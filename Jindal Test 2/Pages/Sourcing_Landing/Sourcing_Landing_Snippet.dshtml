<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Sourcing Team";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	myRM = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status.contains("Returned") || Status == "Reopened"].count();
	sourcingApproval = Raw_Material_Budgets[Status == "Submitted to Sourcing Manager"].count();
	financeApproval = Raw_Material_Budgets[Status == "Submitted to Finance"].count();
	approved = Raw_Material_Budgets[Status == "Approved" || Status == "Locked" || Locked == true].count();
	materials = Raw_Materials[ID != 0].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>Sourcing Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Prepare raw material budgets and route commercial inputs to finance.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:All_Raw_Material_Budgets'><span>My RM drafts</span><strong><%=myRM%></strong><span>Draft, returned or reopened budget rows</span></a><a class='dl-card' href='#Report:RM_Budget_Status_Board'><span>Sourcing approval</span><strong><%=sourcingApproval%></strong><span>Submitted to sourcing manager</span></a><a class='dl-card' href='#Report:RM_Budget_Status_Board'><span>Finance review</span><strong><%=financeApproval%></strong><span>Submitted to finance</span></a><a class='dl-card' href='#Report:Approved_RM_Budgets'><span>Approved RM budgets</span><strong><%=approved%></strong><span>Approved or locked raw material budgets</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Form:Raw_Material_Budgets?zc_LoadIn=dialog'><span><i class='zc-li-outline business-calculator dl-icon'></i> Add RM budget</span><b>New</b></a><a class='dl-action' href='#Report:All_Raw_Material_Budgets'><span><i class='zc-li-outline ui-2-time dl-icon'></i> Update my RM budgets</span><b><%=myRM%></b></a><a class='dl-action' href='#Report:Active_Raw_Materials'><span><i class='zc-li-outline business-gold dl-icon'></i> Review material master</span><b><%=materials%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Review split</strong><div class='dl-muted'><%=sourcingApproval%> rows are with sourcing and <%=financeApproval%> are with finance.</div></div><div class='dl-insight'><strong>Material base</strong><div class='dl-muted'><%=materials%> raw material master records are available for budgeting.</div></div></div></div></div>