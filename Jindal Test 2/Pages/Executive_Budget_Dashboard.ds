<page linkname = "Executive_Budget_Dashboard" displayname = "Executive Budget Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='Executive_KPI_Cards' elementName='Executive_KPI_Cards' bgColor=''>
          <![CDATA[htmlpage Executive_KPI_Cards()
content
			<%{%>
            <file name:Executive_KPI_Cards.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='50%'>
				<dsp id='Approval_Bottlenecks' elementName='Approval_Bottlenecks' bgColor=''>
          <![CDATA[htmlpage Approval_Bottlenecks()
content
			<%{%>
            <file name:Approval_Bottlenecks.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
			<column width='50%'>
				<dsp id='Plant_Status_Matrix' elementName='Plant_Status_Matrix' bgColor=''>
          <![CDATA[htmlpage Plant_Status_Matrix()
content
			<%{%>
            <file name:Plant_Status_Matrix.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Exception_Feed' elementName='Exception_Feed' bgColor=''>
          <![CDATA[htmlpage Exception_Feed()
content
			<%{%>
            <file name:Exception_Feed.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:Critical_Audit_Events.ds/> </column>
		</row>
	</layout>
</zml>
</content>