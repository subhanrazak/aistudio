<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "System Administrator";
	activeCycles = Budget_Cycles[Status == "Open" || Status == "In Planning" || Status == "Under Review" || Status == "Reopened"].count();
	lockedCycles = Budget_Cycles[Status == "Locked" || Approved_Scenario == true].count();
	userCount = Add_Users[ID != 0].count();
	plantCount = Plants[ID != 0].count();
	lineCount = Production_Lines[ID != 0].count();
	criticalEvents = Approval_Audit_Log[Action in {"Returned","Reopened","Locked","Final Approved"}].count();
	%>
<style>
.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box;color:var(--zcs_primary_text_color)}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0;color:var(--zcs_primary_text_color)}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}
</style>
<div class='dl-shell'>
	<div class='dl-hero'><div><h2>System Admin Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Maintain master data, budget cycles, app users and governance logs.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div>
	<div class='dl-grid'>
		<a class='dl-card' href='#Report:Active_Budget_Cycles'><span>Active cycles</span><strong><%=activeCycles%></strong><span>Planning cycles requiring configuration or monitoring</span></a>
		<a class='dl-card' href='#Report:Locked_Baselines'><span>Locked baselines</span><strong><%=lockedCycles%></strong><span>Approved or locked cycle records</span></a>
		<a class='dl-card' href='#Report:All_Users'><span>Application users</span><strong><%=userCount%></strong><span>Users available in the Users module</span></a>
		<a class='dl-card' href='#Report:Critical_Audit_Events'><span>Critical audit events</span><strong><%=criticalEvents%></strong><span>Returned, reopened, locked or final approval actions</span></a>
	</div>
	<div class='dl-layout'>
		<div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Form:Budget_Cycles?zc_LoadIn=dialog'><span><i class='zc-li-outline business-progress dl-icon'></i> Open or revise budget cycle</span><b><%=activeCycles%></b></a><a class='dl-action' href='#Form:Add_Users?zc_LoadIn=dialog'><span><i class='zc-li-outline users-add-27 dl-icon'></i> Add or update app user</span><b><%=userCount%></b></a><a class='dl-action' href='#Report:All_Approval_Audit_Logs'><span><i class='zc-li-outline files-search dl-icon'></i> Review audit log</span><b><%=criticalEvents%></b></a></div>
		<div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Master data footprint</strong><div class='dl-muted'><%=plantCount%> plants and <%=lineCount%> production lines are configured for planning.</div></div><div class='dl-insight'><strong>Recommended next step</strong><div class='dl-muted'>Start with financial years, plants, production lines and cycle status before departments submit plans.</div></div></div>
	</div>
</div>