<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Sales Team";
	if(thisapp.permissions.isUserInProfile("Sales_Management"))
	{
		profileText = "Sales Management";
	}
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	mySalesItems = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status == "Returned by Sales Management" || Status == "Revision Requested by SCM" || Status == "Revised Draft"].count();
	coeQueue = Sales_Plans[Status == "Submitted to Sales Management"].count();
	allApproval = Sales_Plans[Status == "Submitted to Sales Management"].count();
	approved = Sales_Plans[Status == "Sales Approved" || Status == "Locked" || Locked == true].count();
	shortfalls = Volume_Consolidations[Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Both Revisions Pending"].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>Sales Department Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Create sales plans, respond to returned rows and monitor approval progress.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:My_Sales_Plan_Workqueue'><span>My workqueue</span><strong><%=mySalesItems%></strong><span>Draft, returned or revision sales plans</span></a><a class='dl-card' href='#Report:Sales_Management_Approval_Queue'><span>Approval queue</span><strong><%=coeQueue%></strong><span>Plans submitted to Sales Management</span></a><a class='dl-card' href='#Report:Sales_Management_Approval_Queue'><span>Total approval queue</span><strong><%=allApproval%></strong><span>Open approval items</span></a><a class='dl-card' href='#Report:Approved_Sales_Plans'><span>Approved plans</span><strong><%=approved%></strong><span>Sales approved or locked records</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Report:My_Sales_Plan_Workqueue'><span><i class='zc-li-outline ui-2-time dl-icon'></i> Update my plans</span><b><%=mySalesItems%></b></a><a class='dl-action' href='#Form:Sales_Plans?zc_LoadIn=dialog'><span><i class='zc-li-outline business-chart-growth dl-icon'></i> Create sales plan</span><b>New</b></a><a class='dl-action' href='#Report:Sales_Shortfall_Buckets'><span><i class='zc-li-outline ui-3-alert dl-icon'></i> Review revision requests</span><b><%=shortfalls%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Approval movement</strong><div class='dl-muted'><%=allApproval%> sales rows are currently with approvers.</div></div><div class='dl-insight'><strong>Revision exposure</strong><div class='dl-muted'><%=shortfalls%> SCM revision buckets may need sales response.</div></div></div></div></div>