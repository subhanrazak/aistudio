<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Plant Operations";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	myConsumables = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status.contains("Returned") || Status == "Reopened"].count();
	plantApproval = Consumables_Budgets[Status == "Submitted to Plant Manager"].count();
	financeApproval = Consumables_Budgets[Status == "Submitted to Finance"].count();
	approved = Consumables_Budgets[Status == "Approved" || Status == "Locked" || Locked == true].count();
	consumables = Consumables[ID != 0].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>Plant Operations Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Maintain consumables budgets and plant operating norms.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:All_Consumables_Budgets'><span>My consumable drafts</span><strong><%=myConsumables%></strong><span>Draft, returned or reopened rows</span></a><a class='dl-card' href='#Report:Consumables_Status_Board'><span>Plant approval</span><strong><%=plantApproval%></strong><span>Rows with plant manager</span></a><a class='dl-card' href='#Report:Consumables_Status_Board'><span>Finance review</span><strong><%=financeApproval%></strong><span>Rows submitted to finance</span></a><a class='dl-card' href='#Report:Approved_Consumables_Budgets'><span>Approved budgets</span><strong><%=approved%></strong><span>Approved or locked consumable budgets</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Form:Consumables_Budgets?zc_LoadIn=dialog'><span><i class='zc-li-outline business-math dl-icon'></i> Add consumables budget</span><b>New</b></a><a class='dl-action' href='#Report:All_Consumables_Budgets'><span><i class='zc-li-outline ui-2-time dl-icon'></i> Update my budgets</span><b><%=myConsumables%></b></a><a class='dl-action' href='#Report:Active_Consumables'><span><i class='zc-li-outline business-stock dl-icon'></i> Review consumable master</span><b><%=consumables%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Review split</strong><div class='dl-muted'><%=plantApproval%> records are pending plant action and <%=financeApproval%> are waiting for finance.</div></div><div class='dl-insight'><strong>Master data</strong><div class='dl-muted'><%=consumables%> active consumable records support budget entry.</div></div></div></div></div>