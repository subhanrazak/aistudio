<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "SMS Team";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	mySMS = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status.contains("Returned") || Status == "Reopened"].count();
	centralPPC = SMS_Capacity_Plans[Status == "Submitted to Central PPC"].count();
	accepted = SMS_Capacity_Plans[Status == "Accepted" || Status == "Validated" || Locked == true].count();
	byPlant = Plants[ID != 0].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>SMS Team Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Submit steel making capacity and track acceptance by Central PPC.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:All_SMS_Capacity_Plans'><span>My SMS drafts</span><strong><%=mySMS%></strong><span>Draft, returned or reopened SMS rows</span></a><a class='dl-card' href='#Report:SMS_Status_Board'><span>Central PPC queue</span><strong><%=centralPPC%></strong><span>Submitted to Central PPC</span></a><a class='dl-card' href='#Report:Accepted_SMS_Capacity'><span>Accepted capacity</span><strong><%=accepted%></strong><span>Accepted, validated or locked rows</span></a><a class='dl-card' href='#Report:SMS_By_Plant'><span>Plant coverage</span><strong><%=byPlant%></strong><span>Plants configured for SMS planning</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Form:SMS_Capacity_Plans?zc_LoadIn=dialog'><span><i class='zc-li-outline business-factory dl-icon'></i> Add SMS capacity</span><b>New</b></a><a class='dl-action' href='#Report:All_SMS_Capacity_Plans'><span><i class='zc-li-outline ui-2-time dl-icon'></i> Update my SMS rows</span><b><%=mySMS%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Submission status</strong><div class='dl-muted'><%=centralPPC%> SMS capacity rows are waiting with Central PPC.</div></div><div class='dl-insight'><strong>Accepted base</strong><div class='dl-muted'><%=accepted%> rows are already accepted, validated or locked for planning.</div></div></div></div></div>