<page linkname = "Scenario_Comparison_Dashboard" parameters = "int Budget_Cycle_ID" displayname = "Scenario Comparison"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='Scenario_Header' elementName='Scenario_Header' bgColor=''>
          <![CDATA[htmlpage Scenario_Header()
content
			<%{%>
            <file name:Scenario_Header.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Scenario_Cards' elementName='Scenario_Cards' bgColor=''>
          <![CDATA[htmlpage Scenario_Cards()
content
			<%{%>
            <file name:Scenario_Cards.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Scenario_Variance_Bars' elementName='Scenario_Variance_Bars' bgColor=''>
          <![CDATA[htmlpage Scenario_Variance_Bars()
content
			<%{%>
            <file name:Scenario_Variance_Bars.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Plant_Scenario_Table' elementName='Plant_Scenario_Table' bgColor=''>
          <![CDATA[htmlpage Plant_Scenario_Table()
content
			<%{%>
            <file name:Plant_Scenario_Table.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Management_Decision_Panel' elementName='Management_Decision_Panel' bgColor=''>
          <![CDATA[htmlpage Management_Decision_Panel()
content
			<%{%>
            <file name:Management_Decision_Panel.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
	</layout>
</zml>
</content>