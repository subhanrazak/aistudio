list Lines_By_Plant
{

			displayName = "Lines By Plant"
			show all rows from Production_Lines    
			(
				Plant
				Line_Code
				Line_Name
				Line_Type
				Capacity_Basis
				Standard_Hours_Per_Day
				Standard_Productivity_MTPH
				Active
				Notes
			)
			filters
			(
				Plant
				Line_Type
				Capacity_Basis
				Active
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Plant ascending
			)
			sort by
			(
				Line_Code ascending
			)
		
}