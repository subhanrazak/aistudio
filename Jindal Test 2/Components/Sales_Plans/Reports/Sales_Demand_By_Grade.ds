list Sales_Demand_By_Grade
{

			displayName = "Sales Demand By Grade"
			show all rows from Sales_Plans
			(
				Sales_Plan_No
				Requested_Financial_Year
				Budget_Cycle
				Total_Grade_Target_Tons
				Total_Product_Required_Tons
				Variance_Tons
				Status
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Status
			)
			group by
			(
				properties
				(
					display record count = true
				)
				Requested_Financial_Year ascending
			)
			sort by
			(
				Sales_Plan_No descending
			)
		
}