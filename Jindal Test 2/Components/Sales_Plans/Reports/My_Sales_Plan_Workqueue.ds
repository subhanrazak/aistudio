list My_Sales_Plan_Workqueue
{

			displayName = "My Sales Plan Workqueue"
			show all rows from Sales_Plans  [Owner_Email == zoho.loginuserid || Status == "Draft" || Status == "Returned by Sales Management" || Status == "Revision Requested by SCM" || Status == "Revised Draft"]
			(
				Sales_Plan_No
				Requested_Financial_Year
				Budget_Cycle
				Revision_No
				Total_Grade_Target_Tons
				Total_Product_Required_Tons
				Variance_Tons
				Status
				Approver_Action
				Approval_Remarks
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Status
				Owner_Email
			)
			sort by
			(
				Status ascending
				Sales_Plan_No descending
			)
		
}