form Financial_Year_Months
{

			displayname = "Financial Year Months"
			Month_Details
			(
				type = section
				displayname = "Month Details"
	 			row = 1
	 			column = 0
				width = medium
			)
			must have Financial_Year
			(
				type = picklist
				displayname = "Financial Year"
				values = Financial_Years.ID
				displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Month_Order
			(
    			type = number
				displayname = "Month Order"
				maxchar = 2
	 			row = 1
	 			column = 2
				width = medium
			)
			must have Month_Label
			(
    			type = text
				displayname = "Month Label"
				maxchar = 30
	 			row = 1
	 			column = 1
				width = medium
			)
			Month_Start_Date
			(
    			type = date
				displayname = "Month Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2
				width = medium
			)
			Month_End_Date
			(
    			type = date
				displayname = "Month End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1
				width = medium
			)
			Included
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 80px
	 			row = 1
	 			column = 1
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}