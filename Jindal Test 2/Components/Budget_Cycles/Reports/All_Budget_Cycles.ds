default list All_Budget_Cycles
{

			displayName = "All Budget Cycles"
			show all rows from Budget_Cycles
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Parent_Cycle
				Opened_Date
				Status
				Sales_Approved
				Operations_Approved
				SCM_Approved
				Finance_Completed
				Baseline_Locked
				Approved_Scenario
				Completion_Date
				Owner_Email
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
				Baseline_Locked
				Approved_Scenario
			)
			sort by
			(
				Opened_Date descending
				Cycle_Code ascending
			)
		
}