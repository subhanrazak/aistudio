list Locked_Baselines
{

			displayName = "Locked Baselines"
			show all rows from Budget_Cycles  [Baseline_Locked == true]
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Parent_Cycle
				Opened_Date
				Status
				Baseline_Locked
				Approved_Scenario
				Completion_Date
				Owner_Email
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
				Approved_Scenario
			)
			sort by
			(
				Opened_Date descending
				Cycle_Code ascending
			)
		
}