kanban Budget_Cycle_Status_Board
{

			displayName = "Budget Cycle Status Board"
			show all rows from Budget_Cycles
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Opened_Date
				Status
				Sales_Approved
				Operations_Approved
				SCM_Approved
				Finance_Completed
				Baseline_Locked
				Owner_Email
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
				Baseline_Locked
			)
			sort by
			(
				Opened_Date descending
			)
			options
			(
	 			display field = Status
				sort order = custom
				record count = enable
	 		)
		
}