form Budget_Cycles
{

			displayname = "Budget Cycles"
			Cycle_Details
			(
				type = section
				displayname = "Cycle Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Cycle_Code
			(
    			type = text
				displayname = "Cycle Code"
				maxchar = 40
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Cycle_Name
			(
    			type = text
				displayname = "Cycle Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Financial_Year
			(
				type = picklist	
				displayname = "Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Cycle_Type
			(
				type = picklist
				displayname = "Cycle Type"
				values = {"Annual Budget","Revision"}
	 			row = 1
	 			column = 2
				width = medium
			)
			Scenario
			(
				type = picklist
				values = {"Base","Revised","Final"}
	 			row = 1
	 			column = 1
				width = medium
			)
			Scenario_Set_Code
			(
    			type = text
				displayname = "Scenario Set Code"
				maxchar = 40
	 			row = 1
	 			column = 2
				width = medium
			)
			Parent_Cycle
			(
				type = picklist	
				displayname = "Parent Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Opened_Date
			(
    			type = date
				displayname = "Opened Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2
				width = medium
			)
			Guidelines
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 1
				width = medium
			)
			Guidelines_Issued_Date
			(
    			type = date
				displayname = "Guidelines Issued Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1
				width = medium
			)
			Guidelines_Notes
			(
    			type = textarea
				displayname = "Guidelines Notes"
				height = 80px
	 			row = 2
	 			column = 2
				width = medium
			)
			Flow_Status
			(
				type = section
				displayname = "Flow Status"
				visibility = true
	 			row = 3
	 			column = 1
				width = medium
			)
			Create_Companion_Scenario
			(
    			type = checkbox
				displayname = "Create Companion Scenario"
				initial value = false
	 			row = 3
	 			column = 1
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Pending Sales","Pending Operations","Pending SCM","Revision Requested","Pending Finance","Completed","Closed"}
				initial value = "Draft"
	 			row = 3
	 			column = 2
				width = medium
			)
			Sales_Approved
			(
    			type = checkbox
				displayname = "Sales Approved"
				initial value = false
	 			row = 3
	 			column = 1
				width = medium
			)
			Operations_Approved
			(
    			type = checkbox
				displayname = "Operations Approved"
				initial value = false
	 			row = 3
	 			column = 2
				width = medium
			)
			SCM_Approved
			(
    			type = checkbox
				displayname = "SCM Approved"
				initial value = false
	 			row = 3
	 			column = 1
				width = medium
			)
			Finance_Completed
			(
    			type = checkbox
				displayname = "Finance Completed"
				initial value = false
	 			row = 3
	 			column = 2
				width = medium
			)
			Baseline_Locked
			(
    			type = checkbox
				displayname = "Baseline Locked"
				initial value = false
	 			row = 3
	 			column = 1
				width = medium
			)
			Approved_Scenario
			(
    			type = checkbox
				displayname = "Approved Scenario"
				initial value = false
	 			row = 3
	 			column = 2
				width = medium
			)
			Reopened_Modules
			(
				type = list	
				displayname = "Reopened Modules"
				values = {"Sales","Operations","SCM","Finance"}
				height = 80px
	 			row = 3
	 			column = 1
				width = medium
			)
			Ownership_Notes
			(
				type = section
				displayname = "Ownership Notes"
				visibility = true
	 			row = 4
	 			column = 1
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 4
	 			column = 1
				width = medium
			)
			Finance_Notes
			(
    			type = textarea
				displayname = "Finance Notes"
				height = 80px
	 			row = 4
	 			column = 2
				width = medium
			)
			Completion_Date
			(
    			type = date
				displayname = "Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}