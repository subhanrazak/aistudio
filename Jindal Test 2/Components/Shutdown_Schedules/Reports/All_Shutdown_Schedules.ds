default list All_Shutdown_Schedules
{

			displayName = "All Shutdown Schedules"
			show all rows from Shutdown_Schedules    
			(
				Shutdown_No
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Annual_Shutdown_Days
				Annual_Shutdown_Hours
				Status
				Approver_Action
				Approval_Remarks
				Locked
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Status
				Locked
			)
			sort by
			(
				Budget_Cycle descending
				Production_Line ascending
			)
		
}