list Completed_Financial_Years
{

			displayName = "Completed Financial Years"
			show all rows from Financial_Years  [Status == "Completed"]
			(
				Year_Code
				Year_Name
				Start_Date
				End_Date
				Status
				Active
				Completion_Date
			)
			filters
			(
				Status
				Active
			)
			sort by
			(
				Completion_Date descending
			)
		
}