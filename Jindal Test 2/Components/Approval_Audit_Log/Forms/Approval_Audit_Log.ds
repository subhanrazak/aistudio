form Approval_Audit_Log
{

			displayname = "Approval Audit Log"
			Section
			(
				type = section
				displayname = "Audit Event Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Module_Name
			(
				type = picklist
				values = {"Financial Years","Budget Cycles","Sales Plans","Operations Availability","Operations Production","SCM Review","Raw Material Budgets","Replanning Requests","Financial Consolidations","Plant","Production Line","Market Segment","Steel Grade","Finish Type","Consumable","Raw Material","Approval Delegation","Shutdown Schedule","Capacity & TEP Plan","SMS Capacity Plan","Volume Consolidation","Raw Material Budget","Consumables Budget","Financial Consolidation","Replanning Request"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Related_Record_ID
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Related_Record_Display
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Action
			(
				type = picklist
				values = {"Created","Updated","Submitted","Approved","Returned","Revision Requested","Revision Copy Created","Superseded","Reopened","Locked","Final Approved","Completed","Cancelled","System Recalculated","Delegated","Deleted"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			From_Status
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			To_Status
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Iteration_Number
			(
				type = number
	 			row = 1
	 			column = 2   
				width = medium
			)
			Actor_Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			Acting_On_Behalf_Of
			(
    			type = email
	 			row = 1
	 			column = 2   
				width = medium
			)
			Action_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}