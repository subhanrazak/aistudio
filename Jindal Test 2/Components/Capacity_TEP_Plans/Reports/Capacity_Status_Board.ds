kanban Capacity_Status_Board
{

			displayName = "Capacity Status Board"
			show all rows from Capacity_TEP_Plans
			(
				Capacity_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Average_Equipment_Availability_Percent
				Average_Equipment_Utilization_Percent
				Status
				Approver_Action
				Locked
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
				Locked
			)
			sort by
			(
				Capacity_No descending
			)
			options
			(
	 			display field = Status
				sort order = custom
				record count = enable
	 		)
		
}