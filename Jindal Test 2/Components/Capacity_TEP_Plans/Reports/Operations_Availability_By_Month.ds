list Operations_Availability_By_Month
{

			displayName = "Operations Availability By Month"
			show all rows from Capacity_TEP_Plans
			(
				Capacity_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Annual_Calendar_Hours
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Average_Equipment_Availability_Percent
				Average_Equipment_Utilization_Percent
				Status
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
			)
			group by
			(
				properties
				(
					display record count = true
				)
				Requested_Financial_Year ascending
				Plant ascending
			)
			sort by
			(
				Capacity_No descending
			)
		
}