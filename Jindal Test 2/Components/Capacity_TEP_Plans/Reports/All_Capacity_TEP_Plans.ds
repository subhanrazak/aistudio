default list All_Capacity_TEP_Plans
{

			displayName = "All Operations Availability Plans"
			show all rows from Capacity_TEP_Plans
			(
				Capacity_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Revision_No
				Annual_Calendar_Hours
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Average_Equipment_Availability_Percent
				Average_Equipment_Utilization_Percent
				Status
				Approver_Action
				Iteration_Count
				Locked
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
				Locked
			)
			sort by
			(
				Capacity_No descending
			)
		
}