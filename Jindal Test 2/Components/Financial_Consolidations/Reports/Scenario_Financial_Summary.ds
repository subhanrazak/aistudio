list Scenario_Financial_Summary
{

			displayName = "Scenario Financial Summary"
			show all rows from Financial_Consolidations    
			(
				Budget_Cycle
				Scenario
				Volume_MT
				(
					display = total	
				)
				Revenue
				(
					display = total	
				)
				Raw_Material_Cost
				(
					display = total	
				)
				Consumables_Cost
				(
					display = total	
				)
				Total_Other_Cost
				(
					display = total	
				)
				Total_Cost
				(
					display = total	
				)
				EBITDA
				(
					display = total	
				)
				EBITDA_Margin_Percent
				Management_Decision
				Status
				Locked
			)
			filters
			(
				Budget_Cycle
				Scenario
				Management_Decision
				Status
				Locked
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Scenario ascending
			)
			sort by
			(
				Scenario ascending
			)
		
}