kanban Financial_Status_Board
{

			displayName = "Financial Status Board"
			show all rows from Financial_Consolidations    
			(
				Financial_Consolidation_No
				Budget_Cycle
				Scenario
				Volume_MT
				Revenue
				Total_Cost
				EBITDA
				EBITDA_Margin_Percent
				Management_Decision
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Budget_Cycle
				Scenario
				Management_Decision
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Financial_Consolidation_No descending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order  = ascending
				record count  = enable
	 		)
		
}