list RM_Budget_By_Material
{

			displayName = "RM Budget By Material"
			show all rows from Raw_Material_Budgets
			(
				RM_Budget_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Budget_Price
				Annual_Requirement_MT
				(
					display = total
				)
				Available_Raw_Material_Total_MT
				(
					display = total
				)
				To_Be_Raised_Total_MT
				(
					display = total
				)
				Cost_Forecast_Total
				(
					display = total
				)
				Total_Raw_Material_Cost
				Status
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Status
				Locked
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Material ascending
			)
			sort by
			(
				Material ascending
				RM_Budget_No descending
			)
		
}