default list All_Raw_Material_Budgets
{

			displayName = "All Raw Material Budgets"
			show all rows from Raw_Material_Budgets
			(
				RM_Budget_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Previous_Year_Price
				Budget_Price
				Annual_Requirement_MT
				(
					display = total
				)
				Available_Raw_Material_Total_MT
				(
					display = total
				)
				To_Be_Raised_Total_MT
				(
					display = total
				)
				Cost_Forecast_Total
				(
					display = total
				)
				Inventory_Value
				Total_Raw_Material_Cost
				Status
				Owner_Email
				Iteration_Count
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				RM_Budget_No descending
			)
		
}