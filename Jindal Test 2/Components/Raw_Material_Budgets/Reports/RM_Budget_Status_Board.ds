kanban RM_Budget_Status_Board
{

			displayName = "RM Budget Status Board"
			show all rows from Raw_Material_Budgets
			(
				RM_Budget_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Budget_Price
				Annual_Requirement_MT
				Available_Raw_Material_Total_MT
				To_Be_Raised_Total_MT
				Cost_Forecast_Total
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				RM_Budget_No descending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order = ascending
				record count = enable
	 		)
		
}