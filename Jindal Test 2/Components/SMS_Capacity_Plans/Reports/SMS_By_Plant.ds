list SMS_By_Plant
{

			displayName = "SMS By Plant"
			show all rows from SMS_Capacity_Plans    
			(
				SMS_Plan_No
				Budget_Cycle
				Plant
				Melting_Unit
				Total_Steel_Availability_BTV
				Status
				Locked
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Status
				Locked
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Plant ascending
			)
			sort by
			(
				SMS_Plan_No descending
			)
		
}