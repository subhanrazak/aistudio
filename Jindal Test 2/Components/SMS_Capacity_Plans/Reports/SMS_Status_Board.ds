kanban SMS_Status_Board
{

			displayName = "SMS Status Board"
			show all rows from SMS_Capacity_Plans    
			(
				SMS_Plan_No
				Budget_Cycle
				Plant
				Melting_Unit
				Total_Steel_Availability_BTV
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Budget_Cycle
				Plant
				Melting_Unit
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				SMS_Plan_No descending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order  = ascending
				record count  = enable
	 		)
		
}