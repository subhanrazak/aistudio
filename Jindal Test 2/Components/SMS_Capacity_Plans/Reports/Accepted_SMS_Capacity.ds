list Accepted_SMS_Capacity
{

			displayName = "Accepted SMS Capacity"
			show all rows from SMS_Capacity_Plans  [Status in {"Accepted","Locked"}]  
			(
				SMS_Plan_No
				Budget_Cycle
				Plant
				Melting_Unit
				Previous_Year_Output_MT
				Total_Steel_Availability_BTV
				Status
				Locked
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Melting_Unit
				Status
				Locked
			)
			sort by
			(
				Plant ascending
				SMS_Plan_No descending
			)
		
}