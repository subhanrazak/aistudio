form SMS_Capacity_Plans
{

			displayname = "SMS Capacity Plans"
			Section
			(
				type = section
				displayname = "Plan Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			SMS_Plan_No
			(
    			type = autonumber
				displayname = "SMS Plan No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Melting_Unit
			(
				type = picklist	
				displayname = "Melting Unit"
				values  = Production_Lines.ID
    			displayformat = [Line_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Previous_Year_Output_MT
			(
				type = decimal
				displayname = "Previous Year Output MT"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Monthly_Steel_Availability
			(
				type = section
				displayname = "Monthly Steel Availability"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Monthly_SMS_Availability
			(
				type = grid
				displayname = "Monthly SMS Availability"
				defaultrow = 1
				maxrow = 12
				must have Month
				(
					type = picklist
					values = {"Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","Jan","Feb","Mar"}
					width = medium
				)
				Month_Order
				(
					type = number
					displayname = "Month Order"
					width = medium
				)
				Available_Days
				(
					type = decimal
					displayname = "Available Days"
					width = medium
				)
				Heats_Per_Day
				(
					type = decimal
					displayname = "Heats Per Day"
					width = medium
				)
				Tonnage_Per_Heat
				(
					type = decimal
					displayname = "Tonnage Per Heat"
					width = medium
				)
				Output_MT
				(
					type = decimal
					displayname = "Output MT"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Steel_Availability_BTV
			(
				type = decimal
				displayname = "Total Steel Availability BTV"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Central PPC","Returned by Central PPC","Accepted","Locked","Reopened"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Reopen","Lock"}
	 			row = 3
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 13px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 3
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}