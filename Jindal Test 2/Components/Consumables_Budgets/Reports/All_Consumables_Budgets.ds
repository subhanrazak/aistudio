default list All_Consumables_Budgets
{

			displayName = "All Consumables Budgets"
			show all rows from Consumables_Budgets    
			(
				Consumables_Budget_No
				Budget_Cycle
				Plant
				Production_Line
				Consumable
				Previous_Year_Budget_Norm
				Previous_Year_Actual_Average
				Best_Three_Month_Average
				Calculated_Budget_Norm
				Override_Norm
				Applied_Norm
				Half_Year_Split
				Budget_Price_Per_Unit
				Production_Basis_MT
				Total_Consumable_Cost
				Status
				Owner_Email
				Iteration_Count
				Locked
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Consumable
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Consumables_Budget_No descending
			)
		
}