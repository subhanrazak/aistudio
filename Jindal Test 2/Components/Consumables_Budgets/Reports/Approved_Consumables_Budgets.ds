list Approved_Consumables_Budgets
{

			displayName = "Approved Consumables Budgets"
			show all rows from Consumables_Budgets  [Status in {"Approved","Locked"}]  
			(
				Consumables_Budget_No
				Budget_Cycle
				Plant
				Production_Line
				Consumable
				Applied_Norm
				Budget_Price_Per_Unit
				Production_Basis_MT
				Total_Consumable_Cost
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Consumable
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Consumables_Budget_No descending
			)
		
}