list Consumables_By_Line
{

			displayName = "Consumables By Line"
			show all rows from Consumables_Budgets    
			(
				Production_Line
				Consumables_Budget_No
				Budget_Cycle
				Plant
				Consumable
				Applied_Norm
				Budget_Price_Per_Unit
				Production_Basis_MT
				Total_Consumable_Cost
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Consumable
				Status
				Owner_Email
				Locked
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Production_Line ascending
			)
			sort by
			(
				Consumables_Budget_No descending
			)
		
}