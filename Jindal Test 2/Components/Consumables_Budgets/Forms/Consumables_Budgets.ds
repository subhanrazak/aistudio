form Consumables_Budgets
{

			displayname = "Consumables Budgets"
			Section
			(
				type = section
				displayname = "Budget Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Consumables_Budget_No
			(
    			type = autonumber
				displayname = "Consumables Budget No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Production_Line
			(
				type = picklist	
				displayname = "Production Line"
				values  = Production_Lines.ID
    			displayformat = [Line_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consumable
			(
				type = picklist	
				values  = Consumables.ID
    			displayformat = [Consumable_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Norm_Planning
			(
				type = section
				displayname = "Norm Planning"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Previous_Year_Budget_Norm
			(
				type = decimal
				displayname = "Previous Year Budget Norm"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			Previous_Year_Actual_Average
			(
				type = decimal
				displayname = "Previous Year Actual Average"
				decimalplace = 4
	 			row = 2
	 			column = 2   
				width = medium
			)
			Best_Three_Month_Average
			(
				type = decimal
				displayname = "Best Three Month Average"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			Calculated_Budget_Norm
			(
				type = decimal
				displayname = "Calculated Budget Norm"
				decimalplace = 4
	 			row = 2
	 			column = 2   
				width = medium
			)
			Override_Norm
			(
				type = decimal
				displayname = "Override Norm"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			Override_Justification
			(
    			type = textarea
				displayname = "Override Justification"
				height = 13px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Applied_Norm
			(
				type = decimal
				displayname = "Applied Norm"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			Half_Year_Split
			(
				type = picklist
				displayname = "Half Year Split"
				values = {"No Split","Separate H1 and H2"}
				initial value = "No Split"
	 			row = 2
	 			column = 2   
				width = medium
			)
			H1_Norm
			(
				type = decimal
				displayname = "H1 Norm"
				decimalplace = 4
	 			row = 2
	 			column = 1   
				width = medium
			)
			H2_Norm
			(
				type = decimal
				displayname = "H2 Norm"
				decimalplace = 4
	 			row = 2
	 			column = 2   
				width = medium
			)
			Cost_Basis
			(
				type = section
				displayname = "Cost Basis"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Budget_Price_Per_Unit
			(
				type = decimal
				displayname = "Budget Price Per Unit"
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Production_Basis_MT
			(
				type = decimal
				displayname = "Production Basis MT"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Total_Consumable_Cost
			(
				type = decimal
				displayname = "Total Consumable Cost"
	 			row = 3
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Applied_Norm * input.Production_Basis_MT * input.Budget_Price_Per_Unit
    						visibility = true
    			)
			)
			Plant_Remarks
			(
    			type = textarea
				displayname = "Plant Remarks"
				height = 13px
	 			row = 3
	 			column = 2   
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Plant Manager","Returned by Plant Manager","Submitted to Finance","Returned by Finance","Approved","Locked","Reopened"}
				initial value = "Draft"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Reopen","Lock"}
	 			row = 4
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 13px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 4
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 4
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}