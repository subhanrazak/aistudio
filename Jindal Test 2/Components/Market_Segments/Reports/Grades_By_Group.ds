list Grades_By_Group
{

			displayName = "Grades By Group"
			show all rows from Market_Segments
			(
				Segment_Code as "Grade Code"
				Segment_Name as "Grade Name"
				Market_Type as "Grade Group"
				Business_Owner_Email
				Active
			)
			filters
			(
				Market_Type
				Active
			)
			group by
			(
				properties
				(
					display record count = true
				)
				Market_Type ascending
			)
			sort by
			(
				Segment_Name ascending
			)
		
}