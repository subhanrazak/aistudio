list Finalised_Consolidations
{

			displayName = "Finalised Consolidations"
			show all rows from Volume_Consolidations [Status == "SCM Approved" || Status == "Submitted to Finance" || Status == "Locked"]
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Sales_Plan
				Operations_Production_Plan
				SCM_Decision
				SCM_Approved_By
				SCM_Approved_On
				Status
				Locked
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				SCM_Decision
				Status
				Locked
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}