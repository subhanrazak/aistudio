list Sales_Shortfall_Buckets
{

			displayName = "Sales Shortfall Buckets"
			show all rows from Volume_Consolidations [Status == "Sales Revision Pending" || Status == "Both Revisions Pending"]
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Sales_Plan
				SCM_Review_Lines
				SCM_Decision
				Status
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}