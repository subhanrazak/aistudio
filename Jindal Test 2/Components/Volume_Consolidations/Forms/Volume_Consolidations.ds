form Volume_Consolidations
{

			displayname = "SCM Review & Consolidation"
			Review_Context
			(
				type = section
				displayname = "Review Context"
	 			row = 1
	 			column = 0
				width = medium
			)
			Consolidation_No
			(
    			type = autonumber
				displayname = "Consolidation No"
				start index = 1000
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist
				displayname = "Requested Financial Year"
				values = Financial_Years.ID
    			displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist
				displayname = "Budget Cycle"
				values = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Sales_Plan
			(
				type = picklist
				displayname = "Sales Plan"
				values = Sales_Plans.ID
    			displayformat = [Sales_Plan_No]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Availability_Plan
			(
				type = picklist
				displayname = "Availability Plan"
				values = Capacity_TEP_Plans.ID
    			displayformat = [Capacity_No]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Operations_Production_Plan
			(
				type = picklist
				displayname = "Operations Production Plan"
				values = Operations_Production_Plans.ID
    			displayformat = [Operations_Production_No]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Plant
			(
				type = picklist
				values = Plants.ID
    			displayformat = [Plant_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Review_Details
			(
				type = section
				displayname = "Review Details"
				visibility = true
	 			row = 2
	 			column = 0
				width = medium
			)
			SCM_Review_Lines
			(
				type = grid
				displayname = "SCM Review Lines"
				defaultrow = 1
				Grade
				(
					type = picklist
					values = Market_Segments.ID
    				displayformat = [Segment_Name]
					width = medium
				)
				Product
				(
					type = picklist
					values = Steel_Grades.ID
    				displayformat = [Grade_Code]
					width = medium
				)
				Sales_Target_Tons
				(
					type = decimal
					displayname = "Sales Target Tons"
					width = medium
				)
				Operations_Production_Tons
				(
					type = decimal
					displayname = "Operations Production Tons"
					width = medium
				)
				BTV_Measured_MT
				(
					type = decimal
					displayname = "BTV Measured MT"
					width = medium
				)
				Raw_Material
				(
					type = picklist
					displayname = "Raw Material"
					values = Raw_Materials.ID
    				displayformat = [Material_Name]
					width = medium
				)
				Required_Raw_Material_MT
				(
					type = decimal
					displayname = "Required Raw Material MT"
					width = medium
				)
				Available_Raw_Material_MT
				(
					type = decimal
					displayname = "Available Raw Material MT"
					width = medium
				)
				To_Be_Raised_MT
				(
					type = decimal
					displayname = "To Be Raised MT"
					width = medium
				)
				Cost_Forecast
				(
					type = decimal
					displayname = "Cost Forecast"
					width = medium
				)
				SCM_Override
				(
    				type = checkbox
					displayname = "SCM Override"
					initial value = false
					width = medium
				)
				Override_Comments
				(
    				type = textarea
					displayname = "Override Comments"
					height = 80px
					width = medium
				)
	 			row = 2
	 			column = 1
				width = medium
			)
			Decision
			(
				type = section
				displayname = "Decision"
				visibility = true
	 			row = 3
	 			column = 0
				width = medium
			)
			SCM_Decision
			(
				type = picklist
				displayname = "SCM Decision"
				values = {"Approve","Request Sales Revision","Request Operations Revision","Request Sales and Operations Revision"}
	 			row = 3
	 			column = 1
				width = medium
			)
			SCM_Comments
			(
    			type = textarea
				displayname = "SCM Comments"
				height = 80px
	 			row = 3
	 			column = 2
				width = medium
			)
			Latest_Revision_No
			(
				type = number
				displayname = "Latest Revision No"
				initial value = 0
	 			row = 3
	 			column = 1
				width = medium
			)
			Revision_History
			(
				type = section
				displayname = "Revision History"
				visibility = true
	 			row = 4
	 			column = 0
				width = medium
			)
			Revision_History_Lines
			(
				type = grid
				displayname = "Revision History Lines"
				defaultrow = 0
				Revision_No
				(
					type = number
					displayname = "Revision No"
					width = medium
				)
				Requested_To
				(
					type = picklist
					displayname = "Requested To"
					values = {"Sales","Operations","Both"}
					width = medium
				)
				Source_Record
				(
					type = text
					displayname = "Source Record"
					width = medium
				)
				New_Revision_Record_ID
				(
					type = number
					displayname = "New Revision Record ID"
					width = medium
				)
				Comments
				(
    				type = textarea
					height = 80px
					width = medium
				)
				Requested_By
				(
    				type = email
					displayname = "Requested By"
					width = medium
				)
				Requested_On
				(
					type = datetime
					displayname = "Requested On"
					width = medium
				)
				Revision_Status
				(
					type = picklist
					displayname = "Revision Status"
					values = {"Requested","In Progress","Resubmitted","Closed"}
					width = medium
				)
	 			row = 4
	 			column = 1
				width = medium
			)
			Workflow_Status
			(
				type = section
				displayname = "Workflow Status"
				visibility = true
	 			row = 5
	 			column = 0
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Waiting for Sales and Operations Approval","Under SCM Review","Revision Requested","Sales Revision Pending","Operations Revision Pending","Both Revisions Pending","SCM Approved","Submitted to Finance","Locked","Reopened"}
				initial value = "Waiting for Sales and Operations Approval"
	 			row = 5
	 			column = 1
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Start Review","Approve","Request Revision","Submit to Finance","Lock"}
	 			row = 5
	 			column = 2
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 5
	 			column = 1
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 5
	 			column = 2
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 5
	 			column = 2
				width = medium
			)
			SCM_Approved_By
			(
    			type = email
				displayname = "SCM Approved By"
	 			row = 5
	 			column = 1
				width = medium
			)
			SCM_Approved_On
			(
				type = datetime
				displayname = "SCM Approved On"
	 			row = 5
	 			column = 2
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}