kanban Operations_Production_Status_Board
{

			displayName = "Operations Production Status Board"
			show all rows from Operations_Production_Plans
			(
				Operations_Production_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Total_FY_Production_Tons
				Average_Productivity_MTPH
				Status
				Approver_Action
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
				Locked
			)
			sort by
			(
				Operations_Production_No descending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order = custom
				record count = enable
	 		)
		
}