form Approval_Delegations
{

			displayname = "Approval Delegations"
			Section
			(
				type = section
				displayname = "Delegation Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Delegator_Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Delegate_Email
			(
    			type = email
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Profile_Name
			(
				type = picklist
				values = {"Finance_Costing","Sales_Team","COE_Team","SCM_Central_PPC","Operations_PPC","SMS_Team","Sourcing_Team","Plant_Operations","Sales_Management","Executive_Management"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Module_Name
			(
				type = picklist
				values = {"Sales Plan","Capacity & TEP Plan","SMS Capacity Plan","Shutdown Schedule","Volume Consolidation","Raw Material Budget","Consumables Budget","Financial Consolidation","Budget Cycle"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reason
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}