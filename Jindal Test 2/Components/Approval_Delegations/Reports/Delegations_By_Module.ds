list Delegations_By_Module
{

			displayName = "Delegations By Module"
			show all rows from Approval_Delegations    
			(
				Delegator_Email
				Delegate_Email
				Profile_Name
				Module_Name
				Start_Date
				End_Date
				Active
				Reason
			)
			filters
			(
				Module_Name
				Active
				Profile_Name
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Module_Name ascending
			)
			sort by
			(
				Start_Date descending
			)
		
}