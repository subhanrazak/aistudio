customize
{
	font = "lato"
	color options
	{
		color = "1"
	}
	logo
	{
		preference = "app_icon"
		placement = "left"
	}
	custom css
	{
		content = ".zc-report-table, .zc-report-table td, .zc-report-table th, .zc-list-report, .zc-spreadsheet-report { font-size: 13px; line-height: 1.45; } .zc-report-table th { font-weight: 600; } .zc-page-content table, .zc-page-content td, .zc-page-content th { font-size: 13px; line-height: 1.45; }"
	}
}