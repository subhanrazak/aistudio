			Validate_Unique_Active_Segment_Naming as "Validate Grade Master Naming"
			{
			
							type = form
							form = Market_Segments
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Segment_Code == null || input.Segment_Code.trim() == "")
										{
											alert "Grade Code is required.";
											cancel submit;
										}
										if(input.Segment_Name == null || input.Segment_Name.trim() == "")
										{
											alert "Grade Name is required.";
											cancel submit;
										}
										if(input.Active == true)
										{
											duplicate_segments = Market_Segments[ID != input.ID && Active == true && Segment_Name == input.Segment_Name];
											if(duplicate_segments.count() > 0)
											{
												alert "Active grade name must be unique.";
												cancel submit;
											}
										}
										if(input.Active == false)
										{
											active_sales_grade_count = Sales_Plans[Status != "Locked" && Status != "Superseded" && Grade_Demand_Lines.Grade == input.ID].count();
											active_scm_grade_count = Volume_Consolidations[Status != "Locked" && SCM_Review_Lines.Grade == input.ID].count();
											if(active_sales_grade_count > 0 || active_scm_grade_count > 0)
											{
												alert "This inactive grade is referenced in active Sales or SCM records. Review dependent plans before saving.";
											}
										}
									)
								}
							}
			
						
			}

			OP_Prod_Action_Input as "Operations Production Action On User Input"
			{
			
							type = form
							form = Operations_Production_Plans
			
							record event = on add or edit
			
							on user input of Approver_Action
							{
								actions
								{
									custom deluge script
									(
										if(input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
										else
										{
											hide Approval_Remarks;
											input.Approval_Remarks = null;
										}
									)
								}
							}
			
						
			}

			Operations_Production_Plans_After_Save as "Operations Production Plans After Save"
			{
			
							type = form
							form = Operations_Production_Plans
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										currentStatus = input.Status;
										actionValue = input.Approver_Action;
										newStatus = currentStatus;
										auditAction = "Updated";
										shouldAudit = false;
										newRevisionId = null;
										if(actionValue == "Submit" && (currentStatus == "Draft" || currentStatus == "Returned by Operations Approval" || currentStatus == "Revision Requested by SCM" || currentStatus == "Revised Draft"))
										{
											newStatus = "Submitted to Operations Approval";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Approve" && currentStatus == "Submitted to Operations Approval")
										{
											newStatus = "Operations Approved";
											input.Operations_Approved_By = zoho.loginuserid;
											input.Operations_Approved_On = zoho.currenttime;
											auditAction = "Approved";
											shouldAudit = true;
										}
										else if(actionValue == "Return" && currentStatus == "Submitted to Operations Approval")
										{
											newStatus = "Returned by Operations Approval";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Returned";
											shouldAudit = true;
										}
										else if(actionValue == "Create Revision Copy")
										{
											revisionRows = Collection();
											for each productionRow in input.Product_Production_Lines
											{
												newProductionRow = Operations_Production_Plans.Product_Production_Lines();
												newProductionRow.Product = productionRow.Product;
												newProductionRow.Series = productionRow.Series;
												newProductionRow.Width = productionRow.Width;
												newProductionRow.Thickness = productionRow.Thickness;
												newProductionRow.Productivity_MTPH = productionRow.Productivity_MTPH;
												newProductionRow.Month = productionRow.Month;
												newProductionRow.Month_Order = productionRow.Month_Order;
												newProductionRow.Production_Tons = productionRow.Production_Tons;
												newProductionRow.Remarks = productionRow.Remarks;
												revisionRows.insert(newProductionRow);
											}
											newRevisionId = insert into Operations_Production_Plans
											[
												Requested_Financial_Year=input.Requested_Financial_Year
												Budget_Cycle=input.Budget_Cycle
												Plant=input.Plant
												Production_Line=input.Production_Line
												Linked_Availability_Plan=input.Linked_Availability_Plan
												Revision_No=ifNull(input.Revision_No,0) + 1
												Parent_Production_Plan=input.ID
												Product_Production_Lines=revisionRows
												Total_FY_Production_Tons=input.Total_FY_Production_Tons
												Average_Productivity_MTPH=input.Average_Productivity_MTPH
												Status="Revised Draft"
												Iteration_Count=ifNull(input.Iteration_Count,0) + 1
												Locked=false
												Owner_Email=zoho.loginuserid
												Approval_Remarks=input.Approval_Remarks
												Added_User=zoho.loginuser
											];
											newStatus = "Superseded";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Revision Copy Created";
											shouldAudit = true;
										}
										else if(actionValue == "Lock")
										{
											newStatus = "Locked";
											input.Locked = true;
											auditAction = "Locked";
											shouldAudit = true;
										}
										latestAudit = Approval_Audit_Log[Module_Name == "Operations Production" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										if(latestAudit.count() == 0)
										{
											createdAuditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Operations Production"
												Related_Record_ID=input.ID
												Related_Record_Display="Production Plan " + input.Operations_Production_No
												Action="Created"
												From_Status=""
												To_Status=currentStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Operations production plan created."
												Added_User=zoho.loginuser
											];
										}
										if(shouldAudit == true)
										{
											input.Status = newStatus;
											auditRemarks = input.Approval_Remarks;
											if(newRevisionId != null)
											{
												auditRemarks = input.Approval_Remarks + " | New revision record ID: " + newRevisionId;
											}
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Operations Production"
												Related_Record_ID=input.ID
												Related_Record_Display="Production Plan " + input.Operations_Production_No
												Action=auditAction
												From_Status=currentStatus
												To_Status=newStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=auditRemarks
												Added_User=zoho.loginuser
											];
											if(newStatus == "Operations Approved")
											{
												cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
												if(cycleRec.count() > 0)
												{
													approvedAvailabilityCount = Capacity_TEP_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"].count();
													if(approvedAvailabilityCount > 0)
													{
														cycleRec.Operations_Approved = true;
														if(cycleRec.Sales_Approved == true)
														{
															cycleRec.Status = "Pending SCM";
														}
														else
														{
															cycleRec.Status = "Pending Sales";
														}
													}
												}
											}
											input.Approver_Action = null;
										}
									)
								}
							}
			
						
			}

			Operations_Production_Plans_On_Load as "Operations Production Plans On Load"
			{
			
							type = form
							form = Operations_Production_Plans
			
							record event = on add or edit
			
							on load
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										if(input.Status == null)
										{
											input.Status = "Draft";
										}
										if(input.Iteration_Count == null)
										{
											input.Iteration_Count = 0;
										}
										if(input.Requested_Financial_Year != null && input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
										}
										if(input.Linked_Availability_Plan == null && input.Requested_Financial_Year != null && input.Plant != null && input.Production_Line != null)
										{
											approvedAvailability = Capacity_TEP_Plans[Requested_Financial_Year == input.Requested_Financial_Year && Plant == input.Plant && Production_Line == input.Production_Line && Status == "Operations Approved"] sort by Operations_Approved_On desc range from 0 to 0;
											if(approvedAvailability.count() > 0)
											{
												input.Linked_Availability_Plan = approvedAvailability.ID;
											}
										}
										disable Budget_Cycle;
										disable Total_FY_Production_Tons;
										disable Average_Productivity_MTPH;
										disable Status;
										disable Iteration_Count;
										disable Locked;
										disable Owner_Email;
										disable Operations_Approved_By;
										disable Operations_Approved_On;
										hide Approval_Remarks;
										if(input.Locked == true || input.Status == "Locked" || input.Status == "Superseded")
										{
											disable Requested_Financial_Year;
											disable Plant;
											disable Production_Line;
											disable Linked_Availability_Plan;
											disable Revision_No;
											disable Parent_Production_Plan;
											disable Approver_Action;
											disable Approval_Remarks;
										}
										if(input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
									)
								}
							}
						}

			Operations_Production_Plans_Validate as "Operations Production Plans Validate"
			{
			
							type = form
							form = Operations_Production_Plans
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Locked == true || input.Status == "Locked" || input.Status == "Superseded")
										{
											alert "This Operations production plan is locked or superseded and cannot be edited.";
											cancel submit;
										}
										if(input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
											else
											{
												alert "An active Budget Cycle is required for the selected Financial Year.";
												cancel submit;
											}
										}
										totalProduction = 0;
										productivityTotal = 0;
										productivityRows = 0;
										productionRows = 0;
										for each productionRow in input.Product_Production_Lines
										{
											if(productionRow.Product == null)
											{
												alert "Product is required in every production row.";
												cancel submit;
											}
											if(productionRow.Month == null)
											{
												alert "Month is required in every production row.";
												cancel submit;
											}
											if(ifNull(productionRow.Production_Tons,0) < 0 || ifNull(productionRow.Productivity_MTPH,0) < 0 || ifNull(productionRow.Thickness,0) < 0)
											{
												alert "Production tons, productivity, and thickness values cannot be negative.";
												cancel submit;
											}
											if(productionRow.Month != null)
											{
												monthRec = Financial_Year_Months[ID == productionRow.Month];
												if(monthRec.count() == 0 || monthRec.Financial_Year != input.Requested_Financial_Year || monthRec.Included != true)
												{
													alert "Every production month must belong to the selected Financial Year and be marked Included.";
													cancel submit;
												}
												else
												{
													productionRow.Month_Order = monthRec.Month_Order;
												}
											}
											if(productionRow.Product != null)
											{
												productRec = Steel_Grades[ID == productionRow.Product];
												if(productRec.count() > 0 && (productionRow.Series == null || productionRow.Series == ""))
												{
													productionRow.Series = productRec.Grade_Series;
												}
											}
											totalProduction = totalProduction + ifNull(productionRow.Production_Tons,0);
											if(productionRow.Productivity_MTPH != null)
											{
												productivityTotal = productivityTotal + productionRow.Productivity_MTPH;
												productivityRows = productivityRows + 1;
											}
											productionRows = productionRows + 1;
										}
										input.Total_FY_Production_Tons = totalProduction;
										if(productivityRows > 0)
										{
											input.Average_Productivity_MTPH = productivityTotal / productivityRows;
										}
										else
										{
											input.Average_Productivity_MTPH = 0;
										}
										if((input.Approver_Action == "Submit" || input.Approver_Action == "Approve") && productionRows == 0)
										{
											alert "At least one production row is required before submitting or approving.";
											cancel submit;
										}
										if((input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy") && (input.Approval_Remarks == null || input.Approval_Remarks == ""))
										{
											alert "Approval remarks are required for Return or Create Revision Copy actions.";
											cancel submit;
										}
										if(input.Approver_Action == "Approve")
										{
											if(input.Linked_Availability_Plan == null)
											{
												alert "An approved linked Operations availability plan is required before approving production.";
												cancel submit;
											}
											availabilityRec = Capacity_TEP_Plans[ID == input.Linked_Availability_Plan];
											if(availabilityRec.count() == 0 || availabilityRec.Status != "Operations Approved")
											{
												alert "The linked Operations availability plan must be Operations Approved.";
												cancel submit;
											}
											else if(availabilityRec.Requested_Financial_Year != input.Requested_Financial_Year || availabilityRec.Plant != input.Plant || availabilityRec.Production_Line != input.Production_Line)
											{
												alert "The linked availability plan must match the same Financial Year, Plant, and Production Line.";
												cancel submit;
											}
										}
									)
								}
							}
			
						
			}

			OP_Prod_FY_Input as "Operations Production FY On User Input"
