			 			row = 1
			 			column = 0
						width = medium
					)
					must have unique Grade_Code
					(
		    			type = text
						displayname = "Product Code"
						maxchar = 30
			 			row = 1
			 			column = 1
						width = medium
					)
					Grade_Name
					(
		    			type = text
						displayname = "Product Name"
						maxchar = 100
			 			row = 1
			 			column = 2
						width = medium
					)
					must have Grade_Series
					(
						type = picklist
						displayname = "Series"
						values = {"200","300","400","DUPLEX","Clad-Alloy"}
			 			row = 1
			 			column = 1
						width = medium
					)
					Nickel_Content_Percent
					(
						type = decimal
						displayname = "Nickel Content Percent"
						decimalplace = 3
			 			row = 1
			 			column = 2
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 80px
			 			row = 1
			 			column = 2
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Volume_Consolidations
		{
		
					displayname = "SCM Review & Consolidation"
