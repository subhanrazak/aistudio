			Raw_Material_Budgets_After_Save as "Raw Material Budgets After Save"
			{
			
							type =  form
							form = Raw_Material_Budgets
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													currentStatus = input.Status;
													actionValue = input.Approver_Action;
													newStatus = currentStatus;
													auditAction = "";
													shouldAudit = false;
													isReturn = false;
													isFinalApproval = false;
													isFinalLock = false;
													if(actionValue == "Submit" && currentStatus == "Draft" || currentStatus == "Returned by Sourcing Manager" || currentStatus == "Returned by Finance" || currentStatus == "Reopened")
													{
														newStatus = "Submitted to Sourcing Manager";
														auditAction = "Submitted";
														shouldAudit = true;
													}
													else if(actionValue == "Approve" && currentStatus == "Submitted to Sourcing Manager")
													{
														newStatus = "Submitted to Finance";
														auditAction = "Approved";
														shouldAudit = true;
													}
													else if(actionValue == "Approve" && currentStatus == "Submitted to Finance")
													{
														newStatus = "Approved";
														auditAction = "Approved";
														shouldAudit = true;
														isFinalApproval = true;
													}
													else if(actionValue == "Lock" && currentStatus == "Submitted to Finance" || currentStatus == "Approved")
													{
														newStatus = "Locked";
														input.Locked = true;
														auditAction = "Locked";
														shouldAudit = true;
														isFinalApproval = true;
														isFinalLock = true;
													}
													else if(actionValue == "Return")
													{
														isReturn = true;
														auditAction = "Returned";
														shouldAudit = true;
														if(currentStatus == "Submitted to Sourcing Manager")
														{
															newStatus = "Returned by Sourcing Manager";
														}
														else if(currentStatus == "Submitted to Finance")
														{
															newStatus = "Returned by Finance";
														}
													}
													else if(actionValue == "Reopen" && currentStatus == "Locked")
													{
														newStatus = "Reopened";
														input.Locked = false;
														isReturn = true;
														auditAction = "Reopened";
														shouldAudit = true;
													}
													latestAudit = Approval_Audit_Log[Module_Name == "Raw Material Budget" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													if(latestAudit.count() == 0)
													{
														createdAuditId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="Raw Material Budget"
															Related_Record_ID=input.ID
															Related_Record_Display="RM Budget " + input.RM_Budget_No
															Action="Created"
															From_Status=""
															To_Status=currentStatus
															Iteration_Number=input.Iteration_Count
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks="Raw material budget created."
															Added_User=zoho.loginuser
														];
													}
													if(shouldAudit == true)
													{
														if(isReturn == true)
														{
															input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
														}
														input.Status = newStatus;
														auditRecordId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="Raw Material Budget"
															Related_Record_ID=input.ID
															Related_Record_Display="RM Budget " + input.RM_Budget_No
															Action=auditAction
															From_Status=currentStatus
															To_Status=newStatus
															Iteration_Number=input.Iteration_Count
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks=input.Approval_Remarks
															Added_User=zoho.loginuser
														];
														if(isReturn == true && input.Owner_Email != null)
														{
															sendmail
															[
																from :zoho.adminuserid
																to :input.Owner_Email
																subject :"Raw Material Budget Returned: " + input.RM_Budget_No
																message :"Your Raw Material Budget has been returned from " + currentStatus + ". Remarks: " + input.Approval_Remarks
															]
														}
														if(isFinalApproval == true)
														{
															input.Status = newStatus;
															approvedRawMaterialCost = 0.0;
															approvedRawMaterialBudgets = Raw_Material_Budgets[Budget_Cycle == input.Budget_Cycle && Status in {"Approved","Locked"}];
															for each  approvedRawMaterialBudget in approvedRawMaterialBudgets
															{
																approvedRawMaterialCost = approvedRawMaterialCost + ifNull(approvedRawMaterialBudget.Cost_Forecast_Total,0);
															}
															financialConsolidations = Financial_Consolidations[Budget_Cycle == input.Budget_Cycle];
															for each  financialConsolidation in financialConsolidations
															{
																financialConsolidation.Raw_Material_Cost=approvedRawMaterialCost;
															}
															recalculationAuditId = insert into Approval_Audit_Log
															[
																Budget_Cycle=input.Budget_Cycle
																Module_Name="Financial Consolidation"
																Related_Record_ID=input.Budget_Cycle
																Related_Record_Display="Raw Material Cost Refresh"
																Action="System Recalculated"
																From_Status="Raw Material Budget"
																To_Status=newStatus
																Iteration_Number=input.Iteration_Count
																Actor_Email=zoho.loginuserid
																Action_On=zoho.currenttime
																Remarks="Raw_Material_Cost refreshed from approved raw material budgets."
																Added_User=zoho.loginuser
															];
														}
														if(isFinalLock == true)
														{
															sendmail
															[
																from :zoho.adminuserid
																to :zoho.adminuserid
																cc:input.Owner_Email
																subject :"Raw Material Budget Locked: " + input.RM_Budget_No
																message :"Raw Material Budget " + input.RM_Budget_No + " is approved and locked. Financial Consolidations have been refreshed with approved raw-material cost."
															]
														}
														input.Approver_Action = null;
													}
									)
								}
							}
			
						
			}

			Raw_Material_Budgets_On_Load as "Raw Material Budgets On Load"
			{
			
							type =  form
							form = Raw_Material_Budgets
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													disable Annual_Requirement_MT;
													disable Available_Raw_Material_Total_MT;
													disable To_Be_Raised_Total_MT;
													disable Cost_Forecast_Total;
													disable Status;
													disable Iteration_Count;
													disable Locked;
													disable Owner_Email;
													hide Approver_Action;
													hide Approval_Remarks;
													disable Approver_Action;
													disable Approval_Remarks;
													if(input.Budget_Cycle != null && input.Requested_Financial_Year == null)
													{
														cycleRecForFY = Budget_Cycles[ID == input.Budget_Cycle];
														if(cycleRecForFY.count() > 0)
														{
															input.Requested_Financial_Year = cycleRecForFY.Financial_Year;
														}
													}
													if(input.Locked == true)
													{
														disable Budget_Cycle;
														disable Requested_Financial_Year;
														disable Plant;
														disable Material;
														disable Previous_Year_Price;
														disable Market_Price_Month_1;
														disable Market_Price_Month_2;
														disable Market_Price_Month_3;
														disable Lead_Time_Days;
														disable In_Plant_Inventory_MT;
														disable In_Transit_Inventory_MT;
													}
													isSourcing = thisapp.permissions.isUserInProfile("Sourcing_Team");
													isSourcingManager = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													delegatedSourcing = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Sourcing_Team" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedManager = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "SCM_Central_PPC" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedFinance = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Finance_Costing" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													canAct = false;
													if(input.Status == "Draft" || input.Status == "Returned by Sourcing Manager" || input.Status == "Returned by Finance" || input.Status == "Reopened" && isSourcing || isAdmin || delegatedSourcing)
													{
														canAct = true;
													}
													else if(input.Status == "Submitted to Sourcing Manager" && isSourcingManager || isAdmin || delegatedManager)
													{
														canAct = true;
													}
													else if(input.Status == "Submitted to Finance" || input.Status == "Approved" && isFinance || isAdmin || delegatedFinance)
													{
														canAct = true;
													}
													else if(input.Status == "Locked" && isFinance || isAdmin || delegatedFinance)
													{
														canAct = true;
													}
													if(canAct == true)
													{
														show Approver_Action;
														enable Approver_Action;
														if(input.Approver_Action == "Return" || input.Approver_Action == "Reopen")
														{
															show Approval_Remarks;
															enable Approval_Remarks;
														}
													}
									)
								}
							}
			
						
			}

			Raw_Material_Budgets_Validate as "Raw Material Budgets Validate"
			{
			
							type =  form
							form = Raw_Material_Budgets
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
													if(input.Budget_Cycle != null && input.Requested_Financial_Year == null)
													{
														cycleRecForFY = Budget_Cycles[ID == input.Budget_Cycle];
														if(cycleRecForFY.count() > 0)
														{
															input.Requested_Financial_Year = cycleRecForFY.Financial_Year;
														}
													}
													if(ifNull(input.Previous_Year_Price,0) < 0 || ifNull(input.Market_Price_Month_1,0) < 0 || ifNull(input.Market_Price_Month_2,0) < 0 || ifNull(input.Market_Price_Month_3,0) < 0)
													{
														alert "Raw material prices cannot be negative.";
														cancel submit;
													}
													budgetPrice = (ifNull(input.Market_Price_Month_1,0) + ifNull(input.Market_Price_Month_2,0) + ifNull(input.Market_Price_Month_3,0)) / 3;
													annualRequirement = 0.0;
													availableTotal = 0.0;
													toBeRaisedTotal = 0.0;
													costForecastTotal = 0.0;
													monthList = list();
													materialRecord = Raw_Materials[ID == input.Material];
													isNickelSource = false;
													if(materialRecord.count() > 0 && materialRecord.Is_Nickel_Source == true)
													{
														isNickelSource = true;
													}
													for each  rmMonth in input.Monthly_RM_Budget_Lines
													{
														if(rmMonth.Month == null || rmMonth.Month == "")
														{
															alert "Month is required in every raw material budget row.";
															cancel submit;
														}
														if(monthList.contains(rmMonth.Month))
														{
															alert "Duplicate month found in raw material budget rows: " + rmMonth.Month + ".";
															cancel submit;
														}
														monthList.add(rmMonth.Month);
														if(ifNull(rmMonth.Requirement_MT,0) < 0 || ifNull(rmMonth.Required_Raw_Material_MT,0) < 0 || ifNull(rmMonth.Available_Raw_Material_MT,0) < 0 || ifNull(rmMonth.To_Be_Raised_MT,0) < 0 || ifNull(rmMonth.Cost_Forecast,0) < 0 || ifNull(rmMonth.Scrap_Percent,0) < 0 || ifNull(rmMonth.NPI_Percent,0) < 0 || ifNull(rmMonth.Ferro_Nickel_Percent,0) < 0 || ifNull(rmMonth.Pure_Metal_Percent,0) < 0)
														{
															alert "Monthly requirement, availability, shortfall, cost, and nickel mix values cannot be negative.";
															cancel submit;
														}
														mixTotal = ifNull(rmMonth.Scrap_Percent,0) + ifNull(rmMonth.NPI_Percent,0) + ifNull(rmMonth.Ferro_Nickel_Percent,0) + ifNull(rmMonth.Pure_Metal_Percent,0);
														if(isNickelSource == true && mixTotal != 100)
														{
															alert "For nickel-source materials, Scrap + NPI + Ferro Nickel + Pure Metal percentages must total 100 for " + rmMonth.Month + ".";
															cancel submit;
														}
														if(rmMonth.Month == "Apr")
														{
															rmMonth.Month_Order=1;
														}
														else if(rmMonth.Month == "May")
														{
															rmMonth.Month_Order=2;
														}
														else if(rmMonth.Month == "Jun")
														{
															rmMonth.Month_Order=3;
														}
														else if(rmMonth.Month == "Jul")
														{
															rmMonth.Month_Order=4;
														}
														else if(rmMonth.Month == "Aug")
														{
															rmMonth.Month_Order=5;
														}
														else if(rmMonth.Month == "Sep")
														{
															rmMonth.Month_Order=6;
														}
														else if(rmMonth.Month == "Oct")
														{
															rmMonth.Month_Order=7;
														}
														else if(rmMonth.Month == "Nov")
														{
															rmMonth.Month_Order=8;
														}
														else if(rmMonth.Month == "Dec")
														{
															rmMonth.Month_Order=9;
														}
														else if(rmMonth.Month == "Jan")
														{
															rmMonth.Month_Order=10;
														}
														else if(rmMonth.Month == "Feb")
														{
															rmMonth.Month_Order=11;
														}
														else if(rmMonth.Month == "Mar")
														{
															rmMonth.Month_Order=12;
														}
														requiredMaterial = ifNull(rmMonth.Required_Raw_Material_MT,0);
														if(requiredMaterial == 0 && ifNull(rmMonth.Requirement_MT,0) > 0)
														{
															requiredMaterial = ifNull(rmMonth.Requirement_MT,0);
															rmMonth.Required_Raw_Material_MT = requiredMaterial;
														}
														availableMaterial = ifNull(rmMonth.Available_Raw_Material_MT,0);
														shortfall = requiredMaterial - availableMaterial;
														if(shortfall < 0)
														{
															shortfall = 0;
														}
														calculatedForecast = shortfall * budgetPrice;
														if(rmMonth.Cost_Forecast != null && rmMonth.Cost_Forecast != calculatedForecast && (rmMonth.Override_Reason == null || rmMonth.Override_Reason == ""))
														{
															alert "Override Reason is required when a row Cost Forecast is manually changed.";
															cancel submit;
														}
														else if(rmMonth.Cost_Forecast == null || rmMonth.Cost_Forecast == 0 || rmMonth.Override_Reason == null || rmMonth.Override_Reason == "")
														{
															rmMonth.Cost_Forecast = calculatedForecast;
														}
														rmMonth.To_Be_Raised_MT = shortfall;
														annualRequirement = annualRequirement + requiredMaterial;
														availableTotal = availableTotal + availableMaterial;
														toBeRaisedTotal = toBeRaisedTotal + shortfall;
														costForecastTotal = costForecastTotal + ifNull(rmMonth.Cost_Forecast,0);
													}
													input.Annual_Requirement_MT = annualRequirement;
													input.Available_Raw_Material_Total_MT = availableTotal;
													input.To_Be_Raised_Total_MT = toBeRaisedTotal;
													input.Cost_Forecast_Total = costForecastTotal;
													if(ifNull(input.Lead_Time_Days,0) < 0 || ifNull(input.In_Plant_Inventory_MT,0) < 0 || ifNull(input.In_Transit_Inventory_MT,0) < 0)
													{
														alert "Lead time and inventory assumptions cannot be negative.";
														cancel submit;
													}
													if((input.Approver_Action == "Return" || input.Approver_Action == "Reopen") && (input.Approval_Remarks == null || input.Approval_Remarks == ""))
													{
														alert(Approval_Remarks,"Approval remarks are required for Return/Reopen actions.");
														cancel submit;
													}
													isSourcing = thisapp.permissions.isUserInProfile("Sourcing_Team");
													isSourcingManager = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													delegatedSourcing = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Sourcing_Team" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedManager = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "SCM_Central_PPC" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedFinance = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Finance_Costing" && Module_Name == "Raw Material Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													roleAllowed = false;
													actionValid = false;
													if(input.Approver_Action != null && input.Approver_Action != "")
													{
														if((input.Status == "Draft" || input.Status == "Returned by Sourcing Manager" || input.Status == "Returned by Finance" || input.Status == "Reopened") && input.Approver_Action == "Submit")
														{
															actionValid = true;
															roleAllowed = isSourcing || isAdmin || delegatedSourcing;
														}
														else if(input.Status == "Submitted to Sourcing Manager" && (input.Approver_Action == "Approve" || input.Approver_Action == "Return"))
														{
															actionValid = true;
															roleAllowed = isSourcingManager || isAdmin || delegatedManager;
														}
														else if(input.Status == "Submitted to Finance" && (input.Approver_Action == "Approve" || input.Approver_Action == "Return" || input.Approver_Action == "Lock"))
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														else if(input.Status == "Approved" && input.Approver_Action == "Lock")
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														else if(input.Status == "Locked" && input.Approver_Action == "Reopen")
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														if(actionValid == false)
														{
															alert(Approver_Action,"The selected action is not valid for the current RM Budget status.");
															cancel submit;
														}
														if(roleAllowed == false)
														{
															alert "Your profile or active delegation is not authorised for this RM Budget action.";
															cancel submit;
														}
													}
													if(input.Locked == true && !((input.Approver_Action == "Reopen" && input.Status == "Locked" && isFinance) || isAdmin || delegatedFinance))
													{
														alert "This Raw Material Budget is locked. Only Finance/System Administrator can reopen it through Approver Action = Reopen.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Log_Raw_Material_Master_Data as "Log Raw Material Master Data"
			{
			
							type =  form
							form = Raw_Materials
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														info "Master data change - Raw Materials | ID: " + input.ID + " | Code: " + input.Material_Code + " | Name: " + input.Material_Name + " | Group: " + input.Material_Group + " | UOM: " + input.Unit_Of_Measure + " | Nickel Source: " + input.Is_Nickel_Source + " | Active: " + input.Active;
									)
