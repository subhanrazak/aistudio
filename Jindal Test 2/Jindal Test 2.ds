						SCM_Decision
						Status
						Owner_Email
					)
					filters
					(
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Decision
						Status
						Owner_Email
					)
					sort by
					(
						Consolidation_No descending
					)
				
		}

		list SCM_Ready_For_Review
		{
		
					displayName = "SCM Ready For Review"
					show all rows from Volume_Consolidations [Status == "Under SCM Review"]
					(
						Consolidation_No
						Requested_Financial_Year
						Budget_Cycle
						Plant
						Sales_Plan
						Availability_Plan
						Operations_Production_Plan
						SCM_Review_Lines
						SCM_Decision
						Status
						Owner_Email
					)
					filters
					(
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Decision
						Status
						Owner_Email
					)
					sort by
					(
						Consolidation_No descending
					)
				
		}

		list SCM_Revision_Requests
		{
		
					displayName = "SCM Revision Requests"
					show all rows from Volume_Consolidations [Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending"]
					(
						Consolidation_No
						Requested_Financial_Year
						Budget_Cycle
						Plant
						Sales_Plan
						Availability_Plan
						Operations_Production_Plan
						SCM_Decision
						Revision_History_Lines
						Latest_Revision_No
						Status
						Owner_Email
					)
					filters
					(
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Decision
						Status
						Owner_Email
					)
					sort by
					(
						Consolidation_No descending
					)
				
		}

		list Sales_Shortfall_Buckets
		{
		
					displayName = "Sales Shortfall Buckets"
					show all rows from Volume_Consolidations [Status == "Sales Revision Pending" || Status == "Both Revisions Pending"]
					(
						Consolidation_No
						Requested_Financial_Year
						Budget_Cycle
						Plant
						Sales_Plan
						SCM_Review_Lines
						SCM_Decision
						Status
						Owner_Email
					)
					filters
					(
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Decision
						Status
						Owner_Email
					)
					sort by
					(
						Consolidation_No descending
					)
				
		}

		list Shortfall_Buckets
		{
		
					displayName = "Shortfall Buckets"
					show all rows from Volume_Consolidations [Status != "Locked"]
					(
						Consolidation_No
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Review_Lines
						SCM_Decision
						Status
						Owner_Email
					)
					filters
					(
						Requested_Financial_Year
						Budget_Cycle
						Plant
						SCM_Decision
						Status
						Owner_Email
					)
					sort by
					(
						Consolidation_No descending
					)
				
		}
	}

	pages
	{
		page Audit_Landing
		{
					displayname = "Audit Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Audit_Landing_Snippet' elementName='Audit_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Audit_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Auditor&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;}].count();\n\treturned = Approval_Audit_Log[Action == &quot;Returned&quot;].count();\n\treopened = Approval_Audit_Log[Action == &quot;Reopened&quot;].count();\n\tdelegations = Approval_Delegations[Active == true].count();\n\tlockedCycles = Budget_Cycles[Status == &quot;Locked&quot; || Approved_Scenario == true].count();\n\tapprovedSales = Sales_Plans[Status == &quot;Approved and Locked&quot;].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Audit &amp; Delegation Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Monitor approvals, critical events and active delegation coverage.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Critical_Audit_Events&apos;&gt;&lt;span&gt;Critical events&lt;/span&gt;&lt;strong&gt;&lt;%=criticalEvents%&gt;&lt;/strong&gt;&lt;span&gt;Returned, reopened, locked and final approval events&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Approval_Delegations&apos;&gt;&lt;span&gt;Active delegations&lt;/span&gt;&lt;strong&gt;&lt;%=delegations%&gt;&lt;/strong&gt;&lt;span&gt;Delegation records currently active&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Locked_Baselines&apos;&gt;&lt;span&gt;Locked baselines&lt;/span&gt;&lt;strong&gt;&lt;%=lockedCycles%&gt;&lt;/strong&gt;&lt;span&gt;Approved scenario or locked cycle records&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Sales_Plans&apos;&gt;&lt;span&gt;Approved sales plans&lt;/span&gt;&lt;strong&gt;&lt;%=approvedSales%&gt;&lt;/strong&gt;&lt;span&gt;Sales records approved and locked&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Critical_Audit_Events&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline files-exclamation dl-icon&apos;&gt;&lt;/i&gt; Review critical audit events&lt;/span&gt;&lt;b&gt;&lt;%=criticalEvents%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Active_Delegations&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline users-network dl-icon&apos;&gt;&lt;/i&gt; Review active delegations&lt;/span&gt;&lt;b&gt;&lt;%=delegations%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Audit_By_Cycle&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-money-time dl-icon&apos;&gt;&lt;/i&gt; Audit by cycle&lt;/span&gt;&lt;b&gt;View&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Audit mix&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=returned%&gt; returned actions and &lt;%=reopened%&gt; reopened actions are present in audit logs.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Governance watch&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;Track active delegations against high-impact budget approval events.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page COE_Landing
		{
					displayname = "COE Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='COE_Landing_Snippet' elementName='COE_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage COE_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;COE Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tcoeQueue = Sales_Plans[Status == &quot;Submitted to COE&quot;].count();\n\treturned = Sales_Plans[Status.contains(&quot;Returned&quot;)].count();\n\tsubmittedNext = Sales_Plans[Status == &quot;Submitted to SCM&quot; || Status == &quot;Submitted to Operations&quot;].count();\n\tapproved = Sales_Plans[Status == &quot;Approved and Locked&quot;].count();\n\tsegments = Market_Segments[ID != 0].count();\n\tgrades = Steel_Grades[ID != 0].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;COE Department Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Validate sales plan completeness and move clean plans to downstream review.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:COE_Sales_Plan_Approval_Queue&apos;&gt;&lt;span&gt;COE pending&lt;/span&gt;&lt;strong&gt;&lt;%=coeQueue%&gt;&lt;/strong&gt;&lt;span&gt;Sales plans waiting for COE action&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Sales_Plans&apos;&gt;&lt;span&gt;Returned plans&lt;/span&gt;&lt;strong&gt;&lt;%=returned%&gt;&lt;/strong&gt;&lt;span&gt;Rows returned to owners&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Sales_Plan_Approval_Queue&apos;&gt;&lt;span&gt;Moved forward&lt;/span&gt;&lt;strong&gt;&lt;%=submittedNext%&gt;&lt;/strong&gt;&lt;span&gt;Rows sent to SCM or Operations&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Sales_Plans&apos;&gt;&lt;span&gt;Approved&lt;/span&gt;&lt;strong&gt;&lt;%=approved%&gt;&lt;/strong&gt;&lt;span&gt;Final approved sales plans&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:COE_Sales_Plan_Approval_Queue&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-signature dl-icon&apos;&gt;&lt;/i&gt; Review COE approval queue&lt;/span&gt;&lt;b&gt;&lt;%=coeQueue%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-progress dl-icon&apos;&gt;&lt;/i&gt; Track sales plan status&lt;/span&gt;&lt;b&gt;&lt;%=coeQueue + submittedNext%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Reference coverage&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=segments%&gt; market segments and &lt;%=grades%&gt; steel grades support COE validation.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Exception watch&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=returned%&gt; returned rows indicate quality or approval feedback to resolve.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Executive_Budget_Dashboard
		{
					displayname = "Executive Budget Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Executive_KPI_Cards' elementName='Executive_KPI_Cards' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Executive_KPI_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tactiveCycleCount = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tcompletedCycleCount = Budget_Cycles[Status == &quot;Completed&quot; || Status == &quot;Closed&quot;].count();\n\tapprovedSalesCount = Sales_Plans[Status == &quot;Sales Approved&quot; || Locked == true].count();\n\tapprovedOpsAvailability = Capacity_TEP_Plans[Status == &quot;Operations Approved&quot; || Locked == true].count();\n\tapprovedOpsProduction = Operations_Production_Plans[Status == &quot;Operations Approved&quot; || Locked == true].count();\n\tscmReadyCount = Volume_Consolidations[Status == &quot;Under SCM Review&quot; || Status == &quot;SCM Approved&quot; || Status == &quot;Submitted to Finance&quot;].count();\n\tfinanceCompletedCount = Financial_Consolidations[Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Status == &quot;Approved Final&quot;].count();\n\tcriticalEvents = Approval_Audit_Log[Action == &quot;Revision Requested&quot; || Action == &quot;Revision Copy Created&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n%&gt;\n&lt;style&gt;\n.ebd-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:16px}.ebd-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:16px}.ebd-label{font-size:12px;color:var(--zcs_secondary_text_color);text-transform:uppercase;letter-spacing:.04em}.ebd-value{font-size:26px;font-weight:700;color:var(--zcs_primary_text_color);margin-top:8px}.ebd-section-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin-bottom:16px}.ebd-section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.ebd-section-title h2{margin:0;color:var(--zcs_primary_text_color);font-size:18px}.ebd-muted{color:var(--zcs_secondary_text_color)}.ebd-feed{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ebd-feed-item{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px;margin-bottom:8px}.ebd-feed-title{display:flex;justify-content:space-between;gap:10px}.ebd-small{font-size:12px}.ebd-matrix-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;overflow:hidden}.ebd-matrix-head,.ebd-matrix-cell{padding:10px;border-top:1px solid var(--zcs_tertiary_border_color)}.ebd-matrix-head{background:#f9fafe;font-weight:600;color:var(--zcs_primary_text_color);border-top:0}.zcs-red{color:#fe455d}.zcs-green{color:#179e6c}@media(max-width:900px){.ebd-grid,.ebd-feed{grid-template-columns:1fr}.ebd-matrix-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&quot;ebd-grid&quot;&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Active cycles&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=activeCycleCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Sales approved&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=approvedSalesCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Ops approved&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=approvedOpsAvailability + approvedOpsProduction%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;SCM ready/final&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=scmReadyCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Finance completed&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=financeCompletedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Completed cycles&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=completedCycleCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Critical events&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=criticalEvents%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Revision requests&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count()%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Approval_Bottlenecks' elementName='Approval_Bottlenecks' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Approval_Bottlenecks()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tsalesAwaiting = Sales_Plans[Status == &quot;Submitted to COE&quot; || Status == &quot;Submitted to SCM&quot; || Status == &quot;Submitted to Operations&quot; || Status == &quot;Submitted to Sales Head&quot; || Status == &quot;Submitted to Global Sales Head&quot; || Status == &quot;Submitted to SCM Head&quot;].count();\n\tsalesReturned = Sales_Plans[Status.contains(&quot;Returned&quot;)].count();\n\tsalesApproved = Sales_Plans[Status == &quot;Approved and Locked&quot; || Locked == true].count();\n\tvolumeAwaiting = Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\tvolumeReturned = Volume_Consolidations[Status == &quot;Returned to Sales&quot;].count();\n\tvolumeApproved = Volume_Consolidations[Status == &quot;Balanced&quot; || Status == &quot;SCM Head Finalised&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tfinancialAwaiting = Financial_Consolidations[Status == &quot;Submitted to Management&quot;].count();\n\tfinancialReturned = Financial_Consolidations[Status == &quot;Returned by Management&quot;].count();\n\tfinancialApproved = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tcutoff = zoho.currenttime.subDay(7);\n\toverdueReturns = Approval_Audit_Log[Action == &quot;Returned&quot; &amp;&amp; Action_On &lt; cutoff] sort by Action_On asc range from 0 to 4;\n\toverdueCount = Approval_Audit_Log[Action == &quot;Returned&quot; &amp;&amp; Action_On &lt; cutoff].count();\n\t%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t\t&lt;div class=&quot;ebd-section-title&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;ebd-icon-ring&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;h2&gt;Approval Bottlenecks&lt;/h2&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-simple-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=overdueCount%&gt; overdue returns&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Module&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Awaiting approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Returned&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Approved or locked&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Sales Plan&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=salesAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=salesReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=salesApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Volume Consolidation&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=volumeAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=volumeReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=volumeApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Financial Consolidation&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=financialAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=financialReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=financialApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot; style=&quot;margin-top:16px;margin-bottom:8px;&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-alert-circle-i zcs-color-yellow&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;Oldest returned approvals past 7 days&lt;/strong&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ebd-feed-list&quot;&gt;\n&lt;%\n\tif(overdueReturns.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item ebd-muted zcs-font-14&quot;&gt;No overdue returned approvals at this time.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  audit in overdueReturns\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ebd-feed-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=audit.Module_Name%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.Action_On%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ebd-muted zcs-font-13&quot;&gt;&lt;%=audit.Related_Record_Display%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13&quot;&gt;Returned to: &lt;span class=&quot;zcs-color-yellow&quot;&gt;&lt;%=audit.To_Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Plant_Status_Matrix' elementName='Plant_Status_Matrix' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Status_Matrix()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tplants = Plants[Active == true] sort by Plant_Name asc;\n\tfinancialTotal = Financial_Consolidations[ID != 0].count();\n\tfinancialDone = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot;].count();\n\tfinancialPct = 0;\n\tif(financialTotal != 0)\n\t{\n\t\tfinancialPct = financialDone * 100 / financialTotal;\n\t}\n%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t&lt;div class=&quot;ebd-section-title&quot;&gt;&lt;h2&gt;Plant Status Matrix&lt;/h2&gt;&lt;span class=&quot;ebd-muted&quot;&gt;Financial sign-off &lt;%=financialPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-matrix-grid&quot;&gt;\n\t\t&lt;div class=&quot;ebd-matrix-head&quot;&gt;Plant&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;Operations availability&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;Operations production&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;SCM reviews&lt;/div&gt;\n&lt;%\n\tif(plants.count() == 0)\n\t{\n%&gt;\n\t\t&lt;div class=&quot;ebd-matrix-cell&quot; style=&quot;grid-column:1 / -1;&quot;&gt;No active plants configured.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each plant in plants\n\t\t{\n\t\t\tavail = Capacity_TEP_Plans[Plant == plant.ID &amp;&amp; Status == &quot;Operations Approved&quot;].count();\n\t\t\tprod = Operations_Production_Plans[Plant == plant.ID &amp;&amp; Status == &quot;Operations Approved&quot;].count();\n\t\t\tscm = Volume_Consolidations[Plant == plant.ID &amp;&amp; Status != &quot;Waiting for Sales and Operations Approval&quot;].count();\n%&gt;\n\t\t&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;strong&gt;&lt;%=plant.Plant_Name%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=avail%&gt; approved&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=prod%&gt; approved&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=scm%&gt; active/final&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Exception_Feed' elementName='Exception_Feed' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Exception_Feed()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\trevisions = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;] sort by Consolidation_No desc range from 0 to 5;\n\treturnedApprovals = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Revision Requested&quot;] sort by Action_On desc range from 0 to 5;\n%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t&lt;div class=&quot;ebd-section-title&quot;&gt;&lt;h2&gt;Exception Feed&lt;/h2&gt;&lt;span class=&quot;ebd-muted&quot;&gt;Revision requests and returned approvals&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-feed&quot;&gt;\n\t\t&lt;div&gt;&lt;strong&gt;SCM revision requests&lt;/strong&gt;\n&lt;%\n\tif(revisions.count() == 0)\n\t{\n%&gt;\n\t\t\t&lt;div class=&quot;ebd-feed-item ebd-muted&quot;&gt;No active SCM revision requests.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each vc in revisions\n\t\t{\n%&gt;\n\t\t\t&lt;div class=&quot;ebd-feed-item&quot;&gt;&lt;div class=&quot;ebd-feed-title&quot;&gt;&lt;strong&gt;&lt;%=vc.Consolidation_No%&gt;&lt;/strong&gt;&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=vc.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=vc.Requested_Financial_Year.Year_Name%&gt; | &lt;%=vc.Plant.Plant_Name%&gt;&lt;/div&gt;&lt;div&gt;&lt;%=vc.SCM_Decision%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div&gt;&lt;strong&gt;Audit exceptions&lt;/strong&gt;\n&lt;%\n\tif(returnedApprovals.count() == 0)\n\t{\n%&gt;\n\t\t\t&lt;div class=&quot;ebd-feed-item ebd-muted&quot;&gt;No returned approvals in the audit log.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each audit in returnedApprovals\n\t\t{\n%&gt;\n\t\t\t&lt;div class=&quot;ebd-feed-item&quot;&gt;&lt;div class=&quot;ebd-feed-title&quot;&gt;&lt;strong&gt;&lt;%=audit.Module_Name%&gt;&lt;/strong&gt;&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.Action_On%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;%=audit.Related_Record_Display%&gt;&lt;/div&gt;&lt;div class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.From_Status%&gt; to &lt;%=audit.To_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Critical_Audit_Events' title='Critical Audit Events' boldTitle='true' titleColor='#12132B' appLinkName='thisapp' linkName='Critical_Audit_Events' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Executive_Landing
		{
					displayname = "Executive Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Executive_Landing_Snippet' elementName='Executive_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Executive_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Executive Management&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tactiveCycles = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tmanagementQueue = Financial_Consolidations[Status == &quot;Submitted to Management&quot;].count();\n\tfinalBudgets = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tshortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\tcriticalEvents = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Reopened&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n\treplans = Replanning_Requests[Status in {&quot;Submitted to Finance&quot;,&quot;Finance Approved&quot;,&quot;Revision Created&quot;}].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Executive Management Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). View enterprise budget readiness, scenario decisions and final approval signals.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Active_Budget_Cycles&apos;&gt;&lt;span&gt;Active cycles&lt;/span&gt;&lt;strong&gt;&lt;%=activeCycles%&gt;&lt;/strong&gt;&lt;span&gt;Cycles still in planning or review&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Scenario_Financial_Summary&apos;&gt;&lt;span&gt;Management queue&lt;/span&gt;&lt;strong&gt;&lt;%=managementQueue%&gt;&lt;/strong&gt;&lt;span&gt;Financial records awaiting decision&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Final_Budgets&apos;&gt;&lt;span&gt;Final budgets&lt;/span&gt;&lt;strong&gt;&lt;%=finalBudgets%&gt;&lt;/strong&gt;&lt;span&gt;Approved or locked final budget records&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Management_Critical_Audit_Events&apos;&gt;&lt;span&gt;Critical events&lt;/span&gt;&lt;strong&gt;&lt;%=criticalEvents%&gt;&lt;/strong&gt;&lt;span&gt;High-impact audit actions&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Page:Executive_Budget_Dashboard&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-chart dl-icon&apos;&gt;&lt;/i&gt; Open executive dashboard&lt;/span&gt;&lt;b&gt;View&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Scenario_Financial_Summary&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-signature dl-icon&apos;&gt;&lt;/i&gt; Review management submissions&lt;/span&gt;&lt;b&gt;&lt;%=managementQueue%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Active_Replanning_Requests&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 dl-icon&apos;&gt;&lt;/i&gt; Monitor replanning requests&lt;/span&gt;&lt;b&gt;&lt;%=replans%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Exception load&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=shortfalls%&gt; shortfall buckets and &lt;%=criticalEvents%&gt; critical audit events are visible.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Budget readiness&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=finalBudgets%&gt; final budget records are approved or locked.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Finance_Landing
		{
					displayname = "Finance Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Finance_Landing_Snippet' elementName='Finance_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Finance_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Finance Costing&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tactiveCycles = Budget_Cycles[Status == &quot;Open&quot; || Status == &quot;In Planning&quot; || Status == &quot;Under Review&quot; || Status == &quot;Reopened&quot;].count();\n\tfinanceDrafts = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tmanagementQueue = Financial_Consolidations[Status == &quot;Submitted to Management&quot;].count();\n\trmFinance = Raw_Material_Budgets[Status == &quot;Submitted to Finance&quot;].count();\n\tconsFinance = Consumables_Budgets[Status == &quot;Submitted to Finance&quot;].count();\n\treplanQueue = Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;Revision Created&quot;].count();\n\tfinalBudgets = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Finance &amp; Costing Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Coordinate cycles, financial consolidation, replanning and final budget readiness.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Active_Budget_Cycles&apos;&gt;&lt;span&gt;Active cycles&lt;/span&gt;&lt;strong&gt;&lt;%=activeCycles%&gt;&lt;/strong&gt;&lt;span&gt;Cycles in planning or review&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Financial_Consolidations&apos;&gt;&lt;span&gt;My finance drafts&lt;/span&gt;&lt;strong&gt;&lt;%=financeDrafts%&gt;&lt;/strong&gt;&lt;span&gt;Draft, returned or reopened consolidations&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Scenario_Financial_Summary&apos;&gt;&lt;span&gt;Management queue&lt;/span&gt;&lt;strong&gt;&lt;%=managementQueue%&gt;&lt;/strong&gt;&lt;span&gt;Financial consolidations awaiting management&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Final_Budgets&apos;&gt;&lt;span&gt;Final budgets&lt;/span&gt;&lt;strong&gt;&lt;%=finalBudgets%&gt;&lt;/strong&gt;&lt;span&gt;Approved or locked final budget records&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Financial_Consolidations&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-money-growth dl-icon&apos;&gt;&lt;/i&gt; Complete finance consolidation&lt;/span&gt;&lt;b&gt;&lt;%=financeDrafts%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Raw_Material_Budgets&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-calculator dl-icon&apos;&gt;&lt;/i&gt; Raw material budget finance review&lt;/span&gt;&lt;b&gt;&lt;%=rmFinance%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Consumables_Budgets&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-math dl-icon&apos;&gt;&lt;/i&gt; Consumables finance review&lt;/span&gt;&lt;b&gt;&lt;%=consFinance%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Active_Replanning_Requests&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 dl-icon&apos;&gt;&lt;/i&gt; Replanning requests&lt;/span&gt;&lt;b&gt;&lt;%=replanQueue%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Financial handoff&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=managementQueue%&gt; records are positioned for management decision.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Cross-functional load&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=rmFinance + consFinance%&gt; sourcing or plant submissions need finance attention.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Operations_Landing(int Financial_Year, int Plant, int Production_Line)
		{
					displayname = "Operations Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Landing_Snippet' elementName='Operations_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Landing_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nloginName = zoho.loginuser;\nloginEmail = zoho.loginuserid;\nprofileText = &quot;Operations PPC&quot;;\nif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n{\n\tprofileText = &quot;System Administrator&quot;;\n}\nselectedFYId = 0;\nselectedFYName = &quot;No active financial year&quot;;\nselectedPlantId = 0;\nselectedLineId = 0;\nselectedPlantName = &quot;All plants&quot;;\nselectedLineName = &quot;All production lines&quot;;\nif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n{\n\tfyRows = Financial_Years[ID == input.Financial_Year];\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nif(selectedFYId == 0)\n{\n\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nif(input.Plant != null &amp;&amp; input.Plant != 0)\n{\n\tselectedPlantId = input.Plant;\n\tplantRows = Plants[ID == selectedPlantId];\n\tfor each plantRec in plantRows\n\t{\n\t\tselectedPlantName = plantRec.Plant_Name;\n\t}\n}\nif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n{\n\tselectedLineId = input.Production_Line;\n\tlineRows = Production_Lines[ID == selectedLineId];\n\tfor each lineRec in lineRows\n\t{\n\t\tselectedLineName = lineRec.Line_Name;\n\t}\n}\nmonthCount = 0;\nif(selectedFYId != 0)\n{\n\tmonthCount = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true].count();\n}\nif(selectedFYId == 0)\n{\n\tavailabilityPlans = Capacity_TEP_Plans[ID == 0];\n\tproductionPlans = Operations_Production_Plans[ID == 0];\n}\nelse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n{\n\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId];\n\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId];\n}\nelse if(selectedPlantId != 0)\n{\n\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId];\n\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId];\n}\nelse if(selectedLineId != 0)\n{\n\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId];\n\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId];\n}\nelse\n{\n\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId];\n\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId];\n}\navDraft = 0;\navSubmitted = 0;\navApproved = 0;\navRevision = 0;\nprodDraft = 0;\nprodSubmitted = 0;\nprodApproved = 0;\nprodRevision = 0;\ntotalAvailableHours = 0.0;\ntotalNetRunningHours = 0.0;\navailabilityPctTotal = 0.0;\navailabilityPctCount = 0;\nutilizationPctTotal = 0.0;\nutilizationPctCount = 0;\nfor each capPlan in availabilityPlans\n{\n\tif(capPlan.Status == &quot;Operations Approved&quot;)\n\t{\n\t\tavApproved = avApproved + 1;\n\t\ttotalAvailableHours = totalAvailableHours + ifnull(capPlan.Annual_Available_Hours,0.0);\n\t\ttotalNetRunningHours = totalNetRunningHours + ifnull(capPlan.Annual_Net_Running_Hours,0.0);\n\t\tavailabilityPctTotal = availabilityPctTotal + ifnull(capPlan.Average_Equipment_Availability_Percent,0.0);\n\t\tavailabilityPctCount = availabilityPctCount + 1;\n\t\tutilizationPctTotal = utilizationPctTotal + ifnull(capPlan.Average_Equipment_Utilization_Percent,0.0);\n\t\tutilizationPctCount = utilizationPctCount + 1;\n\t}\n\telse if(capPlan.Status == &quot;Submitted to Operations Approval&quot;)\n\t{\n\t\tavSubmitted = avSubmitted + 1;\n\t}\n\telse if(capPlan.Status == &quot;Revision Requested by SCM&quot;)\n\t{\n\t\tavRevision = avRevision + 1;\n\t}\n\telse if(capPlan.Status == &quot;Draft&quot; || capPlan.Status == &quot;Revised Draft&quot;)\n\t{\n\t\tavDraft = avDraft + 1;\n\t}\n}\ntotalProductionTons = 0.0;\nfor each prodPlan in productionPlans\n{\n\tif(prodPlan.Status == &quot;Operations Approved&quot;)\n\t{\n\t\tprodApproved = prodApproved + 1;\n\t\ttotalProductionTons = totalProductionTons + ifnull(prodPlan.Total_FY_Production_Tons,0.0);\n\t}\n\telse if(prodPlan.Status == &quot;Submitted to Operations Approval&quot;)\n\t{\n\t\tprodSubmitted = prodSubmitted + 1;\n\t}\n\telse if(prodPlan.Status == &quot;Revision Requested by SCM&quot;)\n\t{\n\t\tprodRevision = prodRevision + 1;\n\t}\n\telse if(prodPlan.Status == &quot;Draft&quot; || prodPlan.Status == &quot;Revised Draft&quot;)\n\t{\n\t\tprodDraft = prodDraft + 1;\n\t}\n}\navgAvailability = 0.0;\nif(availabilityPctCount &gt; 0)\n{\n\tavgAvailability = availabilityPctTotal / availabilityPctCount;\n}\navgUtilization = 0.0;\nif(utilizationPctCount &gt; 0)\n{\n\tavgUtilization = utilizationPctTotal / utilizationPctCount;\n}\n%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-font-11{font-size:.6875rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background:#F4660C;border-color:#F4660C;color:#fff}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;z-index:3}.zcs-table-wrapper table thead tr th{background:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background:#fff;box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:hover td{background:var(--zcs-tr-h-color)}.zcs-nodata-wrapper{min-height:220px}.op-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.op-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:24px;display:flex;justify-content:space-between;gap:16px;align-items:center}.op-hero h2{margin:0 0 6px;font-size:26px}.op-hero p{margin:0;opacity:.92}.op-hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.op-filter-card,.op-section{margin-top:16px;padding:18px;box-sizing:border-box}.op-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.zcs-template-card.op-kpi{width:auto;height:auto;min-height:142px;overflow:hidden}.op-kpi .zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color);padding:14px 16px}.op-kpi .zcs-card-content{padding:16px}.op-kpi-value{display:block;font-size:27px;line-height:1.1;font-weight:700;color:var(--zcs_primary_text_color);margin-bottom:8px}.op-kpi-caption{color:var(--zcs_secondary_text_color);font-size:13px}.op-section-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}.op-section-head h3,.op-filter-card h3{margin:0 0 5px;font-size:19px;color:var(--zcs_primary_text_color)}.op-section-head p,.op-filter-card p{margin:0;color:var(--zcs_secondary_text_color);font-size:13px}.op-filter-row{display:flex;align-items:flex-start;gap:12px;margin-top:12px;flex-wrap:wrap}.op-filter-label{min-width:120px;color:var(--zcs_secondary_text_color);font-size:13px;font-weight:600;padding-top:5px}.op-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--zcs_tertiary_border_color);border-radius:999px;padding:6px 11px;text-decoration:none;color:var(--zcs_primary_text_color);background:#fff;font-size:13px}.op-chip:hover,.op-chip.active{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.op-status-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}.op-status-box{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px;background:#fff}.op-status-box b{display:block;font-size:21px}.op-matrix-wrapper{max-height:620px}.op-matrix-table{min-width:980px}.op-matrix-table th,.op-matrix-table td{white-space:nowrap}.op-sticky-col{position:sticky;left:0;z-index:2;background:#fff;min-width:230px}.op-matrix-table thead .op-sticky-col{z-index:4;background:var(--zcs-thead-color)}.op-total-cell{background:#fbfcff;font-weight:600}.op-product-col{min-width:210px}.op-product-col strong{display:block}.op-product-col span{display:block;color:var(--zcs_secondary_text_color);font-size:12px;margin-top:2px}.op-empty{border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px;background:#fbfcff}.op-empty-icon{font-size:42px;color:var(--zcs_brand_color)}.op-empty p{margin:8px auto 0;max-width:560px;color:var(--zcs_secondary_text_color)}.op-report-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}@media(max-width:1100px){.op-kpi-grid,.op-status-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.op-hero{flex-direction:column;align-items:flex-start}}@media(max-width:700px){.op-kpi-grid,.op-status-grid{grid-template-columns:1fr}.op-shell{padding:12px}.op-filter-label{min-width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;op-shell&apos;&gt;\n\t&lt;div class=&apos;op-hero&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h2&gt;Operations Overview Dashboard&lt;/h2&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Review approved availability and production plans without writing data.&lt;/p&gt;\n\t\t\t&lt;div class=&apos;op-hero-meta&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-grid-58&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=selectedFYName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;op-report-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Capacity_By_Line&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Capacity by Line&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Operations_Production_By_Product&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Production by Product&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% if(selectedFYId == 0 || monthCount == 0) { %&gt;\n\t&lt;div class=&apos;op-empty zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-filter-card&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-calendar-date op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Active FY or month setup is incomplete&lt;/h5&gt;\n\t\t\t&lt;p&gt;Set one Financial Year as active and add included Financial Year Months. The matrices below will populate after approved plans exist.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\t&lt;div class=&apos;op-filter-card zcs-card&apos;&gt;\n\t\t&lt;h3&gt;Filters&lt;/h3&gt;\n\t\t&lt;p&gt;Use URL parameters to focus the dashboard by Financial Year, Plant, and Production Line. Current filter: &lt;strong&gt;&lt;%=selectedFYName%&gt;&lt;/strong&gt;, &lt;strong&gt;&lt;%=selectedPlantName%&gt;&lt;/strong&gt;, &lt;strong&gt;&lt;%=selectedLineName%&gt;&lt;/strong&gt;.&lt;/p&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Financial Year&lt;/span&gt;&lt;a class=&apos;op-chip&apos; href=&apos;#Page:Operations_Landing&apos;&gt;Active FY&lt;/a&gt;&lt;%\n\t\tfyFilterRows = Financial_Years[Status != &quot;Archived&quot;] sort by Start_Date desc;\n\t\tfor each fyOpt in fyFilterRows\n\t\t{\n\t\t\tfyUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + fyOpt.ID;\n\t\t\tif(selectedPlantId != 0) { fyUrl = fyUrl + &quot;&amp;Plant=&quot; + selectedPlantId; }\n\t\t\tif(selectedLineId != 0) { fyUrl = fyUrl + &quot;&amp;Production_Line=&quot; + selectedLineId; }\n\t\t\tchipClass = &quot;op-chip&quot;;\n\t\t\tif(fyOpt.ID == selectedFYId) { chipClass = &quot;op-chip active&quot;; }\n\t\t\t%&gt;&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=fyUrl%&gt;&apos;&gt;&lt;%=fyOpt.Year_Name%&gt;&lt;/a&gt;&lt;%\n\t\t}\n\t\t%&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Plant&lt;/span&gt;&lt;%\n\t\tallPlantUrl = &quot;#Page:Operations_Landing&quot;;\n\t\tif(selectedFYId != 0) { allPlantUrl = allPlantUrl + &quot;?Financial_Year=&quot; + selectedFYId; }\n\t\t%&gt;&lt;a class=&apos;op-chip &lt;% if(selectedPlantId == 0) { %&gt;active&lt;% } %&gt;&apos; href=&apos;&lt;%=allPlantUrl%&gt;&apos;&gt;All plants&lt;/a&gt;&lt;%\n\t\tplantRows = Plants[Active == true] sort by Plant_Name;\n\t\tfor each plantOpt in plantRows\n\t\t{\n\t\t\tplantUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId + &quot;&amp;Plant=&quot; + plantOpt.ID;\n\t\t\tchipClass = &quot;op-chip&quot;;\n\t\t\tif(plantOpt.ID == selectedPlantId) { chipClass = &quot;op-chip active&quot;; }\n\t\t\t%&gt;&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=plantUrl%&gt;&apos;&gt;&lt;%=plantOpt.Plant_Name%&gt;&lt;/a&gt;&lt;%\n\t\t}\n\t\t%&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Production Line&lt;/span&gt;&lt;%\n\t\tallLineUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId;\n\t\tif(selectedPlantId != 0) { allLineUrl = allLineUrl + &quot;&amp;Plant=&quot; + selectedPlantId; }\n\t\t%&gt;&lt;a class=&apos;op-chip &lt;% if(selectedLineId == 0) { %&gt;active&lt;% } %&gt;&apos; href=&apos;&lt;%=allLineUrl%&gt;&apos;&gt;All lines&lt;/a&gt;&lt;%\n\t\tif(selectedPlantId != 0)\n\t\t{\n\t\t\tlineFilterRows = Production_Lines[Active == true &amp;&amp; Plant == selectedPlantId] sort by Line_Name;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tlineFilterRows = Production_Lines[Active == true] sort by Line_Name;\n\t\t}\n\t\tfor each lineOpt in lineFilterRows\n\t\t{\n\t\t\tlineUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId;\n\t\t\tif(selectedPlantId != 0) { lineUrl = lineUrl + &quot;&amp;Plant=&quot; + selectedPlantId; }\n\t\t\tlineUrl = lineUrl + &quot;&amp;Production_Line=&quot; + lineOpt.ID;\n\t\t\tchipClass = &quot;op-chip&quot;;\n\t\t\tif(lineOpt.ID == selectedLineId) { chipClass = &quot;op-chip active&quot;; }\n\t\t\t%&gt;&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=lineUrl%&gt;&apos;&gt;&lt;%=lineOpt.Line_Name%&gt;&lt;/a&gt;&lt;%\n\t\t}\n\t\t%&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;op-status-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Draft&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=avDraft + prodDraft%&gt;&lt;/b&gt;&lt;small&gt;Availability &lt;%=avDraft%&gt;, Production &lt;%=prodDraft%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Submitted&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=avSubmitted + prodSubmitted%&gt;&lt;/b&gt;&lt;small&gt;Availability &lt;%=avSubmitted%&gt;, Production &lt;%=prodSubmitted%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Approved&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=avApproved + prodApproved%&gt;&lt;/b&gt;&lt;small&gt;Availability &lt;%=avApproved%&gt;, Production &lt;%=prodApproved%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Revision Requested&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=avRevision + prodRevision%&gt;&lt;/b&gt;&lt;small&gt;Availability &lt;%=avRevision%&gt;, Production &lt;%=prodRevision%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;op-kpi-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Active Financial Year&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=selectedFYName%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;&lt;%=monthCount%&gt; included months configured&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Approved Availability Plans&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=avApproved%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;Capacity TEP plans approved by Operations&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Approved Production Plans&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=prodApproved%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;Operations production plans approved&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Total Available Hours&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=totalAvailableHours%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;FY available hours from approved plans&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Net Running Hours&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=totalNetRunningHours%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;FY net running hours after downtime&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Total Production Tons&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=totalProductionTons%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;FY production tons from approved plans&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Avg Availability / Utilization&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=avgAvailability%&gt;% / &lt;%=avgUtilization%&gt;%&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;Average equipment metrics across approved plans&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Availability_Matrix' elementName='Operations_Availability_Matrix'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Availability_Matrix()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nselectedFYId = 0;\nselectedFYName = &quot;No active financial year&quot;;\nif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n{\n\tfyRows = Financial_Years[ID == input.Financial_Year];\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nif(selectedFYId == 0)\n{\n\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nselectedPlantId = 0;\nif(input.Plant != null &amp;&amp; input.Plant != 0)\n{\n\tselectedPlantId = input.Plant;\n}\nselectedLineId = 0;\nif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n{\n\tselectedLineId = input.Production_Line;\n}\nmonthRows = Financial_Year_Months[ID == 0];\nif(selectedFYId != 0)\n{\n\tmonthRows = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true] sort by Month_Order;\n}\nif(selectedFYId == 0)\n{\n\tapprovedAvailabilityPlans = Capacity_TEP_Plans[ID == 0];\n}\nelse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n{\n\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse if(selectedPlantId != 0)\n{\n\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse if(selectedLineId != 0)\n{\n\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse\n{\n\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\n%&gt;\n&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3&gt;Plant and Line Availability Matrix&lt;/h3&gt;\n\t\t\t&lt;p&gt;Approved capacity TEP plans across configured FY months for &lt;strong&gt;&lt;%=selectedFYName%&gt;&lt;/strong&gt;.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approvedAvailabilityPlans.count()%&gt; Approved&lt;/span&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;% if(selectedFYId == 0 || monthRows.count() == 0) { %&gt;\n\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline files-2-folder-15 op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No FY month setup found&lt;/h5&gt;\n\t\t\t&lt;p&gt;Mark a financial year as active and configure included Financial Year Months before reviewing availability.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% } else if(approvedAvailabilityPlans.count() == 0) { %&gt;\n\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-ban-bold op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No approved availability plan&lt;/h5&gt;\n\t\t\t&lt;p&gt;Adjust filters or approve a Capacity TEP Plan for the selected FY, plant, and production line.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% } else { %&gt;\n\t&lt;div class=&apos;zcs-table-wrapper op-matrix-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full op-matrix-table&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;op-sticky-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Availability Metric&lt;/th&gt;\n\t\t\t\t\t&lt;% for each monthRec in monthRows { %&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthRec.Month_Label%&gt;&lt;/th&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;FY Total&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;&lt;%=monthRows.count() + 2%&gt;&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n\t\t\t&lt;%\n\t\t\tmetrics = {&quot;Calendar Hrs&quot;,&quot;Holidays&quot;,&quot;Planned Down Time&quot;,&quot;Capital Shutdown&quot;,&quot;Setup Change Time&quot;,&quot;Steckel Mill Work Roll Change&quot;,&quot;Roughing Mill Work Roll Change&quot;,&quot;Available Hrs&quot;,&quot;Unforeseen Delay/Breakdowns&quot;,&quot;Net Running Hrs&quot;,&quot;Equipment Availability&quot;,&quot;Equipment Utilization&quot;};\n\t\t\tfor each metric in metrics\n\t\t\t{\n\t\t\t\tisPercent = (metric == &quot;Equipment Availability&quot; || metric == &quot;Equipment Utilization&quot;);\n\t\t\t\tfyTotal = 0.0;\n\t\t\t\tfyCount = 0;\n\t\t\t\t%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;op-sticky-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=metric%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tfor each monthRec in monthRows\n\t\t\t\t\t{\n\t\t\t\t\t\tcellValue = 0.0;\n\t\t\t\t\t\tcellCount = 0;\n\t\t\t\t\t\tfor each planRec in approvedAvailabilityPlans\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor each monthLine in planRec.Monthly_Availability_Lines\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(monthLine.Month_Order == monthRec.Month_Order)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tlineValue = 0.0;\n\t\t\t\t\t\t\t\t\tif(metric == &quot;Calendar Hrs&quot;) { lineValue = ifnull(monthLine.Calendar_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Holidays&quot;) { lineValue = ifnull(monthLine.Holidays_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Planned Down Time&quot;) { lineValue = ifnull(monthLine.Planned_Down_Time_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Capital Shutdown&quot;) { lineValue = ifnull(monthLine.Capital_Shutdown_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Setup Change Time&quot;) { lineValue = ifnull(monthLine.Setup_Change_Time_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Steckel Mill Work Roll Change&quot;) { lineValue = ifnull(monthLine.Steckel_Mill_Work_Roll_Change_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Roughing Mill Work Roll Change&quot;) { lineValue = ifnull(monthLine.Roughing_Mill_Work_Roll_Change_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Available Hrs&quot;) { lineValue = ifnull(monthLine.Available_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Unforeseen Delay/Breakdowns&quot;) { lineValue = ifnull(monthLine.Unforeseen_Delay_Breakdowns_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Net Running Hrs&quot;) { lineValue = ifnull(monthLine.Net_Running_Hours,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Equipment Availability&quot;) { lineValue = ifnull(monthLine.Equipment_Availability_Percent,0.0); }\n\t\t\t\t\t\t\t\t\telse if(metric == &quot;Equipment Utilization&quot;) { lineValue = ifnull(monthLine.Equipment_Utilization_Percent,0.0); }\n\t\t\t\t\t\t\t\t\tcellValue = cellValue + lineValue;\n\t\t\t\t\t\t\t\t\tcellCount = cellCount + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(isPercent &amp;&amp; cellCount &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcellValue = cellValue / cellCount;\n\t\t\t\t\t\t\tfyTotal = fyTotal + cellValue;\n\t\t\t\t\t\t\tfyCount = fyCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(!isPercent)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfyTotal = fyTotal + cellValue;\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=cellValue%&gt;&lt;% if(isPercent) { %&gt;%&lt;% } %&gt;&lt;/td&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\tif(isPercent &amp;&amp; fyCount &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tfyTotal = fyTotal / fyCount;\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;td class=&apos;op-total-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=fyTotal%&gt;&lt;% if(isPercent) { %&gt;%&lt;% } %&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;%\n\t\t\t}\n\t\t\t%&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n\t&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Production_Matrix' elementName='Operations_Production_Matrix'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Production_Matrix()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nselectedFYId = 0;\nselectedFYName = &quot;No active financial year&quot;;\nif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n{\n\tfyRows = Financial_Years[ID == input.Financial_Year];\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nif(selectedFYId == 0)\n{\n\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\tfor each fyRec in fyRows\n\t{\n\t\tif(selectedFYId == 0)\n\t\t{\n\t\t\tselectedFYId = fyRec.ID;\n\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t}\n\t}\n}\nselectedPlantId = 0;\nif(input.Plant != null &amp;&amp; input.Plant != 0)\n{\n\tselectedPlantId = input.Plant;\n}\nselectedLineId = 0;\nif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n{\n\tselectedLineId = input.Production_Line;\n}\nmonthRows = Financial_Year_Months[ID == 0];\nif(selectedFYId != 0)\n{\n\tmonthRows = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true] sort by Month_Order;\n}\nif(selectedFYId == 0)\n{\n\tapprovedProductionPlans = Operations_Production_Plans[ID == 0];\n}\nelse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n{\n\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse if(selectedPlantId != 0)\n{\n\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse if(selectedLineId != 0)\n{\n\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nelse\n{\n\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n}\nproductKeys = list();\nfor each planRec in approvedProductionPlans\n{\n\tfor each productionRow in planRec.Product_Production_Lines\n\t{\n\t\tproductTextForKey = &quot;&quot;;\n\t\tif(productionRow.Product != null)\n\t\t{\n\t\t\tproductTextForKey = productionRow.Product.Grade_Code;\n\t\t}\n\t\trowKey = productTextForKey + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\tif(!productKeys.contains(rowKey))\n\t\t{\n\t\t\tproductKeys.add(rowKey);\n\t\t}\n\t}\n}\n%&gt;\n&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3&gt;Product Production Plan Matrix&lt;/h3&gt;\n\t\t\t&lt;p&gt;Product, series, size, productivity, month-wise production tons, and FY totals from approved operations production plans.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approvedProductionPlans.count()%&gt; Approved&lt;/span&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;% if(selectedFYId == 0 || monthRows.count() == 0) { %&gt;\n\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline files-2-folder-15 op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No FY month setup found&lt;/h5&gt;\n\t\t\t&lt;p&gt;Configure included Financial Year Months before reviewing production plans.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% } else if(productKeys.size() == 0) { %&gt;\n\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-ban-bold op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No approved production plan&lt;/h5&gt;\n\t\t\t&lt;p&gt;Adjust filters or approve an Operations Production Plan for the selected FY, plant, and production line.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;% } else { %&gt;\n\t&lt;div class=&apos;zcs-table-wrapper op-matrix-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full op-matrix-table op-production-table&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;op-sticky-col op-product-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Product/Series&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Width&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Thickness&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Productivity&lt;/th&gt;\n\t\t\t\t\t&lt;% for each monthRec in monthRows { %&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthRec.Month_Label%&gt;&lt;/th&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;FY Total&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;&lt;%=monthRows.count() + 5%&gt;&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n\t\t\t&lt;% for each productKey in productKeys\n\t\t\t{\n\t\t\t\tproductText = &quot;&quot;;\n\t\t\t\tseriesText = &quot;&quot;;\n\t\t\t\twidthText = &quot;&quot;;\n\t\t\t\tthicknessText = &quot;&quot;;\n\t\t\t\tproductivityText = &quot;&quot;;\n\t\t\t\tfor each planRec in approvedProductionPlans\n\t\t\t\t{\n\t\t\t\t\tfor each productionRow in planRec.Product_Production_Lines\n\t\t\t\t\t{\n\t\t\t\t\t\tprodCode = &quot;&quot;;\n\t\t\t\t\t\tif(productionRow.Product != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tprodCode = productionRow.Product.Grade_Code;\n\t\t\t\t\t\t}\n\t\t\t\t\t\trowKey = prodCode + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\t\tif(rowKey == productKey &amp;&amp; productText == &quot;&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tproductText = prodCode;\n\t\t\t\t\t\t\tseriesText = ifnull(productionRow.Series,&quot;&quot;);\n\t\t\t\t\t\t\twidthText = ifnull(productionRow.Width,&quot;&quot;);\n\t\t\t\t\t\t\tthicknessText = ifnull(productionRow.Thickness,&quot;&quot;);\n\t\t\t\t\t\t\tproductivityText = ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfyTotal = 0.0;\n\t\t\t\t%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;op-sticky-col op-product-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;strong&gt;&lt;%=productText%&gt;&lt;/strong&gt;&lt;span&gt;&lt;%=seriesText%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=widthText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=thicknessText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=productivityText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;% for each monthRec in monthRows\n\t\t\t\t\t{\n\t\t\t\t\t\tmonthTotal = 0.0;\n\t\t\t\t\t\tfor each planRec in approvedProductionPlans\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor each productionRow in planRec.Product_Production_Lines\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tprodCode = &quot;&quot;;\n\t\t\t\t\t\t\t\tif(productionRow.Product != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tprodCode = productionRow.Product.Grade_Code;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\trowKey = prodCode + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\t\t\t\tif(rowKey == productKey &amp;&amp; productionRow.Month_Order == monthRec.Month_Order)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tmonthTotal = monthTotal + ifnull(productionRow.Production_Tons,0.0);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfyTotal = fyTotal + monthTotal;\n\t\t\t\t\t\t%&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthTotal%&gt;&lt;/td&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;&lt;td class=&apos;op-total-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=fyTotal%&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n\t&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Capacity_By_Line_Embed'\n\t\t\t\ttitle='Capacity by Line'\n\t\t\t\ttitleColor='#222326'\n\t\t\t\tboldTitle='true'\n\t\t\t\tappLinkName='thisapp'\n\t\t\t\tlinkName='Capacity_By_Line'\n\t\t\t\tiszreport='false'\n\t\t\t\tzc_Footer='false'\n\t\t\t\tzc_AddRec='false'\n\t\t\t\tzc_EditRec='false'\n\t\t\t\tzc_Print='false'\n\t\t\t\tzc_Export='false'\n\t\t\t\tzc_DelRec='false'\n\t\t\t\tzc_DuplRec='false'\n\t\t\t\tzc_Search='true'\n\t\t\t\tzc_EditBulkRec='false'\n\t\t\t\tzc_BulkDelete='false'\n\t\t\t\tzc_BulkDuplicate='false'\n\t\t\t\theightType='custom'\n\t\t\t\theightValue='360' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Operations_Production_By_Product_Embed'\n\t\t\t\ttitle='Operations Production by Product'\n\t\t\t\ttitleColor='#222326'\n\t\t\t\tboldTitle='true'\n\t\t\t\tappLinkName='thisapp'\n\t\t\t\tlinkName='Operations_Production_By_Product'\n\t\t\t\tiszreport='false'\n\t\t\t\tzc_Footer='false'\n\t\t\t\tzc_AddRec='false'\n\t\t\t\tzc_EditRec='false'\n\t\t\t\tzc_Print='false'\n\t\t\t\tzc_Export='false'\n\t\t\t\tzc_DelRec='false'\n\t\t\t\tzc_DuplRec='false'\n\t\t\t\tzc_Search='true'\n\t\t\t\tzc_EditBulkRec='false'\n\t\t\t\tzc_BulkDelete='false'\n\t\t\t\tzc_BulkDuplicate='false'\n\t\t\t\theightType='custom'\n\t\t\t\theightValue='360' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Planning_Workbench
		{
					displayname = "Planning Workbench"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='My_Task_Cards' elementName='My_Task_Cards' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage My_Task_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tloginName = zoho.loginuser;\n\tisAdmin = thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;);\n\tisFinance = thisapp.permissions.isUserInProfile(&quot;Finance_Costing&quot;);\n\tisSales = thisapp.permissions.isUserInProfile(&quot;Sales_Team&quot;);\n\tisCOE = thisapp.permissions.isUserInProfile(&quot;COE_Team&quot;);\n\tisSCM = thisapp.permissions.isUserInProfile(&quot;SCM_Central_PPC&quot;);\n\tisOps = thisapp.permissions.isUserInProfile(&quot;Operations_PPC&quot;);\n\tisSMS = thisapp.permissions.isUserInProfile(&quot;SMS_Team&quot;);\n\tisSourcing = thisapp.permissions.isUserInProfile(&quot;Sourcing_Team&quot;);\n\tisPlantOps = thisapp.permissions.isUserInProfile(&quot;Plant_Operations&quot;);\n\tisSalesMgmt = thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;);\n\tisExec = thisapp.permissions.isUserInProfile(&quot;Executive_Management&quot;);\n\tisAuditor = thisapp.permissions.isUserInProfile(&quot;Auditor&quot;);\n\tprofileText = &quot;&quot;;\n\tif(isAdmin)\n\t{\n\t\tprofileText = profileText + &quot;System Administrator, &quot;;\n\t}\n\tif(isFinance)\n\t{\n\t\tprofileText = profileText + &quot;Finance Costing, &quot;;\n\t}\n\tif(isSales)\n\t{\n\t\tprofileText = profileText + &quot;Sales Team, &quot;;\n\t}\n\tif(isCOE)\n\t{\n\t\tprofileText = profileText + &quot;COE Team, &quot;;\n\t}\n\tif(isSCM)\n\t{\n\t\tprofileText = profileText + &quot;SCM Central PPC, &quot;;\n\t}\n\tif(isOps)\n\t{\n\t\tprofileText = profileText + &quot;Operations PPC, &quot;;\n\t}\n\tif(isSMS)\n\t{\n\t\tprofileText = profileText + &quot;SMS Team, &quot;;\n\t}\n\tif(isSourcing)\n\t{\n\t\tprofileText = profileText + &quot;Sourcing Team, &quot;;\n\t}\n\tif(isPlantOps)\n\t{\n\t\tprofileText = profileText + &quot;Plant Operations, &quot;;\n\t}\n\tif(isSalesMgmt)\n\t{\n\t\tprofileText = profileText + &quot;Sales Management, &quot;;\n\t}\n\tif(isExec)\n\t{\n\t\tprofileText = profileText + &quot;Executive Management, &quot;;\n\t}\n\tif(isAuditor)\n\t{\n\t\tprofileText = profileText + &quot;Auditor, &quot;;\n\t}\n\tif(profileText == &quot;&quot;)\n\t{\n\t\tprofileText = &quot;Operational user&quot;;\n\t}\n\tmySalesItems = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tmyShutdownItems = Shutdown_Schedules[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tmyCapacityItems = Capacity_TEP_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tmySMSItems = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tmyVolumeItems = Volume_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot;].count();\n\tmyRMItems = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sourcing Manager&quot; || Status == &quot;Returned by Finance&quot;].count();\n\tmyConsumableItems = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tmyFinanceItems = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Management&quot; || Status == &quot;Reopened&quot;].count();\n\tmyReplanningItems = Replanning_Requests[Requested_By_Email == loginEmail || Requested_By_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Rejected&quot;].count();\n\tmyEntryItems = mySalesItems + myShutdownItems + myCapacityItems + mySMSItems + myVolumeItems + myRMItems + myConsumableItems + myFinanceItems + myReplanningItems;\n\treturnedItems = mySalesItems + myCapacityItems + mySMSItems + myVolumeItems + myRMItems + myConsumableItems + myFinanceItems;\n\tapprovalItems = 0;\n\tif(isCOE || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\t}\n\tif(isSCM || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\t}\n\tif(isOps || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Capacity_TEP_Plans[Status == &quot;Submitted to Operations Approval&quot;].count() + Operations_Production_Plans[Status == &quot;Submitted to Operations Approval&quot;].count();\n\t}\n\tif(isSalesMgmt || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\t}\n\tif(isSCM || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\t}\n\tif(isFinance || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Raw_Material_Budgets[Status == &quot;Submitted to Finance&quot;].count() + Consumables_Budgets[Status == &quot;Submitted to Finance&quot;].count() + Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot;].count();\n\t}\n\tif(isExec || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Financial_Consolidations[Status == &quot;Submitted to Management&quot;].count();\n\t}\n\tshortfallItems = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\tcriticalEvents = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Reopened&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;}].count();\n\tactiveReplans = Replanning_Requests[Status in {&quot;Submitted to Finance&quot;,&quot;Finance Approved&quot;,&quot;Revision Created&quot;}].count();\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}.zcs-cursor-pointer{cursor:pointer}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-m-0{margin:0}.zcs-mt-16{margin-top:1rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-pb-0{padding-bottom:0}.zcs-pl-24{padding-left:1.5rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:var(--zcs-white-color)}a{text-decoration:none}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598E}.zcs-color-l_blue{color:#1094C5}\n/* Badge with Icon */\n.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#e8e8e8;border-color:#242424;color:#242424}\n/* Primary Outline Button No Icon */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-fw-button{width:100%}\n/* Simple Table */\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-l_blue{color:#1094c5}\n/* Outline Banner with Icon */\n.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background-color:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.zcs-warning-toast{background-color:#fef4e5;color:#663c01}.zcs-info-toast{background-color:#e4f6fd;color:#024361}.zcs-toast-link:hover{text-decoration:underline}\n/* Card Type Quick Actions */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:none}\n/* Notes With List */\n.zcs-notes-wrapper ul{list-style-type:disc}.zcs-notes-wrapper ul li::marker{color:var(--zcs_tertiary_text_color)}\n/* Planning Workbench custom layout */\n.pw-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.pw-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;box-sizing:border-box;overflow:hidden;position:relative}.pw-hero:after{content:&quot;&quot;;position:absolute;right:-70px;top:-80px;width:220px;height:220px;border:32px solid rgba(255,255,255,.12);border-radius:50%}.pw-hero h2{margin:0 0 6px 0;font-size:24px;line-height:1.2}.pw-hero p{margin:0;opacity:.88}.pw-card-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.pw-metric-card{min-height:126px}.pw-metric-icon{width:42px;height:42px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.pw-metric-value{font-size:30px;font-weight:700;line-height:1;color:var(--zcs_primary_text_color)}.pw-metric-label{color:var(--zcs_secondary_text_color)}.pw-small-link{color:var(--zcs_brand_color);font-size:13px;font-weight:500}.pw-queue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pw-queue-card{min-height:210px}.pw-queue-card h5{margin:0}.pw-queue-actions{margin-top:auto}.pw-muted{color:var(--zcs_tertiary_text_color)}.pw-report-note{margin:12px 0 0}.pw-guidance-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.pw-step{border-left:3px solid var(--zcs_brand_color);padding-left:12px}.pw-report-wrap{padding:8px 20px;background:var(--zcs-page-bg-color)}\n@media(max-width:1100px){.pw-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pw-queue-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:700px){.pw-shell{padding:12px}.pw-card-grid,.pw-queue-grid,.pw-guidance-grid{grid-template-columns:1fr}.pw-hero{padding:18px}}\n&lt;/style&gt;\n&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;pw-hero zcs-flex zcs-justify-space-between zcs-gap-16 zcs-align-items-center&apos;&gt;\n\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t&lt;h2&gt;Planning Workbench&lt;/h2&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt;. Queues are inferred from your profile, delegated authority and record status.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-badge-icon zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-card-grid&apos;&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Open&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=myEntryItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;My draft, returned or reopened entries&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;Open my sales workqueue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Action&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=approvalItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Approval or validation items visible to your role&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:Sales_Plan_Approval_Queue&apos;&gt;Open sales approval queue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Exception&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=shortfallItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Amber or red volume shortfall buckets&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:Shortfall_Buckets&apos;&gt;Review shortfalls&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Audit&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=activeReplans%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Active replanning requests; &lt;%=criticalEvents%&gt; critical audit events logged&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:Active_Replanning_Requests&apos;&gt;Open replanning queue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Department_Queue_Grid' elementName='Department_Queue_Grid' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Department_Queue_Grid()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tloginName = zoho.loginuser;\n\tisAdmin = thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;);\n\tisFinance = thisapp.permissions.isUserInProfile(&quot;Finance_Costing&quot;);\n\tisSales = thisapp.permissions.isUserInProfile(&quot;Sales_Team&quot;);\n\tisCOE = thisapp.permissions.isUserInProfile(&quot;COE_Team&quot;);\n\tisSCM = thisapp.permissions.isUserInProfile(&quot;SCM_Central_PPC&quot;);\n\tisOps = thisapp.permissions.isUserInProfile(&quot;Operations_PPC&quot;);\n\tisSMS = thisapp.permissions.isUserInProfile(&quot;SMS_Team&quot;);\n\tisSourcing = thisapp.permissions.isUserInProfile(&quot;Sourcing_Team&quot;);\n\tisPlantOps = thisapp.permissions.isUserInProfile(&quot;Plant_Operations&quot;);\n\tisSalesMgmt = thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;);\n\tisExec = thisapp.permissions.isUserInProfile(&quot;Executive_Management&quot;);\n\tisAuditor = thisapp.permissions.isUserInProfile(&quot;Auditor&quot;);\n\tsalesMine = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tsalesApproval = Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\tshutdownMine = Shutdown_Schedules[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tshutdownReady = Shutdown_Schedules[Status == &quot;Submitted&quot;].count();\n\tcapacityMine = Capacity_TEP_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tcapacityApproval = Capacity_TEP_Plans[Status == &quot;Submitted to Operations Approval&quot;].count();\n\tsmsMine = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tsmsApproval = SMS_Capacity_Plans[Status == &quot;Submitted to Central PPC&quot;].count();\n\tvolumeMine = Volume_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot;].count();\n\tvolumeApproval = Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\tvolumeShortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\trmMine = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sourcing Manager&quot; || Status == &quot;Returned by Finance&quot;].count();\n\trmApproval = Raw_Material_Budgets[Status == &quot;Submitted to Sourcing Manager&quot; || Status == &quot;Submitted to Finance&quot;].count();\n\tconsMine = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tconsApproval = Consumables_Budgets[Status == &quot;Submitted to Plant Manager&quot; || Status == &quot;Submitted to Finance&quot;].count();\n\tfinanceMine = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tfinanceApproval = Financial_Consolidations[Status == &quot;Submitted to Management&quot;].count();\n\treplanMine = Replanning_Requests[Requested_By_Email == loginEmail || Requested_By_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Rejected&quot;].count();\n\treplanApproval = Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;Revision Created&quot;].count();\n\t%&gt;\n&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16 zcs-pb-0&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Department queues&lt;/h3&gt;\n\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Each card exposes the report and entry form for modules your profile can operate. Counts are based on ownership, approval status and exception status.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:Critical_Audit_Events&apos;&gt;Audit events&lt;/a&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-queue-grid zcs-py-16&apos;&gt;\n&lt;%\n\tif(isSales || isCOE || isSCM || isOps || isSalesMgmt || isFinance || isAdmin || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 