			SMS_Capacity_Plans_After_Save as "SMS Capacity Plans After Save"
			{
			
							type =  form
							form = SMS_Capacity_Plans
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														actionDecision = input.Approver_Action;
													latestAudit = Approval_Audit_Log[Module_Name == "SMS Capacity Plan" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													previousStatus = "";
													if(latestAudit.count() > 0)
													{
														previousStatus = latestAudit.To_Status;
													}
													fromStatus = input.Status;
													auditAction = "";
													if(actionDecision == "Submit")
													{
														input.Status = "Submitted to Central PPC";
														auditAction = "Submitted";
													}
													else if(actionDecision == "Approve")
													{
														input.Status = "Accepted";
														auditAction = "Approved";
													}
													else if(actionDecision == "Return")
													{
														input.Status = "Returned by Central PPC";
														if(input.Iteration_Count == null)
														{
															input.Iteration_Count = 0;
														}
														input.Iteration_Count = input.Iteration_Count + 1;
														auditAction = "Returned";
													}
													else if(actionDecision == "Lock")
													{
														input.Status = "Locked";
														input.Locked = true;
														auditAction = "Locked";
													}
													else if(actionDecision == "Reopen")
													{
														input.Status = "Reopened";
														input.Locked = false;
														if(input.Iteration_Count == null)
														{
															input.Iteration_Count = 0;
														}
														input.Iteration_Count = input.Iteration_Count + 1;
														auditAction = "Reopened";
													}
													else
													{
														if(previousStatus == "")
														{
															auditAction = "Created";
														}
														else if(previousStatus != input.Status)
														{
															auditAction = "Updated";
														}
													}
													if(auditAction != "")
													{
														auditRecordId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="SMS Capacity Plan"
															Related_Record_ID=input.ID
															Related_Record_Display="SMS Plan " + input.ID
															Action=auditAction
															From_Status=fromStatus
															To_Status=input.Status
															Iteration_Number=input.Iteration_Count
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks=input.Approval_Remarks
															Added_User=zoho.loginuser
														];
														if(actionDecision != null && actionDecision != "")
														{
															input.Approver_Action = null;
														}
													}
													// SMS BTV no longer writes to parent-level Volume_Consolidations fields in the rebuilt SCM review model.
									)
								}
							}
			
						
			}

			SMS_Capacity_Plans_On_Load as "SMS Capacity Plans On Load"
			{
			
							type =  form
							form = SMS_Capacity_Plans
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													disable Total_Steel_Availability_BTV;
													disable Status;
													disable Iteration_Count;
													disable Locked;
													disable Owner_Email;
													hide Approver_Action;
													hide Approval_Remarks;
													disable Approver_Action;
													disable Approval_Remarks;
													isSMS = thisapp.permissions.isUserInProfile("SMS_Team");
													isCentralPPC = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													canAct = false;
													if(input.Status == "Draft" || input.Status == "Returned by Central PPC" || input.Status == "Reopened" && isSMS || isAdmin)
													{
														canAct = true;
													}
													else if(input.Status == "Submitted to Central PPC" && isCentralPPC || isAdmin)
													{
														canAct = true;
													}
													else if(input.Status == "Accepted" || input.Status == "Locked" && isCentralPPC || isFinance || isAdmin)
													{
														canAct = true;
													}
													if(canAct == true)
													{
														show Approver_Action;
														enable Approver_Action;
														if(input.Approver_Action == "Return" || input.Approver_Action == "Reopen")
														{
															show Approval_Remarks;
															enable Approval_Remarks;
														}
													}
													if(input.Locked == true || input.Status == "Locked")
													{
														disable Budget_Cycle;
														disable Plant;
														disable Melting_Unit;
														if(!isCentralPPC && !isFinance && !isAdmin)
														{
															hide Approver_Action;
															hide Approval_Remarks;
															disable Approver_Action;
															disable Approval_Remarks;
														}
													}
									)
								}
							}
			
						
			}

			SMS_Capacity_Plans_Validate as "SMS Capacity Plans Validate"
			{
			
							type =  form
							form = SMS_Capacity_Plans
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														isSMS = thisapp.permissions.isUserInProfile("SMS_Team");
													isCentralPPC = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													canSubmit = isSMS || isAdmin;
													canApprove = isCentralPPC || isAdmin;
													canReopen = isCentralPPC || isFinance || isAdmin;
													totalSteelAvailability = 0;
													monthList = list();
													for each  smsMonth in input.Monthly_SMS_Availability
													{
														if(smsMonth.Month == null || smsMonth.Month == "")
														{
															alert "Month is required in every SMS availability row.";
															cancel submit;
														}
														if(monthList.contains(smsMonth.Month))
														{
															alert "Duplicate month found in SMS availability rows: " + smsMonth.Month + ".";
															cancel submit;
														}
														monthList.add(smsMonth.Month);
														if(ifNull(smsMonth.Available_Days,0) < 0 || ifNull(smsMonth.Heats_Per_Day,0) < 0 || ifNull(smsMonth.Tonnage_Per_Heat,0) < 0)
														{
															alert "SMS available days, heats per day and tonnage per heat cannot be negative.";
															cancel submit;
														}
														smsMonth.Output_MT=ifNull(smsMonth.Available_Days,0) * ifNull(smsMonth.Heats_Per_Day,0) * ifNull(smsMonth.Tonnage_Per_Heat,0);
														if(smsMonth.Month == "Apr")
														{
															smsMonth.Month_Order=1;
														}
														else if(smsMonth.Month == "May")
														{
															smsMonth.Month_Order=2;
														}
														else if(smsMonth.Month == "Jun")
														{
															smsMonth.Month_Order=3;
														}
														else if(smsMonth.Month == "Jul")
														{
															smsMonth.Month_Order=4;
														}
														else if(smsMonth.Month == "Aug")
														{
															smsMonth.Month_Order=5;
														}
														else if(smsMonth.Month == "Sep")
														{
															smsMonth.Month_Order=6;
														}
														else if(smsMonth.Month == "Oct")
														{
															smsMonth.Month_Order=7;
														}
														else if(smsMonth.Month == "Nov")
														{
															smsMonth.Month_Order=8;
														}
														else if(smsMonth.Month == "Dec")
														{
															smsMonth.Month_Order=9;
														}
														else if(smsMonth.Month == "Jan")
														{
															smsMonth.Month_Order=10;
														}
														else if(smsMonth.Month == "Feb")
														{
															smsMonth.Month_Order=11;
														}
														else if(smsMonth.Month == "Mar")
														{
															smsMonth.Month_Order=12;
														}
														totalSteelAvailability = totalSteelAvailability + ifNull(smsMonth.Output_MT,0);
													}
													input.Total_Steel_Availability_BTV = totalSteelAvailability;
													if(input.Locked == true && input.Approver_Action != "Reopen" && !isAdmin)
													{
														alert "Locked SMS capacity plans cannot be edited.";
														cancel submit;
													}
													if(input.Approver_Action == "Return" || input.Approver_Action == "Reopen" && input.Approval_Remarks == null || input.Approval_Remarks == "" || input.Approval_Remarks == " ")
													{
														alert "Approval remarks are required for Return/Reopen actions on an SMS capacity plan.";
														cancel submit;
													}
													if(input.Approver_Action == "Submit")
													{
														if(!canSubmit)
														{
															alert "Only SMS Team or System Administrator can submit SMS capacity plans.";
															cancel submit;
														}
														if(!(input.Status == "Draft" || input.Status == "Returned by Central PPC" || input.Status == "Reopened"))
														{
															alert "Only Draft, Returned or Reopened SMS capacity plans can be submitted.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Approve" || input.Approver_Action == "Return")
													{
														if(!canApprove)
														{
															alert "Only Central PPC or System Administrator can approve or return SMS capacity plans.";
															cancel submit;
														}
														if(input.Status != "Submitted to Central PPC")
														{
															alert "Central PPC can approve or return only submitted SMS capacity plans.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Lock")
													{
														if(!canApprove)
														{
															alert "Only Central PPC or System Administrator can lock SMS capacity plans.";
															cancel submit;
														}
														if(!(input.Status == "Accepted" || input.Status == "Submitted to Central PPC"))
														{
															alert "Only Accepted or Submitted SMS capacity plans can be locked.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Reopen")
													{
														if(!canReopen)
														{
															alert "Only Central PPC, Finance Costing or System Administrator can reopen SMS capacity plans.";
															cancel submit;
														}
														if(!(input.Status == "Accepted" || input.Status == "Locked"))
														{
															alert "Only Accepted or Locked SMS capacity plans can be reopened.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Requested_Financial_Year_On_User_Input as "Requested Financial Year On User Input"
			{
			
							type = form
							form = Sales_Plans
			
							record event = on add or edit
			
							on user input of Requested_Financial_Year
							{
								actions
								{
									custom deluge script
									(
										input.Budget_Cycle = null;
										if(input.Requested_Financial_Year != null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
											else
											{
												alert "No active Budget Cycle exists for the selected Financial Year.";
											}
										}
									)
								}
							}
			
						
			}

			Sales_Plans_After_Save as "Sales Plans After Save"
			{
			
							type = form
							form = Sales_Plans
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										currentStatus = input.Status;
										actionValue = input.Approver_Action;
										newStatus = currentStatus;
										auditAction = "Updated";
										shouldAudit = false;
										if(actionValue == "Submit" && (currentStatus == "Draft" || currentStatus == "Returned by Sales Management" || currentStatus == "Revision Requested by SCM" || currentStatus == "Revised Draft"))
										{
											newStatus = "Submitted to Sales Management";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Approve" && currentStatus == "Submitted to Sales Management")
										{
											newStatus = "Sales Approved";
											input.Sales_Approved_By = zoho.loginuserid;
											input.Sales_Approved_On = zoho.currenttime;
											auditAction = "Approved";
											shouldAudit = true;
										}
										else if(actionValue == "Return" && currentStatus == "Submitted to Sales Management")
										{
											newStatus = "Returned by Sales Management";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Returned";
											shouldAudit = true;
										}
										else if(actionValue == "Create Revision Copy")
										{
											newStatus = "Revised Draft";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Revision Copy Created";
											shouldAudit = true;
										}
										else if(actionValue == "Lock")
										{
											newStatus = "Locked";
											input.Locked = true;
											auditAction = "Locked";
											shouldAudit = true;
										}
										latestAudit = Approval_Audit_Log[Module_Name == "Sales Plans" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										if(latestAudit.count() == 0)
										{
											createdAuditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Sales Plans"
												Related_Record_ID=input.ID
												Related_Record_Display="Sales Plan " + input.Sales_Plan_No
												Action="Created"
												From_Status=""
												To_Status=currentStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Sales plan created."
												Added_User=zoho.loginuser
											];
										}
										if(shouldAudit == true)
										{
											input.Status = newStatus;
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Sales Plans"
												Related_Record_ID=input.ID
												Related_Record_Display="Sales Plan " + input.Sales_Plan_No
												Action=auditAction
												From_Status=currentStatus
												To_Status=newStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.Approval_Remarks
												Added_User=zoho.loginuser
											];
											if(newStatus == "Sales Approved")
											{
												cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
												if(cycleRec.count() > 0)
												{
													cycleRec.Sales_Approved = true;
													if(cycleRec.Operations_Approved == true)
													{
														cycleRec.Status = "Pending SCM";
													}
													else
													{
														cycleRec.Status = "Pending Operations";
													}
												}
											}
											input.Approver_Action = null;
										}
									)
								}
							}
			
						
			}

			Sales_Plans_On_Load as "Sales Plans On Load"
			{
			
							type = form
							form = Sales_Plans
			
							record event = on add or edit
			
							on load
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										if(input.Status == null)
										{
											input.Status = "Draft";
										}
										if(input.Requested_Financial_Year != null && input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
										}
										disable Budget_Cycle;
										disable Total_Grade_Target_Tons;
										disable Total_Product_Required_Tons;
										disable Variance_Tons;
										disable Status;
										disable Iteration_Count;
										disable Locked;
										disable Owner_Email;
										disable Sales_Approved_By;
										disable Sales_Approved_On;
										hide Approval_Remarks;
										if(input.Locked == true || input.Status == "Locked" || input.Status == "Superseded")
										{
											disable Requested_Financial_Year;
											disable Revision_No;
											disable Parent_Sales_Plan;
											disable Approver_Action;
											disable Approval_Remarks;
										}
										if(input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
									)
								}
							}
			
						
			}

			Sales_Plans_On_User_Input_Action as "Sales Plans On User Input Action"
			{
			
							type = form
							form = Sales_Plans
			
							record event = on add or edit
			
							on user input of Approver_Action
							{
								actions
								{
									custom deluge script
									(
										if(input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
