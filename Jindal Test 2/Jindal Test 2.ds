			Shutdown_Schedules_After_Save as "Shutdown Schedules After Save"
			{
			
							type =  form
							form = Shutdown_Schedules
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														statusBeforeRouting = input.Status;
													routedByAction = "";
													if(input.Approver_Action == "Submit" && statusBeforeRouting == "Draft" || statusBeforeRouting == "Reopened")
													{
														input.Status = "Submitted";
														input.Locked = false;
														routedByAction = "Submitted";
													}
													else if(input.Approver_Action == "Approve" && statusBeforeRouting == "Submitted")
													{
														input.Status = "Available to Capacity";
														input.Locked = false;
														routedByAction = "Approved";
													}
													else if(input.Approver_Action == "Reopen" && statusBeforeRouting == "Locked")
													{
														input.Status = "Reopened";
														input.Locked = false;
														routedByAction = "Reopened";
													}
													else if(input.Approver_Action == "Lock" && statusBeforeRouting == "Available to Capacity")
													{
														input.Status = "Locked";
														input.Locked = true;
														routedByAction = "Locked";
													}
													latestAudit = Approval_Audit_Log[Module_Name == "Shutdown Schedule" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													previousStatus = "";
													if(latestAudit.count() > 0)
													{
														previousStatus = latestAudit.To_Status;
													}
													if(previousStatus == "" || previousStatus != input.Status || routedByAction != "")
													{
														auditAction = "Updated";
														if(previousStatus == "")
														{
															auditAction = "Created";
														}
														if(routedByAction == "Submitted")
														{
															auditAction = "Submitted";
														}
														if(routedByAction == "Approved")
														{
															auditAction = "Approved";
														}
														if(routedByAction == "Reopened")
														{
															auditAction = "Reopened";
														}
														if(routedByAction == "Locked")
														{
															auditAction = "Locked";
														}
														auditRecordId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="Shutdown Schedule"
															Related_Record_ID=input.ID
															Related_Record_Display="Shutdown " + input.Shutdown_No
															Action=auditAction
															From_Status=previousStatus
															To_Status=input.Status
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks=input.Approval_Remarks
															Added_User=zoho.loginuser
														];
													}
													if(input.Shutdown_Type == "Capital" && routedByAction == "Approved")
													{
														mailRecipients = List();
														for each  plantRecord in Plants[ID == input.Plant] range from 0 to 0
														{
															plantName = plantRecord.Plant_Name;
															if(plantRecord.Finance_Contact_Email != null && plantRecord.Finance_Contact_Email != "")
															{
																mailRecipients.add(plantRecord.Finance_Contact_Email);
															}
														}
														lineName = "";
														for each  lineRecord in Production_Lines[ID == input.Production_Line] range from 0 to 0
														{
															lineName = lineRecord.Line_Name;
														}
														if(mailRecipients.size() > 0)
														{
															sendmail
															[
																from :zoho.adminuserid
																to :mailRecipients
																subject :"Capital shutdown available for capacity planning"
																message :"A capital shutdown schedule has been submitted and made available to capacity planning. Plant: " + plantName + ", Line: " + lineName + ", Annual shutdown days: " + input.Annual_Shutdown_Days
															]
														}
													}
													totalApr = 0;
													totalMay = 0;
													totalJun = 0;
													totalJul = 0;
													totalAug = 0;
													totalSep = 0;
													totalOct = 0;
													totalNov = 0;
													totalDec = 0;
													totalJan = 0;
													totalFeb = 0;
													totalMar = 0;
													approvedSchedules = Shutdown_Schedules[Budget_Cycle == input.Budget_Cycle && Production_Line == input.Production_Line && Status == "Available to Capacity" || Status == "Locked"];
													for each  shutdownSchedule in approvedSchedules
													{
														for each  shutdownMonth in shutdownSchedule.Monthly_Shutdowns
														{
															if(shutdownMonth.Month == "Apr")
															{
																totalApr = totalApr + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "May")
															{
																totalMay = totalMay + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Jun")
															{
																totalJun = totalJun + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Jul")
															{
																totalJul = totalJul + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Aug")
															{
																totalAug = totalAug + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Sep")
															{
																totalSep = totalSep + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Oct")
															{
																totalOct = totalOct + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Nov")
															{
																totalNov = totalNov + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Dec")
															{
																totalDec = totalDec + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Jan")
															{
																totalJan = totalJan + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Feb")
															{
																totalFeb = totalFeb + ifNull(shutdownMonth.Days_For,0);
															}
															else if(shutdownMonth.Month == "Mar")
															{
																totalMar = totalMar + ifNull(shutdownMonth.Days_For,0);
															}
														}
													}
													// Capacity_TEP_Plans now uses configurable Monthly_Availability_Lines; legacy fixed-month shutdown push is intentionally skipped.
									)
								}
							}
						}

			Shutdown_Schedules_On_Load as "Shutdown Schedules On Load"
			{
			
							type =  form
							form = Shutdown_Schedules
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													disable Status;
													disable Annual_Shutdown_Days;
													disable Annual_Shutdown_Hours;
													disable Locked;
													hide Approver_Action;
													hide Approval_Remarks;
													disable Approver_Action;
													disable Approval_Remarks;
													isOperationsPPC = thisapp.permissions.isUserInProfile("Operations_PPC");
													isCentralPPC = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													canAction = isOperationsPPC || isCentralPPC || isFinance || isAdmin;
													if(canAction)
													{
														show Approver_Action;
														enable Approver_Action;
														if(input.Approver_Action == "Reopen")
														{
															show Approval_Remarks;
															enable Approval_Remarks;
														}
													}
													if(input.Locked == true)
													{
														disable Budget_Cycle;
														disable Plant;
														disable Owner_Email;
														if(!isAdmin)
														{
															hide Approver_Action;
															hide Approval_Remarks;
															disable Approver_Action;
															disable Approval_Remarks;
														}
													}
									)
								}
							}
			
						
			}

			Validate_Shutdown_Schedules as "Validate Shutdown Schedules"
			{
			
							type =  form
							form = Shutdown_Schedules
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														isOperationsPPC = thisapp.permissions.isUserInProfile("Operations_PPC");
													isCentralPPC = thisapp.permissions.isUserInProfile("SCM_Central_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													canAction = isOperationsPPC || isCentralPPC || isFinance || isAdmin;
													if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													if(input.Locked == true && !(isAdmin && input.Approver_Action == "Reopen"))
													{
														alert "This shutdown schedule is locked. Only System Administrator can reopen locked schedules through Approver Action = Reopen.";
														cancel submit;
													}
													if(input.Approver_Action != null && input.Approver_Action != "" && !canAction)
													{
														alert "Only Operations PPC, Central PPC, Finance Costing or System Administrator can act on shutdown schedules.";
														cancel submit;
													}
													if(input.Approver_Action == "Submit" && !(input.Status == "Draft" || input.Status == "Reopened"))
													{
														alert "Submit is allowed only from Draft or Reopened shutdown schedules.";
														cancel submit;
													}
													if(input.Approver_Action == "Approve" && input.Status != "Submitted")
													{
														alert "Approve is allowed only after the shutdown schedule is Submitted.";
														cancel submit;
													}
													if(input.Approver_Action == "Lock" && input.Status != "Available to Capacity")
													{
														alert "Only schedules available to capacity can be locked.";
														cancel submit;
													}
													if(input.Approver_Action == "Reopen" && input.Status != "Locked")
													{
														alert "Only locked shutdown schedules can be reopened.";
														cancel submit;
													}
													if(input.Approver_Action == "Reopen" && input.Approval_Remarks == null || input.Approval_Remarks == "")
													{
														alert "Approval remarks are required when reopening a shutdown schedule.";
														cancel submit;
													}
													annualShutdownDays = 0;
													monthList = list();
													for each  shutdownMonth in input.Monthly_Shutdowns
													{
														if(shutdownMonth.Month == null || shutdownMonth.Month == "")
														{
															alert "Month is required in every shutdown row.";
															cancel submit;
														}
														if(monthList.contains(shutdownMonth.Month))
														{
															alert "Duplicate month found in shutdown rows: " + shutdownMonth.Month + ".";
															cancel submit;
														}
														monthList.add(shutdownMonth.Month);
														if(ifNull(shutdownMonth.Days_For,0) < 0)
														{
															alert "Shutdown days cannot be negative.";
															cancel submit;
														}
														if(ifNull(shutdownMonth.Days_For,0) > 0 && shutdownMonth.Reason == null || shutdownMonth.Reason == "")
														{
															alert "Reason is required when shutdown days are entered for " + shutdownMonth.Month + ".";
															cancel submit;
														}
														if(shutdownMonth.Month == "Apr")
														{
															shutdownMonth.Month_Order=1;
														}
														else if(shutdownMonth.Month == "May")
														{
															shutdownMonth.Month_Order=2;
														}
														else if(shutdownMonth.Month == "Jun")
														{
															shutdownMonth.Month_Order=3;
														}
														else if(shutdownMonth.Month == "Jul")
														{
															shutdownMonth.Month_Order=4;
														}
														else if(shutdownMonth.Month == "Aug")
														{
															shutdownMonth.Month_Order=5;
														}
														else if(shutdownMonth.Month == "Sep")
														{
															shutdownMonth.Month_Order=6;
														}
														else if(shutdownMonth.Month == "Oct")
														{
															shutdownMonth.Month_Order=7;
														}
														else if(shutdownMonth.Month == "Nov")
														{
															shutdownMonth.Month_Order=8;
														}
														else if(shutdownMonth.Month == "Dec")
														{
															shutdownMonth.Month_Order=9;
														}
														else if(shutdownMonth.Month == "Jan")
														{
															shutdownMonth.Month_Order=10;
														}
														else if(shutdownMonth.Month == "Feb")
														{
															shutdownMonth.Month_Order=11;
														}
														else if(shutdownMonth.Month == "Mar")
														{
															shutdownMonth.Month_Order=12;
														}
														annualShutdownDays = annualShutdownDays + ifNull(shutdownMonth.Days_For,0);
													}
													input.Annual_Shutdown_Days = annualShutdownDays;
													input.Annual_Shutdown_Hours = annualShutdownDays * 24;
									)
								}
							}
			
						
			}

			Log_Steel_Grade_Master_Data as "Log Steel Grade Master Data"
			{
			
							type =  form
							form = Steel_Grades
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														auditAction = "Created";
													existingAudit = Approval_Audit_Log[Module_Name == "Steel Grade" && Related_Record_ID == input.ID] range from 1 to 1;
													if(existingAudit.count() > 0)
													{
														auditAction = "Updated";
													}
													relatedDisplay = input.Grade_Code + " - " + input.Grade_Name;
													auditId = insert into Approval_Audit_Log
													[
														Module_Name="Steel Grade"
														Related_Record_ID=input.ID
														Related_Record_Display=relatedDisplay
														Action=auditAction
														To_Status=input.Active
														Actor_Email=zoho.loginuserid
														Action_On=zoho.currenttime
														Remarks="Steel grade master data change logged by system workflow."
														Added_User=zoho.loginuser
													];
													info "Steel Grade master-data " + auditAction + ": " + input.Grade_Code;
									)
								}
							}
			
						
			}

			Validate_Nickel_Content as "Validate Product Master"
			{
			
							type = form
							form = Steel_Grades
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Grade_Code == null || input.Grade_Code.trim() == "")
										{
											alert "Product Code is required.";
											cancel submit;
										}
										if(input.Active == true && (input.Grade_Series == null || input.Grade_Series == ""))
