			Volume_Consolidations_After_Save as "Volume Consolidations After Save"
			{
			
							type = form
							form = Volume_Consolidations
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										currentStatus = input.Status;
										actionValue = input.Approver_Action;
										newStatus = currentStatus;
										auditAction = "Updated";
										shouldAudit = false;
										if(actionValue == "Start Review" && (currentStatus == "Waiting for Sales and Operations Approval" || currentStatus == "Reopened"))
										{
											newStatus = "Under SCM Review";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Approve" && currentStatus == "Under SCM Review")
										{
											newStatus = "SCM Approved";
											input.SCM_Approved_By = zoho.loginuserid;
											input.SCM_Approved_On = zoho.currenttime;
											auditAction = "Approved";
											shouldAudit = true;
										}
										else if(actionValue == "Request Revision")
										{
											input.Latest_Revision_No = ifNull(input.Latest_Revision_No,0) + 1;
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											requestedToValue = "Both";
											if(input.SCM_Decision == "Request Sales Revision")
											{
												newStatus = "Sales Revision Pending";
												requestedToValue = "Sales";
											}
											else if(input.SCM_Decision == "Request Operations Revision")
											{
												newStatus = "Operations Revision Pending";
												requestedToValue = "Operations";
											}
											else
											{
												newStatus = "Both Revisions Pending";
												requestedToValue = "Both";
											}
											historyRow = Volume_Consolidations.Revision_History_Lines();
											historyRow.Revision_No = input.Latest_Revision_No;
											historyRow.Requested_To = requestedToValue;
											historyRow.Source_Record = "SCM Review " + input.Consolidation_No;
											historyRow.New_Revision_Record_ID = 0;
											historyRow.Comments = input.SCM_Comments;
											historyRow.Requested_By = zoho.loginuserid;
											historyRow.Requested_On = zoho.currenttime;
											historyRow.Revision_Status = "Requested";
											input.Revision_History_Lines.insert(historyRow);
											if(requestedToValue == "Sales" || requestedToValue == "Both")
											{
												salesPlanRec = Sales_Plans[ID == input.Sales_Plan];
												if(salesPlanRec.count() > 0)
												{
													salesPlanRec.Status = "Revision Requested by SCM";
													salesPlanRec.Approval_Remarks = input.SCM_Comments;
													salesPlanRec.Iteration_Count = ifNull(salesPlanRec.Iteration_Count,0) + 1;
												}
											}
											if(requestedToValue == "Operations" || requestedToValue == "Both")
											{
												availabilityRec = Capacity_TEP_Plans[ID == input.Availability_Plan];
												if(availabilityRec.count() > 0)
												{
													availabilityRec.Status = "Revision Requested by SCM";
													availabilityRec.Approval_Remarks = input.SCM_Comments;
													availabilityRec.Iteration_Count = ifNull(availabilityRec.Iteration_Count,0) + 1;
												}
												productionRec = Operations_Production_Plans[ID == input.Operations_Production_Plan];
												if(productionRec.count() > 0)
												{
													productionRec.Status = "Revision Requested by SCM";
													productionRec.Approval_Remarks = input.SCM_Comments;
													productionRec.Iteration_Count = ifNull(productionRec.Iteration_Count,0) + 1;
												}
											}
											auditAction = "Revision Requested";
											shouldAudit = true;
										}
										else if(actionValue == "Submit to Finance" && currentStatus == "SCM Approved")
										{
											newStatus = "Submitted to Finance";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Lock" && (currentStatus == "SCM Approved" || currentStatus == "Submitted to Finance"))
										{
											newStatus = "Locked";
											input.Locked = true;
											auditAction = "Locked";
											shouldAudit = true;
										}
										latestAudit = Approval_Audit_Log[Module_Name == "SCM Review" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										if(latestAudit.count() == 0)
										{
											createdAuditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="SCM Review"
												Related_Record_ID=input.ID
												Related_Record_Display="SCM Review " + input.Consolidation_No
												Action="Created"
												From_Status=""
												To_Status=currentStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="SCM review created."
												Added_User=zoho.loginuser
											];
										}
										if(shouldAudit == true)
										{
											input.Status = newStatus;
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="SCM Review"
												Related_Record_ID=input.ID
												Related_Record_Display="SCM Review " + input.Consolidation_No
												Action=auditAction
												From_Status=currentStatus
												To_Status=newStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.SCM_Comments + " " + input.Approval_Remarks
												Added_User=zoho.loginuser
											];
											if(newStatus == "SCM Approved" || newStatus == "Submitted to Finance")
											{
												cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
												if(cycleRec.count() > 0)
												{
													cycleRec.SCM_Approved = true;
													cycleRec.Status = "Pending Finance";
												}
											}
											input.Approver_Action = null;
										}
									)
								}
							}
			
						
			}

			Volume_Consolidations_On_Load as "Volume Consolidations On Load"
			{
			
							type = form
							form = Volume_Consolidations
			
							record event = on add or edit
			
							on load
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										if(input.Status == null)
										{
											input.Status = "Waiting for Sales and Operations Approval";
										}
										if(input.Locked == null)
										{
											input.Locked = false;
										}
										if(input.Iteration_Count == null)
										{
											input.Iteration_Count = 0;
										}
										if(input.Latest_Revision_No == null)
										{
											input.Latest_Revision_No = 0;
										}
										if(input.Requested_Financial_Year != null && input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
										}
										if(input.Budget_Cycle != null && input.Sales_Plan == null)
										{
											approvedSalesPlan = Sales_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Sales Approved"] sort by Sales_Approved_On desc range from 0 to 0;
											if(approvedSalesPlan.count() > 0)
											{
												input.Sales_Plan = approvedSalesPlan.ID;
											}
										}
										if(input.Budget_Cycle != null && input.Availability_Plan == null)
										{
											approvedAvailabilityPlan = Capacity_TEP_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"] sort by Operations_Approved_On desc range from 0 to 0;
											if(approvedAvailabilityPlan.count() > 0)
											{
												input.Availability_Plan = approvedAvailabilityPlan.ID;
												input.Plant = approvedAvailabilityPlan.Plant;
											}
										}
										if(input.Budget_Cycle != null && input.Operations_Production_Plan == null)
										{
											approvedProductionPlan = Operations_Production_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"] sort by Operations_Approved_On desc range from 0 to 0;
											if(approvedProductionPlan.count() > 0)
											{
												input.Operations_Production_Plan = approvedProductionPlan.ID;
												input.Plant = approvedProductionPlan.Plant;
											}
										}
										disable Status;
										disable Iteration_Count;
										disable Locked;
										disable Owner_Email;
										disable SCM_Approved_By;
										disable SCM_Approved_On;
										hide Approval_Remarks;
										if(input.Locked == true || input.Status == "Locked")
										{
											disable Requested_Financial_Year;
											disable Budget_Cycle;
											disable Sales_Plan;
											disable Availability_Plan;
											disable Operations_Production_Plan;
											disable Plant;
											disable SCM_Decision;
											disable SCM_Comments;
											disable Approver_Action;
											disable Approval_Remarks;
										}
										if(input.Approver_Action == "Request Revision" || input.Approver_Action == "Approve" || input.Approver_Action == "Submit to Finance")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
									)
								}
							}
			
						
			}

			Volume_Consolidations_Validate as "Volume Consolidations Validate"
			{
			
							type = form
							form = Volume_Consolidations
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Locked == true || input.Status == "Locked")
										{
											alert "This SCM review is locked and cannot be edited.";
											cancel submit;
										}
										if(input.Budget_Cycle == null && input.Requested_Financial_Year != null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
										}
										if(input.Sales_Plan != null)
										{
											salesPlanRec = Sales_Plans[ID == input.Sales_Plan];
											if(salesPlanRec.count() == 0 || salesPlanRec.Status != "Sales Approved")
											{
												alert "SCM review can start only with a Sales Approved Sales Plan.";
												cancel submit;
											}
										}
										if(input.Availability_Plan != null)
										{
											availabilityRec = Capacity_TEP_Plans[ID == input.Availability_Plan];
											if(availabilityRec.count() == 0 || availabilityRec.Status != "Operations Approved")
											{
												alert "SCM review can start only with an Operations Approved availability plan.";
												cancel submit;
											}
										}
										if(input.Operations_Production_Plan != null)
										{
											productionRec = Operations_Production_Plans[ID == input.Operations_Production_Plan];
											if(productionRec.count() == 0 || productionRec.Status != "Operations Approved")
											{
												alert "SCM review can start only with an Operations Approved production plan.";
												cancel submit;
											}
										}
										if((input.Approver_Action == "Start Review" || input.Approver_Action == "Approve" || input.Approver_Action == "Request Revision" || input.Approver_Action == "Submit to Finance") && (input.Sales_Plan == null || input.Availability_Plan == null || input.Operations_Production_Plan == null))
										{
											alert "Sales, Operations availability, and Operations production plans are all required before SCM action.";
											cancel submit;
										}
										totalShortfall = 0.0;
										totalCost = 0.0;
										for each reviewRow in input.SCM_Review_Lines
										{
											if(ifNull(reviewRow.Sales_Target_Tons,0) < 0 || ifNull(reviewRow.Operations_Production_Tons,0) < 0 || ifNull(reviewRow.BTV_Measured_MT,0) < 0 || ifNull(reviewRow.Required_Raw_Material_MT,0) < 0 || ifNull(reviewRow.Available_Raw_Material_MT,0) < 0 || ifNull(reviewRow.To_Be_Raised_MT,0) < 0 || ifNull(reviewRow.Cost_Forecast,0) < 0)
											{
												alert "SCM review line tonnage and cost values cannot be negative.";
												cancel submit;
											}
											shortfall = ifNull(reviewRow.Required_Raw_Material_MT,0) - ifNull(reviewRow.Available_Raw_Material_MT,0);
											if(shortfall < 0)
											{
												shortfall = 0;
											}
											reviewRow.To_Be_Raised_MT = shortfall;
											if(reviewRow.SCM_Override == true && (reviewRow.Override_Comments == null || reviewRow.Override_Comments == ""))
											{
												alert "Override comments are required for every SCM override line.";
												cancel submit;
											}
											totalShortfall = totalShortfall + shortfall;
											totalCost = totalCost + ifNull(reviewRow.Cost_Forecast,0);
										}
										if((input.SCM_Decision == "Request Sales Revision" || input.SCM_Decision == "Request Operations Revision" || input.SCM_Decision == "Request Sales and Operations Revision") && (input.SCM_Comments == null || input.SCM_Comments == ""))
										{
											alert "SCM comments are required when requesting a revision.";
											cancel submit;
										}
										if(input.Approver_Action == "Approve" && input.SCM_Decision != "Approve")
										{
											alert "Set SCM Decision to Approve before approving this SCM review.";
											cancel submit;
										}
										if(input.Approver_Action == "Request Revision" && (input.SCM_Decision == null || input.SCM_Decision == "Approve"))
										{
											alert "Choose which team must revise before selecting Request Revision.";
											cancel submit;
										}
									)
								}
							}
			
						
			}
		}
	}

