			 			row = 5
			 			column = 2
						width = medium
					)
					Locked
					(
		    			type = checkbox
						initial value = false
			 			row = 5
			 			column = 1
						width = medium
					)
					Owner_Email
					(
		    			type = email
						displayname = "Owner Email"
			 			row = 5
			 			column = 2
						width = medium
					)
					SCM_Approved_By
					(
		    			type = email
						displayname = "SCM Approved By"
			 			row = 5
			 			column = 1
						width = medium
					)
					SCM_Approved_On
					(
						type = datetime
						displayname = "SCM Approved On"
			 			row = 5
			 			column = 2
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}
	}

	reports
	{
		default list All_Users
		{
		
					displayName = "All Users"
					show all rows from Add_Users    
					(
						User_Email as "User Email"
						Profile
					)
				
		}

		default list All_Approval_Audit_Logs
		{
		
					displayName = "All Approval Audit Logs"
					show all rows from Approval_Audit_Log    
					(
						Budget_Cycle
						Module_Name
						Related_Record_ID
						Related_Record_Display
						Action
						From_Status
						To_Status
						Iteration_Number
						Actor_Email
						Acting_On_Behalf_Of
						Action_On
						(
							displayformat = fulldate
						)
						Remarks
					)
					filters
					(
						Budget_Cycle
						Module_Name
						Action
						Actor_Email
						Action_On
					)
					sort by
					(
						Action_On descending
					)
				
		}

		list Audit_By_Cycle
		{
		
					displayName = "Audit By Cycle"
					show all rows from Approval_Audit_Log    
					(
						Budget_Cycle
						Module_Name
						Related_Record_ID
						Related_Record_Display
						Action
						From_Status
						To_Status
						Iteration_Number
						Actor_Email
						Acting_On_Behalf_Of
						Action_On
						(
							displayformat = fulldate
						)
						Remarks
					)
					filters
					(
						Budget_Cycle
						Module_Name
						Action
						Actor_Email
						Action_On
					)
					group by
					(
						properties
		    			(
		  	    			display record count = true
		   				)
						Budget_Cycle ascending
					)
					sort by
					(
						Action_On descending
					)
				
		}

		list Critical_Audit_Events
		{
		
					displayName = "Critical Audit Events"
					show all rows from Approval_Audit_Log [Action == "Revision Requested" || Action == "Revision Copy Created" || Action == "Locked" || Action == "Final Approved" || Action == "Completed" || Action == "Cancelled"]
					(
						Budget_Cycle
						Module_Name
						Related_Record_ID
						Related_Record_Display
						Action
						From_Status
						To_Status
						Iteration_Number
						Actor_Email
						Acting_On_Behalf_Of
						Action_On
						(
							displayformat = fulldate
						)
						Remarks
					)
					filters
					(
						Budget_Cycle
						Module_Name
						Action
						Actor_Email
						Action_On
					)
					sort by
					(
						Action_On descending
					)
				
		}

		list Management_Critical_Audit_Events
		{
		
					displayName = "Management Critical Audit Events"
					show all rows from Approval_Audit_Log [Action == "Revision Requested" || Action == "Revision Copy Created" || Action == "Locked" || Action == "Final Approved" || Action == "Completed" || Action == "Cancelled"]
					(
						Budget_Cycle
						Module_Name
						Related_Record_ID
						Related_Record_Display
						Action
						From_Status
						To_Status
						Iteration_Number
						Actor_Email
						Acting_On_Behalf_Of
						Action_On
						(
							displayformat = fulldate
						)
						Remarks
					)
					filters
					(
						Budget_Cycle
						Module_Name
						Action
						Actor_Email
						Action_On
					)
					sort by
					(
						Action_On descending
					)
				
		}

		list Active_Delegations
		{
		
					displayName = "Active Delegations"
					show all rows from Approval_Delegations  [Active == true]  
					(
						Delegator_Email
						Delegate_Email
						Profile_Name
						Module_Name
						Start_Date
						End_Date
						Active
						Reason
					)
					filters
					(
						Profile_Name
						Module_Name
						Start_Date
						End_Date
					)
					sort by
					(
						End_Date ascending
					)
				
		}

		default list All_Approval_Delegations
		{
		
					displayName = "All Approval Delegations"
					show all rows from Approval_Delegations    
					(
						Delegator_Email
						Delegate_Email
						Profile_Name
						Module_Name
						Start_Date
						End_Date
						Active
						Reason
