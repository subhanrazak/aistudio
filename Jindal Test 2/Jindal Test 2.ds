t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Variance_Bars' elementName='Scenario_Variance_Bars' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Variance_Bars()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[ID != 0] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvVolume = ifNull(volumeFinancial.Volume_MT,0);\n\tvRevenue = ifNull(volumeFinancial.Revenue,0);\n\tvRaw = ifNull(volumeFinancial.Raw_Material_Cost,0);\n\tvCons = ifNull(volumeFinancial.Consumables_Cost,0);\n\tvTotal = ifNull(volumeFinancial.Total_Cost,0);\n\tvEbitda = ifNull(volumeFinancial.EBITDA,0);\n\tvMargin = ifNull(volumeFinancial.EBITDA_Margin_Percent,0);\n\teVolume = ifNull(ebitdaFinancial.Volume_MT,0);\n\teRevenue = ifNull(ebitdaFinancial.Revenue,0);\n\teRaw = ifNull(ebitdaFinancial.Raw_Material_Cost,0);\n\teCons = ifNull(ebitdaFinancial.Consumables_Cost,0);\n\teTotal = ifNull(ebitdaFinancial.Total_Cost,0);\n\teEbitda = ifNull(ebitdaFinancial.EBITDA,0);\n\teMargin = ifNull(ebitdaFinancial.EBITDA_Margin_Percent,0);\n\tvolVar = eVolume - vVolume;\n\tvolPct = 0;\n\tif(vVolume != 0)\n\t{\n\t\tvolPct = volVar / vVolume * 100;\n\t}\n\telse if(eVolume != 0)\n\t{\n\t\tvolPct = 100;\n\t}\n\tvolWidth = volPct;\n\tif(volWidth &lt; 0)\n\t{\n\t\tvolWidth = volWidth * -1;\n\t}\n\tif(volWidth &gt; 100)\n\t{\n\t\tvolWidth = 100;\n\t}\n\tif(volWidth &gt; 0 &amp;&amp; volWidth &lt; 3)\n\t{\n\t\tvolWidth = 3;\n\t}\n\tvolClass = &quot;is-neutral&quot;;\n\tif(volVar &gt; 0)\n\t{\n\t\tvolClass = &quot;is-positive&quot;;\n\t}\n\tif(volVar &lt; 0)\n\t{\n\t\tvolClass = &quot;is-negative&quot;;\n\t}\n\trevVar = eRevenue - vRevenue;\n\trevPct = 0;\n\tif(vRevenue != 0)\n\t{\n\t\trevPct = revVar / vRevenue * 100;\n\t}\n\telse if(eRevenue != 0)\n\t{\n\t\trevPct = 100;\n\t}\n\trevWidth = revPct;\n\tif(revWidth &lt; 0)\n\t{\n\t\trevWidth = revWidth * -1;\n\t}\n\tif(revWidth &gt; 100)\n\t{\n\t\trevWidth = 100;\n\t}\n\tif(revWidth &gt; 0 &amp;&amp; revWidth &lt; 3)\n\t{\n\t\trevWidth = 3;\n\t}\n\trevClass = &quot;is-neutral&quot;;\n\tif(revVar &gt; 0)\n\t{\n\t\trevClass = &quot;is-positive&quot;;\n\t}\n\tif(revVar &lt; 0)\n\t{\n\t\trevClass = &quot;is-negative&quot;;\n\t}\n\trawVar = eRaw - vRaw;\n\trawPct = 0;\n\tif(vRaw != 0)\n\t{\n\t\trawPct = rawVar / vRaw * 100;\n\t}\n\telse if(eRaw != 0)\n\t{\n\t\trawPct = 100;\n\t}\n\trawWidth = rawPct;\n\tif(rawWidth &lt; 0)\n\t{\n\t\trawWidth = rawWidth * -1;\n\t}\n\tif(rawWidth &gt; 100)\n\t{\n\t\trawWidth = 100;\n\t}\n\tif(rawWidth &gt; 0 &amp;&amp; rawWidth &lt; 3)\n\t{\n\t\trawWidth = 3;\n\t}\n\trawClass = &quot;is-neutral&quot;;\n\tif(rawVar &gt; 0)\n\t{\n\t\trawClass = &quot;is-positive&quot;;\n\t}\n\tif(rawVar &lt; 0)\n\t{\n\t\trawClass = &quot;is-negative&quot;;\n\t}\n\tconVar = eCons - vCons;\n\tconPct = 0;\n\tif(vCons != 0)\n\t{\n\t\tconPct = conVar / vCons * 100;\n\t}\n\telse if(eCons != 0)\n\t{\n\t\tconPct = 100;\n\t}\n\tconWidth = conPct;\n\tif(conWidth &lt; 0)\n\t{\n\t\tconWidth = conWidth * -1;\n\t}\n\tif(conWidth &gt; 100)\n\t{\n\t\tconWidth = 100;\n\t}\n\tif(conWidth &gt; 0 &amp;&amp; conWidth &lt; 3)\n\t{\n\t\tconWidth = 3;\n\t}\n\tconClass = &quot;is-neutral&quot;;\n\tif(conVar &gt; 0)\n\t{\n\t\tconClass = &quot;is-positive&quot;;\n\t}\n\tif(conVar &lt; 0)\n\t{\n\t\tconClass = &quot;is-negative&quot;;\n\t}\n\ttotVar = eTotal - vTotal;\n\ttotPct = 0;\n\tif(vTotal != 0)\n\t{\n\t\ttotPct = totVar / vTotal * 100;\n\t}\n\telse if(eTotal != 0)\n\t{\n\t\ttotPct = 100;\n\t}\n\ttotWidth = totPct;\n\tif(totWidth &lt; 0)\n\t{\n\t\ttotWidth = totWidth * -1;\n\t}\n\tif(totWidth &gt; 100)\n\t{\n\t\ttotWidth = 100;\n\t}\n\tif(totWidth &gt; 0 &amp;&amp; totWidth &lt; 3)\n\t{\n\t\ttotWidth = 3;\n\t}\n\ttotClass = &quot;is-neutral&quot;;\n\tif(totVar &gt; 0)\n\t{\n\t\ttotClass = &quot;is-positive&quot;;\n\t}\n\tif(totVar &lt; 0)\n\t{\n\t\ttotClass = &quot;is-negative&quot;;\n\t}\n\tebiVar = eEbitda - vEbitda;\n\tebiPct = 0;\n\tif(vEbitda != 0)\n\t{\n\t\tebiPct = ebiVar / vEbitda * 100;\n\t}\n\telse if(eEbitda != 0)\n\t{\n\t\tebiPct = 100;\n\t}\n\tebiWidth = ebiPct;\n\tif(ebiWidth &lt; 0)\n\t{\n\t\tebiWidth = ebiWidth * -1;\n\t}\n\tif(ebiWidth &gt; 100)\n\t{\n\t\tebiWidth = 100;\n\t}\n\tif(ebiWidth &gt; 0 &amp;&amp; ebiWidth &lt; 3)\n\t{\n\t\tebiWidth = 3;\n\t}\n\tebiClass = &quot;is-neutral&quot;;\n\tif(ebiVar &gt; 0)\n\t{\n\t\tebiClass = &quot;is-positive&quot;;\n\t}\n\tif(ebiVar &lt; 0)\n\t{\n\t\tebiClass = &quot;is-negative&quot;;\n\t}\n\tmarVar = eMargin - vMargin;\n\tmarPct = 0;\n\tif(vMargin != 0)\n\t{\n\t\tmarPct = marVar / vMargin * 100;\n\t}\n\telse if(eMargin != 0)\n\t{\n\t\tmarPct = 100;\n\t}\n\tmarWidth = marPct;\n\tif(marWidth &lt; 0)\n\t{\n\t\tmarWidth = marWidth * -1;\n\t}\n\tif(marWidth &gt; 100)\n\t{\n\t\tmarWidth = 100;\n\t}\n\tif(marWidth &gt; 0 &amp;&amp; marWidth &lt; 3)\n\t{\n\t\tmarWidth = 3;\n\t}\n\tmarClass = &quot;is-neutral&quot;;\n\tif(marVar &gt; 0)\n\t{\n\t\tmarClass = &quot;is-positive&quot;;\n\t}\n\tif(marVar &lt; 0)\n\t{\n\t\tmarClass = &quot;is-negative&quot;;\n\t}\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Scenario Variance Bars&lt;/h5&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Variance is EBITDA-maximising scenario minus volume-maximising scenario.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=volClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Volume MT&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vVolume%&gt; | Compare &lt;%=eVolume%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=volWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;&lt;%=volVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=volPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=revClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Revenue&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vRevenue%&gt; | Compare &lt;%=eRevenue%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=revWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=revVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=revPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=rawClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Raw Material Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vRaw%&gt; | Compare &lt;%=eRaw%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=rawWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=rawVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=rawPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=conClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Consumables Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vCons%&gt; | Compare &lt;%=eCons%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=conWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=conVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=conPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=totClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Total Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vTotal%&gt; | Compare &lt;%=eTotal%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=totWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=totVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=totPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=ebiClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;EBITDA&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vEbitda%&gt; | Compare &lt;%=eEbitda%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=ebiWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=ebiVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=ebiPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=marClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;EBITDA Margin Percent&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vMargin%&gt;% | Compare &lt;%=eMargin%&gt;%&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=marWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;&lt;%=marVar%&gt; pts&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=marPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Plant_Scenario_Table' elementName='Plant_Scenario_Table' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Scenario_Table()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[ID != 0] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tconsolidations = Volume_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tconsolidations = Volume_Consolidations[Budget_Cycle == selectedCycle.ID] sort by Consolidation_No desc;\n\t}\n%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t&lt;h3 style=&quot;margin:0 0 6px;color:var(--zcs_primary_text_color);&quot;&gt;SCM Consolidation Summary&lt;/h3&gt;\n\t\t&lt;p style=&quot;margin:0 0 14px;color:var(--zcs_secondary_text_color);font-size:13px;&quot;&gt;Valid SCM review records linked to the selected budget cycle.&lt;/p&gt;\n\t\t&lt;table class=&quot;scenario-table&quot;&gt;\n\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Consolidation&lt;/th&gt;&lt;th&gt;FY&lt;/th&gt;&lt;th&gt;Plant&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Decision&lt;/th&gt;&lt;th&gt;Latest Revision&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;%\n\tif(consolidations.count() == 0)\n\t{\n%&gt;\n\t\t\t\t&lt;tr&gt;&lt;td colspan=&quot;6&quot; style=&quot;text-align:center;color:var(--zcs_secondary_text_color);&quot;&gt;No SCM consolidations found for the selected cycle.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each rec in consolidations\n\t\t{\n%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Consolidation_No%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Requested_Financial_Year.Year_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Plant.Plant_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Status%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.SCM_Decision%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=ifNull(rec.Latest_Revision_No,0)%&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n%&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Management_Decision_Panel' elementName='Management_Decision_Panel' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Management_Decision_Panel()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[ID != 0] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvolumeDecision = ifNull(volumeFinancial.Management_Decision,&quot;Pending&quot;);\n\tebitdaDecision = ifNull(ebitdaFinancial.Management_Decision,&quot;Pending&quot;);\n\tvolumeStatus = ifNull(volumeFinancial.Status,&quot;Not Created&quot;);\n\tebitdaStatus = ifNull(ebitdaFinancial.Status,&quot;Not Created&quot;);\n\tvolumeDraftClass = &quot;&quot;;\n\tvolumeSubmittedClass = &quot;&quot;;\n\tvolumeApprovedClass = &quot;&quot;;\n\tvolumeLockedClass = &quot;&quot;;\n\tif(volumeStatus == &quot;Draft&quot;)\n\t{\n\t\tvolumeDraftClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Submitted to Management&quot;)\n\t{\n\t\tvolumeSubmittedClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Approved Final&quot;)\n\t{\n\t\tvolumeApprovedClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Locked&quot;)\n\t{\n\t\tvolumeLockedClass = &quot;active&quot;;\n\t}\n\tebitdaDraftClass = &quot;&quot;;\n\tebitdaSubmittedClass = &quot;&quot;;\n\tebitdaApprovedClass = &quot;&quot;;\n\tebitdaLockedClass = &quot;&quot;;\n\tif(ebitdaStatus == &quot;Draft&quot;)\n\t{\n\t\tebitdaDraftClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Submitted to Management&quot;)\n\t{\n\t\tebitdaSubmittedClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Approved Final&quot;)\n\t{\n\t\tebitdaApprovedClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Locked&quot;)\n\t{\n\t\tebitdaLockedClass = &quot;active&quot;;\n\t}\n\tcurrentDecision = &quot;Pending&quot;;\n\tif(volumeDecision != &quot;Pending&quot;)\n\t{\n\t\tcurrentDecision = volumeDecision;\n\t}\n\tif(ebitdaDecision != &quot;Pending&quot;)\n\t{\n\t\tcurrentDecision = ebitdaDecision;\n\t}\n\tdecisionClass = &quot;zcs-badge-yellow&quot;;\n\tif(currentDecision.contains(&quot;Selected&quot;))\n\t{\n\t\tdecisionClass = &quot;zcs-badge-green&quot;;\n\t}\n\tif(currentDecision == &quot;Rejected&quot;)\n\t{\n\t\tdecisionClass = &quot;zcs-badge-red&quot;;\n\t}\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Management Decision Panel&lt;/h5&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Current approval decision and Financial Consolidation status before final lock.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=decisionClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=currentDecision%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;scenario-grid-3&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;Volume Maximising Decision&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;decision-big&quot;&gt;&lt;%=volumeDecision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-mt-8&quot;&gt;&lt;span class=&quot;scenario-muted&quot;&gt;Financial status&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=volumeStatus%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-flow&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeDraftClass%&gt;&quot;&gt;Draft&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeSubmittedClass%&gt;&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeApprovedClass%&gt;&quot;&gt;Approved Final&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeLockedClass%&gt;&quot;&gt;Locked&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;EBITDA Maximising Decision&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;decision-big&quot;&gt;&lt;%=ebitdaDecision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-mt-8&quot;&gt;&lt;span class=&quot;scenario-muted&quot;&gt;Financial status&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=ebitdaStatus%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-flow&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaDraftClass%&gt;&quot;&gt;Draft&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaSubmittedClass%&gt;&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaApprovedClass%&gt;&quot;&gt;Approved Final&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaLockedClass%&gt;&quot;&gt;Locked&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;Review Actions&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Financial_Consolidations&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Drill to Consolidations&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Approved_Final_Budgets&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Approved Final Budgets&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-16&quot;&gt;Final approval is performed in the Financial Consolidations workflow using Management Decision, Approver Action and Approval Remarks.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sourcing_Landing
		{
					displayname = "Sourcing Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sourcing_Landing_Snippet' elementName='Sourcing_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Sourcing_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Sourcing Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmyRM = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tsourcingApproval = Raw_Material_Budgets[Status == &quot;Submitted to Sourcing Manager&quot;].count();\n\tfinanceApproval = Raw_Material_Budgets[Status == &quot;Submitted to Finance&quot;].count();\n\tapproved = Raw_Material_Budgets[Status == &quot;Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tmaterials = Raw_Materials[ID != 0].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Sourcing Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Prepare raw material budgets and route commercial inputs to finance.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Raw_Material_Budgets&apos;&gt;&lt;span&gt;My RM drafts&lt;/span&gt;&lt;strong&gt;&lt;%=myRM%&gt;&lt;/strong&gt;&lt;span&gt;Draft, returned or reopened budget rows&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:RM_Budget_Status_Board&apos;&gt;&lt;span&gt;Sourcing approval&lt;/span&gt;&lt;strong&gt;&lt;%=sourcingApproval%&gt;&lt;/strong&gt;&lt;span&gt;Submitted to sourcing manager&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:RM_Budget_Status_Board&apos;&gt;&lt;span&gt;Finance review&lt;/span&gt;&lt;strong&gt;&lt;%=financeApproval%&gt;&lt;/strong&gt;&lt;span&gt;Submitted to finance&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_RM_Budgets&apos;&gt;&lt;span&gt;Approved RM budgets&lt;/span&gt;&lt;strong&gt;&lt;%=approved%&gt;&lt;/strong&gt;&lt;span&gt;Approved or locked raw material budgets&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-calculator dl-icon&apos;&gt;&lt;/i&gt; Add RM budget&lt;/span&gt;&lt;b&gt;New&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Raw_Material_Budgets&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time dl-icon&apos;&gt;&lt;/i&gt; Update my RM budgets&lt;/span&gt;&lt;b&gt;&lt;%=myRM%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Active_Raw_Materials&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-gold dl-icon&apos;&gt;&lt;/i&gt; Review material master&lt;/span&gt;&lt;b&gt;&lt;%=materials%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Review split&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=sourcingApproval%&gt; rows are with sourcing and &lt;%=financeApproval%&gt; are with finance.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Material base&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=materials%&gt; raw material master records are available for budgeting.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page System_Admin_Landing
		{
					displayname = "System Admin Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='System_Admin_Landing_Snippet' elementName='System_Admin_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage System_Admin_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;System Administrator&quot;;\n\tactiveCycles = Budget_Cycles[Status == &quot;Open&quot; || Status == &quot;In Planning&quot; || Status == &quot;Under Review&quot; || Status == &quot;Reopened&quot;].count();\n\tlockedCycles = Budget_Cycles[Status == &quot;Locked&quot; || Approved_Scenario == true].count();\n\tuserCount = Add_Users[ID != 0].count();\n\tplantCount = Plants[ID != 0].count();\n\tlineCount = Production_Lines[ID != 0].count();\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;}].count();\n\t%&gt;\n&lt;style&gt;\n.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box;color:var(--zcs_primary_text_color)}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0;color:var(--zcs_primary_text_color)}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}\n&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;\n\t&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;System Admin Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Maintain master data, budget cycles, app users and governance logs.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&apos;dl-grid&apos;&gt;\n\t\t&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Active_Budget_Cycles&apos;&gt;&lt;span&gt;Active cycles&lt;/span&gt;&lt;strong&gt;&lt;%=activeCycles%&gt;&lt;/strong&gt;&lt;span&gt;Planning cycles requiring configuration or monitoring&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Locked_Baselines&apos;&gt;&lt;span&gt;Locked baselines&lt;/span&gt;&lt;strong&gt;&lt;%=lockedCycles%&gt;&lt;/strong&gt;&lt;span&gt;Approved or locked cycle records&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Users&apos;&gt;&lt;span&gt;Application users&lt;/span&gt;&lt;strong&gt;&lt;%=userCount%&gt;&lt;/strong&gt;&lt;span&gt;Users available in the Users module&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Critical_Audit_Events&apos;&gt;&lt;span&gt;Critical audit events&lt;/span&gt;&lt;strong&gt;&lt;%=criticalEvents%&gt;&lt;/strong&gt;&lt;span&gt;Returned, reopened, locked or final approval actions&lt;/span&gt;&lt;/a&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;dl-layout&apos;&gt;\n\t\t&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:Budget_Cycles?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-progress dl-icon&apos;&gt;&lt;/i&gt; Open or revise budget cycle&lt;/span&gt;&lt;b&gt;&lt;%=activeCycles%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:Add_Users?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline users-add-27 dl-icon&apos;&gt;&lt;/i&gt; Add or update app user&lt;/span&gt;&lt;b&gt;&lt;%=userCount%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Approval_Audit_Logs&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline files-search dl-icon&apos;&gt;&lt;/i&gt; Review audit log&lt;/span&gt;&lt;b&gt;&lt;%=criticalEvents%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Master data footprint&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=plantCount%&gt; plants and &lt;%=lineCount%&gt; production lines are configured for planning.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Recommended next step&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;Start with financial years, plants, production lines and cycle status before departments submit plans.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Add_Update_User1 as "Add / Update User"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														info thisapp.permissions.assignUserInProfile(input.User_Email,input.Profile);
													info input.User_Email;
													info input.Profile;
									)
								}
							}
			
						
			}

			Delete_Users as "Delete Users"
			{
			
							type =  form
							form = Add_Users
			
							record event = on delete
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														thisapp.permissions.deleteUser(input.User_Email);
													info "deleted:" + input.User_Email;
									)
								}
							}
			
						
			}

			Disable_email as "Disable email"
			{
			
							type =  form
							form = Add_Users
			
							record event = on edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable User_Email;
													existingProfile = input.Profile;
													clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
													input.Profile = existingProfile;
									)
								}
							}
			
						
			}

			Populate_profiles_on_load as "Populate profiles on load"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
									)
								}
							}
			
						
			}

			Approval_Audit_Log_Set_Action_On as "Approval Audit Log Set Action On"
			{
			
							type =  form
							form = Approval_Audit_Log
			
							record event = on add
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Action_On == null)
													{
														input.Action_On = zoho.currenttime;
													}
									)
								}
							}
			
						
			}

			Log_Approval_Delegation_Save as "Log Approval Delegation Save"
			{
			
							type =  form
							form = Approval_Delegations
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														latestAudit = Approval_Audit_Log[Module_Name == "Approval Delegation" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													previousActive = null;
													auditAction = "Created";
													if(latestAudit.count() > 0)
													{
														previousActive = latestAudit.To_Status;
														auditAction = "Updated";
														if(input.Active == false)
														{
															auditAction = "Deactivated";
														}
													}
													relatedDisplay = input.Delegator_Email + " -> " + input.Delegate_Email + " (" + input.Module_Name + ")";
													auditId = insert into Approval_Audit_Log
													[
														Module_Name="Approval Delegation"
														Related_Record_ID=input.ID
														Related_Record_Display=relatedDisplay
														Action=auditAction
														From_Status=previousActive
														To_Status=input.Active
														Actor_Email=zoho.loginuserid
														Action_On=zoho.currenttime
														Remarks=input.Reason
														Added_User=zoho.loginuser
													];
									)
								}
							}
			
						
			}

			Validate_Approval_Delegations as "Validate Approval Delegations"
			{
			
							type =  form
							form = Approval_Delegations
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Start_Date != null && input.End_Date != null && input.End_Date < input.Start_Date)
													{
														alert(End_Date,"End Date must be on or after Start Date.");
														cancel submit;
													}
													if(input.Delegator_Email != null && input.Delegate_Email != null && input.Delegator_Email == input.Delegate_Email)
													{
														alert(Delegate_Email,"Delegate Email must be different from Delegator Email.");
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_After_Save as "Budget Cycles After Save"
			{
			
							type = form
							form = Budget_Cycles
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										fy_status = input.Status;
										if(input.Status == "Draft")
										{
											fy_status = "Draft";
										}
										financial_year_rec = Financial_Years[ID == input.Financial_Year];
										if(financial_year_rec.count() > 0)
										{
											financial_year_rec.Status = fy_status;
											if(input.Status == "Completed")
											{
												financial_year_rec.Status = "Completed";
												financial_year_rec.Completion_Date = input.Completion_Date;
											}
										}
										latestAudit = Approval_Audit_Log[Module_Name == "Budget Cycles" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										previousStatus = "";
										if(latestAudit.count() > 0)
										{
											previousStatus = latestAudit.To_Status;
										}
										if(previousStatus != input.Status)
										{
											auditAction = "Updated";
											if(previousStatus == "")
											{
												auditAction = "Created";
											}
											if(input.Status == "Completed")
											{
												auditAction = "Completed";
											}
											else if(input.Status == "Closed")
											{
												auditAction = "Locked";
											}
											else if(input.Status == "Revision Requested")
											{
												auditAction = "Revision Requested";
											}
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.ID
												Module_Name="Budget Cycles"
												Related_Record_ID=input.ID
												Related_Record_Display=input.Cycle_Code
												Action=auditAction
												From_Status=previousStatus
												To_Status=input.Status
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.Finance_Notes
												Added_User=zoho.loginuser
											];
										}
									)
								}
							}
			
						
			}

			Budget_Cycles_On_Load as "Budget Cycles On Load"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(!(isFinance || isAdmin))
													{
														disable Baseline_Locked;
														disable Approved_Scenario;
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_Validate_Add as "Budget Cycles Validate Add"
			{
			
							type = form
							form = Budget_Cycles
			
							record event = on add
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Cycle_Type == "Revision" && input.Parent_Cycle == null)
										{
											alert "Parent Cycle is required for revision cycles.";
											cancel submit;
										}
										if(input.Cycle_Type != "Revision")
										{
											active_cycle_count = Budget_Cycles[Financial_Year == input.Financial_Year && Status != "Completed" && Status != "Closed" && ID != input.ID].count();
											if(active_cycle_count > 0)
											{
												alert "Only one active non-closed budget cycle is allowed for a financial year unless this is a Revision cycle.";
												cancel submit;
											}
										}
										if(input.Status == "Revision Requested" && (input.Reopened_Modules == null || input.Reopened_Modules.size() == 0))
										{
											alert "Select at least one reopened module when revision is requested.";
											cancel submit;
										}
										if(input.Status == "Completed")
										{
											input.Finance_Completed = true;
											if(input.Completion_Date == null)
											{
												input.Completion_Date = zoho.currentdate;
											}
										}
									)
								}
							}
			
						
			}

			Budget_Cycles_Validate_Edit as "Budget Cycles Validate Edit"
			{
			
							type = form
							form = Budget_Cycles
			
							record event = on edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(old.Baseline_Locked == true && input.Status != "Completed" && input.Status != "Closed")
										{
											alert "This baseline is locked. Reopen through Finance before editing an active stage.";
											cancel submit;
										}
										if(input.Cycle_Type == "Revision" && input.Parent_Cycle == null)
										{
											alert "Parent Cycle is required for revision cycles.";
											cancel submit;
										}
										if(input.Cycle_Type != "Revision")
										{
											active_cycle_count = Budget_Cycles[Financial_Year == input.Financial_Year && Status != "Completed" && Status != "Closed" && ID != input.ID].count();
											if(active_cycle_count > 0)
											{
												alert "Only one active non-closed budget cycle is allowed for a financial year unless this is a Revision cycle.";
												cancel submit;
											}
										}
										if(input.Status == "Revision Requested" && (input.Reopened_Modules == null || input.Reopened_Modules.size() == 0))
										{
											alert "Select at least one reopened module when revision is requested.";
											cancel submit;
										}
										if(input.Status == "Completed")
										{
											input.Finance_Completed = true;
											if(input.Completion_Date == null)
											{
												input.Completion_Date = zoho.currentdate;
											}
										}
									)
								}
							}
			
						
			}

			Capacity_TEP_Plans_After_Save as "Capacity TEP Plans After Save"
			{
			
							type = form
							form = Capacity_TEP_Plans
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										currentStatus = input.Status;
										actionValue = input.Approver_Action;
										newStatus = currentStatus;
										auditAction = "Updated";
										shouldAudit = false;
										if(actionValue == "Submit" && (currentStatus == "Draft" || currentStatus == "Returned by Operations Approval" || currentStatus == "Revision Requested by SCM" || currentStatus == "Revised Draft"))
										{
											newStatus = "Submitted to Operations Approval";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Approve" && currentStatus == "Submitted to Operations Approval")
										{
											newStatus = "Operations Approved";
											input.Operations_Approved_By = zoho.loginuserid;
											input.Operations_Approved_On = zoho.currenttime;
											auditAction = "Approved";
											shouldAudit = true;
										}
										else if(actionValue == "Return" && currentStatus == "Submitted to Operations Approval")
										{
											newStatus = "Returned by Operations Approval";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Returned";
											shouldAudit = true;
										}
										else if(actionValue == "Create Revision Copy")
										{
											newStatus = "Revised Draft";
											input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
											auditAction = "Revision Copy Created";
											shouldAudit = true;
										}
										else if(actionValue == "Lock")
										{
											newStatus = "Locked";
											input.Locked = true;
											auditAction = "Locked";
											shouldAudit = true;
										}
										latestAudit = Approval_Audit_Log[Module_Name == "Operations Availability" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										if(latestAudit.count() == 0)
										{
											createdAuditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Operations Availability"
												Related_Record_ID=input.ID
												Related_Record_Display="Availability Plan " + input.Capacity_No
												Action="Created"
												From_Status=""
												To_Status=currentStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Operations availability plan created."
												Added_User=zoho.loginuser
											];
										}
										if(shouldAudit == true)
										{
											input.Status = newStatus;
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Operations Availability"
												Related_Record_ID=input.ID
												Related_Record_Display="Availability Plan " + input.Capacity_No
												Action=auditAction
												From_Status=currentStatus
												To_Status=newStatus
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.Approval_Remarks
												Added_User=zoho.loginuser
											];
											if(newStatus == "Operations Approved")
											{
												cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
												if(cycleRec.count() > 0)
												{
													approvedProductionCount = Operations_Production_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"].count();
													if(approvedProductionCount > 0)
													{
														cycleRec.Operations_Approved = true;
														if(cycleRec.Sales_Approved == true)
														{
															cycleRec.Status = "Pending SCM";
														}
														else
														{
															cycleRec.Status = "Pending Sales";
														}
													}
												}
											}
											input.Approver_Action = null;
										}
									)
								}
							}
			
						
			}

			Capacity_TEP_Plans_On_Load as "Capacity TEP Plans On Load"
			{
			
							type = form
							form = Capacity_TEP_Plans
			
							record event = on add or edit
			
							on load
							{
								actions
								{
									custom deluge script
									(
										if(input.Owner_Email == null)
										{
											input.Owner_Email = zoho.loginuserid;
										}
										if(input.Status == null)
										{
											input.Status = "Draft";
										}
										if(input.Requested_Financial_Year != null && input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
										}
										disable Budget_Cycle;
										disable Annual_Calendar_Hours;
										disable Annual_Available_Hours;
										disable Annual_Net_Running_Hours;
										disable Average_Equipment_Availability_Percent;
										disable Average_Equipment_Utilization_Percent;
										disable Status;
										disable Iteration_Count;
										disable Locked;
										disable Owner_Email;
										disable Operations_Approved_By;
										disable Operations_Approved_On;
										hide Approval_Remarks;
										if(input.Locked == true || input.Status == "Locked" || input.Status == "Superseded")
										{
											disable Requested_Financial_Year;
											disable Plant;
											disable Production_Line;
											disable Revision_No;
											disable Parent_Availability_Plan;
											disable Approver_Action;
											disable Approval_Remarks;
										}
										if(input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
									)
								}
							}
			
						
			}

			Capacity_TEP_Plans_Validate as "Capacity TEP Plans Validate"
			{
			
							type = form
							form = Capacity_TEP_Plans
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Locked == true || input.Status == "Locked" || input.Status == "Superseded")
										{
											alert "This Operations availability plan is locked or superseded and cannot be edited.";
											cancel submit;
										}
										if(input.Budget_Cycle == null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
											else
											{
												alert "An active Budget Cycle is required for the selected Financial Year.";
												cancel submit;
											}
										}
										annualCalendar = 0;
										annualAvailable = 0;
										annualNet = 0;
										availabilitySum = 0;
										utilizationSum = 0;
										rowCount = 0;
										for each monthRow in input.Monthly_Availability_Lines
										{
											if(monthRow.Month == null)
											{
												alert "Month is required in every availability row.";
												cancel submit;
											}
											if(ifNull(monthRow.Calendar_Hours,0) < 0 || ifNull(monthRow.Holidays_Hours,0) < 0 || ifNull(monthRow.Planned_Down_Time_Hours,0) < 0 || ifNull(monthRow.Capital_Shutdown_Hours,0) < 0 || ifNull(monthRow.Setup_Change_Time_Hours,0) < 0 || ifNull(monthRow.Steckel_Mill_Work_Roll_Change_Hours,0) < 0 || ifNull(monthRow.Roughing_Mill_Work_Roll_Change_Hours,0) < 0 || ifNull(monthRow.Unforeseen_Delay_Breakdowns_Hours,0) < 0)
											{
												alert "Availability hour values cannot be negative.";
												cancel submit;
											}
											available = ifNull(monthRow.Calendar_Hours,0) - ifNull(monthRow.Holidays_Hours,0) - ifNull(monthRow.Planned_Down_Time_Hours,0) - ifNull(monthRow.Capital_Shutdown_Hours,0) - ifNull(monthRow.Setup_Change_Time_Hours,0) - ifNull(monthRow.Steckel_Mill_Work_Roll_Change_Hours,0) - ifNull(monthRow.Roughing_Mill_Work_Roll_Change_Hours,0);
											if(available < 0)
											{
												alert "Available Hours cannot be negative after subtracting downtime.";
												cancel submit;
											}
											netRun = available - ifNull(monthRow.Unforeseen_Delay_Breakdowns_Hours,0);
											if(netRun < 0)
											{
												alert "Net Running Hours cannot be negative.";
												cancel submit;
											}
											monthRow.Available_Hours = available;
											monthRow.Net_Running_Hours = netRun;
											if(ifNull(monthRow.Calendar_Hours,0) > 0)
											{
												monthRow.Equipment_Availability_Percent = available / monthRow.Calendar_Hours * 100;
											}
											else
											{
												monthRow.Equipment_Availability_Percent = 0;
											}
											if(available > 0)
											{
												monthRow.Equipment_Utilization_Percent = netRun / available * 100;
											}
											else
											{
												monthRow.Equipment_Utilization_Percent = 0;
											}
											annualCalendar = annualCalendar + ifNull(monthRow.Calendar_Hours,0);
											annualAvailable = annualAvailable + available;
											annualNet = annualNet + netRun;
											availabilitySum = availabilitySum + ifNull(monthRow.Equipment_Availability_Percent,0);
											utilizationSum = utilizationSum + ifNull(monthRow.Equipment_Utilization_Percent,0);
											rowCount = rowCount + 1;
										}
										input.Annual_Calendar_Hours = annualCalendar;
										input.Annual_Available_Hours = annualAvailable;
										input.Annual_Net_Running_Hours = annualNet;
										if(rowCount > 0)
										{
											input.Average_Equipment_Availability_Percent = availabilitySum / rowCount;
											input.Average_Equipment_Utilization_Percent = utilizationSum / rowCount;
										}
										else
										{
											input.Average_Equipment_Availability_Percent = 0;
											input.Average_Equipment_Utilization_Percent = 0;
										}
										if((input.Approver_Action == "Return" || input.Approver_Action == "Create Revision Copy") && (input.Approval_Remarks == null || input.Approval_Remarks == ""))
										{
											alert "Approval remarks are required for Return or Create Revision Copy actions.";
											cancel submit;
										}
									)
								}
							}
			
						
			}

			Capacity_Requested_Financial_Year_On_User_Input as "Capacity Requested Financial Year On User Input"
			{
			
							type = form
							form = Capacity_TEP_Plans
			
							record event = on add or edit
			
							on user input of Requested_Financial_Year
							{
								actions
								{
									custom deluge script
									(
										input.Budget_Cycle = null;
										if(input.Requested_Financial_Year != null)
										{
											activeCycle = Budget_Cycles[Financial_Year == input.Requested_Financial_Year && Status != "Completed" && Status != "Closed"] sort by Opened_Date desc range from 0 to 0;
											if(activeCycle.count() > 0)
											{
												input.Budget_Cycle = activeCycle.ID;
											}
											else
											{
												alert "No active Budget Cycle exists for the selected Financial Year.";
											}
											fyMonths = Financial_Year_Months[Financial_Year == input.Requested_Financial_Year && Included == true] sort by Month_Order;
											if(fyMonths.count() == 0)
											{
												alert "No included months are configured for the selected Financial Year.";
											}
										}
									)
								}
							}
			
						
			}

			Log_Consumables_Master_Data as "Log Consumables Master Data"
			{
			
							type =  form
							form = Consumables
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														auditAction = "Created";
													existingAudit = Approval_Audit_Log[Module_Name == "Consumable" && Related_Record_ID == input.ID] range from 1 to 1;
													if(existingAudit.count() > 0)
													{
														auditAction = "Updated";
													}
													relatedDisplay = input.Consumable_Code + " - " + input.Consumable_Name;
													auditId = insert into Approval_Audit_Log
													[
														Module_Name="Consumable"
														Related_Record_ID=input.ID
														Related_Record_Display=relatedDisplay
														Action=auditAction
														To_Status=input.Active
														Actor_Email=zoho.loginuserid
														Action_On=zoho.currenttime
														Remarks="Consumable master data change logged by system workflow."
														Added_User=zoho.loginuser
													];
													info "Consumable master-data " + auditAction + ": " + input.Consumable_Code;
									)
								}
							}
			
						
			}

			Consumables_Budgets_After_Save as "Consumables Budgets After Save"
			{
			
							type =  form
							form = Consumables_Budgets
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Best_Three_Month_Average != null && input.Previous_Year_Budget_Norm == null || input.Best_Three_Month_Average < input.Previous_Year_Budget_Norm)
													{
														input.Calculated_Budget_Norm = input.Best_Three_Month_Average;
													}
													else
													{
														input.Calculated_Budget_Norm = ifNull(input.Previous_Year_Budget_Norm,0);
													}
													if(input.Override_Norm != null)
													{
														input.Applied_Norm = input.Override_Norm;
													}
													else
													{
														input.Applied_Norm = input.Calculated_Budget_Norm;
													}
													currentStatus = input.Status;
													actionValue = input.Approver_Action;
													newStatus = currentStatus;
													auditAction = "";
													shouldAudit = false;
													isReturn = false;
													shouldRefreshFinance = false;
													if(actionValue == "Submit" && currentStatus == "Draft" || currentStatus == "Returned by Plant Manager" || currentStatus == "Returned by Finance" || currentStatus == "Reopened")
													{
														newStatus = "Submitted to Plant Manager";
														auditAction = "Submitted";
														shouldAudit = true;
													}
													else if(actionValue == "Approve" && currentStatus == "Submitted to Plant Manager")
													{
														newStatus = "Submitted to Finance";
														auditAction = "Approved";
														shouldAudit = true;
													}
													else if(actionValue == "Approve" && currentStatus == "Submitted to Finance")
													{
														newStatus = "Approved";
														auditAction = "Approved";
														shouldAudit = true;
														shouldRefreshFinance = true;
													}
													else if(actionValue == "Lock" && currentStatus == "Submitted to Finance" || currentStatus == "Approved")
													{
														newStatus = "Locked";
														input.Locked = true;
														auditAction = "Locked";
														shouldAudit = true;
														shouldRefreshFinance = true;
													}
													else if(actionValue == "Return")
													{
														isReturn = true;
														auditAction = "Returned";
														shouldAudit = true;
														if(currentStatus == "Submitted to Plant Manager")
														{
															newStatus = "Returned by Plant Manager";
														}
														else if(currentStatus == "Submitted to Finance")
														{
															newStatus = "Returned by Finance";
														}
													}
													else if(actionValue == "Reopen" && currentStatus == "Approved" || currentStatus == "Locked")
													{
														newStatus = "Reopened";
														input.Locked = false;
														isReturn = true;
														auditAction = "Reopened";
														shouldAudit = true;
														shouldRefreshFinance = true;
													}
													latestAudit = Approval_Audit_Log[Module_Name == "Consumables Budget" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													if(latestAudit.count() == 0)
													{
														createdAuditId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="Consumables Budget"
															Related_Record_ID=input.ID
															Related_Record_Display="Consumables Budget " + input.Consumables_Budget_No
															Action="Created"
															From_Status=""
															To_Status=currentStatus
															Iteration_Number=input.Iteration_Count
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks="Consumables budget created."
															Added_User=zoho.loginuser
														];
													}
													if(shouldAudit == true)
													{
														if(isReturn == true)
														{
															input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
														}
														input.Status = newStatus;
														auditRecordId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.Budget_Cycle
															Module_Name="Consumables Budget"
															Related_Record_ID=input.ID
															Related_Record_Display="Consumables Budget " + input.Consumables_Budget_No
															Action=auditAction
															From_Status=currentStatus
															To_Status=newStatus
															Iteration_Number=input.Iteration_Count
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks=input.Approval_Remarks
															Added_User=zoho.loginuser
														];
														if(isReturn == true && input.Owner_Email != null)
														{
															sendmail
															[
																from :zoho.adminuserid
																to :input.Owner_Email
																subject :"Consumables Budget Returned: " + input.Consumables_Budget_No
																message :"Your Consumables Budget has been returned from " + currentStatus + ". Remarks: " + input.Approval_Remarks
															]
														}
														input.Approver_Action = null;
													}
													if(shouldRefreshFinance == true && input.Budget_Cycle != null)
													{
														consumablesCost = 0.0;
														approvedBudgets = Consumables_Budgets[Budget_Cycle == input.Budget_Cycle && Status in {"Approved","Locked"}];
														for each  approvedBudget in approvedBudgets
														{
															consumablesCost = consumablesCost + ifNull(approvedBudget.Total_Consumable_Cost,0);
														}
														relatedConsolidations = Financial_Consolidations[Budget_Cycle == input.Budget_Cycle];
														for each  relatedConsolidation in relatedConsolidations
														{
															relatedConsolidation.Consumables_Cost=consumablesCost;
														}
													}
									)
								}
							}
			
						
			}

			Consumables_Budgets_On_Load as "Consumables Budgets On Load"
			{
			
							type =  form
							form = Consumables_Budgets
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													if(input.Iteration_Count == null)
													{
														input.Iteration_Count = 0;
													}
													if(input.Locked == null)
													{
														input.Locked = false;
													}
													if(input.Half_Year_Split == null || input.Half_Year_Split == "")
													{
														input.Half_Year_Split = "No Split";
													}
													if(input.Production_Basis_MT == null || input.Production_Basis_MT == 0 && input.Budget_Cycle != null && input.Plant != null)
													{
														productionBasis = 0.0;
														if(input.Production_Line != null)
														{
															capacityPlans = Capacity_TEP_Plans[Budget_Cycle == input.Budget_Cycle && Plant == input.Plant && Production_Line == input.Production_Line && Status == "Operations Approved"];
															for each  capacityPlan in capacityPlans
															{
																productionBasis = productionBasis + ifNull(capacityPlan.Annual_Net_Running_Hours,0);
															}
														}
														if(productionBasis > 0)
														{
															input.Production_Basis_MT = productionBasis;
														}
													}
													disable Calculated_Budget_Norm;
													disable Applied_Norm;
													disable Status;
													disable Iteration_Count;
													disable Locked;
													disable Owner_Email;
													hide Approver_Action;
													hide Approval_Remarks;
													disable Approver_Action;
													disable Approval_Remarks;
													if(input.Locked == true)
													{
														disable Budget_Cycle;
														disable Plant;
														disable Production_Line;
														disable Consumable;
														disable Previous_Year_Budget_Norm;
														disable Previous_Year_Actual_Average;
														disable Best_Three_Month_Average;
														disable Override_Norm;
														disable Override_Justification;
														disable Half_Year_Split;
														disable H1_Norm;
														disable H2_Norm;
														disable Budget_Price_Per_Unit;
														disable Production_Basis_MT;
														disable Plant_Remarks;
													}
													isPlantOps = thisapp.permissions.isUserInProfile("Plant_Operations");
													isOperationsPPC = thisapp.permissions.isUserInProfile("Operations_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													delegatedPlantOps = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Plant_Operations" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedPlantManager = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Operations_PPC" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedFinance = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Finance_Costing" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													canAct = false;
													if(input.Status == "Draft" || input.Status == "Returned by Plant Manager" || input.Status == "Returned by Finance" || input.Status == "Reopened" && isPlantOps || isAdmin || delegatedPlantOps)
													{
														canAct = true;
													}
													else if(input.Status == "Submitted to Plant Manager" && isOperationsPPC || isAdmin || delegatedPlantManager)
													{
														canAct = true;
													}
													else if(input.Status == "Submitted to Finance" && isFinance || isAdmin || delegatedFinance)
													{
														canAct = true;
													}
													else if(input.Status == "Approved" || input.Status == "Locked" && isFinance || isAdmin || delegatedFinance)
													{
														canAct = true;
													}
													if(canAct == true)
													{
														show Approver_Action;
														enable Approver_Action;
														if(input.Approver_Action == "Return" || input.Approver_Action == "Reopen")
														{
															show Approval_Remarks;
															enable Approval_Remarks;
														}
													}
									)
								}
							}
			
						
			}

			Consumables_Budgets_Validate as "Consumables Budgets Validate"
			{
			
							type =  form
							form = Consumables_Budgets
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Override_Norm != null && input.Override_Justification == null)
													{
														alert(Override_Justification,"Override justification is required when Override Norm is entered.");
														cancel submit;
													}
													if(input.Override_Norm != null && input.Override_Justification != null && input.Override_Justification == "")
													{
														alert(Override_Justification,"Override justification is required when Override Norm is entered.");
														cancel submit;
													}
													if(input.Half_Year_Split == "Separate H1 and H2" && input.H1_Norm == null || input.H2_Norm == null)
													{
														alert "H1 Norm and H2 Norm are required when Half Year Split is Separate H1 and H2.";
														cancel submit;
													}
													if(ifNull(input.Previous_Year_Budget_Norm,0) < 0 || ifNull(input.Previous_Year_Actual_Average,0) < 0 || ifNull(input.Best_Three_Month_Average,0) < 0 || ifNull(input.Override_Norm,0) < 0 || ifNull(input.H1_Norm,0) < 0 || ifNull(input.H2_Norm,0) < 0 || ifNull(input.Budget_Price_Per_Unit,0) < 0 || ifNull(input.Production_Basis_MT,0) < 0)
													{
														alert "Consumable norms, price and production basis cannot be negative.";
														cancel submit;
													}
													if(input.Approver_Action == "Return" || input.Approver_Action == "Reopen" && input.Approval_Remarks == null || input.Approval_Remarks == "")
													{
														alert(Approval_Remarks,"Approval remarks are required for Return/Reopen actions.");
														cancel submit;
													}
													isPlantOps = thisapp.permissions.isUserInProfile("Plant_Operations");
													isOperationsPPC = thisapp.permissions.isUserInProfile("Operations_PPC");
													isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													delegatedPlantOps = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Plant_Operations" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedPlantManager = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Operations_PPC" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedFinance = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Finance_Costing" && Module_Name == "Consumables Budget" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													if(input.Approver_Action != null && input.Approver_Action != "")
													{
														actionValid = false;
														roleAllowed = false;
														if(input.Status == "Draft" || input.Status == "Returned by Plant Manager" || input.Status == "Returned by Finance" || input.Status == "Reopened" && input.Approver_Action == "Submit")
														{
															actionValid = true;
															roleAllowed = isPlantOps || isAdmin || delegatedPlantOps;
														}
														else if(input.Status == "Submitted to Plant Manager" && input.Approver_Action == "Approve" || input.Approver_Action == "Return")
														{
															actionValid = true;
															roleAllowed = isOperationsPPC || isAdmin || delegatedPlantManager;
														}
														else if(input.Status == "Submitted to Finance" && input.Approver_Action == "Approve" || input.Approver_Action == "Return" || input.Approver_Action == "Lock")
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														else if(input.Status == "Approved" && input.Approver_Action == "Lock" || input.Approver_Action == "Reopen")
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														else if(input.Status == "Locked" && input.Approver_Action == "Reopen")
														{
															actionValid = true;
															roleAllowed = isFinance || isAdmin || delegatedFinance;
														}
														if(actionValid == false)
														{
															alert(Approver_Action,"The selected action is not valid for the current Consumables Budget status.");
															cancel submit;
														}
														if(roleAllowed == false)
														{
															alert "Your profile or active delegation is not authorised for this Consumables Budget action.";
															cancel submit;
														}
													}
													if(input.Locked == true && !(input.Approver_Action == "Reopen" && input.Status == "Locked" && isFinance || isAdmin || delegatedFinance))
													{
														alert "This Consumables Budget is locked. Reopen it through Approver Action = Reopen before editing.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Financial_Consolidations_After_Save as "Financial Consolidations After Save"
			{
				type = form
				form = Financial_Consolidations
				record event = on add or edit
			
				on success
				{
					actions
					{
						custom deluge script
						(
							if(input.Owner_Email == null)
							{
								input.Owner_Email = zoho.loginuserid;
							}
							if(input.Management_Decision == null)
							{
								input.Management_Decision = "Pending";
							}
							currentStatus = input.Status;
							actionValue = input.Approver_Action;
							newStatus = currentStatus;
							auditAction = "Updated";
							shouldAudit = false;
							isReturn = false;
							isFinalCompletion = false;
							if(actionValue == "Submit" && (currentStatus == "Draft" || currentStatus == "Returned by Management" || currentStatus == "Reopened"))
							{
								newStatus = "Submitted to Management";
								auditAction = "Submitted";
								shouldAudit = true;
							}
							else if(actionValue == "Return" && currentStatus == "Submitted to Management")
							{
								newStatus = "Returned by Management";
								auditAction = "Returned";
								shouldAudit = true;
								isReturn = true;
							}
							else if(actionValue == "Approve Final" && currentStatus == "Submitted to Management")
							{
								newStatus = "Approved Final";
								auditAction = "Final Approved";
								shouldAudit = true;
								input.Management_Decision = "Final Approved";
							}
							else if(actionValue == "Complete Budget" && currentStatus == "Approved Final")
							{
								newStatus = "Completed";
								auditAction = "Completed";
								shouldAudit = true;
								isFinalCompletion = true;
								input.Locked = true;
							}
							else if(actionValue == "Lock" && (currentStatus == "Approved Final" || currentStatus == "Completed"))
							{
								newStatus = "Locked";
								auditAction = "Locked";
								shouldAudit = true;
								isFinalCompletion = true;
								input.Locked = true;
							}
							latestAudit = Approval_Audit_Log[Module_Name == "Financial Consolidation" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
							if(latestAudit.count() == 0)
							{
								createdAuditId = insert into Approval_Audit_Log
								[
									Budget_Cycle=input.Budget_Cycle
									Module_Name="Financial Consolidation"
									Related_Record_ID=input.ID
									Related_Record_Display="Financial Consolidation " + input.Financial_Consolidation_No
									Action="Created"
									From_Status=""
									To_Status=currentStatus
									Iteration_Number=input.Iteration_Count
									Actor_Email=zoho.loginuserid
									Action_On=zoho.currenttime
									Remarks="Financial consolidation created."
									Added_User=zoho.loginuser
								];
							}
							if(shouldAudit == true)
							{
								input.Status = newStatus;
								auditRecordId = insert into Approval_Audit_Log
								[
									Budget_Cycle=input.Budget_Cycle
									Module_Name="Financial Consolidation"
									Related_Record_ID=input.ID
									Related_Record_Display="Financial Consolidation " + input.Financial_Consolidation_No
									Action=auditAction
									From_Status=currentStatus
									To_Status=newStatus
									Iteration_Number=input.Iteration_Count
									Actor_Email=zoho.loginuserid
									Action_On=zoho.currenttime
									Remarks=input.Approval_Remarks
									Added_User=zoho.loginuser
								];
								if(isFinalCompletion == true)
								{
									cycleRecords = Budget_Cycles[ID == input.Budget_Cycle];
									if(cycleRecords.count() > 0)
									{
										cycleRecords.Approved_Scenario=true;
										cycleRecords.Status="Completed";
										cycleRecords.Finance_Completed=true;
										cycleRecords.Completion_Date=zoho.currentdate;
										cycleRecords.Baseline_Locked=true;
										fyRec = Financial_Years[ID == cycleRecords.Financial_Year];
										if(fyRec.count() > 0)
										{
											fyRec.Status="Completed";
											fyRec.Completion_Date=zoho.currentdate;
										}
									}
									for each salesPlan in Sales_Plans[Budget_Cycle == input.Budget_Cycle]
									{
										salesPlan.Locked=true;
									}
									for each capacityPlan in Capacity_TEP_Plans[Budget_Cycle == input.Budget_Cycle]
									{
										capacityPlan.Locked=true;
									}
									for each productionPlan in Operations_Production_Plans[Budget_Cycle == input.Budget_Cycle]
									{
										productionPlan.Locked=true;
									}
									for each consolidation in Volume_Consolidations[Budget_Cycle == input.Budget_Cycle]
									{
										consolidation.Locked=true;
										consolidation.Status="Locked";
									}
									for each rawMaterialBudget in Raw_Material_Budgets[Budget_Cycle == input.Budget_Cycle]
									{
										rawMaterialBudget.Locked=true;
									}
									for each financialConsolidation in Financial_Consolidations[Budget_Cycle == input.Budget_Cycle]
									{
										financialConsolidation.Locked=true;
									}
								}
								input.Approver_Action = null;
							}
						)
					}
				}
			}

			Financial_Consolidations_On_Load as "Financial Consolidations On Load"
			{
				type = form
				form = Financial_Consolidations
				record event = on add or edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							if(input.Owner_Email == null)
							{
								input.Owner_Email = zoho.loginuserid;
							}
							if(input.Status == null)
							{
								input.Status = "Draft";
							}
							if(input.Management_Decision == null)
							{
								input.Management_Decision = "Pending";
							}
							if(input.Budget_Cycle != null && input.Requested_Financial_Year == null)
							{
								cycleRecords = Budget_Cycles[ID == input.Budget_Cycle];
								if(cycleRecords.count() > 0)
								{
									input.Requested_Financial_Year = cycleRecords.Financial_Year;
								}
							}
							if(input.SCM_Consolidation == null && input.Budget_Cycle != null)
							{
								scmRec = Volume_Consolidations[Budget_Cycle == input.Budget_Cycle && (Status == "SCM Approved" || Status == "Submitted to Finance")] sort by SCM_Approved_On desc range from 0 to 0;
								if(scmRec.count() > 0)
								{
									input.SCM_Consolidation = scmRec.ID;
								}
							}
							disable Volume_MT;
							disable Revenue;
							disable Raw_Material_Cost;
							disable Consumables_Cost;
							disable Status;
							disable Iteration_Count;
							disable Locked;
							disable Owner_Email;
							disable Management_Decision;
							hide Approval_Remarks;
							if(input.Locked == true)
							{
								disable Requested_Financial_Year;
								disable Budget_Cycle;
								disable SCM_Consolidation;
								disable Scenario;
								disable HR_Cost;
								disable Logistics_Cost;
								disable IT_Cost;
								disable Other_Support_Costs;
							}
							if(input.Approver_Action == "Return")
							{
								show Approval_Remarks;
								enable Approval_Remarks;
							}
						)
					}
				}
			}

			Financial_Consolidations_Validate as "Financial Consolidations Validate"
			{
			
							type =  form
							form = Financial_Consolidations
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isManagement = thisapp.permissions.isUserInProfile("Executive_Management");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													delegatedFinance = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Finance_Costing" && Module_Name == "Financial Consolidation" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													delegatedManagement = Approval_Delegations[Delegate_Email == zoho.loginuserid && Profile_Name == "Executive_Management" && Module_Name == "Financial Consolidation" && Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count() > 0;
													if((input.Approver_Action == "Return") && (input.Approval_Remarks == null || input.Approval_Remarks == ""))
													{
														alert "Approval remarks are required for Return actions.";
														cancel submit;
													}
													if(input.SCM_Consolidation == null)
													{
														alert "SCM Consolidation is required before Financial Consolidation can proceed.";
														cancel submit;
													}
													scmConsolidationRec = Volume_Consolidations[ID == input.SCM_Consolidation];
													if(scmConsolidationRec.count() == 0 || !(scmConsolidationRec.Status == "SCM Approved" || scmConsolidationRec.Status == "Submitted to Finance" || scmConsolidationRec.Status == "Locked"))
													{
														alert "Linked SCM Consolidation must be SCM Approved or Submitted to Finance.";
														cancel submit;
													}
													if(input.Approver_Action == "Submit")
													{
														if(!(isFinance || isAdmin || delegatedFinance))
														{
															alert "Only Finance Costing or System Administrator can submit Financial Consolidations to Management.";
															cancel submit;
														}
														if(!(input.Status == "Draft" || input.Status == "Returned by Management" || input.Status == "Reopened"))
														{
															alert "Financial Consolidations can be submitted only from Draft, Returned by Management, or Reopened status.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Approve Final" || input.Approver_Action == "Lock")
													{
														if(!(isManagement || isAdmin || delegatedManagement))
														{
															alert "Only Executive Management or System Administrator can approve the final Financial Consolidation.";
															cancel submit;
														}
														if(input.Status != "Submitted to Management" && !(input.Approver_Action == "Lock" && (input.Status == "Approved Final" || input.Status == "Completed")))
														{
															alert "Final approval or lock is allowed only from Submitted to Management, Approved Final, or Completed status.";
															cancel submit;
														}
														if(input.Management_Decision == null || input.Management_Decision == "" || input.Management_Decision == "Pending" || input.Management_Decision == "Rejected")
														{
															alert "Select a final Management Decision before approving the final budget.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Complete Budget")
													{
														if(!(isFinance || isAdmin || delegatedFinance))
														{
															alert "Only Finance Costing or System Administrator can complete the budget.";
															cancel submit;
														}
														if(!(input.Status == "Approved Final" || input.Status == "Completed"))
														{
															alert "Complete Budget is allowed only after final approval.";
															cancel submit;
														}
													}
													if(input.Approver_Action == "Return")
													{
														if(!(isManagement || isAdmin || delegatedManagement))
														{
															alert "Only Executive Management or System Administrator can return Financial Consolidations.";
															cancel submit;
														}
														if(input.Status != "Submitted to Management")
														{
															alert "Financial Consolidations can be returned only from Submitted to Management status.";
															cancel submit;
														}
													}
													if(input.Locked == true && input.Approver_Action != "Lock")
													{
														alert "This Financial Consolidation is locked.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Financial_Year_Months_On_Validate as "Validate Financial Year Months"
			{
			
							type = form
							form = Financial_Year_Months
			
							record event = on add or edit
			
							on validate
							{
								actions
								{
									custom deluge script
									(
										if(input.Month_Start_Date != null && input.Month_End_Date != null && input.Month_End_Date < input.Month_Start_Date)
										{
											alert "Month End Date cannot be before Month Start Date.";
											cancel submit;
										}
										if(input.Month_Label == null || input.Month_Label.trim() == "")
										{
											alert "Month Label is required.";
											cancel submit;
										}
										duplicate_month_count = Financial_Year_Months[Financial_Year == input.Financial_Year && Month_Order == input.Month_Order && ID != input.ID].count();
										if(duplicate_month_count > 0)
										{
											alert "Month Order must be unique for the selected Financial Year.";
											cancel submit;
										}
									)
								}
							}
			
						
			}

			Log_Financial_Year_Status_Change as "Log Financial Year Status Change"
