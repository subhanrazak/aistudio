			}

			Replanning_Requests_After_Save as "Replanning Requests After Save"
			{
			
							type = form
							form = Replanning_Requests
			
							record event = on add or edit
			
							on success
							{
								actions
								{
									custom deluge script
									(
										if(input.Requested_By_Email == null)
										{
											input.Requested_By_Email = zoho.loginuserid;
										}
										if(input.Request_Date == null)
										{
											input.Request_Date = zoho.currentdate;
										}
										if(input.Parent_Budget_Cycle != null && input.Requested_Financial_Year == null)
										{
											cycleRec = Budget_Cycles[ID == input.Parent_Budget_Cycle];
											if(cycleRec.count() > 0)
											{
												input.Requested_Financial_Year = cycleRec.Financial_Year;
											}
										}
										currentStatus = input.Status;
										actionValue = input.Approver_Action;
										newStatus = currentStatus;
										auditAction = "Updated";
										shouldAudit = false;
										if(actionValue == "Submit" && currentStatus == "Draft")
										{
											newStatus = "Submitted to Finance";
											auditAction = "Submitted";
											shouldAudit = true;
										}
										else if(actionValue == "Approve" && currentStatus == "Submitted to Finance")
										{
											newStatus = "Finance Approved";
											auditAction = "Approved";
											shouldAudit = true;
										}
										else if(actionValue == "Reject" && (currentStatus == "Submitted to Finance" || currentStatus == "Finance Approved" || currentStatus == "Draft"))
										{
											newStatus = "Rejected";
											auditAction = "Cancelled";
											shouldAudit = true;
										}
										else if(actionValue == "Mark Revision Created" && (currentStatus == "Finance Approved" || currentStatus == "In Team Revision" || currentStatus == "Submitted to Finance"))
										{
											newStatus = "Revision Created";
											auditAction = "Revision Copy Created";
											shouldAudit = true;
										}
										else if(actionValue == "Close" && (currentStatus == "Revision Created" || currentStatus == "Resubmitted to SCM" || currentStatus == "Finance Approved"))
										{
											newStatus = "Locked";
											auditAction = "Locked";
											shouldAudit = true;
										}
										latestAudit = Approval_Audit_Log[Module_Name == "Replanning Requests" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
										if(latestAudit.count() == 0)
										{
											createdAuditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Parent_Budget_Cycle
												Module_Name="Replanning Requests"
												Related_Record_ID=input.ID
												Related_Record_Display="Replanning Request " + input.Replan_No
												Action="Created"
												From_Status=""
												To_Status=currentStatus
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.Trigger_Reason
												Added_User=zoho.loginuser
											];
										}
										if(shouldAudit == true)
										{
											input.Status = newStatus;
											auditRecordId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Parent_Budget_Cycle
												Module_Name="Replanning Requests"
												Related_Record_ID=input.ID
												Related_Record_Display="Replanning Request " + input.Replan_No
												Action=auditAction
												From_Status=currentStatus
												To_Status=newStatus
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=input.Approval_Remarks
												Added_User=zoho.loginuser
											];
											input.Approver_Action = null;
										}
									)
								}
							}
			
						
			}

			Replanning_Requests_On_Load as "Replanning Requests On Load"
			{
			
							type = form
							form = Replanning_Requests
			
							record event = on add or edit
			
							on load
							{
								actions
								{
									custom deluge script
									(
										if(input.Requested_By_Email == null)
										{
											input.Requested_By_Email = zoho.loginuserid;
										}
										if(input.Request_Date == null)
										{
											input.Request_Date = zoho.currentdate;
										}
										if(input.Status == null)
										{
											input.Status = "Draft";
										}
										if(input.Parent_Budget_Cycle != null && input.Requested_Financial_Year == null)
										{
											cycleRec = Budget_Cycles[ID == input.Parent_Budget_Cycle];
											if(cycleRec.count() > 0)
											{
												input.Requested_Financial_Year = cycleRec.Financial_Year;
											}
										}
										disable Requested_By_Email;
										disable Request_Date;
										hide Approval_Remarks;
										if(input.Status == "Locked" || input.Status == "Rejected")
										{
											disable Parent_Budget_Cycle;
											disable New_Revision_Cycle;
											disable Requested_Financial_Year;
											disable Trigger_Reason;
											disable Affected_Modules;
											disable Source_Module;
											disable Source_Record_ID;
											disable New_Revision_Record_ID;
											disable Approver_Action;
											disable Approval_Remarks;
										}
										if(input.Approver_Action == "Reject" || input.Approver_Action == "Close" || input.Approver_Action == "Mark Revision Created")
										{
											show Approval_Remarks;
											enable Approval_Remarks;
										}
									)
								}
							}
			
						
			}

			Replanning_Requests_Validate as "Replanning Requests Validate"
			{
			
							type =  form
							form = Replanning_Requests
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													canFinanceAct = isFinance || isAdmin;
													if(input.Requested_By_Email == null)
													{
														input.Requested_By_Email = zoho.loginuserid;
													}
													if(input.Status == null)
													{
														input.Status = "Draft";
													}
													if(input.Affected_Modules == null || input.Affected_Modules.size() == 0)
													{
														alert "Select at least one affected module for replanning.";
														cancel submit;
													}
													parentCycle = Budget_Cycles[ID == input.Parent_Budget_Cycle] range from 0 to 0;
													if(parentCycle.count() == 0)
													{
														alert "Select a valid parent budget cycle.";
														cancel submit;
													}
													else if(!(parentCycle.Status == "Locked" || parentCycle.Status == "Approved" || parentCycle.Baseline_Locked == true || parentCycle.Approved_Scenario == true))
													{
														alert "Parent Budget Cycle must be approved or locked before annual replanning can be opened.";
														cancel submit;
													}
													isRequester = input.Requested_By_Email == zoho.loginuserid || input.Requested_By_Email == zoho.loginuser;
													if(input.Approver_Action == "Submit" && !(input.Status == "Draft" && isRequester || isAdmin))
													{
														alert "Only the requester or System Administrator can submit draft replanning requests.";
														cancel submit;
													}
													if(input.Approver_Action == "Approve" || input.Approver_Action == "Reject" || input.Approver_Action == "Create Revision" || input.Approver_Action == "Lock" && !canFinanceAct)
													{
														alert "Only Finance Costing or System Administrator can approve, reject, create, or lock replanning requests.";
														cancel submit;
													}
													if(input.Approver_Action == "Approve" && input.Status != "Submitted to Finance")
													{
														alert "Only requests submitted to Finance can be approved.";
														cancel submit;
													}
													if(input.Approver_Action == "Reject" && input.Status != "Submitted to Finance" && input.Status != "Finance Approved")
													{
														alert "Only submitted or Finance approved replanning requests can be rejected.";
														cancel submit;
													}
													if(input.Approver_Action == "Create Revision" && input.Status != "Finance Approved")
													{
														alert "Create Revision is allowed only after Finance approval.";
														cancel submit;
													}
													if(input.Approver_Action == "Lock" && input.Status != "Revision Created")
													{
														alert "Only replanning requests with a created revision can be locked.";
														cancel submit;
													}
													if(input.Approver_Action == "Reject" || input.Approver_Action == "Lock" && input.Approval_Remarks == null || input.Approval_Remarks == "")
													{
														alert "Approval remarks are required for reject or lock actions.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Monthly_SMS_Availability_Month_On_User_Input as "Monthly SMS Availability Month On User Input"
			{
			
							type =  form
							form = SMS_Capacity_Plans
			
							record event = on add or edit
			
							on load
