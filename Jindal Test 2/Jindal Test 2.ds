						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Steel_Grades
		{
		
					displayname = "Products"
					Grade_Details
					(
						type = section
