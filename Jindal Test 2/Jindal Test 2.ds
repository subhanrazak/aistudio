					filters
					(
						Profile_Name
						Module_Name
						Active
						Start_Date
						End_Date
					)
					sort by
					(
						Start_Date descending
					)
				
		}

		list Delegations_By_Module
		{
		
					displayName = "Delegations By Module"
					show all rows from Approval_Delegations    
