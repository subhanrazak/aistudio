		form Consumables
		{
		
					Section
					(
						type = section
						displayname = "Consumable Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Consumable_Code
					(
		    			type = text
						displayname = "Consumable Code"
						maxchar = 30
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Consumable_Name
					(
		    			type = text
						displayname = "Consumable Name"
						maxchar = 100
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Category
					(
						type = picklist
						values = {"Acid","Gas","Shot","Fuel","Chemical","Other"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Unit_Of_Measure
					(
						type = picklist
						displayname = "Unit Of Measure"
						values = {"KG","MT","Litre","Nm3","Ton","Each"}
			 			row = 1
			 			column = 2   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 13px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
