blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=rmMine%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Approvals &lt;%=rmApproval%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:All_Raw_Material_Budgets&apos;&gt;Open report&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;New RM budget&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(isPlantOps || isOps || isFinance || isAdmin || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Consumables&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Consumable norms, overrides and plant approvals.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline ui-2-settings-90 zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=consMine%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Approvals &lt;%=consApproval%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:All_Consumables_Budgets&apos;&gt;Open report&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;New budget&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(isFinance || isExec || isAdmin || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Finance&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Financial consolidation and management decision stages.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline business-coins zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=financeMine%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mgmt &lt;%=financeApproval%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:All_Financial_Consolidations&apos;&gt;Open report&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;New consolidation&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(isFinance || isAdmin || isExec || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Replanning&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Annual revision requests and reopened modules.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=replanMine%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Active &lt;%=replanApproval%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:Active_Replanning_Requests&apos;&gt;Active requests&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;New request&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='My_Sales_Plan_Workqueue' title='My Sales Plan Workqueue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Sales_Plan_Workqueue' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Sales_Management_Approval_Queue' title='Sales Management Approval Queue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Sales_Management_Approval_Queue' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Shortfall_Buckets' title='Shortfall Buckets' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Shortfall_Buckets' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Active_Replanning_Requests' title='Active Replanning Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Active_Replanning_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Critical_Audit_Events' title='Critical Audit Events' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Critical_Audit_Events' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Action_Guidance' elementName='Action_Guidance' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Action_Guidance()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;This workbench does not use report custom-action workflows. Users act by opening the record, selecting &lt;strong&gt;Approver Action&lt;/strong&gt;, entering &lt;strong&gt;Approval Remarks&lt;/strong&gt; where required and saving. Form workflows validate the profile, delegation and current status before routing the record.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-guidance-grid zcs-py-16&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-20 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Status and action pattern&lt;/h3&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;1. Find the queue&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Department cards and embedded reports show records where your profile can enter, approve, return, reopen or lock records.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;2. Edit the record&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Open the report row or module form. The form on-load workflow enables only the relevant planning and action fields for the current status.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;3. Save to route&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;The on-validate and on-success workflows route the status, increment iterations on returns, lock approved baselines and write audit entries.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-notes-wrapper&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-notes-title zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary&apos;&gt;Operational rules:&lt;/span&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-m-0 zcs-pl-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Submit&lt;/strong&gt; from draft or returned records to move work to the next department.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Approve&lt;/strong&gt;, &lt;strong&gt;Finalise&lt;/strong&gt; or &lt;strong&gt;Approve Final&lt;/strong&gt; only when the profile owns the current approval stage.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Return&lt;/strong&gt; with remarks for corrections; returned records reappear in the originator&apos;s workqueue.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Reopen&lt;/strong&gt; or &lt;strong&gt;Lock&lt;/strong&gt; only where Finance or administrators are explicitly allowed by the module workflow.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Field&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Purpose&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Status&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Current workflow state and queue placement.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Approver Action&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;User-selected transition such as Submit, Approve, Return, Reopen, Lock or Finalise.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Approval Remarks&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Mandatory explanation for returns and reopen requests.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Locked&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Prevents further planning edits after approval or baseline lock.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Plant_Operations_Landing
		{
					displayname = "Plant Operations Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Plant_Operations_Landing_Snippet' elementName='Plant_Operations_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Operations_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Plant Operations&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmyConsumables = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tplantApproval = Consumables_Budgets[Status == &quot;Submitted to Plant Manager&quot;].count();\n\tfinanceApproval = Consumables_Budgets[Status == &quot;Submitted to Finance&quot;].count();\n\tapproved = Consumables_Budgets[Status == &quot;Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tconsumables = Consumables[ID != 0].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Plant Operations Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Maintain consumables budgets and plant operating norms.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Consumables_Budgets&apos;&gt;&lt;span&gt;My consumable drafts&lt;/span&gt;&lt;strong&gt;&lt;%=myConsumables%&gt;&lt;/strong&gt;&lt;span&gt;Draft, returned or reopened rows&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Consumables_Status_Board&apos;&gt;&lt;span&gt;Plant approval&lt;/span&gt;&lt;strong&gt;&lt;%=plantApproval%&gt;&lt;/strong&gt;&lt;span&gt;Rows with plant manager&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Consumables_Status_Board&apos;&gt;&lt;span&gt;Finance review&lt;/span&gt;&lt;strong&gt;&lt;%=financeApproval%&gt;&lt;/strong&gt;&lt;span&gt;Rows submitted to finance&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Consumables_Budgets&apos;&gt;&lt;span&gt;Approved budgets&lt;/span&gt;&lt;strong&gt;&lt;%=approved%&gt;&lt;/strong&gt;&lt;span&gt;Approved or locked consumable budgets&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-math dl-icon&apos;&gt;&lt;/i&gt; Add consumables budget&lt;/span&gt;&lt;b&gt;New&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Consumables_Budgets&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time dl-icon&apos;&gt;&lt;/i&gt; Update my budgets&lt;/span&gt;&lt;b&gt;&lt;%=myConsumables%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Active_Consumables&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-stock dl-icon&apos;&gt;&lt;/i&gt; Review consumable master&lt;/span&gt;&lt;b&gt;&lt;%=consumables%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Review split&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=plantApproval%&gt; records are pending plant action and &lt;%=financeApproval%&gt; are waiting for finance.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Master data&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=consumables%&gt; active consumable records support budget entry.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page SCM_Landing
		{
					displayname = "SCM Review Workbench"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='SCM_Review_Summary' elementName='SCM_Review_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage SCM_Review_Summary()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;SCM Central PPC&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\treadyPlans = Volume_Consolidations[Status == &quot;Under SCM Review&quot;];\n\trevisionPlans = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;];\n\tapprovedPlans = Volume_Consolidations[Status == &quot;SCM Approved&quot;];\n\tscmPlans = Volume_Consolidations[Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; || Status == &quot;SCM Approved&quot;];\n\treadyCount = readyPlans.count();\n\trevisionCount = revisionPlans.count();\n\tapprovedCount = approvedPlans.count();\n\ttotalSalesTarget = 0.0;\n\ttotalOperationsProduction = 0.0;\n\ttotalToBeRaised = 0.0;\n\ttotalCostForecast = 0.0;\n\tmatrixRowCount = 0;\n\tfor each plan in scmPlans\n\t{\n\t\tfor each line in plan.SCM_Review_Lines\n\t\t{\n\t\t\ttotalSalesTarget = totalSalesTarget + ifnull(line.Sales_Target_Tons,0);\n\t\t\ttotalOperationsProduction = totalOperationsProduction + ifnull(line.Operations_Production_Tons,0);\n\t\t\ttotalToBeRaised = totalToBeRaised + ifnull(line.To_Be_Raised_MT,0);\n\t\t\ttotalCostForecast = totalCostForecast + ifnull(line.Cost_Forecast,0);\n\t\t\tmatrixRowCount = matrixRowCount + 1;\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0%}.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}\n/* ZCS card, table, timeline, badge and button components */\n.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094c5}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color);border:1px solid var(--zcs-white-color);box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}\n.scm-workbench{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.scm-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.scm-hero h1{margin:0 0 8px;font-size:26px;line-height:1.2}.scm-hero p{margin:0;opacity:.92;max-width:920px}.scm-hero-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px;color:var(--zcs_brand_foreground_color);white-space:nowrap}.scm-kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(170px,1fr));gap:14px;margin-top:16px}.scm-kpi{min-height:132px;display:flex;flex-direction:column;justify-content:space-between}.scm-kpi-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.scm-kpi-value{font-size:26px;font-weight:700;line-height:1.1;color:var(--zcs_primary_text_color);margin-top:10px}.scm-section{margin-top:16px}.scm-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.scm-section-head h2{margin:0;font-size:20px;color:var(--zcs_primary_text_color)}.scm-note{font-size:13px;color:var(--zcs_secondary_text_color)}.scm-guidance-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.scm-guidance-card{display:flex;gap:14px;align-items:flex-start}.scm-guidance-card i{color:var(--zcs_brand_color);font-size:22px;margin-top:2px}.scm-guidance-card h3{margin:0 0 6px;font-size:16px;color:var(--zcs_primary_text_color)}.scm-guidance-card p{margin:0 0 12px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-dual-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.scm-comments{max-width:280px;white-space:normal}.scm-empty{padding:24px;text-align:center;color:var(--zcs_secondary_text_color);background:#fff;border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.scm-mini-table td,.scm-mini-table th{font-size:13px}.scm-panel{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px;box-sizing:border-box}@media(max-width:1280px){.scm-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.scm-dual-grid,.scm-guidance-grid{grid-template-columns:1fr}}@media(max-width:768px){.scm-workbench{padding:12px}.scm-hero{flex-direction:column}.scm-kpi-grid{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li{flex-direction:column}.zcs-px-60{padding-left:3.75rem;padding-right:1rem}}\n&lt;/style&gt;\n&lt;div class=&apos;scm-workbench&apos;&gt;\n\t&lt;div class=&apos;scm-hero&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h1&gt;SCM Review Workbench&lt;/h1&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). This workbench surfaces only Volume Consolidations that have reached SCM-controlled statuses after Sales and Operations approval, and keeps final decisions in the linked forms and reports.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;scm-hero-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-kpi-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;SCM-ready plans&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=readyCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Revision requests pending&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=revisionCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-bold&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;SCM-approved plans&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=approvedCount%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Total sales target tons&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalSalesTarget%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Operations production tons&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalOperationsProduction%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Raw material to be raised&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalToBeRaised%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Forecast cost&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalCostForecast%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section&apos;&gt;\n\t\t&lt;div class=&apos;scm-section-head&apos;&gt;\n\t\t\t&lt;h2&gt;SCM option guidance&lt;/h2&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Revision_Requests&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Open revision queue&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-guidance-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request Sales revision&lt;/h3&gt;&lt;p&gt;Use when demand, grade mix, product mix, or sales target tons need correction before SCM approval.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request Operations revision&lt;/h3&gt;&lt;p&gt;Use when production tons, BTV measured MT, or operational feasibility needs rework.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request both revisions&lt;/h3&gt;&lt;p&gt;Use when Sales demand and Operations production both require replanning to resolve raw-material gaps.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section zcs-card zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;scm-section-head&apos;&gt;\n\t\t\t&lt;h2&gt;Review matrix by grade and product&lt;/h2&gt;\n\t\t\t&lt;span class=&apos;scm-note&apos;&gt;&lt;%=matrixRowCount%&gt; SCM review rows across visible plans&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;% if(matrixRowCount == 0) { %&gt;\n\t\t\t&lt;div class=&apos;scm-empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; No consolidation rows are currently available for SCM review.&lt;/div&gt;\n\t\t&lt;% } else { %&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plan&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Grade&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Sales Target Tons&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Operations Production Tons&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;BTV Measured MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Required Raw Material MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Available Raw Material MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;To Be Raised MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Cost Forecast&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Override comments&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-0 zcs-box-border&apos; colspan=&apos;12&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;% for each plan in scmPlans { for each line in plan.SCM_Review_Lines { statusName = ifnull(plan.Status,&quot;-&quot;); statusClass = &quot;zcs-badge-blue&quot;; if(statusName == &quot;SCM Approved&quot;) { statusClass = &quot;zcs-badge-green&quot;; } else if(statusName == &quot;Revision Requested&quot; || statusName == &quot;Sales Revision Pending&quot; || statusName == &quot;Operations Revision Pending&quot; || statusName == &quot;Both Revisions Pending&quot;) { statusClass = &quot;zcs-badge-orange&quot;; } %&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Volume_Consolidations?Consolidation_No=&lt;%=plan.Consolidation_No%&gt;&apos;&gt;&lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=statusName%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Grade,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Product,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Sales_Target_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Operations_Production_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.BTV_Measured_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Required_Raw_Material_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Available_Raw_Material_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.To_Be_Raised_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Cost_Forecast,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary scm-comments&apos;&gt;&lt;%=ifnull(line.Override_Comments,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } %&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section scm-dual-grid&apos;&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Revision history timeline&lt;/h2&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Revision_History&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Open history report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;% timelineCount = 0; for each plan in scmPlans { for each rev in plan.Revision_History_Lines { timelineCount = timelineCount + 1; if(timelineCount &lt;= 8) { revStatus = ifnull(rev.Revision_Status,&quot;Revision requested&quot;); %&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=ifnull(rev.Requested_On,&quot;-&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=revStatus%&gt;&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Plan &lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;Requested to &lt;strong&gt;&lt;%=ifnull(rev.Requested_To,&quot;-&quot;)%&gt;&lt;/strong&gt; by &lt;%=ifnull(rev.Requested_By,&quot;-&quot;)%&gt;. &lt;%=ifnull(rev.Comments,&quot;No comments recorded.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;% } } } if(timelineCount == 0) { %&gt;\n\t\t\t\t\t&lt;li class=&apos;scm-empty&apos;&gt;No revision history lines are recorded for the currently visible SCM plans.&lt;/li&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Replanning requests&lt;/h2&gt;&lt;span class=&apos;scm-note&apos;&gt;Latest SCM, Sales and Operations requests&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full scm-mini-table&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Request&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Module&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Reason&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;% reqCount = 0; for each req in Replanning_Requests[Source_Module == &quot;SCM&quot; || Source_Module == &quot;Sales&quot; || Source_Module == &quot;Operations&quot;] sort by Request_Date desc { reqCount = reqCount + 1; if(reqCount &lt;= 8) { reqStatus = ifnull(req.Status,&quot;-&quot;); reqClass = &quot;zcs-badge-blue&quot;; if(reqStatus == &quot;Approved&quot; || reqStatus == &quot;Closed&quot; || reqStatus == &quot;Locked&quot;) { reqClass = &quot;zcs-badge-green&quot;; } else if(reqStatus == &quot;Rejected&quot;) { reqClass = &quot;zcs-badge-red&quot;; } else if(reqStatus == &quot;Pending&quot; || reqStatus == &quot;Requested&quot;) { reqClass = &quot;zcs-badge-yellow&quot;; } %&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Replanning_Requests?Replan_No=&lt;%=req.Replan_No%&gt;&apos;&gt;&lt;%=ifnull(req.Replan_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(req.Source_Module,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=reqClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=reqStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(req.Trigger_Reason,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } } if(reqCount == 0) { %&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;4&apos;&gt;No replanning requests are available.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='SCM_Ready_For_Review'\n\t\t\t\ttitle='SCM Ready For Review'\n\t\t\t\tboldTitle='true'\n\t\t\t\ttitleColor='#222326'\n\t\t\t\tappLinkName='thisapp'\n\t\t\t\tlinkName='SCM_Ready_For_Review'\n\t\t\t\tiszreport='false'\n\t\t\t\tzc_Footer='true'\n\t\t\t\tzc_AddRec='false'\n\t\t\t\tzc_EditRec='true'\n\t\t\t\tzc_Print='false'\n\t\t\t\tzc_Export='false'\n\t\t\t\tzc_DelRec='false'\n\t\t\t\tzc_DuplRec='false'\n\t\t\t\tzc_Search='true'\n\t\t\t\tzc_EditBulkRec='false'\n\t\t\t\tzc_BulkDelete='false'\n\t\t\t\tzc_BulkDuplicate='false'\n\t\t\t\theightType='custom'\n\t\t\t\theightValue='520' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='SCM_Revision_Requests'\n\t\t\t\ttitle='SCM Revision Requests'\n\t\t\t\tboldTitle='true'\n\t\t\t\ttitleColor='#222326'\n\t\t\t\tappLinkName='thisapp'\n\t\t\t\tlinkName='SCM_Revision_Requests'\n\t\t\t\tiszreport='false'\n\t\t\t\tzc_Footer='true'\n\t\t\t\tzc_AddRec='false'\n\t\t\t\tzc_EditRec='true'\n\t\t\t\tzc_Print='false'\n\t\t\t\tzc_Export='false'\n\t\t\t\tzc_DelRec='false'\n\t\t\t\tzc_DuplRec='false'\n\t\t\t\tzc_Search='true'\n\t\t\t\tzc_EditBulkRec='false'\n\t\t\t\tzc_BulkDelete='false'\n\t\t\t\tzc_BulkDuplicate='false'\n\t\t\t\theightType='custom'\n\t\t\t\theightValue='520' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page SMS_Landing
		{
					displayname = "SMS Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='SMS_Landing_Snippet' elementName='SMS_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage SMS_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;SMS Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmySMS = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tcentralPPC = SMS_Capacity_Plans[Status == &quot;Submitted to Central PPC&quot;].count();\n\taccepted = SMS_Capacity_Plans[Status == &quot;Accepted&quot; || Status == &quot;Validated&quot; || Locked == true].count();\n\tbyPlant = Plants[ID != 0].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;SMS Team Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Submit steel making capacity and track acceptance by Central PPC.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_SMS_Capacity_Plans&apos;&gt;&lt;span&gt;My SMS drafts&lt;/span&gt;&lt;strong&gt;&lt;%=mySMS%&gt;&lt;/strong&gt;&lt;span&gt;Draft, returned or reopened SMS rows&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:SMS_Status_Board&apos;&gt;&lt;span&gt;Central PPC queue&lt;/span&gt;&lt;strong&gt;&lt;%=centralPPC%&gt;&lt;/strong&gt;&lt;span&gt;Submitted to Central PPC&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Accepted_SMS_Capacity&apos;&gt;&lt;span&gt;Accepted capacity&lt;/span&gt;&lt;strong&gt;&lt;%=accepted%&gt;&lt;/strong&gt;&lt;span&gt;Accepted, validated or locked rows&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:SMS_By_Plant&apos;&gt;&lt;span&gt;Plant coverage&lt;/span&gt;&lt;strong&gt;&lt;%=byPlant%&gt;&lt;/strong&gt;&lt;span&gt;Plants configured for SMS planning&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-factory dl-icon&apos;&gt;&lt;/i&gt; Add SMS capacity&lt;/span&gt;&lt;b&gt;New&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_SMS_Capacity_Plans&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time dl-icon&apos;&gt;&lt;/i&gt; Update my SMS rows&lt;/span&gt;&lt;b&gt;&lt;%=mySMS%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Submission status&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=centralPPC%&gt; SMS capacity rows are waiting with Central PPC.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Accepted base&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=accepted%&gt; rows are already accepted, validated or locked for planning.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Landing
		{
					displayname = "Sales Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Landing_Snippet' elementName='Sales_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Sales Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;))\n\t{\n\t\tprofileText = &quot;Sales Management&quot;;\n\t}\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmySalesItems = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tcoeQueue = Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\tallApproval = Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\tapproved = Sales_Plans[Status == &quot;Sales Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tshortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Sales Department Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Create sales plans, respond to returned rows and monitor approval progress.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;span&gt;My workqueue&lt;/span&gt;&lt;strong&gt;&lt;%=mySalesItems%&gt;&lt;/strong&gt;&lt;span&gt;Draft, returned or revision sales plans&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Sales_Management_Approval_Queue&apos;&gt;&lt;span&gt;Approval queue&lt;/span&gt;&lt;strong&gt;&lt;%=coeQueue%&gt;&lt;/strong&gt;&lt;span&gt;Plans submitted to Sales Management&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Sales_Management_Approval_Queue&apos;&gt;&lt;span&gt;Total approval queue&lt;/span&gt;&lt;strong&gt;&lt;%=allApproval%&gt;&lt;/strong&gt;&lt;span&gt;Open approval items&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Sales_Plans&apos;&gt;&lt;span&gt;Approved plans&lt;/span&gt;&lt;strong&gt;&lt;%=approved%&gt;&lt;/strong&gt;&lt;span&gt;Sales approved or locked records&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-2-time dl-icon&apos;&gt;&lt;/i&gt; Update my plans&lt;/span&gt;&lt;b&gt;&lt;%=mySalesItems%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Form:Sales_Plans?zc_LoadIn=dialog&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-chart-growth dl-icon&apos;&gt;&lt;/i&gt; Create sales plan&lt;/span&gt;&lt;b&gt;New&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Sales_Shortfall_Buckets&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline ui-3-alert dl-icon&apos;&gt;&lt;/i&gt; Review revision requests&lt;/span&gt;&lt;b&gt;&lt;%=shortfalls%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Approval movement&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=allApproval%&gt; sales rows are currently with approvers.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Revision exposure&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=shortfalls%&gt; SCM revision buckets may need sales response.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Management_Landing
		{
					displayname = "Sales Management Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Management_Landing_Snippet' elementName='Sales_Management_Landing_Snippet' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Management_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Sales Management&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmanagementQueue = Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\tapproved = Sales_Plans[Status == &quot;Sales Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\treturned = Sales_Plans[Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot;].count();\n\tallPlans = Sales_Plans[ID != 0].count();\n\tshortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\t%&gt;\n&lt;style&gt;.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;&lt;div class=&apos;dl-hero&apos;&gt;&lt;div&gt;&lt;h2&gt;Sales Management Landing&lt;/h2&gt;&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Approve sales plans and monitor commercial readiness.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;dl-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;dl-grid&apos;&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Sales_Management_Approval_Queue&apos;&gt;&lt;span&gt;Management approvals&lt;/span&gt;&lt;strong&gt;&lt;%=managementQueue%&gt;&lt;/strong&gt;&lt;span&gt;Sales Head or Global Sales Head queue&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Approved_Sales_Plans&apos;&gt;&lt;span&gt;Approved sales plans&lt;/span&gt;&lt;strong&gt;&lt;%=approved%&gt;&lt;/strong&gt;&lt;span&gt;Approved and locked plan records&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:All_Sales_Plans&apos;&gt;&lt;span&gt;Total plan rows&lt;/span&gt;&lt;strong&gt;&lt;%=allPlans%&gt;&lt;/strong&gt;&lt;span&gt;Sales plan records in the system&lt;/span&gt;&lt;/a&gt;&lt;a class=&apos;dl-card&apos; href=&apos;#Report:Sales_Shortfall_Buckets&apos;&gt;&lt;span&gt;Shortfall buckets&lt;/span&gt;&lt;strong&gt;&lt;%=shortfalls%&gt;&lt;/strong&gt;&lt;span&gt;Amber or red commercial shortfalls&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-layout&apos;&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Pending actions&lt;/h3&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:Sales_Management_Approval_Queue&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline business-signature dl-icon&apos;&gt;&lt;/i&gt; Approve or return sales plans&lt;/span&gt;&lt;b&gt;&lt;%=managementQueue%&gt;&lt;/b&gt;&lt;/a&gt;&lt;a class=&apos;dl-action&apos; href=&apos;#Report:All_Sales_Plans&apos;&gt;&lt;span&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 dl-icon&apos;&gt;&lt;/i&gt; Review returned rows&lt;/span&gt;&lt;b&gt;&lt;%=returned%&gt;&lt;/b&gt;&lt;/a&gt;&lt;/div&gt;&lt;div class=&apos;dl-panel&apos;&gt;&lt;h3&gt;Department insights&lt;/h3&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Approval ratio&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=approved%&gt; of &lt;%=allPlans%&gt; plan rows are approved and locked.&lt;/div&gt;&lt;/div&gt;&lt;div class=&apos;dl-insight&apos;&gt;&lt;strong&gt;Exception focus&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;&lt;%=shortfalls%&gt; shortfall buckets may require management attention.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Scenario_Comparison_Dashboard(int Budget_Cycle_ID)
		{
					displayname = "Scenario Comparison"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Header' elementName='Scenario_Header' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Header()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[ID != 0] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tcycleCode = &quot;No cycle selected&quot;;\n\tcycleName = &quot;Select a Budget Cycle to review.&quot;;\n\tcycleStatus = &quot;No Data&quot;;\n\tfyName = &quot;-&quot;;\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tcycleCode = ifNull(selectedCycle.Cycle_Code,&quot;-&quot;);\n\t\tcycleName = ifNull(selectedCycle.Cycle_Name,&quot;-&quot;);\n\t\tcycleStatus = ifNull(selectedCycle.Status,&quot;-&quot;);\n\t\tfyRecords = Financial_Years[ID == selectedCycle.Financial_Year];\n\t\tif(fyRecords.count() &gt; 0)\n\t\t{\n\t\t\tfyName = ifNull(fyRecords.Year_Name,&quot;-&quot;);\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n.scenario-page{font-family:var(--zc-page-font-family,Arial,sans-serif);background:#f3f3f4;padding:16px;box-sizing:border-box}.scenario-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);border-radius:16px;color:#fff;padding:24px}.scenario-hero h2{margin:0 0 6px;font-size:24px}.scenario-hero p{margin:0;font-size:14px;opacity:.9}.scenario-pill{display:inline-block;margin-top:14px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:6px 12px;font-size:13px}.scenario-section{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.scenario-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.scenario-card{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;padding:14px;background:#fff}.scenario-label{font-size:12px;color:var(--zcs_secondary_text_color)}.scenario-value{font-size:22px;font-weight:700;color:var(--zcs_primary_text_color);margin-top:4px}.scenario-table{width:100%;border-collapse:collapse}.scenario-table th,.scenario-table td{border-top:1px solid var(--zcs_tertiary_border_color);padding:10px;text-align:left}.scenario-table th{background:#f9fafe;color:var(--zcs_primary_text_color)}@media(max-width:900px){.scenario-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&quot;scenario-page&quot;&gt;\n\t&lt;div class=&quot;scenario-hero&quot;&gt;\n\t\t&lt;h2&gt;Scenario Comparison&lt;/h2&gt;\n\t\t&lt;p&gt;Financial year &lt;%=fyName%&gt; | Cycle &lt;%=cycleCode%&gt; | Status &lt;%=cycleStatus%&gt;&lt;/p&gt;\n\t\t&lt;span class=&quot;scenario-pill&quot;&gt;&lt;%=cycleName%&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Cards' elementName='Scenario_Cards' bgColor=''>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[ID != 0] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tscenarioSetCode = &quot;&quot;;\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvVolume = ifNull(volumeFinancial.Volume_MT,0);\n\tvRevenue = ifNull(volumeFinancial.Revenue,0);\n\tvRaw = ifNull(volumeFinancial.Raw_Material_Cost,0);\n\tvCons = ifNull(volumeFinancial.Consumables_Cost,0);\n\tvTotal = ifNull(volumeFinancial.Total_Cost,0);\n\tvEbitda = ifNull(volumeFinancial.EBITDA,0);\n\tvMargin = ifNull(volumeFinancial.EBITDA_Margin_Percent,0);\n\teVolume = ifNull(ebitdaFinancial.Volume_MT,0);\n\teRevenue = ifNull(ebitdaFinancial.Revenue,0);\n\teRaw = ifNull(ebitdaFinancial.Raw_Material_Cost,0);\n\teCons = ifNull(ebitdaFinancial.Consumables_Cost,0);\n\teTotal = ifNull(ebitdaFinancial.Total_Cost,0);\n\teEbitda = ifNull(ebitdaFinancial.EBITDA,0);\n\teMargin = ifNull(ebitdaFinancial.EBITDA_Margin_Percent,0);\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Scenario KPI Cards&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Side-by-side financial comparison for management review. Currency values are shown as entered in Financial Consolidations.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;scenario-grid-2&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-icon&quot; style=&quot;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h6 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Volume Maximising&lt;/h6&gt;&lt;span class=&quot;scenario-muted&quot;&gt;&lt;%=ifNull(volumeCycle.Cycle_Code,&quot;No cycle&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ifNull(volumeFinancial.Status,&quot;Not Created&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Volume MT&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=vVolume%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Revenue&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vRevenue%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Raw Material Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vRaw%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Consumables Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vCons%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Total Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vEbitda%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA Margin Percent&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=vMargin%&gt;%&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-icon&quot; style=&quot;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h6 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;EBITDA Maximising&lt;/h6&gt;&lt;span class=&quot;scenario-muted&quot;&gt;&lt;%=ifNull(ebitdaCycle.Cycle_Code,&quot;No cycle&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-alig