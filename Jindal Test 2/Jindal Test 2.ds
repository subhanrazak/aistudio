						(
							type = decimal
							displayname = "Cost Forecast"
							width = medium
						)
						SCM_Override
						(
		    				type = checkbox
							displayname = "SCM Override"
							initial value = false
							width = medium
						)
						Override_Comments
						(
		    				type = textarea
							displayname = "Override Comments"
							height = 80px
							width = medium
						)
			 			row = 2
			 			column = 1
						width = medium
					)
					Decision
					(
						type = section
						displayname = "Decision"
						visibility = true
			 			row = 3
			 			column = 0
						width = medium
					)
					SCM_Decision
					(
						type = picklist
						displayname = "SCM Decision"
						values = {"Approve","Request Sales Revision","Request Operations Revision","Request Sales and Operations Revision"}
			 			row = 3
			 			column = 1
						width = medium
					)
					SCM_Comments
					(
		    			type = textarea
						displayname = "SCM Comments"
						height = 80px
			 			row = 3
			 			column = 2
						width = medium
					)
					Latest_Revision_No
					(
						type = number
						displayname = "Latest Revision No"
						initial value = 0
			 			row = 3
			 			column = 1
						width = medium
					)
					Revision_History
					(
						type = section
						displayname = "Revision History"
						visibility = true
			 			row = 4
			 			column = 0
						width = medium
					)
					Revision_History_Lines
					(
						type = grid
						displayname = "Revision History Lines"
						defaultrow = 0
						Revision_No
						(
							type = number
							displayname = "Revision No"
							width = medium
						)
						Requested_To
						(
							type = picklist
							displayname = "Requested To"
							values = {"Sales","Operations","Both"}
							width = medium
						)
						Source_Record
						(
							type = text
							displayname = "Source Record"
							width = medium
						)
						New_Revision_Record_ID
						(
							type = number
							displayname = "New Revision Record ID"
							width = medium
						)
						Comments
						(
		    				type = textarea
							height = 80px
							width = medium
						)
						Requested_By
						(
		    				type = email
							displayname = "Requested By"
							width = medium
						)
						Requested_On
						(
							type = datetime
							displayname = "Requested On"
							width = medium
						)
						Revision_Status
						(
							type = picklist
							displayname = "Revision Status"
							values = {"Requested","In Progress","Resubmitted","Closed"}
							width = medium
						)
			 			row = 4
			 			column = 1
						width = medium
					)
					Workflow_Status
					(
						type = section
						displayname = "Workflow Status"
						visibility = true
			 			row = 5
			 			column = 0
						width = medium
					)
					must have Status
					(
						type = picklist
						values = {"Waiting for Sales and Operations Approval","Under SCM Review","Revision Requested","Sales Revision Pending","Operations Revision Pending","Both Revisions Pending","SCM Approved","Submitted to Finance","Locked","Reopened"}
						initial value = "Waiting for Sales and Operations Approval"
			 			row = 5
			 			column = 1
						width = medium
					)
					Approver_Action
					(
						type = picklist
						displayname = "Approver Action"
						values = {"Start Review","Approve","Request Revision","Submit to Finance","Lock"}
			 			row = 5
			 			column = 2
						width = medium
					)
					Approval_Remarks
					(
		    			type = textarea
