<%
total_deliveries = Outbound_Deliveries_Form[ID != 0].count();
today_deliveries = Outbound_Deliveries_Form[Planned_Delivery_Date == zoho.currentdate].count();
pending_deliveries = Outbound_Deliveries_Form[Delivery_Status == "Pending"].count();
assigned_deliveries = Outbound_Deliveries_Form[Delivery_Status == "Assigned"].count();
in_transit_deliveries = Outbound_Deliveries_Form[Delivery_Status == "In Transit" || Delivery_Status == "In-Transit"].count();
arrived_deliveries = Outbound_Deliveries_Form[Delivery_Status == "Arrived"].count();
pod_submitted = Outbound_Deliveries_Form[Delivery_Status == "POD Submitted"].count();
overdue_count = Outbound_Deliveries_Form[Is_Overdue == true].count();
open_exception_count = New_Exception[Status == "Open"].count();
submitted_pods = POD_Form[Status == "Submitted"].count();
approved_pods = POD_Form[Status == "Approved"].count();
rejected_pods = POD_Form[Status == "Rejected"].count();
active_drivers = Driver[ID != 0].count();
delivered_count = Outbound_Deliveries_Form[Delivery_Outcome == "Delivered" || Delivery_Status == "POD Approved"].count();
completion_pct = 0;
if(total_deliveries > 0)
{
	completion_pct = ((delivered_count * 100) / total_deliveries).round(0);
}
%>
<style>
.zcdash{font-family:Inter,Arial,sans-serif;background:#f7f9fc;padding:24px;color:#111827;box-sizing:border-box}.zcdash *{box-sizing:border-box}.hero{border-radius:28px;padding:28px;background:linear-gradient(135deg,#172554,#2563eb 52%,#38bdf8);color:#fff;box-shadow:0 18px 44px rgba(37,99,235,.22);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;right:-60px;bottom:-90px;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.12)}.hero-row{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.16em;opacity:.8;margin-bottom:10px}.title{font-size:29px;font-weight:850;line-height:1.08;margin:0}.subtitle{max-width:720px;color:#dbeafe;margin:10px 0 0;font-size:14px;line-height:1.6}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:8px;text-decoration:none;border-radius:999px;padding:11px 16px;font-size:13px;font-weight:800}.btn-primary{background:#fff;color:#1d4ed8}.btn-ghost{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:#fff}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.kpi{background:#fff;border:1px solid #e5e7eb;border-radius:22px;padding:18px;box-shadow:0 10px 28px rgba(15,23,42,.06);position:relative;overflow:hidden}.kpi:before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--accent)}.kpi-head{display:flex;justify-content:space-between;gap:10px}.ico{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:var(--soft);color:var(--accent);font-size:20px}.label{font-size:13px;color:#64748b;font-weight:750}.value{font-size:31px;font-weight:900;margin-top:12px;letter-spacing:-.04em}.note{font-size:12px;color:#94a3b8;margin-top:4px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.card{background:#fff;border:1px solid #e5e7eb;border-radius:24px;padding:20px;box-shadow:0 10px 28px rgba(15,23,42,.06)}.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:10px}.card-head h3{font-size:17px;margin:0}.pill{display:inline-flex;align-items:center;gap:7px;border-radius:999px;background:#eff6ff;color:#1d4ed8;padding:7px 10px;font-size:12px;font-weight:850}.status-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.status{padding:15px;border-radius:18px;background:#f8fafc;border:1px solid #edf2f7}.status b{display:block;font-size:25px;margin-bottom:3px}.status span{font-size:12px;color:#64748b;font-weight:750}.progress-shell{height:12px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin:16px 0 10px}.progress-bar{height:100%;width:<%=completion_pct%>%;background:linear-gradient(90deg,#16a34a,#38bdf8)}.quick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}.quick a{display:flex;align-items:center;gap:10px;text-decoration:none;color:#0f172a;background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:14px;font-size:13px;font-weight:850;box-shadow:0 8px 20px rgba(15,23,42,.05)}.quick i{color:#2563eb}.reports{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.reportbox{background:#fff;border:1px solid #e5e7eb;border-radius:24px;overflow:hidden;box-shadow:0 10px 28px rgba(15,23,42,.06)}.reporthead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #eef2f7}.reporthead h3{margin:0;font-size:15px}.reportbody{height:430px;overflow:auto}.zc-embed{height:100%}@media(max-width:900px){.kpis,.quick,.reports{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}}@media(max-width:560px){.zcdash{padding:14px}.kpis,.quick,.reports,.status-grid{grid-template-columns:1fr}.hero{padding:22px}.title{font-size:24px}}
</style>
<div class="zcdash">
  <section class="hero">
    <div class="hero-row">
      <div><div class="eyebrow">Supervisor Workspace</div><h1 class="title">Supervisor Dashboard</h1><p class="subtitle">Coordinate field execution, assign pending deliveries, monitor driver locations, and resolve exceptions before they impact service levels.</p></div>
      <div class="hero-actions"><a class="btn btn-primary" href="#Form:Assign_Driver?zc_LoadIn=dialog"><i class="zc-li-outline users-single-05"></i> Assign Driver</a><a class="btn btn-ghost" href="#Report:Unassigned_Deliveries"><i class="zc-li-outline ui-1-zoom"></i> Unassigned</a></div>
    </div>
  </section>
  <section class="kpis">
    <div class="kpi" style="--accent:#2563eb;--soft:#dbeafe"><div class="kpi-head"><div><div class="label">Today</div><div class="value"><%=today_deliveries%></div></div><div class="ico"><i class="zc-li-outline ui-2-calendar-date"></i></div></div><div class="note">Planned for today</div></div>
    <div class="kpi" style="--accent:#f59e0b;--soft:#fef3c7"><div class="kpi-head"><div><div class="label">Unassigned</div><div class="value"><%=pending_deliveries%></div></div><div class="ico"><i class="zc-li-outline ui-2-time"></i></div></div><div class="note">Requires allocation</div></div>
    <div class="kpi" style="--accent:#ef4444;--soft:#fee2e2"><div class="kpi-head"><div><div class="label">Overdue</div><div class="value"><%=overdue_count%></div></div><div class="ico"><i class="zc-li-outline ui-1-notification-69"></i></div></div><div class="note">Escalation queue</div></div>
    <div class="kpi" style="--accent:#7c3aed;--soft:#ede9fe"><div class="kpi-head"><div><div class="label">Open Exceptions</div><div class="value"><%=open_exception_count%></div></div><div class="ico"><i class="zc-li-outline ui-1-alert-circle-i"></i></div></div><div class="note">Needs resolution</div></div>
  </section>
  <section class="grid">
    <div class="card"><div class="card-head"><h3>Dispatch Flow</h3><span class="pill"><i class="zc-li-outline arrows-4-restore"></i> <%=completion_pct%>% closed</span></div><div class="status-grid"><div class="status"><b><%=assigned_deliveries%></b><span>Assigned</span></div><div class="status"><b><%=in_transit_deliveries%></b><span>In Transit</span></div><div class="status"><b><%=arrived_deliveries%></b><span>Arrived</span></div><div class="status"><b><%=pod_submitted%></b><span>POD Submitted</span></div></div><div class="progress-shell"><div class="progress-bar"></div></div><div class="note">Track active movement from assignment through POD submission.</div></div>
    <div class="card"><div class="card-head"><h3>POD Review Queue</h3><span class="pill"><i class="zc-li-outline ui-1-check-square-09"></i> Review</span></div><div class="status-grid"><div class="status"><b><%=submitted_pods%></b><span>Submitted</span></div><div class="status"><b><%=approved_pods%></b><span>Approved</span></div><div class="status"><b><%=rejected_pods%></b><span>Rejected</span></div><div class="status"><b><%=active_drivers%></b><span>Drivers</span></div></div><div class="note">Use POD details to approve or reject submitted proof records.</div></div>
  </section>
  <section class="quick"><a href="#Report:All_Drivers_Location"><i class="zc-li-outline location_pin"></i> Driver Map</a><a href="#Report:All_Exceptions"><i class="zc-li-outline ui-1-alert-circle-i"></i> Exceptions</a><a href="#Report:POD_Report"><i class="zc-li-outline files-single-copy-04"></i> POD Queue</a><a href="#Report:Customer_Feedback_Report"><i class="zc-li-outline ui-2-chat-round-content"></i> Feedback</a></section>
  <section class="reports">
    <div class="reportbox"><div class="reporthead"><h3>Live Driver Locations</h3><span class="pill">Map</span></div><div class="reportbody"><div class="zc-embed" zc-component="report" zc-linkname="All_Drivers_Location" zc-params="zc_Header=false&zc_Footer=false"></div></div></div>
    <div class="reportbox"><div class="reporthead"><h3>Unassigned Deliveries</h3><span class="pill"><%=pending_deliveries%></span></div><div class="reportbody"><div class="zc-embed" zc-component="report" zc-linkname="Unassigned_Deliveries" zc-params="zc_Header=false&zc_Footer=false"></div></div></div>
    <div class="reportbox"><div class="reporthead"><h3>Open Exceptions</h3><span class="pill"><%=open_exception_count%></span></div><div class="reportbody"><div class="zc-embed" zc-component="report" zc-linkname="All_Exceptions" zc-params="zc_Header=false&zc_Footer=false"></div></div></div>
    <div class="reportbox"><div class="reporthead"><h3>Customer Feedback</h3><span class="pill">Review</span></div><div class="reportbody"><div class="zc-embed" zc-component="report" zc-linkname="Customer_Feedback_Report" zc-params="zc_Header=false&zc_Footer=false"></div></div></div>
  </section>
</div>