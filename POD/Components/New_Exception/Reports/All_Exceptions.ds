default list All_Exceptions
{

			displayName = "All Exceptions"
			show all rows from New_Exception    
			(
				Delivery_Number as "Delivery Number"
				Exception_ID as "Exception ID"
				S_No as "S No"
				POD_ID as "POD ID"
				Status
				Reported_Date as "Reported Date"
				Exception_SLA_Due_On as "SLA Due On"
				Resolve_Description as "Resolve Description"
				custom action "Resolve"
				(
	  			workflow = Resolve
				show action in edit record menu = true
				column header = "Resolve"
				condition = (Status == "Open")
				)
			)
		
}