form New_Exception
{

			displayname = "New Exception"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			POD_ID
			(
				type = picklist	
				displayname = "POD ID"
				values  = POD_Form.ID
    			displayformat = [POD_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Exception_Items
			(
				type = grid
				displayname = "Exception Items"
				values  = Exception_Line_Items.ID
    			bidirectional = Exception_ID
	 			row = 2
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			unique Exception_ID
			(
    			type = text
				displayname = "Exception ID"
	 			row = 3
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S No"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","Approved","Rejected","Resolved","Closed"}
				initial value = "Open"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Reported_Date
			(
    			type = datetime
				displayname = "Reported Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Exception_SLA_Due_On
			(
    			type = datetime
				displayname = "SLA Due On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Is_Overdue
			(
    			type = checkbox
				displayname = "Is Overdue"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Resolve_Description
			(
    			type = textarea
				displayname = "Resolve Description"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}