Submit_action_on_add11 as "Submit action on add"
{

				type =  form
				form = Resolve_Exception
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						excep = New_Exception[ID == input.Exception_ID];
										excep.Resolve_Description=input.Description;
										excep.Status="Closed";
										openUrl("#Script:page.parent.refresh ","parent window");
					)
					}
				}
			
}