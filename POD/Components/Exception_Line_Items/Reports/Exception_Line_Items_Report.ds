default list Exception_Line_Items_Report
{

			displayName = "Exception Line Items Report"
			show all rows from Exception_Line_Items    
			(
				Ordered_Qty as "Ordered Qty"
				Delivered_Qty as "Delivered Qty"
				Pending_Qty as "Pending Qty"
				Reject_Reason as "Reason"
				Exception_ID as "Exception ID"
				Product
				Image
				Notes
				Status
			)
		
}