form Customer_Feedback
{

			displayname = "Customer Feedback"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer
			(
				type = picklist	
				displayname = "Customer ID"
				values  = New_Customer.ID
    			displayformat = [Customer_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rating
			(
				type = picklist
				maxchar = 100
				values = {"1","2","3","4","5"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rating_Display
			(
    			type = richtext
				displayname = "Rating"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}