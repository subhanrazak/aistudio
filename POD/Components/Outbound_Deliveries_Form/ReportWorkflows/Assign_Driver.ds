Assign_Driver as "Assign Driver"
{

				type =  functions
				form = Outbound_Deliveries_Form
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Assign_Driver?Delivery_Number=" + input.ID,"popup window","width=600px");
					)
					}
				}
			
}