Field_action_on_always2 as "Field action on always"
{

				type =  form
				form = Outbound_Deliveries_Form

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden_Section;
					}
					actions  (Customer is not null)
					{
						show Customer_Address;
					}
				}

			
}