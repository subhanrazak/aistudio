Validation_on_always as "Validation on always"
{

				type =  form
				form = Outbound_Deliveries_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Driver.isEmpty() == false && input.Vehicle.isEmpty() == true)
										{
											alert "Please select a vehicle";
											cancel submit;
										}
						)
					}
				}

			
}