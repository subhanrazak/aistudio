report Overdue_Admin
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Delivery_Number as "Delivery Number"
								Products.Product as "Products"
								Customer
								Delivery_Address as "Delivery Address"
								Driver
								Planned_Delivery_Date as "Planned Delivery Date"
								Delivery_Status as "Delivery Status"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							"Assign Driver"
    					)
						)
    				action
    				(
						on click
						(
							"View"
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
							layout type = -6
		     				title = "Overview"
							fields
							(
								Stop_Sequence as "Stop Sequence"
								Delivery_Number as "Delivery Number"
								Route_Number as "Route Number"
								Delivery_Status as "Delivery Status"
								Added_User as "Added User"
								Added_Time as "Added Time"
							)
						)
						datablock2
						(
							layout type = -1
		     				related field = Products
							fields
							(
								Outbound_Deliveries_SAP as "Delivery Number"
								Ordered_Qty as "Ordered Qty"
								Delivered_Qty as "Delivered Qty"
								Pending_Qty as "Pending Qty"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}