map Drivers_Location
{

			displayName = "Drivers Location"
			show all rows from Outbound_Deliveries_Form    
			(
				Customer
				Customer_Address as "Customer Address"
				Driver
				Route_Number as "Route Number"
				Planned_Delivery_Date as "Planned Delivery Date"
				Vehicle
				Stop_Sequence as "Stop Sequence"
				Delivery_Window_Start as "Delivery Window Start"
				Delivery_Window_End as "Delivery Window End"
				Special_Instructions as "Special Instructions"
				Delivery_Number as "Delivery Number"
				Delivery_Address as "Delivery Address"
				Driver_Start_Time as "Driver Start Time"
				Driver_Arrived_Time as "Driver Arrived Time"
				Total_Weight_kg as "Total Weight kg"
				Total_Items as "Total Items"
				Delivery_Status as "Delivery Status"
				Delivery_Outcome as "Delivery Outcome"
				Distance_km
				Duration_min
				SAP_ID as "SAP ID"
				Order_Date as "Order Date"
				Delivered_Date as "Delivered Date"
				S_No as "S No"
			)
			options
			(
	 			display field = Modified_Location
	 		)
		
}