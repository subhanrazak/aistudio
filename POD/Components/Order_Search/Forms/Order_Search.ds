form Order_Search
{

			displayname = "Order Search"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
    			type = text
				displayname = "Delivery Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Search_Button
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
		
}