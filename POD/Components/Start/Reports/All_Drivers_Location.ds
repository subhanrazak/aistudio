map All_Drivers_Location
{

			displayName = "All Drivers Location"
			show all rows from Start    
			(
				Delivery_Number as "Delivery Number"
				Delivery_Number.Delivery_Address as "Delivery Address"
				Driver.Image
			)
			options
			(
	 			display field = Added_Location
	 	 		radius = 30 Miles 
	 		)
			conditional formatting
			(
				"Style 1"
				{
				format = "color:#00b0ff;map-icon:envir-car;map-icon-color:#ffffff;"
				}
			)
		
}