default list Customer_Address_Report
{

			displayName = "Customer Address Report"
			show all rows from Customer_Address    
			(
				Address_Name as "Address Name"
				Address_Type as "Address Type"
				Is_Default_Address as "Is Default Address"
				Customer_Address  as "Customer Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Status
				Customer
			)
		
}