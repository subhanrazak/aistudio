Submit_action_on_always2 as "Submit action on always"
{

				type =  form
				form = New_Customer

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Customer = thisapp.Util.DisplayFormat({"img_field_value":input.Customer_Logo,"report_name":"All_Customers","field_name":"Customer_Logo","name":input.Customer_Name,"secondary_text":input.Customer_Email,"recID":input.ID});
						)
					}
				}

			
}