report All_Customers
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Customer
								Customer_ID as "Customer ID"
								Customer_Phone as "Customer Phone"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Customer_Name as "Customer Name"
								Customer_Email as "Customer Email"
								Customer_Phone as "Customer Phone"
								Customer_ID as "Customer ID"
								S_No as "S No"
							)
						)
						datablock2
						(
							layout type = -1
		     				title = "Address"
		     				related field = Address
							fields
							(
								Customer
								Address_Type as "Address Type"
								Address_Name as "Address Name"
								Customer_Address as "Customer Address"
								Is_Default_Address as "Is Default Address"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}