form Organization
{

			success message = "Organization details have been saved successfully."
			feature property = 320
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Organization_Name
			(
    			type = text
				displayname = "Organization Name"
    			description
    			[
    				type = none
    			 	message = "Enter the official name of the organization."
    			]
	 			row = 1
	 			column = 1   
				width = large
			)
			must have Organization_Email
			(
    			type = email
				displayname = "Organization Email"
				maxchar = 80
    			description
    			[
    				type = none
    			 	message = "Add the main email address for this organization."
    			]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Organization_Phone
			(
    			type = phonenumber
				displayname = "Organization Phone"
    			allowedcountries={us}
    			defaultcountry="us"
    			description
    			[
    				type = none
    			 	message = "Add the primary contact number, including country code if needed."
    			]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Organization_Address1
			(
    			type = textarea
				displayname = "Organization Address"
				height = 120px
    			description
    			[
    				type = none
    			 	message = "Enter the full mailing or business address."
    			]
	 			row = 1
	 			column = 1   
				width = large
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}