form Submit_POD
{

			displayname = "Submit POD"
			store data in zc = false
			Submit_POD
			(
				type = section
				displayname = "Submit POD"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Delivery_Notes
			(
    			type = textarea
				displayname = "Delivery Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit_POD_for_Approval
				(
   					type = submit
   					displayname = "Submit POD for Approval"
				)
			}
		
}