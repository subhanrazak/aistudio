Submit_action_on_add1 as "Submit action on add"
{

				type =  form
				form = POD_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.POD_ID = thisapp.Util.getID("POD",input.S_No);
										input.Customer = input.Delivery_Number.Customer;
						)
					}
				}

			
}