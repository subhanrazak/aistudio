default list POD_Report
{

			displayName = "POD"
			show all rows from POD_Form    
			(
				Delivery_Number as "Delivery Number"
				Delivery_Notes as "Delivery Notes"
				POD_ID as "POD ID"
				S_No
				Status
				Delivery_Number.Driver
				Delivery_Number.Customer
				Receipient_Details.Receipient_Printed_Name as "Receipient Name"
				Receipient_Details.Receipient_Signature as "Receipient Signature"
				Delivery_Number.Delivery_Address as "Delivery Address"
				Delivery_Number.Delivery_Outcome as "Delivery Outcome"
				Delivery_Number.Delivered_Date as "Delivered Date"
				(
					displayformat = dateonly
				)
				Customer.Customer_Logo as "Customer Logo"
				Customer.Customer_Name as "Customer Name"
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '17px'\n	paddingLeft = '17px'\n	paddingRight = '0px'\n	paddingBottom = '17px'\n\n		width = '100%'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '16px'\n	type = 'Text'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = '#'\n>\n</text>\n\n</pc><pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '13px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '18'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'POD_ID'\n>\n</text>\n\n</pc><pc \n	\n>\n	<text \n\n	marginLeft = '10px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '12px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '17'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Status'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '17px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n		marginLeft = '0px'\n	marginRight = '12px' \n	marginBottom = '0px'\n	marginTop = '0px'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n	color = '#FFFFFF'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	width = '52px'\n	height = '52px'\n	type = 'field'\n	value = 'Customer.Customer_Logo'\n	cornerRadius = '10px'\n/>\n</pc><pc \n	\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '16px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Customer.Customer_Name'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '14px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '3'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Delivery_Number.Delivery_Address'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '17px'\n	paddingLeft = '0px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '50%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n		marginLeft = '0px'\n	marginRight = '3px' \n	marginBottom = '0px'\n	marginTop = '0px'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n	color = '#000000'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	width = '23.9062px'\n	height = '24px'\n	type = 'icon'\n	value = 'ui-1-calendar-57'\n	size = '14px'\n	cornerRadius = '0px'\n	iconType = 'outline'\n/>\n</pc><pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '14px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Delivery_Number.Delivered_Date'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '17px'\n	paddingRight = '17px'\n	paddingBottom = '17px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '50%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<image  \n		marginLeft = '0px'\n	marginRight = '10px' \n	marginBottom = '0px'\n	marginTop = '0px'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n	color = '#000000'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	width = '23.9062px'\n	height = '24px'\n	type = 'icon'\n	value = 'shopping-delivery'\n	size = '14px'\n	cornerRadius = '0px'\n	iconType = 'outline'\n/>\n</pc><pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#000000'\n	size = '14px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Delivery_Number.Delivery_Outcome'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		
}