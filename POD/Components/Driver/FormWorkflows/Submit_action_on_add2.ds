Submit_action_on_add2 as "Submit action on add"
{

				type =  form
				form = Driver

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Driver_ID = thisapp.Util.getID("Driver",input.S_No);
										if(input.Share_App)
										{
											try 
											{
												thisapp.permissions.assignUserInProfile(input.Email,"Driver",true);
											}	catch (e)
											{
												info e;
											}
										}
						)
					}
				}

			
}