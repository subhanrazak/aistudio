Submit_action_on_add3 as "Submit action on add"
{

				type =  form
				form = Employee

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Employee_ID = thisapp.Util.getID("Employee",input.S_No);
										if(input.Share_App)
										{
											try 
											{
												thisapp.permissions.assignUserInProfile(input.Email,input.Role,true);
											}	catch (e)
											{
												info e;
											}
										}
						)
					}
				}

			
}