form Employee
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee_Name
			(
    			type = text
				displayname = "Employee Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have unique Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Gender
			(
				type = picklist
				maxchar = 100
				values = {"Male","Female","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Of_Birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Role
			(
				type = picklist
				maxchar = 100
				values = {"Supervisor","Logistics Manager","Admin"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Share_App
			(
    			type = checkbox
				displayname = "Share App?"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","In active"}
				initial value = "Active"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Employee_ID
			(
    			type = text
				displayname = "Employee ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Employee_Display
			(
    			type = richtext
				displayname = "Employee"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}