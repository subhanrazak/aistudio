Load_action_on_always2 as "Load action on always"
{

				type =  form
				form = Arrived

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(zoho.device.type == "web")
										{
											input.Notes = "<style>" + thisapp.Styles_Popup.Active() + "</style><div class='zcs-active-popup zcs-popup-content zcs-flex zcs-direction-column zcs-align-items-center zcs-p-20 zcs-box-border zcs-text-center'> <div class='zcs-popup-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-full zcs-text-center'> <i class='zcs-font-24 zc-li-outline ui-1-check-circle-08'></i> </div> <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-16 zcs-mx-0 zcs-mb-12'> Arrived </h5> <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'> Have you arrived at the delivery location? </p> </div>";
										}
										else
										{
											input.Notes = "Have you arrived at the delivery location?";
										}
						)
					}
				}

			
}