report Products_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Image
								Product_Name as "Product Name"
								Category
								Weight
								Status
								S_No as "S No"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Product_Name as "Product Name"
								Weight
								Description
								Image
								Category
								Status
								Product_ID as "Product ID"
								S_No as "S No"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}