string Util.processImageUrl(string image_tag, int rec_ID, string report_name, string field_name)
{

                 	actual_image_url = "";
                 	image_url = image_tag.getSuffix("src = \"").getPrefix("\" lowqual");
                 	image_name = image_url.getSuffix("/image/");
                 	if(thisapp.portal.isUserInProfile("Customer"))
                 	{
                 		actual_image_url = zoho.appuri + "report/" + report_name + "/" + rec_ID + "/" + field_name + "/download-file?filepath=/" + image_name + "&mediaType=1";
                 	}
                 	else
                 	{
                 		actual_image_url = zoho.appuri + "report/" + report_name + "/" + rec_ID + "/" + field_name + "/download-file?filepath=/" + image_name + "&mediaType=1";
                 		// 		actual_image_url = image_url.replaceAll("/sharedBy/appLinkName/viewLinkName/fieldName/image/",zoho.appuri + report_name + "/" + field_name + "/image/");
                 	}
                 	return actual_image_url;
                 
}