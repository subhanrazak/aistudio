string Styles.App_CSS()
{

                 	to_be_removed = "a { text-decoration: none; }";
                 	style_text = thisapp.Styles.Color_Codes() + thisapp.Styles.Grid() + thisapp.Styles_Creator.Element_Styles() + thisapp.Styles.To_Be_Removed() + to_be_removed;
                 	return style_text;
                 
}