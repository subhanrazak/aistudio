string Styles.Timeline()
{

                 	style_text = ".zcs-tl-indicator { width: 60px; left: 16.6666666667%; } .zcs-without-time .zcs-tl-indicator { left: 0px; } .zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0px 2px 6px 0px #C4DEE4; } .zcs-tl-icon { width: 35px; height: 35px; } .zcs-tl-icon.zcs-tl-icon-yellow { background-color: #FCF4E6; color: #B8770D; } .zcs-tl-icon.zcs-tl-icon-orange { background-color: #F8F0EB; color: #F4660C; } .zcs-tl-icon.zcs-tl-icon-blue { background-color: #E8EFFF; color: #2A6FFC; } .zcs-tl-icon.zcs-tl-icon-green { background-color: #E4FCF3; color: #179E6C; } .zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; } .zcs-tl-li .zcs-tl-animation { animation: pulse-dot 1.25s cubic-bezier(0.455, 0.03, 0.515, 0.955) -.4s infinite; } @media (max-width: 768px) { .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0px 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-px-60 { padding-left: 60px; padding-right: 24px; } } @keyframes pulse-dot { 0% { transform: scale(.8); } 50% { transform: scale(1); } 100% { transform: scale(.8); } } /* RTL styles start here */ .zc-rtl-wrapper .zcs-tl-indicator { left: auto; right: 16.6666666667%; } .zc-rtl-wrapper .zcs-without-time .zcs-tl-indicator { left: auto; right: 0px; } @media (max-width: 768px) { .zc-rtl-wrapper .zcs-tl-indicator { left: auto; right: 0px; } .zc-rtl-wrapper .zcs-tl-time { text-align: right; } .zc-rtl-wrapper .zcs-tl-li .zcs-px-60 { padding-left: 24px; padding-right: 60px; } }";
                 	return style_text;
                 
}