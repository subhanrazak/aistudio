string Styles_Popup.Active()
{

                 	style_text = thisapp.Styles_Popup.Popup() + ".zcs-popup-content.zcs-active-popup .zcs-popup-icon-wrapper { background-color: #e4fcf3; color: #179e6c; } .zcpopup.compact .popupbox-wrapper .statelessFormWidth .formbutton .zcs-live-primary-btn { background-color: #179e6c; border: 1px solid #179e6c; color: #FFF; } .zcpopup.compact .popupbox-wrapper .statelessFormWidth .formbutton .zcs-live-primary-btn:hover { background-color: #1EA13C; border: 1px solid #1EA13C; color: #FFF; }";
                 	return style_text;
                 
}