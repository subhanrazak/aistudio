string Styles.Avatar()
{

                 	style_text = ".zcs-avatar { width: var(--zcs-avatar-size); height: var(--zcs-avatar-size); background-color: var(--zcs_brand_color); border-radius: var(--zcs-avatar-radius); } .zcs-avatar .zcs-avatar-img { border-radius: inherit; object-fit: cover; } .zcs-avatar-badge { width: 8px; height: 8px; top: -1px; right: -1px; border: 1px solid var(--zcs-white-color); background-color: var(--zcs_brand_color); } .zcs-avatar-grp .zcs-avatar { border: 1px solid var(--zcs-white-color); margin-left: -8px; }";
                 	return style_text;
                 
}