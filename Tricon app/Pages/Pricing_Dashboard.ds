<page linkname = "Pricing_Dashboard" displayname = "Pricing Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='KPI_Cards' elementName='KPI_Cards' bgColor=\"\">
          <![CDATA[htmlpage KPI_Cards()
content
			<%{%>
            <file name:KPI_Cards.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Pipeline_Summary' elementName='Pipeline_Summary' bgColor=\"\">
          <![CDATA[htmlpage Pipeline_Summary()
content
			<%{%>
            <file name:Pipeline_Summary.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='62%'>
				<dsp id='Missing_Inputs_Table' elementName='Missing_Inputs_Table' bgColor=\"\">
          <![CDATA[htmlpage Missing_Inputs_Table()
content
			<%{%>
            <file name:Missing_Inputs_Table.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
			<column width='38%'>
				<dsp id='Approval_Queue' elementName='Approval_Queue' bgColor=\"\">
          <![CDATA[htmlpage Approval_Queue()
content
			<%{%>
            <file name:Approval_Queue.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Recent_Audit_Feed' elementName='Recent_Audit_Feed' bgColor=\"\">
          <![CDATA[htmlpage Recent_Audit_Feed()
content
			<%{%>
            <file name:Recent_Audit_Feed.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
	</layout>
</zml>
</content>