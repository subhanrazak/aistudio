			Pricing_Options_On_Load as "Pricing Options On Load"
			{
			
							type =  form
							form = Pricing_Options
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Calculated_On;
													if(input.Pricing_Request != null)
													{
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
														if(reqRec.count() > 0)
														{
															if(input.Customer == null)
															{
																input.Customer = reqRec.Customer;
															}
															if(input.Customer_Branch == null && reqRec.Primary_Branch != null)
															{
																input.Customer_Branch = reqRec.Primary_Branch;
															}
															if(input.Quote_Currency == null || input.Quote_Currency == "")
															{
																input.Quote_Currency = reqRec.Quote_Currency;
															}
														}
													}
													if(input.Customer != null && input.Margin_Percent == null || input.Margin_Percent == 0)
													{
														agr = Customer_Commercial_Agreements[Customer == input.Customer && Agreement_Status == "Active" && Effective_From <= zoho.currentdate && Effective_To == null || Effective_To >= zoho.currentdate] sort by Effective_From desc range from 0 to 1;
														if(agr.count() > 0 && agr.Default_Margin_Percent != null)
														{
															input.Margin_Percent = agr.Default_Margin_Percent;
														}
													}
													if(input.Calculation_Status == null || input.Calculation_Status == "")
													{
														input.Calculation_Status = "Draft";
													}
									)
								}
							}
			
						
			}

			Pricing_Options_On_Success as "Pricing Options On Success"
			{
			
							type =  form
							form = Pricing_Options
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														statusText = "Calculated";
													messageText = "Calculation completed.";
													reqDate = zoho.currentdate;
													reqOfferDate = zoho.currentdate;
													reqRec = Pricing_Requests[ID == input.Pricing_Request];
													if(reqRec.count() > 0)
													{
														reqDate = reqRec.Request_Date;
														reqOfferDate = reqRec.Offer_Month;
													}
													supplierRec = Supplier_Price_Books[Product == input.Product && Vendor == input.Vendor && Price_Status == "Active" && Effective_From <= reqOfferDate && Effective_To == null || Effective_To >= reqOfferDate] sort by Effective_From desc range from 0 to 1;
													if(supplierRec.count() == 0 && input.Arrival_Port != null)
													{
														supplierRec = Supplier_Price_Books[Product == input.Product && Vendor == input.Vendor && Arrival_Port == input.Arrival_Port && Price_Status == "Active" && Effective_From <= reqOfferDate && Effective_To == null || Effective_To >= reqOfferDate] sort by Effective_From desc range from 0 to 1;
													}
													matrixRec = Logistics_Cost_Matrix[Arrival_Port == input.Arrival_Port && Delivery_Region == input.Delivery_Region && Packaging == input.Packaging && Delivery_Model == input.Delivery_Model && Container_Size == input.Container_Size && Matrix_Status == "Active" && Effective_From <= reqOfferDate && Effective_To == null || Effective_To >= reqOfferDate] sort by Effective_From desc range from 0 to 1;
													if(matrixRec.count() == 0)
													{
														statusText = "Missing Inputs";
														messageText = "No active logistics cost matrix matches this arrival port, delivery region, packaging, delivery model, and container size.";
													}
													if(supplierRec.count() == 0)
													{
														statusText = "Missing Inputs";
														messageText = "No active supplier price book matches this product and vendor for the request offer month.";
													}
													sourceCurrency = input.Buy_Currency;
													buyPrice = input.Buy_Price_CIF_Curr_MT;
													if(supplierRec.count() > 0)
													{
														sourceCurrency = supplierRec.Currency;
														buyPrice = supplierRec.Buy_Price_CIF_Curr_MT;
													}
													fxRate = 1.0;
													fxDescription = "AUD base currency";
													fxRec = FX_Rates[From_Currency == sourceCurrency && To_Currency == "AUD" && Is_Approved == true && Rate_Date <= reqDate] sort by Rate_Date desc range from 0 to 1;
													if(sourceCurrency != "AUD")
													{
														if(fxRec.count() == 0)
														{
															statusText = "Missing Inputs";
															messageText = "No approved FX rate is available from " + sourceCurrency + " to AUD on or before the request date.";
														}
														else
														{
															fxRate = fxRec.Exchange_Rate;
															fxDescription = fxRec.Rate_Description;
														}
													}
													quoteFxRate = 1.0;
													quoteFxRec = FX_Rates[From_Currency == "AUD" && To_Currency == input.Quote_Currency && Is_Approved == true && Rate_Date <= reqDate] sort by Rate_Date desc range from 0 to 1;
													if(input.Quote_Currency != "AUD")
													{
														if(quoteFxRec.count() == 0)
														{
															statusText = "Missing Inputs";
															messageText = "No approved FX rate is available from AUD to " + input.Quote_Currency + " on or before the request date.";
														}
														else
														{
															quoteFxRate = quoteFxRec.Exchange_Rate;
														}
													}
													supplierAud = 0.0;
													costAdders = 0.0;
													overallCost = 0.0;
													marginAud = 0.0;
													quotedPrice = 0.0;
													dutyAmt = ifnull(input.Duty_AUD_MT,0).toDecimal();
													wharfAmt = 0.0;
													portTransportAmt = 0.0;
													repackAmt = 0.0;
													storageAmt = 0.0;
													additionalAmt = 0.0;
													fuelPct = 0.0;
													deliveryAmt = 0.0;
													financePct = 0.0;
													if(matrixRec.count() > 0)
													{
														wharfAmt = ifnull(matrixRec.Wharf_Clearance_AUD_MT,0).toDecimal();
														portTransportAmt = ifnull(matrixRec.Port_Fees_Transport_WH_AUD_MT,0).toDecimal();
														repackAmt = ifnull(matrixRec.Repacking_Costs_AUD_MT,0).toDecimal();
														storageAmt = ifnull(matrixRec.Est_Storage_Cost_AUD_MT,0).toDecimal();
														additionalAmt = ifnull(matrixRec.Additional_Charges_AUD_MT,0).toDecimal();
														fuelPct = ifnull(matrixRec.Fuel_Levy_Percent,0).toDecimal() / 100.0;
														deliveryAmt = ifnull(matrixRec.Est_Delivery_Cost_AUD_MT,0).toDecimal();
														financePct = ifnull(matrixRec.Financing_Percent,0).toDecimal() / 100.0;
													}
													if(statusText == "Calculated")
													{
														supplierAud = buyPrice.toDecimal() / fxRate.toDecimal();
														portFuelAdder = portTransportAmt * (1.0 + fuelPct);
														deliveryFuelAdder = deliveryAmt * (1.0 + fuelPct);
														costAdders = dutyAmt + wharfAmt + portFuelAdder + repackAmt + storageAmt + additionalAmt + deliveryFuelAdder;
														preFinanceCost = supplierAud + costAdders;
														overallCost = preFinanceCost * (1.0 + financePct);
														marginPct = input.Margin_Percent.toDecimal() / 100.0;
														marginAud = overallCost * marginPct;
														quotedPrice = overallCost / (1.0 - marginPct) * quoteFxRate.toDecimal();
													}
													update Pricing_Options[ID == input.ID]
													[
														Supplier_Price_Record=if(supplierRec.count() > 0,supplierRec.ID,null)
														Logistics_Matrix_Record=if(matrixRec.count() > 0,matrixRec.ID,null)
														FX_Rate_Record=if(fxRec.count() > 0,fxRec.ID,null)
														Exchange_Rate=fxRate
														Exchange_Rate_Description=fxDescription
														Buy_Price_CIF_Curr_MT=buyPrice
														Buy_Currency=sourceCurrency
														Supplier_Price_AUD_MT=supplierAud
														Duty_AUD_MT=dutyAmt
														Wharf_Clearance_AUD_MT=wharfAmt
														Port_Fees_Transport_WH_AUD_MT=portTransportAmt
														Repacking_Costs_AUD_MT=repackAmt
														Est_Storage_Cost_AUD_MT=storageAmt
														Additional_Charges_AUD_MT=additionalAmt
														Fuel_Levy_Percent=fuelPct * 100
														Est_Delivery_Cost_AUD_MT=deliveryAmt
														Financing_Percent=financePct * 100
														Cost_Adders_AUD_MT=costAdders
														Overall_Product_Cost_AUD_MT=overallCost
														Margin_AUD_MT=marginAud
														Quoted_Price_MT=quotedPrice
														Calculation_Status=statusText
														Calculation_Message=messageText
														Calculated_On=zoho.currenttime
													];
													if(statusText == "Calculated" && reqRec.count() > 0 && reqRec.Request_Status == "Draft")
													{
														update Pricing_Requests[ID == input.Pricing_Request]
														[
															Request_Status="Calculated"
														];
													}
													insert into Audit_Logs
													[
														Module_Name="Pricing_Options"
														Record_Display=input.Option_Code
														Record_ID_Text=input.ID.toString()
														Action_Type=if(statusText == "Calculated","Calculated","Validation")
														Changed_By=zoho.loginuser
														Summary="Pricing option " + input.Option_Code + " saved with status " + statusText + ". " + messageText
														Related_Customer=input.Customer
														Related_Request=input.Pricing_Request
														Severity=if(statusText == "Calculated","Info","Warning")
														Added_User=zoho.loginuser
													]
									)
								}
							}
			
						
			}

			Pricing_Options_On_Validate as "Pricing Options On Validate"
			{
			
							type =  form
							form = Pricing_Options
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Total_Quantity_KG <= 0)
													{
														alert "Total quantity must be greater than zero.";
														cancel submit;
													}
													if(input.Margin_Percent < 0 || input.Margin_Percent >= 100)
													{
														alert "Margin percent must be at least 0 and less than 100.";
														cancel submit;
													}
													if(input.Pricing_Request != null)
													{
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
														if(reqRec.count() > 0)
														{
															if(!thisapp.permissions.isUserInProfile("Pricing_Admin") && reqRec.Request_Status == "Approved" || reqRec.Request_Status == "Quote Generated" || reqRec.Request_Status == "Sent" || reqRec.Request_Status == "Expired" || reqRec.Request_Status == "Cancelled")
															{
																alert "This pricing request is locked for non-admin edits.";
																cancel submit;
															}
														}
													}
													prodRec = Product_Catalog[ID == input.Product];
													if(prodRec.count() == 0 || prodRec.Product_Status != "Active")
													{
														alert "Pricing options require an active product.";
														cancel submit;
													}
													branchRec = Customer_Branches[ID == input.Customer_Branch];
													if(branchRec.count() == 0 || branchRec.Branch_Status != "Active")
													{
														alert "Pricing options require an active customer branch.";
														cancel submit;
													}
													portRec = Arrival_Ports[ID == input.Arrival_Port];
													if(portRec.count() == 0 || portRec.Port_Status != "Active")
													{
														alert "Pricing options require an active arrival port.";
														cancel submit;
													}
													packRec = Packaging_Options[ID == input.Packaging];
													if(packRec.count() == 0 || packRec.Packaging_Status != "Active")
													{
														alert "Pricing options require an active packaging option.";
														cancel submit;
													}
													deliveryRec = Delivery_Models[ID == input.Delivery_Model];
													if(deliveryRec.count() == 0 || deliveryRec.Delivery_Status != "Active")
													{
														alert "Pricing options require an active delivery model.";
														cancel submit;
													}
													if(input.Option_Code == null || input.Option_Code == "")
													{
														reqText = "REQ";
														if(input.Pricing_Request != null)
														{
															reqRecForCode = Pricing_Requests[ID == input.Pricing_Request];
															if(reqRecForCode.count() > 0)
															{
																reqText = reqRecForCode.Request_Number.toString();
															}
														}
														input.Option_Code = reqText + "-OPT-" + zoho.currenttime.toString("yyyyMMddHHmmss");
													}
									)
								}
							}
			
						
			}

			Pricing_Options_Pricing_Request_On_User_Input as "Pricing Options Pricing Request On User Input"
			{
			
							type =  form
							form = Pricing_Options
			
							record event = on add or edit
			
							on user input of Pricing_Request
							{
								actions 
								{
									custom deluge script
									(
														if(input.Pricing_Request != null)
													{
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
														if(reqRec.count() > 0)
														{
															input.Customer = reqRec.Customer;
															input.Customer_Branch = reqRec.Primary_Branch;
															input.Quote_Currency = reqRec.Quote_Currency;
														}
													}
									)
								}
							}
			
						
			}

			Pricing_Options_Product_On_User_Input as "Pricing Options Product On User Input"
			{
			
							type =  form
							form = Pricing_Options
			
							record event = on add or edit
			
							on user input of Product
							{
								actions 
								{
									custom deluge script
									(
														if(input.Product != null)
													{
														prodRec = Product_Catalog[ID == input.Product];
														if(prodRec.count() > 0)
														{
															input.Vendor = prodRec.Default_Vendor;
															input.Duty_AUD_MT = prodRec.Default_Duty_AUD_MT;
															input.Buy_Currency = prodRec.Default_Currency;
														}
													}
									)
								}
							}
			
						
			}

			Customer_On_User_Input as "Customer On User Input"
			{
			
							type =  form
							form = Pricing_Requests
			
							record event = on add or edit
			
							on user input of Customer
							{
								actions 
								{
									custom deluge script
									(
														custRec = Customers[ID == input.Customer];
													if(custRec.count() > 0)
													{
														input.Quote_Currency = custRec.Preferred_Quote_Currency;
														input.Customer_Email = custRec.Primary_Email;
														input.Payment_Terms = custRec.Default_Payment_Terms;
													}
													agr = Customer_Commercial_Agreements[Customer == input.Customer && Agreement_Status == "Active" && Effective_From <= zoho.currentdate && Effective_To == null || Effective_To >= zoho.currentdate] sort by Effective_From desc;
													if(agr.count() > 0)
													{
														if(agr.Preferred_Quote_Currency != null && agr.Preferred_Quote_Currency != "")
														{
															input.Quote_Currency = agr.Preferred_Quote_Currency;
														}
														input.Payment_Terms = agr.Payment_Terms;
														if(agr.Default_Validity_Days != null)
														{
															input.Valid_Until = zoho.currentdate.addDay(agr.Default_Validity_Days);
														}
													}
									)
								}
							}
			
						
			}

			Pricing_Requests_On_Load as "Pricing Requests On Load"
			{
			
							type =  form
							form = Pricing_Requests
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														input.Request_Date = zoho.currentdate;
													input.Requested_By = zoho.loginuser;
													if(input.Request_Status == null || input.Request_Status == "")
													{
														input.Request_Status = "Draft";
													}
									)
								}
							}
			
						
			}

			Pricing_Requests_On_Success as "Pricing Requests On Success"
			{
			
							type =  form
							form = Pricing_Requests
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														insert into Audit_Logs
													[
														Module_Name="Pricing_Requests"
														Record_Display=input.Request_Number.toString()
														Record_ID_Text=input.ID.toString()
														Action_Type="Updated"
														Changed_By=zoho.loginuser
														Summary="Pricing request " + input.Request_Number + " saved with status " + input.Request_Status + "."
														Related_Customer=input.Customer
														Related_Request=input.ID
														Severity="Info"
														Added_User=zoho.loginuser
													]
									)
								}
							}
			
						
			}

			Pricing_Requests_On_Validate as "Pricing Requests On Validate"
			{
			
							type =  form
							form = Pricing_Requests
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														custRec = Customers[ID == input.Customer];
													if(custRec.count() == 0 || custRec.Customer_Status != "Active")
													{
														alert "Pricing request must be linked to an active customer.";
														cancel submit;
													}
													if(input.Valid_Until != null && input.Valid_Until < input.Request_Date)
													{
														alert "Quote Valid Until cannot be before Request Date.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Product_Catalog_On_Success as "Product Catalog On Success"
			{
			
							type =  form
							form = Product_Catalog
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														actionText = "Updated";
													insert into Audit_Logs
													[
														Added_User=zoho.loginuser
														Module_Name="Product_Catalog"
														Record_Display=input.Product_Code
														Record_ID_Text=input.ID.toString()
														Action_Type=actionText
														Changed_By=zoho.loginuser
														Summary="Product " + input.Product_Code + " saved as " + input.Application_Category + " / " + input.Resin_Subcategory + " with status " + input.Product_Status + "."
														Severity="Info"
													]
									)
								}
							}
			
						
			}

			Product_Catalog_On_Validate as "Product Catalog On Validate"
			{
			
							type =  form
							form = Product_Catalog
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Default_Currency != null && input.Default_Currency != "" && input.Default_Currency != "USD" && input.Default_Currency != "EUR")
													{
														alert "Default Currency must be USD or EUR.";
														cancel submit;
													}
													if(input.Default_Duty_AUD_MT != null && input.Default_Duty_AUD_MT < 0)
													{
														alert "Default Duty cannot be negative.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Quote_Documents_On_Load as "Quote Documents On Load"
			{
			
							type =  form
							form = Quote_Documents
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Quote_Date == null)
													{
														input.Quote_Date = zoho.currentdate;
													}
													if(input.Generated_By == null || input.Generated_By == "")
													{
														input.Generated_By = zoho.loginuser;
													}
													if(input.Quote_Status == null || input.Quote_Status == "")
													{
														input.Quote_Status = "Draft";
													}
									)
								}
							}
			
						
			}

			Quote_Documents_On_Success as "Quote Documents On Success"
			{
			
							type =  form
							form = Quote_Documents
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
													quoteHtml = "<div style='font-family:Arial,sans-serif;color:#1f2937;'>";
													quoteHtml = quoteHtml + "<h2 style='margin:0 0 8px 0;'>" + input.Quote_Title + "</h2>";
													quoteHtml = quoteHtml + "<p><b>Quote Date:</b> " + input.Quote_Date.toString() + " &nbsp; <b>Valid Until:</b> " + input.Valid_Until.toString() + "</p>";
													quoteHtml = quoteHtml + "<p><b>Currency:</b> " + input.Quote_Currency + " &nbsp; <b>Payment Terms:</b> " + input.Payment_Terms + "</p>";
													quoteHtml = quoteHtml + "<table style='width:100%;border-collapse:collapse;margin-top:16px;' border='1' cellpadding='6'>";
													quoteHtml = quoteHtml + "<tr style='background:#f3f4f6;'><th>Option</th><th>Product</th><th>Packaging</th><th>Quantity KG</th><th>Delivery Region</th><th>Delivery Model</th><th>Container</th><th>FX</th><th>Price / MT</th></tr>";
													calculatedOptions = Pricing_Options[Pricing_Request == input.Pricing_Request && Calculation_Status == "Calculated"] sort by Option_Code;
													for each  opt in calculatedOptions
													{
														productText = "";
														packText = "";
														deliveryText = "";
														prodRec = Product_Catalog[ID == opt.Product];
														if(prodRec.count() > 0)
														{
															productText = prodRec.Product_Code;
														}
														packRec = Packaging_Options[ID == opt.Packaging];
														if(packRec.count() > 0)
														{
															packText = packRec.Packaging_Name;
														}
														deliveryRec = Delivery_Models[ID == opt.Delivery_Model];
														if(deliveryRec.count() > 0)
														{
															deliveryText = deliveryRec.Delivery_Model_Name;
														}
														quoteHtml = quoteHtml + "<tr>";
														quoteHtml = quoteHtml + "<td>" + opt.Option_Name + "</td>";
														quoteHtml = quoteHtml + "<td>" + productText + "</td>";
														quoteHtml = quoteHtml + "<td>" + packText + "</td>";
														quoteHtml = quoteHtml + "<td style='text-align:right;'>" + opt.Total_Quantity_KG.toString() + "</td>";
														quoteHtml = quoteHtml + "<td>" + opt.Delivery_Region + "</td>";
														quoteHtml = quoteHtml + "<td>" + deliveryText + "</td>";
														quoteHtml = quoteHtml + "<td>" + opt.Container_Size + "</td>";
														quoteHtml = quoteHtml + "<td>" + opt.Exchange_Rate_Description + "</td>";
														quoteHtml = quoteHtml + "<td style='text-align:right;'>" + opt.Quoted_Price_MT.toString() + " " + opt.Quote_Currency + "</td>";
														quoteHtml = quoteHtml + "</tr>";
													}
													quoteHtml = quoteHtml + "</table>";
													quoteHtml = quoteHtml + "<p style='margin-top:16px;'>Prices are based on the approved pricing snapshot at generation time and remain subject to agreed validity, payment terms, and final contract terms.</p>";
													if(input.Quote_Summary != null && input.Quote_Summary != "")
													{
														quoteHtml = quoteHtml + "<p><b>Summary:</b> " + input.Quote_Summary + "</p>";
													}
													quoteHtml = quoteHtml + "</div>";
													update Quote_Documents[ID == input.ID]
													[
														Quote_HTML_Snapshot=quoteHtml
														Quote_Status="Generated"
														Generated_By=zoho.loginuser
														Generated_On=zoho.currenttime
														Total_Options=calculatedOptions.count()
													];
													update Pricing_Requests[ID == input.Pricing_Request]
													[
														Request_Status="Quote Generated"
													];
													insert into Audit_Logs
													[
														Module_Name="Quote_Documents"
														Record_Display=input.Quote_Number.toString()
														Record_ID_Text=input.ID.toString()
														Action_Type="Generated Quote"
														Changed_By=zoho.loginuser
														Summary="Quote document generated for pricing request " + input.Pricing_Request.toString() + " with " + calculatedOptions.count().toString() + " calculated option(s)."
														Related_Customer=input.Customer
														Related_Request=input.Pricing_Request
														Severity="Info"
														Added_User=zoho.loginuser
													]
									)
								}
							}
			
						
			}

			Quote_Documents_On_Validate as "Quote Documents On Validate"
			{
			
							type =  form
							form = Quote_Documents
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
													if(reqRec.count() == 0)
													{
														alert "A valid pricing request is required.";
														cancel submit;
													}
													if(reqRec.count() > 0 && reqRec.Request_Status != "Approved" && reqRec.Request_Status != "Quote Generated")
													{
														alert "Quotes can only be generated from approved pricing requests.";
														cancel submit;
													}
													calculatedOptions = Pricing_Options[Pricing_Request == input.Pricing_Request && Calculation_Status == "Calculated"];
													if(calculatedOptions.count() == 0)
													{
														alert "At least one calculated pricing option is required before generating a quote.";
														cancel submit;
													}
													if(input.Quote_Status == "Sent" && !thisapp.permissions.isUserInProfile("Pricing_Admin"))
													{
														alert "Sent quote snapshots can only be changed by Pricing Admin users.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Quote_Documents_Pricing_Request_On_User_Input as "Quote Documents Pricing Request On User Input"
			{
			
							type =  form
							form = Quote_Documents
			
							record event = on add or edit
			
							on user input of Pricing_Request
							{
								actions 
								{
									custom deluge script
									(
														if(input.Pricing_Request != null)
													{
														reqRec = Pricing_Requests[ID == input.Pricing_Request];
														if(reqRec.count() > 0)
														{
															input.Customer = reqRec.Customer;
															input.Quote_Currency = reqRec.Quote_Currency;
															input.Valid_Until = reqRec.Valid_Until;
															input.Payment_Terms = reqRec.Payment_Terms;
															input.Quote_Title = "Quote for request " + reqRec.Request_Number.toString();
														}
														calculatedOptions = Pricing_Options[Pricing_Request == input.Pricing_Request && Calculation_Status == "Calculated"];
														input.Total_Options = calculatedOptions.count();
													}
									)
								}
							}
			
						
			}

			Supplier_Price_Books_On_Load as "Supplier Price Books On Load"
			{
			
							type =  form
							form = Supplier_Price_Books
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Currency == null || input.Currency == "")
													{
														input.Currency = "USD";
													}
									)
								}
							}
			
						
			}

			Supplier_Price_Books_On_Success as "Supplier Price Books On Success"
			{
			
							type =  form
							form = Supplier_Price_Books
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														insert into Audit_Logs
													[
														Module_Name="Supplier_Price_Books"
														Record_Display=input.Price_Book_Code
														Record_ID_Text=input.ID.toString()
														Action_Type="Updated"
														Changed_By=zoho.loginuser
														Summary="Supplier price " + input.Price_Book_Code + " saved at " + input.Buy_Price_CIF_Curr_MT + " " + input.Currency + "/MT."
														Severity="Info"
														Added_User=zoho.loginuser
													]
									)
								}
							}
			
						
			}

			Supplier_Price_Books_On_Validate as "Supplier Price Books On Validate"
			{
			
							type =  form
							form = Supplier_Price_Books
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Buy_Price_CIF_Curr_MT <= 0)
													{
														alert "Buy Price CIF must be greater than zero.";
														cancel submit;
													}
													if(input.Effective_To != null && input.Effective_To < input.Effective_From)
													{
														alert "Effective To cannot be before Effective From.";
														cancel submit;
													}
													if(input.Price_Status == "Active")
													{
														prodRec = Product_Catalog[ID == input.Product];
														venRec = Vendors[ID == input.Vendor];
														if(prodRec.count() == 0 || prodRec.Product_Status != "Active")
														{
															alert "Active supplier prices require an active product.";
															cancel submit;
														}
														if(venRec.count() == 0 || venRec.Vendor_Status != "Active")
														{
															alert "Active supplier prices require an active vendor.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Supplier_Price_Books_Product_On_User_Input as "Supplier Price Books Product On User Input"
			{
			
							type =  form
							form = Supplier_Price_Books
			
							record event = on add or edit
			
							on user input of Product
							{
								actions 
								{
									custom deluge script
									(
														prodRec = Product_Catalog[ID == input.Product];
													if(prodRec.count() > 0)
													{
														input.Vendor = prodRec.Default_Vendor;
														input.Currency = prodRec.Default_Currency;
													}
									)
								}
							}
			
						
			}

			Vendors_On_Success as "Vendors On Success"
			{
			
							type =  form
							form = Vendors
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														insert into Audit_Logs
													[
														Added_User=zoho.loginuser
														Module_Name="Vendors"
														Record_Display=input.Vendor_Name
														Record_ID_Text=input.ID.toString()
														Action_Type="Updated"
														Changed_By=zoho.loginuser
														Summary="Vendor " + input.Vendor_Code + " - " + input.Vendor_Name + " saved with status " + input.Vendor_Status + "."
														Severity="Info"
													]
									)
								}
							}
			
						
			}

			Vendors_On_Validate as "Vendors On Validate"
			{
			
							type =  form
							form = Vendors
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Vendor_Status == "Active" && input.Contact_Name != null && input.Contact_Name != "" && input.Contact_Email == null || input.Contact_Email == "")
													{
														alert "Contact Email is required when an active vendor has a contact name.";
														cancel submit;
													}
									)
								}
							}
			
						
			}
		}

		blueprint
		{
			Pricing_Request_Approval as "Pricing Request Approval"
			{
			
			        			type = Blueprint
			        			form = Pricing_Requests
			        			start
			        			{
			            			start stage = "Draft"
			        			}
			        			stages
			        			{
			           			"Draft"
			           			{
			           			}
			           			"Calculated"
			           			{
			           			}
			           			"Submitted for Approval"
			           			{
			           			}
			           			"Approved"
			           			{
			           			}
			           			"Rejected"
			           			{
			           			}
			           			"Quote Generated"
			           			{
			           			}
			           			"Sent"
			           			{
			           			}
			           			"Expired"
			           			{
			           			}
			           			"Cancelled"
			           			{
			           			}
			        			}
			        			transitions
			        			{
			    				Approve_Request as "Approve Request"
			    				{
			         				type = normal
			         				from stage = "Submitted for Approval"
			         				to stage = "Approved"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Management_Approver"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		input.Approved_By = zoho.loginuser;
																	input.Approved_On = zoho.currenttime;
																	insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Approved"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request approved."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Cancel_Request as "Cancel Request"
			    				{
			         				type = common
			         				from stage = "Draft"
			         				to stage = "Cancelled"
			         				common stages = {"Quote Generated", "Approved", "Calculated", "Rejected", "Submitted for Approval", "Sent"}
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Cancelled"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request cancelled."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Warning"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Expire_Request as "Expire Request"
			    				{
			         				type = common
			         				from stage = "Quote Generated"
			         				to stage = "Expired"
			         				common stages = {"Sent"}
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Expired"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request expired."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Generate_Quote as "Generate Quote"
			    				{
			         				type = normal
			         				from stage = "Approved"
			         				to stage = "Quote Generated"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		quoteCheck = Quote_Documents[Pricing_Request == input.ID];
																	if(quoteCheck.count() == 0)
																	{
																		insert into Quote_Documents
																		[
																			Pricing_Request=input.ID
																			Customer=input.Customer
																			Quote_Date=zoho.currentdate
																			Valid_Until=input.Valid_Until
																			Quote_Status="Draft"
																			Quote_Currency=input.Quote_Currency
																			Payment_Terms=input.Payment_Terms
																			Quote_Title="Pricing Offer " + input.Request_Number
																			Generated_By=zoho.loginuser
																			Generated_On=zoho.currenttime
																			Added_User=zoho.loginuser
																		]
																	}
																	insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Generated Quote"
																		Changed_By=zoho.loginuser
																		Summary="Quote document generated from approved request."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Mark_Calculated as "Mark Calculated"
			    				{
			         				type = normal
			         				from stage = "Draft"
			         				to stage = "Calculated"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin", "Sales_Trader"}
			             				)
			            				transition criteria = (Request_Status == "Draft")
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Calculated"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request marked calculated."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Mark_Sent as "Mark Sent"
			    				{
			         				type = normal
			         				from stage = "Quote Generated"
			         				to stage = "Sent"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin", "Sales_Trader"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Sent"
																		Changed_By=zoho.loginuser
																		Summary="Pricing quote marked sent."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Reject_Request as "Reject Request"
			    				{
			         				type = normal
			         				from stage = "Submitted for Approval"
			         				to stage = "Rejected"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Management_Approver"}
			             				)
			         				}
			         				during
			         				{
			            				action = update_fields
			            				workflow status = true
			            				visible fields = [Approval_Comments]
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Rejected"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request rejected. " + ifnull(input.Approval_Comments,"")
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Warning"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			    				Submit_For_Approval as "Submit for Approval"
			    				{
			         				type = normal
			         				from stage = "Calculated"
			         				to stage = "Submitted for Approval"
			         				before
			         				{
			            				transition owner
			            				(
			                				permissions = {"Pricing_Admin", "Sales_Trader"}
			             				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		insert into Audit_Logs
																	[
																		Module_Name="Pricing_Requests"
																		Record_Display=input.Request_Number.toString()
																		Record_ID_Text=input.ID.toString()
																		Action_Type="Submitted"
																		Changed_By=zoho.loginuser
																		Summary="Pricing request submitted for approval."
																		Related_Customer=input.Customer
																		Related_Request=input.ID
																		Severity="Info"
																		Added_User=zoho.loginuser
																	]
											)
										}
			         				}
			  				}
			        			}
			    			
			}
		}
	}

