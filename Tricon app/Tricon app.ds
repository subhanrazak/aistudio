	pages
	{
		page Pricing_Dashboard
		{
					displayname = "Pricing Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='KPI_Cards' elementName='KPI_Cards' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage KPI_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tactiveCustomers = Customers[Customer_Status == &quot;Active&quot;].count();\n\topenRequests = Pricing_Requests[Request_Status == &quot;Draft&quot; || Request_Status == &quot;Calculated&quot; || Request_Status == &quot;Submitted for Approval&quot; || Request_Status == &quot;Approved&quot;].count();\n\tawaitingApproval = Pricing_Requests[Request_Status == &quot;Submitted for Approval&quot;].count();\n\tmissingOptions = Pricing_Options[Calculation_Status == &quot;Missing Inputs&quot; || Calculation_Status == &quot;Error&quot;].count();\n\tcurrentMonth = zoho.currentdate.toString(&quot;MM&quot;);\n\tcurrentYear = zoho.currentdate.toString(&quot;yyyy&quot;);\n\tgeneratedThisMonth = 0;\n\tfor each  quoteRec in Quote_Documents[Quote_Status == &quot;Generated&quot;]\n\t{\n\t\tif(quoteRec.Quote_Date != null &amp;&amp; quoteRec.Quote_Date.toString(&quot;MM&quot;) == currentMonth &amp;&amp; quoteRec.Quote_Date.toString(&quot;yyyy&quot;) == currentYear)\n\t\t{\n\t\t\tgeneratedThisMonth = generatedThisMonth + 1;\n\t\t}\n\t}\n\tpageStamp = zoho.currentdate.toString(&quot;dd-MMM-yyyy&quot;);\n\t%&gt;\n&lt;style&gt;\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-black-color: #000000;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\na { text-decoration: none; }\n.zcs-row, .zcs-flex { display: flex; }\n.zcs-row { flex-wrap: wrap; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-direction-row { flex-direction: row; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-items-center, .zcs-align-center { align-items: center; }\n.zcs-align-items-stretch { align-items: stretch; }\n.zcs-justify-start { justify-content: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-color-green { color: #179E6C; }\n.zcs-color-red { color: #FE455D; }\n.zcs-color-yellow { color: #B8770D; }\n.zcs-rounded-sm { border-radius: 4px; }\n.zcs-rounded-md { border-radius: 6px; }\n.zcs-rounded-lg { border-radius: 8px; }\n.zcs-rounded-xl { border-radius: 12px; }\n.zcs-rounded-2xl { border-radius: 16px; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n.zcs-m-0 { margin: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-6 { margin-top: 0.375rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mb-4 { margin-bottom: 0.25rem; }\n.zcs-mb-6 { margin-bottom: 0.375rem; }\n.zcs-mb-8 { margin-bottom: 0.5rem; }\n.zcs-mb-10 { margin-bottom: 0.625rem; }\n.zcs-mb-12 { margin-bottom: 0.75rem; }\n.zcs-mb-16 { margin-bottom: 1rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-10 { padding: 0.625rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-14 { padding: 0.875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-18 { padding: 1.125rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-22 { padding: 1.375rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-p-25 { padding: 1.5625rem; }\n.zcs-px-8 { padding-left: 0.5rem; padding-right: 0.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-14 { padding-left: 0.875rem; padding-right: 0.875rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-18 { padding-left: 1.125rem; padding-right: 1.125rem; }\n.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }\n.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.pricing-dashboard-shell { background: var(--zcs-page-bg-color, #F3F3F4); padding: 18px 18px 0; box-sizing: border-box; }\n.pricing-hero { background: linear-gradient(135deg, var(--zcs-theme-brand-color), #111827); border-radius: 16px; padding: 24px; color: #fff; overflow: hidden; position: relative; }\n.pricing-hero:after { content: &apos;&apos;; position: absolute; width: 260px; height: 260px; border-radius: 50%; right: -80px; top: -120px; border: 38px solid rgba(255,255,255,0.12); }\n.pricing-hero h1, .pricing-hero p { position: relative; z-index: 1; }\n.kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(150px, 1fr)); gap: 14px; margin-top: 16px; }\n.kpi-card { min-height: 142px; padding: 18px; border-left: 4px solid var(--zcs-theme-brand-color); transition: transform .18s ease, box-shadow .18s ease; }\n.kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(17,24,39,0.08); }\n.kpi-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.kpi-value { font-size: 2rem; font-weight: 700; line-height: 1.05; color: var(--zcs-primary-text-color); }\n.kpi-note { border: 1px solid var(--zcs-border-color); background: #fff; border-radius: 12px; padding: 14px 16px; margin-top: 14px; }\n.zcs-notes-wrapper ul { list-style-type: disc; }\n.zcs-notes-wrapper ul li::marker { color: var(--zcs-teritiary-text-color); }\n.zcs-notes-text a:hover { text-decoration: underline; }\n@media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(3, minmax(160px, 1fr)); } }\n@media (max-width: 760px) { .kpi-grid { grid-template-columns: 1fr; } .pricing-dashboard-shell { padding: 12px 12px 0; } .pricing-hero { padding: 18px; } .zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;pricing-dashboard-shell&quot;&gt;\n\t\t&lt;div class=&quot;pricing-hero&quot;&gt;\n\t\t\t\t&lt;h1 class=&quot;zcs-font-28 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Pricing Dashboard&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-8 zcs-mb-0&quot;&gt;Management view of pricing activity, approvals, quote outcomes, missing input issues, and recent rule-change audit activity. Refreshed as of &lt;%=pageStamp%&gt;.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;kpi-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot; href=&quot;#Report:Active_Customers&quot; target=&quot;_self&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase&quot;&gt;Active customers&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=activeCustomers%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Customers available for pricing&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot; href=&quot;#Report:All_Pricing_Requests&quot; target=&quot;_self&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase&quot;&gt;Open requests&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=openRequests%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Draft through approved pipeline&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot; href=&quot;#Report:Pending_Approvals&quot; target=&quot;_self&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase&quot;&gt;Awaiting approval&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=awaitingApproval%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Requests submitted for approval&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot; href=&quot;#Report:Generated_Quotes&quot; target=&quot;_self&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase&quot;&gt;Quotes generated&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=generatedThisMonth%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Generated during current month&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot; href=&quot;#Report:Pricing_Options_By_Request&quot; target=&quot;_self&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase&quot;&gt;Missing inputs&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=missingOptions%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Options requiring pricing attention&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;kpi-note zcs-notes-wrapper&quot;&gt;\n\t\t\t\t&lt;p class=&quot;zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-notes-title zcs-font-medium zcs-color-tertiary&quot;&gt;Governance note: &lt;/span&gt;Pricing rules are maintained as data-driven records, and each quote snapshot preserves the rule set, inputs, and calculated values used when the quote was generated.&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Pipeline_Summary' elementName='Pipeline_Summary' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Pipeline_Summary()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tdraftCount = Pricing_Requests[Request_Status == &quot;Draft&quot;].count();\n\tcalculatedCount = Pricing_Requests[Request_Status == &quot;Calculated&quot;].count();\n\tsubmittedCount = Pricing_Requests[Request_Status == &quot;Submitted for Approval&quot;].count();\n\tapprovedCount = Pricing_Requests[Request_Status == &quot;Approved&quot;].count();\n\tquoteGeneratedCount = Pricing_Requests[Request_Status == &quot;Quote Generated&quot;].count();\n\tsentCount = Pricing_Requests[Request_Status == &quot;Sent&quot;].count();\n\texpiredCount = Pricing_Requests[Request_Status == &quot;Expired&quot;].count();\n\tpipelineTotal = draftCount + calculatedCount + submittedCount + approvedCount + quoteGeneratedCount + sentCount + expiredCount;\n\tif(pipelineTotal == 0)\n\t{\n\t\tpipelineTotal = 1;\n\t}\n\tdraftPct = (draftCount * 100.0) / pipelineTotal;\n\tcalculatedPct = (calculatedCount * 100.0) / pipelineTotal;\n\tsubmittedPct = (submittedCount * 100.0) / pipelineTotal;\n\tapprovedPct = (approvedCount * 100.0) / pipelineTotal;\n\tquoteGeneratedPct = (quoteGeneratedCount * 100.0) / pipelineTotal;\n\tsentPct = (sentCount * 100.0) / pipelineTotal;\n\texpiredPct = (expiredCount * 100.0) / pipelineTotal;\n\tcurrentMonth = zoho.currentdate.toString(&quot;MM&quot;);\n\tcurrentYear = zoho.currentdate.toString(&quot;yyyy&quot;);\n\toutGenerated = 0;\n\toutSent = 0;\n\toutAccepted = 0;\n\toutDeclined = 0;\n\toutExpired = 0;\n\tfor each  quoteRec in Quote_Documents[ID != 0]\n\t{\n\t\tif(quoteRec.Quote_Date != null &amp;&amp; quoteRec.Quote_Date.toString(&quot;MM&quot;) == currentMonth &amp;&amp; quoteRec.Quote_Date.toString(&quot;yyyy&quot;) == currentYear)\n\t\t{\n\t\t\tif(quoteRec.Quote_Status == &quot;Generated&quot;)\n\t\t\t{\n\t\t\t\toutGenerated = outGenerated + 1;\n\t\t\t}\n\t\t\telse if(quoteRec.Quote_Status == &quot;Sent&quot;)\n\t\t\t{\n\t\t\t\toutSent = outSent + 1;\n\t\t\t}\n\t\t\telse if(quoteRec.Quote_Status == &quot;Accepted&quot;)\n\t\t\t{\n\t\t\t\toutAccepted = outAccepted + 1;\n\t\t\t}\n\t\t\telse if(quoteRec.Quote_Status == &quot;Declined&quot;)\n\t\t\t{\n\t\t\t\toutDeclined = outDeclined + 1;\n\t\t\t}\n\t\t\telse if(quoteRec.Quote_Status == &quot;Expired&quot;)\n\t\t\t{\n\t\t\t\toutExpired = outExpired + 1;\n\t\t\t}\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n.pipeline-shell { padding: 0 18px; background: var(--zcs-page-bg-color, #F3F3F4); }\n.dashboard-section-card { padding: 20px; }\n.pipeline-grid { display: grid; grid-template-columns: 1.45fr .9fr; gap: 16px; }\n.pipeline-status-grid { display: grid; grid-template-columns: repeat(7, minmax(110px, 1fr)); gap: 10px; }\n.status-chip-card { background: #fff; border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 12px; min-height: 92px; }\n.status-count { font-size: 1.55rem; font-weight: 700; color: var(--zcs-primary-text-color); }\n.pipeline-bar { overflow: hidden; background: var(--zcs_component_hover_color); border-radius: 999px; height: 8px; margin-top: 8px; }\n.pipeline-bar span { display: block; height: 8px; border-radius: 999px; background: var(--zcs-theme-brand-color); }\n.quote-outcome-grid { display: grid; grid-template-columns: repeat(5, minmax(86px, 1fr)); gap: 10px; }\n.outcome-tile { border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 12px; background: #fff; }\n.outcome-tile strong { display: block; font-size: 1.5rem; color: var(--zcs-primary-text-color); line-height: 1.1; }\n@media (max-width: 1100px) { .pipeline-grid { grid-template-columns: 1fr; } .pipeline-status-grid { grid-template-columns: repeat(3, minmax(120px, 1fr)); } }\n@media (max-width: 760px) { .pipeline-status-grid, .quote-outcome-grid { grid-template-columns: 1fr; } .pipeline-shell { padding: 0 12px; } }\n&lt;/style&gt;\n&lt;div class=&quot;pipeline-shell&quot;&gt;\n\t\t&lt;div class=&quot;pipeline-grid&quot;&gt;\n\t\t\t\t&lt;section class=&quot;dashboard-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quote pipeline by request status&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Operational distribution across active and downstream statuses.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot; href=&quot;#Report:Pricing_Pipeline_Kanban&quot; target=&quot;_self&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Pipeline&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;pipeline-status-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Draft&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=draftCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=draftPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Calculated&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=calculatedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=calculatedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Submitted&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=submittedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Approved&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=approvedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=approvedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Quote Generated&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=quoteGeneratedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=quoteGeneratedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Sent&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=sentCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=sentPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-chip-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-13&quot;&gt;Expired&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;status-count zcs-mt-10&quot;&gt;&lt;%=expiredCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;pipeline-bar&quot;&gt;&lt;span style=&quot;width:&lt;%=expiredPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t\t&lt;section class=&quot;dashboard-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quote outcomes this month&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Counts from Quote_Documents by Quote Status.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot; href=&quot;#Report:Quote_Outcomes&quot; target=&quot;_self&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14&quot;&gt;Outcomes&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;quote-outcome-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;outcome-tile&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Generated&lt;/span&gt;&lt;strong&gt;&lt;%=outGenerated%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;outcome-tile&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Sent&lt;/span&gt;&lt;strong&gt;&lt;%=outSent%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;outcome-tile&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Accepted&lt;/span&gt;&lt;strong class=&quot;zcs-color-green&quot;&gt;&lt;%=outAccepted%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;outcome-tile&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Declined&lt;/span&gt;&lt;strong class=&quot;zcs-color-red&quot;&gt;&lt;%=outDeclined%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;outcome-tile&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Expired&lt;/span&gt;&lt;strong class=&quot;zcs-color-yellow&quot;&gt;&lt;%=outExpired%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='62%'>\n\t\t\t\t<dsp id='Missing_Inputs_Table' elementName='Missing_Inputs_Table' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Missing_Inputs_Table()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tissueCount = Pricing_Options[Calculation_Status == &quot;Missing Inputs&quot; || Calculation_Status == &quot;Error&quot;].count();\n\t%&gt;\n&lt;style&gt;\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 900px; }\n.zcs-table-wrapper table thead { top: 0px; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs-border-color); }\n.missing-shell { padding: 0 0 0 18px; background: var(--zcs-page-bg-color, #F3F3F4); }\n.dashboard-section-card { padding: 20px; }\n.issue-status { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 4px; border: 1px solid; font-size: 12px; white-space: nowrap; }\n.issue-status.missing { color: #B8770D; background: #FCF4E6; border-color: #FAAE13; }\n.issue-status.error { color: #FE455D; background: #FDE3E6; border-color: #FE455D; }\n.empty-state { border: 1px dashed var(--zcs-border-color); border-radius: 12px; padding: 22px; background: #fff; }\n.option-link { color: var(--zcs-theme-brand-color); font-weight: 600; }\n.message-cell { max-width: 320px; white-space: normal; }\n@media (max-width: 900px) { .missing-shell { padding: 0 12px; } }\n&lt;/style&gt;\n&lt;div class=&quot;missing-shell&quot;&gt;\n\t\t&lt;section class=&quot;dashboard-section-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pricing options needing attention&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Options where Calculation_Status is Missing Inputs or Error.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-font-14 zcs-font-medium zcs-color-theme&quot; href=&quot;#Report:Pricing_Options_By_Request&quot; target=&quot;_self&quot;&gt;Open options report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(issueCount == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;empty-state zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-color-green zcs-font-24&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;No missing input or calculation error options&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;The pricing option queue is currently clear.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Option code&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Request&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Missing message&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Calculated date&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;7&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tshown = 0;\n\t\tfor each  opt in Pricing_Options[Calculation_Status == &quot;Missing Inputs&quot; || Calculation_Status == &quot;Error&quot;] sort by Calculated_On desc\n\t\t{\n\t\t\tif(shown &lt; 10)\n\t\t\t{\n\t\t\t\treqLabel = &quot;-&quot;;\n\t\t\t\tcustName = &quot;-&quot;;\n\t\t\t\tproductName = &quot;-&quot;;\n\t\t\t\tcalcDate = &quot;-&quot;;\n\t\t\t\tif(opt.Pricing_Request != null)\n\t\t\t\t{\n\t\t\t\t\treqRec = Pricing_Requests[ID == opt.Pricing_Request];\n\t\t\t\t\tif(reqRec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\treqLabel = ifnull(reqRec.Request_Number,&quot;-&quot;);\n\t\t\t\t\t\tif(reqRec.Customer != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\treqCustRec = Customers[ID == reqRec.Customer];\n\t\t\t\t\t\t\tif(reqCustRec.count() &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcustName = ifnull(reqCustRec.Customer_Name,&quot;-&quot;);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(opt.Customer != null)\n\t\t\t\t{\n\t\t\t\t\toptCustRec = Customers[ID == opt.Customer];\n\t\t\t\t\tif(optCustRec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tcustName = ifnull(optCustRec.Customer_Name,custName);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(opt.Product != null)\n\t\t\t\t{\n\t\t\t\t\tprodRec = Product_Catalog[ID == opt.Product];\n\t\t\t\t\tif(prodRec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tproductName = ifnull(prodRec.Product_Name,&quot;-&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(opt.Calculated_On != null)\n\t\t\t\t{\n\t\t\t\t\tcalcDate = opt.Calculated_On.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t}\n\t\t\t\tstatusClass = &quot;missing&quot;;\n\t\t\t\tstatusIcon = &quot;ui-2-time&quot;;\n\t\t\t\tif(opt.Calculation_Status == &quot;Error&quot;)\n\t\t\t\t{\n\t\t\t\t\tstatusClass = &quot;error&quot;;\n\t\t\t\t\tstatusIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t}\n\t\t\t\toptionUrl = &quot;#Report:Pricing_Options_By_Request?ID=&quot; + opt.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;a class=&quot;option-link&quot; href=&quot;&lt;%=optionUrl%&gt;&quot;&gt;&lt;%=ifnull(opt.Option_Code,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=reqLabel%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=custName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=productName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;issue-status &lt;%=statusClass%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=statusIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;%=opt.Calculation_Status%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary message-cell&quot;&gt;&lt;%=ifnull(opt.Calculation_Message,&quot;Review option inputs and supporting rule data.&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;%=calcDate%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\tshown = shown + 1;\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='38%'>\n\t\t\t\t<dsp id='Approval_Queue' elementName='Approval_Queue' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Approval_Queue()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tapprovalCount = Pricing_Requests[Request_Status == &quot;Submitted for Approval&quot;].count();\n\t%&gt;\n&lt;style&gt;\n.approval-shell { padding: 0 18px 0 0; background: var(--zcs-page-bg-color, #F3F3F4); }\n.dashboard-section-card { padding: 20px; }\n.approval-list { display: grid; gap: 10px; }\n.approval-row { border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 12px 14px; background: #fff; }\n.approval-row:hover { background: #F9FAFE; }\n.approval-status-pill { display: inline-flex; align-items: center; gap: 6px; color: #B8770D; background: #FCF4E6; border: 1px solid #FAAE13; padding: 2px 8px; border-radius: 4px; font-size: 12px; }\n.approval-meta { display: grid; grid-template-columns: repeat(3, minmax(90px, 1fr)); gap: 10px; margin-top: 10px; }\n.empty-state { border: 1px dashed var(--zcs-border-color); border-radius: 12px; padding: 22px; background: #fff; }\n.request-link { color: var(--zcs-theme-brand-color); font-weight: 600; }\n@media (max-width: 900px) { .approval-shell { padding: 0 12px; } .approval-meta { grid-template-columns: 1fr; } }\n&lt;/style&gt;\n&lt;div class=&quot;approval-shell&quot;&gt;\n\t\t&lt;section class=&quot;dashboard-section-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending approval queue&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Pricing requests submitted for management approval.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-font-14 zcs-font-medium zcs-color-theme&quot; href=&quot;#Report:Pending_Approvals&quot; target=&quot;_self&quot;&gt;Open queue&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(approvalCount == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;empty-state zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-color-green zcs-font-24&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;No requests waiting for approval&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Submitted requests will appear here as soon as they enter approval status.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;approval-list&quot;&gt;\n&lt;%\n\t\tshown = 0;\n\t\tfor each  req in Pricing_Requests[Request_Status == &quot;Submitted for Approval&quot;] sort by Valid_Until asc\n\t\t{\n\t\t\tif(shown &lt; 8)\n\t\t\t{\n\t\t\t\tcustName = &quot;-&quot;;\n\t\t\t\tofferMonth = &quot;-&quot;;\n\t\t\t\tvalidUntil = &quot;-&quot;;\n\t\t\t\tif(req.Customer != null)\n\t\t\t\t{\n\t\t\t\t\tcustRec = Customers[ID == req.Customer];\n\t\t\t\t\tif(custRec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tcustName = ifnull(custRec.Customer_Name,&quot;-&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(req.Offer_Month != null)\n\t\t\t\t{\n\t\t\t\t\tofferMonth = req.Offer_Month.toString(&quot;MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\tif(req.Valid_Until != null)\n\t\t\t\t{\n\t\t\t\t\tvalidUntil = req.Valid_Until.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\treqUrl = &quot;#Report:Pending_Approvals?ID=&quot; + req.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t\t%&gt;\n&lt;div class=&quot;approval-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;request-link zcs-font-16&quot; href=&quot;&lt;%=reqUrl%&gt;&quot;&gt;&lt;%=ifnull(req.Request_Number,&quot;Request&quot;)%&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-primary zcs-ellipsis zcs-mt-4&quot;&gt;&lt;%=custName%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;approval-status-pill zcs-no-shrink&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Submitted for Approval&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;approval-meta&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Offer month&lt;/span&gt;&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=offerMonth%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Valid until&lt;/span&gt;&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=validUntil%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary zcs-uppercase&quot;&gt;Requested by&lt;/span&gt;&lt;div class=&quot;zcs-font-14 zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=ifnull(req.Requested_By,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\tshown = shown + 1;\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Recent_Audit_Feed' elementName='Recent_Audit_Feed' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Recent_Audit_Feed()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tauditCount = Audit_Logs[ID != 0].count();\n\t%&gt;\n&lt;style&gt;\n.audit-shell { padding: 0 18px 0 0; background: var(--zcs-page-bg-color, #F3F3F4); }\n.dashboard-section-card { padding: 20px; }\n.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0px 2px 6px 0px #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 24px); background-color: #E1E1E1; top: 5px; }\n.audit-timeline-scroll { max-height: 610px; overflow: auto; padding-right: 4px; }\n.audit-action { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--zcs-border-color); color: var(--zcs-theme-brand-color); background: var(--zcs_component_hover_color); }\n.audit-summary { color: var(--zcs-secondary-text-color); }\n.empty-state { border: 1px dashed var(--zcs-border-color); border-radius: 12px; padding: 22px; background: #fff; }\n@media (max-width: 768px) {\n\t\t.audit-shell { padding: 0 12px; }\n\t\t.zcs-tl-li { flex-direction: column; }\n\t\t.zcs-tl-indicator { left: 0px; }\n\t\t.zcs-tl-time { text-align: left; padding: 0px 60px; margin-bottom: 12px; }\n}\n&lt;/style&gt;\n&lt;div class=&quot;audit-shell&quot;&gt;\n\t\t&lt;section class=&quot;dashboard-section-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Recent audit activity&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Latest 10 audit events across pricing rules, options, requests, and quotes.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-font-14 zcs-font-medium zcs-color-theme&quot; href=&quot;#Report:Audit_Log_Report&quot; target=&quot;_self&quot;&gt;Open audit report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(auditCount == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;empty-state zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-time zcs-color-tertiary zcs-font-24&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;No audit events recorded yet&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-tertiary zcs-mt-4 zcs-mb-0&quot;&gt;Rule maintenance and quote generation audit entries will appear here.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-timeline-wrapper audit-timeline-scroll&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tshown = 0;\n\t\tfor each  auditRec in Audit_Logs[ID != 0] sort by Audit_DateTime desc\n\t\t{\n\t\t\tif(shown &lt; 10)\n\t\t\t{\n\t\t\t\teventTime = &quot;-&quot;;\n\t\t\t\tif(auditRec.Audit_DateTime != null)\n\t\t\t\t{\n\t\t\t\t\teventTime = auditRec.Audit_DateTime.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=eventTime%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=ifnull(auditRec.Module_Name,&quot;Module&quot;)%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;audit-action zcs-font-12&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;%=ifnull(auditRec.Action_Type,&quot;Action&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;audit-summary zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=ifnull(auditRec.Summary,&quot;No summary provided.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-6&quot;&gt;User: &lt;%=ifnull(auditRec.Changed_By,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\tshown = shown + 1;\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Arrival_Ports_On_Success as "Arrival Ports On Success"
			{
			
							type =  form
							form = Arrival_Ports
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														insert into Audit_Logs
													[
														Added_User=zoho.loginuser
														Module_Name="Arrival_Ports"
														Record_Display=input.Port_Name
														Record_ID_Text=input.ID.toString()
														Action_Type="Updated"
														Changed_By=zoho.loginuser
														Summary="Arrival port " + input.Port_Code + " - " + input.Port_Name + " saved with status " + input.Port_Status + "."
														Severity="Info"
													]
									)
								}
							}
			
						
			}

			Audit_Logs_On_Load as "Audit Logs On Load"
			{
			
							type =  form
							form = Audit_Logs
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Audit_DateTime == null)
													{
														input.Audit_DateTime = zoho.currenttime;
													}
													if(input.Changed_By == null || input.Changed_By == "")
													{
														input.Changed_By = zoho.loginuser;
													}
													if(input.Severity == null || input.Severity == "")
													{
														input.Severity = "Info";
													}
									)
								}
							}
			
						
			}

			Audit_Logs_On_Success as "Audit Logs On Success"
			{
			
							type =  form
							form = Audit_Logs
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														info "Audit log saved without recursive audit creation.";
									)
								}
							}
			
						
			}

			Audit_Logs_On_Validate as "Audit Logs On Validate"
			{
			
							type =  form
							form = Audit_Logs
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Summary == null || input.Summary == "")
													{
														alert "Audit summary is required.";
														cancel submit;
													}
													if(input.Module_Name == null || input.Module_Name == "")
													{
														alert "Module Name is required.";
														cancel submit;
													}
													if(input.Action_Type == null || input.Action_Type == "")
													{
														alert "Action Type is required.";
														cancel submit;
													}
													if(input.Audit_DateTime == null)
													{
														input.Audit_DateTime = zoho.currenttime;
													}
													if(input.Severity == null || input.Severity == "")
													{
														input.Severity = "Info";
													}
									)
								}
							}
			
						
			}

			Customer_Branches_On_Load as "Customer Branches On Load"
			{
			
							type =  form
							form = Customer_Branches
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Branch_Status == null || input.Branch_Status == "")
													{
														input.Branch_Status = "Active";
													}
													if(input.Historical_Location == null)
													{
														input.Historical_Location = false;
													}
									)
								}
							}
			
						
			}

			Customer_Branches_On_Success as "Customer Branches On Success"
			{
			
							type =  form
							form = Customer_Branches
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														actionText = "Updated";
													insert into Audit_Logs
													[
														Added_User=zoho.loginuser
														Module_Name="Customer_Branches"
														Record_Display=input.Branch_Name
														Record_ID_Text=input.ID.toString()
														Action_Type=actionText
														Changed_By=zoho.loginuser
														Summary="Branch " + input.Branch_Code + " for customer " + input.Customer.Customer_Name + " saved for " + input.City + ", " + input.Country + "."
														Related_Customer=input.Customer
														Severity="Info"
													]
									)
								}
							}
			
						
			}

			Customer_Branches_On_Validate as "Customer Branches On Validate"
			{
			
							type =  form
							form = Customer_Branches
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Suburb == null || input.Suburb == "" && input.Delivery_Region == null || input.Delivery_Region == "")
													{
														alert "Pricing Delivery Region is required when suburb is blank.";
														cancel submit;
													}
													custRec = Customers[ID == input.Customer];
													if(custRec.count() == 0 || custRec.Customer_Status != "Active")
													{
														alert "Branch must be linked to an active customer.";
														cancel submit;
													}
													if(input.Historical_Location == true && input.Branch_Status == "Active")
													{
														alert "Historical locations should be inactive unless they are available for future deliveries.";
													}
									)
								}
							}
			
						
			}

			Customer_Commercial_Agreements_On_Load as "Customer Commercial Agreements On Load"
			{
			
							type =  form
							form = Customer_Commercial_Agreements
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Agreement_Status == null || input.Agreement_Status == "")
													{
														input.Agreement_Status = "Draft";
													}
													if(input.Default_Validity_Days == null)
													{
														input.Default_Validity_Days = 7;
													}
									)
								}
							}
			
						
			}

			Customer_Commercial_Agreements_On_Success as "Customer Commercial Agreements On Success"
			{
			
							type =  form
							form = Customer_Commercial_Agreements
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														insert into Audit_Logs
													[
														Module_Name="Customer_Commercial_Agreements"
														Record_Display=input.Agreement_Code
														Record_ID_Text=input.ID.toString()
														Action_Type="Updated"
														Changed_By=zoho.loginuser
														Summary="Commercial agreement " + input.Agreement_Code + " saved with status " + input.Agreement_Status + "."
														Related_Customer=input.Customer
														Severity="Info"
														Added_User=zoho.loginuser
													]
									)
								}
							}
			
						
			}

