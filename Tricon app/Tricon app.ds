		    			type = text
						maxchar = 80
			 			row = 1
			 			column = 2   
						width = medium
					)
					Suburb
					(
		    			type = text
						displayname = "Suburb / Delivery Region"
						maxchar = 120
			 			row = 1
			 			column = 1   
						width = medium
					)
					State
					(
		    			type = text
						displayname = "State / Province"
						maxchar = 80
			 			row = 1
			 			column = 2   
						width = medium
					)
					Postal_Code
					(
		    			type = text
