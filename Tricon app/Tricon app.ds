					(
						type = picklist
						displayname = "Preferred Container Size"
						values = {"20GP","40HC","Other"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					Notes
					(
		    			type = textarea
						height = 13px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

