	reports
	{
		default list All_Arrival_Ports
		{
		
					displayName = "All Arrival Ports"
					show all rows from Arrival_Ports    
					(
						Port_Code
						Port_Name
						Port_Status
						Country
						State
						City
					)
					filters
					(
						Port_Status
						Country
						State
					)
					sort by
					(
						Port_Name ascending
					)
				
		}

		default list Audit_Log_Report
		{
		
					displayName = "Audit Log Report"
					show all rows from Audit_Logs    
					(
						Audit_Number
						Audit_DateTime
						Module_Name
						Record_Display
						Action_Type
						Changed_By
						Summary
						Related_Customer
						Related_Request
						Severity
					)
					filters
					(
						Audit_DateTime
						Module_Name
						Action_Type
						Changed_By
						Severity
						Related_Customer
						Related_Request
					)
					sort by
					(
						Audit_DateTime descending
					)
				
		}

		list Critical_Audit_Events
		{
		
					displayName = "Critical Audit Events"
					show all rows from Audit_Logs  [Severity == "Critical"]  
					(
						Audit_Number
						Audit_DateTime
						Module_Name
						Record_Display
						Action_Type
						Changed_By
						Summary
						Related_Customer
						Related_Request
						Severity
					)
					filters
					(
						Audit_DateTime
						Module_Name
						Action_Type
						Changed_By
						Severity
						Related_Customer
						Related_Request
					)
					sort by
					(
						Audit_DateTime descending
					)
				
		}

		list Active_Branches_By_Region
		{
		
					displayName = "Active Branches By Region"
					show all rows from Customer_Branches  [Branch_Status == "Active"]  
					(
						Branch_Code
						Customer
						Branch_Name
						Branch_Status
						Country
						City
						Suburb
						State
						Delivery_Region
						Default_Arrival_Port
						Preferred_Packaging
						Preferred_Container_Size
					)
