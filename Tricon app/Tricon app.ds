						maxchar = 30
			 			row = 1
			 			column = 1   
						width = medium
					)
					Delivery_Address
					(
		    			type = textarea
						displayname = "Delivery Address"
						height = 13px
			 			row = 1
			 			column = 2   
						width = medium
					)
					Delivery_Region
					(
		    			type = text
						displayname = "Pricing Delivery Region"
						maxchar = 120
			 			row = 1
			 			column = 1   
						width = medium
					)
					Historical_Location
					(
		    			type = checkbox
						displayname = "Historical Delivery Location"
						initial value = false
			 			row = 1
			 			column = 2   
						width = medium
					)
					Default_Arrival_Port
					(
						type = picklist	
						displayname = "Default Arrival Port"
						values  = Arrival_Ports.ID
		    			displayformat = [Port_Name]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Preferred_Packaging
					(
						type = picklist	
						displayname = "Preferred Packaging"
						values  = Packaging_Options.ID
