form Delivery_Models
{

			displayname = "Delivery Models"
			Delivery_Model_Details
			(
				type = section
				displayname = "Delivery Model Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Delivery_Model_Code
			(
    			type = text
				displayname = "Delivery Model Code"
				maxchar = 60
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Delivery_Model_Name
			(
    			type = text
				displayname = "Delivery Model Name"
				maxchar = 180
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Delivery_Status
			(
				type = picklist
				displayname = "Delivery Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incoterm
			(
				type = picklist
				values = {"DDP","DAP","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Agreement_Type
			(
				type = picklist
				displayname = "Agreement Type"
				values = {"Blanket Agreement","Standard Delivery","Indent","Blanket Order Contract","Direct to Customer","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Include_Warehouse_Costs
			(
    			type = checkbox
				displayname = "Include Warehouse Costs"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Include_Delivery_Costs
			(
    			type = checkbox
				displayname = "Include Delivery Costs"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Include_Storage_Costs
			(
    			type = checkbox
				displayname = "Include Storage Costs"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Include_Repacking_Costs
			(
    			type = checkbox
				displayname = "Include Repacking Costs"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Terms_Text
			(
    			type = textarea
				displayname = "Default Terms Text"
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}