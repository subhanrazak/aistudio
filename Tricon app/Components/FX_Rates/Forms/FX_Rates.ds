form FX_Rates
{

			displayname = "FX Rates"
			FX_Rate_Details
			(
				type = section
				displayname = "FX Rate Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Rate_Key
			(
    			type = text
				displayname = "Rate Key"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Rate_Date
			(
    			type = date
				displayname = "Rate Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have From_Currency
			(
				type = picklist
				displayname = "From Currency"
				values = {"USD","EUR","AUD","NZD"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have To_Currency
			(
				type = picklist
				displayname = "To Currency"
				values = {"AUD","NZD","USD"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Exchange_Rate
			(
				type = decimal
				displayname = "Exchange Rate"
				decimalplace = 6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rate_Description
			(
    			type = text
				displayname = "Exchange Rate Description"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Source_Name
			(
    			type = text
				displayname = "Source"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Approved
			(
    			type = checkbox
				displayname = "Approved for Pricing"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}