list Active_Tier_Rules
{

			displayName = "Active Tier Rules"
			show all rows from Customer_Tier_Rules  [Rule_Status == "Active"]  
			(
				Rule_Code
				Rule_Status
				Application_Category
				Resin_Subcategory
				Tier
				Minimum_Monthly_Tons
				Maximum_Monthly_Tons
				Threshold_Description
				Effective_From
				Effective_To
			)
			filters
			(
				Rule_Status
				Application_Category
				Resin_Subcategory
				Tier
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Application_Category ascending
				Resin_Subcategory ascending
			)
			sort by
			(
				Application_Category ascending
				Resin_Subcategory ascending
				Tier ascending
			)
		
}