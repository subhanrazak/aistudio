default list All_Customer_Tier_Rules
{

			displayName = "All Customer Tier Rules"
			show all rows from Customer_Tier_Rules    
			(
				Rule_Code
				Rule_Status
				Application_Category
				Resin_Subcategory
				Tier
				Minimum_Monthly_Tons
				Maximum_Monthly_Tons
				Threshold_Description
				Effective_From
				Effective_To
			)
			filters
			(
				Rule_Status
				Application_Category
				Resin_Subcategory
				Tier
			)
			sort by
			(
				Application_Category ascending
				Resin_Subcategory ascending
				Tier ascending
			)
		
}