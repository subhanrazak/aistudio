form Customer_Tier_Rules
{

			displayname = "Customer Tier Rules"
			Tier_Rule_Details
			(
				type = section
				displayname = "Tier Rule Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Rule_Code
			(
    			type = text
				displayname = "Rule Code"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Rule_Status
			(
				type = picklist
				displayname = "Rule Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Application_Category
			(
				type = picklist
				displayname = "Application Category"
				values = {"Film","Pipe & Fittings","Blow Moulding","Roto Moulding","Injection Moulding","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resin_Subcategory
			(
				type = picklist
				displayname = "Resin Subcategory"
				values = {"PE","PVC","PP","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Tier
			(
				type = picklist
				values = {"Tier A","Tier B","Tier C"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Minimum_Monthly_Tons
			(
				type = decimal
				displayname = "Minimum Monthly Tons"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Maximum_Monthly_Tons
			(
				type = decimal
				displayname = "Maximum Monthly Tons"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Threshold_Description
			(
    			type = text
				displayname = "Threshold Description"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Effective_From
			(
    			type = date
				displayname = "Effective From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Effective_To
			(
    			type = date
				displayname = "Effective To"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}