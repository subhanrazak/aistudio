form Product_Catalog
{

			displayname = "Product Catalog"
			Product_Details
			(
				type = section
				displayname = "Product Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Product_Code
			(
    			type = text
				displayname = "Product Code"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Name
			(
    			type = text
				displayname = "Product Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Trade_Name
			(
    			type = text
				displayname = "Trade Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Status
			(
				type = picklist
				displayname = "Product Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Application_Category
			(
				type = picklist
				displayname = "Application Category"
				values = {"Film","Pipe & Fittings","Blow Moulding","Roto Moulding","Injection Moulding","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resin_Subcategory
			(
				type = picklist
				displayname = "Resin Subcategory"
				values = {"PE","PVC","PP","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Book_Name
			(
				type = picklist
				displayname = "Book Name"
				values = {"PE","PVC","OTP","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Vendor
			(
				type = picklist	
				displayname = "Default Vendor"
				values  = Vendors.ID
    			displayformat = [Vendor_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Currency
			(
				type = picklist
				displayname = "Default Currency"
				values = {"USD","EUR"}
				initial value = "USD"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Duty_AUD_MT
			(
				type = decimal
				displayname = "Default Duty (AUD/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Product_Notes
			(
    			type = textarea
				displayname = "Product Notes"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}