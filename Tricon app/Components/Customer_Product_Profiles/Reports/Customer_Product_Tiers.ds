default list Customer_Product_Tiers
{

			displayName = "Customer Product Tiers"
			show all rows from Customer_Product_Profiles    
			(
				Profile_Code
				Customer
				Product
				Application_Category
				Resin_Subcategory
				Monthly_Consumption_Tons
				Calculated_Tier
				Tier_Rule_Used
				Effective_From
				Effective_To
			)
			filters
			(
				Customer
				Application_Category
				Resin_Subcategory
				Calculated_Tier
			)
			sort by
			(
				Customer ascending
			)
		
}