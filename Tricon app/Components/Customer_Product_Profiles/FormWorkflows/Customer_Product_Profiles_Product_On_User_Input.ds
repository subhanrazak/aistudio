Customer_Product_Profiles_Product_On_User_Input as "Customer Product Profiles Product On User Input"
{

				type =  form
				form = Customer_Product_Profiles

				record event = on add or edit

				on user input of Product
				{
					actions 
					{
						custom deluge script
						(
											prodRec = Product_Catalog[ID == input.Product];
										if(prodRec.count() > 0)
										{
											input.Application_Category = prodRec.Application_Category;
											input.Resin_Subcategory = prodRec.Resin_Subcategory;
										}
						)
					}
				}

			
}