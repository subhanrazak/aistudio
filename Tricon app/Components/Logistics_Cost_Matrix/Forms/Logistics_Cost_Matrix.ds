form Logistics_Cost_Matrix
{

			displayname = "Logistics Cost Matrix"
			Matrix_Details
			(
				type = section
				displayname = "Matrix Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Matrix_Code
			(
    			type = text
				displayname = "Matrix Code"
				maxchar = 120
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Matrix_Status
			(
				type = picklist
				displayname = "Matrix Status"
				values = {"Draft","Active","Expired","Inactive"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Arrival_Port
			(
				type = picklist	
				displayname = "Arrival Port"
				values  = Arrival_Ports.ID
    			displayformat = [Port_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Delivery_Region
			(
    			type = text
				displayname = "Delivery Region"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			State
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Country
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Packaging
			(
				type = picklist	
				values  = Packaging_Options.ID
    			displayformat = [Packaging_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Model
			(
				type = picklist	
				displayname = "Delivery Model"
				values  = Delivery_Models.ID
    			displayformat = [Delivery_Model_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Container_Size
			(
				type = picklist
				displayname = "Container Size"
				values = {"20GP","40HC","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Wharf_Clearance_AUD_MT
			(
				type = decimal
				displayname = "Wharf Clearance (AUD/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Port_Fees_Transport_WH_AUD_MT
			(
				type = decimal
				displayname = "Port Fees + Transport to WH (AUD/MT)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repacking_Costs_AUD_MT
			(
				type = decimal
				displayname = "Repacking Costs (AUD/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Est_Storage_Cost_AUD_MT
			(
				type = decimal
				displayname = "Est Storage Cost (AUD/MT)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Charges_AUD_MT
			(
				type = decimal
				displayname = "Additional Charges (AUD/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Fuel_Levy_Percent
			(
				type = decimal
				displayname = "Fuel Levy %"
				decimalplace = 4
	 			row = 1
	 			column = 1   
				width = medium
			)
			Est_Delivery_Cost_AUD_MT
			(
				type = decimal
				displayname = "Est Delivery Cost (AUD/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Financing_Percent
			(
				type = decimal
				displayname = "Financing %"
				decimalplace = 4
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Effective_From
			(
    			type = date
				displayname = "Effective From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_To
			(
    			type = date
				displayname = "Effective To"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}