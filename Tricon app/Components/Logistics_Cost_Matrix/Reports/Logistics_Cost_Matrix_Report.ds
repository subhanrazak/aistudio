default list Logistics_Cost_Matrix_Report
{

			displayName = "Logistics Cost Matrix"
			show all rows from Logistics_Cost_Matrix    
			(
				Matrix_Code
				Matrix_Status
				Arrival_Port
				Delivery_Region
				State
				Country
				Packaging
				Delivery_Model
				Container_Size
				Wharf_Clearance_AUD_MT
				Port_Fees_Transport_WH_AUD_MT
				Repacking_Costs_AUD_MT
				Est_Storage_Cost_AUD_MT
				Additional_Charges_AUD_MT
				Fuel_Levy_Percent
				Est_Delivery_Cost_AUD_MT
				Financing_Percent
				Effective_From
				Effective_To
			)
			filters
			(
				Matrix_Status
				Arrival_Port
				Delivery_Region
				Packaging
				Delivery_Model
				Container_Size
			)
			sort by
			(
				Effective_From descending
			)
		
}