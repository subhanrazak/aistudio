list Quote_Outcomes
{

			displayName = "Quote Outcomes"
			show all rows from Quote_Documents    
			(
				Quote_Number
				Customer
				Quote_Date
				Valid_Until
				Quote_Status
				Total_Options
				Generated_By
				Generated_On
			)
			filters
			(
				Customer
				Quote_Status
				Quote_Date
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Quote_Status ascending
			)
			sort by
			(
				Quote_Date descending
			)
		
}