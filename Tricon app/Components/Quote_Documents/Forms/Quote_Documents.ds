form Quote_Documents
{

			displayname = "Quote Documents"
			Quote_Details
			(
				type = section
				displayname = "Quote Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Quote_Number
			(
    			type = autonumber
				displayname = "Quote Number"
				start index = 5000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Pricing_Request
			(
				type = picklist	
				displayname = "Pricing Request"
				values  = Pricing_Requests.ID
    			displayformat = [Request_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = Customers.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quote_Date
			(
    			type = date
				displayname = "Quote Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Valid_Until
			(
    			type = date
				displayname = "Valid Until"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quote_Status
			(
				type = picklist
				displayname = "Quote Status"
				values = {"Draft","Generated","Sent","Accepted","Declined","Expired"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Quote_Currency
			(
				type = picklist
				displayname = "Quote Currency"
				values = {"AUD","NZD","USD"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Terms
			(
    			type = text
				displayname = "Payment Terms"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Options
			(
				type = number
				displayname = "Total Options"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quote_Title
			(
    			type = text
				displayname = "Quote Title"
				maxchar = 180
	 			row = 1
	 			column = 2   
				width = medium
			)
			Quote_Summary
			(
    			type = textarea
				displayname = "Quote Summary"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quote_HTML_Snapshot
			(
    			type = richtext
				displayname = "Quote HTML Snapshot"
				height = 300px
				toolbar = enable
				[
					style, font-color, alignment, link, table, bullets-and-numbering, html, 
					font-size : {2, 3, 4, 5},
					font-family : {"Arimo", "Lato", "Poppins"}
				]
	 			row = 1
	 			column = 2   
				width = medium
			)
			PDF_File
			(
    			type = upload file
				displayname = "Generated PDF File"
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 1   
				width = medium
			)
			Generated_By
			(
    			type = email
				displayname = "Generated By"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Generated_On
			(
    			type = datetime
				displayname = "Generated On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}