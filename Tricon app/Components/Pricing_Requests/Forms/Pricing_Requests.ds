form Pricing_Requests
{

			displayname = "Pricing Requests"
			Request_Details
			(
				type = section
				displayname = "Request Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Request_Number
			(
    			type = autonumber
				displayname = "Request Number"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Request_Date
			(
    			type = date
				displayname = "Request Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Requested_By
			(
    			type = email
				displayname = "Requested By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer
			(
				type = picklist	
				values  = Customers.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_Branch
			(
				type = picklist	
				displayname = "Primary Branch"
				values  = Customer_Branches.ID
    			displayformat = [Branch_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Offer_Month
			(
    			type = date
				displayname = "Offer / Billing Month"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Request_Source
			(
				type = picklist
				displayname = "Request Source"
				values = {"Email","Manual","Future CRM"}
				initial value = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quote_Currency
			(
				type = picklist
				displayname = "Quote Currency"
				values = {"AUD","NZD","USD"}
				initial value = "AUD"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Request_Status
			(
				type = picklist
				displayname = "Request Status"
				values = {"Draft","Calculated","Submitted for Approval","Approved","Rejected","Quote Generated","Sent","Expired","Cancelled"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Valid_Until
			(
    			type = date
				displayname = "Quote Valid Until"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer_Email
			(
    			type = email
				displayname = "Customer Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Terms
			(
    			type = text
				displayname = "Payment Terms"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Approval_Comments
			(
    			type = textarea
				displayname = "Approval Comments"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved_By
			(
    			type = email
				displayname = "Approved By"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Approved_On
			(
    			type = datetime
				displayname = "Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Request_Notes
			(
    			type = textarea
				displayname = "Request Notes"
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Draft","Calculated","Submitted for Approval","Approved","Rejected","Quote Generated","Sent","Expired","Cancelled"}
			}
		
}