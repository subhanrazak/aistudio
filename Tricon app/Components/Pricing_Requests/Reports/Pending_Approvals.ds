list Pending_Approvals
{

			displayName = "Pending Approvals"
			show all rows from Pricing_Requests  [Request_Status == "Submitted for Approval"]  
			(
				Request_Number
				Request_Date
				Customer
				Offer_Month
				Quote_Currency
				Request_Status
				Valid_Until
				Approval_Comments
			)
			filters
			(
				Customer
				Request_Status
				Quote_Currency
				Offer_Month
			)
			sort by
			(
				Request_Date ascending
			)
		
}