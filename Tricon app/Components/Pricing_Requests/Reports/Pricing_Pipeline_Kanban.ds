kanban Pricing_Pipeline_Kanban
{

			displayName = "Pricing Pipeline Kanban"
			show all rows from Pricing_Requests    
			(
				Request_Number
				Request_Date
				Customer
				Offer_Month
				Quote_Currency
				Request_Status
				Valid_Until
				Approved_By
			)
			filters
			(
				Customer
				Request_Status
				Quote_Currency
				Offer_Month
			)
			sort by
			(
				Request_Date descending
			)
			options
			(
	 			display field = Request_Status
				sort order  = ascending
				record count  = enable
	 		)
		
}