default list All_Pricing_Requests
{

			displayName = "All Pricing Requests"
			show all rows from Pricing_Requests    
			(
				Request_Number
				Request_Date
				Customer
				Primary_Branch
				Offer_Month
				Request_Source
				Quote_Currency
				Request_Status
				Valid_Until
				Customer_Email
				Payment_Terms
				Approved_By
				Approved_On
			)
			filters
			(
				Customer
				Request_Status
				Quote_Currency
				Offer_Month
			)
			sort by
			(
				Request_Date descending
			)
		
}