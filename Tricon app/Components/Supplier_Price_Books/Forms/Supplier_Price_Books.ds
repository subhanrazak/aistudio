form Supplier_Price_Books
{

			displayname = "Supplier Price Books"
			Supplier_Price_Details
			(
				type = section
				displayname = "Supplier Price Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Price_Book_Code
			(
    			type = text
				displayname = "Price Book Code"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Price_Status
			(
				type = picklist
				displayname = "Price Status"
				values = {"Draft","Active","Expired","Inactive"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Product
			(
				type = picklist	
				values  = Product_Catalog.ID
    			displayformat = [Product_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor
			(
				type = picklist	
				values  = Vendors.ID
    			displayformat = [Vendor_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Arrival_Port
			(
				type = picklist	
				displayname = "Arrival Port"
				values  = Arrival_Ports.ID
    			displayformat = [Port_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Packaging
			(
				type = picklist	
				values  = Packaging_Options.ID
    			displayformat = [Packaging_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Container_Size
			(
				type = picklist
				displayname = "Container Size"
				values = {"20GP","40HC","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Buy_Price_CIF_Curr_MT
			(
				type = decimal
				displayname = "Buy Price CIF (Curr/MT)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Currency
			(
				type = picklist
				values = {"USD","EUR"}
				initial value = "USD"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Effective_From
			(
    			type = date
				displayname = "Effective From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_To
			(
    			type = date
				displayname = "Effective To"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}