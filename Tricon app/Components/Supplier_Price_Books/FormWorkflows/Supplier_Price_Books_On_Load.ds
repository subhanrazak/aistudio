Supplier_Price_Books_On_Load as "Supplier Price Books On Load"
{

				type =  form
				form = Supplier_Price_Books

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Currency == null || input.Currency == "")
										{
											input.Currency = "USD";
										}
						)
					}
				}

			
}