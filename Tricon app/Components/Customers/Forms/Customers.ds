form Customers
{

			Customer_Details
			(
				type = section
				displayname = "Customer Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Customer_Code
			(
    			type = text
				displayname = "Customer Code"
				maxchar = 50
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Name
			(
    			type = text
				displayname = "Customer Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Customer_Status
			(
				type = picklist
				displayname = "Customer Status"
				values = {"Active","On Hold","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Type
			(
				type = picklist
				displayname = "Customer Type"
				values = {"Distributor","Direct Customer","Contract Customer","Spot Customer","Internal"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Tier
			(
				type = picklist
				displayname = "Default Customer Tier"
				values = {"Tier A","Tier B","Tier C","Unassigned"}
				initial value = "Unassigned"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Primary_Country
			(
    			type = text
				displayname = "Primary Country"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_City
			(
    			type = text
				displayname = "Primary City"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Primary_Suburb
			(
    			type = text
				displayname = "Primary Suburb"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_State
			(
    			type = text
				displayname = "Primary State"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Primary_Email
			(
    			type = email
				displayname = "Primary Email"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Primary_Phone
			(
    			type = phonenumber
				displayname = "Primary Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Preferred_Quote_Currency
			(
				type = picklist
				displayname = "Preferred Quote Currency"
				values = {"AUD","NZD","USD"}
				initial value = "AUD"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Payment_Terms
			(
    			type = text
				displayname = "Default Payment Terms"
				maxchar = 120
	 			row = 1
	 			column = 1   
				width = medium
			)
			CRM_Reference_ID
			(
    			type = text
				displayname = "Future CRM Reference ID"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}