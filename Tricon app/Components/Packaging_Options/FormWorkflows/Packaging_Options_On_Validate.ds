Packaging_Options_On_Validate as "Packaging Options On Validate"
{

				type =  form
				form = Packaging_Options

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Default_Qty_Per_Pallet_KG != null && input.Default_Qty_Per_Pallet_KG < 0)
										{
											alert "Default Qty per Pallet cannot be negative.";
											cancel submit;
										}
										if(input.Default_Qty_Per_Container_KG != null && input.Default_Qty_Per_Container_KG < 0)
										{
											alert "Default Qty per Container cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}