form Packaging_Options
{

			displayname = "Packaging Options"
			Packaging_Details
			(
				type = section
				displayname = "Packaging Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Packaging_Code
			(
    			type = text
				displayname = "Packaging Code"
				maxchar = 40
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Packaging_Name
			(
    			type = text
				displayname = "Packaging Name"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Packaging_Status
			(
				type = picklist
				displayname = "Packaging Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Packaging_Type
			(
				type = picklist
				displayname = "Packaging Type"
				values = {"Seabulk","Bulk Bags","Container","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Qty_Per_Pallet_KG
			(
				type = decimal
				displayname = "Default Qty per Pallet (KG)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Qty_Per_Container_KG
			(
				type = decimal
				displayname = "Default Qty per Container (KG)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Repacking_Required_By_Default
			(
    			type = checkbox
				displayname = "Repacking Required By Default"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}