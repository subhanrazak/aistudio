form Arrival_Ports
{

			displayname = "Arrival Ports"
			Port_Details
			(
				type = section
				displayname = "Port Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Port_Code
			(
    			type = text
				displayname = "Port Code"
				maxchar = 40
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Port_Name
			(
    			type = text
				displayname = "Port Name"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Port_Status
			(
				type = picklist
				displayname = "Port Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Country
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			State
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			City
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}