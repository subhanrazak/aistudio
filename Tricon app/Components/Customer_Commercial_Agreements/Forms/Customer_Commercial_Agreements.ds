form Customer_Commercial_Agreements
{

			displayname = "Customer Commercial Agreements"
			Agreement_Details
			(
				type = section
				displayname = "Agreement Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Agreement_Code
			(
    			type = text
				displayname = "Agreement Code"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer
			(
				type = picklist	
				values  = Customers.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Branch
			(
				type = picklist	
				values  = Customer_Branches.ID
    			displayformat = [Branch_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agreement_Status
			(
				type = picklist
				displayname = "Agreement Status"
				values = {"Draft","Active","Expired","Inactive"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Preferred_Quote_Currency
			(
				type = picklist
				displayname = "Preferred Quote Currency"
				values = {"AUD","NZD","USD"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Terms
			(
    			type = text
				displayname = "Customer Payment Terms"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Margin_Percent
			(
				type = decimal
				displayname = "Default Margin %"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Validity_Days
			(
				type = number
				displayname = "Default Quote Validity Days"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Preferred_Packaging
			(
				type = picklist	
				displayname = "Preferred Packaging"
				values  = Packaging_Options.ID
    			displayformat = [Packaging_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Container_Size
			(
				type = picklist
				displayname = "Preferred Container Size"
				values = {"20GP","40HC","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Delivery_Model
			(
				type = picklist	
				displayname = "Default Delivery Model"
				values  = Delivery_Models.ID
    			displayformat = [Delivery_Model_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Effective_From
			(
    			type = date
				displayname = "Effective From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_To
			(
    			type = date
				displayname = "Effective To"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}