Vendors_On_Validate as "Vendors On Validate"
{

				type =  form
				form = Vendors

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Vendor_Status == "Active" && input.Contact_Name != null && input.Contact_Name != "" && input.Contact_Email == null || input.Contact_Email == "")
										{
											alert "Contact Email is required when an active vendor has a contact name.";
											cancel submit;
										}
						)
					}
				}

			
}