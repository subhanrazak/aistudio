default list All_Vendors
{

			displayName = "All Vendors"
			show all rows from Vendors    
			(
				Vendor_Code
				Vendor_Name
				Vendor_Status
				Country
				Default_Currency
				Contact_Name
				Contact_Email
			)
			filters
			(
				Vendor_Status
				Default_Currency
				Country
			)
			sort by
			(
				Vendor_Name ascending
			)
		
}