form Customer_Branches
{

			displayname = "Customer Branches"
			Branch_Details
			(
				type = section
				displayname = "Branch Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Branch_Code
			(
    			type = text
				displayname = "Branch Code"
				maxchar = 60
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer
			(
				type = picklist	
				values  = Customers.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Branch_Name
			(
    			type = text
				displayname = "Branch Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Branch_Status
			(
				type = picklist
				displayname = "Branch Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Country
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have City
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Suburb
			(
    			type = text
				displayname = "Suburb / Delivery Region"
				maxchar = 120
	 			row = 1
	 			column = 1   
				width = medium
			)
			State
			(
    			type = text
				displayname = "State / Province"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			Postal_Code
			(
    			type = text
				displayname = "Postal Code"
				maxchar = 30
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Address
			(
    			type = textarea
				displayname = "Delivery Address"
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Delivery_Region
			(
    			type = text
				displayname = "Pricing Delivery Region"
				maxchar = 120
	 			row = 1
	 			column = 1   
				width = medium
			)
			Historical_Location
			(
    			type = checkbox
				displayname = "Historical Delivery Location"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Default_Arrival_Port
			(
				type = picklist	
				displayname = "Default Arrival Port"
				values  = Arrival_Ports.ID
    			displayformat = [Port_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Packaging
			(
				type = picklist	
				displayname = "Preferred Packaging"
				values  = Packaging_Options.ID
    			displayformat = [Packaging_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Preferred_Container_Size
			(
				type = picklist
				displayname = "Preferred Container Size"
				values = {"20GP","40HC","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}