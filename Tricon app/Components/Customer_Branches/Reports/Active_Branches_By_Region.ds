list Active_Branches_By_Region
{

			displayName = "Active Branches By Region"
			show all rows from Customer_Branches  [Branch_Status == "Active"]  
			(
				Branch_Code
				Customer
				Branch_Name
				Branch_Status
				Country
				City
				Suburb
				State
				Delivery_Region
				Default_Arrival_Port
				Preferred_Packaging
				Preferred_Container_Size
			)
			filters
			(
				Customer
				Branch_Status
				Country
				City
				Delivery_Region
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Country ascending
				City ascending
			)
			sort by
			(
				Customer ascending
				Branch_Name ascending
			)
		
}