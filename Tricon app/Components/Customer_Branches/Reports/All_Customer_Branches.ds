default list All_Customer_Branches
{

			displayName = "All Customer Branches"
			show all rows from Customer_Branches    
			(
				Branch_Code
				Customer
				Branch_Name
				Branch_Status
				Country
				City
				Suburb
				State
				Delivery_Region
				Default_Arrival_Port
				Preferred_Packaging
				Preferred_Container_Size
			)
			filters
			(
				Customer
				Branch_Status
				Country
				City
				Delivery_Region
			)
			sort by
			(
				Customer ascending
				Branch_Name ascending
			)
		
}