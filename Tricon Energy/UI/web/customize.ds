customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-report-title{font-weight:700}.zc-menu-item{letter-spacing:.01em}"
    }
}
