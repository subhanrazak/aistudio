menu
{
    space Pricing_Workspace
    {
        displayname = "Pricing Workspace"
        icon = "business-calculator"

        section Dashboard_Section
        {
            displayname = "Dashboard"
            icon = "business-chart"
            page Pricing_Dashboard { icon = "business-chart-bar-33" }
            page Quote_Detail { icon = "files-paper" }
        }

        section Pricing_Requests_Section
        {
            displayname = "Pricing Requests"
            icon = "shopping-tag"
            form Pricing_Requests { icon = "files-add" }
            form Pricing_Options { icon = "business-calculator" }
            form Quote_Documents { icon = "files-check" }
            report All_Pricing_Requests { icon = "files-single-content-03" }
            report Pricing_Pipeline_Kanban { icon = "business-hierarchy-54" }
            report Pending_Approvals { icon = "business-signature" }
            report Pricing_Options_By_Request { icon = "shopping-list" }
            report Calculated_Options { icon = "business-chart-growth" }
            report Generated_Quotes { icon = "files-paper" }
        }

        section Master_Data_Section
        {
            displayname = "Master Data"
            icon = "business-contacts"
            form Customers { icon = "users-multiple-11" }
            form Customer_Branches { icon = "location-map-pin" }
            form Product_Catalog { icon = "shopping-box" }
            form Vendors { icon = "business-handshake" }
            form Arrival_Ports { icon = "transportation-boat-front" }
            form Packaging_Options { icon = "shopping-box-3d-67" }
            form Delivery_Models { icon = "shopping-delivery" }
            report All_Customers { icon = "users-contacts" }
            report Active_Customers { icon = "users-circle-08" }
            report All_Customer_Branches { icon = "location-pins" }
            report Active_Branches_By_Region { icon = "location-map" }
            report All_Products { icon = "shopping-stock" }
            report Active_Products { icon = "shopping-box-ribbon" }
            report All_Vendors { icon = "business-briefcase-24" }
            report All_Arrival_Ports { icon = "transportation-boat" }
            report All_Packaging_Options { icon = "shopping-basket" }
            report All_Delivery_Models { icon = "transportation-truck-front" }
        }

        section Pricing_Rules_Costs_Section
        {
            displayname = "Pricing Rules & Costs"
            icon = "business-money-growth"
            form Customer_Tier_Rules { icon = "business-chart-pie-36" }
            form Customer_Product_Profiles { icon = "business-business-contact-88" }
            form Customer_Commercial_Agreements { icon = "business-handshake" }
            form FX_Rates { icon = "business-currency-dollar" }
            form Supplier_Price_Books { icon = "files-folder-money" }
            form Logistics_Cost_Matrix { icon = "transportation-road" }
            report All_Customer_Tier_Rules { icon = "business-percentage-38" }
            report Active_Tier_Rules { icon = "business-goal-64" }
            report Customer_Product_Tiers { icon = "users-badge-13" }
            report Tier_Profile_By_Category { icon = "business-chart-pie-35" }
            report Active_Agreements { icon = "business-signature" }
            report Agreements_Expiring { icon = "business-money-time" }
            report FX_Rate_History { icon = "business-round-dollar" }
            report Supplier_Price_Book { icon = "files-book-07" }
            report Active_Supplier_Prices { icon = "business-money-13" }
            report Logistics_Cost_Matrix_Report { icon = "location-route-open" }
        }

        section Governance_Section
        {
            displayname = "Governance"
            icon = "business-law"
            form Audit_Logs { icon = "files-archive-check" }
            report Audit_Log_Report { icon = "files-archive-paper" }
            report Critical_Audit_Events { icon = "files-exclamation" }
            report Quote_Outcomes { icon = "business-chart-bar-32" }
        }

        section SharedAnalytics_Section
        {
            type = shared_user_report_section
            displayname = "Reports"
            icon = "business-chart-bar-33"
        }
    }

    preference
    {
        icon
        {
            style = outline
            show = {space,section,component}
        }
    }
}
