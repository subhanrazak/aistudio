<%
draftCount = Pricing_Requests[Request_Status == "Draft"].count();
calculatedCount = Pricing_Requests[Request_Status == "Calculated"].count();
submittedCount = Pricing_Requests[Request_Status == "Submitted for Approval"].count();
approvedCount = Pricing_Requests[Request_Status == "Approved"].count();
quoteGeneratedCount = Pricing_Requests[Request_Status == "Quote Generated"].count();
sentCount = Pricing_Requests[Request_Status == "Sent"].count();
expiredCount = Pricing_Requests[Request_Status == "Expired"].count();
pipelineTotal = draftCount + calculatedCount + submittedCount + approvedCount + quoteGeneratedCount + sentCount + expiredCount;
if(pipelineTotal == 0)
{
    pipelineTotal = 1;
}
draftPct = (draftCount * 100.0) / pipelineTotal;
calculatedPct = (calculatedCount * 100.0) / pipelineTotal;
submittedPct = (submittedCount * 100.0) / pipelineTotal;
approvedPct = (approvedCount * 100.0) / pipelineTotal;
quoteGeneratedPct = (quoteGeneratedCount * 100.0) / pipelineTotal;
sentPct = (sentCount * 100.0) / pipelineTotal;
expiredPct = (expiredCount * 100.0) / pipelineTotal;
currentMonth = zoho.currentdate.toString("MM");
currentYear = zoho.currentdate.toString("yyyy");
outGenerated = 0;
outSent = 0;
outAccepted = 0;
outDeclined = 0;
outExpired = 0;
for each quoteRec in Quote_Documents[ID != 0]
{
    if(quoteRec.Quote_Date != null && quoteRec.Quote_Date.toString("MM") == currentMonth && quoteRec.Quote_Date.toString("yyyy") == currentYear)
    {
        if(quoteRec.Quote_Status == "Generated")
        {
            outGenerated = outGenerated + 1;
        }
        else if(quoteRec.Quote_Status == "Sent")
        {
            outSent = outSent + 1;
        }
        else if(quoteRec.Quote_Status == "Accepted")
        {
            outAccepted = outAccepted + 1;
        }
        else if(quoteRec.Quote_Status == "Declined")
        {
            outDeclined = outDeclined + 1;
        }
        else if(quoteRec.Quote_Status == "Expired")
        {
            outExpired = outExpired + 1;
        }
    }
}
%>
<style>
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); }
.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }
.pipeline-shell { padding: 0 18px; background: var(--zcs-page-bg-color, #F3F3F4); }
.dashboard-section-card { padding: 20px; }
.pipeline-grid { display: grid; grid-template-columns: 1.45fr .9fr; gap: 16px; }
.pipeline-status-grid { display: grid; grid-template-columns: repeat(7, minmax(110px, 1fr)); gap: 10px; }
.status-chip-card { background: #fff; border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 12px; min-height: 92px; }
.status-count { font-size: 1.55rem; font-weight: 700; color: var(--zcs-primary-text-color); }
.pipeline-bar { overflow: hidden; background: var(--zcs_component_hover_color); border-radius: 999px; height: 8px; margin-top: 8px; }
.pipeline-bar span { display: block; height: 8px; border-radius: 999px; background: var(--zcs-theme-brand-color); }
.quote-outcome-grid { display: grid; grid-template-columns: repeat(5, minmax(86px, 1fr)); gap: 10px; }
.outcome-tile { border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 12px; background: #fff; }
.outcome-tile strong { display: block; font-size: 1.5rem; color: var(--zcs-primary-text-color); line-height: 1.1; }
@media (max-width: 1100px) { .pipeline-grid { grid-template-columns: 1fr; } .pipeline-status-grid { grid-template-columns: repeat(3, minmax(120px, 1fr)); } }
@media (max-width: 760px) { .pipeline-status-grid, .quote-outcome-grid { grid-template-columns: 1fr; } .pipeline-shell { padding: 0 12px; } }
</style>
<div class="pipeline-shell">
    <div class="pipeline-grid">
        <section class="dashboard-section-card zcs-card">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16">
                <div>
                    <h2 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quote pipeline by request status</h2>
                    <p class="zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0">Operational distribution across active and downstream statuses.</p>
                </div>
                <a class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme" href="#Report:Pricing_Pipeline_Kanban" target="_self"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline loader-dots-06"></i><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Pipeline</span></a>
            </div>
            <div class="pipeline-status-grid">
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey"><i class="zc-li-outline ui-1-edit-72"></i><span class="zcs-font-13">Draft</span></span>
                    <div class="status-count zcs-mt-10"><%=draftCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=draftPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zc-li-outline loader-dots-06"></i><span class="zcs-font-13">Calculated</span></span>
                    <div class="status-count zcs-mt-10"><%=calculatedCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=calculatedPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><i class="zc-li-outline ui-2-time"></i><span class="zcs-font-13">Submitted</span></span>
                    <div class="status-count zcs-mt-10"><%=submittedCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=submittedPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><i class="zc-li-outline ui-1-check-circle-08"></i><span class="zcs-font-13">Approved</span></span>
                    <div class="status-count zcs-mt-10"><%=approvedCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=approvedPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><i class="zc-li-outline ui-1-eye-17"></i><span class="zcs-font-13">Quote Generated</span></span>
                    <div class="status-count zcs-mt-10"><%=quoteGeneratedCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=quoteGeneratedPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><i class="zc-li-outline arrows-1-tail-right"></i><span class="zcs-font-13">Sent</span></span>
                    <div class="status-count zcs-mt-10"><%=sentCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=sentPct%>%;"></span></div>
                </div>
                <div class="status-chip-card">
                    <span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zc-li-outline ui-1-circle-remove"></i><span class="zcs-font-13">Expired</span></span>
                    <div class="status-count zcs-mt-10"><%=expiredCount%></div>
                    <div class="pipeline-bar"><span style="width:<%=expiredPct%>%;"></span></div>
                </div>
            </div>
        </section>
        <section class="dashboard-section-card zcs-card">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-16">
                <div>
                    <h2 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quote outcomes this month</h2>
                    <p class="zcs-font-13 zcs-color-tertiary zcs-mt-4 zcs-mb-0">Counts from Quote_Documents by Quote Status.</p>
                </div>
                <a class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme" href="#Report:Quote_Outcomes" target="_self"><i class="zc-li-outline ui-1-eye-17"></i><span class="zcs-font-14">Outcomes</span></a>
            </div>
            <div class="quote-outcome-grid">
                <div class="outcome-tile"><span class="zcs-font-12 zcs-color-tertiary zcs-uppercase">Generated</span><strong><%=outGenerated%></strong></div>
                <div class="outcome-tile"><span class="zcs-font-12 zcs-color-tertiary zcs-uppercase">Sent</span><strong><%=outSent%></strong></div>
                <div class="outcome-tile"><span class="zcs-font-12 zcs-color-tertiary zcs-uppercase">Accepted</span><strong class="zcs-color-green"><%=outAccepted%></strong></div>
                <div class="outcome-tile"><span class="zcs-font-12 zcs-color-tertiary zcs-uppercase">Declined</span><strong class="zcs-color-red"><%=outDeclined%></strong></div>
                <div class="outcome-tile"><span class="zcs-font-12 zcs-color-tertiary zcs-uppercase">Expired</span><strong class="zcs-color-yellow"><%=outExpired%></strong></div>
            </div>
        </section>
    </div>
</div>
