<%
activeCustomers = Customers[Customer_Status == "Active"].count();
openRequests = Pricing_Requests[Request_Status == "Draft" || Request_Status == "Calculated" || Request_Status == "Submitted for Approval" || Request_Status == "Approved"].count();
awaitingApproval = Pricing_Requests[Request_Status == "Submitted for Approval"].count();
missingOptions = Pricing_Options[Calculation_Status == "Missing Inputs" || Calculation_Status == "Error"].count();
currentMonth = zoho.currentdate.toString("MM");
currentYear = zoho.currentdate.toString("yyyy");
generatedThisMonth = 0;
for each quoteRec in Quote_Documents[Quote_Status == "Generated"]
{
    if(quoteRec.Quote_Date != null && quoteRec.Quote_Date.toString("MM") == currentMonth && quoteRec.Quote_Date.toString("yyyy") == currentYear)
    {
        generatedThisMonth = generatedThisMonth + 1;
    }
}
pageStamp = zoho.currentdate.toString("dd-MMM-yyyy");
%>
<style>
:root {
    --zcs-theme-brand-color: var(--zcs_brand_color);
    --zcs-light-bg-color: var(--zcs_brand_light_color);
    --zcs-primary-text-color: var(--zcs_primary_text_color);
    --zcs-secondary-text-color: var(--zcs_secondary_text_color);
    --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
    --zcs-border-color: var(--zcs_tertiary_border_color);
    --zcs-white-color: #FFFFFF;
    --zcs-black-color: #000000;
    font-size: 16px;
    line-height: 1.5;
}
a { text-decoration: none; }
.zcs-row, .zcs-flex { display: flex; }
.zcs-row { flex-wrap: wrap; }
.zcs-inline-flex { display: inline-flex; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-direction-column { flex-direction: column; }
.zcs-direction-row { flex-direction: row; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-align-items-center, .zcs-align-center { align-items: center; }
.zcs-align-items-stretch { align-items: stretch; }
.zcs-justify-start { justify-content: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-overflow-auto { overflow: auto; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-font-11 { font-size: 0.6875rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-color-green { color: #179E6C; }
.zcs-color-red { color: #FE455D; }
.zcs-color-yellow { color: #B8770D; }
.zcs-rounded-sm { border-radius: 4px; }
.zcs-rounded-md { border-radius: 6px; }
.zcs-rounded-lg { border-radius: 8px; }
.zcs-rounded-xl { border-radius: 12px; }
.zcs-rounded-2xl { border-radius: 16px; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
.zcs-m-0 { margin: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-mt-4 { margin-top: 0.25rem; }
.zcs-mt-6 { margin-top: 0.375rem; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-10 { margin-top: 0.625rem; }
.zcs-mt-12 { margin-top: 0.75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mb-4 { margin-bottom: 0.25rem; }
.zcs-mb-6 { margin-bottom: 0.375rem; }
.zcs-mb-8 { margin-bottom: 0.5rem; }
.zcs-mb-10 { margin-bottom: 0.625rem; }
.zcs-mb-12 { margin-bottom: 0.75rem; }
.zcs-mb-16 { margin-bottom: 1rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: 0.5rem; }
.zcs-p-10 { padding: 0.625rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-14 { padding: 0.875rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-18 { padding: 1.125rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-22 { padding: 1.375rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-p-25 { padding: 1.5625rem; }
.zcs-px-8 { padding-left: 0.5rem; padding-right: 0.5rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-14 { padding-left: 0.875rem; padding-right: 0.875rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-18 { padding-left: 1.125rem; padding-right: 1.125rem; }
.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-gap-6 { gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.pricing-dashboard-shell { background: var(--zcs-page-bg-color, #F3F3F4); padding: 18px 18px 0; box-sizing: border-box; }
.pricing-hero { background: linear-gradient(135deg, var(--zcs-theme-brand-color), #111827); border-radius: 16px; padding: 24px; color: #fff; overflow: hidden; position: relative; }
.pricing-hero:after { content: ''; position: absolute; width: 260px; height: 260px; border-radius: 50%; right: -80px; top: -120px; border: 38px solid rgba(255,255,255,0.12); }
.pricing-hero h1, .pricing-hero p { position: relative; z-index: 1; }
.kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(150px, 1fr)); gap: 14px; margin-top: 16px; }
.kpi-card { min-height: 142px; padding: 18px; border-left: 4px solid var(--zcs-theme-brand-color); transition: transform .18s ease, box-shadow .18s ease; }
.kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(17,24,39,0.08); }
.kpi-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }
.kpi-value { font-size: 2rem; font-weight: 700; line-height: 1.05; color: var(--zcs-primary-text-color); }
.kpi-note { border: 1px solid var(--zcs-border-color); background: #fff; border-radius: 12px; padding: 14px 16px; margin-top: 14px; }
.zcs-notes-wrapper ul { list-style-type: disc; }
.zcs-notes-wrapper ul li::marker { color: var(--zcs-teritiary-text-color); }
.zcs-notes-text a:hover { text-decoration: underline; }
@media (max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(3, minmax(160px, 1fr)); } }
@media (max-width: 760px) { .kpi-grid { grid-template-columns: 1fr; } .pricing-dashboard-shell { padding: 12px 12px 0; } .pricing-hero { padding: 18px; } .zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; } }
</style>
<div class="pricing-dashboard-shell">
    <div class="pricing-hero">
        <h1 class="zcs-font-28 zcs-font-bold zcs-lh-heading zcs-m-0">Pricing Dashboard</h1>
        <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-8 zcs-mb-0">Management view of pricing activity, approvals, quote outcomes, missing input issues, and recent rule-change audit activity. Refreshed as of <%=pageStamp%>.</p>
    </div>
    <div class="kpi-grid">
        <a class="kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12" href="#Report:Active_Customers" target="_self">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8">
                <span class="zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase">Active customers</span>
                <span class="kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08"></i></span>
            </div>
            <div class="kpi-value"><%=activeCustomers%></div>
            <span class="zcs-font-12 zcs-color-tertiary">Customers available for pricing</span>
        </a>
        <a class="kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12" href="#Report:All_Pricing_Requests" target="_self">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8">
                <span class="zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase">Open requests</span>
                <span class="kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline loader-dots-06"></i></span>
            </div>
            <div class="kpi-value"><%=openRequests%></div>
            <span class="zcs-font-12 zcs-color-tertiary">Draft through approved pipeline</span>
        </a>
        <a class="kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12" href="#Report:Pending_Approvals" target="_self">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8">
                <span class="zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase">Awaiting approval</span>
                <span class="kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time"></i></span>
            </div>
            <div class="kpi-value"><%=awaitingApproval%></div>
            <span class="zcs-font-12 zcs-color-tertiary">Requests submitted for approval</span>
        </a>
        <a class="kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12" href="#Report:Generated_Quotes" target="_self">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8">
                <span class="zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase">Quotes generated</span>
                <span class="kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-eye-17"></i></span>
            </div>
            <div class="kpi-value"><%=generatedThisMonth%></div>
            <span class="zcs-font-12 zcs-color-tertiary">Generated during current month</span>
        </a>
        <a class="kpi-card zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12" href="#Report:Pricing_Options_By_Request" target="_self">
            <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8">
                <span class="zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-uppercase">Missing inputs</span>
                <span class="kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-circle-remove"></i></span>
            </div>
            <div class="kpi-value"><%=missingOptions%></div>
            <span class="zcs-font-12 zcs-color-tertiary">Options requiring pricing attention</span>
        </a>
    </div>
    <div class="kpi-note zcs-notes-wrapper">
        <p class="zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="zcs-notes-title zcs-font-medium zcs-color-tertiary">Governance note: </span>Pricing rules are maintained as data-driven records, and each quote snapshot preserves the rule set, inputs, and calculated values used when the quote was generated.</p>
    </div>
</div>
