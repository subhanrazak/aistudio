form Pricing_Options
{
    displayname = "Pricing Options"
    Option_Inputs
    (
        type = section
        displayname = "Option Inputs"
        row = 1
        column = 0
    )
    must have unique Option_Code
    (
        type = text
        displayname = "Option Code"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    must have Pricing_Request
    (
        type = picklist
        displayname = "Pricing Request"
        values = Pricing_Requests.ID
        displayformat = [Request_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Option_Name
    (
        type = text
        displayname = "Option Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Customer_Branch
    (
        type = picklist
        displayname = "Customer Branch"
        values = Customer_Branches.ID
        displayformat = [Branch_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Delivery_Region
    (
        type = text
        displayname = "Delivery Region"
        maxchar = 120
        row = 1
        column = 2
        width = medium
    )
    must have Product
    (
        type = picklist
        displayname = "Product"
        values = Product_Catalog.ID
        displayformat = [Product_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Arrival_Port
    (
        type = picklist
        displayname = "Arrival Port"
        values = Arrival_Ports.ID
        displayformat = [Port_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Packaging
    (
        type = picklist
        displayname = "Packaging"
        values = Packaging_Options.ID
        displayformat = [Packaging_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Delivery_Model
    (
        type = picklist
        displayname = "Delivery Model"
        values = Delivery_Models.ID
        displayformat = [Delivery_Model_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Total_Quantity_KG
    (
        type = decimal
        displayname = "Total Quantity (KG)"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    must have Container_Size
    (
        type = picklist
        displayname = "Container Size"
        values = {"20GP","40HC","Other"}
        row = 1
        column = 1
        width = medium
    )
    Qty_Per_Pallet_KG
    (
        type = decimal
        displayname = "Qty per Pallet (KG)"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Qty_Per_Container_KG
    (
        type = decimal
        displayname = "Qty per Container (KG)"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    must have Quote_Currency
    (
        type = picklist
        displayname = "Quote Currency"
        values = {"AUD","NZD","USD"}
        row = 1
        column = 2
        width = medium
    )
    must have Margin_Percent
    (
        type = decimal
        displayname = "Margin %"
        decimalplace = 4
        row = 1
        column = 1
        width = medium
    )
    Calculation_Snapshot
    (
        type = section
        displayname = "Calculation Snapshot"
        visibility = true
        row = 2
        column = 1
    )
    Supplier_Price_Record
    (
        type = picklist
        displayname = "Supplier Price Record"
        values = Supplier_Price_Books.ID
        displayformat = [Price_Book_Code]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Logistics_Matrix_Record
    (
        type = picklist
        displayname = "Logistics Matrix Record"
        values = Logistics_Cost_Matrix.ID
        displayformat = [Matrix_Code]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    FX_Rate_Record
    (
        type = picklist
        displayname = "FX Rate Record"
        values = FX_Rates.ID
        displayformat = [Rate_Key]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Exchange_Rate
    (
        type = decimal
        displayname = "Exchange Rate"
        decimalplace = 6
        row = 2
        column = 2
        width = medium
    )
    Exchange_Rate_Description
    (
        type = text
        displayname = "Exchange Rate Description"
        maxchar = 80
        row = 2
        column = 1
        width = medium
    )
    Buy_Price_CIF_Curr_MT
    (
        type = decimal
        displayname = "Buy Price CIF (Curr/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Buy_Currency
    (
        type = picklist
        displayname = "Buy Currency"
        values = {"USD","EUR"}
        row = 2
        column = 1
        width = medium
    )
    Supplier_Price_AUD_MT
    (
        type = decimal
        displayname = "Supplier Price (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Duty_AUD_MT
    (
        type = decimal
        displayname = "Duty (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Wharf_Clearance_AUD_MT
    (
        type = decimal
        displayname = "Wharf Clearance (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Port_Fees_Transport_WH_AUD_MT
    (
        type = decimal
        displayname = "Port Fees + Transport to WH (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Repacking_Costs_AUD_MT
    (
        type = decimal
        displayname = "Repacking Costs (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Est_Storage_Cost_AUD_MT
    (
        type = decimal
        displayname = "Est Storage Cost (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Additional_Charges_AUD_MT
    (
        type = decimal
        displayname = "Additional Charges (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Fuel_Levy_Percent
    (
        type = decimal
        displayname = "Fuel Levy %"
        decimalplace = 4
        row = 2
        column = 1
        width = medium
    )
    Est_Delivery_Cost_AUD_MT
    (
        type = decimal
        displayname = "Est Delivery Cost (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Financing_Percent
    (
        type = decimal
        displayname = "Financing %"
        decimalplace = 4
        row = 2
        column = 1
        width = medium
    )
    Cost_Adders_AUD_MT
    (
        type = decimal
        displayname = "Cost Adders (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Overall_Product_Cost_AUD_MT
    (
        type = decimal
        displayname = "Overall Product Cost (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Margin_AUD_MT
    (
        type = decimal
        displayname = "Margin (AUD/MT)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Quoted_Price_MT
    (
        type = decimal
        displayname = "Quoted Price"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Calculation_Status
    (
        type = picklist
        displayname = "Calculation Status"
        values = {"Draft","Calculated","Missing Inputs","Error"}
        initial value = "Draft"
        row = 2
        column = 2
        width = medium
    )
    Calculation_Message
    (
        type = textarea
        displayname = "Calculation Message"
        row = 2
        column = 1
        width = medium
    )
    Calculated_On
    (
        type = datetime
        displayname = "Calculated On"
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
