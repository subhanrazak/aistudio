default list Pricing_Options_By_Request
{
    displayName = "Pricing Options By Request"
    show all rows from Pricing_Options
    (
        Option_Code
        Pricing_Request
        Option_Name
        Customer
        Customer_Branch
        Delivery_Region
        Product
        Vendor
        Arrival_Port
        Packaging
        Delivery_Model
        Total_Quantity_KG
        Container_Size
        Quote_Currency
        Margin_Percent
        Overall_Product_Cost_AUD_MT
        Quoted_Price_MT
        Calculation_Status
        Calculated_On
    )
    filters
    (
        Pricing_Request
        Customer
        Product
        Packaging
        Delivery_Model
        Calculation_Status
        Quote_Currency
    )
    sort by
    (
        Pricing_Request descending
        Option_Code ascending
    )
}
