Calculation_Drivers_On_User_Input as "Calculation Drivers On User Input"
{
    type = form
    form = Pricing_Options
    record event = on add or edit

    on user input of Margin_Percent
    {
        actions
        {
            custom deluge script
            (
                input.Calculation_Status = "Draft";
                input.Calculation_Message = "Calculation will refresh after save.";
                input.Quoted_Price_MT = null;
                input.Calculated_On = null;
            )
        }
    }
}
