Pricing_Options_Product_On_User_Input as "Pricing Options Product On User Input"
{
    type = form
    form = Pricing_Options
    record event = on add or edit

    on user input of Product
    {
        actions
        {
            custom deluge script
            (
                if(input.Product != null)
                {
                    prodRec = Product_Catalog[ID == input.Product];
                    if(prodRec.count() > 0)
                    {
                        input.Vendor = prodRec.Default_Vendor;
                        input.Duty_AUD_MT = prodRec.Default_Duty_AUD_MT;
                        input.Buy_Currency = prodRec.Default_Currency;
                    }
                }
            )
        }
    }
}
