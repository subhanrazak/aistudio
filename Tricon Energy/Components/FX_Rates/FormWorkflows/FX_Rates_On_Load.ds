FX_Rates_On_Load as "FX Rates On Load"
{
    type = form
    form = FX_Rates
    record event = on add

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Rate_Date == null)
                {
                    input.Rate_Date = zoho.currentdate;
                }
                if(input.Is_Approved == null)
                {
                    input.Is_Approved = true;
                }
            )
        }
    }
}
