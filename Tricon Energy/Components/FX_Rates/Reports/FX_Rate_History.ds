default list FX_Rate_History
{
    displayName = "FX Rate History"
    show all rows from FX_Rates
    (
        Rate_Date
        From_Currency
        To_Currency
        Exchange_Rate
        Rate_Description
        Source_Name
        Is_Approved
    )
    filters
    (
        Rate_Date
        From_Currency
        To_Currency
        Is_Approved
    )
    sort by
    (
        Rate_Date descending
    )
}
