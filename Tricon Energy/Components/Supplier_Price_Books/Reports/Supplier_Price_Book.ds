default list Supplier_Price_Book
{
    displayName = "Supplier Price Book"
    show all rows from Supplier_Price_Books
    (
        Price_Book_Code
        Price_Status
        Product
        Vendor
        Arrival_Port
        Packaging
        Container_Size
        Buy_Price_CIF_Curr_MT
        Currency
        Effective_From
        Effective_To
    )
    filters
    (
        Price_Status
        Product
        Vendor
        Arrival_Port
        Packaging
        Currency
    )
    sort by
    (
        Effective_From descending
    )
}
