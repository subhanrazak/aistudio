list Active_Supplier_Prices
{
    displayName = "Active Supplier Prices"
    show all rows from Supplier_Price_Books [Price_Status == "Active"]
    (
        Price_Book_Code
        Price_Status
        Product
        Vendor
        Arrival_Port
        Packaging
        Container_Size
        Buy_Price_CIF_Curr_MT
        Currency
        Effective_From
        Effective_To
    )
    filters
    (
        Price_Status
        Product
        Vendor
        Arrival_Port
        Packaging
        Currency
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Product ascending
        Vendor ascending
    )
    sort by
    (
        Effective_From descending
    )
}
