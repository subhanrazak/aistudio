Product_Catalog_On_Validate as "Product Catalog On Validate"
{
    type = form
    form = Product_Catalog
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Default_Currency != null && input.Default_Currency != "" && input.Default_Currency != "USD" && input.Default_Currency != "EUR")
                {
                    alert "Default Currency must be USD or EUR.";
                    cancel submit;
                }
                if(input.Default_Duty_AUD_MT != null && input.Default_Duty_AUD_MT < 0)
                {
                    alert "Default Duty cannot be negative.";
                    cancel submit;
                }
            )
        }
    }
}
