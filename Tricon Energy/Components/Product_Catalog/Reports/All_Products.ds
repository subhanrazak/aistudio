default list All_Products
{
    displayName = "All Products"
    show all rows from Product_Catalog
    (
        Product_Code
        Product_Name
        Trade_Name
        Product_Status
        Application_Category
        Resin_Subcategory
        Book_Name
        Default_Vendor
        Default_Currency
    )
    filters
    (
        Product_Status
        Application_Category
        Resin_Subcategory
        Book_Name
    )
    sort by
    (
        Product_Code ascending
    )
}
