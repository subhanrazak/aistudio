list Active_Products
{
    displayName = "Active Products"
    show all rows from Product_Catalog [Product_Status == "Active"]
    (
        Product_Code
        Product_Name
        Trade_Name
        Product_Status
        Application_Category
        Resin_Subcategory
        Book_Name
        Default_Vendor
        Default_Currency
    )
    filters
    (
        Product_Status
        Application_Category
        Resin_Subcategory
        Book_Name
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Application_Category ascending
        Resin_Subcategory ascending
    )
    sort by
    (
        Product_Code ascending
    )
}
