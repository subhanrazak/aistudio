default list Active_Agreements
{
    displayName = "Active Agreements"
    show all rows from Customer_Commercial_Agreements [Agreement_Status == "Active"]
    (
        Agreement_Code
        Customer
        Branch
        Agreement_Status
        Preferred_Quote_Currency
        Payment_Terms
        Default_Margin_Percent
        Default_Validity_Days
        Preferred_Packaging
        Preferred_Container_Size
        Default_Delivery_Model
        Effective_From
        Effective_To
    )
    filters
    (
        Customer
        Branch
        Preferred_Quote_Currency
        Agreement_Status
    )
    sort by
    (
        Customer ascending
    )
}
