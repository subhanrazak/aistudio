list Tier_Profile_By_Category
{
    displayName = "Tier Profile By Category"
    show all rows from Customer_Product_Profiles
    (
        Profile_Code
        Customer
        Product
        Application_Category
        Resin_Subcategory
        Monthly_Consumption_Tons
        Calculated_Tier
        Tier_Rule_Used
        Effective_From
        Effective_To
    )
    filters
    (
        Customer
        Application_Category
        Resin_Subcategory
        Calculated_Tier
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Application_Category ascending
        Calculated_Tier ascending
    )
    sort by
    (
        Customer ascending
    )
}
