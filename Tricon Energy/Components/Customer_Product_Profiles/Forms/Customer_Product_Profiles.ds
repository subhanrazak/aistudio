form Customer_Product_Profiles
{
    displayname = "Customer Product Profiles"
    Customer_Product_Profile
    (
        type = section
        displayname = "Customer Product Profile"
        row = 1
        column = 0
    )
    must have unique Profile_Code
    (
        type = text
        displayname = "Profile Code"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Product
    (
        type = picklist
        displayname = "Product"
        values = Product_Catalog.ID
        displayformat = [Product_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Application_Category
    (
        type = picklist
        displayname = "Application Category"
        values = {"Film","Pipe & Fittings","Blow Moulding","Roto Moulding","Injection Moulding","Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Resin_Subcategory
    (
        type = picklist
        displayname = "Resin Subcategory"
        values = {"PE","PVC","PP","Other"}
        row = 1
        column = 1
        width = medium
    )
    must have Monthly_Consumption_Tons
    (
        type = decimal
        displayname = "Monthly Consumption Tons"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Calculated_Tier
    (
        type = picklist
        displayname = "Calculated Tier"
        values = {"Tier A","Tier B","Tier C","Unassigned"}
        initial value = "Unassigned"
        row = 1
        column = 1
        width = medium
    )
    Tier_Rule_Used
    (
        type = picklist
        displayname = "Tier Rule Used"
        values = Customer_Tier_Rules.ID
        displayformat = [Rule_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Effective_From
    (
        type = date
        displayname = "Effective From"
        row = 1
        column = 1
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
