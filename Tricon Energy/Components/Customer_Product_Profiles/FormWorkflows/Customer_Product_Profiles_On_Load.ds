Customer_Product_Profiles_On_Load as "Customer Product Profiles On Load"
{
    type = form
    form = Customer_Product_Profiles
    record event = on add

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Effective_From == null)
                {
                    input.Effective_From = zoho.currentdate;
                }
                if(input.Calculated_Tier == null || input.Calculated_Tier == "")
                {
                    input.Calculated_Tier = "Unassigned";
                }
            )
        }
    }
}
