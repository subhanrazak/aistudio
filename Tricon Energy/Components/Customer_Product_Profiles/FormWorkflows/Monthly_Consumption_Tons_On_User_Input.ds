Monthly_Consumption_Tons_On_User_Input as "Monthly Consumption Tons On User Input"
{
    type = form
    form = Customer_Product_Profiles
    record event = on add or edit

    on user input of Monthly_Consumption_Tons
    {
        actions
        {
            custom deluge script
            (
                input.Calculated_Tier = "Unassigned";
                input.Tier_Rule_Used = null;
                if(input.Monthly_Consumption_Tons != null && input.Application_Category != null && input.Resin_Subcategory != null)
                {
                    rules = Customer_Tier_Rules[Rule_Status == "Active" && Application_Category == input.Application_Category && Resin_Subcategory == input.Resin_Subcategory && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)] sort by Minimum_Monthly_Tons desc;
                    for each ruleRec in rules
                    {
                        minOk = (ruleRec.Minimum_Monthly_Tons == null || input.Monthly_Consumption_Tons >= ruleRec.Minimum_Monthly_Tons);
                        maxOk = (ruleRec.Maximum_Monthly_Tons == null || input.Monthly_Consumption_Tons < ruleRec.Maximum_Monthly_Tons);
                        if(minOk && maxOk)
                        {
                            input.Calculated_Tier = ruleRec.Tier;
                            input.Tier_Rule_Used = ruleRec.ID;
                            break;
                        }
                    }
                    if(input.Calculated_Tier == "Unassigned")
                    {
                        alert "No active tier rule matched this consumption profile.";
                    }
                }
            )
        }
    }
}
