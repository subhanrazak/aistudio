default list Generated_Quotes
{
    displayName = "Generated Quotes"
    show all rows from Quote_Documents
    (
        Quote_Number
        Pricing_Request
        Customer
        Quote_Date
        Valid_Until
        Quote_Status
        Quote_Currency
        Payment_Terms
        Total_Options
        Quote_Detail_Link
        Generated_By
        Generated_On
    )
    filters
    (
        Customer
        Quote_Status
        Quote_Currency
        Quote_Date
    )
    sort by
    (
        Quote_Date descending
    )
}
