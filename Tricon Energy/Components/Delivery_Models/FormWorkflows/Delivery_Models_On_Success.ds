Delivery_Models_On_Success as "Delivery Models On Success"
{
    type = form
    form = Delivery_Models
    record event = on add or edit

    on success
    {
        actions
        {
            custom deluge script
            (
                insert into Audit_Logs
                [
                    Added_User = zoho.loginuser
                    Module_Name = "Delivery_Models"
                    Record_Display = input.Delivery_Model_Name
                    Record_ID_Text = input.ID.toString()
                    Action_Type = "Updated"
                    Changed_By = zoho.loginuser
                    Summary = "Delivery model " + input.Delivery_Model_Code + " - " + input.Delivery_Model_Name + " saved for " + input.Incoterm + "."
                    Severity = "Info"
                ];
            )
        }
    }
}
