Delivery_Models_On_Validate as "Delivery Models On Validate"
{
    type = form
    form = Delivery_Models
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Delivery_Status == "Active" && (input.Default_Terms_Text == null || input.Default_Terms_Text == ""))
                {
                    alert "Default Terms Text is required for active delivery models.";
                    cancel submit;
                }
            )
        }
    }
}
