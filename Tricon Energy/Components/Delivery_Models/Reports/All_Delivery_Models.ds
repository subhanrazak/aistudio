default list All_Delivery_Models
{
    displayName = "All Delivery Models"
    show all rows from Delivery_Models
    (
        Delivery_Model_Code
        Delivery_Model_Name
        Delivery_Status
        Incoterm
        Agreement_Type
        Include_Warehouse_Costs
        Include_Delivery_Costs
        Include_Storage_Costs
        Include_Repacking_Costs
    )
    filters
    (
        Delivery_Status
        Incoterm
        Agreement_Type
    )
    sort by
    (
        Delivery_Model_Name ascending
    )
}
