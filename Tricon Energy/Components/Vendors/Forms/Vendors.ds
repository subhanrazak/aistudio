form Vendors
{
    displayname = "Vendors"
    Vendor_Details
    (
        type = section
        displayname = "Vendor Details"
        row = 1
        column = 0
    )
    must have unique Vendor_Code
    (
        type = text
        displayname = "Vendor Code"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    must have Vendor_Name
    (
        type = text
        displayname = "Vendor Name"
        maxchar = 255
        row = 1
        column = 2
        width = medium
    )
    must have Vendor_Status
    (
        type = picklist
        displayname = "Vendor Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Country
    (
        type = text
        displayname = "Country"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Default_Currency
    (
        type = picklist
        displayname = "Default Currency"
        values = {"USD","EUR"}
        initial value = "USD"
        row = 1
        column = 1
        width = medium
    )
    Contact_Name
    (
        type = text
        displayname = "Contact Name"
        maxchar = 120
        row = 1
        column = 2
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
