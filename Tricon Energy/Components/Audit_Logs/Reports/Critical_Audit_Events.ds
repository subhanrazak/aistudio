list Critical_Audit_Events
{
    displayName = "Critical Audit Events"
    show all rows from Audit_Logs [Severity == "Critical"]
    (
        Audit_Number
        Audit_DateTime
        Module_Name
        Record_Display
        Action_Type
        Changed_By
        Summary
        Related_Customer
        Related_Request
        Severity
    )
    filters
    (
        Audit_DateTime
        Module_Name
        Action_Type
        Changed_By
        Severity
        Related_Customer
        Related_Request
    )
    sort by
    (
        Audit_DateTime descending
    )
}
