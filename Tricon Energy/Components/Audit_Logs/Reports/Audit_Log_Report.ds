default list Audit_Log_Report
{
    displayName = "Audit Log Report"
    show all rows from Audit_Logs
    (
        Audit_Number
        Audit_DateTime
        Module_Name
        Record_Display
        Action_Type
        Changed_By
        Summary
        Related_Customer
        Related_Request
        Severity
    )
    filters
    (
        Audit_DateTime
        Module_Name
        Action_Type
        Changed_By
        Severity
        Related_Customer
        Related_Request
    )
    sort by
    (
        Audit_DateTime descending
    )
}
