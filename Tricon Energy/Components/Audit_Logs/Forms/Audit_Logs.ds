form Audit_Logs
{
    displayname = "Audit Logs"
    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    Audit_Number
    (
        type = autonumber
        displayname = "Audit Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Audit_DateTime
    (
        type = datetime
        displayname = "Audit DateTime"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )
    must have Module_Name
    (
        type = text
        displayname = "Module Name"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    Record_Display
    (
        type = text
        displayname = "Record Display"
        maxchar = 255
        row = 1
        column = 2
        width = medium
    )
    Record_ID_Text
    (
        type = text
        displayname = "Record ID"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    must have Action_Type
    (
        type = picklist
        displayname = "Action Type"
        values = {"Created","Updated","Calculated","Submitted","Approved","Rejected","Generated Quote","Sent","Cancelled","Expired","Validation"}
        row = 1
        column = 2
        width = medium
    )
    Changed_By
    (
        type = email
        displayname = "Changed By"
        row = 1
        column = 1
        width = medium
    )
    must have Summary
    (
        type = textarea
        displayname = "Summary"
        row = 1
        column = 2
        width = medium
    )
    Before_Value
    (
        type = textarea
        displayname = "Before Value"
        row = 1
        column = 1
        width = medium
    )
    After_Value
    (
        type = textarea
        displayname = "After Value"
        row = 1
        column = 2
        width = medium
    )
    Related_Customer
    (
        type = picklist
        displayname = "Related Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Related_Request
    (
        type = picklist
        displayname = "Related Request"
        values = Pricing_Requests.ID
        displayformat = [Request_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Severity
    (
        type = picklist
        displayname = "Severity"
        values = {"Info","Warning","Critical"}
        initial value = "Info"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
