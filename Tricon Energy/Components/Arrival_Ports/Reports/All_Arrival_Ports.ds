default list All_Arrival_Ports
{
    displayName = "All Arrival Ports"
    show all rows from Arrival_Ports
    (
        Port_Code
        Port_Name
        Port_Status
        Country
        State
        City
    )
    filters
    (
        Port_Status
        Country
        State
    )
    sort by
    (
        Port_Name ascending
    )
}
