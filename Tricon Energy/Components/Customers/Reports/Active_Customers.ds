list Active_Customers
{
    displayName = "Active Customers"
    show all rows from Customers [Customer_Status == "Active"]
    (
        Customer_Code
        Customer_Name
        Customer_Status
        Customer_Type
        Default_Tier
        Primary_Country
        Primary_City
        Primary_Suburb
        Preferred_Quote_Currency
        Default_Payment_Terms
    )
    filters
    (
        Customer_Status
        Default_Tier
        Preferred_Quote_Currency
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Default_Tier ascending
    )
    sort by
    (
        Customer_Name ascending
    )
}
