list My_Response_Worklist
{
    displayName = "My Response Worklist"
    show all rows from Assessment_Responses
    (
        Assessment
        Customer
        Project
        Section_Category_Snapshot
        Display_Order
        Question_Text_Snapshot
        Submitted_Response
        Response_Status
    )
    filters
    (
        Assessment
        Customer
        Project
        Response_Status
    )
    sort by
    (
        Assessment ascending
        Display_Order ascending
    )
}
