list Needs_Review_Responses
{
    displayName = "Needs Review Responses"
    show all rows from Assessment_Responses[Response_Status == "Needs Review"]
    (
        Assessment
        Customer
        Project
        Section_Category_Snapshot
        Display_Order
        Question_Text_Snapshot
        Submitted_Response
        Response_Notes
    )
    filters
    (
        Assessment
        Customer
        Project
    )
    sort by
    (
        Assessment ascending
        Display_Order ascending
    )
}
