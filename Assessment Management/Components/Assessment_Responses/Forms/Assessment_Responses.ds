form Assessment_Responses
{
    displayname = "Assessment Responses"
    Assessment_Link
    (
        type = section
        displayname = "Assessment Link"
        row = 1
        column = 0
    )
    must have Assessment
    (
        displayname = "Assessment"
        type = picklist
        values = Assessments.ID
        displayformat = [Assessment_Reference_Number]
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        displayname = "Customer"
        type = picklist
        values = Customers.ID
        displayformat = [Customer_Name]
        row = 1
        column = 1
        width = medium
    )
    must have Project
    (
        displayname = "Project"
        type = picklist
        values = Projects.ID
        displayformat = [Project_Name]
        row = 1
        column = 1
        width = medium
    )
    must have Industry_Type
    (
        displayname = "Industry Type"
        type = picklist
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        row = 1
        column = 1
        width = medium
    )
    Master_Question
    (
        displayname = "Question Reference"
        type = picklist
        values = Master_Questionnaire.ID
        displayformat = [Question_Text]
        row = 1
        column = 1
        width = medium
    )
    Question_Snapshot
    (
        type = section
        displayname = "Question Snapshot"
        row = 2
        column = 1
        visibility = true
    )
    must have Section_Category_Snapshot
    (
        displayname = "Section / Category Snapshot"
        type = text
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    must have Question_Text_Snapshot
    (
        displayname = "Question Text Snapshot"
        type = textarea
        row = 2
        column = 1
        width = medium
    )
    must have Question_Type_Snapshot
    (
        displayname = "Question Type Snapshot"
        type = picklist
        values = {"Short Text", "Long Text", "Yes / No", "Single Choice", "Multiple Choice", "Rating", "Number", "Date"}
        row = 2
        column = 1
        width = medium
    )
    Answer_Options_Snapshot
    (
        displayname = "Answer Options Snapshot"
        type = textarea
        row = 2
        column = 1
        width = medium
    )
    Help_Text_Snapshot
    (
        displayname = "Help Text Snapshot"
        type = textarea
        row = 2
        column = 1
        width = medium
    )
    Display_Order
    (
        displayname = "Display Order"
        type = number
        row = 2
        column = 1
        width = medium
    )
    Mandatory
    (
        displayname = "Mandatory Snapshot"
        type = checkbox
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Is_Scored
    (
        displayname = "Is Scored Snapshot"
        type = checkbox
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Weightage
    (
        displayname = "Weightage Snapshot"
        type = decimal
        decimalplace = 2
        initial value = 1
        row = 2
        column = 1
        width = medium
    )
    Max_Score
    (
        displayname = "Max Score Snapshot"
        type = decimal
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Question_Version_Number
    (
        displayname = "Question Version Number"
        type = number
        row = 2
        column = 1
        width = medium
    )
    Response
    (
        type = section
        displayname = "Response"
        row = 3
        column = 1
        visibility = true
    )
    Submitted_Response
    (
        displayname = "Submitted Response"
        type = textarea
        row = 3
        column = 1
        width = medium
    )
    Response_Notes
    (
        displayname = "Response Notes / Comments"
        type = textarea
        row = 3
        column = 1
        width = medium
    )
    Score
    (
        displayname = "Score"
        type = decimal
        decimalplace = 2
        initial value = 0
        row = 3
        column = 1
        width = medium
    )
    Weighted_Score
    (
        displayname = "Weighted Score"
        type = decimal
        decimalplace = 2
        initial value = 0
        row = 3
        column = 1
        width = medium
    )
    must have Response_Status
    (
        displayname = "Response Status"
        type = picklist
        values = {"Not Started", "In Progress", "Answered", "Needs Review"}
        initial value = "Not Started"
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}