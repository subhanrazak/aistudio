form Projects
{
    displayname = "Projects"
    Project_Information
    (
        type = section
        displayname = "Project Information"
        row = 1
        column = 0
    )
    must have Project_Name
    (
        type = text
        displayname = "Project Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_Consultant_Email
    (
        type = email
        displayname = "Assigned Consultant Email"
        row = 1
        column = 2
        width = medium
    )
    must have Project_Stage
    (
        type = picklist
        displayname = "Project Stage"
        values = {"Discovery", "Assessment In Progress", "Assessment Submitted", "Report Generated", "Review", "Reassessment Required", "Completed"}
        initial value = "Discovery"
        row = 1
        column = 1
        width = medium
    )
    Start_Date
    (
        type = date
        displayname = "Start Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Target_Completion_Date
    (
        type = date
        displayname = "Target Completion Date"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "On Hold", "Completed", "Cancelled"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
