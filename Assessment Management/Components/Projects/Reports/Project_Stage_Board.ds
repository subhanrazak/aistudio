kanban Project_Stage_Board
{
    displayName = "Project Stage Board"
    show all rows from Projects
    (
        Project_Name
        Customer
        Assigned_Consultant_Email
        Project_Stage
        Target_Completion_Date
        Status
    )
    filters
    (
        Assigned_Consultant_Email
        Status
    )
    sort by
    (
        Target_Completion_Date ascending
    )
    options
    (
        display field = Project_Stage
        emptycolumn = "No Stage"
        othercolumn = "Other"
        filter type = manual
        sort order = ascending
        record count = enable
    )
}
