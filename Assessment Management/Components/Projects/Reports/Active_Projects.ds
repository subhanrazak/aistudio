list Active_Projects
{
    displayName = "Active Projects"
    show all rows from Projects [Status == "Active"]
    (
        Project_Name
        Customer
        Industry_Type
        Assigned_Consultant_Email
        Project_Stage
        Start_Date
        Target_Completion_Date
    )
    filters
    (
        Customer
        Industry_Type
        Project_Stage
    )
    sort by
    (
        Target_Completion_Date ascending
    )
}
