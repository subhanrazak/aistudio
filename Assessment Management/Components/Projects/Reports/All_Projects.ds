default list All_Projects
{
    displayName = "All Projects"
    show all rows from Projects
    (
        Project_Name
        Customer
        Industry_Type
        Assigned_Consultant_Email
        Project_Stage
        Start_Date
        Target_Completion_Date
        Status
    )
    filters
    (
        Customer
        Industry_Type
        Assigned_Consultant_Email
        Project_Stage
        Status
    )
    sort by
    (
        Start_Date descending
    )
}
