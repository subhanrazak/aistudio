list My_Projects
{
    displayName = "My Projects"
    show all rows from Projects [Assigned_Consultant_Email == zoho.loginuser]
    (
        Project_Name
        Customer
        Industry_Type
        Project_Stage
        Start_Date
        Target_Completion_Date
        Status
    )
    filters
    (
        Project_Stage
        Status
    )
    sort by
    (
        Start_Date descending
    )
}
