Customer_On_User_Input as "Projects - Populate Customer Details"
{
    type = form
    form = Projects
    record event = on add or edit

    on user input of Customer
    {
        actions
        {
            custom deluge script
            (
                if (input.Customer != null)
                {
                    customerRec = Customers[ID == input.Customer];
                    if (customerRec.count() > 0)
                    {
                        input.Industry_Type = customerRec.Industry_Type;
                        input.Assigned_Consultant_Email = customerRec.Assigned_Consultant_Email;
                    }
                }
            )
        }
    }
}
