form Scoring_Maturity_Config
{
    displayname = "Scoring / Maturity Configuration"
    Score_Range
    (
        type = section
        displayname = "Score Range"
        row = 1
        column = 0
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Section_Category
    (
        type = text
        displayname = "Section / Category"
        description [ type = tooltip  message = "Leave blank for the overall/default score range for the selected industry." ]
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Minimum_Score_Percentage
    (
        type = decimal
        displayname = "Minimum Score Percentage"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    must have Maximum_Score_Percentage
    (
        type = decimal
        displayname = "Maximum Score Percentage"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    must have Maturity_Level
    (
        type = picklist
        displayname = "Maturity Level"
        values = {"Initial", "Developing", "Defined", "Managed", "Optimized"}
        row = 1
        column = 1
        width = medium
    )
    must have Risk_Level
    (
        type = picklist
        displayname = "Risk Level"
        values = {"High Risk", "Medium-High Risk", "Medium Risk", "Low-Medium Risk", "Low Risk"}
        row = 1
        column = 2
        width = medium
    )
    Recommendation_Text
    (
        type = textarea
        displayname = "Recommendation Text"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
