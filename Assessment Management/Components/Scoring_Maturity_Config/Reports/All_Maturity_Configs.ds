default list All_Maturity_Configs
{
    displayName = "All Maturity Configurations"
    show all rows from Scoring_Maturity_Config
    (
        Industry_Type
        Section_Category
        Minimum_Score_Percentage
        Maximum_Score_Percentage
        Maturity_Level
        Risk_Level
        Status
    )
    filters
    (
        Industry_Type
        Section_Category
        Maturity_Level
        Risk_Level
        Status
    )
    sort by
    (
        Industry_Type ascending
        Minimum_Score_Percentage ascending
    )
}
