list Active_Maturity_Configs
{
    displayName = "Active Maturity Configurations"
    show all rows from Scoring_Maturity_Config [Status == "Active"]
    (
        Industry_Type
        Section_Category
        Minimum_Score_Percentage
        Maximum_Score_Percentage
        Maturity_Level
        Risk_Level
        Recommendation_Text
    )
    filters
    (
        Industry_Type
        Section_Category
    )
    sort by
    (
        Industry_Type ascending
        Minimum_Score_Percentage ascending
    )
}
