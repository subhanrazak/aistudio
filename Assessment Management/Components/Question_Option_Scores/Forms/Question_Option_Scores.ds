form Question_Option_Scores
{
    displayname = "Question Option Scores"
    Option_Score
    (
        type = section
        displayname = "Option Score"
        row = 1
        column = 0
    )
    must have Question
    (
        type = picklist
        displayname = "Question"
        values = Master_Questionnaire.ID
        displayformat = [Question_Text]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Option_Label
    (
        type = text
        displayname = "Option Label"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Score_Value
    (
        type = decimal
        displayname = "Score Value"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    must have Display_Order
    (
        type = number
        displayname = "Display Order"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
