Question_On_User_Input as "Question Option Scores - Populate Question Context"
{
    type = form
    form = Question_Option_Scores
    record event = on add or edit

    on user input of Question
    {
        actions
        {
            custom deluge script
            (
                if (input.Question != null)
                {
                    questionRec = Master_Questionnaire[ID == input.Question];
                    if (questionRec.count() > 0)
                    {
                        input.Industry_Type = questionRec.Industry_Type;
                    }
                }
            )
        }
    }
}
