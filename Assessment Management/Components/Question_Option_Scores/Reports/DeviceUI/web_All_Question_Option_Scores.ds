report All_Question_Option_Scores
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Question
                    Industry_Type
                    Option_Label
                    Score_Value
                    Display_Order
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Question
                    Industry_Type
                    Option_Label
                    Score_Value
                    Display_Order
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
