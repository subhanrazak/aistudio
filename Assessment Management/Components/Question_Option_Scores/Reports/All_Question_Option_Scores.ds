default list All_Question_Option_Scores
{
    displayName = "All Question Option Scores"
    show all rows from Question_Option_Scores
    (
        Question
        Industry_Type
        Option_Label
        Score_Value
        Display_Order
        Status
    )
    filters
    (
        Industry_Type
        Question
        Status
    )
    sort by
    (
        Industry_Type ascending
        Question ascending
        Display_Order ascending
    )
}
