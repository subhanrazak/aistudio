list Active_Question_Option_Scores
{
    displayName = "Active Option Scores"
    show all rows from Question_Option_Scores [Status == "Active"]
    (
        Question
        Industry_Type
        Option_Label
        Score_Value
        Display_Order
    )
    filters
    (
        Industry_Type
        Question
    )
    sort by
    (
        Industry_Type ascending
        Question ascending
        Display_Order ascending
    )
}
