list Failed_Report_Emails
{
    displayName = "Failed Report Emails"
    show all rows from Report_Email_Log[Email_Status == "Failed"]
    (
        Assessment
        Project
        Customer
        Recipient_Email
        Sent_By_Email
        Sent_Date_Time
        Notes
    )
    filters
    (
        Customer
        Project
    )
    sort by
    (
        Sent_Date_Time descending
    )
}
