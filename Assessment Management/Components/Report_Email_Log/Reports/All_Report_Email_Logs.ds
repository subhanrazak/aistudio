default list All_Report_Email_Logs
{
    displayName = "All Report Email Logs"
    show all rows from Report_Email_Log
    (
        Assessment
        Project
        Customer
        Recipient_Email
        Sent_By_Email
        Sent_Date_Time
        Email_Subject
        Email_Status
        Related_Document
    )
    filters
    (
        Customer
        Project
        Recipient_Email
        Email_Status
    )
    sort by
    (
        Sent_Date_Time descending
    )
}
