list Sent_Report_Emails
{
    displayName = "Sent Report Emails"
    show all rows from Report_Email_Log[Email_Status == "Sent"]
    (
        Assessment
        Project
        Customer
        Recipient_Email
        Sent_By_Email
        Sent_Date_Time
        Related_Document
    )
    filters
    (
        Customer
        Project
        Recipient_Email
    )
    sort by
    (
        Sent_Date_Time descending
    )
}
