form Report_Email_Log
{
    displayname = "Report Email Log"
    Email_Details
    (
        type = section
        displayname = "Email Details"
        row = 1
        column = 0
    )
    must have Assessment
    (
        displayname = "Assessment"
        type = picklist
        values = Assessments.ID
        displayformat = [Assessment_Reference_Number]
        row = 1
        column = 1
        width = medium
    )
    must have Project
    (
        displayname = "Project"
        type = picklist
        values = Projects.ID
        displayformat = [Project_Name]
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        displayname = "Customer"
        type = picklist
        values = Customers.ID
        displayformat = [Customer_Name]
        row = 1
        column = 1
        width = medium
    )
    must have Recipient_Email
    (
        displayname = "Recipient Email"
        type = email
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Sent_By_Email
    (
        displayname = "Sent By Email"
        type = email
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Sent_Date_Time
    (
        displayname = "Sent Date Time"
        type = datetime
        row = 1
        column = 1
        width = medium
    )
    Email_Subject
    (
        displayname = "Email Subject"
        type = text
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    must have Email_Status
    (
        displayname = "Email Status"
        type = picklist
        values = {"Draft", "Sent", "Failed"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    Related_Document
    (
        displayname = "Related Document"
        type = picklist
        values = Project_Documents.ID
        displayformat = [Document_Name]
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        displayname = "Notes"
        type = textarea
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}