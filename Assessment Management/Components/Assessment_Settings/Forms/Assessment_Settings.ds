form Assessment_Settings
{
    displayname = "Assessment Settings"
    Validity_Settings
    (
        type = section
        displayname = "Validity Settings"
        row = 1
        column = 0
    )
    must have unique Setting_Name
    (
        type = text
        displayname = "Setting Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Default_Validity_Days
    (
        type = number
        displayname = "Default Validity Days"
        initial value = 180
        row = 1
        column = 2
        width = medium
    )
    must have Reminder_Every_Days
    (
        type = number
        displayname = "Reminder Every Days"
        initial value = 4
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
