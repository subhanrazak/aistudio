list Expired_Assessments
{
    displayName = "Expired Assessments"
    show all rows from Assessments [Assessment_Status == "Expired" || Assessment_Status == "Reassessment Required"]
    (
        Assessment_Reference_Number
        Customer
        Project
        Assigned_Consultant_Email
        Customer_Portal_Email
        Valid_Until_Date
        Assessment_Status
    )
    filters
    (
        Customer
        Project
        Assigned_Consultant_Email
        Assessment_Status
    )
    sort by
    (
        Valid_Until_Date ascending
    )
}
