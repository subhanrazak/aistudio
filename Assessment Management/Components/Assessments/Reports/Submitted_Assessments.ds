list Submitted_Assessments
{
    displayName = "Submitted Assessments"
    show all rows from Assessments [Assessment_Status == "Submitted" || Assessment_Status == "Report Generated"]
    (
        Assessment_Reference_Number
        Customer
        Project
        Assessment_Mode
        Submission_Date_Time
        Valid_Until_Date
        Overall_Score_Percentage
        Maturity_Level
        Risk_Level
    )
    filters
    (
        Customer
        Project
        Assessment_Mode
        Risk_Level
    )
    sort by
    (
        Submission_Date_Time descending
    )
}
