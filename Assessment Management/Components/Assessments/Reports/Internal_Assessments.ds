list Internal_Assessments
{
    displayName = "Internal Assessments"
    show all rows from Assessments [Assessment_Mode == "Internal"]
    (
        Assessment_Reference_Number
        Customer
        Project
        Assigned_Consultant_Email
        Assessment_Status
        Submission_Date_Time
        Valid_Until_Date
    )
    filters
    (
        Customer
        Project
        Assigned_Consultant_Email
        Assessment_Status
    )
    sort by
    (
        Submission_Date_Time descending
    )
}
