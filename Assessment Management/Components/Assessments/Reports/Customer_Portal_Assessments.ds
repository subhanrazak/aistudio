list Customer_Portal_Assessments
{
    displayName = "Customer Portal Assessments"
    show all rows from Assessments [Assessment_Mode == "Customer Portal"]
    (
        Assessment_Reference_Number
        Customer
        Project
        Customer_Portal_Email
        Assessment_Status
        Submission_Date_Time
        Valid_Until_Date
    )
    filters
    (
        Customer
        Project
        Customer_Portal_Email
        Assessment_Status
    )
    sort by
    (
        Submission_Date_Time descending
    )
}
