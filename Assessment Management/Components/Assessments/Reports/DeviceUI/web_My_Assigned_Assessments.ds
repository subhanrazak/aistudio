report My_Assigned_Assessments
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Assessment_Reference_Number
                    Customer
                    Project
                    Assessment_Mode
                    Assessment_Status
                    Submission_Date_Time
                    Valid_Until_Date
                    Overall_Score_Percentage
                    Maturity_Level
                    Risk_Level
                    "Generate Responses / Refresh Questions"
                    "Submit Assessment"
                    "Reopen for Reassessment"
                    "Email Report to Customer"
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Assessment_Reference_Number
                    Customer
                    Project
                    Assessment_Mode
                    Assessment_Status
                    Submission_Date_Time
                    Valid_Until_Date
                    Overall_Score_Percentage
                    Maturity_Level
                    Risk_Level
                    "Generate Responses / Refresh Questions"
                    "Submit Assessment"
                    "Reopen for Reassessment"
                    "Email Report to Customer"
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
