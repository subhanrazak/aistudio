list Expiring_Assessments
{
    displayName = "Expiring Assessments"
    show all rows from Assessments [Assessment_Status == "Expiring Soon"]
    (
        Assessment_Reference_Number
        Customer
        Project
        Assigned_Consultant_Email
        Customer_Portal_Email
        Submission_Date_Time
        Valid_Until_Date
        Last_Reminder_Sent_Date
    )
    filters
    (
        Customer
        Project
        Assigned_Consultant_Email
    )
    sort by
    (
        Valid_Until_Date ascending
    )
}
