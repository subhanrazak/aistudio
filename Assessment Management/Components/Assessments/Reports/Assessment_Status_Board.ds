kanban Assessment_Status_Board
{
    displayName = "Assessment Status Board"
    show all rows from Assessments
    (
        Assessment_Reference_Number
        Customer
        Project
        Industry_Type
        Assessment_Mode
        Assessment_Status
        Assigned_Consultant_Email
        Valid_Until_Date
        Risk_Level
    )
    filters
    (
        Industry_Type
        Assessment_Mode
        Assigned_Consultant_Email
        Risk_Level
    )
    sort by
    (
        Valid_Until_Date ascending
    )
    options
    (
        display field = Assessment_Status
        emptycolumn = "No Status"
        othercolumn = "Other"
        filter type = manual
        sort order = ascending
        record count = enable
    )
}
