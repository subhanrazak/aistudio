form Assessments
{
    displayname = "Assessments"
    Assessment_Details
    (
        type = section
        displayname = "Assessment Details"
        row = 1
        column = 0
    )
    Assessment_Reference_Number
    (
        type = autonumber
        displayname = "Assessment Reference Number"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Project
    (
        type = picklist
        displayname = "Project"
        values = Projects.ID
        displayformat = [Project_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Assessment_Mode
    (
        type = picklist
        displayname = "Assessment Mode"
        values = {"Internal", "Customer Portal"}
        row = 1
        column = 1
        width = medium
    )
    must have Assessment_Status
    (
        type = picklist
        displayname = "Assessment Status"
        values = {"Draft", "In Progress", "Submitted", "Report Generated", "Expiring Soon", "Expired", "Reassessment Required", "Reopened for Reassessment"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    must have Assigned_Consultant_Email
    (
        type = email
        displayname = "Assigned Consultant Email"
        row = 1
        column = 1
        width = medium
    )
    Customer_Portal_Email
    (
        type = email
        displayname = "Customer Portal Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Submission_Metadata
    (
        type = section
        displayname = "Submission Metadata"
        visibility = true
        row = 2
        column = 1
    )
    Completed_By_Name
    (
        type = text
        displayname = "Completed By Name"
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    Completed_By_Email
    (
        type = email
        displayname = "Completed By Email"
        personal data = true
        row = 2
        column = 2
        width = medium
    )
    Submission_Date_Time
    (
        type = datetime
        displayname = "Submission Date and Time"
        row = 2
        column = 1
        width = medium
    )
    must have Validity_Period_Days
    (
        type = number
        displayname = "Validity Period Days"
        initial value = 180
        row = 2
        column = 2
        width = medium
    )
    Valid_Until_Date
    (
        type = date
        displayname = "Valid Until Date"
        row = 2
        column = 1
        width = medium
    )
    Last_Reminder_Sent_Date
    (
        type = date
        displayname = "Last Reminder Sent Date"
        row = 2
        column = 2
        width = medium
    )
    Scoring_and_Report
    (
        type = section
        displayname = "Scoring and Report"
        visibility = true
        row = 3
        column = 1
    )
    Overall_Score
    (
        type = decimal
        displayname = "Overall Score"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Overall_Score_Percentage
    (
        type = decimal
        displayname = "Overall Score Percentage"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Maturity_Level
    (
        type = text
        displayname = "Maturity Level"
        maxchar = 100
        row = 3
        column = 1
        width = medium
    )
    Risk_Level
    (
        type = text
        displayname = "Risk Level"
        maxchar = 100
        row = 3
        column = 2
        width = medium
    )
    Report_Version_Number
    (
        type = number
        displayname = "Report Version Number"
        initial value = 1
        row = 3
        column = 1
        width = medium
    )
    Generated_PDF_Report
    (
        type = upload file
        displayname = "Generated PDF Report"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 2
        width = medium
    )
    Report_Document_Link
    (
        type = url
        displayname = "Report Document Link"
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
