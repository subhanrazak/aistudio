Question_Type_On_User_Input as "Master Questionnaire - Question Type Behavior"
{
    type = form
    form = Master_Questionnaire
    record event = on add or edit

    on user input of Question_Type
    {
        actions
        {
            custom deluge script
            (
                if (input.Question_Type in {"Yes / No", "Single Choice", "Multiple Choice", "Rating"})
                {
                    show Answer_Options;
                    enable Answer_Options;
                }
                else
                {
                    input.Answer_Options = "";
                    hide Answer_Options;
                    disable Answer_Options;
                }
            )
        }
    }
}
