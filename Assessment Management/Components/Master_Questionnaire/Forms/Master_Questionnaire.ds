form Master_Questionnaire
{
    displayname = "Master Questionnaire"
    Question_Setup
    (
        type = section
        displayname = "Question Setup"
        row = 1
        column = 0
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Section_Category
    (
        type = text
        displayname = "Section / Category"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Question_Text
    (
        type = textarea
        displayname = "Question Text"
        row = 1
        column = 1
        width = medium
    )
    must have Question_Type
    (
        type = picklist
        displayname = "Question Type"
        values = {"Short Text", "Long Text", "Yes / No", "Single Choice", "Multiple Choice", "Rating", "Number", "Date"}
        row = 1
        column = 2
        width = medium
    )
    Answer_Options
    (
        type = textarea
        displayname = "Answer Options"
        description [ type = tooltip  message = "Enter one option per line for Yes/No, Single Choice, Multiple Choice, or Rating questions." ]
        row = 1
        column = 1
        width = medium
    )
    Help_Text
    (
        type = textarea
        displayname = "Help Text / Guidance Notes"
        row = 1
        column = 2
        width = medium
    )
    must have Display_Order
    (
        type = number
        displayname = "Display Order"
        row = 1
        column = 1
        width = medium
    )
    Mandatory
    (
        type = checkbox
        displayname = "Mandatory"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Scoring_and_Versioning
    (
        type = section
        displayname = "Scoring and Versioning"
        visibility = true
        row = 2
        column = 1
    )
    Is_Scored
    (
        type = checkbox
        displayname = "Is Scored"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Weightage
    (
        type = decimal
        displayname = "Weightage"
        decimalplace = 2
        initial value = 1
        row = 2
        column = 2
        width = medium
    )
    Max_Score
    (
        type = decimal
        displayname = "Max Score"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    must have Version_Number
    (
        type = number
        displayname = "Version Number"
        initial value = 1
        row = 2
        column = 2
        width = medium
    )
    Last_Updated_Date
    (
        type = datetime
        displayname = "Last Updated Date"
        row = 2
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
