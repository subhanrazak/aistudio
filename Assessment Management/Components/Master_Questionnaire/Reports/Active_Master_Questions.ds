list Active_Master_Questions
{
    displayName = "Active Master Questions"
    show all rows from Master_Questionnaire [Status == "Active"]
    (
        Industry_Type
        Section_Category
        Display_Order
        Question_Text
        Question_Type
        Mandatory
        Is_Scored
        Weightage
    )
    filters
    (
        Industry_Type
        Section_Category
        Question_Type
        Is_Scored
    )
    sort by
    (
        Industry_Type ascending
        Section_Category ascending
        Display_Order ascending
    )
}
