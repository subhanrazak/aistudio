list Scored_Questions
{
    displayName = "Scored Questions"
    show all rows from Master_Questionnaire [Is_Scored == true]
    (
        Industry_Type
        Section_Category
        Display_Order
        Question_Text
        Question_Type
        Weightage
        Max_Score
        Status
    )
    filters
    (
        Industry_Type
        Section_Category
        Status
    )
    sort by
    (
        Industry_Type ascending
        Section_Category ascending
        Display_Order ascending
    )
}
