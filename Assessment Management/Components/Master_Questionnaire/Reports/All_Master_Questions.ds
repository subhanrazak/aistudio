default list All_Master_Questions
{
    displayName = "All Master Questions"
    show all rows from Master_Questionnaire
    (
        Industry_Type
        Section_Category
        Display_Order
        Question_Text
        Question_Type
        Mandatory
        Is_Scored
        Weightage
        Version_Number
        Status
    )
    filters
    (
        Industry_Type
        Section_Category
        Question_Type
        Is_Scored
        Status
    )
    sort by
    (
        Industry_Type ascending
        Section_Category ascending
        Display_Order ascending
    )
}
