report Active_Master_Questions
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Industry_Type
                    Section_Category
                    Display_Order
                    Question_Text
                    Question_Type
                    Mandatory
                    Is_Scored
                    Weightage
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Industry_Type
                    Section_Category
                    Display_Order
                    Question_Text
                    Question_Type
                    Mandatory
                    Is_Scored
                    Weightage
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
