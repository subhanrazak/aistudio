default list All_Activity_Log
{
    displayName = "All Activity Log"
    show all rows from Activity_Log
    (
        Activity_Date_Time
        Actor_Email
        Activity_Type
        Customer
        Project
        Assessment
        Message
    )
    filters
    (
        Activity_Type
        Customer
        Project
        Assessment
        Actor_Email
    )
    sort by
    (
        Activity_Date_Time descending
    )
}
