list Recent_Project_Activity
{
    displayName = "Recent Project Activity"
    show all rows from Activity_Log
    (
        Activity_Date_Time
        Activity_Type
        Customer
        Project
        Assessment
        Actor_Email
        Message
    )
    filters
    (
        Project
        Customer
        Activity_Type
    )
    sort by
    (
        Activity_Date_Time descending
    )
}
