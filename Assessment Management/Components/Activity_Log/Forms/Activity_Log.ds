form Activity_Log
{
    displayname = "Activity Log"
    Activity
    (
        type = section
        displayname = "Activity"
        row = 1
        column = 0
    )
    must have Activity_Date_Time
    (
        displayname = "Activity Date Time"
        type = datetime
        initial value = "${zoho.currenttime}"
        row = 1
        column = 1
        width = medium
    )
    Actor_Email
    (
        displayname = "Actor Email"
        type = email
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Activity_Type
    (
        displayname = "Activity Type"
        type = picklist
        values = {"Customer Created", "Project Updated", "Assessment Created", "Responses Generated", "Assessment Submitted", "Report Generated", "Report Emailed", "Reminder Sent", "Assessment Expired", "Reassessment Reopened", "Document Added", "Other"}
        row = 1
        column = 1
        width = medium
    )
    Customer
    (
        displayname = "Customer"
        type = picklist
        values = Customers.ID
        displayformat = [Customer_Name]
        row = 1
        column = 1
        width = medium
    )
    Project
    (
        displayname = "Project"
        type = picklist
        values = Projects.ID
        displayformat = [Project_Name]
        row = 1
        column = 1
        width = medium
    )
    Assessment
    (
        displayname = "Assessment"
        type = picklist
        values = Assessments.ID
        displayformat = [Assessment_Reference_Number]
        row = 1
        column = 1
        width = medium
    )
    Message
    (
        displayname = "Message"
        type = textarea
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}