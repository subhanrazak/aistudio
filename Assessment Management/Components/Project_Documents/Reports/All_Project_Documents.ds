default list All_Project_Documents
{
    displayName = "All Project Documents"
    show all rows from Project_Documents
    (
        Project
        Customer
        Document_Name
        Document_Type
        Uploaded_File
        Document_Link
        Related_Assessment
        Uploaded_By_Email
        Uploaded_Date
        Email_Sent
        Last_Emailed_Date
    )
    filters
    (
        Project
        Customer
        Document_Type
        Email_Sent
    )
    sort by
    (
        Uploaded_Date descending
    )
}
