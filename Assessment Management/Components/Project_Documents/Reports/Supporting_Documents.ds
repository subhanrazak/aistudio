list Supporting_Documents
{
    displayName = "Supporting Documents"
    show all rows from Project_Documents [Document_Type != "Assessment Report"]
    (
        Project
        Customer
        Document_Name
        Document_Type
        Uploaded_File
        Document_Link
        Uploaded_By_Email
        Uploaded_Date
    )
    filters
    (
        Project
        Customer
        Document_Type
    )
    sort by
    (
        Uploaded_Date descending
    )
}
