list Assessment_Report_Documents
{
    displayName = "Assessment Report Documents"
    show all rows from Project_Documents [Document_Type == "Assessment Report"]
    (
        Project
        Customer
        Document_Name
        Uploaded_File
        Document_Link
        Related_Assessment
        Uploaded_Date
        Email_Sent
        Last_Emailed_Date
    )
    filters
    (
        Project
        Customer
        Email_Sent
    )
    sort by
    (
        Uploaded_Date descending
    )
}
