form Project_Documents
{
    displayname = "Project Documents"
    Document_Information
    (
        type = section
        displayname = "Document Information"
        row = 1
        column = 0
    )
    must have Project
    (
        type = picklist
        displayname = "Project"
        values = Projects.ID
        displayformat = [Project_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Document_Name
    (
        type = text
        displayname = "Document Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    must have Document_Type
    (
        type = picklist
        displayname = "Document Type"
        values = {"Assessment Report", "Supporting Document", "Requirement Document", "Proposal", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Uploaded_File
    (
        type = upload file
        displayname = "Uploaded File"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 1
        width = medium
    )
    Document_Link
    (
        type = url
        displayname = "External Document Link"
        row = 1
        column = 2
        width = medium
    )
    Related_Assessment
    (
        type = picklist
        displayname = "Related Assessment"
        values = Assessments.ID
        displayformat = [Assessment_Reference_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Uploaded_By_Email
    (
        type = email
        displayname = "Uploaded By Email"
        row = 1
        column = 2
        width = medium
    )
    Uploaded_Date
    (
        type = datetime
        displayname = "Uploaded Date"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 1
        width = medium
    )
    Email_Tracking
    (
        type = section
        displayname = "Email Tracking"
        visibility = true
        row = 2
        column = 1
    )
    Email_Sent
    (
        type = checkbox
        displayname = "Email Sent"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Last_Emailed_Date
    (
        type = datetime
        displayname = "Last Emailed Date"
        row = 2
        column = 2
        width = medium
    )
    Last_Emailed_To
    (
        type = email
        displayname = "Last Emailed To"
        row = 2
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
