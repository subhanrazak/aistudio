Project_Documents_Project_On_User_Input as "Project Documents - Populate Project Customer"
{
    type = form
    form = Project_Documents
    record event = on add or edit

    on user input of Project
    {
        actions
        {
            custom deluge script
            (
                if (input.Project != null)
                {
                    projectRec = Projects[ID == input.Project];
                    if (projectRec.count() > 0)
                    {
                        input.Customer = projectRec.Customer;
                    }
                }
            )
        }
    }
}
