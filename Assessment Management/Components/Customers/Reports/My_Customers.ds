list My_Customers
{
    displayName = "My Customers"
    show all rows from Customers [Assigned_Consultant_Email == zoho.loginuser]
    (
        Customer_Name
        Primary_Contact_Name
        Primary_Contact_Email
        Phone
        Industry_Type
        Status
    )
    filters
    (
        Industry_Type
        Status
    )
    sort by
    (
        Customer_Name ascending
    )
}
