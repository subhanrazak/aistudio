list Active_Customers
{
    displayName = "Active Customers"
    show all rows from Customers [Status == "Active"]
    (
        Customer_Name
        Primary_Contact_Name
        Primary_Contact_Email
        Industry_Type
        Assigned_Consultant_Email
        Status
    )
    filters
    (
        Industry_Type
        Assigned_Consultant_Email
    )
    sort by
    (
        Customer_Name ascending
    )
}
