form Customers
{
    displayname = "Customers"
    Customer_Information
    (
        type = section
        displayname = "Customer Information"
        row = 1
        column = 0
    )
    must have unique Customer_Name
    (
        type = text
        displayname = "Customer Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    must have Primary_Contact_Name
    (
        type = text
        displayname = "Primary Contact Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Primary_Contact_Email
    (
        type = email
        displayname = "Primary Contact Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types.ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Assigned_Consultant_Email
    (
        type = email
        displayname = "Assigned Consultant Email"
        description [ type = tooltip  message = "Enter the consultant's Creator login email for assignment filtering and notifications." ]
        row = 1
        column = 2
        width = medium
    )
    Address_and_Status
    (
        type = section
        displayname = "Address and Status"
        visibility = true
        row = 2
        column = 1
    )
    Address_Location
    (
        type = textarea
        displayname = "Address / Location"
        row = 2
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 2
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
