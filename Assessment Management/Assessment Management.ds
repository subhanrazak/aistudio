application "Assessment-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Activity_Log
		{
		    displayname = "Activity Log"
		    Activity
		    (
		        type = section
		        displayname = "Activity"
		        row = 1
		        column = 0
		    )
		    must have Activity_Date_Time
		    (
		        displayname = "Activity Date Time"
		        type = datetime
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Actor_Email
		    (
		        displayname = "Actor Email"
		        type = email
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Activity_Type
		    (
		        displayname = "Activity Type"
		        type = picklist
		        values = {"Customer Created", "Project Updated", "Assessment Created", "Responses Generated", "Assessment Submitted", "Report Generated", "Report Emailed", "Reminder Sent", "Assessment Expired", "Reassessment Reopened", "Document Added", "Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer
		    (
		        displayname = "Customer"
		        type = picklist
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Project
		    (
		        displayname = "Project"
		        type = picklist
		        values = Projects.ID
		        displayformat = [Project_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Assessment
		    (
		        displayname = "Assessment"
		        type = picklist
		        values = Assessments.ID
		        displayformat = [Assessment_Reference_Number]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Message
		    (
		        displayname = "Message"
		        type = textarea
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessment_Responses
		{
		    displayname = "Assessment Responses"
		    Assessment_Link
		    (
		        type = section
		        displayname = "Assessment Link"
		        row = 1
		        column = 0
		    )
		    must have Assessment
		    (
		        displayname = "Assessment"
		        type = picklist
		        values = Assessments.ID
		        displayformat = [Assessment_Reference_Number]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer
		    (
		        displayname = "Customer"
		        type = picklist
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Project
		    (
		        displayname = "Project"
		        type = picklist
		        values = Projects.ID
		        displayformat = [Project_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Industry_Type
		    (
		        displayname = "Industry Type"
		        type = picklist
		        values = Industry_Types.ID
		        displayformat = [Industry_Name]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Master_Question
		    (
		        displayname = "Question Reference"
		        type = picklist
		        values = Master_Questionnaire.ID
		        displayformat = [Question_Text]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Question_Snapshot
		    (
		        type = section
		        displayname = "Question Snapshot"
		        row = 2
		        column = 1
		        visibility = true
		    )
		    must have Section_Category_Snapshot
		    (
		        displayname = "Section / Category Snapshot"
		        type = text
		        maxchar = 150
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Question_Text_Snapshot
		    (
		        displayname = "Question Text Snapshot"
		        type = textarea
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Question_Type_Snapshot
		    (
		        displayname = "Question Type Snapshot"
		        type = picklist
		        values = {"Short Text", "Long Text", "Yes / No", "Single Choice", "Multiple Choice", "Rating", "Number", "Date"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Answer_Options_Snapshot
		    (
		        displayname = "Answer Options Snapshot"
		        type = textarea
		        row = 2
		        column = 1
		        width = medium
		    )
		    Help_Text_Snapshot
		    (
		        displayname = "Help Text Snapshot"
		        type = textarea
		        row = 2
		        column = 1
		        width = medium
		    )
		    Display_Order
		    (
		        displayname = "Display Order"
		        type = number
		        row = 2
		        column = 1
		        width = medium
		    )
		    Mandatory
		    (
		        displayname = "Mandatory Snapshot"
		        type = checkbox
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Is_Scored
		    (
		        displayname = "Is Scored Snapshot"
		        type = checkbox
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Weightage
		    (
		        displayname = "Weightage Snapshot"
		        type = decimal
		        decimalplace = 2
		        initial value = 1
		        row = 2
		        column = 1
		        width = medium
		    )
		    Max_Score
		    (
		        displayname = "Max Score Snapshot"
		        type = decimal
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Question_Version_Number
		    (
		        displayname = "Question Version Number"
		        type = number
		        row = 2
		        column = 1
		        width = medium
		    )
		    Response
		    (
		        type = section
		        displayname = "Response"
		        row = 3
		        column = 1
		        visibility = true
		    )
		    Submitted_Response
		    (
		        displayname = "Submitted Response"
		        type = textarea
		        row = 3
		        column = 1
		        width = medium
		    )
		    Response_Notes
		    (
		        displayname = "Response Notes / Comments"
		        type = textarea
		        row = 3
		        column = 1
		        width = medium
		    )
		    Score
		    (
		        displayname = "Score"
		        type = decimal
		        decimalplace = 2
		        initial value = 0
		        row = 3
		        column = 1
		        width = medium
		    )
		    Weighted_Score
		    (
		        displayname = "Weighted Score"
		        type = decimal
		        decimalplace = 2
		        initial value = 0
		        row = 3
		        column = 1
		        width = medium
		    )
		    must have Response_Status
		    (
		        displayname = "Response Status"
		        type = picklist
		        values = {"Not Started", "In Progress", "Answered", "Needs Review"}
		        initial value = "Not Started"
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessment_Settings
		{
		    displayname = "Assessment Settings"
		    Validity_Settings
		    (
		        type = section
		        displayname = "Validity Settings"
		        row = 1
		        column = 0
		    )
		    must have unique Setting_Name
		    (
		        type = text
		        displayname = "Setting Name"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Default_Validity_Days
		    (
		        type = number
		        displayname = "Default Validity Days"
		        initial value = 180
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Reminder_Every_Days
		    (
		        type = number
		        displayname = "Reminder Every Days"
		        initial value = 4
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessments
		{
		    displayname = "Assessments"
		    Assessment_Details
		    (
		        type = section
		        displayname = "Assessment Details"
		        row = 1
		        column = 0
		    )
		    Assessment_Reference_Number
		    (
		        type = autonumber
		        displayname = "Assessment Reference Number"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Project
		    (
		        type = picklist
		        displayname = "Project"
		        values = Projects.ID
		        displayformat = [Project_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Industry_Type
		    (
		        type = picklist
		        displayname = "Industry Type"
		        values = Industry_Types.ID
		        displayformat = [Industry_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Assessment_Mode
		    (
		        type = picklist
		        displayname = "Assessment Mode"
		        values = {"Internal", "Customer Portal"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assessment_Status
		    (
		        type = picklist
		        displayname = "Assessment Status"
		        values = {"Draft", "In Progress", "Submitted", "Report Generated", "Expiring Soon", "Expired", "Reassessment Required", "Reopened for Reassessment"}
		        initial value = "Draft"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Assigned_Consultant_Email
		    (
		        type = email
		        displayname = "Assigned Consultant Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer_Portal_Email
		    (
		        type = email
		        displayname = "Customer Portal Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Submission_Metadata
		    (
		        type = section
		        displayname = "Submission Metadata"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Completed_By_Name
		    (
		        type = text
		        displayname = "Completed By Name"
		        maxchar = 150
		        row = 2
		        column = 1
		        width = medium
		    )
		    Completed_By_Email
		    (
		        type = email
		        displayname = "Completed By Email"
		        personal data = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Submission_Date_Time
		    (
		        type = datetime
		        displayname = "Submission Date and Time"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Validity_Period_Days
		    (
		        type = number
		        displayname = "Validity Period Days"
		        initial value = 180
		        row = 2
		        column = 2
		        width = medium
		    )
		    Valid_Until_Date
		    (
		        type = date
		        displayname = "Valid Until Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Last_Reminder_Sent_Date
		    (
		        type = date
		        displayname = "Last Reminder Sent Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Scoring_and_Report
		    (
		        type = section
		        displayname = "Scoring and Report"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Overall_Score
		    (
		        type = decimal
		        displayname = "Overall Score"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Overall_Score_Percentage
		    (
		        type = decimal
		        displayname = "Overall Score Percentage"
		        decimalplace = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Maturity_Level
		    (
		        type = text
		        displayname = "Maturity Level"
		        maxchar = 100
		        row = 3
		        column = 1
		        width = medium
		    )
		    Risk_Level
		    (
		        type = text
		        displayname = "Risk Level"
		        maxchar = 100
		        row = 3
		        column = 2
		        width = medium
		    )
		    Report_Version_Number
		    (
		        type = number
		        displayname = "Report Version Number"
		        initial value = 1
		        row = 3
		        column = 1
		        width = medium
		    )
		    Generated_PDF_Report
		    (
		        type = upload file
		        displayname = "Generated PDF Report"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 3
		        column = 2
		        width = medium
		    )
		    Report_Document_Link
		    (
		        type = url
		        displayname = "Report Document Link"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customers
		{
		    displayname = "Customers"
		    Customer_Information
		    (
		        type = section
		        displayname = "Customer Information"
		        row = 1
		        column = 0
		    )
		    must have unique Customer_Name
		    (
		        type = text
		        displayname = "Customer Name"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Primary_Contact_Name
		    (
		        type = text
		        displayname = "Primary Contact Name"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Primary_Contact_Email
		    (
		        type = email
		        displayname = "Primary Contact Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Industry_Type
		    (
		        type = picklist
		        displayname = "Industry Type"
		        values = Industry_Types.ID
		        displayformat = [Industry_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Assigned_Consultant_Email
		    (
		        type = email
		        displayname = "Assigned Consultant Email"
		        description [ type = tooltip  message = "Enter the consultant's Creator login email for assignment filtering and notifications." ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    Address_and_Status
		    (
		        type = section
		        displayname = "Address and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Address_Location
		    (
		        type = textarea
		        displayname = "Address / Location"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Industry_Types
		{
		    displayname = "Industry Types"
		    Industry_Information
		    (
		        type = section
		        displayname = "Industry Information"
		        row = 1
		        column = 0
		    )
		    must have unique Industry_Name
		    (
		        type = text
		        displayname = "Industry Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Master_Questionnaire
		{
		    displayname = "Master Questionnaire"
		    Question_Setup
		    (
		        type = section
		        displayname = "Question Setup"
		        row = 1
		        column = 0
		    )
		    must have Industry_Type
		    (
		        type = picklist
		        displayname = "Industry Type"
		        values = Industry_Types.ID
		        displayformat = [Industry_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Section_Category
		    (
		        type = text
		        displayname = "Section / Category"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Question_Text
		    (
		        type = textarea
		        displayname = "Question Text"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Question_Type
		    (
		        type = picklist
		        displayname = "Question Type"
		        values = {"Short Text", "Long Text", "Yes / No", "Single Choice", "Multiple Choice", "Rating", "Number", "Date"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Answer_Options
		    (
		        type = textarea
		        displayname = "Answer Options"
		        description [ type = tooltip  message = "Enter one option per line for Yes/No, Single Choice, Multiple Choice, or Rating questions." ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    Help_Text
		    (
		        type = textarea
		        displayname = "Help Text / Guidance Notes"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Mandatory
		    (
		        type = checkbox
		        displayname = "Mandatory"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Scoring_and_Versioning
		    (
		        type = section
		        displayname = "Scoring and Versioning"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Is_Scored
		    (
		        type = checkbox
		        displayname = "Is Scored"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Weightage
		    (
		        type = decimal
		        displayname = "Weightage"
		        decimalplace = 2
		        initial value = 1
		        row = 2
		        column = 2
		        width = medium
		    )
		    Max_Score
		    (
		        type = decimal
		        displayname = "Max Score"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Version_Number
		    (
		        type = number
		        displayname = "Version Number"
		        initial value = 1
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Updated_Date
		    (
		        type = datetime
		        displayname = "Last Updated Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Project_Documents
		{
		    displayname = "Project Documents"
		    Document_Information
		    (
		        type = section
		        displayname = "Document Information"
		        row = 1
		        column = 0
		    )
		    must have Project
		    (
		        type = picklist
		        displayname = "Project"
		        values = Projects.ID
		        displayformat = [Project_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Document_Name
		    (
		        type = text
		        displayname = "Document Name"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Document_Type
		    (
		        type = picklist
		        displayname = "Document Type"
		        values = {"Assessment Report", "Supporting Document", "Requirement Document", "Proposal", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Uploaded_File
		    (
		        type = upload file
		        displayname = "Uploaded File"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		    Document_Link
		    (
		        type = url
		        displayname = "External Document Link"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Related_Assessment
		    (
		        type = picklist
		        displayname = "Related Assessment"
		        values = Assessments.ID
		        displayformat = [Assessment_Reference_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Uploaded_By_Email
		    (
		        type = email
		        displayname = "Uploaded By Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Uploaded_Date
		    (
		        type = datetime
		        displayname = "Uploaded Date"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Email_Tracking
		    (
		        type = section
		        displayname = "Email Tracking"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Email_Sent
		    (
		        type = checkbox
		        displayname = "Email Sent"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Last_Emailed_Date
		    (
		        type = datetime
		        displayname = "Last Emailed Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Emailed_To
		    (
		        type = email
		        displayname = "Last Emailed To"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Projects
		{
