			        actions
			        {
			            custom deluge script
			            (
			                if (input.Question_Type in {"Yes / No", "Single Choice", "Multiple Choice", "Rating"})
			                {
			                    show Answer_Options;
			                    enable Answer_Options;
			                }
			                else
			                {
			                    hide Answer_Options;
			                    disable Answer_Options;
			                }
			                if (input.Is_Scored == true)
			                {
			                    show Weightage;
			                    show Max_Score;
			                    enable Weightage;
			                    enable Max_Score;
			                }
			                else
			                {
			                    hide Weightage;
			                    hide Max_Score;
			                    disable Weightage;
			                    disable Max_Score;
			                }
			            )
			        }
			    }
			}

