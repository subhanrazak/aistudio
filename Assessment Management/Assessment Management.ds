			Scoring_Maturity_Config_On_Validate as "Scoring Config - Validate Score Range"
			{
			    type = form
			    form = Scoring_Maturity_Config
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Industry_Type != null)
			                {
			                    industryRec = Industry_Types[ID == input.Industry_Type];
			                    if (industryRec.count() > 0 && industryRec.Status != "Active")
			                    {
			                        alert "Please select an active industry type.";
			                        cancel submit;
			                    }
			                }
			                if (ifnull(input.Minimum_Score_Percentage,-1) < 0)
			                {
			                    alert "Minimum score percentage must be 0 or above.";
			                    cancel submit;
			                }
			                if (ifnull(input.Maximum_Score_Percentage,101) > 100)
			                {
			                    alert "Maximum score percentage must be 100 or below.";
			                    cancel submit;
			                }
			                if (input.Minimum_Score_Percentage > input.Maximum_Score_Percentage)
			                {
			                    alert "Minimum score percentage must be less than or equal to maximum score percentage.";
			                    cancel submit;
			                }
			                overlapRecs = Scoring_Maturity_Config[ID != input.ID && Industry_Type == input.Industry_Type && Section_Category == input.Section_Category && Status == "Active" && Maximum_Score_Percentage >= input.Minimum_Score_Percentage && Minimum_Score_Percentage <= input.Maximum_Score_Percentage];
			                if (overlapRecs.count() > 0 && input.Status == "Active")
			                {
			                    alert "An overlapping active score range already exists for this industry and section.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Assessment_Validity_Reminders as "Assessment Validity Reminders"
			{
			    type = schedule
			    form = Assessments[Assessment_Status == "Report Generated" || Assessment_Status == "Expiring Soon"]
			    start = Submission_Date_Time
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                assessmentRec = Assessments[ID == input.ID];
			                if (assessmentRec.count() > 0)
			                {
			                    if (assessmentRec.Valid_Until_Date != null && assessmentRec.Valid_Until_Date < zoho.currentdate)
			                    {
			                        assessmentRec.Assessment_Status = "Expired";
			                        projectRec = Projects[ID == assessmentRec.Project];
			                        if (projectRec.count() > 0)
			                        {
			                            projectRec.Project_Stage = "Reassessment Required";
			                        }
			                    }
			                    else
			                    {
			                        settingsRec = Assessment_Settings[Status == "Active"];
			                        reminderDays = 4;
			                        if (settingsRec.count() > 0)
			                        {
			                            reminderDays = settingsRec.Reminder_Every_Days;
			                        }
			                        shouldSend = false;
			                        if (assessmentRec.Last_Reminder_Sent_Date == null)
			                        {
			                            shouldSend = true;
			                        }
			                        else if (assessmentRec.Last_Reminder_Sent_Date.addDay(reminderDays) <= zoho.currentdate)
			                        {
			                            shouldSend = true;
			                        }
			                        if (shouldSend == true)
			                        {
			                            toEmail = assessmentRec.Customer_Portal_Email;
			                            if (toEmail in ["", " ", "null"])
			                            {
			                                customerRec = Customers[ID == assessmentRec.Customer];
			                                if (customerRec.count() > 0)
			                                {
			                                    toEmail = customerRec.Primary_Contact_Email;
			                                }
			                            }
			                            if (toEmail not in ["", " ", "null"])
			                            {
			                                sendmail
			                                (
			                                    from : zoho.adminuserid
			                                    to : toEmail
			                                    cc : assessmentRec.Assigned_Consultant_Email
			                                    subject : "Assessment Validity Reminder - " + assessmentRec.Assessment_Reference_Number
			                                    message : "This is a reminder that Current State Assessment " + assessmentRec.Assessment_Reference_Number + " is valid until " + assessmentRec.Valid_Until_Date + ". Please coordinate reassessment planning if required."
			                                )
			                                assessmentRec.Last_Reminder_Sent_Date = zoho.currentdate;
			                                assessmentRec.Assessment_Status = "Expiring Soon";
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}

		functions
		{
			Email_Report_To_Customer as "Email Report to Customer"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                assessmentRec = Assessments[ID == input.ID];
			                if (assessmentRec.count() > 0)
			                {
			                    toEmail = assessmentRec.Customer_Portal_Email;
			                    if (toEmail in ["", " ", "null"])
			                    {
			                        customerRec = Customers[ID == assessmentRec.Customer];
			                        if (customerRec.count() > 0)
			                        {
			                            toEmail = customerRec.Primary_Contact_Email;
			                        }
			                    }
			                    if (toEmail not in ["", " ", "null"])
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : toEmail
			                            cc : assessmentRec.Assigned_Consultant_Email
			                            subject : "Current State Assessment Report - " + assessmentRec.Assessment_Reference_Number
			                            message : "Dear Customer,<br><br>Please find the Current State Assessment report reference: " + assessmentRec.Assessment_Reference_Number + ".<br><br>Your Kannanware consultant will coordinate access to the PDF report.<br><br>Regards,<br>Kannanware"
			                        )
			                        docRec = Project_Documents[Related_Assessment == assessmentRec.ID && Document_Type == "Assessment Report"];
			                        if (docRec.count() > 0)
			                        {
			                            docRec.Email_Sent = true;
			                            docRec.Last_Emailed_Date = zoho.currenttime;
			                            docRec.Last_Emailed_To = toEmail;
			                        }
			                        insert into Report_Email_Log
			                        [
			                            Assessment = assessmentRec.ID
			                            Customer = assessmentRec.Customer
			                            Project = assessmentRec.Project
			                            Recipient_Email = toEmail
			                            Sent_By_Email = zoho.loginuser
			                            Sent_Date_Time = zoho.currenttime
			                            Email_Status = "Sent"
			                            Notes = "Report email sent from assessment action."
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}

			Generate_Assessment_Responses as "Generate Responses / Refresh Questions"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                assessmentRec = Assessments[ID == input.ID];
			                if (assessmentRec.count() > 0)
			                {
			                    if (assessmentRec.Assessment_Status in {"Draft", "In Progress", "Reopened for Reassessment"})
			                    {
			                        questions = Master_Questionnaire[Industry_Type == assessmentRec.Industry_Type && Status == "Active"];
			                        for each q in questions
			                        {
			                            existingResp = Assessment_Responses[Assessment == assessmentRec.ID && Master_Question == q.ID];
			                            if (existingResp.count() == 0)
			                            {
			                                insert into Assessment_Responses
			                                [
			                                    Assessment = assessmentRec.ID
			                                    Customer = assessmentRec.Customer
			                                    Project = assessmentRec.Project
			                                    Industry_Type = assessmentRec.Industry_Type
			                                    Master_Question = q.ID
			                                    Section_Category_Snapshot = q.Section_Category
			                                    Question_Text_Snapshot = q.Question_Text
			                                    Question_Type_Snapshot = q.Question_Type
			                                    Answer_Options_Snapshot = q.Answer_Options
			                                    Help_Text_Snapshot = q.Help_Text
			                                    Display_Order = q.Display_Order
			                                    Mandatory = q.Mandatory
			                                    Is_Scored = q.Is_Scored
			                                    Weightage = q.Weightage
			                                    Max_Score = q.Max_Score
			                                    Question_Version_Number = q.Version_Number
			                                    Response_Status = "Not Started"
			                                ];
			                            }
			                        }
			                        assessmentRec.Assessment_Status = "In Progress";
			                        projectRec = Projects[ID == assessmentRec.Project];
			                        if (projectRec.count() > 0)
			                        {
			                            projectRec.Project_Stage = "Assessment In Progress";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Reopen_For_Reassessment as "Reopen for Reassessment"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                assessmentRec = Assessments[ID == input.ID];
			                if (assessmentRec.count() > 0)
			                {
			                    if (assessmentRec.Assessment_Status in {"Submitted", "Report Generated", "Expired", "Reassessment Required"})
			                    {
			                        assessmentRec.Assessment_Status = "Reopened for Reassessment";
			                        assessmentRec.Last_Reminder_Sent_Date = null;
			                        assessmentRec.Report_Version_Number = ifnull(assessmentRec.Report_Version_Number,1) + 1;
			                        projectRec = Projects[ID == assessmentRec.Project];
			                        if (projectRec.count() > 0)
			                        {
			                            projectRec.Project_Stage = "Reassessment Required";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Submit_Assessment as "Submit Assessment"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                assessmentRec = Assessments[ID == input.ID];
			                if (assessmentRec.count() > 0)
			                {
			                    missingMandatory = Assessment_Responses[Assessment == assessmentRec.ID && Mandatory == true && Submitted_Response == ""];
			                    if (missingMandatory.count() > 0)
			                    {
			                        input.Notes = ifnull(input.Notes,"") + "\nSubmission blocked: mandatory responses are incomplete.";
			                    }
			                    else
			                    {
			                        totalScore = 0.0;
			                        totalMax = 0.0;
			                        scoredResponses = Assessment_Responses[Assessment == assessmentRec.ID && Is_Scored == true];
			                        for each resp in scoredResponses
			                        {
			                            totalScore = totalScore + ifnull(resp.Score,0);
			                            totalMax = totalMax + ifnull(resp.Max_Score,0);
			                        }
			                        scorePercentage = 0.0;
			                        if (totalMax > 0)
			                        {
			                            scorePercentage = (totalScore / totalMax) * 100;
			                        }
			                        assessmentRec.Overall_Score = totalScore;
			                        assessmentRec.Overall_Score_Percentage = scorePercentage;
			                        if (assessmentRec.Completed_By_Email in ["", " ", "null"])
			                        {
			                            assessmentRec.Completed_By_Email = zoho.loginuser;
			                        }
			                        if (assessmentRec.Completed_By_Name in ["", " ", "null"])
			                        {
			                            assessmentRec.Completed_By_Name = zoho.loginuser;
			                        }
			                        assessmentRec.Submission_Date_Time = zoho.currenttime;
			                        assessmentRec.Valid_Until_Date = zoho.currentdate.addDay(ifnull(assessmentRec.Validity_Period_Days,180));
			                        configRec = Scoring_Maturity_Config[Industry_Type == assessmentRec.Industry_Type && Status == "Active" && Section_Category == "" && Minimum_Score_Percentage <= scorePercentage && Maximum_Score_Percentage >= scorePercentage];
			                        if (configRec.count() == 0)
			                        {
			                            configRec = Scoring_Maturity_Config[Industry_Type == assessmentRec.Industry_Type && Status == "Active" && Minimum_Score_Percentage <= scorePercentage && Maximum_Score_Percentage >= scorePercentage];
			                        }
			                        if (configRec.count() > 0)
			                        {
			                            assessmentRec.Maturity_Level = configRec.Maturity_Level;
			                            assessmentRec.Risk_Level = configRec.Risk_Level;
			                        }
			                        if (ifnull(assessmentRec.Report_Version_Number,0) <= 0)
			                        {
			                            assessmentRec.Report_Version_Number = 1;
			                        }
			                        assessmentRec.Assessment_Status = "Report Generated";
			                        projectRec = Projects[ID == assessmentRec.Project];
			                        if (projectRec.count() > 0)
			                        {
			                            projectRec.Project_Stage = "Report Generated";
			                        }
			                        existingDoc = Project_Documents[Related_Assessment == assessmentRec.ID && Document_Type == "Assessment Report" && Document_Name == "CSA Report - " + assessmentRec.Assessment_Reference_Number + " - v" + assessmentRec.Report_Version_Number];
			                        if (existingDoc.count() == 0)
			                        {
			                            insert into Project_Documents
			                            [
			                                Project = assessmentRec.Project
			                                Customer = assessmentRec.Customer
			                                Document_Name = "CSA Report - " + assessmentRec.Assessment_Reference_Number + " - v" + assessmentRec.Report_Version_Number
			                                Document_Type = "Assessment Report"
			                                Related_Assessment = assessmentRec.ID
			                                Document_Link = assessmentRec.Report_Document_Link
			                                Uploaded_By_Email = zoho.loginuser
			                                Uploaded_Date = zoho.currenttime
			                                Notes = "Assessment report tracking record created on submission. Upload the generated branded PDF into the assessment or document record."
			                            ];
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}
	}

	share_settings
	{
	"Consultant_Agent"
	{
	    name        = "Consultant_Agent"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
	    description = "Consultant / Agent profile focused on the customer, project, assessment, response, document, email, and dashboard flow. Setup and portal-only reports are hidden from this profile."
	
