	reports
	{
		default list All_Activity_Log
		{
		    displayName = "All Activity Log"
		    show all rows from Activity_Log
		    (
		        Activity_Date_Time
		        Actor_Email
		        Activity_Type
		        Customer
		        Project
		        Assessment
		        Message
		    )
		    filters
		    (
		        Activity_Type
		        Customer
		        Project
		        Assessment
		        Actor_Email
		    )
		    sort by
		    (
		        Activity_Date_Time descending
		    )
		}

		list Recent_Project_Activity
		{
		    displayName = "Recent Project Activity"
		    show all rows from Activity_Log
		    (
		        Activity_Date_Time
		        Activity_Type
		        Customer
		        Project
		        Assessment
		        Actor_Email
		        Message
		    )
		    filters
		    (
		        Project
		        Customer
		        Activity_Type
		    )
		    sort by
		    (
		        Activity_Date_Time descending
		    )
		}

		list All_Assessment_Responses
		{
		    displayName = "All Assessment Responses"
		    show all rows from Assessment_Responses
		    (
		        Assessment
		        Customer
		        Project
		        Section_Category_Snapshot
		        Display_Order
		        Question_Text_Snapshot
		        Submitted_Response
		        Score
		        Weighted_Score
		        Response_Status
		    )
		    filters
		    (
		        Assessment
		        Customer
		        Project
		        Section_Category_Snapshot
		        Response_Status
		    )
		    sort by
		    (
		        Assessment ascending
		        Section_Category_Snapshot ascending
		        Display_Order ascending
		    )
		}

		list My_Response_Worklist
		{
		    displayName = "My Response Worklist"
		    show all rows from Assessment_Responses
		    (
		        Assessment
		        Customer
		        Project
		        Section_Category_Snapshot
		        Display_Order
		        Question_Text_Snapshot
		        Submitted_Response
		        Response_Status
		    )
		    filters
		    (
		        Assessment
		        Customer
		        Project
		        Response_Status
		    )
		    sort by
		    (
		        Assessment ascending
		        Display_Order ascending
		    )
		}

		list Needs_Review_Responses
		{
		    displayName = "Needs Review Responses"
		    show all rows from Assessment_Responses[Response_Status == "Needs Review"]
		    (
		        Assessment
		        Customer
		        Project
		        Section_Category_Snapshot
		        Display_Order
		        Question_Text_Snapshot
		        Submitted_Response
		        Response_Notes
		    )
		    filters
		    (
		        Assessment
		        Customer
		        Project
		    )
		    sort by
		    (
		        Assessment ascending
		        Display_Order ascending
		    )
		}

		list Responses_By_Assessment
		{
		    displayName = "Responses By Assessment"
		    show all rows from Assessment_Responses
		    (
		        Assessment
		        Section_Category_Snapshot
		        Display_Order
		        Question_Text_Snapshot
		        Question_Type_Snapshot
		        Submitted_Response
		        Response_Notes
		        Score
		        Response_Status
		    )
		    filters
		    (
		        Assessment
		        Section_Category_Snapshot
		        Response_Status
		    )
		    group by
		    (
		        Section_Category_Snapshot ascending
		    )
		    sort by
		    (
		        Display_Order ascending
		    )
		}

		list Active_Assessment_Settings
		{
		    displayName = "Active Assessment Settings"
		    show all rows from Assessment_Settings [Status == "Active"]
		    (
		        Setting_Name
		        Default_Validity_Days
		        Reminder_Every_Days
		        Notes
		    )
		    sort by
		    (
		        Setting_Name ascending
		    )
		}

		default list All_Assessment_Settings
		{
		    displayName = "All Assessment Settings"
		    show all rows from Assessment_Settings
		    (
		        Setting_Name
		        Default_Validity_Days
		        Reminder_Every_Days
		        Status
		        Notes
		    )
		    filters
		    (
		        Status
		    )
		    sort by
		    (
		        Setting_Name ascending
		    )
		}

		default list All_Assessments
		{
		    displayName = "All Assessments"
		    show all rows from Assessments
		    (
		        Assessment_Reference_Number
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Assessment_Status
		        Assigned_Consultant_Email
		        Customer_Portal_Email
		        Submission_Date_Time
		        Valid_Until_Date
		        Overall_Score_Percentage
		        Maturity_Level
		        Risk_Level
		        custom action "Generate Responses / Refresh Questions"
		        (
		            workflow = Generate_Assessment_Responses
		            show action for each record = true
		            column header = "Generate Responses / Refresh Questions"
		            success message = "Assessment response snapshot refreshed."
		            condition = (Assessment_Status == "Draft" || Assessment_Status == "In Progress" || Assessment_Status == "Reopened for Reassessment")
		        )
		        custom action "Submit Assessment"
		        (
		            workflow = Submit_Assessment
		            show action for each record = true
		            column header = "Submit Assessment"
		            success message = "Assessment submitted and scored."
		            condition = (Assessment_Status == "Draft" || Assessment_Status == "In Progress" || Assessment_Status == "Reopened for Reassessment")
		            confirmation before execution
		            (
		                message for individual record = "Submit this assessment and lock current responses?"
		                confirm button text = "Submit"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Reopen for Reassessment"
		        (
		            workflow = Reopen_For_Reassessment
		            show action for each record = true
		            column header = "Reopen for Reassessment"
		            success message = "Assessment reopened for reassessment."
		            condition = (Assessment_Status == "Submitted" || Assessment_Status == "Report Generated" || Assessment_Status == "Expired" || Assessment_Status == "Reassessment Required")
		        )
		        custom action "Email Report to Customer"
		        (
		            workflow = Email_Report_To_Customer
		            show action for each record = true
		            column header = "Email Report to Customer"
		            success message = "Report email request completed."
		            condition = (Assessment_Status == "Report Generated")
		        )
		    )
		    filters
		    (
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Assessment_Status
		        Assigned_Consultant_Email
		        Risk_Level
		    )
		    sort by
		    (
		        Submission_Date_Time descending
		    )
		}

		kanban Assessment_Status_Board
		{
		    displayName = "Assessment Status Board"
		    show all rows from Assessments
		    (
		        Assessment_Reference_Number
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Assessment_Status
		        Assigned_Consultant_Email
		        Valid_Until_Date
		        Risk_Level
		    )
		    filters
		    (
		        Industry_Type
		        Assessment_Mode
		        Assigned_Consultant_Email
		        Risk_Level
		    )
		    sort by
		    (
		        Valid_Until_Date ascending
		    )
		    options
		    (
		        display field = Assessment_Status
		        emptycolumn = "No Status"
		        othercolumn = "Other"
		        filter type = manual
		        sort order = ascending
		        record count = enable
		    )
		}

