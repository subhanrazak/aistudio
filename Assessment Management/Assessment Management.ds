	pages
	{
		page Current_State_Dashboard
		{
					displayname = "Current State Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Dashboard_Content' elementName='Dashboard_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Dashboard_Content()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tcurrentMonth = zoho.currentdate.getMonth();\n\tcurrentYear = zoho.currentdate.getYear();\n\ttotalCustomers = Customers[ID != 0].count();\n\ttotalProjects = Projects[ID != 0].count();\n\ttotalAssessments = Assessments[ID != 0].count();\n\tcompletedThisMonth = 0;\n\tscoreTotal = 0.0;\n\tscoreCount = 0;\n\tfor each assessmentForMetrics in Assessments[ID != 0]\n\t{\n\t\tif(assessmentForMetrics.Submission_Date_Time != null)\n\t\t{\n\t\t\tif(assessmentForMetrics.Submission_Date_Time.getMonth() == currentMonth &amp;&amp; assessmentForMetrics.Submission_Date_Time.getYear() == currentYear &amp;&amp; (assessmentForMetrics.Assessment_Status == &quot;Submitted&quot; || assessmentForMetrics.Assessment_Status == &quot;Report Generated&quot;))\n\t\t\t{\n\t\t\t\tcompletedThisMonth = completedThisMonth + 1;\n\t\t\t}\n\t\t}\n\t\tif(assessmentForMetrics.Overall_Score_Percentage != null)\n\t\t{\n\t\t\tscoreTotal = scoreTotal + ifnull(assessmentForMetrics.Overall_Score_Percentage,0.0);\n\t\t\tscoreCount = scoreCount + 1;\n\t\t}\n\t}\n\tavgScore = 0.0;\n\tif(scoreCount &gt; 0)\n\t{\n\t\tavgScore = scoreTotal / scoreCount;\n\t}\n\n\tinProgressCount = Assessments[Assessment_Status == &quot;In Progress&quot; || Assessment_Status == &quot;Reopened for Reassessment&quot;].count();\n\texpiringSoonCount = Assessments[Assessment_Status == &quot;Expiring Soon&quot;].count();\n\texpiredReassessCount = Assessments[Assessment_Status == &quot;Expired&quot; || Assessment_Status == &quot;Reassessment Required&quot;].count();\n\thighRiskCount = Assessments[Risk_Level == &quot;High Risk&quot;].count();\n\n\tinternalCount = Assessments[Assessment_Mode == &quot;Internal&quot;].count();\n\tportalCount = Assessments[Assessment_Mode == &quot;Customer Portal&quot;].count();\n\tinternalPct = 0.0;\n\tportalPct = 0.0;\n\tif(totalAssessments &gt; 0)\n\t{\n\t\tinternalPct = (internalCount * 100.0) / totalAssessments;\n\t\tportalPct = (portalCount * 100.0) / totalAssessments;\n\t}\n\n\tdraftCount = Assessments[Assessment_Status == &quot;Draft&quot;].count();\n\tinProgressOnlyCount = Assessments[Assessment_Status == &quot;In Progress&quot; || Assessment_Status == &quot;Reopened for Reassessment&quot;].count();\n\tsubmittedCount = Assessments[Assessment_Status == &quot;Submitted&quot;].count();\n\treportGeneratedCount = Assessments[Assessment_Status == &quot;Report Generated&quot;].count();\n\texpiringStatusCount = Assessments[Assessment_Status == &quot;Expiring Soon&quot;].count();\n\texpiredStatusCount = Assessments[Assessment_Status == &quot;Expired&quot;].count();\n\treassessmentStatusCount = Assessments[Assessment_Status == &quot;Reassessment Required&quot;].count();\n\tstatusMax = draftCount;\n\tif(inProgressOnlyCount &gt; statusMax) { statusMax = inProgressOnlyCount; }\n\tif(submittedCount &gt; statusMax) { statusMax = submittedCount; }\n\tif(reportGeneratedCount &gt; statusMax) { statusMax = reportGeneratedCount; }\n\tif(expiringStatusCount &gt; statusMax) { statusMax = expiringStatusCount; }\n\tif(expiredStatusCount &gt; statusMax) { statusMax = expiredStatusCount; }\n\tif(reassessmentStatusCount &gt; statusMax) { statusMax = reassessmentStatusCount; }\n\tif(statusMax == 0) { statusMax = 1; }\n\tdraftPct = (draftCount * 100.0) / statusMax;\n\tinProgressStatusPct = (inProgressOnlyCount * 100.0) / statusMax;\n\tsubmittedPct = (submittedCount * 100.0) / statusMax;\n\treportGeneratedPct = (reportGeneratedCount * 100.0) / statusMax;\n\texpiringStatusPct = (expiringStatusCount * 100.0) / statusMax;\n\texpiredStatusPct = (expiredStatusCount * 100.0) / statusMax;\n\treassessmentStatusPct = (reassessmentStatusCount * 100.0) / statusMax;\n\n\triskHigh = Assessments[Risk_Level == &quot;High Risk&quot;].count();\n\triskMedHigh = Assessments[Risk_Level == &quot;Medium-High Risk&quot;].count();\n\triskMed = Assessments[Risk_Level == &quot;Medium Risk&quot;].count();\n\triskLowMed = Assessments[Risk_Level == &quot;Low-Medium Risk&quot;].count();\n\triskLow = Assessments[Risk_Level == &quot;Low Risk&quot;].count();\n\triskMax = riskHigh;\n\tif(riskMedHigh &gt; riskMax) { riskMax = riskMedHigh; }\n\tif(riskMed &gt; riskMax) { riskMax = riskMed; }\n\tif(riskLowMed &gt; riskMax) { riskMax = riskLowMed; }\n\tif(riskLow &gt; riskMax) { riskMax = riskLow; }\n\tif(riskMax == 0) { riskMax = 1; }\n\triskHighPct = (riskHigh * 100.0) / riskMax;\n\triskMedHighPct = (riskMedHigh * 100.0) / riskMax;\n\triskMedPct = (riskMed * 100.0) / riskMax;\n\triskLowMedPct = (riskLowMed * 100.0) / riskMax;\n\triskLowPct = (riskLow * 100.0) / riskMax;\n\n\trefreshText = zoho.currenttime.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\tmonthText = zoho.currentdate.toString(&quot;MMM yyyy&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset, included once for this page */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color:#FFFFFF; --zcs-page-bg-color:#F3F3F4; }\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-20{padding-left:20px;padding-right:20px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:4px}.zcs-mt-8{margin-top:8px}.zcs-mt-12{margin-top:12px}.zcs-mt-16{margin-top:16px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-24{font-size:24px}.zcs-font-30{font-size:30px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-color-primary{color:var(--zcs-primary-text-color,#15172E)}.zcs-color-secondary{color:var(--zcs-secondary-text-color,#596074)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color,#84899A)}.zcs-color-white{color:#fff}.zcs-color-theme{color:var(--zcs-theme-brand-color,#0B6B62)}.zcs-card{background:var(--zcs-white-color);border:1px solid #E6E8EF;border-radius:14px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}\n/* ZCS button component */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color,#0B6B62);color:var(--zcs_brand_foreground_color,#fff);border:1px solid var(--zcs_brand_color,#0B6B62)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#0B6B62);background-color:var(--zcs-white-color);color:var(--zcs_brand_color,#0B6B62)}.zcs-secondary-button{border:1px solid var(--zcs_tertiary_border_color,#DFE3EA);background-color:#F7F8FA;color:var(--zcs_primary_text_color,#15172E)}.zcs-button:hover{filter:brightness(.98)}.zcs-button-icon{width:16px;max-height:16px}\n/* ZCS filled badge component */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color,#0B6B62);border-color:var(--zcs_brand_color,#0B6B62);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}\n/* ZCS simple table component */\n.zcs-table-wrapper{border:1px solid #E6E8EF;background-color:#fff;overflow:auto;border-radius:10px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 #E6E8EF inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid #E6E8EF;vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-table-wrapper table tbody tr td .zcs-l_blue{color:#1094c5}\n/* Dashboard-specific layout */\n.csd-page{font-family:Inter,Roboto,Arial,sans-serif;background:#F4F6F8;min-height:100%;padding:22px;box-sizing:border-box;color:#15172E}.csd-hero{position:relative;overflow:hidden;border-radius:20px;padding:24px;background:radial-gradient(circle at 90% 12%,rgba(255,255,255,.34) 0,rgba(255,255,255,.34) 70px,transparent 72px),radial-gradient(circle at 83% 70%,rgba(255,255,255,.18) 0,rgba(255,255,255,.18) 120px,transparent 122px),linear-gradient(135deg,#102A43 0%,#0B6B62 60%,#D99A19 130%);box-shadow:0 18px 42px rgba(16,42,67,.16)}.csd-brand-mark{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center}.csd-hero h1{font-size:28px;margin:0;color:#fff;font-weight:700;letter-spacing:-.02em}.csd-hero p{margin:6px 0 0;color:rgba(255,255,255,.82);font-size:14px;max-width:820px}.csd-hero-meta{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.csd-hero-chip{border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.12);color:#fff;border-radius:999px;padding:7px 11px;font-size:12px;display:inline-flex;gap:7px;align-items:center}.csd-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.csd-action-link{background:rgba(255,255,255,.94);color:#0B5E58;border:1px solid rgba(255,255,255,.7);border-radius:10px;padding:9px 13px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:8px}.csd-action-link.secondary{background:rgba(16,42,67,.22);color:#fff;border-color:rgba(255,255,255,.26)}.csd-section-title{display:flex;align-items:center;justify-content:space-between;margin:22px 0 12px}.csd-section-title h2{font-size:18px;margin:0;font-weight:700;color:#15172E}.csd-section-title span{font-size:12px;color:#6B7280}.csd-kpi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.csd-kpi-card{position:relative;overflow:hidden}.csd-kpi-card:before{content:&quot;&quot;;position:absolute;left:0;top:0;width:5px;height:100%;background:var(--accent,#0B6B62)}.csd-kpi-card .kpi-icon{width:40px;height:40px;border-radius:12px;background:var(--accent-soft,#E6F5F2);color:var(--accent,#0B6B62);display:flex;align-items:center;justify-content:center;font-size:20px}.csd-kpi-label{font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.05em;font-weight:700}.csd-kpi-value{font-size:30px;font-weight:800;color:#111827;letter-spacing:-.03em;line-height:1.05;margin-top:8px}.csd-kpi-note{font-size:12px;color:#6B7280;margin-top:8px}.csd-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.csd-grid-3{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:14px}.csd-panel{padding:18px}.csd-panel h3{font-size:16px;margin:0 0 4px;font-weight:700}.csd-panel-subtitle{font-size:12px;color:#6B7280;margin:0 0 16px}.csd-stack{display:flex;height:18px;overflow:hidden;border-radius:999px;background:#E9EDF2}.csd-stack .internal{background:#0B6B62}.csd-stack .portal{background:#D99A19}.csd-legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px}.csd-legend-item{display:inline-flex;align-items:center;gap:7px;color:#4B5563;font-size:13px}.csd-dot{width:10px;height:10px;border-radius:50%;background:var(--dot,#0B6B62)}.csd-bar-row{display:grid;grid-template-columns:148px 1fr 38px;gap:10px;align-items:center;margin:10px 0}.csd-bar-label{font-size:13px;color:#374151}.csd-bar-track{height:10px;border-radius:999px;background:#EEF1F5;overflow:hidden}.csd-bar-fill{height:100%;border-radius:999px;background:var(--bar,#0B6B62);width:var(--w,0%)}.csd-industry-row,.csd-project-row{padding:11px 0;border-top:1px solid #EEF1F5}.csd-industry-row:first-child,.csd-project-row:first-child{border-top:0}.csd-mini-label{font-size:13px;color:#374151;font-weight:600}.csd-mini-count{font-size:13px;color:#6B7280}.csd-mini-bar{height:7px;background:#EEF1F5;border-radius:999px;overflow:hidden;margin-top:8px}.csd-mini-bar span{display:block;height:100%;width:var(--w,0%);background:linear-gradient(90deg,#0B6B62,#D99A19);border-radius:999px}.csd-risk-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px}.csd-risk-box{border:1px solid #EEF1F5;border-radius:12px;padding:12px;text-align:center;background:#FBFCFD}.csd-risk-box strong{display:block;font-size:20px}.csd-risk-box span{display:block;font-size:11px;color:#6B7280;margin-top:3px}.csd-tables{display:grid;grid-template-columns:1.3fr 1fr;gap:14px}.csd-feed-item{display:flex;gap:12px;padding:13px 0;border-top:1px solid #EEF1F5}.csd-feed-item:first-child{border-top:0}.csd-feed-icon{width:32px;height:32px;border-radius:10px;background:#E6F5F2;color:#0B6B62;display:flex;align-items:center;justify-content:center;flex-shrink:0}.csd-feed-title{font-size:13px;font-weight:700;color:#15172E}.csd-feed-msg{font-size:13px;color:#4B5563;margin-top:2px}.csd-feed-meta{font-size:12px;color:#8791A3;margin-top:4px}.csd-empty{padding:18px;text-align:center;color:#6B7280;font-size:13px;background:#FBFCFD;border-radius:10px;border:1px dashed #DDE3EA}.csd-nowrap{white-space:nowrap}.csd-small{font-size:12px;color:#6B7280}.csd-score{font-weight:700;color:#0B6B62}.csd-overflow{overflow:auto}@media(max-width:1180px){.csd-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.csd-grid-3,.csd-tables{grid-template-columns:1fr}.csd-grid-2{grid-template-columns:1fr}}@media(max-width:720px){.csd-page{padding:14px}.csd-hero{padding:18px}.csd-kpi-grid{grid-template-columns:1fr}.csd-hero-meta{justify-content:flex-start}.csd-bar-row{grid-template-columns:112px 1fr 34px}.csd-risk-strip{grid-template-columns:repeat(2,1fr)}}\n&lt;/style&gt;\n&lt;div class=&quot;csd-page&quot;&gt;\n\t&lt;div class=&quot;csd-hero&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-align-items-center&quot;&gt;\n\t\t\t\t&lt;div class=&quot;csd-brand-mark&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32 zcs-font-24 zcs-color-white&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h1&gt;Current State Executive Dashboard&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Internal view for assessment volume, maturity, risk, project/document momentum, expiry exposure, and recent operating activity.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-hero-meta&quot;&gt;\n\t\t\t\t&lt;span class=&quot;csd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline users-circle-08&quot;&gt;&lt;/i&gt; Internal executive view&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;csd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Refreshed &lt;%=refreshText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;csd-actions&quot;&gt;\n\t\t\t&lt;a class=&quot;csd-action-link&quot; href=&quot;#Report:All_Assessments&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt; All Assessments&lt;/a&gt;\n\t\t\t&lt;a class=&quot;csd-action-link&quot; href=&quot;#Report:Expiring_Assessments&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Expiring Assessments&lt;/a&gt;\n\t\t\t&lt;a class=&quot;csd-action-link secondary&quot; href=&quot;#Report:All_Projects&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt; All Projects&lt;/a&gt;\n\t\t\t&lt;a class=&quot;csd-action-link secondary&quot; href=&quot;#Report:All_Project_Documents&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt; Project Documents&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;csd-section-title&quot;&gt;\n\t\t&lt;h2&gt;Executive KPI Snapshot&lt;/h2&gt;\n\t\t&lt;span&gt;Completed metric period: &lt;%=monthText%&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;csd-kpi-grid&quot;&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#0B6B62;--accent-soft:#E6F5F2;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Total Customers&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=totalCustomers%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Active and inactive customer master records&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#2A6FFC;--accent-soft:#E8EFFF;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Total Projects&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=totalProjects%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Projects across all lifecycle stages&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#7C3AED;--accent-soft:#F0EAFE;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Total Assessments&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=totalAssessments%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Internal and customer portal assessment records&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline education-paper-diploma&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#179E6C;--accent-soft:#E4FCF3;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Completed This Month&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=completedThisMonth%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Submitted or report-generated in &lt;%=monthText%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#1094C5;--accent-soft:#E7F8FE;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;In Progress&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=inProgressCount%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;In Progress and Reopened for Reassessment&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#FAAE13;--accent-soft:#FFF6DA;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Expiring Soon&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=expiringSoonCount%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Assessments in reminder window&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time-clock&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#FE455D;--accent-soft:#FDE3E6;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Expired / Reassessment&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=expiredReassessCount%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Expired or reassessment required&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-alert-circle-i&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#D99A19;--accent-soft:#FCF4E6;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;Average Overall Score&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=avgScore%&gt;%&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Average of scored assessments (&lt;%=scoreCount%&gt; records)&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-pie-35&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border csd-kpi-card&quot; style=&quot;--accent:#B42318;--accent-soft:#FDECEC;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;div class=&quot;csd-kpi-label&quot;&gt;High Risk Assessments&lt;/div&gt;&lt;div class=&quot;csd-kpi-value&quot;&gt;&lt;%=highRiskCount%&gt;&lt;/div&gt;&lt;div class=&quot;csd-kpi-note&quot;&gt;Assessments currently tagged High Risk&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info-warning&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;csd-section-title&quot;&gt;\n\t\t&lt;h2&gt;Visual Summaries&lt;/h2&gt;\n\t\t&lt;span&gt;Mode, status, industry, risk, and document concentration&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;csd-grid-2&quot;&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border&quot;&gt;\n\t\t\t&lt;h3&gt;Internal vs Customer Portal Assessments&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Volume split by assessment mode&lt;/p&gt;\n\t\t\t&lt;div class=&quot;csd-stack&quot; title=&quot;Assessment mode distribution&quot;&gt;&lt;div class=&quot;internal&quot; style=&quot;width:&lt;%=internalPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;div class=&quot;portal&quot; style=&quot;width:&lt;%=portalPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-legend&quot;&gt;&lt;span class=&quot;csd-legend-item&quot;&gt;&lt;span class=&quot;csd-dot&quot; style=&quot;--dot:#0B6B62&quot;&gt;&lt;/span&gt;Internal: &lt;strong&gt;&lt;%=internalCount%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;span class=&quot;csd-legend-item&quot;&gt;&lt;span class=&quot;csd-dot&quot; style=&quot;--dot:#D99A19&quot;&gt;&lt;/span&gt;Customer Portal: &lt;strong&gt;&lt;%=portalCount%&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-risk-strip&quot;&gt;\n\t\t\t\t&lt;div class=&quot;csd-risk-box&quot;&gt;&lt;strong&gt;&lt;%=totalAssessments%&gt;&lt;/strong&gt;&lt;span&gt;Total&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;csd-risk-box&quot;&gt;&lt;strong&gt;&lt;%=internalPct%&gt;%&lt;/strong&gt;&lt;span&gt;Internal share&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;csd-risk-box&quot;&gt;&lt;strong&gt;&lt;%=portalPct%&gt;%&lt;/strong&gt;&lt;span&gt;Portal share&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;csd-risk-box&quot;&gt;&lt;strong&gt;&lt;%=completedThisMonth%&gt;&lt;/strong&gt;&lt;span&gt;Completed&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;csd-risk-box&quot;&gt;&lt;strong&gt;&lt;%=scoreCount%&gt;&lt;/strong&gt;&lt;span&gt;Scored&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border&quot;&gt;\n\t\t\t&lt;h3&gt;Assessment Status Distribution&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Current assessment pipeline health&lt;/p&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Draft&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=draftPct%&gt;%;--bar:#94A3B8&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=draftCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;In Progress&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=inProgressStatusPct%&gt;%;--bar:#1094C5&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=inProgressOnlyCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Submitted&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=submittedPct%&gt;%;--bar:#2A6FFC&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Report Generated&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=reportGeneratedPct%&gt;%;--bar:#179E6C&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=reportGeneratedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Expiring Soon&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=expiringStatusPct%&gt;%;--bar:#FAAE13&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=expiringStatusCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Expired&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=expiredStatusPct%&gt;%;--bar:#FE455D&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=expiredStatusCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Reassessment Required&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=reassessmentStatusPct%&gt;%;--bar:#B42318&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=reassessmentStatusCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;csd-grid-3 zcs-mt-16&quot;&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border&quot;&gt;\n\t\t\t&lt;h3&gt;Industry-wise Assessment Summary&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Assessment count grouped by industry master&lt;/p&gt;\n\t\t\t&lt;%\n\t\t\t\tindustryRows = 0;\n\t\t\t\tfor each industryRec in Industry_Types[ID != 0] sort by Industry_Name asc\n\t\t\t\t{\n\t\t\t\t\tindustryCount = Assessments[Industry_Type == industryRec.ID].count();\n\t\t\t\t\tindustryPct = 0.0;\n\t\t\t\t\tif(totalAssessments &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tindustryPct = (industryCount * 100.0) / totalAssessments;\n\t\t\t\t\t}\n\t\t\t\t\tindustryRows = industryRows + 1;\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&quot;csd-industry-row&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div class=&quot;csd-mini-label&quot;&gt;&lt;%=industryRec.Industry_Name%&gt;&lt;/div&gt;&lt;div class=&quot;csd-mini-count&quot;&gt;&lt;%=industryCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;csd-mini-bar&quot;&gt;&lt;span style=&quot;--w:&lt;%=industryPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t}\n\t\t\t\tif(industryRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;div class=&quot;csd-empty&quot;&gt;No industry records are available yet.&lt;/div&gt;&lt;%\n\t\t\t\t}\n\t\t\t%&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border&quot;&gt;\n\t\t\t&lt;h3&gt;Risk Level Summary&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Distribution across maturity risk bands&lt;/p&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;High Risk&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=riskHighPct%&gt;%;--bar:#FE455D&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=riskHigh%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Medium-High&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=riskMedHighPct%&gt;%;--bar:#F4660C&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=riskMedHigh%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Medium&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=riskMedPct%&gt;%;--bar:#FAAE13&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=riskMed%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Low-Medium&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=riskLowMedPct%&gt;%;--bar:#2A6FFC&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=riskLowMed%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;csd-bar-row&quot;&gt;&lt;div class=&quot;csd-bar-label&quot;&gt;Low Risk&lt;/div&gt;&lt;div class=&quot;csd-bar-track&quot;&gt;&lt;div class=&quot;csd-bar-fill&quot; style=&quot;--w:&lt;%=riskLowPct%&gt;%;--bar:#179E6C&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-text-right zcs-font-13&quot;&gt;&lt;%=riskLow%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border&quot;&gt;\n\t\t\t&lt;h3&gt;Project-wise Document Count&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Recent project document concentration&lt;/p&gt;\n\t\t\t&lt;%\n\t\t\t\tprojectRows = 0;\n\t\t\t\tfor each projectRec in Projects[ID != 0] sort by Start_Date desc\n\t\t\t\t{\n\t\t\t\t\tif(projectRows &lt; 7)\n\t\t\t\t\t{\n\t\t\t\t\t\tdocCount = Project_Documents[Project == projectRec.ID].count();\n\t\t\t\t\t\tdocPct = 0.0;\n\t\t\t\t\t\tif(docCount &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tdocPct = docCount * 12.5;\n\t\t\t\t\t\t\tif(docPct &gt; 100)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tdocPct = 100;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tprojectRows = projectRows + 1;\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;csd-project-row&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div class=&quot;csd-mini-label&quot;&gt;&lt;%=projectRec.Project_Name%&gt;&lt;/div&gt;&lt;div class=&quot;csd-mini-count&quot;&gt;&lt;%=docCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;csd-mini-bar&quot;&gt;&lt;span style=&quot;--w:&lt;%=docPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(projectRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;div class=&quot;csd-empty&quot;&gt;No project records are available yet.&lt;/div&gt;&lt;%\n\t\t\t\t}\n\t\t\t%&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;csd-section-title&quot;&gt;\n\t\t&lt;h2&gt;Tables and Feeds&lt;/h2&gt;\n\t\t&lt;span&gt;Recent submissions, expiry exposure, and audit activity&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;csd-tables&quot;&gt;\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border csd-overflow&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mt-4&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;h3&gt;Recent Submissions&lt;/h3&gt;&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Latest completed assessment records&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;#Report:All_Assessments&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open report&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assessment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer / Project&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Score&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Maturity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Risk&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\trecentRows = 0;\n\t\t\t\t\t\tfor each recentAssessment in Assessments[Submission_Date_Time != null] sort by Submission_Date_Time desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(recentRows &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trecentRows = recentRows + 1;\n\t\t\t\t\t\t\t\triskText = ifnull(recentAssessment.Risk_Level,&quot;Not rated&quot;);\n\t\t\t\t\t\t\t\triskClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tif(riskText == &quot;High Risk&quot;) { riskClass = &quot;zcs-badge-red&quot;; }\n\t\t\t\t\t\t\t\telse if(riskText == &quot;Medium-High Risk&quot;) { riskClass = &quot;zcs-badge-orange&quot;; }\n\t\t\t\t\t\t\t\telse if(riskText == &quot;Medium Risk&quot;) { riskClass = &quot;zcs-badge-yellow&quot;; }\n\t\t\t\t\t\t\t\telse if(riskText == &quot;Low-Medium Risk&quot;) { riskClass = &quot;zcs-badge-blue&quot;; }\n\t\t\t\t\t\t\t\telse if(riskText == &quot;Low Risk&quot;) { riskClass = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\t\t\t\tscoreText = &quot;Not scored&quot;;\n\t\t\t\t\t\t\t\tif(recentAssessment.Overall_Score_Percentage != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tscoreText = recentAssessment.Overall_Score_Percentage + &quot;%&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(recentAssessment.Assessment_Reference_Number,&quot;-&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;csd-small&quot;&gt;&lt;%=ifnull(recentAssessment.Assessment_Mode,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(recentAssessment.Customer.Customer_Name,&quot;-&quot;)%&gt;&lt;div class=&quot;csd-small&quot;&gt;&lt;%=ifnull(recentAssessment.Project.Project_Name,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary csd-nowrap&quot;&gt;&lt;%=recentAssessment.Submission_Date_Time.toString(&quot;dd-MMM-yyyy&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-text-right csd-score&quot;&gt;&lt;%=scoreText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(recentAssessment.Maturity_Level,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=riskClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=riskText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(recentRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;6&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;csd-empty&quot;&gt;No submitted assessments yet.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border csd-overflow&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mt-4&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;h3&gt;Expiring and Expired Assessments&lt;/h3&gt;&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Validity exposure and assigned consultant ownership&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;#Report:Expiring_Assessments&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;Review&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assessment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Valid Until&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Consultant&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\texpiryRows = 0;\n\t\t\t\t\t\tfor each expAssessment in Assessments[Assessment_Status == &quot;Expiring Soon&quot; || Assessment_Status == &quot;Expired&quot; || Assessment_Status == &quot;Reassessment Required&quot;] sort by Valid_Until_Date asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(expiryRows &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\texpiryRows = expiryRows + 1;\n\t\t\t\t\t\t\t\tstatusText = ifnull(expAssessment.Assessment_Status,&quot;-&quot;);\n\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tif(statusText == &quot;Expired&quot; || statusText == &quot;Reassessment Required&quot;) { statusClass = &quot;zcs-badge-red&quot;; }\n\t\t\t\t\t\t\t\tvalidText = &quot;Not set&quot;;\n\t\t\t\t\t\t\t\tif(expAssessment.Valid_Until_Date != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tvalidText = expAssessment.Valid_Until_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(expAssessment.Assessment_Reference_Number,&quot;-&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;csd-small&quot;&gt;&lt;%=ifnull(expAssessment.Customer.Customer_Name,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary csd-nowrap&quot;&gt;&lt;%=validText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(expAssessment.Assigned_Consultant_Email,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=statusText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(expiryRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;csd-empty&quot;&gt;No expiring or expired assessments at this time.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-card csd-panel zcs-box-border zcs-mt-16&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t&lt;div&gt;&lt;h3&gt;Recent Activity Feed&lt;/h3&gt;&lt;p class=&quot;csd-panel-subtitle&quot;&gt;Latest operational activity from Activity Log&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;Audit visibility&lt;/span&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\tactivityRows = 0;\n\t\t\tfor each activityRec in Activity_Log[ID != 0] sort by Activity_Date_Time desc\n\t\t\t{\n\t\t\t\tif(activityRows &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tactivityRows = activityRows + 1;\n\t\t\t\t\tactivityDateText = &quot;No date&quot;;\n\t\t\t\t\tif(activityRec.Activity_Date_Time != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tactivityDateText = activityRec.Activity_Date_Time.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&quot;csd-feed-item&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;csd-feed-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-bell-53&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;csd-feed-title&quot;&gt;&lt;%=ifnull(activityRec.Activity_Type,&quot;Activity&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;csd-feed-msg&quot;&gt;&lt;%=ifnull(activityRec.Message,&quot;No message captured.&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;csd-feed-meta&quot;&gt;&lt;%=activityDateText%&gt; by &lt;%=ifnull(activityRec.Actor_Email,&quot;System&quot;)%&gt; &lt;%=ifnull(activityRec.Customer.Customer_Name,&quot;&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(activityRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;&lt;div class=&quot;csd-empty&quot;&gt;No activity log entries are available yet.&lt;/div&gt;&lt;%\n\t\t\t}\n\t\t%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Project_Tracking_Dashboard(int Project_ID)
		{
					displayname = "Project Tracking Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Project_Tracking_Content' elementName='Project_Tracking_Content'>\n\t\t\t\t\t<![CDATA[htmlpage Project_Tracking_Content()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\thasProjectParam = false;\n\tif(input.Project_ID != null)\n\t{\n\t\tif(input.Project_ID &gt; 0)\n\t\t{\n\t\t\thasProjectParam = true;\n\t\t}\n\t}\n\tselectedProjectCount = 0;\n\tif(hasProjectParam)\n\t{\n\t\tselectedProjectCount = Projects[ID == input.Project_ID].count();\n\t}\n\trefreshText = zoho.currenttime.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset, included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-page-bg-color:#F3F3F4;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-2{flex:0 0 16.666666%;max-width:16.666666%}.zcs-col-10{flex:0 0 83.333333%;max-width:83.333333%}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-rounded-half{border-radius:50%}.zcs-gap-0{gap:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-14{gap:14px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-gap-32{gap:32px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-10{padding:10px}.zcs-p-16{padding:16px}.zcs-p-18{padding:18px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-20{padding-left:20px;padding-right:20px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-px-60{padding-left:60px;padding-right:60px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-4{padding-top:4px;padding-bottom:4px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-mt-4{margin-top:4px}.zcs-mt-5{margin-top:5px}.zcs-mt-8{margin-top:8px}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mt-16{margin-top:16px}.zcs-mt-20{margin-top:20px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-28{font-size:28px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-color-primary{color:var(--zcs-primary-text-color,#15172E)}.zcs-color-secondary{color:var(--zcs-secondary-text-color,#596074)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color,#84899A)}.zcs-color-white{color:#fff}.zcs-color-theme{color:var(--zcs-theme-brand-color,#0B6B62)}.zcs-card{background:var(--zcs-white-color);border:1px solid #E6E8EF;border-radius:14px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}a{text-decoration:none}\n/* ZCS button component */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color,#0B6B62);color:var(--zcs_brand_foreground_color,#fff);border:1px solid var(--zcs_brand_color,#0B6B62)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#0B6B62);background-color:var(--zcs-white-color);color:var(--zcs_brand_color,#0B6B62)}.zcs-secondary-button{border:1px solid var(--zcs_tertiary_border_color,#DFE3EA);background-color:#F7F8FA;color:var(--zcs_primary_text_color,#15172E)}.zcs-button:hover{filter:brightness(.98)}.zcs-button-icon{width:16px;max-height:16px}\n/* ZCS filled badge component */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color,#0B6B62);border-color:var(--zcs_brand_color,#0B6B62);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}\n/* ZCS simple table component */\n.zcs-table-wrapper{border:1px solid #E6E8EF;background-color:#fff;overflow:auto;border-radius:10px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 #E6E8EF inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid #E6E8EF;vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-table-wrapper table tbody tr td .zcs-l_blue{color:#1094c5}\n/* ZCS timeline component */\n.zcs-tl-indicator{width:60px;left:16.6666666667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color,#0B6B62);border:1px solid #fff;box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}@media(max-width:768px){.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}}\n/* Project tracking layout */\n.ptd-page{font-family:Inter,Roboto,Arial,sans-serif;background:#F4F6F8;min-height:100%;padding:22px;box-sizing:border-box;color:#15172E}.ptd-hero{position:relative;overflow:hidden;border-radius:20px;padding:24px;background:radial-gradient(circle at 92% 14%,rgba(255,255,255,.34) 0,rgba(255,255,255,.34) 70px,transparent 72px),radial-gradient(circle at 82% 75%,rgba(255,255,255,.17) 0,rgba(255,255,255,.17) 120px,transparent 122px),linear-gradient(135deg,#102A43 0%,#0B6B62 62%,#D99A19 135%);box-shadow:0 18px 42px rgba(16,42,67,.16)}.ptd-brand-mark{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center}.ptd-hero h1{font-size:28px;margin:0;color:#fff;font-weight:700;letter-spacing:-.02em}.ptd-hero p{margin:6px 0 0;color:rgba(255,255,255,.82);font-size:14px;max-width:860px}.ptd-hero-meta{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.ptd-hero-chip{border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.12);color:#fff;border-radius:999px;padding:7px 11px;font-size:12px;display:inline-flex;gap:7px;align-items:center}.ptd-action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.ptd-action-link{background:rgba(255,255,255,.94);color:#0B5E58;border:1px solid rgba(255,255,255,.7);border-radius:10px;padding:9px 13px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:8px}.ptd-action-link.secondary{background:rgba(16,42,67,.22);color:#fff;border-color:rgba(255,255,255,.26)}.ptd-section-title{display:flex;align-items:center;justify-content:space-between;margin:22px 0 12px}.ptd-section-title h2{font-size:18px;margin:0;font-weight:700;color:#15172E}.ptd-section-title span{font-size:12px;color:#6B7280}.ptd-grid-2{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.ptd-grid-docs{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ptd-panel{padding:18px}.ptd-panel h3{font-size:16px;margin:0 0 4px;font-weight:700}.ptd-panel-subtitle{font-size:12px;color:#6B7280;margin:0 0 16px}.ptd-summary-title{font-size:22px;font-weight:800;letter-spacing:-.02em;color:#111827;margin:0}.ptd-muted{color:#6B7280}.ptd-small{font-size:12px;color:#6B7280}.ptd-nowrap{white-space:nowrap}.ptd-kpi-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:14px}.ptd-mini-kpi{border:1px solid #EEF1F5;background:#FBFCFD;border-radius:12px;padding:12px}.ptd-mini-kpi strong{display:block;font-size:22px;line-height:1.15;color:#111827}.ptd-mini-kpi span{display:block;font-size:12px;color:#6B7280;margin-top:4px}.ptd-key-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.ptd-key{border:1px solid #EEF1F5;background:#FBFCFD;border-radius:12px;padding:12px}.ptd-key label{display:block;font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.04em;font-weight:700}.ptd-key span{display:block;font-size:14px;color:#15172E;font-weight:600;margin-top:5px;word-break:break-word}.ptd-stage-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-top:16px}.ptd-stage{position:relative;border:1px solid #E6E8EF;border-radius:12px;padding:10px 8px;background:#fff;color:#6B7280;text-align:center;font-size:11px;font-weight:700;min-height:42px;display:flex;align-items:center;justify-content:center}.ptd-stage.complete{background:#E4FCF3;border-color:#179E6C;color:#0B6B62}.ptd-stage.current{background:#0B6B62;border-color:#0B6B62;color:#fff;box-shadow:0 10px 24px rgba(11,107,98,.22)}.ptd-assessment-score{font-size:42px;line-height:1;font-weight:800;letter-spacing:-.05em;color:#0B6B62;margin:12px 0 4px}.ptd-score-wrap{border-radius:16px;background:linear-gradient(135deg,#E6F5F2 0%,#FFFFFF 72%);border:1px solid #D8EEE9;padding:16px;margin-top:14px}.ptd-doc-link{font-weight:700;color:var(--zcs_brand_color,#0B6B62)}.ptd-doc-link:hover{text-decoration:underline}.ptd-empty{padding:18px;text-align:center;color:#6B7280;font-size:13px;background:#FBFCFD;border-radius:10px;border:1px dashed #DDE3EA}.ptd-empty-icon{width:58px;height:58px;border-radius:18px;background:#E6F5F2;color:#0B6B62;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:28px}.ptd-recent-list{margin-top:18px}.ptd-table-actions{display:flex;gap:8px;justify-content:flex-end}.ptd-health-banner{display:flex;align-items:center;gap:10px;padding:12px;border-radius:12px;background:#F9FAFE;border:1px solid #E6E8EF;margin-top:12px}.ptd-health-icon{width:34px;height:34px;border-radius:10px;background:#E6F5F2;color:#0B6B62;display:flex;align-items:center;justify-content:center;flex-shrink:0}.ptd-overflow{overflow:auto}.ptd-document-card .zcs-table-wrapper{max-height:360px}.ptd-activity-card{max-height:520px;overflow:auto}.ptd-activity-message{font-size:13px;color:#4B5563;margin-top:5px}.ptd-activity-title{font-size:14px;font-weight:700;color:#15172E}.ptd-activity-actor{font-size:12px;color:#8791A3;margin-top:4px}.ptd-status-pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}@media(max-width:1180px){.ptd-grid-2,.ptd-grid-docs{grid-template-columns:1fr}.ptd-kpi-row{grid-template-columns:repeat(2,minmax(0,1fr))}.ptd-stage-strip{grid-template-columns:repeat(4,1fr)}}@media(max-width:720px){.ptd-page{padding:14px}.ptd-hero{padding:18px}.ptd-hero-meta{justify-content:flex-start}.ptd-key-grid,.ptd-kpi-row{grid-template-columns:1fr}.ptd-stage-strip{grid-template-columns:1fr}.ptd-table-actions{justify-content:flex-start}.ptd-hero h1{font-size:23px}}\n&lt;/style&gt;\n&lt;div class=&quot;ptd-page&quot;&gt;\n&lt;%\n\tif(!hasProjectParam || selectedProjectCount == 0)\n\t{\n\t\temptyTitle = &quot;Choose a project to track&quot;;\n\t\temptyMessage = &quot;Pass Project_ID in the page URL or select one of the recent active projects below to open the project-centric tracking view.&quot;;\n\t\tif(hasProjectParam &amp;&amp; selectedProjectCount == 0)\n\t\t{\n\t\t\temptyTitle = &quot;Project not found&quot;;\n\t\t\temptyMessage = &quot;No project record was found for Project_ID &quot; + input.Project_ID + &quot;. Select a recent active project or open the Projects report to confirm the record.&quot;;\n\t\t}\n\t\t%&gt;\n\t\t&lt;div class=&quot;ptd-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-align-items-center&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ptd-brand-mark&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24 zcs-font-24 zcs-color-white&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h1&gt;Project Tracking Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t&lt;p&gt;Internal project tracking workspace for stage, latest assessment, documents, email status, and project activity.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ptd-hero-meta&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;ptd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline users-circle-08&quot;&gt;&lt;/i&gt; Internal project view&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;ptd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Refreshed &lt;%=refreshText%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ptd-action-row&quot;&gt;\n\t\t\t\t&lt;a class=&quot;ptd-action-link&quot; href=&quot;#Report:Active_Projects&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt; Active Projects&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;ptd-action-link secondary&quot; href=&quot;#Report:All_Projects&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt; All Projects&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-card zcs-p-24 zcs-box-border zcs-mt-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ptd-empty-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-search&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=emptyTitle%&gt;&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=emptyMessage%&gt;&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;zcs-row zcs-align-items-center zcs-justify-center zcs-gap-16 zcs-mt-20&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Active_Projects&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open Active Projects&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Projects&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Browse All Projects&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ptd-section-title&quot;&gt;\n\t\t\t&lt;h2&gt;Recent Active Projects&lt;/h2&gt;\n\t\t\t&lt;span&gt;Select a project to open this dashboard with Project_ID&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card ptd-panel zcs-box-border ptd-overflow&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Project&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Stage&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Target&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Action&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tactiveProjectRows = 0;\n\t\t\t\t\t\tfor each activeProject in Projects[Status == &quot;Active&quot;] sort by Start_Date desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(activeProjectRows &lt; 10)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tactiveProjectRows = activeProjectRows + 1;\n\t\t\t\t\t\t\t\tactiveProjectUrl = &quot;#Page:Project_Tracking_Dashboard?Project_ID=&quot; + activeProject.ID;\n\t\t\t\t\t\t\t\tactiveTargetText = &quot;-&quot;;\n\t\t\t\t\t\t\t\tif(activeProject.Target_Completion_Date != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tactiveTargetText = activeProject.Target_Completion_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(activeProject.Project_Name,&quot;Untitled project&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;ptd-small&quot;&gt;ID &lt;%=activeProject.ID%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(activeProject.Customer.Customer_Name,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=ifnull(activeProject.Project_Stage,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap&quot;&gt;&lt;%=activeTargetText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;div class=&quot;ptd-table-actions&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;&lt;%=activeProjectUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Track&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(activeProjectRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;ptd-empty&quot;&gt;No active projects are available yet.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t}\n\telse\n\t{\n\t\tfor each projectRec in Projects[ID == input.Project_ID]\n\t\t{\n\t\t\tprojectName = ifnull(projectRec.Project_Name,&quot;Untitled project&quot;);\n\t\t\tcustomerName = ifnull(projectRec.Customer.Customer_Name,&quot;-&quot;);\n\t\t\tindustryName = ifnull(projectRec.Industry_Type.Industry_Name,&quot;-&quot;);\n\t\t\tconsultantEmail = ifnull(projectRec.Assigned_Consultant_Email,&quot;-&quot;);\n\t\t\tprojectStage = ifnull(projectRec.Project_Stage,&quot;-&quot;);\n\t\t\tprojectStatus = ifnull(projectRec.Status,&quot;-&quot;);\n\t\t\tprojectStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tif(projectStatus == &quot;Active&quot;) { projectStatusClass = &quot;zcs-badge-green&quot;; }\n\t\t\telse if(projectStatus == &quot;On Hold&quot;) { projectStatusClass = &quot;zcs-badge-yellow&quot;; }\n\t\t\telse if(projectStatus == &quot;Completed&quot;) { projectStatusClass = &quot;zcs-badge-blue&quot;; }\n\t\t\telse if(projectStatus == &quot;Cancelled&quot;) { projectStatusClass = &quot;zcs-badge-grey&quot;; }\n\t\t\tstartDateText = &quot;-&quot;;\n\t\t\tif(projectRec.Start_Date != null)\n\t\t\t{\n\t\t\t\tstartDateText = projectRec.Start_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t}\n\t\t\ttargetDateText = &quot;-&quot;;\n\t\t\ttargetHealthText = &quot;No target date&quot;;\n\t\t\ttargetHealthClass = &quot;zcs-badge-grey&quot;;\n\t\t\tif(projectRec.Target_Completion_Date != null)\n\t\t\t{\n\t\t\t\ttargetDateText = projectRec.Target_Completion_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\ttargetHealthText = &quot;Target set&quot;;\n\t\t\t\ttargetHealthClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(projectStatus != &quot;Completed&quot; &amp;&amp; projectRec.Target_Completion_Date &lt; zoho.currentdate)\n\t\t\t\t{\n\t\t\t\t\ttargetHealthText = &quot;Past target&quot;;\n\t\t\t\t\ttargetHealthClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t}\n\t\t\tassessmentCount = Assessments[Project == projectRec.ID].count();\n\t\t\treportDocCount = Project_Documents[Project == projectRec.ID &amp;&amp; Document_Type == &quot;Assessment Report&quot;].count();\n\t\t\tsupportDocCount = Project_Documents[Project == projectRec.ID &amp;&amp; Document_Type != &quot;Assessment Report&quot;].count();\n\t\t\tactivityCount = Activity_Log[Project == projectRec.ID].count();\n\t\t\tprojectUrl = &quot;#Report:All_Projects?ID=&quot; + projectRec.ID;\n\t\t\tassessmentsUrl = &quot;#Report:All_Assessments?Project=&quot; + projectRec.ID;\n\t\t\tdocumentsUrl = &quot;#Report:All_Project_Documents?Project=&quot; + projectRec.ID;\n\t\t\tlatestFound = false;\n\t\t\tlatestRef = &quot;No assessment yet&quot;;\n\t\t\tlatestMode = &quot;-&quot;;\n\t\t\tlatestStatus = &quot;-&quot;;\n\t\t\tlatestSubmission = &quot;-&quot;;\n\t\t\tlatestValidUntil = &quot;-&quot;;\n\t\t\tlatestScore = &quot;Not scored&quot;;\n\t\t\tlatestMaturity = &quot;-&quot;;\n\t\t\tlatestRisk = &quot;Not rated&quot;;\n\t\t\tlatestRiskClass = &quot;zcs-badge-grey&quot;;\n\t\t\tlatestStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tfor each latestAssessment in Assessments[Project == projectRec.ID] sort by Submission_Date_Time desc\n\t\t\t{\n\t\t\t\tif(latestFound == false)\n\t\t\t\t{\n\t\t\t\t\tlatestFound = true;\n\t\t\t\t\tlatestRef = ifnull(latestAssessment.Assessment_Reference_Number,&quot;Assessment &quot; + latestAssessment.ID);\n\t\t\t\t\tlatestMode = ifnull(latestAssessment.Assessment_Mode,&quot;-&quot;);\n\t\t\t\t\tlatestStatus = ifnull(latestAssessment.Assessment_Status,&quot;-&quot;);\n\t\t\t\t\tif(latestAssessment.Submission_Date_Time != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tlatestSubmission = latestAssessment.Submission_Date_Time.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tif(latestAssessment.Valid_Until_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tlatestValidUntil = latestAssessment.Valid_Until_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tif(latestAssessment.Overall_Score_Percentage != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tlatestScore = latestAssessment.Overall_Score_Percentage + &quot;%&quot;;\n\t\t\t\t\t}\n\t\t\t\t\tlatestMaturity = ifnull(latestAssessment.Maturity_Level,&quot;-&quot;);\n\t\t\t\t\tlatestRisk = ifnull(latestAssessment.Risk_Level,&quot;Not rated&quot;);\n\t\t\t\t\tif(latestRisk == &quot;High Risk&quot;) { latestRiskClass = &quot;zcs-badge-red&quot;; }\n\t\t\t\t\telse if(latestRisk == &quot;Medium-High Risk&quot;) { latestRiskClass = &quot;zcs-badge-orange&quot;; }\n\t\t\t\t\telse if(latestRisk == &quot;Medium Risk&quot;) { latestRiskClass = &quot;zcs-badge-yellow&quot;; }\n\t\t\t\t\telse if(latestRisk == &quot;Low-Medium Risk&quot;) { latestRiskClass = &quot;zcs-badge-blue&quot;; }\n\t\t\t\t\telse if(latestRisk == &quot;Low Risk&quot;) { latestRiskClass = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\tif(latestStatus == &quot;Submitted&quot; || latestStatus == &quot;Report Generated&quot;) { latestStatusClass = &quot;zcs-badge-green&quot;; }\n\t\t\t\t\telse if(latestStatus == &quot;In Progress&quot; || latestStatus == &quot;Reopened for Reassessment&quot;) { latestStatusClass = &quot;zcs-badge-blue&quot;; }\n\t\t\t\t\telse if(latestStatus == &quot;Expiring Soon&quot;) { latestStatusClass = &quot;zcs-badge-yellow&quot;; }\n\t\t\t\t\telse if(latestStatus == &quot;Expired&quot; || latestStatus == &quot;Reassessment Required&quot;) { latestStatusClass = &quot;zcs-badge-red&quot;; }\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n\t\t\t&lt;div class=&quot;ptd-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-brand-mark&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24 zcs-font-24 zcs-color-white&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;h1&gt;&lt;%=projectName%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t&lt;p&gt;Internal project tracking view for &lt;%=customerName%&gt;. Review stage, latest assessment, generated reports, supporting documents, email tracking, and recent activity.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ptd-hero-meta&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;ptd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline users-circle-08&quot;&gt;&lt;/i&gt; Internal project view&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;ptd-hero-chip&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Refreshed &lt;%=refreshText%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ptd-action-row&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;ptd-action-link&quot; href=&quot;&lt;%=projectUrl%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt; Project Record / Report&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;ptd-action-link secondary&quot; href=&quot;&lt;%=assessmentsUrl%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt; Related Assessments&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;ptd-action-link secondary&quot; href=&quot;&lt;%=documentsUrl%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt; Related Documents&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ptd-section-title&quot;&gt;\n\t\t\t\t&lt;h2&gt;Project Overview&lt;/h2&gt;\n\t\t\t\t&lt;span&gt;Summary and latest assessment&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ptd-grid-2&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card ptd-panel zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;h3 class=&quot;ptd-summary-title&quot;&gt;&lt;%=projectName%&gt;&lt;/h3&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ptd-status-pill-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=projectStage%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=projectStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=projectStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=targetHealthClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=targetHealthText%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;&lt;%=projectUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ptd-key-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Customer&lt;/label&gt;&lt;span&gt;&lt;%=customerName%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Industry&lt;/label&gt;&lt;span&gt;&lt;%=industryName%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Assigned Consultant&lt;/label&gt;&lt;span&gt;&lt;%=consultantEmail%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Project Stage&lt;/label&gt;&lt;span&gt;&lt;%=projectStage%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Status&lt;/label&gt;&lt;span&gt;&lt;%=projectStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Start Date&lt;/label&gt;&lt;span&gt;&lt;%=startDateText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Target Completion&lt;/label&gt;&lt;span&gt;&lt;%=targetDateText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Project ID&lt;/label&gt;&lt;span&gt;&lt;%=projectRec.ID%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ptd-kpi-row&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-mini-kpi&quot;&gt;&lt;strong&gt;&lt;%=assessmentCount%&gt;&lt;/strong&gt;&lt;span&gt;Assessments&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-mini-kpi&quot;&gt;&lt;strong&gt;&lt;%=reportDocCount%&gt;&lt;/strong&gt;&lt;span&gt;Report documents&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-mini-kpi&quot;&gt;&lt;strong&gt;&lt;%=supportDocCount%&gt;&lt;/strong&gt;&lt;span&gt;Supporting documents&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ptd-mini-kpi&quot;&gt;&lt;strong&gt;&lt;%=activityCount%&gt;&lt;/strong&gt;&lt;span&gt;Activity records&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;ptd-stage-strip&quot;&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\tstageList = {&quot;Discovery&quot;,&quot;Assessment In Progress&quot;,&quot;Assessment Submitted&quot;,&quot;Report Generated&quot;,&quot;Review&quot;,&quot;Reassessment Required&quot;,&quot;Completed&quot;};\n\t\t\t\t\t\t\tcurrentStageIndex = stageList.indexOf(projectStage);\n\t\t\t\t\t\t\tfor each index stageIndex in stageList\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstageValue = stageList.get(stageIndex);\n\t\t\t\t\t\t\t\tstageClass = &quot;&quot;;\n\t\t\t\t\t\t\t\tif(currentStageIndex &gt;= 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif(stageIndex &lt; currentStageIndex) { stageClass = &quot;complete&quot;; }\n\t\t\t\t\t\t\t\t\telse if(stageIndex == currentStageIndex) { stageClass = &quot;current&quot;; }\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;ptd-stage &lt;%=stageClass%&gt;&quot;&gt;&lt;%=stageValue%&gt;&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-card ptd-panel zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;h3&gt;Latest Assessment&lt;/h3&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;ptd-panel-subtitle&quot;&gt;Most recent assessment linked to this project&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;&lt;%=assessmentsUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;span&gt;Assessments&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(latestFound == false)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;ptd-empty&quot;&gt;No assessment has been created for this project yet.&lt;/div&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ptd-score-wrap&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-tertiary zcs-uppercase zcs-font-bold&quot;&gt;Assessment Reference&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-20 zcs-font-bold zcs-color-primary zcs-mt-4&quot;&gt;&lt;%=latestRef%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-8&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=latestStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=latestStatus%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=latestRiskClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=latestRisk%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-assessment-score&quot;&gt;&lt;%=latestScore%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-small&quot;&gt;Overall score percentage&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Mode&lt;/label&gt;&lt;span&gt;&lt;%=latestMode%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Status&lt;/label&gt;&lt;span&gt;&lt;%=latestStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Submission Date&lt;/label&gt;&lt;span&gt;&lt;%=latestSubmission%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Valid Until&lt;/label&gt;&lt;span&gt;&lt;%=latestValidUntil%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Maturity Level&lt;/label&gt;&lt;span&gt;&lt;%=latestMaturity%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-key&quot;&gt;&lt;label&gt;Risk Level&lt;/label&gt;&lt;span&gt;&lt;%=latestRisk%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ptd-section-title&quot;&gt;\n\t\t\t\t&lt;h2&gt;Documents&lt;/h2&gt;\n\t\t\t\t&lt;span&gt;Generated PDF assessment reports and supporting project documents&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ptd-grid-docs&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card ptd-panel ptd-document-card zcs-box-border ptd-overflow&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h3&gt;Assessment Report Documents&lt;/h3&gt;&lt;p class=&quot;ptd-panel-subtitle&quot;&gt;Generated PDF report tracking records and email status&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;&lt;%=documentsUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;span&gt;Open docs&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Document&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assessment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Uploaded&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Email&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Source&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\treportRows = 0;\n\t\t\t\t\t\t\t\tfor each reportDoc in Project_Documents[Project == projectRec.ID &amp;&amp; Document_Type == &quot;Assessment Report&quot;] sort by Uploaded_Date desc\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif(reportRows &lt; 8)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\treportRows = reportRows + 1;\n\t\t\t\t\t\t\t\t\t\treportUploaded = &quot;-&quot;;\n\t\t\t\t\t\t\t\t\t\tif(reportDoc.Uploaded_Date != null) { reportUploaded = reportDoc.Uploaded_Date.toString(&quot;dd-MMM-yyyy HH:mm&quot;); }\n\t\t\t\t\t\t\t\t\t\treportEmailText = &quot;Not sent&quot;;\n\t\t\t\t\t\t\t\t\t\treportEmailClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\tif(reportDoc.Email_Sent == true)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\treportEmailText = &quot;Sent&quot;;\n\t\t\t\t\t\t\t\t\t\t\treportEmailClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\treportLastEmail = &quot;&quot;;\n\t\t\t\t\t\t\t\t\t\tif(reportDoc.Last_Emailed_Date != null) { reportLastEmail = reportDoc.Last_Emailed_Date.toString(&quot;dd-MMM-yyyy HH:mm&quot;); }\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(reportDoc.Document_Name,&quot;Unnamed document&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;ptd-small&quot;&gt;Assessment Report&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(reportDoc.Related_Assessment.Assessment_Reference_Number,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap&quot;&gt;&lt;%=reportUploaded%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=reportEmailClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=reportEmailText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;div class=&quot;ptd-small&quot;&gt;&lt;%=reportLastEmail%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tif(reportDoc.Document_Link != null &amp;&amp; reportDoc.Document_Link != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;a class=&quot;ptd-doc-link&quot; href=&quot;&lt;%=reportDoc.Document_Link%&gt;&quot; target=&quot;_blank&quot;&gt;Open link&lt;/a&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;span class=&quot;ptd-small&quot;&gt;Stored in Creator&lt;/span&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(reportRows == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;ptd-empty&quot;&gt;No generated assessment report document entries are linked to this project yet.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-card ptd-panel ptd-document-card zcs-box-border ptd-overflow&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h3&gt;Supporting Documents&lt;/h3&gt;&lt;p class=&quot;ptd-panel-subtitle&quot;&gt;Requirement, proposal, and other non-report documents&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;#Report:Supporting_Documents?Project=&lt;%=projectRec.ID%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;span&gt;Supporting&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Document&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Uploaded By&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Uploaded&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Source&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tsupportRows = 0;\n\t\t\t\t\t\t\t\tfor each supportDoc in Project_Documents[Project == projectRec.ID &amp;&amp; Document_Type != &quot;Assessment Report&quot;] sort by Uploaded_Date desc\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif(supportRows &lt; 8)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tsupportRows = supportRows + 1;\n\t\t\t\t\t\t\t\t\t\tsupportUploaded = &quot;-&quot;;\n\t\t\t\t\t\t\t\t\t\tif(supportDoc.Uploaded_Date != null) { supportUploaded = supportDoc.Uploaded_Date.toString(&quot;dd-MMM-yyyy HH:mm&quot;); }\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(supportDoc.Document_Name,&quot;Unnamed document&quot;)%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;&lt;%=ifnull(supportDoc.Document_Type,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(supportDoc.Uploaded_By_Email,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap&quot;&gt;&lt;%=supportUploaded%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tif(supportDoc.Document_Link != null &amp;&amp; supportDoc.Document_Link != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;a class=&quot;ptd-doc-link&quot; href=&quot;&lt;%=supportDoc.Document_Link%&gt;&quot; target=&quot;_blank&quot;&gt;Open link&lt;/a&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;span class=&quot;ptd-small&quot;&gt;Stored in Creator&lt;/span&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(supportRows == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;ptd-empty&quot;&gt;No supporting documents are linked to this project yet.&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ptd-section-title&quot;&gt;\n\t\t\t\t&lt;h2&gt;Activity&lt;/h2&gt;\n\t\t\t\t&lt;span&gt;Recent Activity_Log records for this project&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card ptd-panel ptd-activity-card zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;h3&gt;Recent Project Activity&lt;/h3&gt;&lt;p class=&quot;ptd-panel-subtitle&quot;&gt;Audit trail for submissions, report generation, emailing, documents, and status changes&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;#Report:Recent_Project_Activity?Project=&lt;%=projectRec.ID%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;Activity report&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tactivityRows = 0;\n\t\t\t\t\t\tfor each activityRec in Activity_Log[Project == projectRec.ID] sort by Activity_Date_Time desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(activityRows &lt; 8)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tactivityRows = activityRows + 1;\n\t\t\t\t\t\t\t\tactivityTimeText = &quot;-&quot;;\n\t\t\t\t\t\t\t\tif(activityRec.Activity_Date_Time != null) { activityTimeText = activityRec.Activity_Date_Time.toString(&quot;dd-MMM-yyyy HH:mm&quot;); }\n\t\t\t\t\t\t\t\tactivityTypeText = ifnull(activityRec.Activity_Type,&quot;Activity&quot;);\n\t\t\t\t\t\t\t\tactivityMessageText = ifnull(activityRec.Message,&quot;No message captured.&quot;);\n\t\t\t\t\t\t\t\tactorText = ifnull(activityRec.Actor_Email,&quot;-&quot;);\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=activityTimeText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;ptd-activity-title zcs-m-0&quot;&gt;&lt;%=activityTypeText%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal&quot;&gt;Project&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ptd-activity-message zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=activityMessageText%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;ptd-activity-actor&quot;&gt;Actor: &lt;%=actorText%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(activityRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;ptd-empty zcs-w-full&quot;&gt;No activity log records are linked to this project yet.&lt;/div&gt;&lt;/li&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;%\n\t\t}\n\t}\n%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Activity_Log_On_Success as "Activity Log - Stamp Metadata"
			{
			    type = form
			    form = Activity_Log
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                logRec = Activity_Log[ID == input.ID];
			                if (logRec.count() > 0)
			                {
			                    if (logRec.Activity_Date_Time == null)
			                    {
			                        logRec.Activity_Date_Time = zoho.currenttime;
			                    }
			                    if (logRec.Actor_Email in ["", " ", "null"])
			                    {
			                        logRec.Actor_Email = zoho.loginuser;
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_Assessment_On_User_Input as "Assessment Responses - Populate Assessment Context"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			
			    on user input of Assessment
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Assessment != null)
			                {
			                    assessmentRec = Assessments[ID == input.Assessment];
			                    if (assessmentRec.count() > 0)
			                    {
			                        input.Customer = assessmentRec.Customer;
			                        input.Project = assessmentRec.Project;
			                        input.Industry_Type = assessmentRec.Industry_Type;
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Load as "Assessment Responses - Load Field Behavior"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Customer;
			                disable Project;
			                disable Industry_Type;
			                disable Master_Question;
			                disable Section_Category_Snapshot;
			                disable Question_Text_Snapshot;
			                disable Question_Type_Snapshot;
			                disable Answer_Options_Snapshot;
			                disable Help_Text_Snapshot;
			                disable Display_Order;
			                disable Mandatory;
			                disable Is_Scored;
			                disable Weightage;
			                disable Max_Score;
			                disable Question_Version_Number;
			                disable Weighted_Score;
			                if (input.Is_Scored == true)
			                {
			                    show Score;
			                    show Weighted_Score;
			                    enable Score;
			                }
			                else
			                {
			                    hide Score;
			                    hide Weighted_Score;
			                    disable Score;
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Success as "Assessment Responses - Score and Update Parent"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                respRec = Assessment_Responses[ID == input.ID];
			                if (respRec.count() > 0)
			                {
			                    if (respRec.Submitted_Response not in ["", " ", "null"])
			                    {
			                        respRec.Response_Status = "Answered";
			                    }
			                    else if (respRec.Response_Status == "Answered")
			                    {
			                        respRec.Response_Status = "In Progress";
			                    }
			                    if (respRec.Is_Scored == true)
			                    {
			                        resolvedScore = ifnull(respRec.Score,0);
			                        if (respRec.Question_Type_Snapshot in {"Yes / No", "Single Choice", "Multiple Choice", "Rating"})
			                        {
			                            optionRec = Question_Option_Scores[Question == respRec.Master_Question && Status == "Active" && Option_Label == respRec.Submitted_Response];
			                            if (optionRec.count() > 0)
			                            {
			                                resolvedScore = ifnull(optionRec.Score_Value,0);
			                            }
			                        }
			                        respRec.Score = resolvedScore;
			                        respRec.Weighted_Score = resolvedScore * ifnull(respRec.Weightage,1);
			                    }
			                    else
			                    {
			                        respRec.Score = 0;
			                        respRec.Weighted_Score = 0;
			                    }
			                    assessmentRec = Assessments[ID == respRec.Assessment];
			                    if (assessmentRec.count() > 0 && assessmentRec.Assessment_Status in {"Draft", "Reopened for Reassessment"})
			                    {
			                        assessmentRec.Assessment_Status = "In Progress";
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Validate as "Assessment Responses - Validate Response"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Assessment != null)
			                {
			                    assessmentRec = Assessments[ID == input.Assessment];
			                    if (assessmentRec.count() > 0)
			                    {
			                        if (assessmentRec.Assessment_Status in {"Submitted", "Report Generated", "Expired", "Reassessment Required"})
			                        {
			                            alert "This assessment is locked. Reopen it for reassessment before editing responses.";
			                            cancel submit;
			                        }
			                        if (input.Customer != assessmentRec.Customer)
			                        {
			                            alert "Response customer must match the parent assessment.";
			                            cancel submit;
			                        }
			                        if (input.Project != assessmentRec.Project)
			                        {
			                            alert "Response project must match the parent assessment.";
			                            cancel submit;
			                        }
			                    }
			                }
			                if (input.Is_Scored == true && ifnull(input.Max_Score,0) < 0)
			                {
			                    alert "Maximum score cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Submitted_Response_On_User_Input as "Assessment Responses - Response UI Guidance"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			
			    on user input of Submitted_Response
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Submitted_Response not in ["", " ", "null"])
			                {
			                    input.Response_Status = "Answered";
			                }
			                else
			                {
			                    input.Response_Status = "In Progress";
			                }
			                if (input.Is_Scored == true)
			                {
			                    show Score;
			                    show Weighted_Score;
			                    enable Score;
			                }
			                else
			                {
			                    hide Score;
			                    hide Weighted_Score;
			                    disable Score;
			                }
			            )
			        }
			    }
			}

			Assessment_Settings_On_Validate as "Assessment Settings - Validate Defaults"
			{
			    type = form
			    form = Assessment_Settings
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Default_Validity_Days,0) <= 0)
			                {
			                    alert "Default validity days must be greater than zero.";
			                    cancel submit;
			                }
			                if (ifnull(input.Reminder_Every_Days,0) <= 0)
			                {
			                    alert "Reminder frequency must be greater than zero.";
			                    cancel submit;
			                }
			                if (input.Status == "Active")
			                {
			                    activeSettings = Assessment_Settings[ID != input.ID && Status == "Active"];
			                    if (activeSettings.count() > 0)
			                    {
			                        alert "Only one active assessment settings record is allowed.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Mode_On_User_Input as "Assessments - Portal Email Behavior"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			
			    on user input of Assessment_Mode
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Assessment_Mode == "Customer Portal")
			                {
			                    show Customer_Portal_Email;
			                    enable Customer_Portal_Email;
			                }
			                else
			                {
			                    hide Customer_Portal_Email;
			                    disable Customer_Portal_Email;
			                }
			            )
			        }
			    }
			}

			Assessments_On_Load as "Assessments - Load Defaults and Behavior"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Validity_Period_Days,0) <= 0)
			                {
			                    settingsRec = Assessment_Settings[Status == "Active"];
			                    if (settingsRec.count() > 0)
			                    {
			                        input.Validity_Period_Days = settingsRec.Default_Validity_Days;
			                    }
			                    else
			                    {
			                        input.Validity_Period_Days = 180;
			                    }
			                }
			                if (input.Assessment_Mode == "Customer Portal")
			                {
			                    show Customer_Portal_Email;
			                    enable Customer_Portal_Email;
			                }
			                else
			                {
			                    hide Customer_Portal_Email;
			                    disable Customer_Portal_Email;
			                }
			                if (input.Assessment_Status in {"Submitted", "Report Generated", "Expired", "Reassessment Required"})
			                {
			                    disable Customer;
			                    disable Project;
			                    disable Industry_Type;
			                    disable Assessment_Mode;
			                    disable Assigned_Consultant_Email;
			                    disable Validity_Period_Days;
			                }
			            )
			        }
			    }
			}

			Assessments_On_Success as "Assessments - Update Project Stage"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                rec = Assessments[ID == input.ID];
			                if (rec.count() > 0 && rec.Project != null)
			                {
			                    projectRec = Projects[ID == rec.Project];
			                    if (projectRec.count() > 0 && projectRec.Project_Stage == "Discovery")
			                    {
			                        projectRec.Project_Stage = "Assessment In Progress";
			                    }
			                }
			            )
			        }
			    }
			}

			Assessments_On_Validate as "Assessments - Validate Assessment"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Project != null)
			                {
			                    projectRec = Projects[ID == input.Project];
			                    if (projectRec.count() > 0)
			                    {
			                        if (projectRec.Customer != input.Customer)
			                        {
			                            alert "Selected customer must match the selected project.";
			                            cancel submit;
			                        }
			                        if (projectRec.Industry_Type != input.Industry_Type)
			                        {
			                            alert "Selected industry type must match the selected project.";
			                            cancel submit;
			                        }
			                    }
			                }
			                if (input.Customer != null)
			                {
			                    customerRec = Customers[ID == input.Customer];
			                    if (customerRec.count() > 0 && customerRec.Status != "Active")
			                    {
			                        alert "Please select an active customer.";
			                        cancel submit;
			                    }
			                }
			                if (input.Industry_Type != null)
			                {
			                    industryRec = Industry_Types[ID == input.Industry_Type];
			                    if (industryRec.count() > 0 && industryRec.Status != "Active")
			                    {
			                        alert "Please select an active industry type.";
			                        cancel submit;
			                    }
			                }
			                if (input.Assessment_Mode == "Customer Portal" && input.Customer_Portal_Email in ["", " ", "null"])
			                {
			                    alert "Customer Portal Email is required for customer portal assessments.";
			                    cancel submit;
			                }
			                if (ifnull(input.Validity_Period_Days,0) <= 0)
			                {
			                    alert "Validity period days must be greater than zero.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Assessments_Project_On_User_Input as "Assessments - Populate Project Context"
			{
