			Is_Scored_On_User_Input as "Master Questionnaire - Scoring Field Behavior"
			{
			    type = form
			    form = Master_Questionnaire
			    record event = on add or edit
			
			    on user input of Is_Scored
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Is_Scored == true)
			                {
			                    show Weightage;
			                    show Max_Score;
			                    enable Weightage;
			                    enable Max_Score;
			                }
			                else
			                {
			                    input.Weightage = 1;
			                    input.Max_Score = 0;
			                    hide Weightage;
			                    hide Max_Score;
			                    disable Weightage;
			                    disable Max_Score;
			                }
			            )
			        }
			    }
			}

			Master_Questionnaire_On_Load as "Master Questionnaire - Load Field Behavior"
			{
			    type = form
			    form = Master_Questionnaire
			    record event = on add or edit
			
