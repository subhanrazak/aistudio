	menu
	{
	    unused
	    {
	        form Assessments
	        {
	            icon = "business-notes"
	        }
	        form Assessment_Responses
	        {
	            icon = "files-edit"
	        }
	        form Report_Email_Log
	        {
	            icon = "files-shared"
	        }
	        form Activity_Log
	        {
	            icon = "business-agenda"
	        }
	    }
	
	    space Consultant_Agent_Space
	    {
	        displayname = "Consultant / Agent"
	        icon = "business-businessman-04"
	
	        section Consultant_Dashboards_Section
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-bar-33"
	
	            page Current_State_Dashboard
	            {
	                icon = "business-chart-bar-33"
	            }
	            page Project_Tracking_Dashboard
	            {
	                icon = "business-strategy"
	            }
	        }
	
	        section Consultant_Customer_Project_Flow
	        {
	            displayname = "Customer & Project Flow"
	            icon = "business-handshake"
	
	            form Customers
	            {
	                icon = "users-contacts"
	            }
	            report My_Customers
	            {
	                icon = "users-circle-10"
	            }
	            form Projects
	            {
	                icon = "business-board-29"
