"Consultant_Agent"
{
    name        = "Consultant_Agent"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Consultant / Agent profile focused on the customer, project, assessment, response, document, email, and dashboard flow. Setup and portal-only reports are hidden from this profile."

    ModulePermissions
    {
        Industry_Types
        {
            enabled          = Viewall,View,Search
            allFieldsVisible = true
        }

        Customers
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                My_Customers={"View"}
            }
        }

        Projects
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                My_Projects={"View"}
                Project_Stage_Board={"View"}
                Active_Projects={"View"}
            }
        }

        Project_Documents
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                Assessment_Report_Documents={"View"}
                Supporting_Documents={"View"}
            }
        }

        Master_Questionnaire
        {
            enabled          = Viewall,View,Search
            allFieldsVisible = true
        }

        Question_Option_Scores
        {
            enabled          = Viewall,View,Search
            allFieldsVisible = true
        }

        Scoring_Maturity_Config
        {
            enabled          = Viewall,View,Search
            allFieldsVisible = true
        }

        Assessment_Settings
        {
            enabled          = Viewall,View,Search
            allFieldsVisible = true
        }

        Assessments
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                My_Assigned_Assessments={"View"}
                Internal_Assessments={"View"}
                Submitted_Assessments={"View"}
                Expiring_Assessments={"View"}
                Expired_Assessments={"View"}
                Assessment_Status_Board={"View"}
            }
        }

        Assessment_Responses
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                My_Response_Worklist={"View"}
                Needs_Review_Responses={"View"}
            }
        }

        Report_Email_Log
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                Sent_Report_Emails={"View"}
                Failed_Report_Emails={"View"}
            }
        }

        Activity_Log
        {
            enabled          = Create,Viewall,Modifyall,View,Edit,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                Recent_Project_Activity={"View"}
            }
        }

        Current_State_Dashboard
        {
            enabled = tab
        }

        Project_Tracking_Dashboard
        {
            enabled = tab
        }
    }
}
