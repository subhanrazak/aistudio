"Customer_Portal_User"
{
    name        = "Customer_Portal_User"
    type        = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Customer portal profile focused only on assessment completion and response save-and-continue access. Customer/project master tabs and generated report fields are hidden."

    ModulePermissions
    {
        Customers
        {
            enabled          = View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Customer_Name{visibility:true,readonly:true}
                Primary_Contact_Name{visibility:true,readonly:true}
                Primary_Contact_Email{visibility:true,readonly:true}
                Phone{visibility:true,readonly:true}
                Industry_Type{visibility:true,readonly:true}
                Assigned_Consultant_Email{visibility:false}
                Address_Location{visibility:false}
                Status{visibility:false}
                Notes{visibility:false}
            }
        }

        Projects
        {
            enabled          = View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Project_Name{visibility:true,readonly:true}
                Customer{visibility:true,readonly:true}
                Industry_Type{visibility:true,readonly:true}
                Assigned_Consultant_Email{visibility:false}
                Project_Stage{visibility:true,readonly:true}
                Start_Date{visibility:true,readonly:true}
                Target_Completion_Date{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Notes{visibility:false}
            }
        }

        Assessments
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            FieldPermissions
            {
                Assessment_Reference_Number{visibility:true,readonly:true}
                Customer{visibility:true,readonly:true}
                Project{visibility:true,readonly:true}
                Industry_Type{visibility:true,readonly:true}
                Assessment_Mode{visibility:true,readonly:true}
                Assessment_Status{visibility:true,readonly:true}
                Assigned_Consultant_Email{visibility:false}
                Customer_Portal_Email{visibility:true,readonly:true}
                Completed_By_Name{visibility:true,readonly:false}
                Completed_By_Email{visibility:true,readonly:false}
                Submission_Date_Time{visibility:true,readonly:true}
                Validity_Period_Days{visibility:false}
                Valid_Until_Date{visibility:true,readonly:true}
                Last_Reminder_Sent_Date{visibility:false}
                Overall_Score{visibility:false}
                Overall_Score_Percentage{visibility:false}
                Maturity_Level{visibility:false}
                Risk_Level{visibility:false}
                Report_Version_Number{visibility:false}
                Generated_PDF_Report{visibility:false}
                Report_Document_Link{visibility:false}
                Notes{visibility:true,readonly:false}
            }
            ReportPermissions
            {
                Customer_Portal_Assessments={"View"}
            }
        }

        Assessment_Responses
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            FieldPermissions
            {
                Assessment{visibility:true,readonly:true}
                Customer{visibility:true,readonly:true}
                Project{visibility:true,readonly:true}
                Industry_Type{visibility:true,readonly:true}
                Master_Question{visibility:false}
                Section_Category_Snapshot{visibility:true,readonly:true}
                Question_Text_Snapshot{visibility:true,readonly:true}
                Question_Type_Snapshot{visibility:true,readonly:true}
                Answer_Options_Snapshot{visibility:true,readonly:true}
                Help_Text_Snapshot{visibility:true,readonly:true}
                Display_Order{visibility:true,readonly:true}
                Mandatory{visibility:true,readonly:true}
                Is_Scored{visibility:false}
                Weightage{visibility:false}
                Max_Score{visibility:false}
                Question_Version_Number{visibility:false}
                Submitted_Response{visibility:true,readonly:false}
                Response_Notes{visibility:true,readonly:false}
                Score{visibility:false}
                Weighted_Score{visibility:false}
                Response_Status{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                Responses_By_Assessment={"View"}
            }
        }
    }
}
