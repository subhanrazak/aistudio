<%
  hasProjectParam = false;
  if(input.Project_ID != null)
  {
    if(input.Project_ID > 0)
    {
      hasProjectParam = true;
    }
  }
  selectedProjectCount = 0;
  if(hasProjectParam)
  {
    selectedProjectCount = Projects[ID == input.Project_ID].count();
  }
  refreshText = zoho.currenttime.toString("dd-MMM-yyyy HH:mm");
%>
<style>
/* ZCS global utility subset, included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-page-bg-color:#F3F3F4;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row-wrap{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-2{flex:0 0 16.666666%;max-width:16.666666%}.zcs-col-10{flex:0 0 83.333333%;max-width:83.333333%}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-rounded-half{border-radius:50%}.zcs-gap-0{gap:0}.zcs-gap-4{gap:4px}.zcs-gap-6{gap:6px}.zcs-gap-8{gap:8px}.zcs-gap-10{gap:10px}.zcs-gap-12{gap:12px}.zcs-gap-14{gap:14px}.zcs-gap-16{gap:16px}.zcs-gap-20{gap:20px}.zcs-gap-24{gap:24px}.zcs-gap-32{gap:32px}.zcs-p-0{padding:0}.zcs-p-8{padding:8px}.zcs-p-10{padding:10px}.zcs-p-16{padding:16px}.zcs-p-18{padding:18px}.zcs-p-20{padding:20px}.zcs-p-24{padding:24px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-px-20{padding-left:20px;padding-right:20px}.zcs-px-30{padding-left:30px;padding-right:30px}.zcs-px-60{padding-left:60px;padding-right:60px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-4{padding-top:4px;padding-bottom:4px}.zcs-py-6{padding-top:6px;padding-bottom:6px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-py-10{padding-top:10px;padding-bottom:10px}.zcs-py-12{padding-top:12px;padding-bottom:12px}.zcs-py-24{padding-top:24px;padding-bottom:24px}.zcs-m-0{margin:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-mt-4{margin-top:4px}.zcs-mt-5{margin-top:5px}.zcs-mt-8{margin-top:8px}.zcs-mt-10{margin-top:10px}.zcs-mt-12{margin-top:12px}.zcs-mt-16{margin-top:16px}.zcs-mt-20{margin-top:20px}.zcs-font-11{font-size:11px}.zcs-font-12{font-size:12px}.zcs-font-13{font-size:13px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-16{font-size:16px}.zcs-font-18{font-size:18px}.zcs-font-20{font-size:20px}.zcs-font-22{font-size:22px}.zcs-font-24{font-size:24px}.zcs-font-28{font-size:28px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-color-primary{color:var(--zcs-primary-text-color,#15172E)}.zcs-color-secondary{color:var(--zcs-secondary-text-color,#596074)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color,#84899A)}.zcs-color-white{color:#fff}.zcs-color-theme{color:var(--zcs-theme-brand-color,#0B6B62)}.zcs-card{background:var(--zcs-white-color);border:1px solid #E6E8EF;border-radius:14px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}a{text-decoration:none}
/* ZCS button component */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color,#0B6B62);color:var(--zcs_brand_foreground_color,#fff);border:1px solid var(--zcs_brand_color,#0B6B62)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color,#0B6B62);background-color:var(--zcs-white-color);color:var(--zcs_brand_color,#0B6B62)}.zcs-secondary-button{border:1px solid var(--zcs_tertiary_border_color,#DFE3EA);background-color:#F7F8FA;color:var(--zcs_primary_text_color,#15172E)}.zcs-button:hover{filter:brightness(.98)}.zcs-button-icon{width:16px;max-height:16px}
/* ZCS filled badge component */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color,#0B6B62);border-color:var(--zcs_brand_color,#0B6B62);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}
/* ZCS simple table component */
.zcs-table-wrapper{border:1px solid #E6E8EF;background-color:#fff;overflow:auto;border-radius:10px}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 #E6E8EF inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid #E6E8EF;vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-table-wrapper table tbody tr td .zcs-l_blue{color:#1094c5}
/* ZCS timeline component */
.zcs-tl-indicator{width:60px;left:16.6666666667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color,#0B6B62);border:1px solid #fff;box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}@media(max-width:768px){.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-li{flex-direction:column}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}}
/* Project tracking layout */
.ptd-page{font-family:Inter,Roboto,Arial,sans-serif;background:#F4F6F8;min-height:100%;padding:22px;box-sizing:border-box;color:#15172E}.ptd-hero{position:relative;overflow:hidden;border-radius:20px;padding:24px;background:radial-gradient(circle at 92% 14%,rgba(255,255,255,.34) 0,rgba(255,255,255,.34) 70px,transparent 72px),radial-gradient(circle at 82% 75%,rgba(255,255,255,.17) 0,rgba(255,255,255,.17) 120px,transparent 122px),linear-gradient(135deg,#102A43 0%,#0B6B62 62%,#D99A19 135%);box-shadow:0 18px 42px rgba(16,42,67,.16)}.ptd-brand-mark{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center}.ptd-hero h1{font-size:28px;margin:0;color:#fff;font-weight:700;letter-spacing:-.02em}.ptd-hero p{margin:6px 0 0;color:rgba(255,255,255,.82);font-size:14px;max-width:860px}.ptd-hero-meta{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.ptd-hero-chip{border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.12);color:#fff;border-radius:999px;padding:7px 11px;font-size:12px;display:inline-flex;gap:7px;align-items:center}.ptd-action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.ptd-action-link{background:rgba(255,255,255,.94);color:#0B5E58;border:1px solid rgba(255,255,255,.7);border-radius:10px;padding:9px 13px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:8px}.ptd-action-link.secondary{background:rgba(16,42,67,.22);color:#fff;border-color:rgba(255,255,255,.26)}.ptd-section-title{display:flex;align-items:center;justify-content:space-between;margin:22px 0 12px}.ptd-section-title h2{font-size:18px;margin:0;font-weight:700;color:#15172E}.ptd-section-title span{font-size:12px;color:#6B7280}.ptd-grid-2{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.ptd-grid-docs{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ptd-panel{padding:18px}.ptd-panel h3{font-size:16px;margin:0 0 4px;font-weight:700}.ptd-panel-subtitle{font-size:12px;color:#6B7280;margin:0 0 16px}.ptd-summary-title{font-size:22px;font-weight:800;letter-spacing:-.02em;color:#111827;margin:0}.ptd-muted{color:#6B7280}.ptd-small{font-size:12px;color:#6B7280}.ptd-nowrap{white-space:nowrap}.ptd-kpi-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:14px}.ptd-mini-kpi{border:1px solid #EEF1F5;background:#FBFCFD;border-radius:12px;padding:12px}.ptd-mini-kpi strong{display:block;font-size:22px;line-height:1.15;color:#111827}.ptd-mini-kpi span{display:block;font-size:12px;color:#6B7280;margin-top:4px}.ptd-key-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.ptd-key{border:1px solid #EEF1F5;background:#FBFCFD;border-radius:12px;padding:12px}.ptd-key label{display:block;font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.04em;font-weight:700}.ptd-key span{display:block;font-size:14px;color:#15172E;font-weight:600;margin-top:5px;word-break:break-word}.ptd-stage-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-top:16px}.ptd-stage{position:relative;border:1px solid #E6E8EF;border-radius:12px;padding:10px 8px;background:#fff;color:#6B7280;text-align:center;font-size:11px;font-weight:700;min-height:42px;display:flex;align-items:center;justify-content:center}.ptd-stage.complete{background:#E4FCF3;border-color:#179E6C;color:#0B6B62}.ptd-stage.current{background:#0B6B62;border-color:#0B6B62;color:#fff;box-shadow:0 10px 24px rgba(11,107,98,.22)}.ptd-assessment-score{font-size:42px;line-height:1;font-weight:800;letter-spacing:-.05em;color:#0B6B62;margin:12px 0 4px}.ptd-score-wrap{border-radius:16px;background:linear-gradient(135deg,#E6F5F2 0%,#FFFFFF 72%);border:1px solid #D8EEE9;padding:16px;margin-top:14px}.ptd-doc-link{font-weight:700;color:var(--zcs_brand_color,#0B6B62)}.ptd-doc-link:hover{text-decoration:underline}.ptd-empty{padding:18px;text-align:center;color:#6B7280;font-size:13px;background:#FBFCFD;border-radius:10px;border:1px dashed #DDE3EA}.ptd-empty-icon{width:58px;height:58px;border-radius:18px;background:#E6F5F2;color:#0B6B62;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:28px}.ptd-recent-list{margin-top:18px}.ptd-table-actions{display:flex;gap:8px;justify-content:flex-end}.ptd-health-banner{display:flex;align-items:center;gap:10px;padding:12px;border-radius:12px;background:#F9FAFE;border:1px solid #E6E8EF;margin-top:12px}.ptd-health-icon{width:34px;height:34px;border-radius:10px;background:#E6F5F2;color:#0B6B62;display:flex;align-items:center;justify-content:center;flex-shrink:0}.ptd-overflow{overflow:auto}.ptd-document-card .zcs-table-wrapper{max-height:360px}.ptd-activity-card{max-height:520px;overflow:auto}.ptd-activity-message{font-size:13px;color:#4B5563;margin-top:5px}.ptd-activity-title{font-size:14px;font-weight:700;color:#15172E}.ptd-activity-actor{font-size:12px;color:#8791A3;margin-top:4px}.ptd-status-pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}@media(max-width:1180px){.ptd-grid-2,.ptd-grid-docs{grid-template-columns:1fr}.ptd-kpi-row{grid-template-columns:repeat(2,minmax(0,1fr))}.ptd-stage-strip{grid-template-columns:repeat(4,1fr)}}@media(max-width:720px){.ptd-page{padding:14px}.ptd-hero{padding:18px}.ptd-hero-meta{justify-content:flex-start}.ptd-key-grid,.ptd-kpi-row{grid-template-columns:1fr}.ptd-stage-strip{grid-template-columns:1fr}.ptd-table-actions{justify-content:flex-start}.ptd-hero h1{font-size:23px}}
</style>
<div class="ptd-page">
<%
  if(!hasProjectParam || selectedProjectCount == 0)
  {
    emptyTitle = "Choose a project to track";
    emptyMessage = "Pass Project_ID in the page URL or select one of the recent active projects below to open the project-centric tracking view.";
    if(hasProjectParam && selectedProjectCount == 0)
    {
      emptyTitle = "Project not found";
      emptyMessage = "No project record was found for Project_ID " + input.Project_ID + ". Select a recent active project or open the Projects report to confirm the record.";
    }
    %>
    <div class="ptd-hero">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16" style="flex-wrap:wrap;">
        <div class="zcs-flex zcs-gap-12 zcs-align-items-center">
          <div class="ptd-brand-mark"><i class="zc-li-outline business-briefcase-24 zcs-font-24 zcs-color-white"></i></div>
          <div>
            <h1>Project Tracking Dashboard</h1>
            <p>Internal project tracking workspace for stage, latest assessment, documents, email status, and project activity.</p>
          </div>
        </div>
        <div class="ptd-hero-meta">
          <span class="ptd-hero-chip"><i class="zc-li-outline users-circle-08"></i> Internal project view</span>
          <span class="ptd-hero-chip"><i class="zc-li-outline ui-2-time"></i> Refreshed <%=refreshText%></span>
        </div>
      </div>
      <div class="ptd-action-row">
        <a class="ptd-action-link" href="#Report:Active_Projects"><i class="zc-li-outline business-briefcase-24"></i> Active Projects</a>
        <a class="ptd-action-link secondary" href="#Report:All_Projects"><i class="zc-li-outline arrows-1-tail-right"></i> All Projects</a>
      </div>
    </div>

    <div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-card zcs-p-24 zcs-box-border zcs-mt-16">
      <div class="zcs-nodata-content zcs-p-20 zcs-box-border">
        <div class="ptd-empty-icon"><i class="zc-li-outline ui-1-search"></i></div>
        <h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0"><%=emptyTitle%></h5>
        <p class="zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0"><%=emptyMessage%></p>
        <div class="zcs-row zcs-align-items-center zcs-justify-center zcs-gap-16 zcs-mt-20">
          <a class="zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Active_Projects"><i class="zcs-button-icon zc-li-outline business-briefcase-24"></i><span class="zcs-button-text">Open Active Projects</span></a>
          <a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:All_Projects"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">Browse All Projects</span></a>
        </div>
      </div>
    </div>

    <div class="ptd-section-title">
      <h2>Recent Active Projects</h2>
      <span>Select a project to open this dashboard with Project_ID</span>
    </div>
    <div class="zcs-card ptd-panel zcs-box-border ptd-overflow">
      <div class="zcs-table-wrapper">
        <table class="zcs-w-full">
          <thead>
            <tr>
              <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Project</th>
              <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Customer</th>
              <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Stage</th>
              <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Target</th>
              <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Action</th>
            </tr>
          </thead>
          <tbody>
          <%
            activeProjectRows = 0;
            for each activeProject in Projects[Status == "Active"] sort by Start_Date desc
            {
              if(activeProjectRows < 10)
              {
                activeProjectRows = activeProjectRows + 1;
                activeProjectUrl = "#Page:Project_Tracking_Dashboard?Project_ID=" + activeProject.ID;
                activeTargetText = "-";
                if(activeProject.Target_Completion_Date != null)
                {
                  activeTargetText = activeProject.Target_Completion_Date.toString("dd-MMM-yyyy");
                }
                %>
                <tr>
                  <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(activeProject.Project_Name,"Untitled project")%></strong><div class="ptd-small">ID <%=activeProject.ID%></div></td>
                  <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(activeProject.Customer.Customer_Name,"-")%></td>
                  <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=ifnull(activeProject.Project_Stage,"-")%></span></span></td>
                  <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap"><%=activeTargetText%></td>
                  <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><div class="ptd-table-actions"><a class="zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="<%=activeProjectUrl%>"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Track</span></a></div></td>
                </tr>
                <%
              }
            }
            if(activeProjectRows == 0)
            {
              %><tr><td colspan="5" class="zcs-px-16 zcs-py-8 zcs-box-border"><div class="ptd-empty">No active projects are available yet.</div></td></tr><%
            }
          %>
          </tbody>
        </table>
      </div>
    </div>
    <%
  }
  else
  {
    for each projectRec in Projects[ID == input.Project_ID]
    {
      projectName = ifnull(projectRec.Project_Name,"Untitled project");
      customerName = ifnull(projectRec.Customer.Customer_Name,"-");
      industryName = ifnull(projectRec.Industry_Type.Industry_Name,"-");
      consultantEmail = ifnull(projectRec.Assigned_Consultant_Email,"-");
      projectStage = ifnull(projectRec.Project_Stage,"-");
      projectStatus = ifnull(projectRec.Status,"-");
      projectStatusClass = "zcs-badge-grey";
      if(projectStatus == "Active") { projectStatusClass = "zcs-badge-green"; }
      else if(projectStatus == "On Hold") { projectStatusClass = "zcs-badge-yellow"; }
      else if(projectStatus == "Completed") { projectStatusClass = "zcs-badge-blue"; }
      else if(projectStatus == "Cancelled") { projectStatusClass = "zcs-badge-grey"; }
      startDateText = "-";
      if(projectRec.Start_Date != null)
      {
        startDateText = projectRec.Start_Date.toString("dd-MMM-yyyy");
      }
      targetDateText = "-";
      targetHealthText = "No target date";
      targetHealthClass = "zcs-badge-grey";
      if(projectRec.Target_Completion_Date != null)
      {
        targetDateText = projectRec.Target_Completion_Date.toString("dd-MMM-yyyy");
        targetHealthText = "Target set";
        targetHealthClass = "zcs-badge-blue";
        if(projectStatus != "Completed" && projectRec.Target_Completion_Date < zoho.currentdate)
        {
          targetHealthText = "Past target";
          targetHealthClass = "zcs-badge-red";
        }
      }
      assessmentCount = Assessments[Project == projectRec.ID].count();
      reportDocCount = Project_Documents[Project == projectRec.ID && Document_Type == "Assessment Report"].count();
      supportDocCount = Project_Documents[Project == projectRec.ID && Document_Type != "Assessment Report"].count();
      activityCount = Activity_Log[Project == projectRec.ID].count();
      projectUrl = "#Report:All_Projects?ID=" + projectRec.ID;
      assessmentsUrl = "#Report:All_Assessments?Project=" + projectRec.ID;
      documentsUrl = "#Report:All_Project_Documents?Project=" + projectRec.ID;
      latestFound = false;
      latestRef = "No assessment yet";
      latestMode = "-";
      latestStatus = "-";
      latestSubmission = "-";
      latestValidUntil = "-";
      latestScore = "Not scored";
      latestMaturity = "-";
      latestRisk = "Not rated";
      latestRiskClass = "zcs-badge-grey";
      latestStatusClass = "zcs-badge-grey";
      for each latestAssessment in Assessments[Project == projectRec.ID] sort by Submission_Date_Time desc
      {
        if(latestFound == false)
        {
          latestFound = true;
          latestRef = ifnull(latestAssessment.Assessment_Reference_Number,"Assessment " + latestAssessment.ID);
          latestMode = ifnull(latestAssessment.Assessment_Mode,"-");
          latestStatus = ifnull(latestAssessment.Assessment_Status,"-");
          if(latestAssessment.Submission_Date_Time != null)
          {
            latestSubmission = latestAssessment.Submission_Date_Time.toString("dd-MMM-yyyy HH:mm");
          }
          if(latestAssessment.Valid_Until_Date != null)
          {
            latestValidUntil = latestAssessment.Valid_Until_Date.toString("dd-MMM-yyyy");
          }
          if(latestAssessment.Overall_Score_Percentage != null)
          {
            latestScore = latestAssessment.Overall_Score_Percentage + "%";
          }
          latestMaturity = ifnull(latestAssessment.Maturity_Level,"-");
          latestRisk = ifnull(latestAssessment.Risk_Level,"Not rated");
          if(latestRisk == "High Risk") { latestRiskClass = "zcs-badge-red"; }
          else if(latestRisk == "Medium-High Risk") { latestRiskClass = "zcs-badge-orange"; }
          else if(latestRisk == "Medium Risk") { latestRiskClass = "zcs-badge-yellow"; }
          else if(latestRisk == "Low-Medium Risk") { latestRiskClass = "zcs-badge-blue"; }
          else if(latestRisk == "Low Risk") { latestRiskClass = "zcs-badge-green"; }
          if(latestStatus == "Submitted" || latestStatus == "Report Generated") { latestStatusClass = "zcs-badge-green"; }
          else if(latestStatus == "In Progress" || latestStatus == "Reopened for Reassessment") { latestStatusClass = "zcs-badge-blue"; }
          else if(latestStatus == "Expiring Soon") { latestStatusClass = "zcs-badge-yellow"; }
          else if(latestStatus == "Expired" || latestStatus == "Reassessment Required") { latestStatusClass = "zcs-badge-red"; }
        }
      }
      %>
      <div class="ptd-hero">
        <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16" style="flex-wrap:wrap;">
          <div class="zcs-flex zcs-gap-12 zcs-align-items-center">
            <div class="ptd-brand-mark"><i class="zc-li-outline business-briefcase-24 zcs-font-24 zcs-color-white"></i></div>
            <div>
              <h1><%=projectName%></h1>
              <p>Internal project tracking view for <%=customerName%>. Review stage, latest assessment, generated reports, supporting documents, email tracking, and recent activity.</p>
            </div>
          </div>
          <div class="ptd-hero-meta">
            <span class="ptd-hero-chip"><i class="zc-li-outline users-circle-08"></i> Internal project view</span>
            <span class="ptd-hero-chip"><i class="zc-li-outline ui-2-time"></i> Refreshed <%=refreshText%></span>
          </div>
        </div>
        <div class="ptd-action-row">
          <a class="ptd-action-link" href="<%=projectUrl%>"><i class="zc-li-outline business-briefcase-24"></i> Project Record / Report</a>
          <a class="ptd-action-link secondary" href="<%=assessmentsUrl%>"><i class="zc-li-outline files-single-content-03"></i> Related Assessments</a>
          <a class="ptd-action-link secondary" href="<%=documentsUrl%>"><i class="zc-li-outline files-archive-3d-content"></i> Related Documents</a>
        </div>
      </div>

      <div class="ptd-section-title">
        <h2>Project Overview</h2>
        <span>Summary and latest assessment</span>
      </div>
      <div class="ptd-grid-2">
        <div class="zcs-card ptd-panel zcs-box-border">
          <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12" style="flex-wrap:wrap;">
            <div>
              <h3 class="ptd-summary-title"><%=projectName%></h3>
              <div class="ptd-status-pill-row">
                <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=projectStage%></span></span>
                <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=projectStatusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=projectStatus%></span></span>
                <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=targetHealthClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=targetHealthText%></span></span>
              </div>
            </div>
            <a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="<%=projectUrl%>"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open</span></a>
          </div>
          <div class="ptd-key-grid">
            <div class="ptd-key"><label>Customer</label><span><%=customerName%></span></div>
            <div class="ptd-key"><label>Industry</label><span><%=industryName%></span></div>
            <div class="ptd-key"><label>Assigned Consultant</label><span><%=consultantEmail%></span></div>
            <div class="ptd-key"><label>Project Stage</label><span><%=projectStage%></span></div>
            <div class="ptd-key"><label>Status</label><span><%=projectStatus%></span></div>
            <div class="ptd-key"><label>Start Date</label><span><%=startDateText%></span></div>
            <div class="ptd-key"><label>Target Completion</label><span><%=targetDateText%></span></div>
            <div class="ptd-key"><label>Project ID</label><span><%=projectRec.ID%></span></div>
          </div>
          <div class="ptd-kpi-row">
            <div class="ptd-mini-kpi"><strong><%=assessmentCount%></strong><span>Assessments</span></div>
            <div class="ptd-mini-kpi"><strong><%=reportDocCount%></strong><span>Report documents</span></div>
            <div class="ptd-mini-kpi"><strong><%=supportDocCount%></strong><span>Supporting documents</span></div>
            <div class="ptd-mini-kpi"><strong><%=activityCount%></strong><span>Activity records</span></div>
          </div>
          <div class="ptd-stage-strip">
            <%
              stageList = {"Discovery","Assessment In Progress","Assessment Submitted","Report Generated","Review","Reassessment Required","Completed"};
              currentStageIndex = stageList.indexOf(projectStage);
              for each index stageIndex in stageList
              {
                stageValue = stageList.get(stageIndex);
                stageClass = "";
                if(currentStageIndex >= 0)
                {
                  if(stageIndex < currentStageIndex) { stageClass = "complete"; }
                  else if(stageIndex == currentStageIndex) { stageClass = "current"; }
                }
                %><div class="ptd-stage <%=stageClass%>"><%=stageValue%></div><%
              }
            %>
          </div>
        </div>

        <div class="zcs-card ptd-panel zcs-box-border">
          <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12" style="flex-wrap:wrap;">
            <div>
              <h3>Latest Assessment</h3>
              <p class="ptd-panel-subtitle">Most recent assessment linked to this project</p>
            </div>
            <a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="<%=assessmentsUrl%>"><i class="zcs-button-icon zc-li-outline files-single-content-03"></i><span>Assessments</span></a>
          </div>
          <%
            if(latestFound == false)
            {
              %><div class="ptd-empty">No assessment has been created for this project yet.</div><%
            }
            else
            {
              %>
              <div class="ptd-score-wrap">
                <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12" style="flex-wrap:wrap;">
                  <div>
                    <div class="zcs-font-13 zcs-color-tertiary zcs-uppercase zcs-font-bold">Assessment Reference</div>
                    <div class="zcs-font-20 zcs-font-bold zcs-color-primary zcs-mt-4"><%=latestRef%></div>
                  </div>
                  <div class="zcs-flex zcs-gap-8" style="flex-wrap:wrap;">
                    <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=latestStatusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=latestStatus%></span></span>
                    <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=latestRiskClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=latestRisk%></span></span>
                  </div>
                </div>
                <div class="ptd-assessment-score"><%=latestScore%></div>
                <div class="ptd-small">Overall score percentage</div>
              </div>
              <div class="ptd-key-grid">
                <div class="ptd-key"><label>Mode</label><span><%=latestMode%></span></div>
                <div class="ptd-key"><label>Status</label><span><%=latestStatus%></span></div>
                <div class="ptd-key"><label>Submission Date</label><span><%=latestSubmission%></span></div>
                <div class="ptd-key"><label>Valid Until</label><span><%=latestValidUntil%></span></div>
                <div class="ptd-key"><label>Maturity Level</label><span><%=latestMaturity%></span></div>
                <div class="ptd-key"><label>Risk Level</label><span><%=latestRisk%></span></div>
              </div>
              <%
            }
          %>
        </div>
      </div>

      <div class="ptd-section-title">
        <h2>Documents</h2>
        <span>Generated PDF assessment reports and supporting project documents</span>
      </div>
      <div class="ptd-grid-docs">
        <div class="zcs-card ptd-panel ptd-document-card zcs-box-border ptd-overflow">
          <div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12" style="flex-wrap:wrap;">
            <div><h3>Assessment Report Documents</h3><p class="ptd-panel-subtitle">Generated PDF report tracking records and email status</p></div>
            <a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="<%=documentsUrl%>"><i class="zcs-button-icon zc-li-outline files-archive-3d-content"></i><span>Open docs</span></a>
          </div>
          <div class="zcs-table-wrapper">
            <table class="zcs-w-full">
              <thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Document</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Assessment</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Uploaded</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Email</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Source</th></tr></thead>
              <tbody>
              <%
                reportRows = 0;
                for each reportDoc in Project_Documents[Project == projectRec.ID && Document_Type == "Assessment Report"] sort by Uploaded_Date desc
                {
                  if(reportRows < 8)
                  {
                    reportRows = reportRows + 1;
                    reportUploaded = "-";
                    if(reportDoc.Uploaded_Date != null) { reportUploaded = reportDoc.Uploaded_Date.toString("dd-MMM-yyyy HH:mm"); }
                    reportEmailText = "Not sent";
                    reportEmailClass = "zcs-badge-grey";
                    if(reportDoc.Email_Sent == true)
                    {
                      reportEmailText = "Sent";
                      reportEmailClass = "zcs-badge-green";
                    }
                    reportLastEmail = "";
                    if(reportDoc.Last_Emailed_Date != null) { reportLastEmail = reportDoc.Last_Emailed_Date.toString("dd-MMM-yyyy HH:mm"); }
                    %>
                    <tr>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(reportDoc.Document_Name,"Unnamed document")%></strong><div class="ptd-small">Assessment Report</div></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(reportDoc.Related_Assessment.Assessment_Reference_Number,"-")%></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap"><%=reportUploaded%></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=reportEmailClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=reportEmailText%></span></span><div class="ptd-small"><%=reportLastEmail%></div></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><%
                        if(reportDoc.Document_Link != null && reportDoc.Document_Link != "")
                        {
                          %><a class="ptd-doc-link" href="<%=reportDoc.Document_Link%>" target="_blank">Open link</a><%
                        }
                        else
                        {
                          %><span class="ptd-small">Stored in Creator</span><%
                        }
                      %></td>
                    </tr>
                    <%
                  }
                }
                if(reportRows == 0)
                {
                  %><tr><td colspan="5" class="zcs-px-16 zcs-py-8 zcs-box-border"><div class="ptd-empty">No generated assessment report document entries are linked to this project yet.</div></td></tr><%
                }
              %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="zcs-card ptd-panel ptd-document-card zcs-box-border ptd-overflow">
          <div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12" style="flex-wrap:wrap;">
            <div><h3>Supporting Documents</h3><p class="ptd-panel-subtitle">Requirement, proposal, and other non-report documents</p></div>
            <a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="#Report:Supporting_Documents?Project=<%=projectRec.ID%>"><i class="zcs-button-icon zc-li-outline files-archive-3d-content"></i><span>Supporting</span></a>
          </div>
          <div class="zcs-table-wrapper">
            <table class="zcs-w-full">
              <thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Document</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Uploaded By</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Uploaded</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Source</th></tr></thead>
              <tbody>
              <%
                supportRows = 0;
                for each supportDoc in Project_Documents[Project == projectRec.ID && Document_Type != "Assessment Report"] sort by Uploaded_Date desc
                {
                  if(supportRows < 8)
                  {
                    supportRows = supportRows + 1;
                    supportUploaded = "-";
                    if(supportDoc.Uploaded_Date != null) { supportUploaded = supportDoc.Uploaded_Date.toString("dd-MMM-yyyy HH:mm"); }
                    %>
                    <tr>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(supportDoc.Document_Name,"Unnamed document")%></strong></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12 zcs-font-normal"><%=ifnull(supportDoc.Document_Type,"-")%></span></span></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(supportDoc.Uploaded_By_Email,"-")%></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary ptd-nowrap"><%=supportUploaded%></td>
                      <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14"><%
                        if(supportDoc.Document_Link != null && supportDoc.Document_Link != "")
                        {
                          %><a class="ptd-doc-link" href="<%=supportDoc.Document_Link%>" target="_blank">Open link</a><%
                        }
                        else
                        {
                          %><span class="ptd-small">Stored in Creator</span><%
                        }
                      %></td>
                    </tr>
                    <%
                  }
                }
                if(supportRows == 0)
                {
                  %><tr><td colspan="5" class="zcs-px-16 zcs-py-8 zcs-box-border"><div class="ptd-empty">No supporting documents are linked to this project yet.</div></td></tr><%
                }
              %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="ptd-section-title">
        <h2>Activity</h2>
        <span>Recent Activity_Log records for this project</span>
      </div>
      <div class="zcs-card ptd-panel ptd-activity-card zcs-box-border">
        <div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12" style="flex-wrap:wrap;">
          <div><h3>Recent Project Activity</h3><p class="ptd-panel-subtitle">Audit trail for submissions, report generation, emailing, documents, and status changes</p></div>
          <a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13" href="#Report:Recent_Project_Activity?Project=<%=projectRec.ID%>"><i class="zcs-button-icon zc-li-outline ui-2-time"></i><span>Activity report</span></a>
        </div>
        <div class="zcs-timeline-wrapper zcs-mt-16">
          <ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
          <%
            activityRows = 0;
            for each activityRec in Activity_Log[Project == projectRec.ID] sort by Activity_Date_Time desc
            {
              if(activityRows < 8)
              {
                activityRows = activityRows + 1;
                activityTimeText = "-";
                if(activityRec.Activity_Date_Time != null) { activityTimeText = activityRec.Activity_Date_Time.toString("dd-MMM-yyyy HH:mm"); }
                activityTypeText = ifnull(activityRec.Activity_Type,"Activity");
                activityMessageText = ifnull(activityRec.Message,"No message captured.");
                actorText = ifnull(activityRec.Actor_Email,"-");
                %>
                <li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative">
                  <div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div>
                  <span class="zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=activityTimeText%></span>
                  <div class="zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8">
                      <h6 class="ptd-activity-title zcs-m-0"><%=activityTypeText%></h6>
                      <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-12 zcs-font-normal">Project</span></span>
                    </div>
                    <p class="ptd-activity-message zcs-mx-0 zcs-mb-0"><%=activityMessageText%></p>
                    <div class="ptd-activity-actor">Actor: <%=actorText%></div>
                  </div>
                </li>
                <%
              }
            }
            if(activityRows == 0)
            {
              %><li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="ptd-empty zcs-w-full">No activity log records are linked to this project yet.</div></li><%
            }
          %>
          </ul>
        </div>
      </div>
      <%
    }
  }
%>
</div>
