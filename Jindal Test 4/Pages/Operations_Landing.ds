<page linkname = "Operations_Landing" parameters = "int Financial_Year, int Plant, int Production_Line" displayname = "Operations Landing"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='Operations_Landing_Snippet' elementName='Operations_Landing_Snippet'>
          <![CDATA[htmlpage Operations_Landing_Snippet()
content
			<%{%>
            <file name:Operations_Landing_Snippet.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Operations_Availability_Matrix' elementName='Operations_Availability_Matrix'>
          <![CDATA[htmlpage Operations_Availability_Matrix()
content
			<%{%>
            <file name:Operations_Availability_Matrix.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Operations_Production_Matrix' elementName='Operations_Production_Matrix'>
          <![CDATA[htmlpage Operations_Production_Matrix()
content
			<%{%>
            <file name:Operations_Production_Matrix.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:Capacity_By_Line_Embed.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Operations_Production_By_Product_Embed.ds/> </column>
		</row>
	</layout>
</zml>
</content>