<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "System Administrator";
	activeUsers = Add_Users[ID != 0].count();
	activeDelegations = Approval_Delegations[Active == true].count();
	allDelegations = Approval_Delegations[ID != 0].count();
	criticalEvents = Approval_Audit_Log[Action in {"Returned","Revision Requested","Revision Copy Created","Reopened","Locked","Final Approved","Cancelled"}].count();
	recentCriticalEvents = Approval_Audit_Log[Action in {"Returned","Revision Requested","Revision Copy Created","Reopened","Locked","Final Approved","Cancelled"} && Action_On >= zoho.currenttime.subDay(7)].count();
	openSetupItems = Budget_Cycles[Status == "Open" || Status == "In Planning" || Status == "Under Review" || Status == "Reopened"].count() + Financial_Years[Status == "Open" || Status == "Pending Sales" || Status == "Pending Operations" || Status == "Pending SCM" || Status == "Pending Finance"].count();
	financialYearTotal = Financial_Years[ID != 0].count();
	financialYearActive = Financial_Years[Active == true].count();
	plantTotal = Plants[ID != 0].count();
	plantActive = Plants[Active == true].count();
	lineTotal = Production_Lines[ID != 0].count();
	lineActive = Production_Lines[Active == true].count();
	gradeTotal = Market_Segments[ID != 0].count();
	gradeActive = Market_Segments[Active == true].count();
	productTotal = Steel_Grades[ID != 0].count();
	productActive = Steel_Grades[Active == true].count();
	finishTotal = Finish_Types[ID != 0].count();
	finishActive = Finish_Types[Active == true].count();
	rawMaterialTotal = Raw_Materials[ID != 0].count();
	rawMaterialActive = Raw_Materials[Active == true].count();
	consumableTotal = Consumables[ID != 0].count();
	consumableActive = Consumables[Active == true].count();
	masterDomains = 8;
	masterDomainsReady = 0;
	if(financialYearActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		financialYearStatus = "Ready";
		financialYearClass = "zcs-green";
	}
	else
	{
		financialYearStatus = "Missing";
		financialYearClass = "zcs-red";
	}
	if(plantActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		plantStatus = "Ready";
		plantClass = "zcs-green";
	}
	else
	{
		plantStatus = "Missing";
		plantClass = "zcs-red";
	}
	if(lineActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		lineStatus = "Ready";
		lineClass = "zcs-green";
	}
	else
	{
		lineStatus = "Missing";
		lineClass = "zcs-red";
	}
	if(gradeActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		gradeStatus = "Ready";
		gradeClass = "zcs-green";
	}
	else
	{
		gradeStatus = "Missing";
		gradeClass = "zcs-red";
	}
	if(productActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		productStatus = "Ready";
		productClass = "zcs-green";
	}
	else
	{
		productStatus = "Missing";
		productClass = "zcs-red";
	}
	if(finishActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		finishStatus = "Ready";
		finishClass = "zcs-green";
	}
	else
	{
		finishStatus = "Missing";
		finishClass = "zcs-red";
	}
	if(rawMaterialActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		rawMaterialStatus = "Ready";
		rawMaterialClass = "zcs-green";
	}
	else
	{
		rawMaterialStatus = "Missing";
		rawMaterialClass = "zcs-red";
	}
	if(consumableActive > 0)
	{
		masterDomainsReady = masterDomainsReady + 1;
		consumableStatus = "Ready";
		consumableClass = "zcs-green";
	}
	else
	{
		consumableStatus = "Missing";
		consumableClass = "zcs-red";
	}
	masterCompleteness = 0;
	if(masterDomains > 0)
	{
		masterCompleteness = (masterDomainsReady * 100) / masterDomains;
	}
	%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#F3F3F4}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-shrink{flex-shrink:0}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.98)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-notes-text a:hover{text-decoration:underline}
.dl-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;color:var(--zcs_primary_text_color);min-height:100%}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:18px;align-items:flex-start;box-shadow:0 12px 30px rgba(20,37,63,.12)}.dl-hero h2{margin:0 0 8px;font-size:26px;line-height:1.2}.dl-hero p{margin:0;opacity:.92;max-width:780px}.dl-hero a{color:var(--zcs_brand_foreground_color);border-color:rgba(255,255,255,.55)}.dl-hero-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end}.dl-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:16px}.dl-kpi{text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:12px;min-height:172px;transition:border-color .15s ease,transform .15s ease}.dl-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.dl-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.dl-kpi-icon{width:38px;height:38px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:20px;flex-shrink:0}.dl-kpi-value{font-size:32px;font-weight:700;line-height:1.05;color:var(--zcs_primary_text_color)}.dl-kpi-note{color:var(--zcs_secondary_text_color);font-size:13px;line-height:1.45}.dl-command-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.dl-layout{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.35fr);gap:16px;margin-top:16px}.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:16px;padding:18px;box-sizing:border-box}.dl-panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-top:10px;text-decoration:none;color:inherit;background:#fff}.dl-action:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.dl-action-main{display:flex;gap:10px;align-items:flex-start}.dl-action-icon{color:var(--zcs_brand_color);font-size:18px;margin-top:2px}.dl-count{font-size:18px;font-weight:700;color:var(--zcs_brand_color)}.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px;line-height:1.45}.dl-table-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-weight:600}.dl-insight-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.dl-mini{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:14px}.dl-mini strong{display:block;margin-bottom:6px}@media(max-width:1180px){.dl-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.dl-layout{grid-template-columns:1fr}}@media(max-width:760px){.dl-shell{padding:14px}.dl-hero{flex-direction:column}.dl-hero-actions{justify-content:flex-start}.dl-kpi-grid,.dl-insight-grid{grid-template-columns:1fr}.dl-command-row .zcs-button{width:100%}}
</style>
<div class='dl-shell'>
	<div class='dl-hero'>
		<div>
			<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'>
				<i class='zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01'></i>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=profileText%></span>
			</div>
			<h2 class='zcs-mt-12'>System Admin Command Center</h2>
			<p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Monitor users, master-data readiness, approval delegations and audit exceptions through safe setup navigation.</p>
		</div>
		<div class='dl-hero-actions'>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Users'>
				<i class='zcs-button-icon zc-li-outline users-contacts'></i><span class='zcs-button-text'>Users</span>
			</a>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog'>
				<i class='zcs-button-icon zc-li-outline files-search'></i><span class='zcs-button-text'>Audit logs</span>
			</a>
		</div>
	</div>
	<div class='dl-kpi-grid'>
		<a class='zcs-card dl-kpi zcs-p-20 zcs-box-border' href='#Report:All_Users'>
			<div class='dl-kpi-top'><span class='dl-kpi-icon'><i class='zc-li-outline users-single-01'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><i class='zc-li-outline ui-1-check-circle-08'></i><span class='zcs-font-12'>Roster</span></span></div>
			<div><div class='dl-kpi-value'><%=activeUsers%></div><div class='zcs-font-14 zcs-font-medium zcs-color-primary'>Active users</div></div>
			<div class='dl-kpi-note'>Configured application users. Add or verify users through the Users report or form.</div>
		</a>
		<a class='zcs-card dl-kpi zcs-p-20 zcs-box-border' href='#Report:All_Plants?zc_LoadIn=dialog'>
			<div class='dl-kpi-top'><span class='dl-kpi-icon'><i class='zc-li-outline business-books'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><i class='zc-li-outline ui-1-check-circle-08'></i><span class='zcs-font-12'><%=masterDomainsReady%>/<%=masterDomains%></span></span></div>
			<div><div class='dl-kpi-value'><%=masterCompleteness%>%</div><div class='zcs-font-14 zcs-font-medium zcs-color-primary'>Master data completeness</div></div>
			<div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=masterCompleteness%>%;'></div></div>
		</a>
		<a class='zcs-card dl-kpi zcs-p-20 zcs-box-border' href='#Report:All_Approval_Delegations?zc_LoadIn=dialog'>
			<div class='dl-kpi-top'><span class='dl-kpi-icon'><i class='zc-li-outline users-network'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><i class='zc-li-outline ui-2-time'></i><span class='zcs-font-12'><%=allDelegations%> total</span></span></div>
			<div><div class='dl-kpi-value'><%=activeDelegations%></div><div class='zcs-font-14 zcs-font-medium zcs-color-primary'>Active delegations</div></div>
			<div class='dl-kpi-note'>Review active delegator and delegate coverage before approval cycles progress.</div>
		</a>
		<a class='zcs-card dl-kpi zcs-p-20 zcs-box-border' href='#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog'>
			<div class='dl-kpi-top'><span class='dl-kpi-icon'><i class='zc-li-outline files-search'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><i class='zc-li-outline ui-2-time'></i><span class='zcs-font-12'><%=recentCriticalEvents%> last 7 days</span></span></div>
			<div><div class='dl-kpi-value'><%=criticalEvents%></div><div class='zcs-font-14 zcs-font-medium zcs-color-primary'>Critical audit events</div></div>
			<div class='dl-kpi-note'>Returned, reopened, revision, lock, final approval or cancellation audit entries.</div>
		</a>
		<a class='zcs-card dl-kpi zcs-p-20 zcs-box-border' href='#Report:Active_Budget_Cycles?zc_LoadIn=dialog'>
			<div class='dl-kpi-top'><span class='dl-kpi-icon'><i class='zc-li-outline business-progress'></i></span><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><i class='zc-li-outline arrows-1-refresh-68'></i><span class='zcs-font-12'>Status based</span></span></div>
			<div><div class='dl-kpi-value'><%=openSetupItems%></div><div class='zcs-font-14 zcs-font-medium zcs-color-primary'>Open or reopened setup items</div></div>
			<div class='dl-kpi-note'>Budget cycle and financial-year setup records that remain open, pending or reopened.</div>
		</a>
	</div>
	<div class='dl-command-row'>
		<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Add_Users?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline users-add-27'></i><span class='zcs-button-text'>Add user</span></a>
		<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Users'><i class='zcs-button-icon zc-li-outline users-contacts'></i><span class='zcs-button-text'>View users</span></a>
		<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Approval_Delegations?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i><span class='zcs-button-text'>Add delegation</span></a>
		<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Approval_Delegations?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline users-network'></i><span class='zcs-button-text'>Delegation report</span></a>
		<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline files-search'></i><span class='zcs-button-text'>Audit report</span></a>
	</div>
	<div class='dl-layout'>
		<div class='dl-panel'>
			<div class='dl-panel-title'><h3 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Pending actions</h3><span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><i class='zc-li-outline ui-1-lock'></i><span class='zcs-font-12'>Safe navigation</span></span></div>
			<a class='dl-action' href='#Report:All_Users'><span class='dl-action-main'><i class='zc-li-outline users-contacts dl-action-icon'></i><span><strong class='zcs-font-14'>Review user access roster</strong><span class='dl-muted'>Open the user report before adding or updating access.</span></span></span><span class='dl-count'><%=activeUsers%></span></a>
			<a class='dl-action' href='#Form:Add_Users?zc_LoadIn=dialog'><span class='dl-action-main'><i class='zc-li-outline users-add-27 dl-action-icon'></i><span><strong class='zcs-font-14'>Open Add Users form</strong><span class='dl-muted'>Setup changes open in a dialog form.</span></span></span><i class='zc-li-outline arrows-1-tail-right zcs-color-theme'></i></a>
			<a class='dl-action' href='#Report:All_Approval_Delegations?zc_LoadIn=dialog'><span class='dl-action-main'><i class='zc-li-outline users-network dl-action-icon'></i><span><strong class='zcs-font-14'>Review approval delegations</strong><span class='dl-muted'>Validate delegates, modules and active windows.</span></span></span><span class='dl-count'><%=activeDelegations%></span></a>
			<a class='dl-action' href='#Form:Approval_Delegations?zc_LoadIn=dialog'><span class='dl-action-main'><i class='zc-li-outline ui-1-simple-add dl-action-icon'></i><span><strong class='zcs-font-14'>Open delegation setup form</strong><span class='dl-muted'>Create or revise delegation records through the form only.</span></span></span><i class='zc-li-outline arrows-1-tail-right zcs-color-theme'></i></a>
			<a class='dl-action' href='#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog'><span class='dl-action-main'><i class='zc-li-outline files-search dl-action-icon'></i><span><strong class='zcs-font-14'>Review audit exceptions</strong><span class='dl-muted'>Inspect critical audit events and exception history.</span></span></span><span class='dl-count'><%=criticalEvents%></span></a>
			<a class='dl-action' href='#Report:Active_Budget_Cycles?zc_LoadIn=dialog'><span class='dl-action-main'><i class='zc-li-outline business-progress dl-action-icon'></i><span><strong class='zcs-font-14'>Check open or reopened setup items</strong><span class='dl-muted'>Status-based setup exceptions are surfaced through existing reports.</span></span></span><span class='dl-count'><%=openSetupItems%></span></a>
		</div>
		<div class='dl-panel'>
			<div class='dl-panel-title'><h3 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Master data coverage</h3><span class='dl-muted'><%=masterDomainsReady%> of <%=masterDomains%> domains have active records</span></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead>
						<tr>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Domain</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Active / Total</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Safe navigation</th>
						</tr>
					</thead>
					<tbody>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Financial years</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=financialYearActive%> / <%=financialYearTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=financialYearClass%>'><%=financialYearStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Financial_Years?zc_LoadIn=dialog'>All Financial Years <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Plants</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=plantActive%> / <%=plantTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=plantClass%>'><%=plantStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Plants?zc_LoadIn=dialog'>All Plants <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Production lines</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=lineActive%> / <%=lineTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=lineClass%>'><%=lineStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Production_Lines?zc_LoadIn=dialog'>All Production Lines <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Grades</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=gradeActive%> / <%=gradeTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=gradeClass%>'><%=gradeStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Market_Segments?zc_LoadIn=dialog'>All Grades <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Products</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=productActive%> / <%=productTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=productClass%>'><%=productStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Steel_Grades?zc_LoadIn=dialog'>All Products <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Finish types</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=finishActive%> / <%=finishTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=finishClass%>'><%=finishStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Finish_Types?zc_LoadIn=dialog'>All Finish Types <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Raw materials</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=rawMaterialActive%> / <%=rawMaterialTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=rawMaterialClass%>'><%=rawMaterialStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Raw_Materials?zc_LoadIn=dialog'>All Raw Materials <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Consumables</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=consumableActive%> / <%=consumableTotal%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 <%=consumableClass%>'><%=consumableStatus%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='dl-table-link' href='#Report:All_Consumables?zc_LoadIn=dialog'>All Consumables <i class='zc-li-outline arrows-1-tail-right'></i></a></td></tr>
					</tbody>
				</table>
			</div>
			<div class='zcs-notes-wrapper zcs-mt-16'>
				<p class='zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='zcs-notes-title zcs-font-medium zcs-color-tertiary'>Navigation note: </span>Setup changes are intentionally routed to Creator forms and reports only. No direct report workflow buttons are exposed from this landing page.</p>
			</div>
		</div>
	</div>
	<div class='dl-insight-grid'>
		<div class='dl-mini'><strong class='zcs-color-primary'>Delegation hygiene</strong><div class='dl-muted'>Review <a class='zcs-color-theme zcs-font-medium' href='#Report:All_Approval_Delegations?zc_LoadIn=dialog'>All Approval Delegations</a> before peak approval windows, then use the delegation form for controlled setup updates.</div></div>
		<div class='dl-mini'><strong class='zcs-color-primary'>Audit exception handling</strong><div class='dl-muted'>Critical events should be investigated in <a class='zcs-color-theme zcs-font-medium' href='#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog'>All Approval Audit Logs</a> with module, actor and action filters.</div></div>
	</div>
</div>