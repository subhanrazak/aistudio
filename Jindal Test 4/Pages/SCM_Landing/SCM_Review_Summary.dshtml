<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "SCM Central PPC";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	readyPlans = Volume_Consolidations[Status == "Under SCM Review" && Locked != true];
	revisionPlans = Volume_Consolidations[Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" && Locked != true];
	approvedPlans = Volume_Consolidations[Status == "SCM Approved"];
	lockedPlans = Volume_Consolidations[Status == "Locked" || Locked == true];
	pendingPlans = Volume_Consolidations[Status == "Under SCM Review" || Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" && Locked != true];
	insightPlans = Volume_Consolidations[Status == "Under SCM Review" || Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" || Status == "SCM Approved" || Status == "Locked" || Locked == true];
	approvedLockedPlans = Volume_Consolidations[Status == "SCM Approved" || Status == "Locked" || Locked == true];
	readyCount = readyPlans.count();
	revisionCount = revisionPlans.count();
	approvedCount = approvedPlans.count();
	lockedCount = lockedPlans.count();
	pendingDecisionCount = readyCount + revisionCount;
	approvedLockedCount = approvedLockedPlans.count();
	totalSalesTarget = 0.0;
	totalOperationsProduction = 0.0;
	totalToBeRaised = 0.0;
	totalCostForecast = 0.0;
	insightRowCount = 0;
	pendingMatrixRowCount = 0;
	approvedLockedRowCount = 0;
	approvedLockedToBeRaised = 0.0;
	approvedLockedCostForecast = 0.0;
	for each  plan in insightPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			totalSalesTarget = totalSalesTarget + ifnull(line.Sales_Target_Tons,0);
			totalOperationsProduction = totalOperationsProduction + ifnull(line.Operations_Production_Tons,0);
			totalToBeRaised = totalToBeRaised + ifnull(line.To_Be_Raised_MT,0);
			totalCostForecast = totalCostForecast + ifnull(line.Cost_Forecast,0);
			insightRowCount = insightRowCount + 1;
		}
	}
	for each  plan in pendingPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			pendingMatrixRowCount = pendingMatrixRowCount + 1;
		}
	}
	for each  plan in approvedLockedPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			approvedLockedRowCount = approvedLockedRowCount + 1;
			approvedLockedToBeRaised = approvedLockedToBeRaised + ifnull(line.To_Be_Raised_MT,0);
			approvedLockedCostForecast = approvedLockedCostForecast + ifnull(line.Cost_Forecast,0);
		}
	}
	focusTitle = "No pending SCM decisions";
	focusText = "Ready and revision queues are clear. Use revision history for audit review and keep monitoring approved or locked plans through the insight metrics.";
	focusHref = "#Report:SCM_Revision_History?zc_LoadIn=dialog";
	focusCta = "Review history";
	focusIcon = "ui-1-check-circle-08";
	focusClass = "scm-focus-clear";
	if(readyCount > 0)
	{
		focusTitle = "Start with SCM-ready plans";
		focusText = readyCount + " plan(s) are ready for SCM decision. Review the matrix first, then use the source report to approve or open the replanning request form when remarks are required.";
		focusHref = "#Report:SCM_Ready_For_Review?zc_LoadIn=dialog";
		focusCta = "Open ready queue";
		focusIcon = "ui-1-check-circle-08";
		focusClass = "scm-focus-ready";
	}
	else if(revisionCount > 0)
	{
		focusTitle = "Follow up revision requests";
		focusText = revisionCount + " plan(s) are waiting on Sales or Operations revision. Use the revision queue and capture any reason or remarks through Replanning Requests.";
		focusHref = "#Report:SCM_Revision_Requests?zc_LoadIn=dialog";
		focusCta = "Open revision queue";
		focusIcon = "ui-2-time";
		focusClass = "scm-focus-revision";
	}
	%>
<style>
/* zcs-global utility subset included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0%}.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}
/* ZCS card, table, timeline, badge and button components */
.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094c5}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color);border:1px solid var(--zcs-white-color);box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}
.scm-workbench{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.scm-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start;position:relative;overflow:hidden}.scm-hero:after{content:'';position:absolute;right:-90px;top:-110px;width:290px;height:290px;border:34px solid rgba(255,255,255,.10);border-radius:50%}.scm-hero>*{position:relative;z-index:1}.scm-hero h1{margin:0 0 8px;font-size:26px;line-height:1.2}.scm-hero p{margin:0;opacity:.92;max-width:960px}.scm-hero-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px;color:var(--zcs_brand_foreground_color);white-space:nowrap}.scm-kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(170px,1fr));gap:14px;margin-top:16px}.scm-kpi{min-height:140px;display:flex;flex-direction:column;justify-content:space-between}.scm-kpi-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.scm-kpi-value{font-size:26px;font-weight:700;line-height:1.1;color:var(--zcs_primary_text_color);margin-top:10px}.scm-kpi-sub{font-size:12px;color:var(--zcs_tertiary_text_color);margin-top:6px}.scm-section{margin-top:16px}.scm-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.scm-section-head h2{margin:0;font-size:20px;color:var(--zcs_primary_text_color)}.scm-note{font-size:13px;color:var(--zcs_secondary_text_color)}.scm-action-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px;margin-top:16px}.scm-focus-card{border-left:5px solid var(--zcs_brand_color);display:flex;gap:16px;align-items:flex-start;min-height:180px}.scm-focus-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);flex:0 0 auto}.scm-focus-card h2{margin:0 0 8px;font-size:22px;color:var(--zcs_primary_text_color)}.scm-focus-card p{margin:0 0 16px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-focus-revision{border-left-color:#F4660C}.scm-focus-revision .scm-focus-icon{background:#F8F0EB;color:#F4660C}.scm-focus-clear{border-left-color:#179E6C}.scm-focus-clear .scm-focus-icon{background:#E4FCF3;color:#179E6C}.scm-pending-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scm-action-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border:1px solid #e7e7ee;border-radius:12px;background:#fff;box-sizing:border-box;color:var(--zcs_primary_text_color)}.scm-action-card:hover{background:var(--zcs_component_hover_color)}.scm-action-left{display:flex;gap:12px;align-items:center}.scm-action-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.scm-action-title{font-weight:600;font-size:14px;color:var(--zcs_primary_text_color)}.scm-action-sub{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:2px}.scm-guidance-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.scm-guidance-card{display:flex;gap:14px;align-items:flex-start}.scm-guidance-card i{color:var(--zcs_brand_color);font-size:22px;margin-top:2px}.scm-guidance-card h3{margin:0 0 6px;font-size:16px;color:var(--zcs_primary_text_color)}.scm-guidance-card p{margin:0 0 12px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-insight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.scm-insight-item{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:14px}.scm-insight-label{font-size:12px;color:var(--zcs_secondary_text_color);margin-bottom:6px}.scm-insight-value{font-size:20px;font-weight:700;color:var(--zcs_primary_text_color)}.scm-dual-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.scm-comments{max-width:280px;white-space:normal}.scm-empty{padding:24px;text-align:center;color:var(--zcs_secondary_text_color);background:#fff;border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.scm-empty i{margin-right:8px;color:var(--zcs_brand_color)}.scm-mini-table td,.scm-mini-table th{font-size:13px}.scm-panel{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px;box-sizing:border-box}.scm-inline-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}@media(max-width:1440px){.scm-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:1280px){.scm-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.scm-dual-grid,.scm-guidance-grid,.scm-action-grid{grid-template-columns:1fr}.scm-insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:768px){.scm-workbench{padding:12px}.scm-hero{flex-direction:column}.scm-kpi-grid,.scm-pending-actions,.scm-insight-grid{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li{flex-direction:column}.zcs-px-60{padding-left:3.75rem;padding-right:1rem}.scm-section-head{align-items:flex-start;flex-direction:column}}
</style>
<div class='scm-workbench'>
	<div class='scm-hero'>
		<div>
			<h1>SCM Review Workbench</h1>
			<p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Pending decisions now show only SCM-ready and revision-request records. SCM Approved and Locked records are retained in KPI and insight metrics, but are kept out of pending action lists.</p>
		</div>
		<span class='scm-hero-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span>
	</div>

	<div class='scm-kpi-grid'>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>SCM-ready plans</div><div class='scm-kpi-value'><%=readyCount%></div><div class='scm-kpi-sub'>Open decisions only</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-2-time'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Revision requests pending</div><div class='scm-kpi-value'><%=revisionCount%></div><div class='scm-kpi-sub'>Sales or Operations follow-up</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-1-check-bold'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>SCM-approved plans</div><div class='scm-kpi-value'><%=approvedCount%></div><div class='scm-kpi-sub'><%=lockedCount%> locked plan(s) in insights</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline business-chart-bar-32'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Total sales target tons</div><div class='scm-kpi-value'><%=totalSalesTarget%></div><div class='scm-kpi-sub'>Pending plus finalised insight set</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline business-factory'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Operations production tons</div><div class='scm-kpi-value'><%=totalOperationsProduction%></div><div class='scm-kpi-sub'>SCM-visible records</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline e-commerce-shopping-cart-simple'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Raw material to be raised</div><div class='scm-kpi-value'><%=totalToBeRaised%></div><div class='scm-kpi-sub'>MT shortfall basis</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline business-money-coins'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Forecast cost</div><div class='scm-kpi-value'><%=totalCostForecast%></div><div class='scm-kpi-sub'>All SCM insight rows</div></div></div>
	</div>

	<div class='scm-action-grid'>
		<div class='zcs-card zcs-p-24 zcs-box-border scm-focus-card <%=focusClass%>'>
			<div class='scm-focus-icon'><i class='zc-li-outline <%=focusIcon%>'></i></div>
			<div>
				<h2><%=focusTitle%></h2>
				<p><%=focusText%></p>
				<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=focusHref%>'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span><%=focusCta%></span></a>
			</div>
		</div>
		<div class='zcs-card zcs-p-20 zcs-box-border'>
			<div class='scm-section-head'><h2>Pending actions</h2><span class='scm-note'><%=pendingDecisionCount%> active plan(s); approved and locked records excluded</span></div>
			<div class='scm-pending-actions'>
				<a class='scm-action-card' href='#Report:SCM_Ready_For_Review?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><span><span class='scm-action-title'>SCM ready for review</span><span class='scm-action-sub'>Open decision queue</span></span></span><strong><%=readyCount%></strong></a>
				<a class='scm-action-card' href='#Report:SCM_Revision_Requests?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline ui-2-time'></i></span><span><span class='scm-action-title'>Revision requests</span><span class='scm-action-sub'>Pending Sales or Operations rework</span></span></span><strong><%=revisionCount%></strong></a>
				<a class='scm-action-card' href='#Form:Replanning_Requests?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline ui-1-edit-72'></i></span><span><span class='scm-action-title'>Raise replanning request</span><span class='scm-action-sub'>Use when reason or remarks are required</span></span></span><i class='zc-li-outline arrows-1-tail-right'></i></a>
				<a class='scm-action-card' href='#Report:SCM_Revision_History?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline files-single-folded-content'></i></span><span><span class='scm-action-title'>Revision history</span><span class='scm-action-sub'>Audit requests and outcomes</span></span></span><i class='zc-li-outline arrows-1-tail-right'></i></a>
			</div>
		</div>
	</div>

	<div class='scm-section'>
		<div class='scm-section-head'>
			<h2>SCM option guidance</h2>
			<div class='scm-inline-actions'>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Revision_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span class='zcs-button-text'>Open revision queue</span></a>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Replanning_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span class='zcs-button-text'>Raise request with remarks</span></a>
			</div>
		</div>
		<div class='scm-guidance-grid'>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline business-chart-bar-32'></i><div><h3>Request Sales revision</h3><p>Use when demand, grade mix, product mix, or sales target tons need correction before SCM approval.</p><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Replanning_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Raise request</span></a></div></div>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline business-factory'></i><div><h3>Request Operations revision</h3><p>Use when production tons, BTV measured MT, or operational feasibility needs rework.</p><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Replanning_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Raise request</span></a></div></div>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline ui-2-time'></i><div><h3>Request both revisions</h3><p>Use when Sales demand and Operations production both require replanning to resolve raw-material gaps.</p><a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Replanning_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Raise request</span></a></div></div>
		</div>
	</div>

	<div class='scm-section zcs-card zcs-p-24 zcs-box-border'>
		<div class='scm-section-head'>
			<h2>Approved and locked insights</h2>
			<span class='scm-note'>Finalised or locked rows are excluded from pending lists and retained here for context</span>
		</div>
		<div class='scm-insight-grid'>
			<div class='scm-insight-item'><div class='scm-insight-label'>Approved or locked plans</div><div class='scm-insight-value'><%=approvedLockedCount%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Approved or locked matrix rows</div><div class='scm-insight-value'><%=approvedLockedRowCount%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Finalised raw material MT</div><div class='scm-insight-value'><%=approvedLockedToBeRaised%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Finalised forecast cost</div><div class='scm-insight-value'><%=approvedLockedCostForecast%></div></div>
		</div>
	</div>

	<div class='scm-section scm-dual-grid'>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Records needing SCM decisions</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Ready_For_Review?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Open ready report</span></a></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Plan</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Plant</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Cycle</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th></tr></thead>
					<tbody>
<%
	readyIndex = 0;
	for each  plan in readyPlans
	{
		readyIndex = readyIndex + 1;
		if(readyIndex <= 6)
		{
			%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Volume_Consolidations?Consolidation_No=<%=plan.Consolidation_No%>'><%=ifnull(plan.Consolidation_No,"-")%></a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(plan.Plant,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(plan.Budget_Cycle,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>Under SCM Review</span></span></td></tr>
<%
		}
	}
	if(readyIndex == 0)
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary' colspan='4'>No SCM-ready plans are waiting for decision.</td></tr>
<%
	}
	%>
</tbody>
				</table>
			</div>
		</div>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Revision requests pending</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Revision_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Open revision report</span></a></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Plan</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Requested to</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Action</th></tr></thead>
					<tbody>
<%
	revisionIndex = 0;
	for each  plan in revisionPlans
	{
		revisionIndex = revisionIndex + 1;
		if(revisionIndex <= 6)
		{
			requestedTo = "-";
			for each  rev in plan.Revision_History_Lines_Existing
			{
				if(requestedTo == "-")
				{
					requestedTo = ifnull(rev.Requested_To,"-");
				}
			}
			%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Volume_Consolidations?Consolidation_No=<%=plan.Consolidation_No%>'><%=ifnull(plan.Consolidation_No,"-")%></a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=requestedTo%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=ifnull(plan.Status,"-")%></span></span></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body'><a class='zcs-color-theme' href='#Form:Replanning_Requests?zc_LoadIn=dialog'>Open request form</a></td></tr>
<%
		}
	}
	if(revisionIndex == 0)
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary' colspan='4'>No revision requests are pending with SCM.</td></tr>
<%
	}
	%>
</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class='scm-section zcs-card zcs-p-24 zcs-box-border'>
		<div class='scm-section-head'>
			<h2>Pending SCM review matrix by grade and product</h2>
			<span class='scm-note'><%=pendingMatrixRowCount%> actionable row(s); SCM Approved and Locked rows are excluded here</span>
		</div>
<%
	if(pendingMatrixRowCount == 0)
	{
		%>
<div class='scm-empty'><i class='zc-li-outline ui-1-check-circle-08'></i>No consolidation rows are currently waiting for SCM decision.</div>
<%
	}
	else
	{
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead class='zcs-sticky'>
						<tr>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Plan</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Grade</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Product</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Sales Target Tons</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Operations Production Tons</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>BTV Measured MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Required Raw Material MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Available Raw Material MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>To Be Raised MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Cost Forecast</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Override comments</th>
						</tr>
						<tr class='zcs-tspace'><th class='zcs-p-0 zcs-box-border' colspan='12'></th></tr>
					</thead>
					<tbody>
<%
		for each  plan in pendingPlans
		{
			for each  line in plan.SCM_Review_Lines_Existing
			{
				statusName = ifnull(plan.Status,"-");
				statusClass = "zcs-badge-blue";
				if(statusName == "Revision Requested" || statusName == "Sales Revision Pending" || statusName == "Operations Revision Pending" || statusName == "Both Revisions Pending")
				{
					statusClass = "zcs-badge-orange";
				}
				%>
<tr>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Volume_Consolidations?Consolidation_No=<%=plan.Consolidation_No%>'><%=ifnull(plan.Consolidation_No,"-")%></a></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=statusName%></span></span></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Grade,"-")%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Product,"-")%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Sales_Target_Tons,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Operations_Production_Tons,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.BTV_Measured_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Required_Raw_Material_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Available_Raw_Material_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.To_Be_Raised_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Cost_Forecast,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary scm-comments'><%=ifnull(line.Override_Comments,"-")%></td>
						</tr>
<%
			}
		}
		%>
</tbody>
				</table>
			</div>
<%
	}
	%>
</div>

	<div class='scm-section scm-dual-grid'>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Revision history timeline</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Revision_History?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Open history report</span></a></div>
			<div class='zcs-timeline-wrapper'>
				<ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
<%
	timelineCount = 0;
	for each  plan in insightPlans
	{
		for each  rev in plan.Revision_History_Lines_Existing
		{
			timelineCount = timelineCount + 1;
			if(timelineCount <= 8)
			{
				revStatus = ifnull(rev.Revision_Status,"Revision requested");
				%>
<li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'>
						<div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div>
						<span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right'><%=ifnull(rev.Requested_On,"-")%></span>
						<div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'>
							<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h3 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=revStatus%></h3><span class='zcs-font-13 zcs-color-secondary'>Plan <%=ifnull(plan.Consolidation_No,"-")%></span></div>
							<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Requested to <strong><%=ifnull(rev.Requested_To,"-")%></strong> by <%=ifnull(rev.Requested_By,"-")%>. <%=ifnull(rev.Comments,"No comments recorded.")%></p>
						</div>
					</li>
<%
			}
		}
	}
	if(timelineCount == 0)
	{
		%>
<li class='scm-empty'>No revision history lines are recorded for the currently visible SCM plans.</li>
<%
	}
	%>
</ul>
			</div>
		</div>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Replanning requests needing follow-up</h2><span class='scm-note'>Open SCM, Sales and Operations requests only</span></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Request</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Module</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Reason</th></tr></thead>
					<tbody>
<%
	reqCount = 0;
	for each  req in Replanning_Requests[Source_Module == "SCM" || Source_Module == "Sales" || Source_Module == "Operations" && Status != "Approved" && Status != "Closed" && Status != "Locked" && Status != "Rejected"] sort by Request_Date desc
	{
		reqCount = reqCount + 1;
		if(reqCount <= 8)
		{
			reqStatus = ifnull(req.Status,"-");
			reqClass = "zcs-badge-blue";
			if(reqStatus == "Pending" || reqStatus == "Requested")
			{
				reqClass = "zcs-badge-yellow";
			}
			else if(reqStatus == "Approved" || reqStatus == "Closed" || reqStatus == "Locked")
			{
				reqClass = "zcs-badge-green";
			}
			else if(reqStatus == "Rejected")
			{
				reqClass = "zcs-badge-red";
			}
			%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Replanning_Requests?Replan_No=<%=req.Replan_No%>'><%=ifnull(req.Replan_No,"-")%></a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(req.Source_Module,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=reqClass%>'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=reqStatus%></span></span></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(req.Trigger_Reason,"-")%></td></tr>
<%
		}
	}
	if(reqCount == 0)
	{
		%>
