<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "SCM Central PPC";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	productMixWaitingSalesPlans = Volume_Consolidations[(Status == "Product Mix Pending Sales Approval") && Locked != true];
	salesProductMixActionPlans = Volume_Consolidations[(Status == "Product Mix Pending Sales Approval" || Status == "Product Mix Sales Revision Pending") && Locked != true];
	salesRevisionPendingPlans = Volume_Consolidations[(Status == "Product Mix Sales Revision Pending" || Status == "Sales Revision Pending" || Status == "Operations Revision Submitted") && Locked != true];
	salesRevisionSubmittedPlans = Volume_Consolidations[(Status == "Sales Revision Submitted" || Status == "Both Revisions Submitted") && Locked != true];
	operationsRevisionPendingPlans = Volume_Consolidations[(Status == "Operations Revision Pending" || Status == "Sales Revision Submitted") && Locked != true];
	operationsRevisionSubmittedPlans = Volume_Consolidations[(Status == "Operations Revision Submitted" || Status == "Both Revisions Submitted") && Locked != true];
	bothRevisionPlans = Volume_Consolidations[(Status == "Both Revisions Pending" || Status == "Both Revisions Submitted") && Locked != true];
	bothRevisionPendingPlans = Volume_Consolidations[(Status == "Both Revisions Pending") && Locked != true];
	bothRevisionSubmittedPlans = Volume_Consolidations[(Status == "Both Revisions Submitted") && Locked != true];
	readyPlans = Volume_Consolidations[(Status == "Under SCM Review" || Status == "Returned to SCM Review" || Status == "Both Revisions Submitted") && Locked != true];
	revisionPlans = Volume_Consolidations[(Status == "Revision Requested" || Status == "Product Mix Sales Revision Pending" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" || Status == "Sales Revision Submitted" || Status == "Operations Revision Submitted" || Status == "Both Revisions Submitted") && Locked != true];
	pendingPlans = Volume_Consolidations[(Status == "Product Mix Pending Sales Approval" || Status == "Product Mix Sales Revision Pending" || Status == "Under SCM Review" || Status == "Returned to SCM Review" || Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" || Status == "Sales Revision Submitted" || Status == "Operations Revision Submitted" || Status == "Both Revisions Submitted") && Locked != true];
	insightPlans = Volume_Consolidations[(Status == "Product Mix Pending Sales Approval" || Status == "Product Mix Sales Revision Pending" || Status == "Under SCM Review" || Status == "Returned to SCM Review" || Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" || Status == "Sales Revision Submitted" || Status == "Operations Revision Submitted" || Status == "Both Revisions Submitted" || Status == "SCM Approved" || Status == "Final Approved" || Status == "Locked" || Locked == true)];
	approvedPlans = Volume_Consolidations[(Status == "SCM Approved" || Status == "Final Approved")];
	lockedPlans = Volume_Consolidations[(Status == "Locked" || Locked == true)];
	approvedLockedPlans = Volume_Consolidations[(Status == "SCM Approved" || Status == "Final Approved" || Status == "Locked" || Locked == true)];
	productMixWaitingSalesCount = productMixWaitingSalesPlans.count();
	salesProductMixActionCount = salesProductMixActionPlans.count();
	salesRevisionPendingCount = salesRevisionPendingPlans.count();
	salesRevisionSubmittedCount = salesRevisionSubmittedPlans.count();
	operationsRevisionPendingCount = operationsRevisionPendingPlans.count();
	operationsRevisionSubmittedCount = operationsRevisionSubmittedPlans.count();
	bothRevisionPendingCount = bothRevisionPendingPlans.count();
	bothRevisionSubmittedCount = bothRevisionSubmittedPlans.count();
	bothRevisionCount = bothRevisionPlans.count();
	readyCount = readyPlans.count();
	revisionCount = revisionPlans.count();
	approvedCount = approvedPlans.count();
	lockedCount = lockedPlans.count();
	pendingDecisionCount = pendingPlans.count();
	approvedLockedCount = approvedLockedPlans.count();
	totalSalesTarget = 0.0;
	totalOperationsProduction = 0.0;
	totalBTVMeasured = 0.0;
	totalAvailableRawMaterial = 0.0;
	totalAvailableHours = 0.0;
	totalToBeRaised = 0.0;
	totalCostForecast = 0.0;
	insightRowCount = 0;
	pendingMatrixRowCount = 0;
	approvedLockedRowCount = 0;
	approvedLockedToBeRaised = 0.0;
	approvedLockedCostForecast = 0.0;
	for each  plan in insightPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			totalSalesTarget = totalSalesTarget + ifnull(line.Sales_Target_Tons,0);
			totalOperationsProduction = totalOperationsProduction + ifnull(line.Operations_Production_Tons,0);
			totalBTVMeasured = totalBTVMeasured + ifnull(line.BTV_Measured_MT,0);
			totalAvailableRawMaterial = totalAvailableRawMaterial + ifnull(line.Available_Raw_Material_MT,0);
			totalAvailableHours = totalAvailableHours + ifnull(line.Annual_Available_Hours,0);
			totalToBeRaised = totalToBeRaised + ifnull(line.To_Be_Raised_MT,0);
			totalCostForecast = totalCostForecast + ifnull(line.Cost_Forecast,0);
			insightRowCount = insightRowCount + 1;
		}
	}
	for each  plan in pendingPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			pendingMatrixRowCount = pendingMatrixRowCount + 1;
		}
	}
	for each  plan in approvedLockedPlans
	{
		for each  line in plan.SCM_Review_Lines_Existing
		{
			approvedLockedRowCount = approvedLockedRowCount + 1;
			approvedLockedToBeRaised = approvedLockedToBeRaised + ifnull(line.To_Be_Raised_MT,0);
			approvedLockedCostForecast = approvedLockedCostForecast + ifnull(line.Cost_Forecast,0);
		}
	}
	focusTitle = "No active SCM actions";
	focusText = "Sales, Operations and final SCM queues are clear. Final Approved, SCM Approved and Locked records remain available in insight metrics for audit and planning context.";
	focusHref = "#Report:SCM_Revision_History?zc_LoadIn=dialog";
	focusCta = "Review history";
	focusIcon = "ui-1-check-circle-08";
	focusClass = "scm-focus-clear";
	if(productMixWaitingSalesCount > 0 || salesRevisionPendingCount > 0)
	{
		focusTitle = "Product mix or Sales revision is waiting";
		focusText = salesProductMixActionCount + " consolidation(s) need Sales product mix action. Sales approves product mix changes first before SCM gives final approval.";
		focusHref = "#Report:Sales_Product_Mix_Approval_Queue?zc_LoadIn=dialog";
		focusCta = "Open Sales queue";
		focusIcon = "business-chart-bar-32";
		focusClass = "scm-focus-sales";
	}
	else if(operationsRevisionPendingCount > 0)
	{
		focusTitle = "Operations revision is waiting";
		focusText = operationsRevisionPendingCount + " consolidation(s) need Operations production or availability revision before SCM can complete the review.";
		focusHref = "#Report:Operations_Revision_Queue?zc_LoadIn=dialog";
		focusCta = "Open Operations queue";
		focusIcon = "business-factory";
		focusClass = "scm-focus-operations";
	}
	else if(bothRevisionPendingCount > 0)
	{
		focusTitle = "Both teams have revision actions";
		focusText = bothRevisionPendingCount + " consolidation(s) are waiting for both Sales and Operations to submit revisions.";
		focusHref = "#Report:SCM_Revision_Requests?zc_LoadIn=dialog";
		focusCta = "Open revision queue";
		focusIcon = "ui-2-time";
		focusClass = "scm-focus-revision";
	}
	else if(readyCount > 0)
	{
		focusTitle = "Final SCM review queue is ready";
		focusText = readyCount + " consolidation(s) have product mix approval or submitted revisions and are waiting for final SCM decision.";
		focusHref = "#Report:SCM_Ready_For_Review?zc_LoadIn=dialog";
		focusCta = "Open SCM review";
		focusIcon = "ui-1-check-circle-08";
		focusClass = "scm-focus-ready";
	}
	%>
<style>
/* zcs-global utility subset included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0%}.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-0{gap:0}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}
/* ZCS card, table, timeline, badge and button components */
.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094c5}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color);border:1px solid var(--zcs-white-color);box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:'';display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}
.scm-workbench{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.scm-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start;position:relative;overflow:hidden}.scm-hero:after{content:'';position:absolute;right:-90px;top:-110px;width:290px;height:290px;border:34px solid rgba(255,255,255,.10);border-radius:50%}.scm-hero>*{position:relative;z-index:1}.scm-hero h1{margin:0 0 8px;font-size:26px;line-height:1.2}.scm-hero p{margin:0;opacity:.92;max-width:980px}.scm-hero-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px;color:var(--zcs_brand_foreground_color);white-space:nowrap}.scm-kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(165px,1fr));gap:14px;margin-top:16px}.scm-kpi{min-height:144px;display:flex;flex-direction:column;justify-content:space-between}.scm-kpi-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.scm-kpi-value{font-size:26px;font-weight:700;line-height:1.1;color:var(--zcs_primary_text_color);margin-top:10px}.scm-kpi-sub{font-size:12px;color:var(--zcs_tertiary_text_color);margin-top:6px}.scm-section{margin-top:16px}.scm-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.scm-section-head h2{margin:0;font-size:20px;color:var(--zcs_primary_text_color)}.scm-note{font-size:13px;color:var(--zcs_secondary_text_color)}.scm-action-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px;margin-top:16px}.scm-focus-card{border-left:5px solid var(--zcs_brand_color);display:flex;gap:16px;align-items:flex-start;min-height:180px}.scm-focus-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);flex:0 0 auto}.scm-focus-card h2{margin:0 0 8px;font-size:22px;color:var(--zcs_primary_text_color)}.scm-focus-card p{margin:0 0 16px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-focus-sales{border-left-color:#2A6FFC}.scm-focus-sales .scm-focus-icon{background:#E8EFFF;color:#2A6FFC}.scm-focus-operations{border-left-color:#09598E}.scm-focus-operations .scm-focus-icon{background:#E7F5FB;color:#09598E}.scm-focus-revision{border-left-color:#F4660C}.scm-focus-revision .scm-focus-icon{background:#F8F0EB;color:#F4660C}.scm-focus-clear{border-left-color:#179E6C}.scm-focus-clear .scm-focus-icon{background:#E4FCF3;color:#179E6C}.scm-pending-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scm-action-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border:1px solid #e7e7ee;border-radius:12px;background:#fff;box-sizing:border-box;color:var(--zcs_primary_text_color)}.scm-action-card:hover{background:var(--zcs_component_hover_color)}.scm-action-left{display:flex;gap:12px;align-items:center}.scm-action-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.scm-action-title{font-weight:600;font-size:14px;color:var(--zcs_primary_text_color)}.scm-action-sub{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:2px}.scm-owner-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.scm-owner-card{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.scm-owner-count{font-size:24px;font-weight:700;color:var(--zcs_primary_text_color)}.scm-owner-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:4px}.scm-guidance-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.scm-guidance-card{display:flex;gap:14px;align-items:flex-start}.scm-guidance-card i{color:var(--zcs_brand_color);font-size:22px;margin-top:2px}.scm-guidance-card h3{margin:0 0 6px;font-size:16px;color:var(--zcs_primary_text_color)}.scm-guidance-card p{margin:0 0 12px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-insight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.scm-insight-item{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:14px}.scm-insight-label{font-size:12px;color:var(--zcs_secondary_text_color);margin-bottom:6px}.scm-insight-value{font-size:20px;font-weight:700;color:var(--zcs_primary_text_color)}.scm-dual-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.scm-comments{max-width:280px;white-space:normal}.scm-empty{padding:24px;text-align:center;color:var(--zcs_secondary_text_color);background:#fff;border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.scm-empty i{margin-right:8px;color:var(--zcs_brand_color)}.scm-mini-table td,.scm-mini-table th{font-size:13px}.scm-panel{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px;box-sizing:border-box}.scm-inline-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.scm-comment-stack{display:flex;flex-direction:column;gap:8px;margin-top:10px}.scm-comment-item{border-left:3px solid var(--zcs_brand_color);background:#F9FAFE;border-radius:8px;padding:8px 10px}.scm-comment-label{display:block;font-size:12px;font-weight:700;color:var(--zcs_secondary_text_color);margin-bottom:2px}.scm-comment-text{font-size:13px;color:var(--zcs_primary_text_color)}@media(max-width:1440px){.scm-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.scm-guidance-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:1280px){.scm-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.scm-dual-grid,.scm-guidance-grid,.scm-action-grid,.scm-owner-grid{grid-template-columns:1fr}.scm-insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:768px){.scm-workbench{padding:12px}.scm-hero{flex-direction:column}.scm-kpi-grid,.scm-pending-actions,.scm-insight-grid{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li{flex-direction:column}.zcs-px-60{padding-left:3.75rem;padding-right:1rem}.scm-section-head{align-items:flex-start;flex-direction:column}}
</style>
<div class='scm-workbench'>
	<div class='scm-hero'>
		<div>
			<h1>SCM Review Workbench</h1>
			<p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). This workbench now combines all-plant availability, product mix status and revision ownership so SCM can see records waiting on Sales, Operations, both teams, or final SCM approval. Approved and locked records are excluded from action lists and retained in insight metrics.</p>
		</div>
		<span class='scm-hero-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span>
	</div>

	<div class='scm-kpi-grid'>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline business-chart-bar-32'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Product mix waiting for Sales</div><div class='scm-kpi-value'><%=productMixWaitingSalesCount%></div><div class='scm-kpi-sub'>Product Mix Pending Sales Approval</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-2-time'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Sales revisions pending/submitted</div><div class='scm-kpi-value'><%=salesRevisionPendingCount%> / <%=salesRevisionSubmittedCount%></div><div class='scm-kpi-sub'>Pending first, submitted second</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline business-factory'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Operations revisions pending/submitted</div><div class='scm-kpi-value'><%=operationsRevisionPendingCount%> / <%=operationsRevisionSubmittedCount%></div><div class='scm-kpi-sub'>Pending first, submitted second</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline users-single-01'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Both-team revisions</div><div class='scm-kpi-value'><%=bothRevisionCount%></div><div class='scm-kpi-sub'><%=bothRevisionPendingCount%> pending; <%=bothRevisionSubmittedCount%> submitted</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>SCM final review queue</div><div class='scm-kpi-value'><%=readyCount%></div><div class='scm-kpi-sub'>Under or returned to SCM review</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline ui-1-check-bold'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>Final approved/locked</div><div class='scm-kpi-value'><%=approvedLockedCount%></div><div class='scm-kpi-sub'><%=approvedCount%> approved; <%=lockedCount%> locked</div></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-kpi'><div class='scm-kpi-icon'><i class='zc-li-outline files-single-copy-04'></i></div><div><div class='zcs-font-13 zcs-color-secondary'>All-plant matrix rows</div><div class='scm-kpi-value'><%=pendingMatrixRowCount%></div><div class='scm-kpi-sub'>Actionable rows only</div></div></div>
	</div>

	<div class='scm-section scm-owner-grid'>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-owner-card'><div><div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Waiting on Sales</div><div class='scm-owner-label'>Product mix approval, Sales revision, or Sales after Operations submission</div></div><div class='scm-owner-count'><%=salesRevisionPendingCount + productMixWaitingSalesCount%></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-owner-card'><div><div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Waiting on Operations</div><div class='scm-owner-label'>Operations revision pending or Sales already submitted</div></div><div class='scm-owner-count'><%=operationsRevisionPendingCount%></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-owner-card'><div><div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Waiting on both teams</div><div class='scm-owner-label'>Both Revisions Pending status</div></div><div class='scm-owner-count'><%=bothRevisionPendingCount%></div></div>
		<div class='zcs-card zcs-p-20 zcs-box-border scm-owner-card'><div><div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Waiting on SCM</div><div class='scm-owner-label'>Returned, under SCM review, or both revisions submitted</div></div><div class='scm-owner-count'><%=readyCount%></div></div>
	</div>

	<div class='scm-action-grid'>
		<div class='zcs-card zcs-p-24 zcs-box-border scm-focus-card <%=focusClass%>'>
			<div class='scm-focus-icon'><i class='zc-li-outline <%=focusIcon%>'></i></div>
			<div>
				<h2><%=focusTitle%></h2>
				<p><%=focusText%></p>
				<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=focusHref%>'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span><%=focusCta%></span></a>
			</div>
		</div>
		<div class='zcs-card zcs-p-20 zcs-box-border'>
			<div class='scm-section-head'><h2>Pending actions</h2><span class='scm-note'><%=pendingDecisionCount%> active consolidation(s); approved and locked records excluded</span></div>
			<div class='scm-pending-actions'>
				<a class='scm-action-card' href='#Report:Sales_Product_Mix_Approval_Queue?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline business-chart-bar-32'></i></span><span><span class='scm-action-title'>Sales product mix approval queue</span><span class='scm-action-sub'>Product mix approval or Sales product mix revision</span></span></span><strong><%=salesProductMixActionCount%></strong></a>
				<a class='scm-action-card' href='#Report:Operations_Revision_Queue?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline business-factory'></i></span><span><span class='scm-action-title'>Operations revision queue</span><span class='scm-action-sub'>Operations or both-team revision action</span></span></span><strong><%=operationsRevisionPendingCount + bothRevisionPendingCount%></strong></a>
				<a class='scm-action-card' href='#Report:SCM_Ready_For_Review?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span><span><span class='scm-action-title'>SCM ready for review</span><span class='scm-action-sub'>Final SCM approval queue</span></span></span><strong><%=readyCount%></strong></a>
				<a class='scm-action-card' href='#Report:SCM_Revision_Requests?zc_LoadIn=dialog'><span class='scm-action-left'><span class='scm-action-icon'><i class='zc-li-outline ui-2-time'></i></span><span><span class='scm-action-title'>SCM revision requests</span><span class='scm-action-sub'>Sales, Operations and both-team revision statuses</span></span></span><strong><%=revisionCount%></strong></a>
			</div>
		</div>
	</div>

	<div class='scm-section'>
		<div class='scm-section-head'>
			<h2>Product mix guidance</h2>
			<div class='scm-inline-actions'>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:Sales_Product_Mix_Approval_Queue?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline business-chart-bar-32'></i><span class='zcs-button-text'>Open Sales queue</span></a>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Ready_For_Review?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span class='zcs-button-text'>Open final SCM queue</span></a>
			</div>
		</div>
		<div class='scm-guidance-grid'>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline files-single-copy-04'></i><div><h3>Copied from Sales Plan</h3><p>Product mix lines are copied from the Sales Plan so SCM starts from Sales demand rather than re-keyed values.</p></div></div>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline business-factory'></i><div><h3>Compare with all plants</h3><p>The SCM review matrix uses line-level Plant and Production Line from all SCM Review Lines so one consolidation can show all plants together.</p></div></div>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline ui-1-check-circle-08'></i><div><h3>Sales approves product mix first</h3><p>If SCM changes product mix, Sales must approve or request product mix revision before SCM final approval.</p></div></div>
			<div class='zcs-card zcs-p-20 zcs-box-border scm-guidance-card'><i class='zc-li-outline ui-1-check-bold'></i><div><h3>SCM final approves last</h3><p>SCM gives final approval only after Sales and Operations submit requested revisions and the record returns to SCM review.</p></div></div>
		</div>
	</div>

	<div class='scm-section zcs-card zcs-p-24 zcs-box-border'>
		<div class='scm-section-head'>
			<h2>All-plant availability and finalised insights</h2>
			<span class='scm-note'>Finalised or locked rows are excluded from pending lists and retained here for context</span>
		</div>
		<div class='scm-insight-grid'>
			<div class='scm-insight-item'><div class='scm-insight-label'>SCM-visible matrix rows</div><div class='scm-insight-value'><%=insightRowCount%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>All-plant available raw material MT</div><div class='scm-insight-value'><%=totalAvailableRawMaterial%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Annual available hours</div><div class='scm-insight-value'><%=totalAvailableHours%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>BTV measured MT</div><div class='scm-insight-value'><%=totalBTVMeasured%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Total sales target tons</div><div class='scm-insight-value'><%=totalSalesTarget%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Operations production tons</div><div class='scm-insight-value'><%=totalOperationsProduction%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Raw material to be raised MT</div><div class='scm-insight-value'><%=totalToBeRaised%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Forecast cost</div><div class='scm-insight-value'><%=totalCostForecast%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Approved or locked plans</div><div class='scm-insight-value'><%=approvedLockedCount%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Approved or locked matrix rows</div><div class='scm-insight-value'><%=approvedLockedRowCount%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Finalised raw material MT</div><div class='scm-insight-value'><%=approvedLockedToBeRaised%></div></div>
			<div class='scm-insight-item'><div class='scm-insight-label'>Finalised forecast cost</div><div class='scm-insight-value'><%=approvedLockedCostForecast%></div></div>
		</div>
	</div>

	<div class='scm-section scm-dual-grid'>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Queue ownership snapshot</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Revision_Requests?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Open revision queue</span></a></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Owner</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Representative statuses</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Count</th></tr></thead>
					<tbody>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Sales</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Product Mix Pending Sales Approval, Product Mix Sales Revision Pending, Sales Revision Pending, Operations Revision Submitted</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-13 zcs-color-primary'><%=salesRevisionPendingCount + productMixWaitingSalesCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Operations</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Operations Revision Pending, Sales Revision Submitted</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-13 zcs-color-primary'><%=operationsRevisionPendingCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Both teams</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Both Revisions Pending, Both Revisions Submitted</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-13 zcs-color-primary'><%=bothRevisionCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>SCM</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-13 zcs-color-primary'>Under SCM Review, Returned to SCM Review, Both Revisions Submitted</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-13 zcs-color-primary'><%=readyCount%></td></tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Recent active consolidations</h2><span class='scm-note'>Final approved and locked records excluded</span></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Plan</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Plant</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th></tr></thead>
					<tbody>
<%
	activeIndex = 0;
	for each  plan in pendingPlans
	{
		activeIndex = activeIndex + 1;
		if(activeIndex <= 8)
		{
			planPlantName = "-";
			if(plan.Plant != null)
			{
				planPlantName = plan.Plant.Plant_Name;
			}
			statusName = ifnull(plan.Status,"-");
			statusClass = "zcs-badge-blue";
			if(statusName == "Product Mix Pending Sales Approval" || statusName == "Product Mix Sales Revision Pending" || statusName == "Sales Revision Pending" || statusName == "Operations Revision Pending" || statusName == "Both Revisions Pending" || statusName == "Revision Requested")
			{
				statusClass = "zcs-badge-orange";
			}
			else if(statusName == "Sales Revision Submitted" || statusName == "Operations Revision Submitted" || statusName == "Both Revisions Submitted")
			{
				statusClass = "zcs-badge-yellow";
			}
			%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Volume_Consolidations?Consolidation_No=<%=plan.Consolidation_No%>'><%=ifnull(plan.Consolidation_No,"-")%></a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=planPlantName%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=statusName%></span></span></td></tr>
<%
		}
	}
	if(activeIndex == 0)
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary' colspan='3'>No active consolidations require follow-up.</td></tr>
<%
	}
	%>
</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class='scm-section zcs-card zcs-p-24 zcs-box-border'>
		<div class='scm-section-head'>
			<h2>Pending SCM review matrix by grade and product</h2>
			<span class='scm-note'><%=pendingMatrixRowCount%> actionable row(s) across all plants; Final Approved, SCM Approved and Locked rows are excluded here</span>
		</div>
<%
	if(pendingMatrixRowCount == 0)
	{
		%>
<div class='scm-empty'><i class='zc-li-outline ui-1-check-circle-08'></i>No consolidation rows are currently waiting for SCM decision.</div>
<%
	}
	else
	{
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead class='zcs-sticky'>
						<tr>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Plan</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Plant</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Production Line</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Grade</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Product</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Sales Target Tons</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Operations Production Tons</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>BTV Measured MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Required Raw Material MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Available Raw Material MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>To Be Raised MT</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Cost Forecast</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Override comments</th>
						</tr>
						<tr class='zcs-tspace'><th class='zcs-p-0 zcs-box-border' colspan='14'></th></tr>
					</thead>
					<tbody>
<%
		for each  plan in pendingPlans
		{
			for each  line in plan.SCM_Review_Lines_Existing
			{
				statusName = ifnull(plan.Status,"-");
				statusClass = "zcs-badge-blue";
				if(statusName == "Product Mix Pending Sales Approval" || statusName == "Product Mix Sales Revision Pending" || statusName == "Revision Requested" || statusName == "Sales Revision Pending" || statusName == "Operations Revision Pending" || statusName == "Both Revisions Pending")
				{
					statusClass = "zcs-badge-orange";
				}
				else if(statusName == "Sales Revision Submitted" || statusName == "Operations Revision Submitted" || statusName == "Both Revisions Submitted")
				{
					statusClass = "zcs-badge-yellow";
				}
				plantName = "-";
				if(line.Plant != null)
				{
					plantName = line.Plant.Plant_Name;
				}
				productionLineName = "-";
				if(line.Production_Line != null)
				{
					productionLineName = line.Production_Line.Line_Name;
				}
				%>
<tr>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Volume_Consolidations?Consolidation_No=<%=plan.Consolidation_No%>'><%=ifnull(plan.Consolidation_No,"-")%></a></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=statusName%></span></span></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=plantName%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=productionLineName%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Grade,"-")%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Product,"-")%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Sales_Target_Tons,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Operations_Production_Tons,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.BTV_Measured_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Required_Raw_Material_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Available_Raw_Material_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.To_Be_Raised_MT,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(line.Cost_Forecast,0)%></td>
							<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary scm-comments'><%=ifnull(line.Override_Comments,"-")%></td>
						</tr>
<%
			}
		}
		%>
</tbody>
				</table>
			</div>
<%
	}
	%>
</div>

	<div class='scm-section scm-dual-grid'>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Revision history timeline</h2><a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:SCM_Revision_History?zc_LoadIn=dialog'><i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span>Open history report</span></a></div>
			<div class='zcs-timeline-wrapper'>
				<ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
<%
	timelineCount = 0;
	for each  plan in insightPlans
	{
		for each  rev in plan.Revision_History_Lines_Existing
		{
			timelineCount = timelineCount + 1;
			if(timelineCount <= 8)
			{
				revStatus = ifnull(rev.Revision_Status,"Revision requested");
				hasStructuredComments = false;
				if(ifnull(rev.Sales_Request_Comments,"").trim() != "" || ifnull(rev.Operations_Request_Comments,"").trim() != "" || ifnull(rev.Sales_Response_Comments,"").trim() != "" || ifnull(rev.Operations_Response_Comments,"").trim() != "" || ifnull(rev.SCM_Review_Comments,"").trim() != "")
				{
					hasStructuredComments = true;
				}
				%>
<li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'>
						<div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'><span class='zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative'></span></div>
						<span class='zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right'><%=ifnull(rev.Requested_On,"-")%></span>
						<div class='zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border'>
							<div class='zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8'><h3 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=revStatus%></h3><span class='zcs-font-13 zcs-color-secondary'>Plan <%=ifnull(plan.Consolidation_No,"-")%></span></div>
							<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0'>Requested to <strong><%=ifnull(rev.Requested_To,"-")%></strong> by <%=ifnull(rev.Requested_By,"-")%>.</p>
							<div class='scm-comment-stack'>
<%
				if(ifnull(rev.Sales_Request_Comments,"").trim() != "")
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>Sales request comments</span><span class='scm-comment-text'><%=rev.Sales_Request_Comments%></span></div>
<%
				}
				if(ifnull(rev.Operations_Request_Comments,"").trim() != "")
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>Operations request comments</span><span class='scm-comment-text'><%=rev.Operations_Request_Comments%></span></div>
<%
				}
				if(ifnull(rev.Sales_Response_Comments,"").trim() != "")
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>Sales response comments</span><span class='scm-comment-text'><%=rev.Sales_Response_Comments%></span></div>
<%
				}
				if(ifnull(rev.Operations_Response_Comments,"").trim() != "")
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>Operations response comments</span><span class='scm-comment-text'><%=rev.Operations_Response_Comments%></span></div>
<%
				}
				if(ifnull(rev.SCM_Review_Comments,"").trim() != "")
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>SCM review comments</span><span class='scm-comment-text'><%=rev.SCM_Review_Comments%></span></div>
<%
				}
				if(hasStructuredComments == false)
				{
					%>
								<div class='scm-comment-item'><span class='scm-comment-label'>General comments</span><span class='scm-comment-text'><%=ifnull(rev.Comments,"No comments recorded.")%></span></div>
<%
				}
				%>
							</div>
						</div>
					</li>
<%
			}
		}
	}
	if(timelineCount == 0)
	{
		%>
<li class='scm-empty'>No revision history lines are recorded for the currently visible SCM plans.</li>
<%
	}
	%>
</ul>
			</div>
		</div>
		<div class='scm-panel'>
			<div class='scm-section-head'><h2>Replanning requests needing follow-up</h2><span class='scm-note'>Open SCM, Sales and Operations requests only</span></div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full scm-mini-table'>
					<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Request</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Module</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary'>Reason</th></tr></thead>
					<tbody>
<%
	reqCount = 0;
	for each  req in Replanning_Requests[(Source_Module == "SCM" || Source_Module == "Sales" || Source_Module == "Operations") && Status != "Approved" && Status != "Closed" && Status != "Locked" && Status != "Rejected"] sort by Request_Date desc
	{
		reqCount = reqCount + 1;
		if(reqCount <= 8)
		{
			reqStatus = ifnull(req.Status,"-");
			reqClass = "zcs-badge-blue";
			if(reqStatus == "Pending" || reqStatus == "Requested")
			{
				reqClass = "zcs-badge-yellow";
			}
			else if(reqStatus == "Approved" || reqStatus == "Closed" || reqStatus == "Locked")
			{
				reqClass = "zcs-badge-green";
			}
			else if(reqStatus == "Rejected")
			{
				reqClass = "zcs-badge-red";
			}
			%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><a class='zcs-color-theme' href='#Report:All_Replanning_Requests?Replan_No=<%=req.Replan_No%>'><%=ifnull(req.Replan_No,"-")%></a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(req.Source_Module,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=reqClass%>'><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=reqStatus%></span></span></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(req.Trigger_Reason,"-")%></td></tr>
<%
		}
	}
	if(reqCount == 0)
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary' colspan='4'>No open replanning requests require follow-up.</td></tr>
<%
	}
	%>
</tbody>
				</table>
			</div>
		</div>
	</div>
</div>