<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Auditor";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	criticalEvents = Approval_Audit_Log[Action in {"Returned","Reopened","Revision Requested","Revision Copy Created","Locked","Final Approved","Cancelled","Deleted"}].count();
	returned = Approval_Audit_Log[Action == "Returned"].count();
	reopened = Approval_Audit_Log[Action == "Reopened"].count();
	returnedReopened = returned + reopened;
	revisionRequested = Approval_Audit_Log[Action == "Revision Requested"].count();
	cancelledDeleted = Approval_Audit_Log[Action == "Cancelled" || Action == "Deleted"].count();
	criticalQueue = returnedReopened + revisionRequested + cancelledDeleted;
	lockedFinalEvents = Approval_Audit_Log[Action == "Locked" || Action == "Final Approved"].count();
	completedHistory = Approval_Audit_Log[Action == "Completed"].count();
	finalHistory = Approval_Audit_Log[Action == "Final Approved"].count();
	auditHistoryCount = completedHistory + finalHistory;
	delegationFlags = Approval_Delegations[Active == true].count();
	activeDelegations = Approval_Delegations[Active == true && Start_Date <= zoho.currentdate && End_Date >= zoho.currentdate].count();
	delegationDateExceptions = delegationFlags - activeDelegations;
	delegatedEvents = Approval_Audit_Log[Action == "Delegated"].count();
	lockedBaselines = Budget_Cycles[Baseline_Locked == true || Approved_Scenario == true || Status == "Closed"].count();
	approvedSales = Sales_Plans[Status == "Sales Approved" || Status == "Locked" || Locked == true].count();
	salesApprovedOnly = Sales_Plans[Status == "Sales Approved"].count();
	salesLockedOnly = Sales_Plans[Status == "Locked" || Locked == true].count();
	%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%}.zcs-no-shrink{flex-shrink:0}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-w-full{width:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-heading{line-height:1.25}.zcs-lh-body{line-height:1.5}.zcs-uppercase{text-transform:uppercase}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#a06309}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-red{color:#fe455d}.audit-shell{background:var(--zcs-page-bg-color);padding:20px;color:var(--zcs-primary-text-color);min-height:100%}.audit-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--zcs_brand_color),#17324c);border:0;color:var(--zcs_brand_foreground_color);padding:24px;gap:18px}.audit-hero:after{content:"";position:absolute;right:-80px;top:-90px;width:250px;height:250px;border:34px solid rgba(255,255,255,.10);border-radius:50%}.audit-hero-main{position:relative;z-index:1;max-width:760px}.audit-hero h2{font-size:26px;line-height:1.2;margin:0 0 8px}.audit-hero p{margin:0;opacity:.92}.audit-hero-meta{position:relative;z-index:1;align-items:flex-end}.audit-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.audit-kpi{padding:18px;text-decoration:none;color:inherit;transition:border-color .18s ease,transform .18s ease}.audit-kpi:hover,.audit-action-card:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.audit-kpi strong{display:block;font-size:32px;line-height:1;margin-top:14px;margin-bottom:8px;color:var(--zcs-primary-text-color)}.audit-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px}.audit-icon-theme{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.audit-icon-red{background:#FDE3E6;color:#FE455D}.audit-icon-green{background:#E4FCF3;color:#179E6C}.audit-icon-blue{background:#E8EFFF;color:#2A6FFC}.audit-icon-yellow{background:#FCF4E6;color:#a06309}.audit-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.audit-panel{overflow:hidden}.audit-panel-body{padding:18px}.audit-section-title{margin:0}.audit-action-list{display:grid;gap:12px;margin-top:14px}.audit-action-card{padding:14px;text-decoration:none;color:inherit}.audit-action-count{font-size:24px;font-weight:700;color:var(--zcs_brand_color);line-height:1}.audit-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color);padding:12px;border-radius:8px;margin-top:12px}.audit-note-warning{border-left-color:#FAAE13;background:#FCF4E6}.audit-note-clear{border-left-color:#179E6C;background:#E4FCF3}.audit-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.audit-mini{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px}.audit-mini strong{display:block;font-size:20px;margin-top:4px}.audit-foot-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.audit-muted{color:var(--zcs-secondary-text-color)}.audit-rule{height:1px;background:var(--zcs_tertiary_border_color);margin:16px 0}@media(max-width:1100px){.audit-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.audit-layout{grid-template-columns:1fr}}@media(max-width:680px){.audit-shell{padding:12px}.audit-kpi-grid,.audit-mini-grid{grid-template-columns:1fr}.audit-hero,.audit-hero-meta{align-items:flex-start}.audit-hero{flex-direction:column}.audit-action-card{align-items:flex-start}.audit-action-count{margin-left:52px}}
</style>
<div class='audit-shell zcs-box-border'>
	<div class='audit-hero zcs-card zcs-flex zcs-justify-space-between zcs-align-items-center zcs-box-border'>
		<div class='audit-hero-main'>
			<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
				<i class='zcs-badge-icon zcs-no-shrink zc-li-outline files-book-07'></i>
				<span class='zcs-badge-text zcs-font-13 zcs-font-medium zcs-lh-body'>Audit governance landing</span>
			</div>
			<h2 class='zcs-font-bold'>Governance insight, queues and delegation checks</h2>
			<p class='zcs-font-15 zcs-lh-body'>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Critical queues below exclude normal Completed records from pending action counts; final/completed records are retained as audit history.</p>
		</div>
		<div class='audit-hero-meta zcs-flex zcs-direction-column zcs-gap-10'>
			<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'>
				<i class='zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01'></i>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=profileText%></span>
			</div>
			<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'>
				<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=approvedSales%> final sales plans</span>
			</div>
		</div>
	</div>

	<div class='audit-kpi-grid'>
		<a class='audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border' href='#Report:Critical_Audit_Events?zc_LoadIn=dialog'>
			<div class='zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
				<div class='audit-icon audit-icon-red'><i class='zc-li-outline files-exclamation'></i></div>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'><span class='zcs-badge-text zcs-font-12 zcs-font-normal'>Audit significant</span></div>
			</div>
			<strong><%=criticalEvents%></strong>
			<span class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Critical audit events</span>
			<p class='zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8'>Returned, reopened, revision, lock/final and cancellation signals. Normal Completed records are not counted here.</p>
		</a>
		<a class='audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border' href='#Report:Active_Delegations?zc_LoadIn=dialog'>
			<div class='zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
				<div class='audit-icon audit-icon-blue'><i class='zc-li-outline users-network'></i></div>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><span class='zcs-badge-text zcs-font-12 zcs-font-normal'>Date valid</span></div>
			</div>
			<strong><%=activeDelegations%></strong>
			<span class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Active delegations</span>
			<p class='zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8'><%=delegationFlags%> records are flagged Active; <%=delegationDateExceptions%> need start/end-date verification.</p>
		</a>
		<a class='audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border' href='#Report:Audit_By_Cycle?zc_LoadIn=dialog'>
			<div class='zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
				<div class='audit-icon audit-icon-green'><i class='zc-li-outline business-money-time'></i></div>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><span class='zcs-badge-text zcs-font-12 zcs-font-normal'>Baseline</span></div>
			</div>
			<strong><%=lockedBaselines%></strong>
			<span class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Locked baselines</span>
			<p class='zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8'>Budget cycles with Baseline Locked, Approved Scenario or Closed status.</p>
		</a>
		<a class='audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border' href='#Report:Critical_Audit_Events?zc_LoadIn=dialog'>
			<div class='zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
				<div class='audit-icon audit-icon-yellow'><i class='zc-li-outline arrows-1-tail-right'></i></div>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><span class='zcs-badge-text zcs-font-12 zcs-font-normal'>Follow-up</span></div>
			</div>
			<strong><%=returnedReopened%></strong>
			<span class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Returned / reopened</span>
			<p class='zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8'><%=returned%> returned and <%=reopened%> reopened events requiring audit attention.</p>
		</a>
	</div>

	<div class='audit-layout'>
		<div class='audit-panel zcs-card'>
			<div class='zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
				<h3 class='audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary'>Audit queues and delegation checks</h3>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
					<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time'></i>
					<span class='zcs-badge-text zcs-font-12 zcs-font-normal'>Action view</span>
				</div>
			</div>
			<div class='audit-panel-body'>
				<div class='audit-action-list'>
					<a class='audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border' href='#Report:Critical_Audit_Events?zc_LoadIn=dialog'>
						<div class='audit-icon audit-icon-red zcs-no-shrink'><i class='zc-li-outline files-exclamation'></i></div>
						<div class='zcs-col-common'>
							<div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Critical event queue</div>
							<div class='zcs-font-13 audit-muted'>Counts only returned, reopened, revision requested, cancelled or deleted events as follow-up. Lock/final/completed records remain history.</div>
						</div>
						<span class='audit-action-count'><%=criticalQueue%></span>
					</a>
					<a class='audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border' href='#Report:Active_Delegations?zc_LoadIn=dialog'>
						<div class='audit-icon audit-icon-blue zcs-no-shrink'><i class='zc-li-outline users-network'></i></div>
						<div class='zcs-col-common'>
							<div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Active delegation coverage</div>
							<div class='zcs-font-13 audit-muted'>Validate current delegate coverage and date-window exceptions before relying on delegated approvals.</div>
						</div>
						<span class='audit-action-count'><%=activeDelegations%></span>
					</a>
					<a class='audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border' href='#Report:Audit_By_Cycle?zc_LoadIn=dialog'>
						<div class='audit-icon audit-icon-green zcs-no-shrink'><i class='zc-li-outline business-money-time'></i></div>
						<div class='zcs-col-common'>
							<div class='zcs-font-15 zcs-font-semibold zcs-color-primary'>Audit by cycle</div>
							<div class='zcs-font-13 audit-muted'>Use cycle history for evidence review across locked baselines, final approvals and completed audit records.</div>
						</div>
						<span class='audit-action-count'>View</span>
					</a>
				</div>
				<div class='audit-foot-actions'>
					<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Approval_Delegations?zc_LoadIn=dialog'>
						<i class='zcs-button-icon zc-li-outline users-multiple-11'></i>
						<span class='zcs-button-text'>All delegations</span>
					</a>
					<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:Approved_Sales_Plans?zc_LoadIn=dialog'>
						<i class='zcs-button-icon zc-li-outline business-chart-growth'></i>
						<span class='zcs-button-text'>Approved sales</span>
					</a>
				</div>
			</div>
		</div>

		<div class='audit-panel zcs-card'>
			<div class='zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border'>
				<h3 class='audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary'>Governance insight</h3>
			</div>
			<div class='audit-panel-body'>
				<div class='audit-mini-grid'>
					<div class='audit-mini'>
						<span class='zcs-font-13 audit-muted'>Approved sales plans</span>
						<strong class='zcs-color-primary'><%=approvedSales%></strong>
						<div class='zcs-font-12 audit-muted'>Status Sales Approved or Locked, or Locked is true.</div>
					</div>
					<div class='audit-mini'>
						<span class='zcs-font-13 audit-muted'>History events</span>
						<strong class='zcs-color-primary'><%=auditHistoryCount%></strong>
						<div class='zcs-font-12 audit-muted'>Completed and Final Approved shown as evidence, not pending.</div>
					</div>
					<div class='audit-mini'>
						<span class='zcs-font-13 audit-muted'>Delegated events</span>
						<strong class='zcs-color-primary'><%=delegatedEvents%></strong>
						<div class='zcs-font-12 audit-muted'>Audit log entries where approvals were delegated.</div>
					</div>
					<div class='audit-mini'>
						<span class='zcs-font-13 audit-muted'>Locked sales plans</span>
						<strong class='zcs-color-primary'><%=salesLockedOnly%></strong>
						<div class='zcs-font-12 audit-muted'><%=salesApprovedOnly%> are Sales Approved before lock.</div>
					</div>
				</div>
<%
	if(delegationDateExceptions > 0)
	{
		%>
<div class='audit-note audit-note-warning'>
					<div class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Delegation date check needed</div>
					<div class='zcs-font-13 audit-muted'><%=delegationDateExceptions%> active-flag delegation records are outside the current date window. Review before treating them as valid delegation coverage.</div>
				</div>
<%
	}
	else
	{
		%>
<div class='audit-note audit-note-clear'>
					<div class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Delegation window clear</div>
					<div class='zcs-font-13 audit-muted'>All active-flag delegation records currently fall within their start and end dates.</div>
				</div>
<%
	}
	%>
</div>
		</div>
	</div>

	<div class='audit-panel zcs-card zcs-mt-16'>
		<div class='zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
			<h3 class='audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary'>Event treatment guide</h3>
			<span class='zcs-font-13 audit-muted'>Prevents closed evidence from inflating action queues</span>
		</div>
		<div class='audit-panel-body'>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'>
				<table class='zcs-w-full'>
					<thead>
						<tr>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Event group</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Count</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Treatment</th>
							<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Governance note</th>
						</tr>
						<tr class='zcs-tspace'><th class='zcs-p-0' colspan='4'></th></tr>
					</thead>
					<tbody>
						<tr>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Returned / Reopened</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-yellow'><%=returnedReopened%></td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow'>Pending follow-up</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Requires owner review and audit explanation.</td>
						</tr>
						<tr>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Revision / Cancellation / Delete</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-red'><%=revisionRequested + cancelledDeleted%></td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red'>Critical event queue</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Signals change-control risk or governance exception.</td>
						</tr>
						<tr>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Locked / Final approved</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-green'><%=lockedFinalEvents%></td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green'>Audit evidence</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Shows baseline commitment and final approval history.</td>
						</tr>
						<tr>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Completed</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-blue'><%=completedHistory%></td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue'>History only</td>
							<td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Normal completion is not a pending action unless paired with another audit-significant event.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>