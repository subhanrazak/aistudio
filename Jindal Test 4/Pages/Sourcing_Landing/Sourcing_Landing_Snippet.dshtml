<div class='zcs-page-container zcs-commonview zcs-wh-full sl-shell'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-card sl-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-p-24 zcs-rounded-2xl zcs-box-border'>
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
					<i class='zc-li-outline users-single-01'></i><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=profileText%></span>
				</div>
				<h5 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Sourcing raw-material budget desk</h5>
				<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Work only on draft, returned, reopened, and other editable budget rows; approved or locked budgets are separated from pending actions.</p>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12 sl-header-actions'>
				<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Form:Raw_Material_Budgets?zc_LoadIn=dialog'>
					<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i><span class='zcs-button-text'>Add Raw Material Budget</span>
				</a>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>
					<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i><span class='zcs-button-text'>Update My Budgets</span>
				</a>
			</div>
		</div>

		<div class='zcs-panel-wrapper'>
			<ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
					<div class='zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline ui-1-edit-72'></i></div><h4 class='sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=myRM%></h4></div>
						<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>My active working rows</p>
					</div>
					<a href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog' class='zcs-overlay zcs-wh-full zcs-absolute'></a>
				</li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
					<div class='zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time'></i></div><h4 class='sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=sourcingApproval%></h4></div>
						<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Submitted to sourcing manager</p>
					</div>
					<a href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog' class='zcs-overlay zcs-wh-full zcs-absolute'></a>
				</li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
					<div class='zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline business-safe'></i></div><h4 class='sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=financeApproval%></h4></div>
						<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Submitted to finance</p>
					</div>
					<a href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog' class='zcs-overlay zcs-wh-full zcs-absolute'></a>
				</li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
					<div class='zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-10'><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08'></i></div><h4 class='sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=approved%></h4></div>
						<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Approved or locked rows</p>
					</div>
					<a href='#Report:Approved_RM_Budgets?zc_LoadIn=dialog' class='zcs-overlay zcs-wh-full zcs-absolute'></a>
				</li>
			</ul>
		</div>

		<div class='sl-grid'>
			<div class='zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
				<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Pending actions and quick links</h5>
				<ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:Raw_Material_Budgets?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add'></i><span class='zcs-quick-action-text'>Add Raw Material Budget</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><span class='zcs-badge-text zcs-font-12'>New</span></span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72'></i><span class='zcs-quick-action-text'>Update My Budgets</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><span class='zcs-badge-text zcs-font-12'><%=myRM%></span></span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time'></i><span class='zcs-quick-action-text'>Review sourcing approval queue</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><span class='zcs-badge-text zcs-font-12'><%=sourcingApproval%></span></span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline business-safe'></i><span class='zcs-quick-action-text'>Track finance handoff</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange'><span class='zcs-badge-text zcs-font-12'><%=financeApproval%></span></span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:Approved_RM_Budgets?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08'></i><span class='zcs-quick-action-text'>Approved RM Budgets insight</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><span class='zcs-badge-text zcs-font-12'><%=approved%></span></span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:RM_Availability_For_SCM?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline business-gold'></i><span class='zcs-quick-action-text'>RM Availability For SCM insight</span><span class='sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey'><span class='zcs-badge-text zcs-font-12'><%=materials%></span></span></a></li>
				</ul>
			</div>

			<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
				<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Review insights</h5>
				<div class='zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
					<i class='zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info'></i><div class='zcs-toast-text'><p class='zcs-m-0'>Pending actions exclude rows where Status is Approved or Locked is true. Approval, return, and reopen actions must be performed through the record so remarks and approval data are captured.</p></div>
				</div>
				<ul class='zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0'>
					<li class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10'><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0'><span class='zcs-color-tertiary'>Pending workload across queues</span><span class='zcs-color-tertiary'><%=pendingTotal%> rows</span></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=pendingPct%>%;'></div></div></li>
					<li class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10'><p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0'><span class='zcs-color-tertiary'>Approved or locked coverage</span><span class='zcs-color-tertiary'><%=approved%> of <%=totalRM%></span></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=approvalPct%>%;'></div></div></li>
				</ul>
				<div class='zcs-row zcs-gap-12 sl-mini-stat zcs-pt-16'>
					<div class='zcs-col-6 zcs-col-xs-12 sl-muted-card zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Returned rows</span><strong class='zcs-font-20 zcs-color-primary'><%=returnedRows%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Need budget correction before resubmission.</p></div>
					<div class='zcs-col-6 zcs-col-xs-12 sl-muted-card zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-color-tertiary'>Finance handoff</span><strong class='zcs-font-20 zcs-color-primary'><%=financeApproval%></strong><p class='zcs-font-13 zcs-color-tertiary zcs-m-0'>Rows already moved out of sourcing review.</p></div>
				</div>
			</div>
		</div>

		<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
			<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
				<div><h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>My working rows by status</h5><p class='zcs-font-14 zcs-color-tertiary zcs-m-0'>Draft, returned, reopened, and other editable rows owned by you.</p></div>
				<a class='sl-report-link zcs-font-14 zcs-font-medium sl-nowrap' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>Open all budgets</a>
			</div>
			<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
				<table class='zcs-w-full'>
					<thead class='zcs-sticky'><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Bucket</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Rows</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Focus</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Link</th></tr><tr class='zcs-tspace'><th class='zcs-p-8 zcs-box-border' colspan='4'></th></tr></thead>
					<tbody>
						<tr><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-1-edit-72 zcs-color-theme'></i>Draft</div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=draftRows%></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=draftPct%>%;'></div></div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14'><a class='sl-report-link' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>Update</a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline arrows-4-restore zcs-color-theme'></i>Returned</div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=returnedRows%></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=returnedPct%>%;'></div></div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14'><a class='sl-report-link' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>Review remarks</a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline loader-dots-06 zcs-color-theme'></i>Reopened</div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=reopenedRows%></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=reopenedPct%>%;'></div></div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14'><a class='sl-report-link' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>Continue</a></td></tr>
						<tr><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline design-todo zcs-color-theme'></i>Other working</div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=otherWorking%></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary'><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width:<%=otherWorkingPct%>%;'></div></div></td><td class='zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14'><a class='sl-report-link' href='#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog'>Open</a></td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>