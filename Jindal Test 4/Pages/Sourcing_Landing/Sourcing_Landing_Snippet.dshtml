<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Raw Material Budget User";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	myRM = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Locked != true && Status != "Submitted to Sourcing Manager" && Status != "Submitted to Finance" && Status != "Approved" && Status != "Locked"].count();
	draftRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Locked != true && Status == "Draft"].count();
	returnedRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Locked != true && Status.contains("Returned")].count();
	reopenedRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName && Locked != true && Status == "Reopened"].count();
	otherWorking = myRM - draftRows - returnedRows - reopenedRows;
	if(otherWorking < 0)
	{
		otherWorking = 0;
	}
	sourcingApproval = Raw_Material_Budgets[Status == "Submitted to Sourcing Manager" && Locked != true].count();
	financeApproval = Raw_Material_Budgets[Status == "Submitted to Finance" && Locked != true].count();
	approved = Raw_Material_Budgets[Status == "Approved" || Locked == true].count();
	totalRM = Raw_Material_Budgets[ID != 0].count();
	materials = Raw_Materials[ID != 0].count();
	pendingTotal = myRM + sourcingApproval + financeApproval;
	approvalPct = 0;
	pendingPct = 0;
	draftPct = 0;
	returnedPct = 0;
	reopenedPct = 0;
	otherWorkingPct = 0;
	if(totalRM > 0)
	{
		approvalPct = (approved * 100) / totalRM;
		pendingPct = (pendingTotal * 100) / totalRM;
	}
	if(myRM > 0)
	{
		draftPct = (draftRows * 100) / myRM;
		returnedPct = (returnedRows * 100) / myRM;
		reopenedPct = (reopenedRows * 100) / myRM;
		otherWorkingPct = (otherWorking * 100) / myRM;
	}
	%>
<style>
