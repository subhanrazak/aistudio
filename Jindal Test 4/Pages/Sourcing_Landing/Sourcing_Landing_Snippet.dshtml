rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:#fff}.zcs-card{background-color:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:#fff;color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:#fff;box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-panel-wrapper ul li{list-style-type:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px 0 #F2F2F6;background-color:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px}.zcs-panel-icon{width:24px;height:24px;line-height:24px}.zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper{background-color:#E4FCF3;color:#179E6C}.zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper{background-color:#FCF4E6;color:#B8770D}.zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper{background-color:#EAF2FF;color:#1652BB}.zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper{background-color:#fdf5f3;color:#ff8b11}.zcs-panel-wrapper .zcs-overlay{top:0;left:0}.zcs-panel-wrapper li:hover .zcs-panel{border-color:var(--zcs_brand_color);background-image:linear-gradient(rgb(253 253 255 / 10%),#f7f9ff)}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background-color:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.sl-shell{background:var(--zcs-page-bg-color);min-height:100%;font-family:inherit}.sl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#17324d);border:0;color:var(--zcs_brand_foreground_color);box-shadow:0 10px 28px rgba(0,0,0,.12)}.sl-hero .zcs-color-primary,.sl-hero .zcs-color-tertiary{color:var(--zcs_brand_foreground_color)}.sl-hero p{max-width:780px;opacity:.92}.sl-hero .zcs-primary-outline-button{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.55);color:var(--zcs_brand_foreground_color)}.sl-kpi-number{font-size:30px;line-height:1.05}.sl-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}.sl-action-count{margin-left:auto}.sl-mini-stat{border-top:1px solid var(--zcs_tertiary_border_color)}.sl-muted-card{background:#F9FAFE}.sl-report-link{color:var(--zcs_brand_color)}.sl-nowrap{white-space:nowrap}@media(max-width:992px){.zcs-col-md-6{flex:0 0 calc(50% - var(--column-gap)*.5);max-width:calc(50% - var(--column-gap)*.5)}.sl-grid{grid-template-columns:1fr}.sl-hero{align-items:flex-start;flex-direction:column}.sl-header-actions{flex-wrap:wrap}}@media(max-width:768px){.zcs-col-sm-6{flex:0 0 calc(50% - var(--column-gap)*.5);max-width:calc(50% - var(--column-gap)*.5)}.zcs-page-container-inner{padding:16px 20px}.zcs-panel-wrapper ul{gap:12px}}@media(max-width:576px){.zcs-col-xs-12{flex:0 0 100%;max-width:100%}.sl-kpi-number{font-size:24px}.sl-header-actions .zcs-button{width:100%}}
