<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Sales Management";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	managementQueue = Sales_Plans[Status == "Submitted to Sales Management" && Locked != true].count();
	pendingPlans = Sales_Plans[Status == "Submitted to Sales Management" && Locked != true] sort by Modified_Time desc range from 0 to 7;
	returnedRevision = Sales_Plans[Locked != true && Status == "Returned by Sales Management" || Status == "Revision Requested by SCM" || Status == "Revised Draft"].count();
	approvedFinal = Sales_Plans[Status == "Sales Approved" || Status == "Locked" || Status == "Superseded" || Locked == true].count();
	shortfallBuckets = Volume_Consolidations[Status == "Sales Revision Pending" || Status == "Both Revisions Pending"].count();
	allPlans = Sales_Plans[ID != 0].count();
	focusTone = "green";
	focusBadge = "Queue clear";
	focusTitle = "No pending management approvals";
	focusText = "Final, locked and superseded records are excluded from this landing page action queue. Keep monitoring returned revisions and shortfall buckets for new exceptions.";
	focusHref = "#Report:All_Sales_Plans?zc_LoadIn=dialog";
	focusIcon = "ui-1-check-circle-08";
	if(managementQueue > 0)
	{
		focusTone = "red";
		focusBadge = "Approve or return";
		focusTitle = "Start with the management approval queue";
		focusText = managementQueue + " submitted sales plan row(s) are waiting for Sales Management action. Open each record in dialog mode, choose Approver Action, and add remarks before approving or returning.";
		focusHref = "#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog";
		focusIcon = "business-signature";
	}
	else if(returnedRevision > 0)
	{
		focusTone = "yellow";
		focusBadge = "Revision watch";
		focusTitle = "Returned and revision rows need follow-up";
		focusText = returnedRevision + " open returned or revision row(s) may come back for approval after owner correction. Review All Sales Plans for latest ownership and remarks.";
		focusHref = "#Report:All_Sales_Plans?zc_LoadIn=dialog";
		focusIcon = "arrows-1-refresh-69";
	}
	else if(shortfallBuckets > 0)
	{
		focusTone = "orange";
		focusBadge = "Commercial exception";
		focusTitle = "Review sales shortfall buckets";
		focusText = shortfallBuckets + " sales shortfall bucket(s) are active. Use them as supporting insight before the next approval wave arrives.";
		focusHref = "#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog";
		focusIcon = "business-chart-pie-36";
	}
	queueShare = 0;
	if(allPlans > 0)
	{
		queueShare = (managementQueue * 100) / allPlans;
	}
	%>
<style>
/* zcs-global.css core utilities included once for this page */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;font-size:16px;line-height:1.5}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598E}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-no-shrink{flex-shrink:0}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky;top:0}.zcs-cursor-pointer{cursor:pointer}
/* ZCS component CSS: button, badge, quick-actions, label-value and simple table */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#A06A00}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#C94F07}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow{color:#a06309}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#FF7E52}.zcs-labelvalue-wrapper .zcs-labelvalue-color-red{color:#FE455D}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}
/* Sales Management command-center layout */
div#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important;padding:0!important}.sml-shell{min-height:100vh;background:radial-gradient(circle at 82% 6%,rgba(255,255,255,.98) 0,rgba(255,255,255,0) 34%),linear-gradient(135deg,#f8fbff 0%,var(--zcs_brand_light_color) 48%,#f3f3f4 100%);padding:24px;box-sizing:border-box;color:var(--zcs_primary_text_color)}.sml-container{max-width:1500px;margin:0 auto}.sml-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:22px;padding:24px;box-shadow:0 18px 48px rgba(16,24,40,.14);color:var(--zcs_brand_foreground_color);position:relative;overflow:hidden}.sml-hero:after{content:"";position:absolute;width:330px;height:330px;border:1px solid rgba(255,255,255,.24);border-radius:50%;right:-124px;top:-154px;box-shadow:0 0 0 34px rgba(255,255,255,.06),0 0 0 80px rgba(255,255,255,.04)}.sml-hero-inner{position:relative;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.sml-title{font-size:30px;font-weight:800;line-height:1.2;margin:0 0 8px}.sml-subtitle{max-width:820px;margin:0;color:rgba(255,255,255,.88)}.sml-profile-pill{border:1px solid rgba(255,255,255,.38);border-radius:999px;padding:8px 12px;background:rgba(255,255,255,.12);white-space:nowrap}.sml-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.sml-hero-actions .zcs-button{border-color:rgba(255,255,255,.58);background:rgba(255,255,255,.14);color:var(--zcs_brand_foreground_color)}.sml-hero-actions .sml-primary-hero{background:var(--zcs-white-color);border-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.sml-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.sml-kpi{padding:18px;min-height:145px;box-shadow:0 12px 28px rgba(16,24,40,.06);transition:border-color .18s ease,transform .18s ease;color:inherit}.sml-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.sml-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.sml-icon-tile{width:42px;height:42px;border-radius:14px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.sml-kpi-value{font-size:38px;font-weight:800;line-height:1;margin-top:16px}.sml-kpi-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:8px}.sml-main-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(330px,.95fr);gap:16px;margin-top:16px}.sml-panel{padding:18px;box-shadow:0 12px 28px rgba(16,24,40,.05)}.sml-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.sml-section-title h2{margin:0}.sml-focus{border-left:4px solid var(--zcs_brand_color);background:linear-gradient(180deg,#fff,#fbfcff)}.sml-focus.red{border-left-color:#FE455D}.sml-focus.yellow{border-left-color:#FAAE13}.sml-focus.orange{border-left-color:#F4660C}.sml-focus.green{border-left-color:#179E6C}.sml-focus h3{margin:0}.sml-focus-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.sml-note{background:rgba(255,255,255,.74);border:1px dashed var(--zcs_tertiary_border_color);border-radius:14px;padding:12px}.sml-table-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-weight:600}.sml-form-link{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--zcs_brand_color);border-radius:8px;padding:6px 10px;color:var(--zcs_brand_color);background:#fff;font-weight:600;white-space:nowrap}.sml-form-link:hover{background:var(--zcs_component_hover_color)}.sml-muted{color:var(--zcs_secondary_text_color)}.sml-small{font-size:12px}.sml-empty{padding:28px;text-align:center;color:var(--zcs_secondary_text_color)}.sml-support-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.sml-support-item{border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:14px;background:#fff}.sml-quick-actions-wrapper{margin-top:16px}.sml-quick-action-item{list-style:none}.sml-quick-action-link{min-height:42px}.sml-queue-note{display:flex;align-items:flex-start;gap:10px;margin-top:12px}.sml-status-pill{white-space:nowrap}.sml-mobile-list{display:none}.sml-mobile-card{border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;background:#fff;padding:14px}.sml-mobile-card+.sml-mobile-card{margin-top:10px}@media(max-width:1180px){.sml-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sml-main-grid{grid-template-columns:1fr}.sml-support-grid{grid-template-columns:1fr}}@media(max-width:760px){.sml-shell{padding:14px}.sml-hero-inner{flex-direction:column;align-items:flex-start}.sml-title{font-size:24px}.sml-kpi-grid{grid-template-columns:1fr}.sml-desktop-table{display:none}.sml-mobile-list{display:block}.sml-section-title{align-items:flex-start;flex-direction:column}.sml-hero-actions .zcs-button,.sml-focus-actions .zcs-button{width:100%}}
</style>
<div class='sml-shell'>
	<div class='sml-container'>
		<section class='sml-hero'>
			<div class='sml-hero-inner'>
				<div>
					<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
						<i class='zcs-badge-icon zcs-no-shrink zc-li-outline business-signature'></i>
						<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Sales Management command center</span>
					</div>
					<h1 class='sml-title'>Approval queue first for <%=loginName%></h1>
					<p class='sml-subtitle zcs-font-15 zcs-lh-body'>Submitted and unlocked Sales Plans are surfaced first. Approve or return work opens in dialog mode so remarks and Approver Action can be captured on the source record, while final and locked rows stay out of pending actions.</p>
					<div class='sml-hero-actions'>
						<a class='zcs-button zcs-primary-button sml-primary-hero zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog'>
							<i class='zcs-button-icon zc-li-outline business-signature'></i><span>Open approval queue</span>
						</a>
						<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='#Report:All_Sales_Plans?zc_LoadIn=dialog'>
							<i class='zcs-button-icon zc-li-outline business-agenda'></i><span>All sales plans</span>
						</a>
						<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog'>
							<i class='zcs-button-icon zc-li-outline business-chart-pie-36'></i><span>Shortfall buckets</span>
						</a>
					</div>
				</div>
				<div class='sml-profile-pill zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-font-14'>
					<i class='zc-li-outline users-single-01'></i><span><%=profileText%></span>
				</div>
			</div>
		</section>

		<section class='sml-kpi-grid'>
			<a class='sml-kpi zcs-card zcs-box-border' href='#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog'>
				<div class='sml-kpi-top'><span class='zcs-font-13 zcs-color-secondary zcs-uppercase'>Management approval queue</span><span class='sml-icon-tile'><i class='zc-li-outline business-signature'></i></span></div>
				<div class='sml-kpi-value zcs-color-primary'><%=managementQueue%></div>
				<div class='sml-kpi-label'>Submitted to Sales Management and not locked</div>
			</a>
			<a class='sml-kpi zcs-card zcs-box-border' href='#Report:All_Sales_Plans?zc_LoadIn=dialog'>
				<div class='sml-kpi-top'><span class='zcs-font-13 zcs-color-secondary zcs-uppercase'>Returned and revision rows</span><span class='sml-icon-tile'><i class='zc-li-outline arrows-1-refresh-69'></i></span></div>
				<div class='sml-kpi-value zcs-color-primary'><%=returnedRevision%></div>
				<div class='sml-kpi-label'>Returned by Sales Management or in SCM revision loop</div>
			</a>
			<a class='sml-kpi zcs-card zcs-box-border' href='#Report:Approved_Sales_Plans?zc_LoadIn=dialog'>
				<div class='sml-kpi-top'><span class='zcs-font-13 zcs-color-secondary zcs-uppercase'>Approved and final rows</span><span class='sml-icon-tile'><i class='zc-li-outline ui-1-check-circle-08'></i></span></div>
				<div class='sml-kpi-value zcs-color-primary'><%=approvedFinal%></div>
				<div class='sml-kpi-label'>Sales approved, superseded, locked or finalised records</div>
			</a>
			<a class='sml-kpi zcs-card zcs-box-border' href='#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog'>
				<div class='sml-kpi-top'><span class='zcs-font-13 zcs-color-secondary zcs-uppercase'>Sales shortfall buckets</span><span class='sml-icon-tile'><i class='zc-li-outline business-chart-pie-36'></i></span></div>
				<div class='sml-kpi-value zcs-color-primary'><%=shortfallBuckets%></div>
				<div class='sml-kpi-label'>Commercial exceptions requiring sales-side revision</div>
			</a>
		</section>

		<section class='sml-main-grid'>
			<div class='sml-panel zcs-card zcs-box-border'>
				<div class='sml-section-title'>
					<div>
						<h2 class='zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary'>Pending actions</h2>
						<p class='zcs-font-14 zcs-color-secondary zcs-m-0'>Latest 8 Sales Plans with Status equals Submitted to Sales Management, sorted by Modified Time descending. Locked and final rows are excluded.</p>
					</div>
					<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'>
						<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time'></i>
						<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=managementQueue%> pending</span>
					</div>
				</div>
<%
	if(pendingPlans.count() == 0)
	{
		%>
<div class='sml-empty zcs-card'>
					<i class='zc-li-outline ui-1-check-circle-08 zcs-font-30 zcs-color-green'></i>
					<div class='zcs-font-16 zcs-font-semibold zcs-color-primary zcs-mt-8'>No submitted and unlocked Sales Plans are waiting for management action.</div>
					<div class='zcs-font-14 sml-muted zcs-mt-4'>Use the quick navigation panel to review approved rows, returned revisions, or commercial exceptions.</div>
				</div>
<%
	}
	else
	{
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative sml-desktop-table'>
					<table class='zcs-w-full'>
						<thead class='zcs-sticky'>
							<tr>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Sales plan</th>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Cycle</th>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Target tons</th>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Variance</th>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Modified</th>
								<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Open work</th>
							</tr>
						</thead>
						<tbody>
<%
		for each  plan in pendingPlans
		{
			fyText = "-";
			cycleText = "-";
			if(plan.Requested_Financial_Year != null)
			{
				fyText = plan.Requested_Financial_Year.Year_Name;
			}
			if(plan.Budget_Cycle != null)
			{
				cycleText = plan.Budget_Cycle.Cycle_Name;
			}
			%>
<tr>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
									<a class='sml-table-link' href='#Report:Sales_Management_Approval_Queue?ID=<%=plan.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-eye-17'></i><span><%=plan.Sales_Plan_No%></span></a>
									<div class='sml-small sml-muted'>Owner: <%=ifnull(plan.Owner_Email,"-")%></div>
								</td>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=fyText%><div class='sml-small sml-muted'><%=cycleText%></div></td>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=ifnull(plan.Total_Grade_Target_Tons,0)%></td>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow'><%=ifnull(plan.Variance_Tons,0)%></td>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=plan.Modified_Time%><div class='sml-small sml-muted'>Status: <%=plan.Status%></div></td>
								<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
									<a class='sml-form-link' href='#Form:Sales_Plans?recLinkID=<%=plan.ID%>&amp;viewLinkName=Sales_Management_Approval_Queue&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>Open/Edit Form</span></a>
								</td>
							</tr>
<%
		}
		%>
</tbody>
					</table>
				</div>

				<div class='sml-mobile-list'>
<%
		for each  planMobile in pendingPlans
		{
			fyMobile = "-";
			cycleMobile = "-";
			if(planMobile.Requested_Financial_Year != null)
			{
				fyMobile = planMobile.Requested_Financial_Year.Year_Name;
			}
			if(planMobile.Budget_Cycle != null)
			{
				cycleMobile = planMobile.Budget_Cycle.Cycle_Name;
			}
			%>
<div class='sml-mobile-card'>
						<div class='zcs-flex zcs-justify-space-between zcs-gap-12 zcs-align-items-start'>
							<a class='sml-table-link zcs-font-16' href='#Report:Sales_Management_Approval_Queue?ID=<%=planMobile.ID%>&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-eye-17'></i><span><%=planMobile.Sales_Plan_No%></span></a>
							<span class='zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 sml-status-pill'>Pending</span>
						</div>
						<div class='zcs-labelvalue-wrapper zcs-mt-8'>
							<ul class='zcs-row zcs-p-0 zcs-m-0'>
								<li class='zcs-flex zcs-direction-column zcs-gap-4 zcs-py-4 zcs-box-border' style='width:50%;'><label class='zcs-font-12 zcs-color-tertiary'>Cycle</label><span class='zcs-font-14 zcs-color-primary'><%=fyMobile%> / <%=cycleMobile%></span></li>
								<li class='zcs-flex zcs-direction-column zcs-gap-4 zcs-py-4 zcs-box-border' style='width:50%;'><label class='zcs-font-12 zcs-color-tertiary'>Modified</label><span class='zcs-font-14 zcs-color-primary'><%=planMobile.Modified_Time%></span></li>
							</ul>
						</div>
						<a class='sml-form-link zcs-mt-8' href='#Form:Sales_Plans?recLinkID=<%=planMobile.ID%>&amp;viewLinkName=Sales_Management_Approval_Queue&amp;zc_LoadIn=dialog'><i class='zc-li-outline ui-1-edit-72'></i><span>Open/Edit Form</span></a>
					</div>
<%
		}
		%>
</div>
<%
	}
	%>
<div class='sml-queue-note sml-note zcs-font-14 sml-muted'>
					<i class='zc-li-outline ui-1-alert-circle-i zcs-color-theme zcs-font-18'></i>
					<div>Approve and return actions require source-record context. Use Open/Edit Form to set Approver Action and Approval Remarks in the dialog rather than adding a report-button workflow on this page.</div>
				</div>
			</div>

			<aside>
				<div class='sml-panel sml-focus <%=focusTone%> zcs-card zcs-box-border'>
					<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
						<span class='sml-icon-tile'><i class='zc-li-outline <%=focusIcon%>'></i></span>
						<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
							<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'><%=focusBadge%></span>
						</div>
					</div>
					<h3 class='zcs-font-22 zcs-font-semibold zcs-color-primary zcs-mt-16'><%=focusTitle%></h3>
					<p class='zcs-font-14 sml-muted zcs-lh-body'><%=focusText%></p>
					<div class='sml-focus-actions'>
						<a class='zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='<%=focusHref%>'><i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i><span>Open priority</span></a>
					</div>
				</div>

				<div class='sml-support-grid'>
					<div class='sml-support-item'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline business-chart-bar-32 zcs-color-theme'></i><strong class='zcs-font-14 zcs-color-primary'>Queue share</strong></div>
						<div class='zcs-font-24 zcs-font-bold zcs-color-primary zcs-mt-8'><%=queueShare%>%</div>
						<div class='zcs-font-13 sml-muted'>Pending queue as a share of all Sales Plans</div>
					</div>
					<div class='sml-support-item'>
						<div class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-1-check-circle-08 zcs-color-green'></i><strong class='zcs-font-14 zcs-color-primary'>Final control</strong></div>
						<div class='zcs-font-24 zcs-font-bold zcs-color-primary zcs-mt-8'><%=approvedFinal%></div>
						<div class='zcs-font-13 sml-muted'>Approved, superseded or locked records kept out of action queue</div>
					</div>
				</div>

				<div class='zcs-quick-actions-wrapper sml-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border'>
					<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Quick navigation</h5>
					<ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
						<li class='zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'>
							<a class='zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog'>
								<i class='zcs-quick-action-icon zcs-font-medium zc-li-outline business-signature'></i><span class='zcs-quick-action-text'>Approval queue</span>
							</a>
						</li>
						<li class='zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'>
							<a class='zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:All_Sales_Plans?zc_LoadIn=dialog'>
								<i class='zcs-quick-action-icon zcs-font-medium zc-li-outline business-agenda'></i><span class='zcs-quick-action-text'>All sales plans</span>
							</a>
						</li>
						<li class='zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'>
							<a class='zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:Approved_Sales_Plans?zc_LoadIn=dialog'>
								<i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08'></i><span class='zcs-quick-action-text'>Approved sales plans</span>
							</a>
						</li>
						<li class='zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'>
							<a class='zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog'>
								<i class='zcs-quick-action-icon zcs-font-medium zc-li-outline business-chart-pie-36'></i><span class='zcs-quick-action-text'>Sales shortfall buckets</span>
							</a>
						</li>
					</ul>
				</div>
			</aside>
		</section>
	</div>
</div>