<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Executive Management";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	activeCycles = Budget_Cycles[Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final"].count();
	managementQueue = Financial_Consolidations[Status == "Submitted to Management" && Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final" && Locked != true].count();
	finalBudgets = Financial_Consolidations[Status == "Approved Final" || Status == "Completed" || Status == "Locked" || Locked == true].count();
	financialTotal = Financial_Consolidations[ID != 0].count();
	finalBudgetRate = 0;
	if(financialTotal > 0)
	{
		finalBudgetRate = (finalBudgets * 100) / financialTotal;
	}
	shortfalls = Volume_Consolidations[Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" && Status != "Completed" && Status != "Closed" && Status != "Locked" && Locked != true].count();
	criticalEvents = Approval_Audit_Log[Action == "Returned" || Action == "Reopened" || Action == "Locked" || Action == "Final Approved" || Action == "Completed"].count();
	auditNeeds = Approval_Audit_Log[Action == "Returned" || Action == "Reopened"].count();
	finalAuditSignals = Approval_Audit_Log[Action == "Locked" || Action == "Final Approved" || Action == "Completed"].count();
	replans = Replanning_Requests[Status == "Submitted to Finance" || Status == "Finance Approved" || Status == "Revision Created" && Status != "Completed" && Status != "Closed" && Status != "Locked"].count();
	scenarioCycleId = 0;
	scenarioCycleName = "";
	for each  cycleRec in Budget_Cycles[Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final" && Baseline_Locked != true && Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0
	{
		scenarioCycleId = cycleRec.ID;
		scenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,"Active cycle"));
	}
	scenarioComparisonUrl = "";
	if(scenarioCycleId != 0)
	{
		scenarioComparisonUrl = "#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=" + scenarioCycleId;
	}
	decisionLoad = managementQueue + replans + auditNeeds + shortfalls;
	watchTotal = activeCycles + managementQueue + replans + auditNeeds + shortfalls;
	if(watchTotal == 0)
	{
		watchTotal = 1;
	}
	mgmtPct = (managementQueue * 100) / watchTotal;
	replanPct = (replans * 100) / watchTotal;
	auditPct = (auditNeeds * 100) / watchTotal;
	shortfallPct = (shortfalls * 100) / watchTotal;
	urgentTitle = "Open scenario comparison dashboard";
	urgentCopy = "No urgent exception is ahead of the decision queue. Continue monitoring the latest active/open Budget Cycle and final budget readiness.";
	urgentUrl = scenarioComparisonUrl;
	if(urgentUrl == "")
	{
		urgentUrl = "#Page:Executive_Budget_Dashboard";
	}
	urgentCount = activeCycles;
	urgentLabel = "Comparison";
	urgentIcon = "zc-li-outline business-chart-pie-36";
	urgentTone = "zcs-badge-blue";
	if(auditNeeds > 0)
	{
		urgentTitle = "Investigate returned or reopened audit signals";
		urgentCopy = "Critical audit activity needs executive visibility before the next final-readiness checkpoint.";
		urgentUrl = "#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog";
		urgentCount = auditNeeds;
		urgentLabel = "Audit signals";
		urgentIcon = "zc-li-outline ui-1-circle-remove";
		urgentTone = "zcs-badge-red";
	}
	else if(managementQueue > 0)
	{
		urgentTitle = "Review management submissions";
		urgentCopy = "Financial consolidation records are submitted for management decision and exclude completed, locked, and final-approved items.";
		urgentUrl = "#Report:Scenario_Financial_Summary?zc_LoadIn=dialog";
		urgentCount = managementQueue;
		urgentLabel = "Submissions";
		urgentIcon = "zc-li-outline business-signature";
		urgentTone = "zcs-badge-yellow";
	}
	else if(replans > 0)
	{
		urgentTitle = "Resolve replanning watch items";
		urgentCopy = "Replanning requests are in finance review, finance approved, or revision-created states and should be closed into the next cycle.";
		urgentUrl = "#Report:Active_Replanning_Requests?zc_LoadIn=dialog";
		urgentCount = replans;
		urgentLabel = "Replans";
		urgentIcon = "zc-li-outline arrows-1-refresh-69";
		urgentTone = "zcs-badge-orange";
	}
	else if(shortfalls > 0)
	{
		urgentTitle = "Review SCM shortfall revision buckets";
		urgentCopy = "Shortfall or revision-pending volume buckets remain open and may affect final budget readiness.";
		urgentUrl = "#Page:Executive_Budget_Dashboard";
		urgentCount = shortfalls;
		urgentLabel = "Shortfalls";
		urgentIcon = "zc-li-outline ui-2-time";
		urgentTone = "zcs-badge-yellow";
	}
	%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#F3F3F4;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;--zcs-light-bg-color:var(--zcs_brand_light_color)}
.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-primary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px;font-style:normal}.zcs-badge{width:auto;border:1px solid}.zcs-badge-icon{font-style:normal}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9F6500}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#C84F09}
.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}
.el-command-center{background:linear-gradient(180deg,#f6f7fb 0%,var(--zcs-page-bg-color) 100%);padding:24px;box-sizing:border-box;color:var(--zcs-primary-text-color);font-family:inherit}.el-hero{position:relative;overflow:hidden;padding:26px;border:0;background:linear-gradient(135deg,var(--zcs_brand_color) 0%,#17324d 68%,#111827 100%);color:var(--zcs_brand_foreground_color);box-shadow:0 18px 45px rgba(17,24,39,.18)}.el-hero:after{content:"";position:absolute;right:-90px;top:-120px;width:320px;height:320px;border-radius:50%;border:42px solid rgba(255,255,255,.10)}.el-hero-main{position:relative;z-index:1}.el-eyebrow{letter-spacing:.08em;text-transform:uppercase;opacity:.82}.el-title{font-size:30px;line-height:1.15;margin:8px 0}.el-subtitle{max-width:860px;margin:0;opacity:.9}.el-hero-side{position:relative;z-index:1;min-width:230px}.el-link-light{color:var(--zcs_brand_foreground_color);border-color:rgba(255,255,255,.55);background:rgba(255,255,255,.12)}.el-kpi-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-top:16px}.el-kpi{display:block;padding:18px;color:inherit;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}.el-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 12px 28px rgba(17,24,39,.08)}.el-kpi-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.el-kpi-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.el-kpi-value{display:block;font-size:32px;font-weight:700;line-height:1;margin:15px 0 6px}.el-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color)}.el-kpi-meta{font-size:12px;color:var(--zcs-teritiary-text-color)}.el-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:16px;margin-top:16px}.el-panel{padding:20px}.el-panel-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.el-panel h3{font-size:18px;margin:0}.el-focus{border:1px solid rgba(244,102,12,.22);background:linear-gradient(135deg,#fff 0%,#fff8f1 100%)}.el-focus-icon{width:52px;height:52px;border-radius:16px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:24px}.el-focus-copy{margin:10px 0 16px;color:var(--zcs-secondary-text-color)}.el-action-list{display:grid;gap:10px}.el-action{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:12px;align-items:center;padding:13px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff;color:inherit}.el-action:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.el-action-icon{width:34px;height:34px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.el-action-title{font-weight:600;color:var(--zcs-primary-text-color)}.el-action-note{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:2px}.el-count{font-size:22px;font-weight:700;color:var(--zcs_brand_color)}.el-insight-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.el-insight{padding:15px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff}.el-insight strong{display:block;margin-bottom:6px}.el-muted{color:var(--zcs-secondary-text-color)}.el-bars{display:grid;gap:11px}.el-bar-row{display:grid;gap:5px}.el-bar-meta{display:flex;justify-content:space-between;font-size:12px;color:var(--zcs-secondary-text-color)}.el-bar{height:8px;border-radius:999px;background:#eef0f5;overflow:hidden}.el-bar span{display:block;height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.el-bar.audit span{background:#FE455D}.el-bar.replan span{background:#F4660C}.el-bar.shortfall span{background:#FAAE13}.el-readiness{margin-top:14px;padding:14px;border-radius:12px;background:#f9fafe;border:1px solid var(--zcs_tertiary_border_color)}.el-table-link{color:var(--zcs_brand_color);font-weight:600}.el-table-link:hover{text-decoration:underline}.el-note{margin-top:12px;font-size:12px;color:var(--zcs-secondary-text-color)}@media(max-width:1180px){.el-kpi-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.el-grid{grid-template-columns:1fr}}@media(max-width:720px){.el-command-center{padding:14px}.el-hero{padding:20px}.el-title{font-size:24px}.el-kpi-strip,.el-insight-grid{grid-template-columns:1fr}.el-action{grid-template-columns:auto minmax(0,1fr)}.el-count{grid-column:2}.el-hero-side{min-width:0;width:100%}}
</style>
<div class='el-command-center'>
	<section class='el-hero zcs-card zcs-box-border'>
		<div class='zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-20 el-hero-main'>
			<div>
				<div class='el-eyebrow zcs-font-12 zcs-font-semibold'>Executive landing command center</div>
				<h1 class='el-title zcs-font-bold'>Budget decisions, replanning watch, and audit signals</h1>
				<p class='el-subtitle zcs-font-14 zcs-lh-body'>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Pending queues exclude Completed, Closed, Locked, and Approved Final states; those states appear only in final-readiness metrics.</p>
			</div>
			<div class='el-hero-side zcs-flex zcs-direction-column zcs-gap-12'>
				<div class='zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border'>
					<i class='zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01'></i>
					<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=profileText%></span>
				</div>
				<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body el-link-light' href='#Page:Executive_Budget_Dashboard'>
					<i class='zcs-button-icon zc-li-outline business-chart'></i>
					<span class='zcs-button-text'>Open dashboard</span>
				</a>
			</div>
		</div>
	</section>

	<section class='el-kpi-strip'>
		<a class='el-kpi zcs-card zcs-box-border' href='#Report:Active_Budget_Cycles?zc_LoadIn=dialog'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Active cycles</span><span class='el-kpi-icon'><i class='zc-li-outline business-chart'></i></span></div>
			<strong class='el-kpi-value'><%=activeCycles%></strong>
			<div class='el-kpi-label'>Planning or review cycles still open</div>
		</a>
<%
	if(scenarioCycleId != 0)
	{
		%>
<a class='el-kpi zcs-card zcs-box-border' href='<%=scenarioComparisonUrl%>'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Scenario comparison</span><span class='el-kpi-icon'><i class='zc-li-outline business-chart-pie-36'></i></span></div>
			<strong class='el-kpi-value'><%=managementQueue%></strong>
			<div class='el-kpi-label'>Compare <%=scenarioCycleName%> and open decision scenarios</div>
		</a>
<%
	}
	else
	{
		%>
<div class='el-kpi zcs-card zcs-box-border' style='opacity:.72;'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Scenario comparison</span><span class='el-kpi-icon'><i class='zc-li-outline ui-1-circle-remove'></i></span></div>
			<strong class='el-kpi-value'>0</strong>
			<div class='el-kpi-label'>No active/open Budget Cycle is available</div>
		</div>
<%
	}
	%>
<a class='el-kpi zcs-card zcs-box-border' href='#Report:Approved_Final_Budgets?zc_LoadIn=dialog'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Final budgets</span><span class='el-kpi-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span></div>
			<strong class='el-kpi-value'><%=finalBudgets%></strong>
			<div class='el-kpi-label'>Approved final, completed, or locked records</div>
		</a>
		<a class='el-kpi zcs-card zcs-box-border' href='#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Critical events</span><span class='el-kpi-icon'><i class='zc-li-outline ui-1-circle-remove'></i></span></div>
			<strong class='el-kpi-value'><%=criticalEvents%></strong>
			<div class='el-kpi-label'>Returned, reopened, locked, or final actions</div>
		</a>
		<a class='el-kpi zcs-card zcs-box-border' href='#Report:Active_Replanning_Requests?zc_LoadIn=dialog'>
			<div class='el-kpi-head'><span class='zcs-font-13 zcs-font-semibold zcs-color-secondary'>Replanning watch</span><span class='el-kpi-icon'><i class='zc-li-outline arrows-1-refresh-69'></i></span></div>
			<strong class='el-kpi-value'><%=replans%></strong>
			<div class='el-kpi-label'>Submitted, finance-approved, or revision-created requests</div>
		</a>
	</section>

	<section class='el-grid'>
		<div class='zcs-flex zcs-direction-column zcs-gap-16'>
			<div class='el-panel el-focus zcs-card zcs-box-border'>
				<div class='zcs-flex zcs-align-items-start zcs-gap-16'>
					<div class='el-focus-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink'><i class='<%=urgentIcon%>'></i></div>
					<div class='zcs-col-common'>
						<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
							<div class='zcs-badge zcs-badge-filled-outline <%=urgentTone%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border'>
								<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time'></i>
								<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>Most urgent next action</span>
							</div>
							<strong class='el-count'><%=urgentCount%></strong>
						</div>
						<h2 class='zcs-font-24 zcs-font-bold zcs-lh-heading zcs-color-primary zcs-m-0 zcs-mt-8'><%=urgentTitle%></h2>
						<p class='el-focus-copy zcs-font-14 zcs-lh-body'><%=urgentCopy%></p>
						<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=urgentUrl%>'>
							<i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
							<span class='zcs-button-text'>Act on <%=urgentLabel%></span>
						</a>
					</div>
				</div>
			</div>

			<div class='el-panel zcs-card zcs-box-border'>
				<div class='el-panel-title'>
					<h3 class='zcs-font-semibold zcs-color-primary'>Decision shortcuts</h3>
					<span class='zcs-font-12 zcs-color-tertiary'>Executive action links</span>
				</div>
				<div class='el-action-list'>
<%
	if(scenarioCycleId != 0)
	{
		%>
<a class='el-action' href='<%=scenarioComparisonUrl%>'>
						<span class='el-action-icon'><i class='zc-li-outline business-chart-pie-36'></i></span>
						<span><span class='el-action-title'>Scenario comparison dashboard</span><span class='el-action-note'>Open <%=scenarioCycleName%> for side-by-side decision review</span></span>
						<span class='el-count'><%=activeCycles%></span>
					</a>
<%
	}
	else
	{
		%>
<div class='el-action' style='opacity:.72;'>
						<span class='el-action-icon'><i class='zc-li-outline ui-1-circle-remove'></i></span>
						<span><span class='el-action-title'>Scenario comparison dashboard</span><span class='el-action-note'>No active/open Budget Cycle is available for comparison</span></span>
						<span class='el-count'>0</span>
					</div>
<%
	}
	%>
<a class='el-action' href='#Page:Executive_Budget_Dashboard'>
						<span class='el-action-icon'><i class='zc-li-outline business-chart'></i></span>
						<span><span class='el-action-title'>Executive budget dashboard</span><span class='el-action-note'>Command view for cycle, scenario, and final readiness decisions</span></span>
						<span class='el-count'><%=activeCycles%></span>
					</a>
					<a class='el-action' href='#Report:Scenario_Financial_Summary?zc_LoadIn=dialog'>
						<span class='el-action-icon'><i class='zc-li-outline business-signature'></i></span>
						<span><span class='el-action-title'>Review management submissions</span><span class='el-action-note'>Submitted to Management, excluding completed, locked, and final-approved records</span></span>
						<span class='el-count'><%=managementQueue%></span>
					</a>
					<a class='el-action' href='#Report:Active_Replanning_Requests?zc_LoadIn=dialog'>
						<span class='el-action-icon'><i class='zc-li-outline arrows-1-refresh-69'></i></span>
						<span><span class='el-action-title'>Monitor replanning requests</span><span class='el-action-note'>Submitted to Finance, Finance Approved, or Revision Created</span></span>
						<span class='el-count'><%=replans%></span>
					</a>
					<a class='el-action' href='#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog'>
						<span class='el-action-icon'><i class='zc-li-outline ui-1-circle-remove'></i></span>
						<span><span class='el-action-title'>Investigate critical audit signals</span><span class='el-action-note'>Returned or reopened events for executive follow-up</span></span>
						<span class='el-count'><%=auditNeeds%></span>
					</a>
				</div>
			</div>
		</div>

		<div class='zcs-flex zcs-direction-column zcs-gap-16'>
			<div class='el-panel zcs-card zcs-box-border'>
				<div class='el-panel-title'>
					<h3 class='zcs-font-semibold zcs-color-primary'>Enterprise insight cards</h3>
					<span class='zcs-font-12 zcs-color-tertiary'>Live operational summary</span>
				</div>
				<div class='el-insight-grid'>
					<div class='el-insight'><strong>Management submissions</strong><div class='el-muted zcs-font-13'><%=managementQueue%> financial scenario records need management decision.</div></div>
					<div class='el-insight'><strong>Replanning exposure</strong><div class='el-muted zcs-font-13'><%=replans%> replanning requests remain on the finance watch path.</div></div>
					<div class='el-insight'><strong>SCM revision pressure</strong><div class='el-muted zcs-font-13'><%=shortfalls%> shortfall or revision-pending volume buckets may affect readiness.</div></div>
					<div class='el-insight'><strong>Audit attention</strong><div class='el-muted zcs-font-13'><%=auditNeeds%> returned or reopened audit events need triage; <%=finalAuditSignals%> are final-readiness signals.</div></div>
				</div>
			</div>

			<div class='el-panel zcs-card zcs-box-border'>
				<div class='el-panel-title'>
					<h3 class='zcs-font-semibold zcs-color-primary'>Decision load distribution</h3>
					<span class='zcs-font-12 zcs-color-tertiary'>Open workload mix</span>
				</div>
				<div class='el-bars'>
					<div class='el-bar-row'><div class='el-bar-meta'><span>Management queue</span><strong><%=managementQueue%></strong></div><div class='el-bar'><span style='width:<%=mgmtPct%>%;'></span></div></div>
					<div class='el-bar-row'><div class='el-bar-meta'><span>Replanning watch</span><strong><%=replans%></strong></div><div class='el-bar replan'><span style='width:<%=replanPct%>%;'></span></div></div>
					<div class='el-bar-row'><div class='el-bar-meta'><span>Critical audit triage</span><strong><%=auditNeeds%></strong></div><div class='el-bar audit'><span style='width:<%=auditPct%>%;'></span></div></div>
					<div class='el-bar-row'><div class='el-bar-meta'><span>SCM revision pressure</span><strong><%=shortfalls%></strong></div><div class='el-bar shortfall'><span style='width:<%=shortfallPct%>%;'></span></div></div>
				</div>
				<div class='el-readiness'>
					<div class='zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'><strong>Final budget readiness</strong><span class='zcs-font-13 zcs-color-secondary'><%=finalBudgets%> of <%=financialTotal%> records</span></div>
					<div class='el-bar zcs-mt-8'><span style='width:<%=finalBudgetRate%>%;'></span></div>
				</div>
			</div>
		</div>
	</section>

	<section class='el-panel zcs-card zcs-box-border' style='margin-top:16px;'>
		<div class='el-panel-title'>
			<h3 class='zcs-font-semibold zcs-color-primary'>Decision links and availability</h3>
			<span class='zcs-font-12 zcs-color-tertiary'>Dialog links open reports in place when available</span>
		</div>
		<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
			<table class='zcs-w-full'>
				<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Area</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Action</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Open count</th></tr></thead>
				<tbody>
<%
	if(scenarioCycleId != 0)
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Scenario comparison</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='el-table-link' href='<%=scenarioComparisonUrl%>'>Open Scenario Comparison Dashboard</a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=activeCycles%></td></tr>
<%
	}
	else
	{
		%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Scenario comparison</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary'>No active/open Budget Cycle available</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'>0</td></tr>
<%
	}
	%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Management submissions</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='el-table-link' href='#Report:Scenario_Financial_Summary?zc_LoadIn=dialog'>Open Scenario Financial Summary</a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=managementQueue%></td></tr>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Replanning watch</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='el-table-link' href='#Report:Active_Replanning_Requests?zc_LoadIn=dialog'>Open Active Replanning Requests</a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=replans%></td></tr>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary'>Critical audit signals</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14'><a class='el-table-link' href='#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog'>Open Management Critical Audit Events</a></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary'><%=auditNeeds%></td></tr>
				</tbody>
			</table>
		</div>
		<div class='el-note'>Pending counts intentionally exclude Completed, Closed, Locked, and Approved Final records. Final-readiness metrics include those states to show closure progress.</div>
	</section>
</div>