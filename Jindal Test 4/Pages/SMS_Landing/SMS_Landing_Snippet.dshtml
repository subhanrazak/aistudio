<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "SMS Team";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	mySMS = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status == "Returned by Central PPC" || Status == "Reopened" && Status != "Accepted" && Status != "Locked" && Status != "Completed" && Locked != true].count();
	centralPPC = SMS_Capacity_Plans[Status == "Submitted to Central PPC" && Locked != true].count();
	accepted = SMS_Capacity_Plans[Status == "Accepted" || Status == "Validated" || Status == "Locked" || Locked == true && Status != "Completed"].count();
	plantCoverage = Plants[ID != 0].count();
	openWork = mySMS + centralPPC;
	%>
<style>
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-5{flex:0 0 calc(41.666% - 10px);max-width:calc(41.666% - 10px)}.zcs-col-7{flex:0 0 calc(58.333% - 8px);max-width:calc(58.333% - 8px)}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-w-full{width:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}.zcs-page-header{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color,#1c3d5a));border:0;border-radius:16px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:rgba(255,255,255,.15);border-color:rgba(255,255,255,.42);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9B6400}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#F1F2F4;border-color:#D7DCE2;color:#525967}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#F4660C}.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow{color:#9B6400}.sms-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;min-height:100%;color:var(--zcs-primary-text-color)}.sms-hero{box-shadow:0 14px 28px rgba(20,29,51,.12);overflow:hidden;position:relative}.sms-hero:after{content:"";position:absolute;right:-54px;top:-72px;width:210px;height:210px;border:34px solid rgba(255,255,255,.12);border-radius:50%;pointer-events:none}.sms-hero-title{color:var(--zcs_brand_foreground_color);font-size:28px}.sms-hero-copy{max-width:760px;color:var(--zcs_brand_foreground_color);opacity:.9}.sms-eyebrow{letter-spacing:.08em;color:var(--zcs_brand_foreground_color);opacity:.78}.sms-hero .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.sms-kpi-grid{margin-top:16px}.sms-kpi{min-height:158px;color:inherit;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.sms-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 10px 22px rgba(20,29,51,.08)}.sms-kpi-top{min-height:34px}.sms-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.sms-kpi-value{font-size:34px;line-height:1;color:var(--zcs-primary-text-color)}.sms-kpi-note{min-height:40px}.sms-content{margin-top:16px}.sms-panel{min-height:100%}.sms-section-head{margin-bottom:14px}.sms-action-list{list-style:none}.sms-action-card{border-radius:12px;transition:border-color .15s ease,background-color .15s ease}.sms-action-card.is-primary{background:linear-gradient(0deg,var(--zcs_component_hover_color),var(--zcs-white-color))}.sms-action-link{color:inherit;width:100%}.sms-action-title{display:block;color:var(--zcs-primary-text-color)}.sms-action-meta{display:block;color:var(--zcs-secondary-text-color);margin-top:2px}.sms-action-count{min-width:48px;text-align:center;border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:6px 10px}.sms-arrow{color:var(--zcs-teritiary-text-color)}.sms-insight-list{list-style:none}.sms-insight-item{border-top:1px solid var(--zcs-border-color)}.sms-insight-item:first-child{border-top:0}.sms-insight-link{color:var(--zcs_brand_color);font-weight:600}.sms-footer-links{border-top:1px solid var(--zcs-border-color);margin-top:14px;padding-top:14px}.sms-footer-links a{color:var(--zcs_brand_color)}@media(max-width:992px){.zcs-col-md-12{flex:0 0 100%;max-width:100%}.sms-hero{align-items:flex-start;flex-direction:column}.sms-hero-actions{width:100%;justify-content:flex-start}.zcs-col-3{flex:0 0 calc(50% - 8px);max-width:calc(50% - 8px)}}@media(max-width:576px){.sms-shell{padding:12px}.zcs-col-xs-12,.zcs-col-3,.zcs-col-5,.zcs-col-7{flex:0 0 100%;max-width:100%}.sms-hero{padding:18px}.sms-hero-actions{flex-direction:column;align-items:stretch}.sms-hero-actions .zcs-button{width:100%}.sms-kpi-value{font-size:30px}.sms-action-link{align-items:flex-start}.sms-action-count{min-width:40px}}
</style>
<div class='sms-shell'>
	<div class='zcs-page-header sms-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common'>
			<div class='sms-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase'>Steel making capacity workspace</div>
			<h2 class='sms-hero-title zcs-font-bold zcs-lh-heading zcs-m-0'>SMS Landing</h2>
			<p class='sms-hero-copy zcs-font-14 zcs-lh-body zcs-m-0'>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Create SMS capacity rows, monitor Central PPC submissions, and keep accepted capacity separate from pending work.</p>
		</div>
		<div class='sms-hero-actions zcs-flex zcs-align-items-center zcs-gap-12'>
			<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
				<i class='zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01'></i>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=profileText%></span>
			</div>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body' href='#Form:SMS_Capacity_Plans?zc_LoadIn=dialog'>
				<i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
				<span class='zcs-button-text'>Add SMS Capacity</span>
			</a>
		</div>
	</div>

	<div class='sms-kpi-grid zcs-row zcs-gap-16'>
		<a class='sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border' href='#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog'>
			<div class='sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-edit-72'></i></span>
				<span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><i class='zc-li-outline users-single-01'></i><span class='zcs-font-12'>Mine</span></span>
			</div>
			<div>
				<div class='zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase'>My SMS active rows</div>
				<strong class='sms-kpi-value zcs-font-bold'><%=mySMS%></strong>
			</div>
			<div class='sms-kpi-note zcs-font-13 zcs-color-secondary'>Draft, returned or reopened rows owned by this user; final and locked rows are excluded.</div>
		</a>
		<a class='sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border' href='#Report:SMS_Status_Board?zc_LoadIn=dialog'>
			<div class='sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-progress'></i></span>
				<span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><i class='zc-li-outline loader-dots-06'></i><span class='zcs-font-12'>Queue</span></span>
			</div>
			<div>
				<div class='zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase'>Central PPC queue</div>
				<strong class='sms-kpi-value zcs-font-bold'><%=centralPPC%></strong>
			</div>
			<div class='sms-kpi-note zcs-font-13 zcs-color-secondary'>Rows currently submitted to Central PPC and not locked.</div>
		</a>
		<a class='sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border' href='#Report:Accepted_SMS_Capacity?zc_LoadIn=dialog'>
			<div class='sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-archive-check'></i></span>
				<span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><i class='zc-li-outline ui-1-check-circle-08'></i><span class='zcs-font-12'>Final</span></span>
			</div>
			<div>
				<div class='zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase'>Accepted, validated, locked</div>
				<strong class='sms-kpi-value zcs-font-bold'><%=accepted%></strong>
			</div>
			<div class='sms-kpi-note zcs-font-13 zcs-color-secondary'>Accepted base shown as an insight metric, never as pending action.</div>
		</a>
		<a class='sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border' href='#Report:SMS_By_Plant?zc_LoadIn=dialog'>
			<div class='sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
				<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline business-factory'></i></span>
				<span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey'><i class='zc-li-outline business-chart-bar-32'></i><span class='zcs-font-12'>Plants</span></span>
			</div>
			<div>
				<div class='zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase'>Plant coverage</div>
				<strong class='sms-kpi-value zcs-font-bold'><%=plantCoverage%></strong>
			</div>
			<div class='sms-kpi-note zcs-font-13 zcs-color-secondary'>Plants configured for SMS capacity planning coverage.</div>
		</a>
	</div>

	<div class='sms-content zcs-row zcs-gap-16'>
		<section class='zcs-quick-actions-wrapper sms-panel zcs-card zcs-col-7 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
			<div class='sms-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
				<div>
					<h3 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Pending actions</h3>
					<p class='zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8'>Action cards open the form or report in dialog. Completed, accepted and locked records stay out of pending counts.</p>
				</div>
				<span class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey'><i class='zc-li-outline design-todo'></i><span class='zcs-font-12'><%=openWork%> open</span></span>
			</div>
			<ul class='sms-action-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
				<li class='zcs-quick-action-item sms-action-card is-primary zcs-card zcs-px-16 zcs-py-16 zcs-box-border'>
					<a class='zcs-quick-action-link sms-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:SMS_Capacity_Plans?zc_LoadIn=dialog'>
						<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-simple-add'></i></span>
						<span class='zcs-col-common'><strong class='sms-action-title zcs-font-16 zcs-font-semibold'>Add SMS Capacity</strong><span class='sms-action-meta zcs-font-13'>Create a new steel making capacity plan for the relevant plant and melting unit.</span></span>
						<span class='sms-action-count zcs-font-13 zcs-font-semibold'>New</span>
						<i class='sms-arrow zc-li-outline arrows-1-tail-right'></i>
					</a>
				</li>
				<li class='zcs-quick-action-item sms-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border'>
					<a class='zcs-quick-action-link sms-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog'>
						<span class='sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-edit-72'></i></span>
						<span class='zcs-col-common'><strong class='sms-action-title zcs-font-16 zcs-font-semibold'>Update My SMS Rows</strong><span class='sms-action-meta zcs-font-13'>Continue rows owned by this user in Draft, Returned by Central PPC, or Reopened status.</span></span>
						<span class='sms-action-count zcs-font-16 zcs-font-bold'><%=mySMS%></span>
						<i class='sms-arrow zc-li-outline arrows-1-tail-right'></i>
					</a>
				</li>
			</ul>
		</section>

		<section class='zcs-labelvalue-wrapper sms-panel zcs-card zcs-col-5 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
			<div class='sms-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
				<div>
					<h3 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Department insights</h3>
					<p class='zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8'>Central PPC waiting count and accepted base for SMS planning.</p>
				</div>
			</div>
			<ul class='sms-insight-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0'>
				<li class='sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border'>
					<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Central PPC waiting</label>
					<div class='zcs-flex zcs-gap-8 zcs-align-items-start'>
						<i class='zcs-lh-body zcs-labelvalue-color-yellow zc-li-outline business-progress'></i>
						<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><a class='sms-insight-link' href='#Report:SMS_Status_Board?zc_LoadIn=dialog'><%=centralPPC%> rows</a> are submitted to Central PPC and waiting for action.</span>
					</div>
				</li>
				<li class='sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border'>
					<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Accepted base</label>
					<div class='zcs-flex zcs-gap-8 zcs-align-items-start'>
						<i class='zcs-lh-body zcs-labelvalue-color-green zc-li-outline ui-1-check-circle-08'></i>
						<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><a class='sms-insight-link' href='#Report:Accepted_SMS_Capacity?zc_LoadIn=dialog'><%=accepted%> accepted, validated or locked rows</a> form the current SMS capacity base.</span>
					</div>
				</li>
				<li class='sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border'>
					<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Owner criteria</label>
					<div class='zcs-flex zcs-gap-8 zcs-align-items-start'>
						<i class='zcs-lh-body zcs-labelvalue-color-blue zc-li-outline users-single-01'></i>
						<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>My active KPI applies the owner match before status checks, so returned or reopened rows are not counted globally.</span>
					</div>
				</li>
				<li class='sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border'>
					<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Plant coverage</label>
					<div class='zcs-flex zcs-gap-8 zcs-align-items-start'>
						<i class='zcs-lh-body zcs-labelvalue-color-orange zc-li-outline business-factory'></i>
						<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><a class='sms-insight-link' href='#Report:SMS_By_Plant?zc_LoadIn=dialog'><%=plantCoverage%> configured plants</a> are available for capacity planning visibility.</span>
					</div>
				</li>
			</ul>
			<div class='sms-footer-links zcs-flex zcs-gap-12 zcs-row-wrap zcs-font-13'>
				<a class='zcs-inline-flex zcs-align-items-center zcs-gap-6' href='#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog'><i class='zc-li-outline files-chart-pie'></i>All SMS rows</a>
				<a class='zcs-inline-flex zcs-align-items-center zcs-gap-6' href='#Report:SMS_Status_Board?zc_LoadIn=dialog'><i class='zc-li-outline business-progress'></i>Status board</a>
				<a class='zcs-inline-flex zcs-align-items-center zcs-gap-6' href='#Report:SMS_By_Plant?zc_LoadIn=dialog'><i class='zc-li-outline business-factory'></i>By plant</a>
			</div>
		</section>
	</div>
</div>