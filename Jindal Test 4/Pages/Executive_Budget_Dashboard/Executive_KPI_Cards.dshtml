<%
	activeCycleCount = Budget_Cycles[Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final"].count();
	completedCycleCount = Budget_Cycles[Status == "Completed" || Status == "Closed" || Status == "Locked" || Status == "Approved Final"].count();
	approvedSalesCount = Sales_Plans[Status == "Sales Approved" || Locked == true].count();
	approvedOpsAvailability = Capacity_TEP_Plans[Status == "Operations Approved" || Locked == true].count();
	approvedOpsProduction = Operations_Production_Plans[Status == "Operations Approved" || Locked == true].count();
	scmReadyCount = Volume_Consolidations[Status == "Under SCM Review" || Status == "SCM Approved" || Status == "Submitted to Finance" && Status != "Completed" && Status != "Closed" && Status != "Locked" && Locked != true].count();
	financeDecisionCount = Financial_Consolidations[Status == "Submitted to Management" && Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final" && Locked != true].count();
	financeCompletedCount = Financial_Consolidations[Status == "Completed" || Status == "Locked" || Status == "Approved Final" || Locked == true].count();
	criticalEvents = Approval_Audit_Log[Action == "Revision Requested" || Action == "Revision Copy Created" || Action == "Locked" || Action == "Final Approved" || Action == "Completed"].count();
	scenarioCycleId = 0;
	scenarioCycleName = "";
	for each  cycleRec in Budget_Cycles[Status != "Completed" && Status != "Closed" && Status != "Locked" && Status != "Approved Final" && Baseline_Locked != true && Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0
	{
		scenarioCycleId = cycleRec.ID;
		scenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,"Active cycle"));
	}
	scenarioComparisonUrl = "";
	if(scenarioCycleId != 0)
	{
		scenarioComparisonUrl = "#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=" + scenarioCycleId;
	}
	%>
<style>
.ebd-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:16px}.ebd-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:16px;color:inherit;text-decoration:none}.ebd-card-link:hover{border-color:var(--zcs_brand_color);box-shadow:0 8px 18px rgba(20,29,51,.08)}.ebd-card-disabled{opacity:.72}.ebd-label{font-size:12px;color:var(--zcs_secondary_text_color);text-transform:uppercase;letter-spacing:.04em}.ebd-value{font-size:26px;font-weight:700;color:var(--zcs_primary_text_color);margin-top:8px}.ebd-note{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:8px}.ebd-section-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin-bottom:16px}.ebd-section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.ebd-section-title h2{margin:0;color:var(--zcs_primary_text_color);font-size:18px}.ebd-muted{color:var(--zcs_secondary_text_color)}.ebd-feed{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ebd-feed-item{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px;margin-bottom:8px}.ebd-feed-title{display:flex;justify-content:space-between;gap:10px}.ebd-small{font-size:12px}.ebd-matrix-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;overflow:hidden}.ebd-matrix-head,.ebd-matrix-cell{padding:10px;border-top:1px solid var(--zcs_tertiary_border_color)}.ebd-matrix-head{background:#f9fafe;font-weight:600;color:var(--zcs_primary_text_color);border-top:0}.zcs-red{color:#fe455d}.zcs-green{color:#179e6c}@media(max-width:900px){.ebd-grid,.ebd-feed{grid-template-columns:1fr}.ebd-matrix-grid{grid-template-columns:1fr}}
</style>
<div class="ebd-grid">
	<div class="ebd-card"><div class="ebd-label">Active cycles</div><div class="ebd-value"><%=activeCycleCount%></div></div>
<%
	if(scenarioCycleId != 0)
	{
		%>
<a class="ebd-card ebd-card-link" href='<%=scenarioComparisonUrl%>'><div class="ebd-label"><i class="zc-li-outline business-chart-pie-36"></i> Scenario comparison</div><div class="ebd-value"><%=financeDecisionCount%></div><div class="ebd-note">Open <%=scenarioCycleName%> comparison</div></a>
<%
	}
	else
	{
		%>
<div class="ebd-card ebd-card-disabled"><div class="ebd-label"><i class="zc-li-outline ui-1-circle-remove"></i> Scenario comparison</div><div class="ebd-value">0</div><div class="ebd-note">No active/open Budget Cycle available</div></div>
<%
	}
	%>
<a class="ebd-card ebd-card-link" href='#Report:Scenario_Financial_Summary?zc_LoadIn=dialog'><div class="ebd-label"><i class="zc-li-outline business-signature"></i> Financial summary</div><div class="ebd-value"><%=financeDecisionCount%></div><div class="ebd-note">Submitted to Management</div></a>
	<div class="ebd-card"><div class="ebd-label">SCM ready/final</div><div class="ebd-value"><%=scmReadyCount%></div></div>
	<div class="ebd-card"><div class="ebd-label">Finance completed</div><div class="ebd-value"><%=financeCompletedCount%></div></div>
	<div class="ebd-card"><div class="ebd-label">Completed cycles</div><div class="ebd-value"><%=completedCycleCount%></div></div>
	<div class="ebd-card"><div class="ebd-label">Critical events</div><div class="ebd-value"><%=criticalEvents%></div></div>
	<div class="ebd-card"><div class="ebd-label">Revision requests</div><div class="ebd-value"><%=Volume_Consolidations[Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" && Status != "Completed" && Status != "Closed" && Status != "Locked" && Locked != true].count()%></div></div>
</div>