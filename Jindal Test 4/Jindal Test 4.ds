					(
						type = decimal
						displayname = "Total FY Production Tons"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Average_Productivity_MTPH
					(
						type = decimal
						displayname = "Average Productivity MTPH"
						decimalplace = 3
			 			row = 3
			 			column = 2   
						width = medium
					)
					Approval_Status
					(
						type = section
						displayname = "Approval Status"
						visibility = true
			 			row = 4
			 			column = 0   
						width = medium
					)
					must have Status
					(
						type = picklist
						values = {"Draft","Submitted to Operations Approval","Returned by Operations Approval","Operations Approved","Revision Requested by SCM","Revised Draft","Superseded","Locked"}
						initial value = "Draft"
			 			row = 4
			 			column = 1   
						width = medium
					)
					Approver_Action
					(
						type = picklist
						displayname = "Approver Action"
						values = {"Submit","Approve","Return","Create Revision Copy","Lock"}
			 			row = 4
			 			column = 2   
						width = medium
					)
					Approval_Remarks
					(
		    			type = textarea
						displayname = "Approval Remarks"
						height = 80px
			 			row = 4
			 			column = 1   
						width = medium
					)
					Iteration_Count
					(
						type = number
						displayname = "Iteration Count"
						initial value = 0
			 			row = 4
			 			column = 2   
						width = medium
					)
					Locked
					(
		    			type = checkbox
						initial value = false
			 			row = 4
			 			column = 1   
						width = medium
					)
					Owner_Email
					(
		    			type = email
						displayname = "Owner Email"
			 			row = 4
			 			column = 2   
						width = medium
					)
					Operations_Approved_By
					(
		    			type = email
						displayname = "Operations Approved By"
			 			row = 4
			 			column = 1   
						width = medium
					)
					Operations_Approved_On
					(
		    			type = datetime
						displayname = "Operations Approved On"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
