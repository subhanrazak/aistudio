					(
						type = picklist	
						displayname = "Parent Production Plan"
						values  = Operations_Production_Plans.ID
		    			displayformat = [Operations_Production_No]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Product_Production
					(
						type = section
						displayname = "Product Production"
						visibility = false
			 			row = 2
			 			column = 1   
						width = medium
					)
					Product_Production_Lines_Existing
					(
						type = grid
						displayname = "Product Production Lines"
						values = Product_Production_Lines.ID
						defaultrow = 1
			 			row = 2
			 			column = 1   
						width = medium
					)
					Totals
					(
						type = section
						visibility = true
			 			row = 3
			 			column = 0   
						width = medium
					)
