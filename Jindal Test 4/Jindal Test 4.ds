application "Jindal-Test-4"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Add_Users
		{
		
					displayname = "Add Users"
					success message = "User Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique User_Email
					(
		    			type = email
						displayname = "User Email"
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Profile
					(
						type = picklist
						maxchar = 100
						values = {"Choice 1"}
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Add"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Approval_Audit_Log
		{
		
					displayname = "Approval Audit Log"
					Section
					(
						type = section
						displayname = "Audit Event Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Budget_Cycle
					(
						type = picklist	
						values  = Budget_Cycles.ID
		    			displayformat = [Cycle_Code]
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Module_Name
					(
						type = picklist
						values = {"Financial Years","Budget Cycles","Sales Plans","Operations Availability","Operations Production","SCM Review","Raw Material Budgets","Replanning Requests","Financial Consolidations","Plant","Production Line","Market Segment","Steel Grade","Finish Type","Consumable","Raw Material","Approval Delegation","Shutdown Schedule","Capacity & TEP Plan","SMS Capacity Plan","Volume Consolidation","Raw Material Budget","Consumables Budget","Financial Consolidation","Replanning Request"}
			 			row = 1
			 			column = 2   
						width = medium
					)
					Related_Record_ID
					(
						type = number
			 			row = 1
			 			column = 1   
						width = medium
					)
					Related_Record_Display
					(
		    			type = text
						maxchar = 150
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Action
					(
						type = picklist
						values = {"Created","Updated","Submitted","Approved","Returned","Revision Requested","Revision Copy Created","Superseded","Reopened","Locked","Final Approved","Completed","Cancelled","System Recalculated","Delegated","Deleted"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					From_Status
					(
		    			type = text
						maxchar = 80
			 			row = 1
			 			column = 2   
						width = medium
					)
					To_Status
					(
		    			type = text
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
					)
					Iteration_Number
					(
						type = number
			 			row = 1
			 			column = 2   
						width = medium
					)
					Actor_Email
					(
		    			type = email
			 			row = 1
			 			column = 1   
						width = medium
					)
					Acting_On_Behalf_Of
					(
		    			type = email
			 			row = 1
			 			column = 2   
						width = medium
					)
					Action_On
					(
		    			type = datetime
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Remarks
					(
		    			type = textarea
						height = 13px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Approval_Delegations
		{
		
					displayname = "Approval Delegations"
					Section
					(
						type = section
						displayname = "Delegation Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Delegator_Email
					(
		    			type = email
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Delegate_Email
					(
		    			type = email
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Profile_Name
					(
						type = picklist
						values = {"Finance_Costing","Sales_Team","COE_Team","SCM_Central_PPC","Operations_PPC","SMS_Team","Sourcing_Team","Plant_Operations","Sales_Management","Executive_Management"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Module_Name
					(
						type = picklist
						values = {"Sales Plan","Capacity & TEP Plan","SMS Capacity Plan","Shutdown Schedule","Volume Consolidation","Raw Material Budget","Consumables Budget","Financial Consolidation","Budget Cycle"}
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Start_Date
					(
		    			type = date
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have End_Date
					(
		    			type = date
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Active
					(
		    			type = checkbox
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					Reason
					(
		    			type = textarea
						height = 13px
			 			row = 1
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Budget_Cycles
		{
		
					displayname = "Budget Cycles"
					Cycle_Details
					(
						type = section
						displayname = "Cycle Details"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Cycle_Code
					(
		    			type = text
						displayname = "Cycle Code"
						maxchar = 40
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Cycle_Name
					(
		    			type = text
						displayname = "Cycle Name"
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Financial_Year
					(
						type = picklist	
						displayname = "Financial Year"
						values  = Financial_Years.ID
		    			displayformat = [Year_Name]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Cycle_Type
					(
						type = picklist
						displayname = "Cycle Type"
						values = {"Annual Budget","Revision"}
			 			row = 1
			 			column = 2   
						width = medium
					)
					Scenario
					(
						type = picklist
						values = {"Base","Revised","Final"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					Scenario_Set_Code
					(
		    			type = text
						displayname = "Scenario Set Code"
						maxchar = 40
			 			row = 1
			 			column = 2   
						width = medium
					)
					Parent_Cycle
					(
						type = picklist	
						displayname = "Parent Cycle"
						values  = Budget_Cycles.ID
		    			displayformat = [Cycle_Code]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Opened_Date
					(
		    			type = date
						displayname = "Opened Date"
						initial value = "${zoho.currentdate}"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 2   
						width = medium
					)
					Guidelines
					(
						type = section
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					Guidelines_Issued_Date
					(
		    			type = date
						displayname = "Guidelines Issued Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 2
			 			column = 1   
						width = medium
					)
					Guidelines_Notes
					(
		    			type = textarea
						displayname = "Guidelines Notes"
						height = 80px
			 			row = 2
			 			column = 2   
						width = medium
					)
					Flow_Status
					(
						type = section
						displayname = "Flow Status"
						visibility = true
			 			row = 3
			 			column = 0   
						width = medium
					)
					Create_Companion_Scenario
					(
		    			type = checkbox
						displayname = "Create Companion Scenario"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					must have Status
					(
						type = picklist
						values = {"Draft","Pending Sales","Pending Operations","Pending SCM","Revision Requested","Pending Finance","Completed","Closed"}
						initial value = "Draft"
			 			row = 3
			 			column = 2   
						width = medium
					)
					Sales_Approved
					(
		    			type = checkbox
						displayname = "Sales Approved"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					Operations_Approved
					(
		    			type = checkbox
						displayname = "Operations Approved"
						initial value = false
			 			row = 3
			 			column = 2   
						width = medium
					)
					SCM_Approved
					(
		    			type = checkbox
						displayname = "SCM Approved"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					Finance_Completed
					(
		    			type = checkbox
						displayname = "Finance Completed"
						initial value = false
			 			row = 3
			 			column = 2   
						width = medium
					)
					Baseline_Locked
					(
		    			type = checkbox
						displayname = "Baseline Locked"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					Approved_Scenario
					(
		    			type = checkbox
						displayname = "Approved Scenario"
						initial value = false
			 			row = 3
			 			column = 2   
						width = medium
					)
					Reopened_Modules
					(
						type = checkboxes
						displayname = "Reopened Modules"
						values = {"Sales","Operations","SCM","Finance"}
						layout = 1
			 			row = 3
			 			column = 1   
						width = medium
					)
					Ownership_Notes
					(
						type = section
						displayname = "Ownership Notes"
						visibility = true
			 			row = 4
			 			column = 0   
						width = medium
					)
					Owner_Email
					(
		    			type = email
						displayname = "Owner Email"
			 			row = 4
			 			column = 1   
						width = medium
					)
					Finance_Notes
					(
		    			type = textarea
						displayname = "Finance Notes"
						height = 80px
			 			row = 4
			 			column = 2   
						width = medium
					)
					Completion_Date
					(
		    			type = date
						displayname = "Completion Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 4
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Capacity_TEP_Plans
		{
		
					displayname = "Operations Line Availability"
					Availability_Context
					(
						type = section
						displayname = "Availability Context"
			 			row = 1
			 			column = 0   
						width = medium
					)
					Capacity_No
					(
		    			type = autonumber
						displayname = "Capacity No"
						start index = 1000
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Requested_Financial_Year
					(
						type = picklist	
						displayname = "Requested Financial Year"
						values  = Financial_Years.ID
		    			displayformat = [Year_Name]
			 			row = 1
			 			column = 1   
						width = medium
