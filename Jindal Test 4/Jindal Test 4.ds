-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Replanning&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Annual revision requests and reopened modules.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69 zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=replanMine%&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Active &lt;%=replanApproval%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:Active_Replanning_Requests&apos;&gt;Active requests&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;New request&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='My_Sales_Plan_Workqueue' title='My Sales Plan Workqueue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Sales_Plan_Workqueue' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Sales_Management_Approval_Queue' title='Sales Management Approval Queue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Sales_Management_Approval_Queue' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Shortfall_Buckets' title='Shortfall Buckets' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Shortfall_Buckets' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Active_Replanning_Requests' title='Active Replanning Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Active_Replanning_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Critical_Audit_Events' title='Critical Audit Events' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Critical_Audit_Events' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Action_Guidance' elementName='Action_Guidance'>\n\t\t\t\t\t<![CDATA[htmlpage Action_Guidance()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\t%&gt;\n&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;This workbench does not use report custom-action workflows. Users act by opening the record, selecting &lt;strong&gt;Approver Action&lt;/strong&gt;, entering &lt;strong&gt;Approval Remarks&lt;/strong&gt; where required and saving. Form workflows validate the profile, delegation and current status before routing the record.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-guidance-grid zcs-py-16&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-20 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Status and action pattern&lt;/h3&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;1. Find the queue&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Department cards and embedded reports show records where your profile can enter, approve, return, reopen or lock records.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;2. Compare scenarios before decisions&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;When a management decision is expected, use the Scenario Comparison Dashboard and Scenario Financial Summary links. These are navigation only and do not change record status.&lt;/p&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap zcs-mt-16&apos;&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;Scenario dashboard&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;span class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; style=&apos;opacity:.65;cursor:not-allowed;&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;No active cycle&lt;/span&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-signature&apos;&gt;&lt;/i&gt;Financial summary&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;3. Edit the record&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Open the report row or module form. The form on-load workflow enables only the relevant planning and action fields for the current status.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-step&apos;&gt;&lt;h5 class=&apos;zcs-font-16 zcs-font-medium zcs-m-0&apos;&gt;4. Save to route&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;The on-validate and on-success workflows route the status, increment iterations on returns, lock approved baselines and write audit entries.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-notes-wrapper&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-notes-title zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary&apos;&gt;Operational rules:&lt;/span&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-m-0 zcs-pl-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Submit&lt;/strong&gt; from draft or returned records to move work to the next department.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Approve&lt;/strong&gt;, &lt;strong&gt;Finalise&lt;/strong&gt; or &lt;strong&gt;Approve Final&lt;/strong&gt; only when the profile owns the current approval stage.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Return&lt;/strong&gt; with remarks for corrections; returned records reappear in the originator&apos;s workqueue.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-pt-8 zcs-px-8 zcs-pb-0 zcs-box-border&apos;&gt;&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-color-primary&apos;&gt;Use &lt;strong&gt;Reopen&lt;/strong&gt; or &lt;strong&gt;Lock&lt;/strong&gt; only where Finance or administrators are explicitly allowed by the module workflow.&lt;/p&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Field&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Purpose&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Status&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Current workflow state and queue placement.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Approver Action&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;User-selected transition such as Submit, Approve, Return, Reopen, Lock or Finalise.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Approval Remarks&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Mandatory explanation for returns and reopen requests.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Locked&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Prevents further planning edits after approval or baseline lock.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Plant_Operations_Landing
		{
					displayname = "Plant Operations Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Plant_Operations_Landing_Snippet' elementName='Plant_Operations_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Operations_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Plant Operations&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmyConsumables = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Plant Manager&quot; || Status == &quot;Returned by Finance&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Approved&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Locked != true].count();\n\tplantApproval = Consumables_Budgets[Status == &quot;Submitted to Plant Manager&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Locked != true].count();\n\tfinanceApproval = Consumables_Budgets[Status == &quot;Submitted to Finance&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Locked != true].count();\n\tapprovedLocked = Consumables_Budgets[Status == &quot;Approved&quot; || Status == &quot;Locked&quot; || Locked == true &amp;&amp; Status != &quot;Completed&quot;].count();\n\tconsumables = Consumables[Active == true].count();\n\topenWork = myConsumables + plantApproval + financeApproval;\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-5{flex:0 0 calc(41.666% - 10px);max-width:calc(41.666% - 10px)}.zcs-col-7{flex:0 0 calc(58.333% - 8px);max-width:calc(58.333% - 8px)}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-w-full{width:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}.zcs-page-header{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color,#1c3d5a));border:0;border-radius:16px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:rgba(255,255,255,.15);border-color:rgba(255,255,255,.42);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9B6400}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#F1F2F4;border-color:#D7DCE2;color:#525967}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#F4660C}.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow{color:#9B6400}.pl-ops-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;min-height:100%;color:var(--zcs-primary-text-color)}.pl-ops-hero{box-shadow:0 14px 28px rgba(20,29,51,.12);overflow:hidden;position:relative}.pl-ops-hero:after{content:&quot;&quot;;position:absolute;right:-54px;top:-72px;width:210px;height:210px;border:34px solid rgba(255,255,255,.12);border-radius:50%;pointer-events:none}.pl-ops-hero-title{color:var(--zcs_brand_foreground_color);font-size:28px}.pl-ops-hero-copy{max-width:760px;color:var(--zcs_brand_foreground_color);opacity:.9}.pl-ops-eyebrow{letter-spacing:.08em;color:var(--zcs_brand_foreground_color);opacity:.78}.pl-ops-hero .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.pl-ops-kpi-grid{margin-top:16px}.pl-ops-kpi{min-height:158px;color:inherit;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.pl-ops-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 10px 22px rgba(20,29,51,.08)}.pl-ops-kpi-top{min-height:34px}.pl-ops-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.pl-ops-kpi-value{font-size:34px;line-height:1;color:var(--zcs-primary-text-color)}.pl-ops-kpi-note{min-height:40px}.pl-ops-content{margin-top:16px}.pl-ops-panel{min-height:100%}.pl-ops-section-head{margin-bottom:14px}.pl-ops-action-list{list-style:none}.pl-ops-action-card{border-radius:12px;transition:border-color .15s ease,background-color .15s ease}.pl-ops-action-card.is-primary{background:linear-gradient(0deg,var(--zcs_component_hover_color),var(--zcs-white-color))}.pl-ops-action-link{color:inherit;width:100%}.pl-ops-action-title{display:block;color:var(--zcs-primary-text-color)}.pl-ops-action-meta{display:block;color:var(--zcs-secondary-text-color);margin-top:2px}.pl-ops-action-count{min-width:48px;text-align:center;border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:6px 10px}.pl-ops-arrow{color:var(--zcs-teritiary-text-color)}.pl-ops-insight-list{list-style:none}.pl-ops-insight-item{border-top:1px solid var(--zcs-border-color)}.pl-ops-insight-item:first-child{border-top:0}.pl-ops-insight-link{color:var(--zcs_brand_color);font-weight:600}.pl-ops-footer-links{border-top:1px solid var(--zcs-border-color);margin-top:14px;padding-top:14px}.pl-ops-footer-links a{color:var(--zcs_brand_color)}@media(max-width:992px){.zcs-col-md-12{flex:0 0 100%;max-width:100%}.pl-ops-hero{align-items:flex-start;flex-direction:column}.pl-ops-hero-actions{width:100%;justify-content:flex-start}.zcs-col-3{flex:0 0 calc(50% - 8px);max-width:calc(50% - 8px)}}@media(max-width:576px){.pl-ops-shell{padding:12px}.zcs-col-xs-12,.zcs-col-3,.zcs-col-5,.zcs-col-7{flex:0 0 100%;max-width:100%}.pl-ops-hero{padding:18px}.pl-ops-hero-actions{flex-direction:column;align-items:stretch}.pl-ops-hero-actions .zcs-button{width:100%}.pl-ops-kpi-value{font-size:30px}.pl-ops-action-link{align-items:flex-start}.pl-ops-action-count{min-width:40px}}\n&lt;/style&gt;\n&lt;div class=&apos;pl-ops-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header pl-ops-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase&apos;&gt;Consumables budget workspace&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;pl-ops-hero-title zcs-font-bold zcs-lh-heading zcs-m-0&apos;&gt;Plant Operations Landing&lt;/h2&gt;\n\t\t\t&lt;p class=&apos;pl-ops-hero-copy zcs-font-14 zcs-lh-body zcs-m-0&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Create, update and review consumables budgets without mixing final records into pending queues.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pl-ops-hero-actions zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Form:Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Consumables Budget&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;pl-ops-kpi-grid zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;a class=&apos;pl-ops-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-math&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Mine&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;My drafts, returned, reopened&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;pl-ops-kpi-value zcs-font-bold&apos;&gt;&lt;%=myConsumables%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Only my editable consumables budget rows; final and locked rows are excluded.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;pl-ops-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Consumables_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Queue&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Submitted to plant manager&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;pl-ops-kpi-value zcs-font-bold&apos;&gt;&lt;%=plantApproval%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Plant review queue using Submitted to Plant Manager only.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;pl-ops-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Consumables_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-hierarchy-55&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Queue&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Submitted to finance&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;pl-ops-kpi-value zcs-font-bold&apos;&gt;&lt;%=financeApproval%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Finance review queue using Submitted to Finance only.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;pl-ops-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Approved_Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Final&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Approved or locked&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;pl-ops-kpi-value zcs-font-bold&apos;&gt;&lt;%=approvedLocked%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pl-ops-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Final consumables budgets shown separately from pending work.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;pl-ops-content zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;zcs-quick-actions-wrapper pl-ops-panel zcs-card zcs-col-7 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pending actions&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Action cards only count non-final statuses. Approved, locked and completed records stay out of these queues.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=openWork%&gt; open&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;pl-ops-action-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item pl-ops-action-card is-primary zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link pl-ops-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;pl-ops-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Add Consumables Budget&lt;/strong&gt;&lt;span class=&apos;pl-ops-action-meta zcs-font-13&apos;&gt;Create a consumables budget draft for a plant, line and consumable.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-action-count zcs-font-13 zcs-font-semibold&apos;&gt;New&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;pl-ops-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item pl-ops-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link pl-ops-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;pl-ops-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Update My Budgets&lt;/strong&gt;&lt;span class=&apos;pl-ops-action-meta zcs-font-13&apos;&gt;Continue my draft, returned or reopened consumables budget rows.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=myConsumables%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;pl-ops-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item pl-ops-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link pl-ops-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Consumables_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;pl-ops-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Plant Approval&lt;/strong&gt;&lt;span class=&apos;pl-ops-action-meta zcs-font-13&apos;&gt;Review rows submitted to plant manager; locked and final rows are excluded.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=plantApproval%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;pl-ops-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item pl-ops-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link pl-ops-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Consumables_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-hierarchy-55&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;pl-ops-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Finance Review&lt;/strong&gt;&lt;span class=&apos;pl-ops-action-meta zcs-font-13&apos;&gt;Review rows submitted to finance; final and locked records stay separate.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;pl-ops-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=financeApproval%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;pl-ops-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;zcs-labelvalue-wrapper pl-ops-panel zcs-card zcs-col-5 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;pl-ops-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Concise insights&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Budget signals for the current consumables workflow.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;pl-ops-insight-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;pl-ops-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Review split&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-yellow zc-li-outline business-progress&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=plantApproval%&gt; at plant review and &lt;%=financeApproval%&gt; at finance review.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;pl-ops-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;My editable work&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-blue zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=myConsumables%&gt; records are draft, returned or reopened for this user.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;pl-ops-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Consumables master data&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-green zc-li-outline business-stock&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;pl-ops-insight-link&apos; href=&apos;#Report:Active_Consumables?zc_LoadIn=dialog&apos;&gt;&lt;%=consumables%&gt; active consumables&lt;/a&gt; are available to support budget entry.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;pl-ops-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Final archive&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-green zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;pl-ops-insight-link&apos; href=&apos;#Report:Approved_Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;%=approvedLocked%&gt; approved or locked budgets&lt;/a&gt; are excluded from pending work.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&apos;pl-ops-footer-links zcs-flex zcs-gap-12 zcs-row-wrap zcs-font-13&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Consumables_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-chart-pie&apos;&gt;&lt;/i&gt;All budgets&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:Consumables_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;Status board&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:Active_Consumables?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-stock&apos;&gt;&lt;/i&gt;Active consumables&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page SCM_Landing
		{
					displayname = "SCM Review Workbench"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='SCM_Review_Summary' elementName='SCM_Review_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage SCM_Review_Summary()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;SCM Central PPC&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\treadyPlans = Volume_Consolidations[Status == &quot;Under SCM Review&quot; &amp;&amp; Locked != true];\n\trevisionPlans = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; &amp;&amp; Locked != true];\n\tapprovedPlans = Volume_Consolidations[Status == &quot;SCM Approved&quot;];\n\tlockedPlans = Volume_Consolidations[Status == &quot;Locked&quot; || Locked == true];\n\tpendingPlans = Volume_Consolidations[Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; &amp;&amp; Locked != true];\n\tinsightPlans = Volume_Consolidations[Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; || Status == &quot;SCM Approved&quot; || Status == &quot;Locked&quot; || Locked == true];\n\tapprovedLockedPlans = Volume_Consolidations[Status == &quot;SCM Approved&quot; || Status == &quot;Locked&quot; || Locked == true];\n\treadyCount = readyPlans.count();\n\trevisionCount = revisionPlans.count();\n\tapprovedCount = approvedPlans.count();\n\tlockedCount = lockedPlans.count();\n\tpendingDecisionCount = readyCount + revisionCount;\n\tapprovedLockedCount = approvedLockedPlans.count();\n\ttotalSalesTarget = 0.0;\n\ttotalOperationsProduction = 0.0;\n\ttotalToBeRaised = 0.0;\n\ttotalCostForecast = 0.0;\n\tinsightRowCount = 0;\n\tpendingMatrixRowCount = 0;\n\tapprovedLockedRowCount = 0;\n\tapprovedLockedToBeRaised = 0.0;\n\tapprovedLockedCostForecast = 0.0;\n\tfor each  plan in insightPlans\n\t{\n\t\tfor each  line in plan.SCM_Review_Lines_Existing\n\t\t{\n\t\t\ttotalSalesTarget = totalSalesTarget + ifnull(line.Sales_Target_Tons,0);\n\t\t\ttotalOperationsProduction = totalOperationsProduction + ifnull(line.Operations_Production_Tons,0);\n\t\t\ttotalToBeRaised = totalToBeRaised + ifnull(line.To_Be_Raised_MT,0);\n\t\t\ttotalCostForecast = totalCostForecast + ifnull(line.Cost_Forecast,0);\n\t\t\tinsightRowCount = insightRowCount + 1;\n\t\t}\n\t}\n\tfor each  plan in pendingPlans\n\t{\n\t\tfor each  line in plan.SCM_Review_Lines_Existing\n\t\t{\n\t\t\tpendingMatrixRowCount = pendingMatrixRowCount + 1;\n\t\t}\n\t}\n\tfor each  plan in approvedLockedPlans\n\t{\n\t\tfor each  line in plan.SCM_Review_Lines_Existing\n\t\t{\n\t\t\tapprovedLockedRowCount = approvedLockedRowCount + 1;\n\t\t\tapprovedLockedToBeRaised = approvedLockedToBeRaised + ifnull(line.To_Be_Raised_MT,0);\n\t\t\tapprovedLockedCostForecast = approvedLockedCostForecast + ifnull(line.Cost_Forecast,0);\n\t\t}\n\t}\n\tfocusTitle = &quot;No pending SCM decisions&quot;;\n\tfocusText = &quot;Ready and revision queues are clear. Use revision history for audit review and keep monitoring approved or locked plans through the insight metrics.&quot;;\n\tfocusHref = &quot;#Report:SCM_Revision_History?zc_LoadIn=dialog&quot;;\n\tfocusCta = &quot;Review history&quot;;\n\tfocusIcon = &quot;ui-1-check-circle-08&quot;;\n\tfocusClass = &quot;scm-focus-clear&quot;;\n\tif(readyCount &gt; 0)\n\t{\n\t\tfocusTitle = &quot;Start with SCM-ready plans&quot;;\n\t\tfocusText = readyCount + &quot; plan(s) are ready for SCM decision. Review the matrix first, then use the source report to approve or open the replanning request form when remarks are required.&quot;;\n\t\tfocusHref = &quot;#Report:SCM_Ready_For_Review?zc_LoadIn=dialog&quot;;\n\t\tfocusCta = &quot;Open ready queue&quot;;\n\t\tfocusIcon = &quot;ui-1-check-circle-08&quot;;\n\t\tfocusClass = &quot;scm-focus-ready&quot;;\n\t}\n\telse if(revisionCount &gt; 0)\n\t{\n\t\tfocusTitle = &quot;Follow up revision requests&quot;;\n\t\tfocusText = revisionCount + &quot; plan(s) are waiting on Sales or Operations revision. Use the revision queue and capture any reason or remarks through Replanning Requests.&quot;;\n\t\tfocusHref = &quot;#Report:SCM_Revision_Requests?zc_LoadIn=dialog&quot;;\n\t\tfocusCta = &quot;Open revision queue&quot;;\n\t\tfocusIcon = &quot;ui-2-time&quot;;\n\t\tfocusClass = &quot;scm-focus-revision&quot;;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-black-color:#000;--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row-wrap{flex-wrap:wrap}.zcs-col-common{flex:1 1 0%}.zcs-col-2{flex:0 0 16.6667%;max-width:16.6667%}.zcs-col-10{flex:0 0 83.3333%;max-width:83.3333%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-gap-32{gap:2rem}.zcs-p-0{padding:0}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-60{padding-left:3.75rem;padding-right:3.75rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-5{margin-top:.3125rem}.zcs-mt-8{margin-top:.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-half{border-radius:50%}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}\n/* ZCS card, table, timeline, badge and button components */\n.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:top}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094c5}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-tl-indicator{width:60px;left:16.6667%}.zcs-tl-dot{width:12px;height:12px;background-color:var(--zcs_brand_color);border:1px solid var(--zcs-white-color);box-shadow:0 2px 6px 0 #C4DEE4}.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before{content:&apos;&apos;;display:flex;position:absolute;width:1px;height:calc(100% + 32px);background-color:#E1E1E1;top:5px}\n.scm-workbench{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.scm-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start;position:relative;overflow:hidden}.scm-hero:after{content:&apos;&apos;;position:absolute;right:-90px;top:-110px;width:290px;height:290px;border:34px solid rgba(255,255,255,.10);border-radius:50%}.scm-hero&gt;*{position:relative;z-index:1}.scm-hero h1{margin:0 0 8px;font-size:26px;line-height:1.2}.scm-hero p{margin:0;opacity:.92;max-width:960px}.scm-hero-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px;color:var(--zcs_brand_foreground_color);white-space:nowrap}.scm-kpi-grid{display:grid;grid-template-columns:repeat(7,minmax(170px,1fr));gap:14px;margin-top:16px}.scm-kpi{min-height:140px;display:flex;flex-direction:column;justify-content:space-between}.scm-kpi-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.scm-kpi-value{font-size:26px;font-weight:700;line-height:1.1;color:var(--zcs_primary_text_color);margin-top:10px}.scm-kpi-sub{font-size:12px;color:var(--zcs_tertiary_text_color);margin-top:6px}.scm-section{margin-top:16px}.scm-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.scm-section-head h2{margin:0;font-size:20px;color:var(--zcs_primary_text_color)}.scm-note{font-size:13px;color:var(--zcs_secondary_text_color)}.scm-action-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px;margin-top:16px}.scm-focus-card{border-left:5px solid var(--zcs_brand_color);display:flex;gap:16px;align-items:flex-start;min-height:180px}.scm-focus-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);flex:0 0 auto}.scm-focus-card h2{margin:0 0 8px;font-size:22px;color:var(--zcs_primary_text_color)}.scm-focus-card p{margin:0 0 16px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-focus-revision{border-left-color:#F4660C}.scm-focus-revision .scm-focus-icon{background:#F8F0EB;color:#F4660C}.scm-focus-clear{border-left-color:#179E6C}.scm-focus-clear .scm-focus-icon{background:#E4FCF3;color:#179E6C}.scm-pending-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.scm-action-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border:1px solid #e7e7ee;border-radius:12px;background:#fff;box-sizing:border-box;color:var(--zcs_primary_text_color)}.scm-action-card:hover{background:var(--zcs_component_hover_color)}.scm-action-left{display:flex;gap:12px;align-items:center}.scm-action-icon{width:36px;height:36px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.scm-action-title{font-weight:600;font-size:14px;color:var(--zcs_primary_text_color)}.scm-action-sub{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:2px}.scm-guidance-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.scm-guidance-card{display:flex;gap:14px;align-items:flex-start}.scm-guidance-card i{color:var(--zcs_brand_color);font-size:22px;margin-top:2px}.scm-guidance-card h3{margin:0 0 6px;font-size:16px;color:var(--zcs_primary_text_color)}.scm-guidance-card p{margin:0 0 12px;color:var(--zcs_secondary_text_color);font-size:14px}.scm-insight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.scm-insight-item{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:14px}.scm-insight-label{font-size:12px;color:var(--zcs_secondary_text_color);margin-bottom:6px}.scm-insight-value{font-size:20px;font-weight:700;color:var(--zcs_primary_text_color)}.scm-dual-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.scm-comments{max-width:280px;white-space:normal}.scm-empty{padding:24px;text-align:center;color:var(--zcs_secondary_text_color);background:#fff;border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px}.scm-empty i{margin-right:8px;color:var(--zcs_brand_color)}.scm-mini-table td,.scm-mini-table th{font-size:13px}.scm-panel{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px;box-sizing:border-box}.scm-inline-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}@media(max-width:1440px){.scm-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:1280px){.scm-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.scm-dual-grid,.scm-guidance-grid,.scm-action-grid{grid-template-columns:1fr}.scm-insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:768px){.scm-workbench{padding:12px}.scm-hero{flex-direction:column}.scm-kpi-grid,.scm-pending-actions,.scm-insight-grid{grid-template-columns:1fr}.zcs-col-sm-12{flex:0 0 100%;max-width:100%}.zcs-tl-indicator{left:0}.zcs-tl-time{text-align:left;padding:0 60px;margin-bottom:12px}.zcs-tl-li{flex-direction:column}.zcs-px-60{padding-left:3.75rem;padding-right:1rem}.scm-section-head{align-items:flex-start;flex-direction:column}}\n&lt;/style&gt;\n&lt;div class=&apos;scm-workbench&apos;&gt;\n\t&lt;div class=&apos;scm-hero&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h1&gt;SCM Review Workbench&lt;/h1&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Pending decisions now show only SCM-ready and revision-request records. SCM Approved and Locked records are retained in KPI and insight metrics, but are kept out of pending action lists.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;scm-hero-badge&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-kpi-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;SCM-ready plans&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=readyCount%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;Open decisions only&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Revision requests pending&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=revisionCount%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;Sales or Operations follow-up&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-bold&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;SCM-approved plans&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=approvedCount%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;&lt;%=lockedCount%&gt; locked plan(s) in insights&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Total sales target tons&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalSalesTarget%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;Pending plus finalised insight set&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Operations production tons&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalOperationsProduction%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;SCM-visible records&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline e-commerce-shopping-cart-simple&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Raw material to be raised&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalToBeRaised%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;MT shortfall basis&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-kpi&apos;&gt;&lt;div class=&apos;scm-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-coins&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Forecast cost&lt;/div&gt;&lt;div class=&apos;scm-kpi-value&apos;&gt;&lt;%=totalCostForecast%&gt;&lt;/div&gt;&lt;div class=&apos;scm-kpi-sub&apos;&gt;All SCM insight rows&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-action-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-24 zcs-box-border scm-focus-card &lt;%=focusClass%&gt;&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-focus-icon&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=focusIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2&gt;&lt;%=focusTitle%&gt;&lt;/h2&gt;\n\t\t\t\t&lt;p&gt;&lt;%=focusText%&gt;&lt;/p&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=focusHref%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=focusCta%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Pending actions&lt;/h2&gt;&lt;span class=&apos;scm-note&apos;&gt;&lt;%=pendingDecisionCount%&gt; active plan(s); approved and locked records excluded&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;scm-pending-actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;scm-action-card&apos; href=&apos;#Report:SCM_Ready_For_Review?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;scm-action-left&apos;&gt;&lt;span class=&apos;scm-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;span class=&apos;scm-action-title&apos;&gt;SCM ready for review&lt;/span&gt;&lt;span class=&apos;scm-action-sub&apos;&gt;Open decision queue&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=readyCount%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;scm-action-card&apos; href=&apos;#Report:SCM_Revision_Requests?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;scm-action-left&apos;&gt;&lt;span class=&apos;scm-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;span class=&apos;scm-action-title&apos;&gt;Revision requests&lt;/span&gt;&lt;span class=&apos;scm-action-sub&apos;&gt;Pending Sales or Operations rework&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=revisionCount%&gt;&lt;/strong&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;scm-action-card&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;scm-action-left&apos;&gt;&lt;span class=&apos;scm-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;span class=&apos;scm-action-title&apos;&gt;Raise replanning request&lt;/span&gt;&lt;span class=&apos;scm-action-sub&apos;&gt;Use when reason or remarks are required&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;scm-action-card&apos; href=&apos;#Report:SCM_Revision_History?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;scm-action-left&apos;&gt;&lt;span class=&apos;scm-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;span class=&apos;scm-action-title&apos;&gt;Revision history&lt;/span&gt;&lt;span class=&apos;scm-action-sub&apos;&gt;Audit requests and outcomes&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section&apos;&gt;\n\t\t&lt;div class=&apos;scm-section-head&apos;&gt;\n\t\t\t&lt;h2&gt;SCM option guidance&lt;/h2&gt;\n\t\t\t&lt;div class=&apos;scm-inline-actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Revision_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Open revision queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Raise request with remarks&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-guidance-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request Sales revision&lt;/h3&gt;&lt;p&gt;Use when demand, grade mix, product mix, or sales target tons need correction before SCM approval.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request Operations revision&lt;/h3&gt;&lt;p&gt;Use when production tons, BTV measured MT, or operational feasibility needs rework.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border scm-guidance-card&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;div&gt;&lt;h3&gt;Request both revisions&lt;/h3&gt;&lt;p&gt;Use when Sales demand and Operations production both require replanning to resolve raw-material gaps.&lt;/p&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Raise request&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section zcs-card zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;scm-section-head&apos;&gt;\n\t\t\t&lt;h2&gt;Approved and locked insights&lt;/h2&gt;\n\t\t\t&lt;span class=&apos;scm-note&apos;&gt;Finalised or locked rows are excluded from pending lists and retained here for context&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-insight-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-insight-item&apos;&gt;&lt;div class=&apos;scm-insight-label&apos;&gt;Approved or locked plans&lt;/div&gt;&lt;div class=&apos;scm-insight-value&apos;&gt;&lt;%=approvedLockedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;scm-insight-item&apos;&gt;&lt;div class=&apos;scm-insight-label&apos;&gt;Approved or locked matrix rows&lt;/div&gt;&lt;div class=&apos;scm-insight-value&apos;&gt;&lt;%=approvedLockedRowCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;scm-insight-item&apos;&gt;&lt;div class=&apos;scm-insight-label&apos;&gt;Finalised raw material MT&lt;/div&gt;&lt;div class=&apos;scm-insight-value&apos;&gt;&lt;%=approvedLockedToBeRaised%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;scm-insight-item&apos;&gt;&lt;div class=&apos;scm-insight-label&apos;&gt;Finalised forecast cost&lt;/div&gt;&lt;div class=&apos;scm-insight-value&apos;&gt;&lt;%=approvedLockedCostForecast%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section scm-dual-grid&apos;&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Records needing SCM decisions&lt;/h2&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Ready_For_Review?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Open ready report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full scm-mini-table&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plan&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plant&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Cycle&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\treadyIndex = 0;\n\tfor each  plan in readyPlans\n\t{\n\t\treadyIndex = readyIndex + 1;\n\t\tif(readyIndex &lt;= 6)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Volume_Consolidations?Consolidation_No=&lt;%=plan.Consolidation_No%&gt;&apos;&gt;&lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(plan.Plant,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(plan.Budget_Cycle,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;Under SCM Review&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(readyIndex == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;4&apos;&gt;No SCM-ready plans are waiting for decision.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Revision requests pending&lt;/h2&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Revision_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Open revision report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full scm-mini-table&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plan&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Requested to&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\trevisionIndex = 0;\n\tfor each  plan in revisionPlans\n\t{\n\t\trevisionIndex = revisionIndex + 1;\n\t\tif(revisionIndex &lt;= 6)\n\t\t{\n\t\t\trequestedTo = &quot;-&quot;;\n\t\t\tfor each  rev in plan.Revision_History_Lines_Existing\n\t\t\t{\n\t\t\t\tif(requestedTo == &quot;-&quot;)\n\t\t\t\t{\n\t\t\t\t\trequestedTo = ifnull(rev.Requested_To,&quot;-&quot;);\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Volume_Consolidations?Consolidation_No=&lt;%=plan.Consolidation_No%&gt;&apos;&gt;&lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=requestedTo%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=ifnull(plan.Status,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;Open request form&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(revisionIndex == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;4&apos;&gt;No revision requests are pending with SCM.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section zcs-card zcs-p-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;scm-section-head&apos;&gt;\n\t\t\t&lt;h2&gt;Pending SCM review matrix by grade and product&lt;/h2&gt;\n\t\t\t&lt;span class=&apos;scm-note&apos;&gt;&lt;%=pendingMatrixRowCount%&gt; actionable row(s); SCM Approved and Locked rows are excluded here&lt;/span&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\tif(pendingMatrixRowCount == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;scm-empty&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;No consolidation rows are currently waiting for SCM decision.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plan&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Grade&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Sales Target Tons&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Operations Production Tons&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;BTV Measured MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Required Raw Material MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Available Raw Material MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;To Be Raised MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Cost Forecast&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Override comments&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-0 zcs-box-border&apos; colspan=&apos;12&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each  plan in pendingPlans\n\t\t{\n\t\t\tfor each  line in plan.SCM_Review_Lines_Existing\n\t\t\t{\n\t\t\t\tstatusName = ifnull(plan.Status,&quot;-&quot;);\n\t\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(statusName == &quot;Revision Requested&quot; || statusName == &quot;Sales Revision Pending&quot; || statusName == &quot;Operations Revision Pending&quot; || statusName == &quot;Both Revisions Pending&quot;)\n\t\t\t\t{\n\t\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Volume_Consolidations?Consolidation_No=&lt;%=plan.Consolidation_No%&gt;&apos;&gt;&lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=statusName%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Grade,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Product,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Sales_Target_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Operations_Production_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.BTV_Measured_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Required_Raw_Material_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Available_Raw_Material_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.To_Be_Raised_MT,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line.Cost_Forecast,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary scm-comments&apos;&gt;&lt;%=ifnull(line.Override_Comments,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\n\t&lt;div class=&apos;scm-section scm-dual-grid&apos;&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Revision history timeline&lt;/h2&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:SCM_Revision_History?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Open history report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-timeline-wrapper&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n&lt;%\n\ttimelineCount = 0;\n\tfor each  plan in insightPlans\n\t{\n\t\tfor each  rev in plan.Revision_History_Lines_Existing\n\t\t{\n\t\t\ttimelineCount = timelineCount + 1;\n\t\t\tif(timelineCount &lt;= 8)\n\t\t\t{\n\t\t\t\trevStatus = ifnull(rev.Revision_Status,&quot;Revision requested&quot;);\n\t\t\t\t%&gt;\n&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&apos;&gt;&lt;%=ifnull(rev.Requested_On,&quot;-&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&apos;&gt;&lt;h3 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=revStatus%&gt;&lt;/h3&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Plan &lt;%=ifnull(plan.Consolidation_No,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&apos;&gt;Requested to &lt;strong&gt;&lt;%=ifnull(rev.Requested_To,&quot;-&quot;)%&gt;&lt;/strong&gt; by &lt;%=ifnull(rev.Requested_By,&quot;-&quot;)%&gt;. &lt;%=ifnull(rev.Comments,&quot;No comments recorded.&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t}\n\tif(timelineCount == 0)\n\t{\n\t\t%&gt;\n&lt;li class=&apos;scm-empty&apos;&gt;No revision history lines are recorded for the currently visible SCM plans.&lt;/li&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;scm-panel&apos;&gt;\n\t\t\t&lt;div class=&apos;scm-section-head&apos;&gt;&lt;h2&gt;Replanning requests needing follow-up&lt;/h2&gt;&lt;span class=&apos;scm-note&apos;&gt;Open SCM, Sales and Operations requests only&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full scm-mini-table&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Request&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Module&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Reason&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\treqCount = 0;\n\tfor each  req in Replanning_Requests[Source_Module == &quot;SCM&quot; || Source_Module == &quot;Sales&quot; || Source_Module == &quot;Operations&quot; &amp;&amp; Status != &quot;Approved&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Rejected&quot;] sort by Request_Date desc\n\t{\n\t\treqCount = reqCount + 1;\n\t\tif(reqCount &lt;= 8)\n\t\t{\n\t\t\treqStatus = ifnull(req.Status,&quot;-&quot;);\n\t\t\treqClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(reqStatus == &quot;Pending&quot; || reqStatus == &quot;Requested&quot;)\n\t\t\t{\n\t\t\t\treqClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\telse if(reqStatus == &quot;Approved&quot; || reqStatus == &quot;Closed&quot; || reqStatus == &quot;Locked&quot;)\n\t\t\t{\n\t\t\t\treqClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(reqStatus == &quot;Rejected&quot;)\n\t\t\t{\n\t\t\t\treqClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;zcs-color-theme&apos; href=&apos;#Report:All_Replanning_Requests?Replan_No=&lt;%=req.Replan_No%&gt;&apos;&gt;&lt;%=ifnull(req.Replan_No,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(req.Source_Module,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=reqClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=reqStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(req.Trigger_Reason,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(reqCount == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;4&apos;&gt;No open replanning requests require follow-up.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='SCM_Ready_For_Review' title='SCM Ready For Review' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='SCM_Ready_For_Review' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='SCM_Revision_Requests' title='SCM Revision Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='SCM_Revision_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page SMS_Landing
		{
					displayname = "SMS Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='SMS_Landing_Snippet' elementName='SMS_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage SMS_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;SMS Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmySMS = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Central PPC&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Accepted&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Locked != true].count();\n\tcentralPPC = SMS_Capacity_Plans[Status == &quot;Submitted to Central PPC&quot; &amp;&amp; Locked != true].count();\n\taccepted = SMS_Capacity_Plans[Status == &quot;Accepted&quot; || Status == &quot;Validated&quot; || Status == &quot;Locked&quot; || Locked == true &amp;&amp; Status != &quot;Completed&quot;].count();\n\tplantCoverage = Plants[ID != 0].count();\n\topenWork = mySMS + centralPPC;\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-5{flex:0 0 calc(41.666% - 10px);max-width:calc(41.666% - 10px)}.zcs-col-7{flex:0 0 calc(58.333% - 8px);max-width:calc(58.333% - 8px)}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-w-full{width:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}.zcs-page-header{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color,#1c3d5a));border:0;border-radius:16px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:rgba(255,255,255,.15);border-color:rgba(255,255,255,.42);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9B6400}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#F1F2F4;border-color:#D7DCE2;color:#525967}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#F4660C}.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow{color:#9B6400}.sms-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;min-height:100%;color:var(--zcs-primary-text-color)}.sms-hero{box-shadow:0 14px 28px rgba(20,29,51,.12);overflow:hidden;position:relative}.sms-hero:after{content:&quot;&quot;;position:absolute;right:-54px;top:-72px;width:210px;height:210px;border:34px solid rgba(255,255,255,.12);border-radius:50%;pointer-events:none}.sms-hero-title{color:var(--zcs_brand_foreground_color);font-size:28px}.sms-hero-copy{max-width:760px;color:var(--zcs_brand_foreground_color);opacity:.9}.sms-eyebrow{letter-spacing:.08em;color:var(--zcs_brand_foreground_color);opacity:.78}.sms-hero .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.sms-kpi-grid{margin-top:16px}.sms-kpi{min-height:158px;color:inherit;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.sms-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 10px 22px rgba(20,29,51,.08)}.sms-kpi-top{min-height:34px}.sms-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.sms-kpi-value{font-size:34px;line-height:1;color:var(--zcs-primary-text-color)}.sms-kpi-note{min-height:40px}.sms-content{margin-top:16px}.sms-panel{min-height:100%}.sms-section-head{margin-bottom:14px}.sms-action-list{list-style:none}.sms-action-card{border-radius:12px;transition:border-color .15s ease,background-color .15s ease}.sms-action-card.is-primary{background:linear-gradient(0deg,var(--zcs_component_hover_color),var(--zcs-white-color))}.sms-action-link{color:inherit;width:100%}.sms-action-title{display:block;color:var(--zcs-primary-text-color)}.sms-action-meta{display:block;color:var(--zcs-secondary-text-color);margin-top:2px}.sms-action-count{min-width:48px;text-align:center;border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:6px 10px}.sms-arrow{color:var(--zcs-teritiary-text-color)}.sms-insight-list{list-style:none}.sms-insight-item{border-top:1px solid var(--zcs-border-color)}.sms-insight-item:first-child{border-top:0}.sms-insight-link{color:var(--zcs_brand_color);font-weight:600}.sms-footer-links{border-top:1px solid var(--zcs-border-color);margin-top:14px;padding-top:14px}.sms-footer-links a{color:var(--zcs_brand_color)}@media(max-width:992px){.zcs-col-md-12{flex:0 0 100%;max-width:100%}.sms-hero{align-items:flex-start;flex-direction:column}.sms-hero-actions{width:100%;justify-content:flex-start}.zcs-col-3{flex:0 0 calc(50% - 8px);max-width:calc(50% - 8px)}}@media(max-width:576px){.sms-shell{padding:12px}.zcs-col-xs-12,.zcs-col-3,.zcs-col-5,.zcs-col-7{flex:0 0 100%;max-width:100%}.sms-hero{padding:18px}.sms-hero-actions{flex-direction:column;align-items:stretch}.sms-hero-actions .zcs-button{width:100%}.sms-kpi-value{font-size:30px}.sms-action-link{align-items:flex-start}.sms-action-count{min-width:40px}}\n&lt;/style&gt;\n&lt;div class=&apos;sms-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header sms-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase&apos;&gt;Steel making capacity workspace&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;sms-hero-title zcs-font-bold zcs-lh-heading zcs-m-0&apos;&gt;SMS Landing&lt;/h2&gt;\n\t\t\t&lt;p class=&apos;sms-hero-copy zcs-font-14 zcs-lh-body zcs-m-0&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Create SMS capacity rows, monitor Central PPC submissions, and keep accepted capacity separate from pending work.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;sms-hero-actions zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Form:SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add SMS Capacity&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;sms-kpi-grid zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;a class=&apos;sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Mine&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;My SMS active rows&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;sms-kpi-value zcs-font-bold&apos;&gt;&lt;%=mySMS%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Draft, returned or reopened rows owned by this user; final and locked rows are excluded.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:SMS_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Queue&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Central PPC queue&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;sms-kpi-value zcs-font-bold&apos;&gt;&lt;%=centralPPC%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Rows currently submitted to Central PPC and not locked.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Accepted_SMS_Capacity?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Final&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Accepted, validated, locked&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;sms-kpi-value zcs-font-bold&apos;&gt;&lt;%=accepted%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Accepted base shown as an insight metric, never as pending action.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;sms-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:SMS_By_Plant?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Plants&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Plant coverage&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;sms-kpi-value zcs-font-bold&apos;&gt;&lt;%=plantCoverage%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;sms-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Plants configured for SMS capacity planning coverage.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;sms-content zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;zcs-quick-actions-wrapper sms-panel zcs-card zcs-col-7 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pending actions&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Action cards open the form or report in dialog. Completed, accepted and locked records stay out of pending counts.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=openWork%&gt; open&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;sms-action-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sms-action-card is-primary zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sms-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;sms-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Add SMS Capacity&lt;/strong&gt;&lt;span class=&apos;sms-action-meta zcs-font-13&apos;&gt;Create a new steel making capacity plan for the relevant plant and melting unit.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sms-action-count zcs-font-13 zcs-font-semibold&apos;&gt;New&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;sms-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sms-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sms-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sms-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;sms-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Update My SMS Rows&lt;/strong&gt;&lt;span class=&apos;sms-action-meta zcs-font-13&apos;&gt;Continue rows owned by this user in Draft, Returned by Central PPC, or Reopened status.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sms-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=mySMS%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;sms-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;zcs-labelvalue-wrapper sms-panel zcs-card zcs-col-5 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;sms-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Department insights&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Central PPC waiting count and accepted base for SMS planning.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;sms-insight-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Central PPC waiting&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-yellow zc-li-outline business-progress&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;sms-insight-link&apos; href=&apos;#Report:SMS_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;%=centralPPC%&gt; rows&lt;/a&gt; are submitted to Central PPC and waiting for action.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Accepted base&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-green zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;sms-insight-link&apos; href=&apos;#Report:Accepted_SMS_Capacity?zc_LoadIn=dialog&apos;&gt;&lt;%=accepted%&gt; accepted, validated or locked rows&lt;/a&gt; form the current SMS capacity base.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Owner criteria&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-blue zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;My active KPI applies the owner match before status checks, so returned or reopened rows are not counted globally.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;sms-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Plant coverage&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-labelvalue-color-orange zc-li-outline business-factory&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;sms-insight-link&apos; href=&apos;#Report:SMS_By_Plant?zc_LoadIn=dialog&apos;&gt;&lt;%=plantCoverage%&gt; configured plants&lt;/a&gt; are available for capacity planning visibility.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&apos;sms-footer-links zcs-flex zcs-gap-12 zcs-row-wrap zcs-font-13&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_SMS_Capacity_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-chart-pie&apos;&gt;&lt;/i&gt;All SMS rows&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:SMS_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;Status board&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:SMS_By_Plant?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;By plant&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Landing
		{
					displayname = "Sales Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Landing_Snippet' elementName='Sales_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Sales Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;))\n\t{\n\t\tprofileText = &quot;Sales Management&quot;;\n\t}\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmyActiveWork = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Revised Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Reopened&quot;].count();\n\tmyDrafts = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Revised Draft&quot;].count();\n\tneedsRevision = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Reopened&quot;].count();\n\treopenedCount = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Reopened&quot;].count();\n\tmySubmitted = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Submitted to Sales Management&quot;].count();\n\tsubmittedQueue = Sales_Plans[Status == &quot;Submitted to Sales Management&quot; &amp;&amp; Locked != true].count();\n\tapprovedFinal = Sales_Plans[Status == &quot;Sales Approved&quot; || Status == &quot;Locked&quot; || Status == &quot;Superseded&quot; || Locked == true].count();\n\tfocusTitle = &quot;Queue is clear&quot;;\n\tfocusText = &quot;No draft, returned or reopened sales-plan rows are waiting for you. Use the status board for monitoring only.&quot;;\n\tfocusTone = &quot;green&quot;;\n\tif(needsRevision &gt; 0)\n\t{\n\t\tfocusTitle = &quot;Revision work first&quot;;\n\t\tfocusText = needsRevision + &quot; returned, reopened or SCM revision row(s) need remarks review before any resubmission.&quot;;\n\t\tfocusTone = &quot;red&quot;;\n\t}\n\telse if(myDrafts &gt; 0)\n\t{\n\t\tfocusTitle = &quot;Drafts need submission&quot;;\n\t\tfocusText = myDrafts + &quot; draft or revised draft row(s) are still with you and should be completed before monitoring approvals.&quot;;\n\t\tfocusTone = &quot;yellow&quot;;\n\t}\n\telse if(mySubmitted &gt; 0)\n\t{\n\t\tfocusTitle = &quot;Submitted plans are moving&quot;;\n\t\tfocusText = mySubmitted + &quot; of your plan row(s) are with Sales Management. Track them without changing workflow state.&quot;;\n\t\tfocusTone = &quot;blue&quot;;\n\t}\n\tpriorityLabel = &quot;Normal&quot;;\n\tif(needsRevision &gt; 0 || reopenedCount &gt; 0)\n\t{\n\t\tpriorityLabel = &quot;High&quot;;\n\t}\n\telse if(myDrafts &gt; 0 || mySubmitted &gt; 0)\n\t{\n\t\tpriorityLabel = &quot;Medium&quot;;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global.css core utilities included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;font-size:16px;line-height:1.5}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-no-shrink{flex-shrink:0}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}\n/* ZCS component CSS: button, badge, quick-actions and simple-table */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#A06A00}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#C94F07}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}\n/* Sales landing command-center layout */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important;padding:0!important}.sl-shell{min-height:100vh;background:radial-gradient(circle at 85% 8%,rgba(255,255,255,.95) 0,rgba(255,255,255,0) 34%),linear-gradient(135deg,#f8fbff 0%,var(--zcs_brand_light_color) 48%,#f3f3f4 100%);padding:24px;box-sizing:border-box;color:var(--zcs_primary_text_color)}.sl-container{max-width:1480px;margin:0 auto}.sl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:22px;padding:24px;box-shadow:0 18px 48px rgba(16,24,40,.14);color:var(--zcs_brand_foreground_color);position:relative;overflow:hidden}.sl-hero:after{content:&quot;&quot;;position:absolute;width:320px;height:320px;border:1px solid rgba(255,255,255,.22);border-radius:50%;right:-120px;top:-150px;box-shadow:0 0 0 34px rgba(255,255,255,.06),0 0 0 78px rgba(255,255,255,.04)}.sl-hero-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20px}.sl-title{font-size:30px;font-weight:700;line-height:1.2;margin:0 0 8px}.sl-subtitle{max-width:780px;margin:0;color:rgba(255,255,255,.88)}.sl-profile-pill{border:1px solid rgba(255,255,255,.38);border-radius:999px;padding:8px 12px;background:rgba(255,255,255,.12);white-space:nowrap}.sl-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.sl-hero-actions .zcs-button{border-color:rgba(255,255,255,.58);background:rgba(255,255,255,.14);color:var(--zcs_brand_foreground_color)}.sl-hero-actions .sl-primary-hero{background:var(--zcs-white-color);border-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.sl-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.sl-kpi{padding:18px;min-height:140px;box-shadow:0 12px 28px rgba(16,24,40,.06);transition:border-color .18s ease,transform .18s ease}.sl-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.sl-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.sl-icon-tile{width:42px;height:42px;border-radius:14px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.sl-kpi-value{font-size:38px;font-weight:800;line-height:1;margin-top:16px}.sl-kpi-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:8px}.sl-main-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(320px,.9fr);gap:16px;margin-top:16px}.sl-panel{padding:18px;box-shadow:0 12px 28px rgba(16,24,40,.05)}.sl-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.sl-action-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.sl-action-card{display:flex;align-items:flex-start;gap:12px;padding:14px;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;background:#fff;color:inherit}.sl-action-card:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.sl-action-card strong{display:block;margin-bottom:4px}.sl-focus{border-left:4px solid var(--zcs_brand_color);background:linear-gradient(180deg,#fff,#fbfcff)}.sl-focus.red{border-left-color:#FE455D}.sl-focus.yellow{border-left-color:#FAAE13}.sl-focus.green{border-left-color:#179E6C}.sl-focus.blue{border-left-color:#2A6FFC}.sl-quick-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:16px}.sl-quick-card{padding:16px;display:flex;gap:12px;align-items:flex-start;color:inherit;min-height:116px}.sl-quick-card:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.sl-secondary{opacity:.88}.sl-table-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-weight:600}.sl-muted{color:var(--zcs_secondary_text_color)}.sl-note{background:rgba(255,255,255,.74);border:1px dashed var(--zcs_tertiary_border_color);border-radius:14px;padding:12px;margin-top:12px}.sl-empty{padding:24px;text-align:center;color:var(--zcs_secondary_text_color)}@media(max-width:1180px){.sl-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sl-main-grid{grid-template-columns:1fr}.sl-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.sl-shell{padding:14px}.sl-hero-inner{flex-direction:column;align-items:flex-start}.sl-title{font-size:24px}.sl-kpi-grid,.sl-action-cards,.sl-quick-grid{grid-template-columns:1fr}.zcs-table-wrapper table{min-width:760px}}\n&lt;/style&gt;\n&lt;div class=&apos;sl-shell&apos;&gt;\n\t&lt;div class=&apos;sl-container&apos;&gt;\n\t\t&lt;section class=&apos;sl-hero&apos;&gt;\n\t\t\t&lt;div class=&apos;sl-hero-inner&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline business-chart-growth&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Sales command center&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;h1 class=&apos;sl-title&apos;&gt;Welcome, &lt;%=loginName%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&apos;sl-subtitle zcs-font-15 zcs-lh-body&apos;&gt;Draft, returned, reopened and submission work is surfaced first. Approved, locked and superseded rows stay out of pending counts so the landing page stays actionable.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&apos;sl-hero-actions&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button sl-primary-hero zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Form:Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span&gt;Create sales plan&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-agenda&apos;&gt;&lt;/i&gt;&lt;span&gt;My pending work&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;span&gt;Status board&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-profile-pill zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-font-medium&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sl-kpi-grid&apos;&gt;\n\t\t\t&lt;a class=&apos;sl-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-secondary&apos;&gt;My active work&lt;/span&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-value&apos;&gt;&lt;%=myActiveWork%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-label&apos;&gt;Draft, revised draft, returned, SCM revision or reopened rows owned by you&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:My_Sales_Plan_Workqueue?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-secondary&apos;&gt;Needs revision&lt;/span&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-value&apos;&gt;&lt;%=needsRevision%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-label&apos;&gt;Returned, reopened or SCM revision rows. Open in dialog to review remarks.&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-secondary&apos;&gt;Submitted queue&lt;/span&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-value&apos;&gt;&lt;%=submittedQueue%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-label&apos;&gt;Rows submitted to Sales Management and not locked&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&apos;sl-kpi zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-secondary&apos;&gt;Final rows hidden&lt;/span&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-value&apos;&gt;&lt;%=approvedFinal%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-kpi-label&apos;&gt;Approved, superseded or locked rows are excluded from pending work&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sl-main-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;sl-panel zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sl-section-title&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pending actions&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-4&apos;&gt;Open forms and reports in dialog when remarks or revisions may be required.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;Priority: &lt;%=priorityLabel%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-action-cards&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;sl-action-card&apos; href=&apos;#Report:My_Sales_Plan_Workqueue?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;strong&gt;Revise returned work&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;&lt;%=needsRevision%&gt; row(s) need remarks review or a revised draft.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;sl-action-card&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;strong&gt;Finish drafts&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;&lt;%=myDrafts%&gt; draft row(s) are still not submitted.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;sl-action-card&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;strong&gt;Monitor submissions&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;&lt;%=submittedQueue%&gt; row(s) are with Sales Management.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-16&apos;&gt;\n\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Action&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Why it matters&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Review returned or reopened rows&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Remarks and revision details must be checked before updates.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-red&apos;&gt;&lt;%=needsRevision%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-table-link&apos; href=&apos;#Report:My_Sales_Plan_Workqueue?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Open dialog&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Complete draft submissions&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Draft and revised draft rows are still editable by the owner.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-yellow&apos;&gt;&lt;%=myDrafts%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-table-link&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Open queue&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Track submitted queue&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Submitted rows should be monitored, not mutated from the landing page.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-blue&apos;&gt;&lt;%=submittedQueue%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-table-link&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Status board&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;aside class=&apos;sl-panel sl-focus &lt;%=focusTone%&gt; zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=focusTitle%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;&lt;%=focusText%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-zoom&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border zcs-mt-16&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Quick actions&lt;/h3&gt;\n\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Sales_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Create a new sales plan&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-agenda&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Open my sales-plan workqueue&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Monitor status board&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sl-note zcs-font-13 zcs-color-secondary&apos;&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Insight only:&lt;/strong&gt; &lt;%=approvedFinal%&gt; approved, locked or superseded row(s) exist but are intentionally excluded from pending counts.&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sl-panel zcs-card zcs-box-border zcs-mt-16&apos;&gt;\n\t\t\t&lt;div class=&apos;sl-section-title&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Recent and priority work rows&lt;/h2&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-4&apos;&gt;Only your non-final working statuses are listed. Use the dialog link where remarks or revision details may be involved.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span&gt;View all&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Plan&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Grade MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Product MT&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Next action&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\trowCount = 0;\n\tfor each  plan in Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Reopened&quot; || Status == &quot;Draft&quot; || Status == &quot;Revised Draft&quot;] sort by Added_Time desc\n\t{\n\t\tif(rowCount &lt; 6)\n\t\t{\n\t\t\trowCount = rowCount + 1;\n\t\t\tstatusText = ifnull(plan.Status,&quot;Draft&quot;);\n\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tstatusIcon = &quot;zc-li-outline loader-dots-06&quot;;\n\t\t\tnextStep = &quot;Review status&quot;;\n\t\t\tif(statusText == &quot;Returned by Sales Management&quot; || statusText == &quot;Revision Requested by SCM&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\tstatusIcon = &quot;zc-li-outline ui-3-alert&quot;;\n\t\t\t\tnextStep = &quot;Open remarks and revise&quot;;\n\t\t\t}\n\t\t\telse if(statusText == &quot;Reopened&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tstatusIcon = &quot;zc-li-outline ui-3-alert&quot;;\n\t\t\t\tnextStep = &quot;Review reopened plan&quot;;\n\t\t\t}\n\t\t\telse if(statusText == &quot;Draft&quot; || statusText == &quot;Revised Draft&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\tstatusIcon = &quot;zc-li-outline ui-1-edit-72&quot;;\n\t\t\t\tnextStep = &quot;Complete and submit&quot;;\n\t\t\t}\n\t\t\tplanUrl = &quot;#Report:My_Sales_Plan_Workqueue?ID=&quot; + plan.ID + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;strong&gt;SP-&lt;%=ifnull(plan.Sales_Plan_No,&quot;Draft&quot;)%&gt;&lt;/strong&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Revision &lt;%=ifnull(plan.Revision_No,0)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14&apos;&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&apos;&gt;&lt;i class=&apos;zcs-badge-icon zcs-no-shrink &lt;%=statusIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=statusText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(plan.Total_Grade_Target_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(plan.Total_Product_Required_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=nextStep%&gt;&lt;div class=&apos;zcs-font-12 zcs-color-secondary&apos;&gt;Variance: &lt;%=ifnull(plan.Variance_Tons,0)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-table-link&apos; href=&apos;&lt;%=planUrl%&gt;&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Open dialog&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(rowCount == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;sl-empty zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14&apos; colspan=&apos;6&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt; No draft, returned, reopened or revision rows are waiting for you.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sl-quick-grid&apos;&gt;\n\t\t\t&lt;a class=&apos;sl-quick-card zcs-card zcs-box-border&apos; href=&apos;#Form:Sales_Plans?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Create plan&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;Start the new/create flow in dialog.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-quick-card zcs-card zcs-box-border&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline business-agenda&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;My workqueue&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;Personal pending work only.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-quick-card zcs-card zcs-box-border&apos; href=&apos;#Report:Sales_Plan_Status_Board&apos;&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Status monitoring&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;Track submitted rows and workflow state.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-quick-card sl-secondary zcs-card zcs-box-border&apos; href=&apos;#Report:Approved_Sales_Plans&apos;&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline files-check&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Approved plans&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;Secondary reference; not pending work.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sl-quick-card sl-secondary zcs-card zcs-box-border&apos; href=&apos;#Report:All_Sales_Plans&apos;&gt;&lt;span class=&apos;sl-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;All sales plans&lt;/strong&gt;&lt;span class=&apos;sl-muted zcs-font-13&apos;&gt;Secondary audit and search view.&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sales_Management_Landing
		{
					displayname = "Sales Management Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sales_Management_Landing_Snippet' elementName='Sales_Management_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Sales_Management_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Sales Management&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmanagementQueue = Sales_Plans[Status == &quot;Submitted to Sales Management&quot; &amp;&amp; Locked != true].count();\n\tpendingPlans = Sales_Plans[Status == &quot;Submitted to Sales Management&quot; &amp;&amp; Locked != true] sort by Modified_Time desc range from 0 to 7;\n\treturnedRevision = Sales_Plans[Locked != true &amp;&amp; Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tapprovedFinal = Sales_Plans[Status == &quot;Sales Approved&quot; || Status == &quot;Locked&quot; || Status == &quot;Superseded&quot; || Locked == true].count();\n\tshortfallBuckets = Volume_Consolidations[Status == &quot;Sales Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\tallPlans = Sales_Plans[ID != 0].count();\n\tfocusTone = &quot;green&quot;;\n\tfocusBadge = &quot;Queue clear&quot;;\n\tfocusTitle = &quot;No pending management approvals&quot;;\n\tfocusText = &quot;Final, locked and superseded records are excluded from this landing page action queue. Keep monitoring returned revisions and shortfall buckets for new exceptions.&quot;;\n\tfocusHref = &quot;#Report:All_Sales_Plans?zc_LoadIn=dialog&quot;;\n\tfocusIcon = &quot;ui-1-check-circle-08&quot;;\n\tif(managementQueue &gt; 0)\n\t{\n\t\tfocusTone = &quot;red&quot;;\n\t\tfocusBadge = &quot;Approve or return&quot;;\n\t\tfocusTitle = &quot;Start with the management approval queue&quot;;\n\t\tfocusText = managementQueue + &quot; submitted sales plan row(s) are waiting for Sales Management action. Open each record in dialog mode, choose Approver Action, and add remarks before approving or returning.&quot;;\n\t\tfocusHref = &quot;#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog&quot;;\n\t\tfocusIcon = &quot;business-signature&quot;;\n\t}\n\telse if(returnedRevision &gt; 0)\n\t{\n\t\tfocusTone = &quot;yellow&quot;;\n\t\tfocusBadge = &quot;Revision watch&quot;;\n\t\tfocusTitle = &quot;Returned and revision rows need follow-up&quot;;\n\t\tfocusText = returnedRevision + &quot; open returned or revision row(s) may come back for approval after owner correction. Review All Sales Plans for latest ownership and remarks.&quot;;\n\t\tfocusHref = &quot;#Report:All_Sales_Plans?zc_LoadIn=dialog&quot;;\n\t\tfocusIcon = &quot;arrows-1-refresh-69&quot;;\n\t}\n\telse if(shortfallBuckets &gt; 0)\n\t{\n\t\tfocusTone = &quot;orange&quot;;\n\t\tfocusBadge = &quot;Commercial exception&quot;;\n\t\tfocusTitle = &quot;Review sales shortfall buckets&quot;;\n\t\tfocusText = shortfallBuckets + &quot; sales shortfall bucket(s) are active. Use them as supporting insight before the next approval wave arrives.&quot;;\n\t\tfocusHref = &quot;#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog&quot;;\n\t\tfocusIcon = &quot;business-chart-pie-36&quot;;\n\t}\n\tqueueShare = 0;\n\tif(allPlans &gt; 0)\n\t{\n\t\tqueueShare = (managementQueue * 100) / allPlans;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global.css core utilities included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;font-size:16px;line-height:1.5}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598E}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-no-shrink{flex-shrink:0}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky;top:0}.zcs-cursor-pointer{cursor:pointer}\n/* ZCS component CSS: button, badge, quick-actions, label-value and simple table */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#A06A00}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#C94F07}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow{color:#a06309}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#FF7E52}.zcs-labelvalue-wrapper .zcs-labelvalue-color-red{color:#FE455D}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}\n/* Sales Management command-center layout */\ndiv#zppagesLive,div#elementsContainer,.Layout.elemContainment,div#row_1,.zc-pb-formreport-placeholder{height:100%!important;padding:0!important}.sml-shell{min-height:100vh;background:radial-gradient(circle at 82% 6%,rgba(255,255,255,.98) 0,rgba(255,255,255,0) 34%),linear-gradient(135deg,#f8fbff 0%,var(--zcs_brand_light_color) 48%,#f3f3f4 100%);padding:24px;box-sizing:border-box;color:var(--zcs_primary_text_color)}.sml-container{max-width:1500px;margin:0 auto}.sml-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:22px;padding:24px;box-shadow:0 18px 48px rgba(16,24,40,.14);color:var(--zcs_brand_foreground_color);position:relative;overflow:hidden}.sml-hero:after{content:&quot;&quot;;position:absolute;width:330px;height:330px;border:1px solid rgba(255,255,255,.24);border-radius:50%;right:-124px;top:-154px;box-shadow:0 0 0 34px rgba(255,255,255,.06),0 0 0 80px rgba(255,255,255,.04)}.sml-hero-inner{position:relative;z-index:1;display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.sml-title{font-size:30px;font-weight:800;line-height:1.2;margin:0 0 8px}.sml-subtitle{max-width:820px;margin:0;color:rgba(255,255,255,.88)}.sml-profile-pill{border:1px solid rgba(255,255,255,.38);border-radius:999px;padding:8px 12px;background:rgba(255,255,255,.12);white-space:nowrap}.sml-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.sml-hero-actions .zcs-button{border-color:rgba(255,255,255,.58);background:rgba(255,255,255,.14);color:var(--zcs_brand_foreground_color)}.sml-hero-actions .sml-primary-hero{background:var(--zcs-white-color);border-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.sml-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.sml-kpi{padding:18px;min-height:145px;box-shadow:0 12px 28px rgba(16,24,40,.06);transition:border-color .18s ease,transform .18s ease;color:inherit}.sml-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.sml-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.sml-icon-tile{width:42px;height:42px;border-radius:14px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:20px}.sml-kpi-value{font-size:38px;font-weight:800;line-height:1;margin-top:16px}.sml-kpi-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:8px}.sml-main-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(330px,.95fr);gap:16px;margin-top:16px}.sml-panel{padding:18px;box-shadow:0 12px 28px rgba(16,24,40,.05)}.sml-section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.sml-section-title h2{margin:0}.sml-focus{border-left:4px solid var(--zcs_brand_color);background:linear-gradient(180deg,#fff,#fbfcff)}.sml-focus.red{border-left-color:#FE455D}.sml-focus.yellow{border-left-color:#FAAE13}.sml-focus.orange{border-left-color:#F4660C}.sml-focus.green{border-left-color:#179E6C}.sml-focus h3{margin:0}.sml-focus-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.sml-note{background:rgba(255,255,255,.74);border:1px dashed var(--zcs_tertiary_border_color);border-radius:14px;padding:12px}.sml-table-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-weight:600}.sml-form-link{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--zcs_brand_color);border-radius:8px;padding:6px 10px;color:var(--zcs_brand_color);background:#fff;font-weight:600;white-space:nowrap}.sml-form-link:hover{background:var(--zcs_component_hover_color)}.sml-muted{color:var(--zcs_secondary_text_color)}.sml-small{font-size:12px}.sml-empty{padding:28px;text-align:center;color:var(--zcs_secondary_text_color)}.sml-support-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.sml-support-item{border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:14px;background:#fff}.sml-quick-actions-wrapper{margin-top:16px}.sml-quick-action-item{list-style:none}.sml-quick-action-link{min-height:42px}.sml-queue-note{display:flex;align-items:flex-start;gap:10px;margin-top:12px}.sml-status-pill{white-space:nowrap}.sml-mobile-list{display:none}.sml-mobile-card{border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;background:#fff;padding:14px}.sml-mobile-card+.sml-mobile-card{margin-top:10px}@media(max-width:1180px){.sml-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sml-main-grid{grid-template-columns:1fr}.sml-support-grid{grid-template-columns:1fr}}@media(max-width:760px){.sml-shell{padding:14px}.sml-hero-inner{flex-direction:column;align-items:flex-start}.sml-title{font-size:24px}.sml-kpi-grid{grid-template-columns:1fr}.sml-desktop-table{display:none}.sml-mobile-list{display:block}.sml-section-title{align-items:flex-start;flex-direction:column}.sml-hero-actions .zcs-button,.sml-focus-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;sml-shell&apos;&gt;\n\t&lt;div class=&apos;sml-container&apos;&gt;\n\t\t&lt;section class=&apos;sml-hero&apos;&gt;\n\t\t\t&lt;div class=&apos;sml-hero-inner&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline business-signature&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Sales Management command center&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;h1 class=&apos;sml-title&apos;&gt;Approval queue first for &lt;%=loginName%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&apos;sml-subtitle zcs-font-15 zcs-lh-body&apos;&gt;Submitted and unlocked Sales Plans are surfaced first. Approve or return work opens in dialog mode so remarks and Approver Action can be captured on the source record, while final and locked rows stay out of pending actions.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&apos;sml-hero-actions&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button sml-primary-hero zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;span&gt;Open approval queue&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:All_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-agenda&apos;&gt;&lt;/i&gt;&lt;span&gt;All sales plans&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;span&gt;Shortfall buckets&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-profile-pill zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-font-14&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sml-kpi-grid&apos;&gt;\n\t\t\t&lt;a class=&apos;sml-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary zcs-uppercase&apos;&gt;Management approval queue&lt;/span&gt;&lt;span class=&apos;sml-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-value zcs-color-primary&apos;&gt;&lt;%=managementQueue%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-label&apos;&gt;Submitted to Sales Management and not locked&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sml-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:All_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary zcs-uppercase&apos;&gt;Returned and revision rows&lt;/span&gt;&lt;span class=&apos;sml-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-value zcs-color-primary&apos;&gt;&lt;%=returnedRevision%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-label&apos;&gt;Returned by Sales Management or in SCM revision loop&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sml-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Approved_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary zcs-uppercase&apos;&gt;Approved and final rows&lt;/span&gt;&lt;span class=&apos;sml-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-value zcs-color-primary&apos;&gt;&lt;%=approvedFinal%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-label&apos;&gt;Sales approved, superseded, locked or finalised records&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;sml-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-top&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary zcs-uppercase&apos;&gt;Sales shortfall buckets&lt;/span&gt;&lt;span class=&apos;sml-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-value zcs-color-primary&apos;&gt;&lt;%=shortfallBuckets%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;sml-kpi-label&apos;&gt;Commercial exceptions requiring sales-side revision&lt;/div&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;sml-main-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;sml-panel zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;sml-section-title&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Pending actions&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Latest 8 Sales Plans with Status equals Submitted to Sales Management, sorted by Modified Time descending. Locked and final rows are excluded.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=managementQueue%&gt; pending&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(pendingPlans.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;sml-empty zcs-card&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-30 zcs-color-green&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-mt-8&apos;&gt;No submitted and unlocked Sales Plans are waiting for management action.&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-14 sml-muted zcs-mt-4&apos;&gt;Use the quick navigation panel to review approved rows, returned revisions, or commercial exceptions.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative sml-desktop-table&apos;&gt;\n\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Sales plan&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Cycle&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Target tons&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Variance&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Modified&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open work&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each  plan in pendingPlans\n\t\t{\n\t\t\tfyText = &quot;-&quot;;\n\t\t\tcycleText = &quot;-&quot;;\n\t\t\tif(plan.Requested_Financial_Year != null)\n\t\t\t{\n\t\t\t\tfyText = plan.Requested_Financial_Year.Year_Name;\n\t\t\t}\n\t\t\tif(plan.Budget_Cycle != null)\n\t\t\t{\n\t\t\t\tcycleText = plan.Budget_Cycle.Cycle_Name;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;sml-table-link&apos; href=&apos;#Report:Sales_Management_Approval_Queue?ID=&lt;%=plan.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=plan.Sales_Plan_No%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;sml-small sml-muted&apos;&gt;Owner: &lt;%=ifnull(plan.Owner_Email,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=fyText%&gt;&lt;div class=&apos;sml-small sml-muted&apos;&gt;&lt;%=cycleText%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(plan.Total_Grade_Target_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=ifnull(plan.Variance_Tons,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=plan.Modified_Time%&gt;&lt;div class=&apos;sml-small sml-muted&apos;&gt;Status: &lt;%=plan.Status%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;sml-form-link&apos; href=&apos;#Form:Sales_Plans?recLinkID=&lt;%=plan.ID%&gt;&amp;amp;viewLinkName=Sales_Management_Approval_Queue&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Open/Edit Form&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;sml-mobile-list&apos;&gt;\n&lt;%\n\t\tfor each  planMobile in pendingPlans\n\t\t{\n\t\t\tfyMobile = &quot;-&quot;;\n\t\t\tcycleMobile = &quot;-&quot;;\n\t\t\tif(planMobile.Requested_Financial_Year != null)\n\t\t\t{\n\t\t\t\tfyMobile = planMobile.Requested_Financial_Year.Year_Name;\n\t\t\t}\n\t\t\tif(planMobile.Budget_Cycle != null)\n\t\t\t{\n\t\t\t\tcycleMobile = planMobile.Budget_Cycle.Cycle_Name;\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&apos;sml-mobile-card&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;sml-table-link zcs-font-16&apos; href=&apos;#Report:Sales_Management_Approval_Queue?ID=&lt;%=planMobile.ID%&gt;&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=planMobile.Sales_Plan_No%&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 sml-status-pill&apos;&gt;Pending&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper zcs-mt-8&apos;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-py-4 zcs-box-border&apos; style=&apos;width:50%;&apos;&gt;&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Cycle&lt;/label&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=fyMobile%&gt; / &lt;%=cycleMobile%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-py-4 zcs-box-border&apos; style=&apos;width:50%;&apos;&gt;&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Modified&lt;/label&gt;&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=planMobile.Modified_Time%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;sml-form-link zcs-mt-8&apos; href=&apos;#Form:Sales_Plans?recLinkID=&lt;%=planMobile.ID%&gt;&amp;amp;viewLinkName=Sales_Management_Approval_Queue&amp;amp;zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span&gt;Open/Edit Form&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&apos;sml-queue-note sml-note zcs-font-14 sml-muted&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-color-theme zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;div&gt;Approve and return actions require source-record context. Use Open/Edit Form to set Approver Action and Approval Remarks in the dialog rather than adding a report-button workflow on this page.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;aside&gt;\n\t\t\t\t&lt;div class=&apos;sml-panel sml-focus &lt;%=focusTone%&gt; zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;sml-icon-tile&apos;&gt;&lt;i class=&apos;zc-li-outline &lt;%=focusIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=focusBadge%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-22 zcs-font-semibold zcs-color-primary zcs-mt-16&apos;&gt;&lt;%=focusTitle%&gt;&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-14 sml-muted zcs-lh-body&apos;&gt;&lt;%=focusText%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&apos;sml-focus-actions&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;&lt;%=focusHref%&gt;&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span&gt;Open priority&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;sml-support-grid&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;sml-support-item&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Queue share&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary zcs-mt-8&apos;&gt;&lt;%=queueShare%&gt;%&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 sml-muted&apos;&gt;Pending queue as a share of all Sales Plans&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;sml-support-item&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-color-green&apos;&gt;&lt;/i&gt;&lt;strong class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Final control&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary zcs-mt-8&apos;&gt;&lt;%=approvedFinal%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 sml-muted&apos;&gt;Approved, superseded or locked records kept out of action queue&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper sml-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Quick navigation&lt;/h5&gt;\n\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Sales_Management_Approval_Queue?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Approval queue&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-agenda&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;All sales plans&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Approved_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Approved sales plans&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item sml-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link sml-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Sales_Shortfall_Buckets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Sales shortfall buckets&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Scenario_Comparison_Dashboard(int Budget_Cycle_ID)
		{
					displayname = "Scenario Comparison"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Header' elementName='Scenario_Header'>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Header()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc;\n\tcycleSource = &quot;Latest active/open cycle&quot;;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t\tcycleSource = &quot;Selected cycle&quot;;\n\t\t}\n\t}\n\tcycleCode = &quot;No active cycle&quot;;\n\tcycleName = &quot;No active/open Budget Cycle is available for scenario comparison.&quot;;\n\tcycleStatus = &quot;No Data&quot;;\n\tfyName = &quot;-&quot;;\n\thasCycle = selectedCycle.count() &gt; 0;\n\tcomparisonUrl = &quot;&quot;;\n\tif(hasCycle)\n\t{\n\t\tcomparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + selectedCycle.ID;\n\t\tcycleCode = ifNull(selectedCycle.Cycle_Code,&quot;-&quot;);\n\t\tcycleName = ifNull(selectedCycle.Cycle_Name,&quot;-&quot;);\n\t\tcycleStatus = ifNull(selectedCycle.Status,&quot;-&quot;);\n\t\tfyRecords = Financial_Years[ID == selectedCycle.Financial_Year];\n\t\tif(fyRecords.count() &gt; 0)\n\t\t{\n\t\t\tfyName = ifNull(fyRecords.Year_Name,&quot;-&quot;);\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n.scenario-page{font-family:var(--zc-page-font-family,Arial,sans-serif);background:#f3f3f4;padding:16px;box-sizing:border-box}.scenario-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);border-radius:16px;color:#fff;padding:24px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;flex-wrap:wrap}.scenario-hero h2{margin:0 0 6px;font-size:24px}.scenario-hero p{margin:0;font-size:14px;opacity:.9}.scenario-pill{display:inline-block;margin-top:14px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:6px 12px;font-size:13px}.scenario-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap;min-width:260px}.scenario-actions .zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.scenario-actions .zcs-primary-button{background:#fff;color:var(--zcs_brand_color)}.scenario-actions .zcs-primary-outline-button{border:1px solid rgba(255,255,255,.55);background:rgba(255,255,255,.12);color:#fff}.scenario-actions .zcs-button-icon{width:16px;max-height:16px}.scenario-empty{background:#fff;border:1px dashed var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;color:var(--zcs_primary_text_color);display:flex;gap:12px;align-items:flex-start}.scenario-empty i{color:var(--zcs_brand_color);font-size:22px}.scenario-section{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.scenario-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.scenario-card{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;padding:14px;background:#fff}.scenario-label{font-size:12px;color:var(--zcs_secondary_text_color)}.scenario-value{font-size:22px;font-weight:700;color:var(--zcs_primary_text_color);margin-top:4px}.scenario-table{width:100%;border-collapse:collapse}.scenario-table th,.scenario-table td{border-top:1px solid var(--zcs_tertiary_border_color);padding:10px;text-align:left}.scenario-table th{background:#f9fafe;color:var(--zcs_primary_text_color)}@media(max-width:900px){.scenario-grid{grid-template-columns:1fr}.scenario-hero{display:block}.scenario-actions{justify-content:flex-start;margin-top:16px}}\n&lt;/style&gt;\n&lt;div class=&quot;scenario-page&quot;&gt;\n\t&lt;div class=&quot;scenario-hero&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h2&gt;Scenario Comparison&lt;/h2&gt;\n\t\t\t&lt;p&gt;Financial year &lt;%=fyName%&gt; | Cycle &lt;%=cycleCode%&gt; | Status &lt;%=cycleStatus%&gt;&lt;/p&gt;\n\t\t\t&lt;span class=&quot;scenario-pill&quot;&gt;&lt;%=cycleSource%&gt;: &lt;%=cycleName%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;scenario-actions&quot;&gt;\n&lt;%\n\tif(hasCycle)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=comparisonUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Open Comparison&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;span class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; style=&apos;opacity:.68;cursor:not-allowed;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;No Active Cycle&lt;/span&gt;\n\t\t\t&lt;/span&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Financial Summary&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\tif(!hasCycle)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;scenario-empty&quot; style=&quot;margin-top:16px;&quot;&gt;\n\t\t&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;\n\t\t&lt;div&gt;&lt;strong&gt;No comparison cycle available&lt;/strong&gt;&lt;br&gt;&lt;span&gt;No selected cycle was supplied and no active/open Budget Cycle is available. Create or reopen a cycle before making scenario decisions.&lt;/span&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Cards' elementName='Scenario_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tscenarioSetCode = &quot;&quot;;\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvVolume = ifNull(volumeFinancial.Volume_MT,0);\n\tvRevenue = ifNull(volumeFinancial.Revenue,0);\n\tvRaw = ifNull(volumeFinancial.Raw_Material_Cost,0);\n\tvCons = ifNull(volumeFinancial.Consumables_Cost,0);\n\tvTotal = ifNull(volumeFinancial.Total_Cost,0);\n\tvEbitda = ifNull(volumeFinancial.EBITDA,0);\n\tvMargin = ifNull(volumeFinancial.EBITDA_Margin_Percent,0);\n\teVolume = ifNull(ebitdaFinancial.Volume_MT,0);\n\teRevenue = ifNull(ebitdaFinancial.Revenue,0);\n\teRaw = ifNull(ebitdaFinancial.Raw_Material_Cost,0);\n\teCons = ifNull(ebitdaFinancial.Consumables_Cost,0);\n\teTotal = ifNull(ebitdaFinancial.Total_Cost,0);\n\teEbitda = ifNull(ebitdaFinancial.EBITDA,0);\n\teMargin = ifNull(ebitdaFinancial.EBITDA_Margin_Percent,0);\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Scenario KPI Cards&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Side-by-side financial comparison for management review. Currency values are shown as entered in Financial Consolidations.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;scenario-grid-2&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-icon&quot; style=&quot;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h6 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Volume Maximising&lt;/h6&gt;&lt;span class=&quot;scenario-muted&quot;&gt;&lt;%=ifNull(volumeCycle.Cycle_Code,&quot;No cycle&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ifNull(volumeFinancial.Status,&quot;Not Created&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Volume MT&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=vVolume%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Revenue&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vRevenue%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Raw Material Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vRaw%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Consumables Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vCons%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Total Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=vEbitda%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA Margin Percent&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=vMargin%&gt;%&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-icon&quot; style=&quot;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h6 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;EBITDA Maximising&lt;/h6&gt;&lt;span class=&quot;scenario-muted&quot;&gt;&lt;%=ifNull(ebitdaCycle.Cycle_Code,&quot;No cycle&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ifNull(ebitdaFinancial.Status,&quot;Not Created&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Volume MT&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=eVolume%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Revenue&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=eRevenue%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Raw Material Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=eRaw%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Consumables Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=eCons%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;Total Cost&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=eTotal%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;INR &lt;%=eEbitda%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;metric-line&quot;&gt;&lt;span class=&quot;metric-label&quot;&gt;EBITDA Margin Percent&lt;/span&gt;&lt;strong class=&quot;metric-value&quot;&gt;&lt;%=eMargin%&gt;%&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scenario_Variance_Bars' elementName='Scenario_Variance_Bars'>\n\t\t\t\t\t<![CDATA[htmlpage Scenario_Variance_Bars()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvVolume = ifNull(volumeFinancial.Volume_MT,0);\n\tvRevenue = ifNull(volumeFinancial.Revenue,0);\n\tvRaw = ifNull(volumeFinancial.Raw_Material_Cost,0);\n\tvCons = ifNull(volumeFinancial.Consumables_Cost,0);\n\tvTotal = ifNull(volumeFinancial.Total_Cost,0);\n\tvEbitda = ifNull(volumeFinancial.EBITDA,0);\n\tvMargin = ifNull(volumeFinancial.EBITDA_Margin_Percent,0);\n\teVolume = ifNull(ebitdaFinancial.Volume_MT,0);\n\teRevenue = ifNull(ebitdaFinancial.Revenue,0);\n\teRaw = ifNull(ebitdaFinancial.Raw_Material_Cost,0);\n\teCons = ifNull(ebitdaFinancial.Consumables_Cost,0);\n\teTotal = ifNull(ebitdaFinancial.Total_Cost,0);\n\teEbitda = ifNull(ebitdaFinancial.EBITDA,0);\n\teMargin = ifNull(ebitdaFinancial.EBITDA_Margin_Percent,0);\n\tvolVar = eVolume - vVolume;\n\tvolPct = 0;\n\tif(vVolume != 0)\n\t{\n\t\tvolPct = volVar / vVolume * 100;\n\t}\n\telse if(eVolume != 0)\n\t{\n\t\tvolPct = 100;\n\t}\n\tvolWidth = volPct;\n\tif(volWidth &lt; 0)\n\t{\n\t\tvolWidth = volWidth * -1;\n\t}\n\tif(volWidth &gt; 100)\n\t{\n\t\tvolWidth = 100;\n\t}\n\tif(volWidth &gt; 0 &amp;&amp; volWidth &lt; 3)\n\t{\n\t\tvolWidth = 3;\n\t}\n\tvolClass = &quot;is-neutral&quot;;\n\tif(volVar &gt; 0)\n\t{\n\t\tvolClass = &quot;is-positive&quot;;\n\t}\n\tif(volVar &lt; 0)\n\t{\n\t\tvolClass = &quot;is-negative&quot;;\n\t}\n\trevVar = eRevenue - vRevenue;\n\trevPct = 0;\n\tif(vRevenue != 0)\n\t{\n\t\trevPct = revVar / vRevenue * 100;\n\t}\n\telse if(eRevenue != 0)\n\t{\n\t\trevPct = 100;\n\t}\n\trevWidth = revPct;\n\tif(revWidth &lt; 0)\n\t{\n\t\trevWidth = revWidth * -1;\n\t}\n\tif(revWidth &gt; 100)\n\t{\n\t\trevWidth = 100;\n\t}\n\tif(revWidth &gt; 0 &amp;&amp; revWidth &lt; 3)\n\t{\n\t\trevWidth = 3;\n\t}\n\trevClass = &quot;is-neutral&quot;;\n\tif(revVar &gt; 0)\n\t{\n\t\trevClass = &quot;is-positive&quot;;\n\t}\n\tif(revVar &lt; 0)\n\t{\n\t\trevClass = &quot;is-negative&quot;;\n\t}\n\trawVar = eRaw - vRaw;\n\trawPct = 0;\n\tif(vRaw != 0)\n\t{\n\t\trawPct = rawVar / vRaw * 100;\n\t}\n\telse if(eRaw != 0)\n\t{\n\t\trawPct = 100;\n\t}\n\trawWidth = rawPct;\n\tif(rawWidth &lt; 0)\n\t{\n\t\trawWidth = rawWidth * -1;\n\t}\n\tif(rawWidth &gt; 100)\n\t{\n\t\trawWidth = 100;\n\t}\n\tif(rawWidth &gt; 0 &amp;&amp; rawWidth &lt; 3)\n\t{\n\t\trawWidth = 3;\n\t}\n\trawClass = &quot;is-neutral&quot;;\n\tif(rawVar &gt; 0)\n\t{\n\t\trawClass = &quot;is-positive&quot;;\n\t}\n\tif(rawVar &lt; 0)\n\t{\n\t\trawClass = &quot;is-negative&quot;;\n\t}\n\tconVar = eCons - vCons;\n\tconPct = 0;\n\tif(vCons != 0)\n\t{\n\t\tconPct = conVar / vCons * 100;\n\t}\n\telse if(eCons != 0)\n\t{\n\t\tconPct = 100;\n\t}\n\tconWidth = conPct;\n\tif(conWidth &lt; 0)\n\t{\n\t\tconWidth = conWidth * -1;\n\t}\n\tif(conWidth &gt; 100)\n\t{\n\t\tconWidth = 100;\n\t}\n\tif(conWidth &gt; 0 &amp;&amp; conWidth &lt; 3)\n\t{\n\t\tconWidth = 3;\n\t}\n\tconClass = &quot;is-neutral&quot;;\n\tif(conVar &gt; 0)\n\t{\n\t\tconClass = &quot;is-positive&quot;;\n\t}\n\tif(conVar &lt; 0)\n\t{\n\t\tconClass = &quot;is-negative&quot;;\n\t}\n\ttotVar = eTotal - vTotal;\n\ttotPct = 0;\n\tif(vTotal != 0)\n\t{\n\t\ttotPct = totVar / vTotal * 100;\n\t}\n\telse if(eTotal != 0)\n\t{\n\t\ttotPct = 100;\n\t}\n\ttotWidth = totPct;\n\tif(totWidth &lt; 0)\n\t{\n\t\ttotWidth = totWidth * -1;\n\t}\n\tif(totWidth &gt; 100)\n\t{\n\t\ttotWidth = 100;\n\t}\n\tif(totWidth &gt; 0 &amp;&amp; totWidth &lt; 3)\n\t{\n\t\ttotWidth = 3;\n\t}\n\ttotClass = &quot;is-neutral&quot;;\n\tif(totVar &gt; 0)\n\t{\n\t\ttotClass = &quot;is-positive&quot;;\n\t}\n\tif(totVar &lt; 0)\n\t{\n\t\ttotClass = &quot;is-negative&quot;;\n\t}\n\tebiVar = eEbitda - vEbitda;\n\tebiPct = 0;\n\tif(vEbitda != 0)\n\t{\n\t\tebiPct = ebiVar / vEbitda * 100;\n\t}\n\telse if(eEbitda != 0)\n\t{\n\t\tebiPct = 100;\n\t}\n\tebiWidth = ebiPct;\n\tif(ebiWidth &lt; 0)\n\t{\n\t\tebiWidth = ebiWidth * -1;\n\t}\n\tif(ebiWidth &gt; 100)\n\t{\n\t\tebiWidth = 100;\n\t}\n\tif(ebiWidth &gt; 0 &amp;&amp; ebiWidth &lt; 3)\n\t{\n\t\tebiWidth = 3;\n\t}\n\tebiClass = &quot;is-neutral&quot;;\n\tif(ebiVar &gt; 0)\n\t{\n\t\tebiClass = &quot;is-positive&quot;;\n\t}\n\tif(ebiVar &lt; 0)\n\t{\n\t\tebiClass = &quot;is-negative&quot;;\n\t}\n\tmarVar = eMargin - vMargin;\n\tmarPct = 0;\n\tif(vMargin != 0)\n\t{\n\t\tmarPct = marVar / vMargin * 100;\n\t}\n\telse if(eMargin != 0)\n\t{\n\t\tmarPct = 100;\n\t}\n\tmarWidth = marPct;\n\tif(marWidth &lt; 0)\n\t{\n\t\tmarWidth = marWidth * -1;\n\t}\n\tif(marWidth &gt; 100)\n\t{\n\t\tmarWidth = 100;\n\t}\n\tif(marWidth &gt; 0 &amp;&amp; marWidth &lt; 3)\n\t{\n\t\tmarWidth = 3;\n\t}\n\tmarClass = &quot;is-neutral&quot;;\n\tif(marVar &gt; 0)\n\t{\n\t\tmarClass = &quot;is-positive&quot;;\n\t}\n\tif(marVar &lt; 0)\n\t{\n\t\tmarClass = &quot;is-negative&quot;;\n\t}\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Scenario Variance Bars&lt;/h5&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Variance is EBITDA-maximising scenario minus volume-maximising scenario.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=volClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Volume MT&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vVolume%&gt; | Compare &lt;%=eVolume%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=volWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;&lt;%=volVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=volPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=revClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Revenue&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vRevenue%&gt; | Compare &lt;%=eRevenue%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=revWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=revVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=revPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=rawClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Raw Material Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vRaw%&gt; | Compare &lt;%=eRaw%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=rawWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=rawVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=rawPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=conClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Consumables Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vCons%&gt; | Compare &lt;%=eCons%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=conWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=conVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=conPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=totClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;Total Cost&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vTotal%&gt; | Compare &lt;%=eTotal%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=totWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=totVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=totPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=ebiClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;EBITDA&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vEbitda%&gt; | Compare &lt;%=eEbitda%&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=ebiWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;INR &lt;%=ebiVar%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=ebiPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;variance-row &lt;%=marClass%&gt;&quot;&gt;&lt;div&gt;&lt;strong&gt;EBITDA Margin Percent&lt;/strong&gt;&lt;div class=&quot;variance-meta&quot;&gt;Base &lt;%=vMargin%&gt;% | Compare &lt;%=eMargin%&gt;%&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-bar-track&quot;&gt;&lt;div class=&quot;variance-bar-fill&quot; style=&quot;width:&lt;%=marWidth%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;variance-value&quot;&gt;&lt;strong&gt;&lt;%=marVar%&gt; pts&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;variance-meta&quot;&gt;&lt;%=marPct%&gt;%&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Plant_Scenario_Table' elementName='Plant_Scenario_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Scenario_Table()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tconsolidations = Volume_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tconsolidations = Volume_Consolidations[Budget_Cycle == selectedCycle.ID] sort by Consolidation_No desc;\n\t}\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t&lt;h3 style=&quot;margin:0 0 6px;color:var(--zcs_primary_text_color);&quot;&gt;SCM Consolidation Summary&lt;/h3&gt;\n\t\t&lt;p style=&quot;margin:0 0 14px;color:var(--zcs_secondary_text_color);font-size:13px;&quot;&gt;Valid SCM review records linked to the selected budget cycle.&lt;/p&gt;\n\t\t&lt;table class=&quot;scenario-table&quot;&gt;\n\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Consolidation&lt;/th&gt;&lt;th&gt;FY&lt;/th&gt;&lt;th&gt;Plant&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Decision&lt;/th&gt;&lt;th&gt;Latest Revision&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;%\n\tif(consolidations.count() == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;6&quot; style=&quot;text-align:center;color:var(--zcs_secondary_text_color);&quot;&gt;No SCM consolidations found for the selected cycle.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  rec in consolidations\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Consolidation_No%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Requested_Financial_Year.Year_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Plant.Plant_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.Status%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=rec.SCM_Decision%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%=ifNull(rec.Latest_Revision_No,0)%&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Management_Decision_Panel' elementName='Management_Decision_Panel'>\n\t\t\t\t\t<![CDATA[htmlpage Management_Decision_Panel()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedCycle = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc;\n\tif(input.Budget_Cycle_ID != null &amp;&amp; input.Budget_Cycle_ID &gt; 0)\n\t{\n\t\trequestedCycle = Budget_Cycles[ID == input.Budget_Cycle_ID];\n\t\tif(requestedCycle.count() &gt; 0)\n\t\t{\n\t\t\tselectedCycle = requestedCycle;\n\t\t}\n\t}\n\tvolumeCycle = Budget_Cycles[ID == 0];\n\tebitdaCycle = Budget_Cycles[ID == 0];\n\tvolumeFinancial = Financial_Consolidations[ID == 0];\n\tebitdaFinancial = Financial_Consolidations[ID == 0];\n\tif(selectedCycle.count() &gt; 0)\n\t{\n\t\tscenarioSetCode = ifNull(selectedCycle.Scenario_Set_Code,&quot;&quot;);\n\t\tif(scenarioSetCode != &quot;&quot;)\n\t\t{\n\t\t\tvolumeCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;Volume Maximising&quot;];\n\t\t\tebitdaCycle = Budget_Cycles[Scenario_Set_Code == scenarioSetCode &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;];\n\t\t}\n\t\tif(volumeCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;Volume Maximising&quot;)\n\t\t{\n\t\t\tvolumeCycle = selectedCycle;\n\t\t}\n\t\tif(ebitdaCycle.count() == 0 &amp;&amp; selectedCycle.Scenario == &quot;EBITDA Maximising&quot;)\n\t\t{\n\t\t\tebitdaCycle = selectedCycle;\n\t\t}\n\t\tif(volumeCycle.count() &gt; 0)\n\t\t{\n\t\t\tvolumeFinancial = Financial_Consolidations[Budget_Cycle == volumeCycle.ID &amp;&amp; Scenario == &quot;Volume Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t\tif(ebitdaCycle.count() &gt; 0)\n\t\t{\n\t\t\tebitdaFinancial = Financial_Consolidations[Budget_Cycle == ebitdaCycle.ID &amp;&amp; Scenario == &quot;EBITDA Maximising&quot;] sort by Financial_Consolidation_No desc;\n\t\t}\n\t}\n\tvolumeDecision = ifNull(volumeFinancial.Management_Decision,&quot;Pending&quot;);\n\tebitdaDecision = ifNull(ebitdaFinancial.Management_Decision,&quot;Pending&quot;);\n\tvolumeStatus = ifNull(volumeFinancial.Status,&quot;Not Created&quot;);\n\tebitdaStatus = ifNull(ebitdaFinancial.Status,&quot;Not Created&quot;);\n\tvolumeDraftClass = &quot;&quot;;\n\tvolumeSubmittedClass = &quot;&quot;;\n\tvolumeApprovedClass = &quot;&quot;;\n\tvolumeLockedClass = &quot;&quot;;\n\tif(volumeStatus == &quot;Draft&quot;)\n\t{\n\t\tvolumeDraftClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Submitted to Management&quot;)\n\t{\n\t\tvolumeSubmittedClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Approved Final&quot;)\n\t{\n\t\tvolumeApprovedClass = &quot;active&quot;;\n\t}\n\tif(volumeStatus == &quot;Locked&quot;)\n\t{\n\t\tvolumeLockedClass = &quot;active&quot;;\n\t}\n\tebitdaDraftClass = &quot;&quot;;\n\tebitdaSubmittedClass = &quot;&quot;;\n\tebitdaApprovedClass = &quot;&quot;;\n\tebitdaLockedClass = &quot;&quot;;\n\tif(ebitdaStatus == &quot;Draft&quot;)\n\t{\n\t\tebitdaDraftClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Submitted to Management&quot;)\n\t{\n\t\tebitdaSubmittedClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Approved Final&quot;)\n\t{\n\t\tebitdaApprovedClass = &quot;active&quot;;\n\t}\n\tif(ebitdaStatus == &quot;Locked&quot;)\n\t{\n\t\tebitdaLockedClass = &quot;active&quot;;\n\t}\n\tcurrentDecision = &quot;Pending&quot;;\n\tif(volumeDecision != &quot;Pending&quot;)\n\t{\n\t\tcurrentDecision = volumeDecision;\n\t}\n\tif(ebitdaDecision != &quot;Pending&quot;)\n\t{\n\t\tcurrentDecision = ebitdaDecision;\n\t}\n\tdecisionClass = &quot;zcs-badge-yellow&quot;;\n\tif(currentDecision.contains(&quot;Selected&quot;))\n\t{\n\t\tdecisionClass = &quot;zcs-badge-green&quot;;\n\t}\n\tif(currentDecision == &quot;Rejected&quot;)\n\t{\n\t\tdecisionClass = &quot;zcs-badge-red&quot;;\n\t}\n\t%&gt;\n&lt;div class=&quot;scenario-page&quot; style=&quot;padding-top:0;&quot;&gt;\n\t\t&lt;div class=&quot;scenario-section&quot;&gt;\n\t\t\t\t&lt;div class=&quot;scenario-card-title&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Management Decision Panel&lt;/h5&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Current approval decision and Financial Consolidation status before final lock.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=decisionClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=currentDecision%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;scenario-grid-3&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;Volume Maximising Decision&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;decision-big&quot;&gt;&lt;%=volumeDecision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-mt-8&quot;&gt;&lt;span class=&quot;scenario-muted&quot;&gt;Financial status&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=volumeStatus%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-flow&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeDraftClass%&gt;&quot;&gt;Draft&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeSubmittedClass%&gt;&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeApprovedClass%&gt;&quot;&gt;Approved Final&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=volumeLockedClass%&gt;&quot;&gt;Locked&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;EBITDA Maximising Decision&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;decision-big&quot;&gt;&lt;%=ebitdaDecision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-mt-8&quot;&gt;&lt;span class=&quot;scenario-muted&quot;&gt;Financial status&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=ebitdaStatus%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;status-flow&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaDraftClass%&gt;&quot;&gt;Draft&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaSubmittedClass%&gt;&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaApprovedClass%&gt;&quot;&gt;Approved Final&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;status-step &lt;%=ebitdaLockedClass%&gt;&quot;&gt;Locked&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;decision-tile&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;scenario-muted&quot;&gt;Review Actions&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Scenario Financial Summary&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Drill to Consolidations&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Approved Final Budgets&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-16&quot;&gt;Final approval is performed in the Financial Consolidations workflow using Management Decision, Approver Action and Approval Remarks.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Sourcing_Landing
		{
					displayname = "Sourcing Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Sourcing_Landing_Snippet' elementName='Sourcing_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Sourcing_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Raw Material Budget User&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tmyRM = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status != &quot;Submitted to Sourcing Manager&quot; &amp;&amp; Status != &quot;Submitted to Finance&quot; &amp;&amp; Status != &quot;Approved&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tdraftRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Draft&quot;].count();\n\treturnedRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status.contains(&quot;Returned&quot;)].count();\n\treopenedRows = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Locked != true &amp;&amp; Status == &quot;Reopened&quot;].count();\n\totherWorking = myRM - draftRows - returnedRows - reopenedRows;\n\tif(otherWorking &lt; 0)\n\t{\n\t\totherWorking = 0;\n\t}\n\tsourcingApproval = Raw_Material_Budgets[Status == &quot;Submitted to Sourcing Manager&quot; &amp;&amp; Locked != true].count();\n\tfinanceApproval = Raw_Material_Budgets[Status == &quot;Submitted to Finance&quot; &amp;&amp; Locked != true].count();\n\tapproved = Raw_Material_Budgets[Status == &quot;Approved&quot; || Locked == true].count();\n\ttotalRM = Raw_Material_Budgets[ID != 0].count();\n\tmaterials = Raw_Materials[ID != 0].count();\n\tpendingTotal = myRM + sourcingApproval + financeApproval;\n\tapprovalPct = 0;\n\tpendingPct = 0;\n\tdraftPct = 0;\n\treturnedPct = 0;\n\treopenedPct = 0;\n\totherWorkingPct = 0;\n\tif(totalRM &gt; 0)\n\t{\n\t\tapprovalPct = (approved * 100) / totalRM;\n\t\tpendingPct = (pendingTotal * 100) / totalRM;\n\t}\n\tif(myRM &gt; 0)\n\t{\n\t\tdraftPct = (draftRows * 100) / myRM;\n\t\treturnedPct = (returnedRows * 100) / myRM;\n\t\treopenedPct = (reopenedRows * 100) / myRM;\n\t\totherWorkingPct = (otherWorking * 100) / myRM;\n\t}\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);--column-gap:0px;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%}.zcs-col-3{flex:0 0 calc(25% - var(--column-gap)*.75);max-width:calc(25% - var(--column-gap)*.75)}.zcs-col-6{flex:0 0 calc(50% - var(--column-gap)*.5);max-width:calc(50% - var(--column-gap)*.5)}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:#fff}.zcs-card{background-color:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:#fff;color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:#fff;box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color);vertical-align:middle}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-panel-wrapper ul li{list-style-type:none}.zcs-panel{border:1px solid var(--zcs_tertiary_border_color);box-shadow:0 2px 8px 0 #F2F2F6;background-color:#fff}.zcs-panel-icon-wrapper{width:40px;height:40px}.zcs-panel-icon{width:24px;height:24px;line-height:24px}.zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper{background-color:#E4FCF3;color:#179E6C}.zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper{background-color:#FCF4E6;color:#B8770D}.zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper{background-color:#EAF2FF;color:#1652BB}.zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper{background-color:#fdf5f3;color:#ff8b11}.zcs-panel-wrapper .zcs-overlay{top:0;left:0}.zcs-panel-wrapper li:hover .zcs-panel{border-color:var(--zcs_brand_color);background-image:linear-gradient(rgb(253 253 255 / 10%),#f7f9ff)}.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background-color:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.sl-shell{background:var(--zcs-page-bg-color);min-height:100%;font-family:inherit}.sl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#17324d);border:0;color:var(--zcs_brand_foreground_color);box-shadow:0 10px 28px rgba(0,0,0,.12)}.sl-hero .zcs-color-primary,.sl-hero .zcs-color-tertiary{color:var(--zcs_brand_foreground_color)}.sl-hero p{max-width:780px;opacity:.92}.sl-hero .zcs-primary-outline-button{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.55);color:var(--zcs_brand_foreground_color)}.sl-kpi-number{font-size:30px;line-height:1.05}.sl-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}.sl-action-count{margin-left:auto}.sl-mini-stat{border-top:1px solid var(--zcs_tertiary_border_color)}.sl-muted-card{background:#F9FAFE}.sl-report-link{color:var(--zcs_brand_color)}.sl-nowrap{white-space:nowrap}@media(max-width:992px){.zcs-col-md-6{flex:0 0 calc(50% - var(--column-gap)*.5);max-width:calc(50% - var(--column-gap)*.5)}.sl-grid{grid-template-columns:1fr}.sl-hero{align-items:flex-start;flex-direction:column}.sl-header-actions{flex-wrap:wrap}}@media(max-width:768px){.zcs-col-sm-6{flex:0 0 calc(50% - var(--column-gap)*.5);max-width:calc(50% - var(--column-gap)*.5)}.zcs-page-container-inner{padding:16px 20px}.zcs-panel-wrapper ul{gap:12px}}@media(max-width:576px){.zcs-col-xs-12{flex:0 0 100%;max-width:100%}.sl-kpi-number{font-size:24px}.sl-header-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page-container zcs-commonview zcs-wh-full sl-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card sl-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-p-24 zcs-rounded-2xl zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Sourcing raw-material budget desk&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Work only on draft, returned, reopened, and other editable budget rows; approved or locked budgets are separated from pending actions.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 sl-header-actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Add Raw Material Budget&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Update My Budgets&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-panel-wrapper&apos;&gt;\n\t\t\t&lt;ul class=&apos;zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=myRM%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;My active working rows&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=sourcingApproval%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Submitted to sourcing manager&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline business-safe&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=financeApproval%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Submitted to finance&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&apos;sl-kpi-number zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=approved%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Approved or locked rows&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a href=&apos;#Report:Approved_RM_Budgets?zc_LoadIn=dialog&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;sl-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pe