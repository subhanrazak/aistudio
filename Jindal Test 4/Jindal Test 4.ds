					sort by
					(
						Sales_Plan_No descending
					)
					options
					(
			 			display field = Status
			 			emptycolumn = "No Status"
						sort order  = custom
						record count  = enable
			 		)
				
		}

		default list All_Shutdown_Schedules
		{
		
