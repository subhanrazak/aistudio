8 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Master data coverage&lt;/h3&gt;&lt;span class=&apos;dl-muted&apos;&gt;&lt;%=masterDomainsReady%&gt; of &lt;%=masterDomains%&gt; domains have active records&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Domain&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Active / Total&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Safe navigation&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Financial years&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=financialYearActive%&gt; / &lt;%=financialYearTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=financialYearClass%&gt;&apos;&gt;&lt;%=financialYearStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Financial_Years?zc_LoadIn=dialog&apos;&gt;All Financial Years &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Plants&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=plantActive%&gt; / &lt;%=plantTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=plantClass%&gt;&apos;&gt;&lt;%=plantStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Plants?zc_LoadIn=dialog&apos;&gt;All Plants &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Production lines&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=lineActive%&gt; / &lt;%=lineTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=lineClass%&gt;&apos;&gt;&lt;%=lineStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Production_Lines?zc_LoadIn=dialog&apos;&gt;All Production Lines &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Grades&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=gradeActive%&gt; / &lt;%=gradeTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=gradeClass%&gt;&apos;&gt;&lt;%=gradeStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Market_Segments?zc_LoadIn=dialog&apos;&gt;All Grades &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Products&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=productActive%&gt; / &lt;%=productTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=productClass%&gt;&apos;&gt;&lt;%=productStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Steel_Grades?zc_LoadIn=dialog&apos;&gt;All Products &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Finish types&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=finishActive%&gt; / &lt;%=finishTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=finishClass%&gt;&apos;&gt;&lt;%=finishStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Finish_Types?zc_LoadIn=dialog&apos;&gt;All Finish Types &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Raw materials&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=rawMaterialActive%&gt; / &lt;%=rawMaterialTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=rawMaterialClass%&gt;&apos;&gt;&lt;%=rawMaterialStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Raw_Materials?zc_LoadIn=dialog&apos;&gt;All Raw Materials &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Consumables&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=consumableActive%&gt; / &lt;%=consumableTotal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 &lt;%=consumableClass%&gt;&apos;&gt;&lt;%=consumableStatus%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;dl-table-link&apos; href=&apos;#Report:All_Consumables?zc_LoadIn=dialog&apos;&gt;All Consumables &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-notes-wrapper zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-notes-text zcs-m-0 zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-notes-title zcs-font-medium zcs-color-tertiary&apos;&gt;Navigation note: &lt;/span&gt;Setup changes are intentionally routed to Creator forms and reports only. No direct report workflow buttons are exposed from this landing page.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;dl-insight-grid&apos;&gt;\n\t\t&lt;div class=&apos;dl-mini&apos;&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Delegation hygiene&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;Review &lt;a class=&apos;zcs-color-theme zcs-font-medium&apos; href=&apos;#Report:All_Approval_Delegations?zc_LoadIn=dialog&apos;&gt;All Approval Delegations&lt;/a&gt; before peak approval windows, then use the delegation form for controlled setup updates.&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;dl-mini&apos;&gt;&lt;strong class=&apos;zcs-color-primary&apos;&gt;Audit exception handling&lt;/strong&gt;&lt;div class=&apos;dl-muted&apos;&gt;Critical events should be investigated in &lt;a class=&apos;zcs-color-theme zcs-font-medium&apos; href=&apos;#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog&apos;&gt;All Approval Audit Logs&lt;/a&gt; with module, actor and action filters.&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Add_Update_User1 as "Add / Update User"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														info thisapp.permissions.assignUserInProfile(input.User_Email,input.Profile);
													info input.User_Email;
													info input.Profile;
									)
								}
							}
			
						
			}

			Delete_Users as "Delete Users"
			{
			
							type =  form
							form = Add_Users
			
							record event = on delete
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														thisapp.permissions.deleteUser(input.User_Email);
													info "deleted:" + input.User_Email;
									)
								}
							}
			
						
			}

			Disable_email as "Disable email"
			{
			
							type =  form
							form = Add_Users
			
							record event = on edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable User_Email;
													existingProfile = input.Profile;
													clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
													input.Profile = existingProfile;
									)
								}
							}
			
						
			}

			Populate_profiles_on_load as "Populate profiles on load"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
									)
								}
							}
			
						
			}

			Approval_Audit_Log_On_Load as "Approval Audit Log On Load"
			{
			
							type =  form
							form = Approval_Audit_Log
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Budget_Cycle;
													disable Module_Name;
													disable Related_Record_ID;
													disable Related_Record_Display;
													disable Action;
													disable From_Status;
													disable To_Status;
													disable Iteration_Number;
													disable Actor_Email;
													disable Acting_On_Behalf_Of;
													disable Action_On;
													disable Remarks;
									)
								}
							}
			
						
			}

			Approval_Audit_Log_Set_Action_On as "Approval Audit Log Set Action On"
			{
			
							type =  form
							form = Approval_Audit_Log
			
							record event = on add
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Action_On == null)
													{
														input.Action_On = zoho.currenttime;
													}
									)
								}
							}
			
						
			}

			Log_Approval_Delegation_Save as "Log Approval Delegation Save"
			{
			
							type =  form
							form = Approval_Delegations
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														latestAudit = Approval_Audit_Log[Module_Name == "Approval Delegation" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													previousActive = null;
													auditAction = "Created";
													if(latestAudit.count() > 0)
													{
														previousActive = latestAudit.To_Status;
														auditAction = "Updated";
														if(input.Active == false)
														{
															auditAction = "Deactivated";
														}
													}
													relatedDisplay = input.Delegator_Email + " -> " + input.Delegate_Email + " (" + input.Module_Name + ")";
													auditId = insert into Approval_Audit_Log
													[
														Module_Name="Approval Delegation"
														Related_Record_ID=input.ID
														Related_Record_Display=relatedDisplay
														Action=auditAction
														From_Status=previousActive
														To_Status=input.Active
														Actor_Email=zoho.loginuserid
														Action_On=zoho.currenttime
														Remarks=input.Reason
														Added_User=zoho.loginuser
													];
									)
								}
							}
			
						
			}

			Validate_Approval_Delegations as "Validate Approval Delegations"
			{
			
							type =  form
							form = Approval_Delegations
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Start_Date != null && input.End_Date != null && input.End_Date < input.Start_Date)
													{
														alert(End_Date,"End Date must be on or after Start Date.");
														cancel submit;
													}
													if(input.Delegator_Email != null && input.Delegate_Email != null && input.Delegator_Email == input.Delegate_Email)
													{
														alert(Delegate_Email,"Delegate Email must be different from Delegator Email.");
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_After_Save as "Budget Cycles After Save"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														fy_status = input.Status;
													if(input.Status == "Draft")
													{
														fy_status = "Draft";
													}
													financial_year_rec = Financial_Years[ID == input.Financial_Year];
													if(financial_year_rec.count() > 0)
													{
														financial_year_rec.Status=fy_status;
														if(input.Status == "Completed")
														{
															financial_year_rec.Status="Completed";
															financial_year_rec.Completion_Date=input.Completion_Date;
														}
													}
													latestAudit = Approval_Audit_Log[Module_Name == "Budget Cycles" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
													previousStatus = "";
													if(latestAudit.count() > 0)
													{
														previousStatus = latestAudit.To_Status;
													}
													if(previousStatus != input.Status)
													{
														auditAction = "Updated";
														if(previousStatus == "")
														{
															auditAction = "Created";
														}
														if(input.Status == "Completed")
														{
															auditAction = "Completed";
														}
														else if(input.Status == "Closed")
														{
															auditAction = "Locked";
														}
														else if(input.Status == "Revision Requested")
														{
															auditAction = "Revision Requested";
														}
														auditRecordId = insert into Approval_Audit_Log
														[
															Budget_Cycle=input.ID
															Module_Name="Budget Cycles"
															Related_Record_ID=input.ID
															Related_Record_Display=input.Cycle_Code
															Action=auditAction
															From_Status=previousStatus
															To_Status=input.Status
															Actor_Email=zoho.loginuserid
															Action_On=zoho.currenttime
															Remarks=input.Finance_Notes
															Added_User=zoho.loginuser
														];
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_On_Load as "Budget Cycles On Load"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														isFinance = thisapp.permissions.isUserInProfile("Finance_Costing");
													isAdmin = thisapp.permissions.isUserInProfile("System_Administrator");
													if(input.Owner_Email == null)
													{
														input.Owner_Email = zoho.loginuserid;
													}
													hide Flow_Status;
													hide Reopened_Modules;
													hide Owner_Email;
													disable Owner_Email;
													disable Sales_Approved;
													disable Operations_Approved;
													disable SCM_Approved;
													disable Finance_Completed;
													if(input.ID != null)
													{
														show Flow_Status;
														show Owner_Email;
													}
													if(input.Status == "Revision Requested")
													{
														show Reopened_Modules;
														enable Reopened_Modules;
													}
													if(!(isFinance || isAdmin))
													{
														disable Baseline_Locked;
														disable Approved_Scenario;
													}
													if(input.Status == "Completed" || input.Status == "Closed" || input.Baseline_Locked == true)
													{
														disable Status;
														disable Reopened_Modules;
														disable Baseline_Locked;
														disable Approved_Scenario;
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_Status_On_User_Input as "Budget Cycles Status On User Input"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on add or edit
			
							on user input of Status
							{
								actions 
								{
									custom deluge script
									(
														if(input.Status == "Revision Requested")
													{
														show Reopened_Modules;
														enable Reopened_Modules;
													}
													else
													{
														input.Reopened_Modules = null;
														hide Reopened_Modules;
														disable Reopened_Modules;
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_Validate_Add as "Budget Cycles Validate Add"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on add
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Cycle_Type == "Revision" && input.Parent_Cycle == null)
													{
														alert "Parent Cycle is required for revision cycles.";
														cancel submit;
													}
													if(input.Cycle_Type != "Revision")
													{
														active_cycle_count = Budget_Cycles[Financial_Year == input.Financial_Year && Status != "Completed" && Status != "Closed" && ID != input.ID].count();
														if(active_cycle_count > 0)
														{
															alert "Only one active non-closed budget cycle is allowed for a financial year unless this is a Revision cycle.";
															cancel submit;
														}
													}
													if(input.Status == "Revision Requested" && input.Reopened_Modules == null || input.Reopened_Modules.size() == 0)
													{
														alert "Select at least one reopened module when revision is requested.";
														cancel submit;
													}
													if(input.Status == "Completed")
													{
														input.Finance_Completed = true;
														if(input.Completion_Date == null)
														{
															input.Completion_Date = zoho.currentdate;
														}
													}
									)
								}
							}
			
						
			}

			Budget_Cycles_Validate_Edit as "Budget Cycles Validate Edit"
			{
			
							type =  form
							form = Budget_Cycles
			
							record event = on edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(old.Baseline_Locked == true && input.Status != "Completed" && input.Status != "Closed")
													{
														alert "This baseline is locked. Reopen through Finance before editing an active stage.";
														cancel submit;
													}
													if(input.Cycle_Type == "Revision" && input.Parent_Cycle == null)
													{
														alert "Parent Cycle is required for revision cycles.";
														cancel submit;
													}
													if(input.Cycle_Type != "Revision")
													{
														active_cycle_count = Budget_Cycles[Financial_Year == input.Financial_Year && Status != "Completed" && Status != "Closed" && ID != input.ID].count();
														if(active_cycle_count > 0)
														{
															alert "Only one active non-closed budget cycle is allowed for a financial year unless this is a Revision cycle.";
															cancel submit;
														}
													}
													if(input.Status == "Revision Requested" && input.Reopened_Modules == null || input.Reopened_Modules.size() == 0)
													{
														alert "Select at least one reopened module when revision is requested.";
														cancel submit;
													}
													if(input.Status == "Completed")
													{
														input.Finance_Completed = true;
														if(input.Completion_Date == null)
														{
															input.Completion_Date = zoho.currentdate;
														}
													}
									)
								}
							}
			
						
			}

