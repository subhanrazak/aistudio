ont-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Review sourcing approval queue&lt;/span&gt;&lt;span class=&apos;sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=sourcingApproval%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-safe&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Track finance handoff&lt;/span&gt;&lt;span class=&apos;sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=financeApproval%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Approved_RM_Budgets?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Approved RM Budgets insight&lt;/span&gt;&lt;span class=&apos;sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=approved%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-10 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:RM_Availability_For_SCM?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline business-gold&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;RM Availability For SCM insight&lt;/span&gt;&lt;span class=&apos;sl-action-count zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=materials%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Review insights&lt;/h5&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-theme-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;&lt;div class=&apos;zcs-toast-text&apos;&gt;&lt;p class=&apos;zcs-m-0&apos;&gt;Pending actions exclude rows where Status is Approved or Locked is true. Approval, return, and reopen actions must be performed through the record so remarks and approval data are captured.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&apos;&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;Pending workload across queues&lt;/span&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=pendingTotal%&gt; rows&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=pendingPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&apos;&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;Approved or locked coverage&lt;/span&gt;&lt;span class=&apos;zcs-color-tertiary&apos;&gt;&lt;%=approved%&gt; of &lt;%=totalRM%&gt;&lt;/span&gt;&lt;/p&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=approvalPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;div class=&apos;zcs-row zcs-gap-12 sl-mini-stat zcs-pt-16&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-col-6 zcs-col-xs-12 sl-muted-card zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Returned rows&lt;/span&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;&lt;%=returnedRows%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Need budget correction before resubmission.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-col-6 zcs-col-xs-12 sl-muted-card zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Finance handoff&lt;/span&gt;&lt;strong class=&apos;zcs-font-20 zcs-color-primary&apos;&gt;&lt;%=financeApproval%&gt;&lt;/strong&gt;&lt;p class=&apos;zcs-font-13 zcs-color-tertiary zcs-m-0&apos;&gt;Rows already moved out of sourcing review.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;My working rows by status&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-tertiary zcs-m-0&apos;&gt;Draft, returned, reopened, and other editable rows owned by you.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;a class=&apos;sl-report-link zcs-font-14 zcs-font-medium sl-nowrap&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;Open all budgets&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Bucket&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Rows&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Focus&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Link&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-8 zcs-box-border&apos; colspan=&apos;4&apos;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72 zcs-color-theme&apos;&gt;&lt;/i&gt;Draft&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=draftRows%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=draftPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-report-link&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;Update&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-4-restore zcs-color-theme&apos;&gt;&lt;/i&gt;Returned&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=returnedRows%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=returnedPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-report-link&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;Review remarks&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06 zcs-color-theme&apos;&gt;&lt;/i&gt;Reopened&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=reopenedRows%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=reopenedPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-report-link&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;Continue&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo zcs-color-theme&apos;&gt;&lt;/i&gt;Other working&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=otherWorking%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-tertiary&apos;&gt;&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=otherWorkingPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;sl-report-link&apos; href=&apos;#Report:All_Raw_Material_Budgets?zc_LoadIn=dialog&apos;&gt;Open&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page System_Admin_Landing
		{
					displayname = "System Admin Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='System_Admin_Landing_Snippet' elementName='System_Admin_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage System_Admin_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;System Administrator&quot;;\n\tactiveUsers = Add_Users[ID != 0].count();\n\tactiveDelegations = Approval_Delegations[Active == true].count();\n\tallDelegations = Approval_Delegations[ID != 0].count();\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Revision Requested&quot;,&quot;Revision Copy Created&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;,&quot;Cancelled&quot;}].count();\n\trecentCriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Revision Requested&quot;,&quot;Revision Copy Created&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;,&quot;Cancelled&quot;} &amp;&amp; Action_On &gt;= zoho.currenttime.subDay(7)].count();\n\topenSetupItems = Budget_Cycles[Status == &quot;Open&quot; || Status == &quot;In Planning&quot; || Status == &quot;Under Review&quot; || Status == &quot;Reopened&quot;].count() + Financial_Years[Status == &quot;Open&quot; || Status == &quot;Pending Sales&quot; || Status == &quot;Pending Operations&quot; || Status == &quot;Pending SCM&quot; || Status == &quot;Pending Finance&quot;].count();\n\tfinancialYearTotal = Financial_Years[ID != 0].count();\n\tfinancialYearActive = Financial_Years[Active == true].count();\n\tplantTotal = Plants[ID != 0].count();\n\tplantActive = Plants[Active == true].count();\n\tlineTotal = Production_Lines[ID != 0].count();\n\tlineActive = Production_Lines[Active == true].count();\n\tgradeTotal = Market_Segments[ID != 0].count();\n\tgradeActive = Market_Segments[Active == true].count();\n\tproductTotal = Steel_Grades[ID != 0].count();\n\tproductActive = Steel_Grades[Active == true].count();\n\tfinishTotal = Finish_Types[ID != 0].count();\n\tfinishActive = Finish_Types[Active == true].count();\n\trawMaterialTotal = Raw_Materials[ID != 0].count();\n\trawMaterialActive = Raw_Materials[Active == true].count();\n\tconsumableTotal = Consumables[ID != 0].count();\n\tconsumableActive = Consumables[Active == true].count();\n\tmasterDomains = 8;\n\tmasterDomainsReady = 0;\n\tif(financialYearActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tfinancialYearStatus = &quot;Ready&quot;;\n\t\tfinancialYearClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tfinancialYearStatus = &quot;Missing&quot;;\n\t\tfinancialYearClass = &quot;zcs-red&quot;;\n\t}\n\tif(plantActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tplantStatus = &quot;Ready&quot;;\n\t\tplantClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tplantStatus = &quot;Missing&quot;;\n\t\tplantClass = &quot;zcs-red&quot;;\n\t}\n\tif(lineActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tlineStatus = &quot;Ready&quot;;\n\t\tlineClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tlineStatus = &quot;Missing&quot;;\n\t\tlineClass = &quot;zcs-red&quot;;\n\t}\n\tif(gradeActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tgradeStatus = &quot;Ready&quot;;\n\t\tgradeClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tgradeStatus = &quot;Missing&quot;;\n\t\tgradeClass = &quot;zcs-red&quot;;\n\t}\n\tif(productActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tproductStatus = &quot;Ready&quot;;\n\t\tproductClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tproductStatus = &quot;Missing&quot;;\n\t\tproductClass = &quot;zcs-red&quot;;\n\t}\n\tif(finishActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tfinishStatus = &quot;Ready&quot;;\n\t\tfinishClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tfinishStatus = &quot;Missing&quot;;\n\t\tfinishClass = &quot;zcs-red&quot;;\n\t}\n\tif(rawMaterialActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\trawMaterialStatus = &quot;Ready&quot;;\n\t\trawMaterialClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\trawMaterialStatus = &quot;Missing&quot;;\n\t\trawMaterialClass = &quot;zcs-red&quot;;\n\t}\n\tif(consumableActive &gt; 0)\n\t{\n\t\tmasterDomainsReady = masterDomainsReady + 1;\n\t\tconsumableStatus = &quot;Ready&quot;;\n\t\tconsumableClass = &quot;zcs-green&quot;;\n\t}\n\telse\n\t{\n\t\tconsumableStatus = &quot;Missing&quot;;\n\t\tconsumableClass = &quot;zcs-red&quot;;\n\t}\n\tmasterCompleteness = 0;\n\tif(masterDomains &gt; 0)\n\t{\n\t\tmasterCompleteness = (masterDomainsReady * 100) / masterDomains;\n\t}\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#F3F3F4}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-no-shrink{flex-shrink:0}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px}a{text-decoration:none}.zcs-green{color:#179e6c}.zcs-red{color:#fe455d}.zcs-yellow{color:#b8770d}.zcs-blue{color:#09598e}.zcs-l_blue{color:#1094c5}\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-fw-button{width:100%}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.98)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-notes-text a:hover{text-decoration:underline}\n.dl-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;color:var(--zcs_primary_text_color);min-height:100%}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:18px;padding:24px;display:flex;justify-content:space-between;gap:18px;align-items:flex-start;box-shadow:0 12px 30px rgba(20,37,63,.12)}.dl-hero h2{margin:0 0 8px;font-size:26px;line-height:1.2}.dl-hero p{margin:0;opacity:.92;max-width:780px}.dl-hero a{color:var(--zcs_brand_foreground_color);border-color:rgba(255,255,255,.55)}.dl-hero-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end}.dl-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:16px}.dl-kpi{text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:12px;min-height:172px;transition:border-color .15s ease,transform .15s ease}.dl-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.dl-kpi-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.dl-kpi-icon{width:38px;height:38px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:20px;flex-shrink:0}.dl-kpi-value{font-size:32px;font-weight:700;line-height:1.05;color:var(--zcs_primary_text_color)}.dl-kpi-note{color:var(--zcs_secondary_text_color);font-size:13px;line-height:1.45}.dl-command-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.dl-layout{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.35fr);gap:16px;margin-top:16px}.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:16px;padding:18px;box-sizing:border-box}.dl-panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-top:10px;text-decoration:none;color:inherit;background:#fff}.dl-action:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.dl-action-main{display:flex;gap:10px;align-items:flex-start}.dl-action-icon{color:var(--zcs_brand_color);font-size:18px;margin-top:2px}.dl-count{font-size:18px;font-weight:700;color:var(--zcs_brand_color)}.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px;line-height:1.45}.dl-table-link{display:inline-flex;align-items:center;gap:6px;color:var(--zcs_brand_color);font-weight:600}.dl-insight-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.dl-mini{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:14px}.dl-mini strong{display:block;margin-bottom:6px}@media(max-width:1180px){.dl-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.dl-layout{grid-template-columns:1fr}}@media(max-width:760px){.dl-shell{padding:14px}.dl-hero{flex-direction:column}.dl-hero-actions{justify-content:flex-start}.dl-kpi-grid,.dl-insight-grid{grid-template-columns:1fr}.dl-command-row .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;dl-shell&apos;&gt;\n\t&lt;div class=&apos;dl-hero&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;zcs-mt-12&apos;&gt;System Admin Command Center&lt;/h2&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Monitor users, master-data readiness, approval delegations and audit exceptions through safe setup navigation.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;dl-hero-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Users&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline users-contacts&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Users&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-search&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Audit logs&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;dl-kpi-grid&apos;&gt;\n\t\t&lt;a class=&apos;zcs-card dl-kpi zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Users&apos;&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-top&apos;&gt;&lt;span class=&apos;dl-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Roster&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;dl-kpi-value&apos;&gt;&lt;%=activeUsers%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Active users&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-note&apos;&gt;Configured application users. Add or verify users through the Users report or form.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;zcs-card dl-kpi zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Plants?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-top&apos;&gt;&lt;span class=&apos;dl-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-books&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=masterDomainsReady%&gt;/&lt;%=masterDomains%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;dl-kpi-value&apos;&gt;&lt;%=masterCompleteness%&gt;%&lt;/div&gt;&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Master data completeness&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=masterCompleteness%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;zcs-card dl-kpi zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Approval_Delegations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-top&apos;&gt;&lt;span class=&apos;dl-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline users-network&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=allDelegations%&gt; total&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;dl-kpi-value&apos;&gt;&lt;%=activeDelegations%&gt;&lt;/div&gt;&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Active delegations&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-note&apos;&gt;Review active delegator and delegate coverage before approval cycles progress.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;zcs-card dl-kpi zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Approval_Audit_Logs?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;dl-kpi-top&apos;&gt;&lt;span class=&apos;dl-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline files-search&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zc