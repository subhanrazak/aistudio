		{
					displayname = "Audit Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Audit_Landing_Snippet' elementName='Audit_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Audit_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Auditor&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Reopened&quot;,&quot;Revision Requested&quot;,&quot;Revision Copy Created&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;,&quot;Cancelled&quot;,&quot;Deleted&quot;}].count();\n\treturned = Approval_Audit_Log[Action == &quot;Returned&quot;].count();\n\treopened = Approval_Audit_Log[Action == &quot;Reopened&quot;].count();\n\treturnedReopened = returned + reopened;\n\trevisionRequested = Approval_Audit_Log[Action == &quot;Revision Requested&quot;].count();\n\tcancelledDeleted = Approval_Audit_Log[Action == &quot;Cancelled&quot; || Action == &quot;Deleted&quot;].count();\n\tcriticalQueue = returnedReopened + revisionRequested + cancelledDeleted;\n\tlockedFinalEvents = Approval_Audit_Log[Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot;].count();\n\tcompletedHistory = Approval_Audit_Log[Action == &quot;Completed&quot;].count();\n\tfinalHistory = Approval_Audit_Log[Action == &quot;Final Approved&quot;].count();\n\tauditHistoryCount = completedHistory + finalHistory;\n\tdelegationFlags = Approval_Delegations[Active == true].count();\n\tactiveDelegations = Approval_Delegations[Active == true &amp;&amp; Start_Date &lt;= zoho.currentdate &amp;&amp; End_Date &gt;= zoho.currentdate].count();\n\tdelegationDateExceptions = delegationFlags - activeDelegations;\n\tdelegatedEvents = Approval_Audit_Log[Action == &quot;Delegated&quot;].count();\n\tlockedBaselines = Budget_Cycles[Baseline_Locked == true || Approved_Scenario == true || Status == &quot;Closed&quot;].count();\n\tapprovedSales = Sales_Plans[Status == &quot;Sales Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tsalesApprovedOnly = Sales_Plans[Status == &quot;Sales Approved&quot;].count();\n\tsalesLockedOnly = Sales_Plans[Status == &quot;Locked&quot; || Locked == true].count();\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%}.zcs-no-shrink{flex-shrink:0}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-0{padding:0}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-w-full{width:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-heading{line-height:1.25}.zcs-lh-body{line-height:1.5}.zcs-uppercase{text-transform:uppercase}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-button{width:auto;min-width:5rem;min-height:36px;text-decoration:none}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#a06309}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-red{color:#fe455d}.audit-shell{background:var(--zcs-page-bg-color);padding:20px;color:var(--zcs-primary-text-color);min-height:100%}.audit-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--zcs_brand_color),#17324c);border:0;color:var(--zcs_brand_foreground_color);padding:24px;gap:18px}.audit-hero:after{content:&quot;&quot;;position:absolute;right:-80px;top:-90px;width:250px;height:250px;border:34px solid rgba(255,255,255,.10);border-radius:50%}.audit-hero-main{position:relative;z-index:1;max-width:760px}.audit-hero h2{font-size:26px;line-height:1.2;margin:0 0 8px}.audit-hero p{margin:0;opacity:.92}.audit-hero-meta{position:relative;z-index:1;align-items:flex-end}.audit-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.audit-kpi{padding:18px;text-decoration:none;color:inherit;transition:border-color .18s ease,transform .18s ease}.audit-kpi:hover,.audit-action-card:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px)}.audit-kpi strong{display:block;font-size:32px;line-height:1;margin-top:14px;margin-bottom:8px;color:var(--zcs-primary-text-color)}.audit-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px}.audit-icon-theme{background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.audit-icon-red{background:#FDE3E6;color:#FE455D}.audit-icon-green{background:#E4FCF3;color:#179E6C}.audit-icon-blue{background:#E8EFFF;color:#2A6FFC}.audit-icon-yellow{background:#FCF4E6;color:#a06309}.audit-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.audit-panel{overflow:hidden}.audit-panel-body{padding:18px}.audit-section-title{margin:0}.audit-action-list{display:grid;gap:12px;margin-top:14px}.audit-action-card{padding:14px;text-decoration:none;color:inherit}.audit-action-count{font-size:24px;font-weight:700;color:var(--zcs_brand_color);line-height:1}.audit-note{border-left:3px solid var(--zcs_brand_color);background:var(--zcs_component_hover_color);padding:12px;border-radius:8px;margin-top:12px}.audit-note-warning{border-left-color:#FAAE13;background:#FCF4E6}.audit-note-clear{border-left-color:#179E6C;background:#E4FCF3}.audit-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px}.audit-mini{background:#F9FAFE;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px}.audit-mini strong{display:block;font-size:20px;margin-top:4px}.audit-foot-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.audit-muted{color:var(--zcs-secondary-text-color)}.audit-rule{height:1px;background:var(--zcs_tertiary_border_color);margin:16px 0}@media(max-width:1100px){.audit-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.audit-layout{grid-template-columns:1fr}}@media(max-width:680px){.audit-shell{padding:12px}.audit-kpi-grid,.audit-mini-grid{grid-template-columns:1fr}.audit-hero,.audit-hero-meta{align-items:flex-start}.audit-hero{flex-direction:column}.audit-action-card{align-items:flex-start}.audit-action-count{margin-left:52px}}\n&lt;/style&gt;\n&lt;div class=&apos;audit-shell zcs-box-border&apos;&gt;\n\t&lt;div class=&apos;audit-hero zcs-card zcs-flex zcs-justify-space-between zcs-align-items-center zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;audit-hero-main&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline files-book-07&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-medium zcs-lh-body&apos;&gt;Audit governance landing&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;zcs-font-bold&apos;&gt;Governance insight, queues and delegation checks&lt;/h2&gt;\n\t\t\t&lt;p class=&apos;zcs-font-15 zcs-lh-body&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Critical queues below exclude normal Completed records from pending action counts; final/completed records are retained as audit history.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;audit-hero-meta zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approvedSales%&gt; final sales plans&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;audit-kpi-grid&apos;&gt;\n\t\t&lt;a class=&apos;audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border&apos; href=&apos;#Report:Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-red&apos;&gt;&lt;i class=&apos;zc-li-outline files-exclamation&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal&apos;&gt;Audit significant&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;strong&gt;&lt;%=criticalEvents%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Critical audit events&lt;/span&gt;\n\t\t\t&lt;p class=&apos;zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8&apos;&gt;Returned, reopened, revision, lock/final and cancellation signals. Normal Completed records are not counted here.&lt;/p&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border&apos; href=&apos;#Report:Active_Delegations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-blue&apos;&gt;&lt;i class=&apos;zc-li-outline users-network&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal&apos;&gt;Date valid&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;strong&gt;&lt;%=activeDelegations%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Active delegations&lt;/span&gt;\n\t\t\t&lt;p class=&apos;zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8&apos;&gt;&lt;%=delegationFlags%&gt; records are flagged Active; &lt;%=delegationDateExceptions%&gt; need start/end-date verification.&lt;/p&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border&apos; href=&apos;#Report:Audit_By_Cycle?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-green&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal&apos;&gt;Baseline&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;strong&gt;&lt;%=lockedBaselines%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Locked baselines&lt;/span&gt;\n\t\t\t&lt;p class=&apos;zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8&apos;&gt;Budget cycles with Baseline Locked, Approved Scenario or Closed status.&lt;/p&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;audit-kpi zcs-card zcs-flex zcs-direction-column zcs-box-border&apos; href=&apos;#Report:Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal&apos;&gt;Follow-up&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;strong&gt;&lt;%=returnedReopened%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Returned / reopened&lt;/span&gt;\n\t\t\t&lt;p class=&apos;zcs-font-13 zcs-lh-body audit-muted zcs-m-0 zcs-mt-8&apos;&gt;&lt;%=returned%&gt; returned and &lt;%=reopened%&gt; reopened events requiring audit attention.&lt;/p&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;audit-layout&apos;&gt;\n\t\t&lt;div class=&apos;audit-panel zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;h3 class=&apos;audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Audit queues and delegation checks&lt;/h3&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal&apos;&gt;Action view&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;audit-panel-body&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-action-list&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border&apos; href=&apos;#Report:Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-red zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline files-exclamation&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;Critical event queue&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 audit-muted&apos;&gt;Counts only returned, reopened, revision requested, cancelled or deleted events as follow-up. Lock/final/completed records remain history.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;audit-action-count&apos;&gt;&lt;%=criticalQueue%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border&apos; href=&apos;#Report:Active_Delegations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-blue zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline users-network&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;Active delegation coverage&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 audit-muted&apos;&gt;Validate current delegate coverage and date-window exceptions before relying on delegated approvals.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;audit-action-count&apos;&gt;&lt;%=activeDelegations%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;audit-action-card zcs-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-box-border&apos; href=&apos;#Report:Audit_By_Cycle?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;audit-icon audit-icon-green zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;Audit by cycle&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 audit-muted&apos;&gt;Use cycle history for evidence review across locked baselines, final approvals and completed audit records.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;audit-action-count&apos;&gt;View&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;audit-foot-actions&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Approval_Delegations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline users-multiple-11&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;All delegations&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Approved_Sales_Plans?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-chart-growth&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Approved sales&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;audit-panel zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h3 class=&apos;audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Governance insight&lt;/h3&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;audit-panel-body&apos;&gt;\n\t\t\t\t&lt;div class=&apos;audit-mini-grid&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;audit-mini&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 audit-muted&apos;&gt;Approved sales plans&lt;/span&gt;\n\t\t\t\t\t\t&lt;strong class=&apos;zcs-color-primary&apos;&gt;&lt;%=approvedSales%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 audit-muted&apos;&gt;Status Sales Approved or Locked, or Locked is true.&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;audit-mini&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 audit-muted&apos;&gt;History events&lt;/span&gt;\n\t\t\t\t\t\t&lt;strong class=&apos;zcs-color-primary&apos;&gt;&lt;%=auditHistoryCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 audit-muted&apos;&gt;Completed and Final Approved shown as evidence, not pending.&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;audit-mini&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 audit-muted&apos;&gt;Delegated events&lt;/span&gt;\n\t\t\t\t\t\t&lt;strong class=&apos;zcs-color-primary&apos;&gt;&lt;%=delegatedEvents%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 audit-muted&apos;&gt;Audit log entries where approvals were delegated.&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;audit-mini&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 audit-muted&apos;&gt;Locked sales plans&lt;/span&gt;\n\t\t\t\t\t\t&lt;strong class=&apos;zcs-color-primary&apos;&gt;&lt;%=salesLockedOnly%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-font-12 audit-muted&apos;&gt;&lt;%=salesApprovedOnly%&gt; are Sales Approved before lock.&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(delegationDateExceptions &gt; 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;audit-note audit-note-warning&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Delegation date check needed&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-13 audit-muted&apos;&gt;&lt;%=delegationDateExceptions%&gt; active-flag delegation records are outside the current date window. Review before treating them as valid delegation coverage.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;audit-note audit-note-clear&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Delegation window clear&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-13 audit-muted&apos;&gt;All active-flag delegation records currently fall within their start and end dates.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;audit-panel zcs-card zcs-mt-16&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card-header zcs-px-20 zcs-py-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;h3 class=&apos;audit-section-title zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Event treatment guide&lt;/h3&gt;\n\t\t\t&lt;span class=&apos;zcs-font-13 audit-muted&apos;&gt;Prevents closed evidence from inflating action queues&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;audit-panel-body&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Event group&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Treatment&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Governance note&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-0&apos; colspan=&apos;4&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Returned / Reopened&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-yellow&apos;&gt;&lt;%=returnedReopened%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;Pending follow-up&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Requires owner review and audit explanation.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Revision / Cancellation / Delete&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-red&apos;&gt;&lt;%=revisionRequested + cancelledDeleted%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&apos;&gt;Critical event queue&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Signals change-control risk or governance exception.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Locked / Final approved&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-green&apos;&gt;&lt;%=lockedFinalEvents%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;Audit evidence&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Shows baseline commitment and final approval history.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Completed&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-blue&apos;&gt;&lt;%=completedHistory%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;History only&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Normal completion is not a pending action unless paired with another audit-significant event.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page COE_Landing
		{
					displayname = "COE Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='COE_Landing_Snippet' elementName='COE_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage COE_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;COE Team&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tactiveBudgetCycles = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true].count();\n\tbudgetCycleRevisions = Budget_Cycles[Status == &quot;Revision Requested&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Baseline_Locked != true].count();\n\tclosedBudgetCycles = Budget_Cycles[Status == &quot;Completed&quot; || Status == &quot;Closed&quot; || Baseline_Locked == true || Approved_Scenario == true].count();\n\tcapacityPending = Capacity_TEP_Plans[Status == &quot;Draft&quot; || Status == &quot;Submitted to Operations Approval&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Operations Approved&quot; &amp;&amp; Status != &quot;Superseded&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tcapacitySubmitted = Capacity_TEP_Plans[Status == &quot;Submitted to Operations Approval&quot; &amp;&amp; Locked != true].count();\n\tcapacityExceptions = Capacity_TEP_Plans[Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tcapacityFinal = Capacity_TEP_Plans[Status == &quot;Operations Approved&quot; || Status == &quot;Superseded&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tproductionPending = Operations_Production_Plans[Status == &quot;Draft&quot; || Status == &quot;Submitted to Operations Approval&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Operations Approved&quot; &amp;&amp; Status != &quot;Superseded&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tproductionSubmitted = Operations_Production_Plans[Status == &quot;Submitted to Operations Approval&quot; &amp;&amp; Locked != true].count();\n\tproductionExceptions = Operations_Production_Plans[Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tproductionFinal = Operations_Production_Plans[Status == &quot;Operations Approved&quot; || Status == &quot;Superseded&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tcapProdSubmissions = capacityPending + productionPending;\n\tconsolidationPending = Volume_Consolidations[Status == &quot;Waiting for Sales and Operations Approval&quot; || Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; || Status == &quot;Submitted to Finance&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;SCM Approved&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tconsolidationExceptions = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; || SCM_Decision == &quot;Request Sales Revision&quot; || SCM_Decision == &quot;Request Operations Revision&quot; || SCM_Decision == &quot;Request Sales and Operations Revision&quot; &amp;&amp; Status != &quot;SCM Approved&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tfinancialReview = Financial_Consolidations[Status == &quot;Draft&quot; || Status == &quot;Submitted to Management&quot; || Status == &quot;Returned by Management&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tfinancialExceptions = Financial_Consolidations[Status == &quot;Returned by Management&quot; || Management_Decision == &quot;Rejected&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tconsolidationReviewItems = consolidationPending + financialReview;\n\tfinalConsolidations = Volume_Consolidations[Status == &quot;SCM Approved&quot; || Status == &quot;Locked&quot; || Locked == true].count() + Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\topenReplans = Replanning_Requests[Status == &quot;Draft&quot; || Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;In Team Revision&quot; || Status == &quot;Resubmitted to SCM&quot; &amp;&amp; Status != &quot;Revision Created&quot; &amp;&amp; Status != &quot;Rejected&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\treplanApprovals = Replanning_Requests[Status == &quot;Submitted to Finance&quot;].count();\n\treplanInTeam = Replanning_Requests[Status == &quot;In Team Revision&quot; || Status == &quot;Resubmitted to SCM&quot;].count();\n\tclosedReplans = Replanning_Requests[Status == &quot;Revision Created&quot; || Status == &quot;Rejected&quot; || Status == &quot;Locked&quot;].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\ttotalOpenWork = activeBudgetCycles + capProdSubmissions + consolidationReviewItems + openReplans;\n\ttotalExceptions = budgetCycleRevisions + capacityExceptions + productionExceptions + consolidationExceptions + financialExceptions;\n\tapprovalQueue = capacitySubmitted + productionSubmitted + replanApprovals + financialReview;\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-col-3{flex:0 0 calc(25% - 12px);max-width:calc(25% - 12px)}.zcs-col-4{flex:0 0 calc(33.333% - 11px);max-width:calc(33.333% - 11px)}.zcs-col-5{flex:0 0 calc(41.666% - 10px);max-width:calc(41.666% - 10px)}.zcs-col-7{flex:0 0 calc(58.333% - 8px);max-width:calc(58.333% - 8px)}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-w-full{width:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}.zc-pb-page-content-wrapper div#zppagesLive,.zc-pb-page-content-wrapper div#elementsContainer,.zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zcpage-elemContainer{height:100%}.zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,.zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,.zc-pb-page-content-wrapper .zc-pb-tile-container{padding:0}#splash-screen{display:none!important}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:rgba(255,255,255,.15);border-color:rgba(255,255,255,.42);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#D91E36}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9B6400}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#F1F2F4;border-color:#D7DCE2;color:#525967}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#FE455D}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.coe-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;min-height:100%;color:var(--zcs-primary-text-color)}.coe-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color,#1c3d5a));border:0;border-radius:16px;box-shadow:0 14px 28px rgba(20,29,51,.12);overflow:hidden;position:relative}.coe-hero:after{content:&quot;&quot;;position:absolute;right:-58px;top:-78px;width:224px;height:224px;border:36px solid rgba(255,255,255,.12);border-radius:50%;pointer-events:none}.coe-eyebrow{letter-spacing:.08em;color:var(--zcs_brand_foreground_color);opacity:.78}.coe-hero-title{color:var(--zcs_brand_foreground_color);font-size:28px}.coe-hero-copy{max-width:820px;color:var(--zcs_brand_foreground_color);opacity:.9}.coe-hero .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.coe-kpi-grid,.coe-content{margin-top:16px}.coe-kpi{min-height:158px;color:inherit;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.coe-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 10px 22px rgba(20,29,51,.08)}.coe-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.coe-kpi-value{font-size:34px;line-height:1;color:var(--zcs-primary-text-color)}.coe-kpi-note{min-height:40px}.coe-panel{min-height:100%}.coe-action-list,.coe-insight-list{list-style:none}.coe-action-card{border-radius:12px;transition:border-color .15s ease,background-color .15s ease}.coe-action-card.is-exception{border-color:#FE455D;background:#FDE3E6}.coe-action-card.is-approval{background:linear-gradient(0deg,var(--zcs_component_hover_color),var(--zcs-white-color))}.coe-action-card:hover{border-color:var(--zcs_brand_color)}.coe-action-link{color:inherit;width:100%}.coe-action-title{display:block;color:var(--zcs-primary-text-color)}.coe-action-meta{display:block;color:var(--zcs-secondary-text-color);margin-top:2px}.coe-action-count{min-width:54px;text-align:center;border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:6px 10px}.coe-action-card.is-exception .coe-action-count{background:#fff;color:#D91E36}.coe-arrow{color:var(--zcs-teritiary-text-color)}.coe-table-link,.coe-insight-link,.coe-footer-links a{color:var(--zcs_brand_color);font-weight:600}.coe-insight-item{border-top:1px solid var(--zcs-border-color)}.coe-insight-item:first-child{border-top:0}.coe-insight-icon-green{color:#179e6c}.coe-insight-icon-blue{color:#2a6ffc}.coe-insight-icon-yellow{color:#9B6400}.coe-insight-icon-red{color:#D91E36}.coe-footer-links{border-top:1px solid var(--zcs-border-color);margin-top:14px;padding-top:14px}@media(max-width:992px){.zcs-col-md-12{flex:0 0 100%;max-width:100%}.coe-hero{align-items:flex-start;flex-direction:column}.coe-hero-actions{width:100%;justify-content:flex-start}.zcs-col-3,.zcs-col-4,.zcs-col-5,.zcs-col-7{flex:0 0 100%;max-width:100%}}@media(max-width:576px){.coe-shell{padding:12px}.coe-hero{padding:18px}.coe-hero-actions{flex-direction:column;align-items:stretch}.coe-hero-actions .zcs-button{width:100%}.coe-kpi-value{font-size:30px}.coe-action-link{align-items:flex-start}.coe-action-count{min-width:40px}.zcs-table-wrapper table{min-width:760px}}\n&lt;/style&gt;\n&lt;div class=&apos;coe-shell&apos;&gt;\n\t&lt;div class=&apos;coe-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common&apos;&gt;\n\t\t\t&lt;div class=&apos;coe-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase&apos;&gt;Central planning command centre&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;coe-hero-title zcs-font-bold zcs-lh-heading zcs-m-0&apos;&gt;COE Landing&lt;/h2&gt;\n\t\t\t&lt;p class=&apos;coe-hero-copy zcs-font-14 zcs-lh-body zcs-m-0&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Prioritise unresolved exceptions, approval queues, consolidation review, and replanning work instead of browsing historical records.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;coe-hero-actions zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Compare Scenarios&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;span class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; style=&apos;opacity:.7;cursor:not-allowed;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;No Active Cycle&lt;/span&gt;\n\t\t\t&lt;/span&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-signature&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Financial Summary&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-refresh&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Raise Replan&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;coe-kpi-grid zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;a class=&apos;coe-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Active_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-check&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Active&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Active budget cycles&lt;/div&gt;&lt;strong class=&apos;coe-kpi-value zcs-font-bold&apos;&gt;&lt;%=activeBudgetCycles%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Open cycle states only; completed, closed, baseline locked and approved scenarios stay out.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;coe-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Capacity_Status_Board?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Submissions&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Capacity and production&lt;/div&gt;&lt;strong class=&apos;coe-kpi-value zcs-font-bold&apos;&gt;&lt;%=capProdSubmissions%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=capacityPending%&gt; capacity and &lt;%=productionPending%&gt; production rows need planning visibility.&lt;/div&gt;\n\t\t&lt;/a&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;coe-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Compare&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Scenario comparison&lt;/div&gt;&lt;strong class=&apos;coe-kpi-value zcs-font-bold&apos;&gt;&lt;%=financialReview%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Compare &lt;%=scenarioCycleName%&gt; financial scenarios before management decisions.&lt;/div&gt;\n\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;coe-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; style=&apos;opacity:.72;&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Empty&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Scenario comparison&lt;/div&gt;&lt;strong class=&apos;coe-kpi-value zcs-font-bold&apos;&gt;0&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;No active/open Budget Cycle is available for scenario comparison.&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;coe-kpi zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-refresh&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;i class=&apos;zc-li-outline business-strategy&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Replan&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Open replanning&lt;/div&gt;&lt;strong class=&apos;coe-kpi-value zcs-font-bold&apos;&gt;&lt;%=openReplans%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=replanApprovals%&gt; finance approvals and &lt;%=replanInTeam%&gt; team revision items are active.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;coe-content zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;coe-panel zcs-card zcs-col-7 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pending actions&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Open the relevant report or form in dialog. Counts exclude completed, locked, superseded, approved final, and closed states.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=totalOpenWork%&gt; open&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;coe-action-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;coe-action-card is-exception zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;coe-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Consolidation_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;coe-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Resolve consolidation exceptions&lt;/strong&gt;&lt;span class=&apos;coe-action-meta zcs-font-13&apos;&gt;Revision requested, sales revision pending, operations revision pending, or both revision pending statuses.&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;coe-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=consolidationExceptions%&gt;&lt;/span&gt;&lt;i class=&apos;coe-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-action-card is-approval zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;coe-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Capacity_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-board-28&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;coe-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Capacity approval queue&lt;/strong&gt;&lt;span class=&apos;coe-action-meta zcs-font-13&apos;&gt;Draft, submitted, returned, revised draft, and SCM revision-requested capacity plans only.&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;coe-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=capacityPending%&gt;&lt;/span&gt;&lt;i class=&apos;coe-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-action-card is-approval zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;coe-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Operations_Production_Status_Board?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;coe-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Production approval queue&lt;/strong&gt;&lt;span class=&apos;coe-action-meta zcs-font-13&apos;&gt;Operations production rows not approved, superseded, locked, or final.&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;coe-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=productionPending%&gt;&lt;/span&gt;&lt;i class=&apos;coe-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;coe-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;coe-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Management financial review&lt;/strong&gt;&lt;span class=&apos;coe-action-meta zcs-font-13&apos;&gt;Submitted to management, returned by management, and reopened finance consolidation rows. Opens Scenario Financial Summary for decisions.&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;coe-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=financialReview%&gt;&lt;/span&gt;&lt;i class=&apos;coe-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;coe-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;coe-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-refresh&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;coe-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Replanning queue&lt;/strong&gt;&lt;span class=&apos;coe-action-meta zcs-font-13&apos;&gt;Finance submitted, finance approved, in-team revision, and resubmitted-to-SCM requests.&lt;/span&gt;&lt;/span&gt;&lt;span class=&apos;coe-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=openReplans%&gt;&lt;/span&gt;&lt;i class=&apos;coe-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;coe-panel zcs-card zcs-col-5 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Exception watch&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Exceptions and pending approvals are elevated here; final records are kept as insight metrics below.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Queue&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Focus&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;a class=&apos;coe-table-link&apos; href=&apos;#Report:Active_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;Budget revision cycle&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-red&apos;&gt;&lt;%=budgetCycleRevisions%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Revision requested&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;a class=&apos;coe-table-link&apos; href=&apos;#Report:Capacity_Status_Board?zc_LoadIn=dialog&apos;&gt;Capacity exceptions&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-yellow&apos;&gt;&lt;%=capacityExceptions%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Returned or SCM revision&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;a class=&apos;coe-table-link&apos; href=&apos;#Report:Operations_Production_Status_Board?zc_LoadIn=dialog&apos;&gt;Production exceptions&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-yellow&apos;&gt;&lt;%=productionExceptions%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Returned or revised draft&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;a class=&apos;coe-table-link&apos; href=&apos;#Report:Consolidation_Status_Board?zc_LoadIn=dialog&apos;&gt;Consolidation exceptions&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-red&apos;&gt;&lt;%=consolidationExceptions%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Sales or operations revision&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;a class=&apos;coe-table-link&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;Replanning approvals&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-blue&apos;&gt;&lt;%=replanApprovals%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Submitted to finance&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;coe-footer-links zcs-flex zcs-gap-12 zcs-row zcs-font-13&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Budget_Cycles?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-13&apos;&gt;&lt;/i&gt;Budget cycle form&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Capacity_TEP_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-board-28&apos;&gt;&lt;/i&gt;Capacity form&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Operations_Production_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-factory&apos;&gt;&lt;/i&gt;Production form&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Volume_Consolidations?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-connect&apos;&gt;&lt;/i&gt;Consolidation form&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;coe-content zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;coe-panel zcs-card zcs-col-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Insight metrics&lt;/h3&gt;&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Completed, locked, approved final, and closed statuses are intentionally shown only as insight totals.&lt;/p&gt;&lt;/div&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-alert&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=totalExceptions%&gt; exceptions&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;coe-insight-list zcs-row zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;coe-insight-item zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Approval pressure&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;&lt;i class=&apos;coe-insight-icon-yellow zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=approvalQueue%&gt; submitted, management, or finance items are awaiting approval action.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-insight-item zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Locked capacity and production&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;&lt;i class=&apos;coe-insight-icon-green zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=capacityFinal + productionFinal%&gt; capacity or production rows are approved, superseded, or locked.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-insight-item zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Finalised consolidation base&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;&lt;i class=&apos;coe-insight-icon-blue zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=finalConsolidations%&gt; SCM or financial consolidation records are approved final, completed, or locked.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;coe-insight-item zcs-card zcs-col-3 zcs-col-md-12 zcs-flex zcs-direction-column zcs-gap-8 zcs-p-16 zcs-box-border&apos;&gt;&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Closed cycle and replan history&lt;/label&gt;&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;&lt;i class=&apos;coe-insight-icon-green zc-li-outline files-locked&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=closedBudgetCycles%&gt; budget cycles and &lt;%=closedReplans%&gt; replanning requests are closed, rejected, revision created, or locked.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&apos;coe-footer-links zcs-flex zcs-gap-12 zcs-row zcs-font-13&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-folder-13&apos;&gt;&lt;/i&gt;All budget cycles&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Capacity_TEP_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-chart-bar&apos;&gt;&lt;/i&gt;Capacity history&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Operations_Production_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-chart-pie&apos;&gt;&lt;/i&gt;Production history&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Volume_Consolidations?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-connect&apos;&gt;&lt;/i&gt;Volume history&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Report:All_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline files-refresh&apos;&gt;&lt;/i&gt;Replanning history&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Executive_Budget_Dashboard
		{
					displayname = "Executive Budget Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Executive_KPI_Cards' elementName='Executive_KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage Executive_KPI_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tactiveCycleCount = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot;].count();\n\tcompletedCycleCount = Budget_Cycles[Status == &quot;Completed&quot; || Status == &quot;Closed&quot; || Status == &quot;Locked&quot; || Status == &quot;Approved Final&quot;].count();\n\tapprovedSalesCount = Sales_Plans[Status == &quot;Sales Approved&quot; || Locked == true].count();\n\tapprovedOpsAvailability = Capacity_TEP_Plans[Status == &quot;Operations Approved&quot; || Locked == true].count();\n\tapprovedOpsProduction = Operations_Production_Plans[Status == &quot;Operations Approved&quot; || Locked == true].count();\n\tscmReadyCount = Volume_Consolidations[Status == &quot;Under SCM Review&quot; || Status == &quot;SCM Approved&quot; || Status == &quot;Submitted to Finance&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tfinanceDecisionCount = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinanceCompletedCount = Financial_Consolidations[Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Status == &quot;Approved Final&quot; || Locked == true].count();\n\tcriticalEvents = Approval_Audit_Log[Action == &quot;Revision Requested&quot; || Action == &quot;Revision Copy Created&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\t%&gt;\n&lt;style&gt;\n.ebd-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:16px}.ebd-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:16px;color:inherit;text-decoration:none}.ebd-card-link:hover{border-color:var(--zcs_brand_color);box-shadow:0 8px 18px rgba(20,29,51,.08)}.ebd-card-disabled{opacity:.72}.ebd-label{font-size:12px;color:var(--zcs_secondary_text_color);text-transform:uppercase;letter-spacing:.04em}.ebd-value{font-size:26px;font-weight:700;color:var(--zcs_primary_text_color);margin-top:8px}.ebd-note{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:8px}.ebd-section-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin-bottom:16px}.ebd-section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.ebd-section-title h2{margin:0;color:var(--zcs_primary_text_color);font-size:18px}.ebd-muted{color:var(--zcs_secondary_text_color)}.ebd-feed{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ebd-feed-item{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:12px;margin-bottom:8px}.ebd-feed-title{display:flex;justify-content:space-between;gap:10px}.ebd-small{font-size:12px}.ebd-matrix-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;overflow:hidden}.ebd-matrix-head,.ebd-matrix-cell{padding:10px;border-top:1px solid var(--zcs_tertiary_border_color)}.ebd-matrix-head{background:#f9fafe;font-weight:600;color:var(--zcs_primary_text_color);border-top:0}.zcs-red{color:#fe455d}.zcs-green{color:#179e6c}@media(max-width:900px){.ebd-grid,.ebd-feed{grid-template-columns:1fr}.ebd-matrix-grid{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&quot;ebd-grid&quot;&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Active cycles&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=activeCycleCount%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&quot;ebd-card ebd-card-link&quot; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;&lt;div class=&quot;ebd-label&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-pie-36&quot;&gt;&lt;/i&gt; Scenario comparison&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=financeDecisionCount%&gt;&lt;/div&gt;&lt;div class=&quot;ebd-note&quot;&gt;Open &lt;%=scenarioCycleName%&gt; comparison&lt;/div&gt;&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-card ebd-card-disabled&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt; Scenario comparison&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;0&lt;/div&gt;&lt;div class=&quot;ebd-note&quot;&gt;No active/open Budget Cycle available&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&quot;ebd-card ebd-card-link&quot; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;&lt;div class=&quot;ebd-label&quot;&gt;&lt;i class=&quot;zc-li-outline business-signature&quot;&gt;&lt;/i&gt; Financial summary&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=financeDecisionCount%&gt;&lt;/div&gt;&lt;div class=&quot;ebd-note&quot;&gt;Submitted to Management&lt;/div&gt;&lt;/a&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;SCM ready/final&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=scmReadyCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Finance completed&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=financeCompletedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Completed cycles&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=completedCycleCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Critical events&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=criticalEvents%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-card&quot;&gt;&lt;div class=&quot;ebd-label&quot;&gt;Revision requests&lt;/div&gt;&lt;div class=&quot;ebd-value&quot;&gt;&lt;%=Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count()%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Approval_Bottlenecks' elementName='Approval_Bottlenecks'>\n\t\t\t\t\t<![CDATA[htmlpage Approval_Bottlenecks()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tsalesAwaiting = Sales_Plans[Status == &quot;Submitted to COE&quot; || Status == &quot;Submitted to SCM&quot; || Status == &quot;Submitted to Operations&quot; || Status == &quot;Submitted to Sales Head&quot; || Status == &quot;Submitted to Global Sales Head&quot; || Status == &quot;Submitted to SCM Head&quot;].count();\n\tsalesReturned = Sales_Plans[Status.contains(&quot;Returned&quot;)].count();\n\tsalesApproved = Sales_Plans[Status == &quot;Approved and Locked&quot; || Locked == true].count();\n\tvolumeAwaiting = Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\tvolumeReturned = Volume_Consolidations[Status == &quot;Returned to Sales&quot;].count();\n\tvolumeApproved = Volume_Consolidations[Status == &quot;Balanced&quot; || Status == &quot;SCM Head Finalised&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tfinancialAwaiting = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinancialReturned = Financial_Consolidations[Status == &quot;Returned by Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinancialApproved = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\tcutoff = zoho.currenttime.subDay(7);\n\toverdueReturns = Approval_Audit_Log[Action == &quot;Returned&quot; &amp;&amp; Action_On &lt; cutoff] sort by Action_On asc range from 0 to 4;\n\toverdueCount = Approval_Audit_Log[Action == &quot;Returned&quot; &amp;&amp; Action_On &lt; cutoff].count();\n\t%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t\t&lt;div class=&quot;ebd-section-title&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;ebd-icon-ring&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;h2&gt;Approval Bottlenecks&lt;/h2&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-simple-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=overdueCount%&gt; overdue returns&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Module&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Awaiting approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Returned&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Approved or locked&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;ebd-table-link&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;Financial Consolidation Summary&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=financialAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=financialReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=financialApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;ebd-table-link&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;Scenario Comparison Dashboard&lt;/a&gt;&lt;div class=&apos;ebd-muted ebd-small&apos;&gt;&lt;%=scenarioCycleName%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=financialAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;0&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;0&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Scenario Comparison Dashboard&lt;div class=&apos;ebd-muted ebd-small&apos;&gt;No active/open Budget Cycle available&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;0&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;0&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;0&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Volume Consolidation&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=volumeAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=volumeReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=volumeApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Financial Consolidation&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-blue&apos;&gt;&lt;%=financialAwaiting%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=financialReturned%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=financialApproved%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot; style=&quot;margin-top:16px;margin-bottom:8px;&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-alert-circle-i zcs-color-yellow&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;Oldest returned approvals past 7 days&lt;/strong&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ebd-feed-list&quot;&gt;\n&lt;%\n\tif(overdueReturns.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item ebd-muted zcs-font-14&quot;&gt;No overdue returned approvals at this time.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  audit in overdueReturns\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ebd-feed-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=audit.Module_Name%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.Action_On%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ebd-muted zcs-font-13&quot;&gt;&lt;%=audit.Related_Record_Display%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13&quot;&gt;Returned to: &lt;span class=&quot;zcs-color-yellow&quot;&gt;&lt;%=audit.To_Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Plant_Status_Matrix' elementName='Plant_Status_Matrix'>\n\t\t\t\t\t<![CDATA[htmlpage Plant_Status_Matrix()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tplants = Plants[Active == true] sort by Plant_Name asc;\n\tfinancialTotal = Financial_Consolidations[ID != 0].count();\n\tfinancialDone = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot;].count();\n\tfinancialPct = 0;\n\tif(financialTotal != 0)\n\t{\n\t\tfinancialPct = financialDone * 100 / financialTotal;\n\t}\n\t%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t&lt;div class=&quot;ebd-section-title&quot;&gt;&lt;h2&gt;Plant Status Matrix&lt;/h2&gt;&lt;span class=&quot;ebd-muted&quot;&gt;Financial sign-off &lt;%=financialPct%&gt;%&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-matrix-grid&quot;&gt;\n\t\t&lt;div class=&quot;ebd-matrix-head&quot;&gt;Plant&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;Operations availability&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;Operations production&lt;/div&gt;&lt;div class=&quot;ebd-matrix-head&quot;&gt;SCM reviews&lt;/div&gt;\n&lt;%\n\tif(plants.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-matrix-cell&quot; style=&quot;grid-column:1 / -1;&quot;&gt;No active plants configured.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  plant in plants\n\t\t{\n\t\t\tavail = Capacity_TEP_Plans[Plant == plant.ID &amp;&amp; Status == &quot;Operations Approved&quot;].count();\n\t\t\tprod = Operations_Production_Plans[Plant == plant.ID &amp;&amp; Status == &quot;Operations Approved&quot;].count();\n\t\t\tscm = Volume_Consolidations[Plant == plant.ID &amp;&amp; Status != &quot;Waiting for Sales and Operations Approval&quot;].count();\n\t\t\t%&gt;\n&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;strong&gt;&lt;%=plant.Plant_Name%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=avail%&gt; approved&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=prod%&gt; approved&lt;/div&gt;&lt;div class=&quot;ebd-matrix-cell&quot;&gt;&lt;%=scm%&gt; active/final&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Exception_Feed' elementName='Exception_Feed'>\n\t\t\t\t\t<![CDATA[htmlpage Exception_Feed()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\trevisions = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;] sort by Consolidation_No desc range from 0 to 5;\n\treturnedApprovals = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Revision Requested&quot;] sort by Action_On desc range from 0 to 5;\n\t%&gt;\n&lt;div class=&quot;ebd-section-card&quot;&gt;\n\t&lt;div class=&quot;ebd-section-title&quot;&gt;&lt;h2&gt;Exception Feed&lt;/h2&gt;&lt;span class=&quot;ebd-muted&quot;&gt;Revision requests and returned approvals&lt;/span&gt;&lt;/div&gt;\n\t&lt;div class=&quot;ebd-feed&quot;&gt;\n\t\t&lt;div&gt;&lt;strong&gt;SCM revision requests&lt;/strong&gt;\n&lt;%\n\tif(revisions.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item ebd-muted&quot;&gt;No active SCM revision requests.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  vc in revisions\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item&quot;&gt;&lt;div class=&quot;ebd-feed-title&quot;&gt;&lt;strong&gt;&lt;%=vc.Consolidation_No%&gt;&lt;/strong&gt;&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=vc.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=vc.Requested_Financial_Year.Year_Name%&gt; | &lt;%=vc.Plant.Plant_Name%&gt;&lt;/div&gt;&lt;div&gt;&lt;%=vc.SCM_Decision%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;div&gt;&lt;strong&gt;Audit exceptions&lt;/strong&gt;\n&lt;%\n\tif(returnedApprovals.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item ebd-muted&quot;&gt;No returned approvals in the audit log.&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tfor each  audit in returnedApprovals\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ebd-feed-item&quot;&gt;&lt;div class=&quot;ebd-feed-title&quot;&gt;&lt;strong&gt;&lt;%=audit.Module_Name%&gt;&lt;/strong&gt;&lt;span class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.Action_On%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;%=audit.Related_Record_Display%&gt;&lt;/div&gt;&lt;div class=&quot;ebd-muted ebd-small&quot;&gt;&lt;%=audit.From_Status%&gt; to &lt;%=audit.To_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Critical_Audit_Events' title='Critical Audit Events' boldTitle='true' titleColor='#12132B' appLinkName='thisapp' linkName='Critical_Audit_Events' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Executive_Landing
		{
					displayname = "Executive Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Executive_Landing_Snippet' elementName='Executive_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Executive_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Executive Management&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tactiveCycles = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot;].count();\n\tmanagementQueue = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinalBudgets = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tfinancialTotal = Financial_Consolidations[ID != 0].count();\n\tfinalBudgetRate = 0;\n\tif(financialTotal &gt; 0)\n\t{\n\t\tfinalBudgetRate = (finalBudgets * 100) / financialTotal;\n\t}\n\tshortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tcriticalEvents = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Reopened&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n\tauditNeeds = Approval_Audit_Log[Action == &quot;Returned&quot; || Action == &quot;Reopened&quot;].count();\n\tfinalAuditSignals = Approval_Audit_Log[Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot;].count();\n\treplans = Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;Revision Created&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\tdecisionLoad = managementQueue + replans + auditNeeds + shortfalls;\n\twatchTotal = activeCycles + managementQueue + replans + auditNeeds + shortfalls;\n\tif(watchTotal == 0)\n\t{\n\t\twatchTotal = 1;\n\t}\n\tmgmtPct = (managementQueue * 100) / watchTotal;\n\treplanPct = (replans * 100) / watchTotal;\n\tauditPct = (auditNeeds * 100) / watchTotal;\n\tshortfallPct = (shortfalls * 100) / watchTotal;\n\turgentTitle = &quot;Open scenario comparison dashboard&quot;;\n\turgentCopy = &quot;No urgent exception is ahead of the decision queue. Continue monitoring the latest active/open Budget Cycle and final budget readiness.&quot;;\n\turgentUrl = scenarioComparisonUrl;\n\tif(urgentUrl == &quot;&quot;)\n\t{\n\t\turgentUrl = &quot;#Page:Executive_Budget_Dashboard&quot;;\n\t}\n\turgentCount = activeCycles;\n\turgentLabel = &quot;Comparison&quot;;\n\turgentIcon = &quot;zc-li-outline business-chart-pie-36&quot;;\n\turgentTone = &quot;zcs-badge-blue&quot;;\n\tif(auditNeeds &gt; 0)\n\t{\n\t\turgentTitle = &quot;Investigate returned or reopened audit signals&quot;;\n\t\turgentCopy = &quot;Critical audit activity needs executive visibility before the next final-readiness checkpoint.&quot;;\n\t\turgentUrl = &quot;#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog&quot;;\n\t\turgentCount = auditNeeds;\n\t\turgentLabel = &quot;Audit signals&quot;;\n\t\turgentIcon = &quot;zc-li-outline ui-1-circle-remove&quot;;\n\t\turgentTone = &quot;zcs-badge-red&quot;;\n\t}\n\telse if(managementQueue &gt; 0)\n\t{\n\t\turgentTitle = &quot;Review management submissions&quot;;\n\t\turgentCopy = &quot;Financial consolidation records are submitted for management decision and exclude completed, locked, and final-approved items.&quot;;\n\t\turgentUrl = &quot;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&quot;;\n\t\turgentCount = managementQueue;\n\t\turgentLabel = &quot;Submissions&quot;;\n\t\turgentIcon = &quot;zc-li-outline business-signature&quot;;\n\t\turgentTone = &quot;zcs-badge-yellow&quot;;\n\t}\n\telse if(replans &gt; 0)\n\t{\n\t\turgentTitle = &quot;Resolve replanning watch items&quot;;\n\t\turgentCopy = &quot;Replanning requests are in finance review, finance approved, or revision-created states and should be closed into the next cycle.&quot;;\n\t\turgentUrl = &quot;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&quot;;\n\t\turgentCount = replans;\n\t\turgentLabel = &quot;Replans&quot;;\n\t\turgentIcon = &quot;zc-li-outline arrows-1-refresh-69&quot;;\n\t\turgentTone = &quot;zcs-badge-orange&quot;;\n\t}\n\telse if(shortfalls &gt; 0)\n\t{\n\t\turgentTitle = &quot;Review SCM shortfall revision buckets&quot;;\n\t\turgentCopy = &quot;Shortfall or revision-pending volume buckets remain open and may affect final budget readiness.&quot;;\n\t\turgentUrl = &quot;#Page:Executive_Budget_Dashboard&quot;;\n\t\turgentCount = shortfalls;\n\t\turgentLabel = &quot;Shortfalls&quot;;\n\t\turgentIcon = &quot;zc-li-outline ui-2-time&quot;;\n\t\turgentTone = &quot;zcs-badge-yellow&quot;;\n\t}\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#fff;--zcs-page-bg-color:#F3F3F4;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;--zcs-light-bg-color:var(--zcs_brand_light_color)}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-button:hover{filter:brightness(.96)}.zcs-primary-button.zcs-button:focus,.zcs-primary-outline-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px;font-style:normal}.zcs-badge{width:auto;border:1px solid}.zcs-badge-icon{font-style:normal}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9F6500}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#C84F09}\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}\n.el-command-center{background:linear-gradient(180deg,#f6f7fb 0%,var(--zcs-page-bg-color) 100%);padding:24px;box-sizing:border-box;color:var(--zcs-primary-text-color);font-family:inherit}.el-hero{position:relative;overflow:hidden;padding:26px;border:0;background:linear-gradient(135deg,var(--zcs_brand_color) 0%,#17324d 68%,#111827 100%);color:var(--zcs_brand_foreground_color);box-shadow:0 18px 45px rgba(17,24,39,.18)}.el-hero:after{content:&quot;&quot;;position:absolute;right:-90px;top:-120px;width:320px;height:320px;border-radius:50%;border:42px solid rgba(255,255,255,.10)}.el-hero-main{position:relative;z-index:1}.el-eyebrow{letter-spacing:.08em;text-transform:uppercase;opacity:.82}.el-title{font-size:30px;line-height:1.15;margin:8px 0}.el-subtitle{max-width:860px;margin:0;opacity:.9}.el-hero-side{position:relative;z-index:1;min-width:230px}.el-link-light{color:var(--zcs_brand_foreground_color);border-color:rgba(255,255,255,.55);background:rgba(255,255,255,.12)}.el-kpi-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-top:16px}.el-kpi{display:block;padding:18px;color:inherit;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}.el-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 12px 28px rgba(17,24,39,.08)}.el-kpi-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.el-kpi-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:18px}.el-kpi-value{display:block;font-size:32px;font-weight:700;line-height:1;margin:15px 0 6px}.el-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color)}.el-kpi-meta{font-size:12px;color:var(--zcs-teritiary-text-color)}.el-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:16px;margin-top:16px}.el-panel{padding:20px}.el-panel-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.el-panel h3{font-size:18px;margin:0}.el-focus{border:1px solid rgba(244,102,12,.22);background:linear-gradient(135deg,#fff 0%,#fff8f1 100%)}.el-focus-icon{width:52px;height:52px;border-radius:16px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:24px}.el-focus-copy{margin:10px 0 16px;color:var(--zcs-secondary-text-color)}.el-action-list{display:grid;gap:10px}.el-action{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:12px;align-items:center;padding:13px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff;color:inherit}.el-action:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.el-action-icon{width:34px;height:34px;border-radius:10px;background:var(--zcs-light-bg-color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center}.el-action-title{font-weight:600;color:var(--zcs-primary-text-color)}.el-action-note{font-size:12px;color:var(--zcs-secondary-text-color);margin-top:2px}.el-count{font-size:22px;font-weight:700;color:var(--zcs_brand_color)}.el-insight-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.el-insight{padding:15px;border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff}.el-insight strong{display:block;margin-bottom:6px}.el-muted{color:var(--zcs-secondary-text-color)}.el-bars{display:grid;gap:11px}.el-bar-row{display:grid;gap:5px}.el-bar-meta{display:flex;justify-content:space-between;font-size:12px;color:var(--zcs-secondary-text-color)}.el-bar{height:8px;border-radius:999px;background:#eef0f5;overflow:hidden}.el-bar span{display:block;height:100%;border-radius:inherit;background:var(--zcs_brand_color)}.el-bar.audit span{background:#FE455D}.el-bar.replan span{background:#F4660C}.el-bar.shortfall span{background:#FAAE13}.el-readiness{margin-top:14px;padding:14px;border-radius:12px;background:#f9fafe;border:1px solid var(--zcs_tertiary_border_color)}.el-table-link{color:var(--zcs_brand_color);font-weight:600}.el-table-link:hover{text-decoration:underline}.el-note{margin-top:12px;font-size:12px;color:var(--zcs-secondary-text-color)}@media(max-width:1180px){.el-kpi-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.el-grid{grid-template-columns:1fr}}@media(max-width:720px){.el-command-center{padding:14px}.el-hero{padding:20px}.el-title{font-size:24px}.el-kpi-strip,.el-insight-grid{grid-template-columns:1fr}.el-action{grid-template-columns:auto minmax(0,1fr)}.el-count{grid-column:2}.el-hero-side{min-width:0;width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;el-command-center&apos;&gt;\n\t&lt;section class=&apos;el-hero zcs-card zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-20 el-hero-main&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;el-eyebrow zcs-font-12 zcs-font-semibold&apos;&gt;Executive landing command center&lt;/div&gt;\n\t\t\t\t&lt;h1 class=&apos;el-title zcs-font-bold&apos;&gt;Budget decisions, replanning watch, and audit signals&lt;/h1&gt;\n\t\t\t\t&lt;p class=&apos;el-subtitle zcs-font-14 zcs-lh-body&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Pending queues exclude Completed, Closed, Locked, and Approved Final states; those states appear only in final-readiness metrics.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;el-hero-side zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body el-link-light&apos; href=&apos;#Page:Executive_Budget_Dashboard&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline business-chart&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open dashboard&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&apos;el-kpi-strip&apos;&gt;\n\t\t&lt;a class=&apos;el-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Active_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Active cycles&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;&lt;%=activeCycles%&gt;&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;Planning or review cycles still open&lt;/div&gt;\n\t\t&lt;/a&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;el-kpi zcs-card zcs-box-border&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Scenario comparison&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;&lt;%=managementQueue%&gt;&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;Compare &lt;%=scenarioCycleName%&gt; and open decision scenarios&lt;/div&gt;\n\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;el-kpi zcs-card zcs-box-border&apos; style=&apos;opacity:.72;&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Scenario comparison&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;0&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;No active/open Budget Cycle is available&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;el-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Final budgets&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;&lt;%=finalBudgets%&gt;&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;Approved final, completed, or locked records&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;el-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Critical events&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;&lt;%=criticalEvents%&gt;&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;Returned, reopened, locked, or final actions&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;el-kpi zcs-card zcs-box-border&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;el-kpi-head&apos;&gt;&lt;span class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary&apos;&gt;Replanning watch&lt;/span&gt;&lt;span class=&apos;el-kpi-icon&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;strong class=&apos;el-kpi-value&apos;&gt;&lt;%=replans%&gt;&lt;/strong&gt;\n\t\t\t&lt;div class=&apos;el-kpi-label&apos;&gt;Submitted, finance-approved, or revision-created requests&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&apos;el-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;div class=&apos;el-panel el-focus zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-start zcs-gap-16&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;el-focus-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos;&gt;&lt;i class=&apos;&lt;%=urgentIcon%&gt;&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline &lt;%=urgentTone%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;Most urgent next action&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;strong class=&apos;el-count&apos;&gt;&lt;%=urgentCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-24 zcs-font-bold zcs-lh-heading zcs-color-primary zcs-m-0 zcs-mt-8&apos;&gt;&lt;%=urgentTitle%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&apos;el-focus-copy zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=urgentCopy%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=urgentUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Act on &lt;%=urgentLabel%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;el-panel zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;el-panel-title&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;Decision shortcuts&lt;/h3&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Executive action links&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;el-action-list&apos;&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;el-action&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Scenario comparison dashboard&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;Open &lt;%=scenarioCycleName%&gt; for side-by-side decision review&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;&lt;%=activeCycles%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;el-action&apos; style=&apos;opacity:.72;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Scenario comparison dashboard&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;No active/open Budget Cycle is available for comparison&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;0&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;el-action&apos; href=&apos;#Page:Executive_Budget_Dashboard&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Executive budget dashboard&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;Command view for cycle, scenario, and final readiness decisions&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;&lt;%=activeCycles%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;el-action&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Review management submissions&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;Submitted to Management, excluding completed, locked, and final-approved records&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;&lt;%=managementQueue%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;el-action&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Monitor replanning requests&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;Submitted to Finance, Finance Approved, or Revision Created&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;&lt;%=replans%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;el-action&apos; href=&apos;#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-action-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;span class=&apos;el-action-title&apos;&gt;Investigate critical audit signals&lt;/span&gt;&lt;span class=&apos;el-action-note&apos;&gt;Returned or reopened events for executive follow-up&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;el-count&apos;&gt;&lt;%=auditNeeds%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;div class=&apos;el-panel zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;el-panel-title&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;Enterprise insight cards&lt;/h3&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Live operational summary&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;el-insight-grid&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;el-insight&apos;&gt;&lt;strong&gt;Management submissions&lt;/strong&gt;&lt;div class=&apos;el-muted zcs-font-13&apos;&gt;&lt;%=managementQueue%&gt; financial scenario records need management decision.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-insight&apos;&gt;&lt;strong&gt;Replanning exposure&lt;/strong&gt;&lt;div class=&apos;el-muted zcs-font-13&apos;&gt;&lt;%=replans%&gt; replanning requests remain on the finance watch path.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-insight&apos;&gt;&lt;strong&gt;SCM revision pressure&lt;/strong&gt;&lt;div class=&apos;el-muted zcs-font-13&apos;&gt;&lt;%=shortfalls%&gt; shortfall or revision-pending volume buckets may affect readiness.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-insight&apos;&gt;&lt;strong&gt;Audit attention&lt;/strong&gt;&lt;div class=&apos;el-muted zcs-font-13&apos;&gt;&lt;%=auditNeeds%&gt; returned or reopened audit events need triage; &lt;%=finalAuditSignals%&gt; are final-readiness signals.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;el-panel zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;el-panel-title&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;Decision load distribution&lt;/h3&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Open workload mix&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;el-bars&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;el-bar-row&apos;&gt;&lt;div class=&apos;el-bar-meta&apos;&gt;&lt;span&gt;Management queue&lt;/span&gt;&lt;strong&gt;&lt;%=managementQueue%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;el-bar&apos;&gt;&lt;span style=&apos;width:&lt;%=mgmtPct%&gt;%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-bar-row&apos;&gt;&lt;div class=&apos;el-bar-meta&apos;&gt;&lt;span&gt;Replanning watch&lt;/span&gt;&lt;strong&gt;&lt;%=replans%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;el-bar replan&apos;&gt;&lt;span style=&apos;width:&lt;%=replanPct%&gt;%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-bar-row&apos;&gt;&lt;div class=&apos;el-bar-meta&apos;&gt;&lt;span&gt;Critical audit triage&lt;/span&gt;&lt;strong&gt;&lt;%=auditNeeds%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;el-bar audit&apos;&gt;&lt;span style=&apos;width:&lt;%=auditPct%&gt;%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-bar-row&apos;&gt;&lt;div class=&apos;el-bar-meta&apos;&gt;&lt;span&gt;SCM revision pressure&lt;/span&gt;&lt;strong&gt;&lt;%=shortfalls%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&apos;el-bar shortfall&apos;&gt;&lt;span style=&apos;width:&lt;%=shortfallPct%&gt;%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;el-readiness&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;&lt;strong&gt;Final budget readiness&lt;/strong&gt;&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=finalBudgets%&gt; of &lt;%=financialTotal%&gt; records&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;el-bar zcs-mt-8&apos;&gt;&lt;span style=&apos;width:&lt;%=finalBudgetRate%&gt;%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&apos;el-panel zcs-card zcs-box-border&apos; style=&apos;margin-top:16px;&apos;&gt;\n\t\t&lt;div class=&apos;el-panel-title&apos;&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;Decision links and availability&lt;/h3&gt;\n\t\t\t&lt;span class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Dialog links open reports in place when available&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Area&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Action&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open count&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Scenario comparison&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;el-table-link&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;Open Scenario Comparison Dashboard&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=activeCycles%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Scenario comparison&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;No active/open Budget Cycle available&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;0&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Management submissions&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;el-table-link&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;Open Scenario Financial Summary&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=managementQueue%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Replanning watch&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;el-table-link&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;Open Active Replanning Requests&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=replans%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Critical audit signals&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;el-table-link&apos; href=&apos;#Report:Management_Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;Open Management Critical Audit Events&lt;/a&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=auditNeeds%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;el-note&apos;&gt;Pending counts intentionally exclude Completed, Closed, Locked, and Approved Final records. Final-readiness metrics include those states to show closure progress.&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Finance_Landing
		{
					displayname = "Finance Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Finance_Landing_Snippet' elementName='Finance_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Finance_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Finance Costing&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tactiveCycles = Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot;].count();\n\tpendingFinanceCycles = Budget_Cycles[Status == &quot;Pending Finance&quot; &amp;&amp; Finance_Completed != true &amp;&amp; Baseline_Locked != true &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot;].count();\n\tfinanceDrafts = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tmanagementQueue = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinanceSubmissionQueue = financeDrafts + managementQueue;\n\treplanFinanceAction = Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;Revision Created&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tfinalConsolidations = Financial_Consolidations[Status == &quot;Approved Final&quot; || Status == &quot;Completed&quot; || Status == &quot;Locked&quot; || Locked == true].count();\n\tapprovedFinal = Financial_Consolidations[Status == &quot;Approved Final&quot;].count();\n\tcompletedFinance = Financial_Consolidations[Status == &quot;Completed&quot;].count();\n\tlockedFinance = Financial_Consolidations[Status == &quot;Locked&quot; || Locked == true].count();\n\tlockedBaselines = Budget_Cycles[Baseline_Locked == true].count();\n\tfinanceCompletedCycles = Budget_Cycles[Finance_Completed == true].count();\n\tcriticalExceptions = Approval_Audit_Log[Action == &quot;Revision Requested&quot; || Action == &quot;Revision Copy Created&quot; || Action == &quot;Locked&quot; || Action == &quot;Final Approved&quot; || Action == &quot;Completed&quot; || Action == &quot;Cancelled&quot;].count();\n\tpendingFinanceTotal = pendingFinanceCycles + financeDrafts + replanFinanceAction;\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\t%&gt;\n&lt;style&gt;\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-primary-btn-color:var(--zcs_brand_color);--zcs-primary-btn-text-color:var(--zcs_brand_foreground_color);font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-col-5{flex:0 0 calc(41.666% - 10px);max-width:calc(41.666% - 10px)}.zcs-col-7{flex:0 0 calc(58.333% - 8px);max-width:calc(58.333% - 8px)}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mb-0{margin-bottom:0}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:40px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-no-shrink{flex-shrink:0}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}.zcs-page-header{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color,#1c3d5a));border:0;border-radius:16px}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-theme{background-color:rgba(255,255,255,.15);border-color:rgba(255,255,255,.42);color:var(--zcs-white-color)}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9B6400}.zcs-badge-filled-outline.zcs-badge-orange{background-color:#F8F0EB;border-color:#F4660C;color:#F4660C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#F1F2F4;border-color:#D7DCE2;color:#525967}.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-red{color:#fe455d}.fl-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;min-height:100%;color:var(--zcs-primary-text-color)}.fl-hero{box-shadow:0 14px 28px rgba(20,29,51,.12);overflow:hidden;position:relative}.fl-hero:after{content:&quot;&quot;;position:absolute;right:-58px;top:-78px;width:220px;height:220px;border:34px solid rgba(255,255,255,.12);border-radius:50%;pointer-events:none}.fl-hero-title{color:var(--zcs_brand_foreground_color);font-size:28px}.fl-hero-copy{max-width:820px;color:var(--zcs_brand_foreground_color);opacity:.9}.fl-eyebrow{letter-spacing:.08em;color:var(--zcs_brand_foreground_color);opacity:.78}.fl-hero .zcs-primary-button{background:var(--zcs-white-color);color:var(--zcs_brand_color)}.fl-kpi-grid{margin-top:16px}.fl-kpi{flex:1 1 180px;min-width:180px;min-height:158px;color:inherit;transition:border-color .15s ease,transform .15s ease,box-shadow .15s ease}.fl-kpi:hover{border-color:var(--zcs_brand_color);transform:translateY(-1px);box-shadow:0 10px 22px rgba(20,29,51,.08)}.fl-kpi-top{min-height:34px}.fl-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);font-size:18px}.fl-kpi-value{font-size:34px;line-height:1;color:var(--zcs-primary-text-color)}.fl-kpi-note{min-height:40px}.fl-content{margin-top:16px}.fl-panel{min-height:100%}.fl-section-head{margin-bottom:14px}.fl-action-list{list-style:none}.fl-action-card{border-radius:12px;transition:border-color .15s ease,background-color .15s ease}.fl-action-card.is-primary{background:linear-gradient(0deg,var(--zcs_component_hover_color),var(--zcs-white-color))}.fl-action-link{color:inherit;width:100%}.fl-action-title{display:block;color:var(--zcs-primary-text-color)}.fl-action-meta{display:block;color:var(--zcs-secondary-text-color);margin-top:2px}.fl-action-count{min-width:48px;text-align:center;border-radius:999px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);padding:6px 10px}.fl-arrow{color:var(--zcs-teritiary-text-color)}.fl-insight-list{list-style:none}.fl-insight-item{border-top:1px solid var(--zcs-border-color)}.fl-insight-item:first-child{border-top:0}.fl-insight-link{color:var(--zcs_brand_color);font-weight:600}.fl-footer-links{border-top:1px solid var(--zcs-border-color);margin-top:14px;padding-top:14px}.fl-footer-links a,.fl-table-link{color:var(--zcs_brand_color);font-weight:600}.fl-dashboard-card{color:inherit;transition:border-color .15s ease,box-shadow .15s ease}.fl-dashboard-card:hover{border-color:var(--zcs_brand_color);box-shadow:0 10px 22px rgba(20,29,51,.08)}.fl-nodata{min-height:136px;background:var(--zcs-white-color);border:1px dashed var(--zcs-border-color);border-radius:12px}.fl-nav{margin-top:16px}.fl-table-wrapper{max-height:365px}@media(max-width:992px){.zcs-col-md-12{flex:0 0 100%;max-width:100%}.fl-hero{align-items:flex-start;flex-direction:column}.fl-hero-actions{width:100%;justify-content:flex-start}.fl-kpi{flex:1 1 calc(50% - 8px)}}@media(max-width:576px){.fl-shell{padding:12px}.zcs-col-xs-12,.zcs-col-5,.zcs-col-7,.fl-kpi{flex:0 0 100%;max-width:100%}.fl-hero{padding:18px}.fl-hero-actions{flex-direction:column;align-items:stretch}.fl-hero-actions .zcs-button{width:100%}.fl-kpi-value{font-size:30px}.fl-action-link{align-items:flex-start}.fl-action-count{min-width:40px}.fl-dashboard-row{flex-direction:column}}\n&lt;/style&gt;\n&lt;div class=&apos;fl-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header fl-hero zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-eyebrow zcs-font-12 zcs-font-semibold zcs-uppercase&apos;&gt;Finance budget workspace&lt;/div&gt;\n\t\t\t&lt;h2 class=&apos;fl-hero-title zcs-font-bold zcs-lh-heading zcs-m-0&apos;&gt;Finance Landing&lt;/h2&gt;\n\t\t\t&lt;p class=&apos;fl-hero-copy zcs-font-14 zcs-lh-body zcs-m-0&apos;&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Track active budget cycles, finance consolidation work, replanning decisions, and final budget readiness without mixing locked or approved records into pending actions.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;fl-hero-actions zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;#Form:Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Consolidation&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;fl-kpi-grid zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;a class=&apos;fl-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Active_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;i class=&apos;zc-li-outline loader-dots-06&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Active&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Active budget cycles&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;fl-kpi-value zcs-font-bold&apos;&gt;&lt;%=activeCycles%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Uses the Active Budget Cycles report criteria: not Completed and not Closed.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;fl-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:All_Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-growth&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Queue&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Finance submission queue&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;fl-kpi-value zcs-font-bold&apos;&gt;&lt;%=financeSubmissionQueue%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Draft, returned, reopened, and management-submitted consolidations; final and locked rows excluded.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;fl-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Finance&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Replanning action&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;fl-kpi-value zcs-font-bold&apos;&gt;&lt;%=replanFinanceAction%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Submitted to Finance, Finance Approved, or Revision Created requests; Locked excluded.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;fl-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Final&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Approved, final, locked&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;fl-kpi-value zcs-font-bold&apos;&gt;&lt;%=finalConsolidations%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Approved Final, Completed, Locked, or Locked flag records shown only as readiness metrics.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&apos;fl-kpi zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border&apos; href=&apos;#Report:Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-top zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-paragraph&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;Audit&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-semibold zcs-color-secondary zcs-uppercase&apos;&gt;Critical exceptions&lt;/div&gt;\n\t\t\t\t&lt;strong class=&apos;fl-kpi-value zcs-font-bold&apos;&gt;&lt;%=criticalExceptions%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;fl-kpi-note zcs-font-13 zcs-color-secondary&apos;&gt;Uses the existing Critical Audit Events report actions already surfaced on executive pages.&lt;/div&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;fl-content zcs-row zcs-gap-16&apos;&gt;\n\t\t&lt;section class=&apos;zcs-quick-actions-wrapper fl-panel zcs-card zcs-col-7 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Pending finance actions&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Only active finance work is listed here. Completed, Closed, Locked, and Approved Final records are excluded from this queue.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-12&apos;&gt;&lt;%=pendingFinanceTotal%&gt; open&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(pendingFinanceTotal == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper fl-nodata zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-30 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No pending finance actions&lt;/h5&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;ul class=&apos;fl-action-list zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item fl-action-card is-primary zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link fl-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Active_Budget_Cycles?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Budget cycles needing finance completion&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Cycles in Pending Finance with Finance Completed not checked; completed, closed, and locked baselines are not counted.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=pendingFinanceCycles%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item fl-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link fl-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-money-growth&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Complete or resubmit financial consolidations&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Rows owned by this user in Draft, Returned by Management, or Reopened status. Approved Final, Completed, and Locked rows are excluded.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=financeDrafts%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;zcs-quick-action-item fl-action-card zcs-card zcs-px-16 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-quick-action-link fl-action-link zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Active_Replanning_Requests?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Act on replanning requests&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Finance statuses: Submitted to Finance, Finance Approved, or Revision Created. Locked requests stay out of the pending list.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;fl-action-count zcs-font-16 zcs-font-bold&apos;&gt;&lt;%=replanFinanceAction%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&apos;fl-footer-links zcs-flex zcs-gap-12 zcs-row zcs-font-13&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Financial_Consolidations?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;New consolidation&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Replanning_Requests?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-refresh-69&apos;&gt;&lt;/i&gt;New replanning request&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos; href=&apos;#Form:Budget_Cycles?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zc-li-outline business-progress&apos;&gt;&lt;/i&gt;Open budget cycle form&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&apos;fl-panel zcs-card zcs-col-5 zcs-col-md-12 zcs-col-xs-12 zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;fl-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Final readiness &amp;amp; locked records&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Approved, completed, and locked records are tracked as readiness metrics, not pending work.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper fl-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Record set&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-green&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/span&gt; Approved Final consolidations&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-bold zcs-lh-body zcs-green&apos;&gt;&lt;%=approvedFinal%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;fl-table-link&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;View&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-green&apos;&gt;&lt;i class=&apos;zc-li-outline files-archive-check&apos;&gt;&lt;/i&gt;&lt;/span&gt; Completed consolidations&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-bold zcs-lh-body zcs-green&apos;&gt;&lt;%=completedFinance%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;fl-table-link&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;View&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;/span&gt; Locked financial consolidations&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-bold zcs-lh-body zcs-yellow&apos;&gt;&lt;%=lockedFinance%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;fl-table-link&apos; href=&apos;#Report:Approved_Final_Budgets?zc_LoadIn=dialog&apos;&gt;View&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-yellow&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-32&apos;&gt;&lt;/i&gt;&lt;/span&gt; Locked budget baselines&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-bold zcs-lh-body zcs-yellow&apos;&gt;&lt;%=lockedBaselines%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;fl-table-link&apos; href=&apos;#Report:Locked_Baselines?zc_LoadIn=dialog&apos;&gt;View&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;zcs-red&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/span&gt; Critical audit events&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-bold zcs-lh-body zcs-red&apos;&gt;&lt;%=criticalExceptions%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;fl-table-link&apos; href=&apos;#Report:Critical_Audit_Events?zc_LoadIn=dialog&apos;&gt;View&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;ul class=&apos;fl-insight-list zcs-flex zcs-direction-column zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;li class=&apos;fl-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Management handoff&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-color-theme zc-li-outline business-handshake&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;a class=&apos;fl-insight-link&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;&lt;%=managementQueue%&gt; submitted consolidations&lt;/a&gt; are with management and kept out of finance pending actions.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;li class=&apos;fl-insight-item zcs-flex zcs-direction-column zcs-gap-8 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Finance completed cycles&lt;/label&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-align-items-start&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-color-theme zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=financeCompletedCycles%&gt; budget cycles have Finance Completed checked.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&apos;fl-nav zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;fl-section-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Dashboard links&lt;/h3&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Executive dashboards and comparison pages are quick navigation only and are not treated as pending finance actions.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;fl-dashboard-row zcs-flex zcs-gap-12&apos;&gt;\n\t\t\t&lt;a class=&apos;fl-dashboard-card zcs-card zcs-col-common zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-14 zcs-box-border&apos; href=&apos;#Page:Executive_Budget_Dashboard&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Executive Budget Dashboard&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Enterprise readiness and audit visibility.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;fl-dashboard-card zcs-card zcs-col-common zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-14 zcs-box-border&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Scenario Comparison Dashboard&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Compare &lt;%=scenarioCycleName%&gt; scenarios.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;fl-dashboard-card zcs-card zcs-col-common zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-14 zcs-box-border&apos; style=&apos;opacity:.72;&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Scenario Comparison Dashboard&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;No active/open Budget Cycle is available for comparison.&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;a class=&apos;fl-dashboard-card zcs-card zcs-col-common zcs-flex zcs-align-items-center zcs-gap-12 zcs-px-16 zcs-py-14 zcs-box-border&apos; href=&apos;#Report:Scenario_Financial_Summary?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;span class=&apos;fl-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-signature&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-col-common&apos;&gt;&lt;strong class=&apos;fl-action-title zcs-font-16 zcs-font-semibold&apos;&gt;Scenario Financial Summary&lt;/strong&gt;&lt;span class=&apos;fl-action-meta zcs-font-13&apos;&gt;Open submitted scenario financials in dialog.&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;i class=&apos;fl-arrow zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Operations_Landing(int Financial_Year, int Plant, int Production_Line)
		{
					displayname = "Operations Landing"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Landing_Snippet' elementName='Operations_Landing_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Landing_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginName = zoho.loginuser;\n\tloginEmail = zoho.loginuserid;\n\tprofileText = &quot;Operations PPC&quot;;\n\tif(thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;))\n\t{\n\t\tprofileText = &quot;System Administrator&quot;;\n\t}\n\tselectedFYId = 0;\n\tselectedFYName = &quot;No active financial year&quot;;\n\tselectedPlantId = 0;\n\tselectedLineId = 0;\n\tselectedPlantName = &quot;All plants&quot;;\n\tselectedLineName = &quot;All production lines&quot;;\n\tif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n\t{\n\t\tfyRows = Financial_Years[ID == input.Financial_Year];\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tif(input.Plant != null &amp;&amp; input.Plant != 0)\n\t{\n\t\tselectedPlantId = input.Plant;\n\t\tplantRows = Plants[ID == selectedPlantId];\n\t\tfor each  plantRec in plantRows\n\t\t{\n\t\t\tselectedPlantName = plantRec.Plant_Name;\n\t\t}\n\t}\n\tif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n\t{\n\t\tselectedLineId = input.Production_Line;\n\t\tlineRows = Production_Lines[ID == selectedLineId];\n\t\tfor each  lineRec in lineRows\n\t\t{\n\t\t\tselectedLineName = lineRec.Line_Name;\n\t\t}\n\t}\n\tselectedScopeText = selectedFYName + &quot; / &quot; + selectedPlantName + &quot; / &quot; + selectedLineName;\n\tmonthCount = 0;\n\tif(selectedFYId != 0)\n\t{\n\t\tmonthCount = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true].count();\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tavailabilityPlans = Capacity_TEP_Plans[ID == 0];\n\t\tproductionPlans = Operations_Production_Plans[ID == 0];\n\t}\n\telse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n\t{\n\t\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId];\n\t\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId];\n\t}\n\telse if(selectedPlantId != 0)\n\t{\n\t\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId];\n\t\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId];\n\t}\n\telse if(selectedLineId != 0)\n\t{\n\t\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId];\n\t\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId];\n\t}\n\telse\n\t{\n\t\tavailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId];\n\t\tproductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId];\n\t}\n\tavDraft = 0;\n\tavRevisedDraft = 0;\n\tavSubmitted = 0;\n\tavRevision = 0;\n\tavApprovedFinal = 0;\n\tprodDraft = 0;\n\tprodRevisedDraft = 0;\n\tprodSubmitted = 0;\n\tprodRevision = 0;\n\tprodApprovedFinal = 0;\n\ttotalAvailableHours = 0.0;\n\ttotalNetRunningHours = 0.0;\n\tavailabilityPctTotal = 0.0;\n\tavailabilityPctCount = 0;\n\tutilizationPctTotal = 0.0;\n\tutilizationPctCount = 0;\n\tfor each  capPlan in availabilityPlans\n\t{\n\t\tif(capPlan.Status == &quot;Operations Approved&quot; || capPlan.Status == &quot;Locked&quot;)\n\t\t{\n\t\t\tavApprovedFinal = avApprovedFinal + 1;\n\t\t\ttotalAvailableHours = totalAvailableHours + ifnull(capPlan.Annual_Available_Hours,0.0);\n\t\t\ttotalNetRunningHours = totalNetRunningHours + ifnull(capPlan.Annual_Net_Running_Hours,0.0);\n\t\t\tavailabilityPctTotal = availabilityPctTotal + ifnull(capPlan.Average_Equipment_Availability_Percent,0.0);\n\t\t\tavailabilityPctCount = availabilityPctCount + 1;\n\t\t\tutilizationPctTotal = utilizationPctTotal + ifnull(capPlan.Average_Equipment_Utilization_Percent,0.0);\n\t\t\tutilizationPctCount = utilizationPctCount + 1;\n\t\t}\n\t\telse if(capPlan.Status == &quot;Submitted to Operations Approval&quot;)\n\t\t{\n\t\t\tavSubmitted = avSubmitted + 1;\n\t\t}\n\t\telse if(capPlan.Status == &quot;Revision Requested by SCM&quot;)\n\t\t{\n\t\t\tavRevision = avRevision + 1;\n\t\t}\n\t\telse if(capPlan.Status == &quot;Revised Draft&quot;)\n\t\t{\n\t\t\tavRevisedDraft = avRevisedDraft + 1;\n\t\t}\n\t\telse if(capPlan.Status == &quot;Draft&quot;)\n\t\t{\n\t\t\tavDraft = avDraft + 1;\n\t\t}\n\t}\n\ttotalProductionTons = 0.0;\n\tfor each  prodPlan in productionPlans\n\t{\n\t\tif(prodPlan.Status == &quot;Operations Approved&quot; || prodPlan.Status == &quot;Locked&quot;)\n\t\t{\n\t\t\tprodApprovedFinal = prodApprovedFinal + 1;\n\t\t\ttotalProductionTons = totalProductionTons + ifnull(prodPlan.Total_FY_Production_Tons,0.0);\n\t\t}\n\t\telse if(prodPlan.Status == &quot;Submitted to Operations Approval&quot;)\n\t\t{\n\t\t\tprodSubmitted = prodSubmitted + 1;\n\t\t}\n\t\telse if(prodPlan.Status == &quot;Revision Requested by SCM&quot;)\n\t\t{\n\t\t\tprodRevision = prodRevision + 1;\n\t\t}\n\t\telse if(prodPlan.Status == &quot;Revised Draft&quot;)\n\t\t{\n\t\t\tprodRevisedDraft = prodRevisedDraft + 1;\n\t\t}\n\t\telse if(prodPlan.Status == &quot;Draft&quot;)\n\t\t{\n\t\t\tprodDraft = prodDraft + 1;\n\t\t}\n\t}\n\tavPending = avDraft + avRevisedDraft + avSubmitted + avRevision;\n\tprodPending = prodDraft + prodRevisedDraft + prodSubmitted + prodRevision;\n\ttotalPending = avPending + prodPending;\n\tdraftTotal = avDraft + prodDraft;\n\trevisedDraftTotal = avRevisedDraft + prodRevisedDraft;\n\tsubmittedTotal = avSubmitted + prodSubmitted;\n\trevisionTotal = avRevision + prodRevision;\n\tapprovedFinalTotal = avApprovedFinal + prodApprovedFinal;\n\tavgAvailability = 0.0;\n\tif(availabilityPctCount &gt; 0)\n\t{\n\t\tavgAvailability = availabilityPctTotal / availabilityPctCount;\n\t}\n\tavgUtilization = 0.0;\n\tif(utilizationPctCount &gt; 0)\n\t{\n\t\tavgUtilization = utilizationPctTotal / utilizationPctCount;\n\t}\n\tfocusMessage = &quot;Capacity and production planning are clear for the selected scope.&quot;;\n\tif(totalPending &gt; 0)\n\t{\n\t\tfocusMessage = &quot;Close pending drafts, submissions, and SCM revision requests before relying on the matrices below.&quot;;\n\t}\n\telse if(approvedFinalTotal == 0)\n\t{\n\t\tfocusMessage = &quot;No approved or final operational plans exist yet for this scope.&quot;;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global.css utilities used by this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-light-bg-color:var(--zcs_brand_light_color);--zcs-page-bg-color:#F3F3F4;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-white-color:#FFFFFF;--zcs-black-color:#000000;--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE;font-size:16px;line-height:1.5}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-relative{position:relative}.zcs-absolute{position:absolute}.zcs-sticky{position:sticky}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-template-card{width:260px;height:250px;overflow:hidden}.zcs-card-header{border-bottom:1px solid var(--zcs_tertiary_border_color)}.zcs-card-content{box-sizing:border-box}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;z-index:3}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-table-wrapper table tbody tr td .zcs-l_blue{color:#1094c5}.zcs-nodata-wrapper{min-height:220px}\n/* Operations command-center style */\n.op-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;color:var(--zcs-primary-text-color)}.op-command-hero{position:relative;overflow:hidden;border-radius:18px;padding:24px;background:linear-gradient(135deg,var(--zcs_brand_color),#162B4D 62%,#0F172A);color:var(--zcs_brand_foreground_color);display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.op-command-hero:after{content:&quot;&quot;;position:absolute;right:-70px;top:-110px;width:320px;height:320px;border:54px solid rgba(255,255,255,.08);border-radius:50%}.op-command-hero:before{content:&quot;&quot;;position:absolute;right:210px;bottom:-90px;width:230px;height:230px;border:38px solid rgba(255,255,255,.06);border-radius:50%}.op-hero-copy,.op-hero-actions{position:relative;z-index:1}.op-kicker{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.88}.op-command-hero h2{margin:0 0 8px;font-size:28px;line-height:1.18;font-weight:700}.op-command-hero p{margin:0;max-width:760px;opacity:.9}.op-hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.op-hero-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;min-width:310px}.op-hero-actions .zcs-button{box-shadow:0 10px 28px rgba(0,0,0,.16)}.op-kpi-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:16px}.op-kpi{width:auto;height:auto;min-height:132px;overflow:hidden}.op-kpi .zcs-card-header{padding:13px 15px}.op-kpi .zcs-card-content{padding:15px}.op-kpi-title{display:flex;align-items:center;gap:8px}.op-kpi-title i{color:var(--zcs_brand_color)}.op-kpi-value{display:block;font-size:30px;line-height:1.05;font-weight:800;color:var(--zcs-primary-text-color);margin-bottom:8px}.op-kpi-caption{display:block;color:var(--zcs-secondary-text-color);font-size:13px;line-height:1.35}.op-workbench{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:16px;margin-top:16px}.op-section,.op-filter-card{padding:18px;box-sizing:border-box}.op-section-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}.op-section-head h3,.op-filter-card h3,.op-card-title{margin:0 0 5px;font-size:19px;color:var(--zcs-primary-text-color);font-weight:700}.op-section-head p,.op-filter-card p,.op-card-subtitle{margin:0;color:var(--zcs-secondary-text-color);font-size:13px;line-height:1.5}.op-focus-card{background:linear-gradient(180deg,#FFFFFF,#FBFCFF);border-left:4px solid var(--zcs_brand_color)}.op-focus-main{display:grid;grid-template-columns:160px 1fr;gap:16px;align-items:center}.op-focus-score{border-radius:14px;background:var(--zcs_component_hover_color);padding:18px;text-align:center}.op-focus-score strong{display:block;font-size:44px;line-height:1;color:var(--zcs_brand_color)}.op-focus-score span{display:block;margin-top:8px;color:var(--zcs-secondary-text-color);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.op-focus-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}.op-mini-stat{border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;padding:11px 12px;background:#fff}.op-mini-stat b{display:block;font-size:22px;line-height:1.1;color:var(--zcs-primary-text-color)}.op-mini-stat span{display:block;margin-top:4px;color:var(--zcs-secondary-text-color);font-size:12px}.op-quick-grid{display:grid;grid-template-columns:1fr;gap:10px}.op-quick-card{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:#fff;padding:13px;display:flex;align-items:center;justify-content:space-between;gap:12px}.op-quick-copy{display:flex;gap:10px;align-items:center;min-width:0}.op-quick-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_component_hover_color);display:flex;align-items:center;justify-content:center;color:var(--zcs_brand_color);flex:0 0 38px}.op-quick-copy strong{display:block;color:var(--zcs-primary-text-color);font-size:14px;line-height:1.25}.op-quick-copy span{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}.op-filter-row{display:flex;align-items:flex-start;gap:12px;margin-top:12px;flex-wrap:wrap}.op-filter-label{min-width:126px;color:var(--zcs-secondary-text-color);font-size:13px;font-weight:700;padding-top:6px}.op-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--zcs_tertiary_border_color);border-radius:999px;padding:6px 11px;text-decoration:none;color:var(--zcs-primary-text-color);background:#fff;font-size:13px;line-height:1.25}.op-chip:hover,.op-chip.active{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.op-status-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px}.op-status-box{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;padding:13px;background:#fff}.op-status-box b{display:block;font-size:24px;line-height:1.1;margin:10px 0 5px;color:var(--zcs-primary-text-color)}.op-status-box small{display:block;color:var(--zcs-secondary-text-color);font-size:12px;line-height:1.35}.op-tables-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:16px}.op-table-note{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:9px}.op-insight-value{font-weight:700;color:var(--zcs-primary-text-color)}.op-empty{border:1px dashed var(--zcs_tertiary_border_color);border-radius:12px;background:#fbfcff}.op-empty-icon{font-size:42px;color:var(--zcs_brand_color)}.op-empty p{margin:8px auto 0;max-width:560px;color:var(--zcs-secondary-text-color)}.op-matrix-wrapper{max-height:620px}.op-matrix-table{min-width:980px}.op-matrix-table th,.op-matrix-table td{white-space:nowrap}.op-sticky-col{position:sticky;left:0;z-index:2;background:#fff;min-width:230px}.op-matrix-table thead .op-sticky-col{z-index:4;background:var(--zcs-thead-color)}.op-total-cell{background:#fbfcff;font-weight:600}.op-product-col{min-width:210px}.op-product-col strong{display:block}.op-product-col span{display:block;color:var(--zcs-secondary-text-color);font-size:12px;margin-top:2px}@media(max-width:1160px){.op-kpi-strip,.op-status-grid,.op-tables-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.op-workbench{grid-template-columns:1fr}.op-command-hero{flex-direction:column}.op-hero-actions{justify-content:flex-start;min-width:0}.op-focus-list{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:720px){.op-shell{padding:12px}.op-kpi-strip,.op-status-grid,.op-tables-grid,.op-focus-list{grid-template-columns:1fr}.op-focus-main{grid-template-columns:1fr}.op-filter-label{min-width:100%}.op-command-hero h2{font-size:24px}.op-quick-card{align-items:flex-start;flex-direction:column}.op-hero-actions .zcs-button{width:100%}}\n&lt;/style&gt;\n&lt;div class=&apos;op-shell&apos;&gt;\n\t&lt;div class=&apos;op-command-hero&apos;&gt;\n\t\t&lt;div class=&apos;op-hero-copy&apos;&gt;\n\t\t\t&lt;div class=&apos;op-kicker&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Operations command center&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;h2&gt;Pending planning actions and approved-capacity insight&lt;/h2&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt; (&lt;%=loginEmail%&gt;). Use the same Financial Year, Plant, and Production Line filters to focus action queues and approved operational capacity.&lt;/p&gt;\n\t\t\t&lt;div class=&apos;op-hero-meta&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-calendar-grid-58&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=selectedFYName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=selectedPlantName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=selectedLineName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;op-hero-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Capacity_TEP_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Capacity TEP Plan&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Operations_Production_Plans?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Production Plan&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Capacity_By_Line&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Capacity by Line&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Operations_Production_By_Product&apos;&gt;&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Production by Product&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;op-kpi-strip&apos;&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;op-kpi-title zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Pending Capacity&lt;/span&gt;&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=avPending%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;Draft, revised draft, submitted, and SCM revision Capacity TEP plans.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;op-kpi-title zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Pending Production&lt;/span&gt;&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=prodPending%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;Open Operations Production Plans requiring preparation or approval movement.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;op-kpi-title zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Approved Capacity&lt;/span&gt;&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=avApprovedFinal%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;&lt;%=totalAvailableHours%&gt; available hours and &lt;%=totalNetRunningHours%&gt; net running hours.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative op-kpi&apos;&gt;&lt;div class=&apos;zcs-card-header zcs-box-border&apos;&gt;&lt;h6 class=&apos;op-kpi-title zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Approved Production&lt;/span&gt;&lt;/h6&gt;&lt;/div&gt;&lt;div class=&apos;zcs-card-content zcs-box-border&apos;&gt;&lt;span class=&apos;op-kpi-value&apos;&gt;&lt;%=totalProductionTons%&gt;&lt;/span&gt;&lt;span class=&apos;op-kpi-caption&apos;&gt;FY production tons from &lt;%=prodApprovedFinal%&gt; approved or final plans.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\tif(selectedFYId == 0 || monthCount == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;op-empty zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-filter-card&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-calendar-date op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Active FY or month setup is incomplete&lt;/h5&gt;\n\t\t\t&lt;p&gt;Set one Financial Year as active and add included Financial Year Months. The action queue and matrices below will populate when operational plan records exist.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&apos;op-workbench&apos;&gt;\n\t\t&lt;div class=&apos;op-section op-focus-card zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3&gt;Planning focus&lt;/h3&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=focusMessage%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n&lt;%\n\tif(totalPending &gt; 0)\n\t{\n\t\t%&gt;\nAction Required\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\nClear\n&lt;%\n\t}\n\t%&gt;\n&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-focus-main&apos;&gt;\n\t\t\t\t&lt;div class=&apos;op-focus-score&apos;&gt;&lt;strong&gt;&lt;%=totalPending%&gt;&lt;/strong&gt;&lt;span&gt;Pending actions&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;p class=&apos;op-card-subtitle&apos;&gt;Scope: &lt;strong&gt;&lt;%=selectedScopeText%&gt;&lt;/strong&gt;. Approved and final rows are reserved for insight metrics; pending lists below include only Draft, Revised Draft, Submitted to Operations Approval, and Revision Requested by SCM.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&apos;op-focus-list&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;op-mini-stat&apos;&gt;&lt;b&gt;&lt;%=monthCount%&gt;&lt;/b&gt;&lt;span&gt;Included FY months&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;op-mini-stat&apos;&gt;&lt;b&gt;&lt;%=avgAvailability%&gt;%&lt;/b&gt;&lt;span&gt;Avg approved availability&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;op-mini-stat&apos;&gt;&lt;b&gt;&lt;%=avgUtilization%&gt;%&lt;/b&gt;&lt;span&gt;Avg approved utilization&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t\t\t&lt;div&gt;&lt;h3&gt;Quick links&lt;/h3&gt;&lt;p&gt;Open entry dialogs or the retained operational reports.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-quick-grid&apos;&gt;\n\t\t\t\t&lt;div class=&apos;op-quick-card&apos;&gt;&lt;div class=&apos;op-quick-copy&apos;&gt;&lt;span class=&apos;op-quick-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong&gt;Create Capacity TEP Plan&lt;/strong&gt;&lt;span&gt;Capture or revise available capacity.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Capacity_TEP_Plans?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Open&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;op-quick-card&apos;&gt;&lt;div class=&apos;op-quick-copy&apos;&gt;&lt;span class=&apos;op-quick-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong&gt;Create Production Plan&lt;/strong&gt;&lt;span&gt;Enter product-wise FY production.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Operations_Production_Plans?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;Open&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;op-quick-card&apos;&gt;&lt;div class=&apos;op-quick-copy&apos;&gt;&lt;span class=&apos;op-quick-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong&gt;Capacity by Line&lt;/strong&gt;&lt;span&gt;Review line-level approved and pending records.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Capacity_By_Line&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;View&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;op-quick-card&apos;&gt;&lt;div class=&apos;op-quick-copy&apos;&gt;&lt;span class=&apos;op-quick-icon&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-eye-17&apos;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div&gt;&lt;strong&gt;Production by Product&lt;/strong&gt;&lt;span&gt;Review product-wise production plans.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-13 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Operations_Production_By_Product&apos;&gt;&lt;span class=&apos;zcs-button-text&apos;&gt;View&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;op-filter-card zcs-card&apos;&gt;\n\t\t&lt;h3&gt;Filters&lt;/h3&gt;\n\t\t&lt;p&gt;Current filter: &lt;strong&gt;&lt;%=selectedFYName%&gt;&lt;/strong&gt;, &lt;strong&gt;&lt;%=selectedPlantName%&gt;&lt;/strong&gt;, &lt;strong&gt;&lt;%=selectedLineName%&gt;&lt;/strong&gt;. These links preserve the existing URL-parameter behavior.&lt;/p&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Financial Year&lt;/span&gt;&lt;a class=&apos;op-chip&apos; href=&apos;#Page:Operations_Landing&apos;&gt;Active FY&lt;/a&gt;\n&lt;%\n\tfyFilterRows = Financial_Years[Status != &quot;Archived&quot;] sort by Start_Date desc;\n\tfor each  fyOpt in fyFilterRows\n\t{\n\t\tfyUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + fyOpt.ID;\n\t\tif(selectedPlantId != 0)\n\t\t{\n\t\t\tfyUrl = fyUrl + &quot;&amp;Plant=&quot; + selectedPlantId;\n\t\t}\n\t\tif(selectedLineId != 0)\n\t\t{\n\t\t\tfyUrl = fyUrl + &quot;&amp;Production_Line=&quot; + selectedLineId;\n\t\t}\n\t\tchipClass = &quot;op-chip&quot;;\n\t\tif(fyOpt.ID == selectedFYId)\n\t\t{\n\t\t\tchipClass = &quot;op-chip active&quot;;\n\t\t}\n\t\t%&gt;\n&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=fyUrl%&gt;&apos;&gt;&lt;%=fyOpt.Year_Name%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Plant&lt;/span&gt;\n&lt;%\n\tallPlantUrl = &quot;#Page:Operations_Landing&quot;;\n\tif(selectedFYId != 0)\n\t{\n\t\tallPlantUrl = allPlantUrl + &quot;?Financial_Year=&quot; + selectedFYId;\n\t}\n\t%&gt;\n&lt;a class=&apos;op-chip&apos; href=&apos;&lt;%=allPlantUrl%&gt;&apos;&gt;All plants&lt;/a&gt;\n&lt;%\n\tplantRows = Plants[Active == true] sort by Plant_Name;\n\tfor each  plantOpt in plantRows\n\t{\n\t\tplantUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId + &quot;&amp;Plant=&quot; + plantOpt.ID;\n\t\tchipClass = &quot;op-chip&quot;;\n\t\tif(plantOpt.ID == selectedPlantId)\n\t\t{\n\t\t\tchipClass = &quot;op-chip active&quot;;\n\t\t}\n\t\t%&gt;\n&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=plantUrl%&gt;&apos;&gt;&lt;%=plantOpt.Plant_Name%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;div class=&apos;op-filter-row&apos;&gt;&lt;span class=&apos;op-filter-label&apos;&gt;Production Line&lt;/span&gt;\n&lt;%\n\tallLineUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId;\n\tif(selectedPlantId != 0)\n\t{\n\t\tallLineUrl = allLineUrl + &quot;&amp;Plant=&quot; + selectedPlantId;\n\t}\n\t%&gt;\n&lt;a class=&apos;op-chip&apos; href=&apos;&lt;%=allLineUrl%&gt;&apos;&gt;All lines&lt;/a&gt;\n&lt;%\n\tif(selectedPlantId != 0)\n\t{\n\t\tlineFilterRows = Production_Lines[Active == true &amp;&amp; Plant == selectedPlantId] sort by Line_Name;\n\t}\n\telse\n\t{\n\t\tlineFilterRows = Production_Lines[Active == true] sort by Line_Name;\n\t}\n\tfor each  lineOpt in lineFilterRows\n\t{\n\t\tlineUrl = &quot;#Page:Operations_Landing?Financial_Year=&quot; + selectedFYId;\n\t\tif(selectedPlantId != 0)\n\t\t{\n\t\t\tlineUrl = lineUrl + &quot;&amp;Plant=&quot; + selectedPlantId;\n\t\t}\n\t\tlineUrl = lineUrl + &quot;&amp;Production_Line=&quot; + lineOpt.ID;\n\t\tchipClass = &quot;op-chip&quot;;\n\t\tif(lineOpt.ID == selectedLineId)\n\t\t{\n\t\t\tchipClass = &quot;op-chip active&quot;;\n\t\t}\n\t\t%&gt;\n&lt;a class=&apos;&lt;%=chipClass%&gt;&apos; href=&apos;&lt;%=lineUrl%&gt;&apos;&gt;&lt;%=lineOpt.Line_Name%&gt;&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t\t&lt;div&gt;&lt;h3&gt;Pending status mix&lt;/h3&gt;&lt;p&gt;Only statuses that require planning action are shown here.&lt;/p&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;op-status-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Draft&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=draftTotal%&gt;&lt;/b&gt;&lt;small&gt;Capacity &lt;%=avDraft%&gt;, Production &lt;%=prodDraft%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Revised Draft&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=revisedDraftTotal%&gt;&lt;/b&gt;&lt;small&gt;Capacity &lt;%=avRevisedDraft%&gt;, Production &lt;%=prodRevisedDraft%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;Submitted&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=submittedTotal%&gt;&lt;/b&gt;&lt;small&gt;Capacity &lt;%=avSubmitted%&gt;, Production &lt;%=prodSubmitted%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;op-status-box&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span&gt;SCM Revision&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;%=revisionTotal%&gt;&lt;/b&gt;&lt;small&gt;Capacity &lt;%=avRevision%&gt;, Production &lt;%=prodRevision%&gt;&lt;/small&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;op-tables-grid&apos;&gt;\n\t\t&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;op-section-head&apos;&gt;&lt;div&gt;&lt;h3&gt;Pending action table&lt;/h3&gt;&lt;p&gt;Approved, locked, superseded, and returned records are intentionally excluded.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Capacity TEP&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Production&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Next action&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;4&apos;&gt; &lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Draft&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=avDraft%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=prodDraft%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;Complete plan data&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Revised Draft&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=avRevisedDraft%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=prodRevisedDraft%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;Submit revised version&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Submitted to Operations Approval&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=avSubmitted%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=prodSubmitted%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&apos;&gt;Review approval queue&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Revision Requested by SCM&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=avRevision%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=prodRevision%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;Address SCM comments&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;span class=&apos;op-table-note&apos;&gt;Pending total: &lt;strong&gt;&lt;%=totalPending%&gt;&lt;/strong&gt; across Capacity TEP and Operations Production plans.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t\t\t&lt;div class=&apos;op-section-head&apos;&gt;&lt;div&gt;&lt;h3&gt;Approved-capacity insights&lt;/h3&gt;&lt;p&gt;Approved or final records contribute here only, keeping action lists focused.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Insight&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Value&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Basis&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;3&apos;&gt; &lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Capacity plans approved/final&lt;/td&gt;&lt;td class=&apos;op-insight-value zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=avApprovedFinal%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;Capacity_TEP_Plans&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Annual available hours&lt;/td&gt;&lt;td class=&apos;op-insight-value zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=totalAvailableHours%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;Approved/final capacity rows&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Annual net running hours&lt;/td&gt;&lt;td class=&apos;op-insight-value zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=totalNetRunningHours%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;After planned and unplanned downtime&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Average availability / utilization&lt;/td&gt;&lt;td class=&apos;op-insight-value zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=avgAvailability%&gt;% / &lt;%=avgUtilization%&gt;%&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;Approved/final capacity averages&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Production tons approved/final&lt;/td&gt;&lt;td class=&apos;op-insight-value zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-lh-body&apos;&gt;&lt;%=totalProductionTons%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;&lt;%=prodApprovedFinal%&gt; Operations_Production_Plans&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;span class=&apos;op-table-note&apos;&gt;Use the embedded matrices below for month-wise approved capacity and production distribution.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Availability_Matrix' elementName='Operations_Availability_Matrix'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Availability_Matrix()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedFYId = 0;\n\tselectedFYName = &quot;No active financial year&quot;;\n\tif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n\t{\n\t\tfyRows = Financial_Years[ID == input.Financial_Year];\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tselectedPlantId = 0;\n\tif(input.Plant != null &amp;&amp; input.Plant != 0)\n\t{\n\t\tselectedPlantId = input.Plant;\n\t}\n\tselectedLineId = 0;\n\tif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n\t{\n\t\tselectedLineId = input.Production_Line;\n\t}\n\tmonthRows = Financial_Year_Months[ID == 0];\n\tif(selectedFYId != 0)\n\t{\n\t\tmonthRows = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true] sort by Month_Order;\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tapprovedAvailabilityPlans = Capacity_TEP_Plans[ID == 0];\n\t}\n\telse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n\t{\n\t\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse if(selectedPlantId != 0)\n\t{\n\t\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse if(selectedLineId != 0)\n\t{\n\t\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse\n\t{\n\t\tapprovedAvailabilityPlans = Capacity_TEP_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\t%&gt;\n&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3&gt;Plant and Line Availability Matrix&lt;/h3&gt;\n\t\t\t&lt;p&gt;Approved capacity TEP plans across configured FY months for &lt;strong&gt;&lt;%=selectedFYName%&gt;&lt;/strong&gt;.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approvedAvailabilityPlans.count()%&gt; Approved&lt;/span&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n&lt;%\n\tif(selectedFYId == 0 || monthRows.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline files-2-folder-15 op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No FY month setup found&lt;/h5&gt;\n\t\t\t&lt;p&gt;Mark a financial year as active and configure included Financial Year Months before reviewing availability.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse if(approvedAvailabilityPlans.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-ban-bold op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No approved availability plan&lt;/h5&gt;\n\t\t\t&lt;p&gt;Adjust filters or approve a Capacity TEP Plan for the selected FY, plant, and production line.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper op-matrix-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full op-matrix-table&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;op-sticky-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Availability Metric&lt;/th&gt;\n&lt;%\n\t\tfor each  monthRec in monthRows\n\t\t{\n\t\t\t%&gt;\n&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthRec.Month_Label%&gt;&lt;/th&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;FY Total&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;&lt;%=monthRows.count() + 2%&gt;&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tmetrics = {&quot;Calendar Hrs&quot;,&quot;Holidays&quot;,&quot;Planned Down Time&quot;,&quot;Capital Shutdown&quot;,&quot;Setup Change Time&quot;,&quot;Steckel Mill Work Roll Change&quot;,&quot;Roughing Mill Work Roll Change&quot;,&quot;Available Hrs&quot;,&quot;Unforeseen Delay/Breakdowns&quot;,&quot;Net Running Hrs&quot;,&quot;Equipment Availability&quot;,&quot;Equipment Utilization&quot;};\n\t\tfor each  metric in metrics\n\t\t{\n\t\t\tisPercent = metric == &quot;Equipment Availability&quot; || metric == &quot;Equipment Utilization&quot;;\n\t\t\tfyTotal = 0.0;\n\t\t\tfyCount = 0;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;op-sticky-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=metric%&gt;&lt;/td&gt;\n&lt;%\n\t\t\tfor each  monthRec in monthRows\n\t\t\t{\n\t\t\t\tcellValue = 0.0;\n\t\t\t\tcellCount = 0;\n\t\t\t\tfor each  planRec in approvedAvailabilityPlans\n\t\t\t\t{\n\t\t\t\t\tfor each  monthLine in planRec.Monthly_Availability_Lines_Existing\n\t\t\t\t\t{\n\t\t\t\t\t\tif(monthLine.Month_Order == monthRec.Month_Order)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tlineValue = 0.0;\n\t\t\t\t\t\t\tif(metric == &quot;Calendar Hrs&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Calendar_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Holidays&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Holidays_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Planned Down Time&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Planned_Down_Time_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Capital Shutdown&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Capital_Shutdown_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Setup Change Time&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Setup_Change_Time_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Steckel Mill Work Roll Change&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Steckel_Mill_Work_Roll_Change_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Roughing Mill Work Roll Change&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Roughing_Mill_Work_Roll_Change_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Available Hrs&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Available_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Unforeseen Delay/Breakdowns&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Unforeseen_Delay_Breakdowns_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Net Running Hrs&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Net_Running_Hours,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Equipment Availability&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Equipment_Availability_Percent,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(metric == &quot;Equipment Utilization&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlineValue = ifnull(monthLine.Equipment_Utilization_Percent,0.0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tcellValue = cellValue + lineValue;\n\t\t\t\t\t\t\tcellCount = cellCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(isPercent &amp;&amp; cellCount &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tcellValue = cellValue / cellCount;\n\t\t\t\t\tfyTotal = fyTotal + cellValue;\n\t\t\t\t\tfyCount = fyCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(!isPercent)\n\t\t\t\t{\n\t\t\t\t\tfyTotal = fyTotal + cellValue;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=cellValue%&gt;\n&lt;%\n\t\t\t\tif(isPercent)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n%\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/td&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(isPercent &amp;&amp; fyCount &gt; 0)\n\t\t\t{\n\t\t\t\tfyTotal = fyTotal / fyCount;\n\t\t\t}\n\t\t\t%&gt;\n&lt;td class=&apos;op-total-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=fyTotal%&gt;\n&lt;%\n\t\t\tif(isPercent)\n\t\t\t{\n\t\t\t\t%&gt;\n%\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Production_Matrix' elementName='Operations_Production_Matrix'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Production_Matrix()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tselectedFYId = 0;\n\tselectedFYName = &quot;No active financial year&quot;;\n\tif(input.Financial_Year != null &amp;&amp; input.Financial_Year != 0)\n\t{\n\t\tfyRows = Financial_Years[ID == input.Financial_Year];\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tfyRows = Financial_Years[Active == true] sort by Start_Date desc;\n\t\tfor each  fyRec in fyRows\n\t\t{\n\t\t\tif(selectedFYId == 0)\n\t\t\t{\n\t\t\t\tselectedFYId = fyRec.ID;\n\t\t\t\tselectedFYName = fyRec.Year_Name;\n\t\t\t}\n\t\t}\n\t}\n\tselectedPlantId = 0;\n\tif(input.Plant != null &amp;&amp; input.Plant != 0)\n\t{\n\t\tselectedPlantId = input.Plant;\n\t}\n\tselectedLineId = 0;\n\tif(input.Production_Line != null &amp;&amp; input.Production_Line != 0)\n\t{\n\t\tselectedLineId = input.Production_Line;\n\t}\n\tmonthRows = Financial_Year_Months[ID == 0];\n\tif(selectedFYId != 0)\n\t{\n\t\tmonthRows = Financial_Year_Months[Financial_Year == selectedFYId &amp;&amp; Included == true] sort by Month_Order;\n\t}\n\tif(selectedFYId == 0)\n\t{\n\t\tapprovedProductionPlans = Operations_Production_Plans[ID == 0];\n\t}\n\telse if(selectedPlantId != 0 &amp;&amp; selectedLineId != 0)\n\t{\n\t\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse if(selectedPlantId != 0)\n\t{\n\t\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Plant == selectedPlantId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse if(selectedLineId != 0)\n\t{\n\t\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Production_Line == selectedLineId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\telse\n\t{\n\t\tapprovedProductionPlans = Operations_Production_Plans[Requested_Financial_Year == selectedFYId &amp;&amp; Status == &quot;Operations Approved&quot;] sort by Operations_Approved_On desc;\n\t}\n\tproductKeys = list();\n\tfor each  planRec in approvedProductionPlans\n\t{\n\t\tfor each  productionRow in planRec.Product_Production_Lines_Existing\n\t\t{\n\t\t\tproductTextForKey = &quot;&quot;;\n\t\t\tif(productionRow.Product != null)\n\t\t\t{\n\t\t\t\tproductTextForKey = productionRow.Product.Grade_Code;\n\t\t\t}\n\t\t\trowKey = productTextForKey + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\tif(!productKeys.contains(rowKey))\n\t\t\t{\n\t\t\t\tproductKeys.add(rowKey);\n\t\t\t}\n\t\t}\n\t}\n\t%&gt;\n&lt;div class=&apos;op-section zcs-card&apos;&gt;\n\t&lt;div class=&apos;op-section-head&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3&gt;Product Production Plan Matrix&lt;/h3&gt;\n\t\t\t&lt;p&gt;Product, series, size, productivity, month-wise production tons, and FY totals from approved operations production plans.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approvedProductionPlans.count()%&gt; Approved&lt;/span&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n&lt;%\n\tif(selectedFYId == 0 || monthRows.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline files-2-folder-15 op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No FY month setup found&lt;/h5&gt;\n\t\t\t&lt;p&gt;Configure included Financial Year Months before reviewing production plans.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse if(productKeys.size() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center op-empty&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-ban-bold op-empty-icon&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No approved production plan&lt;/h5&gt;\n\t\t\t&lt;p&gt;Adjust filters or approve an Operations Production Plan for the selected FY, plant, and production line.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper op-matrix-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full op-matrix-table op-production-table&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;op-sticky-col op-product-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Product/Series&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Width&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Thickness&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Productivity&lt;/th&gt;\n&lt;%\n\t\tfor each  monthRec in monthRows\n\t\t{\n\t\t\t%&gt;\n&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthRec.Month_Label%&gt;&lt;/th&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;FY Total&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;&lt;%=monthRows.count() + 5%&gt;&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each  productKey in productKeys\n\t\t{\n\t\t\tproductText = &quot;&quot;;\n\t\t\tseriesText = &quot;&quot;;\n\t\t\twidthText = &quot;&quot;;\n\t\t\tthicknessText = &quot;&quot;;\n\t\t\tproductivityText = &quot;&quot;;\n\t\t\tfor each  planRec in approvedProductionPlans\n\t\t\t{\n\t\t\t\tfor each  productionRow in planRec.Product_Production_Lines_Existing\n\t\t\t\t{\n\t\t\t\t\tprodCode = &quot;&quot;;\n\t\t\t\t\tif(productionRow.Product != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tprodCode = productionRow.Product.Grade_Code;\n\t\t\t\t\t}\n\t\t\t\t\trowKey = prodCode + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\tif(rowKey == productKey &amp;&amp; productText == &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tproductText = prodCode;\n\t\t\t\t\t\tseriesText = ifnull(productionRow.Series,&quot;&quot;);\n\t\t\t\t\t\twidthText = ifnull(productionRow.Width,&quot;&quot;);\n\t\t\t\t\t\tthicknessText = ifnull(productionRow.Thickness,&quot;&quot;);\n\t\t\t\t\t\tproductivityText = ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tfyTotal = 0.0;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;op-sticky-col op-product-col zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;strong&gt;&lt;%=productText%&gt;&lt;/strong&gt;&lt;span&gt;&lt;%=seriesText%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=widthText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=thicknessText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=productivityText%&gt;&lt;/td&gt;\n&lt;%\n\t\t\tfor each  monthRec in monthRows\n\t\t\t{\n\t\t\t\tmonthTotal = 0.0;\n\t\t\t\tfor each  planRec in approvedProductionPlans\n\t\t\t\t{\n\t\t\t\t\tfor each  productionRow in planRec.Product_Production_Lines_Existing\n\t\t\t\t\t{\n\t\t\t\t\t\tprodCode = &quot;&quot;;\n\t\t\t\t\t\tif(productionRow.Product != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tprodCode = productionRow.Product.Grade_Code;\n\t\t\t\t\t\t}\n\t\t\t\t\t\trowKey = prodCode + &quot;|&quot; + ifnull(productionRow.Series,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Width,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Thickness,&quot;&quot;) + &quot;|&quot; + ifnull(productionRow.Productivity_MTPH,&quot;&quot;);\n\t\t\t\t\t\tif(rowKey == productKey &amp;&amp; productionRow.Month_Order == monthRec.Month_Order)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmonthTotal = monthTotal + ifnull(productionRow.Production_Tons,0.0);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfyTotal = fyTotal + monthTotal;\n\t\t\t\t%&gt;\n&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=monthTotal%&gt;&lt;/td&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;td class=&apos;op-total-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=fyTotal%&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Capacity_By_Line_Embed' title='Capacity by Line' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Capacity_By_Line' iszreport='false' zc_Footer='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Operations_Production_By_Product_Embed' title='Operations Production by Product' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Operations_Production_By_Product' iszreport='false' zc_Footer='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Planning_Workbench
		{
					displayname = "Planning Workbench"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='My_Task_Cards' elementName='My_Task_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage My_Task_Cards()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tloginName = zoho.loginuser;\n\tisAdmin = thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;);\n\tisFinance = thisapp.permissions.isUserInProfile(&quot;Finance_Costing&quot;);\n\tisSales = thisapp.permissions.isUserInProfile(&quot;Sales_Team&quot;);\n\tisCOE = thisapp.permissions.isUserInProfile(&quot;COE_Team&quot;);\n\tisSCM = thisapp.permissions.isUserInProfile(&quot;SCM_Central_PPC&quot;);\n\tisOps = thisapp.permissions.isUserInProfile(&quot;Operations_PPC&quot;);\n\tisSMS = thisapp.permissions.isUserInProfile(&quot;SMS_Team&quot;);\n\tisSourcing = thisapp.permissions.isUserInProfile(&quot;Sourcing_Team&quot;);\n\tisPlantOps = thisapp.permissions.isUserInProfile(&quot;Plant_Operations&quot;);\n\tisSalesMgmt = thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;);\n\tisExec = thisapp.permissions.isUserInProfile(&quot;Executive_Management&quot;);\n\tisAuditor = thisapp.permissions.isUserInProfile(&quot;Auditor&quot;);\n\tprofileText = &quot;&quot;;\n\tif(isAdmin)\n\t{\n\t\tprofileText = profileText + &quot;System Administrator, &quot;;\n\t}\n\tif(isFinance)\n\t{\n\t\tprofileText = profileText + &quot;Finance Costing, &quot;;\n\t}\n\tif(isSales)\n\t{\n\t\tprofileText = profileText + &quot;Sales Team, &quot;;\n\t}\n\tif(isCOE)\n\t{\n\t\tprofileText = profileText + &quot;COE Team, &quot;;\n\t}\n\tif(isSCM)\n\t{\n\t\tprofileText = profileText + &quot;SCM Central PPC, &quot;;\n\t}\n\tif(isOps)\n\t{\n\t\tprofileText = profileText + &quot;Operations PPC, &quot;;\n\t}\n\tif(isSMS)\n\t{\n\t\tprofileText = profileText + &quot;SMS Team, &quot;;\n\t}\n\tif(isSourcing)\n\t{\n\t\tprofileText = profileText + &quot;Sourcing Team, &quot;;\n\t}\n\tif(isPlantOps)\n\t{\n\t\tprofileText = profileText + &quot;Plant Operations, &quot;;\n\t}\n\tif(isSalesMgmt)\n\t{\n\t\tprofileText = profileText + &quot;Sales Management, &quot;;\n\t}\n\tif(isExec)\n\t{\n\t\tprofileText = profileText + &quot;Executive Management, &quot;;\n\t}\n\tif(isAuditor)\n\t{\n\t\tprofileText = profileText + &quot;Auditor, &quot;;\n\t}\n\tif(profileText == &quot;&quot;)\n\t{\n\t\tprofileText = &quot;Operational user&quot;;\n\t}\n\tmySalesItems = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmyShutdownItems = Shutdown_Schedules[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tmyCapacityItems = Capacity_TEP_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot; &amp;&amp; Status != &quot;Operations Approved&quot; &amp;&amp; Status != &quot;Superseded&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmySMSItems = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Accepted&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmyVolumeItems = Volume_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot; &amp;&amp; Status != &quot;SCM Approved&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmyRMItems = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sourcing Manager&quot; || Status == &quot;Returned by Finance&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmyConsumableItems = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tmyFinanceItems = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Management&quot; || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinanceDecisionItems = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tmyReplanningItems = Replanning_Requests[Requested_By_Email == loginEmail || Requested_By_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Rejected&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tmyEntryItems = mySalesItems + myShutdownItems + myCapacityItems + mySMSItems + myVolumeItems + myRMItems + myConsumableItems + myFinanceItems + myReplanningItems;\n\treturnedItems = mySalesItems + myCapacityItems + mySMSItems + myVolumeItems + myRMItems + myConsumableItems + myFinanceItems;\n\tapprovalItems = 0;\n\tif(isCOE || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\t}\n\tif(isSCM || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\t}\n\tif(isOps || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Capacity_TEP_Plans[Status == &quot;Submitted to Operations Approval&quot;].count() + Operations_Production_Plans[Status == &quot;Submitted to Operations Approval&quot;].count();\n\t}\n\tif(isSalesMgmt || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\t}\n\tif(isSCM || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\t}\n\tif(isFinance || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Raw_Material_Budgets[Status == &quot;Submitted to Finance&quot;].count() + Consumables_Budgets[Status == &quot;Submitted to Finance&quot;].count() + Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot;].count();\n\t}\n\tif(isExec || isAdmin)\n\t{\n\t\tapprovalItems = approvalItems + Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\t}\n\tshortfallItems = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Locked != true].count();\n\tcriticalEvents = Approval_Audit_Log[Action in {&quot;Returned&quot;,&quot;Reopened&quot;,&quot;Locked&quot;,&quot;Final Approved&quot;}].count();\n\tactiveReplans = Replanning_Requests[Status in {&quot;Submitted to Finance&quot;,&quot;Finance Approved&quot;,&quot;Revision Created&quot;} &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-row-wrap{flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}.zcs-cursor-pointer{cursor:pointer}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}.zcs-m-0{margin:0}.zcs-mt-16{margin-top:1rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-6{padding-left:.375rem;padding-right:.375rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-pb-0{padding-bottom:0}.zcs-pl-24{padding-left:1.5rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs_primary_text_color)}.zcs-color-secondary{color:var(--zcs_secondary_text_color)}.zcs-color-tertiary{color:var(--zcs_tertiary_text_color)}.zcs-color-white{color:var(--zcs-white-color)}a{text-decoration:none}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598E}.zcs-color-l_blue{color:#1094C5}\n/* Badge with Icon */\n.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#e8e8e8;border-color:#242424;color:#242424}\n/* Primary Outline Button No Icon */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-fw-button{width:100%}\n/* Simple Table */\n.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr td.zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-l_blue{color:#1094c5}\n/* Outline Banner with Icon */\n.zcs-outline-toast{border:1px solid}.zcs-theme-toast{background-color:var(--zcs_component_hover_color)}.zcs-outline-toast.zcs-theme-toast{border:1px solid var(--zcs_brand_color)}.zcs-warning-toast{background-color:#fef4e5;color:#663c01}.zcs-info-toast{background-color:#e4f6fd;color:#024361}.zcs-toast-link:hover{text-decoration:underline}\n/* Card Type Quick Actions */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:none}\n/* Notes With List */\n.zcs-notes-wrapper ul{list-style-type:disc}.zcs-notes-wrapper ul li::marker{color:var(--zcs_tertiary_text_color)}\n/* Planning Workbench custom layout */\n.pw-shell{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box}.pw-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;box-sizing:border-box;overflow:hidden;position:relative}.pw-hero:after{content:&quot;&quot;;position:absolute;right:-70px;top:-80px;width:220px;height:220px;border:32px solid rgba(255,255,255,.12);border-radius:50%}.pw-hero h2{margin:0 0 6px 0;font-size:24px;line-height:1.2}.pw-hero p{margin:0;opacity:.88}.pw-card-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.pw-metric-card{min-height:126px}.pw-metric-icon{width:42px;height:42px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.pw-metric-value{font-size:30px;font-weight:700;line-height:1;color:var(--zcs_primary_text_color)}.pw-metric-label{color:var(--zcs_secondary_text_color)}.pw-small-link{color:var(--zcs_brand_color);font-size:13px;font-weight:500}.pw-queue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pw-queue-card{min-height:210px}.pw-queue-card h5{margin:0}.pw-queue-actions{margin-top:auto}.pw-muted{color:var(--zcs_tertiary_text_color)}.pw-report-note{margin:12px 0 0}.pw-guidance-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.pw-step{border-left:3px solid var(--zcs_brand_color);padding-left:12px}.pw-report-wrap{padding:8px 20px;background:var(--zcs-page-bg-color)}\n@media(max-width:1100px){.pw-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pw-queue-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:700px){.pw-shell{padding:12px}.pw-card-grid,.pw-queue-grid,.pw-guidance-grid{grid-template-columns:1fr}.pw-hero{padding:18px}}\n&lt;/style&gt;\n&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;pw-hero zcs-flex zcs-justify-space-between zcs-gap-16 zcs-align-items-center&apos;&gt;\n\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t&lt;h2&gt;Planning Workbench&lt;/h2&gt;\n\t\t\t&lt;p&gt;Signed in as &lt;strong&gt;&lt;%=loginName%&gt;&lt;/strong&gt;. Queues are inferred from your profile, delegated authority and record status.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-badge-icon zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14&apos;&gt;&lt;%=profileText%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-card-grid&apos;&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Open&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=myEntryItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;My draft, returned or reopened entries&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;Open my sales workqueue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Action&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=approvalItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Approval or validation items visible to your role&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:Sales_Plan_Approval_Queue&apos;&gt;Open sales approval queue&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Exception&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=shortfallItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Amber or red volume shortfall buckets&lt;/div&gt;\n\t\t\t&lt;a class=&apos;pw-small-link&apos; href=&apos;#Report:Shortfall_Buckets&apos;&gt;Review shortfalls&lt;/a&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\tif(scenarioCycleId != 0)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos; href=&apos;&lt;%=scenarioComparisonUrl%&gt;&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-pie-36 zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Compare&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;&lt;%=financeDecisionItems%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;Submitted management scenarios for &lt;%=scenarioCycleName%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&apos;pw-small-link&apos;&gt;Open scenario comparison dashboard&lt;/span&gt;\n\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-metric-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos; style=&apos;opacity:.72;&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;pw-metric-icon zcs-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-22&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-grey zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Empty&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-value&apos;&gt;0&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-metric-label zcs-font-14&apos;&gt;No active/open Budget Cycle is available for comparison&lt;/div&gt;\n\t\t\t&lt;span class=&apos;pw-small-link&apos;&gt;Comparison disabled&lt;/span&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Department_Queue_Grid' elementName='Department_Queue_Grid'>\n\t\t\t\t\t<![CDATA[htmlpage Department_Queue_Grid()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tloginName = zoho.loginuser;\n\tisAdmin = thisapp.permissions.isUserInProfile(&quot;System_Administrator&quot;);\n\tisFinance = thisapp.permissions.isUserInProfile(&quot;Finance_Costing&quot;);\n\tisSales = thisapp.permissions.isUserInProfile(&quot;Sales_Team&quot;);\n\tisCOE = thisapp.permissions.isUserInProfile(&quot;COE_Team&quot;);\n\tisSCM = thisapp.permissions.isUserInProfile(&quot;SCM_Central_PPC&quot;);\n\tisOps = thisapp.permissions.isUserInProfile(&quot;Operations_PPC&quot;);\n\tisSMS = thisapp.permissions.isUserInProfile(&quot;SMS_Team&quot;);\n\tisSourcing = thisapp.permissions.isUserInProfile(&quot;Sourcing_Team&quot;);\n\tisPlantOps = thisapp.permissions.isUserInProfile(&quot;Plant_Operations&quot;);\n\tisSalesMgmt = thisapp.permissions.isUserInProfile(&quot;Sales_Management&quot;);\n\tisExec = thisapp.permissions.isUserInProfile(&quot;Executive_Management&quot;);\n\tisAuditor = thisapp.permissions.isUserInProfile(&quot;Auditor&quot;);\n\tsalesMine = Sales_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sales Management&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tsalesApproval = Sales_Plans[Status == &quot;Submitted to Sales Management&quot;].count();\n\tshutdownMine = Shutdown_Schedules[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tshutdownReady = Shutdown_Schedules[Status == &quot;Submitted&quot;].count();\n\tcapacityMine = Capacity_TEP_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Operations Approval&quot; || Status == &quot;Revision Requested by SCM&quot; || Status == &quot;Revised Draft&quot;].count();\n\tcapacityApproval = Capacity_TEP_Plans[Status == &quot;Submitted to Operations Approval&quot;].count();\n\tsmsMine = SMS_Capacity_Plans[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Reopened&quot;].count();\n\tsmsApproval = SMS_Capacity_Plans[Status == &quot;Submitted to Central PPC&quot;].count();\n\tvolumeMine = Volume_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Under SCM Review&quot; || Status == &quot;Revision Requested&quot;].count();\n\tvolumeApproval = Volume_Consolidations[Status == &quot;Under SCM Review&quot;].count();\n\tvolumeShortfalls = Volume_Consolidations[Status == &quot;Revision Requested&quot; || Status == &quot;Sales Revision Pending&quot; || Status == &quot;Operations Revision Pending&quot; || Status == &quot;Both Revisions Pending&quot;].count();\n\trmMine = Raw_Material_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Returned by Sourcing Manager&quot; || Status == &quot;Returned by Finance&quot;].count();\n\trmApproval = Raw_Material_Budgets[Status == &quot;Submitted to Sourcing Manager&quot; || Status == &quot;Submitted to Finance&quot;].count();\n\tconsMine = Consumables_Budgets[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot;].count();\n\tconsApproval = Consumables_Budgets[Status == &quot;Submitted to Plant Manager&quot; || Status == &quot;Submitted to Finance&quot;].count();\n\tfinanceMine = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status.contains(&quot;Returned&quot;) || Status == &quot;Reopened&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\tfinanceApproval = Financial_Consolidations[Status == &quot;Submitted to Management&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Locked != true].count();\n\treplanMine = Replanning_Requests[Requested_By_Email == loginEmail || Requested_By_Email == loginName &amp;&amp; Status == &quot;Draft&quot; || Status == &quot;Rejected&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\treplanApproval = Replanning_Requests[Status == &quot;Submitted to Finance&quot; || Status == &quot;Finance Approved&quot; || Status == &quot;Revision Created&quot; &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot;].count();\n\tscenarioCycleId = 0;\n\tscenarioCycleName = &quot;&quot;;\n\tfor each  cycleRec in Budget_Cycles[Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Locked&quot; &amp;&amp; Status != &quot;Approved Final&quot; &amp;&amp; Baseline_Locked != true &amp;&amp; Approved_Scenario != true] sort by Opened_Date desc range from 0 to 0\n\t{\n\t\tscenarioCycleId = cycleRec.ID;\n\t\tscenarioCycleName = ifNull(cycleRec.Cycle_Name,ifNull(cycleRec.Cycle_Code,&quot;Active cycle&quot;));\n\t}\n\tscenarioComparisonUrl = &quot;&quot;;\n\tif(scenarioCycleId != 0)\n\t{\n\t\tscenarioComparisonUrl = &quot;#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=&quot; + scenarioCycleId;\n\t}\n\t%&gt;\n&lt;div class=&apos;pw-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16 zcs-pb-0&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Department queues&lt;/h3&gt;\n\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Each card exposes the report and entry form for modules your profile can operate. Counts are based on ownership, approval status and exception status.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-lh-body&apos; href=&apos;#Report:Critical_Audit_Events&apos;&gt;Audit events&lt;/a&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;pw-queue-grid zcs-py-16&apos;&gt;\n&lt;%\n\tif(isSales || isCOE || isSCM || isOps || isSalesMgmt || isFinance || isAdmin || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Sales Plans&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Sales entry, COE, SCM, Operations and management approval stages.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline business-chart-bar-32 zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;Mine &lt;%=salesMine%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;Approvals &lt;%=salesApproval%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;pw-queue-actions zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Report:My_Sales_Plan_Workqueue&apos;&gt;My workqueue&lt;/a&gt;&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&apos; href=&apos;#Form:Sales_Plans?zc_LoadIn=dialog&apos;&gt;New plan&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(isOps || isSCM || isFinance || isAdmin || isAuditor)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;pw-queue-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;&lt;div&gt;&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-color-primary&apos;&gt;Shutdowns&lt;/h5&gt;&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Planned downtime by line feeding capacity.&lt;/p&gt;&lt;/div&gt;&lt;i class=&apos;zc-li-outline transport-traffic zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8 zcs-row-wrap&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-13&apos;&gt;Mine &lt;%=shutdownMine%&gt;&lt;/span&gt;&lt;span c