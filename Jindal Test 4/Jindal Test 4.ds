			SCM_Decision_On_User_Input as "SCM Decision On User Input"
			{
			
							type =  form
							form = Volume_Consolidations
			
							record event = on add or edit
			
							on user input of SCM_Decision
							{
								actions 
								{
									custom deluge script
									(
														if(input.SCM_Decision == "Request Sales Revision" || input.SCM_Decision == "Request Operations Revision" || input.SCM_Decision == "Request Sales and Operations Revision")
													{
														show SCM_Comments;
														show Approval_Remarks;
														enable Approval_Remarks;
													}
