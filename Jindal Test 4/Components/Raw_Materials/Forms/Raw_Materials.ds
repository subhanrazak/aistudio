form Raw_Materials
{

			displayname = "Raw Materials"
			Material_Details
			(
				type = section
				displayname = "Material Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Material_Code
			(
    			type = text
				displayname = "Material Code"
				maxchar = 30
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Material_Name
			(
    			type = text
				displayname = "Material Name"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Material_Group
			(
				type = picklist
				displayname = "Material Group"
				values = {"Nickel","Chrome","Iron","Scrap","NPI","Ferro-Alloy","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Unit_Of_Measure
			(
				type = picklist
				displayname = "Unit Of Measure"
				values = {"MT","KG","Ton"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Nickel_Source
			(
    			type = checkbox
				displayname = "Is Nickel Source"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}