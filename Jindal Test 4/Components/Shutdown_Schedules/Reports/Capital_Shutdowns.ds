list Capital_Shutdowns
{

			displayName = "Capital Shutdowns"
			show all rows from Shutdown_Schedules  [Shutdown_Type == "Capital"]  
			(
				Shutdown_No
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Annual_Shutdown_Days
				Annual_Shutdown_Hours
				Status
				Approval_Remarks
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Status
			)
			sort by
			(
				Budget_Cycle descending
				Production_Line ascending
			)
		
}