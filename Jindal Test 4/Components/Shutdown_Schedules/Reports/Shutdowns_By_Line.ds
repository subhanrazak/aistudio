list Shutdowns_By_Line
{

			displayName = "Shutdowns By Line"
			show all rows from Shutdown_Schedules    
			(
				Shutdown_No
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Annual_Shutdown_Days
				Annual_Shutdown_Hours
				Status
				Locked
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Status
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Production_Line ascending
			)
			sort by
			(
				Budget_Cycle descending
				Production_Line ascending
			)
		
}