form Shutdown_Schedules
{

			displayname = "Shutdown Schedules"
			Schedule_Details
			(
				type = section
				displayname = "Schedule Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Shutdown_No
			(
    			type = autonumber
				displayname = "Shutdown No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Production_Line
			(
				type = picklist	
				displayname = "Production Line"
				values  = Production_Lines.ID
    			displayformat = [Line_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Shutdown_Type
			(
				type = picklist
				displayname = "Shutdown Type"
				values = {"Capital","Planned Maintenance","Project","Routine"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Monthly_Shutdown_Days
			(
				type = section
				displayname = "Monthly Shutdown Days"
				visibility = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Monthly_Shutdowns_Existing
			(
				type = grid
				displayname = "Monthly Shutdowns"
				values = Monthly_Shutdowns.ID
				defaultrow = 1
				maxrow = 12
	 			row = 2
	 			column = 1   
				width = medium
			)
			Shutdown_Totals
			(
				type = section
				displayname = "Shutdown Totals"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Annual_Shutdown_Days
			(
				type = decimal
				displayname = "Annual Shutdown Days"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Annual_Shutdown_Hours
			(
				type = decimal
				displayname = "Annual Shutdown Hours"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted","Available to Capacity","Reopened","Locked"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Reopen","Lock"}
	 			row = 4
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 13px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 4
	 			column = 2   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}