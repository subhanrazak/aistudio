WF_Shutdown_Approve as "Mark Available to Capacity"
{

				type =  functions
				form = Shutdown_Schedules
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Submitted")
										{
											input.Status = "Available to Capacity";
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Shutdown Schedule"
												Related_Record_ID=input.ID
												Related_Record_Display="Shutdown " + input.Shutdown_No
												Action="Approved"
												From_Status=oldStatus
												To_Status="Available to Capacity"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Marked available to capacity from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}