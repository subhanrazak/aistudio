WF_Shutdown_Reopen as "Reopen Shutdown"
{

				type =  functions
				form = Shutdown_Schedules
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Shutdown_Schedules?recLinkID=" + input.ID + "&viewLinkName=All_Shutdown_Schedules&Approver_Action=Reopen&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}