WF_Shutdown_Reopen as "Reopen Shutdown"
{

				type =  functions
				form = Shutdown_Schedules
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Locked")
										{
											input.Status = "Reopened";
											input.Locked = false;
											input.Approver_Action = null;
											remarksText = input.Approval_Remarks;
											if(remarksText == null || remarksText == "")
											{
												remarksText = "Reopened from report action.";
											}
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Shutdown Schedule"
												Related_Record_ID=input.ID
												Related_Record_Display="Shutdown " + input.Shutdown_No
												Action="Reopened"
												From_Status=oldStatus
												To_Status="Reopened"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=remarksText
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}