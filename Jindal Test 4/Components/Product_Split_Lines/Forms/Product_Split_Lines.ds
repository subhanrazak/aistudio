form Product_Split_Lines
{
	displayname = "Product Split Lines"
	Product_Split_Details
	(
		type = section
		displayname = "Product Split Details"
		row = 1
		column = 0
		width = medium
	)
	must have Grade
	(
		type = picklist
		values = Market_Segments.ID
		displayformat = [Segment_Name]
		row = 1
		column = 1
		width = medium
	)
	must have Product
	(
		type = picklist
		values = Steel_Grades.ID
		displayformat = [Grade_Code]
		row = 1
		column = 2
		width = medium
	)
	Series
	(
		type = text
		row = 1
		column = 1
		width = medium
	)
	must have Required_Tons
	(
		type = decimal
		displayname = "Required Tons"
		row = 1
		column = 2
		width = medium
	)
	Remarks
	(
		type = textarea
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}