form Replanning_Requests
{

			displayname = "Replanning Requests"
			Section
			(
				type = section
				displayname = "Revision Request Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Replan_No
			(
    			type = autonumber
				displayname = "Replan No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Parent_Budget_Cycle
			(
				type = picklist	
				displayname = "Parent Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Revision_Cycle
			(
				type = picklist	
				displayname = "New Revision Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Requested_Financial_Year
			(
				type = picklist	
				displayname = "Requested Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Trigger_Reason
			(
    			type = textarea
				displayname = "Trigger Reason"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Affected_Modules
			(
				type = checkboxes
				displayname = "Affected Modules"
				values = {"Sales","Operations","Both","SCM","Finance"}
				layout = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Module
			(
				type = picklist
				displayname = "Source Module"
				values = {"Sales","Operations","SCM","Finance"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Source_Record_ID
			(
				type = number
				displayname = "Source Record ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Revision_Record_ID
			(
				type = number
				displayname = "New Revision Record ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Request_Status
			(
				type = section
				displayname = "Request Status"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Requested_By_Email
			(
    			type = email
				displayname = "Requested By Email"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Request_Date
			(
    			type = date
				displayname = "Request Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Finance","Finance Approved","Revision Created","In Team Revision","Resubmitted to SCM","Rejected","Locked"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Reject","Mark Revision Created","Close"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}