list SCM_Revision_History
{

			displayName = "SCM Revision History"
			show all rows from Replanning_Requests  [Source_Module == "SCM" || Source_Module == "Sales" || Source_Module == "Operations"]  
			(
				Replan_No
				Parent_Budget_Cycle
				Requested_Financial_Year
				Affected_Modules
				Source_Module
				Source_Record_ID
				New_Revision_Record_ID
				Trigger_Reason
				Requested_By_Email
				Request_Date
				Status
				Approval_Remarks
			)
			filters
			(
				Parent_Budget_Cycle
				Requested_Financial_Year
				Source_Module
				Status
				Requested_By_Email
				Request_Date
			)
			sort by
			(
				Request_Date descending
			)
		
}