kanban Replanning_Status_Board
{

			displayName = "Replanning Status Board"
			show all rows from Replanning_Requests    
			(
				Replan_No
				Parent_Budget_Cycle
				New_Revision_Cycle
				Requested_Financial_Year
				Affected_Modules
				Source_Module
				Requested_By_Email
				Request_Date
				Status
				custom action "Submit Replanning Request"
				(
	  			workflow = WF_Replanning_Submit
				column header = "Submit Replanning Request"
				success message = "Replanning request submitted."
				condition = (Status == "Draft")
				)
				custom action "Finance Approve"
				(
	  			workflow = WF_Replanning_Finance_Approve
				column header = "Finance Approve"
				success message = "Replanning request finance approved."
				condition = (Status == "Submitted to Finance")
				)
				custom action "Close Request"
				(
	  			workflow = WF_Replanning_Close
				column header = "Close Request"
				success message = "Replanning request closed."
				condition = (Status == "Revision Created" || Status == "Resubmitted to SCM" || Status == "Finance Approved")
				)
			)
			filters
			(
				Parent_Budget_Cycle
				Requested_Financial_Year
				Source_Module
				Status
				Requested_By_Email
				Request_Date
			)
			sort by
			(
				Request_Date descending
			)
			options
			(
	 			display field = Status
				sort order  = ascending
				record count  = enable
	 		)
		
}