WF_Replanning_Close as "Close Replanning Request"
{

				type =  functions
				form = Replanning_Requests
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Replanning_Requests?recLinkID=" + input.ID + "&viewLinkName=All_Replanning_Requests&Approver_Action=Close&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}