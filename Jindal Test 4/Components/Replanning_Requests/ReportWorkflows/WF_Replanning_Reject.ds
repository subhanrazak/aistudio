WF_Replanning_Reject as "Reject Replanning Request"
{

				type =  functions
				form = Replanning_Requests
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Submitted to Finance" || oldStatus == "Finance Approved" || oldStatus == "Draft")
										{
											input.Status = "Rejected";
											input.Approver_Action = null;
											remarksText = input.Approval_Remarks;
											if(remarksText == null || remarksText == "")
											{
												remarksText = "Rejected from report action.";
											}
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Parent_Budget_Cycle
												Module_Name="Replanning Requests"
												Related_Record_ID=input.ID
												Related_Record_Display="Replanning Request " + input.Replan_No
												Action="Returned"
												From_Status=oldStatus
												To_Status="Rejected"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=remarksText
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}