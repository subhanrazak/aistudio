WF_Replanning_Mark_Revision_Created as "Mark Revision Created"
{

				type =  functions
				form = Replanning_Requests
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Finance Approved" || oldStatus == "In Team Revision" || oldStatus == "Submitted to Finance")
										{
											input.Status = "Revision Created";
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Parent_Budget_Cycle
												Module_Name="Replanning Requests"
												Related_Record_ID=input.ID
												Related_Record_Display="Replanning Request " + input.Replan_No
												Action="Revision Copy Created"
												From_Status=oldStatus
												To_Status="Revision Created"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks=ifnull(input.Approval_Remarks,"Revision marked created from report action.")
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}