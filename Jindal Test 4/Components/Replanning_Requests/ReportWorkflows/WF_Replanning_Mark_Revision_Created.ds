WF_Replanning_Mark_Revision_Created as "Mark Revision Created"
{

				type =  functions
				form = Replanning_Requests
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Replanning_Requests?recLinkID=" + input.ID + "&viewLinkName=All_Replanning_Requests&Approver_Action=Mark%20Revision%20Created&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}