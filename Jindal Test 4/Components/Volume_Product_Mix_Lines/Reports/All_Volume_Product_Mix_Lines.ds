default list All_Volume_Product_Mix_Lines
{

			displayName = "All Volume Product Mix Lines"
			show all rows from Volume_Product_Mix_Lines    
			(
				Grade
				Product
				Series
				Sales_Planned_Tons
				Proposed_Product_Tons
				Sales_Approved_Tons
				Final_Product_Tons
				Mix_Status
			)
			filters
			(
				Mix_Status
			)
}