form Volume_Product_Mix_Lines
{

			displayname = "Volume Product Mix Lines"
			Product_Mix_Details
			(
				type = section
				displayname = "Product Mix Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Grade
			(
				type = picklist	
				displayname = "Grade"
				values  = Market_Segments.ID
    			displayformat = [Segment_Code]
				searchable = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product
			(
				type = picklist	
				displayname = "Product"
				values  = Steel_Grades.ID
    			displayformat = [Grade_Code]
				searchable = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Series
			(
    			type = text
				displayname = "Series"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sales_Planned_Tons
			(
				type = decimal
				displayname = "Sales Planned Tons"
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			Proposed_Product_Tons
			(
				type = decimal
				displayname = "Proposed Product Tons"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sales_Approved_Tons
			(
				type = decimal
				displayname = "Sales Approved Tons"
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			Final_Product_Tons
			(
				type = decimal
				displayname = "Final Product Tons"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Mix_Status
			(
				type = picklist
				displayname = "Mix Status"
				values = {"Copied from Sales","SCM Proposed Change","Sales Approved","Sales Revision Requested","Operations Revision Requested","Final Approved"}
				initial value = "Copied from Sales"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sales_Comments
			(
    			type = textarea
				displayname = "Sales Comments"
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)
			SCM_Comments
			(
    			type = textarea
				displayname = "SCM Comments"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Operations_Comments
			(
    			type = textarea
				displayname = "Operations Comments"
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)

			actions
			{
				on add
				{
					Submit
					(
   					type = submit
   					displayname = "Submit"
					)
					Reset
					(
   					type = reset
   					displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   					type = submit
   					displayname = "Update"
					)
					Cancel
					(
   					type = cancel
   					displayname = "Cancel"
					)
				}
			}
		
}