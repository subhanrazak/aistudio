WF_SMS_Accept as "Accept SMS"
{

				type =  functions
				form = SMS_Capacity_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:SMS_Capacity_Plans?recLinkID=" + input.ID + "&viewLinkName=All_SMS_Capacity_Plans&Approver_Action=Approve&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}