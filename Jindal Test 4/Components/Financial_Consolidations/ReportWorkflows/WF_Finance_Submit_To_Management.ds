WF_Finance_Submit_To_Management as "Submit to Management"
{

				type =  functions
				form = Financial_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Financial_Consolidations?recLinkID=" + input.ID + "&viewLinkName=All_Financial_Consolidations&Approver_Action=Submit&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}