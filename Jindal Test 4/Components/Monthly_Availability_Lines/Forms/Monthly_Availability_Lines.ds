form Monthly_Availability_Lines
{
	displayname = "Monthly Availability Lines"
	Availability_Line_Details
	(
		type = section
		displayname = "Availability Line Details"
		row = 1
		column = 0
		width = medium
	)
	must have Month
	(
		type = picklist
		values = Financial_Year_Months.ID
		displayformat = [Month_Label]
		row = 1
		column = 1
		width = medium
	)
	Month_Order
	(
		type = number
		displayname = "Month Order"
		row = 1
		column = 2
		width = medium
	)
	Calendar_Hours
	(
		type = decimal
		displayname = "Calendar Hours"
		row = 1
		column = 1
		width = medium
	)
	Holidays_Hours
	(
		type = decimal
		displayname = "Holidays Hours"
		row = 1
		column = 2
		width = medium
	)
	Planned_Down_Time_Hours
	(
		type = decimal
		displayname = "Planned Down Time Hours"
		row = 1
		column = 1
		width = medium
	)
	Capital_Shutdown_Hours
	(
		type = decimal
		displayname = "Capital Shutdown Hours"
		row = 1
		column = 2
		width = medium
	)
	Setup_Change_Time_Hours
	(
		type = decimal
		displayname = "Setup Change Time Hours"
		row = 1
		column = 1
		width = medium
	)
	Steckel_Mill_Work_Roll_Change_Hours
	(
		type = decimal
		displayname = "Steckel Mill Work Roll Change Hours"
		row = 1
		column = 2
		width = medium
	)
	Roughing_Mill_Work_Roll_Change_Hours
	(
		type = decimal
		displayname = "Roughing Mill Work Roll Change Hours"
		row = 1
		column = 1
		width = medium
	)
	Available_Hours
	(
		type = decimal
		displayname = "Available Hours"
		row = 1
		column = 2
		width = medium
	)
	Unforeseen_Delay_Breakdowns_Hours
	(
		type = decimal
		displayname = "Unforeseen Delay Breakdowns Hours"
		row = 1
		column = 1
		width = medium
	)
	Net_Running_Hours
	(
		type = decimal
		displayname = "Net Running Hours"
		row = 1
		column = 2
		width = medium
	)
	Equipment_Availability_Percent
	(
		type = decimal
		displayname = "Equipment Availability Percent"
		row = 1
		column = 1
		width = medium
	)
	Equipment_Utilization_Percent
	(
		type = decimal
		displayname = "Equipment Utilization Percent"
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}