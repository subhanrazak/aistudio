list Active_Plants
{

			displayName = "Active Plants"
			show all rows from Plants  [Active == true]  
			(
				Plant_Code
				Plant_Name
				Location
				State
				Plant_Head_Email
				Finance_Contact_Email
				Active
				Notes
			)
			filters
			(
				Location
				Active
			)
			sort by
			(
				Plant_Name ascending
			)
		
}