WF_Consumables_Reopen as "Reopen Consumables"
{

				type =  functions
				form = Consumables_Budgets
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Consumables_Budgets?recLinkID=" + input.ID + "&viewLinkName=All_Consumables_Budgets&Approver_Action=Reopen&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}