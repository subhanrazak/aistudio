WF_Consumables_Reopen as "Reopen Consumables"
{

				type =  functions
				form = Consumables_Budgets
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Locked")
										{
											input.Status = "Reopened";
											input.Locked = false;
											input.Iteration_Count = ifnull(input.Iteration_Count,0) + 1;
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Consumables Budget"
												Related_Record_ID=input.ID
												Related_Record_Display="Consumables Budget " + input.Consumables_Budget_No
												Action="Reopened"
												From_Status=oldStatus
												To_Status="Reopened"
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Reopened from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}