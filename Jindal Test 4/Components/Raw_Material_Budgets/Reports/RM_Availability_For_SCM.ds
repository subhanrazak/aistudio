list RM_Availability_For_SCM
{

			displayName = "RM Availability For SCM"
			show all rows from Raw_Material_Budgets  [Status == "Approved" || Status == "Locked"]  
			(
				RM_Budget_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Annual_Requirement_MT
				(
					display = total	
				)
				Available_Raw_Material_Total_MT
				(
					display = total	
				)
				To_Be_Raised_Total_MT
				(
					display = total	
				)
				Cost_Forecast_Total
				(
					display = total	
				)
				Budget_Price
				Status
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Status
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Requested_Financial_Year ascending
				Material ascending
			)
			sort by
			(
				Material ascending
				RM_Budget_No descending
			)
		
}