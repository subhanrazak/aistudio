list Approved_RM_Budgets
{

			displayName = "Approved RM Budgets"
			show all rows from Raw_Material_Budgets  [Status == "Approved"]  
			(
				RM_Budget_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Budget_Price
				Annual_Requirement_MT
				(
					display = total	
				)
				Available_Raw_Material_Total_MT
				(
					display = total	
				)
				To_Be_Raised_Total_MT
				(
					display = total	
				)
				Cost_Forecast_Total
				(
					display = total	
				)
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Material
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Material ascending
				RM_Budget_No descending
			)
		
}