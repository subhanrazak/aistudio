WF_RM_Return as "Return RM Budget"
{

				type =  functions
				form = Raw_Material_Budgets
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Raw_Material_Budgets?recLinkID=" + input.ID + "&viewLinkName=All_Raw_Material_Budgets&Approver_Action=Return&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}