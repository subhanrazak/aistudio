WF_RM_Lock as "Lock RM Budget"
{

				type =  functions
				form = Raw_Material_Budgets
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Submitted to Finance" || oldStatus == "Approved" && input.Locked != true)
										{
											input.Status = "Locked";
											input.Locked = true;
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Raw Material Budget"
												Related_Record_ID=input.ID
												Related_Record_Display="RM Budget " + input.RM_Budget_No
												Action="Locked"
												From_Status=oldStatus
												To_Status="Locked"
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Locked from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}