form Finish_Types
{

			displayname = "Finish Types"
			Finish_Details
			(
				type = section
				displayname = "Finish Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Finish_Code
			(
    			type = text
				displayname = "Finish Code"
				maxchar = 30
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Finish_Name
			(
    			type = text
				displayname = "Finish Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Process_Route
			(
    			type = textarea
				displayname = "Process Route"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}