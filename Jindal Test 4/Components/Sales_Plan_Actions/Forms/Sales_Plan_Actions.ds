form Sales_Plan_Actions
{

			displayname = "Sales Plan Actions"
			Action_Details
			(
				type = section
				displayname = "Action Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Action_Name
			(
    			type = text
				displayname = "Action Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sales_Plan_ID
			(
				type = number
				displayname = "Sales Plan ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Action_Status
			(
				type = picklist
				displayname = "Action Status"
				values = {"Open","Completed","Cancelled"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)

			actions
			{
				on add
				{
					Submit
					(
   					type = submit
   					displayname = "Submit"
					)
					Reset
					(
   					type = reset
   					displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   					type = submit
   					displayname = "Update"
					)
					Cancel
					(
   					type = cancel
   					displayname = "Cancel"
					)
				}
			}
		
}