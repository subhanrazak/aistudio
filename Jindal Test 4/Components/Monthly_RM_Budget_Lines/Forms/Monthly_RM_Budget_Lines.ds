form Monthly_RM_Budget_Lines
{
	displayname = "Monthly RM Budget Lines"
	RM_Budget_Line_Details
	(
		type = section
		displayname = "RM Budget Line Details"
		row = 1
		column = 0
		width = medium
	)
	must have Month
	(
		type = picklist
		values = {"Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","Jan","Feb","Mar"}
		row = 1
		column = 1
		width = medium
	)
	Month_Order
	(
		type = number
		displayname = "Month Order"
		row = 1
		column = 2
		width = medium
	)
	Requirement_MT
	(
		type = decimal
		displayname = "Requirement MT"
		row = 1
		column = 1
		width = medium
	)
	Available_Raw_Material_MT
	(
		type = decimal
		displayname = "Available Raw Material MT"
		row = 1
		column = 2
		width = medium
	)
	Required_Raw_Material_MT
	(
		type = decimal
		displayname = "Required Raw Material MT"
		row = 1
		column = 1
		width = medium
	)
	To_Be_Raised_MT
	(
		type = decimal
		displayname = "To Be Raised MT"
		row = 1
		column = 2
		width = medium
	)
	Cost_Forecast
	(
		type = decimal
		displayname = "Cost Forecast"
		row = 1
		column = 1
		width = medium
	)
	Override_Reason
	(
		type = textarea
		displayname = "Override Reason"
		height = 80px
		row = 1
		column = 2
		width = medium
	)
	Scrap_Percent
	(
		type = decimal
		displayname = "Scrap Percent"
		row = 1
		column = 1
		width = medium
	)
	NPI_Percent
	(
		type = decimal
		displayname = "NPI Percent"
		row = 1
		column = 2
		width = medium
	)
	Ferro_Nickel_Percent
	(
		type = decimal
		displayname = "Ferro Nickel Percent"
		row = 1
		column = 1
		width = medium
	)
	Pure_Metal_Percent
	(
		type = decimal
		displayname = "Pure Metal Percent"
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}