WF_Volume_Approve_Product_Mix as "Approve Product Mix"
{

				type =  functions
				form = Volume_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Volume_Consolidations?recLinkID=" + input.ID + "&viewLinkName=All_Volume_Consolidations&Approver_Action=Approve%20Product%20Mix&Action_Open=true&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}