WF_Volume_Submit_To_Finance as "Submit to Finance"
{

				type =  functions
				form = Volume_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Volume_Consolidations?recLinkID=" + input.ID + "&viewLinkName=All_Volume_Consolidations&Approver_Action=Submit%20to%20Finance&Action_Open=true&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}