WF_Volume_Open_Scenario_Comparison as "Open Scenario Comparison"
{

				type =  functions
				form = Volume_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Budget_Cycle != null)
										{
											openUrl("#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=" + input.Budget_Cycle,"same window");
										}
										else
										{
											openUrl("#Page:Scenario_Comparison_Dashboard","same window");
										}
					)
					}
				}
			
}