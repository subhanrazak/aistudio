WF_Volume_Approve_SCM as "Approve SCM"
{

				type =  functions
				form = Volume_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Under SCM Review")
										{
											input.Status = "SCM Approved";
											input.SCM_Decision = "Approve";
											input.SCM_Approved_By = zoho.loginuserid;
											input.SCM_Approved_On = zoho.currenttime;
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="SCM Review"
												Related_Record_ID=input.ID
												Related_Record_Display="SCM Review " + input.Consolidation_No
												Action="Approved"
												From_Status=oldStatus
												To_Status="SCM Approved"
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Approved from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}