WF_Volume_Request_Product_Mix_Revision as "Request Product Mix Revision"
{

				type =  functions
				form = Volume_Consolidations
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Volume_Consolidations?recLinkID=" + input.ID + "&viewLinkName=All_Volume_Consolidations&Approver_Action=Request%20Product%20Mix%20Revision&Action_Open=true&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}