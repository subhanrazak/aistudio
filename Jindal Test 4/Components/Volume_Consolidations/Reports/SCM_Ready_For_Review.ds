list SCM_Ready_For_Review
{

			displayName = "SCM Ready For Review"
			show all rows from Volume_Consolidations  [Status == "Under SCM Review" || Status == "Returned to SCM Review"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				Sales_Plan
				Product_Mix_Lines_Existing
				SCM_Review_Lines_Existing
				SCM_Decision
				SCM_Comments
				Latest_Revision_No
				Status
				Owner_Email
				custom action "Approve SCM"
				(
	  			workflow = WF_Volume_Approve_SCM
				column header = "Approve SCM"
				success message = "SCM review approved."
				condition = (Status == "Under SCM Review" || Status == "Returned to SCM Review")
				)
				custom action "Request Revision"
				(
	  			workflow = WF_Volume_Request_Revision
				column header = "Request Revision"
				success message = "SCM revision requested."
				condition = (Status == "Under SCM Review" || Status == "Returned to SCM Review")
				)
				custom action "Open Scenario Comparison"
				(
	  			workflow = WF_Volume_Open_Scenario_Comparison
				column header = "Open Scenario Comparison"
				success message = "Opening scenario comparison."
				)
				custom action "Open Financial Summary"
				(
	  			workflow = WF_Volume_Open_Financial_Summary
				column header = "Open Financial Summary"
				success message = "Opening financial summary."
				)
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}