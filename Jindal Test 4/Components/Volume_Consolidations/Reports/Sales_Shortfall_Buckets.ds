list Sales_Shortfall_Buckets
{

			displayName = "Sales Shortfall Buckets"
			show all rows from Volume_Consolidations  [Status == "Product Mix Pending Sales Approval" || Status == "Product Mix Sales Revision Pending" || Status == "Sales Revision Pending" || Status == "Both Revisions Pending"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				Sales_Plan
				Product_Mix_Lines_Existing
				Sales_Product_Mix_Decision
				Sales_Product_Mix_Comments
				SCM_Review_Lines_Existing
				SCM_Decision
				SCM_Comments
				Latest_Revision_No
				Status
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}