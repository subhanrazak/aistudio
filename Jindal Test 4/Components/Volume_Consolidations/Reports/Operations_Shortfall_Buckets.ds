list Operations_Shortfall_Buckets
{

			displayName = "Operations Shortfall Buckets"
			show all rows from Volume_Consolidations  [Status == "Operations Revision Pending" || Status == "Both Revisions Pending"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Operations_Production_Plan
				SCM_Review_Lines_Existing
				SCM_Decision
				Status
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}