list Operations_Revision_Queue
{

			displayName = "Operations Revision Queue"
			show all rows from Volume_Consolidations  [Status == "Operations Revision Pending" || Status == "Both Revisions Pending"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				SCM_Review_Lines_Existing
				Operations_Revision_Decision
				Operations_Revision_Comments
				SCM_Comments
				Latest_Revision_No
				Status
				Owner_Email
				custom action "Submit Operations Revision"
				(
	  			workflow = WF_Volume_Submit_Operations_Revision
				column header = "Submit Operations Revision"
				success message = "Opening operations revision submission form."
				condition = (Status == "Operations Revision Pending" || Status == "Both Revisions Pending")
				)
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
}