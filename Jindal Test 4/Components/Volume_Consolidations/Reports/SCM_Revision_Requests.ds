list SCM_Revision_Requests
{

			displayName = "SCM Revision Requests"
			show all rows from Volume_Consolidations  [Status == "Revision Requested" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Sales_Plan
				Availability_Plan
				Operations_Production_Plan
				SCM_Decision
				Revision_History_Lines_Existing
				Latest_Revision_No
				Status
				Owner_Email
				custom action "Open Scenario Comparison"
				(
	  			workflow = WF_Volume_Open_Scenario_Comparison
				column header = "Open Scenario Comparison"
				success message = "Opening scenario comparison."
				)
				custom action "Open Financial Summary"
				(
	  			workflow = WF_Volume_Open_Financial_Summary
				column header = "Open Financial Summary"
				success message = "Opening financial summary."
				)
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}