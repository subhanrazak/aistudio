list SCM_Revision_Requests
{

			displayName = "SCM Revision Requests"
			show all rows from Volume_Consolidations  [Status == "Product Mix Sales Revision Pending" || Status == "Sales Revision Pending" || Status == "Operations Revision Pending" || Status == "Both Revisions Pending" || Status == "Sales Revision Submitted" || Status == "Operations Revision Submitted" || Status == "Both Revisions Submitted"]  
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				Sales_Plan
				Product_Mix_Lines_Existing
				SCM_Review_Lines_Existing
				SCM_Decision
				SCM_Comments
				Sales_Product_Mix_Comments
				Operations_Revision_Comments
				Revision_History_Lines_Existing
				Latest_Revision_No
				Status
				Owner_Email
				custom action "Open Scenario Comparison"
				(
	  			workflow = WF_Volume_Open_Scenario_Comparison
				column header = "Open Scenario Comparison"
				success message = "Opening scenario comparison."
				)
				custom action "Open Financial Summary"
				(
	  			workflow = WF_Volume_Open_Financial_Summary
				column header = "Open Financial Summary"
				success message = "Opening financial summary."
				)
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Consolidation_Scope
				Plant
				SCM_Decision
				Status
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
		
}