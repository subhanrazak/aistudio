form Volume_Consolidations
{

			displayname = "SCM Review & Consolidation"
			Review_Context
			(
				type = section
				displayname = "Review Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Consolidation_No
			(
    			type = autonumber
				displayname = "Consolidation No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist	
				displayname = "Requested Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sales_Plan
			(
				type = picklist	
				displayname = "Sales Plan"
				values  = Sales_Plans.ID
    			displayformat = [Sales_Plan_No]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Availability_Plan
			(
				type = picklist	
				displayname = "Availability Plan"
				values  = Capacity_TEP_Plans.ID
    			displayformat = [Capacity_No]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Operations_Production_Plan
			(
				type = picklist	
				displayname = "Operations Production Plan"
				values  = Operations_Production_Plans.ID
    			displayformat = [Operations_Production_No]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Review_Details
			(
				type = section
				displayname = "Review Details"
				visibility = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			SCM_Review_Lines_Existing
			(
				type = grid
				displayname = "SCM Review Lines"
				values = SCM_Review_Lines.ID
				defaultrow = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Decision
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			SCM_Decision
			(
				type = picklist
				displayname = "SCM Decision"
				values = {"Approve","Request Sales Revision","Request Operations Revision","Request Sales and Operations Revision"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			SCM_Comments
			(
    			type = textarea
				displayname = "SCM Comments"
				height = 80px
	 			row = 3
	 			column = 2   
				width = medium
			)
			Latest_Revision_No
			(
				type = number
				displayname = "Latest Revision No"
				initial value = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			Revision_History
			(
				type = section
				displayname = "Revision History"
				visibility = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Revision_History_Lines_Existing
			(
				type = grid
				displayname = "Revision History Lines"
				values = Revision_History_Lines.ID
	 			row = 4
	 			column = 1   
				width = medium
			)
			Workflow_Status
			(
				type = section
				displayname = "Workflow Status"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Waiting for Sales and Operations Approval","Under SCM Review","Revision Requested","Sales Revision Pending","Operations Revision Pending","Both Revisions Pending","SCM Approved","Submitted to Finance","Locked","Reopened"}
				initial value = "Waiting for Sales and Operations Approval"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Start Review","Approve","Request Revision","Submit to Finance","Lock"}
	 			row = 5
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 5
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 5
	 			column = 2   
				width = medium
			)
			SCM_Approved_By
			(
    			type = email
				displayname = "SCM Approved By"
	 			row = 5
	 			column = 1   
				width = medium
			)
			SCM_Approved_On
			(
    			type = datetime
				displayname = "SCM Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}