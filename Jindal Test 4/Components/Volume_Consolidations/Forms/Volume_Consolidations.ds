form Volume_Consolidations
{

			displayname = "SCM Review & Consolidation"
			Review_Context
			(
				type = section
				displayname = "Review Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Consolidation_No
			(
    			type = autonumber
				displayname = "Consolidation No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist	
				displayname = "Requested Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Consolidation_Scope
			(
				type = picklist
				displayname = "Consolidation Scope"
				values = {"All Plants","Specific Plant"}
				initial value = "All Plants"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sales_Plan
			(
				type = picklist	
				displayname = "Sales Plan"
				values  = Sales_Plans.ID
    			displayformat = [Sales_Plan_No]
				searchable = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Availability_Plan
			(
				type = picklist	
				displayname = "Reference Availability Plan"
				values  = Capacity_TEP_Plans.ID
    			displayformat = [Capacity_No]
				searchable = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Operations_Production_Plan
			(
				type = picklist	
				displayname = "Reference Operations Production Plan"
				values  = Operations_Production_Plans.ID
    			displayformat = [Operations_Production_No]
				searchable = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Plant
			(
				type = picklist	
				displayname = "Reference Plant"
				values  = Plants.ID
    			displayformat = [Plant_Name]
				searchable = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Scope_Notes
			(
    			type = textarea
				displayname = "Scope Notes"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Review_Details
			(
				type = section
				displayname = "All Plant Review Details"
				visibility = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			SCM_Review_Lines_Existing
			(
				type = grid
				displayname = "SCM Review Lines"
				values = SCM_Review_Lines.ID
				defaultrow = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Product_Mix_Review
			(
				type = section
				displayname = "Product Mix Review"
				visibility = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Product_Mix_Lines_Existing
			(
				type = grid
				displayname = "Product Mix Lines"
				values = Volume_Product_Mix_Lines.ID
				defaultrow = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Decision
			(
				type = section
				displayname = "Review Decisions"
				visibility = true
	 			row = 4
	 			column = 1   
				width = medium
			)
			SCM_Decision
			(
				type = picklist
				displayname = "SCM Decision"
				values = {"Approve","Final Approve","Send Product Mix to Sales","Request Sales Revision","Request Operations Revision","Request Sales and Operations Revision"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			SCM_Comments
			(
    			type = textarea
				displayname = "SCM Comments"
				height = 80px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Sales_Product_Mix_Decision
			(
				type = picklist
				displayname = "Sales Product Mix Decision"
				values = {"Approve Product Mix","Request Product Mix Revision"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Sales_Product_Mix_Comments
			(
    			type = textarea
				displayname = "Sales Product Mix Comments"
				height = 80px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Operations_Revision_Decision
			(
				type = picklist
				displayname = "Operations Revision Decision"
				values = {"Submit Operations Revision","Request More Details"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Operations_Revision_Comments
			(
    			type = textarea
				displayname = "Operations Revision Comments"
				height = 80px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Latest_Revision_No
			(
				type = number
				displayname = "Latest Revision No"
				initial value = 0
	 			row = 4
	 			column = 1   
				width = medium
			)
			Revision_History
			(
				type = section
				displayname = "Revision History"
				visibility = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Revision_History_Lines_Existing
			(
				type = grid
				displayname = "Revision History Lines"
				values = Revision_History_Lines.ID
	 			row = 5
	 			column = 1   
				width = medium
			)
			Workflow_Status
			(
				type = section
				displayname = "Workflow Status"
				visibility = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Waiting for Sales and Operations Approval","Product Mix Pending Sales Approval","Product Mix Sales Revision Pending","Sales Product Mix Approved","Under SCM Review","Returned to SCM Review","Revision Requested","Sales Revision Pending","Operations Revision Pending","Both Revisions Pending","Sales Revision Submitted","Operations Revision Submitted","Both Revisions Submitted","SCM Approved","Final Approved","Submitted to Finance","Locked","Reopened"}
				initial value = "Waiting for Sales and Operations Approval"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Start Review","Send Product Mix to Sales","Approve Product Mix","Request Product Mix Revision","Submit Sales Revision","Submit Operations Revision","Submit Both Revisions","Approve","Request Revision","Submit to Finance","Lock","Reopen"}
	 			row = 6
	 			column = 2   
				width = medium
			)
			Action_Open
			(
    			type = checkbox
				displayname = "Opened From Action"
				initial value = false
	 			row = 6
	 			column = 1   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 6
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 6
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 6
	 			column = 2   
				width = medium
			)
			Sales_Approved_By
			(
    			type = email
				displayname = "Sales Approved By"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Sales_Approved_On
			(
    			type = datetime
				displayname = "Sales Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 2   
				width = medium
			)
			Operations_Submitted_By
			(
    			type = email
				displayname = "Operations Submitted By"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Operations_Submitted_On
			(
    			type = datetime
				displayname = "Operations Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 2   
				width = medium
			)
			SCM_Approved_By
			(
    			type = email
				displayname = "SCM Approved By"
	 			row = 6
	 			column = 1   
				width = medium
			)
			SCM_Approved_On
			(
    			type = datetime
				displayname = "SCM Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   					type = submit
   					displayname = "Submit"
					)
					Reset
					(
   					type = reset
   					displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   					type = submit
   					displayname = "Update"
					)
					Cancel
					(
   					type = cancel
   					displayname = "Cancel"
					)
				}
			}
		
}