Volume_Consolidations_After_Save as "Volume Consolidations After Save"
{

				type = form
				form = Volume_Consolidations
				record event = on add or edit

				on success
				{
					actions
					{
						custom deluge script
						(
											if(input.Owner_Email == null)
											{
												input.Owner_Email = zoho.loginuserid;
											}
											currentStatus = input.Status;
											actionValue = if(input.Action_Open == true,input.Approver_Action,null);
											newStatus = currentStatus;
											auditAction = "Updated";
											shouldAudit = false;
											shouldBuildMix = false;
											shouldBuildReview = false;
											mixCount = 0;
											for each  mixCounter in input.Product_Mix_Lines_Existing
											{
												mixCount = mixCount + 1;
											}
											reviewCount = 0;
											for each  reviewCounter in input.SCM_Review_Lines_Existing
											{
												reviewCount = reviewCount + 1;
											}
											if(mixCount == 0 && input.Sales_Plan != null)
											{
												shouldBuildMix = true;
											}
											if(reviewCount == 0 && input.Budget_Cycle != null)
											{
												shouldBuildReview = true;
											}
											if(actionValue == "Start Review" || actionValue == "Send Product Mix to Sales")
											{
												newStatus = "Product Mix Pending Sales Approval";
												auditAction = "Product Mix Sent to Sales";
												shouldAudit = true;
												shouldBuildMix = true;
												shouldBuildReview = true;
											}
											else if(actionValue == "Approve Product Mix")
											{
												for each  mixApproveRow in input.Product_Mix_Lines_Existing
												{
													mixApproveRow.Sales_Approved_Tons=ifnull(mixApproveRow.Proposed_Product_Tons,ifnull(mixApproveRow.Sales_Planned_Tons,0));
													mixApproveRow.Final_Product_Tons=mixApproveRow.Sales_Approved_Tons;
													mixApproveRow.Mix_Status="Sales Approved";
													mixApproveRow.Sales_Comments=input.Sales_Product_Mix_Comments;
												}
												input.Sales_Approved_By = zoho.loginuserid;
												input.Sales_Approved_On = zoho.currenttime;
												newStatus = "Under SCM Review";
												auditAction = "Sales Product Mix Approved";
												shouldAudit = true;
												shouldBuildReview = true;
											}
											else if(actionValue == "Request Product Mix Revision")
											{
												input.Latest_Revision_No = ifnull(input.Latest_Revision_No,0) + 1;
												input.Iteration_Count = ifnull(input.Iteration_Count,0) + 1;
												for each  mixRevisionRow in input.Product_Mix_Lines_Existing
												{
													mixRevisionRow.Mix_Status="Sales Revision Requested";
													mixRevisionRow.Sales_Comments=input.Sales_Product_Mix_Comments;
												}
												historyRow = Volume_Consolidations.Revision_History_Lines_Existing();
												historyRow.Revision_No=input.Latest_Revision_No;
												historyRow.Requested_To="SCM";
												historyRow.Requested_By_Team="Sales";
												historyRow.Source_Record="SCM Review " + input.Consolidation_No;
												historyRow.New_Revision_Record_ID=0;
												historyRow.Comments=input.Sales_Product_Mix_Comments;
												historyRow.Sales_Response_Comments=input.Sales_Product_Mix_Comments;
												historyRow.Requested_By=zoho.loginuserid;
												historyRow.Requested_On=zoho.currenttime;
												historyRow.Sales_Reviewed_By=zoho.loginuserid;
												historyRow.Sales_Reviewed_On=zoho.currenttime;
												historyRow.Revision_Status="Rejected";
												input.Revision_History_Lines_Existing.insert(historyRow);
												newStatus = "Product Mix Sales Revision Pending";
												auditAction = "Product Mix Revision Requested";
												shouldAudit = true;
											}
											else if(actionValue == "Request Revision")
											{
												input.Latest_Revision_No = ifnull(input.Latest_Revision_No,0) + 1;
												input.Iteration_Count = ifnull(input.Iteration_Count,0) + 1;
												requestedToValue = "Both";
												if(input.SCM_Decision == "Request Sales Revision")
												{
													newStatus = "Sales Revision Pending";
													requestedToValue = "Sales";
												}
												else if(input.SCM_Decision == "Request Operations Revision")
												{
													newStatus = "Operations Revision Pending";
													requestedToValue = "Operations";
												}
												else
												{
													newStatus = "Both Revisions Pending";
													requestedToValue = "Both";
												}
												historyRow = Volume_Consolidations.Revision_History_Lines_Existing();
												historyRow.Revision_No=input.Latest_Revision_No;
												historyRow.Requested_To=requestedToValue;
												historyRow.Requested_By_Team="SCM";
												historyRow.Source_Record="SCM Review " + input.Consolidation_No;
												historyRow.New_Revision_Record_ID=0;
												historyRow.Comments=input.SCM_Comments + " " + input.Approval_Remarks;
												historyRow.Sales_Request_Comments=if(requestedToValue == "Sales" || requestedToValue == "Both", input.SCM_Comments + " " + input.Approval_Remarks, "");
												historyRow.Operations_Request_Comments=if(requestedToValue == "Operations" || requestedToValue == "Both", input.SCM_Comments + " " + input.Approval_Remarks, "");
												historyRow.Requested_By=zoho.loginuserid;
												historyRow.Requested_On=zoho.currenttime;
												historyRow.SCM_Reviewed_By=zoho.loginuserid;
												historyRow.SCM_Reviewed_On=zoho.currenttime;
												historyRow.Revision_Status="Requested";
												input.Revision_History_Lines_Existing.insert(historyRow);
												auditAction = "Revision Requested";
												shouldAudit = true;
											}
											else if(actionValue == "Submit Sales Revision")
											{
												newStatus = if(currentStatus == "Both Revisions Pending" || currentStatus == "Operations Revision Submitted", "Sales Revision Submitted", "Returned to SCM Review");
												historyRow = Volume_Consolidations.Revision_History_Lines_Existing();
												historyRow.Revision_No=ifnull(input.Latest_Revision_No,0);
												historyRow.Requested_To="SCM";
												historyRow.Requested_By_Team="Sales";
												historyRow.Source_Record="SCM Review " + input.Consolidation_No;
												historyRow.Comments=input.Approval_Remarks;
												historyRow.Sales_Response_Comments=input.Approval_Remarks;
												historyRow.Requested_By=zoho.loginuserid;
												historyRow.Requested_On=zoho.currenttime;
												historyRow.Sales_Reviewed_By=zoho.loginuserid;
												historyRow.Sales_Reviewed_On=zoho.currenttime;
												historyRow.Revision_Status="Sales Submitted";
												input.Revision_History_Lines_Existing.insert(historyRow);
												auditAction = "Sales Revision Submitted";
												shouldAudit = true;
											}
											else if(actionValue == "Submit Operations Revision" || actionValue == "Submit Both Revisions")
											{
												input.Operations_Submitted_By = zoho.loginuserid;
												input.Operations_Submitted_On = zoho.currenttime;
												if(actionValue == "Submit Both Revisions" || currentStatus == "Sales Revision Submitted")
												{
													newStatus = "Returned to SCM Review";
												}
												else if(currentStatus == "Both Revisions Pending")
												{
													newStatus = "Operations Revision Submitted";
												}
												else
												{
													newStatus = "Returned to SCM Review";
												}
												historyRow = Volume_Consolidations.Revision_History_Lines_Existing();
												historyRow.Revision_No=ifnull(input.Latest_Revision_No,0);
												historyRow.Requested_To="SCM";
												historyRow.Requested_By_Team="Operations";
												historyRow.Source_Record="SCM Review " + input.Consolidation_No;
												historyRow.Comments=input.Operations_Revision_Comments + " " + input.Approval_Remarks;
												historyRow.Operations_Response_Comments=input.Operations_Revision_Comments + " " + input.Approval_Remarks;
												historyRow.Requested_By=zoho.loginuserid;
												historyRow.Requested_On=zoho.currenttime;
												historyRow.Operations_Reviewed_By=zoho.loginuserid;
												historyRow.Operations_Reviewed_On=zoho.currenttime;
												historyRow.Revision_Status=if(actionValue == "Submit Both Revisions", "Both Submitted", "Operations Submitted");
												input.Revision_History_Lines_Existing.insert(historyRow);
												auditAction = historyRow.Revision_Status;
												shouldAudit = true;
												shouldBuildReview = true;
											}
											else if(actionValue == "Approve" && (currentStatus == "Under SCM Review" || currentStatus == "Returned to SCM Review"))
											{
												newStatus = "SCM Approved";
												input.SCM_Approved_By = zoho.loginuserid;
												input.SCM_Approved_On = zoho.currenttime;
												for each  mixFinalRow in input.Product_Mix_Lines_Existing
												{
													mixFinalRow.Final_Product_Tons=ifnull(mixFinalRow.Sales_Approved_Tons,ifnull(mixFinalRow.Proposed_Product_Tons,ifnull(mixFinalRow.Sales_Planned_Tons,0)));
													mixFinalRow.Mix_Status="Final Approved";
													mixFinalRow.SCM_Comments=input.SCM_Comments;
												}
												auditAction = "Final Approved";
												shouldAudit = true;
											}
											else if(actionValue == "Submit to Finance" && currentStatus == "SCM Approved")
											{
												newStatus = "Submitted to Finance";
												auditAction = "Submitted";
												shouldAudit = true;
											}
											else if(actionValue == "Lock" && (currentStatus == "SCM Approved" || currentStatus == "Submitted to Finance"))
											{
												newStatus = "Locked";
												input.Locked = true;
												auditAction = "Locked";
												shouldAudit = true;
											}
											if(shouldBuildMix == true && input.Sales_Plan != null && mixCount == 0)
											{
												salesPlanRec = Sales_Plans[ID == input.Sales_Plan];
												if(salesPlanRec.count() > 0)
												{
													for each  productRow in salesPlanRec.Product_Split_Lines_Existing
													{
														mixRow = Volume_Consolidations.Product_Mix_Lines_Existing();
														mixRow.Grade=productRow.Grade;
														mixRow.Product=productRow.Product;
														mixRow.Series=productRow.Series;
														mixRow.Sales_Planned_Tons=ifnull(productRow.Required_Tons,0);
														mixRow.Proposed_Product_Tons=ifnull(productRow.Required_Tons,0);
														mixRow.Final_Product_Tons=ifnull(productRow.Required_Tons,0);
														mixRow.Mix_Status="Copied from Sales";
														input.Product_Mix_Lines_Existing.insert(mixRow);
													}
												}
											}
											if(shouldBuildReview == true && input.Budget_Cycle != null && reviewCount == 0)
											{
												for each  productionPlan in Operations_Production_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"]
												{
													availabilityRec = Capacity_TEP_Plans[ID == productionPlan.Linked_Availability_Plan];
													for each  productionLineRow in productionPlan.Product_Production_Lines_Existing
													{
														salesTarget = 0.0;
														gradeValue = null;
														for each  mixLookupRow in input.Product_Mix_Lines_Existing
														{
															if(mixLookupRow.Product == productionLineRow.Product)
															{
																salesTarget = ifnull(mixLookupRow.Final_Product_Tons,ifnull(mixLookupRow.Proposed_Product_Tons,ifnull(mixLookupRow.Sales_Planned_Tons,0)));
																gradeValue = mixLookupRow.Grade;
															}
														}
														reviewRow = Volume_Consolidations.SCM_Review_Lines_Existing();
														reviewRow.Plant=productionPlan.Plant;
														reviewRow.Production_Line=productionPlan.Production_Line;
														reviewRow.Availability_Plan=productionPlan.Linked_Availability_Plan;
														reviewRow.Operations_Production_Plan=productionPlan.ID;
														reviewRow.Grade=gradeValue;
														reviewRow.Product=productionLineRow.Product;
														reviewRow.Sales_Target_Tons=salesTarget;
														reviewRow.Operations_Production_Tons=ifnull(productionLineRow.Production_Tons,0);
														reviewRow.Annual_Available_Hours=if(availabilityRec.count() > 0, ifnull(availabilityRec.Annual_Available_Hours,0), 0);
														reviewRow.Annual_Net_Running_Hours=if(availabilityRec.count() > 0, ifnull(availabilityRec.Annual_Net_Running_Hours,0), 0);
														reviewRow.Equipment_Availability_Percent=if(availabilityRec.count() > 0, ifnull(availabilityRec.Average_Equipment_Availability_Percent,0), 0);
														reviewRow.Equipment_Utilization_Percent=if(availabilityRec.count() > 0, ifnull(availabilityRec.Average_Equipment_Utilization_Percent,0), 0);
														reviewRow.Product_Mix_Source="Sales Plan";
														input.SCM_Review_Lines_Existing.insert(reviewRow);
													}
												}
											}
											latestAudit = Approval_Audit_Log[Module_Name == "SCM Review" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
											if(latestAudit.count() == 0)
											{
												createdAuditId = insert into Approval_Audit_Log
												[
													Budget_Cycle=input.Budget_Cycle
													Module_Name="SCM Review"
													Related_Record_ID=input.ID
													Related_Record_Display="SCM Review " + input.Consolidation_No
													Action="Created"
													From_Status=""
													To_Status=currentStatus
													Iteration_Number=input.Iteration_Count
													Actor_Email=zoho.loginuserid
													Action_On=zoho.currenttime
													Remarks="All-plant SCM review created."
													Added_User=zoho.loginuser
												];
											}
											if(shouldAudit == true)
											{
												input.Status = newStatus;
												auditRecordId = insert into Approval_Audit_Log
												[
													Budget_Cycle=input.Budget_Cycle
													Module_Name="SCM Review"
													Related_Record_ID=input.ID
													Related_Record_Display="SCM Review " + input.Consolidation_No
													Action=auditAction
													From_Status=currentStatus
													To_Status=newStatus
													Iteration_Number=input.Iteration_Count
													Actor_Email=zoho.loginuserid
													Action_On=zoho.currenttime
													Remarks=input.SCM_Comments + " " + input.Sales_Product_Mix_Comments + " " + input.Operations_Revision_Comments + " " + input.Approval_Remarks
													Added_User=zoho.loginuser
												];
												if(newStatus == "SCM Approved" || newStatus == "Submitted to Finance")
												{
													cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
													if(cycleRec.count() > 0)
													{
														cycleRec.SCM_Approved=true;
														cycleRec.Status="Pending Finance";
													}
												}
												input.Approver_Action = null;
											}
											input.Action_Open = false;
						)
					}
				}

			
}