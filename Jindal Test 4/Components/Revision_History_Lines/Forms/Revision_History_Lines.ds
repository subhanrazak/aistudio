form Revision_History_Lines
{
	displayname = "Revision History Lines"
	Revision_Details
	(
		type = section
		displayname = "Revision Details"
		row = 1
		column = 0
		width = medium
	)
	Revision_No
	(
		type = number
		displayname = "Revision No"
		row = 1
		column = 1
		width = medium
	)
	Requested_To
	(
		type = picklist
		displayname = "Requested To"
		values = {"Sales","Operations","Both"}
		row = 1
		column = 2
		width = medium
	)
	Source_Record
	(
		type = text
		displayname = "Source Record"
		row = 1
		column = 1
		width = medium
	)
	New_Revision_Record_ID
	(
		type = number
		displayname = "New Revision Record ID"
		row = 1
		column = 2
		width = medium
	)
	Comments
	(
		type = textarea
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	Requested_By
	(
		type = email
		displayname = "Requested By"
		row = 1
		column = 2
		width = medium
	)
	Requested_On
	(
		type = datetime
		displayname = "Requested On"
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = medium
	)
	Revision_Status
	(
		type = picklist
		displayname = "Revision Status"
		values = {"Requested","In Progress","Resubmitted","Closed"}
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}