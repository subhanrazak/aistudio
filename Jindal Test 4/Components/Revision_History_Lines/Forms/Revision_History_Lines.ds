form Revision_History_Lines
{
	displayname = "Revision History Lines"
	Revision_Details
	(
		type = section
		displayname = "Revision Details"
		row = 1
		column = 0
		width = medium
	)
	Revision_No
	(
		type = number
		displayname = "Revision No"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Requested_To
	(
		type = picklist
		displayname = "Requested To"
		values = {"Sales","Operations","Both","SCM"}
		row = 1
		column = 2
		width = medium
	)
	Requested_By_Team
	(
		type = picklist
		displayname = "Requested By Team"
		values = {"SCM","Sales","Operations","Both","System"}
		initial value = "System"
		row = 1
		column = 1
		width = medium
	)
	Source_Record
	(
		type = text
		displayname = "Source Record"
		row = 1
		column = 2
		width = medium
	)
	New_Revision_Record_ID
	(
		type = number
		displayname = "New Revision Record ID"
		row = 1
		column = 1
		width = medium
	)
	Comments
	(
		type = textarea
		displayname = "Comments"
		height = 80px
		row = 1
		column = 2
		width = medium
	)
	Sales_Request_Comments
	(
		type = textarea
		displayname = "Sales Request Comments"
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	Operations_Request_Comments
	(
		type = textarea
		displayname = "Operations Request Comments"
		height = 80px
		row = 1
		column = 2
		width = medium
	)
	Sales_Response_Comments
	(
		type = textarea
		displayname = "Sales Response Comments"
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	Operations_Response_Comments
	(
		type = textarea
		displayname = "Operations Response Comments"
		height = 80px
		row = 1
		column = 2
		width = medium
	)
	SCM_Review_Comments
	(
		type = textarea
		displayname = "SCM Review Comments"
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	Requested_By
	(
		type = email
		displayname = "Requested By"
		row = 1
		column = 2
		width = medium
	)
	Requested_On
	(
		type = datetime
		displayname = "Requested On"
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = medium
	)
	Revision_Status
	(
		type = picklist
		displayname = "Revision Status"
		values = {"Requested","In Progress","Resubmitted","Sales Submitted","Operations Submitted","Both Submitted","Returned to SCM","SCM Approved","Rejected","Closed"}
		initial value = "Requested"
		row = 1
		column = 2
		width = medium
	)
	Sales_Reviewed_By
	(
		type = email
		displayname = "Sales Reviewed By"
		row = 1
		column = 1
		width = medium
	)
	Sales_Reviewed_On
	(
		type = datetime
		displayname = "Sales Reviewed On"
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 2
		width = medium
	)
	Operations_Reviewed_By
	(
		type = email
		displayname = "Operations Reviewed By"
		row = 1
		column = 1
		width = medium
	)
	Operations_Reviewed_On
	(
		type = datetime
		displayname = "Operations Reviewed On"
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 2
		width = medium
	)
	SCM_Reviewed_By
	(
		type = email
		displayname = "SCM Reviewed By"
		row = 1
		column = 1
		width = medium
	)
	SCM_Reviewed_On
	(
		type = datetime
		displayname = "SCM Reviewed On"
		timedisplayoptions = "hh:mm:ss"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}