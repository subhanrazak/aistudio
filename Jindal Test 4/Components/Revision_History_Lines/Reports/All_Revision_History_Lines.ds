default list All_Revision_History_Lines
{

			displayName = "All Revision History Lines"
			show all rows from Revision_History_Lines    
			(
				Revision_No
				Requested_To
				Requested_By_Team
				Comments
				Sales_Request_Comments
				Operations_Request_Comments
				Sales_Response_Comments
				Operations_Response_Comments
				SCM_Review_Comments
				Requested_By
				Requested_On
				Revision_Status
				Sales_Reviewed_By
				Sales_Reviewed_On
				Operations_Reviewed_By
				Operations_Reviewed_On
				SCM_Reviewed_By
				SCM_Reviewed_On
			)
			filters
			(
				Requested_To
				Requested_By_Team
				Revision_Status
				Requested_On
			)
			sort by
			(
				Requested_On descending
			)
}