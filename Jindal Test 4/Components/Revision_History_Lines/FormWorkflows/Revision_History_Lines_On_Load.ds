Revision_History_Lines_On_Load as "Revision History Lines On Load"
{

				type = form
				form = Revision_History_Lines
				record event = on add or edit

				on load
				{
					actions
					{
						custom deluge script
						(
											if(input.Requested_On == null)
											{
												input.Requested_On = zoho.currenttime;
											}
											if(input.Requested_By == null)
											{
												input.Requested_By = zoho.loginuserid;
											}
											if(input.Requested_By_Team == null)
											{
												input.Requested_By_Team = "System";
											}
											if(input.Revision_Status == null)
											{
												input.Revision_Status = "Requested";
											}
						)
					}
				}

			
}