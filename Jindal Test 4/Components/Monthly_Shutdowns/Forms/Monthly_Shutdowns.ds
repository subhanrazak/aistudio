form Monthly_Shutdowns
{
	displayname = "Monthly Shutdowns"
	Shutdown_Line_Details
	(
		type = section
		displayname = "Shutdown Line Details"
		row = 1
		column = 0
		width = medium
	)
	must have Month
	(
		type = picklist
		values = {"Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","Jan","Feb","Mar"}
		row = 1
		column = 1
		width = medium
	)
	Month_Order
	(
		type = number
		displayname = "Month Order"
		row = 1
		column = 2
		width = medium
	)
	Days_For
	(
		type = decimal
		displayname = "Days For"
		row = 1
		column = 1
		width = medium
	)
	Reason
	(
		type = text
		maxchar = 120
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}