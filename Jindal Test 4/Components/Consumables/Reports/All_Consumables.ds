default list All_Consumables
{

			displayName = "All Consumables"
			show all rows from Consumables    
			(
				Consumable_Code
				Consumable_Name
				Category
				Unit_Of_Measure
				Active
				Notes
			)
			filters
			(
				Category
				Unit_Of_Measure
				Active
			)
			sort by
			(
				Consumable_Name ascending
			)
		
}