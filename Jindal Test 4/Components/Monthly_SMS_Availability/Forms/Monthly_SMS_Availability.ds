form Monthly_SMS_Availability
{
	displayname = "Monthly SMS Availability"
	SMS_Availability_Details
	(
		type = section
		displayname = "SMS Availability Details"
		row = 1
		column = 0
		width = medium
	)
	must have Month
	(
		type = picklist
		values = {"Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","Jan","Feb","Mar"}
		row = 1
		column = 1
		width = medium
	)
	Month_Order
	(
		type = number
		displayname = "Month Order"
		row = 1
		column = 2
		width = medium
	)
	Available_Days
	(
		type = decimal
		displayname = "Available Days"
		row = 1
		column = 1
		width = medium
	)
	Heats_Per_Day
	(
		type = decimal
		displayname = "Heats Per Day"
		row = 1
		column = 2
		width = medium
	)
	Tonnage_Per_Heat
	(
		type = decimal
		displayname = "Tonnage Per Heat"
		row = 1
		column = 1
		width = medium
	)
	Output_MT
	(
		type = decimal
		displayname = "Output MT"
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}