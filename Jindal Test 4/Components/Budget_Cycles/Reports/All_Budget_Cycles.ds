default list All_Budget_Cycles
{

			displayName = "All Budget Cycles"
			show all rows from Budget_Cycles    
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Parent_Cycle
				Opened_Date
				Status
				Sales_Approved
				Operations_Approved
				SCM_Approved
				Finance_Completed
				Baseline_Locked
				Approved_Scenario
				Completion_Date
				Owner_Email
				custom action "Open Cycle"
				(
	  			workflow = WF_Budget_Open_Cycle
				column header = "Open Cycle"
				success message = "Cycle opened."
				condition = (Status == "Draft")
				)
				custom action "Request Revision"
				(
	  			workflow = WF_Budget_Request_Revision
				column header = "Request Revision"
				success message = "Revision requested."
				condition = (Status != "Completed" && Status != "Closed")
				)
				custom action "Mark Pending Finance"
				(
	  			workflow = WF_Budget_Mark_Pending_Finance
				column header = "Mark Pending Finance"
				success message = "Cycle marked pending finance."
				condition = (Status == "Pending SCM")
				)
				custom action "Complete Cycle"
				(
	  			workflow = WF_Budget_Complete_Cycle
				column header = "Complete Cycle"
				success message = "Cycle completed."
				condition = (Status == "Pending Finance")
				)
				custom action "Close Cycle"
				(
	  			workflow = WF_Budget_Close_Cycle
				column header = "Close Cycle"
				success message = "Cycle closed."
				condition = (Status != "Closed")
				)
				custom action "Open Scenario Comparison"
				(
	  			workflow = WF_Budget_Open_Scenario_Comparison
				column header = "Open Scenario Comparison"
				success message = "Opening scenario comparison."
				)
				custom action "Open Financial Summary"
				(
	  			workflow = WF_Budget_Open_Financial_Summary
				column header = "Open Financial Summary"
				success message = "Opening financial summary."
				)
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
				Baseline_Locked
				Approved_Scenario
			)
			sort by
			(
				Opened_Date descending
				Cycle_Code ascending
			)
		
}