WF_Budget_Mark_Pending_Finance as "Mark Pending Finance"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Budget_Cycles?recLinkID=" + input.ID + "&viewLinkName=All_Budget_Cycles&Status=Pending%20Finance&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}