WF_Budget_Open_Scenario_Comparison as "Open Scenario Comparison"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Scenario_Comparison_Dashboard?Budget_Cycle_ID=" + input.ID,"same window");
					)
					}
				}
			
}