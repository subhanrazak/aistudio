WF_Budget_Complete_Cycle as "Complete Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Budget_Cycles?recLinkID=" + input.ID + "&viewLinkName=All_Budget_Cycles&Status=Completed&Finance_Completed=true&Approved_Scenario=true&Baseline_Locked=true&Completion_Date=" + zoho.currentdate + "&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}