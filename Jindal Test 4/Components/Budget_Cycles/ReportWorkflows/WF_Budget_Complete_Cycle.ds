WF_Budget_Complete_Cycle as "Complete Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Pending Finance")
										{
											input.Status = "Completed";
											input.Finance_Completed = true;
											input.Approved_Scenario = true;
											input.Baseline_Locked = true;
											input.Completion_Date = zoho.currentdate;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.ID
												Module_Name="Budget Cycles"
												Related_Record_ID=input.ID
												Related_Record_Display="Budget Cycle " + input.Cycle_Code
												Action="Completed"
												From_Status=oldStatus
												To_Status="Completed"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Completed from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}