WF_Budget_Open_Financial_Summary as "Open Financial Summary"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Report:Scenario_Financial_Summary?zc_LoadIn=dialog","same window");
					)
					}
				}
			
}