WF_Budget_Open_Cycle as "Open Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Draft")
										{
											input.Status = "Pending Sales";
											input.Owner_Email = ifnull(input.Owner_Email,zoho.loginuserid);
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.ID
												Module_Name="Budget Cycles"
												Related_Record_ID=input.ID
												Related_Record_Display="Budget Cycle " + input.Cycle_Code
												Action="Submitted"
												From_Status=oldStatus
												To_Status="Pending Sales"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Cycle opened from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}