WF_Budget_Open_Cycle as "Open Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Budget_Cycles?recLinkID=" + input.ID + "&viewLinkName=All_Budget_Cycles&Status=Pending%20Sales&Owner_Email=" + zoho.loginuserid + "&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}