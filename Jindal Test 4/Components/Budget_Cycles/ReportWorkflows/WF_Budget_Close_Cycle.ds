WF_Budget_Close_Cycle as "Close Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Budget_Cycles?recLinkID=" + input.ID + "&viewLinkName=All_Budget_Cycles&Status=Closed&Baseline_Locked=true&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}