WF_Budget_Close_Cycle as "Close Cycle"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus != "Closed")
										{
											input.Status = "Closed";
											input.Baseline_Locked = true;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.ID
												Module_Name="Budget Cycles"
												Related_Record_ID=input.ID
												Related_Record_Display="Budget Cycle " + input.Cycle_Code
												Action="Completed"
												From_Status=oldStatus
												To_Status="Closed"
												Iteration_Number=0
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Closed from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}