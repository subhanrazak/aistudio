WF_Budget_Request_Revision as "Request Revision"
{

				type =  functions
				form = Budget_Cycles
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Budget_Cycles?recLinkID=" + input.ID + "&viewLinkName=All_Budget_Cycles&Status=Revision%20Requested&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}