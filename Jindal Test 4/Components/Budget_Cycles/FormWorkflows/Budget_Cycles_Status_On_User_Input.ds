Budget_Cycles_Status_On_User_Input as "Budget Cycles Status On User Input"
{

				type =  form
				form = Budget_Cycles

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Revision Requested")
										{
											show Reopened_Modules;
											enable Reopened_Modules;
										}
										else
										{
											input.Reopened_Modules = null;
											hide Reopened_Modules;
											disable Reopened_Modules;
										}
						)
					}
				}

			
}