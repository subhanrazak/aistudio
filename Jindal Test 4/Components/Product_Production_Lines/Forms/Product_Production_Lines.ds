form Product_Production_Lines
{
	displayname = "Product Production Lines"
	Production_Line_Details
	(
		type = section
		displayname = "Production Line Details"
		row = 1
		column = 0
		width = medium
	)
	must have Product
	(
		type = picklist
		values = Steel_Grades.ID
		displayformat = [Grade_Code]
		row = 1
		column = 1
		width = medium
	)
	Series
	(
		type = text
		row = 1
		column = 2
		width = medium
	)
	Width
	(
		type = text
		row = 1
		column = 1
		width = medium
	)
	Thickness
	(
		type = decimal
		row = 1
		column = 2
		width = medium
	)
	Productivity_MTPH
	(
		type = decimal
		displayname = "Productivity MTPH"
		decimalplace = 3
		row = 1
		column = 1
		width = medium
	)
	must have Month
	(
		type = picklist
		values = Financial_Year_Months.ID
		displayformat = [Month_Label]
		row = 1
		column = 2
		width = medium
	)
	Month_Order
	(
		type = number
		displayname = "Month Order"
		row = 1
		column = 1
		width = medium
	)
	must have Production_Tons
	(
		type = decimal
		displayname = "Production Tons"
		row = 1
		column = 2
		width = medium
	)
	Remarks
	(
		type = textarea
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}