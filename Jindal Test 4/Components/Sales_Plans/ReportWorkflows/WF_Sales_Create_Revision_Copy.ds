WF_Sales_Create_Revision_Copy as "Create Sales Revision Copy"
{

				type =  functions
				form = Sales_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Sales_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Sales_Plans&Approver_Action=Create%20Revision%20Copy&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}