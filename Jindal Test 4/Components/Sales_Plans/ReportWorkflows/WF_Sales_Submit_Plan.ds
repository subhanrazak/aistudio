WF_Sales_Submit_Plan as "Submit Sales Plan"
{

				type =  functions
				form = Sales_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Draft" || oldStatus == "Returned by Sales Management" || oldStatus == "Revision Requested by SCM" || oldStatus == "Revised Draft")
										{
											input.Status = "Submitted to Sales Management";
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Sales Plans"
												Related_Record_ID=input.ID
												Related_Record_Display="Sales Plan " + input.Sales_Plan_No
												Action="Submitted"
												From_Status=oldStatus
												To_Status="Submitted to Sales Management"
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Submitted from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}