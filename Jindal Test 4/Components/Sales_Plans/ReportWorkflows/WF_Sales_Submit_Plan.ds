WF_Sales_Submit_Plan as "Submit Sales Plan"
{

				type =  functions
				form = Sales_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Sales_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Sales_Plans&Approver_Action=Submit&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}