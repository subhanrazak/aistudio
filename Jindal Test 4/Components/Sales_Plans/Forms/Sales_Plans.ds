form Sales_Plans
{

			displayname = "Sales Plans"
			Plan_Context
			(
				type = section
				displayname = "Plan Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Sales_Plan_No
			(
    			type = autonumber
				displayname = "Sales Plan No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist	
				displayname = "Requested Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Revision_No
			(
				type = number
				displayname = "Revision No"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parent_Sales_Plan
			(
				type = picklist	
				displayname = "Parent Sales Plan"
				values  = Sales_Plans.ID
    			displayformat = [Sales_Plan_No]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sales_Demand
			(
				type = section
				displayname = "Sales Demand"
				visibility = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Grade_Demand_Lines_Existing
			(
				type = grid
				displayname = "Grade Demand Lines"
				values = Grade_Demand_Lines.ID
				defaultrow = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Product_Split
			(
				type = section
				displayname = "Product Split"
				visibility = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Product_Split_Lines_Existing
			(
				type = grid
				displayname = "Product Split Lines"
				values = Product_Split_Lines.ID
				defaultrow = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Totals
			(
				type = section
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Total_Grade_Target_Tons
			(
				type = decimal
				displayname = "Total Grade Target Tons"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Total_Product_Required_Tons
			(
				type = decimal
				displayname = "Total Product Required Tons"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Variance_Tons
			(
				type = decimal
				displayname = "Variance Tons"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Sales Management","Returned by Sales Management","Sales Approved","Revision Requested by SCM","Revised Draft","Superseded","Locked"}
				initial value = "Draft"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Create Revision Copy","Lock"}
	 			row = 5
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 5
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Ownership_Audit
			(
				type = section
				displayname = "Ownership Audit"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Sales_Approved_By
			(
    			type = email
				displayname = "Sales Approved By"
	 			row = 6
	 			column = 2   
				width = medium
			)
			Sales_Approved_On
			(
    			type = datetime
				displayname = "Sales Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Wizard_Page_Helper
			(
				type = section
				displayname = "Wizard Page Helper"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			loadIn
			(
    			type = text
	 			row = 7
	 			column = 1   
				width = medium
			)
			Current_Stage
			(
				type = radiobuttons
				displayname = "Current Stage"
				maxchar = 100
				values = {"0","1","2","3","4"}
				initial value = "0"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Show_Value
			(
    			type = text
				displayname = "Show Value"
	 			row = 7
	 			column = 1   
				width = medium
			)
			From_Page
			(
    			type = checkbox
				displayname = "From Page"
				initial value = false
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}