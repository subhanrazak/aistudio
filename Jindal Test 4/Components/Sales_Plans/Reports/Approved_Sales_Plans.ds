list Approved_Sales_Plans
{

			displayName = "Approved Sales Plans"
			show all rows from Sales_Plans  [Status == "Sales Approved"]  
			(
				Sales_Plan_No
				Requested_Financial_Year
				Budget_Cycle
				Revision_No
				Total_Grade_Target_Tons
				Total_Product_Required_Tons
				Variance_Tons
				Status
				Sales_Approved_By
				Sales_Approved_On
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Status
				Owner_Email
			)
			sort by
			(
				Sales_Approved_On descending
				Sales_Plan_No descending
			)
		
}