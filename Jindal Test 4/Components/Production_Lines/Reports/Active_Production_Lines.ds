list Active_Production_Lines
{

			displayName = "Active Production Lines"
			show all rows from Production_Lines  [Active == true]  
			(
				Line_Code
				Line_Name
				Plant
				Line_Type
				Capacity_Basis
				Standard_Hours_Per_Day
				Standard_Productivity_MTPH
				Active
				Notes
			)
			filters
			(
				Plant
				Line_Type
				Capacity_Basis
			)
			sort by
			(
				Line_Code ascending
			)
		
}