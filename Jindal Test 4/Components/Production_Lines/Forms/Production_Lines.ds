form Production_Lines
{

			displayname = "Production Lines"
			Section
			(
				type = section
				displayname = "Line Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Line_Code
			(
    			type = text
				displayname = "Line Code"
				maxchar = 30
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Line_Name
			(
    			type = text
				displayname = "Line Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Line_Type
			(
				type = picklist
				displayname = "Line Type"
				values = {"Rolling","CRAP","HRAP","Finishing","SMS","Melting","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Capacity_Basis
			(
				type = picklist
				displayname = "Capacity Basis"
				values = {"MT per Hour","Heats per Day","Days","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Standard_Hours_Per_Day
			(
				type = decimal
				displayname = "Standard Hours Per Day"
				initial value = 24
	 			row = 1
	 			column = 2   
				width = medium
			)
			Standard_Productivity_MTPH
			(
				type = decimal
				displayname = "Standard Productivity MTPH"
				decimalplace = 3
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}