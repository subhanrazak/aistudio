Validate_Production_Line_Hours as "Validate Production Line Hours"
{

				type =  form
				form = Production_Lines

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Standard_Hours_Per_Day == null || input.Standard_Hours_Per_Day <= 0 || input.Standard_Hours_Per_Day > 24)
										{
											alert(Standard_Hours_Per_Day,"Standard hours per day must be greater than 0 and not exceed 24.");
											cancel submit;
										}
						)
					}
				}

			
}