form Financial_Years
{

			displayname = "Financial Years"
			Financial_Year_Details
			(
				type = section
				displayname = "Financial Year Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Year_Code
			(
    			type = text
				displayname = "Year Code"
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_Name
			(
    			type = text
				displayname = "Year Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Open","Pending Sales","Pending Operations","Pending SCM","Pending Finance","Completed","Closed","Archived"}
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Completion_Date
			(
    			type = date
				displayname = "Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completion_Remarks
			(
    			type = textarea
				displayname = "Completion Remarks"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}