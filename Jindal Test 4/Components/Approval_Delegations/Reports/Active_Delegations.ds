list Active_Delegations
{

			displayName = "Active Delegations"
			show all rows from Approval_Delegations  [Active == true]  
			(
				Delegator_Email
				Delegate_Email
				Profile_Name
				Module_Name
				Start_Date
				End_Date
				Active
				Reason
			)
			filters
			(
				Profile_Name
				Module_Name
				Start_Date
				End_Date
			)
			sort by
			(
				End_Date ascending
			)
		
}