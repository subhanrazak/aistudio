form Grade_Demand_Lines
{
	displayname = "Grade Demand Lines"
	Demand_Line_Details
	(
		type = section
		displayname = "Demand Line Details"
		row = 1
		column = 0
		width = medium
	)
	must have Grade
	(
		type = picklist
		values = Market_Segments.ID
		displayformat = [Segment_Name]
		row = 1
		column = 1
		width = medium
	)
	Actual_Year_3_MT
	(
		type = decimal
		displayname = "Actual Year 3 MT"
		row = 1
		column = 2
		width = medium
	)
	Actual_Year_2_MT
	(
		type = decimal
		displayname = "Actual Year 2 MT"
		row = 1
		column = 1
		width = medium
	)
	Actual_Year_1_MT
	(
		type = decimal
		displayname = "Actual Year 1 MT"
		row = 1
		column = 2
		width = medium
	)
	Actual_3_Year_Growth_Percent
	(
		type = decimal
		displayname = "Actual 3 Year Growth Percent"
		row = 1
		column = 1
		width = medium
	)
	Current_Year_Growth_Percent
	(
		type = decimal
		displayname = "Current Year Growth Percent"
		row = 1
		column = 2
		width = medium
	)
	Expected_Growth_Percent
	(
		type = decimal
		displayname = "Expected Growth Percent"
		row = 1
		column = 1
		width = medium
	)
	Current_Year_Produced_Tons
	(
		type = decimal
		displayname = "Current Year Produced Tons"
		row = 1
		column = 2
		width = medium
	)
	must have Target_Tons_Needed
	(
		type = decimal
		displayname = "Target Tons Needed"
		row = 1
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}