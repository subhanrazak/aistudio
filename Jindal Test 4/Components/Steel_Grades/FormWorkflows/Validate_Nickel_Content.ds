Validate_Nickel_Content as "Validate Product Master"
{

				type =  form
				form = Steel_Grades

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Grade_Code == null || input.Grade_Code.trim() == "")
										{
											alert "Product Code is required.";
											cancel submit;
										}
										if(input.Active == true && input.Grade_Series == null || input.Grade_Series == "")
										{
											alert "Series is required for active products.";
											cancel submit;
										}
										if(input.Nickel_Content_Percent != null && input.Nickel_Content_Percent < 0 || input.Nickel_Content_Percent > 100)
										{
											alert "Nickel content percent must be between 0 and 100.";
											cancel submit;
										}
						)
					}
				}

			
}