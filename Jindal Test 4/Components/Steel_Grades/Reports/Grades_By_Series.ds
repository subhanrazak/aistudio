list Grades_By_Series
{

			displayName = "Products By Series"
			show all rows from Steel_Grades    
			(
				Grade_Code as "Product Code"
				Grade_Name as "Product Name"
				Grade_Series as "Series"
				Nickel_Content_Percent
				Active
				Notes
			)
			filters
			(
				Grade_Series
				Active
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Grade_Series ascending
			)
			sort by
			(
				Grade_Code ascending
			)
		
}