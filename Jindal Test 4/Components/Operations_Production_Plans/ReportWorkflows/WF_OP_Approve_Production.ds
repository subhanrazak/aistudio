WF_OP_Approve_Production as "Approve Production"
{

				type =  functions
				form = Operations_Production_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Operations_Production_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Operations_Production_Plans&Approver_Action=Approve&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}