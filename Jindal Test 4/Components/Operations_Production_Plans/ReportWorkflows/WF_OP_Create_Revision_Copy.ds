WF_OP_Create_Revision_Copy as "Create Production Revision Copy"
{

				type =  functions
				form = Operations_Production_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Operations_Production_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Operations_Production_Plans&Approver_Action=Create%20Revision%20Copy&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}