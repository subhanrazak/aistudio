list Operations_Production_By_Line
{

			displayName = "Operations Production By Line"
			show all rows from Operations_Production_Plans    
			(
				Operations_Production_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Linked_Availability_Plan
				Revision_No
				Total_FY_Production_Tons
				(
					display = total	
				)
				Average_Productivity_MTPH
				(
					display = average	
				)
				Status
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Plant ascending
				Production_Line ascending
			)
			sort by
			(
				Production_Line ascending
				Operations_Production_No descending
			)
		
}