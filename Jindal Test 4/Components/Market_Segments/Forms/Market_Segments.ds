form Market_Segments
{

			displayname = "Grades"
			Segment_Details
			(
				type = section
				displayname = "Grade Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Segment_Code
			(
    			type = text
				displayname = "Grade Code"
				maxchar = 30
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Segment_Name
			(
    			type = text
				displayname = "Grade Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Market_Type
			(
				type = picklist
				displayname = "Grade Group"
				values = {"Domestic","Export","Both"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Business_Owner_Email
			(
    			type = email
				displayname = "Business Owner Email"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}