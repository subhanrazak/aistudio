Log_Master_Data_Changes as "Log Master Data Changes"
{

				type =  form
				form = Market_Segments

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											info "Master data change - Market Segments | ID: " + input.ID + " | Code: " + input.Segment_Code + " | Name: " + input.Segment_Name + " | Market Type: " + input.Market_Type + " | Active: " + input.Active;
						)
					}
				}

			
}