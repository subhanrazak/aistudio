SCM_Review_Lines_On_Load as "SCM Review Lines On Load"
{

				type = form
				form = SCM_Review_Lines
				record event = on add or edit

				on load
				{
					actions
					{
						custom deluge script
						(
											if(input.Product_Mix_Source == null)
											{
												input.Product_Mix_Source = "Sales Plan";
											}
											input.Sales_Target_Tons = ifnull(input.Sales_Target_Tons,0);
											input.Operations_Production_Tons = ifnull(input.Operations_Production_Tons,0);
											input.BTV_Measured_MT = ifnull(input.BTV_Measured_MT,0);
											input.Annual_Available_Hours = ifnull(input.Annual_Available_Hours,0);
											input.Annual_Net_Running_Hours = ifnull(input.Annual_Net_Running_Hours,0);
											input.Equipment_Availability_Percent = ifnull(input.Equipment_Availability_Percent,0);
											input.Equipment_Utilization_Percent = ifnull(input.Equipment_Utilization_Percent,0);
											input.Required_Raw_Material_MT = ifnull(input.Required_Raw_Material_MT,0);
											input.Available_Raw_Material_MT = ifnull(input.Available_Raw_Material_MT,0);
											input.To_Be_Raised_MT = ifnull(input.To_Be_Raised_MT,0);
											input.Cost_Forecast = ifnull(input.Cost_Forecast,0);
						)
					}
				}

			
}