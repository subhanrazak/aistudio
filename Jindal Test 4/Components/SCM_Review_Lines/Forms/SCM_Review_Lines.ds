form SCM_Review_Lines
{
	displayname = "SCM Review Lines"
	Review_Line_Details
	(
		type = section
		displayname = "Review Line Details"
		row = 1
		column = 0
		width = medium
	)
	Plant
	(
		type = picklist
		displayname = "Plant"
		values = Plants.ID
		displayformat = [Plant_Name]
		searchable = true
		row = 1
		column = 1
		width = medium
	)
	Production_Line
	(
		type = picklist
		displayname = "Production Line"
		values = Production_Lines.ID
		displayformat = [Line_Name]
		searchable = true
		row = 1
		column = 2
		width = medium
	)
	Availability_Plan
	(
		type = picklist
		displayname = "Availability Plan"
		values = Capacity_TEP_Plans.ID
		displayformat = [Capacity_No]
		searchable = true
		row = 1
		column = 1
		width = medium
	)
	Operations_Production_Plan
	(
		type = picklist
		displayname = "Operations Production Plan"
		values = Operations_Production_Plans.ID
		displayformat = [Operations_Production_No]
		searchable = true
		row = 1
		column = 2
		width = medium
	)
	Grade
	(
		type = picklist
		values = Market_Segments.ID
		displayformat = [Segment_Name]
		searchable = true
		row = 1
		column = 1
		width = medium
	)
	Product
	(
		type = picklist
		values = Steel_Grades.ID
		displayformat = [Grade_Code]
		searchable = true
		row = 1
		column = 2
		width = medium
	)
	Sales_Target_Tons
	(
		type = decimal
		displayname = "Sales Target Tons"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Operations_Production_Tons
	(
		type = decimal
		displayname = "Operations Production Tons"
		initial value = 0
		row = 1
		column = 2
		width = medium
	)
	BTV_Measured_MT
	(
		type = decimal
		displayname = "BTV Measured MT"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Annual_Available_Hours
	(
		type = decimal
		displayname = "Annual Available Hours"
		initial value = 0
		row = 1
		column = 2
		width = medium
	)
	Annual_Net_Running_Hours
	(
		type = decimal
		displayname = "Annual Net Running Hours"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Equipment_Availability_Percent
	(
		type = decimal
		displayname = "Equipment Availability %"
		initial value = 0
		row = 1
		column = 2
		width = medium
	)
	Equipment_Utilization_Percent
	(
		type = decimal
		displayname = "Equipment Utilization %"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Raw_Material
	(
		type = picklist
		displayname = "Raw Material"
		values = Raw_Materials.ID
		displayformat = [Material_Name]
		searchable = true
		row = 1
		column = 2
		width = medium
	)
	Required_Raw_Material_MT
	(
		type = decimal
		displayname = "Required Raw Material MT"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Available_Raw_Material_MT
	(
		type = decimal
		displayname = "Available Raw Material MT"
		initial value = 0
		row = 1
		column = 2
		width = medium
	)
	To_Be_Raised_MT
	(
		type = decimal
		displayname = "To Be Raised MT"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Cost_Forecast
	(
		type = decimal
		displayname = "Cost Forecast"
		initial value = 0
		row = 1
		column = 2
		width = medium
	)
	Product_Mix_Source
	(
		type = picklist
		displayname = "Product Mix Source"
		values = {"Sales Plan","SCM Proposal","Sales Revision","Operations Revision","Final"}
		initial value = "Sales Plan"
		row = 1
		column = 1
		width = medium
	)
	SCM_Override
	(
		type = checkbox
		displayname = "SCM Override"
		initial value = false
		row = 1
		column = 2
		width = medium
	)
	Override_Comments
	(
		type = textarea
		displayname = "Override Comments"
		height = 80px
		row = 1
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}