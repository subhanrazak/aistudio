form SCM_Review_Lines
{
	displayname = "SCM Review Lines"
	Review_Line_Details
	(
		type = section
		displayname = "Review Line Details"
		row = 1
		column = 0
		width = medium
	)
	Grade
	(
		type = picklist
		values = Market_Segments.ID
		displayformat = [Segment_Name]
		row = 1
		column = 1
		width = medium
	)
	Product
	(
		type = picklist
		values = Steel_Grades.ID
		displayformat = [Grade_Code]
		row = 1
		column = 2
		width = medium
	)
	Sales_Target_Tons
	(
		type = decimal
		displayname = "Sales Target Tons"
		row = 1
		column = 1
		width = medium
	)
	Operations_Production_Tons
	(
		type = decimal
		displayname = "Operations Production Tons"
		row = 1
		column = 2
		width = medium
	)
	BTV_Measured_MT
	(
		type = decimal
		displayname = "BTV Measured MT"
		row = 1
		column = 1
		width = medium
	)
	Raw_Material
	(
		type = picklist
		displayname = "Raw Material"
		values = Raw_Materials.ID
		displayformat = [Material_Name]
		row = 1
		column = 2
		width = medium
	)
	Required_Raw_Material_MT
	(
		type = decimal
		displayname = "Required Raw Material MT"
		row = 1
		column = 1
		width = medium
	)
	Available_Raw_Material_MT
	(
		type = decimal
		displayname = "Available Raw Material MT"
		row = 1
		column = 2
		width = medium
	)
	To_Be_Raised_MT
	(
		type = decimal
		displayname = "To Be Raised MT"
		row = 1
		column = 1
		width = medium
	)
	Cost_Forecast
	(
		type = decimal
		displayname = "Cost Forecast"
		row = 1
		column = 2
		width = medium
	)
	SCM_Override
	(
		type = checkbox
		displayname = "SCM Override"
		initial value = false
		row = 1
		column = 1
		width = medium
	)
	Override_Comments
	(
		type = textarea
		displayname = "Override Comments"
		height = 80px
		row = 1
		column = 2
		width = medium
	)
	actions
	{
		on add
		{
			Submit
			(
				type = submit
				displayname = "Submit"
			)
			Reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			Update
			(
				type = submit
				displayname = "Update"
			)
			Cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}