default list All_SCM_Review_Lines
{

			displayName = "All SCM Review Lines"
			show all rows from SCM_Review_Lines    
			(
				Plant
				Production_Line
				Availability_Plan
				Operations_Production_Plan
				Grade
				Product
				Sales_Target_Tons
				Operations_Production_Tons
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Equipment_Availability_Percent
				Equipment_Utilization_Percent
				Required_Raw_Material_MT
				Available_Raw_Material_MT
				To_Be_Raised_MT
				Cost_Forecast
				Product_Mix_Source
				SCM_Override
			)
			filters
			(
				Plant
				Production_Line
				Grade
				Product
				Product_Mix_Source
				SCM_Override
			)
			sort by
			(
				Plant ascending
				Production_Line ascending
				Grade ascending
				Product ascending
			)
}