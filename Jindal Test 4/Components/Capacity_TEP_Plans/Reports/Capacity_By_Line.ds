list Capacity_By_Line
{

			displayName = "Capacity By Line"
			show all rows from Capacity_TEP_Plans    
			(
				Capacity_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Annual_Calendar_Hours
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Average_Equipment_Availability_Percent
				Average_Equipment_Utilization_Percent
				Status
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Plant ascending
				Production_Line ascending
			)
			sort by
			(
				Production_Line ascending
				Capacity_No descending
			)
		
}