form Capacity_TEP_Plans
{

			displayname = "Operations Line Availability"
			Availability_Context
			(
				type = section
				displayname = "Availability Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Capacity_No
			(
    			type = autonumber
				displayname = "Capacity No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist	
				displayname = "Requested Financial Year"
				values  = Financial_Years.ID
    			displayformat = [Year_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Production_Line
			(
				type = picklist	
				displayname = "Production Line"
				values  = Production_Lines.ID
    			displayformat = [Line_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Revision_No
			(
				type = number
				displayname = "Revision No"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parent_Availability_Plan
			(
				type = picklist	
				displayname = "Parent Availability Plan"
				values  = Capacity_TEP_Plans.ID
    			displayformat = [Capacity_No]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Monthly_Availability
			(
				type = section
				displayname = "Monthly Availability"
				visibility = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Monthly_Availability_Lines_Existing
			(
				type = grid
				displayname = "Monthly Availability Lines"
				values = Monthly_Availability_Lines.ID
				defaultrow = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Annual_Calculations
			(
				type = section
				displayname = "Annual Calculations"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Annual_Calendar_Hours
			(
				type = decimal
				displayname = "Annual Calendar Hours"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Annual_Available_Hours
			(
				type = decimal
				displayname = "Annual Available Hours"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Annual_Net_Running_Hours
			(
				type = decimal
				displayname = "Annual Net Running Hours"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Average_Equipment_Availability_Percent
			(
				type = decimal
				displayname = "Average Equipment Availability Percent"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Average_Equipment_Utilization_Percent
			(
				type = decimal
				displayname = "Average Equipment Utilization Percent"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Operations Approval","Returned by Operations Approval","Operations Approved","Revision Requested by SCM","Revised Draft","Superseded","Locked"}
				initial value = "Draft"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Create Revision Copy","Lock"}
	 			row = 4
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 4
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Operations_Approved_By
			(
    			type = email
				displayname = "Operations Approved By"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Operations_Approved_On
			(
    			type = datetime
				displayname = "Operations Approved On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}