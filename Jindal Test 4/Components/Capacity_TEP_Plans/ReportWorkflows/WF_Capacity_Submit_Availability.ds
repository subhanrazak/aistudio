WF_Capacity_Submit_Availability as "Submit Availability"
{

				type =  functions
				form = Capacity_TEP_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						oldStatus = input.Status;
										if(oldStatus == "Draft" || oldStatus == "Returned by Operations Approval" || oldStatus == "Revision Requested by SCM" || oldStatus == "Revised Draft")
										{
											input.Status = "Submitted to Operations Approval";
											input.Approver_Action = null;
											auditId = insert into Approval_Audit_Log
											[
												Budget_Cycle=input.Budget_Cycle
												Module_Name="Operations Availability"
												Related_Record_ID=input.ID
												Related_Record_Display="Availability Plan " + input.Capacity_No
												Action="Submitted"
												From_Status=oldStatus
												To_Status="Submitted to Operations Approval"
												Iteration_Number=input.Iteration_Count
												Actor_Email=zoho.loginuserid
												Action_On=zoho.currenttime
												Remarks="Submitted from report action."
												Added_User=zoho.loginuser
											];
										}
					)
					}
				}
			
}