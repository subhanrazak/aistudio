WF_Capacity_Create_Revision_Copy as "Create Availability Revision Copy"
{

				type =  functions
				form = Capacity_TEP_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Capacity_TEP_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Capacity_TEP_Plans&Approver_Action=Create%20Revision%20Copy&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}