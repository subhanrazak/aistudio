WF_Capacity_Lock_Availability as "Lock Availability"
{

				type =  functions
				form = Capacity_TEP_Plans
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Capacity_TEP_Plans?recLinkID=" + input.ID + "&viewLinkName=All_Capacity_TEP_Plans&Approver_Action=Lock&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}