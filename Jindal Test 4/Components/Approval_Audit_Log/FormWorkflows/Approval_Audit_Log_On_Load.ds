Approval_Audit_Log_On_Load as "Approval Audit Log On Load"
{

				type =  form
				form = Approval_Audit_Log

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Budget_Cycle;
										disable Module_Name;
										disable Related_Record_ID;
										disable Related_Record_Display;
										disable Action;
										disable From_Status;
										disable To_Status;
										disable Iteration_Number;
										disable Actor_Email;
										disable Acting_On_Behalf_Of;
										disable Action_On;
										disable Remarks;
						)
					}
				}

			
}