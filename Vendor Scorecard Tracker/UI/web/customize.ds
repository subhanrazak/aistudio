customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "poppins"

    color options
    {
        color = "104"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-page-content { background: #f7f9fc; } .zc-report-title { font-weight: 600; }"
    }
}
