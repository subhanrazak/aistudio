form Departments
{
    displayname = "Departments"

    Section_Department_Info
    (
        type = section
        displayname = "Department Information"
        row = 1
        column = 0
    )
    Department_Code
    (
        type = autonumber
        displayname = "Department Code"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Company
    (
        type = picklist
        displayname = "Company"
        values = Company_Details.ID
        displayformat = [Company_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Branch
    (
        type = picklist
        displayname = "Branch"
        values = Branches.ID
        displayformat = [Branch_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Department_Name
    (
        type = text
        displayname = "Department Name"
        row = 1
        column = 1
        width = medium
    )
    Department_Type
    (
        type = picklist
        displayname = "Department Type"
        values = {"Functional","Support","Operations","Finance","HR","IT","Quality","Other"}
        row = 1
        column = 2
        width = medium
    )
    Department_Head
    (
        type = picklist
        displayname = "Department Head"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Cost_Center
    (
        type = text
        displayname = "Cost Center"
        row = 1
        column = 2
        width = medium
    )
    Department_Email
    (
        type = email
        displayname = "Department Email"
        row = 1
        column = 1
        width = medium
    )
    Department_Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
