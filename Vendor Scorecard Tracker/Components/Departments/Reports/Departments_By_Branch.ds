list Departments_By_Branch
{
    displayName = "Departments By Branch"
    show all rows from Departments
    (
        Department_Code
        Company
        Branch
        Department_Name
        Department_Type
        Department_Head
        Cost_Center
        Department_Email
        Department_Status
        Notes
    )
    filters
    (
        Company
        Branch
        Department_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Branch ascending
    )
    sort by
    (
        Department_Name ascending
    )
}
