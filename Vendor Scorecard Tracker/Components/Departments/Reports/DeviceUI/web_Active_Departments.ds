report Active_Departments
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Department_Code
                    Company
                    Branch
                    Department_Name
                    Department_Type
                    Department_Head
                    Department_Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Department_Code
                    Company
                    Branch
                    Department_Name
                    Department_Type
                    Department_Head
                    Cost_Center
                    Department_Email
                    Department_Status
                    Notes
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
