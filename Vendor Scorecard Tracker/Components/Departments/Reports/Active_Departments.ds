list Active_Departments
{
    displayName = "Active Departments"
    show all rows from Departments [Department_Status == "Active"]
    (
        Department_Code
        Company
        Branch
        Department_Name
        Department_Type
        Department_Head
        Cost_Center
        Department_Email
        Department_Status
        Notes
    )
    filters
    (
        Company
        Branch
        Department_Type
    )
    sort by
    (
        Department_Name ascending
    )
}
