default list All_Departments
{
    displayName = "All Departments"
    show all rows from Departments
    (
        Department_Code
        Company
        Branch
        Department_Name
        Department_Type
        Department_Head
        Cost_Center
        Department_Email
        Department_Status
        Notes
    )
    filters
    (
        Company
        Branch
        Department_Type
        Department_Status
    )
    sort by
    (
        Department_Name ascending
    )
}
