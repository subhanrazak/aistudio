Weightages_Process_Area_On_User_Input as "Process Area On User Input"
{
    type = form
    form = Weightages
    record event = on add or edit
    description = "Clears criterion when process area changes."

    on user input of Process_Area
    {
        actions
        {
            custom deluge script
            (
                input.Criteria = null;
            )
        }
    }
}
