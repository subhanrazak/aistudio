form Weightages
{
    displayname = "Weightages"
    success message = "Weightage saved successfully."
    Section_Weightage_Info
    (
        type = section
        displayname = "Weightage Information"
        row = 1
        column = 0
    )
    must have Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review"}
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Criteria
    (
        type = picklist
        displayname = "Criteria"
        values = Criteria.ID
        displayformat = [Criteria_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Weight_Percentage
    (
        type = decimal
        displayname = "Weight Percentage"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Effective_From
    (
        type = date
        displayname = "Effective From"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
