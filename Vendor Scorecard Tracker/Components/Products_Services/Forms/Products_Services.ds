form Products_Services
{
    displayname = "Products & Services"
    success message = "Product or service saved successfully."
    Section_Product_Service
    (
        type = section
        displayname = "Product Service"
        row = 1
        column = 0
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Item_Name
    (
        type = text
        displayname = "Item Name"
        maxchar = 180
        row = 1
        column = 2
        width = medium
    )
    Item_Type
    (
        type = picklist
        displayname = "Item Type"
        values = {"Product","Service","Both"}
        row = 1
        column = 1
        width = medium
    )
    Service_Category
    (
        type = text
        displayname = "Service Category"
        maxchar = 120
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Criticality
    (
        type = picklist
        displayname = "Criticality"
        values = {"Low","Medium","High","Critical"}
        row = 1
        column = 2
        width = medium
    )
    Approval_Status
    (
        type = picklist
        displayname = "Approval Status"
        values = {"Draft","Submitted","Approved","Rejected","Inactive"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    Effective_From
    (
        type = date
        displayname = "Effective From"
        row = 1
        column = 2
        width = medium
    )
    Effective_To
    (
        type = date
        displayname = "Effective To"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
