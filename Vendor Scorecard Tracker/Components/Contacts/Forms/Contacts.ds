form Contacts
{
    displayname = "Contacts"
    success message = "Contact saved successfully."
    Section_Contact_Info
    (
        type = section
        displayname = "Contact Information"
        row = 1
        column = 0
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Contact_Name
    (
        type = name
        displayname = "Contact Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Mr.","Mrs.","Ms.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have unique Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 1
        column = 1
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 1
        column = 2
        width = medium
    )
    Designation
    (
        type = text
        displayname = "Designation"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Contact_Type
    (
        type = picklist
        displayname = "Contact Type"
        values = {"Primary","Commercial","Technical","Compliance","Finance","Escalation","Other"}
        row = 1
        column = 2
        width = medium
    )
    Is_Primary_Contact
    (
        type = checkbox
        displayname = "Is Primary Contact"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Portal_User_Type
    (
        type = picklist
        displayname = "Portal User Type"
        values = {"None","Register Vendor","Onboarded Vendor"}
        initial value = "None"
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
