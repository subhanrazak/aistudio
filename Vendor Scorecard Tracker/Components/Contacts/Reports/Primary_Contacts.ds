list Primary_Contacts
{
    displayName = "Primary Contacts"
    show all rows from Contacts [Is_Primary_Contact == true]
    (
        Vendor
        Contact_Name
        Contact_Email
        Contact_Phone
        Portal_User_Type
        Status
    )
    filters
    (
        Vendor
        Status
    )
    sort by
    (
        Vendor ascending
        Contact_Name ascending
    )
}
