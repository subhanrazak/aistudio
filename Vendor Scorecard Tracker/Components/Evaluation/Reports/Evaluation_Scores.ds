list Evaluation_Scores
{
    displayName = "Evaluation Scores"
    show all rows from Evaluation
    (
        Vendor
        Evaluation_Cycle
        Category
        Criteria
        Weighted_Score
        Evaluation_Status
    )
    filters
    (
        Vendor
        Evaluation_Cycle
        Category
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Vendor ascending
        Evaluation_Cycle ascending
    )
    sort by
    (
        Vendor ascending
        Evaluation_Cycle ascending
        Category ascending
    )
}
