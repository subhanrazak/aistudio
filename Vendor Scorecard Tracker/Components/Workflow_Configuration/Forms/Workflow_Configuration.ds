form Workflow_Configuration
{
    displayname = "Workflow Configuration"
    success message = "Workflow status configuration saved successfully."
    Section_Status_Config
    (
        type = section
        displayname = "Status Configuration"
        row = 1
        column = 0
    )
    must have Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","Document Verification"}
        row = 1
        column = 1
        width = medium
    )
    must have Status_Name
    (
        type = text
        displayname = "Status Name"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Status_Order
    (
        type = number
        displayname = "Status Order"
        row = 1
        column = 1
        width = medium
    )
    Is_Start_Status
    (
        type = checkbox
        displayname = "Is Start Status"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Is_Final_Status
    (
        type = checkbox
        displayname = "Is Final Status"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Responsible_Profile
    (
        type = picklist
        displayname = "Responsible Profile"
        values = {"Admin","Procurement Executive","Vendor Evaluator","Register Vendor","Onboarded Vendor"}
        row = 1
        column = 2
        width = medium
    )
    SLA_Days
    (
        type = number
        displayname = "SLA Days"
        row = 1
        column = 1
        width = medium
    )
    Notification_Required
    (
        type = checkbox
        displayname = "Notification Required"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
