default list Workflow_Statuses
{
    displayName = "Workflow Statuses"
    show all rows from Workflow_Configuration
    (
        Process_Area
        Status_Name
        Status_Order
        Is_Start_Status
        Is_Final_Status
        Responsible_Profile
        SLA_Days
        Status
    )
    filters
    (
        Process_Area
        Responsible_Profile
        Status
    )
    sort by
    (
        Process_Area ascending
        Status_Order ascending
        Status_Name ascending
    )
}
