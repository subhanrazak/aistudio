form Branches
{
    displayname = "Branches"

    Section_Branch_Info
    (
        type = section
        displayname = "Branch Information"
        row = 1
        column = 0
    )
    Branch_Code
    (
        type = autonumber
        displayname = "Branch Code"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Company
    (
        type = picklist
        displayname = "Company"
        values = Company_Details.ID
        displayformat = [Company_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Branch_Name
    (
        type = text
        displayname = "Branch Name"
        row = 1
        column = 2
        width = medium
    )
    Branch_Type
    (
        type = picklist
        displayname = "Branch Type"
        values = {"Head Office","Regional Office","Plant","Warehouse","Sales Office","Other"}
        row = 1
        column = 1
        width = medium
    )
    Branch_Email
    (
        type = email
        displayname = "Branch Email"
        row = 1
        column = 2
        width = medium
    )
    Branch_Phone
    (
        type = phonenumber
        displayname = "Branch Phone"
        row = 1
        column = 1
        width = medium
    )
    Branch_Address
    (
        type = address
        displayname = "Branch Address"
        row = 1
        column = 2
        width = medium
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
    )
    Branch_Manager
    (
        type = picklist
        displayname = "Branch Manager"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Branch_Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
