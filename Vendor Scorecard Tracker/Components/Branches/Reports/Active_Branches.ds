list Active_Branches
{
    displayName = "Active Branches"
    show all rows from Branches [Branch_Status == "Active"]
    (
        Branch_Code
        Company
        Branch_Name
        Branch_Type
        Branch_Manager
        Branch_Email
        Branch_Phone
        Branch_Address
        Branch_Status
        Notes
    )
    filters
    (
        Company
        Branch_Type
    )
    sort by
    (
        Branch_Name ascending
    )
}
