list Branches_By_Company
{
    displayName = "Branches By Company"
    show all rows from Branches
    (
        Branch_Code
        Company
        Branch_Name
        Branch_Type
        Branch_Manager
        Branch_Email
        Branch_Phone
        Branch_Address
        Branch_Status
        Notes
    )
    filters
    (
        Company
        Branch_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Company ascending
    )
    sort by
    (
        Branch_Name ascending
    )
}
