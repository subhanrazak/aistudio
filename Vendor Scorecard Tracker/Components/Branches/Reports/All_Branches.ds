default list All_Branches
{
    displayName = "All Branches"
    show all rows from Branches
    (
        Branch_Code
        Company
        Branch_Name
        Branch_Type
        Branch_Manager
        Branch_Email
        Branch_Phone
        Branch_Address
        Branch_Status
        Notes
    )
    filters
    (
        Company
        Branch_Type
        Branch_Status
    )
    sort by
    (
        Branch_Name ascending
    )
}
