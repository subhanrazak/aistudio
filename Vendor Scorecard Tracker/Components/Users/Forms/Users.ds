form Users
{
    displayname = "Users"
    success message = "User saved successfully."
    Section_User_Info
    (
        type = section
        displayname = "User Information"
        row = 1
        column = 0
    )
    User_Code
    (
        type = autonumber
        displayname = "User Code"
        start index = 3001
        row = 1
        column = 1
        width = medium
    )
    must have User_Name
    (
        type = name
        displayname = "User Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Mr.","Mrs.","Ms.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 1
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = {"Procurement","Quality","Finance","Compliance","Operations","Management","Other"}
        row = 1
        column = 2
        width = medium
    )
    User_Profile
    (
        type = picklist
        displayname = "User Profile"
        values = {"Admin","Procurement Executive","Vendor Evaluator"}
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
