default list Performance_Reviews
{
    displayName = "Performance Reviews"
    show all rows from Performance_Review
    (
        Performance_Review_Number
        Vendor
        Review_Date
        Review_Period
        Reviewer
        Category
        Criteria
        Rating
        Weighted_Score
        Review_Status
        Next_Review_Date
    )
    filters
    (
        Vendor
        Review_Period
        Reviewer
        Category
        Review_Status
        "Due for Follow-up" : (Next_Review_Date is not null && Next_Review_Date in next 30 days)
        "Finalized Reviews" : (Review_Status == "Finalized")
    )
    sort by
    (
        Review_Date descending
        Vendor ascending
    )
}
