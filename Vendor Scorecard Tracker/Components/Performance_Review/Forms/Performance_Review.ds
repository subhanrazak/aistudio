form Performance_Review
{
    displayname = "Performance Review"
    success message = "Performance review saved successfully."
    Section_Performance_Info
    (
        type = section
        displayname = "Performance Information"
        row = 1
        column = 0
    )
    Performance_Review_Number
    (
        type = autonumber
        displayname = "Performance Review Number"
        start index = 9001
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Review_Date
    (
        type = date
        displayname = "Review Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Review_Period
    (
        type = picklist
        displayname = "Review Period"
        values = {"Monthly","Quarterly","Half Yearly","Yearly","Ad hoc"}
        row = 1
        column = 2
        width = medium
    )
    Reviewer
    (
        type = picklist
        displayname = "Reviewer"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Criteria
    (
        type = picklist
        displayname = "Criteria"
        values = Criteria.ID
        displayformat = [Criteria_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Rating
    (
        type = picklist
        displayname = "Rating"
        values = Rating_Scales.ID
        displayformat = [Rating_Label]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Weight_Percentage
    (
        type = decimal
        displayname = "Weight Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Rating_Score_Percentage
    (
        type = decimal
        displayname = "Rating Score Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Weighted_Score
    (
        type = decimal
        displayname = "Weighted Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Review_Status
    (
        type = picklist
        displayname = "Review Status"
        values = {"Draft","Submitted","Reviewed","Finalized"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Improvement_Action
    (
        type = textarea
        displayname = "Improvement Action"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Next_Review_Date
    (
        type = date
        displayname = "Next Review Date"
        row = 1
        column = 2
        width = medium
    )
    Comments
    (
        type = textarea
        displayname = "Comments"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
