form Documents
{
    displayname = "Documents"
    success message = "Document saved successfully."
    Section_Document_Info
    (
        type = section
        displayname = "Document Information"
        row = 1
        column = 0
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Document_Type
    (
        type = picklist
        displayname = "Document Type"
        values = {"Registration","KYC","Tax","Compliance","Contract","Insurance","Quality Certificate","Financial","Other"}
        row = 1
        column = 2
        width = medium
    )
    Related_Process
    (
        type = picklist
        displayname = "Related Process"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","General"}
        row = 1
        column = 1
        width = medium
    )
    Document_Number
    (
        type = text
        displayname = "Document Number"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Document_File
    (
        type = upload file
        displayname = "Document File"
        browse = local_drive
        file count = 1
        row = 1
        column = 1
        width = medium
    )
    Issue_Date
    (
        type = date
        displayname = "Issue Date"
        row = 1
        column = 2
        width = medium
    )
    Expiry_Date
    (
        type = date
        displayname = "Expiry Date"
        row = 1
        column = 1
        width = medium
    )
    Verification_Status
    (
        type = picklist
        displayname = "Verification Status"
        values = {"Pending","Verified","Rejected","Expired"}
        initial value = "Pending"
        row = 1
        column = 2
        width = medium
    )
    Verified_By
    (
        type = picklist
        displayname = "Verified By"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Verified_On
    (
        type = date
        displayname = "Verified On"
        row = 1
        column = 2
        width = medium
    )
    Rejection_Reason
    (
        type = textarea
        displayname = "Rejection Reason"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
