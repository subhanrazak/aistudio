default list Vendor_Documents
{
    displayName = "Vendor Documents"
    show all rows from Documents
    (
        Vendor
        Document_Type
        Related_Process
        Document_Number
        Expiry_Date
        Verification_Status
        Verified_By
        Verified_On
    )
    filters
    (
        Vendor
        Document_Type
        Related_Process
        Verification_Status
        "Pending Verification" : (Verification_Status == "Pending")
        "Verified Documents" : (Verification_Status == "Verified")
    )
    sort by
    (
        Vendor ascending
        Expiry_Date ascending
    )
}
