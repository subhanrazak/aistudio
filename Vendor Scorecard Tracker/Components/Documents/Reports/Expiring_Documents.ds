list Expiring_Documents
{
    displayName = "Expiring Documents"
    show all rows from Documents [Expiry_Date is not null]
    (
        Vendor
        Document_Type
        Document_Number
        Expiry_Date
        Verification_Status
    )
    filters
    (
        Vendor
        Document_Type
        Verification_Status
    )
    sort by
    (
        Expiry_Date ascending
        Vendor ascending
    )
}
