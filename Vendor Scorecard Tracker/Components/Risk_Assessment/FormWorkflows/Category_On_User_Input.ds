Risk_Assessment_Category_On_User_Input as "Risk Category On User Input"
{
    type = form
    form = Risk_Assessment
    record event = on add or edit
    description = "Clears dependent risk criteria and score values when category changes."

    on user input of Category
    {
        actions
        {
            custom deluge script
            (
                input.Criteria = null;
                input.Weight_Percentage = 0;
                input.Weighted_Risk_Score = 0;
            )
        }
    }
}
