form Risk_Assessment
{
    displayname = "Risk Assessment"
    success message = "Risk assessment saved successfully."
    Section_Risk_Info
    (
        type = section
        displayname = "Risk Information"
        row = 1
        column = 0
    )
    Risk_Assessment_Number
    (
        type = autonumber
        displayname = "Risk Assessment Number"
        start index = 7001
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Assessment_Date
    (
        type = date
        displayname = "Assessment Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Assessment_Cycle
    (
        type = text
        displayname = "Assessment Cycle"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Assessor
    (
        type = picklist
        displayname = "Assessor"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Criteria
    (
        type = picklist
        displayname = "Criteria"
        values = Criteria.ID
        displayformat = [Criteria_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Risk_Rating
    (
        type = picklist
        displayname = "Risk Rating"
        values = Rating_Scales.ID
        displayformat = [Rating_Label]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Weight_Percentage
    (
        type = decimal
        displayname = "Weight Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Risk_Score_Percentage
    (
        type = decimal
        displayname = "Risk Score Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Weighted_Risk_Score
    (
        type = decimal
        displayname = "Weighted Risk Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Risk_Status
    (
        type = picklist
        displayname = "Risk Status"
        values = {"Draft","Submitted","Reviewed","Mitigation Required","Closed"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Mitigation_Action
    (
        type = textarea
        displayname = "Mitigation Action"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Target_Date
    (
        type = date
        displayname = "Target Date"
        row = 1
        column = 2
        width = medium
    )
    Comments
    (
        type = textarea
        displayname = "Comments"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
