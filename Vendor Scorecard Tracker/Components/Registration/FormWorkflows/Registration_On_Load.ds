Registration_On_Load as "Registration On Load"
{
    type = form
    form = Registration
    record event = on add or edit
    description = "Defaults submitter email and locks system-managed fields."

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Submitted_By_Email in ["", " ", "null"])
                {
                    input.Submitted_By_Email = zoho.loginuserid;
                }
                disable Registration_Date;
                disable Submitted_By_Email;
                disable Registration_Score;
            )
        }
    }
}
