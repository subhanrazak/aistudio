default list Vendor_Registrations
{
    displayName = "Vendor Registrations"
    show all rows from Registration
    (
        Registration_Number
        Vendor
        Registration_Date
        Submitted_By_Email
        Registration_Status
        Registration_Score
    )
    filters
    (
        Vendor
        Registration_Status
        Registration_Date
        "Submitted" : (Registration_Status == "Submitted")
        "Accepted" : (Registration_Status == "Accepted")
        "Rejected" : (Registration_Status == "Rejected")
    )
    sort by
    (
        Registration_Date descending
        Vendor ascending
    )
}
