report Registration_Status_Board
{
    quickview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -1
                fields
                (
                    Registration_Number
                    Vendor
                    Registration_Date
                    Registration_Status
                    Registration_Score
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Registration_Number
                    Vendor
                    Registration_Date
                    Registration_Status
                    Registration_Score
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
