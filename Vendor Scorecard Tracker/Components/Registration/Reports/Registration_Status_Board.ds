kanban Registration_Status_Board
{
    displayName = "Registration Status Board"
    show all rows from Registration
    (
        Registration_Number
        Vendor
        Registration_Date
        Registration_Status
        Registration_Score
    )
    filters
    (
        Vendor
        Registration_Date
    )
    sort by
    (
        Registration_Date descending
        Registration_Score descending
    )
    options
    (
        display field = Registration_Status
        emptycolumn = "No Status"
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}
