list Criteria_By_Category
{
    displayName = "Criteria By Category"
    show all rows from Criteria
    (
        Category
        Criteria_Code
        Criteria_Name
        Applies_To
        Status
    )
    filters
    (
        Applies_To
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Category ascending
    )
    sort by
    (
        Criteria_Name ascending
    )
}
