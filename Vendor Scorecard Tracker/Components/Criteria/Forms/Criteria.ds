form Criteria
{
    displayname = "Criteria"
    success message = "Criterion saved successfully."
    Section_Criteria_Info
    (
        type = section
        displayname = "Criteria Information"
        row = 1
        column = 0
    )
    Criteria_Code
    (
        type = autonumber
        displayname = "Criteria Code"
        start index = 2001
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Criteria_Name
    (
        type = text
        displayname = "Criteria Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Applies_To
    (
        type = picklist
        displayname = "Applies To"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review"}
        row = 1
        column = 2
        width = medium
    )
    Measurement_Type
    (
        type = picklist
        displayname = "Measurement Type"
        values = {"Rating Scale","Yes/No","Numeric","Text"}
        initial value = "Rating Scale"
        row = 1
        column = 1
        width = medium
    )
    Is_Mandatory
    (
        type = checkbox
        displayname = "Is Mandatory"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
