form Company_Details
{
    displayname = "Company Details"

    Section_Company_Info
    (
        type = section
        displayname = "Company Information"
        row = 1
        column = 0
    )
    Company_Code
    (
        type = autonumber
        displayname = "Company Code"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have unique Company_Name
    (
        type = text
        displayname = "Company Name"
        row = 1
        column = 1
        width = medium
    )
    Legal_Name
    (
        type = text
        displayname = "Legal Name"
        row = 1
        column = 2
        width = medium
    )
    Tax_ID
    (
        type = text
        displayname = "Tax ID"
        row = 1
        column = 1
        width = medium
    )
    Website
    (
        type = url
        displayname = "Website"
        row = 1
        column = 2
        width = medium
    )
    Primary_Email
    (
        type = email
        displayname = "Primary Email"
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 2
        width = medium
    )
    Address
    (
        type = address
        displayname = "Address"
        row = 1
        column = 1
        width = medium
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
    )
    Company_Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
