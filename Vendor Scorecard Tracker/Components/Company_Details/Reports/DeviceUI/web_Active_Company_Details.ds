report Active_Company_Details
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Company_Code
                    Company_Name
                    Legal_Name
                    Primary_Email
                    Phone
                    Company_Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Company_Code
                    Company_Name
                    Legal_Name
                    Tax_ID
                    Website
                    Primary_Email
                    Phone
                    Address
                    Company_Status
                    Notes
                )
            )
        )
        menu
        (
            header
            (
