list Active_Company_Details
{
    displayName = "Active Company Details"
    show all rows from Company_Details [Company_Status == "Active"]
    (
        Company_Code
        Company_Name
        Legal_Name
        Tax_ID
        Website
        Primary_Email
        Phone
        Address
        Company_Status
        Notes
    )
    filters
    (
        Company_Name
    )
    sort by
    (
        Company_Name ascending
    )
}
