<page linkname = "Vendor_Scorecard_Dashboard" parameters = "int Vendor_ID" displayname = "Vendor Scorecard Dashboard"/>
<content>
<zml mobileDeviceConfig='{"layout":{"displayType":"card","design":"onebyone","forcedOrientation":false}}' tabletDeviceConfig='{"layout":{"displayType":"plain","design":"onebyone","forcedOrientation":false}}'>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Vendor_Header_KPIs_Dsp' elementName='Vendor_Header_KPIs'>
          <![CDATA[htmlpage Vendor_Header_KPIs_Dsp()
            content
            <%{%>
              <file name:Vendor_Header_KPIs.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Gauge_Overall_Score.ds/>
      </column>
      <column width='50%'>
        <file name:Gauge_Risk_Score.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Chart_Evaluation_Weighted_By_Category.ds/>
      </column>
      <column width='50%'>
        <file name:Chart_Performance_Weighted_By_Category.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Scorecard_Summary_Table_Dsp' elementName='Scorecard_Summary_Table'>
          <![CDATA[htmlpage Scorecard_Summary_Table_Dsp()
            content
            <%{%>
              <file name:Scorecard_Summary_Table.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Report_Vendor_Documents.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Report_Evaluation_Scores.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Report_Risk_Assessments.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Report_Onboarding_Tracker.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Report_Performance_Reviews.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
