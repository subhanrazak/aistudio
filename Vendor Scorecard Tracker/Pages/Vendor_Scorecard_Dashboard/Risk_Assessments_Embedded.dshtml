<style>
.vendor-embed-card { background:#FFFFFF; border:1px solid #E7E7EE; border-radius:12px; padding:16px; box-sizing:border-box; }
.vendor-embed-title { color:var(--zcs_primary_text_color); font-size:18px; font-weight:700; margin-bottom:12px; }
.vendor-embed-note { color:var(--zcs_tertiary_text_color); font-size:12px; margin-bottom:10px; }
</style>
<%
reportCriteria = "Vendor == " + input.Vendor_ID;
%>
<div class="vendor-embed-card">
  <div class="vendor-embed-title">Risk Assessments</div>
  <div class="vendor-embed-note">Filtered for the selected vendor.</div>
  <div zc-component="report" zc-linkname="Risk_Assessments" zc-criteria="<%=reportCriteria%>" zc-height="380px"></div>
</div>