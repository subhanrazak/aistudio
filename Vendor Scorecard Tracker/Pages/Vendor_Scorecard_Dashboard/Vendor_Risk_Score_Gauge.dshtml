<style>
.vendor-risk-gauge-card {
  background: #FFFFFF;
  border: 1px solid #E7E7EE;
  border-radius: 12px;
  padding: 18px;
  box-sizing: border-box;
  min-height: 220px;
  font-family: inherit;
}
.vendor-risk-gauge-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}
.vendor-risk-gauge-title {
  color: var(--zcs_primary_text_color);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.25;
}
.vendor-risk-gauge-subtitle {
  color: var(--zcs_tertiary_text_color);
  font-size: 12px;
  margin-top: 4px;
}
.vendor-risk-gauge-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #FFF2E8;
  color: #F4660C;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.vendor-risk-gauge-value {
  color: #12132B;
  font-size: 40px;
  font-weight: 800;
  line-height: 1;
  margin: 18px 0 8px;
}
.vendor-risk-gauge-track {
  width: 100%;
  height: 12px;
  border-radius: 999px;
  background: #F3F3F4;
  overflow: hidden;
  margin: 16px 0 10px;
}
.vendor-risk-gauge-fill {
  height: 100%;
  border-radius: 999px;
}
.vendor-risk-gauge-fill.low { background: #179E6C; }
.vendor-risk-gauge-fill.medium { background: #FAAE13; }
.vendor-risk-gauge-fill.high { background: #F4660C; }
.vendor-risk-gauge-fill.critical { background: #FE455D; }
.vendor-risk-gauge-scale {
  display: flex;
  justify-content: space-between;
  color: var(--zcs_tertiary_text_color);
  font-size: 12px;
}
.vendor-risk-gauge-target {
  color: #6B7280;
  font-size: 13px;
  font-weight: 600;
  margin-top: 14px;
}
</style>
<%
vendorRows = Vendors[ID == input.Vendor_ID];
riskScore = 0;
if(vendorRows.count() > 0)
{
  vendorRec = vendorRows;
  riskScore = ifnull(vendorRec.Risk_Score,0);
}
riskWidth = riskScore;
if(riskWidth < 0)
{
  riskWidth = 0;
}
if(riskWidth > 100)
{
  riskWidth = 100;
}
riskClass = "low";
if(riskScore > 75)
{
  riskClass = "critical";
}
else if(riskScore > 50)
{
  riskClass = "high";
}
else if(riskScore > 25)
{
  riskClass = "medium";
}
%>
<div class="vendor-risk-gauge-card">
  <div class="vendor-risk-gauge-header">
    <div>
      <div class="vendor-risk-gauge-title">Risk Score Gauge</div>
      <div class="vendor-risk-gauge-subtitle">Lower risk score is preferred</div>
    </div>
    <div class="vendor-risk-gauge-icon"><i class="zc-li-outline ui-1-alert-circle-i" style="font-size:22px;"></i></div>
  </div>
  <div class="vendor-risk-gauge-value"><%=riskScore%></div>
  <div class="vendor-risk-gauge-track"><div class="vendor-risk-gauge-fill <%=riskClass%>" style="width:<%=riskWidth%>%;"></div></div>
  <div class="vendor-risk-gauge-scale"><span>0</span><span>Target below 30</span><span>100</span></div>
  <div class="vendor-risk-gauge-target">Target: below 30 / 100</div>
</div>