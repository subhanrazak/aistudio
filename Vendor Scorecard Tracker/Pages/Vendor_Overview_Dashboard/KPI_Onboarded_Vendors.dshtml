<style>
.vendor-overview-kpi { background:#FFFFFF; border:1px solid #E7E7EE; border-radius:12px; padding:16px; box-sizing:border-box; display:flex; align-items:center; gap:12px; min-height:86px; }
.vendor-overview-kpi-icon { width:44px; height:44px; border-radius:22px; display:inline-flex; align-items:center; justify-content:center; color:#FFFFFF; background:#179E6C; flex:0 0 auto; }
.vendor-overview-kpi-label { color:#5F6199; font-size:13px; line-height:1.4; }
.vendor-overview-kpi-value { color:#179E6C; font-size:32px; font-weight:700; line-height:1.1; margin-top:2px; }
</style>
<%
onboardedCount = Vendors[Vendor_Status == "Onboarded"].count();
%>
<div class="vendor-overview-kpi">
  <div class="vendor-overview-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08" style="font-size:24px;"></i></div>
  <div>
    <div class="vendor-overview-kpi-label">Onboarded Vendors</div>
    <div class="vendor-overview-kpi-value"><%=onboardedCount%></div>
  </div>
</div>