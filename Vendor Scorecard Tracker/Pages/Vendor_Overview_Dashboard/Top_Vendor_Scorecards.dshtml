<%
  topVendors = Vendors[ID != 0] sort by Overall_Score desc range from 1 to 6;
%>
<style>
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-10 { padding: .625rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-m-0 { margin: 0; }
.zcs-w-full { width: 100%; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }
a { text-decoration: none; }
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }
.zcs-table-wrapper table thead { top: 0px; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.vod-scorecard { min-height: 100%; }
.vod-card-header { border-bottom: 1px solid var(--zcs_tertiary_border_color); }
.vod-subtitle { color: var(--zcs_secondary_text_color); }
.vod-vendor-name { color: var(--zcs_primary_text_color); font-weight: 600; }
.vod-muted { color: var(--zcs_secondary_text_color); }
.vod-link { white-space: nowrap; }
.vod-empty { min-height: 180px; border: 1px dashed var(--zcs_tertiary_border_color); background: #F9FAFE; }
@media screen and (max-width: 700px) {
  .vod-hide-sm { display: none; }
  .zcs-table-wrapper table { min-width: 640px; }
  .vod-card-header { align-items: flex-start; flex-direction: column; }
}
</style>
<div class='vod-scorecard zcs-card zcs-flex zcs-direction-column zcs-relative'>
  <div class='vod-card-header zcs-p-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12'>
    <div>
      <h3 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Top Vendor Scorecards</h3>
      <div class='vod-subtitle zcs-font-13 zcs-lh-body'>Highest overall scores with current risk and tier.</div>
    </div>
    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Vendors'>
      <span class='zcs-button-text'>View All Vendors</span>
    </a>
  </div>
  <div class='zcs-p-16 zcs-box-border'>
<%
  if(topVendors.count() == 0)
  {
%>
    <div class='vod-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-p-16 zcs-box-border'>
      <i class='zc-li-outline ui-1-alert-circle-i zcs-font-18 zcs-color-tertiary'></i>
      <div class='zcs-font-14 zcs-font-medium zcs-color-primary'>No vendor scorecards yet</div>
      <div class='zcs-font-13 vod-muted'>Vendor scores will appear after scorecard activity is recorded.</div>
    </div>
<%
  }
  else
  {
%>
    <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
      <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
          <tr>
            <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Vendor</th>
            <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary vod-hide-sm'>Tier</th>
            <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Risk</th>
            <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Score</th>
            <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Scorecard</th>
          </tr>
          <tr class='zcs-tspace'>
            <th class='zcs-p-2 zcs-box-border' colspan='5'> </th>
          </tr>
        </thead>
        <tbody>
<%
    for each vendorRec in topVendors
    {
      score = ifnull(vendorRec.Overall_Score,0);
      scoreBadge = "zcs-badge-red";
      if(score >= 85)
      {
        scoreBadge = "zcs-badge-green";
      }
      else if(score >= 70)
      {
        scoreBadge = "zcs-badge-blue";
      }
      else if(score >= 50)
      {
        scoreBadge = "zcs-badge-yellow";
      }
      riskText = ifnull(vendorRec.Risk_Level,"Not Assessed");
      riskBadge = "zcs-badge-grey";
      if(riskText == "Low")
      {
        riskBadge = "zcs-badge-green";
      }
      else if(riskText == "Medium")
      {
        riskBadge = "zcs-badge-yellow";
      }
      else if(riskText == "High")
      {
        riskBadge = "zcs-badge-orange";
      }
      else if(riskText == "Critical")
      {
        riskBadge = "zcs-badge-red";
      }
      vendorUrl = "#Page:Vendor_Scorecard_Dashboard?Vendor_ID=" + vendorRec.ID;
%>
          <tr>
            <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
              <div class='vod-vendor-name'><%=ifnull(vendorRec.Vendor_Name,"Unnamed Vendor")%></div>
              <div class='vod-muted zcs-font-12'><%=ifnull(vendorRec.Vendor_Code,"No Code")%> · <%=ifnull(vendorRec.Vendor_Status,"No Status")%></div>
            </td>
            <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary vod-hide-sm'><%=ifnull(vendorRec.Vendor_Tier,"Unclassified")%></td>
            <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
              <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=riskBadge%>'>
                <span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=riskText%></span>
              </div>
            </td>
            <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
              <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=scoreBadge%>'>
                <span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'><%=score%></span>
              </div>
            </td>
            <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body'>
              <a class='vod-link zcs-color-primary zcs-font-medium' href='<%=vendorUrl%>'>Open <i class='zc-li-outline arrows-1-tail-right'></i></a>
            </td>
          </tr>
<%
    }
%>
        </tbody>
      </table>
    </div>
<%
  }
%>
  </div>
</div>
