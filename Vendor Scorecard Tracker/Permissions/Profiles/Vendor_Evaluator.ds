"Vendor_Evaluator"
{
    name        = "Vendor_Evaluator"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Internal evaluators entering evaluations, risk assessments, and performance reviews."

    ModulePermissions
    {
        Categories
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Categories={"View"}
                Active_Categories={"View"}
            }
        }

        Criteria
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Criteria={"View"}
                Criteria_By_Category={"View"}
            }
        }

        Weightages
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                Active_Weightages={"View"}
                Weightages_By_Process={"View"}
            }
        }

        Rating_Scales
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Rating_Scales={"View"}
                Rating_Scales_By_Process={"View"}
            }
        }

        Vendors
        {
            enabled          = Viewall,Tab,View,Search,Export,read_comm
            allFieldsVisible = false
            ReportPermissions
            {
                All_Vendors={"View"}
                Vendor_Pipeline={"View"}
            }
            FieldPermissions
            {
                Internal_Notes{visibility:false}
                Primary_Email{visibility:true,readonly:true}
                Phone{visibility:true,readonly:true}
                Address{visibility:true,readonly:true}
                Overall_Score{visibility:true,readonly:true}
                Evaluation_Score{visibility:true,readonly:true}
                Risk_Score{visibility:true,readonly:true}
                Performance_Score{visibility:true,readonly:true}
                Vendor_Tier{visibility:true,readonly:true}
            }
        }

        Documents
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Documents={"View"}
                Expiring_Documents={"View"}
            }
            FieldPermissions
            {
                Document_File{visibility:true,readonly:true}
                Verified_By{visibility:true,readonly:true}
                Verified_On{visibility:true,readonly:true}
                Rejection_Reason{visibility:true,readonly:true}
            }
        }

        Onboarding
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                Onboarding_Tracker={"View"}
                Onboarding_By_Status={"View"}
            }
        }

        Evaluation
        {
            enabled          = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Evaluations={"View","Edit"}
                Evaluation_Scores={"View"}
            }
            FieldPermissions
            {
                Evaluation_Number{visibility:true,readonly:true}
                Weight_Percentage{visibility:true,readonly:true}
                Rating_Score_Percentage{visibility:true,readonly:true}
                Weighted_Score{visibility:true,readonly:true}
            }
        }

        Risk_Assessment
        {
            enabled          = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = false
            ReportPermissions
            {
                Risk_Assessments={"View","Edit"}
                High_Risk_Assessments={"View"}
            }
            FieldPermissions
            {
                Risk_Assessment_Number{visibility:true,readonly:true}
                Weight_Percentage{visibility:true,readonly:true}
                Risk_Score_Percentage{visibility:true,readonly:true}
                Weighted_Risk_Score{visibility:true,readonly:true}
            }
        }

        Performance_Review
        {
            enabled          = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = false
            ReportPermissions
            {
                Performance_Reviews={"View","Edit"}
                Performance_Scores={"View"}
            }
            FieldPermissions
            {
                Performance_Review_Number{visibility:true,readonly:true}
                Weight_Percentage{visibility:true,readonly:true}
                Rating_Score_Percentage{visibility:true,readonly:true}
                Weighted_Score{visibility:true,readonly:true}
            }
        }

        Company_Details
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Company_Details={"View"}
                Active_Company_Details={"View"}
            }
        }

        Branches
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Branches={"View"}
                Active_Branches={"View"}
                Branches_By_Company={"View"}
            }
        }

        Departments
        {
            enabled          = Viewall,Tab,View,Search,read_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Departments={"View"}
                Active_Departments={"View"}
                Departments_By_Branch={"View"}
            }
        }

        Vendor_Overview_Dashboard
        {
            enabled = tab
        }

        Vendor_Scorecard_Dashboard
        {
            enabled = tab
        }
    }
}

