"Onboarded_Vendor"
{
    name        = "Onboarded_Vendor"
    type        = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Portal users for onboarded vendors maintaining limited vendor data and viewing their own scorecard."

    ModulePermissions
    {
        Vendors
        {
            enabled          = View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Vendors={"View"}
            }
            FieldPermissions
            {
                Vendor_Code{visibility:true,readonly:true}
                Vendor_Name{visibility:true,readonly:true}
                Vendor_Type{visibility:true,readonly:true}
                Tax_ID{visibility:true,readonly:true}
                Website{visibility:true,readonly:false}
                Primary_Email{visibility:true,readonly:false}
                Phone{visibility:true,readonly:false}
                Address{visibility:true,readonly:false}
                Vendor_Status{visibility:true,readonly:true}
                Risk_Level{visibility:true,readonly:true}
                Overall_Score{visibility:true,readonly:true}
                Evaluation_Score{visibility:true,readonly:true}
                Risk_Score{visibility:true,readonly:true}
                Performance_Score{visibility:true,readonly:true}
                Last_Evaluation_Date{visibility:true,readonly:true}
                Last_Performance_Review_Date{visibility:true,readonly:true}
                Vendor_Tier{visibility:true,readonly:true}
                Internal_Notes{visibility:false}
            }
        }

        Contacts
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Contacts={"View"}
                Primary_Contacts={"View"}
            }
            FieldPermissions
            {
                Vendor{visibility:true,readonly:true}
                Contact_Name{visibility:true,readonly:false}
                Contact_Email{visibility:true,readonly:false}
                Contact_Phone{visibility:true,readonly:false}
                Designation{visibility:true,readonly:false}
                Contact_Type{visibility:true,readonly:false}
                Is_Primary_Contact{visibility:true,readonly:false}
                Portal_User_Type{visibility:false}
                Status{visibility:true,readonly:false}
                Notes{visibility:true,readonly:false}
            }
        }

        Products_Services
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Products_Services={"View"}
                Critical_Products_Services={"View"}
            }
            FieldPermissions
            {
                Vendor{visibility:true,readonly:true}
                Item_Name{visibility:true,readonly:false}
                Item_Type{visibility:true,readonly:false}
                Service_Category{visibility:true,readonly:false}
                Description{visibility:true,readonly:false}
                Criticality{visibility:true,readonly:false}
                Approval_Status{visibility:true,readonly:true}
                Effective_From{visibility:true,readonly:false}
                Effective_To{visibility:true,readonly:false}
                Notes{visibility:true,readonly:false}
            }
        }

        Documents
        {
            enabled          = Create,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Documents={"View"}
            }
            FieldPermissions
            {
                Vendor{visibility:true,readonly:true}
                Document_Type{visibility:true,readonly:false}
                Related_Process{visibility:true,readonly:false}
                Document_Number{visibility:true,readonly:false}
                Document_File{visibility:true,readonly:false}
                Issue_Date{visibility:true,readonly:false}
                Expiry_Date{visibility:true,readonly:false}
                Verification_Status{visibility:true,readonly:true}
                Verified_By{visibility:false}
                Verified_On{visibility:false}
                Rejection_Reason{visibility:true,readonly:true}
                Notes{visibility:true,readonly:false}
            }
        }

        Registration
        {
            enabled          = View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Vendor_Registrations={"View"}
            }
            FieldPermissions
            {
                Registration_Number{visibility:true,readonly:true}
                Vendor{visibility:true,readonly:true}
                Registration_Date{visibility:true,readonly:true}
                Submitted_By_Email{visibility:true,readonly:true}
                Registration_Status{visibility:true,readonly:true}
                Business_Summary{visibility:true,readonly:true}
                Years_In_Business{visibility:true,readonly:true}
                Annual_Turnover{visibility:true,readonly:true}
                Employee_Count{visibility:true,readonly:true}
                Declaration_Accepted{visibility:true,readonly:true}
                Registration_Score{visibility:false}
                Reviewer_Comments{visibility:false}
            }
        }

        Onboarding
        {
            enabled          = View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Onboarding_Tracker={"View"}
            }
            FieldPermissions
            {
                Onboarding_Number{visibility:true,readonly:true}
                Vendor{visibility:true,readonly:true}
                Onboarding_Start_Date{visibility:true,readonly:true}
                Assigned_To{visibility:false}
                Onboarding_Status{visibility:true,readonly:true}
                Target_Completion_Date{visibility:true,readonly:true}
                Completion_Date{visibility:true,readonly:true}
                Bank_Details_Received{visibility:true,readonly:true}
                Contract_Signed{visibility:true,readonly:true}
                Compliance_Clearance{visibility:true,readonly:true}
                ERP_Created{visibility:true,readonly:true}
                Onboarding_Score{visibility:true,readonly:true}
                Remarks{visibility:true,readonly:true}
            }
        }

        Performance_Review
        {
            enabled          = View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Performance_Scores={"View"}
            }
            FieldPermissions
            {
                Performance_Review_Number{visibility:true,readonly:true}
                Vendor{visibility:true,readonly:true}
                Review_Date{visibility:true,readonly:true}
                Review_Period{visibility:true,readonly:true}
                Reviewer{visibility:false}
                Category{visibility:true,readonly:true}
                Criteria{visibility:true,readonly:true}
                Rating{visibility:true,readonly:true}
                Weight_Percentage{visibility:false}
                Rating_Score_Percentage{visibility:false}
                Weighted_Score{visibility:true,readonly:true}
                Review_Status{visibility:true,readonly:true}
                Improvement_Action{visibility:true,readonly:true}
                Next_Review_Date{visibility:true,readonly:true}
                Comments{visibility:true,readonly:true}
            }
        }

        Vendor_Scorecard_Dashboard
        {
            enabled = tab
        }
    }
}

