map Seed_Development_Data(string confirmation)
{
    result = Map();
    result.put("status","blocked");
    result.put("records_created",0);
    if (confirmation != "SEED_DEVELOPMENT_ONLY")
    {
        result.put("message","No data added. Run only in the development environment with confirmation SEED_DEVELOPMENT_ONLY.");
        return result;
    }
    if (ifnull(zoho.loginuserid,"") == "")
    {
        result.put("message","A signed-in Creator developer is required to seed Employee Master.");
        return result;
    }

    created_count = 0;
    completed_seed = Activity_Log[log_id == "DEV-SEED-V1" && new_value == "COMPLETE"];
    if (completed_seed.count() > 0)
    {
        result.put("status","already_seeded");
        result.put("message","Development sample data V1 already exists.");
        return result;
    }

    developer_employee = Employee_Master[email == zoho.loginuserid];
    if (developer_employee.count() == 0)
    {
        employee_id = insert into Employee_Master
        [
            employee_name = "Development Administrator"
            creator_user = zoho.loginuser
            email = zoho.loginuserid
            profile_label = "ADMIN"
            department = "Product Lifecycle Management"
            is_active = true
            notification_opt_in = false
        ];
        created_count = created_count + 1;
    }
    else
    {
        employee_id = developer_employee.ID;
    }

    if (Category_Master[category_name == "DEV Resistor"].count() == 0)
    {
        insert into Category_Master
        [
            category_name = "DEV Resistor"
            prefix = "DVR"
            item_group = "Electrical_Component"
            item_type = "Library_Component"
            id_digit_length = 5
            version_digit_length = 2
            last_issued_number = 8
            is_active = true
        ];
        created_count = created_count + 1;
    }
    if (Category_Master[category_name == "DEV Mechanical"].count() == 0)
    {
        insert into Category_Master
        [
            category_name = "DEV Mechanical"
            prefix = "DVM"
            item_group = "Mechanical_Component"
            item_type = "Library_Component"
            id_digit_length = 5
            version_digit_length = 2
            last_issued_number = 4
            is_active = true
        ];
        created_count = created_count + 1;
    }
    if (Category_Master[category_name == "DEV Assembly"].count() == 0)
    {
        insert into Category_Master
        [
            category_name = "DEV Assembly"
            prefix = "DVA"
            item_group = "Assembly"
            item_type = "Assembly_Component"
            id_digit_length = 5
            version_digit_length = 2
            last_issued_number = 3
            is_active = true
        ];
        created_count = created_count + 1;
    }
    resistor_category = Category_Master[category_name == "DEV Resistor"];
    mechanical_category = Category_Master[category_name == "DEV Mechanical"];
    assembly_category = Category_Master[category_name == "DEV Assembly"];

    if (Manufacturer_Master[manufacturer_name == "DEV Vishay Components"].count() == 0)
    {
        insert into Manufacturer_Master
        [
            manufacturer_name = "DEV Vishay Components"
            manufacturer_code = "DVV"
            country = "United States"
            is_approved = true
            is_active = true
            contact_name = "Development Contact"
            contact_email = "dev.vishay@example.com"
