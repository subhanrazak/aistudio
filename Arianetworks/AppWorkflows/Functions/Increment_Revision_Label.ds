string Increment_Revision_Label(string current_revision)
{
    if (current_revision == null || current_revision == "" || current_revision == "-")
    {
        return "A";
    }
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    current_revision = current_revision.toUpperCase();
    if (current_revision == "Z")
    {
        return "AA";
    }
    if (current_revision.length() == 1)
    {
        idx = alphabet.indexOf(current_revision);
        if (idx >= 0 && idx < 25)
        {
            return alphabet.subString(idx + 1, idx + 2);
        }
    }
    return current_revision + "A";
}