void Write_Activity_Log(string activity_type, string record_id, string field_changed, string old_value, string new_value, int changed_by_employee)
{
    insert into Activity_Log
    [
        log_id = thisapp.Generate_Record_Code("LOG-")
        activity_record_type = activity_type
        record_id = record_id
        field_changed = field_changed
        old_value = old_value
        new_value = new_value
        changed_by_employee = changed_by_employee
        changed_on = zoho.currenttime
    ];
}