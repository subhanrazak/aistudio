map Get_Template(string template_key)
{
    template_map = Map();
    template_rec = Notification_Template[template_key == template_key && is_active == true];
    if (template_rec.count() > 0)
    {
        template_map.put("subject", template_rec.subject);
        template_map.put("body", template_rec.body);
    }
    else
    {
        template_map.put("subject", template_key);
        template_map.put("body", "Notification: " + template_key);
    }
    return template_map;
}