int Propose_Bulk_Remove_Change_Order(list child_item_ids, list parent_item_ids)
{
    creator_emp = thisapp.Get_Employee_For_Login(zoho.loginuser);
    if (creator_emp == 0)
    {
        creator_emp = null;
    }
    co_id = insert into Change_Order
    [
        order_id = thisapp.Generate_Record_Code("ECO-")
        change_category = "Engineering_ECO"
        title = "Bulk BOM Remove Proposal"
        description = "System-generated proposal to remove selected child items from selected parent BOMs."
        effectivity_type = "Permanent_Immediate"
        status = "Open"
        created_by_employee = creator_emp
        created_date = zoho.currenttime
    ];
    thisapp.Write_Activity_Log("Change_Order", co_id.toString(), "bulk_remove_proposal", "", "created", creator_emp);
    return co_id;
}