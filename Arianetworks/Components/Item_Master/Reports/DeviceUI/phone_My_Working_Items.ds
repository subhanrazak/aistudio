report My_Working_Items
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(apn category description lifecycle_phase owner_employee))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(apn category description part_status lifecycle_phase owner_employee))) menu(header(Edit Duplicate Delete)))
}
