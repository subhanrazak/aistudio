form Item_Master
{
    displayname = "Item Master"
    Item_Details
    (
        type = section
        displayname = "Item Details"
        row = 1
        column = 0
    )
    unique apn
    (
        type = text
        displayname = "APN"
        row = 1
        column = 1
        width = medium
    )
    must have category
    (
        type = picklist
        displayname = "Category"
        values = Category_Master[is_active == true].ID
        displayformat = [category_name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    part_name
    (
        type = text
        displayname = "Part Name"
        row = 1
        column = 2
        width = medium
    )
    decal_name
    (
        type = text
        displayname = "Decal Name"
        row = 1
        column = 1
        width = medium
    )
    must have part_type
    (
        type = picklist
        displayname = "Part Type"
        values = {"Component","Assembly","Document","Software_Firmware"}
        row = 1
        column = 2
        width = medium
    )
    value
    (
        type = text
        displayname = "Value"
        row = 1
        column = 1
        width = medium
    )
    voltage
    (
        type = text
        displayname = "Voltage"
        row = 1
        column = 2
        width = medium
    )
    temperature
    (
        type = text
        displayname = "Temperature"
        row = 1
        column = 1
        width = medium
    )
    part_status
    (
        type = picklist
        displayname = "Part Status"
        values = {"In_Work","Released","Obsolete"}
        initial value = "In_Work"
        row = 1
        column = 2
        width = medium
    )
    lifecycle_phase
    (
        type = picklist
        displayname = "Lifecycle Phase"
        values = {"Unreleased","Design","Production","Deprecated","Obsolete","Abandoned"}
        initial value = "Unreleased"
        row = 1
        column = 1
        width = medium
    )
    revision
    (
        type = text
        displayname = "Revision"
        initial value = "-"
        row = 1
        column = 2
        width = medium
    )
    is_variant
    (
        type = checkbox
        displayname = "Is Variant"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    variant_of
    (
        type = picklist
        displayname = "Variant Of"
        values = Item_Master[is_variant == false && is_deleted == false].ID
        displayformat = [apn]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    variant_code
    (
        type = text
        displayname = "Variant Code"
        row = 1
        column = 1
        width = medium
    )
    Manufacturer_Details
    (
        type = section
        displayname = "Manufacturer Details"
        visibility = true
        row = 2
        column = 1
    )
    mfg_0
    (
        type = picklist
        displayname = "Primary Manufacturer"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_0
    (
        type = text
        displayname = "Primary MPN"
        row = 2
        column = 2
        width = medium
    )
    mfg_1
    (
        type = picklist
        displayname = "Alternate Manufacturer 1"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_1
    (
        type = text
        displayname = "Alternate MPN 1"
        row = 2
        column = 2
        width = medium
    )
    mfg_2
    (
        type = picklist
        displayname = "Alternate Manufacturer 2"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_2
    (
        type = text
        displayname = "Alternate MPN 2"
        row = 2
        column = 2
        width = medium
    )
    mfg_3
    (
        type = picklist
        displayname = "Alternate Manufacturer 3"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_3
    (
        type = text
        displayname = "Alternate MPN 3"
        row = 2
        column = 2
        width = medium
    )
    mfg_4
    (
        type = picklist
        displayname = "Alternate Manufacturer 4"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_4
    (
        type = text
        displayname = "Alternate MPN 4"
        row = 2
        column = 2
        width = medium
    )
    mfg_5
    (
        type = picklist
        displayname = "Alternate Manufacturer 5"
        values = Manufacturer_Master[is_active == true].ID
        displayformat = [manufacturer_name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    mpn_5
    (
        type = text
        displayname = "Alternate MPN 5"
        row = 2
        column = 2
        width = medium
    )
    Governance_Details
    (
        type = section
        displayname = "Governance Details"
        visibility = true
        row = 3
        column = 1
    )
    comment
    (
        type = textarea
        displayname = "Comment"
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    primary_file
    (
        type = upload file
        displayname = "Primary File"
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 2
        width = medium
    )
    nir_source
    (
        type = picklist
        displayname = "NIR Source"
        values = New_Item_Request.ID
        displayformat = [nir_id]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    is_deviated
    (
        type = checkbox
        displayname = "Is Deviated"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    must have owner_employee
    (
        type = picklist
        displayname = "Owner Employee"
        values = Employee_Master[is_active == true].ID
        displayformat = [employee_name]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    created_date
    (
        type = datetime
        displayname = "Created Date"
        row = 3
        column = 2
        width = medium
    )
    is_deleted
    (
        type = checkbox
        displayname = "Is Deleted"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    deleted_on
    (
        type = datetime
        displayname = "Deleted On"
        row = 3
        column = 2
        width = medium
    )
    deleted_by_employee
    (
        type = picklist
        displayname = "Deleted By Employee"
        values = Employee_Master.ID
        displayformat = [employee_name]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    deleted_reason
    (
        type = textarea
        displayname = "Deleted Reason"
        height = 80px
        row = 3
        column = 2
        width = medium
    )
    BOM_Lines_Section
    (
        type = section
        displayname = "BOM Lines"
        visibility = false
        row = 4
        column = 1
    )
    bom_lines
    (
        type = grid
        displayname = "BOM Lines"
        values = BOM_Line.ID
        sorttype = fieldbased
        sort by
        (
            line_number ascending
        )
        row = 4
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}