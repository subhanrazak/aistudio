default list Category_Master_List
{
    displayName = "Category Master List"
    show all rows from Category_Master
    (
        category_name
        prefix
        item_group
        item_type
        id_digit_length
        version_digit_length
        last_issued_number
        is_active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        item_group
        item_type
        is_active
    )
    sort by
    (
        category_name ascending
    )
}