report Category_Master_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(category_name prefix item_group item_type is_active))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(category_name prefix item_group item_type id_digit_length version_digit_length last_issued_number is_active))) menu(header(Edit Duplicate Delete)))
}
