report Audit_History
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(changed_on activity_record_type record_id field_changed changed_by_employee))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(changed_on activity_record_type record_id field_changed old_value new_value changed_by_employee))) menu(header(Edit Duplicate Delete)))
}
