form Change_Order_Affected_Item
{
    displayname = "Change Order Affected Item"
    Affected_Item_Details
    (
        type = section
        displayname = "Affected Item Details"
        row = 1
        column = 0
    )
    must have child_item
    (
        type = picklist
        displayname = "Child Item"
        values = Item_Master[is_deleted == false].ID
        displayformat = [apn]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    current_revision
    (
        type = text
        displayname = "Current Revision"
        row = 1
        column = 2
        width = medium
    )
    planned_revision_bump
    (
        type = checkbox
        displayname = "Planned Revision Bump"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    target_lifecycle_phase
    (
        type = picklist
        displayname = "Target Lifecycle Phase"
        values = {"Design","Production","Deprecated","Obsolete"}
        row = 1
        column = 2
        width = medium
    )
    software_load_instruction
    (
        type = textarea
        displayname = "Software Load Instruction"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}