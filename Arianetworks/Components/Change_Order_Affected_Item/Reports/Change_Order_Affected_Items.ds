default list Change_Order_Affected_Items
{
    displayName = "Change Order Affected Items"
    show all rows from Change_Order_Affected_Item
    (
        child_item
        current_revision
        planned_revision_bump
        target_lifecycle_phase
        software_load_instruction
    )
    filters
    (
        child_item
        planned_revision_bump
        target_lifecycle_phase
    )
    sort by
    (
        child_item ascending
    )
}