report Change_Order_Affected_Items
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(child_item current_revision planned_revision_bump target_lifecycle_phase))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(child_item current_revision planned_revision_bump target_lifecycle_phase software_load_instruction))) menu(header(Edit Duplicate Delete)))
}
