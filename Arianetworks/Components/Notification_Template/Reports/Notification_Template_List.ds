default list Notification_Template_List
{
    displayName = "Notification Template List"
    show all rows from Notification_Template
    (
        template_key
        subject
        is_active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        is_active
    )
    sort by
    (
        template_key ascending
    )
}