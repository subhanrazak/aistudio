report Notification_Template_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(template_key subject is_active))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(template_key subject is_active))) menu(header(Edit Duplicate Delete)))
}
