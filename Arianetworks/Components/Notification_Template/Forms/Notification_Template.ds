form Notification_Template
{
    displayname = "Notification Template"
    Template_Details
    (
        type = section
        displayname = "Template Details"
        row = 1
        column = 0
    )
    must have unique template_key
    (
        type = text
        displayname = "Template Key"
        row = 1
        column = 1
        width = medium
    )
    must have subject
    (
        type = text
        displayname = "Subject"
        row = 1
        column = 2
        width = medium
    )
    must have body
    (
        type = richtext
        displayname = "Body"
        height = 250px
        toolbar = enable
        [
            style, font-color, alignment, bullets-and-numbering, link, table, html,
            font-size : {2, 3, 4, 5},
            font-family : {"Arimo", "Lato", "Poppins"}
        ]
        row = 1
        column = 1
        width = medium
    )
    is_active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}