Approval_Matrix_Line_On_Validate as "Approval Matrix Line - On Validate"
{
    type = form
    form = Approval_Matrix_Line
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if (ifnull(input.sequence_no,0) <= 0)
                {
                    alert "Sequence No must be greater than 0.";
                    cancel submit;
                }
            )
        }
    }
}