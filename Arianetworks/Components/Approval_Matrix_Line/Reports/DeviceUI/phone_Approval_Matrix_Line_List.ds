report Approval_Matrix_Line_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(approver sequence_no decision decided_on added_by_cost_rule))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(approver sequence_no decision decided_on added_by_cost_rule))) menu(header(Edit Duplicate Delete)))
}
