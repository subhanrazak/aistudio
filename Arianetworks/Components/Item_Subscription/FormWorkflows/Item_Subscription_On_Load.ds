Item_Subscription_On_Load as "Item Subscription - On Load"
{
    type = form
    form = Item_Subscription
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
                if (emp_id != 0 && input.subscriber_employee == null)
                {
                    input.subscriber_employee = emp_id;
                }
                disable subscriber_employee;
            )
        }
    }
}