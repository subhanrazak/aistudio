form Item_Subscription
{
    displayname = "Item Subscription"
    Subscription_Details
    (
        type = section
        displayname = "Subscription Details"
        row = 1
        column = 0
    )
    must have subscriber_employee
    (
        type = picklist
        displayname = "Subscriber Employee"
        values = Employee_Master[is_active == true].ID
        displayformat = [employee_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have item
    (
        type = picklist
        displayname = "Item"
        values = Item_Master[is_deleted == false].ID
        displayformat = [apn]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have scope
    (
        type = picklist
        displayname = "Scope"
        values = {"This_Item_Only","This_Item_and_First_Level_BOM","This_Item_and_Full_Indented_BOM"}
        row = 1
        column = 1
        width = medium
    )
    is_active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}