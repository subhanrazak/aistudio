report My_Subscriptions
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(item scope is_active "Unsubscribe"))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(subscriber_employee item scope is_active "Unsubscribe"))) menu(header(Edit Duplicate Delete)))
}
