default list My_Subscriptions
{
    displayName = "My Subscriptions"
    show all rows from Item_Subscription [is_active == true]
    (
        subscriber_employee
        item
        scope
        is_active
        custom action "Unsubscribe"
        (
            workflow = Unsubscribe
            show action for each record = true
            column header = "Unsubscribe"
            success message = "Subscription deactivated."
            condition = (is_active == true)
        )
    )
    filters
    (
        scope
        is_active
    )
    sort by
    (
        item ascending
    )
}