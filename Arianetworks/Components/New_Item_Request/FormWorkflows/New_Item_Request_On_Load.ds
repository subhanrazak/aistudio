New_Item_Request_On_Load as "New Item Request - On Load"
{
    type = form
    form = New_Item_Request
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
                if (emp_id != 0 && input.raised_by_employee == null)
                {
                    input.raised_by_employee = emp_id;
                }
                if (input.request_datetime == null)
                {
                    input.request_datetime = zoho.currenttime;
                }
                if (input.status == null || input.status == "")
                {
                    input.status = "Submitted";
                }
                if (input.category != null)
                {
                    cat_rec = Category_Master[ID == input.category];
                    if (cat_rec.count() > 0)
                    {
                        input.item_type_derived = cat_rec.item_type;
                    }
                }
                disable raised_by_employee;
                disable item_type_derived;
                disable nir_id;
                disable apn;
            )
        }
    }
}