New_Item_Request_Category_On_User_Input as "New Item Request - Category On User Input"
{
    type = form
    form = New_Item_Request
    record event = on add or edit

    on user input of category
    {
        actions
        {
            custom deluge script
            (
                if (input.category != null)
                {
                    cat_rec = Category_Master[ID == input.category];
                    if (cat_rec.count() > 0)
                    {
                        input.item_type_derived = cat_rec.item_type;
                    }
                }
            )
        }
    }
}