default list My_NIRs
{
    displayName = "My NIRs"
    show all rows from New_Item_Request
    (
        nir_id
        category
        item_type_derived
        description
        status
        request_datetime
        apn
        raised_by_employee
    )
    filters
    (
        status
        category
        raised_by_employee
    )
    sort by
    (
        request_datetime descending
    )
    conditional formatting
    (
        "Rejected NIR"
        {
            condition = (status == "Rejected")
            fields = [nir_id, status]
            format = "background-color:#FFE0E0;color:#A00000;font-weight:bold"
        }
        "Approved NIR"
        {
            condition = (status == "Approved")
            fields = [nir_id, status]
            format = "background-color:#E7F7ED;color:#106B38;font-weight:bold"
        }
    )
}