Route_NIR_to_Library_Review as "Route NIR to Library Review"
{
    type = functions
    form = New_Item_Request
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
                emp_rec = Employee_Master[ID == emp_id];
                if (emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"})
                {
                    old_status = input.status;
                    input.status = "Library_Review";
                    pca_list = thisapp.Get_Employees_By_Profile("PRODUCT_CHANGE_ANALYST");
                    merge_map = Map();
                    merge_map.put("nir_id", input.nir_id);
                    thisapp.Send_Template_Email("NIR_SUBMITTED", pca_list, merge_map);
                    thisapp.Write_Activity_Log("New_Item_Request", input.nir_id, "status", old_status, "Library_Review", input.raised_by_employee);
                }
            )
        }
    }
}