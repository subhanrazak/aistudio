Approve_NIR as "Approve NIR"
{
    type = functions
    form = New_Item_Request
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
                emp_rec = Employee_Master[ID == emp_id];
                if (emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"} && !(input.status == "PCA_Review" && input.item_type_derived == "Library_Component"))
                {
                    input.apn = thisapp.Generate_APN(input.category);
                    old_status = input.status;
                    input.status = "Approved";
                    thisapp.Create_Item_From_NIR(input.ID);
                    merge_map = Map();
                    merge_map.put("nir_id", input.nir_id);
                    merge_map.put("apn", input.apn);
                    requester_recipients = List();
                    requester_recipients.add(input.raised_by_employee);
                    thisapp.Send_Template_Email("NIR_APPROVED", requester_recipients, merge_map);
                    thisapp.Write_Activity_Log("New_Item_Request", input.nir_id, "status", old_status, "Approved", input.raised_by_employee);
                }
            )
        }
    }
}