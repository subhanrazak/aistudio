report Change_Request_Affected_Items
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(item notes))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(item notes))) menu(header(Edit Duplicate Delete)))
}
