report Change_Request_Affected_Items
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(item notes))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on click(View Record) on right click(Edit Delete Duplicate View Record)))
detailview(layout(type=1 datablock1(layout type=-2 fields(item notes))) menu(header(Edit Duplicate Delete)))
}
