form Approval_Matrix_Template
{
    displayname = "Approval Matrix Template"
    Approval_Routing
    (
        type = section
        displayname = "Approval Routing"
        row = 1
        column = 0
    )
    must have change_category
    (
        type = picklist
        displayname = "Change Category"
        values = {"ECR","ECO","MCR","MCO","PCO","Deviation"}
        row = 1
        column = 1
        width = medium
    )
    must have approver
    (
        type = picklist
        displayname = "Approver"
        values = Employee_Master[is_active == true].ID
        displayformat = [employee_name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have sequence_no
    (
        type = number
        displayname = "Sequence No"
        row = 1
        column = 1
        width = medium
    )
    is_default_finance_approver
    (
        type = checkbox
        displayname = "Default Finance Approver"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    is_active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}