form ECN_Acknowledgment
{
    displayname = "ECN Acknowledgment"
    Main
    (
        type = section
        displayname = "Main"
        row = 1
        column = 0
    )
    unique ack_id
    (
        type = text
        displayname = "Ack ID"
        row = 1
        column = 1
        width = medium
    )
    must have change_order
    (
        type = picklist
        displayname = "Change Order"
        values = Change_Order.ID
        displayformat = [order_id]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have recipient_employee
    (
        type = picklist
        displayname = "Recipient Employee"
        values = Employee_Master[is_active == true].ID
        displayformat = [employee_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    acknowledged_on
    (
        type = datetime
        displayname = "Acknowledged On"
        row = 1
        column = 2
        width = medium
    )
    comments
    (
        type = textarea
        displayname = "Comments"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    status
    (
        type = picklist
        displayname = "Status"
        values = {"Pending","Acknowledged"}
        initial value = "Pending"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}