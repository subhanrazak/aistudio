report My_Pending_Approvals
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(order_id change_category title estimated_cost_impact created_date "Approve" "Reject" "Comment"))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on click(View Record) on right click(Edit Delete Duplicate View Record)))
