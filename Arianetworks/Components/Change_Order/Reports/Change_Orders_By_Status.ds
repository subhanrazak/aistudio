kanban Change_Orders_By_Status
{
    displayName = "Change Orders By Status"
    show all rows from Change_Order
    (
        order_id
        change_category
        title
        status
        effectivity_type
        expiration_date
        release_error_flag
        created_by_employee
        created_date
    )
    filters
    (
        change_category
        status
        effectivity_type
        created_by_employee
        release_error_flag
    )
    sort by
    (
        created_date descending
    )
    options
    (
        display field = status
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}