form System_Config
{
    displayname = "System Config"
    Configuration_Details
    (
        type = section
        displayname = "Configuration Details"
        row = 1
        column = 0
    )
    must have unique config_name
    (
        type = text
        displayname = "Config Name"
        initial value = "PLM_DEFAULT"
        row = 1
        column = 1
        width = medium
    )
    finance_approval_threshold_inr
    (
        type = INR
        displayname = "Finance Approval Threshold (INR)"
        decimalplace = 2
        maxchar = 16
        row = 1
        column = 2
        width = medium
    )
    reference_designator_check_enabled
    (
        type = checkbox
        displayname = "Reference Designator Check Enabled"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    internal_ecn_only
    (
        type = checkbox
        displayname = "Internal ECN Only"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    is_active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}