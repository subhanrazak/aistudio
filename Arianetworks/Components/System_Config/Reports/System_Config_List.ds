default list System_Config_List
{
    displayName = "System Config List"
    show all rows from System_Config
    (
        config_name
        finance_approval_threshold_inr
        reference_designator_check_enabled
        (
            displaytrue = "Enabled"
            displayfalse = "Disabled"
        )
        internal_ecn_only
        (
            displaytrue = "Internal Only"
            displayfalse = "External Allowed"
        )
        is_active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        is_active
    )
    sort by
    (
        config_name ascending
    )
}