form Manufacturer_Master
{
    displayname = "Manufacturer Master"
    Manufacturer_Details
    (
        type = section
        displayname = "Manufacturer Details"
        row = 1
        column = 0
    )
    must have unique manufacturer_name
    (
        type = text
        displayname = "Manufacturer Name"
        row = 1
        column = 1
        width = medium
    )
    manufacturer_code
    (
        type = text
        displayname = "Manufacturer Code"
        row = 1
        column = 2
        width = medium
    )
    country
    (
        type = text
        displayname = "Country"
        row = 1
        column = 1
        width = medium
    )
    is_approved
    (
        type = checkbox
        displayname = "Is Approved"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    is_active
    (
        type = checkbox
        displayname = "Is Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    contact_name
    (
        type = text
        displayname = "Contact Name"
        row = 1
        column = 2
        width = medium
    )
    contact_email
    (
        type = email
        displayname = "Contact Email"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}