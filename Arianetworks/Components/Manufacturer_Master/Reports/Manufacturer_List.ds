default list Manufacturer_List
{
    displayName = "Manufacturer List"
    show all rows from Manufacturer_Master
    (
        manufacturer_name
        manufacturer_code
        country
        contact_name
        contact_email
        is_approved
        (
            displaytrue = "Approved"
            displayfalse = "Not Approved"
        )
        is_active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
    )
    filters
    (
        country
        is_approved
        is_active
    )
    sort by
    (
        manufacturer_name ascending
    )
}