report Manufacturer_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(manufacturer_name manufacturer_code country is_approved))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(manufacturer_name manufacturer_code country contact_name contact_email is_approved is_active))) menu(header(Edit Duplicate Delete)))
}
