default list Deviation_Consumption_Log
{
    displayName = "Deviation Consumption Log"
    show all rows from Deviation_Consumption_Entry
    (
        linked_deviation
        recorded_on
        (
            displayformat = dateonly
        )
        batch_reference
        units_built_this_batch
        (
            display = total
        )
        recorded_by_employee
    )
    filters
    (
        linked_deviation
        recorded_by_employee
    )
    sort by
    (
        recorded_on ascending
    )
    conditional formatting
    (
        "Large Batch"
        {
            condition = (units_built_this_batch > 100)
            fields = [linked_deviation, units_built_this_batch]
            format = "background-color:#FFF7ED;color:#9A3412"
        }
    )
}