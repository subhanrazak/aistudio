form Change_Order_Disposition
{
    displayname = "Change Order Disposition"
    Disposition_Details
    (
        type = section
        displayname = "Disposition Details"
        row = 1
        column = 0
    )
    affected_item
    (
        type = picklist
        displayname = "Affected Item"
        values = Item_Master[is_deleted == false].ID
        displayformat = [apn]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    new_buys
    (
        type = picklist
        displayname = "New Buys"
        values = {"No_Action","Cancel_Open_POs","Modify_Spec","Pivot_to_New_Revision"}
        initial value = "No_Action"
        row = 1
        column = 2
        width = medium
    )
    wip
    (
        type = picklist
        displayname = "WIP"
        values = {"No_Action","Scrap","Rework_Mid_Line","Run_Out_to_Milestone"}
        initial value = "No_Action"
        row = 1
        column = 1
        width = medium
    )
    production_stock
    (
        type = picklist
        displayname = "Production Stock"
        values = {"No_Action","Purge_and_Scrap","Return_to_Vendor","Use_Up"}
        initial value = "No_Action"
        row = 1
        column = 2
        width = medium
    )
    fgi
    (
        type = picklist
        displayname = "FGI"
        values = {"No_Action","Hold","Rework","Downgrade"}
        initial value = "No_Action"
        row = 1
        column = 1
        width = medium
    )
    logistics
    (
        type = picklist
        displayname = "Logistics"
        values = {"No_Action","Hold_in_Transit","Redirect_to_Hub"}
        initial value = "No_Action"
        row = 1
        column = 2
        width = medium
    )
    spares_depot
    (
        type = picklist
        displayname = "Spares Depot"
        values = {"No_Action","Recall_Defective","Use_as_Spare"}
        initial value = "No_Action"
        row = 1
        column = 1
        width = medium
    )
    disposition_notes
    (
        type = textarea
        displayname = "Disposition Notes"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}