default list Change_Order_Disposition_List
{
    displayName = "Change Order Disposition List"
    show all rows from Change_Order_Disposition
    (
        affected_item
        new_buys
        wip
        production_stock
        fgi
        logistics
        spares_depot
        disposition_notes
    )
    filters
    (
        affected_item
        new_buys
        wip
        production_stock
    )
    sort by
    (
        affected_item ascending
    )
}