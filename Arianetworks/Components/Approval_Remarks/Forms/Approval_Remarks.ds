form Approval_Remarks
{
    displayname = "Approval Remarks"
    Main
    (
        type = section
        displayname = "Main"
        row = 1
        column = 0
    )
    unique remarks_id
    (
        type = text
        displayname = "Remarks ID"
        row = 1
        column = 1
        width = medium
    )
    must have linked_change_order
    (
        type = picklist
        displayname = "Linked Change Order"
        values = Change_Order.ID
        displayformat = [order_id]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have action
    (
        type = picklist
        displayname = "Action"
        values = {"Approved","Rejected","Comment"}
        row = 1
        column = 1
        width = medium
    )
    must have action_by_employee
    (
        type = picklist
        displayname = "Action By Employee"
        values = Employee_Master[is_active == true].ID
        displayformat = [employee_name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    action_date
    (
        type = datetime
        displayname = "Action Date"
        row = 1
        column = 1
        width = medium
    )
    remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 140px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}