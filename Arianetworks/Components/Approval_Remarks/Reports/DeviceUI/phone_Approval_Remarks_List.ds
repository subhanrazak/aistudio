report Approval_Remarks_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(remarks_id linked_change_order action action_by_employee action_date))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(remarks_id linked_change_order action action_by_employee action_date remarks))) menu(header(Edit Duplicate Delete)))
}
