default list Item_Revision_History_List
{
    displayName = "Item Revision History List"
    show all rows from Item_Revision_History
    (
        item
        revision_label
        effective_change_order
        effective_date
        custom action "View Snapshot"
        (
            workflow = View_Snapshot
            show action for each record = true
            column header = "View Snapshot"
            success message = "Opening snapshot view."
        )
    )
    filters
    (
        item
        effective_change_order
    )
    sort by
    (
        effective_date descending
    )
}