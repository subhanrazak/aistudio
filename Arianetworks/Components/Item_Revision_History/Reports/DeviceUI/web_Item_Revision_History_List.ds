report Item_Revision_History_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(item revision_label effective_change_order effective_date "View Snapshot"))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on click(View Record) on right click(Edit Delete Duplicate View Record)))
detailview(layout(type=1 datablock1(layout type=-2 fields(item revision_label effective_change_order effective_date "View Snapshot"))) menu(header(Edit Duplicate Delete)))
}
