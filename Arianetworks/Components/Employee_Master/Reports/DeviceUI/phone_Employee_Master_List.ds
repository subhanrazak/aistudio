report Employee_Master_List
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(employee_name email profile_label is_active))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(employee_name creator_user email profile_label department is_active notification_opt_in))) menu(header(Edit Duplicate Delete)))
}
