report My_Requests
{
quickview(layout(type=-1 datablock1(layout type=-1 fields(request_id request_type title status created_date))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
detailview(layout(type=1 datablock1(layout type=-2 fields(request_id request_type title status requested_by_employee created_date))) menu(header(Edit Duplicate Delete)))
}
