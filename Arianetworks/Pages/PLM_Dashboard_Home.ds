<page linkname = "PLM_Dashboard_Home" displayname = "PLM Dashboard Home"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Dashboard_Header_KPIs' elementName='Dashboard_Header_KPIs'>
          <![CDATA[htmlpage Dashboard_Header_KPIs()
             content
             <%{%>
                 <file name:Dashboard_Header_KPIs.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Change_Status_Lifecycle' elementName='Change_Status_Lifecycle'>
          <![CDATA[htmlpage Change_Status_Lifecycle()
             content
             <%{%>
                 <file name:Change_Status_Lifecycle.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Work_Queues' elementName='Work_Queues'>
          <![CDATA[htmlpage Work_Queues()
             content
             <%{%>
                 <file name:Work_Queues.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Deviation_ECN_Activity' elementName='Deviation_ECN_Activity'>
          <![CDATA[htmlpage Deviation_ECN_Activity()
             content
             <%{%>
                 <file name:Deviation_ECN_Activity.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>