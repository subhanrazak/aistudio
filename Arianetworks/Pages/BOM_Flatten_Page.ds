<page linkname = "BOM_Flatten_Page" parameters = "int item_id" displayname = "BOM Flatten Page"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Flattened_BOM' elementName='Flattened_BOM'>
          <![CDATA[htmlpage Flattened_BOM()
             content
             <%{%>
                 <file name:Flattened_BOM.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
