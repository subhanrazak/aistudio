t-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Inserted&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-row-note&apos;&gt;Superseding line &lt;%=new_line.ID%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_line_number%&gt;&lt;/ins&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;ins class=&apos;new-value&apos;&gt;&lt;span class=&apos;brv-part-main&apos;&gt;&lt;%=new_child_apn%&gt; Rev &lt;%=new_child_revision%&gt;&lt;/span&gt;&lt;span class=&apos;brv-part-sub&apos;&gt;&lt;%=new_child_name%&gt;&lt;/span&gt;&lt;/ins&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_quantity%&gt;&lt;/ins&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_ref%&gt;&lt;/ins&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_approval%&gt;&lt;/ins&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_notes%&gt;&lt;/ins&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;removed-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Removed&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-row-note&apos;&gt;Superseding line not found&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_line_number%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;span class=&apos;brv-part-main&apos;&gt;&lt;%=old_child_apn%&gt; Rev &lt;%=old_child_revision%&gt;&lt;/span&gt;&lt;span class=&apos;brv-part-sub&apos;&gt;&lt;%=old_child_name%&gt;&lt;/span&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_quantity%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_ref%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_approval%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_notes%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse if(bom_line.is_struck == true)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;removed-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Removed&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-row-note&apos;&gt;is_struck is true&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_line_number%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;span class=&apos;brv-part-main&apos;&gt;&lt;%=old_child_apn%&gt; Rev &lt;%=old_child_revision%&gt;&lt;/span&gt;&lt;span class=&apos;brv-part-sub&apos;&gt;&lt;%=old_child_name%&gt;&lt;/span&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_quantity%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_ref%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_approval%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;del&gt;&lt;%=old_notes%&gt;&lt;/del&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Unchanged&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=old_line_number%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-part-main&apos;&gt;&lt;%=old_child_apn%&gt; Rev &lt;%=old_child_revision%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-part-sub&apos;&gt;&lt;%=old_child_name%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=old_quantity%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=old_ref%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=old_approval%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=old_notes%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t}\n\t\t%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Change_Order_Summary(int change_order_id)
		{
					displayname = "Change Order Summary"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Change_Order_Summary_View' elementName='Change_Order_Summary_View'>\n\t\t\t\t\t<![CDATA[htmlpage Change_Order_Summary_View()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nco_list = Change_Order[ID == input.change_order_id];\nrecordFound = co_list.count() &gt; 0;\nif(recordFound)\n{\n\t\tco_rec = co_list;\n\t\tstatusText = ifnull(co_rec.status,&quot;Open&quot;);\n\t\tcategoryText = ifnull(co_rec.change_category,&quot;Not set&quot;);\n\t\ttitleText = ifnull(co_rec.title,&quot;Untitled Change Order&quot;);\n\t\tdescriptionText = ifnull(co_rec.description,&quot;No description provided.&quot;);\n\t\torderIdText = ifnull(co_rec.order_id,co_rec.ID.toString());\n\t\teffectivityText = ifnull(co_rec.effectivity_type,&quot;Not set&quot;);\n\t\teffectiveDateText = ifnull(co_rec.effective_date,&quot;Not scheduled&quot;);\n\t\texpirationDateText = ifnull(co_rec.expiration_date,&quot;Not set&quot;);\n\t\tcreatedDateText = ifnull(co_rec.created_date,&quot;Not recorded&quot;);\n\t\treleaseAttemptText = ifnull(co_rec.release_last_attempt_on,&quot;No release attempt recorded&quot;);\n\t\testimatedCostText = ifnull(co_rec.estimated_cost_impact,&quot;0.00&quot;);\n\t\tmaxUnits = ifnull(co_rec.max_unit_count,0);\n\t\tunitsUsed = ifnull(co_rec.units_consumed,0);\n\t\tremainingUnits = maxUnits - unitsUsed;\n\t\tusagePct = 0;\n\t\tif(maxUnits &gt; 0)\n\t\t{\n\t\t\t\tusagePct = (unitsUsed * 100) / maxUnits;\n\t\t\t\tif(usagePct &gt; 100)\n\t\t\t\t{\n\t\t\t\t\t\tusagePct = 100;\n\t\t\t\t}\n\t\t}\n\t\treleaseError = ifnull(co_rec.release_error_flag,false);\n\t\treleaseErrorText = if(releaseError == true,&quot;Yes&quot;,&quot;No&quot;);\n\t\treleaseDetails = ifnull(co_rec.release_error_details,&quot;&quot;);\n\t\tcostRuleCount = 0;\n\t\tfor each cost_row in co_rec.approvers\n\t\t{\n\t\t\t\tif(cost_row.added_by_cost_rule == true)\n\t\t\t\t{\n\t\t\t\t\t\tcostRuleCount = costRuleCount + 1;\n\t\t\t\t}\n\t\t}\n\t\tcreatorName = &quot;Not recorded&quot;;\n\t\tif(co_rec.created_by_employee != null)\n\t\t{\n\t\t\t\tcreator_rec = Employee_Master[ID == co_rec.created_by_employee];\n\t\t\t\tif(creator_rec.count() &gt; 0)\n\t\t\t\t{\n\t\t\t\t\t\tcreatorName = creator_rec.employee_name;\n\t\t\t\t}\n\t\t}\n\t\talternativeText = &quot;Not set&quot;;\n\t\tif(co_rec.alternative_component != null)\n\t\t{\n\t\t\t\talt_item = Item_Master[ID == co_rec.alternative_component];\n\t\t\t\tif(alt_item.count() &gt; 0)\n\t\t\t\t{\n\t\t\t\t\t\talternativeText = alt_item.apn;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t\talternativeText = co_rec.alternative_component.toString();\n\t\t\t\t}\n\t\t}\n\t\tstatusBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\tif(statusText == &quot;Approved&quot; || statusText == &quot;Effective&quot; || statusText == &quot;Complete&quot;)\n\t\t{\n\t\t\t\tstatusBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\tif(statusText == &quot;Rejected&quot;)\n\t\t{\n\t\t\t\tstatusBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\tif(statusText == &quot;Cancelled&quot; || statusText == &quot;Expired&quot;)\n\t\t{\n\t\t\t\tstatusBadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t\tstages = {&quot;Open&quot;,&quot;Submitted&quot;,&quot;Approval_In_Progress&quot;,&quot;Approved&quot;,&quot;Effective&quot;,&quot;Complete&quot;};\n\t\tstageIndex = stages.indexOf(statusText);\n\t\tif(stageIndex &lt; 0)\n\t\t{\n\t\t\t\tstageIndex = 0;\n\t\t}\n\t\tstageFail = false;\n\t\tif(statusText == &quot;Rejected&quot;)\n\t\t{\n\t\t\t\tstageIndex = 2;\n\t\t\t\tstageFail = true;\n\t\t}\n\t\telse if(statusText == &quot;Cancelled&quot;)\n\t\t{\n\t\t\t\tstageIndex = 0;\n\t\t\t\tstageFail = true;\n\t\t}\n\t\telse if(statusText == &quot;Expired&quot;)\n\t\t{\n\t\t\t\tstageIndex = 4;\n\t\t\t\tstageFail = true;\n\t\t}\n\t\tif(releaseError == true)\n\t\t{\n\t\t\t\tstageFail = true;\n\t\t\t\tif(statusText == &quot;Approved&quot;)\n\t\t\t\t{\n\t\t\t\t\t\tif(categoryText == &quot;Deviation&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstageIndex = 4;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tstageIndex = 5;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-col-3 { flex: 0 0 25%; max-width: 25%; }\n.zcs-col-4 { flex: 0 0 33.3333%; max-width: 33.3333%; }\n.zcs-col-6 { flex: 0 0 50%; max-width: 50%; }\n.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-2 { padding: .125rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-15 { padding-left: .9375rem; padding-right: .9375rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-w-full { width: 100%; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-list-none { list-style-type: none; }\n.zcs-break-words { overflow-wrap: break-word; }\n\n.zcs-outline-toast { border: 1px solid; }\n.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }\n.zcs-outline-toast.zcs-theme-toast { border-color: var(--zcs_brand_color); }\n.zcs-success-toast { background-color: #edf7ed; color: #1d4620; }\n.zcs-info-toast { background-color: #e4f6fd; color: #024361; }\n.zcs-warning-toast { background-color: #fef4e5; color: #663c01; }\n.zcs-error-toast { background-color: #feedec; color: #5f2120; }\n.zcs-toast-icon { font-size: 18px; margin-top: 1px; }\n\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n\n.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }\n\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }\n\n.zcs-stepper-status { width: 32px; height: 32px; border: 4px solid var(--zcs-white-color); }\n.zcs-stepper:not(:last-child):before { content: &apos;&apos;; width: 100%; height: 1px; border-top: 1px solid var(--co-line-color, var(--zcs_tertiary_border_color)); box-sizing: border-box; position: absolute; top: calc((32px - 1px) / 2); left: 50%; }\n\n.co-summary-page { background: #F3F3F4; padding: 20px; min-height: 100%; box-sizing: border-box; color: var(--zcs-primary-text-color); }\n.co-header { padding: 20px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.co-eyebrow { color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .04em; font-size: 12px; font-weight: 700; margin: 0 0 6px; }\n.co-title { margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }\n.co-description { margin: 8px 0 0; color: var(--zcs-secondary-text-color); max-width: 980px; white-space: pre-line; }\n.co-card { padding: 18px; margin-top: 16px; }\n.co-section-title { font-size: 16px; font-weight: 700; margin: 0 0 12px; color: var(--zcs-primary-text-color); }\n.co-muted { color: var(--zcs-teritiary-text-color); }\n.co-status-stepper { padding: 10px 0 2px; }\n.co-status-stepper ul { list-style: none; }\n.co-status-stepper .zcs-stepper-text { word-break: break-word; }\n.co-stage-green { --co-line-color: #179E6C; }\n.co-stage-blue { --co-line-color: #2A6FFC; }\n.co-stage-red { --co-line-color: #FE455D; }\n.co-stage-grey { --co-line-color: var(--zcs_tertiary_border_color); }\n.co-stage-green .zcs-stepper-status { background: #179E6C; color: #FFFFFF; }\n.co-stage-blue .zcs-stepper-status { background: #2A6FFC; color: #FFFFFF; }\n.co-stage-red .zcs-stepper-status { background: #FE455D; color: #FFFFFF; }\n.co-stage-grey .zcs-stepper-status { background: #FFFFFF; color: var(--zcs-placeholder-color); border: 1px solid var(--zcs_tertiary_border_color); }\n.co-stage-green .zcs-stepper-text { color: #179E6C; font-weight: 600; }\n.co-stage-blue .zcs-stepper-text { color: #2A6FFC; font-weight: 600; }\n.co-stage-red .zcs-stepper-text { color: #FE455D; font-weight: 700; }\n.co-stage-grey .zcs-stepper-text { color: var(--zcs-teritiary-text-color); }\n.co-stage-icon { font-size: 18px; line-height: 1; }\n.co-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }\n.co-detail-grid .co-card { margin-top: 0; }\n.co-value-long { white-space: pre-line; }\n.co-release-box { border: 1px solid var(--zcs_tertiary_border_color); background: #FFFFFF; border-radius: 10px; padding: 12px; min-height: 58px; color: var(--zcs-secondary-text-color); white-space: pre-line; }\n.co-usage-track { height: 8px; background: #EAEBF9; border-radius: 999px; overflow: hidden; margin-top: 8px; }\n.co-usage-fill { height: 8px; background: #2A6FFC; border-radius: 999px; }\n.co-usage-fill.co-over { background: #FE455D; }\n.co-banner-stack { display: grid; gap: 10px; margin-bottom: 16px; }\n.co-not-found { max-width: 760px; margin: 40px auto; }\n@media (max-width: 992px) { .zcs-col-sm-6 { flex: 0 0 50%; max-width: 50%; } .co-detail-grid { grid-template-columns: 1fr; } }\n@media (max-width: 575px) { .co-summary-page { padding: 12px; } .co-header { flex-direction: column; } .zcs-col-3, .zcs-col-4, .zcs-col-6, .zcs-col-sm-6 { flex: 0 0 100%; max-width: 100%; } .co-status-stepper ul { flex-direction: column; gap: 20px; } .co-status-stepper ul .zcs-stepper { flex-direction: row; text-align: left; } .zcs-stepper:not(:last-child):before { width: 1px; height: 100%; border-left: 1px solid var(--co-line-color, var(--zcs_tertiary_border_color)); border-top: 0; left: calc((32px - 1px) / 2); top: 32px; } }\n&lt;/style&gt;\n\n&lt;% if(recordFound == false) { %&gt;\n&lt;div class=&quot;co-summary-page&quot;&gt;\n\t\t&lt;div class=&quot;co-not-found zcs-card co-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-m-0&quot;&gt;No Change Order was found for ID &lt;%= input.change_order_id %&gt;.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;% } else { %&gt;\n&lt;div class=&quot;co-summary-page&quot;&gt;\n\t\t&lt;div class=&quot;co-header zcs-card&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;p class=&quot;co-eyebrow&quot;&gt;Change Order Summary&lt;/p&gt;\n\t\t\t\t\t\t&lt;h1 class=&quot;co-title&quot;&gt;&lt;%= orderIdText %&gt; - &lt;%= titleText %&gt;&lt;/h1&gt;\n\t\t\t\t\t\t&lt;p class=&quot;co-description&quot;&gt;&lt;%= descriptionText %&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%= statusBadgeClass %&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= statusText %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;co-banner-stack&quot;&gt;\n\t\t\t\t&lt;% if(statusText == &quot;Rejected&quot;) { %&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;This Change Order has been rejected. Review approver decisions and timestamps below before resubmission.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if(statusText == &quot;Cancelled&quot;) { %&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;This Change Order is cancelled. Its status bar is stopped at the cancellation point.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if(statusText == &quot;Expired&quot;) { %&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;This Change Order has expired. Check expiration date and deviation usage before taking further action.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if(releaseError == true) { %&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;Release processing reported an error. Details and last attempt time are shown in the Release section.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Lifecycle status&lt;/h2&gt;\n\t\t\t\t&lt;div class=&quot;zcs-stepper-wrapper co-status-stepper&quot;&gt;\n\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tstageNo = 0;\n\t\t\t\t\t\t\t\tfor each stageName in stages\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tstageState = &quot;co-stage-grey&quot;;\n\t\t\t\t\t\t\t\t\t\tstageIcon = &quot;zc-li-outline ui-2-time&quot;;\n\t\t\t\t\t\t\t\t\t\tif(statusText == &quot;Complete&quot; &amp;&amp; stageNo &lt;= stageIndex)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tstageState = &quot;co-stage-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tstageIcon = &quot;zc-li-outline ui-1-check-small&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(stageFail == true &amp;&amp; stageNo == stageIndex)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tstageState = &quot;co-stage-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tstageIcon = &quot;zc-li-outline ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(stageNo &lt; stageIndex)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tstageState = &quot;co-stage-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tstageIcon = &quot;zc-li-outline ui-1-check-small&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(stageNo == stageIndex)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tstageState = &quot;co-stage-blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tstageIcon = &quot;zc-li-outline ui-2-time&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative &lt;%= stageState %&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;co-stage-icon &lt;%= stageIcon %&gt;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= stageName %&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tstageNo = stageNo + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;co-detail-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Category and cost&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0 zcs-list-none&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Category&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= categoryText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Estimated Cost Impact&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;INR &lt;%= estimatedCostText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Created By&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= creatorName %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Cost Rule Approvers&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= costRuleCount %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Effectivity and dates&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0 zcs-list-none&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Effectivity Type&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= effectivityText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Effective Date&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= effectiveDateText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Expiration Date&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= expirationDateText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Created Date&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= createdDateText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;co-detail-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Deviation usage&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0 zcs-list-none&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Max Unit Count&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;% if(maxUnits &gt; 0) { %&gt;&lt;%= maxUnits %&gt;&lt;% } else { %&gt;Not capped&lt;% } %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Units Consumed&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= unitsUsed %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Units Remaining&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;% if(maxUnits &gt; 0) { %&gt;&lt;%= remainingUnits %&gt;&lt;% } else { %&gt;Not capped&lt;% } %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Alternative Component&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= alternativeText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;co-usage-track&quot;&gt;&lt;div class=&quot;co-usage-fill &lt;% if(maxUnits &gt; 0 &amp;&amp; unitsUsed &gt; maxUnits) { %&gt;co-over&lt;% } %&gt;&quot; style=&quot;width:&lt;%= usagePct %&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Release status&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0 zcs-list-none&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Release Error Flag&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= releaseErrorText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Release Last Attempt On&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%= releaseAttemptText %&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Release Error Details&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;co-release-box&quot;&gt;&lt;% if(releaseDetails == &quot;&quot;) { %&gt;No release errors recorded.&lt;% } else { %&gt;&lt;%= releaseDetails %&gt;&lt;% } %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-card co-card&quot;&gt;\n\t\t\t\t&lt;h2 class=&quot;co-section-title&quot;&gt;Approver decisions&lt;/h2&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Approver&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Sequence&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Decision&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Decided On&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Cost Rule Flag&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tapproverRows = 0;\n\t\t\t\t\t\t\t\t\t\tfor each app_row in co_rec.approvers\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tapproverRows = approverRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\tapproverName = &quot;Not assigned&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(app_row.approver != null)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tapp_emp = Employee_Master[ID == app_row.approver];\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(app_emp.count() &gt; 0)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tapproverName = app_emp.employee_name;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tdecisionText = ifnull(app_row.decision,&quot;Pending&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tdecisionClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tdecisionBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(decisionText == &quot;Approved&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdecisionClass = &quot;zcs-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdecisionBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(decisionText == &quot;Rejected&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdecisionClass = &quot;zcs-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdecisionBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tdecidedOnText = ifnull(app_row.decided_on,&quot;Pending&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tcostRuleText = if(app_row.added_by_cost_rule == true,&quot;Yes&quot;,&quot;No&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tcostRuleBadgeClass = if(app_row.added_by_cost_rule == true,&quot;zcs-badge-orange&quot;,&quot;zcs-badge-grey&quot;);\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= approverName %&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= ifnull(app_row.sequence_no,&quot;-&quot;) %&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%= decisionClass %&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%= decisionBadgeClass %&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= decisionText %&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= decidedOnText %&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%= costRuleBadgeClass %&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= costRuleText %&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% if(approverRows == 0) { %&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;No approver routing rows are attached to this Change Order.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;% } %&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Item_Revision_Snapshot_View(int history_id)
		{
					displayname = "Item Revision Snapshot View"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Snapshot_Dsp_01' elementName='Snapshot Renderer'>\n\t\t\t\t\t<![CDATA[htmlpage Snapshot_Dsp_01()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nhistory_records = Item_Revision_History[ID == input.history_id];\n\nrecord_found = false;\nitem_text = &quot;-&quot;;\nrevision_text = &quot;-&quot;;\nchange_order_text = &quot;-&quot;;\neffective_date_text = &quot;-&quot;;\nhistory_code = &quot;-&quot;;\nsnapshot_text = &quot;&quot;;\nnot_found_text = &quot;No Item Revision History record was found for the supplied history_id.&quot;;\n\nif(history_records.count() &gt; 0)\n{\n\t\trecord_found = true;\n\t\thistory_rec = history_records;\n\t\thistory_code = ifnull(history_rec.history_id, history_rec.ID.toString());\n\t\trevision_text = ifnull(history_rec.revision_label, &quot;-&quot;);\n\t\tsnapshot_text = ifnull(history_rec.snapshot_json, &quot;&quot;);\n\t\tif(history_rec.item != null)\n\t\t{\n\t\t\t\titem_text = history_rec.item;\n\t\t}\n\t\tif(history_rec.effective_change_order != null)\n\t\t{\n\t\t\t\tchange_order_text = history_rec.effective_change_order;\n\t\t}\n\t\tif(history_rec.effective_date != null)\n\t\t{\n\t\t\t\teffective_date_text = history_rec.effective_date.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t}\n}\n\nitem_text = item_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\nrevision_text = revision_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\nchange_order_text = change_order_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\neffective_date_text = effective_date_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\nhistory_code = history_code.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\nsnapshot_text = snapshot_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\nnot_found_text = not_found_text.toString().replaceAll(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replaceAll(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replaceAll(&quot;&gt;&quot;,&quot;&amp;gt;&quot;);\n%&gt;\n\n&lt;style&gt;\n.snapshot-page {\n\tbackground: #F3F3F4;\n\tcolor: #111827;\n\tfont-family: Arial, sans-serif;\n\tmin-height: 100%;\n\tpadding: 20px;\n\tbox-sizing: border-box;\n}\n.snapshot-shell {\n\tmax-width: 1180px;\n\tmargin: 0 auto;\n}\n.snapshot-header {\n\tbackground: #FFFFFF;\n\tborder: 1px solid #E5E7EB;\n\tborder-radius: 12px;\n\tpadding: 18px 20px;\n\tmargin-bottom: 16px;\n}\n.snapshot-title {\n\tfont-size: 20px;\n\tline-height: 1.25;\n\tfont-weight: 600;\n\tmargin: 0;\n}\n.snapshot-subtitle {\n\tcolor: #6B7280;\n\tfont-size: 13px;\n\tline-height: 1.5;\n\tmargin: 6px 0 0;\n}\n.snapshot-card {\n\tbackground: #FFFFFF;\n\tborder: 1px solid #E5E7EB;\n\tborder-radius: 12px;\n\tmargin-bottom: 16px;\n\toverflow: hidden;\n}\n.snapshot-card-title {\n\tborder-bottom: 1px solid #E5E7EB;\n\tfont-size: 16px;\n\tfont-weight: 600;\n\tmargin: 0;\n\tpadding: 14px 18px;\n}\n.snapshot-card-body {\n\tpadding: 18px;\n}\n.snapshot-grid {\n\tdisplay: grid;\n\tgrid-template-columns: 190px minmax(0, 1fr);\n\tgap: 12px 18px;\n}\n.snapshot-label {\n\tcolor: #6B7280;\n\tfont-size: 13px;\n\tfont-weight: 600;\n}\n.snapshot-value {\n\tcolor: #111827;\n\tfont-size: 14px;\n\tword-break: break-word;\n}\n.snapshot-badge {\n\tbackground: #EEF2FF;\n\tborder: 1px solid #CBD5E1;\n\tborder-radius: 999px;\n\tcolor: #1E3A8A;\n\tdisplay: inline-block;\n\tfont-size: 12px;\n\tfont-weight: 600;\n\tpadding: 5px 10px;\n}\n.snapshot-raw {\n\tbackground: #0F172A;\n\tborder-radius: 10px;\n\tcolor: #E5E7EB;\n\tfont-family: Consolas, Menlo, Monaco, monospace;\n\tfont-size: 13px;\n\tline-height: 1.55;\n\tmargin: 0;\n\tmax-height: 480px;\n\toverflow: auto;\n\tpadding: 16px;\n\twhite-space: pre-wrap;\n\tword-break: break-word;\n}\n.snapshot-empty {\n\tbackground: #F9FAFB;\n\tborder: 1px dashed #CBD5E1;\n\tborder-radius: 10px;\n\tcolor: #6B7280;\n\tfont-size: 14px;\n\tline-height: 1.5;\n\tpadding: 16px;\n}\n@media (max-width: 700px) {\n\t.snapshot-page {\n\t\tpadding: 12px;\n\t}\n\t.snapshot-grid {\n\t\tgrid-template-columns: 1fr;\n\t}\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;snapshot-page&quot;&gt;\n\t&lt;div class=&quot;snapshot-shell&quot;&gt;\n\t\t&lt;div class=&quot;snapshot-header&quot;&gt;\n\t\t\t&lt;h1 class=&quot;snapshot-title&quot;&gt;Item Revision Snapshot&lt;/h1&gt;\n\t\t\t&lt;p class=&quot;snapshot-subtitle&quot;&gt;Read-only view of Item_Revision_History and its saved snapshot_json.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\n&lt;%\nif(record_found == true)\n{\n%&gt;\n\t\t&lt;section class=&quot;snapshot-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;snapshot-card-title&quot;&gt;Snapshot Details&lt;/h2&gt;\n\t\t\t&lt;div class=&quot;snapshot-card-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;snapshot-grid&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-label&quot;&gt;History ID&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-value&quot;&gt;&lt;span class=&quot;snapshot-badge&quot;&gt;&lt;%=history_code%&gt;&lt;/span&gt;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;snapshot-label&quot;&gt;Item&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-value&quot;&gt;&lt;%=item_text%&gt;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;snapshot-label&quot;&gt;Revision Label&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-value&quot;&gt;&lt;%=revision_text%&gt;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;snapshot-label&quot;&gt;Effective Change Order&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-value&quot;&gt;&lt;%=change_order_text%&gt;&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;snapshot-label&quot;&gt;Effective Date&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;snapshot-value&quot;&gt;&lt;%=effective_date_text%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;snapshot-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;snapshot-card-title&quot;&gt;Snapshot JSON&lt;/h2&gt;\n\t\t\t&lt;div class=&quot;snapshot-card-body&quot;&gt;\n&lt;%\n\t\tif(snapshot_text != &quot;&quot;)\n\t\t{\n%&gt;\n\t\t\t\t&lt;pre class=&quot;snapshot-raw&quot;&gt;&lt;%=snapshot_text%&gt;&lt;/pre&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;snapshot-empty&quot;&gt;No snapshot_json value is stored on this Item Revision History record.&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;%\n}\nelse\n{\n%&gt;\n\t\t&lt;section class=&quot;snapshot-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;snapshot-card-title&quot;&gt;Snapshot Not Found&lt;/h2&gt;\n\t\t\t&lt;div class=&quot;snapshot-card-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;snapshot-empty&quot;&gt;&lt;%=not_found_text%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;%\n}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Item_Sourcing_View(int item_id)
		{
					displayname = "Item Sourcing View"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Item_Sourcing_View_Snippet' elementName='Item_Sourcing_View_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Item_Sourcing_View_Snippet()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nroot_found = false;\nroot_is_assembly = false;\nchild_ids = List();\nqty_by_item = Map();\nline_status_by_item = Map();\nmax_depth_notice = false;\nif(input.item_id != null)\n{\n\t\troot_rec = Item_Master[ID == input.item_id &amp;&amp; is_deleted == false];\n\t\tif(root_rec.count() &gt; 0)\n\t\t{\n\t\t\t\troot_found = true;\n\t\t\t\tif(root_rec.part_type == &quot;Assembly&quot;)\n\t\t\t\t{\n\t\t\t\t\t\troot_is_assembly = true;\n\t\t\t\t}\n\t\t\t\tcurrent_level = List();\n\t\t\t\troot_state = Map();\n\t\t\t\troot_state.put(&quot;item_id&quot;,root_rec.ID);\n\t\t\t\troot_state.put(&quot;path_qty&quot;,1.0);\n\t\t\t\troot_state.put(&quot;path&quot;,&quot;|&quot; + root_rec.ID.toString() + &quot;|&quot;);\n\t\t\t\tcurrent_level.add(root_state);\n\t\t\t\tdepth = 0;\n\t\t\t\tdepth_steps = List();\n\t\t\t\tdepth_steps.add(1);\n\t\t\t\tdepth_steps.add(2);\n\t\t\t\tdepth_steps.add(3);\n\t\t\t\tdepth_steps.add(4);\n\t\t\t\tdepth_steps.add(5);\n\t\t\t\tdepth_steps.add(6);\n\t\t\t\tdepth_steps.add(7);\n\t\t\t\tdepth_steps.add(8);\n\t\t\t\tdepth_steps.add(9);\n\t\t\t\tdepth_steps.add(10);\n\t\t\t\tfor each depth_marker in depth_steps\n\t\t\t\t{\n\t\t\t\t\t\tif(current_level.size() &gt; 0 &amp;&amp; depth &lt; 10)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tnext_level = List();\n\t\t\t\t\t\t\t\tfor each parent_state in current_level\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tparent_id = parent_state.get(&quot;item_id&quot;);\n\t\t\t\t\t\t\t\t\t\tparent_path_qty = ifnull(parent_state.get(&quot;path_qty&quot;),1.0);\n\t\t\t\t\t\t\t\t\t\tparent_path = ifnull(parent_state.get(&quot;path&quot;),&quot;&quot;);\n\t\t\t\t\t\t\t\t\t\tfor each bom_line in BOM_Line[parent_item == parent_id &amp;&amp; is_struck == false]\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tchild_id = bom_line.child_item;\n\t\t\t\t\t\t\t\t\t\t\t\tif(child_id != null)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tline_qty = ifnull(bom_line.quantity,0.0);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpath_qty = parent_path_qty * line_qty;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tchild_key = child_id.toString();\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texisting_qty = ifnull(qty_by_item.get(child_key),0.0);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tqty_by_item.put(child_key,existing_qty + path_qty);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatus_text = ifnull(bom_line.manufacturer_approval_status,&quot;Pending_Review&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texisting_status = ifnull(line_status_by_item.get(child_key),&quot;&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(existing_status == &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tline_status_by_item.put(child_key,status_text);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse if(!existing_status.contains(status_text))\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tline_status_by_item.put(child_key,existing_status + &quot;, &quot; + status_text);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(child_id not in child_ids)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tchild_ids.add(child_id);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tchild_token = &quot;|&quot; + child_id.toString() + &quot;|&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(!parent_path.contains(child_token))\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tnext_state = Map();\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tnext_state.put(&quot;item_id&quot;,child_id);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tnext_state.put(&quot;path_qty&quot;,path_qty);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tnext_state.put(&quot;path&quot;,parent_path + child_id.toString() + &quot;|&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tnext_level.add(next_state);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tcurrent_level = next_level;\n\t\t\t\t\t\t\t\tdepth = depth + 1;\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(current_level.size() &gt; 0)\n\t\t\t\t{\n\t\t\t\t\t\tmax_depth_notice = true;\n\t\t\t\t}\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-p-2 { padding: .125rem; } .zcs-p-8 { padding: .5rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; } .zcs-m-0 { margin: 0; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mx-0 { margin-left: 0; margin-right: 0; } .zcs-mb-0 { margin-bottom: 0; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-box-border { box-sizing: border-box; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-sticky { position: sticky; } .zcs-relative { position: relative; } a { text-decoration: none; }\n.aria-sourcing-page { box-sizing: border-box; min-height: 100%; background: var(--zcs-page-bg-color,#F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }\n.aria-sourcing-shell { max-width: 1440px; margin: 0 auto; padding: 0 20px 28px; }\n.zcs-page-header { background: var(--zcs-white-color); border-bottom: 1px solid var(--zcs_tertiary_border_color); }\n.aria-header-kicker { color: var(--zcs-secondary-text-color); margin-top: 4px; }\n.aria-card { background: var(--zcs-white-color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; box-shadow: 0 1px 2px rgba(16,24,40,.04); margin-top: 16px; overflow: hidden; }\n.aria-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs_tertiary_border_color); background: var(--zcs-white-color); }\n.aria-card-title { margin: 0; color: var(--zcs-primary-text-color); font-size: 17px; line-height: 1.25; font-weight: 600; }\n.aria-card-subtitle { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; line-height: 1.45; }\n.aria-root-grid { display: grid; grid-template-columns: minmax(0,1.5fr) repeat(3,minmax(120px,.5fr)); gap: 12px; padding: 16px 20px; }\n.aria-root-cell { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 10px; padding: 12px; background: #FBFCFF; }\n.aria-root-label { color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.35; margin-bottom: 4px; }\n.aria-root-value { color: var(--zcs-primary-text-color); font-size: 14px; line-height: 1.35; font-weight: 600; }\n.aria-warning { margin: 14px 20px 0; padding: 12px 14px; border-radius: 10px; border: 1px solid #FAAE13; background: #FFF8E7; color: #7A5200; display: flex; align-items: flex-start; gap: 8px; font-size: 13px; line-height: 1.45; }\n.aria-source-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 0; border-bottom: 1px solid #EEF0F6; }\n.aria-source-line:last-child { border-bottom: 0; }\n.aria-slot { min-width: 92px; color: var(--zcs-secondary-text-color); font-size: 12px; font-weight: 600; }\n.aria-mfg-name { color: var(--zcs-primary-text-color); font-weight: 600; }\n.aria-mpn { color: var(--zcs-secondary-text-color); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n.aria-muted { color: var(--zcs-secondary-text-color); }\n.aria-empty-inline { color: var(--zcs-secondary-text-color); font-size: 13px; padding: 8px 0; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 980px; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.zcs-nodata-wrapper { min-height: 280px; background: var(--zcs-white-color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; }\n@media (max-width: 768px) { .aria-sourcing-shell { padding: 0 12px 20px; } .zcs-page-header { padding: 14px 16px; } .aria-root-grid { grid-template-columns: 1fr; padding: 14px; } .aria-card-header { padding: 14px; } }\n&lt;/style&gt;\n&lt;div class=&quot;aria-sourcing-page&quot;&gt;\n\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Item Sourcing View&lt;/h5&gt;\n\t\t\t\t\t\t&lt;div class=&apos;aria-header-kicker zcs-font-13 zcs-lh-body&apos;&gt;Flattened manufacturer and MPN sourcing for a top-level assembly.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;Internal PLM&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;aria-sourcing-shell&quot;&gt;\n&lt;%\nif(input.item_id == null)\n{\n%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Select an assembly&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-color-secondary zcs-lh-body&apos;&gt;Open this page with an item_id parameter, for example #Page:Item_Sourcing_View?item_id=123456789.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n}\nelse if(!root_found)\n{\n%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Item not found&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-color-secondary zcs-lh-body&apos;&gt;No active Item_Master record was found for item_id &lt;%=input.item_id%&gt;.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n}\nelse\n{\n%&gt;\n\t\t\t\t&lt;div class=&quot;aria-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-card-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;aria-card-title&quot;&gt;&lt;%=ifnull(root_rec.apn,&quot;No APN&quot;)%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;aria-card-subtitle&quot;&gt;&lt;%=ifnull(root_rec.description,&quot;No description&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-root-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-cell&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-label&quot;&gt;Top-level item&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-value&quot;&gt;&lt;%=ifnull(root_rec.part_name,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-cell&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-label&quot;&gt;Part type&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-value&quot;&gt;&lt;%=ifnull(root_rec.part_type,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-cell&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-label&quot;&gt;Lifecycle&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-value&quot;&gt;&lt;%=ifnull(root_rec.lifecycle_phase,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-cell&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-label&quot;&gt;Flattened rows&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-root-value&quot;&gt;&lt;%=child_ids.size()%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(!root_is_assembly)\n\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-warning&quot;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;The selected top-level item is not marked as Assembly. Sourcing rows below are shown only if active BOM lines exist.&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(max_depth_notice)\n\t\t{\n%&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-warning&quot;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;BOM traversal stopped at depth 10 to avoid runaway recursion. Quantities reflect paths rendered up to that depth.&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(child_ids.size() == 0)\n\t\t{\n%&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos; style=&apos;margin-top:16px;&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No active BOM sourcing rows&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-color-secondary zcs-lh-body&apos;&gt;This assembly has no non-struck BOM_Line children to flatten.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n%&gt;\n\t\t\t\t&lt;div class=&quot;aria-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-card-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;aria-card-title&quot;&gt;Manufacturer View&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;aria-card-subtitle&quot;&gt;One row per flattened component, with all populated manufacturer and MPN alternates. Global approval comes from Manufacturer_Master; BOM-line approval comes from BOM_Line.manufacturer_approval_status.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;APN&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Description&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Total Quantity&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;BOM-line Approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Manufacturer / MPN Alternates&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;5&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\t\tfor each child_id in child_ids\n\t\t\t\t{\n\t\t\t\t\t\titem_key = child_id.toString();\n\t\t\t\t\t\titem_rec = Item_Master[ID == child_id &amp;&amp; is_deleted == false];\n\t\t\t\t\t\tif(item_rec.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttotal_qty = ifnull(qty_by_item.get(item_key),0.0);\n\t\t\t\t\t\t\t\tline_approval = ifnull(line_status_by_item.get(item_key),&quot;Pending_Review&quot;);\n\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tif(line_approval == &quot;Approved&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(line_approval.contains(&quot;Unapproved&quot;))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(line_approval.contains(&quot;,&quot;))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tsource_maps = List();\n\t\t\t\t\t\t\t\tif(item_rec.mfg_0 != null || ifnull(item_rec.mpn_0,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_0/mpn_0&quot;); src.put(&quot;label&quot;,&quot;Primary&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_0); src.put(&quot;mpn&quot;,item_rec.mpn_0); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_1 != null || ifnull(item_rec.mpn_1,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_1/mpn_1&quot;); src.put(&quot;label&quot;,&quot;Alternate 1&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_1); src.put(&quot;mpn&quot;,item_rec.mpn_1); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_2 != null || ifnull(item_rec.mpn_2,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_2/mpn_2&quot;); src.put(&quot;label&quot;,&quot;Alternate 2&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_2); src.put(&quot;mpn&quot;,item_rec.mpn_2); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_3 != null || ifnull(item_rec.mpn_3,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_3/mpn_3&quot;); src.put(&quot;label&quot;,&quot;Alternate 3&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_3); src.put(&quot;mpn&quot;,item_rec.mpn_3); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_4 != null || ifnull(item_rec.mpn_4,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_4/mpn_4&quot;); src.put(&quot;label&quot;,&quot;Alternate 4&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_4); src.put(&quot;mpn&quot;,item_rec.mpn_4); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_5 != null || ifnull(item_rec.mpn_5,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_5/mpn_5&quot;); src.put(&quot;label&quot;,&quot;Alternate 5&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_5); src.put(&quot;mpn&quot;,item_rec.mpn_5); source_maps.add(src); }\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(item_rec.apn,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(item_rec.description,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=total_qty%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=line_badge_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=line_approval%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n&lt;%\n\t\t\t\t\t\t\t\tif(source_maps.size() == 0)\n\t\t\t\t\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-empty-inline&quot;&gt;No manufacturer or MPN alternates populated.&lt;/div&gt;\n&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tfor each src in source_maps\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmfg_id = src.get(&quot;mfg_id&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tmfg_name = &quot;No manufacturer&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Not linked&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(mfg_id != null)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfr_rec = Manufacturer_Master[ID == mfg_id];\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.count() &gt; 0)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_name = ifnull(mfr_rec.manufacturer_name,&quot;Unnamed manufacturer&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.is_approved == true)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Globally Approved&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Global Unapproved&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.is_active != true)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = mfg_status_label + &quot; / Inactive&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_name = &quot;Manufacturer record not found&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Missing Master&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;aria-source-line&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;aria-slot&quot;&gt;&lt;%=src.get(&quot;label&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;aria-mfg-name&quot;&gt;&lt;%=mfg_name%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;aria-mpn&quot;&gt;&lt;%=ifnull(src.get(&quot;mpn&quot;),&quot;No MPN&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;aria-muted&quot;&gt;&lt;%=src.get(&quot;slot&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=mfg_badge_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=mfg_status_label%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;aria-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;aria-card-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;aria-card-title&quot;&gt;MPN View&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;aria-card-subtitle&quot;&gt;One row per populated mfg_N/mpn_N pair for procurement review of all alternates across the flattened BOM.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;APN&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Description&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Total Quantity&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Slot&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;MPN&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Manufacturer&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Global Mfr Approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;BOM-line Approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;8&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\t\tmpn_row_count = 0;\n\t\t\t\tfor each child_id in child_ids\n\t\t\t\t{\n\t\t\t\t\t\titem_key = child_id.toString();\n\t\t\t\t\t\titem_rec = Item_Master[ID == child_id &amp;&amp; is_deleted == false];\n\t\t\t\t\t\tif(item_rec.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttotal_qty = ifnull(qty_by_item.get(item_key),0.0);\n\t\t\t\t\t\t\t\tline_approval = ifnull(line_status_by_item.get(item_key),&quot;Pending_Review&quot;);\n\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tif(line_approval == &quot;Approved&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(line_approval.contains(&quot;Unapproved&quot;))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(line_approval.contains(&quot;,&quot;))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tline_badge_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tsource_maps = List();\n\t\t\t\t\t\t\t\tif(item_rec.mfg_0 != null || ifnull(item_rec.mpn_0,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_0/mpn_0&quot;); src.put(&quot;label&quot;,&quot;Primary&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_0); src.put(&quot;mpn&quot;,item_rec.mpn_0); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_1 != null || ifnull(item_rec.mpn_1,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_1/mpn_1&quot;); src.put(&quot;label&quot;,&quot;Alternate 1&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_1); src.put(&quot;mpn&quot;,item_rec.mpn_1); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_2 != null || ifnull(item_rec.mpn_2,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_2/mpn_2&quot;); src.put(&quot;label&quot;,&quot;Alternate 2&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_2); src.put(&quot;mpn&quot;,item_rec.mpn_2); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_3 != null || ifnull(item_rec.mpn_3,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_3/mpn_3&quot;); src.put(&quot;label&quot;,&quot;Alternate 3&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_3); src.put(&quot;mpn&quot;,item_rec.mpn_3); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_4 != null || ifnull(item_rec.mpn_4,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_4/mpn_4&quot;); src.put(&quot;label&quot;,&quot;Alternate 4&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_4); src.put(&quot;mpn&quot;,item_rec.mpn_4); source_maps.add(src); }\n\t\t\t\t\t\t\t\tif(item_rec.mfg_5 != null || ifnull(item_rec.mpn_5,&quot;&quot;) != &quot;&quot;) { src = Map(); src.put(&quot;slot&quot;,&quot;mfg_5/mpn_5&quot;); src.put(&quot;label&quot;,&quot;Alternate 5&quot;); src.put(&quot;mfg_id&quot;,item_rec.mfg_5); src.put(&quot;mpn&quot;,item_rec.mpn_5); source_maps.add(src); }\n\t\t\t\t\t\t\t\tfor each src in source_maps\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tmpn_row_count = mpn_row_count + 1;\n\t\t\t\t\t\t\t\t\t\tmfg_id = src.get(&quot;mfg_id&quot;);\n\t\t\t\t\t\t\t\t\t\tmfg_name = &quot;No manufacturer&quot;;\n\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Not linked&quot;;\n\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\tif(mfg_id != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tmfr_rec = Manufacturer_Master[ID == mfg_id];\n\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.count() &gt; 0)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_name = ifnull(mfr_rec.manufacturer_name,&quot;Unnamed manufacturer&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.is_approved == true)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Globally Approved&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Global Unapproved&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mfr_rec.is_active != true)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = mfg_status_label + &quot; / Inactive&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_name = &quot;Manufacturer record not found&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_status_label = &quot;Missing Master&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmfg_badge_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(item_rec.apn,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(item_rec.description,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=total_qty%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos;&gt;&lt;%=src.get(&quot;slot&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&quot;aria-mpn&quot;&gt;&lt;%=ifnull(src.get(&quot;mpn&quot;),&quot;No MPN&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=mfg_name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=mfg_badge_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=mfg_status_label%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=line_badge_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=line_approval%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(mpn_row_count == 0)\n\t\t\t\t{\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tnodata&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;8&apos;&gt;No populated manufacturer or MPN alternates were found in mfg_0/mpn_0 through mfg_5/mpn_5.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n}\n%&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page PLM_Dashboard_Home
		{
					displayname = "PLM Dashboard Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Dashboard_Header_KPIs' elementName='Dashboard_Header_KPIs'>\n\t\t\t\t\t<![CDATA[htmlpage Dashboard_Header_KPIs()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nopenCO = Change_Order[status != &quot;Complete&quot; &amp;&amp; status != &quot;Cancelled&quot;].count();\npendingApprovals = Approval_Matrix_Line[decision == &quot;Pending&quot;].count();\npendingECN = ECN_Acknowledgment[status == &quot;Pending&quot;].count();\nactiveDeviations = Change_Order[change_category == &quot;Deviation&quot; &amp;&amp; status == &quot;Effective&quot;].count();\nreleasedItems = Item_Master[is_deleted == false &amp;&amp; lifecycle_phase == &quot;Production&quot;].count();\nmyProfile = &quot;&quot;;\nemp = Employee_Master[email == zoho.loginuserid &amp;&amp; is_active == true];\nif(emp.count() &gt; 0)\n{\n\t\tmyProfile = ifnull(emp.profile_label,&quot;&quot;);\n}\n%&gt;\n&lt;style&gt;\n.plm-home{background:#F3F3F4;padding:20px;color:var(--zcs_primary_text_color);box-sizing:border-box}.plm-head{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:20px;margin-bottom:16px;display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.plm-head h1{margin:0;font-size:24px;line-height:1.2}.plm-head p{margin:6px 0 0;color:var(--zcs_secondary_text_color)}.plm-badge{display:inline-flex;align-items:center;gap:6px;background:#EAF2FF;color:#2A6FFC;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:600}.plm-kpis{display:grid;grid-template-columns:repeat(5,minmax(140px,1fr));gap:12px}.plm-kpi{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:16px;box-sizing:border-box}.plm-kpi .icon{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);margin-bottom:10px}.plm-kpi .label{color:var(--zcs_secondary_text_color);font-size:12px}.plm-kpi .value{font-size:28px;font-weight:700;margin-top:4px}.plm-kpi a{color:inherit;text-decoration:none}@media(max-width:900px){.plm-kpis{grid-template-columns:1fr 1fr}.plm-head{display:block}}@media(max-width:520px){.plm-kpis{grid-template-columns:1fr}.plm-home{padding:12px}}\n&lt;/style&gt;\n&lt;div class=&quot;plm-home&quot;&gt;\n\t&lt;div class=&quot;plm-head&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h1&gt;PLM Dashboard Home&lt;/h1&gt;\n\t\t\t&lt;p&gt;Live view of engineering change, item lifecycle, sourcing, deviations, ECN acknowledgments, and recent activity.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&quot;plm-badge&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;% if(myProfile != &quot;&quot;) { %&gt;&lt;%=myProfile%&gt;&lt;% } else { %&gt;Role-aware&lt;% } %&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;plm-kpis&quot;&gt;\n\t\t&lt;a class=&quot;plm-kpi&quot; href=&quot;#Report:All_Change_Orders&quot;&gt;&lt;div class=&quot;icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-content-03&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Open Change Orders&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=openCO%&gt;&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a class=&quot;plm-kpi&quot; href=&quot;#Report:My_Pending_Approvals&quot;&gt;&lt;div class=&quot;icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;My Pending Approvals&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=pendingApprovals%&gt;&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a class=&quot;plm-kpi&quot; href=&quot;#Report:My_Pending_ECN_Acknowledgments&quot;&gt;&lt;div class=&quot;icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Pending ECN Acks&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=pendingECN%&gt;&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a class=&quot;plm-kpi&quot; href=&quot;#Report:Open_Deviations_Calendar&quot;&gt;&lt;div class=&quot;icon&quot;&gt;&lt;i class=&quot;zc-li-outline travel-info&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Active Deviations&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=activeDeviations%&gt;&lt;/div&gt;&lt;/a&gt;\n\t\t&lt;a class=&quot;plm-kpi&quot; href=&quot;#Report:Items_By_Lifecycle&quot;&gt;&lt;div class=&quot;icon&quot;&gt;&lt;i class=&quot;zc-li-outline design_app&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;label&quot;&gt;Production Items&lt;/div&gt;&lt;div class=&quot;value&quot;&gt;&lt;%=releasedItems%&gt;&lt;/div&gt;&lt;/a&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Change_Status_Lifecycle' elementName='Change_Status_Lifecycle'>\n\t\t\t\t\t<![CDATA[htmlpage Change_Status_Lifecycle()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nstatuses = {&quot;Open&quot;,&quot;Submitted&quot;,&quot;Approval_In_Progress&quot;,&quot;Approved&quot;,&quot;Effective&quot;,&quot;Complete&quot;,&quot;Rejected&quot;,&quot;Cancelled&quot;};\nmaxCO = 1;\nstatus_counts = Map();\nfor each s in statuses\n{\n\t\tc = Change_Order[status == s].count();\n\t\tstatus_counts.put(s,c);\n\t\tif(c &gt; maxCO){maxCO = c;}\n}\nphases = {&quot;Unreleased&quot;,&quot;Design&quot;,&quot;Production&quot;,&quot;Deprecated&quot;,&quot;Obsolete&quot;};\nmaxItem = 1;\nphase_counts = Map();\nfor each p in phases\n{\n\t\tpc = Item_Master[is_deleted == false &amp;&amp; lifecycle_phase == p].count();\n\t\tphase_counts.put(p,pc);\n\t\tif(pc &gt; maxItem){maxItem = pc;}\n}\n%&gt;\n&lt;style&gt;\n.plm-card{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin:0 10px 16px 20px;box-sizing:border-box}.plm-card h2{font-size:17px;margin:0 0 12px}.plm-rowbar{display:grid;grid-template-columns:150px 1fr 44px;gap:10px;align-items:center;margin:9px 0}.plm-label{font-size:13px;color:var(--zcs_secondary_text_color);overflow:hidden;text-overflow:ellipsis}.plm-track{height:10px;background:#EEF0F6;border-radius:999px;overflow:hidden}.plm-fill{height:10px;background:#2A6FFC;border-radius:999px}.plm-fill.green{background:#179E6C}.plm-fill.orange{background:#F4660C}.plm-fill.red{background:#FE455D}.plm-count{text-align:right;font-weight:600;font-size:13px}.plm-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.plm-link{font-size:12px;color:var(--zcs_brand_color);text-decoration:none;border:1px solid var(--zcs_brand_color);border-radius:999px;padding:6px 10px}@media(max-width:700px){.plm-card{margin:0 12px 14px}.plm-rowbar{grid-template-columns:1fr}}\n&lt;/style&gt;\n&lt;div class=&quot;plm-card&quot;&gt;\n\t&lt;h2&gt;Change Orders by Status&lt;/h2&gt;\n\t&lt;% for each s in statuses { pct = (status_counts.get(s) * 100) / maxCO; cls=&quot;&quot;; if(s == &quot;Complete&quot; || s == &quot;Effective&quot;){cls=&quot;green&quot;;} if(s == &quot;Rejected&quot; || s == &quot;Cancelled&quot;){cls=&quot;red&quot;;} %&gt;\n\t&lt;div class=&quot;plm-rowbar&quot;&gt;&lt;div class=&quot;plm-label&quot;&gt;&lt;%=s%&gt;&lt;/div&gt;&lt;div class=&quot;plm-track&quot;&gt;&lt;div class=&quot;plm-fill &lt;%=cls%&gt;&quot; style=&quot;width:&lt;%=pct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;plm-count&quot;&gt;&lt;%=status_counts.get(s)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;% } %&gt;\n\t&lt;div class=&quot;plm-actions&quot;&gt;&lt;a class=&quot;plm-link&quot; href=&quot;#Report:All_Change_Orders&quot;&gt;Open Change Orders&lt;/a&gt;&lt;a class=&quot;plm-link&quot; href=&quot;#Report:Change_Orders_By_Status&quot;&gt;Status Report&lt;/a&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div class=&quot;plm-card&quot;&gt;\n\t&lt;h2&gt;Items by Lifecycle Phase&lt;/h2&gt;\n\t&lt;% for each p in phases { pct2 = (phase_counts.get(p) * 100) / maxItem; cls2=&quot;&quot;; if(p == &quot;Production&quot;){cls2=&quot;green&quot;;} if(p == &quot;Deprecated&quot;){cls2=&quot;orange&quot;;} if(p == &quot;Obsolete&quot;){cls2=&quot;red&quot;;} %&gt;\n\t&lt;div class=&quot;plm-rowbar&quot;&gt;&lt;div class=&quot;plm-label&quot;&gt;&lt;%=p%&gt;&lt;/div&gt;&lt;div class=&quot;plm-track&quot;&gt;&lt;div class=&quot;plm-fill &lt;%=cls2%&gt;&quot; style=&quot;width:&lt;%=pct2%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;plm-count&quot;&gt;&lt;%=phase_counts.get(p)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;% } %&gt;\n\t&lt;div class=&quot;plm-actions&quot;&gt;&lt;a class=&quot;plm-link&quot; href=&quot;#Report:All_Items&quot;&gt;All Items&lt;/a&gt;&lt;a class=&quot;plm-link&quot; href=&quot;#Report:Items_By_Lifecycle&quot;&gt;Lifecycle Report&lt;/a&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Work_Queues' elementName='Work_Queues'>\n\t\t\t\t\t<![CDATA[htmlpage Work_Queues()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nmy_emp = Employee_Master[email == zoho.loginuserid &amp;&amp; is_active == true];\nmy_id = 0;\nif(my_emp.count() &gt; 0){my_id = my_emp.ID;}\napprovals = Approval_Matrix_Line[decision == &quot;Pending&quot;] sort by sequence_no range from 0 to 4;\nmyNirs = New_Item_Request[raised_by_employee == my_id &amp;&amp; status != &quot;Approved&quot; &amp;&amp; status != &quot;Rejected&quot;] sort by request_datetime desc range from 0 to 4;\nmyRequests = Change_Request[requested_by_employee == my_id &amp;&amp; status != &quot;Converted&quot; &amp;&amp; status != &quot;Rejected&quot;] sort by created_date desc range from 0 to 4;\n%&gt;\n&lt;style&gt;\n.plm-queue{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin:0 20px 16px 10px;box-sizing:border-box}.plm-queue h2{font-size:17px;margin:0 0 12px}.plm-list{display:grid;gap:10px}.plm-item{border:1px solid #EEF0F6;border-radius:10px;padding:10px}.plm-title{font-size:14px;font-weight:600;color:var(--zcs_primary_text_color)}.plm-meta{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:4px}.plm-empty{color:var(--zcs_secondary_text_color);font-size:13px;padding:12px;border:1px dashed var(--zcs_tertiary_border_color);border-radius:10px}.plm-q-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 0}.plm-q-link{font-size:12px;color:var(--zcs_brand_color);text-decoration:none;border:1px solid var(--zcs_brand_color);border-radius:999px;padding:6px 10px}@media(max-width:700px){.plm-queue{margin:0 12px 14px}}\n&lt;/style&gt;\n&lt;div class=&quot;plm-queue&quot;&gt;\n\t&lt;h2&gt;My Pending Approvals&lt;/h2&gt;\n\t&lt;div class=&quot;plm-list&quot;&gt;\n\t&lt;% rows = 0; for each a in approvals { rows = rows + 1; approverName = &quot;Pending approver&quot;; if(a.approver != null){ap = Employee_Master[ID == a.approver]; if(ap.count() &gt; 0){approverName = ifnull(ap.employee_name,&quot;Approver&quot;);}} %&gt;\n\t\t&lt;div class=&quot;plm-item&quot;&gt;&lt;div class=&quot;plm-title&quot;&gt;&lt;%=approverName%&gt;&lt;/div&gt;&lt;div class=&quot;plm-meta&quot;&gt;Sequence &lt;%=ifnull(a.sequence_no,&quot;-&quot;)%&gt; | Decision &lt;%=ifnull(a.decision,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;% } if(rows == 0) { %&gt;&lt;div class=&quot;plm-empty&quot;&gt;No pending approval rows are currently visible.&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;plm-q-actions&quot;&gt;&lt;a class=&quot;plm-q-link&quot; href=&quot;#Report:My_Pending_Approvals&quot;&gt;Open approval inbox&lt;/a&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;div class=&quot;plm-queue&quot;&gt;\n\t&lt;h2&gt;My Engineering Requests&lt;/h2&gt;\n\t&lt;div class=&quot;plm-list&quot;&gt;\n\t&lt;% requestRows = 0; for each n in myNirs { requestRows = requestRows + 1; %&gt;&lt;div class=&quot;plm-item&quot;&gt;&lt;div class=&quot;plm-title&quot;&gt;&lt;%=ifnull(n.nir_id,n.ID.toString())%&gt;&lt;/div&gt;&lt;div class=&quot;plm-meta&quot;&gt;&lt;%=ifnull(n.description,&quot;New item request&quot;)%&gt; | &lt;%=ifnull(n.status,&quot;Open&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t&lt;% for each r in myRequests { requestRows = requestRows + 1; %&gt;&lt;div class=&quot;plm-item&quot;&gt;&lt;div class=&quot;plm-title&quot;&gt;&lt;%=ifnull(r.request_id,r.ID.toString())%&gt; - &lt;%=ifnull(r.title,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;plm-meta&quot;&gt;&lt;%=ifnull(r.request_type,&quot;Change&quot;)%&gt; | &lt;%=ifnull(r.status,&quot;Open&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;% } %&gt;\n\t&lt;% if(requestRows == 0) { %&gt;&lt;div class=&quot;plm-empty&quot;&gt;No personal open NIR/ECR/MCR requests are currently visible.&lt;/div&gt;&lt;% } %&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;plm-q-actions&quot;&gt;&lt;a class=&quot;plm-q-link&quot; href=&quot;#Report:My_NIRs&quot;&gt;My NIRs&lt;/a&gt;&lt;a class=&quot;plm-q-link&quot; href=&quot;#Report:My_Requests&quot;&gt;My Requests&lt;/a&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Deviation_ECN_Activity' elementName='Deviation_ECN_Activity'>\n\t\t\t\t\t<![CDATA[htmlpage Deviation_ECN_Activity()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nsoon = zoho.currentdate.addDay(7);\nopenDevs = Change_Order[change_category == &quot;Deviation&quot; &amp;&amp; status == &quot;Effective&quot;] sort by expiration_date range from 0 to 5;\npendingAcks = ECN_Acknowledgment[status == &quot;Pending&quot;] sort by ID desc range from 0 to 5;\nactivity = Activity_Log[ID != 0] sort by changed_on desc range from 0 to 9;\n%&gt;\n&lt;style&gt;\n.plm-wide{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;margin:0 20px 20px;box-sizing:border-box}.plm-wide h2{font-size:17px;margin:0 0 12px}.plm-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}.plm-panel{border:1px solid #EEF0F6;border-radius:12px;padding:12px}.plm-panel h3{margin:0 0 10px;font-size:14px}.plm-line{padding:9px 0;border-bottom:1px solid #EEF0F6}.plm-line:last-child{border-bottom:0}.plm-line-title{font-size:13px;font-weight:600}.plm-line-meta{font-size:12px;color:var(--zcs_secondary_text_color);margin-top:3px}.plm-flag{display:inline-flex;align-items:center;gap:5px;background:#FE455D;color:#fff;border-radius:999px;padding:3px 7px;font-size:11px;margin-left:6px}.plm-empty2{color:var(--zcs_secondary_text_color);font-size:13px;padding:8px 0}.plm-wide a{color:var(--zcs_brand_color);text-decoration:none}@media(max-width:950px){.plm-grid3{grid-template-columns:1fr}.plm-wide{margin:0 12px 14px}}\n&lt;/style&gt;\n&lt;div class=&quot;plm-wide&quot;&gt;\n\t&lt;h2&gt;Deviation, ECN, and Activity Watch&lt;/h2&gt;\n\t&lt;div class=&quot;plm-grid3&quot;&gt;\n\t\t&lt;div class=&quot;plm-panel&quot;&gt;&lt;h3&gt;Open Deviations&lt;/h3&gt;\n\t\t\t&lt;% drows = 0; for each d in openDevs { drows = drows + 1; expSoon = false; if(d.expiration_date != null &amp;&amp; d.expiration_date &lt;= soon){expSoon = true;} %&gt;\n\t\t\t&lt;div class=&quot;plm-line&quot;&gt;&lt;div class=&quot;plm-line-title&quot;&gt;&lt;%=ifnull(d.order_id,d.ID.toString())%&gt;&lt;% if(expSoon) { %&gt;&lt;span class=&quot;plm-flag&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;Within 7 days&lt;/span&gt;&lt;% } %&gt;&lt;/div&gt;&lt;div class=&quot;plm-line-meta&quot;&gt;Expires: &lt;%=ifnull(d.expiration_date,&quot;Not set&quot;)%&gt; | Used: &lt;%=ifnull(d.units_consumed,0)%&gt;/&lt;%=ifnull(d.max_unit_count,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% } if(drows == 0) { %&gt;&lt;div class=&quot;plm-empty2&quot;&gt;No active deviations found.&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;a href=&quot;#Report:Open_Deviations_Calendar&quot;&gt;Open deviations calendar&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;plm-panel&quot;&gt;&lt;h3&gt;Pending ECN Acknowledgments&lt;/h3&gt;\n\t\t\t&lt;% arows = 0; for each e in pendingAcks { arows = arows + 1; coText = &quot;Change Order&quot;; if(e.change_order != null){eco = Change_Order[ID == e.change_order]; if(eco.count() &gt; 0){coText = ifnull(eco.order_id,eco.ID.toString());}} %&gt;\n\t\t\t&lt;div class=&quot;plm-line&quot;&gt;&lt;div class=&quot;plm-line-title&quot;&gt;&lt;%=ifnull(e.ack_id,e.ID.toString())%&gt;&lt;/div&gt;&lt;div class=&quot;plm-line-meta&quot;&gt;&lt;%=coText%&gt; | &lt;%=ifnull(e.status,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% } if(arows == 0) { %&gt;&lt;div class=&quot;plm-empty2&quot;&gt;No pending ECN acknowledgments.&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;a href=&quot;#Report:My_Pending_ECN_Acknowledgments&quot;&gt;Open ECN inbox&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;plm-panel&quot;&gt;&lt;h3&gt;Recent Activity&lt;/h3&gt;\n\t\t\t&lt;% lrows = 0; for each l in activity { lrows = lrows + 1; %&gt;\n\t\t\t&lt;div class=&quot;plm-line&quot;&gt;&lt;div class=&quot;plm-line-title&quot;&gt;&lt;%=ifnull(l.activity_record_type,&quot;Record&quot;)%&gt; &lt;%=ifnull(l.record_id,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;plm-line-meta&quot;&gt;&lt;%=ifnull(l.field_changed,&quot;Change&quot;)%&gt;: &lt;%=ifnull(l.old_value,&quot;-&quot;)%&gt; to &lt;%=ifnull(l.new_value,&quot;-&quot;)%&gt; | &lt;%=ifnull(l.changed_on,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;% } if(lrows == 0) { %&gt;&lt;div class=&quot;plm-empty2&quot;&gt;No activity has been logged yet.&lt;/div&gt;&lt;% } %&gt;\n\t\t\t&lt;a href=&quot;#Report:Audit_History&quot;&gt;Open audit history&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Where_Used_Explorer(int item_id)
		{
					displayname = "Where Used Explorer"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Where_Used_Dsp_01' elementName='Where Used Renderer'>\n\t\t\t\t\t<![CDATA[htmlpage Where_Used_Dsp_01()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tcomponent_item = Item_Master[ID == -1];\n\thas_request = false;\n\titem_found = false;\n\tcomponent_id = 0;\n\tcomponent_apn = &quot;-&quot;;\n\tcomponent_desc = &quot;-&quot;;\n\tcomponent_revision = &quot;-&quot;;\n\tcomponent_part_type = &quot;-&quot;;\n\tcomponent_lifecycle = &quot;-&quot;;\n\tdirect_rows = List();\n\tindirect_rows = List();\n\tdirect_parent_count = 0;\n\tactive_impacted_count = 0;\n\tdepth_cap = 8;\n\tcap_hit = false;\n\tcycle_hit = false;\n\tmissing_message = &quot;&quot;;\n\n\tif(input.item_id != null &amp;&amp; input.item_id &gt; 0)\n\t{\n\t\thas_request = true;\n\t\tcomponent_item = Item_Master[ID == input.item_id &amp;&amp; is_deleted == false];\n\t}\n\n\tif(has_request == true &amp;&amp; component_item.count() == 0)\n\t{\n\t\tmissing_message = &quot;No active Item Master record was found for item_id &quot; + input.item_id + &quot;.&quot;;\n\t}\n\n\tif(component_item.count() &gt; 0)\n\t{\n\t\titem_found = true;\n\t\tcomponent_id = component_item.ID;\n\t\tcomponent_apn = ifnull(component_item.apn,&quot;-&quot;);\n\t\tcomponent_desc = ifnull(component_item.description,&quot;-&quot;);\n\t\tcomponent_revision = ifnull(component_item.revision,&quot;-&quot;);\n\t\tcomponent_part_type = ifnull(component_item.part_type,&quot;-&quot;);\n\t\tcomponent_lifecycle = ifnull(component_item.lifecycle_phase,&quot;-&quot;);\n\n\t\tfrontier_ids = List();\n\t\tfrontier_qtys = List();\n\t\tfrontier_depths = List();\n\t\tfrontier_tokens = List();\n\t\tfrontier_labels = List();\n\n\t\tfor each bom_line in BOM_Line[child_item == component_id &amp;&amp; is_struck == false]\n\t\t{\n\t\t\tparent_id = bom_line.parent_item;\n\t\t\tif(parent_id != null)\n\t\t\t{\n\t\t\t\tparent_rec = Item_Master[ID == parent_id &amp;&amp; is_deleted == false];\n\t\t\t\tparent_apn = &quot;Item &quot; + parent_id;\n\t\t\t\tparent_desc = &quot;Parent item not found or deleted&quot;;\n\t\t\t\tparent_lifecycle = &quot;Unknown&quot;;\n\t\t\t\tparent_part_type = &quot;-&quot;;\n\t\t\t\tparent_found = false;\n\t\t\t\tif(parent_rec.count() &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tparent_found = true;\n\t\t\t\t\tparent_apn = ifnull(parent_rec.apn,&quot;-&quot;);\n\t\t\t\t\tparent_desc = ifnull(parent_rec.description,&quot;-&quot;);\n\t\t\t\t\tparent_lifecycle = ifnull(parent_rec.lifecycle_phase,&quot;-&quot;);\n\t\t\t\t\tparent_part_type = ifnull(parent_rec.part_type,&quot;-&quot;);\n\t\t\t\t\tif(parent_lifecycle not in {&quot;Obsolete&quot;,&quot;Abandoned&quot;})\n\t\t\t\t\t{\n\t\t\t\t\t\tactive_impacted_count = active_impacted_count + 1;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tline_qty = ifnull(bom_line.quantity,0);\n\t\t\t\trelationship_text = &quot;Direct BOM parent&quot;;\n\t\t\t\tif(bom_line.line_number != null)\n\t\t\t\t{\n\t\t\t\t\trelationship_text = relationship_text + &quot; line &quot; + bom_line.line_number;\n\t\t\t\t}\n\t\t\t\tdirect_map = Map();\n\t\t\t\tdirect_map.put(&quot;parent_id&quot;,parent_id);\n\t\t\t\tdirect_map.put(&quot;parent_apn&quot;,parent_apn);\n\t\t\t\tdirect_map.put(&quot;parent_description&quot;,parent_desc);\n\t\t\t\tdirect_map.put(&quot;relationship&quot;,relationship_text);\n\t\t\t\tdirect_map.put(&quot;quantity&quot;,line_qty);\n\t\t\t\tdirect_map.put(&quot;lifecycle&quot;,parent_lifecycle);\n\t\t\t\tdirect_map.put(&quot;part_type&quot;,parent_part_type);\n\t\t\t\tdirect_map.put(&quot;found&quot;,parent_found);\n\t\t\t\tdirect_rows.add(direct_map);\n\n\t\t\t\tdirect_token_seed = &quot;,&quot; + component_id + &quot;,&quot;;\n\t\t\t\tparent_token = &quot;,&quot; + parent_id + &quot;,&quot;;\n\t\t\t\tif(direct_token_seed.contains(parent_token))\n\t\t\t\t{\n\t\t\t\t\tcycle_hit = true;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tfrontier_ids.add(parent_id);\n\t\t\t\t\tfrontier_qtys.add(line_qty);\n\t\t\t\t\tfrontier_depths.add(1);\n\t\t\t\t\tfrontier_tokens.add(direct_token_seed + parent_id + &quot;,&quot;);\n\t\t\t\t\tfrontier_labels.add(component_apn + &quot; -&gt; &quot; + parent_apn);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tdirect_parent_count = direct_rows.size();\n\n\t\ttraversal_depth = 1;\n\t\tdepth_steps = List();\n\t\tdepth_steps.add(1);\n\t\tdepth_steps.add(2);\n\t\tdepth_steps.add(3);\n\t\tdepth_steps.add(4);\n\t\tdepth_steps.add(5);\n\t\tdepth_steps.add(6);\n\t\tdepth_steps.add(7);\n\t\tdepth_steps.add(8);\n\n\t\tfor each depth_marker in depth_steps\n\t\t{\n\t\t\tif(frontier_ids.size() &gt; 0 &amp;&amp; traversal_depth &lt; depth_cap)\n\t\t\t{\n\t\t\t\tnext_ids = List();\n\t\t\t\tnext_qtys = List();\n\t\t\t\tnext_depths = List();\n\t\t\t\tnext_tokens = List();\n\t\t\t\tnext_labels = List();\n\t\t\t\tfor each index fidx in frontier_ids\n\t\t\t\t{\n\t\t\t\t\tcurrent_child_id = frontier_ids.get(fidx);\n\t\t\t\t\tcurrent_qty = frontier_qtys.get(fidx);\n\t\t\t\t\tcurrent_depth = frontier_depths.get(fidx);\n\t\t\t\t\tcurrent_tokens = frontier_tokens.get(fidx);\n\t\t\t\t\tcurrent_label = frontier_labels.get(fidx);\n\t\t\t\t\tfor each parent_line in BOM_Line[child_item == current_child_id &amp;&amp; is_struck == false]\n\t\t\t\t\t{\n\t\t\t\t\t\tancestor_id = parent_line.parent_item;\n\t\t\t\t\t\tif(ancestor_id != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tancestor_token = &quot;,&quot; + ancestor_id + &quot;,&quot;;\n\t\t\t\t\t\t\tif(current_tokens.contains(ancestor_token))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcycle_hit = true;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tline_qty = ifnull(parent_line.quantity,0);\n\t\t\t\t\t\t\t\tpath_qty = current_qty * line_qty;\n\t\t\t\t\t\t\t\tancestor_depth = current_depth + 1;\n\t\t\t\t\t\t\t\tancestor_rec = Item_Master[ID == ancestor_id &amp;&amp; is_deleted == false];\n\t\t\t\t\t\t\t\tancestor_apn = &quot;Item &quot; + ancestor_id;\n\t\t\t\t\t\t\t\tancestor_desc = &quot;Ancestor item not found or deleted&quot;;\n\t\t\t\t\t\t\t\tancestor_lifecycle = &quot;Unknown&quot;;\n\t\t\t\t\t\t\t\tancestor_part_type = &quot;-&quot;;\n\t\t\t\t\t\t\t\tancestor_found = false;\n\t\t\t\t\t\t\t\tif(ancestor_rec.count() &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tancestor_found = true;\n\t\t\t\t\t\t\t\t\tancestor_apn = ifnull(ancestor_rec.apn,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\tancestor_desc = ifnull(ancestor_rec.description,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\tancestor_lifecycle = ifnull(ancestor_rec.lifecycle_phase,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\tancestor_part_type = ifnull(ancestor_rec.part_type,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\tif(ancestor_lifecycle not in {&quot;Obsolete&quot;,&quot;Abandoned&quot;})\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tactive_impacted_count = active_impacted_count + 1;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tpath_label = current_label + &quot; -&gt; &quot; + ancestor_apn;\n\t\t\t\t\t\t\t\trelationship_text = &quot;Level &quot; + ancestor_depth + &quot; ancestor&quot;;\n\t\t\t\t\t\t\t\tif(parent_line.line_number != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\trelationship_text = relationship_text + &quot; via BOM line &quot; + parent_line.line_number;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tindirect_map = Map();\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;parent_id&quot;,ancestor_id);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;parent_apn&quot;,ancestor_apn);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;parent_description&quot;,ancestor_desc);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;relationship&quot;,relationship_text);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;path_quantity&quot;,path_qty);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;lifecycle&quot;,ancestor_lifecycle);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;part_type&quot;,ancestor_part_type);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;path&quot;,path_label);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;depth&quot;,ancestor_depth);\n\t\t\t\t\t\t\t\tindirect_map.put(&quot;found&quot;,ancestor_found);\n\t\t\t\t\t\t\t\tindirect_rows.add(indirect_map);\n\n\t\t\t\t\t\t\t\tif(ancestor_depth &lt; depth_cap)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnext_ids.add(ancestor_id);\n\t\t\t\t\t\t\t\t\tnext_qtys.add(path_qty);\n\t\t\t\t\t\t\t\t\tnext_depths.add(ancestor_depth);\n\t\t\t\t\t\t\t\t\tnext_tokens.add(current_tokens + ancestor_id + &quot;,&quot;);\n\t\t\t\t\t\t\t\t\tnext_labels.add(path_label);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tmore_parents = BOM_Line[child_item == ancestor_id &amp;&amp; is_struck == false].count();\n\t\t\t\t\t\t\t\t\tif(more_parents &gt; 0)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcap_hit = true;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfrontier_ids = next_ids;\n\t\t\t\tfrontier_qtys = next_qtys;\n\t\t\t\tfrontier_depths = next_depths;\n\t\t\t\tfrontier_tokens = next_tokens;\n\t\t\t\tfrontier_labels = next_labels;\n\t\t\t\ttraversal_depth = traversal_depth + 1;\n\t\t\t}\n\t\t}\n\t\tif(frontier_ids.size() &gt; 0 &amp;&amp; traversal_depth &gt;= depth_cap)\n\t\t{\n\t\t\tcap_hit = true;\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\na { text-decoration: none; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1120px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 2; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table thead tr th.zcs-green,\n.zcs-table-wrapper table tbody tr td.zcs-green,\n.zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table thead tr th.zcs-red,\n.zcs-table-wrapper table tbody tr td.zcs-red,\n.zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table thead tr th.zcs-yellow,\n.zcs-table-wrapper table tbody tr td.zcs-yellow,\n.zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table thead tr th.zcs-blue,\n.zcs-table-wrapper table tbody tr td.zcs-blue,\n.zcs-table-wrapper table tbody tr td .zcs-blue { color: #09598e; }\n\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-outline { border: 1px solid; }\n.zcs-badge-outline.zcs-badge-theme { color: var(--zcs_brand_color); }\n.zcs-badge-outline.zcs-badge-green { color: #179E6C; }\n.zcs-badge-outline.zcs-badge-red { color: #FE455D; }\n.zcs-badge-outline.zcs-badge-grey { color: #242424; }\n.zcs-badge-outline.zcs-badge-yellow { color: #FAAE13; }\n.zcs-badge-outline.zcs-badge-blue { color: #2A6FFC; }\n.zcs-badge-outline.zcs-badge-orange { color: #F4660C; }\n\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n.where-used { background: var(--zcs-page-bg-color); padding: 20px; box-sizing: border-box; min-height: 100%; color: var(--zcs-primary-text-color); }\n.where-header { margin-bottom: 16px; }\n.where-header-title { display: flex; align-items: center; gap: 10px; }\n.where-header-title i { color: var(--zcs_brand_color); font-size: 22px; }\n.where-root-card { margin-bottom: 16px; }\n.where-root-grid { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(260px, 2fr) repeat(4, minmax(100px, auto)); gap: 14px; align-items: center; }\n.where-root-label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 3px; }\n.where-root-value { color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; }\n.where-section { margin-top: 18px; }\n.where-section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }\n.where-section-title { display: flex; align-items: center; gap: 8px; }\n.where-section-title i { color: var(--zcs_brand_color); font-size: 18px; }\n.where-summary-note { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.where-apn a { color: var(--zcs_brand_color); font-weight: 600; }\n.where-desc { max-width: 380px; white-space: normal; }\n.where-path { max-width: 460px; white-space: normal; color: var(--zcs-secondary-text-color); }\n.where-relationship { max-width: 230px; white-space: normal; }\n.where-link-stack { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; margin-top: 4px; }\n.where-mini-link { display: inline-flex; align-items: center; gap: 5px; color: var(--zcs_brand_color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 4px 8px; background: #FFFFFF; font-size: 12px; line-height: 1.2; }\n.where-mini-link:hover { border-color: var(--zcs_brand_color); background: var(--zcs_component_hover_color); }\n.where-cue { display: grid; gap: 6px; min-width: 250px; }\n.where-cue-text { color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.35; }\n.where-query { color: var(--zcs-teritiary-text-color); font-size: 12px; line-height: 1.35; word-break: break-word; }\n.where-empty { padding: 28px; text-align: center; }\n.where-empty i { display: block; color: var(--zcs_brand_color); font-size: 34px; margin-bottom: 10px; }\n.where-prompt-form { display: flex; gap: 10px; justify-content: center; align-items: end; flex-wrap: wrap; margin-top: 14px; }\n.where-prompt-field { text-align: left; }\n.where-prompt-field label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 4px; }\n.where-prompt-field input { min-height: 36px; min-width: 260px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 6px 10px; box-sizing: border-box; font-size: 14px; color: var(--zcs-primary-text-color); background: #FFFFFF; }\n.where-warning { margin-top: 12px; padding: 12px 14px; border: 1px solid #FAAE13; border-radius: 8px; color: #8A5B00; background: #FCF4E6; }\n.where-critical { margin-top: 12px; padding: 12px 14px; border: 1px solid #FE455D; border-radius: 8px; color: #9B1C2B; background: #FDE3E6; }\n@media (max-width: 980px) {\n\t.where-used { padding: 12px; }\n\t.where-root-grid { grid-template-columns: 1fr; }\n\t.where-section-head { align-items: flex-start; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;where-used&apos;&gt;\n\t&lt;div class=&apos;where-header zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;where-header-title&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-m-0 zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Where Used Explorer&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Direct and indirect upward BOM traversal for impact analysis, change-order review, and obsolete checks.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;% if(has_request == false) { %&gt;\n\t&lt;div class=&apos;where-empty zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Select a component item&lt;/h3&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Open this page with an Item Master ID to see all direct parents and higher-level assemblies that use the component.&lt;/p&gt;\n\t\t\t\t&lt;form class=&apos;where-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:Where_Used_Explorer&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;where-prompt-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;where_item_id&apos;&gt;Item Master ID&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;where_item_id&apos; name=&apos;item_id&apos; type=&apos;number&apos; placeholder=&apos;Example: 123456789&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Explore Usage&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t\t&lt;div class=&apos;where-link-stack zcs-justify-center zcs-mt-12&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:All_Items&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt; Browse All Items&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-12 zcs-font-13 zcs-color-tertiary&apos;&gt;URL format: #Page:Where_Used_Explorer?item_id=123456789.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;% } else if(item_found == false) { %&gt;\n\t&lt;div class=&apos;where-empty zcs-card&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Item not found&lt;/h3&gt;\n\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;&lt;%=missing_message%&gt;&lt;/p&gt;\n\t\t&lt;form class=&apos;where-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:Where_Used_Explorer&apos;&gt;\n\t\t\t&lt;div class=&apos;where-prompt-field&apos;&gt;\n\t\t\t\t&lt;label for=&apos;where_retry&apos;&gt;Try another Item Master ID&lt;/label&gt;\n\t\t\t\t&lt;input id=&apos;where_retry&apos; name=&apos;item_id&apos; type=&apos;number&apos; placeholder=&apos;Enter item_id&apos;&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Explore Usage&lt;/span&gt;\n\t\t\t&lt;/button&gt;\n\t\t&lt;/form&gt;\n\t&lt;/div&gt;\n&lt;% } else { %&gt;\n\t&lt;div class=&apos;where-root-card zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;where-root-grid&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Component APN&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=component_apn%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Description&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=component_desc%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Revision&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=component_revision%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Part Type&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=component_part_type%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Lifecycle&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=component_lifecycle%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;where-root-label&apos;&gt;Impact Rows&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;where-root-value&apos;&gt;&lt;%=direct_rows.size() + indirect_rows.size()%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;where-link-stack zcs-mt-12&apos;&gt;\n\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:All_Items?ID=&lt;%=component_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt; Open Component Item&lt;/a&gt;\n\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=component_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt; Open BOM Browser&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;% if(component_lifecycle in {&quot;Deprecated&quot;,&quot;Obsolete&quot;,&quot;Abandoned&quot;} &amp;&amp; active_impacted_count &gt; 0) { %&gt;\n\t\t&lt;div class=&apos;where-critical zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;&lt;strong&gt;Obsolete check:&lt;/strong&gt; this component lifecycle is &lt;%=component_lifecycle%&gt; and it is still present in &lt;%=active_impacted_count%&gt; active where-used path row(s). Review parent assemblies and change orders before release or procurement actions.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;% if(cycle_hit == true || cap_hit == true) { %&gt;\n\t\t&lt;div class=&apos;where-warning zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;Traversal note: repeated branches were skipped to prevent cycles, or traversal stopped at the &lt;%=depth_cap%&gt;-level depth cap. Review BOM structure if expected ancestors are missing.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;div class=&apos;where-section&apos;&gt;\n\t\t&lt;div class=&apos;where-section-head&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;where-section-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Direct Assemblies&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;where-summary-note&apos;&gt;Rows: &lt;%=direct_rows.size()%&gt;. Source: BOM_Line where child_item equals selected item and is_struck is false.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Parent APN&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Parent Description&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Relationship&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Quantity&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Lifecycle Phase&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Change-Order Cue&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;6&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;% if(direct_rows.size() == 0) { %&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-empty zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;6&apos;&gt;No direct active BOM parents found for this component.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n&lt;% } else { %&gt;\n&lt;%\n\t\tfor each row_map in direct_rows\n\t\t{\n\t\t\trow_parent_id = row_map.get(&quot;parent_id&quot;);\n\t\t\trow_apn = ifnull(row_map.get(&quot;parent_apn&quot;),&quot;-&quot;);\n\t\t\trow_desc = ifnull(row_map.get(&quot;parent_description&quot;),&quot;-&quot;);\n\t\t\trow_relationship = ifnull(row_map.get(&quot;relationship&quot;),&quot;Direct BOM parent&quot;);\n\t\t\trow_qty = ifnull(row_map.get(&quot;quantity&quot;),0);\n\t\t\trow_lifecycle = ifnull(row_map.get(&quot;lifecycle&quot;),&quot;Unknown&quot;);\n\t\t\tlife_display = row_lifecycle.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\t\tlife_class = &quot;zcs-badge-yellow&quot;;\n\t\t\tif(row_lifecycle == &quot;Production&quot;) { life_class = &quot;zcs-badge-green&quot;; } else if(row_lifecycle == &quot;Design&quot;) { life_class = &quot;zcs-badge-blue&quot;; } else if(row_lifecycle == &quot;Deprecated&quot;) { life_class = &quot;zcs-badge-orange&quot;; } else if(row_lifecycle == &quot;Obsolete&quot; || row_lifecycle == &quot;Abandoned&quot;) { life_class = &quot;zcs-badge-red&quot;; } else if(row_lifecycle == &quot;Unreleased&quot;) { life_class = &quot;zcs-badge-yellow&quot;; } else { life_class = &quot;zcs-badge-grey&quot;; }\n%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-apn zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;a href=&apos;#Report:All_Items?ID=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;%=row_apn%&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;where-link-stack&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;BOM&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-desc zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_desc%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-relationship zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_relationship%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_qty%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=life_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=life_display%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;where-cue&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-link-stack&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:All_Change_Orders?status=Open&apos; target=&apos;_self&apos;&gt;Open COs&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:Change_Order_Affected_Items?child_item=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;Affected rows&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-cue-text&apos;&gt;Review open change orders before changing or obsoleting this component.&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-query&apos;&gt;Suggested query: affected_items.child_item == &lt;%=row_parent_id%&gt; and status in Open, Submitted, Approval_In_Progress, Approved.&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n&lt;%  } %&gt;\n&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;where-section&apos;&gt;\n\t\t&lt;div class=&apos;where-section-head&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;where-section-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Indirect Assemblies&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;where-summary-note&apos;&gt;Rows: &lt;%=indirect_rows.size()%&gt;. Recursive upward traversal from direct parents with multiplicative path quantity. Depth cap: &lt;%=depth_cap%&gt;.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Parent APN&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Parent Description&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Relationship&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Path Quantity&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Lifecycle Phase&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Path&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Change-Order Cue&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;7&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;% if(indirect_rows.size() == 0) { %&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-empty zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;7&apos;&gt;No indirect parent assemblies found above the direct parents.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n&lt;% } else { %&gt;\n&lt;%\n\t\tfor each row_map in indirect_rows\n\t\t{\n\t\t\trow_parent_id = row_map.get(&quot;parent_id&quot;);\n\t\t\trow_apn = ifnull(row_map.get(&quot;parent_apn&quot;),&quot;-&quot;);\n\t\t\trow_desc = ifnull(row_map.get(&quot;parent_description&quot;),&quot;-&quot;);\n\t\t\trow_relationship = ifnull(row_map.get(&quot;relationship&quot;),&quot;Indirect ancestor&quot;);\n\t\t\trow_qty = ifnull(row_map.get(&quot;path_quantity&quot;),0);\n\t\t\trow_lifecycle = ifnull(row_map.get(&quot;lifecycle&quot;),&quot;Unknown&quot;);\n\t\t\trow_path = ifnull(row_map.get(&quot;path&quot;),&quot;-&quot;);\n\t\t\tlife_display = row_lifecycle.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\t\tlife_class = &quot;zcs-badge-yellow&quot;;\n\t\t\tif(row_lifecycle == &quot;Production&quot;) { life_class = &quot;zcs-badge-green&quot;; } else if(row_lifecycle == &quot;Design&quot;) { life_class = &quot;zcs-badge-blue&quot;; } else if(row_lifecycle == &quot;Deprecated&quot;) { life_class = &quot;zcs-badge-orange&quot;; } else if(row_lifecycle == &quot;Obsolete&quot; || row_lifecycle == &quot;Abandoned&quot;) { life_class = &quot;zcs-badge-red&quot;; } else if(row_lifecycle == &quot;Unreleased&quot;) { life_class = &quot;zcs-badge-yellow&quot;; } else { life_class = &quot;zcs-badge-grey&quot;; }\n%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-apn zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;a href=&apos;#Report:All_Items?ID=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;%=row_apn%&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;where-link-stack&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;BOM&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-desc zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_desc%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-relationship zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_relationship%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_qty%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=life_class%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=life_display%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;where-path zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=row_path%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;where-cue&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-link-stack&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:All_Change_Orders?status=Open&apos; target=&apos;_self&apos;&gt;Open COs&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&apos;where-mini-link&apos; href=&apos;#Report:Change_Order_Affected_Items?child_item=&lt;%=row_parent_id%&gt;&apos; target=&apos;_self&apos;&gt;Affected rows&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-cue-text&apos;&gt;Treat this ancestor as impacted through the displayed path quantity.&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;where-query&apos;&gt;Suggested query: affected_items.child_item == &lt;%=row_parent_id%&gt; and status in Open, Submitted, Approval_In_Progress, Approved.&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n&lt;%  } %&gt;\n&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Activity_Log_On_Load as "Activity Log - On Load"
			{
			    type = form
			    form = Activity_Log
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.changed_on == null)
			                {
			                    input.changed_on = zoho.currenttime;
			                }
			                disable log_id;
			                disable activity_record_type;
			                disable record_id;
			                disable field_changed;
			                disable old_value;
			                disable new_value;
			                disable changed_by_employee;
			                disable changed_on;
			            )
			        }
			    }
			}

			Activity_Log_On_Validate as "Activity Log - On Validate"
			{
			    type = form
			    form = Activity_Log
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_rec.count() == 0 || emp_rec.profile_label != "ADMIN")
			                {
			                    alert "Activity Log is system-managed and cannot be edited manually.";
			                    cancel submit;
			                }
			                if (input.log_id == null || input.log_id == "")
			                {
			                    input.log_id = thisapp.Generate_Record_Code("LOG-");
			                }
			                if (input.changed_on == null)
			                {
			                    input.changed_on = zoho.currenttime;
			                }
			            )
			        }
			    }
			}

			Approval_Matrix_Line_On_Validate as "Approval Matrix Line - On Validate"
			{
			    type = form
			    form = Approval_Matrix_Line
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.sequence_no,0) <= 0)
			                {
			                    alert "Sequence No must be greater than 0.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Approval_Matrix_Template_On_Validate as "Approval Matrix Template - On Validate"
			{
			    type = form
			    form = Approval_Matrix_Template
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.sequence_no,0) <= 0)
			                {
			                    alert "Sequence No must be greater than 0.";
			                    cancel submit;
			                }
			                if (input.is_default_finance_approver == true && input.approver != null)
			                {
			                    emp_rec = Employee_Master[ID == input.approver];
			                    if (emp_rec.count() > 0 && emp_rec.profile_label not in {"FINANCE_APPROVER","ADMIN"})
			                    {
			                        alert "Default finance approver should be an active FINANCE_APPROVER or ADMIN employee.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Approval_Remarks_On_Load as "Approval Remarks - On Load"
			{
			    type = form
			    form = Approval_Remarks
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                if (emp_id != 0 && input.action_by_employee == null)
			                {
			                    input.action_by_employee = emp_id;
			                }
			                if (input.action_date == null)
			                {
			                    input.action_date = zoho.currenttime;
			                }
			                disable remarks_id;
			                disable linked_change_order;
			                disable action_by_employee;
			                disable action_date;
			            )
			        }
			    }
			}

			Approval_Remarks_On_Success as "Approval Remarks - On Success"
			{
			    type = form
			    form = Approval_Remarks
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                co_rec = Change_Order[ID == input.linked_change_order];
			                if (co_rec.count() > 0)
			                {
			                    old_status = co_rec.status;
			                    if (input.action == "Comment")
			                    {
			                        thisapp.Write_Activity_Log("Change_Order", co_rec.order_id, "approval_comment", "", input.remarks, input.action_by_employee);
			                    }
			                    else
			                    {
			                        for each app_row in co_rec.approvers
			                        {
			                            if (app_row.approver == input.action_by_employee)
			                            {
			                                app_row.decision = input.action;
			                                app_row.decided_on = input.action_date;
			                            }
			                        }
			                        rejected_count = 0;
			                        pending_count = 0;
			                        for each status_row in co_rec.approvers
			                        {
			                            if (status_row.decision == "Rejected")
			                            {
			                                rejected_count = rejected_count + 1;
			                            }
			                            if (status_row.decision == "Pending")
			                            {
			                                pending_count = pending_count + 1;
			                            }
			                        }
			                        if (rejected_count > 0)
			                        {
			                            co_rec.status = "Rejected";
			                        }
			                        else if (pending_count == 0)
			                        {
			                            co_rec.status = "Approved";
			                        }
			                        else if (co_rec.status == "Rejected")
			                        {
			                            co_rec.status = "Approval_In_Progress";
			                        }
			                        merge_map = Map();
			                        merge_map.put("order_id", co_rec.order_id);
			                        merge_map.put("title", co_rec.title);
			                        merge_map.put("decision", input.action);
			                        creator_recipients = List();
			                        creator_recipients.add(co_rec.created_by_employee);
			                        if (input.action == "Rejected")
			                        {
			                            thisapp.Send_Template_Email("CHANGE_ORDER_REJECTED", creator_recipients, merge_map);
			                        }
			                        else if (co_rec.status == "Approved")
			                        {
			                            thisapp.Send_Template_Email("CHANGE_ORDER_APPROVED", creator_recipients, merge_map);
			                        }
			                        thisapp.Write_Activity_Log("Change_Order", co_rec.order_id, "approval_decision", old_status, co_rec.status, input.action_by_employee);
			                    }
			                }
			            )
			        }
			    }
			}

			Approval_Remarks_On_Validate as "Approval Remarks - On Validate"
			{
			    type = form
			    form = Approval_Remarks
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.remarks_id == null || input.remarks_id == "")
			                {
			                    input.remarks_id = thisapp.Generate_Record_Code("APR-");
			                }
			                if (input.action == "Rejected" && (input.remarks == null || input.remarks.trim() == ""))
			                {
			                    alert "Remarks are required when rejecting a Change Order.";
			                    cancel submit;
			                }
			                if (input.linked_change_order == null)
			                {
			                    alert "A linked Change Order is required.";
			                    cancel submit;
			                }
			                if (input.action_by_employee == null)
			                {
			                    alert "Action By Employee is required.";
			                    cancel submit;
			                }
			                emp_rec = Employee_Master[ID == input.action_by_employee];
			                co_rec = Change_Order[ID == input.linked_change_order];
			                if (co_rec.count() == 0)
			                {
			                    alert "Linked Change Order could not be found.";
			                    cancel submit;
			                }
			                if (emp_rec.count() == 0)
			                {
			                    alert "Action employee could not be found.";
			                    cancel submit;
			                }
			                if (input.action in {"Approved","Rejected"} && emp_rec.profile_label != "ADMIN")
			                {
			                    approver_match = false;
			                    for each app_row in co_rec.approvers
			                    {
			                        if (app_row.approver == input.action_by_employee)
			                        {
			                            approver_match = true;
			                        }
			                    }
			                    if (approver_match == false)
			                    {
			                        alert "Only listed approvers or Admin can record approval decisions.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			BOM_Line_On_Success as "BOM Line - On Success"
			{
			    type = form
			    form = BOM_Line
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.parent_item != null)
			                {
			                    thisapp.Write_Activity_Log("BOM_Line", input.ID.toString(), "bom_line", "", "Saved BOM line", null);
			                }
			            )
			        }
			    }
			}

			BOM_Line_On_Validate as "BOM Line - On Validate"
			{
			    type = form
			    form = BOM_Line
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.parent_item != null && input.child_item != null && input.parent_item == input.child_item)
			                {
			                    alert "A BOM line cannot reference the parent item as its own child.";
			                    cancel submit;
			                }
			                if (input.child_item != null)
			                {
			                    child_rec = Item_Master[ID == input.child_item];
			                    if (child_rec.count() > 0 && child_rec.lifecycle_phase == "Obsolete")
			                    {
			                        alert "Cannot add an Obsolete item to a BOM.";
			                        cancel submit;
			                    }
			                }
			                if (input.parent_item != null)
			                {
			                    parent_rec = Item_Master[ID == input.parent_item];
			                    if (parent_rec.count() > 0 && parent_rec.part_type != "Assembly")
			                    {
			                        alert "Only Assembly items can carry BOM lines.";
			                        cancel submit;
			                    }
			                }
			                config_rec = System_Config[is_active == true];
			                check_refdes = true;
			                if (config_rec.count() > 0)
			                {
			                    check_refdes = config_rec.reference_designator_check_enabled;
			                }
			                if (check_refdes == true && input.reference_designator != null && input.reference_designator.trim() != "")
			                {
			                    ref_list = input.reference_designator.toList(",");
			                    if (ref_list.size() != input.quantity.toLong())
			                    {
			                        alert "Reference designator count must match Quantity when checking is enabled.";
			                        cancel submit;
			                    }
			                    unique_refs = List();
			                    for each ref_val in ref_list
			                    {
			                        clean_ref = ref_val.trim();
			                        if (clean_ref in unique_refs)
			                        {
			                            alert "Duplicate reference designator detected: " + clean_ref;
			                            cancel submit;
			                        }
			                        unique_refs.add(clean_ref);
			                    }
			                }
			            )
			        }
			    }
			}

			BOM_Line_Child_Item_On_User_Input as "BOM Line - Child Item On User Input"
			{
			    type = form
			    form = BOM_Line
			    record event = on add or edit
			
			    on user input of child_item
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.child_item != null)
			                {
			                    child_rec = Item_Master[ID == input.child_item];
			                    if (child_rec.count() > 0)
			                    {
			                        if (child_rec.lifecycle_phase == "Obsolete")
			                        {
			                            alert "Cannot add an Obsolete item to a BOM.";
			                            input.child_item = null;
			                        }
			                        else if (child_rec.mfg_0 != null)
			                        {
			                            mfg_rec = Manufacturer_Master[ID == child_rec.mfg_0];
			                            if (mfg_rec.count() > 0 && mfg_rec.is_approved == true)
			                            {
			                                input.manufacturer_approval_status = "Approved";
			                            }
			                            else if (mfg_rec.count() > 0)
			                            {
			                                input.manufacturer_approval_status = "Unapproved";
			                            }
			                            else
			                            {
			                                input.manufacturer_approval_status = "Pending_Review";
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Change_Category_On_User_Input as "Change Order - Change Category On User Input"
			{
			    type = form
			    form = Change_Order
			    record event = on add or edit
			
			    on user input of change_category
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.status == null || input.status == "" || input.status == "Open")
			                {
			                    input.approvers.clear();
			                    category_key = "ECO";
			                    if (input.change_category == "Manufacturing_MCO")
			                    {
			                        category_key = "MCO";
			                    }
			                    else if (input.change_category == "Process_PCO")
			                    {
			                        category_key = "PCO";
			                    }
			                    else if (input.change_category == "Deviation")
			                    {
			                        category_key = "Deviation";
			                    }
			                    for each route_line in Approval_Matrix_Template[change_category == category_key && is_active == true] sort by sequence_no
			                    {
			                        app_row = Change_Order.approvers();
			                        app_row.approver = route_line.approver;
			                        app_row.sequence_no = route_line.sequence_no;
			                        app_row.decision = "Pending";
			                        app_row.added_by_cost_rule = false;
			                        input.approvers.insert(app_row);
			                    }
			                }
			            )
			        }
			    }
			}

			Change_Order_On_Load as "Change Order - On Load"
			{
			    type = form
			    form = Change_Order
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                if (emp_id != 0 && input.created_by_employee == null)
			                {
			                    input.created_by_employee = emp_id;
			                }
			                if (input.created_date == null)
			                {
			                    input.created_date = zoho.currenttime;
			                }
			                if (input.status == null || input.status == "")
			                {
			                    input.status = "Open";
			                }
			                if (input.units_consumed == null)
			                {
			                    input.units_consumed = 0;
			                }
			                disable order_id;
			                disable created_by_employee;
			                disable created_date;
			                disable status;
			                disable units_consumed;
			                disable unit_cap_warning_shown;
			                disable release_error_flag;
			                disable release_error_details;
			                disable release_last_attempt_on;
			                if (input.effectivity_type == "Permanent_Scheduled")
			                {
			                    show effective_date;
			                    hide expiration_date;
			                    hide max_unit_count;
			                    hide alternative_component;
			                }
			                else if (input.effectivity_type == "Temporary_Deviation")
			                {
			                    hide effective_date;
			                    show expiration_date;
			                    show max_unit_count;
			                    show alternative_component;
			                }
			                else
			                {
			                    hide effective_date;
			                    hide expiration_date;
			                    hide max_unit_count;
			                    hide alternative_component;
			                }
			                if (input.status != "Open")
			                {
			                    disable change_category;
			                }
			                else
			                {
			                    enable change_category;
			                }
			            )
			        }
			    }
			}

			Change_Order_On_Success as "Change Order - On Success"
			{
			    type = form
			    form = Change_Order
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.status == "Open")
			                {
			                    old_status = input.status;
			                    input.status = "Approval_In_Progress";
			                    first_seq = 999999;
			                    first_approvers = List();
			                    for each app_row in input.approvers
			                    {
			                        if (app_row.decision == "Pending" && ifnull(app_row.sequence_no,0) < first_seq)
			                        {
			                            first_seq = app_row.sequence_no;
			                        }
			                    }
			                    for each notify_row in input.approvers
			                    {
			                        if (notify_row.decision == "Pending" && notify_row.sequence_no == first_seq)
			                        {
			                            first_approvers.add(notify_row.approver);
			                        }
			                    }
			                    merge_map = Map();
			                    merge_map.put("order_id", input.order_id);
			                    merge_map.put("title", input.title);
			                    thisapp.Send_Template_Email("CHANGE_ORDER_APPROVAL_PENDING", first_approvers, merge_map);
			                    thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Approval_In_Progress", input.created_by_employee);
			                    if (input.source_request != null)
			                    {
			                        source_rec = Change_Request[ID == input.source_request];
			                        if (source_rec.count() > 0)
			                        {
			                            source_rec.status = "Converted_to_Order";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Change_Order_On_Validate as "Change Order - On Validate"
			{
			    type = form
			    form = Change_Order
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.order_id == null || input.order_id == "")
			                {
			                    prefix_val = "ECO-";
			                    if (input.change_category == "Manufacturing_MCO")
			                    {
			                        prefix_val = "MCO-";
			                    }
			                    else if (input.change_category == "Process_PCO")
			                    {
			                        prefix_val = "PCO-";
			                    }
			                    else if (input.change_category == "Deviation")
			                    {
			                        prefix_val = "DEV-";
			                    }
			                    input.order_id = thisapp.Generate_Record_Code(prefix_val);
			                }
			                active_config = System_Config[is_active == true] sort by Added_Time desc;
			                if (active_config.count() == 0 || active_config.finance_approval_threshold_inr == null)
			                {
			                    alert "Active system configuration with finance approval threshold is required before submitting a Change Order.";
			                    cancel submit;
			                }
			                if (input.affected_items == null || input.affected_items.isEmpty())
			                {
			                    alert "At least one affected item is required.";
			                    cancel submit;
			                }
			                if (input.approvers == null || input.approvers.isEmpty())
			                {
			                    alert "At least one approver is required.";
			                    cancel submit;
			                }
			                if (input.effectivity_type == "Temporary_Deviation")
			                {
			                    if (input.expiration_date == null)
			                    {
			                        alert "Expiration Date is required for temporary deviations.";
			                        cancel submit;
			                    }
			                    if (ifnull(input.max_unit_count,0) <= 0)
			                    {
			                        alert "Max Unit Count must be greater than 0 for temporary deviations.";
			                        cancel submit;
			                    }
			                }
			                if (input.change_category == "Deviation")
			                {
			                    for each affected_row in input.affected_items
			                    {
			                        if (affected_row.child_item != null)
			                        {
			                            item_rec = Item_Master[ID == affected_row.child_item];
			                            if (item_rec.count() > 0 && item_rec.lifecycle_phase not in {"Design","Production"})
			                            {
			                                alert "Deviation affected items must be in Design or Production lifecycle phase.";
			                                cancel submit;
			                            }
			                        }
			                    }
			                }
			                if (active_config.count() > 0 && ifnull(input.estimated_cost_impact,0) >= ifnull(active_config.finance_approval_threshold_inr,0))
			                {
			                    finance_exists = false;
			                    max_seq = 0;
			                    for each existing_app in input.approvers
			                    {
			                        if (ifnull(existing_app.sequence_no,0) > max_seq)
			                        {
			                            max_seq = existing_app.sequence_no;
			                        }
			                        if (existing_app.added_by_cost_rule == true)
			                        {
			                            finance_exists = true;
			                        }
			                    }
			                    if (finance_exists == false)
			                    {
			                        finance_route = Approval_Matrix_Template[is_default_finance_approver == true && is_active == true] sort by sequence_no;
			                        if (finance_route.count() == 0)
			                        {
			                            alert "Finance approval threshold is met, but no active default finance approver is configured.";
			                            cancel submit;
			                        }
			                        for each finance_line in finance_route
			                        {
			                            max_seq = max_seq + 1;
			                            finance_row = Change_Order.approvers();
			                            finance_row.approver = finance_line.approver;
			                            finance_row.sequence_no = max_seq;
			                            finance_row.decision = "Pending";
			                            finance_row.added_by_cost_rule = true;
			                            input.approvers.insert(finance_row);
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Effectivity_Type_On_User_Input as "Change Order - Effectivity Type On User Input"
			{
			    type = form
			    form = Change_Order
			    record event = on add or edit
			
			    on user input of effectivity_type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.effectivity_type == "Permanent_Scheduled")
			                {
			                    show effective_date;
			                    hide expiration_date;
			                    hide max_unit_count;
			                    hide alternative_component;
			                    input.expiration_date = null;
			                    input.max_unit_count = null;
			                    input.alternative_component = null;
			                }
			                else if (input.effectivity_type == "Temporary_Deviation")
			                {
			                    hide effective_date;
			                    show expiration_date;
			                    show max_unit_count;
			                    show alternative_component;
			                    input.effective_date = null;
			                }
			                else
			                {
			                    hide effective_date;
			                    hide expiration_date;
			                    hide max_unit_count;
			                    hide alternative_component;
			                    input.effective_date = null;
			                    input.expiration_date = null;
			                    input.max_unit_count = null;
			                    input.alternative_component = null;
			                }
			            )
			        }
			    }
			}

