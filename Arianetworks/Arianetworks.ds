		}
	
		report All_Open_NIRs
		{
		quickview(layout(type=-1 datablock1(layout type=-1 fields(nir_id category status raised_by_employee request_datetime "Approve" "Route to Library Review" "Reject"))) menu(header(Edit Duplicate Delete) record(Edit Duplicate Delete)) action(on tap(View Record) on long press(Edit Delete Duplicate View Record) on left swipe(Delete) on right swipe(Edit)))
