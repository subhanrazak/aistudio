			Deviation_Consumption_Entry_On_Load as "Deviation Consumption Entry - On Load"
			{
			    type = form
			    form = Deviation_Consumption_Entry
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                if (emp_id != 0 && input.recorded_by_employee == null)
			                {
			                    input.recorded_by_employee = emp_id;
			                }
			                if (input.recorded_on == null)
			                {
			                    input.recorded_on = zoho.currenttime;
			                }
			                disable recorded_by_employee;
			                disable recorded_on;
			            )
			        }
			    }
			}

			Deviation_Consumption_Entry_On_Success as "Deviation Consumption Entry - On Success"
			{
			    type = form
			    form = Deviation_Consumption_Entry
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                dev_rec = Change_Order[ID == input.linked_deviation];
			                if (dev_rec.count() > 0)
			                {
			                    total_units = 0;
			                    for each cons_rec in Deviation_Consumption_Entry[linked_deviation == input.linked_deviation]
			                    {
			                        total_units = total_units + ifnull(cons_rec.units_built_this_batch,0);
			                    }
			                    dev_rec.units_consumed = total_units;
			                    thisapp.Enforce_Deviation_Unit_Cap(dev_rec.ID);
			                    thisapp.Write_Activity_Log("Deviation_Consumption_Entry", dev_rec.order_id, "units_consumed", "", total_units.toString(), input.recorded_by_employee);
			                }
			            )
			        }
			    }
			}

			Deviation_Consumption_Entry_On_Validate as "Deviation Consumption Entry - On Validate"
			{
			    type = form
			    form = Deviation_Consumption_Entry
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.units_built_this_batch,0) <= 0)
			                {
			                    alert "Units Built This Batch must be at least 1.";
			                    cancel submit;
			                }
			                dev_rec = Change_Order[ID == input.linked_deviation];
			                if (dev_rec.count() == 0 || dev_rec.change_category != "Deviation" || dev_rec.status != "Effective")
			                {
			                    alert "Consumption can only be recorded against an effective deviation.";
			                    cancel submit;
			                }
			                if (dev_rec.max_unit_count == null || ifnull(dev_rec.max_unit_count,0) <= 0)
			                {
			                    alert "The linked deviation has no unit cap. Consumption cannot be recorded without a cap.";
			                    cancel submit;
			                }
			                remaining_units = ifnull(dev_rec.max_unit_count,0) - ifnull(dev_rec.units_consumed,0);
			                if (input.units_built_this_batch > remaining_units)
			                {
			                    alert "This batch exceeds the deviation cap. Remaining units: " + remaining_units + ", requested batch units: " + input.units_built_this_batch + ".";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			ECN_Acknowledgment_On_Load as "ECN Acknowledgment - On Load"
			{
			    type = form
			    form = ECN_Acknowledgment
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                if (emp_id != 0 && input.recipient_employee == null)
			                {
			                    input.recipient_employee = emp_id;
			                }
			                if (input.status == null || input.status == "")
			                {
			                    input.status = "Pending";
			                }
			                disable ack_id;
			                disable change_order;
			                disable recipient_employee;
			                disable acknowledged_on;
			                disable status;
			            )
			        }
			    }
			}

			ECN_Acknowledgment_On_Success as "ECN Acknowledgment - On Success"
			{
			    type = form
			    form = ECN_Acknowledgment
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_id != 0 && (emp_id == input.recipient_employee || (emp_rec.count() > 0 && emp_rec.profile_label == "ADMIN")))
			                {
			                    input.acknowledged_on = zoho.currenttime;
			                    input.status = "Acknowledged";
			                    co_rec = Change_Order[ID == input.change_order];
			                    if (co_rec.count() > 0)
			                    {
			                        thisapp.Write_Activity_Log("ECN_Acknowledgment", co_rec.order_id, "acknowledgment", "Pending", "Acknowledged", input.recipient_employee);
			                    }
			                }
			            )
			        }
			    }
			}

			ECN_Acknowledgment_On_Validate as "ECN Acknowledgment - On Validate"
			{
			    type = form
			    form = ECN_Acknowledgment
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.ack_id == null || input.ack_id == "")
			                {
			                    input.ack_id = thisapp.Generate_Record_Code("ACK-");
			                }
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_id == 0)
			                {
			                    alert "Logged-in employee record is required to acknowledge ECNs.";
			                    cancel submit;
			                }
			                if (emp_id != input.recipient_employee && (emp_rec.count() == 0 || emp_rec.profile_label != "ADMIN"))
			                {
			                    alert "Only the assigned recipient or Admin can submit this acknowledgment.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Item_Master_On_Load as "Item Master - On Load"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide variant_of;
			                hide variant_code;
			                if (input.is_variant == true)
			                {
			                    show variant_of;
			                    show variant_code;
			                }
			                hide bom_lines;
			                if (input.part_type == "Assembly")
			                {
			                    show bom_lines;
			                }
			                disable apn;
			                disable part_status;
			                disable lifecycle_phase;
			                disable revision;
			                disable is_deviated;
			                disable is_deleted;
			                disable deleted_on;
			                disable deleted_by_employee;
			                if (input.lifecycle_phase == "Deprecated")
			                {
			                    alert "This item is deprecated, use with caution.";
			                }
			                if (input.lifecycle_phase == "Obsolete")
			                {
			                    alert "Obsolete, cannot be added to new BOMs.";
			                }
			                if (input.lifecycle_phase == "Abandoned")
			                {
			                    alert "Abandoned, use Recover to reinstate this item.";
			                }
			                if (input.is_deviated == true)
			                {
			                    alert "This item is currently under an active deviation.";
			                }
			                if (input.is_deleted == true)
			                {
			                    alert "This item is soft-deleted and hidden from normal reports.";
			                }
			            )
			        }
			    }
			}

			Item_Master_On_Success as "Item Master - On Success"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.bom_lines != null)
			                {
			                    for each row_rec in input.bom_lines
			                    {
			                        row_rec.parent_item = input.ID;
			                    }
			                }
			                thisapp.Write_Activity_Log("Item_Master", input.apn, "item_saved", "", input.lifecycle_phase, input.owner_employee);
			            )
			        }
			    }
			}

			Item_Master_On_Validate as "Item Master - On Validate"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.owner_employee == null)
			                {
			                    emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                    if (emp_id != 0)
			                    {
			                        input.owner_employee = emp_id;
			                    }
			                }
			                if (input.lifecycle_phase == null || input.lifecycle_phase == "")
			                {
			                    input.lifecycle_phase = "Unreleased";
			                }
			                if (input.part_status == null || input.part_status == "")
			                {
			                    input.part_status = "In_Work";
			                }
			                if (input.revision == null || input.revision == "")
			                {
			                    input.revision = "-";
			                }
			                if (input.created_date == null)
			                {
			                    input.created_date = zoho.currenttime;
			                }
			                if (input.apn == null || input.apn == "")
			                {
			                    if (input.nir_source == null)
			                    {
			                        input.apn = thisapp.Generate_APN(input.category);
			                    }
			                }
			                if (input.is_variant == true)
			                {
			                    if (input.variant_of == null)
			                    {
			                        alert "Variant Of is required when Is Variant is selected.";
			                        cancel submit;
			                    }
			                    base_item = Item_Master[ID == input.variant_of];
			                    if (base_item.count() > 0 && base_item.is_variant == true)
			                    {
			                        alert "Nested variants are not allowed.";
			                        cancel submit;
			                    }
			                }
			                has_bom_lines = false;
			                if (input.bom_lines != null)
			                {
			                    for each bom_row in input.bom_lines
			                    {
			                        has_bom_lines = true;
			                    }
			                }
			                if (input.part_type != "Assembly" && has_bom_lines == true)
			                {
			                    alert "Only Assembly items can carry BOM lines.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Item_Master_Category_On_User_Input as "Item Master - Category On User Input"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on user input of category
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.category != null)
			                {
			                    cat_rec = Category_Master[ID == input.category];
			                    if (cat_rec.count() > 0 && cat_rec.item_group == "Assembly")
			                    {
			                        input.part_type = "Assembly";
			                        show bom_lines;
			                    }
			                }
			            )
			        }
			    }
			}

			Item_Master_Is_Variant_On_User_Input as "Item Master - Is Variant On User Input"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on user input of is_variant
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.is_variant == true)
			                {
			                    show variant_of;
			                    show variant_code;
			                }
			                else
			                {
			                    hide variant_of;
			                    hide variant_code;
			                    input.variant_of = null;
			                    input.variant_code = "";
			                }
			            )
			        }
			    }
			}

			Item_Master_Part_Type_On_User_Input as "Item Master - Part Type On User Input"
			{
			    type = form
			    form = Item_Master
			    record event = on add or edit
			
			    on user input of part_type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.part_type == "Assembly")
			                {
			                    show bom_lines;
			                }
			                else
			                {
			                    hide bom_lines;
			                }
			            )
			        }
			    }
			}

