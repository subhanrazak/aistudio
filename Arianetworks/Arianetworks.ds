application "Arianetworks"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Activity_Log
		{
		    displayname = "Activity Log"
		    Main
		    (
		        type = section
		        displayname = "Main"
		        row = 1
		        column = 0
		    )
		    unique log_id
		    (
		        type = text
		        displayname = "Log ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    activity_record_type
		    (
		        type = picklist
		        displayname = "Record Type"
		        values = {"Item_Master","Change_Request","Change_Order","Approval_Remarks","Item_Subscription","BOM_Line","ECN_Acknowledgment","Deviation_Consumption_Entry","New_Item_Request"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    record_id
		    (
		        type = text
		        displayname = "Record ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    field_changed
		    (
		        type = text
		        displayname = "Field Changed"
		        row = 1
		        column = 2
		        width = medium
		    )
		    old_value
		    (
		        type = text
		        displayname = "Old Value"
		        row = 1
		        column = 1
		        width = medium
		    )
		    new_value
		    (
		        type = text
		        displayname = "New Value"
		        row = 1
		        column = 2
		        width = medium
		    )
		    changed_by_employee
		    (
		        type = picklist
		        displayname = "Changed By Employee"
		        values = Employee_Master.ID
		        displayformat = [employee_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    changed_on
		    (
		        type = datetime
		        displayname = "Changed On"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Approval_Matrix_Line
		{
		    displayname = "Approval Matrix Line"
		    Approval_Routing
		    (
		        type = section
		        displayname = "Approval Routing"
		        row = 1
		        column = 0
		    )
		    must have approver
		    (
		        type = picklist
		        displayname = "Approver"
		        values = Employee_Master[is_active == true].ID
		        displayformat = [employee_name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have sequence_no
		    (
		        type = number
		        displayname = "Sequence No"
		        row = 1
		        column = 2
		        width = medium
		    )
		    decision
		    (
		        type = picklist
		        displayname = "Decision"
		        values = {"Pending","Approved","Rejected"}
		        initial value = "Pending"
		        row = 1
		        column = 1
		        width = medium
		    )
		    decided_on
		    (
		        type = datetime
		        displayname = "Decided On"
		        row = 1
		        column = 2
		        width = medium
		    )
		    added_by_cost_rule
		    (
		        type = checkbox
		        displayname = "Added By Cost Rule"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Approval_Matrix_Template
		{
		    displayname = "Approval Matrix Template"
		    Approval_Routing
		    (
		        type = section
		        displayname = "Approval Routing"
		        row = 1
		        column = 0
		    )
		    must have change_category
		    (
		        type = picklist
		        displayname = "Change Category"
		        values = {"ECR","ECO","MCR","MCO","PCO","Deviation"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have approver
		    (
		        type = picklist
		        displayname = "Approver"
		        values = Employee_Master[is_active == true].ID
		        displayformat = [employee_name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have sequence_no
		    (
		        type = number
		        displayname = "Sequence No"
		        row = 1
		        column = 1
		        width = medium
		    )
		    is_default_finance_approver
		    (
		        type = checkbox
		        displayname = "Default Finance Approver"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    is_active
		    (
		        type = checkbox
		        displayname = "Is Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Approval_Remarks
		{
		    displayname = "Approval Remarks"
		    Main
		    (
		        type = section
		        displayname = "Main"
		        row = 1
		        column = 0
		    )
		    unique remarks_id
		    (
		        type = text
		        displayname = "Remarks ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have linked_change_order
		    (
		        type = picklist
		        displayname = "Linked Change Order"
		        values = Change_Order.ID
		        displayformat = [order_id]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have action
		    (
		        type = picklist
		        displayname = "Action"
		        values = {"Approved","Rejected","Comment"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have action_by_employee
		    (
		        type = picklist
		        displayname = "Action By Employee"
		        values = Employee_Master[is_active == true].ID
		        displayformat = [employee_name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    action_date
		    (
		        type = datetime
		        displayname = "Action Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 140px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form BOM_Line
		{
		    displayname = "BOM Line"
		    BOM_Line_Details
		    (
		        type = section
		        displayname = "BOM Line Details"
		        row = 1
		        column = 0
		    )
		    parent_item
		    (
		        type = picklist
		        displayname = "Parent Item"
		        values = Item_Master.ID
		        displayformat = [apn]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    line_number
		    (
		        type = number
		        displayname = "Line Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have child_item
		    (
		        type = picklist
		        displayname = "Child Item"
		        values = Item_Master.ID
		        displayformat = [apn]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have quantity
		    (
		        type = decimal
		        displayname = "Quantity"
		        decimalplace = 3
		        row = 1
		        column = 2
		        width = medium
		    )
		    reference_designator
		    (
		        type = textarea
		        displayname = "Reference Designator"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    manufacturer_approval_status
		    (
		        type = picklist
		        displayname = "Manufacturer Approval Status"
		        values = {"Approved","Unapproved","Pending_Review"}
		        initial value = "Pending_Review"
		        row = 1
		        column = 2
		        width = medium
		    )
		    bom_notes
		    (
		        type = textarea
		        displayname = "BOM Notes"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		    is_struck
		    (
		        type = checkbox
		        displayname = "Is Struck"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    superseded_by
		    (
		        type = picklist
		        displayname = "Superseded By"
		        values = BOM_Line.ID
		        displayformat = [line_number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Category_Master
		{
		    displayname = "Category Master"
		    Category_Details
		    (
		        type = section
		        displayname = "Category Details"
		        row = 1
		        column = 0
		    )
		    must have unique category_name
		    (
		        type = text
		        displayname = "Category Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique prefix
		    (
		        type = text
		        displayname = "Prefix"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have item_group
		    (
		        type = picklist
		        displayname = "Item Group"
		        values = {"Electrical_Component","Mechanical_Component","Assembly","Document","Software_Firmware","Packaging"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have item_type
		    (
		        type = picklist
		        displayname = "Item Type"
		        values = {"Library_Component","Assembly_Component"}
		        initial value = "Library_Component"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have id_digit_length
		    (
		        type = number
		        displayname = "ID Digit Length"
		        initial value = 5
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have version_digit_length
		    (
		        type = number
		        displayname = "Version Digit Length"
		        initial value = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    last_issued_number
		    (
		        type = number
		        displayname = "Last Issued Number"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    is_active
		    (
		        type = checkbox
		        displayname = "Is Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Change_Order
		{
		    displayname = "Change Order"
		    Main
		    (
		        type = section
		        displayname = "Main"
		        row = 1
		        column = 0
		    )
		    unique order_id
		    (
		        type = text
		        displayname = "Order ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    source_request
		    (
		        type = picklist
		        displayname = "Source Request"
		        values = Change_Request.ID
		        displayformat = [request_id]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have change_category
		    (
		        type = picklist
		        displayname = "Change Category"
		        values = {"Engineering_ECO","Manufacturing_MCO","Process_PCO","Deviation"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have title
		    (
		        type = text
		        displayname = "Title"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    estimated_cost_impact
		    (
		        type = INR
		        displayname = "Estimated Cost Impact"
		        decimalplace = 2
		        maxchar = 16
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have effectivity_type
		    (
		        type = picklist
		        displayname = "Effectivity Type"
		        values = {"Permanent_Immediate","Permanent_Scheduled","Temporary_Deviation"}
		        initial value = "Permanent_Immediate"
		        row = 1
		        column = 1
		        width = medium
		    )
		    effective_date
		    (
		        type = date
		        displayname = "Effective Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    expiration_date
		    (
		        type = date
		        displayname = "Expiration Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    max_unit_count
		    (
		        type = number
		        displayname = "Max Unit Count"
		        row = 1
		        column = 2
		        width = medium
		    )
		    alternative_component
		    (
		        type = picklist
		        displayname = "Alternative Component"
		        values = Item_Master[is_deleted == false].ID
		        displayformat = [apn]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    units_consumed
		    (
		        type = number
		        displayname = "Units Consumed"
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Open","Submitted","Approval_In_Progress","Approved","Rejected","Effective","Complete","Cancelled","Expired"}
		        initial value = "Open"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have created_by_employee
		    (
		        type = picklist
		        displayname = "Created By Employee"
		        values = Employee_Master[is_active == true].ID
		        displayformat = [employee_name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    created_date
		    (
		        type = datetime
		        displayname = "Created Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    unit_cap_warning_shown
		    (
		        type = checkbox
		        displayname = "Unit Cap Warning Shown"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    release_error_flag
		    (
		        type = checkbox
		        displayname = "Release Error Flag"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    release_error_details
		    (
		        type = textarea
		        displayname = "Release Error Details"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    release_last_attempt_on
		    (
		        type = datetime
		        displayname = "Release Last Attempt On"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Affected_Items_Section
		    (
		        type = section
		        displayname = "Affected Items"
		        visibility = false
		        row = 2
		        column = 1
		    )
		    affected_items
		    (
		        type = grid
		        displayname = "Affected Items"
		        values = Change_Order_Affected_Item.ID
		        row = 2
		        column = 1
		        width = medium
		    )
		    Disposition_Section
		    (
		        type = section
		        displayname = "Disposition"
		        visibility = false
		        row = 3
		        column = 1
		    )
		    disposition
		    (
		        type = grid
		        displayname = "Disposition"
		        values = Change_Order_Disposition.ID
		        row = 3
		        column = 1
		        width = medium
		    )
		    Approvers_Section
		    (
		        type = section
		        displayname = "Approvers"
		        visibility = false
		        row = 4
		        column = 1
		    )
		    approvers
		    (
		        type = grid
		        displayname = "Approvers"
		        values = Approval_Matrix_Line.ID
		        sorttype = fieldbased
		        sort by
		        (
		            sequence_no ascending
		        )
		        row = 4
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Change_Order_Affected_Item
		{
		    displayname = "Change Order Affected Item"
		    Affected_Item_Details
		    (
		        type = section
		        displayname = "Affected Item Details"
		        row = 1
		        column = 0
		    )
		    must have child_item
		    (
		        type = picklist
		        displayname = "Child Item"
		        values = Item_Master[is_deleted == false].ID
		        displayformat = [apn]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    current_revision
		    (
		        type = text
		        displayname = "Current Revision"
		        row = 1
		        column = 2
		        width = medium
		    )
		    planned_revision_bump
		    (
		        type = checkbox
		        displayname = "Planned Revision Bump"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    target_lifecycle_phase
		    (
		        type = picklist
		        displayname = "Target Lifecycle Phase"
		        values = {"Design","Production","Deprecated","Obsolete"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    software_load_instruction
		    (
		        type = textarea
		        displayname = "Software Load Instruction"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Change_Order_Disposition
		{
		    displayname = "Change Order Disposition"
		    Disposition_Details
		    (
		        type = section
		        displayname = "Disposition Details"
		        row = 1
		        column = 0
		    )
		    affected_item
		    (
		        type = picklist
		        displayname = "Affected Item"
		        values = Item_Master[is_deleted == false].ID
		        displayformat = [apn]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    new_buys
		    (
		        type = picklist
		        displayname = "New Buys"
		        values = {"No_Action","Cancel_Open_POs","Modify_Spec","Pivot_to_New_Revision"}
		        initial value = "No_Action"
		        row = 1
		        column = 2
		        width = medium
		    )
		    wip
		    (
		        type = picklist
		        displayname = "WIP"
		        values = {"No_Action","Scrap","Rework_Mid_Line","Run_Out_to_Milestone"}
		        initial value = "No_Action"
		        row = 1
		        column = 1
		        width = medium
		    )
		    production_stock
		    (
		        type = picklist
		        displayname = "Production Stock"
		        values = {"No_Action","Purge_and_Scrap","Return_to_Vendor","Use_Up"}
		        initial value = "No_Action"
		        row = 1
		        column = 2
		        width = medium
		    )
		    fgi
		    (
		        type = picklist
		        displayname = "FGI"
		        values = {"No_Action","Hold","Rework","Downgrade"}
		        initial value = "No_Action"
		        row = 1
		        column = 1
		        width = medium
		    )
		    logistics
		    (
		        type = picklist
		        displayname = "Logistics"
		        values = {"No_Action","Hold_in_Transit","Redirect_to_Hub"}
		        initial value = "No_Action"
		        row = 1
		        column = 2
		        width = medium
		    )
		    spares_depot
		    (
		        type = picklist
		        displayname = "Spares Depot"
		        values = {"No_Action","Recall_Defective","Use_as_Spare"}
		        initial value = "No_Action"
		        row = 1
		        column = 1
		        width = medium
		    )
		    disposition_notes
		    (
		        type = textarea
		        displayname = "Disposition Notes"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
