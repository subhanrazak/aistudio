	reports
	{
		default list Audit_History
		{
		    displayName = "Audit History"
		    show all rows from Activity_Log
		    (
		        changed_on
		        (
		            displayformat = dateonly
		        )
		        activity_record_type
		        record_id
		        field_changed
		        old_value
		        new_value
		        changed_by_employee
		    )
		    filters
		    (
		        activity_record_type
		        record_id
		        changed_by_employee
		        changed_on
		    )
		    sort by
		    (
		        changed_on descending
		    )
		}

		default list Approval_Matrix_Line_List
		{
		    displayName = "Approval Matrix Line List"
		    show all rows from Approval_Matrix_Line
		    (
		        approver
		        sequence_no
		        decision
		        decided_on
		        (
		            displayformat = dateonly
		        )
		        added_by_cost_rule
		        (
		            displaytrue = "Cost Rule"
		            displayfalse = "Standard"
		        )
		    )
		    filters
		    (
		        approver
		        decision
		        added_by_cost_rule
		    )
		    sort by
		    (
		        sequence_no ascending
		    )
		}

		default list Approval_Matrix_Config
		{
		    displayName = "Approval Matrix Config"
		    show all rows from Approval_Matrix_Template
		    (
		        change_category
		        approver
		        sequence_no
		        is_default_finance_approver
		        (
		            displaytrue = "Finance Rule"
		            displayfalse = "Standard"
		        )
		        is_active
		        (
		            displaytrue = "Active"
		            displayfalse = "Inactive"
		        )
		    )
		    filters
		    (
		        change_category
		        is_default_finance_approver
		        is_active
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        change_category ascending
		    )
		    sort by
		    (
		        sequence_no ascending
		    )
		}

		default list Approval_Remarks_List
		{
		    displayName = "Approval Remarks List"
		    show all rows from Approval_Remarks
		    (
		        remarks_id
		        linked_change_order
		        action
		        action_by_employee
		        action_date
		        (
		            displayformat = dateonly
		        )
		        remarks
		        (
		            foldcontent = enable
		        )
		    )
		    filters
		    (
		        linked_change_order
		        action
		        action_by_employee
		    )
		    sort by
		    (
		        action_date descending
		    )
		}

		default list Where_Used
		{
		    displayName = "Where Used"
		    show all rows from BOM_Line
		    (
		        parent_item
		        child_item
		        line_number
		        quantity
		        (
		            display = total
		        )
		        reference_designator
		        manufacturer_approval_status
		        is_struck
		        (
		            displaytrue = "Struck"
		            displayfalse = "Active"
		        )
		    )
		    filters
		    (
		        child_item
		        parent_item
		        manufacturer_approval_status
		        is_struck
		    )
		    sort by
		    (
		        parent_item ascending
		        child_item ascending
		    )
		}

		default list Category_Master_List
		{
		    displayName = "Category Master List"
		    show all rows from Category_Master
		    (
		        category_name
		        prefix
		        item_group
		        item_type
		        id_digit_length
		        version_digit_length
		        last_issued_number
		        is_active
		        (
		            displaytrue = "Active"
		            displayfalse = "Inactive"
		        )
		    )
		    filters
		    (
		        item_group
		        item_type
		        is_active
		    )
		    sort by
		    (
		        category_name ascending
		    )
		}

		default list All_Change_Orders
		{
		    displayName = "All Change Orders"
		    show all rows from Change_Order
		    (
		        order_id
		        change_category
		        title
		        status
		        estimated_cost_impact
		        (
		            display = total
		        )
		        effectivity_type
		        expiration_date
		        units_consumed
		        release_error_flag
		        (
		            displaytrue = "Release Error"
		            displayfalse = "Clear"
		        )
		        created_by_employee
		        created_date
		        (
		            displayformat = dateonly
		        )
		        custom action "Withdraw"
		        (
		            workflow = Withdraw_Change_Order
		            show action for each record = true
		            column header = "Withdraw"
		            success message = "Change order withdrawn."
		            condition = (status == "Open" || status == "Submitted" || status == "Approval_In_Progress")
		            confirmation before execution
		            (
		                message for individual record = "Withdraw this change order?"
		                confirm button text = "Withdraw"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Force Approval"
		        (
		            workflow = Force_Approval
		            show action for each record = true
		            column header = "Force Approval"
		            success message = "Change order force-approved."
		            condition = (status == "Approval_In_Progress")
		        )
		        custom action "Release"
		        (
		            workflow = Release_Change_Order_Action
		            show action for each record = true
		            column header = "Release"
		            success message = "Release attempted. Check release status and error flags."
		            condition = (status == "Approved")
		        )
		        custom action "Re-open"
		        (
		            workflow = Reopen_Change_Order
		            show action for each record = true
		            column header = "Re-open"
		            success message = "Change order re-opened."
		            condition = (status == "Rejected")
		        )
		    )
		    filters
		    (
		        change_category
		        status
		        effectivity_type
		        created_by_employee
		        release_error_flag
		    )
		    sort by
		    (
		        created_date descending
		    )
		    conditional formatting
		    (
		        "Rejected"
		        {
		            condition = (status == "Rejected")
		            fields = [order_id, status, title]
		            format = "background-color:#FDE2E2;color:#991B1B;font-weight:bold"
		        }
		        "Expired"
		        {
		            condition = (status == "Expired")
		            fields = [order_id, status, expiration_date]
		            format = "background-color:#FFF3CD;color:#92400E;font-weight:bold"
		        }
		        "Cancelled"
		        {
		            condition = (status == "Cancelled")
		            fields = [order_id, status]
		            format = "background-color:#E5E7EB;color:#374151"
		        }
		        "Approved"
		        {
		            condition = (status == "Approved")
		            fields = [order_id, status]
		            format = "background-color:#DCFCE7;color:#166534;font-weight:bold"
		        }
		        "Effective"
		        {
		            condition = (status == "Effective")
		            fields = [order_id, status]
		            format = "background-color:#DBEAFE;color:#1D4ED8;font-weight:bold"
		        }
		        "Complete"
		        {
		            condition = (status == "Complete")
		            fields = [order_id, status]
		            format = "background-color:#ECFDF5;color:#047857"
		        }
		        "Release Error"
		        {
		            condition = (release_error_flag == true)
		            fields = [order_id, release_error_flag, status]
		            format = "background-color:#FEE2E2;color:#B91C1C;font-weight:bold"
		        }
		    )
		}

		kanban Change_Orders_By_Status
		{
		    displayName = "Change Orders By Status"
		    show all rows from Change_Order
		    (
		        order_id
		        change_category
		        title
		        status
		        effectivity_type
		        expiration_date
		        release_error_flag
		        created_by_employee
		        created_date
		    )
		    filters
		    (
		        change_category
		        status
		        effectivity_type
		        created_by_employee
		        release_error_flag
		    )
		    sort by
		    (
		        created_date descending
		    )
		    options
		    (
		        display field = status
		        othercolumn = "Other"
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		list My_Pending_Approvals
		{
		    displayName = "My Pending Approvals"
		    show all rows from Change_Order [status == "Approval_In_Progress"]
		    (
		        order_id
		        change_category
		        title
		        estimated_cost_impact
		        created_by_employee
		        created_date
		        (
		            displayformat = dateonly
		        )
		        custom action "Approve"
		        (
		            workflow = Approve_Change_Order
		            show action for each record = true
		            column header = "Approve"
		            success message = "Approval recorded."
		            condition = (status == "Approval_In_Progress")
		            confirmation before execution
		            (
		                message for individual record = "Approve this change order?"
		                confirm button text = "Approve"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Reject"
		        (
		            workflow = Reject_Change_Order
		            show action for each record = true
		            column header = "Reject"
		            success message = "Rejection recorded."
		            condition = (status == "Approval_In_Progress")
		            confirmation before execution
		            (
		                message for individual record = "Reject this change order?"
		                confirm button text = "Reject"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Comment"
		        (
		            workflow = Comment_Change_Order
		            show action for each record = true
		            column header = "Comment"
		            success message = "Opening approval remarks."
		            condition = (status == "Approval_In_Progress")
		        )
		    )
		    filters
		    (
		        change_category
		        created_by_employee
		    )
		    sort by
		    (
		        created_date ascending
		    )
		}

		calendar Open_Deviations_Calendar
		{
		    displayName = "Open Deviations Calendar"
		    show all rows from Change_Order [change_category == "Deviation" && status == "Effective"]
		    (
		        order_id
		        title
		        change_category
		        status
		        effectivity_type
		        expiration_date
		        created_by_employee
		    )
		    filters
		    (
		        status
		        effectivity_type
		        created_by_employee
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = order_id
		        start date = expiration_date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		    conditional formatting
		    (
		        "Expiring Soon"
		        {
		            condition = (expiration_date in next 7 days)
		            fields = [order_id, title, expiration_date]
		            format = "background-color:#FEE2E2;color:#B91C1C;font-weight:bold"
		        }
		    )
		}

