		{
					displayname = "BOM Bulk Remove"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Bulk_Remove_Planner' elementName='Bulk_Remove_Planner'>\n\t\t\t\t\t<![CDATA[htmlpage Bulk_Remove_Planner()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tbase = &quot;https://creatorapp.zoho.com/&quot; + zoho.adminuser + &quot;/&quot; + zoho.appname + &quot;/&quot;;\n\treportBase = base + &quot;report-embed/&quot;;\n\tpageBase = base + &quot;page-embed/&quot;;\n\tformBase = base + &quot;form-embed/&quot;;\n\n\treportChrome = &quot;?zc_Header=false&amp;amp;zc_Footer=true&amp;amp;zc_AddRec=false&amp;amp;zc_EditRec=false&amp;amp;zc_DelRec=false&amp;amp;zc_DuplRec=false&amp;amp;zc_Search=true&amp;amp;zc_ColMenu=true&amp;amp;zc_MoreAction=false&quot;;\n\tpageChrome = &quot;?zc_Header=false&amp;amp;zc_Footer=false&quot;;\n\tformChrome = &quot;?zc_Header=true&amp;amp;zc_Footer=true&quot;;\n\n\tallItemsUrl = reportBase + &quot;All_Items/&quot; + reportChrome;\n\twhereUsedUrl = reportBase + &quot;Where_Used/&quot; + reportChrome;\n\twhereExplorerUrl = pageBase + &quot;Where_Used_Explorer/&quot; + pageChrome;\n\tredlineUrl = pageBase + &quot;BOM_Redline_Viewer/&quot; + pageChrome;\n\tallChangeOrdersUrl = reportBase + &quot;All_Change_Orders/&quot; + reportChrome;\n\tchangeOrderFormUrl = formBase + &quot;Change_Order/&quot; + formChrome + &quot;&amp;amp;change_category=Engineering_ECO&amp;amp;title=Bulk%20BOM%20Remove%20Proposal&amp;amp;description=Bulk%20BOM%20removal%20proposal.%20Record%20selected%20child%20item%20IDs,%20affected%20parent%20assembly%20IDs,%20and%20BOM%20redline%20removal%20instructions.%20Released%20BOM%20changes%20apply%20only%20after%20approval%20and%20release.&amp;amp;effectivity_type=Permanent_Immediate&amp;amp;status=Open&quot;;\n\n\tallItemsShell = &quot;#Report:All_Items&quot;;\n\twhereUsedShell = &quot;#Report:Where_Used&quot;;\n\twhereExplorerShell = &quot;#Page:Where_Used_Explorer&quot;;\n\tredlineShell = &quot;#Page:BOM_Redline_Viewer&quot;;\n\tchangeOrderShell = &quot;#Form:Change_Order?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;change_category=Engineering_ECO&amp;amp;title=Bulk%20BOM%20Remove%20Proposal&amp;amp;description=Bulk%20BOM%20removal%20proposal.%20Record%20selected%20child%20item%20IDs,%20affected%20parent%20assembly%20IDs,%20and%20redline%20removal%20instructions.&amp;amp;effectivity_type=Permanent_Immediate&amp;amp;status=Open&quot;;\n\tallChangeOrdersShell = &quot;#Report:All_Change_Orders&quot;;\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for this page. Component classes are adapted from zcs-global, header-heading-with-actions, banner-outline-banner-with-icon, no-data-no-data-with-buttons, table-simple-table, and button-primary-button. */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.bom-bulk-remove * { box-sizing: border-box; }\n.bom-bulk-remove a { text-decoration: none; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-mt-6 { margin-top: 0.375rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mt-20 { margin-top: 1.25rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary, .zcs-color-teritiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n\n/* Button component */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all 0.2s linear; }\n.zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color); color: var(--zcs_brand_foreground_color); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-secondary-button { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs_light_grey_color); color: var(--zcs_primary_text_color); }\n.zcs-secondary-button:hover { border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); background-color: var(--zcs_component_hover_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* Header component */\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n.zcs-page-header .zcs-header-icon { color: var(--zcs_brand_color); font-size: 24px; }\n\n/* Banner component */\n.zcs-toast-link:hover { text-decoration: underline; }\n.zcs-outline-toast { border: 1px solid; }\n.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }\n.zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); }\n.zcs-warning-toast { background-color: #fef4e5; color: #663c01; border-color: #ed6c03; }\n.zcs-toast-icon { font-size: 18px; margin-top: 2px; }\n\n/* Table component */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 920px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 2; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n\n/* Page specific layout */\n.bom-bulk-remove { min-height: 100%; background: var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); padding: 20px; }\n.bbr-shell { display: grid; grid-template-columns: minmax(320px, 420px) minmax(0, 1fr); gap: 18px; align-items: start; margin-top: 18px; }\n.bbr-left, .bbr-right { display: flex; flex-direction: column; gap: 16px; }\n.bbr-card-title { display: flex; align-items: center; gap: 8px; }\n.bbr-card-title i { color: var(--zcs_brand_color); font-size: 18px; }\n.bbr-card-desc { color: var(--zcs-secondary-text-color); font-size: 13px; margin-top: 6px; }\n.bbr-step-list { display: grid; gap: 10px; margin-top: 14px; }\n.bbr-step { display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; padding: 12px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 10px; background: #FFFFFF; }\n.bbr-step i { color: var(--zcs_brand_color); font-size: 18px; margin-top: 2px; }\n.bbr-step strong { display: block; font-size: 14px; color: var(--zcs-primary-text-color); }\n.bbr-step span { display: block; font-size: 13px; color: var(--zcs-secondary-text-color); margin-top: 2px; }\n.bbr-form-grid { display: grid; gap: 10px; margin-top: 12px; }\n.bbr-field label { display: block; font-size: 12px; color: var(--zcs-secondary-text-color); margin-bottom: 4px; }\n.bbr-field input, .bbr-field textarea { width: 100%; min-height: 36px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 8px 10px; background: #FFFFFF; color: var(--zcs-primary-text-color); font-size: 14px; }\n.bbr-field textarea { min-height: 88px; resize: vertical; }\n.bbr-action-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }\n.bbr-mini-link { display: inline-flex; align-items: center; gap: 6px; color: var(--zcs_brand_color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 6px 10px; background: #FFFFFF; font-size: 13px; line-height: 1.2; }\n.bbr-mini-link:hover { border-color: var(--zcs_brand_color); background: var(--zcs_component_hover_color); }\n.bbr-preview-frame { width: 100%; min-height: 680px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; background: #FFFFFF; }\n.bbr-preview-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }\n.bbr-quick-links { display: flex; gap: 8px; flex-wrap: wrap; }\n.bbr-note { border-left: 3px solid var(--zcs_brand_color); background: var(--zcs_component_hover_color); border-radius: 8px; padding: 12px; font-size: 13px; color: var(--zcs-secondary-text-color); }\n.bbr-warning-note { border: 1px solid #ed6c03; background: #fef4e5; color: #663c01; }\n.bbr-empty { min-height: 220px; }\n.bbr-nodata-icon { color: var(--zcs_brand_color); font-size: 38px; display: block; margin-bottom: 12px; }\n.bbr-check { width: 16px; height: 16px; accent-color: var(--zcs_brand_color); }\n.bbr-status-pill { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #ed6c03; background: #fef4e5; color: #663c01; border-radius: 999px; padding: 3px 9px; white-space: nowrap; }\n.bbr-code { font-family: monospace; font-size: 12px; color: var(--zcs-primary-text-color); background: #F6F7FB; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 8px; overflow-wrap: anywhere; }\n@media (max-width: 1100px) {\n\t.bbr-shell { grid-template-columns: 1fr; }\n\t.bbr-preview-frame { min-height: 560px; }\n}\n@media (max-width: 576px) {\n\t.bom-bulk-remove { padding: 12px; }\n\t.zcs-page-header { padding: 16px; align-items: flex-start; flex-direction: column; }\n\t.zcs-page-header .zcs-button-text { display: none; }\n\t.bbr-action-row .zcs-button, .bbr-action-row .bbr-mini-link { width: 100%; justify-content: center; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;bom-bulk-remove&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-10 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-header-icon zc-li-outline ui-1-trash-simple&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;BOM Bulk Remove Planner&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-6&apos;&gt;Plan child-item removals as a Change Order proposal. This page does not directly delete or strike BOM lines.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=allChangeOrdersShell%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;All Change Orders&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=changeOrderShell%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open CO Form&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-16&apos;&gt;\n\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;&lt;strong&gt;Released BOMs require an approved Change Order.&lt;/strong&gt; Bulk removal is proposed by Change_Order redline instructions and planned removal flags. Actual BOM removal or strike status applies only after approval and release through controlled workflows.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;bbr-shell&apos;&gt;\n\t\t&lt;div class=&apos;bbr-left&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Workflow&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0&apos;&gt;Use the reports and pages below to gather child and parent IDs, then create or open a Change Order proposal. The page itself only reads and navigates.&lt;/p&gt;\n\t\t\t\t&lt;div class=&apos;bbr-step-list&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-step&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;strong&gt;1. Select child item candidates&lt;/strong&gt;&lt;span&gt;Search All Items, confirm item APN, lifecycle, revision, and Item Master ID.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-step&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;strong&gt;2. Inspect where-used results&lt;/strong&gt;&lt;span&gt;Open Where Used Explorer or the Where Used report for the child item. Select only the affected parent assemblies.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-step&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;strong&gt;3. Create a controlled proposal&lt;/strong&gt;&lt;span&gt;Use Propose_Bulk_Remove_Change_Order from a controlled action, or open Change_Order and paste the selected IDs and redline instructions.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-step&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;strong&gt;4. Release applies changes&lt;/strong&gt;&lt;span&gt;Review BOM_Redline_Viewer before release. Removal flags are effective only after approval and release.&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Search and selection controls&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0&apos;&gt;These controls update the preview pane only. They do not create, update, delete, or strike BOM records.&lt;/p&gt;\n\n\t\t\t\t&lt;form class=&apos;bbr-form-grid&apos; action=&apos;&lt;%=reportBase%&gt;All_Items/&apos; method=&apos;get&apos; target=&apos;bulkPlannerFrame&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Header&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Footer&apos; value=&apos;true&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_AddRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_EditRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_DelRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bbr_apn&apos;&gt;Child item APN or exact item field value&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bbr_apn&apos; name=&apos;apn&apos; type=&apos;text&apos; placeholder=&apos;Example: CAP-100-001&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Search All Items&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\n\t\t\t\t&lt;form class=&apos;bbr-form-grid zcs-mt-16&apos; action=&apos;&lt;%=pageBase%&gt;Where_Used_Explorer/&apos; method=&apos;get&apos; target=&apos;bulkPlannerFrame&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Header&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Footer&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bbr_item_id&apos;&gt;Child Item Master ID for upward BOM traversal&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bbr_item_id&apos; name=&apos;item_id&apos; type=&apos;number&apos; placeholder=&apos;Paste the Item Master ID&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Where Used Explorer&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\n\t\t\t\t&lt;form class=&apos;bbr-form-grid zcs-mt-16&apos; action=&apos;&lt;%=reportBase%&gt;Where_Used/&apos; method=&apos;get&apos; target=&apos;bulkPlannerFrame&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Header&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Footer&apos; value=&apos;true&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_AddRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_EditRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_DelRec&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bbr_child_item_lookup&apos;&gt;Where Used report child_item ID&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bbr_child_item_lookup&apos; name=&apos;child_item&apos; type=&apos;number&apos; placeholder=&apos;Paste the child Item Master ID&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Where Used Report&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Controlled proposal path&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0&apos;&gt;After confirming child and parent selections, create the Change Order proposal through an approved action or the Change_Order form.&lt;/p&gt;\n\t\t\t\t&lt;div class=&apos;bbr-note zcs-mt-12&apos;&gt;\n\t\t\t\t\tPreferred controlled function/action: &lt;span class=&apos;bbr-code&apos;&gt;thisapp.Propose_Bulk_Remove_Change_Order(child_item_ids, parent_item_ids)&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bbr-action-row&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=changeOrderFormUrl%&gt;&apos; target=&apos;bulkPlannerFrame&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open CO Form in Preview&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=changeOrderShell%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open CO Form Dialog&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;bbr-warning-note zcs-rounded-md zcs-p-16 zcs-mt-16 zcs-font-13&apos;&gt;\n\t\t\t\t\tDo not use report delete actions for released BOM removals. The proposal should carry the child item IDs, parent assembly IDs, reason, and redline instructions. Approval and release workflows perform the final mutation.\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;bbr-right&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-preview-toolbar&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Preview and evidence&lt;/h3&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-quick-links&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=allItemsUrl%&gt;&apos; target=&apos;bulkPlannerFrame&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt; All Items&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=whereUsedUrl%&gt;&apos; target=&apos;bulkPlannerFrame&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt; Where Used&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=allChangeOrdersUrl%&gt;&apos; target=&apos;bulkPlannerFrame&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt; Change Orders&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0 zcs-mt-8&apos;&gt;Use the preview to identify child item IDs, direct parent assembly IDs, and open Change Orders. Links below also open the app-shell pages and reports if a full-screen view is needed.&lt;/p&gt;\n\t\t\t\t&lt;iframe name=&apos;bulkPlannerFrame&apos; class=&apos;bbr-preview-frame zcs-mt-16&apos; src=&apos;&lt;%=allItemsUrl%&gt;&apos;&gt;&lt;/iframe&gt;\n\t\t\t\t&lt;div class=&apos;bbr-action-row&apos;&gt;\n\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=allItemsShell%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt; Open All_Items&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=whereUsedShell%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt; Open Where_Used&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=whereExplorerShell%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt; Open Where_Used_Explorer&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;bbr-mini-link&apos; href=&apos;&lt;%=redlineShell%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt; Open BOM_Redline_Viewer&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Local selection worksheet&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0&apos;&gt;This worksheet is a visual checklist only. It is intentionally not saved by the page. Transfer confirmed IDs into the controlled Change Order proposal.&lt;/p&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12&apos;&gt;\n\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Select&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Planning record&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;What to capture&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Proposal instruction&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Release status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;5&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;input class=&apos;bbr-check&apos; type=&apos;checkbox&apos;&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Child item candidate&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Item Master ID, APN, current revision, lifecycle phase.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Request removal of this child from selected parent assemblies by redline.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;span class=&apos;bbr-status-pill&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Pending CO&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;input class=&apos;bbr-check&apos; type=&apos;checkbox&apos;&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Affected parent assembly&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Parent Item Master ID, APN, BOM line number, current quantity.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Mark the matching BOM line as planned removal in the Change Order redline.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;span class=&apos;bbr-status-pill&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Pending CO&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;input class=&apos;bbr-check&apos; type=&apos;checkbox&apos;&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Indirect ancestor impact&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Where-used path, level, and cumulative path quantity.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&apos;&gt;Add review notes for assemblies affected through the selected direct parent.&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;span class=&apos;bbr-status-pill&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt; Pending CO&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 bbr-empty&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;bbr-nodata-icon zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No proposal selections are stored on this page&lt;/h5&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-teritiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;The planner starts empty by design. Search an item, inspect where-used results, then use the controlled Change Order process to persist the removal plan.&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-btn-wrapper zcs-row zcs-align-items-center zcs-justify-center zcs-gap-16 zcs-mt-20&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=whereExplorerShell%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Where Used Explorer&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=changeOrderShell%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Create Proposal&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;bbr-card-title&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Redline viewer shortcut&lt;/h3&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;bbr-card-desc zcs-m-0&apos;&gt;After a proposal exists, preview parent-specific removal redlines before approving or releasing.&lt;/p&gt;\n\t\t\t\t&lt;form class=&apos;bbr-form-grid zcs-mt-12&apos; action=&apos;&lt;%=pageBase%&gt;BOM_Redline_Viewer/&apos; method=&apos;get&apos; target=&apos;bulkPlannerFrame&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Header&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;zc_Footer&apos; value=&apos;false&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bbr_co_id&apos;&gt;Change Order ID&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bbr_co_id&apos; name=&apos;change_order_id&apos; type=&apos;number&apos; placeholder=&apos;Paste Change_Order ID&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bbr-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bbr_parent_id&apos;&gt;Parent Item Master ID&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bbr_parent_id&apos; name=&apos;parent_item_id&apos; type=&apos;number&apos; placeholder=&apos;Paste parent assembly ID&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Preview Redline&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page BOM_Compare(string item_ids)
		{
					displayname = "BOM Compare"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='BOM_Compare_Table' elementName='BOM_Compare_Table'>\n\t\t\t\t\t<![CDATA[htmlpage BOM_Compare_Table()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\traw_item_ids = &quot;&quot;;\n\thas_request = false;\n\tselected_items = List();\n\trequested_ids = List();\n\tinvalid_count = 0;\n\n\tif(input.item_ids != null)\n\t{\n\t\traw_item_ids = input.item_ids.trim();\n\t}\n\tif(raw_item_ids != &quot;&quot;)\n\t{\n\t\thas_request = true;\n\t\tid_tokens = raw_item_ids.toList(&quot;,&quot;);\n\t\tfor each raw_token in id_tokens\n\t\t{\n\t\t\ttoken_text = raw_token.trim();\n\t\t\tparsed_id = 0;\n\t\t\tif(token_text != &quot;&quot;)\n\t\t\t{\n\t\t\t\ttry\n\t\t\t\t{\n\t\t\t\t\tparsed_id = token_text.toLong();\n\t\t\t\t}\n\t\t\t\tcatch (parse_error)\n\t\t\t\t{\n\t\t\t\t\tparsed_id = 0;\n\t\t\t\t}\n\t\t\t\tif(parsed_id &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tif(parsed_id not in requested_ids)\n\t\t\t\t\t{\n\t\t\t\t\t\titem_rec = Item_Master[ID == parsed_id &amp;&amp; is_deleted == false];\n\t\t\t\t\t\tif(item_rec.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trequested_ids.add(parsed_id);\n\t\t\t\t\t\t\titem_map = Map();\n\t\t\t\t\t\t\titem_map.put(&quot;id&quot;,item_rec.ID);\n\t\t\t\t\t\t\titem_map.put(&quot;apn&quot;,ifnull(item_rec.apn,&quot;-&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;description&quot;,ifnull(item_rec.description,&quot;-&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;revision&quot;,ifnull(item_rec.revision,&quot;-&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;part_type&quot;,ifnull(item_rec.part_type,&quot;-&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;lifecycle&quot;,ifnull(item_rec.lifecycle_phase,&quot;-&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;variant_code&quot;,ifnull(item_rec.variant_code,&quot;&quot;));\n\t\t\t\t\t\t\titem_map.put(&quot;is_variant&quot;,ifnull(item_rec.is_variant,false));\n\t\t\t\t\t\t\tvariant_context = &quot;&quot;;\n\t\t\t\t\t\t\tvariant_code_text = ifnull(item_rec.variant_code,&quot;&quot;);\n\t\t\t\t\t\t\tif(variant_code_text != &quot;&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvariant_context = &quot;Variant code: &quot; + variant_code_text;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(item_rec.variant_of != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tvariant_base = Item_Master[ID == item_rec.variant_of &amp;&amp; is_deleted == false];\n\t\t\t\t\t\t\t\tif(variant_base.count() &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif(variant_context != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tvariant_context = variant_context + &quot; | &quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tvariant_context = variant_context + &quot;Variant of &quot; + ifnull(variant_base.apn,&quot;Item &quot; + variant_base.ID);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\titem_map.put(&quot;variant_context&quot;,variant_context);\n\t\t\t\t\t\t\tselected_items.add(item_map);\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tinvalid_count = invalid_count + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tinvalid_count = invalid_count + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tready_to_compare = selected_items.size() &gt;= 2;\n\tdepth_cap = 10;\n\tglobal_apn_order = List();\n\tglobal_desc_map = Map();\n\tassembly_qty_maps = Map();\n\tassembly_line_counts = Map();\n\tassembly_direct_counts = Map();\n\tassembly_cap_map = Map();\n\ttotal_traversed = 0;\n\tcap_any = false;\n\tmatched_rows = 0;\n\tchanged_rows = 0;\n\tmissing_rows = 0;\n\tadded_rows = 0;\n\tdiff_rows = 0;\n\n\tif(ready_to_compare == true)\n\t{\n\t\tfor each asm_map in selected_items\n\t\t{\n\t\t\troot_id = asm_map.get(&quot;id&quot;);\n\t\t\tasm_key = root_id.toString();\n\t\t\tagg_order = List();\n\t\t\tagg_qty_map = Map();\n\t\t\tagg_desc_map = Map();\n\t\t\tfrontier_ids = List();\n\t\t\tfrontier_qtys = List();\n\t\t\tfrontier_depths = List();\n\t\t\tfrontier_paths = List();\n\t\t\tfrontier_ids.add(root_id);\n\t\t\tfrontier_qtys.add(1.0);\n\t\t\tfrontier_depths.add(0);\n\t\t\tfrontier_paths.add(&quot;,&quot; + root_id + &quot;,&quot;);\n\t\t\ttraversal_depth = 0;\n\t\t\tcap_hit = false;\n\t\t\ttraversed_lines = 0;\n\t\t\tdirect_line_count = BOM_Line[parent_item == root_id &amp;&amp; is_struck == false].count();\n\t\t\tdepth_steps = List();\n\t\t\tdepth_steps.add(1);\n\t\t\tdepth_steps.add(2);\n\t\t\tdepth_steps.add(3);\n\t\t\tdepth_steps.add(4);\n\t\t\tdepth_steps.add(5);\n\t\t\tdepth_steps.add(6);\n\t\t\tdepth_steps.add(7);\n\t\t\tdepth_steps.add(8);\n\t\t\tdepth_steps.add(9);\n\t\t\tdepth_steps.add(10);\n\n\t\t\tfor each depth_marker in depth_steps\n\t\t\t{\n\t\t\t\tif(frontier_ids.size() &gt; 0 &amp;&amp; traversal_depth &lt; depth_cap)\n\t\t\t\t{\n\t\t\t\t\tnext_ids = List();\n\t\t\t\t\tnext_qtys = List();\n\t\t\t\t\tnext_depths = List();\n\t\t\t\t\tnext_paths = List();\n\t\t\t\t\tfor each index fidx in frontier_ids\n\t\t\t\t\t{\n\t\t\t\t\t\tparent_id = frontier_ids.get(fidx);\n\t\t\t\t\t\tparent_qty = frontier_qtys.get(fidx);\n\t\t\t\t\t\tparent_depth = frontier_depths.get(fidx);\n\t\t\t\t\t\tparent_path = frontier_paths.get(fidx);\n\t\t\t\t\t\tfor each bom_line in BOM_Line[parent_item == parent_id &amp;&amp; is_struck == false]\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\ttraversed_lines = traversed_lines + 1;\n\t\t\t\t\t\t\tchild_id = bom_line.child_item;\n\t\t\t\t\t\t\tline_qty = ifnull(bom_line.quantity,0);\n\t\t\t\t\t\t\taccumulated_qty = parent_qty * line_qty;\n\t\t\t\t\t\t\tchild_depth = parent_depth + 1;\n\t\t\t\t\t\t\tchild_item = Item_Master[ID == child_id &amp;&amp; is_deleted == false];\n\t\t\t\t\t\t\tchild_apn = &quot;Missing item &quot; + child_id;\n\t\t\t\t\t\t\tchild_desc = &quot;The child lookup could not be resolved.&quot;;\n\t\t\t\t\t\t\tif(child_item.count() &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tchild_apn = ifnull(child_item.apn,&quot;Item &quot; + child_id);\n\t\t\t\t\t\t\t\tchild_desc = ifnull(child_item.description,&quot;-&quot;);\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\tif(agg_qty_map.get(child_apn) != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tagg_qty_map.put(child_apn,ifnull(agg_qty_map.get(child_apn),0) + accumulated_qty);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tagg_order.add(child_apn);\n\t\t\t\t\t\t\t\tagg_qty_map.put(child_apn,accumulated_qty);\n\t\t\t\t\t\t\t\tagg_desc_map.put(child_apn,child_desc);\n\t\t\t\t\t\t\t\tif(child_apn not in global_apn_order)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tglobal_apn_order.add(child_apn);\n\t\t\t\t\t\t\t\t\tglobal_desc_map.put(child_apn,child_desc);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\tchild_token = &quot;,&quot; + child_id + &quot;,&quot;;\n\t\t\t\t\t\t\tif(parent_path.contains(child_token))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcap_hit = true;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tchild_children = BOM_Line[parent_item == child_id &amp;&amp; is_struck == false].count();\n\t\t\t\t\t\t\t\tif(child_children &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif(child_depth &lt; depth_cap)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tnext_ids.add(child_id);\n\t\t\t\t\t\t\t\t\t\tnext_qtys.add(accumulated_qty);\n\t\t\t\t\t\t\t\t\t\tnext_depths.add(child_depth);\n\t\t\t\t\t\t\t\t\t\tnext_paths.add(parent_path + child_id + &quot;,&quot;);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcap_hit = true;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tfrontier_ids = next_ids;\n\t\t\t\t\tfrontier_qtys = next_qtys;\n\t\t\t\t\tfrontier_depths = next_depths;\n\t\t\t\t\tfrontier_paths = next_paths;\n\t\t\t\t\ttraversal_depth = traversal_depth + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\tassembly_qty_maps.put(asm_key,agg_qty_map);\n\t\t\tassembly_line_counts.put(asm_key,traversed_lines);\n\t\t\tassembly_direct_counts.put(asm_key,direct_line_count);\n\t\t\tassembly_cap_map.put(asm_key,cap_hit);\n\t\t\ttotal_traversed = total_traversed + traversed_lines;\n\t\t\tif(cap_hit == true)\n\t\t\t{\n\t\t\t\tcap_any = true;\n\t\t\t}\n\t\t}\n\n\t\tbase_asm = selected_items.get(0);\n\t\tbase_key = base_asm.get(&quot;id&quot;).toString();\n\t\tbase_qty_map = assembly_qty_maps.get(base_key);\n\t\tselected_count = selected_items.size();\n\t\tfor each apn_key in global_apn_order\n\t\t{\n\t\t\tbase_present = base_qty_map.get(apn_key) != null;\n\t\t\tbase_qty = ifnull(base_qty_map.get(apn_key),0);\n\t\t\tpresent_count = 0;\n\t\t\tmissing_count = 0;\n\t\t\trow_diff_count = 0;\n\t\t\tfor each index midx in selected_items\n\t\t\t{\n\t\t\t\tasm_for_count = selected_items.get(midx);\n\t\t\t\tqty_map_for_count = assembly_qty_maps.get(asm_for_count.get(&quot;id&quot;).toString());\n\t\t\t\tqty_value_for_count = qty_map_for_count.get(apn_key);\n\t\t\t\tif(qty_value_for_count == null)\n\t\t\t\t{\n\t\t\t\t\tmissing_count = missing_count + 1;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tpresent_count = present_count + 1;\n\t\t\t\t\tif(midx &gt; 0 &amp;&amp; base_present == true &amp;&amp; qty_value_for_count != base_qty)\n\t\t\t\t\t{\n\t\t\t\t\t\trow_diff_count = row_diff_count + 1;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(present_count == selected_count &amp;&amp; row_diff_count == 0)\n\t\t\t{\n\t\t\t\tmatched_rows = matched_rows + 1;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tchanged_rows = changed_rows + 1;\n\t\t\t\tif(base_present == false)\n\t\t\t\t{\n\t\t\t\t\tadded_rows = added_rows + 1;\n\t\t\t\t}\n\t\t\t\telse if(missing_count &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tmissing_rows = missing_rows + 1;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tdiff_rows = diff_rows + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used once for this page. */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-6 { margin-top: 0.375rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* ZCS component CSS: header-heading-with-actions and button styles. */\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* ZCS component CSS: table-simple-table. */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 980px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 2; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; white-space: nowrap; vertical-align: bottom; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs-border-color); }\n\n/* ZCS component CSS: badge-outlined-badge. */\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-outline { border: 1px solid; }\n.zcs-badge-outline.zcs-badge-theme { color: var(--zcs_brand_color); }\n.zcs-badge-outline.zcs-badge-green { color: #179E6C; }\n.zcs-badge-outline.zcs-badge-red { color: #FE455D; }\n.zcs-badge-outline.zcs-badge-grey { color: #242424; }\n.zcs-badge-outline.zcs-badge-yellow { color: #FAAE13; }\n.zcs-badge-outline.zcs-badge-blue { color: #2A6FFC; }\n.zcs-badge-outline.zcs-badge-orange { color: #F4660C; }\n\n/* ZCS component CSS: no-data-no-data-text-only. */\n.zcs-nodata-wrapper { min-height: 220px; }\n\n/* BOM Compare custom styling. */\n.bom-compare-page { background: var(--zcs-page-bg-color); padding: 20px; box-sizing: border-box; min-height: 100%; color: var(--zcs-primary-text-color); font-family: Arial, sans-serif; }\n.bom-title-block { min-width: 0; }\n.bom-header-icon { color: var(--zcs_brand_color); font-size: 24px; }\n.bom-page-note { max-width: 760px; }\n.bom-prompt { padding: 28px; text-align: center; }\n.bom-prompt i { display: block; color: var(--zcs_brand_color); font-size: 34px; margin-bottom: 10px; }\n.bom-prompt-form { display: flex; gap: 10px; justify-content: center; align-items: end; flex-wrap: wrap; margin-top: 16px; }\n.bom-prompt-field { text-align: left; }\n.bom-prompt-field label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 4px; }\n.bom-prompt-field input { min-height: 36px; min-width: 360px; border: 1px solid var(--zcs-border-color); border-radius: 6px; padding: 6px 10px; box-sizing: border-box; font-size: 14px; color: var(--zcs-primary-text-color); background: #FFFFFF; }\n.bom-context-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap: 12px; margin: 16px 0; }\n.bom-assembly-card { padding: 14px; }\n.bom-assembly-role { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 8px; }\n.bom-assembly-role i { color: var(--zcs_brand_color); }\n.bom-card-label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 3px; }\n.bom-card-value { color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; }\n.bom-card-desc { margin-top: 8px; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.bom-card-meta { margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; }\n.bom-summary-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(145px,1fr)); gap: 12px; margin: 0 0 16px 0; }\n.bom-kpi { padding: 14px; }\n.bom-kpi-label { color: var(--zcs-secondary-text-color); font-size: 12px; }\n.bom-kpi-value { color: var(--zcs-primary-text-color); font-size: 24px; font-weight: 700; line-height: 1.15; margin-top: 4px; }\n.bom-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0 12px 0; flex-wrap: wrap; }\n.bom-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.bom-warning { margin: 12px 0; padding: 12px 14px; border: 1px solid #FAAE13; border-radius: 8px; color: #8A5B00; background: #FCF4E6; }\n.bom-warning i { margin-right: 8px; color: #8A5B00; }\n.bom-desc { max-width: 420px; white-space: normal; }\n.bom-apn { white-space: nowrap; font-weight: 600; }\n.bom-qty { white-space: nowrap; font-variant-numeric: tabular-nums; }\n.bom-qty-cell { border-radius: 6px; padding: 5px 8px; display: inline-block; min-width: 52px; text-align: right; }\n.bom-qty-match { background: #E4FCF3; color: #179E6C; }\n.bom-qty-diff { background: #FCF4E6; color: #9D6700; font-weight: 700; }\n.bom-qty-missing { background: #FDE3E6; color: #FE455D; font-weight: 700; text-align: center; }\n.bom-qty-added { background: #E8EFFF; color: #2A6FFC; font-weight: 700; }\n.bom-th-sub { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; font-weight: 400; margin-top: 2px; }\n.bom-status-cell { min-width: 150px; }\n.bom-print-note { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 12px; }\n@media (max-width: 900px) {\n\t.bom-compare-page { padding: 12px; }\n\t.zcs-page-header { padding: 16px; align-items: flex-start; }\n\t.bom-prompt-field input { min-width: 260px; width: 100%; }\n}\n@media print {\n\t.bom-compare-page { background: #FFFFFF; padding: 0; color: #000000; }\n\t.zcs-page-header, .zcs-card, .zcs-table-wrapper { border: 0; box-shadow: none; }\n\t.bom-toolbar-actions, .bom-prompt-form { display: none; }\n\t.zcs-table-wrapper { overflow: visible; }\n\t.zcs-table-wrapper table { min-width: 0; width: 100%; font-size: 10px; }\n\t.zcs-table-wrapper table thead { position: static; display: table-header-group; }\n\t.zcs-table-wrapper table thead tr th, .zcs-table-wrapper table tbody tr td { padding: 5px 6px; border-color: #A0A0A0; }\n\t.zcs-table-wrapper table tbody tr { page-break-inside: avoid; }\n\t.zcs-badge, .bom-qty-cell { color: #000000 !important; background: #FFFFFF !important; border: 1px solid #777777 !important; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;bom-compare-page&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis bom-title-block&apos;&gt;\n\t\t\t&lt;i class=&apos;bom-header-icon zc-li-outline design-2-selection&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;BOM Compare&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;bom-page-note zcs-m-0 zcs-mt-6 zcs-font-14 zcs-color-secondary&apos;&gt;Compare two or more flattened BOMs side-by-side. The first selected item is treated as the base assembly.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;% if(ready_to_compare == true) { base_header = selected_items.get(0); base_header_id = base_header.get(&quot;id&quot;); %&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 bom-toolbar-actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=base_header_id%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Base BOM&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:BOM_Flatten_Page?item_id=&lt;%=base_header_id%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Flatten Base&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\t&lt;/div&gt;\n\n\t&lt;% if(ready_to_compare == false) { %&gt;\n\t\t&lt;div class=&apos;bom-prompt zcs-card zcs-mt-16&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Select at least two Item Master records&lt;/h3&gt;\n\t\t\t\t\t&lt;% if(has_request == true) { %&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Only &lt;%=selected_items.size()%&gt; valid active Item Master record(s) were resolved from the item_ids parameter. Invalid, duplicate, or deleted IDs are ignored.&lt;/p&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Pass comma-separated Item Master IDs. Put the base assembly first, followed by one or more variants or alternate assemblies.&lt;/p&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;form class=&apos;bom-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:BOM_Compare&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;bom-prompt-field&apos;&gt;\n\t\t\t\t\t\t\t&lt;label for=&apos;bom_compare_item_ids&apos;&gt;Item Master IDs&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;input id=&apos;bom_compare_item_ids&apos; name=&apos;item_ids&apos; type=&apos;text&apos; placeholder=&apos;Example: 123456789,123456790,123456791&apos;&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline design-2-selection&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Compare BOMs&lt;/span&gt;\n\t\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t\t&lt;/form&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-12 zcs-font-13 zcs-color-tertiary&apos;&gt;URL format: #Page:BOM_Compare?item_ids=BASE_ID,VARIANT_ID. Use IDs from the All Items report.&lt;/p&gt;\n\t\t\t\t\t&lt;% if(invalid_count &gt; 0) { %&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-13 zcs-color-tertiary&apos;&gt;Ignored invalid or unresolved token count: &lt;%=invalid_count%&gt;.&lt;/p&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } else { %&gt;\n\t\t&lt;div class=&apos;bom-context-grid&apos;&gt;\n\t\t\t&lt;%\n\t\t\t\tfor each index asm_index in selected_items\n\t\t\t\t{\n\t\t\t\t\tasm = selected_items.get(asm_index);\n\t\t\t\t\tasm_id = asm.get(&quot;id&quot;);\n\t\t\t\t\tasm_key = asm_id.toString();\n\t\t\t\t\tasm_apn = ifnull(asm.get(&quot;apn&quot;),&quot;-&quot;);\n\t\t\t\t\tasm_desc = ifnull(asm.get(&quot;description&quot;),&quot;-&quot;);\n\t\t\t\t\tasm_rev = ifnull(asm.get(&quot;revision&quot;),&quot;-&quot;);\n\t\t\t\t\tasm_lifecycle = ifnull(asm.get(&quot;lifecycle&quot;),&quot;-&quot;);\n\t\t\t\t\tasm_variant_context = ifnull(asm.get(&quot;variant_context&quot;),&quot;&quot;);\n\t\t\t\t\tasm_role = &quot;Variant &quot; + asm_index;\n\t\t\t\t\tif(asm_index == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tasm_role = &quot;Base&quot;;\n\t\t\t\t\t}\n\t\t\t\t\tdirect_count = ifnull(assembly_direct_counts.get(asm_key),0);\n\t\t\t\t\tline_count = ifnull(assembly_line_counts.get(asm_key),0);\n\t\t\t%&gt;\n\t\t\t\t&lt;div class=&apos;bom-assembly-card zcs-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bom-assembly-role zcs-font-13 zcs-font-semibold zcs-color-theme&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span&gt;&lt;%=asm_role%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&apos;bom-card-label&apos;&gt;APN&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&apos;bom-card-value&apos;&gt;&lt;%=asm_apn%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;div class=&apos;bom-card-desc&apos;&gt;&lt;%=asm_desc%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;bom-card-meta&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Rev &lt;%=asm_rev%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=asm_lifecycle%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=direct_count%&gt; direct&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=line_count%&gt; traversed&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% if(asm_variant_context != &quot;&quot;) { %&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-mt-8 zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=asm_variant_context%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;% } else if(asm_index &gt; 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-mt-8 zcs-font-13 zcs-color-secondary&apos;&gt;No variant_of or variant_code context on this item.&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;% if(cap_any == true) { %&gt;\n\t\t\t&lt;div class=&apos;bom-warning zcs-font-14&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline travel-info&apos;&gt;&lt;/i&gt;One or more BOM traversals hit the &lt;%=depth_cap%&gt;-level cap or skipped a repeated branch to prevent a cycle. Review nested assemblies if the comparison looks incomplete.\n\t\t\t&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;div class=&apos;bom-summary-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;bom-kpi zcs-card&apos;&gt;&lt;div class=&apos;bom-kpi-label&apos;&gt;Assemblies&lt;/div&gt;&lt;div class=&apos;bom-kpi-value&apos;&gt;&lt;%=selected_items.size()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-kpi zcs-card&apos;&gt;&lt;div class=&apos;bom-kpi-label&apos;&gt;Aligned APNs&lt;/div&gt;&lt;div class=&apos;bom-kpi-value&apos;&gt;&lt;%=global_apn_order.size()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-kpi zcs-card&apos;&gt;&lt;div class=&apos;bom-kpi-label&apos;&gt;Matched Rows&lt;/div&gt;&lt;div class=&apos;bom-kpi-value&apos;&gt;&lt;%=matched_rows%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-kpi zcs-card&apos;&gt;&lt;div class=&apos;bom-kpi-label&apos;&gt;Changed Rows&lt;/div&gt;&lt;div class=&apos;bom-kpi-value&apos;&gt;&lt;%=changed_rows%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-kpi zcs-card&apos;&gt;&lt;div class=&apos;bom-kpi-label&apos;&gt;BOM Lines Traversed&lt;/div&gt;&lt;div class=&apos;bom-kpi-value&apos;&gt;&lt;%=total_traversed%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;bom-toolbar&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary&apos;&gt;Flattened BOM Alignment&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Quantities are multiplicative across nested BOM levels and aggregated by child APN. Status compares each row to the first selected base item.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-toolbar-actions&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Items&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;All Items&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Component APN&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Description&lt;/th&gt;\n\t\t\t\t\t\t&lt;% for each index hidx in selected_items { h_asm = selected_items.get(hidx); h_apn = ifnull(h_asm.get(&quot;apn&quot;),&quot;-&quot;); h_label = &quot;Variant &quot; + hidx; if(hidx == 0) { h_label = &quot;Base&quot;; } %&gt;\n\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=h_label%&gt;&lt;span class=&apos;bom-th-sub&apos;&gt;&lt;%=h_apn%&gt;&lt;/span&gt;&lt;/th&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Delta Status&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;&lt;%=selected_items.size() + 3%&gt;&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;% if(global_apn_order.size() == 0) { %&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&apos;bom-prompt zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;&lt;%=selected_items.size() + 3%&gt;&apos;&gt;No active BOM_Line children were found under any selected item.&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;% } else { %&gt;\n\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\tfor each apn_key in global_apn_order\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trow_desc = ifnull(global_desc_map.get(apn_key),&quot;-&quot;);\n\t\t\t\t\t\t\t\tbase_present = base_qty_map.get(apn_key) != null;\n\t\t\t\t\t\t\t\tbase_qty = ifnull(base_qty_map.get(apn_key),0);\n\t\t\t\t\t\t\t\tpresent_count = 0;\n\t\t\t\t\t\t\t\tmissing_count = 0;\n\t\t\t\t\t\t\t\trow_diff_count = 0;\n\t\t\t\t\t\t\t\tfor each index sidx in selected_items\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcount_asm = selected_items.get(sidx);\n\t\t\t\t\t\t\t\t\tcount_qty_map = assembly_qty_maps.get(count_asm.get(&quot;id&quot;).toString());\n\t\t\t\t\t\t\t\t\tcount_qty = count_qty_map.get(apn_key);\n\t\t\t\t\t\t\t\t\tif(count_qty == null)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tmissing_count = missing_count + 1;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpresent_count = present_count + 1;\n\t\t\t\t\t\t\t\t\t\tif(sidx &gt; 0 &amp;&amp; base_present == true &amp;&amp; count_qty != base_qty)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\trow_diff_count = row_diff_count + 1;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tstatus_text = &quot;Matched&quot;;\n\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\tif(present_count == selected_items.size() &amp;&amp; row_diff_count == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tstatus_text = &quot;Matched&quot;;\n\t\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(base_present == false)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tstatus_text = &quot;Added vs base&quot;;\n\t\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(missing_count &gt; 0 &amp;&amp; row_diff_count &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tstatus_text = &quot;Missing and quantity differs&quot;;\n\t\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(missing_count &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tstatus_text = &quot;Missing in variant&quot;;\n\t\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tstatus_text = &quot;Quantity differs&quot;;\n\t\t\t\t\t\t\t\t\tstatus_class = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;bom-apn zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=apn_key%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;bom-desc zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_desc%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\tfor each index qidx in selected_items\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tq_asm = selected_items.get(qidx);\n\t\t\t\t\t\t\t\t\t\tq_qty_map = assembly_qty_maps.get(q_asm.get(&quot;id&quot;).toString());\n\t\t\t\t\t\t\t\t\t\tq_qty_value = q_qty_map.get(apn_key);\n\t\t\t\t\t\t\t\t\t\tqty_class = &quot;bom-qty-cell bom-qty-missing&quot;;\n\t\t\t\t\t\t\t\t\t\tqty_display = &quot;-&quot;;\n\t\t\t\t\t\t\t\t\t\tif(q_qty_value != null)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tqty_display = q_qty_value;\n\t\t\t\t\t\t\t\t\t\t\tif(qidx == 0)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tqty_class = &quot;bom-qty-cell bom-qty-match&quot;;\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse if(base_present == false)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tqty_class = &quot;bom-qty-cell bom-qty-added&quot;;\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse if(q_qty_value != base_qty)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tqty_class = &quot;bom-qty-cell bom-qty-diff&quot;;\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tqty_class = &quot;bom-qty-cell bom-qty-match&quot;;\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&apos;bom-qty zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;&lt;%=qty_class%&gt;&apos;&gt;&lt;%=qty_display%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;bom-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=status_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=status_text%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;p class=&apos;bom-print-note&apos;&gt;Print or export this page for an export-friendly side-by-side BOM comparison. Interactive navigation buttons are hidden in print media.&lt;/p&gt;\n\t&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page BOM_Flatten_Page(int item_id)
		{
					displayname = "BOM Flatten Page"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Flattened_BOM' elementName='Flattened_BOM'>\n\t\t\t\t\t<![CDATA[htmlpage Flattened_BOM()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\troot_item = Item_Master[ID == -1];\n\thas_request = false;\n\troot_found = false;\n\troot_id = 0;\n\troot_apn = &quot;-&quot;;\n\troot_desc = &quot;-&quot;;\n\troot_part_type = &quot;-&quot;;\n\troot_lifecycle = &quot;-&quot;;\n\troot_category = &quot;-&quot;;\n\tdirect_child_count = 0;\n\ttotal_line_count = 0;\n\taggregate_rows = List();\n\tdepth_cap = 8;\n\tcap_hit = false;\n\tnon_assembly_warning = false;\n\tmissing_root_message = &quot;&quot;;\n\n\tif(input.item_id != null &amp;&amp; input.item_id &gt; 0)\n\t{\n\t\thas_request = true;\n\t\troot_item = Item_Master[ID == input.item_id &amp;&amp; is_deleted == false];\n\t}\n\n\tif(root_item.count() &gt; 0)\n\t{\n\t\troot_found = true;\n\t\troot_id = root_item.ID;\n\t\troot_apn = ifnull(root_item.apn,&quot;-&quot;);\n\t\troot_desc = ifnull(root_item.description,&quot;-&quot;);\n\t\troot_part_type = ifnull(root_item.part_type,&quot;-&quot;);\n\t\troot_lifecycle = ifnull(root_item.lifecycle_phase,&quot;-&quot;);\n\t\troot_category = &quot;-&quot;;\n\t\tif(root_item.category != null)\n\t\t{\n\t\t\troot_cat_rec = Category_Master[ID == root_item.category];\n\t\t\tif(root_cat_rec.count() &gt; 0)\n\t\t\t{\n\t\t\t\troot_category = ifnull(root_cat_rec.category_name,&quot;-&quot;);\n\t\t\t}\n\t\t}\n\t\tdirect_child_count = BOM_Line[parent_item == root_id &amp;&amp; is_struck == false].count();\n\t\tif(root_part_type != &quot;Assembly&quot; || root_lifecycle in {&quot;Obsolete&quot;,&quot;Abandoned&quot;})\n\t\t{\n\t\t\tnon_assembly_warning = true;\n\t\t}\n\n\t\tagg_order = List();\n\t\tagg_qty_map = Map();\n\t\tagg_status_map = Map();\n\t\tagg_depth_map = Map();\n\t\tfrontier_ids = List();\n\t\tfrontier_qtys = List();\n\t\tfrontier_depths = List();\n\t\tfrontier_paths = List();\n\t\tfrontier_ids.add(root_id);\n\t\tfrontier_qtys.add(1.0);\n\t\tfrontier_depths.add(0);\n\t\tfrontier_paths.add(&quot;,&quot; + root_id + &quot;,&quot;);\n\t\ttraversal_depth = 0;\n\t\tdepth_steps = List();\n\t\tdepth_steps.add(1);\n\t\tdepth_steps.add(2);\n\t\tdepth_steps.add(3);\n\t\tdepth_steps.add(4);\n\t\tdepth_steps.add(5);\n\t\tdepth_steps.add(6);\n\t\tdepth_steps.add(7);\n\t\tdepth_steps.add(8);\n\n\t\tfor each depth_marker in depth_steps\n\t\t{\n\t\t\tif(frontier_ids.size() &gt; 0 &amp;&amp; traversal_depth &lt; depth_cap)\n\t\t\t{\n\t\t\t\tnext_ids = List();\n\t\t\t\tnext_qtys = List();\n\t\t\t\tnext_depths = List();\n\t\t\t\tnext_paths = List();\n\t\t\t\tfor each index fidx in frontier_ids\n\t\t\t\t{\n\t\t\t\t\tparent_id = frontier_ids.get(fidx);\n\t\t\t\t\tparent_qty = frontier_qtys.get(fidx);\n\t\t\t\t\tparent_depth = frontier_depths.get(fidx);\n\t\t\t\t\tparent_path = frontier_paths.get(fidx);\n\t\t\t\t\tfor each bom_line in BOM_Line[parent_item == parent_id &amp;&amp; is_struck == false]\n\t\t\t\t\t{\n\t\t\t\t\t\ttotal_line_count = total_line_count + 1;\n\t\t\t\t\t\tchild_id = bom_line.child_item;\n\t\t\t\t\t\tchild_key = child_id.toString();\n\t\t\t\t\t\tline_qty = ifnull(bom_line.quantity,0);\n\t\t\t\t\t\taccumulated_qty = parent_qty * line_qty;\n\t\t\t\t\t\tapproval_status = ifnull(bom_line.manufacturer_approval_status,&quot;Pending_Review&quot;);\n\t\t\t\t\t\tchild_depth = parent_depth + 1;\n\t\t\t\t\t\tif(agg_qty_map.get(child_key) != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tupdated_qty = ifnull(agg_qty_map.get(child_key),0) + accumulated_qty;\n\t\t\t\t\t\t\tagg_qty_map.put(child_key,updated_qty);\n\t\t\t\t\t\t\tcurrent_status = ifnull(agg_status_map.get(child_key),&quot;Pending_Review&quot;);\n\t\t\t\t\t\t\tif(current_status != approval_status)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(current_status == &quot;Unapproved&quot; || approval_status == &quot;Unapproved&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcurrent_status = &quot;Unapproved&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcurrent_status = &quot;Mixed&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tagg_status_map.put(child_key,current_status);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(child_depth &lt; ifnull(agg_depth_map.get(child_key),child_depth))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tagg_depth_map.put(child_key,child_depth);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tagg_order.add(child_key);\n\t\t\t\t\t\t\tagg_qty_map.put(child_key,accumulated_qty);\n\t\t\t\t\t\t\tagg_status_map.put(child_key,approval_status);\n\t\t\t\t\t\t\tagg_depth_map.put(child_key,child_depth);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tchild_token = &quot;,&quot; + child_id + &quot;,&quot;;\n\t\t\t\t\t\tif(parent_path.contains(child_token))\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcap_hit = true;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tchild_children = BOM_Line[parent_item == child_id &amp;&amp; is_struck == false].count();\n\t\t\t\t\t\t\tif(child_children &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(child_depth &lt; depth_cap)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnext_ids.add(child_id);\n\t\t\t\t\t\t\t\t\tnext_qtys.add(accumulated_qty);\n\t\t\t\t\t\t\t\t\tnext_depths.add(child_depth);\n\t\t\t\t\t\t\t\t\tnext_paths.add(parent_path + child_id + &quot;,&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tcap_hit = true;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfrontier_ids = next_ids;\n\t\t\t\tfrontier_qtys = next_qtys;\n\t\t\t\tfrontier_depths = next_depths;\n\t\t\t\tfrontier_paths = next_paths;\n\t\t\t\ttraversal_depth = traversal_depth + 1;\n\t\t\t}\n\t\t}\n\n\t\tfor each child_key in agg_order\n\t\t{\n\t\t\tchild_item_id = child_key.toLong();\n\t\t\titem_rec = Item_Master[ID == child_item_id &amp;&amp; is_deleted == false];\n\t\t\trow_map = Map();\n\t\t\trow_map.put(&quot;item_id&quot;,child_item_id);\n\t\t\trow_map.put(&quot;total_quantity&quot;,ifnull(agg_qty_map.get(child_key),0));\n\t\t\trow_map.put(&quot;approval_status&quot;,ifnull(agg_status_map.get(child_key),&quot;Pending_Review&quot;));\n\t\t\trow_map.put(&quot;depth&quot;,ifnull(agg_depth_map.get(child_key),0));\n\t\t\tif(item_rec.count() &gt; 0)\n\t\t\t{\n\t\t\t\trow_map.put(&quot;apn&quot;,ifnull(item_rec.apn,&quot;-&quot;));\n\t\t\t\trow_map.put(&quot;description&quot;,ifnull(item_rec.description,&quot;-&quot;));\n\t\t\t\tcategory_text = &quot;-&quot;;\n\t\t\t\tif(item_rec.category != null)\n\t\t\t\t{\n\t\t\t\t\tcat_rec = Category_Master[ID == item_rec.category];\n\t\t\t\t\tif(cat_rec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tcategory_text = ifnull(cat_rec.category_name,&quot;-&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\trow_map.put(&quot;category&quot;,category_text);\n\t\t\t\tmfg_text = &quot;-&quot;;\n\t\t\t\tif(item_rec.mfg_0 != null)\n\t\t\t\t{\n\t\t\t\t\tmfg_rec = Manufacturer_Master[ID == item_rec.mfg_0];\n\t\t\t\t\tif(mfg_rec.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tmfg_text = ifnull(mfg_rec.manufacturer_name,&quot;-&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\trow_map.put(&quot;mfg_0&quot;,mfg_text);\n\t\t\t\trow_map.put(&quot;mpn_0&quot;,ifnull(item_rec.mpn_0,&quot;-&quot;));\n\t\t\t\trow_map.put(&quot;lifecycle&quot;,ifnull(item_rec.lifecycle_phase,&quot;-&quot;));\n\t\t\t\trow_map.put(&quot;found&quot;,true);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\trow_map.put(&quot;apn&quot;,&quot;Missing item&quot;);\n\t\t\t\trow_map.put(&quot;description&quot;,&quot;The child lookup could not be resolved.&quot;);\n\t\t\t\trow_map.put(&quot;category&quot;,&quot;-&quot;);\n\t\t\t\trow_map.put(&quot;mfg_0&quot;,&quot;-&quot;);\n\t\t\t\trow_map.put(&quot;mpn_0&quot;,&quot;-&quot;);\n\t\t\t\trow_map.put(&quot;lifecycle&quot;,&quot;Unknown&quot;);\n\t\t\t\trow_map.put(&quot;found&quot;,false);\n\t\t\t}\n\t\t\taggregate_rows.add(row_map);\n\t\t}\n\t}\n\telse if(has_request == true)\n\t{\n\t\tmissing_root_message = &quot;No active Item Master record was found for item_id &quot; + input.item_id + &quot;.&quot;;\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used by this page. */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* ZCS component CSS: table-simple-table. */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1180px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 2; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs-border-color); }\n\n/* ZCS component CSS: banner-outline-banner-with-icon. */\n.zcs-toast-link:hover { text-decoration: underline; }\n.zcs-outline-toast { border: 1px solid; }\n.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }\n.zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); }\n.zcs-warning-toast { background-color: #fef4e5; color: #663c01; }\n\n/* ZCS component CSS: button-primary-outline-button-no-icon. */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* ZCS component CSS: badge-filled-badge. */\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n\n/* ZCS component CSS: no-data-no-data-text-with-image. */\n.zcs-nodata-wrapper { min-height: 220px; }\n.zcs-nodata-img { width: 84px; height: 84px; }\n\n/* BOM Flatten custom styling. */\n.bom-flat-page { background: var(--zcs-page-bg-color); padding: 20px; box-sizing: border-box; min-height: 100%; color: var(--zcs-primary-text-color); font-family: Arial, sans-serif; }\n.bom-flat-header { margin-bottom: 16px; }\n.bom-flat-title { display: flex; align-items: center; gap: 10px; }\n.bom-flat-title i { color: var(--zcs_brand_color); font-size: 22px; }\n.bom-root-card { margin-bottom: 14px; }\n.bom-root-grid { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(280px, 2fr) repeat(4, minmax(120px, auto)); gap: 14px; align-items: center; }\n.bom-root-label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 3px; }\n.bom-root-value { color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; }\n.bom-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 14px 0; flex-wrap: wrap; }\n.bom-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.bom-empty { padding: 28px; text-align: center; }\n.bom-empty i { display: block; color: var(--zcs_brand_color); font-size: 34px; margin-bottom: 10px; }\n.bom-prompt-form { display: flex; gap: 10px; justify-content: center; align-items: end; flex-wrap: wrap; margin-top: 14px; }\n.bom-prompt-field { text-align: left; }\n.bom-prompt-field label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 4px; }\n.bom-prompt-field input { min-height: 36px; min-width: 280px; border: 1px solid var(--zcs-border-color); border-radius: 6px; padding: 6px 10px; box-sizing: border-box; font-size: 14px; color: var(--zcs-primary-text-color); background: #FFFFFF; }\n.bom-desc { max-width: 360px; white-space: normal; }\n.bom-apn { white-space: nowrap; font-weight: 600; }\n.bom-qty { white-space: nowrap; font-variant-numeric: tabular-nums; }\n.bom-warning { margin: 12px 0; }\n.bom-summary-note { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.bom-print-note { color: var(--zcs-secondary-text-color); font-size: 12px; }\n@media (max-width: 900px) {\n\t.bom-flat-page { padding: 12px; }\n\t.bom-root-grid { grid-template-columns: 1fr; }\n\t.bom-toolbar { align-items: flex-start; }\n}\n@media print {\n\t.bom-flat-page { background: #FFFFFF; padding: 0; color: #000000; }\n\t.bom-flat-header, .bom-root-card, .zcs-card, .zcs-table-wrapper { border: 0; box-shadow: none; }\n\t.bom-toolbar-actions, .bom-prompt-form { display: none; }\n\t.zcs-table-wrapper { overflow: visible; }\n\t.zcs-table-wrapper table { min-width: 0; width: 100%; font-size: 10px; }\n\t.zcs-table-wrapper table thead { position: static; display: table-header-group; }\n\t.zcs-table-wrapper table thead tr th, .zcs-table-wrapper table tbody tr td { padding: 5px 6px; border-color: #A0A0A0; }\n\t.zcs-table-wrapper table tbody tr { page-break-inside: avoid; }\n\t.zcs-badge { color: #000000 !important; background: #FFFFFF !important; border: 1px solid #777777 !important; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;bom-flat-page&apos;&gt;\n\t&lt;div class=&apos;bom-flat-header zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;bom-flat-title&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline files-2-archive-drawer&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-m-0 zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;Flattened BOM&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Flat aggregated procurement component list for one top-level assembly.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;% if(has_request == false) { %&gt;\n\t&lt;div class=&apos;bom-empty zcs-card&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Select a top-level assembly&lt;/h3&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Open this page from an Item Master record or enter an Item Master ID below. Use an assembly item for a procurement-ready rollup.&lt;/p&gt;\n\t\t\t\t&lt;form class=&apos;bom-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:BOM_Flatten_Page&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;bom-prompt-field&apos;&gt;\n\t\t\t\t\t\t&lt;label for=&apos;bom_flat_item_id&apos;&gt;Item Master ID&lt;/label&gt;\n\t\t\t\t\t\t&lt;input id=&apos;bom_flat_item_id&apos; name=&apos;item_id&apos; type=&apos;number&apos; placeholder=&apos;Example: 123456789&apos;&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Flatten BOM&lt;/span&gt;\n\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-12 zcs-font-13 zcs-color-tertiary&apos;&gt;URL format: #Page:BOM_Flatten_Page?item_id=123456789. You can find the ID by opening a row from All Items.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;% } else if(root_found == false) { %&gt;\n\t&lt;div class=&apos;bom-empty zcs-card&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Item not found&lt;/h3&gt;\n\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;&lt;%=missing_root_message%&gt;&lt;/p&gt;\n\t\t&lt;form class=&apos;bom-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:BOM_Flatten_Page&apos;&gt;\n\t\t\t&lt;div class=&apos;bom-prompt-field&apos;&gt;\n\t\t\t\t&lt;label for=&apos;bom_flat_retry&apos;&gt;Try another Item Master ID&lt;/label&gt;\n\t\t\t\t&lt;input id=&apos;bom_flat_retry&apos; name=&apos;item_id&apos; type=&apos;number&apos; placeholder=&apos;Enter item_id&apos;&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Flatten BOM&lt;/span&gt;\n\t\t\t&lt;/button&gt;\n\t\t&lt;/form&gt;\n\t&lt;/div&gt;\n&lt;% } else { %&gt;\n\t&lt;div class=&apos;bom-root-card zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;bom-root-grid&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Root APN&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_apn%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Description&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_desc%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Category&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_category%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Part Type&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_part_type%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Lifecycle&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_lifecycle%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Direct Lines&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=direct_child_count%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;% if(non_assembly_warning == true) { %&gt;\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-warning&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;Warning: this root item is not a normal active assembly. Part type is &lt;strong&gt;&lt;%=root_part_type%&gt;&lt;/strong&gt; and lifecycle is &lt;strong&gt;&lt;%=root_lifecycle%&gt;&lt;/strong&gt;. Verify before procurement use.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;% if(direct_child_count == 0) { %&gt;\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-warning&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;Warning: no active BOM_Line children were found for this root item.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;% if(cap_hit == true) { %&gt;\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-warning&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;Traversal stopped at the &lt;%=depth_cap%&gt;-level depth cap or skipped a repeated branch to prevent cycles. Review nested assemblies if the expected list is incomplete.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;% } %&gt;\n\n\t&lt;div class=&apos;bom-toolbar&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary&apos;&gt;Aggregated Components&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-summary-note&apos;&gt;Rows: &lt;%=aggregate_rows.size()%&gt;. Source BOM lines traversed: &lt;%=total_line_count%&gt;. Multiplicative quantity uses parent accumulated quantity times BOM line quantity.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;bom-toolbar-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Items?ID=&lt;%=root_id%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Root Item&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=root_id%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open BOM Browser&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;APN&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Description&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Category&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Total Quantity&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Primary Manufacturer&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Primary MPN&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Lifecycle&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Manufacturer Approval Status&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;8&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;% if(aggregate_rows.size() == 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-empty zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;8&apos;&gt;No aggregated components to display.&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;% } else { %&gt;\n&lt;%\n\t\tfor each row_map in aggregate_rows\n\t\t{\n\t\t\trow_apn = ifnull(row_map.get(&quot;apn&quot;),&quot;-&quot;);\n\t\t\trow_desc = ifnull(row_map.get(&quot;description&quot;),&quot;-&quot;);\n\t\t\trow_category = ifnull(row_map.get(&quot;category&quot;),&quot;-&quot;);\n\t\t\trow_qty = ifnull(row_map.get(&quot;total_quantity&quot;),0);\n\t\t\trow_mfg = ifnull(row_map.get(&quot;mfg_0&quot;),&quot;-&quot;);\n\t\t\trow_mpn = ifnull(row_map.get(&quot;mpn_0&quot;),&quot;-&quot;);\n\t\t\trow_lifecycle = ifnull(row_map.get(&quot;lifecycle&quot;),&quot;-&quot;);\n\t\t\trow_approval = ifnull(row_map.get(&quot;approval_status&quot;),&quot;Pending_Review&quot;);\n\t\t\trow_approval_display = row_approval.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\t\tlife_class = &quot;zcs-badge-yellow&quot;;\n\t\t\tif(row_lifecycle == &quot;Production&quot;) { life_class = &quot;zcs-badge-green&quot;; } else if(row_lifecycle == &quot;Design&quot;) { life_class = &quot;zcs-badge-blue&quot;; } else if(row_lifecycle == &quot;Deprecated&quot;) { life_class = &quot;zcs-badge-orange&quot;; } else if(row_lifecycle == &quot;Obsolete&quot; || row_lifecycle == &quot;Abandoned&quot;) { life_class = &quot;zcs-badge-red&quot;; } else if(row_lifecycle == &quot;Unreleased&quot;) { life_class = &quot;zcs-badge-yellow&quot;; } else { life_class = &quot;zcs-badge-grey&quot;; }\n\t\t\tapproval_class = &quot;zcs-badge-orange&quot;;\n\t\t\tif(row_approval == &quot;Approved&quot;) { approval_class = &quot;zcs-badge-green&quot;; } else if(row_approval == &quot;Unapproved&quot;) { approval_class = &quot;zcs-badge-red&quot;; } else if(row_approval == &quot;Mixed&quot;) { approval_class = &quot;zcs-badge-blue&quot;; }\n%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-apn zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_apn%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-desc zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_desc%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_category%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-qty zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_qty%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_mfg%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=row_mpn%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=life_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=row_lifecycle%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=approval_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=row_approval_display%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%  } %&gt;\n&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t&lt;/div&gt;\n\t&lt;p class=&apos;bom-print-note zcs-m-0 zcs-mt-12&apos;&gt;Print or export this page for a procurement-friendly flat table. Buttons and prompt controls are hidden in print media.&lt;/p&gt;\n&lt;% } %&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page BOM_Redline_Viewer(int change_order_id, int parent_item_id)
		{
					displayname = "BOM Redline Viewer"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Redline_View' elementName='Redline_View'>\n\t\t\t\t\t<![CDATA[htmlpage Redline_View()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tco_rec = Change_Order[ID == -1];\n\tparent_rec = Item_Master[ID == -1];\n\tif(input.change_order_id != null)\n\t{\n\t\tco_rec = Change_Order[ID == input.change_order_id];\n\t}\n\tif(input.parent_item_id != null)\n\t{\n\t\tparent_rec = Item_Master[ID == input.parent_item_id];\n\t}\n\n\tco_found = false;\n\tparent_found = false;\n\tif(co_rec.count() &gt; 0)\n\t{\n\t\tco_found = true;\n\t\tco_order_id = ifnull(co_rec.order_id,&quot;-&quot;);\n\t\tco_title = ifnull(co_rec.title,&quot;Untitled Change Order&quot;);\n\t\tco_status = ifnull(co_rec.status,&quot;Unspecified&quot;);\n\t\tco_status_class = &quot;zcs-badge-yellow&quot;;\n\t\tco_status_icon = &quot;loader-dots-06&quot;;\n\t\tif(co_status == &quot;Released&quot; || co_status == &quot;Approved&quot; || co_status == &quot;Completed&quot; || co_status == &quot;Closed&quot;)\n\t\t{\n\t\t\tco_status_class = &quot;zcs-badge-green&quot;;\n\t\t\tco_status_icon = &quot;ui-1-check-circle-08&quot;;\n\t\t}\n\t\telse if(co_status == &quot;Rejected&quot; || co_status == &quot;Cancelled&quot; || co_status == &quot;Canceled&quot; || co_status == &quot;Failed&quot;)\n\t\t{\n\t\t\tco_status_class = &quot;zcs-badge-red&quot;;\n\t\t\tco_status_icon = &quot;ui-1-circle-remove&quot;;\n\t\t}\n\t\telse if(co_status == &quot;Draft&quot;)\n\t\t{\n\t\t\tco_status_class = &quot;zcs-badge-grey&quot;;\n\t\t\tco_status_icon = &quot;ui-2-time&quot;;\n\t\t}\n\t}\n\telse\n\t{\n\t\tco_order_id = &quot;Change Order not found&quot;;\n\t\tco_title = &quot;No Change Order record matched ID &quot; + ifnull(input.change_order_id,&quot;-&quot;);\n\t\tco_status = &quot;Not found&quot;;\n\t\tco_status_class = &quot;zcs-badge-red&quot;;\n\t\tco_status_icon = &quot;ui-1-circle-remove&quot;;\n\t}\n\n\tif(parent_rec.count() &gt; 0)\n\t{\n\t\tparent_found = true;\n\t\tparent_apn = ifnull(parent_rec.apn,&quot;-&quot;);\n\t\tparent_revision = ifnull(parent_rec.revision,&quot;-&quot;);\n\t\tparent_name = ifnull(parent_rec.part_name,ifnull(parent_rec.description,&quot;-&quot;));\n\t\tparent_status = ifnull(parent_rec.lifecycle_phase,ifnull(parent_rec.part_status,&quot;-&quot;));\n\t}\n\telse\n\t{\n\t\tparent_apn = &quot;Parent item not found&quot;;\n\t\tparent_revision = &quot;-&quot;;\n\t\tparent_name = &quot;No Item Master record matched ID &quot; + ifnull(input.parent_item_id,&quot;-&quot;);\n\t\tparent_status = &quot;Not found&quot;;\n\t}\n\n\tbom_records = BOM_Line[ID == -1];\n\tredline_data = List();\n\tsuperseded_ids = List();\n\ttotal_source_rows = 0;\n\tunchanged_count = 0;\n\tmodified_count = 0;\n\tinserted_count = 0;\n\tremoved_count = 0;\n\tif(co_found == true &amp;&amp; parent_found == true)\n\t{\n\t\tredline_data = thisapp.Build_BOM_Redline_Data(input.change_order_id,input.parent_item_id);\n\t\tbom_records = BOM_Line[parent_item == input.parent_item_id] sort by line_number asc;\n\t\ttotal_source_rows = bom_records.count();\n\t\tfor each bom_line_for_index in bom_records\n\t\t{\n\t\t\tif(bom_line_for_index.superseded_by != null)\n\t\t\t{\n\t\t\t\tsuperseded_ids.add(bom_line_for_index.superseded_by);\n\t\t\t}\n\t\t}\n\t\tfor each bom_line_for_count in bom_records\n\t\t{\n\t\t\tcount_as_superseding_line = false;\n\t\t\tif(superseded_ids.contains(bom_line_for_count.ID) &amp;&amp; bom_line_for_count.is_struck != true)\n\t\t\t{\n\t\t\t\tcount_as_superseding_line = true;\n\t\t\t}\n\t\t\tif(count_as_superseding_line == false)\n\t\t\t{\n\t\t\t\tif(bom_line_for_count.superseded_by != null)\n\t\t\t\t{\n\t\t\t\t\tlinked_insert_count = BOM_Line[ID == bom_line_for_count.superseded_by].count();\n\t\t\t\t\tif(linked_insert_count &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tmodified_count = modified_count + 1;\n\t\t\t\t\t\tinserted_count = inserted_count + 1;\n\t\t\t\t\t}\n\t\t\t\t\telse if(bom_line_for_count.is_struck == true)\n\t\t\t\t\t{\n\t\t\t\t\t\tremoved_count = removed_count + 1;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if(bom_line_for_count.is_struck == true)\n\t\t\t\t{\n\t\t\t\t\tremoved_count = removed_count + 1;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tunchanged_count = unchanged_count + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tredline_data_size = redline_data.size();\n%&gt;\n&lt;style&gt;\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\t--zcs-zebra-even-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-w-full { width: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-20 { padding-top: 1.25rem; padding-bottom: 1.25rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* ZCS component CSS: header-heading-with-back, adjusted to Nucleo icon. */\n.zcs-back { width: 34px; height: 34px; border: 1px solid var(--zcs-border-color); color: var(--zcs-teritiary-text-color); background: var(--zcs-white-color); }\n.zcs-back:hover { color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); }\n.zcs-back-icon { font-style: normal; }\n@media (max-width: 576px) {\n\t.zcs-page-header { padding: 12px 20px; }\n}\n\n/* ZCS component CSS: badge-badge-with-icon */\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #6b7280; color: #4b5563; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #b8770d; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n\n/* ZCS component CSS: banner-outline-banner-with-icon */\n.zcs-toast-link:hover { text-decoration: underline; }\n.zcs-outline-toast { border: 1px solid; }\n.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }\n.zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); }\n.zcs-info-toast { background-color: #e4f6fd; color: #024361; border-color: #0588d1; }\n.zcs-warning-toast { background-color: #fef4e5; color: #663c01; border-color: #ed6c03; }\n.zcs-error-toast { background-color: #feedec; color: #5f2120; border-color: #d32f2f; }\n\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1040px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table thead tr th.zcs-green, .zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table thead tr th.zcs-red, .zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table thead tr th.zcs-yellow, .zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table thead tr th.zcs-blue, .zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color: #09598e; }\n\n.brv-page { min-height: 100%; background: #F6F7FB; }\n.brv-summary-grid { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 12px; }\n.brv-summary-card { border: 1px solid #e7e7ee; background: #ffffff; border-radius: 12px; padding: 14px 16px; }\n.brv-summary-label { color: var(--zcs-secondary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }\n.brv-summary-value { color: var(--zcs-primary-text-color); font-size: 22px; font-weight: 700; line-height: 1.2; margin-top: 4px; }\n.brv-subvalue { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 2px; }\n.brv-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n.brv-meta-card { min-width: 0; }\n.brv-meta-title { color: var(--zcs-primary-text-color); font-weight: 700; font-size: 15px; }\n.brv-meta-line { color: var(--zcs-secondary-text-color); font-size: 13px; margin-top: 4px; }\n.brv-toolbar { border-top: 1px solid #e7e7ee; }\n.brv-legend { flex-wrap: wrap; }\n.brv-legend-dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; border: 1px solid transparent; }\n.brv-dot-unchanged { background: #ffffff; border-color: #cfd4dc; }\n.brv-dot-removed { background: #eef0f3; border-color: #9ca3af; }\n.brv-dot-inserted { background: #e4fcf3; border-color: #179E6C; }\n.brv-dot-modified { background: #e8efff; border-color: #2A6FFC; }\n.brv-row-note { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 3px; }\n.brv-part-main { font-weight: 600; color: var(--zcs-primary-text-color); }\n.brv-part-sub { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 2px; }\n.brv-cell-stack { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }\n.brv-change-pair { display: inline-flex; flex-wrap: wrap; gap: 5px; align-items: center; }\ndel.old-value, .removed-row del { color: #6b7280; text-decoration: line-through; text-decoration-thickness: 1.5px; }\nins.new-value { color: #0f7b4f; background: #e4fcf3; border-bottom: 2px solid #179E6C; text-decoration: none; padding: 0 3px; border-radius: 3px; }\n.removed-row td { background-color: #f3f4f6; color: #6b7280; }\n.removed-row:hover td { background-color: #eef0f3 !important; }\n.inserted-row td { background-color: #f0fdf7; color: #0f7b4f; }\n.inserted-row:hover td { background-color: #e4fcf3 !important; }\n.modified-row td { background-color: #f6f8ff; }\n.modified-row:hover td { background-color: #eef3ff !important; }\n.brv-status-cell { min-width: 135px; }\n.brv-empty { border: 1px dashed var(--zcs_tertiary_border_color); background: #ffffff; border-radius: 12px; padding: 28px; text-align: center; }\n.brv-empty i { color: var(--zcs-secondary-text-color); }\n@media (max-width: 900px) {\n\t.brv-summary-grid, .brv-meta-grid { grid-template-columns: 1fr; }\n\t.brv-page-header { align-items: flex-start; flex-direction: column; }\n}\n&lt;/style&gt;\n&lt;div class=&apos;brv-page zcs-w-full zcs-box-border&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header brv-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;a href=&apos;#Page:BOM_Browser?item_id=&lt;%=input.parent_item_id%&gt;&apos; class=&apos;zcs-back zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-md zcs-box-border&apos; title=&apos;Back to BOM Browser&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-back-icon zcs-font-18 zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&apos;zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;BOM Redline Viewer&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-4&apos;&gt;Visual before and after markers for the selected Change Order and parent assembly.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=co_status_class%&gt;&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=co_status_icon%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=co_status%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;zcs-px-30 zcs-py-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;brv-meta-grid&apos;&gt;\n\t\t\t\t&lt;div class=&apos;brv-meta-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-font-18 zcs-color-theme zc-li-outline design-2-layers&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;brv-meta-title&apos;&gt;Parent assembly&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;&lt;span class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=parent_apn%&gt;&lt;/span&gt; Rev &lt;%=parent_revision%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;&lt;%=parent_name%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;Lifecycle or status: &lt;%=parent_status%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;brv-meta-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-font-18 zcs-color-theme zc-li-outline files-paper&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&apos;brv-meta-title&apos;&gt;Change Order&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;&lt;span class=&apos;zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=co_order_id%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;&lt;%=co_title%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-meta-line&apos;&gt;Status: &lt;%=co_status%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-16&apos;&gt;\n\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;This page is read-only. Snapshot field-level history is unavailable here, so modified rows are inferred from &lt;span class=&apos;zcs-font-semibold&apos;&gt;BOM_Line.superseded_by&lt;/span&gt;, removed rows from &lt;span class=&apos;zcs-font-semibold&apos;&gt;BOM_Line.is_struck&lt;/span&gt;, and unchanged rows from the current BOM marker state.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;%\n\t\t\tif(co_found == false || parent_found == false)\n\t\t\t{\n\t\t%&gt;\n\t\t\t&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;Unable to render BOM redline rows because one or more required records were not found.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;brv-empty zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-22 zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0 zcs-mt-8&apos;&gt;Missing redline context&lt;/h6&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;Change Order ID: &lt;%=ifnull(input.change_order_id,&quot;-&quot;)%&gt;. Parent Item ID: &lt;%=ifnull(input.parent_item_id,&quot;-&quot;)%&gt;.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t%&gt;\n\t\t\t&lt;div class=&apos;brv-summary-grid zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;div class=&apos;brv-summary-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-label&apos;&gt;Unchanged rows&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-value&apos;&gt;&lt;%=unchanged_count%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-subvalue&apos;&gt;Plain BOM lines&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;brv-summary-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-label&apos;&gt;Removed rows&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-value&apos;&gt;&lt;%=removed_count%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-subvalue&apos;&gt;Grey struck rows&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;brv-summary-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-label&apos;&gt;Inserted rows&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-value&apos;&gt;&lt;%=inserted_count%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-subvalue&apos;&gt;Linked superseding lines&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;brv-summary-card&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-label&apos;&gt;Modified rows&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-summary-value&apos;&gt;&lt;%=modified_count%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-subvalue&apos;&gt;Old struck and new inserted&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-mt-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;brv-toolbar zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-16 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&apos;&gt;Redline rows&lt;/h6&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-4&apos;&gt;Helper returned &lt;%=redline_data_size%&gt; row maps from Build_BOM_Redline_Data; rendered source contains &lt;%=total_source_rows%&gt; BOM_Line records.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-legend zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-13 zcs-color-secondary&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;span class=&apos;brv-legend-dot brv-dot-unchanged&apos;&gt;&lt;/span&gt;Unchanged&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;span class=&apos;brv-legend-dot brv-dot-removed&apos;&gt;&lt;/span&gt;Removed&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;span class=&apos;brv-legend-dot brv-dot-inserted&apos;&gt;&lt;/span&gt;Inserted&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-inline-flex zcs-align-items-center zcs-gap-6&apos;&gt;&lt;span class=&apos;brv-legend-dot brv-dot-modified&apos;&gt;&lt;/span&gt;Modified&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;%\n\t\t\t\t\tif(total_source_rows == 0)\n\t\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&apos;brv-empty zcs-m-16&apos;&gt;\n\t\t\t\t\t\t&lt;i class=&apos;zcs-font-22 zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0 zcs-mt-8&apos;&gt;No BOM rows found&lt;/h6&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-8&apos;&gt;The selected parent item has no BOM_Line records to render.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full bom-redline-table&apos;&gt;\n\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Change&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Line&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Child item&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Qty&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Ref des&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Approval&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Notes&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-p-8 zcs-box-border&apos; colspan=&apos;7&apos;&gt;&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\tfor each bom_line in bom_records\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tskip_superseding_line = false;\n\t\t\t\t\t\t\t\t\t\tif(superseded_ids.contains(bom_line.ID) &amp;&amp; bom_line.is_struck != true)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tskip_superseding_line = true;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(skip_superseding_line == false)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\told_line_number = ifnull(bom_line.line_number,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_child_apn = ifnull(bom_line.child_item.apn,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_child_revision = ifnull(bom_line.child_item.revision,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_child_name = ifnull(bom_line.child_item.part_name,ifnull(bom_line.child_item.description,&quot;-&quot;));\n\t\t\t\t\t\t\t\t\t\t\told_quantity = ifnull(bom_line.quantity,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_ref = ifnull(bom_line.reference_designator,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_approval = ifnull(bom_line.manufacturer_approval_status,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\told_notes = ifnull(bom_line.bom_notes,&quot;-&quot;);\n\n\t\t\t\t\t\t\t\t\t\t\tif(bom_line.superseded_by != null)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tnew_line = BOM_Line[ID == bom_line.superseded_by];\n\t\t\t\t\t\t\t\t\t\t\t\tif(new_line.count() &gt; 0)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_line_number = ifnull(new_line.line_number,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_child_apn = ifnull(new_line.child_item.apn,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_child_revision = ifnull(new_line.child_item.revision,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_child_name = ifnull(new_line.child_item.part_name,ifnull(new_line.child_item.description,&quot;-&quot;));\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_quantity = ifnull(new_line.quantity,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_ref = ifnull(new_line.reference_designator,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_approval = ifnull(new_line.manufacturer_approval_status,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\tnew_notes = ifnull(new_line.bom_notes,&quot;-&quot;);\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;modified-row&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Modified&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-row-note&apos;&gt;Before and after values&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tif(bom_line.line_number != new_line.line_number)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;span class=&apos;brv-change-pair&apos;&gt;&lt;del class=&apos;old-value&apos;&gt;&lt;%=old_line_number%&gt;&lt;/del&gt;&lt;ins class=&apos;new-value&apos;&gt;&lt;%=new_line_number%&gt;&lt;/ins&gt;&lt;/span&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;%=old_line_number%&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tif(bom_line.child_item != new_line.child_item)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;brv-cell-stack&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;del class=&apos;old-value&apos;&gt;&lt;span class=&apos;brv-part-main&apos;&gt;&lt;%=old_child_apn%&gt;&lt;/span&gt; Rev &lt;%=old_child_revision%&gt;&lt;span class=&apos;brv-part-sub&apos;&gt;&lt;%=old_child_na