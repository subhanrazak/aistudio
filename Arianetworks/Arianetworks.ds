		schedule
		{
			Deviation_Auto_Expiry as "Deviation Auto Expiry"
			{
			    type = schedule
			    form = Change_Order[change_category == "Deviation" && status == "Effective" && expiration_date <= zoho.currentdate]
			    start = expiration_date at "00:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                old_status = input.status;
			                for each affected_row in input.affected_items
			                {
			                    if (affected_row.child_item != null)
			                    {
			                        item_rec = Item_Master[ID == affected_row.child_item];
			                        if (item_rec.count() > 0)
			                        {
			                            item_rec.is_deviated = false;
			                        }
			                    }
			                }
			                input.status = "Expired";
			                admin_list = thisapp.Get_Employees_By_Profile("ADMIN");
			                merge_map = Map();
			                merge_map.put("order_id", input.order_id);
			                merge_map.put("title", input.title);
			                creator_recipients = List();
			                creator_recipients.add(input.created_by_employee);
			                thisapp.Send_Template_Email("DEVIATION_EXPIRED", creator_recipients, merge_map);
			                thisapp.Send_Template_Email("DEVIATION_EXPIRED", admin_list, merge_map);
			                thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Expired", input.created_by_employee);
			            )
			        }
			    }
			}
		}

		functions
		{
			Approve_Change_Order as "Approve Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                approved_any = false;
			                for each app_row in input.approvers
			                {
			                    if (emp_id != 0 && app_row.approver == emp_id && app_row.decision == "Pending")
			                    {
			                        app_row.decision = "Approved";
			                        app_row.decided_on = zoho.currenttime;
			                        approved_any = true;
			                    }
			                }
			                if (approved_any == true)
			                {
			                    pending_count = 0;
			                    for each pending_row in input.approvers
			                    {
			                        if (pending_row.decision == "Pending")
			                        {
			                            pending_count = pending_count + 1;
			                        }
			                    }
			                    if (pending_count == 0)
			                    {
			                        old_status = input.status;
			                        input.status = "Approved";
			                        thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Approved", input.created_by_employee);
			                    }
			                }
			            )
			        }
			    }
			}

			Comment_Change_Order as "Comment Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                allowed = false;
			                for each app_row in input.approvers
			                {
			                    if (emp_id != 0 && app_row.approver == emp_id && app_row.decision == "Pending")
			                    {
			                        allowed = true;
			                    }
			                }
			                if (emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"})
			                {
			                    allowed = true;
			                }
			                if (allowed == true)
			                {
			                    openUrl("#Form:Approval_Remarks?linked_change_order=" + input.ID, "same window");
			                }
			            )
			        }
			    }
			}

			Force_Approval as "Force Approval"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_rec.count() > 0 && emp_rec.profile_label == "ADMIN" && input.status == "Approval_In_Progress")
			                {
			                    for each app_row in input.approvers
			                    {
			                        if (app_row.decision == "Pending")
			                        {
			                            app_row.decision = "Approved";
			                            app_row.decided_on = zoho.currenttime;
			                        }
			                    }
			                    old_status = input.status;
			                    input.status = "Approved";
			                    thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Approved", input.created_by_employee);
			                }
			            )
			        }
			    }
			}

			Reject_Change_Order as "Reject Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                rejected_any = false;
			                for each app_row in input.approvers
			                {
			                    if (emp_id != 0 && app_row.approver == emp_id && app_row.decision == "Pending")
			                    {
			                        app_row.decision = "Rejected";
			                        app_row.decided_on = zoho.currenttime;
			                        rejected_any = true;
			                    }
			                }
			                if (rejected_any == true)
			                {
			                    old_status = input.status;
			                    input.status = "Rejected";
			                    merge_map = Map();
			                    merge_map.put("order_id", input.order_id);
			                    merge_map.put("title", input.title);
			                    creator_recipients = List();
			                    creator_recipients.add(input.created_by_employee);
			                    thisapp.Send_Template_Email("CHANGE_ORDER_REJECTED", creator_recipients, merge_map);
			                    thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Rejected", input.created_by_employee);
			                }
			            )
			        }
			    }
			}

			Release_Change_Order_Action as "Release Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"} && input.status == "Approved")
			                {
			                    try
			                    {
			                        input.release_last_attempt_on = zoho.currenttime;
			                        thisapp.Release_Change_Order(input.ID);
			                    }
			                    catch (release_error)
			                    {
			                        input.release_error_flag = true;
			                        input.release_error_details = release_error.toString();
			                        input.release_last_attempt_on = zoho.currenttime;
			                        thisapp.Write_Activity_Log("Change_Order", input.order_id, "release_error", "", release_error.toString(), input.created_by_employee);
			                    }
			                }
			            )
			        }
			    }
			}

			Reopen_Change_Order as "Re-open Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                if (emp_rec.count() > 0 && emp_rec.profile_label == "ADMIN" && input.status == "Rejected")
			                {
			                    for each app_row in input.approvers
			                    {
			                        app_row.decision = "Pending";
			                        app_row.decided_on = null;
			                    }
			                    old_status = input.status;
			                    input.status = "Approval_In_Progress";
			                    thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Approval_In_Progress", input.created_by_employee);
			                }
			            )
			        }
			    }
			}

			Withdraw_Change_Order as "Withdraw Change Order"
			{
			    type = functions
			    form = Change_Order
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
			                emp_rec = Employee_Master[ID == emp_id];
			                allowed = false;
			                if (emp_id != 0 && (emp_id == input.created_by_employee || (emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"})))
			                {
			                    allowed = true;
			                }
			                if (allowed == true && input.status in {"Open","Submitted","Approval_In_Progress"})
			                {
			                    old_status = input.status;
			                    input.status = "Cancelled";
			                    pending_approvers = List();
			                    for each app_row in input.approvers
			                    {
			                        if (app_row.decision == "Pending")
			                        {
			                            pending_approvers.add(app_row.approver);
			                        }
			                    }
			                    merge_map = Map();
			                    merge_map.put("order_id", input.order_id);
			                    merge_map.put("title", input.title);
			                    thisapp.Send_Template_Email("CHANGE_ORDER_WITHDRAWN", pending_approvers, merge_map);
			                    thisapp.Write_Activity_Log("Change_Order", input.order_id, "status", old_status, "Cancelled", input.created_by_employee);
			                }
			            )
			        }
			    }
			}

