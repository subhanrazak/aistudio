	pages
	{
		page BOM_Browser(string apn, int item_id)
		{
					displayname = "BOM Browser"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='BOM_Tree' elementName='BOM_Tree'>\n\t\t\t\t\t<![CDATA[htmlpage BOM_Tree()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\troot_item = Item_Master[ID == -1];\n\tapn_value = &quot;&quot;;\n\tlookup_label = &quot;&quot;;\n\thas_request = false;\n\tif(input.apn != null)\n\t{\n\t\tapn_value = input.apn.trim();\n\t}\n\tif(input.item_id != null &amp;&amp; input.item_id &gt; 0)\n\t{\n\t\thas_request = true;\n\t\tlookup_label = &quot;Item ID &quot; + input.item_id;\n\t\troot_item = Item_Master[ID == input.item_id &amp;&amp; is_deleted == false];\n\t}\n\telse if(apn_value != &quot;&quot;)\n\t{\n\t\thas_request = true;\n\t\tlookup_label = &quot;APN &quot; + apn_value;\n\t\troot_item = Item_Master[apn == apn_value &amp;&amp; is_deleted == false];\n\t}\n\troot_found = false;\n\tif(root_item.count() &gt; 0)\n\t{\n\t\troot_found = true;\n\t\troot_id = root_item.ID;\n\t\troot_apn = ifnull(root_item.apn,&quot;-&quot;);\n\t\troot_desc = ifnull(root_item.description,&quot;-&quot;);\n\t\troot_rev = ifnull(root_item.revision,&quot;-&quot;);\n\t\troot_lifecycle = ifnull(root_item.lifecycle_phase,&quot;Unreleased&quot;);\n\t\troot_life_class = &quot;zcs-badge-yellow&quot;;\n\t\tif(root_lifecycle == &quot;Production&quot;)\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(root_lifecycle == &quot;Design&quot;)\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-blue&quot;;\n\t\t}\n\t\telse if(root_lifecycle == &quot;Deprecated&quot;)\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(root_lifecycle == &quot;Obsolete&quot; || root_lifecycle == &quot;Abandoned&quot;)\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(root_lifecycle == &quot;Unreleased&quot;)\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\telse\n\t\t{\n\t\t\troot_life_class = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS component CSS: zcs-global utility subset used by this page. */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-w-full { width: 100%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* ZCS component CSS: table-simple-table. */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1120px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 2; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: middle; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n\n/* ZCS component CSS: badge-filled-badge. */\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n\n/* ZCS component CSS: button-primary-outline-button. */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* BOM Browser custom hierarchy styling. */\n.bom-browser { background: var(--zcs-page-bg-color, #F3F3F4); padding: 20px; box-sizing: border-box; min-height: 100%; color: var(--zcs-primary-text-color); }\n.bom-header { margin-bottom: 16px; }\n.bom-header-title { display: flex; align-items: center; gap: 10px; }\n.bom-header-title i { color: var(--zcs_brand_color); font-size: 22px; }\n.bom-root-card { margin-bottom: 16px; }\n.bom-root-grid { display: grid; grid-template-columns: minmax(220px, 1.2fr) minmax(260px, 2fr) repeat(2, minmax(120px, auto)); gap: 14px; align-items: center; }\n.bom-root-label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 3px; }\n.bom-root-value { color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; }\n.bom-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 14px 0; flex-wrap: wrap; }\n.bom-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.bom-control-disabled { opacity: 0.58; cursor: default; pointer-events: none; }\n.bom-expanded-note { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.bom-line-cell { white-space: nowrap; }\n.bom-level { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; margin-right: 8px; padding: 1px 6px; border-radius: 4px; background: #F1F2F8; color: var(--zcs-secondary-text-color); font-size: 12px; }\n.bom-node { display: inline-flex; align-items: center; gap: 7px; min-width: 0; }\n.bom-node i { color: var(--zcs_brand_color); font-size: 14px; }\n.bom-node a { color: var(--zcs_brand_color); font-weight: 600; }\n.bom-depth-1 .bom-node { padding-left: 0; }\n.bom-depth-2 .bom-node { padding-left: 24px; }\n.bom-depth-3 .bom-node { padding-left: 48px; }\n.bom-depth-4 .bom-node { padding-left: 72px; }\n.bom-depth-5 .bom-node { padding-left: 96px; }\n.bom-depth-6 .bom-node { padding-left: 120px; }\n.bom-depth-7 .bom-node { padding-left: 144px; }\n.bom-depth-8 .bom-node { padding-left: 168px; }\n.bom-row .bom-node:before { content: &apos;&apos;; display: inline-block; width: 14px; height: 1px; background: var(--zcs_tertiary_border_color); margin-right: 2px; }\n.bom-desc { max-width: 360px; white-space: normal; }\n.bom-link-stack { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n.bom-mini-link { display: inline-flex; align-items: center; gap: 5px; color: var(--zcs_brand_color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 4px 8px; background: #FFFFFF; font-size: 12px; }\n.bom-mini-link:hover { border-color: var(--zcs_brand_color); background: var(--zcs_component_hover_color); }\n.bom-empty { padding: 28px; text-align: center; }\n.bom-empty i { display: block; color: var(--zcs_brand_color); font-size: 34px; margin-bottom: 10px; }\n.bom-prompt-form { display: flex; gap: 10px; justify-content: center; align-items: end; flex-wrap: wrap; margin-top: 14px; }\n.bom-prompt-field { text-align: left; }\n.bom-prompt-field label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 4px; }\n.bom-prompt-field input { min-height: 36px; min-width: 260px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 6px 10px; box-sizing: border-box; font-size: 14px; color: var(--zcs-primary-text-color); background: #FFFFFF; }\n.bom-warning { margin-top: 12px; padding: 12px 14px; border: 1px solid #FAAE13; border-radius: 8px; color: #8A5B00; background: #FCF4E6; }\n@media (max-width: 900px) {\n\t.bom-browser { padding: 12px; }\n\t.bom-root-grid { grid-template-columns: 1fr; }\n\t.bom-toolbar { align-items: flex-start; }\n}\n&lt;/style&gt;\n\n&lt;div class=&apos;bom-browser&apos;&gt;\n\t&lt;div class=&apos;bom-header zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;bom-header-title&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-m-0 zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary&apos;&gt;BOM Browser&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Multi-level assembly tree with line, child item, quantity, revision, lifecycle, and approval context.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;% if(has_request == false) { %&gt;\n\t&lt;div class=&apos;bom-empty zcs-card&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;Enter an APN to browse its BOM&lt;/h3&gt;\n\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Provide an APN, or open this page with item_id for an exact Item Master record.&lt;/p&gt;\n\t\t&lt;form class=&apos;bom-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:BOM_Browser&apos;&gt;\n\t\t\t&lt;div class=&apos;bom-prompt-field&apos;&gt;\n\t\t\t\t&lt;label for=&apos;bom_apn&apos;&gt;APN&lt;/label&gt;\n\t\t\t\t&lt;input id=&apos;bom_apn&apos; name=&apos;apn&apos; type=&apos;text&apos; placeholder=&apos;Example: ASM-00001-00&apos;&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open BOM&lt;/span&gt;\n\t\t\t&lt;/button&gt;\n\t\t&lt;/form&gt;\n\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-12 zcs-font-13 zcs-color-tertiary&apos;&gt;URL format: #Page:BOM_Browser?apn=YOUR_APN or #Page:BOM_Browser?item_id=123456789&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;% } else if(root_found == false) { %&gt;\n\t&lt;div class=&apos;bom-empty zcs-card&apos;&gt;\n\t\t&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t&lt;h3 class=&apos;zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary&apos;&gt;No Item Master record found&lt;/h3&gt;\n\t\t&lt;p class=&apos;zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary&apos;&gt;Could not resolve &lt;strong&gt;&lt;%=lookup_label%&gt;&lt;/strong&gt;. Check that the item exists and is not deleted.&lt;/p&gt;\n\t\t&lt;form class=&apos;bom-prompt-form&apos; method=&apos;get&apos; action=&apos;#Page:BOM_Browser&apos;&gt;\n\t\t\t&lt;div class=&apos;bom-prompt-field&apos;&gt;\n\t\t\t\t&lt;label for=&apos;bom_apn_retry&apos;&gt;Try another APN&lt;/label&gt;\n\t\t\t\t&lt;input id=&apos;bom_apn_retry&apos; name=&apos;apn&apos; type=&apos;text&apos; placeholder=&apos;Enter APN&apos;&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;button class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open BOM&lt;/span&gt;\n\t\t\t&lt;/button&gt;\n\t\t&lt;/form&gt;\n\t&lt;/div&gt;\n&lt;% } else { %&gt;\n\t&lt;div class=&apos;bom-root-card zcs-card zcs-p-20&apos;&gt;\n\t\t&lt;div class=&apos;bom-root-grid&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Root APN&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_apn%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Description&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_desc%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Revision&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-value&apos;&gt;&lt;%=root_rev%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&apos;bom-root-label&apos;&gt;Lifecycle&lt;/span&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=root_life_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=root_lifecycle%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;bom-toolbar&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary&apos;&gt;Expanded BOM Tree&lt;/div&gt;\n\t\t\t&lt;div class=&apos;bom-expanded-note&apos;&gt;Rendered expanded by default. Depth cap: 8 levels to avoid execution limits.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;bom-toolbar-actions&apos;&gt;\n\t\t\t&lt;span class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-control-disabled&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Expand All&lt;/span&gt;\n\t\t\t&lt;/span&gt;\n\t\t\t&lt;span class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-control-disabled&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Collapse All&lt;/span&gt;\n\t\t\t&lt;/span&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Items?ID=&lt;%=root_id%&gt;&apos; target=&apos;_self&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Root Item&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Line&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Child APN&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Description&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Quantity&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Revision&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Lifecycle&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Approval&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Links&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-py-2 zcs-box-border&apos; colspan=&apos;8&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n&lt;%\n\trow_count = 0;\n\tcap_hit = false;\n\tfor each line1 in BOM_Line[parent_item == root_id &amp;&amp; is_struck == false] sort by line_number asc\n\t{\n\t\trow_count = row_count + 1;\n\t\tchild1 = Item_Master[ID == line1.child_item &amp;&amp; is_deleted == false];\n\t\tchild1_found = child1.count() &gt; 0;\n\t\tif(child1_found)\n\t\t{\n\t\t\tchild1_id = child1.ID;\n\t\t\tchild1_apn = ifnull(child1.apn,&quot;-&quot;);\n\t\t\tchild1_desc = ifnull(child1.description,&quot;-&quot;);\n\t\t\tchild1_rev = ifnull(child1.revision,&quot;-&quot;);\n\t\t\tchild1_lifecycle = ifnull(child1.lifecycle_phase,&quot;Unreleased&quot;);\n\t\t}\n\t\telse\n\t\t{\n\t\t\tchild1_id = 0;\n\t\t\tchild1_apn = &quot;Missing item&quot;;\n\t\t\tchild1_desc = &quot;The child lookup could not be resolved.&quot;;\n\t\t\tchild1_rev = &quot;-&quot;;\n\t\t\tchild1_lifecycle = &quot;Unknown&quot;;\n\t\t}\n\t\tlife1_class = &quot;zcs-badge-yellow&quot;;\n\t\tif(child1_lifecycle == &quot;Production&quot;) { life1_class = &quot;zcs-badge-green&quot;; } else if(child1_lifecycle == &quot;Design&quot;) { life1_class = &quot;zcs-badge-blue&quot;; } else if(child1_lifecycle == &quot;Deprecated&quot;) { life1_class = &quot;zcs-badge-orange&quot;; } else if(child1_lifecycle == &quot;Obsolete&quot; || child1_lifecycle == &quot;Abandoned&quot;) { life1_class = &quot;zcs-badge-red&quot;; } else if(child1_lifecycle == &quot;Unreleased&quot;) { life1_class = &quot;zcs-badge-yellow&quot;; } else { life1_class = &quot;zcs-badge-grey&quot;; }\n\t\tapproval1 = ifnull(line1.manufacturer_approval_status,&quot;Pending_Review&quot;);\n\t\tapproval1_display = approval1.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\tapproval1_class = &quot;zcs-badge-orange&quot;;\n\t\tif(approval1 == &quot;Approved&quot;) { approval1_class = &quot;zcs-badge-green&quot;; } else if(approval1 == &quot;Unapproved&quot;) { approval1_class = &quot;zcs-badge-red&quot;; }\n%&gt;\n\t\t\t\t&lt;tr class=&apos;bom-row bom-depth-1&apos;&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-line-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;bom-level&apos;&gt;L1&lt;/span&gt;&lt;%=ifnull(line1.line_number,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;span class=&apos;bom-node&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;% if(child1_found) { %&gt;&lt;a href=&apos;#Report:All_Items?ID=&lt;%=child1_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;%=child1_apn%&gt;&lt;/a&gt;&lt;% } else { %&gt;&lt;span&gt;&lt;%=child1_apn%&gt;&lt;/span&gt;&lt;% } %&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;bom-desc zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=child1_desc%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=ifnull(line1.quantity,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=child1_rev%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=life1_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=child1_lifecycle%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=approval1_class%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=approval1_display%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;% if(child1_found) { %&gt;&lt;div class=&apos;bom-link-stack&apos;&gt;&lt;a class=&apos;bom-mini-link&apos; href=&apos;#Report:All_Items?ID=&lt;%=child1_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;Item&lt;/a&gt;&lt;a class=&apos;bom-mini-link&apos; href=&apos;#Page:BOM_Browser?item_id=&lt;%=child1_id%&gt;&apos; target=&apos;_self&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;Child BOM&lt;/a&gt;&lt;/div&gt;&lt;% } else { %&gt;&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Unavailable&lt;/span&gt;&lt;% } %&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n&lt;%  if(child1_found) { for each line2 in BOM_Line[parent_item == child1_id &amp;&amp; is_struck == false] sort by line_number asc { row_count = row_count + 1; child2 = Item_Master[ID == line2.child_item &amp;&amp; is_deleted == false]; child2_found = child2.count() &gt; 0; if(child2_found) { child2_id = child2.ID; child2_apn = ifnull(child2.apn,&quot;-&quot;); child2_desc = ifnull(child2.description,&quot;-&quot;); child2_rev = ifnull(child2.revision,&quot;-&quot;); child2_lifecycle = ifnull(child2.lifecycle_phase,&quot;Unreleased&quot;); } else { child2_id = 0; child2_apn = &quot;Missing item&quot;; child2_desc = &quot;The child lookup could not be resolved.&quot;; child2_rev = &quot;-&quot;; child2_lifecycle = &quot;Unknown&quot;; } life2_class = &quot;zcs-badge-yellow&quot;; if(child2_lifecycle == &quot;Production&quot;) { life2_class = &quot;zcs-badge-green&quot;; } else if(child2_lifecycle == &quot;Design&quot;) { life2_class = &quot;zcs-badge-blue&quot;; } else if(child2_lifecycle == &quot;Deprecated&quot;) { life2_class = &quot;zcs-badge-orange&quot;; } else if(child2_lifecycle == &quot;Obsolete&quot; || child2_lifecycle == &quot;Abandoned&quot;) { life2_class = &quot;zcs-badge-red&quot;; } else if(child2_lifecycle == &quot;Unreleased&quot;) { life2_class = &quot;zcs-badge-yellow&quot;; } else { life2_class = &quot;zcs-badge-grey&quot;; } approval2 = ifnull(line2.manufacturer_approval_status,&quot;Pending_Review&quot;); approval2_display = approval2.replaceAll(&quot;_&quot;,&quot; &quot;); approval2_class = &quot;zcs-badge-orange&quot;; if(approval2 == &quot;Approved&quot;) { approval2_class = &quot;zcs