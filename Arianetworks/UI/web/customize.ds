customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header { box-shadow: 0 1px 8px rgba(15, 23, 42, 0.08); } .zc-menu { letter-spacing: 0.01em; }"
    }
}
