Validate_Financial_Years as "Validate Financial Years"
{

				type = form
				form = Financial_Years

				record event = on add or edit

				on validate
				{
					actions
					{
						custom deluge script
						(
							if(input.Start_Date != null && input.End_Date != null && input.End_Date < input.Start_Date)
							{
								alert "End Date cannot be before Start Date.";
								cancel submit;
							}
							if(input.Status == "Completed" && input.Completion_Date == null)
							{
								alert "Completion Date is required when the financial year is completed.";
								cancel submit;
							}
						)
					}
				}

			
}