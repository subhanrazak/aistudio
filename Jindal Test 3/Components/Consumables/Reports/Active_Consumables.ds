list Active_Consumables
{

			displayName = "Active Consumables"
			show all rows from Consumables  [Active == true]  
			(
				Consumable_Code
				Consumable_Name
				Category
				Unit_Of_Measure
				Active
				Notes
			)
			filters
			(
				Category
				Unit_Of_Measure
			)
			sort by
			(
				Consumable_Name ascending
			)
		
}