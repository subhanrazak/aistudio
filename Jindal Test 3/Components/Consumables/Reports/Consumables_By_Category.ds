list Consumables_By_Category
{

			displayName = "Consumables By Category"
			show all rows from Consumables    
			(
				Consumable_Code
				Consumable_Name
				Category
				Unit_Of_Measure
				Active
				Notes
			)
			filters
			(
				Category
				Unit_Of_Measure
				Active
			)
			group by
			(
				properties
    			(
  	    			display record count = true
   				)
				Category ascending
			)
			sort by
			(
				Consumable_Name ascending
			)
		
}