Operations_Production_Plans_After_Save as "Operations Production Plans After Save"
{

				type = form
				form = Operations_Production_Plans

				record event = on add or edit

				on success
				{
					actions
					{
						custom deluge script
						(
							if(input.Owner_Email == null)
							{
								input.Owner_Email = zoho.loginuserid;
							}
							currentStatus = input.Status;
							actionValue = input.Approver_Action;
							newStatus = currentStatus;
							auditAction = "Updated";
							shouldAudit = false;
							newRevisionId = null;
							if(actionValue == "Submit" && (currentStatus == "Draft" || currentStatus == "Returned by Operations Approval" || currentStatus == "Revision Requested by SCM" || currentStatus == "Revised Draft"))
							{
								newStatus = "Submitted to Operations Approval";
								auditAction = "Submitted";
								shouldAudit = true;
							}
							else if(actionValue == "Approve" && currentStatus == "Submitted to Operations Approval")
							{
								newStatus = "Operations Approved";
								input.Operations_Approved_By = zoho.loginuserid;
								input.Operations_Approved_On = zoho.currenttime;
								auditAction = "Approved";
								shouldAudit = true;
							}
							else if(actionValue == "Return" && currentStatus == "Submitted to Operations Approval")
							{
								newStatus = "Returned by Operations Approval";
								input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
								auditAction = "Returned";
								shouldAudit = true;
							}
							else if(actionValue == "Create Revision Copy")
							{
								revisionRows = Collection();
								for each productionRow in input.Product_Production_Lines
								{
									newProductionRow = Operations_Production_Plans.Product_Production_Lines();
									newProductionRow.Product = productionRow.Product;
									newProductionRow.Series = productionRow.Series;
									newProductionRow.Width = productionRow.Width;
									newProductionRow.Thickness = productionRow.Thickness;
									newProductionRow.Productivity_MTPH = productionRow.Productivity_MTPH;
									newProductionRow.Month = productionRow.Month;
									newProductionRow.Month_Order = productionRow.Month_Order;
									newProductionRow.Production_Tons = productionRow.Production_Tons;
									newProductionRow.Remarks = productionRow.Remarks;
									revisionRows.insert(newProductionRow);
								}
								newRevisionId = insert into Operations_Production_Plans
								[
									Requested_Financial_Year=input.Requested_Financial_Year
									Budget_Cycle=input.Budget_Cycle
									Plant=input.Plant
									Production_Line=input.Production_Line
									Linked_Availability_Plan=input.Linked_Availability_Plan
									Revision_No=ifNull(input.Revision_No,0) + 1
									Parent_Production_Plan=input.ID
									Product_Production_Lines=revisionRows
									Total_FY_Production_Tons=input.Total_FY_Production_Tons
									Average_Productivity_MTPH=input.Average_Productivity_MTPH
									Status="Revised Draft"
									Iteration_Count=ifNull(input.Iteration_Count,0) + 1
									Locked=false
									Owner_Email=zoho.loginuserid
									Approval_Remarks=input.Approval_Remarks
									Added_User=zoho.loginuser
								];
								newStatus = "Superseded";
								input.Iteration_Count = ifNull(input.Iteration_Count,0) + 1;
								auditAction = "Revision Copy Created";
								shouldAudit = true;
							}
							else if(actionValue == "Lock")
							{
								newStatus = "Locked";
								input.Locked = true;
								auditAction = "Locked";
								shouldAudit = true;
							}
							latestAudit = Approval_Audit_Log[Module_Name == "Operations Production" && Related_Record_ID == input.ID] sort by Action_On desc range from 0 to 0;
							if(latestAudit.count() == 0)
							{
								createdAuditId = insert into Approval_Audit_Log
								[
									Budget_Cycle=input.Budget_Cycle
									Module_Name="Operations Production"
									Related_Record_ID=input.ID
									Related_Record_Display="Production Plan " + input.Operations_Production_No
									Action="Created"
									From_Status=""
									To_Status=currentStatus
									Iteration_Number=input.Iteration_Count
									Actor_Email=zoho.loginuserid
									Action_On=zoho.currenttime
									Remarks="Operations production plan created."
									Added_User=zoho.loginuser
								];
							}
							if(shouldAudit == true)
							{
								input.Status = newStatus;
								auditRemarks = input.Approval_Remarks;
								if(newRevisionId != null)
								{
									auditRemarks = input.Approval_Remarks + " | New revision record ID: " + newRevisionId;
								}
								auditRecordId = insert into Approval_Audit_Log
								[
									Budget_Cycle=input.Budget_Cycle
									Module_Name="Operations Production"
									Related_Record_ID=input.ID
									Related_Record_Display="Production Plan " + input.Operations_Production_No
									Action=auditAction
									From_Status=currentStatus
									To_Status=newStatus
									Iteration_Number=input.Iteration_Count
									Actor_Email=zoho.loginuserid
									Action_On=zoho.currenttime
									Remarks=auditRemarks
									Added_User=zoho.loginuser
								];
								if(newStatus == "Operations Approved")
								{
									cycleRec = Budget_Cycles[ID == input.Budget_Cycle];
									if(cycleRec.count() > 0)
									{
										approvedAvailabilityCount = Capacity_TEP_Plans[Budget_Cycle == input.Budget_Cycle && Status == "Operations Approved"].count();
										if(approvedAvailabilityCount > 0)
										{
											cycleRec.Operations_Approved = true;
											if(cycleRec.Sales_Approved == true)
											{
												cycleRec.Status = "Pending SCM";
											}
											else
											{
												cycleRec.Status = "Pending Sales";
											}
										}
									}
								}
								input.Approver_Action = null;
							}
						)
					}
				}

			
}