list Operations_Production_By_Product
{

			displayName = "Operations Production By Product"
			show all rows from Operations_Production_Plans
			(
				Operations_Production_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Product_Production_Lines
				Total_FY_Production_Tons
				(
					display = total
				)
				Average_Productivity_MTPH
				(
					display = average
				)
				Status
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
			)
			group by
			(
				properties
				(
					display record count = true
				)
				Requested_Financial_Year ascending
				Plant ascending
			)
			sort by
			(
				Operations_Production_No descending
			)
		
}