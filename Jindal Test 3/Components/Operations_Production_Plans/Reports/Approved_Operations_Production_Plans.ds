list Approved_Operations_Production_Plans
{

			displayName = "Approved Operations Production Plans"
			show all rows from Operations_Production_Plans [Status == "Operations Approved"]
			(
				Operations_Production_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Linked_Availability_Plan
				Revision_No
				Product_Production_Lines
				Total_FY_Production_Tons
				(
					display = total
				)
				Average_Productivity_MTPH
				Status
				Operations_Approved_By
				Operations_Approved_On
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
			)
			sort by
			(
				Operations_Production_No descending
			)
		
}