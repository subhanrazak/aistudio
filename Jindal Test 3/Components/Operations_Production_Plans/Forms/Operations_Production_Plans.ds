form Operations_Production_Plans
{

			displayname = "Operations Production Plans"
			Plan_Context
			(
				type = section
				displayname = "Plan Context"
	 			row = 1
	 			column = 0
				width = medium
			)
			Operations_Production_No
			(
    			type = autonumber
				displayname = "Operations Production No"
				start index = 1000
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist
				displayname = "Requested Financial Year"
				values = Financial_Years.ID
    			displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Budget_Cycle
			(
				type = picklist
				displayname = "Budget Cycle"
				values = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			must have Plant
			(
				type = picklist
				values = Plants.ID
    			displayformat = [Plant_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Production_Line
			(
				type = picklist
				displayname = "Production Line"
				values = Production_Lines.ID
    			displayformat = [Line_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Linked_Availability_Plan
			(
				type = picklist
				displayname = "Linked Availability Plan"
				values = Capacity_TEP_Plans.ID
    			displayformat = [Capacity_No]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Revision_No
			(
    			type = number
				displayname = "Revision No"
				initial value = 0
	 			row = 1
	 			column = 2
				width = medium
			)
			Parent_Production_Plan
			(
				type = picklist
				displayname = "Parent Production Plan"
				values = Operations_Production_Plans.ID
    			displayformat = [Operations_Production_No]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Product_Production
			(
				type = section
				displayname = "Product Production"
				visibility = true
	 			row = 2
	 			column = 1
				width = medium
			)
			Product_Production_Lines
			(
				type = grid
				displayname = "Product Production Lines"
				defaultrow = 1
				must have Product
				(
					type = picklist
					values = Steel_Grades.ID
    				displayformat = [Grade_Code]
					width = medium
				)
				Series
				(
					type = text
					width = medium
				)
				Width
				(
					type = text
					width = medium
				)
				Thickness
				(
					type = decimal
					width = medium
				)
				Productivity_MTPH
				(
					type = decimal
					displayname = "Productivity MTPH"
					decimalplace = 3
					width = medium
				)
				must have Month
				(
					type = picklist
					values = Financial_Year_Months.ID
    				displayformat = [Month_Label]
					width = medium
				)
				Month_Order
				(
					type = number
					displayname = "Month Order"
					width = medium
				)
				must have Production_Tons
				(
					type = decimal
					displayname = "Production Tons"
					width = medium
				)
				Remarks
				(
					type = textarea
					height = 80px
					width = medium
				)
	 			row = 2
	 			column = 1
				width = medium
			)
			Totals
			(
				type = section
				displayname = "Totals"
				visibility = true
	 			row = 3
	 			column = 1
				width = medium
			)
			Total_FY_Production_Tons
			(
				type = decimal
				displayname = "Total FY Production Tons"
	 			row = 3
	 			column = 1
				width = medium
			)
			Average_Productivity_MTPH
			(
				type = decimal
				displayname = "Average Productivity MTPH"
				decimalplace = 3
	 			row = 3
	 			column = 2
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 4
	 			column = 1
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Operations Approval","Returned by Operations Approval","Operations Approved","Revision Requested by SCM","Revised Draft","Superseded","Locked"}
				initial value = "Draft"
	 			row = 4
	 			column = 1
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Create Revision Copy","Lock"}
	 			row = 4
	 			column = 2
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 4
	 			column = 1
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 4
	 			column = 2
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 4
	 			column = 1
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 4
	 			column = 2
				width = medium
			)
			Operations_Approved_By
			(
    			type = email
				displayname = "Operations Approved By"
	 			row = 4
	 			column = 1
				width = medium
			)
			Operations_Approved_On
			(
				type = datetime
				displayname = "Operations Approved On"
	 			row = 4
	 			column = 2
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}