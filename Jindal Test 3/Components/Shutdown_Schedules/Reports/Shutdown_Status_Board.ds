kanban Shutdown_Status_Board
{

			displayName = "Shutdown Status Board"
			show all rows from Shutdown_Schedules    
			(
				Shutdown_No
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Annual_Shutdown_Days
				Status
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Production_Line
				Shutdown_Type
				Status
			)
			sort by
			(
				Budget_Cycle descending
				Production_Line ascending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order  = ascending
				record count  = enable
	 		)
		
}