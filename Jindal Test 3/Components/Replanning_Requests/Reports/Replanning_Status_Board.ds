kanban Replanning_Status_Board
{

			displayName = "Replanning Status Board"
			show all rows from Replanning_Requests
			(
				Replan_No
				Parent_Budget_Cycle
				New_Revision_Cycle
				Requested_Financial_Year
				Affected_Modules
				Source_Module
				Requested_By_Email
				Request_Date
				Status
			)
			filters
			(
				Parent_Budget_Cycle
				Requested_Financial_Year
				Source_Module
				Status
				Requested_By_Email
				Request_Date
			)
			sort by
			(
				Request_Date descending
			)
			options
			(
	 			display field = Status
				sort order = ascending
				record count = enable
	 		)
		
}