list Active_Replanning_Requests
{

			displayName = "Active Replanning Requests"
			show all rows from Replanning_Requests [Status != "Rejected" && Status != "Locked"]
			(
				Replan_No
				Parent_Budget_Cycle
				New_Revision_Cycle
				Requested_Financial_Year
				Affected_Modules
				Source_Module
				Source_Record_ID
				New_Revision_Record_ID
				Requested_By_Email
				Request_Date
				Status
				Approver_Action
				Approval_Remarks
			)
			filters
			(
				Parent_Budget_Cycle
				Requested_Financial_Year
				Source_Module
				Status
				Requested_By_Email
				Request_Date
			)
			sort by
			(
				Request_Date descending
			)
		
}