form Raw_Material_Budgets
{

			displayname = "Raw Material Budgets"
			Budget_Context
			(
				type = section
				displayname = "Budget Context"
	 			row = 1
	 			column = 0   
				width = medium
			)
			RM_Budget_No
			(
    			type = autonumber
				displayname = "RM Budget No"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Cycle
			(
				type = picklist	
				displayname = "Budget Cycle"
				values  = Budget_Cycles.ID
    			displayformat = [Cycle_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist
				displayname = "Requested Financial Year"
				values = Financial_Years.ID
    			displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			must have Plant
			(
				type = picklist	
				values  = Plants.ID
    			displayformat = [Plant_Name]
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Material
			(
				type = picklist	
				values  = Raw_Materials.ID
    			displayformat = [Material_Name]
	 			row = 1
	 			column = 2
				width = medium
			)
			Price_Assumptions
			(
				type = section
				displayname = "Price Assumptions"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Previous_Year_Price
			(
				type = decimal
				displayname = "Previous Year Price"
				format = commadotindian
	 			row = 2
	 			column = 1   
				width = medium
			)
			Market_Price_Month_1
			(
				type = decimal
				displayname = "Market Price Month 1"
				format = commadotindian
	 			row = 2
	 			column = 2   
				width = medium
			)
			Market_Price_Month_2
			(
				type = decimal
				displayname = "Market Price Month 2"
				format = commadotindian
	 			row = 2
	 			column = 1   
				width = medium
			)
			Market_Price_Month_3
			(
				type = decimal
				displayname = "Market Price Month 3"
				format = commadotindian
	 			row = 2
	 			column = 2   
				width = medium
			)
			Budget_Price
			(
    			type = textarea
				displayname = "Budget Price"
	 			row = 2
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  (ifNull(input.Market_Price_Month_1,0) + ifNull(input.Market_Price_Month_2,0) + ifNull(input.Market_Price_Month_3,0)) / 3
    						visibility = true
    						format = plaintext
    			)
			)
			Monthly_Requirements
			(
				type = section
				displayname = "Monthly RM Budget Lines"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Monthly_RM_Budget_Lines
			(
				type = grid
				displayname = "Monthly RM Budget Lines"
				defaultrow = 1
				maxrow = 12
				must have Month
				(
					type = picklist
					values = {"Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec","Jan","Feb","Mar"}
					width = medium
				)
				Month_Order
				(
					type = number
					displayname = "Month Order"
					width = medium
				)
				Requirement_MT
				(
					type = decimal
					displayname = "Requirement MT"
					width = medium
				)
				Available_Raw_Material_MT
				(
					type = decimal
					displayname = "Available Raw Material MT"
					width = medium
				)
				Required_Raw_Material_MT
				(
					type = decimal
					displayname = "Required Raw Material MT"
					width = medium
				)
				To_Be_Raised_MT
				(
					type = decimal
					displayname = "To Be Raised MT"
					width = medium
				)
				Cost_Forecast
				(
					type = decimal
					displayname = "Cost Forecast"
					width = medium
				)
				Override_Reason
				(
					type = textarea
					displayname = "Override Reason"
					height = 80px
					width = medium
				)
				Scrap_Percent
				(
					type = decimal
					displayname = "Scrap Percent"
					width = medium
				)
				NPI_Percent
				(
					type = decimal
					displayname = "NPI Percent"
					width = medium
				)
				Ferro_Nickel_Percent
				(
					type = decimal
					displayname = "Ferro Nickel Percent"
					width = medium
				)
				Pure_Metal_Percent
				(
					type = decimal
					displayname = "Pure Metal Percent"
					width = medium
				)
	 			row = 3
	 			column = 1   
				width = medium
			)
			Annual_Requirement_MT
			(
				type = decimal
				displayname = "Annual Requirement MT"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Available_Raw_Material_Total_MT
			(
				type = decimal
				displayname = "Available Raw Material Total MT"
	 			row = 3
	 			column = 2
				width = medium
			)
			To_Be_Raised_Total_MT
			(
				type = decimal
				displayname = "To Be Raised Total MT"
	 			row = 3
	 			column = 1
				width = medium
			)
			Cost_Forecast_Total
			(
				type = decimal
				displayname = "Cost Forecast Total"
	 			row = 3
	 			column = 2
				width = medium
			)
			Inventory_Cost
			(
				type = section
				displayname = "Inventory Cost"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Lead_Time_Days
			(
				type = number
				displayname = "Lead Time Days"
	 			row = 4
	 			column = 1   
				width = medium
			)
			In_Plant_Inventory_MT
			(
				type = decimal
				displayname = "In Plant Inventory MT"
	 			row = 4
	 			column = 2   
				width = medium
			)
			In_Transit_Inventory_MT
			(
				type = decimal
				displayname = "In Transit Inventory MT"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Inventory_Value
			(
    			type = textarea
				displayname = "Inventory Value"
	 			row = 4
	 			column = 2   
				width = medium
    			Formula_Properties
    			(
    						value =  (ifNull(input.In_Plant_Inventory_MT,0) + ifNull(input.In_Transit_Inventory_MT,0)) * ifNull((ifNull(input.Market_Price_Month_1,0) + ifNull(input.Market_Price_Month_2,0) + ifNull(input.Market_Price_Month_3,0)) / 3,0)
    						visibility = true
    						format = plaintext
    			)
			)
			Total_Raw_Material_Cost
			(
    			type = textarea
				displayname = "Total Raw Material Cost"
	 			row = 4
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  ifNull(input.Annual_Requirement_MT,0) * ifNull((ifNull(input.Market_Price_Month_1,0) + ifNull(input.Market_Price_Month_2,0) + ifNull(input.Market_Price_Month_3,0)) / 3,0)
    						visibility = true
    						format = plaintext
    			)
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Sourcing Manager","Returned by Sourcing Manager","Submitted to Finance","Returned by Finance","Approved","Locked","Reopened"}
				initial value = "Draft"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Reopen","Lock"}
	 			row = 5
	 			column = 2   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 13px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 5
	 			column = 2   
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 5
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}