report SCM_Revision_Requests
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Consolidation_No
                    Requested_Financial_Year
                    Budget_Cycle
                    Plant
                    Sales_Plan
                    SCM_Decision
                    Latest_Revision_No
                    Status
                    Owner_Email
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
            record ( Edit Duplicate Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit Delete Duplicate View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Consolidation_No
                    Requested_Financial_Year
                    Budget_Cycle
                    Plant
                    Sales_Plan
                    Availability_Plan
                    Operations_Production_Plan
                    SCM_Decision
                    Revision_History_Lines
                    Latest_Revision_No
                    Status
                    Owner_Email
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
        )
    )
}