kanban Consolidation_Status_Board
{

			displayName = "Consolidation Status Board"
			show all rows from Volume_Consolidations
			(
				Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Sales_Plan
				Operations_Production_Plan
				SCM_Decision
				Latest_Revision_No
				Status
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				SCM_Decision
				Status
				Locked
				Owner_Email
			)
			sort by
			(
				Consolidation_No descending
			)
			options
			(
	 			display field = Status
	 			emptycolumn = "No Status"
				sort order = custom
				record count = enable
	 		)
		
}