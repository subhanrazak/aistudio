default list All_Sales_Plans
{

			displayName = "All Sales Plans"
			show all rows from Sales_Plans
			(
				Sales_Plan_No
				Requested_Financial_Year
				Budget_Cycle
				Revision_No
				Parent_Sales_Plan
				Total_Grade_Target_Tons
				Total_Product_Required_Tons
				Variance_Tons
				Status
				Approver_Action
				Owner_Email
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Sales_Plan_No descending
			)
		
}