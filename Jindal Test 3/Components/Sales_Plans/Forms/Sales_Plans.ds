form Sales_Plans
{

			displayname = "Sales Plans"
			Plan_Context
			(
				type = section
				displayname = "Plan Context"
	 			row = 1
	 			column = 0
				width = medium
			)
			Sales_Plan_No
			(
    			type = autonumber
				displayname = "Sales Plan No"
				start index = 1000
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Requested_Financial_Year
			(
				type = picklist
				displayname = "Requested Financial Year"
				values = Financial_Years.ID
    			displayformat = [Year_Name]
				searchable = true
	 			row = 1
	 			column = 1
				width = medium
			)
			Budget_Cycle
			(
				type = picklist
				displayname = "Budget Cycle"
				values = Budget_Cycles.ID
    			displayformat = [Cycle_Name]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Revision_No
			(
    			type = number
				displayname = "Revision No"
				initial value = 0
	 			row = 1
	 			column = 1
				width = medium
			)
			Parent_Sales_Plan
			(
				type = picklist
				displayname = "Parent Sales Plan"
				values = Sales_Plans.ID
    			displayformat = [Sales_Plan_No]
				searchable = true
	 			row = 1
	 			column = 2
				width = medium
			)
			Sales_Demand
			(
				type = section
				displayname = "Sales Demand"
				visibility = false
	 			row = 2
	 			column = 1
				width = medium
			)
			Grade_Demand_Lines
			(
				type = grid
				displayname = "Grade Demand Lines"
				defaultrow = 1
				must have Grade
				(
					type = picklist
					values = Market_Segments.ID
    				displayformat = [Segment_Name]
					width = medium
				)
				Actual_Year_3_MT
				(
					type = decimal
					displayname = "Actual Year 3 MT"
					width = medium
				)
				Actual_Year_2_MT
				(
					type = decimal
					displayname = "Actual Year 2 MT"
					width = medium
				)
				Actual_Year_1_MT
				(
					type = decimal
					displayname = "Actual Year 1 MT"
					width = medium
				)
				Actual_3_Year_Growth_Percent
				(
					type = decimal
					displayname = "Actual 3 Year Growth Percent"
					width = medium
				)
				Current_Year_Growth_Percent
				(
					type = decimal
					displayname = "Current Year Growth Percent"
					width = medium
				)
				Expected_Growth_Percent
				(
					type = decimal
					displayname = "Expected Growth Percent"
					width = medium
				)
				Current_Year_Produced_Tons
				(
					type = decimal
					displayname = "Current Year Produced Tons"
					width = medium
				)
				must have Target_Tons_Needed
				(
					type = decimal
					displayname = "Target Tons Needed"
					width = medium
				)
	 			row = 2
	 			column = 1
				width = medium
			)
			Product_Split
			(
				type = section
				displayname = "Product Split"
				visibility = false
	 			row = 3
	 			column = 1
				width = medium
			)
			Product_Split_Lines
			(
				type = grid
				displayname = "Product Split Lines"
				defaultrow = 1
				must have Grade
				(
					type = picklist
					values = Market_Segments.ID
    				displayformat = [Segment_Name]
					width = medium
				)
				must have Product
				(
					type = picklist
					values = Steel_Grades.ID
    				displayformat = [Grade_Code]
					width = medium
				)
				Series
				(
					type = text
					width = medium
				)
				must have Required_Tons
				(
					type = decimal
					displayname = "Required Tons"
					width = medium
				)
				Remarks
				(
					type = textarea
					height = 80px
					width = medium
				)
	 			row = 3
	 			column = 1
				width = medium
			)
			Totals
			(
				type = section
				displayname = "Totals"
				visibility = true
	 			row = 4
	 			column = 1
				width = medium
			)
			Total_Grade_Target_Tons
			(
				type = decimal
				displayname = "Total Grade Target Tons"
	 			row = 4
	 			column = 1
				width = medium
			)
			Total_Product_Required_Tons
			(
				type = decimal
				displayname = "Total Product Required Tons"
	 			row = 4
	 			column = 2
				width = medium
			)
			Variance_Tons
			(
				type = decimal
				displayname = "Variance Tons"
	 			row = 4
	 			column = 1
				width = medium
			)
			Approval_Status
			(
				type = section
				displayname = "Approval Status"
				visibility = true
	 			row = 5
	 			column = 1
				width = medium
			)
			must have Status
			(
				type = picklist
				values = {"Draft","Submitted to Sales Management","Returned by Sales Management","Sales Approved","Revision Requested by SCM","Revised Draft","Superseded","Locked"}
				initial value = "Draft"
	 			row = 5
	 			column = 1
				width = medium
			)
			Approver_Action
			(
				type = picklist
				displayname = "Approver Action"
				values = {"Submit","Approve","Return","Create Revision Copy","Lock"}
	 			row = 5
	 			column = 2
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				displayname = "Approval Remarks"
				height = 80px
	 			row = 5
	 			column = 1
				width = medium
			)
			Iteration_Count
			(
				type = number
				displayname = "Iteration Count"
				initial value = 0
	 			row = 5
	 			column = 2
				width = medium
			)
			Locked
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1
				width = medium
			)
			Ownership_Audit
			(
				type = section
				displayname = "Ownership Audit"
				visibility = true
	 			row = 6
	 			column = 1
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
	 			row = 6
	 			column = 1
				width = medium
			)
			Sales_Approved_By
			(
    			type = email
				displayname = "Sales Approved By"
	 			row = 6
	 			column = 2
				width = medium
			)
			Sales_Approved_On
			(
				type = datetime
				displayname = "Sales Approved On"
	 			row = 6
	 			column = 1
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}