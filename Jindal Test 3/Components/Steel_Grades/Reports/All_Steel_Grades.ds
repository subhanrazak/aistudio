default list All_Steel_Grades
{

			displayName = "All Products"
			show all rows from Steel_Grades
			(
				Grade_Code as "Product Code"
				Grade_Name as "Product Name"
				Grade_Series as "Series"
				Nickel_Content_Percent
				Active
				Notes
			)
			filters
			(
				Grade_Series
				Active
			)
			sort by
			(
				Grade_Code ascending
			)
		
}