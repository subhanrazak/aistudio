list Validated_Capacity_Plans
{

			displayName = "Validated Capacity Plans"
			show all rows from Capacity_TEP_Plans  [Status == "Operations Approved"]
			(
				Capacity_No
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Annual_Calendar_Hours
				Annual_Available_Hours
				Annual_Net_Running_Hours
				Average_Equipment_Availability_Percent
				Average_Equipment_Utilization_Percent
				Operations_Approved_By
				Operations_Approved_On
				Status
				Locked
				Owner_Email
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Plant
				Production_Line
				Status
				Locked
			)
			sort by
			(
				Operations_Approved_On descending
				Capacity_No descending
			)
		
}