default list All_Approval_Audit_Logs
{

			displayName = "All Approval Audit Logs"
			show all rows from Approval_Audit_Log    
			(
				Budget_Cycle
				Module_Name
				Related_Record_ID
				Related_Record_Display
				Action
				From_Status
				To_Status
				Iteration_Number
				Actor_Email
				Acting_On_Behalf_Of
				Action_On
				(
					displayformat = fulldate
				)
				Remarks
			)
			filters
			(
				Budget_Cycle
				Module_Name
				Action
				Actor_Email
				Action_On
			)
			sort by
			(
				Action_On descending
			)
		
}