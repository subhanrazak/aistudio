default list All_SMS_Capacity_Plans
{

			displayName = "All SMS Capacity Plans"
			show all rows from SMS_Capacity_Plans    
			(
				SMS_Plan_No
				Budget_Cycle
				Plant
				Melting_Unit
				Previous_Year_Output_MT
				Total_Steel_Availability_BTV
				Status
				Approver_Action
				Approval_Remarks
				Iteration_Count
				Locked
				Owner_Email
			)
			filters
			(
				Budget_Cycle
				Plant
				Melting_Unit
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				SMS_Plan_No descending
			)
		
}