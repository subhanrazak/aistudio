list Nickel_Source_Materials
{

			displayName = "Nickel Source Materials"
			show all rows from Raw_Materials  [Is_Nickel_Source == true]  
			(
				Material_Code
				Material_Name
				Material_Group
				Unit_Of_Measure
				Is_Nickel_Source
				Active
				Notes
			)
			filters
			(
				Material_Group
				Unit_Of_Measure
				Is_Nickel_Source
				Active
			)
			sort by
			(
				Material_Name ascending
			)
		
}