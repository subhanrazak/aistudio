list Completed_Budget_Cycles
{

			displayName = "Completed Budget Cycles"
			show all rows from Budget_Cycles  [Status == "Completed"]
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Opened_Date
				Status
				Finance_Completed
				Baseline_Locked
				Approved_Scenario
				Completion_Date
				Owner_Email
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
			)
			sort by
			(
				Completion_Date descending
				Cycle_Code ascending
			)
		
}