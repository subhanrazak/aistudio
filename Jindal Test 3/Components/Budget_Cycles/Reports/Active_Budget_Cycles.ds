list Active_Budget_Cycles
{

			displayName = "Active Budget Cycles"
			show all rows from Budget_Cycles  [Status != "Completed" && Status != "Closed"]
			(
				Cycle_Code
				Cycle_Name
				Financial_Year
				Cycle_Type
				Scenario
				Opened_Date
				Status
				Sales_Approved
				Operations_Approved
				SCM_Approved
				Finance_Completed
				Owner_Email
			)
			filters
			(
				Financial_Year
				Cycle_Type
				Scenario
				Status
			)
			sort by
			(
				Opened_Date descending
				Cycle_Code ascending
			)
		
}