report Completed_Budget_Cycles
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Cycle_Code
                    Cycle_Name
                    Financial_Year
                    Cycle_Type
                    Scenario
                    Status
                    Finance_Completed
                    Completion_Date
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
            record ( Edit Duplicate Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit Delete Duplicate View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Cycle_Code
                    Cycle_Name
                    Financial_Year
                    Cycle_Type
                    Scenario
                    Opened_Date
                    Status
                    Finance_Completed
                    Baseline_Locked
                    Approved_Scenario
                    Completion_Date
                    Owner_Email
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
        )
    )
}