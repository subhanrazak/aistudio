default list All_Financial_Consolidations
{

			displayName = "All Financial Consolidations"
			show all rows from Financial_Consolidations
			(
				Financial_Consolidation_No
				Requested_Financial_Year
				Budget_Cycle
				SCM_Consolidation
				Scenario
				Volume_MT
				Revenue
				Raw_Material_Cost
				Consumables_Cost
				HR_Cost
				Logistics_Cost
				IT_Cost
				Other_Support_Costs
				Total_Other_Cost
				Total_Cost
				EBITDA
				EBITDA_Margin_Percent
				Management_Decision
				Status
				Approver_Action
				Approval_Remarks
				Owner_Email
				Iteration_Count
				Locked
			)
			filters
			(
				Requested_Financial_Year
				Budget_Cycle
				Scenario
				Management_Decision
				Status
				Owner_Email
				Locked
			)
			sort by
			(
				Financial_Consolidation_No descending
			)
		
}