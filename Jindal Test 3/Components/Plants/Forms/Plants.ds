form Plants
{

			Plant_Details
			(
				type = section
				displayname = "Plant Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Plant_Code
			(
    			type = text
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Plant_Name
			(
    			type = text
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Location
			(
				type = picklist
				values = {"Hisar","Jajpur","Mundra"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			State
			(
    			type = text
				maxchar = 60
	 			row = 1
	 			column = 2   
				width = medium
			)
			Plant_Head_Email
			(
    			type = email
	 			row = 1
	 			column = 1   
				width = medium
			)
			Finance_Contact_Email
			(
    			type = email
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}