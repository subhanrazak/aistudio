default list All_Plants
{

			displayName = "All Plants"
			show all rows from Plants    
			(
				Plant_Code
				Plant_Name
				Location
				State
				Plant_Head_Email
				Finance_Contact_Email
				Active
				Notes
			)
			filters
			(
				Location
				Active
			)
			sort by
			(
				Plant_Code ascending
			)
		
}