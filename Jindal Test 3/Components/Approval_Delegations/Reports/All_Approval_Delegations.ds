default list All_Approval_Delegations
{

			displayName = "All Approval Delegations"
			show all rows from Approval_Delegations    
			(
				Delegator_Email
				Delegate_Email
				Profile_Name
				Module_Name
				Start_Date
				End_Date
				Active
				Reason
			)
			filters
			(
				Profile_Name
				Module_Name
				Active
				Start_Date
				End_Date
			)
			sort by
			(
				Start_Date descending
			)
		
}