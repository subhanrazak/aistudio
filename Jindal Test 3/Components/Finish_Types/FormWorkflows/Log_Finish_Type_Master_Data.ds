Log_Finish_Type_Master_Data as "Log Finish Type Master Data"
{

				type =  form
				form = Finish_Types

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											auditId = insert into Approval_Audit_Log
										[
											Module_Name="Finish Type"
											Related_Record_ID=input.ID
											Related_Record_Display=input.Finish_Code + " - " + input.Finish_Name
											Action="Saved"
											To_Status=input.Active
											Actor_Email=zoho.loginuserid
											Action_On=zoho.currenttime
											Remarks="Finish type master data change logged by system workflow."
											Added_User=zoho.loginuser
										];
										info "Finish Type master-data saved: " + input.Finish_Code;
						)
					}
				}

			
}