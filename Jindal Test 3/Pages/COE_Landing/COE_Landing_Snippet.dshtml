<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "COE Team";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	coeQueue = Sales_Plans[Status == "Submitted to COE"].count();
	returned = Sales_Plans[Status.contains("Returned")].count();
	submittedNext = Sales_Plans[Status == "Submitted to SCM" || Status == "Submitted to Operations"].count();
	approved = Sales_Plans[Status == "Approved and Locked"].count();
	segments = Market_Segments[ID != 0].count();
	grades = Steel_Grades[ID != 0].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>COE Department Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Validate sales plan completeness and move clean plans to downstream review.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:COE_Sales_Plan_Approval_Queue'><span>COE pending</span><strong><%=coeQueue%></strong><span>Sales plans waiting for COE action</span></a><a class='dl-card' href='#Report:All_Sales_Plans'><span>Returned plans</span><strong><%=returned%></strong><span>Rows returned to owners</span></a><a class='dl-card' href='#Report:Sales_Plan_Approval_Queue'><span>Moved forward</span><strong><%=submittedNext%></strong><span>Rows sent to SCM or Operations</span></a><a class='dl-card' href='#Report:Approved_Sales_Plans'><span>Approved</span><strong><%=approved%></strong><span>Final approved sales plans</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Report:COE_Sales_Plan_Approval_Queue'><span><i class='zc-li-outline business-signature dl-icon'></i> Review COE approval queue</span><b><%=coeQueue%></b></a><a class='dl-action' href='#Report:Sales_Plan_Status_Board'><span><i class='zc-li-outline business-progress dl-icon'></i> Track sales plan status</span><b><%=coeQueue + submittedNext%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Reference coverage</strong><div class='dl-muted'><%=segments%> market segments and <%=grades%> steel grades support COE validation.</div></div><div class='dl-insight'><strong>Exception watch</strong><div class='dl-muted'><%=returned%> returned rows indicate quality or approval feedback to resolve.</div></div></div></div></div>