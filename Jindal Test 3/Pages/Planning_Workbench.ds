<page linkname = "Planning_Workbench" displayname = "Planning Workbench"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='My_Task_Cards' elementName='My_Task_Cards' bgColor=''>
          <![CDATA[htmlpage My_Task_Cards()
content
			<%{%>
            <file name:My_Task_Cards.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Department_Queue_Grid' elementName='Department_Queue_Grid' bgColor=''>
          <![CDATA[htmlpage Department_Queue_Grid()
content
			<%{%>
            <file name:Department_Queue_Grid.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:My_Sales_Plan_Workqueue.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Sales_Plan_Approval_Queue.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Shortfall_Buckets.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Active_Replanning_Requests.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Critical_Audit_Events.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='Action_Guidance' elementName='Action_Guidance' bgColor=''>
          <![CDATA[htmlpage Action_Guidance()
content
			<%{%>
            <file name:Action_Guidance.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
	</layout>
</zml>
</content>