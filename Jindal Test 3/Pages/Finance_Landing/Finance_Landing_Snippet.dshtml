<%
	loginName = zoho.loginuser;
	loginEmail = zoho.loginuserid;
	profileText = "Finance Costing";
	if(thisapp.permissions.isUserInProfile("System_Administrator"))
	{
		profileText = "System Administrator";
	}
	activeCycles = Budget_Cycles[Status == "Open" || Status == "In Planning" || Status == "Under Review" || Status == "Reopened"].count();
	financeDrafts = Financial_Consolidations[Owner_Email == loginEmail || Owner_Email == loginName && Status == "Draft" || Status.contains("Returned") || Status == "Reopened"].count();
	managementQueue = Financial_Consolidations[Status == "Submitted to Management"].count();
	rmFinance = Raw_Material_Budgets[Status == "Submitted to Finance"].count();
	consFinance = Consumables_Budgets[Status == "Submitted to Finance"].count();
	replanQueue = Replanning_Requests[Status == "Submitted to Finance" || Status == "Finance Approved" || Status == "Revision Created"].count();
	finalBudgets = Financial_Consolidations[Status == "Approved Final" || Status == "Locked" || Locked == true].count();
	%>
<style>.dl-shell{background:#f3f3f4;padding:20px;box-sizing:border-box}.dl-hero{background:linear-gradient(135deg,var(--zcs_brand_color),#1c3d5a);color:var(--zcs_brand_foreground_color);border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.dl-hero h2{margin:0 0 6px;font-size:24px}.dl-hero p{margin:0;opacity:.9}.dl-badge{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:7px 12px}.dl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dl-card,.dl-panel{background:#fff;border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;padding:18px;box-sizing:border-box}.dl-card{text-decoration:none;color:inherit;display:block}.dl-card span,.dl-muted{color:var(--zcs_secondary_text_color);font-size:13px}.dl-card strong{display:block;font-size:30px;line-height:1.1;margin:10px 0}.dl-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.dl-panel h3{margin:0 0 12px;font-size:18px}.dl-action{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;border:1px solid var(--zcs_tertiary_border_color);border-radius:10px;margin-top:10px;text-decoration:none;color:inherit}.dl-action:hover,.dl-card:hover{border-color:var(--zcs_brand_color)}.dl-action b{color:var(--zcs_brand_color);font-size:20px}.dl-insight{border-left:3px solid var(--zcs_brand_color);padding-left:12px;margin-top:12px}.dl-icon{color:var(--zcs_brand_color)}@media(max-width:900px){.dl-grid,.dl-layout{grid-template-columns:1fr}.dl-hero{flex-direction:column;align-items:flex-start}}</style>
<div class='dl-shell'><div class='dl-hero'><div><h2>Finance & Costing Landing</h2><p>Signed in as <strong><%=loginName%></strong> (<%=loginEmail%>). Coordinate cycles, financial consolidation, replanning and final budget readiness.</p></div><span class='dl-badge'><i class='zc-li-outline users-single-01'></i><%=profileText%></span></div><div class='dl-grid'><a class='dl-card' href='#Report:Active_Budget_Cycles'><span>Active cycles</span><strong><%=activeCycles%></strong><span>Cycles in planning or review</span></a><a class='dl-card' href='#Report:All_Financial_Consolidations'><span>My finance drafts</span><strong><%=financeDrafts%></strong><span>Draft, returned or reopened consolidations</span></a><a class='dl-card' href='#Report:Scenario_Financial_Summary'><span>Management queue</span><strong><%=managementQueue%></strong><span>Financial consolidations awaiting management</span></a><a class='dl-card' href='#Report:Approved_Final_Budgets'><span>Final budgets</span><strong><%=finalBudgets%></strong><span>Approved or locked final budget records</span></a></div><div class='dl-layout'><div class='dl-panel'><h3>Pending actions</h3><a class='dl-action' href='#Report:All_Financial_Consolidations'><span><i class='zc-li-outline business-money-growth dl-icon'></i> Complete finance consolidation</span><b><%=financeDrafts%></b></a><a class='dl-action' href='#Report:All_Raw_Material_Budgets'><span><i class='zc-li-outline business-calculator dl-icon'></i> Raw material budget finance review</span><b><%=rmFinance%></b></a><a class='dl-action' href='#Report:All_Consumables_Budgets'><span><i class='zc-li-outline business-math dl-icon'></i> Consumables finance review</span><b><%=consFinance%></b></a><a class='dl-action' href='#Report:Active_Replanning_Requests'><span><i class='zc-li-outline arrows-1-refresh-69 dl-icon'></i> Replanning requests</span><b><%=replanQueue%></b></a></div><div class='dl-panel'><h3>Department insights</h3><div class='dl-insight'><strong>Financial handoff</strong><div class='dl-muted'><%=managementQueue%> records are positioned for management decision.</div></div><div class='dl-insight'><strong>Cross-functional load</strong><div class='dl-muted'><%=rmFinance + consFinance%> sourcing or plant submissions need finance attention.</div></div></div></div></div>