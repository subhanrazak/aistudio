			 			column = 1   
						width = medium
					)
					effective_from
					(
		    			type = date
						displayname = "Effective From"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					effective_to
					(
		    			type = date
						displayname = "Effective To"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
