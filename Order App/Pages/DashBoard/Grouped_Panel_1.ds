<panel elementName='Grouped_Panel 1' title='Fulfillment Status' titleSize='15px'>
									<pr width='fill' height='fill'>
										<pc paddingTop='10px' paddingLeft='0px' paddingRight='0px' paddingBottom='0px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle'>
											<pr width='fill' height='fill'>
												<pc padding='17px' bgColor='#FFFFFF' width='24%' hAlign='left' vAlign='middle'>
													<pr width='auto' height='auto'>
														<pc>
															<image marginLeft='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#1ABE75' width='52px' height='52px' type='icon' value='design-2-cursor-not-allowed' size='20px' cornerRadius='10px' iconType='outline' /> </pc>
														<pc hAlign='left'>
															<pr>
																<pc>
																	<text marginLeft='20px' color='#3F3F3F' size='22px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='fulfillment_status == &quot;Not Started&quot;' value='thisapp.orders.fulfillment_status.count'>
																	</text>

																</pc>
															</pr>
															<pr>
																<pc>
																	<text marginLeft='20px' marginRight='0px' marginTop='3px' color='#909090' size='14px' type='Text' value='Not Started'>
																	</text>

																</pc>
															</pr>
														</pc>
													</pr>
												</pc>
												<pc paddingTop='17px' paddingLeft='0px' paddingRight='17px' paddingBottom='17px' width='24%' hAlign='center'>
													<pr width='auto' height='auto'>
														<pc>
															<image marginLeft='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#E2335C' width='52px' height='52px' type='icon' value='design-2-cursor-not-allowed' size='20px' cornerRadius='10px' iconType='outline' /> </pc>
														<pc hAlign='left'>
															<pr>
																<pc>
																	<text marginLeft='20px' color='#3F3F3F' size='22px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='fulfillment_status == &quot;Failed&quot;' value='thisapp.orders.fulfillment_status.count'>
																	</text>

																</pc>
															</pr>
															<pr>
																<pc>
																	<text marginLeft='20px' marginRight='0px' marginTop='3px' color='#909090' size='14px' type='Text' value='Failed'>
																	</text>

																</pc>
															</pr>
														</pc>
													</pr>
												</pc>
												<pc paddingTop='17px' paddingLeft='0px' paddingRight='17px' paddingBottom='17px' width='25%' hAlign='center'>
													<pr width='auto' height='auto'>
														<pc>
															<image marginLeft='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#1678F9' width='52px' height='52px' type='icon' value='design-todo' size='22px' cornerRadius='10px' iconType='outline' /> </pc>
														<pc hAlign='left'>
															<pr>
																<pc>
																	<text marginLeft='20px' color='#3F3F3F' size='22px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='fulfillment_status == &quot;Completed&quot;' value='thisapp.orders.fulfillment_status.count'>
																	</text>

																</pc>
															</pr>
															<pr>
																<pc>
																	<text marginLeft='20px' marginRight='0px' marginTop='3px' color='#909090' size='14px' type='Text' value='Completed'>
																	</text>

																</pc>
															</pr>
														</pc>
													</pr>
												</pc>
												<pc paddingTop='17px' paddingLeft='0px' paddingRight='17px' paddingBottom='17px' width='27%' hAlign='center'>
													<pr width='auto' height='auto'>
														<pc>
															<image marginLeft='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#F6BC2B' width='52px' height='52px' type='icon' value='loader-refresh' size='22px' cornerRadius='10px' iconType='outline' /> </pc>
														<pc hAlign='left'>
															<pr>
																<pc>
																	<text marginLeft='20px' color='#3F3F3F' size='20px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='fulfillment_status == &quot;In Progress&quot;' value='thisapp.orders.fulfillment_status.count'>
																	</text>

																</pc>
															</pr>
															<pr>
																<pc>
																	<text marginLeft='20px' marginRight='0px' marginTop='3px' color='#909090' size='14px' type='Text' value='In Progress'>
																	</text>

																</pc>
															</pr>
														</pc>
													</pr>
												</pc>
											</pr>
										</pc>
									</pr>
</panel>