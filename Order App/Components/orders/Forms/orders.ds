form orders
{

			displayname = "Orders"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order_id
			(
    			type = autonumber
				displayname = "Order ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer
			(
				type = picklist	
				displayname = "Customer"
				values  = customers.ID
    			displayformat = [customer_display_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			salesperson
			(
				type = picklist	
				displayname = "Salesperson"
				values  = sales_orders.ID
    			displayformat = [created_time]
				allow new entries
				[
					displayname = "Add New"
				]
				advanced field search = true
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			order_date
			(
    			type = date
				displayname = "Order Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			expected_shipment_date
			(
    			type = date
				displayname = "Expected Shipment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Draft","Delivered","Shipped","Confirmed","Cancelled","Processing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","URGENT","Low","Medium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount
			(
				displayname = "Total Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			currency
			(
    			type = text
				displayname = "Currency"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fulfillment_status
			(
				type = picklist
				displayname = "Fulfillment Status"
				values = {"Not Started","Failed","Completed","In Progress"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			tracking_number
			(
    			type = text
				displayname = "Tracking Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Order Placed","Order Confirmed","Order Pending Payment","Order Cancelled","Order Processed","Order Shipped","Order On Hold","Order Delivered","Order Returned","Order Lost","Order Closed","Order Refunded","Order Replacement Shipped"}
			}
		
}