list orders_Report
{

			displayName = "Orders Report"
			show all rows from orders    
			(
				order_id as "Order ID"
				customer as "Customer"
				salesperson as "Salesperson"
				order_date as "Order Date"
				expected_shipment_date as "Expected Shipment Date"
				status as "Status"
				priority as "Priority"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				currency as "Currency"
				fulfillment_status as "Fulfillment Status"
				tracking_number as "Tracking Number"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "URGENT")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		
}