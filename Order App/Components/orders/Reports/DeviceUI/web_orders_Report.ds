								billing_address_pin_code as "Billing Address - Pin Code"
								billing_address_state as "Billing Address - State"
								billing_address_street2 as "Billing Address - Street2"
								company_name as "Company Name"
								country_code as "Country Code"
								created_time as "Created Time"
								customer_display_name as "Customer Display Name"
								customer_email as "Customer Email"
