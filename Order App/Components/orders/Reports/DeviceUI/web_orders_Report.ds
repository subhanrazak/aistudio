								last_modified_time as "Last Modified Time"
								last_name1 as "Last Name"
								legal_name as "Legal Name"
								outstanding_receivables as "Outstanding Receivables"
								pan as "PAN"
								portal_language as "Portal Language"
								remarks as "Remarks"
								shipping_address_address as "Shipping Address - Address"
								shipping_address_attention as "Shipping Address - Attention"
