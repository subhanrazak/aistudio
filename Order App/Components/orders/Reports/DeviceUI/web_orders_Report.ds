								last_modified_time as "Last Modified Time"
								reference_number as "Reference Number"
								sales_order_date as "Sales Order Date"
								sales_order_number as "Sales Order Number"
								salesperson_name as "Salesperson Name"
								total as "Total"
							)
						)
						datablock3
						(
		     				title = "Customer"
		     				related field = customer
							fields
							(
								avatax_exempt_number as "Avatax Exempt Number"
								avatax_use_code as "Avatax Use Code"
								billing_address_address as "Billing Address - Address"
