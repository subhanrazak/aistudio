report orders_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
						datablock2
						(
		     				title = "Salesperson"
		     				related field = salesperson
							fields
							(
								created_time as "Created Time"
								currency as "Currency"
								customer_name as "Customer Name"
								delivery_method as "Delivery Method"
