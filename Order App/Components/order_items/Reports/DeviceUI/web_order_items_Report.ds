report order_items_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								order as "Order"
								product as "Product"
								quantity as "Quantity"
								unit_price as "Unit Price"
								discount_amount as "Discount Amount"
								line_total as "Line Total"
								tax_rate as "Tax Rate"
								fulfilled_quantity as "Fulfilled Quantity"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								order as "Order"
								product as "Product"
								quantity as "Quantity"
								unit_price as "Unit Price"
								discount_amount as "Discount Amount"
								line_total as "Line Total"
								tax_rate as "Tax Rate"
								fulfilled_quantity as "Fulfilled Quantity"
							)
						)
						datablock2
						(
		     				title = "Product"
		     				related field = product
							fields
							(
								brand as "Brand"
								cost_price as "Cost Price"
								created_time as "Created Time"
								dimension_unit as "Dimension Unit"
								ean as "EAN"
								height as "Height"
								hsn_or_sac_code as "HSN Or SAC Code"
								isbn as "ISBN"
								last_modified_time as "Last Modified Time"
								length_field as "Length"
								manufacturer as "Manufacturer"
								mpn as "MPN"
								name as "Name"
								opening_stock as "Opening Stock"
								opening_stock_rate_per_unit as "Opening Stock Rate Per Unit"
								purchase_account_name as "Purchase Account Name"
								purchase_description as "Purchase Description"
								reorder_point as "Reorder Point"
								sales_account_name as "Sales Account Name"
								sales_description as "Sales Description"
								sat_item_key_code as "SAT Item Key Code"
								sat_unit_code as "SAT Unit Code"
								selling_price as "Selling Price"
								sku as "SKU"
								upc as "UPC"
								weight as "Weight"
								weight_unit as "Weight Unit"
								width as "Width"
							)
						)
						datablock3
						(
		     				title = "Order"
		     				related field = order
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
							)
						)
				)
			
}