list order_items_Report
{

			displayName = "Order Items Report"
			show all rows from order_items    
			(
				order as "Order"
				product as "Product"
				quantity as "Quantity"
				unit_price as "Unit Price"
				(
					display = total,average,min,max	
				)
				discount_amount as "Discount Amount"
				(
					display = total,average,min,max	
				)
				line_total as "Line Total"
				(
					display = total,average,min,max	
				)
				tax_rate as "Tax Rate"
				(
					display = total,average,min,max	
				)
				fulfilled_quantity as "Fulfilled Quantity"
			)
		
}