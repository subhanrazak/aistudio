list order_adjustments_Report
{

			displayName = "Order Adjustments Report"
			show all rows from order_adjustments    
			(
				order as "Order"
				adjustment_type as "Adjustment Type"
				amount as "Amount"
				(
					display = total,average,min,max	
				)
				description as "Description"
				applied_by as "Applied By"
				applied_date as "Applied Date"
				reason as "Reason"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (adjustment_type == "Discount")
				fields = [adjustment_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (adjustment_type == "Manual")
				fields = [adjustment_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		
}