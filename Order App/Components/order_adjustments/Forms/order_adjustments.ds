form order_adjustments
{

			displayname = "Order Adjustments"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order
			(
				type = list	
				displayname = "Order"
				values  = orders.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			adjustment_type
			(
				type = picklist
				displayname = "Adjustment Type"
				values = {"Discount","Manual","Tax","Shipping"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			amount
			(
				displayname = "Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = text
				displayname = "Description"
	 			row = 1
	 			column = 1   
				width = medium
			)
			applied_by
			(
    			type = text
				displayname = "Applied By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			applied_date
			(
    			type = date
				displayname = "Applied Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			reason
			(
    			type = text
				displayname = "Reason"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}