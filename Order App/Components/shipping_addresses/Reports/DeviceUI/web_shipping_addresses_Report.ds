report shipping_addresses_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								order as "Order"
								name as "Name"
								address_line1 as "Address Line 1"
								address_line2 as "Address Line 2"
								city as "City"
								state as "State"
								postal_code1 as "Postal Code"
								country1 as "Country"
								phone as "Phone"
								email as "Email"
								is_default as "Is Default"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								order as "Order"
								name as "Name"
								address_line1 as "Address Line 1"
								address_line2 as "Address Line 2"
								city as "City"
								state as "State"
								postal_code1 as "Postal Code"
								country1 as "Country"
								phone as "Phone"
								email as "Email"
								is_default as "Is Default"
							)
						)
						datablock2
						(
		     				title = "Order"
		     				related field = order
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
							)
						)
				)
			
}