form transfer_orders
{

			displayname = "Transfer Orders"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			from_warehouse_name
			(
    			type = text
				displayname = "From Warehouse Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_time
			(
    			type = datetime
				displayname = "Last Modified Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			quantity_transfered
			(
				type = decimal
				displayname = "Quantity Transfered"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			reason
			(
    			type = textarea
				displayname = "Reason"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			to_warehouse_name
			(
    			type = text
				displayname = "To Warehouse Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			transfer_order_number
			(
    			type = text
				displayname = "Transfer Order Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}