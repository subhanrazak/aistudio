report inventory_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								product as "Product"
								warehouse as "Warehouse"
								current_stock as "Current Stock"
								reorder_point as "Reorder Point"
								last_updated as "Last Updated"
								available_stock as "Available Stock"
								reserved_stock as "Reserved Stock"
								unit_of_measure as "Unit of Measure"
								location as "Location"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								product as "Product"
								warehouse as "Warehouse"
								current_stock as "Current Stock"
								reorder_point as "Reorder Point"
								last_updated as "Last Updated"
								available_stock as "Available Stock"
								reserved_stock as "Reserved Stock"
								unit_of_measure as "Unit of Measure"
								location as "Location"
							)
						)
						datablock2
						(
		     				title = "Product"
		     				related field = product
							fields
							(
								brand as "Brand"
								cost_price as "Cost Price"
								created_time as "Created Time"
								dimension_unit as "Dimension Unit"
								ean as "EAN"
								height as "Height"
								hsn_or_sac_code as "HSN Or SAC Code"
								isbn as "ISBN"
								last_modified_time as "Last Modified Time"
								length_field as "Length"
								manufacturer as "Manufacturer"
								mpn as "MPN"
								name as "Name"
								opening_stock as "Opening Stock"
								opening_stock_rate_per_unit as "Opening Stock Rate Per Unit"
								purchase_account_name as "Purchase Account Name"
								purchase_description as "Purchase Description"
								reorder_point as "Reorder Point"
								sales_account_name as "Sales Account Name"
								sales_description as "Sales Description"
								sat_item_key_code as "SAT Item Key Code"
								sat_unit_code as "SAT Unit Code"
								selling_price as "Selling Price"
								sku as "SKU"
								upc as "UPC"
								weight as "Weight"
								weight_unit as "Weight Unit"
								width as "Width"
							)
						)
						datablock3
						(
		     				title = "Warehouse"
		     				related field = warehouse
							fields
							(
								created_by as "Created By"
								created_time as "Created Time"
								date_field as "Date"
								from_warehouse_name as "From Warehouse Name"
								last_modified_time as "Last Modified Time"
								quantity_transfered as "Quantity Transfered"
								reason as "Reason"
								to_warehouse_name as "To Warehouse Name"
								transfer_order_number as "Transfer Order Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
							)
						)
				)
			
}