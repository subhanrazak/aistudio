kanban fulfillment_schedules_by_status
{

			displayName = "Board"
			show all rows from fulfillment_schedules    
			(
				order as "Order"
				scheduled_ship_date as "Scheduled Ship Date"
				scheduled_carrier as "Scheduled Carrier"
				estimated_delivery_date as "Estimated Delivery Date"
				status as "Status"
				priority as "Priority"
				notes as "Notes"
				planned_dispatch_time as "Planned Dispatch Time"
			)
			options
			(
	 			display field = status
	 		)
		
}