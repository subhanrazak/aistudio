form order_status_logs
{

			displayname = "Order Status Logs"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order
			(
				type = list	
				displayname = "Order"
				values  = orders.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Draft","Delivered","Shipped","Confirmed","Cancelled","Processing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			updated_by
			(
    			type = text
				displayname = "Updated By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			change_reason
			(
    			type = text
				displayname = "Change Reason"
	 			row = 1
	 			column = 1   
				width = medium
			)
			timestamp
			(
    			type = datetime
				displayname = "Timestamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}