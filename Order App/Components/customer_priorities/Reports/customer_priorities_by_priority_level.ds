kanban customer_priorities_by_priority_level
{

			displayName = "Board"
			show all rows from customer_priorities    
			(
				customer as "Customer"
				priority_level as "Priority Level"
				effective_from as "Effective From"
				effective_to as "Effective To"
				updated_by as "Updated By"
				notes as "Notes"
			)
			options
			(
	 			display field = priority_level
	 		)
		
}