form sales_orders
{

			displayname = "Sales Orders"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			currency
			(
    			type = text
				displayname = "Currency"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_name
			(
    			type = text
				displayname = "Customer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			delivery_method
			(
    			type = text
				displayname = "Delivery Method"
	 			row = 1
	 			column = 1   
				width = medium
			)
			expected_shipment_date
			(
    			type = date
				displayname = "Expected Shipment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_time
			(
    			type = datetime
				displayname = "Last Modified Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			reference_number
			(
    			type = text
				displayname = "Reference Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			sales_order_date
			(
    			type = date
				displayname = "Sales Order Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			sales_order_number
			(
    			type = text
				displayname = "Sales Order Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			salesperson_name
			(
    			type = text
				displayname = "Salesperson Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			total
			(
				type = decimal
				displayname = "Total"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}