report payment_records_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								order as "Order"
								payment_method as "Payment Method"
								amount as "Amount"
								currency as "Currency"
								payment_date as "Payment Date"
								status as "Status"
								transaction_id as "Transaction ID"
								reference_number as "Reference Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								order as "Order"
								payment_method as "Payment Method"
								amount as "Amount"
								currency as "Currency"
								payment_date as "Payment Date"
								status as "Status"
								transaction_id as "Transaction ID"
								reference_number as "Reference Number"
							)
						)
						datablock2
						(
		     				title = "Order"
		     				related field = order
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
							)
						)
				)
			
}