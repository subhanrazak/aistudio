form payment_records
{

			displayname = "Payment Records"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order
			(
				type = list	
				displayname = "Order"
				values  = orders.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_method
			(
				type = picklist
				displayname = "Payment Method"
				values = {"Bank Transfer","PayPal","Stripe","Cash","Card"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			amount
			(
				displayname = "Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			currency
			(
    			type = text
				displayname = "Currency"
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_date
			(
    			type = date
				displayname = "Payment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Failed","Completed","Pending","Refunded"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			transaction_id
			(
    			type = text
				displayname = "Transaction ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			reference_number
			(
    			type = text
				displayname = "Reference Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}