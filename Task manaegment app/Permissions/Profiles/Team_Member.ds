"Team_Member"
{
    name        = "Team_Member"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Team members can create and update their assigned work and view project/task information. Module permissions are added in the final Permissions segment."
    ModulePermissions
    {
        Projects
        {
            enabled          = Viewall,Tab,View,Search,read_comm,write_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Projects={"View"}
                Active_Projects={"View"}
                Project_Calendar={"View"}
            }
        }
        Tasks
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Tasks={"View","Edit"}
                My_Open_Tasks={"View","Edit"}
                Task_Board={"View","Edit"}
                Overdue_Tasks={"View","Edit"}
                Task_Calendar={"View"}
            }
        }
        Comments
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = true
            ReportPermissions
            {
                All_Comments={"View","Edit"}
                Follow_Up_Comments={"View","Edit"}
            }
        }
        Task_Dashboard
        {
            enabled = tab
        }
    }
}
