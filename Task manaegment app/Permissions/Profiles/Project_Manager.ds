"Project_Manager"
{
    name        = "Project_Manager"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:true, PIIAccess:false, ePHIAccess:false }
    description = "Project managers oversee projects, assign work, and manage task progress. Module permissions are added in the final Permissions segment."
    ModulePermissions
    {
        Projects
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = true
            ReportPermissions
            {
                All_Projects={"View","Edit","Delete"}
                Active_Projects={"View","Edit","Delete"}
                Project_Calendar={"View"}
            }
        }
        Tasks
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = true
            ReportPermissions
            {
                All_Tasks={"View","Edit","Delete"}
                My_Open_Tasks={"View","Edit","Delete"}
                Task_Board={"View","Edit","Delete"}
                Overdue_Tasks={"View","Edit","Delete"}
                Task_Calendar={"View"}
            }
        }
        Comments
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search,read_comm,write_comm,create_new_report
            allFieldsVisible = true
            ReportPermissions
            {
                All_Comments={"View","Edit","Delete"}
                Follow_Up_Comments={"View","Edit","Delete"}
            }
        }
        Task_Dashboard
        {
            enabled = tab
        }
    }
}
