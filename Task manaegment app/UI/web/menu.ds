menu
{
    space Task_Management
    {
        displayname = "Task Management"
        icon = "business-briefcase-25"

        section Dashboard_Section
        {
            displayname = "Dashboard"
            icon = "business-chart-bar-33"

            page Task_Dashboard
            {
                icon = "business-chart"
            }
        }

        section Projects_Section
        {
            displayname = "Projects"
            icon = "files-folder-15"

            form Projects
            {
                icon = "files-folder-add"
            }
            report All_Projects
            {
                icon = "files-folder-14"
            }
            report Active_Projects
            {
                icon = "business-progress"
            }
            report Project_Calendar
            {
                icon = "business-agenda"
            }
        }

        section Tasks_Section
        {
            displayname = "Tasks"
            icon = "files-check"

            form Tasks
            {
                icon = "files-add"
            }
            report All_Tasks
            {
                icon = "files-single-content-03"
            }
            report My_Open_Tasks
            {
                icon = "files-user"
            }
            report Task_Board
            {
                icon = "business-board-27"
            }
            report Overdue_Tasks
            {
                icon = "files-exclamation"
            }
            report Task_Calendar
            {
                icon = "business-agenda"
            }
        }

        section Comments_Section
        {
            displayname = "Comments"
            icon = "business-notes"

            form Comments
            {
                icon = "files-edit"
            }
            report All_Comments
            {
                icon = "files-single-paragraph"
            }
            report Follow_Up_Comments
            {
                icon = "files-time"
            }
        }

        section SharedAnalytics_Section
        {
            type = shared_user_report_section
            displayname = "Reports"
            icon = "business-chart-bar-33"
        }
    }

    preference
    {
        icon
        {
            style = outline
            show = {space,section,component}
        }
    }
}
