form Projects
{
    displayname = "Projects"
    success message = "Project saved successfully."
    record owner = Project_Manager
    Project_Information
    (
        type = section
        displayname = "Project Information"
        row = 1
        column = 0
    )
    must have unique Project_Code
    (
        type = text
        displayname = "Project Code"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have Project_Name
    (
        type = text
        displayname = "Project Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Project_Manager
    (
        type = picklist
        displayname = "Project Manager"
        module = users
        displayformat = [name]
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Planned","Active","On Hold","Completed","Cancelled"}
        initial value = "Planned"
        row = 1
        column = 2
        width = medium
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 2
        width = medium
    )
    Details
    (
        type = section
        displayname = "Details"
        visibility = true
        row = 2
        column = 1
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"Low","Medium","High","Critical"}
        initial value = "Medium"
        row = 2
        column = 2
        width = medium
    )
    Budget_Hours
    (
        type = decimal
        displayname = "Budget Hours"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Project"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Project"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
