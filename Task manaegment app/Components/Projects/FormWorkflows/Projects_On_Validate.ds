Projects_On_Validate as "Projects On Validate"
{
    type = form
    form = Projects
    record event = on add or edit
    description = "Validates project date consistency."

    on validate
    {
        actions
        {
            custom deluge script
            (
                if (input.Due_Date != null && input.Due_Date < input.Start_Date)
                {
                    alert "Due date cannot be earlier than start date.";
                    cancel submit;
                }
            )
        }
    }
}
