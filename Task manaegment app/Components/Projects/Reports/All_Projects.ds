default list All_Projects
{
    displayName = "All Projects"
    show all rows from Projects
    (
        Project_Code
        Project_Name
        Project_Manager
        Status
        Priority
        Start_Date
        Due_Date
        Budget_Hours
    )
    filters
    (
        Project_Manager
        Status
        Priority
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Status ascending
    )
    sort by
    (
        Due_Date ascending
        Project_Name ascending
    )
}
