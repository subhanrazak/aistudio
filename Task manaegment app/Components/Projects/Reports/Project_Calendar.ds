calendar Project_Calendar
{
    displayName = "Project Calendar"
    show all rows from Projects [Status != "Cancelled"]
    (
        Project_Name
        Project_Manager
        Status
        Start_Date
        Due_Date
    )
    filters
    (
        Project_Manager
        Status
    )
    options
    (
        display type = month
        week start day = monday
        display field = Project_Name
        start date = Start_Date
        end date = Due_Date
        default date
        (
            day   = Today
            month = Currentmonth
            year  = Currentyear
        )
    )
}
