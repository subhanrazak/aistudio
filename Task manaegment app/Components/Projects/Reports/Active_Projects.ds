list Active_Projects
{
    displayName = "Active Projects"
    show all rows from Projects [Status == "Active"]
    (
        Project_Code
        Project_Name
        Project_Manager
        Priority
        Start_Date
        Due_Date
        Budget_Hours
    )
    filters
    (
        Project_Manager
        Priority
    )
    sort by
    (
        Due_Date ascending
    )
}
