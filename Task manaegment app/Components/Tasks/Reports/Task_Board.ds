kanban Task_Board
{
    displayName = "Task Board"
    show all rows from Tasks [Status != "Cancelled"]
    (
        Task_ID
        Task_Title
        Project
        Assigned_To
        Status
        Priority
        Due_Date
    )
    filters
    (
        Project
        Assigned_To
        Priority
    )
    sort by
    (
        Due_Date ascending
    )
    options
    (
        display field = Status
        emptycolumn = "No Status"
        sort order = ascending
        record count = enable
    )
}
