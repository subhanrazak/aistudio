list My_Open_Tasks
{
    displayName = "My Open Tasks"
    show all rows from Tasks [Status != "Done" && Status != "Cancelled"]
    (
        Task_ID
        Task_Title
        Project
        Assigned_To
        Status
        Priority
        Due_Date
        Estimated_Hours
    )
    filters
    (
        Project
        Status
        Priority
    )
    sort by
    (
        Due_Date ascending
    )
}
