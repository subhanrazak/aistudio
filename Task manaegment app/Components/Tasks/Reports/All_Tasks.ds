default list All_Tasks
{
    displayName = "All Tasks"
    show all rows from Tasks
    (
        Task_ID
        Task_Title
        Project
        Assigned_To
        Status
        Priority
        Start_Date
        Due_Date
        Completed_Date
        Estimated_Hours
        Actual_Hours
    )
    filters
    (
        Project
        Assigned_To
        Status
        Priority
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Status ascending
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
}
