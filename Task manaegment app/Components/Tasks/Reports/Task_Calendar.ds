calendar Task_Calendar
{
    displayName = "Task Calendar"
    show all rows from Tasks [Status != "Cancelled"]
    (
        Task_Title
        Project
        Assigned_To
        Status
        Priority
        Start_Date
        Due_Date
    )
    filters
    (
        Project
        Assigned_To
        Status
        Priority
    )
    options
    (
        display type = month
        week start day = monday
        display field = Task_Title
        start date = Start_Date
        end date = Due_Date
        default date
        (
            day   = Today
            month = Currentmonth
            year  = Currentyear
        )
    )
}
