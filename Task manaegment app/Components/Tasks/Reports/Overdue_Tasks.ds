list Overdue_Tasks
{
    displayName = "Overdue Tasks"
    show all rows from Tasks [Due_Date < zoho.currentdate && Status != "Done" && Status != "Cancelled"]
    (
        Task_ID
        Task_Title
        Project
        Assigned_To
        Status
        Priority
        Due_Date
    )
    filters
    (
        Project
        Assigned_To
        Priority
    )
    sort by
    (
        Due_Date ascending
    )
}
