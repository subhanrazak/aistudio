form Tasks
{
    displayname = "Tasks"
    success message = "Task saved successfully."
    record owner = Assigned_To
    Task_Information
    (
        type = section
        displayname = "Task Information"
        row = 1
        column = 0
    )
    Task_ID
    (
        type = autonumber
        displayname = "Task ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Task_Title
    (
        type = text
        displayname = "Task Title"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Project
    (
        type = picklist
        displayname = "Project"
        values = Projects.ID
        displayformat = [Project_Name]
        row = 1
        column = 2
        width = medium
    )
    must have Assigned_To
    (
        type = picklist
        displayname = "Assigned To"
        module = users
        displayformat = [name]
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"To Do","In Progress","Blocked","Done","Cancelled"}
        initial value = "To Do"
        row = 1
        column = 1
        width = medium
    )
    must have Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"Low","Medium","High","Critical"}
        initial value = "Medium"
        row = 1
        column = 2
        width = medium
    )
    Scheduling
    (
        type = section
        displayname = "Scheduling"
        visibility = true
        row = 2
        column = 1
    )
    Start_Date
    (
        type = date
        displayname = "Start Date"
        initial value = "${zoho.currentdate}"
        row = 2
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 2
        column = 2
        width = medium
    )
    Completed_Date
    (
        type = date
        displayname = "Completed Date"
        row = 2
        column = 2
        width = medium
    )
    Estimated_Hours
    (
        type = decimal
        displayname = "Estimated Hours"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Actual_Hours
    (
        type = decimal
        displayname = "Actual Hours"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Details
    (
        type = section
        displayname = "Details"
        visibility = true
        row = 3
        column = 1
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 140px
        row = 3
        column = 1
        width = medium
    )
    Blocker_Reason
    (
        type = textarea
        displayname = "Blocker Reason"
        height = 90px
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Task"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Task"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
