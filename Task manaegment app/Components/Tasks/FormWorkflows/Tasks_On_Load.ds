Tasks_On_Load as "Tasks On Load"
{
    type = form
    form = Tasks
    record event = on add or edit
    description = "Sets task field visibility when the form opens."

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Status == "Done")
                {
                    show Completed_Date;
                }
                else
                {
                    hide Completed_Date;
                }
                if (input.Status == "Blocked")
                {
                    show Blocker_Reason;
                }
                else
                {
                    hide Blocker_Reason;
                }
            )
        }
    }
}
