Follow_Up_Required_On_User_Input as "Follow Up Required On User Input"
{
    type = form
    form = Comments
    record event = on add or edit
    description = "Shows or clears the follow-up date when follow-up is toggled."

    on user input of Follow_Up_Required
    {
        actions
        {
            custom deluge script
            (
                if (input.Follow_Up_Required == true)
                {
                    show Follow_Up_Date;
                }
                else
                {
                    hide Follow_Up_Date;
                    input.Follow_Up_Date = null;
                }
            )
        }
    }
}
