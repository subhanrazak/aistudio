Comments_On_Load as "Comments On Load"
{
    type = form
    form = Comments
    record event = on add or edit
    description = "Sets follow-up date visibility when the comment form opens."

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Follow_Up_Required == true)
                {
                    show Follow_Up_Date;
                }
                else
                {
                    hide Follow_Up_Date;
                }
            )
        }
    }
}
