default list All_Comments
{
    displayName = "All Comments"
    show all rows from Comments
    (
        Task
        Update_Type
        Follow_Up_Required
        Follow_Up_Date
        Comment
    )
    filters
    (
        Task
        Update_Type
        Follow_Up_Required
    )
    sort by
    (
        Follow_Up_Date ascending
    )
}
