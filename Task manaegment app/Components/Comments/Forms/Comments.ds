form Comments
{
    displayname = "Comments"
    success message = "Comment added successfully."
    record owner = Added_User
    Comment_Details
    (
        type = section
        displayname = "Comment Details"
        row = 1
        column = 0
    )
    must have Task
    (
        type = picklist
        displayname = "Task"
        values = Tasks.ID
        displayformat = [Task_Title]
        row = 1
        column = 1
        width = medium
    )
    must have Comment
    (
        type = textarea
        displayname = "Comment"
        height = 140px
        row = 1
        column = 1
        width = medium
    )
    Update_Type
    (
        type = picklist
        displayname = "Update Type"
        values = {"General Update","Progress","Blocker","Question","Resolution"}
        initial value = "General Update"
        row = 1
        column = 2
        width = medium
    )
    Follow_Up_Required
    (
        type = checkbox
        displayname = "Follow Up Required"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Follow_Up_Date
    (
        type = date
        displayname = "Follow Up Date"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add Comment"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Comment"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
