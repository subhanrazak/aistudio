<%
  activeProjects = Projects[Status == "Active"].count();
  openTasks = Tasks[Status != "Done" && Status != "Cancelled"].count();
  overdueTasks = Tasks[Due_Date != null && Due_Date < zoho.currentdate && Status != "Done" && Status != "Cancelled"].count();
  blockedTasks = Tasks[Status == "Blocked"].count();
  completedTasks = Tasks[Status == "Done"].count();
%>
<style>
/* ZCS Layout Dashboard panel/card styles */
.zcs-panel-wrapper ul li { list-style-type:none; }
.zcs-panel { border:1px solid var(--zcs-border-color); box-shadow:0 2px 12px 0 rgba(20,20,60,.06); background-color:var(--zcs-white-color); transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
.zcs-panel-icon-wrapper { width:44px; height:44px; }
.zcs-panel-icon { width:24px; height:24px; line-height:24px; }
.zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color:#E4FCF3; color:#179E6C; }
.zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color:#FCF4E6; color:#B8770D; }
.zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color:#FDE3E6; color:#FE455D; }
.zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color:#EAF2FF; color:#1652BB; }
.zcs-panel.zcs-panel-l_blue .zcs-panel-icon-wrapper { background-color:#E8EFFF; color:#2A6FFC; }
.zcs-panel-wrapper li:hover .zcs-panel { border-color:var(--zcs-theme-brand-color); transform:translateY(-2px); box-shadow:0 12px 30px rgba(20,20,60,.10); }
.task-kpi-section { width:100%; box-sizing:border-box; padding:0 0 12px; }
.task-kpi-section .zcs-panel { min-height:134px; }
.task-kpi-meta { display:flex; align-items:center; gap:6px; margin-top:6px; font-size:12px; color:var(--zcs-teritiary-text-color); }
.task-kpi-meta i { font-size:14px; }
.task-kpi-open { color:var(--task-blue); }
.task-kpi-overdue { color:var(--task-red); }
.task-kpi-blocked { color:var(--task-amber); }
.task-kpi-completed { color:var(--task-green); }
.task-kpi-section .zcs-panel h4 { font-size:28px; }
@media (max-width:1200px) { .task-kpi-section .zcs-panel-wrapper li { flex:0 0 calc(33.333% - var(--column-gap) * .666); max-width:calc(33.333% - var(--column-gap) * .666); } }
@media (max-width:768px) { .task-kpi-section .zcs-panel-wrapper li { flex:0 0 100%; max-width:100%; } }
</style>
<div class="task-kpi-section">
    <div class="zcs-panel-wrapper">
        <ul class="zcs-row zcs-justify-space-between zcs-gap-16 zcs-p-0 zcs-m-0">
            <li class="zcs-col zcs-relative">
                <div class="zcs-panel zcs-panel-l_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-10 zcs-rounded-xl zcs-p-20 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-gap-10">
                        <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline files-folder-13"></i></div>
                        <h4 class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%= activeProjects %></h4>
                    </div>
                    <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Active Projects</p>
                    <div class="task-kpi-meta task-kpi-open"><i class="zc-li-outline ui-1-check-circle-08"></i><span>Currently in progress</span></div>
                </div>
            </li>
            <li class="zcs-col zcs-relative">
                <div class="zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-10 zcs-rounded-xl zcs-p-20 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-gap-10">
                        <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore"></i></div>
                        <h4 class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%= openTasks %></h4>
                    </div>
                    <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Open Tasks</p>
                    <div class="task-kpi-meta task-kpi-open"><i class="zc-li-outline loader-dots-06"></i><span>To Do, In Progress, Blocked</span></div>
                </div>
            </li>
            <li class="zcs-col zcs-relative">
                <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-direction-column zcs-gap-10 zcs-rounded-xl zcs-p-20 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-gap-10">
                        <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time"></i></div>
                        <h4 class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%= overdueTasks %></h4>
                    </div>
                    <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Overdue Tasks</p>
                    <div class="task-kpi-meta task-kpi-overdue"><i class="zc-li-outline ui-1-alert-circle-i"></i><span>Past due and still open</span></div>
                </div>
            </li>
            <li class="zcs-col zcs-relative">
                <div class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-10 zcs-rounded-xl zcs-p-20 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-gap-10">
                        <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-1-lock"></i></div>
                        <h4 class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%= blockedTasks %></h4>
                    </div>
                    <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Blocked Tasks</p>
                    <div class="task-kpi-meta task-kpi-blocked"><i class="zc-li-outline ui-2-settings-90"></i><span>Need intervention</span></div>
                </div>
            </li>
            <li class="zcs-col zcs-relative">
                <div class="zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-10 zcs-rounded-xl zcs-p-20 zcs-box-border">
                    <div class="zcs-flex zcs-align-items-center zcs-gap-10">
                        <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08"></i></div>
                        <h4 class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%= completedTasks %></h4>
                    </div>
                    <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Completed Tasks</p>
                    <div class="task-kpi-meta task-kpi-completed"><i class="zc-li-outline arrows-1-tail-right"></i><span>Marked Done</span></div>
                </div>
            </li>
        </ul>
    </div>
</div>