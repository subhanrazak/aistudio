<%
  lowCount = Tasks[Priority == "Low"].count();
  mediumCount = Tasks[Priority == "Medium"].count();
  highCount = Tasks[Priority == "High"].count();
  criticalCount = Tasks[Priority == "Critical"].count();
  priorityTotal = lowCount + mediumCount + highCount + criticalCount;
  if(priorityTotal == 0)
  {
      priorityTotal = 1;
  }
  lowPct = (lowCount * 100) / priorityTotal;
  mediumPct = (mediumCount * 100) / priorityTotal;
  highPct = (highCount * 100) / priorityTotal;
  criticalPct = (criticalCount * 100) / priorityTotal;
  openTaskList = Tasks[Status != "Done" && Status != "Cancelled"] sort by Due_Date asc range from 1 to 6;
%>
<style>
/* ZCS Fleets Performance Metrics + Simple Table components */
.zcs-progress-bar { height:8px; background-color:var(--zcs_component_hover_color, #EEF1F7); overflow:hidden; }
.zcs-progress-bar-indicator { height:inherit; border-radius:inherit; background-color:var(--zcs-theme-brand-color); }
.zcs-table-wrapper { border:1px solid var(--zcs-border-color); background-color:var(--zcs-white-color); overflow:auto; }
.zcs-table-wrapper table { line-height:normal; border-collapse:collapse; }
.zcs-table-wrapper table thead { top:0; }
.zcs-table-wrapper table thead tr th { background-color:#F9FAFE; box-shadow:0 -1px 0 0 var(--zcs-border-color) inset; white-space:nowrap; }
.zcs-table-wrapper table tbody tr td { border-top:1px solid var(--zcs-border-color); }
.zcs-table-wrapper table tbody tr:first-child td { border-color:transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color:#F9FAFE; }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-green { color:#179E6C; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-red { color:#FE455D; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-yellow { color:#B8770D; }
.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-l_blue { color:#1094C5; }
.priority-workload-card { min-height:330px; }
.priority-bars { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.priority-low .zcs-progress-bar-indicator { background:#179E6C; }
.priority-medium .zcs-progress-bar-indicator { background:#2A6FFC; }
.priority-high .zcs-progress-bar-indicator { background:#B8770D; }
.priority-critical .zcs-progress-bar-indicator { background:#FE455D; }
.task-mini-badge { display:inline-flex; align-items:center; gap:5px; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:600; background:#F3F5FA; }
.task-mini-badge.critical { color:#FE455D; background:#FDE3E6; }
.task-mini-badge.high { color:#B8770D; background:#FCF4E6; }
.task-mini-badge.medium { color:#2A6FFC; background:#E8EFFF; }
.task-mini-badge.low { color:#179E6C; background:#E4FCF3; }
.workload-table-shell { max-height:235px; }
@media (max-width:576px) { .priority-bars { grid-template-columns:1fr; } }
</style>
<div class="zcs-card priority-workload-card zcs-p-24 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
    <div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12">
        <div>
            <h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Priority and Workload</h5>
            <p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-8 zcs-mb-0 zcs-mx-0">Priority mix and near-term open assignments</p>
        </div>
        <i class="zc-li-outline ui-2-settings-90 zcs-font-24 zcs-color-theme"></i>
    </div>
    <div class="priority-bars">
        <div class="zcs-progress-bar-wrapper priority-low zcs-flex zcs-direction-column zcs-gap-6">
            <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-m-0"><span class="zcs-color-tertiary">Low</span><strong class="zcs-color-green"><%= lowCount %></strong></p>
            <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%= lowPct %>%;"></div></div>
        </div>
        <div class="zcs-progress-bar-wrapper priority-medium zcs-flex zcs-direction-column zcs-gap-6">
            <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-m-0"><span class="zcs-color-tertiary">Medium</span><strong class="zcs-color-blue"><%= mediumCount %></strong></p>
            <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%= mediumPct %>%;"></div></div>
        </div>
        <div class="zcs-progress-bar-wrapper priority-high zcs-flex zcs-direction-column zcs-gap-6">
            <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-m-0"><span class="zcs-color-tertiary">High</span><strong class="zcs-color-yellow"><%= highCount %></strong></p>
            <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%= highPct %>%;"></div></div>
        </div>
        <div class="zcs-progress-bar-wrapper priority-critical zcs-flex zcs-direction-column zcs-gap-6">
            <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-m-0"><span class="zcs-color-tertiary">Critical</span><strong class="zcs-color-red"><%= criticalCount %></strong></p>
            <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%= criticalPct %>%;"></div></div>
        </div>
    </div>
    <div>
        <h6 class="zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Upcoming open work</h6>
        <div class="zcs-table-wrapper workload-table-shell zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8">
            <table class="zcs-w-full">
                <thead class="zcs-sticky">
                    <tr>
                        <th class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary">Task</th>
                        <th class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary">Assigned To</th>
                        <th class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary">Due</th>
                        <th class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-medium zcs-lh-body zcs-color-primary">Priority</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                      if(openTaskList.count() == 0)
                      {
                    %>
                    <tr><td colspan="4" class="zcs-px-12 zcs-py-14 zcs-box-border zcs-text-center zcs-font-13 zcs-color-tertiary">No open tasks found.</td></tr>
                    <%
                      }
                      else
                      {
                        for each taskRec in openTaskList
                        {
                          priorityClass = taskRec.Priority.toLowerCase();
                          dueText = ifnull(taskRec.Due_Date,"No due date");
                    %>
                    <tr>
                        <td class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-primary"><%= taskRec.Task_Title %></td>
                        <td class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary"><%= ifnull(taskRec.Assigned_To.User_name,"Unassigned") %></td>
                        <td class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary"><%= dueText %></td>
                        <td class="zcs-px-12 zcs-py-8 zcs-box-border zcs-text-left"><span class="task-mini-badge <%= priorityClass %>"><%= taskRec.Priority %></span></td>
                    </tr>
                    <%
                        }
                      }
                    %>
                </tbody>
            </table>
        </div>
    </div>
</div>