<page linkname = "Task_Dashboard" displayname = "Task Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Dashboard_Header' elementName='Dashboard_Header'>
          <![CDATA[htmlpage Dashboard_Header()
            content
             <%{%>
                 <file name:Dashboard_Header.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Task_KPI_Cards' elementName='Task_KPI_Cards'>
          <![CDATA[htmlpage Task_KPI_Cards()
            content
             <%{%>
                 <file name:Task_KPI_Cards.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Status_Breakdown' elementName='Status_Breakdown'>
          <![CDATA[htmlpage Status_Breakdown()
            content
             <%{%>
                 <file name:Status_Breakdown.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Priority_Workload' elementName='Priority_Workload'>
          <![CDATA[htmlpage Priority_Workload()
            content
             <%{%>
                 <file name:Priority_Workload.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='40%'>
        <dsp id='Recent_Activity' elementName='Recent_Activity'>
          <![CDATA[htmlpage Recent_Activity()
            content
             <%{%>
                 <file name:Recent_Activity.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
      <column width='60%'>
        <file name:Embedded_Overdue_Tasks.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Embedded_Task_Board.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
