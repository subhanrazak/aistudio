default list Active_Policy_Rules
{
    displayName = "Active Policy Rules"
    show all rows from TE_Policy_Rules [Active == true]
    (
        Rule_ID
        Rule_Name
        Rule_Category
        Default_Severity
        Warning_Threshold_Percent
        Critical_Threshold_Percent
        Amount_Limit_USD
        Days_Threshold
        Effective_Date
        Owner_Profile
    )
    filters
    (
        Rule_Category
        Default_Severity
        Owner_Profile
    )
}
