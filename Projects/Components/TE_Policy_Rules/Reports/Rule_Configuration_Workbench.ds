spreadsheet Rule_Configuration_Workbench
{
    displayName = "Rule Configuration Workbench"
    show all rows from TE_Policy_Rules
    (
        Rule_ID
        Rule_Name
        Rule_Category
        Rule_Description
        Policy_Reference
        Applies_To_Expense_Category
        Parameters_JSON
        Default_Severity
        Warning_Threshold_Percent
        Critical_Threshold_Percent
        Amount_Limit_USD
        Days_Threshold
        Receipt_Minimum_Amount
        Active
        Effective_Date
        Retired_Date
        Owner_Profile
    )
}
