form TE_Policy_Rules
{
    displayname = "T&E Policy Rules"
    Rule_Definition
    (
        type = section
        displayname = "Rule Definition"
        row = 1
        column = 0
    )
    must have unique Rule_ID
    (
        type = text
        displayname = "Rule ID"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have Rule_Name
    (
        type = text
        displayname = "Rule Name"
        maxchar = 120
        row = 1
        column = 2
        width = medium
    )
    must have Rule_Category
    (
        type = picklist
        displayname = "Rule Category"
        values = {"Hotel Rate Limit","Per Diem / Meals","Airfare Class","Advance Booking","Receipt Requirement","Entertainment Documentation","Entertainment Budget Cap","Duplicate Expense","Weekend/Holiday Travel","Mileage Reasonableness"}
        row = 1
        column = 1
        width = medium
    )
    must have Rule_Description
    (
        type = textarea
        displayname = "Rule Description"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Policy_Reference
    (
        type = text
        displayname = "Policy Reference"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Applies_To_Expense_Category
    (
        type = picklist
        displayname = "Applies To Expense Category"
        values = {"Any","Hotel","Meals","Airfare","Entertainment","Mileage","Other"}
        row = 1
        column = 2
        width = medium
    )
    Parameters_JSON
    (
        type = textarea
        displayname = "Parameters JSON"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    must have Default_Severity
    (
        type = picklist
        displayname = "Default Severity"
        values = {"Info","Warning","Critical"}
        row = 1
        column = 2
        width = medium
    )
    Warning_Threshold_Percent
    (
        type = decimal
        displayname = "Warning Threshold Percent"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Critical_Threshold_Percent
    (
        type = decimal
        displayname = "Critical Threshold Percent"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Amount_Limit_USD
    (
        type = decimal
        displayname = "Amount Limit USD"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Days_Threshold
    (
        type = number
        displayname = "Days Threshold"
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Receipt_Minimum_Amount
    (
        type = decimal
        displayname = "Receipt Minimum Amount"
        decimalplace = 2
        initial value = 25
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    must have Effective_Date
    (
        type = date
        displayname = "Effective Date"
        row = 1
        column = 1
        width = medium
    )
    Retired_Date
    (
        type = date
        displayname = "Retired Date"
        row = 1
        column = 2
        width = medium
    )
    Owner_Profile
    (
        type = picklist
        displayname = "Owner Profile"
        values = {"Travel Policy Administrator","HR Policy Owner","Compliance Officer","CFO"}
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
