spreadsheet Rate_Table_Maintenance
{
    displayName = "Rate Table Maintenance"
    show all rows from TE_Rate_Tables
    (
        Rate_Code
        City_Location
        Country_Code
        City_Tier
        Grade_Band
        Hotel_Max
        Daily_Per_Diem_Meals
        Currency
        Effective_Date
        Expiry_Date
        Active
    )
}