default list Active_Rate_Tables
{
    displayName = "Active Rate Tables"
    show all rows from TE_Rate_Tables [Active == true]
    (
        Rate_Code
        City_Location
        Country_Code
        City_Tier
        Grade_Band
        Hotel_Max
        Daily_Per_Diem_Meals
        Currency
        Effective_Date
    )
    filters
    (
        City_Tier
        Grade_Band
        Country_Code
    )
    group by
    (
        City_Tier ascending
    )
}