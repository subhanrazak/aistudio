list Rate_Version_History
{
    displayName = "Rate Version History"
    show all rows from TE_Rate_Tables
    (
        Rate_Code
        City_Location
        Grade_Band
        Hotel_Max
        Daily_Per_Diem_Meals
        Effective_Date
        Expiry_Date
        Active
        Source
    )
    sort by
    (
        Effective_Date descending
    )
}