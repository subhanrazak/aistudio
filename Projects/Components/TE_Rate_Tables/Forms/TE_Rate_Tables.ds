form TE_Rate_Tables
{
    displayname = "T&E Rate Tables"
    Rate_Definition
    (
        type = section
        displayname = "Rate Definition"
        row = 1
        column = 0
    )
    must have unique Rate_Code
    (
        type = text
        displayname = "Rate Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have City_Location
    (
        type = text
        displayname = "City Location"
        maxchar = 60
        row = 1
        column = 2
        width = medium
    )
    must have Country_Code
    (
        type = text
        displayname = "Country Code"
        maxchar = 3
        initial value = "USA"
        row = 1
        column = 1
        width = medium
    )
    must have City_Tier
    (
        type = picklist
        displayname = "City Tier"
        values = {"Tier 1 (Major Metro)","Tier 2","Tier 3 (Regional)"}
        row = 1
        column = 2
        width = medium
    )
    must have Grade_Band
    (
        type = picklist
        displayname = "Grade Band"
        values = {"Junior Staff","Senior Staff","Executive","All"}
        row = 1
        column = 1
        width = medium
    )
    must have Hotel_Max
    (
        type = decimal
        displayname = "Hotel Max"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    must have Daily_Per_Diem_Meals
    (
        type = decimal
        displayname = "Daily Per Diem Meals"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    must have Currency
    (
        type = text
        maxchar = 3
        initial value = "USD"
        row = 1
        column = 2
        width = medium
    )
    must have Effective_Date
    (
        type = date
        displayname = "Effective Date"
        row = 1
        column = 1
        width = medium
    )
    Expiry_Date
    (
        type = date
        displayname = "Expiry Date"
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Version_Notes
    (
        type = textarea
        displayname = "Version Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Source
    (
        type = picklist
        values = {"Admin Input","GSA Import","SAP Upload","Manual Correction"}
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}