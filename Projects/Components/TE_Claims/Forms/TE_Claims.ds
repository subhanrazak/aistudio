form TE_Claims
{
    displayname = "T&E Claims"
    SAP_Claim_Header
    (
        type = section
        displayname = "SAP Claim Header"
        row = 1
        column = 0
    )
    must have unique Trip_Number
    (
        type = text
        displayname = "Trip Number"
        maxchar = 10
        description [ type = tooltip  message = "SAP PTRV_HEAD-REINR" ]
        row = 1
        column = 1
        width = medium
    )
    must have Employee
    (
        type = picklist
        values = TE_Employees.ID
        displayformat = [Employee_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Employee_ID
    (
        type = text
        displayname = "Employee ID"
        maxchar = 8
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        maxchar = 80
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Employee_Grade_Band
    (
        type = picklist
        displayname = "Employee Grade Band"
        values = {"Junior Staff","Senior Staff","Executive"}
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = text
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    must have Cost_Center
    (
        type = text
        displayname = "Cost Center"
        maxchar = 10
        row = 1
        column = 1
        width = medium
    )
    Approver_Employee_ID
    (
        type = text
        displayname = "Approver Employee ID"
        maxchar = 8
        row = 1
        column = 2
        width = medium
    )
    Approver_Email
    (
        type = email
        displayname = "Approver Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have Trip_Start_Date
    (
        type = date
        displayname = "Trip Start Date"
        row = 1
        column = 2
        width = medium
    )
    must have Trip_End_Date
    (
        type = date
        displayname = "Trip End Date"
        row = 1
        column = 1
        width = medium
    )
    must have Destination_City
    (
        type = text
        displayname = "Destination City"
        maxchar = 40
        row = 1
        column = 2
        width = medium
    )
    must have Destination_Country
    (
        type = text
        displayname = "Destination Country"
        maxchar = 3
        row = 1
        column = 1
        width = medium
    )
    must have Trip_Type
    (
        type = picklist
        displayname = "Trip Type"
        values = {"Domestic","International"}
        row = 1
        column = 2
        width = medium
    )
    must have Submission_Date
    (
        type = date
        displayname = "Submission Date"
        row = 1
        column = 1
        width = medium
    )
    Booking_Date
    (
        type = date
        displayname = "Booking Date"
        row = 1
        column = 2
        width = medium
    )
    must have Total_Amount
    (
        type = decimal
        displayname = "Total Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    must have Currency
    (
        type = text
        maxchar = 3
        initial value = "USD"
        row = 1
        column = 2
        width = medium
    )
    SAP_Status_Code
    (
        type = text
        displayname = "SAP Status Code"
        maxchar = 2
        row = 1
        column = 1
        width = medium
    )
    Source_System
    (
        type = picklist
        displayname = "Source System"
        values = {"SAP FI-TV","Manual Upload","Demo Seed"}
        row = 1
        column = 2
        width = medium
    )
    Sync_Batch_ID
    (
        type = text
        displayname = "Sync Batch ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    Compliance_Scorecard
    (
        type = section
        displayname = "Compliance Scorecard"
        visibility = true
        row = 2
        column = 1
    )
    must have Claim_Status
    (
        type = picklist
        displayname = "Claim Status"
        values = {"Synced","Submitted","Compliance Pending","Compliance Cleared - Green","Compliance Cleared - Warnings","Compliance Held - Critical","Exception Pending","Exception Approved","Returned to Claimant","Rejected by Manager","Compliance Cleared - Approved","SAP Approved","SAP Rejected"}
        initial value = "Synced"
        row = 2
        column = 1
        width = medium
    )
    Compliance_Rating
    (
        type = picklist
        displayname = "Compliance Rating"
        values = {"Green","Yellow","Red","Not Checked"}
        initial value = "Not Checked"
        row = 2
        column = 2
        width = medium
    )
    Compliance_Score
    (
        type = decimal
        displayname = "Compliance Score"
        decimalplace = 2
        initial value = 100
        row = 2
        column = 1
        width = medium
    )
    Critical_Violation_Count
    (
        type = number
        displayname = "Critical Violation Count"
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Warning_Count
    (
        type = number
        displayname = "Warning Count"
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Estimated_Savings
    (
        type = decimal
        displayname = "Estimated Savings"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Has_Duplicate_Flag
    (
        type = checkbox
        displayname = "Has Duplicate Flag"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Repeat_Offender_Flag
    (
        type = checkbox
        displayname = "Repeat Offender Flag"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Last_Compliance_Check
    (
        type = datetime
        displayname = "Last Compliance Check"
        row = 2
        column = 1
        width = medium
    )
    Manager_Acknowledgement
    (
        type = checkbox
        displayname = "Manager Acknowledgement"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Manager_Decision
    (
        type = picklist
        displayname = "Manager Decision"
        values = {"Approve","Reject","Return for Clarification","Hold for Exception"}
        row = 2
        column = 1
        width = medium
    )
    Manager_Comments
    (
        type = textarea
        displayname = "Manager Comments"
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"Synced","Submitted","Compliance Pending","Compliance Cleared - Green","Compliance Cleared - Warnings","Compliance Held - Critical","Exception Pending","Exception Approved","Returned to Claimant","Rejected by Manager","Compliance Cleared - Approved"}
    }
}