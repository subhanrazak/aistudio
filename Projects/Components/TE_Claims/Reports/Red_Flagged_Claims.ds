list Red_Flagged_Claims
{
    displayName = "Red Flagged Claims"
    show all rows from TE_Claims [Compliance_Rating == "Red" || Critical_Violation_Count > 0]
    (
        Trip_Number
        Employee_Name
        Department
        Total_Amount
        Compliance_Rating
        Critical_Violation_Count
        Estimated_Savings
        Claim_Status
        Approver_Email
    )
}