kanban Claims_By_Status
{
    displayName = "Claims By Status"
    show all rows from TE_Claims
    (
        Trip_Number
        Employee_Name
        Total_Amount
        Compliance_Rating
        Critical_Violation_Count
        Warning_Count
        Claim_Status
    )
    options
    (
        display field = Claim_Status
        sort order = custom
        record count = enable
    )
}