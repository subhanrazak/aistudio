calendar Trip_Calendar
{
    displayName = "Trip Calendar"
    show all rows from TE_Claims
    (
        Trip_Number
        Employee_Name
        Destination_City
        Claim_Status
        Trip_Start_Date
        Trip_End_Date
    )
    options
    (
        display type = month
        display field = Trip_Number
        start date = Trip_Start_Date
        end date = Trip_End_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}