Mark_Cleared as "Mark Cleared"
{
    type = functions
    form = TE_Claims
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                unresolvedCriticalCount = TE_Compliance_Results[Claim == input.ID && Pass_Fail == "Fail" && Severity == "Critical" && Exception_Status != "Approved"].count();
                if(unresolvedCriticalCount > 0)
                {
                    info "Mark Cleared blocked: unresolved critical compliance failures remain for Trip " + input.Trip_Number + ".";
                }
                else
                {
                    input.Manager_Acknowledgement = true;
                    input.Manager_Decision = "Approve";
                    input.Claim_Status = "Compliance Cleared - Approved";
                    try
                    {
                        insert into TE_Audit_Log
                        [
                            Event_Key = "CLEAR-" + input.ID.toText() + "-" + zoho.currenttime.toText("yyyyMMddHHmmss")
                            Event_Timestamp = zoho.currenttime
                            Actor_Email = zoho.loginuserid
                            Actor_Profile = zoho.loginuser
                            Entity_Type = "Claim"
                            Entity_Record_ID = input.Trip_Number
                            Action = "Manager marked claim cleared"
                            After_Value = "Decision=Approve; Status=Compliance Cleared - Approved; Rating=" + input.Compliance_Rating
                            IP_Address = zoho.ipaddress
                            Severity = "Info"
                            Immutable_Flag = true
                        ];
                    }
                    catch(auditError)
                    {
                        info "Mark-cleared audit log write skipped: " + auditError.message;
                    }
                    try
                    {
                        sendmail
                        [
                            from: zoho.adminuserid
                            to: zoho.adminuserid
                            subject: "T&E claim cleared for AP processing: " + input.Trip_Number
                            message: "Trip " + input.Trip_Number + " was marked cleared by " + zoho.loginuser + "."
                        ]
                    }
                    catch(mailError)
                    {
                        info "AP notification skipped: " + mailError.message;
                    }
                }
            )
        }
    }
}