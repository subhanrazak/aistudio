TE_Claims_On_User_Input_Employee as "TE Claims On User Input Employee"
{
    type = form
    form = TE_Claims
    record event = on add or edit

    on user input of Employee
    {
        actions
        {
            custom deluge script
            (
                if(input.Employee != null)
                {
                    selectedEmployee = TE_Employees[ID == input.Employee];
                    input.Employee_ID = selectedEmployee.Employee_ID;
                    input.Employee_Name = selectedEmployee.Employee_Name;
                    input.Employee_Grade_Band = selectedEmployee.Employee_Grade_Band;
                    input.Department = selectedEmployee.Department;
                    input.Cost_Center = selectedEmployee.Cost_Center;
                    input.Approver_Email = selectedEmployee.Manager_Email;
                    input.Approver_Employee_ID = selectedEmployee.Manager_Employee_ID;
                    input.Repeat_Offender_Flag = selectedEmployee.Repeat_Offender;
                }
                else
                {
                    input.Employee_ID = "";
                    input.Employee_Name = "";
                    input.Department = "";
                    input.Cost_Center = "";
                    input.Approver_Email = "";
                    input.Approver_Employee_ID = "";
                    input.Repeat_Offender_Flag = false;
                }
            )
        }
    }
}