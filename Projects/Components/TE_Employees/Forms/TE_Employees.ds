form TE_Employees
{
    displayname = "T&E Employees"
    Employee_Information
    (
        type = section
        displayname = "Employee Information"
        row = 1
        column = 0
    )
    must have unique Employee_ID
    (
        type = text
        displayname = "Employee ID"
        maxchar = 8
        description [ type = tooltip  message = "SAP PERNR" ]
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        maxchar = 80
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have unique Login_Email
    (
        type = email
        displayname = "Login Email"
        personal data = true
        description [ type = tooltip  message = "Used to match zoho.loginuser or portal user identity." ]
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Grade_Band
    (
        type = picklist
        displayname = "Employee Grade Band"
        values = {"Junior Staff","Senior Staff","Executive"}
        row = 1
        column = 2
        width = medium
    )
    Position_Title
    (
        type = text
        displayname = "Position Title"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = text
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    must have Cost_Center
    (
        type = text
        displayname = "Cost Center"
        maxchar = 10
        row = 1
        column = 1
        width = medium
    )
    Org_Unit
    (
        type = text
        displayname = "Org Unit"
        maxchar = 20
        row = 1
        column = 2
        width = medium
    )
    Manager_Employee_ID
    (
        type = text
        displayname = "Manager Employee ID"
        maxchar = 8
        row = 1
        column = 1
        width = medium
    )
    Manager_Email
    (
        type = email
        displayname = "Manager Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Department_Head_Email
    (
        type = email
        displayname = "Department Head Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Compliance_Reviewer_Email
    (
        type = email
        displayname = "Compliance Reviewer Email"
        row = 1
        column = 2
        width = medium
    )
    CFO_Approver_Email
    (
        type = email
        displayname = "CFO Approver Email"
        row = 1
        column = 1
        width = medium
    )
    Country_Code
    (
        type = text
        displayname = "Country Code"
        maxchar = 3
        initial value = "USA"
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Critical_Violations_12M
    (
        type = number
        displayname = "Critical Violations 12M"
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Warning_Violations_12M
    (
        type = number
        displayname = "Warning Violations 12M"
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Repeat_Offender
    (
        type = checkbox
        displayname = "Repeat Offender"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    SAP_Last_Sync
    (
        type = datetime
        displayname = "SAP Last Sync"
        row = 1
        column = 1
        width = medium
    )
    Source_System
    (
        type = picklist
        displayname = "Source System"
        values = {"SAP HR","Manual Upload"}
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
