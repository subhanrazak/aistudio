list Repeat_Offenders
{
    displayName = "Repeat Offenders"
    show all rows from TE_Employees [Repeat_Offender == true]
    (
        Employee_ID
        Employee_Name
        Department
        Critical_Violations_12M
        Warning_Violations_12M
        Manager_Email
    )
    sort by
    (
        Critical_Violations_12M descending
    )
}
