default list All_TE_Employees
{
    displayName = "All T&E Employees"
    show all rows from TE_Employees
    (
        Employee_ID
        Employee_Name
        Login_Email
        Employee_Grade_Band
        Department
        Cost_Center
        Manager_Email
        Active
        Repeat_Offender
    )
    filters
    (
        Department
        Employee_Grade_Band
        Active
        Repeat_Offender
    )
    sort by
    (
        Employee_Name ascending
    )
}
