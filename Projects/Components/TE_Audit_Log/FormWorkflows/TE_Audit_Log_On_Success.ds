TE_Audit_Log_On_Success as "TE Audit Log On Success"
{
    type = form
    form = TE_Audit_Log
    record event = on add or edit
    description = "Audit records are append-only; this workflow intentionally performs no cross-form updates."

    on success
    {
        actions
        {
            custom deluge script
            (
                info "TE_Audit_Log append-only record saved without cross-form updates: " + input.Event_Key;
            )
        }
    }
}
