form TE_Audit_Log
{
    displayname = "T&E Audit Log"
    Audit_Event
    (
        type = section
        displayname = "Audit Event"
        row = 1
        column = 0
    )
    must have unique Event_Key
    (
        type = text
        displayname = "Event Key"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    must have Event_Timestamp
    (
        type = datetime
        displayname = "Event Timestamp"
        row = 1
        column = 2
        width = medium
    )
    Actor_Email
    (
        type = email
        displayname = "Actor Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Actor_Profile
    (
        type = text
        displayname = "Actor Profile"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    must have Entity_Type
    (
        type = picklist
        displayname = "Entity Type"
        values = {"Employee","Claim","Line Item","Compliance Result","Exception","Policy Rule","Rate Table","Distance Lookup","Holiday Calendar","Entertainment Budget","SAP Sync","Security"}
        row = 1
        column = 1
        width = medium
    )
    Entity_Record_ID
    (
        type = text
        displayname = "Entity Record ID"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    must have Action
    (
        type = text
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    Before_Value
    (
        type = textarea
        displayname = "Before Value"
        row = 1
        column = 2
        width = medium
    )
    After_Value
    (
        type = textarea
        displayname = "After Value"
        row = 1
        column = 1
        width = medium
    )
    IP_Address
    (
        type = text
        displayname = "IP Address"
        maxchar = 45
        row = 1
        column = 2
        width = medium
    )
    must have Severity
    (
        type = picklist
        values = {"Info","Warning","Critical"}
        row = 1
        column = 1
        width = medium
    )
    Export_Batch_ID
    (
        type = text
        displayname = "Export Batch ID"
        maxchar = 60
        row = 1
        column = 2
        width = medium
    )
    Immutable_Flag
    (
        type = checkbox
        displayname = "Immutable Flag"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
