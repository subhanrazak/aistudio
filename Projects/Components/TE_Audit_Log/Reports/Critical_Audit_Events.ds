list Critical_Audit_Events
{
    displayName = "Critical Audit Events"
    show all rows from TE_Audit_Log [Severity == "Critical"]
    (
        Event_Timestamp
        Actor_Email
        Entity_Type
        Entity_Record_ID
        Action
        Before_Value
        After_Value
    )
    sort by
    (
        Event_Timestamp descending
    )
}
