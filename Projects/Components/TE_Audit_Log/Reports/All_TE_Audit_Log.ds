default list All_TE_Audit_Log
{
    displayName = "All T&E Audit Log"
    show all rows from TE_Audit_Log
    (
        Event_Timestamp
        Actor_Email
        Entity_Type
        Entity_Record_ID
        Action
        Severity
    )
    filters
    (
        Entity_Type
        Severity
        Actor_Email
    )
    sort by
    (
        Event_Timestamp descending
    )
}
