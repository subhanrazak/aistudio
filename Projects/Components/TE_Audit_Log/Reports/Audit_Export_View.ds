list Audit_Export_View
{
    displayName = "Audit Export View"
    show all rows from TE_Audit_Log
    (
        Event_Key
        Event_Timestamp
        Actor_Email
        Actor_Profile
        Entity_Type
        Entity_Record_ID
        Action
        Before_Value
        After_Value
        IP_Address
        Severity
        Export_Batch_ID
    )
    sort by
    (
        Event_Timestamp descending
    )
}
