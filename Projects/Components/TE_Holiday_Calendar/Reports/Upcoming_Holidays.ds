calendar Upcoming_Holidays
{
    displayName = "Upcoming Holidays"
    show all rows from TE_Holiday_Calendar [Active == true]
    (
        Holiday_Name
        Holiday_Date
        Country_Code
        Region_State
    )
    options
    (
        display type = month
        display field = Holiday_Name
        start date = Holiday_Date
        default date
        (
            day   = Today
            month = Currentmonth
            year  = Currentyear
        )
    )
}