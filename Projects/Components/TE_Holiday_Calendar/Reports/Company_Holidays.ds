default list Company_Holidays
{
    displayName = "Company Holidays"
    show all rows from TE_Holiday_Calendar
    (
        Holiday_Code
        Holiday_Name
        Holiday_Date
        Country_Code
        Region_State
        Active
    )
    filters
    (
        Country_Code
        Active
    )
    sort by
    (
        Holiday_Date ascending
    )
}