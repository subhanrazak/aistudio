form TE_Holiday_Calendar
{
    displayname = "Company Holiday Calendar"
    Holiday_Definition
    (
        type = section
        displayname = "Holiday Definition"
        row = 1
        column = 0
    )
    must have unique Holiday_Code
    (
        type = text
        displayname = "Holiday Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Holiday_Name
    (
        type = text
        displayname = "Holiday Name"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Holiday_Date
    (
        type = date
        displayname = "Holiday Date"
        row = 1
        column = 1
        width = medium
    )
    must have Country_Code
    (
        type = text
        displayname = "Country Code"
        maxchar = 3
        row = 1
        column = 2
        width = medium
    )
    Region_State
    (
        type = text
        displayname = "Region State"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    Business_Day_Flag
    (
        type = checkbox
        displayname = "Business Day Flag"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}