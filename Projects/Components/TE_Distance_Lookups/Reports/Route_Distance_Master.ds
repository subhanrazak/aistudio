default list Route_Distance_Master
{
    displayName = "Route Distance Master"
    show all rows from TE_Distance_Lookups
    (
        Route_Code
        Origin_City
        Destination_City
        Expected_Distance_KM
        Tolerance_Percent
        Active
        Origin_Country
        Destination_Country
    )
    filters
    (
        Origin_Country
        Destination_Country
        Active
    )
    sort by
    (
        Origin_City ascending
    )
}
