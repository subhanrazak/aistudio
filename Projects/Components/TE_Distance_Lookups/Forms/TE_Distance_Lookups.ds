form TE_Distance_Lookups
{
    displayname = "Mileage Distance Lookup"
    Route_Definition
    (
        type = section
        displayname = "Route Definition"
        row = 1
        column = 0
    )
    must have unique Route_Code
    (
        type = text
        displayname = "Route Code"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    must have Origin_City
    (
        type = text
        displayname = "Origin City"
        maxchar = 60
        row = 1
        column = 2
        width = medium
    )
    must have Origin_Country
    (
        type = text
        displayname = "Origin Country"
        maxchar = 3
        row = 1
        column = 1
        width = medium
    )
    must have Destination_City
    (
        type = text
        displayname = "Destination City"
        maxchar = 60
        row = 1
        column = 2
        width = medium
    )
    must have Destination_Country
    (
        type = text
        displayname = "Destination Country"
        maxchar = 3
        row = 1
        column = 1
        width = medium
    )
    must have Expected_Distance_KM
    (
        type = decimal
        displayname = "Expected Distance KM"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    must have Tolerance_Percent
    (
        type = decimal
        displayname = "Tolerance Percent"
        decimalplace = 2
        initial value = 20
        row = 1
        column = 1
        width = medium
    )
    must have Effective_Date
    (
        type = date
        displayname = "Effective Date"
        row = 1
        column = 2
        width = medium
    )
    Active
    (
        type = checkbox
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Source
    (
        type = picklist
        values = {"Admin Input","SAP Upload","Manual Correction"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}