form TE_Line_Items
{
    displayname = "T&E Line Items"
    SAP_Expense_Line
    (
        type = section
        displayname = "SAP Expense Line"
        row = 1
        column = 0
    )
    must have unique Line_Item_Key
    (
        type = text
        displayname = "Line Item Key"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Claim
    (
        type = picklist
        values = TE_Claims.ID
        displayformat = [Trip_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Trip_Number_Text
    (
        type = text
        displayname = "Trip Number Text"
        maxchar = 10
        row = 1
        column = 1
        width = medium
    )
    Employee_ID
    (
        type = text
        displayname = "Employee ID"
        maxchar = 8
        row = 1
        column = 2
        width = medium
    )
    must have Expense_Date
    (
        type = date
        displayname = "Expense Date"
        row = 1
        column = 1
        width = medium
    )
    must have Expense_Type_Code
    (
        type = text
        displayname = "Expense Type Code"
        maxchar = 4
        row = 1
        column = 2
        width = medium
    )
    must have Expense_Category
    (
        type = picklist
        displayname = "Expense Category"
        values = {"Hotel","Meals","Airfare","Entertainment","Mileage","Receipt","Other"}
        row = 1
        column = 1
        width = medium
    )
    Expense_Description
    (
        type = text
        displayname = "Expense Description"
        maxchar = 120
        row = 1
        column = 2
        width = medium
    )
    must have Amount
    (
        type = decimal
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    must have Currency
    (
        type = text
        maxchar = 3
        initial value = "USD"
        row = 1
        column = 2
        width = medium
    )
    Receipt_Attached
    (
        type = checkbox
        displayname = "Receipt Attached"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Receipt_Document
    (
        type = upload file
        displayname = "Receipt Document"
        row = 1
        column = 2
        width = medium
    )
    Airfare_Details
    (
        type = section
        displayname = "Airfare Details"
        visibility = true
        row = 2
        column = 1
    )
    Flight_Duration_Hours
    (
        type = decimal
        displayname = "Flight Duration Hours"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Flight_Class
    (
        type = picklist
        displayname = "Flight Class"
        values = {"Economy","Premium Economy","Business","First"}
        row = 2
        column = 2
        width = medium
    )
    Booking_Date
    (
        type = date
        displayname = "Booking Date"
        row = 2
        column = 1
        width = medium
    )
    Departure_Date
    (
        type = date
        displayname = "Departure Date"
        row = 2
        column = 2
        width = medium
    )
    Origin_City
    (
        type = text
        displayname = "Origin City"
        maxchar = 60
        row = 2
        column = 1
        width = medium
    )
    Destination_City
    (
        type = text
        displayname = "Destination City"
        maxchar = 60
        row = 2
        column = 2
        width = medium
    )
    Mileage_Details
    (
        type = section
        displayname = "Mileage Details"
        visibility = true
        row = 3
        column = 1
    )
    Claimed_Mileage_KM
    (
        type = decimal
        displayname = "Claimed Mileage KM"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Expected_Distance_KM
    (
        type = decimal
        displayname = "Expected Distance KM"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Route_Explanation
    (
        type = textarea
        displayname = "Route Explanation"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Entertainment_Details
    (
        type = section
        displayname = "Entertainment Details"
        visibility = true
        row = 4
        column = 1
    )
    Attendee_Count
    (
        type = number
        displayname = "Attendee Count"
        row = 4
        column = 1
        width = medium
    )
    Attendee_Names
    (
        type = textarea
        displayname = "Attendee Names"
        height = 120px
        row = 4
        column = 2
        width = medium
    )
    Attendee_Companies
    (
        type = textarea
        displayname = "Attendee Companies"
        height = 120px
        row = 4
        column = 1
        width = medium
    )
    Business_Purpose
    (
        type = textarea
        displayname = "Business Purpose"
        height = 120px
        row = 4
        column = 2
        width = medium
    )
    Entertainment_Budget_Code
    (
        type = text
        displayname = "Entertainment Budget Code"
        maxchar = 40
        row = 4
        column = 1
        width = medium
    )
    Per_Person_Amount
    (
        type = decimal
        displayname = "Per Person Amount"
        decimalplace = 2
        row = 4
        column = 2
        width = medium
    )
    Compliance_Flags
    (
        type = section
        displayname = "Compliance Flags"
        visibility = true
        row = 5
        column = 1
    )
    Policy_Status
    (
        type = picklist
        displayname = "Policy Status"
        values = {"Not Checked","Pass","Warning","Critical","Duplicate"}
        row = 5
        column = 1
        width = medium
    )
    Violation_Flags
    (
        type = textarea
        displayname = "Violation Flags"
        height = 120px
        row = 5
        column = 2
        width = medium
    )
    Requires_Exception
    (
        type = checkbox
        displayname = "Requires Exception"
        initial value = false
        row = 5
        column = 1
        width = medium
    )
    Last_Checked_On
    (
        type = datetime
        displayname = "Last Checked On"
        row = 5
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
