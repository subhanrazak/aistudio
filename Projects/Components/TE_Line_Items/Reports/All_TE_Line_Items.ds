default list All_TE_Line_Items
{
    displayName = "All T&E Line Items"
    show all rows from TE_Line_Items
    (
        Line_Item_Key
        Claim
        Expense_Date
        Expense_Category
        Amount
        Currency
        Receipt_Attached
        Policy_Status
        Requires_Exception
    )
    filters
    (
        Expense_Category
        Policy_Status
        Receipt_Attached
    )
    sort by
    (
        Expense_Date descending
    )
}
