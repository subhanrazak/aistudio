list Violating_Line_Items
{
    displayName = "Violating Line Items"
    show all rows from TE_Line_Items [Policy_Status == "Warning" || Policy_Status == "Critical" || Policy_Status == "Duplicate"]
    (
        Claim
        Line_Item_Key
        Expense_Date
        Expense_Category
        Amount
        Violation_Flags
        Requires_Exception
    )
}
