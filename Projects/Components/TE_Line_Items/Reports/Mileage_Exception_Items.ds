list Mileage_Exception_Items
{
    displayName = "Mileage Exception Items"
    show all rows from TE_Line_Items [Expense_Category == "Mileage"]
    (
        Claim
        Origin_City
        Destination_City
        Claimed_Mileage_KM
        Expected_Distance_KM
        Route_Explanation
        Policy_Status
    )
}
