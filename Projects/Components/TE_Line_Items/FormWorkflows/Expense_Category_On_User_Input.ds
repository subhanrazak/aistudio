Expense_Category_On_User_Input as "Expense Category On User Input"
{
    type = form
    form = TE_Line_Items
    record event = on add or edit

    on user input of Expense_Category
    {
        actions
        {
            custom deluge script
            (
                if(input.Expense_Category == "Airfare")
                {
                    show Airfare_Details;
                    show Flight_Duration_Hours;
                    show Flight_Class;
                    show Booking_Date;
                    show Departure_Date;
                    show Origin_City;
                    show Destination_City;
                    hide Mileage_Details;
                    input.Claimed_Mileage_KM = null;
                    input.Expected_Distance_KM = null;
                    input.Route_Explanation = "";
                    hide Entertainment_Details;
                    input.Attendee_Count = null;
                    input.Attendee_Names = "";
                    input.Attendee_Companies = "";
                    input.Business_Purpose = "";
                    input.Entertainment_Budget_Code = "";
                    input.Per_Person_Amount = null;
                }
                else if(input.Expense_Category == "Mileage")
                {
                    show Airfare_Details;
                    hide Flight_Duration_Hours;
                    hide Flight_Class;
                    hide Booking_Date;
                    hide Departure_Date;
                    show Origin_City;
                    show Destination_City;
                    show Mileage_Details;
                    hide Entertainment_Details;
                    input.Flight_Duration_Hours = null;
                    input.Flight_Class = null;
                    input.Booking_Date = null;
                    input.Departure_Date = null;
                    input.Attendee_Count = null;
                    input.Attendee_Names = "";
                    input.Attendee_Companies = "";
                    input.Business_Purpose = "";
                    input.Entertainment_Budget_Code = "";
                    input.Per_Person_Amount = null;
                }
                else if(input.Expense_Category == "Entertainment")
                {
                    hide Airfare_Details;
                    hide Mileage_Details;
                    show Entertainment_Details;
                    input.Flight_Duration_Hours = null;
                    input.Flight_Class = null;
                    input.Booking_Date = null;
                    input.Departure_Date = null;
                    input.Origin_City = "";
                    input.Destination_City = "";
                    input.Claimed_Mileage_KM = null;
                    input.Expected_Distance_KM = null;
                    input.Route_Explanation = "";
                    if(input.Amount != null && input.Attendee_Count != null && input.Attendee_Count > 0)
                    {
                        input.Per_Person_Amount = input.Amount / input.Attendee_Count;
                    }
                }
                else
                {
                    hide Airfare_Details;
                    hide Mileage_Details;
                    hide Entertainment_Details;
                    input.Flight_Duration_Hours = null;
                    input.Flight_Class = null;
                    input.Booking_Date = null;
                    input.Departure_Date = null;
                    input.Origin_City = "";
                    input.Destination_City = "";
                    input.Claimed_Mileage_KM = null;
                    input.Expected_Distance_KM = null;
                    input.Route_Explanation = "";
                    input.Attendee_Count = null;
                    input.Attendee_Names = "";
                    input.Attendee_Companies = "";
                    input.Business_Purpose = "";
                    input.Entertainment_Budget_Code = "";
                    input.Per_Person_Amount = null;
                }
                disable Per_Person_Amount;
                disable Expected_Distance_KM;
            )
        }
    }
}
