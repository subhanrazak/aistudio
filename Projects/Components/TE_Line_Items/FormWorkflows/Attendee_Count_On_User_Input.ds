Attendee_Count_On_User_Input as "Attendee Count On User Input"
{
    type = form
    form = TE_Line_Items
    record event = on add or edit

    on user input of Attendee_Count
    {
        actions
        {
            custom deluge script
            (
                if(input.Expense_Category == "Entertainment" && input.Amount != null && input.Attendee_Count != null && input.Attendee_Count > 0)
                {
                    input.Per_Person_Amount = input.Amount / input.Attendee_Count;
                }
                else if(input.Expense_Category == "Entertainment")
                {
                    input.Per_Person_Amount = null;
                }
            )
        }
    }
}
