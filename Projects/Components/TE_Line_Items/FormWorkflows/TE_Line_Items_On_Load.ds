TE_Line_Items_On_Load as "TE Line Items On Load"
{
    type = form
    form = TE_Line_Items
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Expense_Category == "Airfare")
                {
                    show Airfare_Details;
                    show Flight_Duration_Hours;
                    show Flight_Class;
                    show Booking_Date;
                    show Departure_Date;
                    show Origin_City;
                    show Destination_City;
                }
                else if(input.Expense_Category == "Mileage")
                {
                    show Airfare_Details;
                    hide Flight_Duration_Hours;
                    hide Flight_Class;
                    hide Booking_Date;
                    hide Departure_Date;
                    show Origin_City;
                    show Destination_City;
                }
                else
                {
                    hide Airfare_Details;
                }
                if(input.Expense_Category == "Mileage")
                {
                    show Mileage_Details;
                }
                else
                {
                    hide Mileage_Details;
                }
                if(input.Expense_Category == "Entertainment")
                {
                    show Entertainment_Details;
                }
                else
                {
                    hide Entertainment_Details;
                }
                disable Per_Person_Amount;
                disable Expected_Distance_KM;
                receiptThreshold = 25;
                for each receiptRule in TE_Policy_Rules[Active == true && Rule_Category == "Receipt Requirement" && Effective_Date <= zoho.currentdate] sort by Effective_Date desc range from 0 to 0
                {
                    if((receiptRule.Retired_Date == null || receiptRule.Retired_Date >= zoho.currentdate) && receiptRule.Receipt_Minimum_Amount != null && receiptRule.Receipt_Minimum_Amount > 0)
                    {
                        receiptThreshold = receiptRule.Receipt_Minimum_Amount;
                    }
                }
                if(input.Amount != null && input.Amount > receiptThreshold && input.Receipt_Attached == false)
                {
                    alert "Receipt guidance: attach a receipt document for expenses above USD " + receiptThreshold.toText() + ".";
                }
            )
        }
    }
}
