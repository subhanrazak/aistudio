TE_Entertainment_Budgets_On_User_Input_Employee as "TE Entertainment Budgets On User Input Employee"
{
    type = form
    form = TE_Entertainment_Budgets
    record event = on add or edit

    on user input of Employee
    {
        actions
        {
            custom deluge script
            (
                if(input.Employee != null)
                {
                    selectedEmployee = TE_Employees[ID == input.Employee];
                    input.Employee_ID = selectedEmployee.Employee_ID;
                }
                else
                {
                    input.Employee_ID = "";
                }
            )
        }
    }
}
