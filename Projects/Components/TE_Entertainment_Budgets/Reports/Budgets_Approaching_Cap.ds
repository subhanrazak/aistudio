list Budgets_Approaching_Cap
{
    displayName = "Budgets Approaching Cap"
    show all rows from TE_Entertainment_Budgets [Status == "Approaching Cap" || Status == "Exhausted"]
    (
        Budget_Code
        Employee
        Budget_Year
        Annual_Budget
        Used_Amount
        Remaining_Amount
        Warning_Threshold_Percent
        Status
    )
}
