default list Executive_Entertainment_Budgets
{
    displayName = "Executive Entertainment Budgets"
    show all rows from TE_Entertainment_Budgets
    (
        Budget_Code
        Employee
        Employee_ID
        Budget_Year
        Annual_Budget
        Used_Amount
        Remaining_Amount
        Currency
        Status
    )
    filters
    (
        Budget_Year
        Status
    )
    sort by
    (
        Remaining_Amount ascending
    )
}
