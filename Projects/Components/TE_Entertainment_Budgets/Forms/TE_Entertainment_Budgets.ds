form TE_Entertainment_Budgets
{
    displayname = "Entertainment Budgets"
    Budget_Definition
    (
        type = section
        displayname = "Budget Definition"
        row = 1
        column = 0
    )
    must have unique Budget_Code
    (
        type = text
        displayname = "Budget Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Employee
    (
        type = picklist
        values = TE_Employees.ID
        displayformat = [Employee_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Employee_ID
    (
        type = text
        displayname = "Employee ID"
        maxchar = 8
        row = 1
        column = 1
        width = medium
    )
    must have Budget_Year
    (
        type = number
        displayname = "Budget Year"
        row = 1
        column = 2
        width = medium
    )
    must have Annual_Budget
    (
        type = decimal
        displayname = "Annual Budget"
        decimalplace = 2
        initial value = 15000
        row = 1
        column = 1
        width = medium
    )
    Used_Amount
    (
        type = decimal
        displayname = "Used Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Remaining_Amount
    (
        type = decimal
        displayname = "Remaining Amount"
        decimalplace = 2
        initial value = 15000
        row = 1
        column = 1
        width = medium
    )
    must have Currency
    (
        type = text
        maxchar = 3
        initial value = "USD"
        row = 1
        column = 2
        width = medium
    )
    Warning_Threshold_Percent
    (
        type = decimal
        displayname = "Warning Threshold Percent"
        decimalplace = 2
        initial value = 80
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        values = {"Active","Approaching Cap","Exhausted","Closed"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Last_Recalculated_On
    (
        type = datetime
        displayname = "Last Recalculated On"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
