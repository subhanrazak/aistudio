TE_Exceptions_On_Validate as "TE Exceptions On Validate"
{
    type = form
    form = TE_Exceptions
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Business_Justification == null || input.Business_Justification == "")
                {
                    alert "Business Justification is required for a policy exception.";
                    cancel submit;
                }
                if(input.Policy_Limit == null)
                {
                    input.Policy_Limit = 0;
                }
                if(input.Actual_Amount == null)
                {
                    input.Actual_Amount = 0;
                }
                calculatedExcess = input.Actual_Amount - input.Policy_Limit;
                if(calculatedExcess < 0)
                {
                    calculatedExcess = 0;
                }
                input.Excess_Amount = calculatedExcess;
                routeAmount = input.Excess_Amount;
                if(input.Status == null || input.Status == "")
                {
                    input.Status = "Draft";
                }
                shouldRoute = true;
                if(input.Status == "Approved" || input.Status == "Rejected" || input.Status.contains("Pending") == true || input.Status == "Escalated" || input.Approval_Decision == "Approve" || input.Approval_Decision == "Reject" || input.Approval_Decision == "Return for Information")
                {
                    shouldRoute = false;
                }
                if(shouldRoute == true)
                {
                    if(routeAmount <= 500)
                    {
                        input.Exception_Approver_Level = "Direct Manager";
                        if(input.Status == "Draft" || input.Status == "Returned for Information")
                        {
                            input.Status = "Pending Manager Approval";
                        }
                        input.SLA_Due_Date = zoho.currentdate.addBusinessDay(1);
                    }
                    else if(routeAmount <= 2000)
                    {
                        input.Exception_Approver_Level = "Department Head";
                        if(input.Status == "Draft" || input.Status == "Returned for Information")
                        {
                            input.Status = "Pending Department Head Approval";
                        }
                        input.SLA_Due_Date = zoho.currentdate.addBusinessDay(2);
                    }
                    else if(routeAmount <= 5000)
                    {
                        input.Exception_Approver_Level = "Compliance Officer";
                        if(input.Status == "Draft" || input.Status == "Returned for Information")
                        {
                            input.Status = "Pending Compliance Approval";
                        }
                        input.SLA_Due_Date = zoho.currentdate.addBusinessDay(3);
                    }
                    else
                    {
                        input.Exception_Approver_Level = "CFO";
                        if(input.Status == "Draft" || input.Status == "Returned for Information")
                        {
                            input.Status = "Pending CFO Approval";
                        }
                        input.SLA_Due_Date = zoho.currentdate.addBusinessDay(5);
                    }
                }
                if((input.Approval_Decision == "Reject" || input.Approval_Decision == "Return for Information") && (input.Approval_Comments == null || input.Approval_Comments == ""))
                {
                    alert "Approval Comments are required when rejecting or returning an exception for information.";
                    cancel submit;
                }
                if(input.Approval_Decision == "Approve" && input.Status != "Approved")
                {
                    input.Status = "Approved";
                    input.Decision_Date = zoho.currenttime;
                }
                else if(input.Approval_Decision == "Reject" && input.Status != "Rejected")
                {
                    input.Status = "Rejected";
                    input.Decision_Date = zoho.currenttime;
                }
                else if(input.Approval_Decision == "Return for Information" && input.Status != "Returned for Information")
                {
                    input.Status = "Returned for Information";
                    input.Decision_Date = zoho.currenttime;
                }
                if(input.Currency != null && input.Currency != "" && input.Currency.length() != 3)
                {
                    alert "Currency must be a 3-character ISO code such as USD.";
                    cancel submit;
                }
            )
        }
    }
}
