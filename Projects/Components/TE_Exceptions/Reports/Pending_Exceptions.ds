list Pending_Exceptions
{
    displayName = "Pending Exceptions"
    show all rows from TE_Exceptions [(Status == "Pending Manager Approval" || Status == "Pending Department Head Approval" || Status == "Pending Compliance Approval" || Status == "Pending CFO Approval" || Status == "Escalated")]
    (
        Exception_Number
        Claim
        Excess_Amount
        Exception_Approver_Level
        Exception_Approver_Email
        SLA_Due_Date
        Status
    )
    sort by
    (
        SLA_Due_Date ascending
    )
}
