default list All_TE_Exceptions
{
    displayName = "All T&E Exceptions"
    show all rows from TE_Exceptions
    (
        Exception_Number
        Claim
        Violated_Rule
        Excess_Amount
        Currency
        Exception_Approver_Level
        Exception_Approver_Email
        SLA_Due_Date
        Status
    )
    filters
    (
        Status
        Exception_Approver_Level
        Currency
    )
    sort by
    (
        SLA_Due_Date ascending
    )
}
