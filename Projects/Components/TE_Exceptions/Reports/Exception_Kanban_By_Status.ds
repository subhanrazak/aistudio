kanban Exception_Kanban_By_Status
{
    displayName = "Exception Kanban By Status"
    show all rows from TE_Exceptions
    (
        Exception_Number
        Claim
        Excess_Amount
        Exception_Approver_Level
        SLA_Due_Date
        Status
    )
    sort by
    (
        SLA_Due_Date ascending
    )
    options
    (
        display field = Status
        sort order = ascending
        record count = enable
    )
}
