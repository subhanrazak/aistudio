list Violation_Type_Distribution
{
    displayName = "Violation Type Distribution"
    show all rows from TE_Compliance_Results [Pass_Fail == "Fail"]
    (
        Rule_Category
        Result_Key
        Excess_Amount
        (
            display = total
        )
        Pass_Fail
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Rule_Category ascending
    )
    sort by
    (
        Rule_Category ascending
    )
}
