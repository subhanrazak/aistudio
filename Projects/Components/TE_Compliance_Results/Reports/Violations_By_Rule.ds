list Violations_By_Rule
{
    displayName = "Violations By Rule"
    show all rows from TE_Compliance_Results [Pass_Fail == "Fail"]
    (
        Rule_Category
        Severity
        Result_Key
        Excess_Amount
        (
            display = total
        )
        Pass_Fail
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Rule_Category ascending
        Severity ascending
    )
    sort by
    (
        Rule_Category ascending
        Severity ascending
    )
}
