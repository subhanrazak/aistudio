form TE_Compliance_Results
{
    displayname = "Compliance Results"
    Result_Identity
    (
        type = section
        displayname = "Result Identity"
        row = 1
        column = 0
    )
    must have unique Result_Key
    (
        type = text
        displayname = "Result Key"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    must have Claim
    (
        type = picklist
        values = TE_Claims.ID
        displayformat = [Trip_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Line_Item
    (
        type = picklist
        displayname = "Line Item"
        values = TE_Line_Items.ID
        displayformat = [Line_Item_Key]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Policy_Rule
    (
        type = picklist
        displayname = "Policy Rule"
        values = TE_Policy_Rules.ID
        displayformat = [Rule_ID]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Rule_Category
    (
        type = picklist
        displayname = "Rule Category"
        values = {"Hotel Rate Limit","Per Diem / Meals","Airfare Class","Advance Booking","Receipt Requirement","Entertainment Documentation","Entertainment Budget Cap","Duplicate Expense","Weekend/Holiday Travel","Mileage Reasonableness"}
        row = 1
        column = 1
        width = medium
    )
    must have Pass_Fail
    (
        type = picklist
        displayname = "Pass Fail"
        values = {"Pass","Fail","Not Applicable"}
        row = 1
        column = 2
        width = medium
    )
    must have Severity
    (
        type = picklist
        values = {"Info","Warning","Critical"}
        row = 1
        column = 1
        width = medium
    )
    Policy_Limit
    (
        type = decimal
        displayname = "Policy Limit"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Actual_Amount
    (
        type = decimal
        displayname = "Actual Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Excess_Amount
    (
        type = decimal
        displayname = "Excess Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Currency
    (
        type = text
        maxchar = 3
        initial value = "USD"
        row = 1
        column = 1
        width = medium
    )
    Violation_Description
    (
        type = textarea
        displayname = "Violation Description"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Rule_Reference
    (
        type = text
        displayname = "Rule Reference"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Recommended_Action
    (
        type = textarea
        displayname = "Recommended Action"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Exception_Required
    (
        type = checkbox
        displayname = "Exception Required"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Exception_Status
    (
        type = picklist
        displayname = "Exception Status"
        values = {"Not Required","Pending","Approved","Rejected"}
        initial value = "Not Required"
        row = 1
        column = 2
        width = medium
    )
    Checked_On
    (
        type = datetime
        displayname = "Checked On"
        row = 1
        column = 1
        width = medium
    )
    Checked_By
    (
        type = text
        displayname = "Checked By"
        maxchar = 80
        initial value = "System"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
