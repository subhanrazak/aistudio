default list SAP_Sync_History
{
    displayName = "SAP Sync History"
    show all rows from TE_Sync_Log
    (
        Sync_Run_ID
        Source_System
        SAP_Table
        Started_On
        Completed_On
        Sync_Status
        Records_Read
        Records_Imported
        Records_Failed
    )
    filters
    (
        Source_System
        SAP_Table
        Sync_Status
    )
    sort by
    (
        Started_On descending
    )
}