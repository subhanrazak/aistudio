form TE_Sync_Log
{
    displayname = "SAP Sync Log"
    Sync_Run
    (
        type = section
        displayname = "Sync Run"
        row = 1
        column = 0
    )
    must have unique Sync_Run_ID
    (
        type = text
        displayname = "Sync Run ID"
        maxchar = 60
        row = 1
        column = 1
        width = medium
    )
    must have Source_System
    (
        type = picklist
        displayname = "Source System"
        values = {"SAP FI-TV","SAP HR","SAP FI-AP","Manual Import","Demo Seed"}
        row = 1
        column = 2
        width = medium
    )
    SAP_Table
    (
        type = picklist
        displayname = "SAP Table"
        values = {"PTRV_HEAD","PTRV_PERIO","PA0001","HRP1000","T706B","T001","Multiple"}
        row = 1
        column = 1
        width = medium
    )
    must have Started_On
    (
        type = datetime
        displayname = "Started On"
        row = 1
        column = 2
        width = medium
    )
    Completed_On
    (
        type = datetime
        displayname = "Completed On"
        row = 1
        column = 1
        width = medium
    )
    must have Sync_Status
    (
        type = picklist
        displayname = "Sync Status"
        values = {"Started","Completed","Failed","Partial","Placeholder Only"}
        row = 1
        column = 2
        width = medium
    )
    Records_Read
    (
        type = number
        displayname = "Records Read"
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Records_Imported
    (
        type = number
        displayname = "Records Imported"
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Records_Failed
    (
        type = number
        displayname = "Records Failed"
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Error_Message
    (
        type = textarea
        displayname = "Error Message"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Triggered_By_Email
    (
        type = email
        displayname = "Triggered By Email"
        row = 1
        column = 1
        width = medium
    )
    Next_Scheduled_Run
    (
        type = datetime
        displayname = "Next Scheduled Run"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}