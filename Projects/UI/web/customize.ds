customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }
    font = "lato"
    color options
    {
        color = "11"
    }
    logo
    {
        preference = "app_icon"
        placement = "left"
    }
    custom css
    {
        content = ".te-critical{color:#b42318}.te-warning{color:#b54708}.te-green{color:#067647}.te-card{border-radius:14px;}"
    }
}