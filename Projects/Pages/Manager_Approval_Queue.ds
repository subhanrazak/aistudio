<page linkname = "Manager_Approval_Queue" displayname = "Manager Approval Queue"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Manager_Approval_Header' elementName='Manager_Approval_Header'>
          <![CDATA[htmlpage Manager_Approval_Header()
            content
             <%{%>
                 <file name:Manager_Approval_Header.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Claim_Scorecards' elementName='Claim_Scorecards'>
          <![CDATA[htmlpage Claim_Scorecards()
            content
             <%{%>
                 <file name:Claim_Scorecards.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Pending_Manager_Approval_Report.ds/>
      </column>
    </row>
    <row>
      <column width='58%'>
        <dsp id='Exception_Status' elementName='Exception_Status'>
          <![CDATA[htmlpage Exception_Status()
            content
             <%{%>
                 <file name:Exception_Status.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
      <column width='42%'>
        <dsp id='Guidance_Panel' elementName='Guidance_Panel'>
          <![CDATA[htmlpage Guidance_Panel()
            content
             <%{%>
                 <file name:Guidance_Panel.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>