<style>
:root {
  --zcs-theme-brand-color: var(--zcs_brand_color);
  --zcs-white-color: #FFFFFF;
  --zcs-page-bg-color: #F3F3F4;
  --zcs-primary-text-color: var(--zcs_primary_text_color);
  --zcs-secondary-text-color: var(--zcs_secondary_text_color);
  --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
  --zcs-border-color: var(--zcs_tertiary_border_color);
}
.zcs-row,.zcs-flex{display:flex}.zcs-row{flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-10{margin-top:.625rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-full{border-radius:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-heading{line-height:1.25}.zcs-lh-body{line-height:1.5}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-card{background-color:#fff;border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}a{text-decoration:none;color:inherit}#splash-screen{display:none!important}
.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color);overflow:hidden}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}
.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#B8770D}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-icon{font-style:normal}
.cd-page{background:var(--zcs-page-bg-color);padding:20px;box-sizing:border-box;font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color)}
.cd-header{background:linear-gradient(135deg,var(--zcs_brand_color),#1c1c40);border-radius:18px;padding:24px;position:relative;overflow:hidden;color:#fff}.cd-header:after{content:"";position:absolute;right:-60px;top:-80px;width:240px;height:240px;border:36px solid rgba(255,255,255,.14);border-radius:50%}.cd-header:before{content:"";position:absolute;right:130px;bottom:-90px;width:180px;height:180px;border:24px solid rgba(255,255,255,.10);border-radius:50%}.cd-header-content{position:relative;z-index:1}.cd-header h1{margin:0;font-size:28px;line-height:1.2;font-weight:700}.cd-header p{margin:8px 0 0;color:rgba(255,255,255,.86);max-width:860px}.cd-kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(170px,1fr));gap:16px;margin-top:16px}.cd-kpi-card{min-height:148px;position:relative;overflow:hidden}.cd-kpi-icon{width:42px;height:42px;border-radius:14px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;font-size:22px}.cd-kpi-value{font-size:28px;font-weight:700;line-height:1.1;margin-top:14px;color:var(--zcs-primary-text-color)}.cd-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:6px}.cd-kpi-note{font-size:12px;color:var(--zcs-teritiary-text-color);margin-top:8px}.cd-target-card{margin-top:16px;display:grid;grid-template-columns:260px 1fr;gap:22px;align-items:center}.cd-gauge{--p:0;--gauge-color:var(--zcs_brand_color);width:184px;height:184px;border-radius:50%;background:conic-gradient(var(--gauge-color) calc(var(--p)*1%),#e8eaf2 0);display:flex;align-items:center;justify-content:center;position:relative}.cd-gauge:after{content:"";position:absolute;width:128px;height:128px;border-radius:50%;background:#fff}.cd-gauge-inner{position:relative;z-index:2;text-align:center}.cd-gauge-inner strong{display:block;font-size:30px}.cd-gauge-inner span{display:block;font-size:12px;color:var(--zcs-secondary-text-color)}.cd-progress-row{margin-top:12px}.cd-progress-meta{display:flex;justify-content:space-between;font-size:12px;color:var(--zcs-secondary-text-color);margin-top:6px}.cd-target-copy h3{margin:0;font-size:18px}.cd-target-copy p{margin:8px 0 0;color:var(--zcs-secondary-text-color)}@media(max-width:1180px){.cd-kpi-grid{grid-template-columns:repeat(2,minmax(220px,1fr))}.cd-target-card{grid-template-columns:1fr}}@media(max-width:640px){.cd-page{padding:12px}.cd-kpi-grid{grid-template-columns:1fr}.cd-target-card{display:block}.cd-gauge{margin:0 auto 18px}.cd-header h1{font-size:22px}}
</style>
<%
totalClaims = TE_Claims[ID != 0].count(ID);
compliantClaims = TE_Claims[Compliance_Rating == "Green" || Claim_Status == "Compliance Cleared - Green" || Claim_Status == "Compliance Cleared - Approved" || Claim_Status == "SAP Approved"].count(ID);
criticalClaims = TE_Claims[Critical_Violation_Count > 0].count(ID);
criticalResults = TE_Compliance_Results[Pass_Fail == "Fail" && Severity == "Critical"].count(ID);
estimatedSavings = ifnull(TE_Claims[ID != 0].sum(Estimated_Savings),0);
checkedClaims = TE_Claims[Compliance_Rating == "Green" || Compliance_Rating == "Yellow" || Compliance_Rating == "Red"].count(ID);
complianceRate = 0.0;
coverageRate = 0.0;
if(totalClaims > 0)
{
  complianceRate = (compliantClaims * 100.0) / totalClaims;
  coverageRate = (checkedClaims * 100.0) / totalClaims;
}
cycleTotal = 0.0;
cycleCount = 0;
for each cl in TE_Claims[Submission_Date != null && Last_Compliance_Check != null]
{
  cycleTotal = cycleTotal + cl.Submission_Date.daysBetween(cl.Last_Compliance_Check.toDate());
  cycleCount = cycleCount + 1;
}
avgCycle = 0.0;
if(cycleCount > 0)
{
  avgCycle = cycleTotal / cycleCount;
}
gaugeColor = "var(--zcs_brand_color)";
if(complianceRate < 70)
{
  gaugeColor = "#FE455D";
}
else if(complianceRate < 85)
{
  gaugeColor = "#FAAE13";
}
%>
<div class="cd-page">
  <section class="cd-header">
    <div class="cd-header-content zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16">
      <div>
        <h1>Compliance Dashboard</h1>
        <p>Executive and policy-owner analytics for claim compliance, enforcement savings, violation concentration, repeat-risk signals, and policy trend insights.</p>
      </div>
      <div class="zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-4 zcs-box-border">
        <i class="zcs-badge-icon zc-li-outline business-chart-bar-32"></i>
        <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Finance and Policy View</span>
      </div>
    </div>
  </section>
  <section class="cd-kpi-grid">
    <div class="cd-kpi-card zcs-card zcs-p-20 zcs-box-border">
      <div class="cd-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div>
      <div class="cd-kpi-value"><%=complianceRate%>%</div>
      <div class="cd-kpi-label">Overall Compliance Rate</div>
      <div class="cd-kpi-note"><%=compliantClaims%> compliant of <%=totalClaims%> claims</div>
    </div>
    <div class="cd-kpi-card zcs-card zcs-p-20 zcs-box-border">
      <div class="cd-kpi-icon"><i class="zc-li-outline ui-1-circle-remove"></i></div>
      <div class="cd-kpi-value"><%=criticalClaims%></div>
      <div class="cd-kpi-label">Claims with Critical Violations</div>
      <div class="cd-kpi-note"><%=criticalResults%> critical failed rule checks</div>
    </div>
    <div class="cd-kpi-card zcs-card zcs-p-20 zcs-box-border">
      <div class="cd-kpi-icon"><i class="zc-li-outline business-money-coins"></i></div>
      <div class="cd-kpi-value">$<%=estimatedSavings%></div>
      <div class="cd-kpi-label">Estimated Savings from Enforcement</div>
      <div class="cd-kpi-note">Summed from claim scorecards</div>
    </div>
    <div class="cd-kpi-card zcs-card zcs-p-20 zcs-box-border">
      <div class="cd-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div>
      <div class="cd-kpi-value"><%=avgCycle%>d</div>
      <div class="cd-kpi-label">Average Approval Cycle Proxy</div>
      <div class="cd-kpi-note">Submission to last compliance check</div>
    </div>
    <div class="cd-kpi-card zcs-card zcs-p-20 zcs-box-border">
      <div class="cd-kpi-icon"><i class="zc-li-outline ui-1-zoom"></i></div>
      <div class="cd-kpi-value"><%=coverageRate%>%</div>
      <div class="cd-kpi-label">Pre-Payment Check Coverage</div>
      <div class="cd-kpi-note"><%=checkedClaims%> checked before payment release</div>
    </div>
  </section>
  <section class="cd-target-card zcs-card zcs-p-24 zcs-box-border">
    <div class="zcs-flex zcs-justify-center">
      <div class="cd-gauge" style="--p:<%=complianceRate%>;--gauge-color:<%=gaugeColor%>;">
        <div class="cd-gauge-inner"><strong><%=complianceRate%>%</strong><span>Target 85%</span></div>
      </div>
    </div>
    <div class="cd-target-copy">
      <h3 class="zcs-color-primary">Target compliance threshold</h3>
      <p>Policy teams target at least 85% overall compliance. The progress bar shows current performance against the executive threshold and flags under-target conditions.</p>
      <div class="cd-progress-row zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6">
        <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=complianceRate%>%;background:<%=gaugeColor%>;"></div></div>
        <p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0">
          <span class="zcs-color-primary">Current compliance</span><span class="zcs-color-primary"><%=complianceRate%>% of 85% target</span>
        </p>
      </div>
    </div>
  </section>
</div>