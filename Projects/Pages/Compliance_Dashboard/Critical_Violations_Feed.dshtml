<style>
.cd-section{background:var(--zcs-page-bg-color);padding:0 20px 20px;box-sizing:border-box;font-family:Inter,Arial,sans-serif}.cd-card-title{margin:0 0 4px;font-size:18px;font-weight:700;color:var(--zcs-primary-text-color)}.cd-card-subtitle{margin:0 0 16px;font-size:13px;color:var(--zcs-secondary-text-color)}.cd-feed{display:flex;flex-direction:column;gap:10px}.cd-feed-row{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:flex-start;border:1px solid var(--zcs-border-color);border-radius:14px;padding:12px;background:#fff}.cd-feed-icon{width:42px;height:42px;border-radius:14px;background:#FDE3E6;color:#FE455D;display:flex;align-items:center;justify-content:center;font-size:20px}.cd-feed-title{font-weight:700;color:var(--zcs-primary-text-color);font-size:14px;margin:0}.cd-feed-meta{display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:6px;color:var(--zcs-secondary-text-color);font-size:12px}.cd-feed-desc{margin:8px 0 0;color:var(--zcs-secondary-text-color);font-size:13px;line-height:1.45}.cd-feed-actions{display:flex;gap:8px;align-items:center;white-space:nowrap}.cd-link-btn{border:1px solid var(--zcs_brand_color);color:var(--zcs_brand_color);border-radius:8px;padding:6px 10px;font-size:12px;display:inline-flex;align-items:center;gap:6px;background:#fff}.cd-link-btn:hover{background:var(--zcs_component_hover_color)}.cd-nodata{min-height:170px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--zcs-secondary-text-color)}@media(max-width:760px){.cd-section{padding:0 12px 12px}.cd-feed-row{grid-template-columns:42px 1fr}.cd-feed-actions{grid-column:1 / -1;white-space:normal;flex-wrap:wrap}}
</style>
<%
feedTotal = TE_Compliance_Results[Pass_Fail == "Fail" && Severity == "Critical"].count(ID);
%>
<div class="cd-section">
  <section class="zcs-card zcs-p-24 zcs-box-border">
    <div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12">
      <div>
        <h2 class="cd-card-title">Recent critical violations feed</h2>
        <p class="cd-card-subtitle">Latest critical failed compliance results with claim and result report links.</p>
      </div>
      <div class="zcs-badge zcs-badge-filled-outline zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-4 zcs-box-border"><i class="zcs-badge-icon zc-li-outline ui-1-circle-remove"></i><span class="zcs-font-14"><%=feedTotal%> total</span></div>
    </div>
    <% if(feedTotal == 0) { %>
      <div class="cd-nodata"><div><i class="zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-theme"></i><br>No recent critical violations.</div></div>
    <% } else { %>
      <div class="cd-feed">
      <%
        feedCount = 0;
        for each res in TE_Compliance_Results[Pass_Fail == "Fail" && Severity == "Critical"] sort by Checked_On desc
        {
          if(feedCount < 8)
          {
            tripNo = ifnull(res.Claim.Trip_Number,"Claim not linked");
            empId = ifnull(res.Claim.Employee_ID,"Unknown employee");
            dept = ifnull(res.Claim.Department,"Unassigned");
            descText = ifnull(res.Violation_Description,"Critical policy failure requires review.");
            resultUrl = "#Report:Critical_Violations?ID=" + res.ID;
            claimUrl = "#Report:All_TE_Claims?Trip_Number=" + encodeURL(tripNo);
            %>
            <article class="cd-feed-row">
              <div class="cd-feed-icon"><i class="zc-li-outline ui-1-circle-remove"></i></div>
              <div>
                <p class="cd-feed-title"><%=res.Rule_Category%> on <%=tripNo%></p>
                <div class="cd-feed-meta">
                  <span>Result: <%=res.Result_Key%></span>
                  <span>Employee: <%=empId%></span>
                  <span>Department: <%=dept%></span>
                  <span>Excess: $<%=ifnull(res.Excess_Amount,0)%></span>
                </div>
                <p class="cd-feed-desc"><%=descText%></p>
              </div>
              <div class="cd-feed-actions">
                <a class="cd-link-btn" href="<%=resultUrl%>"><i class="zc-li-outline ui-1-zoom"></i>Result</a>
                <a class="cd-link-btn" href="<%=claimUrl%>"><i class="zc-li-outline files-single-content-03"></i>Claim</a>
              </div>
            </article>
            <%
            feedCount = feedCount + 1;
          }
        }
      %>
      </div>
    <% } %>
  </section>
</div>