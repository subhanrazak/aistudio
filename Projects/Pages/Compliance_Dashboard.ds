<page linkname = "Compliance_Dashboard" displayname = "Compliance Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Dashboard_Summary' elementName='Dashboard_Summary'>
          <![CDATA[htmlpage Dashboard_Summary()
             content
             <%{%>
                 <file name:Dashboard_Summary.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Violation_Charts' elementName='Violation_Charts'>
          <![CDATA[htmlpage Violation_Charts()
             content
             <%{%>
                 <file name:Violation_Charts.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Department_Heatmap' elementName='Department_Heatmap'>
          <![CDATA[htmlpage Department_Heatmap()
             content
             <%{%>
                 <file name:Department_Heatmap.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Trends_And_Policy' elementName='Trends_And_Policy'>
          <![CDATA[htmlpage Trends_And_Policy()
             content
             <%{%>
                 <file name:Trends_And_Policy.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Critical_Violations_Feed' elementName='Critical_Violations_Feed'>
          <![CDATA[htmlpage Critical_Violations_Feed()
             content
             <%{%>
                 <file name:Critical_Violations_Feed.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>