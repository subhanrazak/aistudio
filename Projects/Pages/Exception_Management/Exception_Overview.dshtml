<%
  pendingSet = TE_Exceptions[(Status == "Pending Manager Approval" || Status == "Pending Department Head Approval" || Status == "Pending Compliance Approval" || Status == "Pending CFO Approval" || Status == "Escalated")];
  pendingCount = pendingSet.count(ID);
  overdueCount = TE_Exceptions[(Status == "Pending Manager Approval" || Status == "Pending Department Head Approval" || Status == "Pending Compliance Approval" || Status == "Pending CFO Approval" || Status == "Escalated") && SLA_Due_Date != null && SLA_Due_Date < zoho.currentdate].count(ID);
  pendingExcess = ifnull(pendingSet.sum(Excess_Amount),0);
  currentEmail = zoho.loginuserid;
  myPending = TE_Exceptions[(Status == "Pending Manager Approval" || Status == "Pending Department Head Approval" || Status == "Pending Compliance Approval" || Status == "Pending CFO Approval" || Status == "Escalated") && Exception_Approver_Email == currentEmail].count(ID);
  approvedThisMonth = 0;
  rejectedThisMonth = 0;
  approvedRows = TE_Exceptions[Status == "Approved" && Decision_Date != null];
  rejectedRows = TE_Exceptions[Status == "Rejected" && Decision_Date != null];
  for each rec in approvedRows
  {
    if(rec.Decision_Date.getMonth() == zoho.currentdate.getMonth() && rec.Decision_Date.getYear() == zoho.currentdate.getYear())
    {
      approvedThisMonth = approvedThisMonth + 1;
    }
  }
  for each rec in rejectedRows
  {
    if(rec.Decision_Date.getMonth() == zoho.currentdate.getMonth() && rec.Decision_Date.getYear() == zoho.currentdate.getYear())
    {
      rejectedThisMonth = rejectedThisMonth + 1;
    }
  }
%>
<style>
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-white-color: #FFFFFF; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-page-bg-color: #F3F3F4; }
.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-m-0{margin:0}.zcs-mt-8{margin-top:.5rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs_brand_color)}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-w-full{width:100%}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none}
.zcs-badge{width:auto}.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#b8770d}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}
.em-page{background:var(--zcs-page-bg-color);padding:18px;box-sizing:border-box}.em-header{background:linear-gradient(135deg,var(--zcs_brand_color),#1c1c40);color:#fff;border-radius:16px;padding:22px;display:flex;justify-content:space-between;gap:16px;align-items:center}.em-header h1{margin:0;font-size:24px;line-height:1.2}.em-header p{margin:6px 0 0;color:rgba(255,255,255,.85);font-size:14px}.em-kpis{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:14px;margin-top:16px}.em-kpi{min-height:118px;position:relative;overflow:hidden}.em-kpi .em-icon{width:40px;height:40px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.em-kpi-value{font-size:26px;font-weight:700;color:var(--zcs-primary-text-color);margin-top:14px}.em-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin-top:2px}.em-note{margin-top:12px;font-size:13px;color:var(--zcs-secondary-text-color)}@media(max-width:1200px){.em-kpis{grid-template-columns:repeat(3,minmax(150px,1fr))}}@media(max-width:760px){.em-kpis{grid-template-columns:1fr}.em-header{flex-direction:column;align-items:flex-start}}
</style>
<div class="em-page">
  <div class="em-header">
    <div>
      <h1>Exception Management</h1>
      <p>Prioritize pending T&amp;E exceptions by SLA risk, approval tier, excess amount, and compliance category.</p>
    </div>
    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:Pending_Exceptions?zc_LoadIn=dialog&amp;zc_Header=true'>
      <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
      <span class='zcs-button-text'>Open pending queue</span>
    </a>
  </div>
  <div class="em-kpis">
    <div class="em-kpi zcs-card zcs-p-20 zcs-box-border">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start">
        <div class="em-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-single-content-03"></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><i class='zcs-badge-icon zcs-no-shrink zc-li-outline loader-dots-06'></i><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>Pending</span></div>
      </div>
      <div class="em-kpi-value"><%=pendingCount%></div>
      <div class="em-kpi-label">Pending exceptions</div>
    </div>
    <div class="em-kpi zcs-card zcs-p-20 zcs-box-border">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start">
        <div class="em-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time"></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'><i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove'></i><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>SLA risk</span></div>
      </div>
      <div class="em-kpi-value"><%=overdueCount%></div>
      <div class="em-kpi-label">Overdue SLA</div>
    </div>
    <div class="em-kpi zcs-card zcs-p-20 zcs-box-border">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start">
        <div class="em-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08"></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>Approved</span></div>
      </div>
      <div class="em-kpi-value"><%=approvedThisMonth%></div>
      <div class="em-kpi-label">Approved this month</div>
    </div>
    <div class="em-kpi zcs-card zcs-p-20 zcs-box-border">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start">
        <div class="em-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-circle-remove"></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'><i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove'></i><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>Rejected</span></div>
      </div>
      <div class="em-kpi-value"><%=rejectedThisMonth%></div>
      <div class="em-kpi-label">Rejected this month</div>
    </div>
    <div class="em-kpi zcs-card zcs-p-20 zcs-box-border">
      <div class="zcs-flex zcs-justify-space-between zcs-align-items-start">
        <div class="em-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-money-11"></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-alert'></i><span class='zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body'>Exposure</span></div>
      </div>
      <div class="em-kpi-value">$<%=pendingExcess%></div>
      <div class="em-kpi-label">Total excess amount pending</div>
    </div>
  </div>
  <div class="em-note">My routed pending approvals for <%=currentEmail%>: <strong><%=myPending%></strong>. Embedded reports below continue to honor each role's report permissions for broader compliance and finance queues.</div>
</div>