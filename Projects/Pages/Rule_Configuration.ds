<page linkname = "Rule_Configuration" displayname = "Rule Configuration"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Rule_Configuration_Overview' elementName='Overview'>
          <![CDATA[htmlpage Rule_Configuration_Overview()
             content
             <%{%>
                 <file name:Overview.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Rule_Configuration_Workbench.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Rate_Table_Maintenance.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Policy_Rule_Add_Form.ds/>
      </column>
      <column width='50%'>
        <file name:Rate_Table_Add_Form.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Rule_Configuration_Quick_Maintenance' elementName='Quick_Maintenance'>
          <![CDATA[htmlpage Rule_Configuration_Quick_Maintenance()
             content
             <%{%>
                 <file name:Quick_Maintenance.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Rule_Configuration_Testing_Guidance' elementName='Rule_Testing_Guidance'>
          <![CDATA[htmlpage Rule_Configuration_Testing_Guidance()
             content
             <%{%>
                 <file name:Rule_Testing_Guidance.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Rule_Configuration_Audit_Activity_Feed' elementName='Audit_Activity_Feed'>
          <![CDATA[htmlpage Rule_Configuration_Audit_Activity_Feed()
             content
             <%{%>
                 <file name:Audit_Activity_Feed.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>