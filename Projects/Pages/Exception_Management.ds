<page linkname = "Exception_Management" displayname = "Exception Management"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Exception_Overview' elementName='Exception_Overview'>
          <![CDATA[htmlpage Exception_Overview()
             content
             <%{%>
                 <file name:Exception_Overview.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Tier_Queues' elementName='Tier_Queues'>
          <![CDATA[htmlpage Tier_Queues()
             content
             <%{%>
                 <file name:Tier_Queues.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='SLA_Status_List' elementName='SLA_Status_List'>
          <![CDATA[htmlpage SLA_Status_List()
             content
             <%{%>
                 <file name:SLA_Status_List.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Historical_Approval_Rate' elementName='Historical_Approval_Rate'>
          <![CDATA[htmlpage Historical_Approval_Rate()
             content
             <%{%>
                 <file name:Historical_Approval_Rate.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Top_Exception_Categories' elementName='Top_Exception_Categories'>
          <![CDATA[htmlpage Top_Exception_Categories()
             content
             <%{%>
                 <file name:Top_Exception_Categories.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Pending_Exceptions_Embed.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Exception_Kanban_By_Status_Embed.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>