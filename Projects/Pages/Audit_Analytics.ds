<page linkname = "Audit_Analytics" displayname = "Audit & Analytics"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Audit_Summary' elementName='Audit_Summary'>
          <![CDATA[htmlpage Audit_Summary()
             content
             <%{%>
                 <file name:Audit_Summary.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Compliance_History' elementName='Compliance_History'>
          <![CDATA[htmlpage Compliance_History()
             content
             <%{%>
                 <file name:Compliance_History.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Audit_Export_View_Embed.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Critical_Audit_Events_Embed.ds/>
      </column>
      <column width='50%'>
        <file name:Repeat_Offenders_Embed.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Sync_Health_Embed.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>