<%
renderedAuditRows = 0;
%>
<div class='rc-page-shell'>
  <div class='zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16'>
    <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16'>
      <div>
        <h2 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Recent policy and rate audit activity</h2>
        <p class='zcs-font-14 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Filtered to Policy Rule, Rate Table, Distance Lookup, Holiday Calendar, and Entertainment Budget events.</p>
      </div>
      <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_TE_Audit_Log'>
        <i class='zcs-button-icon zc-li-outline ui-1-eye-17'></i>
        <span class='zcs-button-text'>Full Audit Log</span>
      </a>
    </div>
    <div class='zcs-timeline-wrapper zcs-without-time'>
      <ul class='zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0'>
<%
for each auditEvent in TE_Audit_Log[(Entity_Type == "Policy Rule" || Entity_Type == "Rate Table" || Entity_Type == "Distance Lookup" || Entity_Type == "Holiday Calendar" || Entity_Type == "Entertainment Budget")] sort by Event_Timestamp desc
{
  if(renderedAuditRows < 8)
  {
    severityClass = "zcs-badge-blue";
    severityIcon = "loader-dots-06";
    if(auditEvent.Severity == "Critical")
    {
      severityClass = "zcs-badge-red";
      severityIcon = "ui-1-circle-remove";
    }
    else if(auditEvent.Severity == "Warning")
    {
      severityClass = "zcs-badge-yellow";
      severityIcon = "ui-3-alert";
    }
    else if(auditEvent.Severity == "Info")
    {
      severityClass = "zcs-badge-green";
      severityIcon = "ui-1-check-circle-08";
    }
    eventWhen = "Timestamp unavailable";
    if(auditEvent.Event_Timestamp != null)
    {
      eventWhen = auditEvent.Event_Timestamp.toText("dd-MMM-yyyy HH:mm");
    }
%>
        <li class='zcs-tl-li zcs-row zcs-gap-0 zcs-relative'>
          <div class='zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute'>
            <span class='zcs-tl-dot zcs-rounded-half zcs-mt-4 zcs-box-border zcs-relative'></span>
          </div>
          <div class='zcs-flex zcs-direction-column zcs-col-12 zcs-px-60 zcs-box-border'>
            <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
              <h3 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=auditEvent.Action%></h3>
              <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=severityClass%>'>
                <i class='zcs-badge-icon zc-li-outline <%=severityIcon%>'></i>
                <span class='zcs-font-12'><%=auditEvent.Severity%></span>
              </div>
            </div>
            <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0'>
              <span class='zcs-font-medium'><%=auditEvent.Entity_Type%></span>
              <span class='zcs-color-secondary'> record </span>
              <span><%=ifnull(auditEvent.Entity_Record_ID,"not specified")%></span>
            </p>
            <p class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-4 zcs-mx-0 zcs-mb-0'>
              <%=eventWhen%> by <%=ifnull(auditEvent.Actor_Email,"System")%>
            </p>
          </div>
        </li>
<%
    renderedAuditRows = renderedAuditRows + 1;
  }
}
if(renderedAuditRows == 0)
{
%>
        <li class='zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-gap-12'>
          <i class='zc-li-outline ui-1-check-circle-08 zcs-font-20 zcs-color-theme'></i>
          <div>
            <h3 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'>No recent configuration audit activity</h3>
            <p class='zcs-font-14 zcs-color-secondary zcs-mt-4 zcs-mb-0'>Policy and rate maintenance events will appear here after changes are saved.</p>
          </div>
        </li>
<%
}
%>
      </ul>
    </div>
  </div>
</div>