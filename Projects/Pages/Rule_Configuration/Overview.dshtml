<%
activePolicyRules = TE_Policy_Rules[Active == true].count();
activeRateRows = TE_Rate_Tables[Active == true].count();
routesMaintained = TE_Distance_Lookups[Active == true].count();
upcomingRateChanges = TE_Rate_Tables[Active == true && Effective_Date > zoho.currentdate].count();
%>
<style>
/* ZCS global utility subset included once for this page, adapted from zcs-global for the used ZCS components. */
:root {
  --zcs-theme-brand-color: var(--zcs_brand_color);
  --zcs-light-bg-color: var(--zcs_brand_light_color);
  --zcs-page-bg-color: #F3F3F4;
  --zcs-primary-text-color: var(--zcs_primary_text_color);
  --zcs-secondary-text-color: var(--zcs_secondary_text_color);
  --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
  --zcs-border-color: var(--zcs_tertiary_border_color);
  --zcs-white-color: #FFFFFF;
  --zcs-black-color: #000000;
  --zcs-placeholder-color: #878895;
}
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-col-common { flex: 1 1 0%; }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-stretch { align-items: stretch; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-gap-6 { gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-2 { padding: 0.125rem; }
.zcs-p-8 { padding: 0.5rem; }
.zcs-p-10 { padding: 0.625rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-p-25 { padding: 1.5625rem; }
.zcs-px-8 { padding-left: 0.5rem; padding-right: 0.5rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }
.zcs-py-20 { padding-top: 1.25rem; padding-bottom: 1.25rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-pl-24 { padding-left: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-my-0 { margin-top: 0; margin-bottom: 0; }
.zcs-mt-4 { margin-top: 0.25rem; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-12 { margin-top: 0.75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mb-4 { margin-bottom: 0.25rem; }
.zcs-mb-6 { margin-bottom: 0.375rem; }
.zcs-mb-8 { margin-bottom: 0.5rem; }
.zcs-mb-12 { margin-bottom: 0.75rem; }
.zcs-mb-16 { margin-bottom: 1rem; }
.zcs-font-11 { font-size: 0.6875rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-rounded-sm { border-radius: 4px; }
.zcs-rounded-md { border-radius: 6px; }
.zcs-rounded-lg { border-radius: 8px; }
.zcs-rounded-xl { border-radius: 12px; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-text-left { text-align: left; }
.zcs-text-center { text-align: center; }
.zcs-text-right { text-align: right; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-cursor-pointer { cursor: pointer; }
.zcs-overflow-auto { overflow: auto; }
a { text-decoration: none; }

/* ZCS Primary Outline Button component CSS */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }
.zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-button-icon { width: 16px; max-height: 16px; }

/* ZCS Badge with Icon component CSS */
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }

/* ZCS Quick Actions component CSS */
.zcs-quick-action-item { list-style-type: none; }
.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }
.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }
.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }

/* ZCS Notes with List component CSS */
.zcs-notes-wrapper ul { list-style-type: disc; }
.zcs-notes-wrapper ul li::marker { color: var(--zcs_tertiary_text_color); }
.zcs-notes-text a:hover { text-decoration: underline; }

/* ZCS Timeline without time component CSS */
.zcs-tl-indicator { width: 60px; left: 0; }
.zcs-without-time .zcs-tl-indicator { left: 0; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }

/* Rule Configuration page-specific layout */
.rc-page-shell { background: var(--zcs-page-bg-color); padding: 24px; box-sizing: border-box; }
.rc-hero { background: linear-gradient(135deg, var(--zcs_brand_color), var(--zcs_brand_dark_color)); color: var(--zcs_brand_foreground_color); border: 0; overflow: hidden; position: relative; }
.rc-hero:after { content: ''; position: absolute; width: 220px; height: 220px; right: -72px; top: -82px; border: 28px solid rgba(255,255,255,0.14); border-radius: 50%; }
.rc-hero h1, .rc-hero p { position: relative; z-index: 1; }
.rc-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.rc-kpi-card { min-height: 142px; border-color: var(--zcs-border-color); }
.rc-kpi-icon { width: 42px; height: 42px; background: var(--zcs_component_hover_color); color: var(--zcs_brand_color); }
.rc-kpi-value { color: var(--zcs-primary-text-color); }
.rc-section-title { margin: 0 0 8px 0; }
.rc-muted { color: var(--zcs-secondary-text-color); }
@media (max-width: 992px) { .rc-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 576px) { .rc-page-shell { padding: 16px; } .rc-kpi-grid { grid-template-columns: 1fr; } }
</style>

<div class='rc-page-shell zcs-flex zcs-direction-column zcs-gap-16'>
  <div class='rc-hero zcs-card zcs-p-24 zcs-box-border'>
    <div class='zcs-flex zcs-align-items-center zcs-gap-12'>
      <div class='rc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-no-shrink'>
        <i class='zc-li-outline ui-1-settings-gear-63 zcs-font-20'></i>
      </div>
      <div>
        <h1 class='zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-white'>Rule Configuration</h1>
        <p class='zcs-font-14 zcs-lh-body zcs-mt-8 zcs-mb-0 zcs-color-white'>Controlled maintenance workspace for policy rules, travel rates, routes, holidays, and executive entertainment budgets.</p>
      </div>
    </div>
  </div>

  <div class='rc-kpi-grid'>
    <div class='rc-kpi-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
        <div class='rc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-20'></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'>
          <i class='zcs-badge-icon zc-li-outline ui-1-check-circle-08'></i><span class='zcs-font-12'>Active</span>
        </div>
      </div>
      <div>
        <div class='rc-kpi-value zcs-font-28 zcs-font-bold zcs-lh-heading'><%=activePolicyRules%></div>
        <div class='zcs-font-14 zcs-color-secondary zcs-mt-4'>Active policy rules</div>
      </div>
    </div>

    <div class='rc-kpi-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
        <div class='rc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline files-2-doc zcs-font-20'></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'>
          <i class='zcs-badge-icon zc-li-outline loader-dots-06'></i><span class='zcs-font-12'>Rates</span>
        </div>
      </div>
      <div>
        <div class='rc-kpi-value zcs-font-28 zcs-font-bold zcs-lh-heading'><%=activeRateRows%></div>
        <div class='zcs-font-14 zcs-color-secondary zcs-mt-4'>Active rate rows</div>
      </div>
    </div>

    <div class='rc-kpi-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
        <div class='rc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline location-pin-copy zcs-font-20'></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
          <i class='zcs-badge-icon zc-li-outline location-pin-copy'></i><span class='zcs-font-12'>Routes</span>
        </div>
      </div>
      <div>
        <div class='rc-kpi-value zcs-font-28 zcs-font-bold zcs-lh-heading'><%=routesMaintained%></div>
        <div class='zcs-font-14 zcs-color-secondary zcs-mt-4'>Routes maintained</div>
      </div>
    </div>

    <div class='rc-kpi-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12'>
      <div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
        <div class='rc-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half'><i class='zc-li-outline ui-2-time zcs-font-20'></i></div>
        <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'>
          <i class='zcs-badge-icon zc-li-outline ui-2-time'></i><span class='zcs-font-12'>Upcoming</span>
        </div>
      </div>
      <div>
        <div class='rc-kpi-value zcs-font-28 zcs-font-bold zcs-lh-heading'><%=upcomingRateChanges%></div>
        <div class='zcs-font-14 zcs-color-secondary zcs-mt-4'>Upcoming rate changes</div>
      </div>
    </div>
  </div>
</div>