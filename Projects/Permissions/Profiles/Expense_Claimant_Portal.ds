"Expense_Claimant_Portal"
{
    name = "Expense_Claimant_Portal"
    type = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Portal claimant profile for own claim status and exception justification submission."

    ModulePermissions
    {
        TE_Employees { enabled = View,Search allFieldsVisible = false FieldPermissions { Employee_ID{visibility:true,readonly:true} Employee_Name{visibility:true,readonly:true} Login_Email{visibility:true,readonly:true} Department{visibility:true,readonly:true} } }
        TE_Claims { enabled = Viewall,Tab,View,Search allFieldsVisible = false FieldPermissions { Manager_Decision{visibility:false} Manager_Comments{visibility:false} Manager_Acknowledgement{visibility:false} } }
        TE_Line_Items { enabled = Viewall,Tab,View,Search allFieldsVisible = true }
        TE_Compliance_Results { enabled = Viewall,Tab,View,Search allFieldsVisible = true }
        TE_Exceptions { enabled = Create,Viewall,Modifyall,Tab,View,Edit,Search allFieldsVisible = false FieldPermissions { Approval_Decision{visibility:false} Approval_Comments{visibility:true,readonly:true} Decision_Date{visibility:true,readonly:true} Audit_Notes{visibility:false} } }
        My_Claims_Status { enabled = tab }
    }
}
