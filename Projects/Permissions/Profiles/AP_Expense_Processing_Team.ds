"AP_Expense_Processing_Team"
{
    name = "AP_Expense_Processing_Team"
    type = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Expense processing team access to claims, compliance results, exception queues, and sync status."

    ModulePermissions
    {
        TE_Employees { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Claims { enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Search allFieldsVisible = true }
        TE_Line_Items { enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Search allFieldsVisible = true }
        TE_Compliance_Results { enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search allFieldsVisible = true }
        TE_Exceptions { enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search allFieldsVisible = true }
        TE_Policy_Rules { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Rate_Tables { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Distance_Lookups { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Holiday_Calendar { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Entertainment_Budgets { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Audit_Log { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        TE_Sync_Log { enabled = Viewall,Export,Tab,View,Search allFieldsVisible = true }
        Compliance_Dashboard { enabled = tab }
        Manager_Approval_Queue { enabled = tab }
        My_Claims_Status { enabled = tab }
        Exception_Management { enabled = tab }
        Audit_Analytics { enabled = tab }
    }
}
