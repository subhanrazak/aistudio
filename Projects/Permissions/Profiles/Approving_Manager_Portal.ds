"Approving_Manager_Portal"
{
    name = "Approving_Manager_Portal"
    type = customer_portal
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Portal manager profile for assigned approval queue, scorecards, and manager-tier exceptions."

    ModulePermissions
    {
        TE_Employees { enabled = View,Search allFieldsVisible = false FieldPermissions { Employee_ID{visibility:true,readonly:true} Employee_Name{visibility:true,readonly:true} Department{visibility:true,readonly:true} Manager_Email{visibility:true,readonly:true} } }
        TE_Claims { enabled = Viewall,Modifyall,Tab,View,Edit,Search allFieldsVisible = true }
        TE_Line_Items { enabled = Viewall,Tab,View,Search allFieldsVisible = true }
        TE_Compliance_Results { enabled = Viewall,Tab,View,Search allFieldsVisible = true }
        TE_Exceptions { enabled = Viewall,Modifyall,Tab,View,Edit,Search allFieldsVisible = true }
        Manager_Approval_Queue { enabled = tab }
        Exception_Management { enabled = tab }
    }
}
