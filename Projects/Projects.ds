application "Projects"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form TE_Audit_Log
		{
		    displayname = "T&E Audit Log"
		    Audit_Event
		    (
		        type = section
		        displayname = "Audit Event"
		        row = 1
		        column = 0
		    )
		    must have unique Event_Key
		    (
		        type = text
		        displayname = "Event Key"
		        maxchar = 60
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Timestamp
		    (
		        type = datetime
		        displayname = "Event Timestamp"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Actor_Email
		    (
		        type = email
		        displayname = "Actor Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Actor_Profile
		    (
		        type = text
		        displayname = "Actor Profile"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Entity_Type
		    (
		        type = picklist
		        displayname = "Entity Type"
		        values = {"Employee","Claim","Line Item","Compliance Result","Exception","Policy Rule","Rate Table","Distance Lookup","Holiday Calendar","Entertainment Budget","SAP Sync","Security"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Entity_Record_ID
		    (
		        type = text
		        displayname = "Entity Record ID"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action
		    (
		        type = text
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    Before_Value
		    (
		        type = textarea
		        displayname = "Before Value"
		        row = 1
		        column = 2
		        width = medium
		    )
		    After_Value
		    (
		        type = textarea
		        displayname = "After Value"
		        row = 1
		        column = 1
		        width = medium
		    )
		    IP_Address
		    (
		        type = text
		        displayname = "IP Address"
		        maxchar = 45
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Severity
		    (
		        type = picklist
		        values = {"Info","Warning","Critical"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Export_Batch_ID
		    (
		        type = text
		        displayname = "Export Batch ID"
		        maxchar = 60
		        row = 1
		        column = 2
		        width = medium
		    )
		    Immutable_Flag
		    (
		        type = checkbox
		        displayname = "Immutable Flag"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Claims
		{
		    displayname = "T&E Claims"
		    SAP_Claim_Header
		    (
		        type = section
		        displayname = "SAP Claim Header"
		        row = 1
		        column = 0
		    )
		    must have unique Trip_Number
		    (
		        type = text
		        displayname = "Trip Number"
		        maxchar = 10
		        description [ type = tooltip  message = "SAP PTRV_HEAD-REINR" ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee
		    (
		        type = picklist
		        values = TE_Employees.ID
		        displayformat = [Employee_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Employee_ID
		    (
		        type = text
		        displayname = "Employee ID"
		        maxchar = 8
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = text
		        displayname = "Employee Name"
		        maxchar = 80
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Employee_Grade_Band
		    (
		        type = picklist
		        displayname = "Employee Grade Band"
		        values = {"Junior Staff","Senior Staff","Executive"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Department
		    (
		        type = text
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Cost_Center
		    (
		        type = text
		        displayname = "Cost Center"
		        maxchar = 10
		        row = 1
		        column = 1
		        width = medium
		    )
		    Approver_Employee_ID
		    (
		        type = text
		        displayname = "Approver Employee ID"
		        maxchar = 8
		        row = 1
		        column = 2
		        width = medium
		    )
		    Approver_Email
		    (
		        type = email
		        displayname = "Approver Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Trip_Start_Date
		    (
		        type = date
		        displayname = "Trip Start Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Trip_End_Date
		    (
		        type = date
		        displayname = "Trip End Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Destination_City
		    (
		        type = text
		        displayname = "Destination City"
		        maxchar = 40
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Destination_Country
		    (
		        type = text
		        displayname = "Destination Country"
		        maxchar = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Trip_Type
		    (
		        type = picklist
		        displayname = "Trip Type"
		        values = {"Domestic","International"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Submission_Date
		    (
		        type = date
		        displayname = "Submission Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Booking_Date
		    (
		        type = date
		        displayname = "Booking Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Total_Amount
		    (
		        type = decimal
		        displayname = "Total Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Currency
		    (
		        type = text
		        maxchar = 3
		        initial value = "USD"
		        row = 1
		        column = 2
		        width = medium
		    )
		    SAP_Status_Code
		    (
		        type = text
		        displayname = "SAP Status Code"
		        maxchar = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_System
		    (
		        type = picklist
		        displayname = "Source System"
		        values = {"SAP FI-TV","Manual Upload","Demo Seed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Sync_Batch_ID
		    (
		        type = text
		        displayname = "Sync Batch ID"
		        maxchar = 40
		        row = 1
		        column = 1
		        width = medium
		    )
		    Compliance_Scorecard
		    (
		        type = section
		        displayname = "Compliance Scorecard"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Claim_Status
		    (
		        type = picklist
		        displayname = "Claim Status"
		        values = {"Synced","Submitted","Compliance Pending","Compliance Cleared - Green","Compliance Cleared - Warnings","Compliance Held - Critical","Exception Pending","Exception Approved","Returned to Claimant","Rejected by Manager","Compliance Cleared - Approved","SAP Approved","SAP Rejected"}
		        initial value = "Synced"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Compliance_Rating
		    (
		        type = picklist
		        displayname = "Compliance Rating"
		        values = {"Green","Yellow","Red","Not Checked"}
		        initial value = "Not Checked"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Compliance_Score
		    (
		        type = decimal
		        displayname = "Compliance Score"
		        decimalplace = 2
		        initial value = 100
		        row = 2
		        column = 1
		        width = medium
		    )
		    Critical_Violation_Count
		    (
		        type = number
		        displayname = "Critical Violation Count"
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Warning_Count
		    (
		        type = number
		        displayname = "Warning Count"
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Estimated_Savings
		    (
		        type = decimal
		        displayname = "Estimated Savings"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Has_Duplicate_Flag
		    (
		        type = checkbox
		        displayname = "Has Duplicate Flag"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Repeat_Offender_Flag
		    (
		        type = checkbox
		        displayname = "Repeat Offender Flag"
		        initial value = false
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Compliance_Check
		    (
		        type = datetime
		        displayname = "Last Compliance Check"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Manager_Acknowledgement
		    (
		        type = checkbox
		        displayname = "Manager Acknowledgement"
		        initial value = false
		        row = 2
		        column = 2
		        width = medium
		    )
		    Manager_Decision
		    (
		        type = picklist
		        displayname = "Manager Decision"
		        values = {"Approve","Reject","Return for Clarification","Hold for Exception"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Manager_Comments
		    (
		        type = textarea
		        displayname = "Manager Comments"
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"Synced","Submitted","Compliance Pending","Compliance Cleared - Green","Compliance Cleared - Warnings","Compliance Held - Critical","Exception Pending","Exception Approved","Returned to Claimant","Rejected by Manager","Compliance Cleared - Approved"}
		    }
		}

		form TE_Compliance_Results
		{
		    displayname = "Compliance Results"
		    Result_Identity
		    (
		        type = section
		        displayname = "Result Identity"
		        row = 1
		        column = 0
		    )
		    must have unique Result_Key
		    (
		        type = text
		        displayname = "Result Key"
		        maxchar = 60
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Claim
		    (
		        type = picklist
		        values = TE_Claims.ID
		        displayformat = [Trip_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Line_Item
		    (
		        type = picklist
		        displayname = "Line Item"
		        values = TE_Line_Items.ID
		        displayformat = [Line_Item_Key]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Policy_Rule
		    (
		        type = picklist
		        displayname = "Policy Rule"
		        values = TE_Policy_Rules.ID
		        displayformat = [Rule_ID]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Rule_Category
		    (
		        type = picklist
		        displayname = "Rule Category"
		        values = {"Hotel Rate Limit","Per Diem / Meals","Airfare Class","Advance Booking","Receipt Requirement","Entertainment Documentation","Entertainment Budget Cap","Duplicate Expense","Weekend/Holiday Travel","Mileage Reasonableness"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Pass_Fail
		    (
		        type = picklist
		        displayname = "Pass Fail"
		        values = {"Pass","Fail","Not Applicable"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Severity
		    (
		        type = picklist
		        values = {"Info","Warning","Critical"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Policy_Limit
		    (
		        type = decimal
		        displayname = "Policy Limit"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Actual_Amount
		    (
		        type = decimal
		        displayname = "Actual Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Excess_Amount
		    (
		        type = decimal
		        displayname = "Excess Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Currency
		    (
		        type = text
		        maxchar = 3
		        initial value = "USD"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Violation_Description
		    (
		        type = textarea
		        displayname = "Violation Description"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Rule_Reference
		    (
		        type = text
		        displayname = "Rule Reference"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    Recommended_Action
		    (
		        type = textarea
		        displayname = "Recommended Action"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Exception_Required
		    (
		        type = checkbox
		        displayname = "Exception Required"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Exception_Status
		    (
		        type = picklist
		        displayname = "Exception Status"
		        values = {"Not Required","Pending","Approved","Rejected"}
		        initial value = "Not Required"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Checked_On
		    (
		        type = datetime
		        displayname = "Checked On"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Checked_By
		    (
		        type = text
		        displayname = "Checked By"
		        maxchar = 80
		        initial value = "System"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Distance_Lookups
		{
		    displayname = "Mileage Distance Lookup"
		    Route_Definition
		    (
		        type = section
		        displayname = "Route Definition"
		        row = 1
		        column = 0
		    )
		    must have unique Route_Code
		    (
		        type = text
		        displayname = "Route Code"
		        maxchar = 60
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Origin_City
		    (
		        type = text
		        displayname = "Origin City"
		        maxchar = 60
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Origin_Country
		    (
		        type = text
		        displayname = "Origin Country"
		        maxchar = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Destination_City
		    (
		        type = text
		        displayname = "Destination City"
		        maxchar = 60
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Destination_Country
		    (
		        type = text
		        displayname = "Destination Country"
		        maxchar = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Expected_Distance_KM
		    (
		        type = decimal
		        displayname = "Expected Distance KM"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Tolerance_Percent
		    (
		        type = decimal
		        displayname = "Tolerance Percent"
		        decimalplace = 2
		        initial value = 20
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Effective_Date
		    (
		        type = date
		        displayname = "Effective Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source
		    (
		        type = picklist
		        values = {"Admin Input","SAP Upload","Manual Correction"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Employees
		{
		    displayname = "T&E Employees"
		    Employee_Information
		    (
		        type = section
		        displayname = "Employee Information"
		        row = 1
		        column = 0
		    )
		    must have unique Employee_ID
		    (
		        type = text
		        displayname = "Employee ID"
		        maxchar = 8
		        description [ type = tooltip  message = "SAP PERNR" ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = text
		        displayname = "Employee Name"
		        maxchar = 80
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have unique Login_Email
		    (
		        type = email
		        displayname = "Login Email"
		        personal data = true
		        description [ type = tooltip  message = "Used to match zoho.loginuser or portal user identity." ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Grade_Band
		    (
		        type = picklist
		        displayname = "Employee Grade Band"
		        values = {"Junior Staff","Senior Staff","Executive"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Position_Title
		    (
		        type = text
		        displayname = "Position Title"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = text
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Cost_Center
		    (
		        type = text
		        displayname = "Cost Center"
		        maxchar = 10
		        row = 1
		        column = 1
		        width = medium
		    )
		    Org_Unit
		    (
		        type = text
		        displayname = "Org Unit"
		        maxchar = 20
		        row = 1
		        column = 2
		        width = medium
		    )
		    Manager_Employee_ID
		    (
		        type = text
		        displayname = "Manager Employee ID"
		        maxchar = 8
		        row = 1
		        column = 1
		        width = medium
		    )
		    Manager_Email
		    (
		        type = email
		        displayname = "Manager Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Department_Head_Email
		    (
		        type = email
		        displayname = "Department Head Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Compliance_Reviewer_Email
		    (
		        type = email
		        displayname = "Compliance Reviewer Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    CFO_Approver_Email
		    (
		        type = email
		        displayname = "CFO Approver Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Country_Code
		    (
		        type = text
		        displayname = "Country Code"
		        maxchar = 3
		        initial value = "USA"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Critical_Violations_12M
		    (
		        type = number
		        displayname = "Critical Violations 12M"
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Warning_Violations_12M
		    (
		        type = number
		        displayname = "Warning Violations 12M"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Repeat_Offender
		    (
		        type = checkbox
		        displayname = "Repeat Offender"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    SAP_Last_Sync
		    (
		        type = datetime
		        displayname = "SAP Last Sync"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_System
		    (
		        type = picklist
		        displayname = "Source System"
		        values = {"SAP HR","Manual Upload"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Entertainment_Budgets
		{
		    displayname = "Entertainment Budgets"
		    Budget_Definition
		    (
		        type = section
		        displayname = "Budget Definition"
		        row = 1
		        column = 0
		    )
		    must have unique Budget_Code
		    (
		        type = text
		        displayname = "Budget Code"
		        maxchar = 40
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee
		    (
		        type = picklist
		        values = TE_Employees.ID
		        displayformat = [Employee_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Employee_ID
		    (
		        type = text
		        displayname = "Employee ID"
		        maxchar = 8
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Budget_Year
		    (
		        type = number
		        displayname = "Budget Year"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Annual_Budget
		    (
		        type = decimal
		        displayname = "Annual Budget"
		        decimalplace = 2
		        initial value = 15000
		        row = 1
		        column = 1
		        width = medium
		    )
		    Used_Amount
		    (
		        type = decimal
		        displayname = "Used Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Remaining_Amount
		    (
		        type = decimal
		        displayname = "Remaining Amount"
		        decimalplace = 2
		        initial value = 15000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Currency
		    (
		        type = text
		        maxchar = 3
		        initial value = "USD"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Warning_Threshold_Percent
		    (
		        type = decimal
		        displayname = "Warning Threshold Percent"
		        decimalplace = 2
		        initial value = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Active","Approaching Cap","Exhausted","Closed"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Last_Recalculated_On
		    (
		        type = datetime
		        displayname = "Last Recalculated On"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Exceptions
		{
		    displayname = "Policy Exceptions"
		    Exception_Request
		    (
		        type = section
		        displayname = "Exception Request"
		        row = 1
		        column = 0
		    )
		    must have unique Exception_Number
		    (
		        type = text
		        displayname = "Exception Number"
		        maxchar = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Claim
		    (
		        type = picklist
		        values = TE_Claims.ID
		        displayformat = [Trip_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Line_Item
		    (
		        type = picklist
		        displayname = "Line Item"
		        values = TE_Line_Items.ID
		        displayformat = [Line_Item_Key]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Compliance_Result
		    (
		        type = picklist
		        displayname = "Compliance Result"
		        values = TE_Compliance_Results.ID
		        displayformat = [Result_Key]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Violated_Rule
		    (
		        type = picklist
		        displayname = "Violated Rule"
		        values = TE_Policy_Rules.ID
		        displayformat = [Rule_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Policy_Limit
		    (
		        type = decimal
		        displayname = "Policy Limit"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Actual_Amount
		    (
		        type = decimal
		        displayname = "Actual Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Excess_Amount
		    (
		        type = decimal
		        displayname = "Excess Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Currency
		    (
		        type = text
		        maxchar = 3
		        initial value = "USD"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Business_Justification
		    (
		        type = richtext
		        displayname = "Business Justification"
		        height = 200px
		        toolbar = enable
		        [
		            style, font-color, alignment, bullets-and-numbering, link, table
		        ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    Supporting_Document
		    (
		        type = upload file
		        displayname = "Supporting Document"
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		    Requester_Email
		    (
		        type = email
		        displayname = "Requester Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Approval_Routing
		    (
		        type = section
		        displayname = "Approval Routing"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Exception_Approver_Level
		    (
		        type = picklist
		        displayname = "Exception Approver Level"
		        values = {"Direct Manager","Department Head","Compliance Officer","CFO"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Exception_Approver_Email
		    (
		        type = email
		        displayname = "Exception Approver Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    SLA_Due_Date
		    (
		        type = date
		        displayname = "SLA Due Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        values = {"Draft","Pending Manager Approval","Pending Department Head Approval","Pending Compliance Approval","Pending CFO Approval","Approved","Rejected","Escalated","Returned for Information"}
		        initial value = "Draft"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Approval_Decision
		    (
		        type = picklist
		        displayname = "Approval Decision"
		        values = {"Approve","Reject","Return for Information"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Approval_Comments
		    (
		        type = textarea
		        displayname = "Approval Comments"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Decision_Date
		    (
		        type = datetime
		        displayname = "Decision Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Escalation_Count
		    (
		        type = number
		        displayname = "Escalation Count"
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Last_Reminder_Sent_On
		    (
		        type = datetime
		        displayname = "Last Reminder Sent On"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Audit_Notes
		    (
		        type = textarea
		        displayname = "Audit Notes"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"Draft","Pending Manager Approval","Pending Department Head Approval","Pending Compliance Approval","Pending CFO Approval","Approved","Rejected","Escalated","Returned for Information"}
		    }
		}

