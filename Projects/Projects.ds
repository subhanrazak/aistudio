		    (
		        type = text
		        displayname = "City Location"
		        maxchar = 60
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Country_Code
		    (
		        type = text
		        displayname = "Country Code"
		        maxchar = 3
		        initial value = "USA"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have City_Tier
		    (
		        type = picklist
		        displayname = "City Tier"
		        values = {"Tier 1 (Major Metro)","Tier 2","Tier 3 (Regional)"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Grade_Band
		    (
		        type = picklist
		        displayname = "Grade Band"
		        values = {"Junior Staff","Senior Staff","Executive","All"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Hotel_Max
		    (
		        type = decimal
		        displayname = "Hotel Max"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Daily_Per_Diem_Meals
		    (
		        type = decimal
		        displayname = "Daily Per Diem Meals"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Currency
		    (
		        type = text
		        maxchar = 3
		        initial value = "USD"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Effective_Date
		    (
		        type = date
		        displayname = "Effective Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Expiry_Date
		    (
		        type = date
		        displayname = "Expiry Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Active
		    (
		        type = checkbox
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Version_Notes
		    (
		        type = textarea
		        displayname = "Version Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Source
		    (
		        type = picklist
		        values = {"Admin Input","GSA Import","SAP Upload","Manual Correction"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form TE_Sync_Log
		{
		    displayname = "SAP Sync Log"
		    Sync_Run
		    (
		        type = section
		        displayname = "Sync Run"
		        row = 1
		        column = 0
		    )
		    must have unique Sync_Run_ID
		    (
		        type = text
		        displayname = "Sync Run ID"
		        maxchar = 60
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Source_System
		    (
		        type = picklist
		        displayname = "Source System"
		        values = {"SAP FI-TV","SAP HR","SAP FI-AP","Manual Import","Demo Seed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    SAP_Table
		    (
		        type = picklist
		        displayname = "SAP Table"
		        values = {"PTRV_HEAD","PTRV_PERIO","PA0001","HRP1000","T706B","T001","Multiple"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Started_On
		    (
		        type = datetime
		        displayname = "Started On"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Completed_On
		    (
		        type = datetime
		        displayname = "Completed On"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Sync_Status
		    (
		        type = picklist
		        displayname = "Sync Status"
		        values = {"Started","Completed","Failed","Partial","Placeholder Only"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Records_Read
		    (
		        type = number
		        displayname = "Records Read"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Records_Imported
		    (
		        type = number
		        displayname = "Records Imported"
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Records_Failed
		    (
		        type = number
		        displayname = "Records Failed"
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Error_Message
		    (
		        type = textarea
		        displayname = "Error Message"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Triggered_By_Email
		    (
		        type = email
		        displayname = "Triggered By Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Next_Scheduled_Run
		    (
		        type = datetime
		        displayname = "Next Scheduled Run"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_TE_Audit_Log
		{
		    displayName = "All T&E Audit Log"
		    show all rows from TE_Audit_Log
		    (
		        Event_Timestamp
		        Actor_Email
		        Entity_Type
		        Entity_Record_ID
		        Action
		        Severity
		    )
		    filters
		    (
		        Entity_Type
		        Severity
		        Actor_Email
		    )
		    sort by
		    (
		        Event_Timestamp descending
		    )
		}

		list Audit_Export_View
		{
		    displayName = "Audit Export View"
		    show all rows from TE_Audit_Log
		    (
		        Event_Key
		        Event_Timestamp
		        Actor_Email
		        Actor_Profile
		        Entity_Type
		        Entity_Record_ID
		        Action
		        Before_Value
		        After_Value
		        IP_Address
		        Severity
		        Export_Batch_ID
		    )
		    sort by
		    (
		        Event_Timestamp descending
		    )
		}

		list Critical_Audit_Events
		{
		    displayName = "Critical Audit Events"
		    show all rows from TE_Audit_Log [Severity == "Critical"]
		    (
		        Event_Timestamp
		        Actor_Email
		        Entity_Type
		        Entity_Record_ID
		        Action
		        Before_Value
		        After_Value
		    )
		    sort by
		    (
		        Event_Timestamp descending
		    )
		}

		default list All_TE_Claims
		{
		    displayName = "All T&E Claims"
		    show all rows from TE_Claims
		    (
		        Trip_Number
		        Employee_Name
		        Employee_ID
		        Department
		        Trip_Start_Date
		        Trip_End_Date
		        Destination_City
		        Destination_Country
		        Submission_Date
		        Total_Amount
		        Currency
		        Claim_Status
		        Compliance_Rating
		        Critical_Violation_Count
		        Warning_Count
		        custom action "Recheck Compliance"
		        (
		            workflow = Recheck_Compliance
		            show action for each record = true
		            column header = "Actions"
		            success message = "Compliance recheck queued."
		            condition = (Claim_Status != "SAP Approved" && Claim_Status != "SAP Rejected")
		        )
		        custom action "Mark Cleared"
		        (
		            workflow = Mark_Cleared
		            show action for each record = true
		            column header = "Actions"
		            success message = "Claim marked cleared for approval."
		            condition = (Critical_Violation_Count == 0 && (Compliance_Rating == "Green" || Claim_Status == "Compliance Cleared - Green" || Claim_Status == "Exception Approved"))
		        )
		    )
		    filters
		    (
		        Claim_Status
		        Compliance_Rating
		        Department
		        Destination_Country
		    )
		    sort by
		    (
		        Submission_Date descending
		    )
		}

		kanban Claims_By_Status
		{
		    displayName = "Claims By Status"
		    show all rows from TE_Claims
		    (
		        Trip_Number
		        Employee_Name
		        Total_Amount
		        Compliance_Rating
		        Critical_Violation_Count
		        Warning_Count
		        Claim_Status
		    )
		    options
		    (
		        display field = Claim_Status
		        sort order = custom
		        record count = enable
		    )
		}

		list Pending_Manager_Approval
		{
		    displayName = "Pending Manager Approval"
		    show all rows from TE_Claims [Claim_Status == "Submitted" || Claim_Status == "Compliance Cleared - Warnings" || Claim_Status == "Compliance Cleared - Green" || Claim_Status == "Exception Approved"]
		    (
		        Trip_Number
		        Employee_Name
		        Destination_City
		        Total_Amount
		        Compliance_Rating
		        Critical_Violation_Count
		        Warning_Count
		        Approver_Email
		        Manager_Acknowledgement
		        Claim_Status
		        custom action "Recheck Compliance"
		        (
		            workflow = Recheck_Compliance
		            show action for each record = true
		            column header = "Actions"
		            success message = "Compliance recheck queued."
		        )
		        custom action "Approve With Warnings"
		        (
		            workflow = Approve_With_Warnings
		            show action for each record = true
		            column header = "Actions"
		            success message = "Claim approved with warning acknowledgement."
		            condition = (Critical_Violation_Count == 0 && (Warning_Count > 0 || Compliance_Rating == "Yellow" || Claim_Status == "Compliance Cleared - Warnings" || Claim_Status == "Exception Approved"))
		        )
		        custom action "Mark Cleared"
		        (
		            workflow = Mark_Cleared
		            show action for each record = true
		            column header = "Actions"
		            success message = "Claim marked cleared for approval."
		            condition = (Critical_Violation_Count == 0 && (Compliance_Rating == "Green" || Claim_Status == "Compliance Cleared - Green" || Claim_Status == "Exception Approved"))
		        )
		        custom action "Return to Claimant"
		        (
		            workflow = Return_To_Claimant
		            show action for each record = true
		            column header = "Actions"
		            success message = "Claim returned to claimant when comments are present."
		        )
		        custom action "Reject Claim"
		        (
		            workflow = Reject_Claim
		            show action for each record = true
		            column header = "Actions"
		            success message = "Claim rejected when comments are present."
		            confirmation before execution
		            (
		                message for individual record = "Reject this travel claim?"
		                confirm button text = "Reject"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		}

		list Red_Flagged_Claims
		{
		    displayName = "Red Flagged Claims"
		    show all rows from TE_Claims [Compliance_Rating == "Red" || Critical_Violation_Count > 0]
		    (
		        Trip_Number
		        Employee_Name
		        Department
		        Total_Amount
		        Compliance_Rating
		        Critical_Violation_Count
		        Estimated_Savings
		        Claim_Status
		        Approver_Email
		    )
		}

		calendar Trip_Calendar
		{
		    displayName = "Trip Calendar"
		    show all rows from TE_Claims
		    (
		        Trip_Number
		        Employee_Name
		        Destination_City
		        Claim_Status
		        Trip_Start_Date
		        Trip_End_Date
		    )
		    options
		    (
		        display type = month
		        display field = Trip_Number
		        start date = Trip_Start_Date
		        end date = Trip_End_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		default list Compliance_Scorecards
		{
		    displayName = "Compliance Scorecards"
		    show all rows from TE_Compliance_Results
		    (
		        Claim
		        Line_Item
		        Rule_Category
		        Pass_Fail
		        Severity
		        Policy_Limit
		        Actual_Amount
		        Excess_Amount
		        Exception_Status
		        Checked_On
		        custom action "Request Exception"
		        (
		            workflow = Request_Exception
		            show action for each record = true
		            column header = "Actions"
		            success message = "Exception request opened."
		            condition = (Pass_Fail == "Fail" && (Severity == "Critical" || Severity == "Warning") && Exception_Required == true && Exception_Status != "Approved")
		        )
		    )
		    filters
		    (
		        Rule_Category
		        Pass_Fail
		        Severity
		        Exception_Status
		    )
		    sort by
		    (
		        Checked_On descending
		    )
		}

		list Critical_Violations
		{
		    displayName = "Critical Violations"
		    show all rows from TE_Compliance_Results [Pass_Fail == "Fail" && Severity == "Critical"]
		    (
		        Claim
		        Line_Item
		        Rule_Category
		        Violation_Description
		        Policy_Limit
		        Actual_Amount
		        Excess_Amount
		        Exception_Status
		        Pass_Fail
		        Severity
		        custom action "Request Exception"
		        (
		            workflow = Request_Exception
		            show action for each record = true
		            column header = "Actions"
		            success message = "Exception request opened."
		            condition = (Exception_Required == true && Exception_Status != "Approved")
		        )
		    )
		}

		list Violation_Type_Distribution
		{
		    displayName = "Violation Type Distribution"
		    show all rows from TE_Compliance_Results [Pass_Fail == "Fail"]
		    (
		        Rule_Category
		        Result_Key
		        Excess_Amount
		        (
		            display = total
		        )
		        Pass_Fail
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Rule_Category ascending
		    )
		    sort by
		    (
		        Rule_Category ascending
		    )
		}

		list Violations_By_Rule
		{
		    displayName = "Violations By Rule"
		    show all rows from TE_Compliance_Results [Pass_Fail == "Fail"]
		    (
		        Rule_Category
		        Severity
		        Result_Key
		        Excess_Amount
		        (
		            display = total
		        )
		        Pass_Fail
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Rule_Category ascending
		        Severity ascending
		    )
		    sort by
		    (
		        Rule_Category ascending
		        Severity ascending
		    )
		}

		list Warning_Violations
		{
		    displayName = "Warning Violations"
		    show all rows from TE_Compliance_Results [Pass_Fail == "Fail" && Severity == "Warning"]
		    (
		        Claim
		        Line_Item
		        Rule_Category
		        Violation_Description
		        Policy_Limit
		        Actual_Amount
		        Excess_Amount
		        Exception_Status
		        Pass_Fail
		        Severity
		        custom action "Request Exception"
		        (
		            workflow = Request_Exception
		            show action for each record = true
		            column header = "Actions"
		            success message = "Exception request opened."
		            condition = (Exception_Required == true && Exception_Status != "Approved")
		        )
		    )
		}

