	menu
	{
	    space TE_Compliance_Space
	    {
	        displayname = "T&E Compliance"
	        icon = "business-bank"
	
	        section Dashboards_Section
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-bar-33"
	            page Compliance_Dashboard { icon = "business-chart" }
	            page Manager_Approval_Queue { icon = "business-signature" }
	            page My_Claims_Status { icon = "travel-passport" }
	            page Rule_Configuration { icon = "business-hammer" }
	            page Exception_Management { icon = "business-scale" }
	            page Audit_Analytics { icon = "business-board-29" }
	        }
	
	        section Claims_Section
	        {
	            displayname = "Claims & Scorecards"
	            icon = "travel-luggage"
	            form TE_Claims { icon = "travel-passport" }
	            report All_TE_Claims { icon = "business-notes" }
	            report Pending_Manager_Approval { icon = "business-signature" }
	            report Red_Flagged_Claims { icon = "business-hammer" }
	            report Claims_By_Status { icon = "business-hierarchy-54" }
	            report Trip_Calendar { icon = "travel-worldmap" }
	            form TE_Line_Items { icon = "business-notes" }
	            report All_TE_Line_Items { icon = "business-notes" }
	            report Violating_Line_Items { icon = "business-law" }
	            report Entertainment_Review_Items { icon = "business-handshake" }
	            report Mileage_Exception_Items { icon = "travel-road-sign-right" }
	        }
	
	        section Compliance_Section
	        {
	            displayname = "Compliance Results"
	            icon = "business-scale"
	            form TE_Compliance_Results { icon = "business-badge" }
	            report Compliance_Scorecards { icon = "business-chart-pie-36" }
	            report Critical_Violations { icon = "business-law" }
	            report Warning_Violations { icon = "business-hammer" }
	            report Violations_By_Rule { icon = "business-chart-bar-32" }
	            report Violation_Type_Distribution { icon = "business-chart-pie-35" }
	            form TE_Exceptions { icon = "business-signature" }
	            report All_TE_Exceptions { icon = "business-notes" }
	            report Pending_Exceptions { icon = "business-money-time" }
	            report My_Exception_Requests { icon = "business-business-contact-89" }
	            report Exception_Kanban_By_Status { icon = "business-hierarchy-54" }
	            report Approved_Exceptions { icon = "business-goal-64" }
	            report Rejected_Exceptions { icon = "business-businessman-03" }
	        }
	
	        section Policy_Configuration_Section
	        {
	            displayname = "Policy Configuration"
	            icon = "business-hammer"
	            form TE_Policy_Rules { icon = "business-law" }
	            report Active_Policy_Rules { icon = "business-badge" }
