			                else if(input.Expense_Category == "Mileage")
			                {
			                    show Airfare_Details;
			                    hide Flight_Duration_Hours;
			                    hide Flight_Class;
			                    hide Booking_Date;
			                    hide Departure_Date;
			                    show Origin_City;
			                    show Destination_City;
			                    show Mileage_Details;
			                    hide Entertainment_Details;
			                    input.Flight_Duration_Hours = null;
			                    input.Flight_Class = null;
			                    input.Booking_Date = null;
			                    input.Departure_Date = null;
			                    input.Attendee_Count = null;
			                    input.Attendee_Names = "";
			                    input.Attendee_Companies = "";
			                    input.Business_Purpose = "";
			                    input.Entertainment_Budget_Code = "";
