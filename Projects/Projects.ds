			                }
			                else if(input.Expense_Category == "Entertainment")
			                {
			                    hide Airfare_Details;
			                    hide Mileage_Details;
			                    show Entertainment_Details;
			                    input.Flight_Duration_Hours = null;
			                    input.Flight_Class = null;
			                    input.Booking_Date = null;
			                    input.Departure_Date = null;
			                    input.Origin_City = "";
			                    input.Destination_City = "";
			                    input.Claimed_Mileage_KM = null;
			                    input.Expected_Distance_KM = null;
			                    input.Route_Explanation = "";
			                    if(input.Amount != null && input.Attendee_Count != null && input.Attendee_Count > 0)
			                    {
			                        input.Per_Person_Amount = input.Amount / input.Attendee_Count;
			                    }
			                }
			                else
			                {
			                    hide Airfare_Details;
			                    hide Mileage_Details;
			                    hide Entertainment_Details;
			                    input.Flight_Duration_Hours = null;
			                    input.Flight_Class = null;
			                    input.Booking_Date = null;
			                    input.Departure_Date = null;
			                    input.Origin_City = "";
			                    input.Destination_City = "";
