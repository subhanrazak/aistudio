	reports
	{
		report All_TE_Audit_Log
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Event_Timestamp Actor_Email Entity_Type Entity_Record_ID Action Severity ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Event_Timestamp Actor_Email Entity_Type Entity_Record_ID Action Severity ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Audit_Export_View
