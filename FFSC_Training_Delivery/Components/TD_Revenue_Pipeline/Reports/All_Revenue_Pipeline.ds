default list All_Revenue_Pipeline
{
    displayName = "All Revenue Pipeline"
    show all rows from TD_Revenue_Pipeline
    (
        Opportunity_ID as "ID"
        Revenue_Type as "Type"
        Partner_Institution as "Partner"
        Owner_TM as "Owner TM"
        Program_Type as "Program"
        Expected_Revenue as "Exp. Revenue"
        (
            display = total
        )
        Expected_Cost as "Exp. Cost"
        (
            display = total
        )
        Expected_Net as "Exp. Net"
        (
            display = total
        )
        Stage
        Probability_Percent as "Probability %"
        Expected_Closure_Date as "Closure Date"
        CEO_Help_Needed as "CEO Help?"
    )
    filters
    (
        Revenue_Type
        Stage
        Owner_TM
        CEO_Help_Needed
    )
    sort by
    (
        Expected_Closure_Date ascending
    )
    conditional formatting
    (
        "Approved"
        {
            condition = (Stage == "Approved")
            fields = [Stage, Expected_Net]
            format = "background-color:#D4EDDA;color:#155724;font-weight:bold"
        }
        "CEO Help Needed"
        {
            condition = (CEO_Help_Needed == true)
            fields = [Opportunity_ID, CEO_Help_Needed]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
