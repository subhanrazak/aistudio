list CEO_Help_Pipeline
{
    displayName = "CEO Help Needed"
    show all rows from TD_Revenue_Pipeline [CEO_Help_Needed == true]
    (
        Opportunity_ID as "ID"
        Revenue_Type as "Type"
        Partner_Institution as "Partner"
        Owner_TM as "Owner TM"
        Expected_Revenue as "Exp. Revenue"
        Stage
        Expected_Closure_Date as "Closure Date"
        Next_Step as "Next Step"
    )
    sort by
    (
        Expected_Closure_Date ascending
    )
}
