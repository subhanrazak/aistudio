form TD_Revenue_Pipeline
{
    title
    {
        displayname = "T&D Revenue Pipeline"
        on add = "Add Opportunity"
        on edit = "Edit Opportunity"
    }

    Opportunity_Identity
    (
        type = section
        displayname = "Opportunity Identity"
        row = 1
        column = 0
    )
    Opportunity_ID
    (
        type = autonumber
        displayname = "Opportunity ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Revenue_Type
    (
        type = picklist
        displayname = "Revenue Type"
        values = {"Student Paid","Industry Partner","CSR","Government","Workshop","RPL","Other"}
        row = 1
        column = 1
        width = medium
    )
    Linked_Centre_Region
    (
        type = picklist
        displayname = "Linked Centre / Region (Optional)"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Partner_Institution
    (
        type = text
        displayname = "Partner / Institution"
        row = 1
        column = 1
        width = medium
    )
    Owner_TM
    (
        type = picklist
        displayname = "Owner TM"
        module = users
        displayformat = [name]
        row = 1
        column = 2
        width = medium
    )

    Program_Stage
    (
        type = section
        displayname = "Program & Stage"
        visibility = true
        row = 2
        column = 1
    )
    Program_Type
    (
        type = picklist
        displayname = "Program Type"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 2
        column = 1
        width = medium
    )
    Stage
    (
        type = picklist
        displayname = "Stage"
        values = {"Identified","Discussion","Proposal Sent","Negotiation","Approved"}
        initial value = "Identified"
        row = 2
        column = 2
        width = medium
    )
    Probability_Percent
    (
        type = decimal
        displayname = "Probability %"
        decimalplace = 1
        row = 2
        column = 1
        width = medium
    )
    Expected_Closure_Date
    (
        type = date
        displayname = "Expected Closure Date"
        row = 2
        column = 2
        width = medium
    )
    Funding_Billing_Mode
    (
        type = picklist
        displayname = "Funding / Billing Mode"
        values = {"Student Paid","Direct Invoice","CSR Grant","Govt Scheme","FOC"}
        row = 2
        column = 1
        width = medium
    )

    Financials_Section
    (
        type = section
        displayname = "Financials"
        visibility = true
        row = 3
        column = 1
    )
    Expected_Revenue
    (
        type = INR
        displayname = "Expected Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 1
        width = medium
    )
    Expected_Cost
    (
        type = INR
        displayname = "Expected Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 2
        width = medium
    )
    Expected_Net
    (
        type = formula
        displayname = "Expected Net"
        value = Expected_Revenue - Expected_Cost
        visibility = true
        row = 3
        column = 1
    )

    Notes_Actions
    (
        type = section
        displayname = "Notes & Actions"
        visibility = true
        row = 4
        column = 1
    )
    CEO_Help_Needed
    (
        type = checkbox
        displayname = "CEO Help Needed?"
        row = 4
        column = 1
        width = medium
    )
    Next_Step
    (
        type = textarea
        displayname = "Next Step"
        row = 4
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 4
        column = 1
        width = medium
    )

    Metadata_Section
    (
        type = section
        displayname = "Metadata"
        visibility = true
        row = 5
        column = 1
    )
    Updated_By
    (
        type = picklist
        displayname = "Updated By"
        module = users
        displayformat = [name]
        row = 5
        column = 1
        width = medium
    )
    Last_Updated
    (
        type = datetime
        displayname = "Last Updated"
        row = 5
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
