form IPG_Funding_Support
{
    title
    {
        displayname = "IPG Funding Support"
        on add = "Add Funding Support"
        on edit = "Edit Funding Support"
    }

    Funding_Identity
    (
        type = section
        displayname = "Funding Identity"
        row = 1
        column = 0
    )
    Funding_Support_ID
    (
        type = autonumber
        displayname = "Funding Support ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Linked_Batch
    (
        type = picklist
        displayname = "Linked Batch (Optional)"
        values = Batch_Operations.ID
        displayformat = [Batch_ID]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Funding_Source_Partner
    (
        type = text
        displayname = "Funding Source / Partner"
        row = 1
        column = 1
        width = medium
    )
    Funding_Type
    (
        type = picklist
        displayname = "Funding Type"
        values = {"CSR","Government Grant","Industry Partner","Foundation","Other"}
        row = 1
        column = 2
        width = medium
    )

    Amounts_Section
    (
        type = section
        displayname = "Amounts"
        visibility = true
        row = 2
        column = 1
    )
    Amount_Committed
    (
        type = INR
        displayname = "Amount Committed"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Amount_Received
    (
        type = INR
        displayname = "Amount Received"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Balance_Pending
    (
        type = formula
        displayname = "Balance / Pending"
        value = Amount_Committed - Amount_Received
        visibility = true
        row = 2
        column = 1
    )

    Status_Details
    (
        type = section
        displayname = "Status & Details"
        visibility = true
        row = 3
        column = 1
    )
    Funding_Status
    (
        type = picklist
        displayname = "Funding Status"
        values = {"Identified","Committed","Received","Partially Received","Utilized"}
        initial value = "Identified"
        row = 3
        column = 1
        width = medium
    )
    Linked_FY_Month
    (
        type = date
        displayname = "Linked FY / Month"
        row = 3
        column = 2
        width = medium
    )
    Utilized_For
    (
        type = textarea
        displayname = "Utilized For"
        row = 3
        column = 1
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        row = 3
        column = 2
        width = medium
    )

    Ownership_Section
    (
        type = section
        displayname = "Ownership"
        visibility = true
        row = 4
        column = 1
    )
    IPG_Owner
    (
        type = picklist
        displayname = "IP&G Owner"
        module = users
        displayformat = [name]
        row = 4
        column = 1
        width = medium
    )
    TD_Owner
    (
        type = picklist
        displayname = "T&D Owner"
        module = users
        displayformat = [name]
        row = 4
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
