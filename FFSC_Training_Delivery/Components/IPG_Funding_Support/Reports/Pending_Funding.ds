list Pending_Funding
{
    displayName = "Pending / Committed Funding"
    show all rows from IPG_Funding_Support [Funding_Status == "Committed" || Funding_Status == "Partially Received" || Funding_Status == "Identified"]
    (
        Centre
        Funding_Source_Partner as "Source / Partner"
        Funding_Type as "Type"
        Amount_Committed as "Committed"
        (
            display = total
        )
        Amount_Received as "Received"
        (
            display = total
        )
        Balance_Pending as "Balance"
        (
            display = total
        )
        Funding_Status as "Status"
        TD_Owner as "T&D Owner"
    )
    sort by
    (
        Amount_Committed descending
    )
}
