default list All_IPG_Funding
{
    displayName = "All IPG Funding"
    show all rows from IPG_Funding_Support
    (
        Funding_Support_ID as "ID"
        Centre
        Linked_Batch as "Batch"
        Funding_Source_Partner as "Source / Partner"
        Funding_Type as "Type"
        Amount_Committed as "Committed"
        (
            display = total
        )
        Amount_Received as "Received"
        (
            display = total
        )
        Balance_Pending as "Balance"
        (
            display = total
        )
        Funding_Status as "Status"
    )
    filters
    (
        Centre
        Funding_Type
        Funding_Status
    )
    sort by
    (
        Funding_Status ascending
    )
}
