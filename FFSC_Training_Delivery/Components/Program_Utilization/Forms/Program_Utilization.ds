form Program_Utilization
{
    title
    {
        displayname = "Program Utilization"
        on add = "Add Program Utilization"
        on edit = "Edit Program Utilization"
    }

    Centre_Period
    (
        type = section
        displayname = "Centre & Period"
        row = 1
        column = 0
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Reporting_Month
    (
        type = date
        displayname = "Reporting Month"
        row = 1
        column = 2
        width = medium
    )

    STT_Core_Section
    (
        type = section
        displayname = "STT Core"
        visibility = true
        row = 2
        column = 1
    )
    STT_Core_Planned_Batches_FY
    (
        type = number
        displayname = "STT Core Planned Batches FY"
        row = 2
        column = 1
        width = medium
    )
    STT_Core_Visible_in_Tracker
    (
        type = number
        displayname = "STT Core Visible in Tracker"
        row = 2
        column = 2
        width = medium
    )
    STT_Remaining_Capacity_FY
    (
        type = formula
        displayname = "STT Remaining Capacity FY"
        value = STT_Core_Visible_in_Tracker - STT_Core_Planned_Batches_FY
        visibility = true
        row = 2
        column = 1
    )

    RPL_PMC_Section
    (
        type = section
        displayname = "RPL & PMC"
        visibility = true
        row = 3
        column = 1
    )
    RPL_Plan
    (
        type = number
        displayname = "RPL Plan"
        row = 3
        column = 1
        width = medium
    )
    RPL_Actual
    (
        type = number
        displayname = "RPL Actual"
        row = 3
        column = 2
        width = medium
    )
    PMC_Training_Plan
    (
        type = number
        displayname = "PMC Training Plan"
        row = 3
        column = 1
        width = medium
    )
    PMC_Training_Actual
    (
        type = number
        displayname = "PMC Training Actual"
        row = 3
        column = 2
        width = medium
    )

    Upskilling_Workshops_Section
    (
        type = section
        displayname = "Upskilling & Workshops"
        visibility = true
        row = 4
        column = 1
    )
    Upskilling_Plan
    (
        type = number
        displayname = "Upskilling Plan"
        row = 4
        column = 1
        width = medium
    )
    Upskilling_Actual
    (
        type = number
        displayname = "Upskilling Actual"
        row = 4
        column = 2
        width = medium
    )
    Other_Workshops_Plan
    (
        type = number
        displayname = "Other Workshops Plan"
        row = 4
        column = 1
        width = medium
    )
    Other_Workshops_Actual
    (
        type = number
        displayname = "Other Workshops Actual"
        row = 4
        column = 2
        width = medium
    )

    TOT_WSC_India_Skills_Section
    (
        type = section
        displayname = "TOT, WSC & India Skills"
        visibility = true
        row = 5
        column = 1
    )
    TOT_A_Plan
    (
        type = number
        displayname = "TOT/A Plan"
        row = 5
        column = 1
        width = medium
    )
    TOT_A_Actual
    (
        type = number
        displayname = "TOT/A Actual"
        row = 5
        column = 2
        width = medium
    )
    WSC_Training_Plan
    (
        type = number
        displayname = "WSC Training Plan"
        row = 5
        column = 1
        width = medium
    )
    WSC_Training_Actual
    (
        type = number
        displayname = "WSC Training Actual"
        row = 5
        column = 2
        width = medium
    )
    India_Skills_Plan
    (
        type = number
        displayname = "India Skills Plan"
        row = 5
        column = 1
        width = medium
    )
    India_Skills_Actual
    (
        type = number
        displayname = "India Skills Actual"
        row = 5
        column = 2
        width = medium
    )

    Planning_Notes_Section
    (
        type = section
        displayname = "Planning & Notes"
        visibility = true
        row = 6
        column = 1
    )
    Priority_Program_Idle_Capacity
    (
        type = picklist
        displayname = "Priority Program to Use Idle Capacity"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 6
        column = 1
        width = medium
    )
    Owner_TM
    (
        type = picklist
        displayname = "Owner TM"
        module = users
        displayformat = [name]
        row = 6
        column = 2
        width = medium
    )
    Capacity_Constraints
    (
        type = textarea
        displayname = "Capacity / Constraints"
        row = 6
        column = 1
        width = medium
    )
    Updated_By
    (
        type = picklist
        displayname = "Updated By"
        module = users
        displayformat = [name]
        row = 6
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
