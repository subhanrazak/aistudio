default list All_Program_Utilization
{
    displayName = "All Program Utilization"
    show all rows from Program_Utilization
    (
        Centre
        Reporting_Month as "Reporting Month"
        STT_Core_Planned_Batches_FY as "STT Planned FY"
        STT_Core_Visible_in_Tracker as "STT Visible"
        STT_Remaining_Capacity_FY as "STT Remaining"
        RPL_Plan as "RPL Plan"
        RPL_Actual as "RPL Actual"
        Upskilling_Plan as "Upskilling Plan"
        Upskilling_Actual as "Upskilling Actual"
        Priority_Program_Idle_Capacity as "Priority Program"
        Owner_TM as "Owner TM"
    )
    filters
    (
        Centre
        Owner_TM
    )
    sort by
    (
        Reporting_Month descending
    )
}
