form Learner_Lifecycle_DB
{
    title
    {
        displayname = "Learner Lifecycle DB"
        on add = "Add Learner"
        on edit = "Edit Learner"
    }

    record owner = Added_User

    Centre_Batch
    (
        type = section
        displayname = "Centre & Batch"
        row = 1
        column = 0
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Batch
    (
        type = picklist
        displayname = "Batch"
        values = Batch_Operations.ID
        displayformat = [Batch_ID]
        searchable = true
        row = 1
        column = 2
        width = medium
    )

    Learner_Identity
    (
        type = section
        displayname = "Learner Identity"
        visibility = true
        row = 2
        column = 1
    )
    Learner_ID
    (
        type = autonumber
        displayname = "Learner ID"
        start index = 1
        row = 2
        column = 1
    )
    SIDH_ID
    (
        type = text
        displayname = "SIDH ID"
        row = 2
        column = 1
        width = medium
    )
    must have Learner_Name
    (
        type = text
        displayname = "Learner Name"
        row = 2
        column = 2
        width = medium
    )
    Gender
    (
        type = picklist
        displayname = "Gender"
        values = {"Male","Female","Other"}
        row = 2
        column = 1
        width = medium
    )
    Mobile
    (
        type = phonenumber
        displayname = "Mobile"
        defaultcountry = "in"
        row = 2
        column = 2
        width = medium
    )
    Aadhaar_ID_Proof_No
    (
        type = text
        displayname = "Aadhaar / ID Proof No."
        row = 2
        column = 1
        width = medium
    )
    Email
    (
        type = email
        displayname = "Email"
        row = 2
        column = 2
        width = medium
    )
    DOB
    (
        type = date
        displayname = "Date of Birth"
        row = 2
        column = 1
        width = medium
    )
    Father_Guardian_Name
    (
        type = text
        displayname = "Father / Guardian Name"
        row = 2
        column = 2
        width = medium
    )
    Qualification
    (
        type = picklist
        displayname = "Qualification"
        values = {"Below 8th","8th Pass","10th Pass","12th Pass","Diploma","Graduate","Post Graduate"}
        row = 2
        column = 1
        width = medium
    )
    State
    (
        type = text
        displayname = "State"
        row = 2
        column = 2
        width = medium
    )
    City
    (
        type = text
        displayname = "City"
        row = 2
        column = 1
        width = medium
    )

    Mobilisation_Enrollment
    (
        type = section
        displayname = "Mobilisation & Enrollment"
        visibility = true
        row = 3
        column = 1
    )
    Source_Channel
    (
        type = picklist
        displayname = "Source Channel"
        values = {"Direct Walk-in","NGO Partner","School Outreach","Digital/Social Media","Community Mobilisation","Referral","Other"}
        row = 3
        column = 1
        width = medium
    )
    Mobilisation_Drive
    (
        type = text
        displayname = "Mobilisation Drive"
        row = 3
        column = 2
        width = medium
    )
    Mobilised_Date
    (
        type = date
        displayname = "Mobilised Date"
        row = 3
        column = 1
        width = medium
    )
    Registration_Date
    (
        type = date
        displayname = "Registration Date"
        row = 3
        column = 2
        width = medium
    )
    Enrollment_Date
    (
        type = date
        displayname = "Enrollment Date"
        row = 3
        column = 1
        width = medium
    )
    Funding_Mode
    (
        type = picklist
        displayname = "Funding Mode"
        values = {"Student Paid/MSMP","FOC-to confirm","Industry Partner Funded","CSR Funded","Govt Funded"}
        row = 3
        column = 2
        width = medium
    )
    Program
    (
        type = picklist
        displayname = "Program"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 3
        column = 1
        width = medium
    )

    Training_Progress
    (
        type = section
        displayname = "Training Progress"
        visibility = true
        row = 4
        column = 1
    )
    Learner_Stage
    (
        type = picklist
        displayname = "Learner Stage"
        values = {"Mobilised Lead","Registered","Enrolled","Training In Progress","Training Completed","Certified","Placed","Alumni"}
        initial value = "Mobilised Lead"
        row = 4
        column = 1
        width = medium
    )
    Attendance_Percent
    (
        type = decimal
        displayname = "Attendance %"
        decimalplace = 1
        row = 4
        column = 2
        width = medium
    )
    Training_Start_Date
    (
        type = date
        displayname = "Training Start Date"
        row = 4
        column = 1
        width = medium
    )
    Training_Completion_Date
    (
        type = date
        displayname = "Training Completion Date"
        row = 4
        column = 2
        width = medium
    )
    Assessment_Date
    (
        type = date
        displayname = "Assessment Date"
        row = 4
        column = 1
        width = medium
    )
    Assessment_Status
    (
        type = picklist
        displayname = "Assessment Status"
        values = {"Not Scheduled","Scheduled","Appeared","Pass","Fail","Pending Result"}
        row = 4
        column = 2
        width = medium
    )
    Certification_Status
    (
        type = picklist
        displayname = "Certification Status"
        values = {"Not Applied","Applied","Issued","Pending"}
        row = 4
        column = 1
        width = medium
    )

    Placement_Section
    (
        type = section
        displayname = "Placement"
        visibility = true
        row = 5
        column = 1
    )
    Placement_Status
    (
        type = picklist
        displayname = "Placement Status"
        values = {"Not Started","In Progress","Placed","Self-Employed","Not Interested"}
        row = 5
        column = 1
        width = medium
    )
    Employer
    (
        type = text
        displayname = "Employer"
        row = 5
        column = 2
        width = medium
    )
    Job_Role
    (
        type = text
        displayname = "Job Role"
        row = 5
        column = 1
        width = medium
    )
    Salary_Stipend
    (
        type = INR
        displayname = "Salary / Stipend"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 5
        column = 2
        width = medium
    )
    Joining_Date
    (
        type = date
        displayname = "Joining Date"
        row = 5
        column = 1
        width = medium
    )

    Alumni_Followup
    (
        type = section
        displayname = "Alumni & Follow-up"
        visibility = true
        row = 6
        column = 1
    )
    Upskilling_Interest
    (
        type = checkbox
        displayname = "Upskilling Interest?"
        row = 6
        column = 1
        width = medium
    )
    Upskilling_Program
    (
        type = text
        displayname = "Upskilling Program"
        row = 6
        column = 2
        width = medium
    )
    Alumni_Status
    (
        type = picklist
        displayname = "Alumni Status"
        values = {"Active","Inactive","Lost Contact"}
        row = 6
        column = 1
        width = medium
    )
    Alumni_Network_Consent
    (
        type = checkbox
        displayname = "Alumni Network Consent"
        row = 6
        column = 2
        width = medium
    )
    Current_Contact_Status
    (
        type = picklist
        displayname = "Current Contact Status"
        values = {"Reachable","Unreachable","Follow-up Pending"}
        row = 6
        column = 1
        width = medium
    )
    Next_Action
    (
        type = text
        displayname = "Next Action"
        row = 6
        column = 2
        width = medium
    )

    Learner_Metadata
    (
        type = section
        displayname = "Metadata"
        visibility = true
        row = 7
        column = 1
    )
    Owner
    (
        type = picklist
        displayname = "Owner"
        module = users
        displayformat = [name]
        row = 7
        column = 1
        width = medium
    )
    RAG
    (
        type = picklist
        displayname = "RAG"
        values = {"Green","Amber","Red"}
        initial value = "Green"
        row = 7
        column = 2
        width = medium
    )
    Updated_By
    (
        type = picklist
        displayname = "Updated By"
        module = users
        displayformat = [name]
        row = 7
        column = 1
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        row = 7
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
