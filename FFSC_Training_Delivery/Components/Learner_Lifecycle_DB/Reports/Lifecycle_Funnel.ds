list Lifecycle_Funnel
{
    displayName = "Lifecycle Funnel"
    show all rows from Learner_Lifecycle_DB
    (
        Batch
        Learner_Stage as "Stage"
        Learner_Name as "Learner Count"
        (
            display = total
        )
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Batch ascending
        Learner_Stage ascending
    )
    sort by
    (
        Batch ascending
    )
}
