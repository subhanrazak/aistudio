list Placed_Learners
{
    displayName = "Placed Learners"
    show all rows from Learner_Lifecycle_DB [Placement_Status == "Placed"]
    (
        Learner_Name as "Learner Name"
        Centre
        Batch
        Program
        Employer
        Job_Role as "Job Role"
        Salary_Stipend as "Salary / Stipend"
        Joining_Date as "Joining Date"
    )
    sort by
    (
        Joining_Date descending
    )
}
