default list All_Monthly_Updates
{
    displayName = "All Monthly Updates"
    show all rows from Academy_Monthly_Update
    (
        Report_Month as "Month"
        Centre
        TM
        Trainer
        Learners_Mobilised as "Mobilised"
        (
            display = total
        )
        Learners_Enrolled as "Enrolled"
        (
            display = total
        )
        Training_Completed as "Trained"
        (
            display = total
        )
        Certified
        (
            display = total
        )
        Placed
        (
            display = total
        )
        Revenue_Collected_This_Month as "Revenue"
        (
            display = total
        )
        Cost_Incurred_This_Month as "Cost"
        (
            display = total
        )
        CEO_Escalation_Required as "CEO Escalation?"
    )
    filters
    (
        Centre
        CEO_Escalation_Required
    )
    sort by
    (
        Report_Month descending
    )
    conditional formatting
    (
        "CEO Escalation"
        {
            condition = (CEO_Escalation_Required == true)
            fields = [Report_Month, Centre, CEO_Escalation_Required]
            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
        }
    )
}
