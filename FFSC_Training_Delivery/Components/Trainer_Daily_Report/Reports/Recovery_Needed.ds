list Recovery_Needed
{
    displayName = "Recovery Required Reports"
    show all rows from Trainer_Daily_Report [Recovery_Required == true]
    (
        Trainer
        Batch
        Report_Date as "Date"
        Planned_Topic as "Planned Topic"
        Actual_Activity_Done as "Actual Activity"
        Completion_Percent as "Completion %"
        SP_Team_Remark as "SP Remark"
    )
    sort by
    (
        Report_Date descending
    )
}
