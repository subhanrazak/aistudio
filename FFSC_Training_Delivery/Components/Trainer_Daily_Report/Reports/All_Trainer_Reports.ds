default list All_Trainer_Reports
{
    displayName = "All Trainer Reports"
    show all rows from Trainer_Daily_Report
    (
        Trainer
        Batch
        Report_Date as "Date"
        Candidates_Present as "Present"
        Planned_Topic as "Planned Topic"
        Actual_Activity_Done as "Actual Activity"
        Completion_Percent as "Completion %"
        Deviation
        Recovery_Required as "Recovery?"
    )
    filters
    (
        Trainer
        Batch
        Recovery_Required
    )
    sort by
    (
        Report_Date descending
    )
    conditional formatting
    (
        "Recovery Required"
        {
            condition = (Recovery_Required == true)
            fields = [Trainer, Batch, Recovery_Required]
            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
        }
        "Deviation Noted"
        {
            condition = (Deviation == "Deviation Noted")
            fields = [Deviation]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
