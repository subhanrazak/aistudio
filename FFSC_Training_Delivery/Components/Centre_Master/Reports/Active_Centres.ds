list Active_Centres
{
    displayName = "Active Centres"
    show all rows from Centre_Master [Current_Status == "Active"]
    (
        Centre_Name as "Centre Name"
        Centre_Type as "Type"
        Location
        RAG as "RAG"
        Programs_at_Centre as "Programs"
        Parallel_Batch_Capacity as "Parallel Capacity"
        Current_Candidate_Count as "Candidates"
        (
            display = total
        )
        Candidates_Trained_Cumulative as "Trained (Total)"
        (
            display = total
        )
        Candidates_Placed_Cumulative as "Placed (Total)"
        (
            display = total
        )
    )
    sort by
    (
        Centre_Name ascending
    )
}
