form Centre_Master
{
    title
    {
        displayname = "Centre Master"
        on add = "Add Centre"
        on edit = "Edit Centre"
    }

    record owner = Added_User

    Centre_Identity
    (
        type = section
        displayname = "Centre Identity"
        row = 1
        column = 0
    )
    Centre_ID
    (
        type = autonumber
        displayname = "Centre ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Centre_Name
    (
        type = text
        displayname = "Centre Name"
        row = 1
        column = 1
        width = medium
    )
    must have Centre_Type
    (
        type = picklist
        displayname = "Centre Type"
        values = {"Normal","IEVO","NSTI","Sun Foundation","HPWWI"}
        row = 1
        column = 2
        width = medium
    )
    Location
    (
        type = text
        displayname = "Location"
        row = 1
        column = 1
        width = medium
    )
    Regional_SPOC
    (
        type = text
        displayname = "Regional SPOC"
        row = 1
        column = 2
        width = medium
    )

    Status_Classification
    (
        type = section
        displayname = "Status & Classification"
        visibility = true
        row = 2
        column = 1
    )
    Centre_Performance_Bucket
    (
        type = picklist
        displayname = "Centre Performance Bucket"
        values = {"High Performer","Medium Performer","Low Performer"}
        row = 2
        column = 1
        width = medium
    )
    Current_Status
    (
        type = picklist
        displayname = "Current Status"
        values = {"Active","Hold","Closed","Infra Setup"}
        initial value = "Active"
        row = 2
        column = 2
        width = medium
    )
    Lifecycle_Summary
    (
        type = picklist
        displayname = "Lifecycle Summary"
        values = {"Planned","Pipeline","MoU Signed-No Activity","Infra Setup","Mobilization"}
        row = 2
        column = 1
        width = medium
    )
    RAG
    (
        type = picklist
        displayname = "RAG Status"
        values = {"Green","Amber","Red"}
        initial value = "Green"
        row = 2
        column = 2
        width = medium
    )

    Programs_Capacity
    (
        type = section
        displayname = "Programs & Capacity"
        visibility = true
        row = 3
        column = 1
    )
    Programs_at_Centre
    (
        type = checkboxes
        displayname = "Programs at Centre"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 3
        column = 1
        width = medium
    )
    Active_Current_Programs
    (
        type = checkboxes
        displayname = "Active / Current Programs"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 3
        column = 2
        width = medium
    )
    Parallel_Batch_Capacity
    (
        type = number
        displayname = "Parallel Batch Capacity"
        row = 3
        column = 1
        width = medium
    )
    Annual_STT_Batch_Capacity
    (
        type = number
        displayname = "Annual STT Batch Capacity"
        row = 3
        column = 2
        width = medium
    )
    Funding_Modes_Active
    (
        type = checkboxes
        displayname = "Funding Modes Active"
        values = {"Student Paid/MSMP","FOC-to confirm","Industry Partner Funded","CSR Funded","Govt Funded"}
        row = 3
        column = 1
        width = medium
    )
    Funding_Support_Required
    (
        type = checkbox
        displayname = "Funding Support Required?"
        row = 3
        column = 2
        width = medium
    )

    Batch_Dates
    (
        type = section
        displayname = "Batch Dates"
        visibility = true
        row = 4
        column = 1
    )
    Current_Batch_Start_Date
    (
        type = date
        displayname = "Current Batch Start Date"
        row = 4
        column = 1
        width = medium
    )
    Next_Batch_Tentative_Date
    (
        type = date
        displayname = "Next Batch Tentative Date"
        row = 4
        column = 2
        width = medium
    )

    Team_Assignment
    (
        type = section
        displayname = "Team Assignment"
        visibility = true
        row = 5
        column = 1
    )
    Trainers
    (
        type = picklist
        displayname = "Trainer"
        module = users
        displayformat = [name]
        row = 5
        column = 1
        width = medium
    )
    TMs
    (
        type = picklist
        displayname = "TM"
        module = users
        displayformat = [name]
        row = 5
        column = 2
        width = medium
    )

    Notes_Updates
    (
        type = section
        displayname = "Notes & Updates"
        visibility = true
        row = 6
        column = 1
    )
    Commercial_Key_Update
    (
        type = textarea
        displayname = "Commercial / Key Update"
        row = 6
        column = 1
        width = medium
    )
    CEO_Action_Risk_Note
    (
        type = textarea
        displayname = "CEO Action / Risk Note"
        row = 6
        column = 2
        width = medium
    )

    Metadata
    (
        type = section
        displayname = "Metadata"
        visibility = true
        row = 7
        column = 1
    )
    Updated_By
    (
        type = picklist
        displayname = "Updated By"
        module = users
        displayformat = [name]
        row = 7
        column = 1
        width = medium
    )
    Last_Updated
    (
        type = datetime
        displayname = "Last Updated"
        initial value = "${zoho.currenttime}"
        row = 7
        column = 2
        width = medium
    )
    Current_Candidate_Count
    (
        type = number
        displayname = "Current Candidate Count"
        row = 7
        column = 1
        width = medium
    )
    Program_Wise_Batches_Done
    (
        type = number
        displayname = "Program-wise Batches Done"
        row = 7
        column = 2
        width = medium
    )
    Candidates_Trained_Cumulative
    (
        type = number
        displayname = "Candidates Trained (Cumulative)"
        row = 7
        column = 1
        width = medium
    )
    Candidates_Placed_Cumulative
    (
        type = number
        displayname = "Candidates Placed (Cumulative)"
        row = 7
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
