form Academy_PL
{
    title
    {
        displayname = "Academy P&L"
        on add = "Add Academy P&L Record"
        on edit = "Edit Academy P&L Record"
    }

    Centre_Period
    (
        type = section
        displayname = "Centre & Period"
        row = 1
        column = 0
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Reporting_Month
    (
        type = date
        displayname = "Reporting Month"
        row = 1
        column = 2
        width = medium
    )
    Current_Candidate_Count
    (
        type = number
        displayname = "Current Candidate Count"
        row = 1
        column = 1
        width = medium
    )

    Student_Paid_Revenue
    (
        type = section
        displayname = "Student Paid Revenue"
        visibility = true
        row = 2
        column = 1
    )
    Installment_1
    (
        type = INR
        displayname = "Installment 1"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Installment_2
    (
        type = INR
        displayname = "Installment 2"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Installment_3
    (
        type = INR
        displayname = "Installment 3"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Installment_4
    (
        type = INR
        displayname = "Installment 4"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Installment_5
    (
        type = INR
        displayname = "Installment 5"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Installment_6
    (
        type = INR
        displayname = "Installment 6"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Installment_7
    (
        type = INR
        displayname = "Installment 7"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )

    Other_Revenue_Section
    (
        type = section
        displayname = "Other Revenue"
        visibility = true
        row = 3
        column = 1
    )
    Skill_Academy_Partner_Revenue
    (
        type = INR
        displayname = "Skill Academy Partner Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 1
        width = medium
    )
    School_Workshop_Revenue
    (
        type = INR
        displayname = "School Workshop Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 2
        width = medium
    )
    College_Workshop_Revenue
    (
        type = INR
        displayname = "College Workshop Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 1
        width = medium
    )
    Workshop_RPL_Other_Revenue
    (
        type = INR
        displayname = "Workshop/RPL/Upskilling/Other Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 2
        width = medium
    )
    IPG_Funding_Support_Received
    (
        type = INR
        displayname = "IP&G Funding Support Received"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 1
        width = medium
    )
    CSR_Govt_Industry_Funding
    (
        type = INR
        displayname = "CSR/Govt/Industry Funding"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 2
        width = medium
    )
    Marketing_Collaboration_Revenue
    (
        type = INR
        displayname = "Marketing Collaboration Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 1
        width = medium
    )
    Other_Revenue
    (
        type = INR
        displayname = "Other Revenue"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 3
        column = 2
        width = medium
    )
    Total_Revenue
    (
        type = formula
        displayname = "Total Revenue"
        value = Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue
        visibility = true
        row = 3
        column = 1
    )

    Costs_Section
    (
        type = section
        displayname = "Costs"
        visibility = true
        row = 4
        column = 1
    )
    Trainer_Cost
    (
        type = INR
        displayname = "Trainer Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    TM_Cost_Allocation
    (
        type = INR
        displayname = "TM Cost Allocation"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 2
        width = medium
    )
    HQ_Cost_Allocation
    (
        type = INR
        displayname = "HQ Cost Allocation"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    Mobilisation_Cost
    (
        type = INR
        displayname = "Mobilisation Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 2
        width = medium
    )
    Assessment_Cost
    (
        type = INR
        displayname = "Assessment Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    Consumables_Material
    (
        type = INR
        displayname = "Consumables / Material"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 2
        width = medium
    )
    Travel_Local_Coordination
    (
        type = INR
        displayname = "Travel / Local Coordination"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    Infra_Branding_Setup
    (
        type = INR
        displayname = "Infra / Branding / Setup"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 2
        width = medium
    )
    Other_Cost
    (
        type = INR
        displayname = "Other Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 4
        column = 1
        width = medium
    )
    Total_Cost
    (
        type = formula
        displayname = "Total Cost"
        value = Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost
        visibility = true
        row = 4
        column = 2
    )

    PL_Summary_Section
    (
        type = section
        displayname = "P&L Summary"
        visibility = true
        row = 5
        column = 1
    )
    Net_Surplus_Deficit
    (
        type = formula
        displayname = "Net Surplus / Deficit"
        value = (Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue) - (Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost)
        visibility = true
        row = 5
        column = 1
    )
    Cost_Recovery_Percent
    (
        type = formula
        displayname = "Cost Recovery %"
        value = if((Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost) > 0, (Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue) / (Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost) * 100, 0)
        visibility = true
        row = 5
        column = 2
    )
    Funding_Gap
    (
        type = formula
        displayname = "Funding Gap"
        value = if((Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost) > (Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue), (Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost) - (Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue), 0)
        visibility = true
        row = 5
        column = 1
    )
    Finance_Validation_Status
    (
        type = picklist
        displayname = "Finance Validation Status"
        values = {"Pending","Validated"}
        initial value = "Pending"
        row = 5
        column = 2
        width = medium
    )
    Notes_Assumptions
    (
        type = textarea
        displayname = "Notes / Assumptions"
        row = 5
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
