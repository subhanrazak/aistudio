form Batch_Operations
{
    title
    {
        displayname = "Batch Operations"
        on add = "Add Batch"
        on edit = "Edit Batch"
    }

    record owner = Added_User

    Batch_Identity
    (
        type = section
        displayname = "Batch Identity"
        row = 1
        column = 0
    )
    Batch_ID
    (
        type = autonumber
        displayname = "Batch ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Program
    (
        type = picklist
        displayname = "Program"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 1
        column = 2
        width = medium
    )
    Program_Category
    (
        type = picklist
        displayname = "Program Category"
        values = {"Core Skills","Upskilling","Assessment","Workshop","Competition"}
        row = 1
        column = 1
        width = medium
    )
    Scheme
    (
        type = text
        displayname = "Scheme"
        row = 1
        column = 2
        width = medium
    )

    Funding_Details
    (
        type = section
        displayname = "Funding Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Funding_Mode
    (
        type = picklist
        displayname = "Funding Mode"
        values = {"Student Paid/MSMP","FOC-to confirm","Industry Partner Funded","CSR Funded","Govt Funded"}
        row = 2
        column = 1
        width = medium
    )
    Funding_Source
    (
        type = text
        displayname = "Funding Source"
        row = 2
        column = 2
        width = medium
    )
    must have Funding_Confirmed
    (
        type = picklist
        displayname = "Funding Confirmed"
        values = {"Yes","No","To Confirm","Historical"}
        initial value = "To Confirm"
        row = 2
        column = 1
        width = medium
    )
    Funding_Commercial_Notes
    (
        type = textarea
        displayname = "Funding / Commercial Notes"
        row = 2
        column = 2
        width = medium
    )

    Batch_Lifecycle
    (
        type = section
        displayname = "Batch Lifecycle"
        visibility = true
        row = 3
        column = 1
    )
    Batch_Stage
    (
        type = picklist
        displayname = "Batch Stage"
        values = {"Track M","Track D","Planning","Active","Completed","On Hold"}
        row = 3
        column = 1
        width = medium
    )
    Lifecycle_Tag
    (
        type = picklist
        displayname = "Lifecycle Tag"
        values = {"Planned","Pipeline","Mobilization","Enrolled","Training","Assessment","Certified","Placed","Alumni","On Hold"}
        row = 3
        column = 2
        width = medium
    )
    Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 3
        column = 1
        width = medium
    )
    End_Date
    (
        type = date
        displayname = "End Date"
        row = 3
        column = 2
        width = medium
    )

    Outcomes_Status
    (
        type = section
        displayname = "Outcomes & Status"
        visibility = true
        row = 4
        column = 1
    )
    Assessment_Status
    (
        type = picklist
        displayname = "Assessment Status"
        values = {"Not Started","Scheduled","Completed","Pending Results"}
        row = 4
        column = 1
        width = medium
    )
    Certification_Status
    (
        type = picklist
        displayname = "Certification Status"
        values = {"Not Applied","Applied","Issued","Pending"}
        row = 4
        column = 2
        width = medium
    )
    Placement_Status
    (
        type = picklist
        displayname = "Placement Status"
        values = {"Not Started","In Progress","Partially Placed","Fully Placed"}
        row = 4
        column = 1
        width = medium
    )
    Apprenticeship_Status
    (
        type = picklist
        displayname = "Apprenticeship Status"
        values = {"Not Applicable","In Progress","Completed"}
        row = 4
        column = 2
        width = medium
    )
    Risk_Flag
    (
        type = picklist
        displayname = "Risk Flag"
        values = {"Green","Amber","Red"}
        initial value = "Green"
        row = 4
        column = 1
        width = medium
    )
    CEO_Action_Required
    (
        type = checkbox
        displayname = "CEO Action Required?"
        row = 4
        column = 2
        width = medium
    )

    Next_Steps
    (
        type = section
        displayname = "Next Steps"
        visibility = true
        row = 5
        column = 1
    )
    Next_Step
    (
        type = textarea
        displayname = "Next Step"
        row = 5
        column = 1
        width = medium
    )

    Rollup_Section
    (
        type = section
        displayname = "Learner Rollup"
        visibility = true
        row = 6
        column = 1
    )
    Candidates_Count
    (
        type = number
        displayname = "Candidates Count"
        row = 6
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
