default list All_Batches
{
    displayName = "All Batches"
    show all rows from Batch_Operations
    (
        Batch_ID as "Batch ID"
        Centre
        Program
        Funding_Mode as "Funding Mode"
        Funding_Confirmed as "Funding Confirmed"
        Batch_Stage as "Stage"
        Lifecycle_Tag as "Lifecycle"
        Start_Date as "Start Date"
        End_Date as "End Date"
        Risk_Flag as "Risk"
        Candidates_Count as "Candidates"
        (
            display = total
        )
        CEO_Action_Required as "CEO Action?"
    )
    filters
    (
        Centre
        Program
        Funding_Confirmed
        Batch_Stage
        Risk_Flag
        Lifecycle_Tag
    )
    sort by
    (
        Start_Date descending
    )
    conditional formatting
    (
        "Red Risk"
        {
            condition = (Risk_Flag == "Red")
            fields = [Batch_ID, Risk_Flag]
            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
        }
        "Amber Risk"
        {
            condition = (Risk_Flag == "Amber")
            fields = [Batch_ID, Risk_Flag]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
