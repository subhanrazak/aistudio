list CEO_Action_Batches
{
    displayName = "CEO Action Required Batches"
    show all rows from Batch_Operations [CEO_Action_Required == true]
    (
        Batch_ID as "Batch ID"
        Centre
        Program
        Funding_Confirmed as "Funding Confirmed"
        Risk_Flag as "Risk"
        Batch_Stage as "Stage"
        Next_Step as "Next Step"
    )
    sort by
    (
        Risk_Flag ascending
    )
}
