"Trainer"
{
    name        = "Trainer"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Trainer - create/edit Trainer Daily Report; limited edit on Learner DB (attendance/stage/assessment fields only); read-only on assigned batches"

    ModulePermissions
    {
        Batch_Operations
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View"}
                Active_Batches={"View"}
                Batches_By_Centre={"View"}
            }
        }

        Learner_Lifecycle_DB
        {
            enabled          = View,Viewall,Edit,Modifyall,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Learners={"View"}
                Learners_By_Stage={"View"}
                Learners_By_Batch={"View"}
            }
            FieldPermissions
            {
                Aadhaar_ID_Proof_No{visibility:false}
                Salary_Stipend{visibility:false}
                Learner_Name{visibility:true,readonly:true}
                Gender{visibility:true,readonly:true}
                Mobile{visibility:true,readonly:true}
                Email{visibility:true,readonly:true}
                DOB{visibility:true,readonly:true}
                Father_Guardian_Name{visibility:true,readonly:true}
                Qualification{visibility:true,readonly:true}
                State{visibility:true,readonly:true}
                City{visibility:true,readonly:true}
                Source_Channel{visibility:true,readonly:true}
                Mobilisation_Drive{visibility:true,readonly:true}
                Mobilised_Date{visibility:true,readonly:true}
                Registration_Date{visibility:true,readonly:true}
                Enrollment_Date{visibility:true,readonly:true}
                Funding_Mode{visibility:true,readonly:true}
                Program{visibility:true,readonly:true}
                SIDH_ID{visibility:true,readonly:true}
                Employer{visibility:true,readonly:true}
                Job_Role{visibility:true,readonly:true}
                Joining_Date{visibility:true,readonly:true}
                Placement_Status{visibility:true,readonly:true}
                Owner{visibility:true,readonly:true}
                RAG{visibility:true,readonly:true}
                Upskilling_Interest{visibility:true,readonly:true}
                Upskilling_Program{visibility:true,readonly:true}
                Alumni_Status{visibility:true,readonly:true}
                Alumni_Network_Consent{visibility:true,readonly:true}
                Current_Contact_Status{visibility:true,readonly:true}
                Next_Action{visibility:true,readonly:true}
            }
        }

        Trainer_Daily_Report
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Trainer_Reports={"View","Edit","Delete"}
                Recovery_Needed={"View"}
                Reports_By_Batch={"View"}
            }
        }

        Academy_Monthly_Update
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Monthly_Updates={"View","Edit"}
                CEO_Escalations={"View"}
                Updates_By_Centre={"View"}
            }
        }
    }
}
