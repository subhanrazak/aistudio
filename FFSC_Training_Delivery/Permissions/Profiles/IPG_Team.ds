"IPG_Team"
{
    name        = "IPG_Team"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "IP&G Team - create/edit access limited to IPG Funding Support module only"

    ModulePermissions
    {
        Centre_Master
        {
            enabled          = View,Viewall,Search
            allFieldsVisible = true
        }

        Batch_Operations
        {
            enabled          = View,Viewall,Search
            allFieldsVisible = true
        }

        IPG_Funding_Support
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_IPG_Funding={"View","Edit"}
                Pending_Funding={"View","Edit"}
                Funding_By_Centre={"View"}
            }
        }

        Learner_Lifecycle_DB
        {
            enabled          = View,Viewall,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Aadhaar_ID_Proof_No{visibility:false}
                Salary_Stipend{visibility:false}
            }
        }
    }
}
