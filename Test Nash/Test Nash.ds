application "Test-Nash"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Assessment_Documents
		{
		    displayname = "Assessment Documents"
		
		    Document_Details
		    (
		        type = section
		        displayname = "Document Details"
		        row = 1
		        column = 0
		    )
		
		    must have Assessment
		    (
		        type = picklist
		        displayname = "Assessment"
		        values = Assessments.ID
		        displayformat = [Assessment_Reference]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Document_Name
		    (
		        type = text
		        displayname = "Document Name"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Document_Type
		    (
		        type = picklist
		        displayname = "Document Type"
		        values = {"Generated Report","Supporting"}
		        initial value = "Supporting"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Document_File
		    (
		        type = upload file
		        displayname = "Document File"
		        file count = 1
		        browse = local_drive, google_docs, zoho_docs
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Document_URL
		    (
		        type = url
		        displayname = "Document URL"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Uploaded_By
		    (
		        type = picklist
		        displayname = "Uploaded By"
		        module = users
		        displayformat = [name]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Upload_Date
		    (
		        type = datetime
		        displayname = "Upload Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Version_Number
		    (
		        type = number
		        displayname = "Version Number"
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Revision_Notes
		    (
		        type = textarea
		        displayname = "Revision Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Source_Action
		    (
		        type = picklist
		        displayname = "Source Action"
		        values = {"Manual Upload","Generated on Submit","Regenerated"}
		        initial value = "Manual Upload"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessment_Responses
		{
		    displayname = "Assessment Responses"
		
		    Response_Context
		    (
		        type = section
		        displayname = "Response Context"
		        row = 1
		        column = 0
		    )
		
		    must have Assessment
		    (
		        type = picklist
		        displayname = "Assessment"
		        values = Assessments.ID
		        displayformat = [Assessment_Reference]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Question_Bank_Question
		    (
		        type = picklist
		        displayname = "Question Bank Question"
		        values = Questions.ID
		        displayformat = [Question_Text]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Category_Snapshot
		    (
		        type = text
		        displayname = "Category Snapshot"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Category_Display_Order
		    (
		        type = number
		        displayname = "Category Display Order"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Question_Text_Snapshot
		    (
		        type = textarea
		        displayname = "Question Snapshot"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Question_Display_Order
		    (
		        type = number
		        displayname = "Question Display Order"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Industry_Type_Snapshot
		    (
		        type = text
		        displayname = "Industry Type Snapshot"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Answer_Type_Snapshot
		    (
		        type = picklist
		        displayname = "Answer Type Snapshot"
		        values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Option_Values_Snapshot
		    (
		        type = textarea
		        displayname = "Option Values Snapshot"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Mandatory_Snapshot
		    (
		        type = checkbox
		        displayname = "Mandatory Snapshot"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Answer_Section
		    (
		        type = section
		        displayname = "Answer"
		        visibility = true
		        row = 2
		        column = 1
		    )
		
		    Single_Line_Answer
		    (
		        type = text
		        displayname = "Single Line Answer"
		        maxchar = 255
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Paragraph_Answer
		    (
		        type = textarea
		        displayname = "Paragraph Answer"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Dropdown_Answer
		    (
		        type = picklist
		        displayname = "Dropdown Answer"
		        values = {"Not Applicable"}
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Multi_Select_Answer
		    (
		        type = list
		        displayname = "Multi Select Answer"
		        values = {"Not Applicable"}
		        height = 80px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Rating_Answer
		    (
		        type = number
		        displayname = "Rating Answer"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Yes_No_Answer
		    (
		        type = picklist
		        displayname = "Yes No Answer"
		        values = {"Yes","No"}
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Normalized_Answer
		    (
		        type = textarea
		        displayname = "Normalized Answer"
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Submission_Metadata
		    (
		        type = section
		        displayname = "Submission Metadata"
		        visibility = true
		        row = 3
		        column = 1
		    )
		
		    Completed_By_Name
		    (
		        type = text
		        displayname = "Completed By Name"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Completed_By_Email
		    (
		        type = email
		        displayname = "Completed By Email"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Completed_Mode
		    (
		        type = picklist
		        displayname = "Completed Mode"
		        values = {"Internal","External"}
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Submitted_At
		    (
		        type = datetime
		        displayname = "Submitted At"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Row_Status
		    (
		        type = picklist
		        displayname = "Row Status"
		        values = {"Draft","Answered","Submitted"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessment_Settings
		{
		    displayname = "Assessment Settings"
		
		    Validity_Settings
		    (
		        type = section
		        displayname = "Validity Settings"
		        row = 1
		        column = 0
		    )
		
		    must have unique Setting_Name
		    (
		        type = text
		        displayname = "Setting Name"
		        maxchar = 100
		        initial value = "Default"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Default_Validity_Months
		    (
		        type = number
		        displayname = "Default Validity Months"
		        initial value = 3
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Reminder_Days_Before_Expiry
		    (
		        type = number
		        displayname = "Reminder Days Before Expiry"
		        initial value = 15
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Notify_Customer_On_Expiry
		    (
		        type = checkbox
		        displayname = "Notify Customer On Expiry"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Branding_Section
		    (
		        type = section
		        displayname = "Branding"
		        visibility = true
		        row = 2
		        column = 1
		    )
		
		    Branding_Name
		    (
		        type = text
		        displayname = "Branding Name"
		        initial value = "Kannanware"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Logo_URL
		    (
		        type = url
		        displayname = "Logo URL"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Report_Header_Text
		    (
		        type = text
		        displayname = "Report Header Text"
		        initial value = "Current State Assessment Report"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Report_Footer_Text
		    (
		        type = text
		        displayname = "Report Footer Text"
		        initial value = "Confidential - Kannanware"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Assessments
		{
		    displayname = "Assessments"
		
		    Assessment_Details
		    (
		        type = section
		        displayname = "Assessment Details"
		        row = 1
		        column = 0
		    )
		
		    Assessment_Sequence
		    (
		        type = autonumber
		        displayname = "Assessment Sequence"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    unique Assessment_Reference
		    (
		        type = text
		        displayname = "Assessment Reference"
		        maxchar = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Project
		    (
		        type = picklist
		        displayname = "Project"
		        values = Projects[Project_Status != "Cancelled"].ID
		        displayformat = [Project_Name]
		        searchable = true
		        allow new entries
		        [
		            displayname = "Add New Project"
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        searchable = true
		        allow new entries
		        [
		            displayname = "Add New Customer"
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Customer_Contact_Email
		    (
		        type = email
		        displayname = "Customer Contact Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Industry_Type
		    (
		        type = picklist
		        displayname = "Industry Type"
		        values = Industry_Types[Active == true].ID
		        displayformat = [Industry_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Assigned_Consultant
		    (
		        type = picklist
		        displayname = "Assigned Consultant"
		        module = users
		        displayformat = [name]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Assessment_Mode
		    (
		        type = picklist
		        displayname = "Assessment Mode"
		        values = {"Internal","External"}
		        initial value = "Internal"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Draft","In Progress","Submitted","Expired"}
		        initial value = "Draft"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Validity_Section
		    (
		        type = section
		        displayname = "Validity"
		        visibility = true
		        row = 2
		        column = 1
		    )
		
		    Validity_Period_Months
		    (
		        type = number
		        displayname = "Validity Period Months"
		        initial value = 3
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Submission_Date
		    (
		        type = date
		        displayname = "Submission Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Valid_Until
		    (
		        type = date
		        displayname = "Valid Until"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Expiry_Reminder_Sent
		    (
		        type = checkbox
		        displayname = "Expiry Reminder Sent"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Expired_Notification_Sent
		    (
		        type = checkbox
		        displayname = "Expired Notification Sent"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Assessment_Submission_Metadata
		    (
		        type = section
		        displayname = "Assessment Submission Metadata"
		        visibility = true
		        row = 3
		        column = 1
		    )
		
		    Completed_By_Name
		    (
		        type = text
		        displayname = "Completed By Name"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Completed_By_Email
		    (
		        type = email
		        displayname = "Completed By Email"
		        personal data = true
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Submission_Timestamp
		    (
		        type = datetime
		        displayname = "Submission Timestamp"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Submission_Mode
		    (
		        type = picklist
		        displayname = "Submission Mode"
		        values = {"Internal","External"}
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    External_Access
		    (
		        type = section
		        displayname = "External Access"
		        visibility = true
		        row = 4
		        column = 1
		    )
		
		    unique Public_Token
		    (
		        type = text
		        displayname = "Public Token"
		        maxchar = 100
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Public_Link
		    (
		        type = url
		        displayname = "Public Link"
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Public_Link_Generated_On
		    (
		        type = datetime
		        displayname = "Public Link Generated On"
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Public_Link_Expires_On
		    (
		        type = date
		        displayname = "Public Link Expires On"
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Questions_Generated
		    (
		        type = checkbox
		        displayname = "Questions Generated"
		        initial value = false
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Assessment_Responses_Section
		    (
		        type = section
		        displayname = "Assessment Response Rows"
		        visibility = false
		        row = 5
		        column = 1
		    )
		
		    Responses
		    (
		        type = grid
		        displayname = "Responses"
		        values = Assessment_Responses.ID
		        bidirectional = Assessment
		        defaultrow = 0
		        sorttype = fieldbased
		        sort by
		        (
		            Category_Display_Order ascending
		            Question_Display_Order ascending
		        )
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    Assessment_Documents_Section
		    (
		        type = section
		        displayname = "Assessment Document Files"
		        visibility = false
		        row = 6
		        column = 1
		    )
		
		    Documents
		    (
		        type = grid
		        displayname = "Documents"
		        values = Assessment_Documents.ID
		        bidirectional = Assessment
		        defaultrow = 0
		        sorttype = fieldbased
		        sort by
		        (
		            Version_Number descending
		            Upload_Date descending
		        )
		        row = 6
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customers
		{
		    displayname = "Customers"
		
		    Customer_Details
		    (
		        type = section
		        displayname = "Customer Details"
		        row = 1
		        column = 0
		    )
		
		    must have unique Customer_Name
		    (
		        type = text
		        displayname = "Customer Name"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Primary_Contact_Name
		    (
		        type = text
		        displayname = "Primary Contact Name"
		        maxchar = 150
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Primary_Contact_Email
		    (
		        type = email
		        displayname = "Primary Contact Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Primary_Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Primary Contact Phone"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Customer_Status
		    (
		        type = picklist
		        displayname = "Customer Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form External_Assessment_Submission
		{
		    displayname = "External Assessment Submission"
		    success message = "Thank you. Your assessment has been submitted."
		    captcha = true
		
		    Access_Section
		    (
		        type = section
		        displayname = "Assessment Access"
		        row = 1
		        column = 0
		    )
		
		    Token
		    (
		        type = text
		        displayname = "Token"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Assessment_ID
		    (
		        type = number
		        displayname = "Assessment ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Assessment_Reference
		    (
		        type = text
		        displayname = "Assessment Reference"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Project_Name
		    (
		        type = text
		        displayname = "Project Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Customer_Name
		    (
		        type = text
		        displayname = "Customer Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Industry_Name
		    (
		        type = text
		        displayname = "Industry"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Completion_Section
		    (
		        type = section
		        displayname = "Completed By"
		        visibility = true
		        row = 2
		        column = 1
		    )
		
		    must have Completed_By_Name
		    (
		        type = text
		        displayname = "Completed By Name"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    must have Completed_By_Email
		    (
		        type = email
		        displayname = "Completed By Email"
		        personal data = true
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Response_Rows
		    (
		        type = section
		        displayname = "Questionnaire Responses"
		        visibility = false
		        row = 3
		        column = 1
		    )
		
		    Responses
		    (
		        type = grid
		        displayname = "Responses"
		        defaultrow = 0
		        maxrow = 500
		        Assessment_Response_ID
		        (
		            type = number
		            displayname = "Assessment Response ID"
		        )
		        Category_Snapshot
		        (
		            type = text
		            displayname = "Category"
		        )
		        Question_Text_Snapshot
		        (
		            type = textarea
		            displayname = "Question"
		            height = 120px
		        )
		        Answer_Type_Snapshot
		        (
		            type = picklist
		            displayname = "Answer Type"
		            values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
		        )
		        Option_Values_Snapshot
		        (
		            type = textarea
		            displayname = "Options"
		        )
		        Mandatory_Snapshot
		        (
		            type = checkbox
		            displayname = "Mandatory"
		        )
		        Single_Line_Answer
		        (
		            type = text
		            displayname = "Text Answer"
		            maxchar = 255
		        )
		        Paragraph_Answer
		        (
		            type = textarea
		            displayname = "Paragraph Answer"
		            height = 120px
		        )
		        Dropdown_Answer
		        (
		            type = picklist
		            displayname = "Dropdown Answer"
		            values = {"Not Applicable"}
		        )
		        Multi_Select_Answer
		        (
		            type = list
		            displayname = "Multi-Select Answer"
		            values = {"Not Applicable"}
		            height = 80px
		        )
		        Rating_Answer
		        (
		            type = number
		            displayname = "Rating Answer"
		        )
		        Yes_No_Answer
		        (
		            type = picklist
		            displayname = "Yes / No Answer"
		            values = {"Yes","No"}
		        )
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit_Assessment
		            (
		                type = submit
		                displayname = "Submit Assessment"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		    }
		}

		form Industry_Types
		{
		    displayname = "Industry Types"
		
		    Industry_Details
		    (
		        type = section
		        displayname = "Industry Details"
		        row = 1
		        column = 0
		    )
		
		    must have unique Industry_Name
		    (
		        type = text
		        displayname = "Industry Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    unique Industry_Code
		    (
		        type = text
		        displayname = "Industry Code"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
