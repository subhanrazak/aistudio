		            displayname = "Add New Customer"
		        ]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Assigned_Consultant
		    (
		        type = picklist
		        displayname = "Assigned Consultant"
		        module = users
		        displayformat = [name]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Customer_Contact_Email
		    (
		        type = email
		        displayname = "Customer Contact Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Project_Status
		    (
		        type = picklist
		        displayname = "Project Status"
		        values = {"Active","On Hold","Completed","Cancelled"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    End_Date
