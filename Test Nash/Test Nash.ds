		form Questions
		{
		    displayname = "Questions"
		
		    Question_Details
		    (
		        type = section
		        displayname = "Question Details"
		        row = 1
		        column = 0
		    )
		
		    must have Question_Text
		    (
		        type = textarea
		        displayname = "Question Text"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Industry_Type
		    (
		        type = picklist
		        displayname = "Industry Type"
		        values = Industry_Types[Active == true].ID
		        displayformat = [Industry_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Question_Categories[Active == true].ID
		        displayformat = [Category_Name]
		        allow new entries
		        [
		            displayname = "Add New Category"
		            set values
		            (
		                Industry_Type = input.Industry_Type
		            )
		        ]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Answer_Type
		    (
		        type = picklist
		        displayname = "Answer Type"
		        values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Option_Values
		    (
		        type = textarea
		        displayname = "Option Values"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		        description [ type = tooltip  message = "Use one option per line, or comma-separated values, for Dropdown and Multi-Select questions." ]
		    )
		
		    Mandatory
		    (
		        type = checkbox
		        displayname = "Mandatory"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Help_Text
		    (
		        type = textarea
		        displayname = "Help Text"
		        height = 80px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Assessment_Documents
		{
		    displayName = "All Assessment Documents"
		    show all rows from Assessment_Documents
		    (
		        Assessment
		        Document_Name
		        Document_Type
		        Document_File
		        Document_URL
		        Uploaded_By
		        Upload_Date
		        (
		            displayformat = dateonly
		        )
		        Version_Number
		        Source_Action
		    )
		    filters
		    (
		        Assessment
		        Document_Type
		        Uploaded_By
		        Upload_Date
		        Source_Action
		    )
		    sort by
		    (
		        Assessment ascending
		        Version_Number descending
		        Upload_Date descending
		    )
		}

		list Generated_Assessment_Reports
		{
		    displayName = "Generated Assessment Reports"
		    show all rows from Assessment_Documents [Document_Type == "Generated Report"]
		    (
		        Assessment
		        Document_Name
		        Document_Type
		        Document_File
		        Document_URL
		        Upload_Date
		        (
		            displayformat = dateonly
		        )
		        Version_Number
		        Source_Action
		    )
		    filters
		    (
		        Assessment
		        Upload_Date
		        Source_Action
		    )
		    sort by
		    (
		        Upload_Date descending
		    )
		}

		default list All_Assessment_Responses
		{
		    displayName = "All Assessment Responses"
		    show all rows from Assessment_Responses
		    (
		        Assessment
		        Category_Snapshot
		        Category_Display_Order
		        Question_Text_Snapshot
		        (
		            foldcontent = enable
		        )
		        Question_Display_Order
		        Answer_Type_Snapshot
		        Normalized_Answer
		        (
		            foldcontent = enable
		        )
		        Row_Status
		        Completed_Mode
		        Submitted_At
		        (
		            displayformat = dateonly
		        )
		    )
		    filters
		    (
		        Assessment
		        Category_Snapshot
		        Answer_Type_Snapshot
		        Row_Status
		        Completed_Mode
		        Submitted_At
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Assessment ascending
		        Category_Display_Order ascending
		    )
		    sort by
		    (
		        Assessment ascending
		        Category_Display_Order ascending
		        Question_Display_Order ascending
		    )
		}

		list Submitted_Responses
		{
		    displayName = "Submitted Responses"
		    show all rows from Assessment_Responses [Row_Status == "Submitted"]
		    (
		        Assessment
		        Category_Snapshot
		        Question_Text_Snapshot
		        (
		            foldcontent = enable
		        )
		        Normalized_Answer
		        (
		            foldcontent = enable
		        )
		        Completed_Mode
		        Submitted_At
		        (
		            displayformat = dateonly
		        )
		    )
		    filters
		    (
		        Assessment
		        Category_Snapshot
		        Completed_Mode
		        Submitted_At
		    )
		    sort by
		    (
		        Submitted_At descending
		    )
		}

		default list All_Assessment_Settings
		{
		    displayName = "All Assessment Settings"
		    show all rows from Assessment_Settings
		    (
		        Setting_Name
		        Default_Validity_Months
		        Reminder_Days_Before_Expiry
		        Notify_Customer_On_Expiry
		        Branding_Name
		        Active
		    )
		    filters
		    (
		        Active
		    )
		    sort by
		    (
		        Setting_Name ascending
		    )
		}

		default list All_Assessments
		{
		    displayName = "All Assessments"
		    show all rows from Assessments
		    (
		        Assessment_Reference
		        Project
		        Customer
		        Industry_Type
		        Assessment_Mode
		        Status
		        Assigned_Consultant
		        Submission_Date
		        (
		            displayformat = fulldate
		        )
		        Valid_Until
		        (
		            displayformat = fulldate
		        )
		        Customer_Contact_Email
		        Validity_Period_Months
		        Expiry_Reminder_Sent
		        Expired_Notification_Sent
		        Completed_By_Name
		        Completed_By_Email
		        Submission_Timestamp
		        (
		            displayformat = fulldate
		        )
		        Submission_Mode
		        Public_Link
		        Public_Link_Generated_On
		        (
		            displayformat = fulldate
		        )
		        Public_Link_Expires_On
		        (
		            displayformat = fulldate
		        )
		        Questions_Generated
		        Responses
		        Documents
		        custom action "Generate Public Link"
		        (
		            workflow = WF_Generate_Public_Link
		            show action for each record = true
		            column header = "Generate Public Link"
		            success message = "Public questionnaire link generated."
		            condition = (Assessment_Mode == "External" && Status != "Submitted" && Status != "Expired")
		        )
		        custom action "Submit Assessment"
		        (
		            workflow = WF_Submit_Assessment
		            show action for each record = true
		            column header = "Submit Assessment"
		            success message = "Assessment submitted."
		            condition = (Status == "Draft" || Status == "In Progress")
		            confirmation before execution
		            (
		                message for individual record = "Submit this assessment and generate the branded report?"
		                confirm button text = "Submit"
		                cancel button text = "Cancel"
		            )
		        )
		        custom action "Generate Report"
		        (
		            workflow = WF_Generate_Assessment_Report
		            show action for each record = true
		            show action in edit record menu = true
		            column header = "Generate Report"
		            success message = "Assessment report generated."
		            condition = (Status == "Submitted")
		        )
		        custom action "Start Reassessment"
		        (
		            workflow = WF_Start_Reassessment
		            show action for each record = true
		            column header = "Start Reassessment"
		            success message = "Draft reassessment created."
		            condition = (Status == "Expired")
		        )
		    )
		    filters
		    (
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Status
		        Assigned_Consultant
		        Submission_Date
		        Valid_Until
		    )
		    sort by
		    (
		        Assessment_Reference descending
		    )
		}

		list Assessment_Report_Print_View
		{
		    displayName = "Assessment Report Print View"
		    show all rows from Assessments [Status == "Submitted"]
		    (
		        Assessment_Reference
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Assigned_Consultant
		        Submission_Date
		        (
		            displayformat = fulldate
		        )
		        Valid_Until
		        (
		            displayformat = fulldate
		        )
		        Completed_By_Name
		        Completed_By_Email
		        Submission_Mode
		        Questions_Generated
		        Responses
		        Documents
		    )
		    filters
		    (
		        Customer
		        Project
		        Industry_Type
		        Assessment_Mode
		        Assigned_Consultant
		        Valid_Until
		    )
		    sort by
		    (
		        Assessment_Reference descending
		    )
		}

		list Assessments_By_Status
		{
		    displayName = "Assessments By Status"
		    show all rows from Assessments
		    (
		        Assessment_Reference
		        Project
		        Customer
		        Industry_Type
		        Assessment_Mode
		        Status
		        Assigned_Consultant
		        Valid_Until
		        (
		            displayformat = fulldate
		        )
		        Questions_Generated
		        Expiry_Reminder_Sent
		        Expired_Notification_Sent
		    )
		    filters
		    (
		        Status
		        Industry_Type
		        Assessment_Mode
		        Assigned_Consultant
		        Valid_Until
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Status ascending
		    )
		    sort by
		    (
		        Valid_Until ascending
		    )
		}

		list Expiring_Assessments
		{
		    displayName = "Expiring Assessments"
		    show all rows from Assessments [Status == "Submitted" && Valid_Until != null]
		    (
		        Assessment_Reference
		        Customer
		        Project
		        Industry_Type
		        Assigned_Consultant
		        Valid_Until
		        (
		            displayformat = fulldate
		        )
		        Customer_Contact_Email
		        Expiry_Reminder_Sent
		    )
		    filters
		    (
		        Customer
		        Industry_Type
		        Assigned_Consultant
		        Valid_Until
		    )
		    sort by
		    (
		        Valid_Until ascending
		    )
		    conditional formatting
		    (
		        "Expires Soon"
		        {
		            condition = (Valid_Until in next 15 days)
		            fields = [Assessment_Reference, Customer, Project, Valid_Until]
		            format = "background-color:#fff4cc;color:#7a4b00"
		        }
		    )
		}

		default list All_Customers
		{
		    displayName = "All Customers"
		    show all rows from Customers
		    (
		        Customer_Name
		        Primary_Contact_Name
		        Primary_Contact_Email
		        Primary_Contact_Phone
		        (
		            displayformat = formattednumber
		            linktodial = enable
		        )
		        Customer_Status
		    )
		    filters
		    (
		        Customer_Status
		    )
		    sort by
		    (
		        Customer_Name ascending
		    )
		    conditional formatting
		    (
		        "Highlight Inactive"
		        {
		            condition = (Customer_Status == "Inactive")
		            fields = [Customer_Name, Primary_Contact_Name, Primary_Contact_Email, Customer_Status]
		            format = "background-color:#FFF3E0;color:#8A4B08"
		        }
		    )
		}

		default list All_Industry_Types
		{
		    displayName = "All Industry Types"
		    show all rows from Industry_Types
		    (
		        Industry_Name
		        Industry_Code
		        Display_Order
		        Active
		    )
		    filters
		    (
		        Active
		    )
		    sort by
		    (
		        Display_Order ascending
		        Industry_Name ascending
		    )
		    conditional formatting
		    (
		        "Highlight Inactive"
		        {
		            condition = (Active == false)
		            fields = [Industry_Name, Industry_Code, Display_Order, Active]
		            format = "background-color:#ECEFF1;color:#546E7A"
		        }
		    )
		}

		default list All_Projects
		{
		    displayName = "All Projects"
		    show all rows from Projects
		    (
		        Project_Name
		        Project_Code
		        Customer
		        Assigned_Consultant
		        Customer_Contact_Email
		        Project_Status
		        Start_Date
		        (
		            displayformat = fulldate
		        )
		        End_Date
		        (
		            displayformat = fulldate
		        )
		    )
		    filters
		    (
		        Customer
		        Project_Status
		        Assigned_Consultant
		        Start_Date
		    )
		    sort by
		    (
		        Project_Name ascending
		    )
		    conditional formatting
		    (
		        "Highlight On Hold"
		        {
		            condition = (Project_Status == "On Hold")
		            fields = [Project_Name, Project_Code, Customer, Project_Status]
		            format = "background-color:#FFF8E1;color:#7A4F00"
		        }
		        "Highlight Cancelled"
		        {
		            condition = (Project_Status == "Cancelled")
		            fields = [Project_Name, Project_Code, Customer, Project_Status]
		            format = "background-color:#FFEBEE;color:#B71C1C"
		        }
		    )
		}

		default list All_Question_Categories
		{
		    displayName = "All Question Categories"
		    show all rows from Question_Categories
		    (
		        Category_Name
		        Industry_Type
		        Display_Order
		        Active
		        Description
		        (
		            foldcontent = enable
		        )
		    )
		    filters
		    (
		        Industry_Type
		        Active
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Industry_Type ascending
		    )
		    sort by
		    (
		        Display_Order ascending
		        Category_Name ascending
		    )
		    conditional formatting
		    (
		        "Highlight Inactive"
		        {
		            condition = (Active == false)
		            fields = [Category_Name, Industry_Type, Display_Order, Active]
		            format = "background-color:#ECEFF1;color:#546E7A"
		        }
		    )
		}

		list Active_Questions_By_Industry
		{
		    displayName = "Active Questions By Industry"
		    show all rows from Questions [Active == true]
		    (
		        Question_Text
		        (
		            foldcontent = enable
		        )
		        Industry_Type
		        Category
		        Answer_Type
		        Mandatory
		        Display_Order
		        Active
		    )
		    filters
		    (
		        Industry_Type
		        Category
		        Answer_Type
		        Mandatory
		    )
		    sort by
		    (
		        Industry_Type ascending
		        Category ascending
		        Display_Order ascending
		    )
		}

		default list All_Questions
		{
		    displayName = "All Questions"
		    show all rows from Questions
		    (
		        Question_Text
		        (
		            foldcontent = enable
		        )
		        Industry_Type
		        Category
		        Answer_Type
		        Mandatory
		        Display_Order
		        Active
		    )
		    filters
		    (
		        Industry_Type
		        Category
		        Answer_Type
		        Mandatory
		        Active
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Industry_Type ascending
		        Category ascending
		    )
		    sort by
		    (
		        Display_Order ascending
		    )
		    conditional formatting
		    (
		        "Highlight Inactive"
		        {
		            condition = (Active == false)
		            fields = [Question_Text, Industry_Type, Category, Active]
		            format = "background-color:#ECEFF1;color:#546E7A"
		        }
		        "Highlight Mandatory"
		        {
		            condition = (Mandatory == true)
		            fields = [Question_Text, Mandatory]
		            format = "background-color:#E3F2FD;color:#0E7C86;font-weight:bold"
		        }
		    )
		}
	}

	pages
	{
		page Assessment_Dashboard
		{
					displayname = "Assessment Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Dashboard_Summary' elementName='Dashboard_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Dashboard_Summary()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttotalAssessments = Assessments[ID != 0].count();\n\tdraftCount = Assessments[Status == &quot;Draft&quot;].count();\n\tinProgressCount = Assessments[Status == &quot;In Progress&quot;].count();\n\tsubmittedCount = Assessments[Status == &quot;Submitted&quot;].count();\n\texpiredStatusCount = Assessments[Status == &quot;Expired&quot;].count();\n\n\texpiringSoonCount = Assessments[Status == &quot;Submitted&quot; &amp;&amp; Valid_Until != null &amp;&amp; Valid_Until &gt;= zoho.currentdate &amp;&amp; Valid_Until &lt;= zoho.currentdate.addDay(15)].count();\n\talreadyExpiredCount = Assessments[(Status == &quot;Expired&quot;) || (Valid_Until != null &amp;&amp; Valid_Until &lt; zoho.currentdate)].count();\n\n\tif(totalAssessments &gt; 0)\n\t{\n\t\tdraftPct = (draftCount * 100) / totalAssessments;\n\t\tinProgressPct = (inProgressCount * 100) / totalAssessments;\n\t\tsubmittedPct = (submittedCount * 100) / totalAssessments;\n\t\texpiredPct = (expiredStatusCount * 100) / totalAssessments;\n\t}\n\telse\n\t{\n\t\tdraftPct = 0;\n\t\tinProgressPct = 0;\n\t\tsubmittedPct = 0;\n\t\texpiredPct = 0;\n\t}\n%&gt;\n&lt;style&gt;\n/* zcs-global utility stylesheet included once for this page: minimal utility set used by fetched ZCS components */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-page-bg-color: #F3F3F4; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n.zcs-row, .zcs-flex { display: flex; flex-wrap: wrap; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-nowrap { flex-wrap: nowrap; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-col-auto { flex: 0 0 auto; width: auto; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-overflow-hidden { overflow: hidden; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-cursor-pointer { cursor: pointer; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-40 { font-size: 2.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-m-0 { margin: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-rounded-half { border-radius: 50%; }\na { text-decoration: none; color: inherit; }\n\n/* ZCS table-simple-table */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr.zcs-tnodata:hover td { background-color: transparent; }\n.zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-blue { color: #09598e; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; }\n\n/* ZCS badge-filled-badge */\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n\n/* ZCS progress-bar-range-bar-with-texts */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n\n/* ZCS quick-actions-card-type-quick-actions */\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }\n\n/* ZCS timeline-without-time */\n.zcs-timeline-wrapper ul { list-style-type: none; }\n.zcs-tl-indicator { width: 44px; left: 0; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 20px); background-color: #E1E1E1; top: 5px; }\n\n/* Dashboard-specific layout built from ZCS components */\n.assess-dashboard { background: var(--zcs-page-bg-color); box-sizing: border-box; width: 100%; padding: 20px; color: var(--zcs_primary_text_color); }\n.assess-hero { background: linear-gradient(135deg, var(--zcs_brand_color), var(--zcs_brand_dark_color)); border-radius: 18px; padding: 24px; color: #fff; overflow: hidden; position: relative; }\n.assess-hero:after { content: &apos;&apos;; position: absolute; right: -80px; top: -110px; width: 260px; height: 260px; border-radius: 50%; border: 36px solid rgba(255,255,255,0.12); }\n.assess-hero &gt; * { position: relative; z-index: 1; }\n.assess-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(160px, 1fr)); gap: 16px; margin-top: 16px; }\n.assess-two-col { display: grid; grid-template-columns: minmax(280px, 0.9fr) minmax(420px, 1.4fr); gap: 16px; margin-top: 16px; }\n.assess-visual-grid { display: grid; grid-template-columns: minmax(280px, 0.85fr) minmax(340px, 1.15fr); gap: 16px; }\n.assess-card-title { display: flex; align-items: center; gap: 8px; color: var(--zcs_secondary_text_color); }\n.assess-icon-box { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs_brand_light_color); color: var(--zcs_brand_color); }\n.assess-kpi-card { min-height: 120px; }\n.assess-kpi-value { font-size: 34px; line-height: 1; margin-top: 12px; }\n.assess-focus-card { border-left: 4px solid var(--focus-color); }\n.assess-status-stack { display: flex; width: 100%; height: 18px; overflow: hidden; border-radius: 999px; background: var(--zcs_component_hover_color); }\n.assess-stack-seg { min-width: 0; }\n.assess-legend-grid { display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 12px; margin-top: 16px; }\n.assess-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n.assess-industry-list { max-height: 270px; overflow: auto; padding-right: 4px; }\n.assess-empty { border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 10px; padding: 20px; text-align: center; color: var(--zcs_secondary_text_color); background: #fff; }\n.assess-quick-grid { display: grid; grid-template-columns: repeat(4, minmax(170px, 1fr)); gap: 12px; margin-top: 16px; }\n.assess-quick-actions-wrapper { margin-top: 16px; }\n.assess-page-section { background: var(--zcs-page-bg-color); padding: 0 20px 20px; box-sizing: border-box; }\n@media (max-width: 1100px) { .assess-kpi-grid, .assess-quick-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); } .assess-two-col, .assess-visual-grid { grid-template-columns: 1fr; } }\n@media (max-width: 640px) { .assess-dashboard { padding: 12px; } .assess-kpi-grid, .assess-quick-grid, .assess-legend-grid { grid-template-columns: 1fr; } }\n&lt;/style&gt;\n\n&lt;div class=&apos;assess-dashboard&apos;&gt;\n\t&lt;div class=&apos;assess-hero zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t&lt;h1 class=&apos;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-white&apos;&gt;Assessment Dashboard&lt;/h1&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0 zcs-color-white&apos;&gt;Monitor assessment volume, lifecycle status, expiry exposure, submissions, and generated document activity.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-text-right&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-white&apos;&gt;Total assessments&lt;/span&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-40 zcs-font-bold zcs-lh-heading zcs-color-white&apos;&gt;&lt;%=totalAssessments%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;assess-kpi-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card assess-kpi-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;assess-card-title zcs-font-14 zcs-font-medium&apos;&gt;&lt;span&gt;Draft&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;assess-icon-box&apos;&gt;&lt;i class=&apos;zc-li-outline files-1-single-content-03 zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;assess-kpi-value zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=draftCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=draftPct%&gt;%; background-color:#FAAE13;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card assess-kpi-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;assess-card-title zcs-font-14 zcs-font-medium&apos;&gt;&lt;span&gt;In Progress&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;assess-icon-box&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;assess-kpi-value zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=inProgressCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=inProgressPct%&gt;%; background-color:#2A6FFC;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card assess-kpi-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;assess-card-title zcs-font-14 zcs-font-medium&apos;&gt;&lt;span&gt;Submitted&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;assess-icon-box&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;assess-kpi-value zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=submittedPct%&gt;%; background-color:#179E6C;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card assess-kpi-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t&lt;div class=&apos;assess-card-title zcs-font-14 zcs-font-medium&apos;&gt;&lt;span&gt;Expired&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;assess-icon-box&apos;&gt;&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;assess-kpi-value zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=expiredStatusCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-mt-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=expiredPct%&gt;%; background-color:#FE455D;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;assess-two-col&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card assess-focus-card zcs-p-20 zcs-box-border&apos; style=&apos;--focus-color:#FAAE13;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Expiring in next 15 days&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-mt-4 zcs-mb-0 zcs-color-secondary&apos;&gt;Submitted assessments with Valid Until date within the next 15 days.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;strong class=&apos;zcs-font-40 zcs-font-bold zcs-lh-heading&apos; style=&apos;color:#b8770d;&apos;&gt;&lt;%=expiringSoonCount%&gt;&lt;/strong&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-card assess-focus-card zcs-p-20 zcs-box-border&apos; style=&apos;--focus-color:#FE455D;&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center&apos;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Already expired&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-mt-4 zcs-mb-0 zcs-color-secondary&apos;&gt;Assessments marked Expired or past their Valid Until date.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;strong class=&apos;zcs-font-40 zcs-font-bold zcs-lh-heading&apos; style=&apos;color:#FE455D;&apos;&gt;&lt;%=alreadyExpiredCount%&gt;&lt;/strong&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;assess-visual-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Status distribution&lt;/h3&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=totalAssessments%&gt; total&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;assess-status-stack zcs-mt-8&apos; title=&apos;Assessment status distribution&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;assess-stack-seg&apos; style=&apos;width:&lt;%=draftPct%&gt;%; background:#FAAE13;&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&apos;assess-stack-seg&apos; style=&apos;width:&lt;%=inProgressPct%&gt;%; background:#2A6FFC;&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&apos;assess-stack-seg&apos; style=&apos;width:&lt;%=submittedPct%&gt;%; background:#179E6C;&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&apos;assess-stack-seg&apos; style=&apos;width:&lt;%=expiredPct%&gt;%; background:#FE455D;&apos;&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;assess-legend-grid&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos;&gt;&lt;span class=&apos;assess-dot&apos; style=&apos;background:#FAAE13;&apos;&gt;&lt;/span&gt;&lt;span&gt;Draft&lt;/span&gt;&lt;strong&gt;&lt;%=draftCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos;&gt;&lt;span class=&apos;assess-dot&apos; style=&apos;background:#2A6FFC;&apos;&gt;&lt;/span&gt;&lt;span&gt;In Progress&lt;/span&gt;&lt;strong&gt;&lt;%=inProgressCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos;&gt;&lt;span class=&apos;assess-dot&apos; style=&apos;background:#179E6C;&apos;&gt;&lt;/span&gt;&lt;span&gt;Submitted&lt;/span&gt;&lt;strong&gt;&lt;%=submittedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&apos;&gt;&lt;span class=&apos;assess-dot&apos; style=&apos;background:#FE455D;&apos;&gt;&lt;/span&gt;&lt;span&gt;Expired&lt;/span&gt;&lt;strong&gt;&lt;%=expiredStatusCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Industry distribution&lt;/h3&gt;\n\t\t\t\t&lt;div class=&apos;assess-industry-list zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-8&apos;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tindustryRendered = 0;\n\t\t\t\t\t\tfor each industryRow in Industry_Types[Active == true] sort by Display_Order asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tindustryCount = Assessments[Industry_Type == industryRow.ID].count();\n\t\t\t\t\t\t\tif(industryCount &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(totalAssessments &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tindustryPct = (industryCount * 100) / totalAssessments;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tindustryPct = 0;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tindustryRendered = industryRendered + 1;\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-13 zcs-font-medium zcs-lh-body zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-color-primary&apos;&gt;&lt;%=industryRow.Industry_Name%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-color-secondary&apos;&gt;&lt;%=industryCount%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-progress-bar zcs-rounded-sm&apos;&gt;&lt;div class=&apos;zcs-progress-bar-indicator&apos; style=&apos;width:&lt;%=industryPct%&gt;%;&apos;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(industryRendered == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&apos;assess-empty zcs-font-14&apos;&gt;No assessment volume by industry yet.&lt;/div&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;assess-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Quick actions&lt;/h3&gt;\n\t\t&lt;ul class=&apos;assess-quick-grid zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Assessments&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline design-bullet-list-67&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;All Assessments&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:Expiring_Assessments&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Expiring Assessments&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Questions&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline education-paper-diploma&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;All Questions&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-12 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Report:All_Assessment_Documents&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;All Assessment Documents&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Recent_Submissions' elementName='Recent_Submissions'>\n\t\t\t\t\t<![CDATA[htmlpage Recent_Submissions()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;assess-page-section&apos;&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Recent submissions&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-mt-4 zcs-mb-0 zcs-color-secondary&apos;&gt;Latest submitted assessments by customer, project, industry, and validity window.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos; href=&apos;#Report:All_Assessments&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;View all&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-8&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Assessment Reference&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Project&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Industry Type&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Submission Date&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Valid Until&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-8 zcs-box-border&apos; colspan=&apos;6&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\trecentSubmitted = Assessments[Status == &quot;Submitted&quot;] sort by Submission_Date desc;\n\t\t\t\t\t\trenderedRows = 0;\n\t\t\t\t\t\tif(recentSubmitted.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor each submissionRow in recentSubmitted\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(renderedRows &lt; 8)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\trenderedRows = renderedRows + 1;\n\t\t\t\t\t\t\t\t\tsubmissionDateText = &quot;-&quot;;\n\t\t\t\t\t\t\t\t\tvalidUntilText = &quot;-&quot;;\n\t\t\t\t\t\t\t\t\tif(submissionRow.Submission_Date != null)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tsubmissionDateText = submissionRow.Submission_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tif(submissionRow.Valid_Until != null)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tvalidUntilText = submissionRow.Valid_Until.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=submissionRow.Assessment_Reference%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=submissionRow.Customer.Customer_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=submissionRow.Project.Project_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=submissionRow.Industry_Type.Industry_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=submissionDateText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=validUntilText%&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(renderedRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tnodata&apos;&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&apos; colspan=&apos;6&apos;&gt;No submitted assessments found.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Document_Activity' elementName='Document_Activity'>\n\t\t\t\t\t<![CDATA[htmlpage Document_Activity()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;assess-page-section&apos;&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h2 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-m-0 zcs-color-primary&apos;&gt;Document activity&lt;/h2&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-mt-4 zcs-mb-0 zcs-color-secondary&apos;&gt;Latest generated reports and supporting document uploads from Assessment Documents.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos; href=&apos;#Report:All_Assessment_Documents&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;View documents&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;zcs-timeline-wrapper zcs-without-time zcs-mt-8&apos;&gt;\n\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\tactivityRows = Assessment_Documents[Document_Type == &quot;Generated Report&quot; || Document_Type == &quot;Supporting&quot;] sort by Upload_Date desc;\n\t\t\t\t\trenderedActivity = 0;\n\t\t\t\t\tif(activityRows.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tfor each activityRow in activityRows\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(renderedActivity &lt; 10)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trenderedActivity = renderedActivity + 1;\n\t\t\t\t\t\t\t\tactivityDateText = &quot;-&quot;;\n\t\t\t\t\t\t\t\tif(activityRow.Upload_Date != null)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tactivityDateText = activityRow.Upload_Date.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tdocBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tdocIcon = &quot;files-2-doc&quot;;\n\t\t\t\t\t\t\t\tif(activityRow.Document_Type == &quot;Generated Report&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tdocBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\tdocIcon = &quot;files-2-paper-diploma&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-4 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-common zcs-px-60 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-col-common&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=docIcon%&gt;&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t&lt;%=activityRow.Document_Name%&gt;\n\t\t\t\t\t\t\t\t&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t\tAssessment: &lt;%=activityRow.Assessment.Assessment_Reference%&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t\tUploaded on &lt;%=activityDateText%&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=docBadgeClass%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=activityRow.Document_Type%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(renderedActivity == 0)\n\t\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-tl-dot zcs-rounded-half zcs-mt-4 zcs-box-border zcs-relative&apos;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-common zcs-px-60 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;h3 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;No document activity yet&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mb-0&apos;&gt;Generated reports and supporting uploads will appear here.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/ul&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Assessment_Documents_On_Load as "Assessment Documents On Load"
			{
			    type = form
			    form = Assessment_Documents
			    record event = on add or edit
			    description = "Defaults document metadata for manual uploads."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Document_Type in {"", " ", "null", null})
			                {
			                    input.Document_Type = "Supporting";
			                }
			                if(input.Source_Action in {"", " ", "null", null})
			                {
			                    input.Source_Action = "Manual Upload";
			                }
			                if(input.Upload_Date == null)
			                {
			                    input.Upload_Date = zoho.currenttime;
			                }
			                if(input.Uploaded_By == null)
			                {
			                    input.Uploaded_By = zoho.loginuser;
			                }
			            )
			        }
			    }
			}

			Assessment_Documents_On_Success as "Assessment Documents On Success"
			{
			    type = form
			    form = Assessment_Documents
			    record event = on add or edit
			    description = "Completes upload metadata and version defaults."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Upload_Date == null)
			                {
			                    input.Upload_Date = zoho.currenttime;
			                }
			                if(input.Uploaded_By == null)
			                {
			                    input.Uploaded_By = zoho.loginuser;
			                }
			                if(input.Version_Number == null)
			                {
			                    maxVersion = 0;
			                    documentRows = Assessment_Documents[Assessment == input.Assessment && Document_Type == input.Document_Type && ID != input.ID];
			                    for each documentRow in documentRows
			                    {
			                        if(ifnull(documentRow.Version_Number,0) > maxVersion)
			                        {
			                            maxVersion = documentRow.Version_Number;
			                        }
			                    }
			                    input.Version_Number = maxVersion + 1;
			                }
			            )
			        }
			    }
			}

			Assessment_Documents_On_Validate as "Assessment Documents On Validate"
			{
			    type = form
			    form = Assessment_Documents
			    record event = on add or edit
			    description = "Requires a stored file or preview URL and validates version number."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Document_File == null && ifnull(input.Document_URL,"").trim() == "")
			                {
			                    alert "Please upload a file or provide a document URL.";
			                    cancel submit;
			                }
			                if(ifnull(input.Version_Number,0) < 1)
			                {
			                    alert "Version number must be at least 1.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Answer_Type_Snapshot_On_User_Input as "Answer Type Snapshot On User Input"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			    description = "Re-applies answer field visibility when the answer type snapshot is changed by an administrator."
			
			    on user input of Answer_Type_Snapshot
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Single_Line_Answer, Paragraph_Answer, Dropdown_Answer, Multi_Select_Answer, Rating_Answer, Yes_No_Answer;
			                if(input.Answer_Type_Snapshot == "Single-Line Text")
			                {
			                    show Single_Line_Answer;
			                    enable Single_Line_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Paragraph")
			                {
			                    show Paragraph_Answer;
			                    enable Paragraph_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Dropdown")
			                {
			                    show Dropdown_Answer;
			                    enable Dropdown_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Multi-Select")
			                {
			                    show Multi_Select_Answer;
			                    enable Multi_Select_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Rating/Scale")
			                {
			                    show Rating_Answer;
			                    enable Rating_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Yes-No")
			                {
			                    show Yes_No_Answer;
			                    enable Yes_No_Answer;
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Load as "Assessment Responses On Load"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			    description = "Shows only the answer control matching the snapshotted answer type."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Assessment, Question_Bank_Question, Category_Snapshot, Category_Display_Order, Question_Text_Snapshot, Question_Display_Order, Industry_Type_Snapshot, Answer_Type_Snapshot, Option_Values_Snapshot, Mandatory_Snapshot, Normalized_Answer, Completed_Mode, Submitted_At, Row_Status;
			                hide Single_Line_Answer, Paragraph_Answer, Dropdown_Answer, Multi_Select_Answer, Rating_Answer, Yes_No_Answer;
			                if(input.Answer_Type_Snapshot == "Single-Line Text")
			                {
			                    show Single_Line_Answer;
			                    enable Single_Line_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Paragraph")
			                {
			                    show Paragraph_Answer;
			                    enable Paragraph_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Dropdown")
			                {
			                    show Dropdown_Answer;
			                    enable Dropdown_Answer;
			                    if(ifnull(input.Option_Values_Snapshot,"").trim() != "")
			                    {
			                        optionList = input.Option_Values_Snapshot.replaceAll("\n",",").toList(",");
			                        input.Dropdown_Answer:ui.add(optionList);
			                    }
			                }
			                else if(input.Answer_Type_Snapshot == "Multi-Select")
			                {
			                    show Multi_Select_Answer;
			                    enable Multi_Select_Answer;
			                    if(ifnull(input.Option_Values_Snapshot,"").trim() != "")
			                    {
			                        multiOptionList = input.Option_Values_Snapshot.replaceAll("\n",",").toList(",");
			                        input.Multi_Select_Answer:ui.add(multiOptionList);
			                    }
			                }
			                else if(input.Answer_Type_Snapshot == "Rating/Scale")
			                {
			                    show Rating_Answer;
			                    enable Rating_Answer;
			                }
			                else if(input.Answer_Type_Snapshot == "Yes-No")
			                {
			                    show Yes_No_Answer;
			                    enable Yes_No_Answer;
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Success as "Assessment Responses On Success"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			    description = "Stores a normalized answer for reporting and document templates."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                normalized = "";
			                if(input.Answer_Type_Snapshot == "Single-Line Text")
			                {
			                    normalized = ifnull(input.Single_Line_Answer,"");
			                }
			                else if(input.Answer_Type_Snapshot == "Paragraph")
			                {
			                    normalized = ifnull(input.Paragraph_Answer,"");
			                }
			                else if(input.Answer_Type_Snapshot == "Dropdown")
			                {
			                    normalized = ifnull(input.Dropdown_Answer,"");
			                }
			                else if(input.Answer_Type_Snapshot == "Multi-Select")
			                {
			                    normalized = input.Multi_Select_Answer.toString();
			                }
			                else if(input.Answer_Type_Snapshot == "Rating/Scale")
			                {
			                    if(input.Rating_Answer != null)
			                    {
			                        normalized = input.Rating_Answer.toString();
			                    }
			                }
			                else if(input.Answer_Type_Snapshot == "Yes-No")
			                {
			                    normalized = ifnull(input.Yes_No_Answer,"");
			                }
			                input.Normalized_Answer = normalized;
			                if(ifnull(normalized,"").trim() != "" && normalized != "Not Applicable")
			                {
			                    if(input.Row_Status != "Submitted")
			                    {
			                        input.Row_Status = "Answered";
			                    }
			                }
			                else
			                {
			                    if(input.Row_Status != "Submitted")
			                    {
			                        input.Row_Status = "Draft";
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Responses_On_Validate as "Assessment Responses On Validate"
			{
			    type = form
			    form = Assessment_Responses
			    record event = on add or edit
			    description = "Validates mandatory answers and rating ranges."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Answer_Type_Snapshot == "Rating/Scale" && input.Rating_Answer != null && (input.Rating_Answer < 1 || input.Rating_Answer > 5))
			                {
			                    alert "Rating answers must be between 1 and 5.";
			                    cancel submit;
			                }
			                if(input.Mandatory_Snapshot == true)
			                {
			                    missingAnswer = false;
			                    if(input.Answer_Type_Snapshot == "Single-Line Text" && ifnull(input.Single_Line_Answer,"").trim() == "")
			                    {
			                        missingAnswer = true;
			                    }
			                    else if(input.Answer_Type_Snapshot == "Paragraph" && ifnull(input.Paragraph_Answer,"").trim() == "")
			                    {
			                        missingAnswer = true;
			                    }
			                    else if(input.Answer_Type_Snapshot == "Dropdown" && input.Dropdown_Answer in {"", " ", "null", null, "Not Applicable"})
			                    {
			                        missingAnswer = true;
			                    }
			                    else if(input.Answer_Type_Snapshot == "Multi-Select" && input.Multi_Select_Answer.isEmpty())
			                    {
			                        missingAnswer = true;
			                    }
			                    else if(input.Answer_Type_Snapshot == "Rating/Scale" && input.Rating_Answer == null)
			                    {
			                        missingAnswer = true;
			                    }
			                    else if(input.Answer_Type_Snapshot == "Yes-No" && input.Yes_No_Answer in {"", " ", "null", null})
			                    {
			                        missingAnswer = true;
			                    }
			                    if(missingAnswer == true)
			                    {
			                        alert "This question is mandatory. Please provide an answer.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Settings_On_Success as "Assessment Settings On Success"
			{
			    type = form
			    form = Assessment_Settings
			    record event = on add or edit
			    description = "Ensures only one active settings row is used for new assessments."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Active == true)
			                {
			                    otherSettings = Assessment_Settings[ID != input.ID && Active == true];
			                    if(otherSettings.count() > 0)
			                    {
			                        for each settingRow in otherSettings
			                        {
			                            settingRow.Active = false;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Assessment_Settings_On_Validate as "Assessment Settings On Validate"
			{
			    type = form
			    form = Assessment_Settings
			    record event = on add or edit
			    description = "Validates assessment defaults."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Default_Validity_Months,0) <= 0)
			                {
			                    alert "Default validity months must be greater than zero.";
			                    cancel submit;
			                }
			                if(ifnull(input.Reminder_Days_Before_Expiry,0) < 0)
			                {
			                    alert "Reminder days before expiry cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Assessment_Mode_On_User_Input as "Assessment Mode On User Input"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Shows external link metadata only when the assessment is customer-facing."
			
			    on user input of Assessment_Mode
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Assessment_Mode == "External")
			                {
			                    show Public_Link, Public_Link_Generated_On, Public_Link_Expires_On;
			                }
			                else
			                {
			                    hide Public_Link, Public_Link_Generated_On, Public_Link_Expires_On;
			                    input.Public_Link = "";
			                    input.Public_Link_Generated_On = null;
			                    input.Public_Link_Expires_On = null;
			                }
			            )
			        }
			    }
			}

			Assessments_On_Load as "Assessments On Load"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Defaults settings and controls public-link visibility on the assessment form."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Validity_Period_Months == null || input.Validity_Period_Months <= 0)
			                {
			                    activeSettings = Assessment_Settings[Active == true];
			                    if(activeSettings.count() > 0)
			                    {
			                        input.Validity_Period_Months = activeSettings.Default_Validity_Months;
			                    }
			                    else
			                    {
			                        input.Validity_Period_Months = 3;
			                    }
			                }
			                if(input.Assigned_Consultant == null)
			                {
			                    input.Assigned_Consultant = zoho.loginuser;
			                }
			                disable Assessment_Reference, Submission_Date, Valid_Until, Expiry_Reminder_Sent, Expired_Notification_Sent, Submission_Timestamp, Submission_Mode, Public_Token, Public_Link_Generated_On, Public_Link_Expires_On, Questions_Generated;
			                hide Public_Token;
			                if(input.Assessment_Mode == "External")
			                {
			                    show Public_Link, Public_Link_Generated_On, Public_Link_Expires_On;
			                }
			                else
			                {
			                    hide Public_Link, Public_Link_Generated_On, Public_Link_Expires_On;
			                }
			                if(input.Status == "Expired")
			                {
			                    disable Project, Customer, Customer_Contact_Email, Industry_Type, Assigned_Consultant, Assessment_Mode, Status, Validity_Period_Months, Completed_By_Name, Completed_By_Email;
			                }
			            )
			        }
			    }
			}

			Assessments_On_Success as "Assessments On Success"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Creates assessment references, snapshots questions, and routes manual submissions through the central submit routine."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Assessment_Reference,"").trim() == "")
			                {
			                    seqText = input.Assessment_Sequence.toString();
			                    paddedSeq = seqText;
			                    if(seqText.length() == 1)
			                    {
			                        paddedSeq = "000" + seqText;
			                    }
			                    else if(seqText.length() == 2)
			                    {
			                        paddedSeq = "00" + seqText;
			                    }
			                    else if(seqText.length() == 3)
			                    {
			                        paddedSeq = "0" + seqText;
			                    }
			                    assessmentToNumber = Assessments[ID == input.ID];
			                    assessmentToNumber.Assessment_Reference = "CSA-" + zoho.currentdate.getYear().toString() + "-" + paddedSeq;
			                }
			                if(input.Status in {"Draft","In Progress"} && input.Questions_Generated == false)
			                {
			                    thisapp.Generate_Assessment_Responses(input.ID);
			                }
			                if(input.Status == "Submitted" && input.Submission_Timestamp == null)
			                {
			                    thisapp.Submit_Assessment(input.ID, input.Completed_By_Name, input.Completed_By_Email, input.Assessment_Mode);
			                }
			            )
			        }
			    }
			}

			Assessments_On_Validate as "Assessments On Validate"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Validates assessment status changes and mandatory response completion."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Project == null || input.Customer == null || input.Industry_Type == null)
			                {
			                    alert "Project, customer, and industry type are required.";
			                    cancel submit;
			                }
			                if(ifnull(input.Validity_Period_Months,0) <= 0)
			                {
			                    alert "Validity period must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Status == "Expired")
			                {
			                    alert "Expired assessments are locked. Use Start Reassessment to create a fresh cycle.";
			                    cancel submit;
			                }
			                if(input.Status == "Submitted")
			                {
			                    responseRows = Assessment_Responses[Assessment == input.ID];
			                    if(responseRows.count() == 0)
			                    {
			                        alert "Generate and answer assessment questions before submitting.";
			                        cancel submit;
			                    }
			                    for each responseRow in Assessment_Responses[Assessment == input.ID && Mandatory_Snapshot == true]
			                    {
			                        if(ifnull(responseRow.Normalized_Answer,"").trim() == "" || responseRow.Normalized_Answer == "Not Applicable")
			                        {
			                            alert "Mandatory response is unanswered: " + responseRow.Question_Text_Snapshot;
			                            cancel submit;
			                            break;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Assessments_Industry_Type_On_User_Input as "Assessment Industry Type On User Input"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Warns users that the selected industry drives question snapshot generation."
			
			    on user input of Industry_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Questions_Generated == true && input.Status == "Draft")
			                {
			                    alert "Changing the industry on a draft assessment will rebuild draft response rows from the active question bank after save.";
			                }
			                else if(input.Questions_Generated == true && input.Status == "Submitted")
			                {
			                    alert "Submitted assessments keep historical question snapshots and cannot change industry.";
			                }
			            )
			        }
			    }
			}

			Project_On_User_Input as "Project On User Input"
			{
			    type = form
			    form = Assessments
			    record event = on add or edit
			    description = "Copies customer, contact, and consultant defaults from the selected project."
			
			    on user input of Project
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Project != null)
			                {
			                    projectRow = Projects[ID == input.Project];
			                    if(projectRow.count() > 0)
			                    {
			                        input.Customer = projectRow.Customer;
			                        input.Customer_Contact_Email = projectRow.Customer_Contact_Email;
			                        if(projectRow.Assigned_Consultant != null)
			                        {
