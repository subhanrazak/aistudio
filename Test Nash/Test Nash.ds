			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Customers_On_Validate as "Customers On Validate"
			{
			    type = form
			    form = Customers
			    record event = on add or edit
			    description = "Defensively validates primary contact email whitespace and format."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Primary_Contact_Email,"").trim() != "")
			                {
			                    emailValue = input.Primary_Contact_Email.trim().toLowerCase();
			                    if(emailValue.matches("[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?") == false)
			                    {
			                        alert "Please enter a valid primary contact email address.";
			                        cancel submit;
			                    }
			                    input.Primary_Contact_Email = emailValue;
			                }
			            )
			        }
			    }
			}

			External_Assessment_On_Load as "External Assessment On Load"
			{
			    type = form
			    form = External_Assessment_Submission
			    record event = on add
			    description = "Loads the assessment questionnaire for a valid public token without exposing internal data."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Assessment_ID, Assessment_Reference, Project_Name, Customer_Name, Industry_Name;
			                hide Token, Assessment_ID;
			                input.Responses.clear();
			                tokenValue = input.Token;
			                if(ifnull(tokenValue,"").trim() == "")
			                {
			                    alert "This questionnaire link is missing its access token. Please ask your Kannanware consultant for a fresh link.";
			                }
			                else
			                {
			                    assessmentRow = Assessments[Public_Token == tokenValue && Assessment_Mode == "External" && Status != "Submitted" && Status != "Expired"];
			                    if(assessmentRow.count() == 0)
			                    {
			                        alert "This questionnaire link is invalid, expired, or already submitted.";
			                    }
			                    else if(assessmentRow.Public_Link_Expires_On != null && assessmentRow.Public_Link_Expires_On < zoho.currentdate)
			                    {
			                        alert "This questionnaire link has expired. Please ask your Kannanware consultant for a fresh link.";
			                    }
			                    else
			                    {
			                        thisapp.Generate_Assessment_Responses(assessmentRow.ID);
			                        input.Assessment_ID = assessmentRow.ID;
			                        input.Assessment_Reference = assessmentRow.Assessment_Reference;
			                        input.Project_Name = assessmentRow.Project.Project_Name;
			                        input.Customer_Name = assessmentRow.Customer.Customer_Name;
			                        input.Industry_Name = assessmentRow.Industry_Type.Industry_Name;
			                        responseRows = Collection();
			                        for each responseRow in Assessment_Responses[Assessment == assessmentRow.ID] sort by Category_Display_Order, Question_Display_Order
			                        {
			                            publicRow = External_Assessment_Submission.Responses();
			                            publicRow.Assessment_Response_ID = responseRow.ID;
			                            publicRow.Category_Snapshot = responseRow.Category_Snapshot;
			                            publicRow.Question_Text_Snapshot = responseRow.Question_Text_Snapshot;
			                            publicRow.Answer_Type_Snapshot = responseRow.Answer_Type_Snapshot;
			                            publicRow.Option_Values_Snapshot = responseRow.Option_Values_Snapshot;
			                            publicRow.Mandatory_Snapshot = responseRow.Mandatory_Snapshot;
			                            responseRows.insert(publicRow);
			                        }
			                        input.Responses.insert(responseRows);
			                    }
			                }
			            )
			        }
			    }
			}

			External_Assessment_On_Success as "External Assessment On Success"
			{
			    type = form
			    form = External_Assessment_Submission
			    record event = on add
			    description = "Writes public answers back to the assessment response snapshots and submits the parent assessment."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                for each responseRow in input.Responses
			                {
			                    normalizedAnswer = "";
			                    if(responseRow.Answer_Type_Snapshot == "Single-Line Text")
			                    {
			                        normalizedAnswer = ifnull(responseRow.Single_Line_Answer,"");
			                    }
			                    else if(responseRow.Answer_Type_Snapshot == "Paragraph")
			                    {
			                        normalizedAnswer = ifnull(responseRow.Paragraph_Answer,"");
			                    }
			                    else if(responseRow.Answer_Type_Snapshot == "Dropdown")
			                    {
			                        normalizedAnswer = ifnull(responseRow.Dropdown_Answer,"");
			                    }
			                    else if(responseRow.Answer_Type_Snapshot == "Multi-Select")
			                    {
			                        normalizedAnswer = responseRow.Multi_Select_Answer.toString();
			                    }
			                    else if(responseRow.Answer_Type_Snapshot == "Rating/Scale" && responseRow.Rating_Answer != null)
			                    {
			                        normalizedAnswer = responseRow.Rating_Answer.toString();
			                    }
			                    else if(responseRow.Answer_Type_Snapshot == "Yes-No")
			                    {
			                        normalizedAnswer = ifnull(responseRow.Yes_No_Answer,"");
			                    }
			                    update Assessment_Responses[ID == responseRow.Assessment_Response_ID && Assessment == input.Assessment_ID]
			                    [
			                        Single_Line_Answer = responseRow.Single_Line_Answer
			                        Paragraph_Answer = responseRow.Paragraph_Answer
			                        Dropdown_Answer = responseRow.Dropdown_Answer
			                        Multi_Select_Answer = responseRow.Multi_Select_Answer
			                        Rating_Answer = responseRow.Rating_Answer
			                        Yes_No_Answer = responseRow.Yes_No_Answer
			                        Normalized_Answer = normalizedAnswer
			                        Completed_By_Name = input.Completed_By_Name
			                        Completed_By_Email = input.Completed_By_Email
			                        Completed_Mode = "External"
			                        Submitted_At = zoho.currenttime
			                        Row_Status = "Submitted"
			                    ];
			                }
			                thisapp.Submit_Assessment(input.Assessment_ID, input.Completed_By_Name, input.Completed_By_Email, "External");
			            )
			        }
			    }
			}

			External_Assessment_On_Validate as "External Assessment On Validate"
			{
			    type = form
			    form = External_Assessment_Submission
			    record event = on add
			    description = "Revalidates token access and required answers before public submission."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                tokenValue = input.Token;
			                assessmentRow = Assessments[Public_Token == tokenValue && Assessment_Mode == "External" && Status != "Submitted" && Status != "Expired"];
			                if(assessmentRow.count() == 0)
			                {
			                    alert "This questionnaire link is invalid, expired, or already submitted.";
			                    cancel submit;
			                }
			                if(assessmentRow.Public_Link_Expires_On != null && assessmentRow.Public_Link_Expires_On < zoho.currentdate)
			                {
			                    alert "This questionnaire link has expired. Please ask your Kannanware consultant for a fresh link.";
			                    cancel submit;
			                }
			                for each responseRow in input.Responses
			                {
			                    if(responseRow.Rating_Answer != null && (responseRow.Rating_Answer < 1 || responseRow.Rating_Answer > 5))
			                    {
			                        alert "Rating answers must be between 1 and 5.";
			                        cancel submit;
			                        break;
			                    }
			                    if(responseRow.Mandatory_Snapshot == true)
			                    {
			                        missing = false;
			                        if(responseRow.Answer_Type_Snapshot == "Single-Line Text" && ifnull(responseRow.Single_Line_Answer,"").trim() == "")
			                        {
			                            missing = true;
			                        }
			                        else if(responseRow.Answer_Type_Snapshot == "Paragraph" && ifnull(responseRow.Paragraph_Answer,"").trim() == "")
			                        {
			                            missing = true;
			                        }
			                        else if(responseRow.Answer_Type_Snapshot == "Dropdown" && (ifnull(responseRow.Dropdown_Answer,"").trim() == "" || responseRow.Dropdown_Answer == "Not Applicable"))
			                        {
			                            missing = true;
			                        }
			                        else if(responseRow.Answer_Type_Snapshot == "Multi-Select" && responseRow.Multi_Select_Answer.isEmpty())
			                        {
			                            missing = true;
			                        }
			                        else if(responseRow.Answer_Type_Snapshot == "Rating/Scale" && responseRow.Rating_Answer == null)
			                        {
			                            missing = true;
			                        }
			                        else if(responseRow.Answer_Type_Snapshot == "Yes-No" && ifnull(responseRow.Yes_No_Answer,"").trim() == "")
			                        {
			                            missing = true;
			                        }
			                        if(missing == true)
			                        {
			                            alert "Please answer the mandatory question: " + responseRow.Question_Text_Snapshot;
			                            cancel submit;
			                            break;
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

