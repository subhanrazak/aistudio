		        type = date
		        displayname = "End Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Question_Categories
		{
