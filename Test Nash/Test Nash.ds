			Questions_On_Validate as "Questions On Validate"
			{
			    type = form
			    form = Questions
			    record event = on add or edit
			    description = "Validates option values, display order, and category/industry alignment."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if((input.Answer_Type == "Dropdown" || input.Answer_Type == "Multi-Select") && ifnull(input.Option_Values,"").trim() == "")
			                {
			                    alert "Option Values are required for Dropdown and Multi-Select questions.";
			                    cancel submit;
			                }
			                if(ifnull(input.Display_Order,0) <= 0)
			                {
			                    input.Display_Order = 1;
			                }
			                if(input.Category != null && input.Industry_Type != null)
			                {
			                    categoryRec = Question_Categories[ID == input.Category];
			                    if(categoryRec.count() > 0 && categoryRec.Industry_Type != input.Industry_Type)
			                    {
			                        alert "The selected category must belong to the selected industry type.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Assessment_Expiry_Reminder as "Assessment Expiry Reminder"
			{
			    type = schedule
			    form = Assessments[Status == "Submitted" && Expiry_Reminder_Sent == false && Valid_Until != null]
			    start = before 15 days from Valid_Until at "09:00:00"
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                consultantEmail = zoho.adminuserid;
			                if(input.Assigned_Consultant != null)
			                {
			                    consultantEmail = input.Assigned_Consultant.email;
			                }
			                customerEmail = input.Customer_Contact_Email;
			                sendmail
			                [
			                    from : zoho.adminuserid
			                    to : consultantEmail
			                    subject : "Assessment approaching expiry: " + input.Assessment_Reference
			                    message : "The Current State Assessment for " + input.Customer.Customer_Name + " / " + input.Project.Project_Name + " expires on " + input.Valid_Until.toString("dd-MMM-yyyy") + ". Please plan reassessment if required."
			                ];
			                activeSettings = Assessment_Settings[Active == true];
			                notifyCustomer = true;
			                if(activeSettings.count() > 0)
			                {
			                    notifyCustomer = activeSettings.Notify_Customer_On_Expiry;
			                }
			                if(notifyCustomer == true && ifnull(customerEmail,"").trim() != "")
			                {
			                    sendmail
			                    [
			                        from : zoho.adminuserid
			                        to : customerEmail
			                        subject : "Current State Assessment approaching expiry"
			                        message : "Your Current State Assessment " + input.Assessment_Reference + " is valid until " + input.Valid_Until.toString("dd-MMM-yyyy") + ". Your Kannanware consultant will coordinate next steps if reassessment is needed."
			                    ];
			                }
			                update Assessments[ID == input.ID]
			                [
			                    Expiry_Reminder_Sent = true
			                ];
			            )
			        }
			    }
			}

			Assessment_Expiry_Status_Update as "Assessment Expiry Status Update"
			{
			    type = schedule
			    form = Assessments[Status == "Submitted" && Valid_Until != null]
			    start = Valid_Until at "09:00:00"
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                consultantEmail = zoho.adminuserid;
			                if(input.Assigned_Consultant != null)
			                {
			                    consultantEmail = input.Assigned_Consultant.email;
			                }
			                customerEmail = input.Customer_Contact_Email;
			                update Assessments[ID == input.ID]
			                [
			                    Status = "Expired"
			                    Expired_Notification_Sent = true
			                ];
			                sendmail
			                [
			                    from : zoho.adminuserid
			                    to : consultantEmail
			                    subject : "Assessment expired: " + input.Assessment_Reference
			                    message : "The Current State Assessment for " + input.Customer.Customer_Name + " / " + input.Project.Project_Name + " expired today. Use Start Reassessment on the assessment report to create a fresh draft while preserving historical responses and documents."
			                ];
			                activeSettings = Assessment_Settings[Active == true];
			                notifyCustomer = true;
			                if(activeSettings.count() > 0)
			                {
			                    notifyCustomer = activeSettings.Notify_Customer_On_Expiry;
			                }
			                if(notifyCustomer == true && ifnull(customerEmail,"").trim() != "")
			                {
			                    sendmail
			                    [
			                        from : zoho.adminuserid
			                        to : customerEmail
			                        subject : "Current State Assessment expired"
			                        message : "Your Current State Assessment " + input.Assessment_Reference + " has expired. Kannanware will coordinate reassessment if a renewed current-state view is needed."
			                    ];
			                }
			            )
			        }
			    }
			}
		}

		functions
		{
			WF_Generate_Assessment_Report as "Generate Assessment Report"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			    description = "Regenerates the branded Current State Assessment report and versions it in the assessment document history."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                thisapp.Generate_Assessment_Report(input.ID);
			            )
			        }
			    }
			}

			WF_Generate_Public_Link as "Generate Public Link"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			    description = "Generates a tokenized public questionnaire link for an external assessment."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                generatedLink = thisapp.Build_Public_Assessment_Link(input.ID);
			                if(input.Status == "Draft")
			                {
			                    update Assessments[ID == input.ID]
			                    [
			                        Status = "In Progress"
			                    ];
			                }
			                openUrl("#Report:All_Assessments", "same window");
			            )
			        }
			    }
			}

			WF_Start_Reassessment as "Start Reassessment"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			    description = "Clones core assessment context into a fresh Draft without copying responses or documents."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                newAssessmentId = insert into Assessments
			                [
			                    Project = input.Project
			                    Customer = input.Customer
			                    Customer_Contact_Email = input.Customer_Contact_Email
			                    Industry_Type = input.Industry_Type
			                    Assigned_Consultant = input.Assigned_Consultant
			                    Assessment_Mode = input.Assessment_Mode
			                    Status = "Draft"
			                    Validity_Period_Months = input.Validity_Period_Months
			                    Expiry_Reminder_Sent = false
			                    Expired_Notification_Sent = false
			                    Questions_Generated = false
			                ];
			                openUrl("#Form:Assessments?recLinkID=" + newAssessmentId + "&viewLinkName=All_Assessments", "same window");
			            )
			        }
			    }
			}

			WF_Submit_Assessment as "Submit Assessment"
			{
			    type = functions
			    form = Assessments
			    execution type = for each record
			    description = "Runs central assessment submission logic and creates the branded report document row."
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                thisapp.Submit_Assessment(input.ID, input.Completed_By_Name, input.Completed_By_Email, input.Assessment_Mode);
			            )
			        }
			    }
			}
		}
	}

	functions
	{
		Deluge
		{
			string Build_Public_Assessment_Link(int assessmentId)
			{
			    assessmentRow = Assessments[ID == assessmentId];
			    linkValue = "";
			    if(assessmentRow.count() > 0)
			    {
			        tokenValue = assessmentRow.Public_Token;
			        if(ifnull(tokenValue,"").trim() == "")
			        {
			            tokenValue = "CSA-" + assessmentId.toString() + "-" + zoho.currenttime.toString("yyyyMMddHHmmss") + "-" + randomNumber(100000,999999).toString();
			        }
			        expiryDate = zoho.currentdate.addMonth(ifnull(assessmentRow.Validity_Period_Months,3));
			        linkValue = zoho.appuri + "form-perma/External_Assessment_Submission?Token=" + tokenValue;
			        update Assessments[ID == assessmentId]
			        [
			            Public_Token = tokenValue
			            Public_Link = "<a href=\"" + linkValue + "\" target=\"_blank\">Open Questionnaire</a>"
			            Public_Link_Generated_On = zoho.currenttime
			            Public_Link_Expires_On = expiryDate
			        ];
			    }
			    return linkValue;
			}

			void Generate_Assessment_Report(int assessmentId)
			{
			    assessmentRow = Assessments[ID == assessmentId];
			    if(assessmentRow.count() > 0)
			    {
			        maxVersion = 0;
			        for each documentRow in Assessment_Documents[Assessment == assessmentId && Document_Type == "Generated Report"]
			        {
			            if(ifnull(documentRow.Version_Number,0) > maxVersion)
			            {
			                maxVersion = documentRow.Version_Number;
			            }
			        }
			        nextVersion = maxVersion + 1;
			        reportName = "Current State Assessment Report - " + assessmentRow.Assessment_Reference + " - v" + nextVersion.toString();
			        printUrl = zoho.appuri + "print/Assessment_Report_Print_View?Assessment=" + assessmentId.toString() + "&zc_FileName=" + assessmentRow.Assessment_Reference + "-CSA-Report-v" + nextVersion.toString();
			        sourceAction = "Regenerated";
			        if(maxVersion == 0)
			        {
			            sourceAction = "Generated on Submit";
			        }
			        insert into Assessment_Documents
			        [
			            Assessment = assessmentId
			            Document_Name = reportName
			            Document_Type = "Generated Report"
			            Document_URL = "<a href=\"" + printUrl + "\" target=\"_blank\">Preview / Download PDF</a>"
			            Uploaded_By = zoho.loginuser
			            Upload_Date = zoho.currenttime
			            Version_Number = nextVersion
			            Revision_Notes = "Generated from Kannanware Current State Assessment print template. PDF is primary; report view remains export-ready for Excel/Word-compatible formats."
			            Source_Action = sourceAction
			        ];
			    }
			}

			void Generate_Assessment_Responses(int assessmentId)
			{
			    assessmentRow = Assessments[ID == assessmentId];
			    if(assessmentRow.count() > 0)
			    {
			        if(assessmentRow.Industry_Type != null)
			        {
			            existingRows = Assessment_Responses[Assessment == assessmentId];
			            if(existingRows.count() == 0)
			            {
			                industryName = "";
			                industryRow = Industry_Types[ID == assessmentRow.Industry_Type];
			                if(industryRow.count() > 0)
			                {
			                    industryName = industryRow.Industry_Name;
			                }
			                for each categoryRow in Question_Categories[Industry_Type == assessmentRow.Industry_Type && Active == true] sort by Display_Order
			                {
			                    categoryName = categoryRow.Category_Name;
			                    categoryOrder = ifnull(categoryRow.Display_Order,1);
			                    for each questionRow in Questions[Industry_Type == assessmentRow.Industry_Type && Category == categoryRow.ID && Active == true] sort by Display_Order
			                    {
			                        insert into Assessment_Responses
			                        [
			                            Assessment = assessmentId
			                            Question_Bank_Question = questionRow.ID
			                            Category_Snapshot = categoryName
			                            Category_Display_Order = categoryOrder
			                            Question_Text_Snapshot = questionRow.Question_Text
			                            Question_Display_Order = ifnull(questionRow.Display_Order,1)
			                            Industry_Type_Snapshot = industryName
			                            Answer_Type_Snapshot = questionRow.Answer_Type
			                            Option_Values_Snapshot = questionRow.Option_Values
			                            Mandatory_Snapshot = questionRow.Mandatory
			                            Row_Status = "Draft"
			                        ];
			                    }
			                }
			                update Assessments[ID == assessmentId]
			                [
			                    Questions_Generated = true
			                ];
			            }
			        }
			    }
			}

			void Submit_Assessment(int assessmentId, string completedByName, string completedByEmail, string mode)
			{
			    assessmentRow = Assessments[ID == assessmentId];
			    if(assessmentRow.count() > 0)
			    {
			        thisapp.Generate_Assessment_Responses(assessmentId);
			        missingMandatory = false;
			        missingQuestion = "";
			        for each responseRow in Assessment_Responses[Assessment == assessmentId && Mandatory_Snapshot == true]
			        {
			            if(ifnull(responseRow.Normalized_Answer,"").trim() == "" || responseRow.Normalized_Answer == "Not Applicable")
			            {
			                missingMandatory = true;
			                missingQuestion = responseRow.Question_Text_Snapshot;
			                break;
			            }
			        }
			        if(missingMandatory == false)
			        {
			            submitDate = zoho.currentdate;
			            validityMonths = ifnull(assessmentRow.Validity_Period_Months,3);
			            validUntilDate = submitDate.addMonth(validityMonths);
			            submitMode = mode;
			            if(submitMode in {"", " ", "null", null})
			            {
			                submitMode = assessmentRow.Assessment_Mode;
			            }
			            completeName = completedByName;
			            if(completeName in {"", " ", "null", null})
			            {
			                completeName = zoho.loginuser;
			            }
			            completeEmail = completedByEmail;
			            if(completeEmail in {"", " ", "null", null})
			            {
			                completeEmail = zoho.loginuserid;
			            }
			            update Assessments[ID == assessmentId]
			            [
			                Status = "Submitted"
			                Submission_Date = submitDate
			                Valid_Until = validUntilDate
			                Submission_Timestamp = zoho.currenttime
			                Submission_Mode = submitMode
			                Completed_By_Name = completeName
			                Completed_By_Email = completeEmail
			                Expiry_Reminder_Sent = false
			                Expired_Notification_Sent = false
			            ];
			            for each responseRowToSubmit in Assessment_Responses[Assessment == assessmentId]
			            {
			                responseRowToSubmit.Row_Status = "Submitted";
			                responseRowToSubmit.Completed_By_Name = completeName;
			                responseRowToSubmit.Completed_By_Email = completeEmail;
			                responseRowToSubmit.Completed_Mode = submitMode;
			                responseRowToSubmit.Submitted_At = zoho.currenttime;
			            }
			            thisapp.Generate_Assessment_Report(assessmentId);
			        }
			        else
			        {
			            info "Mandatory response is unanswered: " + missingQuestion;
			        }
			    }
			}
		}
	}

