		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Projects
		{
		    displayname = "Projects"
		
		    Project_Details
		    (
		        type = section
		        displayname = "Project Details"
		        row = 1
		        column = 0
		    )
		
		    must have Project_Name
		    (
		        type = text
		        displayname = "Project Name"
		        maxchar = 200
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    unique Project_Code
		    (
		        type = text
		        displayname = "Project Code"
		        maxchar = 50
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    must have Customer
		    (
		        type = picklist
		        displayname = "Customer"
		        values = Customers.ID
		        displayformat = [Customer_Name]
		        allow new entries
