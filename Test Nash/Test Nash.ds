		        column = 1
		        width = medium
		    )
		
		    Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        initial value = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
