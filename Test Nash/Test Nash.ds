	menu
	{
	    unused
	    {
	        form External_Assessment_Submission
	        {
	            icon = "files-locked"
	        }
	    }
	
	    space Admin_Workspace
	    {
	        displayname = "Admin Workspace"
	        icon = "business-safe"
	
	        section Admin_Dashboard_Section
	        {
	            displayname = "Admin Dashboard"
	            icon = "business-chart-bar-33"
	
	            page Assessment_Dashboard
	            {
	                icon = "business-chart"
	            }
	        }
	
	        section Admin_Customer_Project_Section
	        {
	            displayname = "Customers & Projects"
	            icon = "users-multiple-19"
	
	            form Customers
	            {
	                icon = "users-multiple-19"
	            }
	            report All_Customers
	            {
	                icon = "users-contacts"
	            }
	            form Projects
	            {
	                icon = "business-briefcase-26"
	            }
	            report All_Projects
	            {
	                icon = "business-agenda"
	            }
	        }
	
	        section Admin_Questionnaire_Bank_Section
	        {
	            displayname = "Questionnaire Bank"
	            icon = "files-question"
	
	            form Industry_Types
	            {
	                icon = "business-factory"
	            }
	            report All_Industry_Types
	            {
	                icon = "business-globe"
	            }
	            form Question_Categories
	            {
	                icon = "files-folder-13"
	            }
	            report All_Question_Categories
	            {
	                icon = "files-folder-search"
	            }
	            form Questions
	            {
	                icon = "files-question"
	            }
	            report All_Questions
	            {
	                icon = "files-book-08"
	            }
	            report Active_Questions_By_Industry
	            {
	                icon = "business-board-27"
	            }
	        }
	
	        section Admin_Settings_Section
	        {
	            displayname = "Settings"
	            icon = "files-settings-46"
	
	            form Assessment_Settings
	            {
	                icon = "files-settings-99"
	            }
	            report All_Assessment_Settings
	            {
	                icon = "files-settings-46"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	
	        designcomponent designcomponent1
	        {
	            type = separator
	            separator = "line"
	        }
	    }
	
	    space Consultant_Workspace
	    {
	        displayname = "Consultant Workspace"
	        icon = "business-briefcase-26"
	
	        section Consultant_Assessment_Work_Section
	        {
	            displayname = "Assessment Work"
	            icon = "business-board-29"
	
	            form Assessments
	            {
	                icon = "business-board-30"
	            }
	            report All_Assessments
	            {
	                icon = "business-notes"
	            }
	            report Assessments_By_Status
	            {
	                icon = "business-chart-pie-36"
	            }
	            report Expiring_Assessments
	            {
	                icon = "files-time"
	            }
	        }
	
	        section Consultant_Response_Section
	        {
	            displayname = "Responses"
	            icon = "files-single-content-03"
	
	            form Assessment_Responses
	            {
	                icon = "files-single-content-03"
	            }
	            report All_Assessment_Responses
	            {
	                icon = "files-single-paragraph"
	            }
	            report Submitted_Responses
	            {
	                icon = "files-check"
	            }
	            report Assessment_Report_Print_View
	            {
	                icon = "files-paper"
	            }
	        }
	
	        section Consultant_Document_Section
	        {
	            displayname = "Documents"
	            icon = "files-folder-info"
	
	            form Assessment_Documents
	            {
	                icon = "files-folder-14"
	            }
	            report All_Assessment_Documents
	            {
	                icon = "files-folder-info"
	            }
	            report Generated_Assessment_Reports
	            {
	                icon = "files-archive-paper-check"
	            }
	        }
	
	        designcomponent designcomponent2
	        {
	            type = separator
	            separator = "line"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-header,.zc-menu-header{background:#083D56;} .zc-button-primary,.zc-primary{background:#0E7C86;border-color:#0E7C86;} .zc-report-title,.zc-page-title{color:#083D56;}"
	    }
	}
	}
