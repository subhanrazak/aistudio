"CSA_Consultant"
{
    name = "CSA_Consultant"
    type = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Consultants create and complete assessments, generate links and reports, manage documents, and view dashboards."

    ModulePermissions
    {
        Customers
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Customers={"View"}
            }
        }
        Projects
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Projects={"View"}
            }
        }
        Industry_Types
        {
            enabled = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Industry_Types={"View"}
            }
        }
        Assessment_Settings
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Assessment_Settings={"View"}
            }
        }
        Question_Categories
        {
            enabled = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Question_Categories={"View"}
            }
        }
        Questions
        {
            enabled = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Questions={"View"}
                Active_Questions_By_Industry={"View"}
            }
        }
        Assessment_Responses
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Assessment{visibility:true,readonly:true}
                Question_Bank_Question{visibility:false}
                Category_Snapshot{visibility:true,readonly:true}
                Category_Display_Order{visibility:true,readonly:true}
                Question_Text_Snapshot{visibility:true,readonly:true}
                Question_Display_Order{visibility:true,readonly:true}
                Industry_Type_Snapshot{visibility:true,readonly:true}
                Answer_Type_Snapshot{visibility:true,readonly:true}
                Option_Values_Snapshot{visibility:true,readonly:true}
                Mandatory_Snapshot{visibility:true,readonly:true}
                Single_Line_Answer{visibility:true,readonly:false}
                Paragraph_Answer{visibility:true,readonly:false}
                Dropdown_Answer{visibility:true,readonly:false}
                Multi_Select_Answer{visibility:true,readonly:false}
                Rating_Answer{visibility:true,readonly:false}
                Yes_No_Answer{visibility:true,readonly:false}
                Normalized_Answer{visibility:true,readonly:true}
                Completed_By_Name{visibility:true,readonly:true}
                Completed_By_Email{visibility:true,readonly:true}
                Completed_Mode{visibility:true,readonly:true}
                Submitted_At{visibility:true,readonly:true}
                Row_Status{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Assessment_Responses={"View"}
                Submitted_Responses={"View"}
            }
        }
        Assessment_Documents
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Assessment{visibility:true,readonly:true}
                Document_Name{visibility:true,readonly:false}
                Document_Type{visibility:true,readonly:false}
                Document_File{visibility:true,readonly:false}
                Document_URL{visibility:true,readonly:true}
                Uploaded_By{visibility:true,readonly:true}
                Upload_Date{visibility:true,readonly:true}
                Version_Number{visibility:true,readonly:true}
                Revision_Notes{visibility:true,readonly:false}
                Source_Action{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Assessment_Documents={"View"}
                Generated_Assessment_Reports={"View"}
            }
        }
        Assessments
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Assessment_Sequence{visibility:true,readonly:true}
                Assessment_Reference{visibility:true,readonly:true}
                Project{visibility:true,readonly:false}
                Customer{visibility:true,readonly:false}
                Customer_Contact_Email{visibility:true,readonly:false}
                Industry_Type{visibility:true,readonly:false}
                Assigned_Consultant{visibility:true,readonly:false}
                Assessment_Mode{visibility:true,readonly:false}
                Status{visibility:true,readonly:false}
                Validity_Period_Months{visibility:true,readonly:false}
                Submission_Date{visibility:true,readonly:true}
                Valid_Until{visibility:true,readonly:true}
                Expiry_Reminder_Sent{visibility:true,readonly:true}
                Expired_Notification_Sent{visibility:true,readonly:true}
                Completed_By_Name{visibility:true,readonly:true}
                Completed_By_Email{visibility:true,readonly:true}
                Submission_Timestamp{visibility:true,readonly:true}
                Submission_Mode{visibility:true,readonly:true}
                Public_Token{visibility:false}
                Public_Link{visibility:true,readonly:true}
                Public_Link_Generated_On{visibility:true,readonly:true}
                Public_Link_Expires_On{visibility:true,readonly:true}
