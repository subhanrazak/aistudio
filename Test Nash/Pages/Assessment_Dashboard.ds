<page linkname = "Assessment_Dashboard" displayname = "Assessment Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Dashboard_Summary' elementName='Dashboard_Summary'>
          <![CDATA[htmlpage Dashboard_Summary()
            content
            <%{%>
              <file name:Dashboard_Summary.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Recent_Submissions' elementName='Recent_Submissions'>
          <![CDATA[htmlpage Recent_Submissions()
            content
            <%{%>
              <file name:Recent_Submissions.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Document_Activity' elementName='Document_Activity'>
          <![CDATA[htmlpage Document_Activity()
            content
            <%{%>
              <file name:Document_Activity.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
