form Projects
{
    displayname = "Projects"

    Project_Details
    (
        type = section
        displayname = "Project Details"
        row = 1
        column = 0
    )

    must have Project_Name
    (
        type = text
        displayname = "Project Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )

    unique Project_Code
    (
        type = text
        displayname = "Project Code"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )

    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        allow new entries
        [
            displayname = "Add New Customer"
        ]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Assigned_Consultant
    (
        type = picklist
        displayname = "Assigned Consultant"
        module = users
        displayformat = [name]
        row = 1
        column = 1
        width = medium
    )

    Customer_Contact_Email
    (
        type = email
        displayname = "Customer Contact Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    Project_Status
    (
        type = picklist
        displayname = "Project Status"
        values = {"Active","On Hold","Completed","Cancelled"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )

    End_Date
    (
        type = date
        displayname = "End Date"
        row = 1
        column = 1
        width = medium
    )

    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
