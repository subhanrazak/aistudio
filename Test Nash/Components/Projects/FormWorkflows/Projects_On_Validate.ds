Projects_On_Validate as "Projects On Validate"
{
    type = form
    form = Projects
    record event = on add or edit
    description = "Validates project date range."

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Start_Date != null && input.End_Date != null && input.End_Date < input.Start_Date)
                {
                    alert "End Date cannot be before Start Date.";
                    cancel submit;
                }
            )
        }
    }
}
