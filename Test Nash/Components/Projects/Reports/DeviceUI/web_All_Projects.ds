report All_Projects
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Project_Name
                    Project_Code
                    Customer
                    Assigned_Consultant
                    Project_Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Project_Name
                    Project_Code
                    Customer
                    Assigned_Consultant
                    Customer_Contact_Email
                    Project_Status
                    Start_Date
                    End_Date
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
