report Assessment_Report_Print_View
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Assessment_Reference
                    Customer
                    Project
                    Industry_Type
                    Assessment_Mode
                    Assigned_Consultant
                    Valid_Until
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Assessment_Reference
                    Customer
                    Project
                    Industry_Type
                    Assessment_Mode
                    Assigned_Consultant
                    Submission_Date
                    Valid_Until
                    Completed_By_Name
                    Completed_By_Email
                    Submission_Mode
                    Questions_Generated
                    Responses
                    Documents
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
