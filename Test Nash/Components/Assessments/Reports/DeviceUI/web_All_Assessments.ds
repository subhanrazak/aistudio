report All_Assessments
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Assessment_Reference
                    Customer
                    Project
                    Industry_Type
                    Assessment_Mode
                    Status
                    Assigned_Consultant
                    Valid_Until
                    "Generate Public Link"
                    "Submit Assessment"
                    "Generate Report"
                    "Start Reassessment"
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                title = "Assessment Details"
                fields
                (
                    Assessment_Reference
                    Project
                    Customer
                    Industry_Type
                    Assessment_Mode
                    Status
                    Assigned_Consultant
                    Customer_Contact_Email
                    "Generate Public Link"
                    "Submit Assessment"
                    "Generate Report"
                    "Start Reassessment"
                )
            )
            datablock2
            (
                layout type = -2
                title = "Validity"
                fields
                (
                    Validity_Period_Months
                    Submission_Date
                    Valid_Until
                    Expiry_Reminder_Sent
                    Expired_Notification_Sent
                )
            )
            datablock3
            (
                layout type = -2
                title = "Submission Metadata"
                fields
                (
                    Completed_By_Name
                    Completed_By_Email
                    Submission_Timestamp
                    Submission_Mode
                )
            )
            datablock4
            (
                layout type = -2
                title = "External Access"
                fields
                (
                    Public_Link
                    Public_Link_Generated_On
                    Public_Link_Expires_On
                    Questions_Generated
                )
            )
            datablock5
            (
                layout type = -2
                title = "Responses"
                fields
                (
                    Responses
                )
            )
            datablock6
            (
                layout type = -2
                title = "Documents"
                fields
                (
                    Documents
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
