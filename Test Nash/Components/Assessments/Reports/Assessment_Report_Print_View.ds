list Assessment_Report_Print_View
{
    displayName = "Assessment Report Print View"
    show all rows from Assessments [Status == "Submitted"]
    (
        Assessment_Reference
        Customer
        Project
        Industry_Type
        Assessment_Mode
        Assigned_Consultant
        Submission_Date
        (
            displayformat = fulldate
        )
        Valid_Until
        (
            displayformat = fulldate
        )
        Completed_By_Name
        Completed_By_Email
        Submission_Mode
        Questions_Generated
        Responses
        Documents
    )
    filters
    (
        Customer
        Project
        Industry_Type
        Assessment_Mode
        Assigned_Consultant
        Valid_Until
    )
    sort by
    (
        Assessment_Reference descending
    )
}
