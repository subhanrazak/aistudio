form Assessments
{
    displayname = "Assessments"

    Assessment_Details
    (
        type = section
        displayname = "Assessment Details"
        row = 1
        column = 0
    )

    Assessment_Sequence
    (
        type = autonumber
        displayname = "Assessment Sequence"
        start index = 1
        row = 1
        column = 1
        width = medium
    )

    unique Assessment_Reference
    (
        type = text
        displayname = "Assessment Reference"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )

    must have Project
    (
        type = picklist
        displayname = "Project"
        values = Projects[Project_Status != "Cancelled"].ID
        displayformat = [Project_Name]
        searchable = true
        allow new entries
        [
            displayname = "Add New Project"
        ]
        row = 1
        column = 1
        width = medium
    )

    must have Customer
    (
        type = picklist
        displayname = "Customer"
        values = Customers.ID
        displayformat = [Customer_Name]
        searchable = true
        allow new entries
        [
            displayname = "Add New Customer"
        ]
        row = 1
        column = 1
        width = medium
    )

    Customer_Contact_Email
    (
        type = email
        displayname = "Customer Contact Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types[Active == true].ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Assigned_Consultant
    (
        type = picklist
        displayname = "Assigned Consultant"
        module = users
        displayformat = [name]
        row = 1
        column = 1
        width = medium
    )

    Assessment_Mode
    (
        type = picklist
        displayname = "Assessment Mode"
        values = {"Internal","External"}
        initial value = "Internal"
        row = 1
        column = 1
        width = medium
    )

    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft","In Progress","Submitted","Expired"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )

    Validity_Section
    (
        type = section
        displayname = "Validity"
        visibility = true
        row = 2
        column = 1
    )

    Validity_Period_Months
    (
        type = number
        displayname = "Validity Period Months"
        initial value = 3
        row = 2
        column = 1
        width = medium
    )

    Submission_Date
    (
        type = date
        displayname = "Submission Date"
        row = 2
        column = 1
        width = medium
    )

    Valid_Until
    (
        type = date
        displayname = "Valid Until"
        row = 2
        column = 1
        width = medium
    )

    Expiry_Reminder_Sent
    (
        type = checkbox
        displayname = "Expiry Reminder Sent"
        initial value = false
        row = 2
        column = 1
        width = medium
    )

    Expired_Notification_Sent
    (
        type = checkbox
        displayname = "Expired Notification Sent"
        initial value = false
        row = 2
        column = 1
        width = medium
    )

    Assessment_Submission_Metadata
    (
        type = section
        displayname = "Assessment Submission Metadata"
        visibility = true
        row = 3
        column = 1
    )

    Completed_By_Name
    (
        type = text
        displayname = "Completed By Name"
        personal data = true
        row = 3
        column = 1
        width = medium
    )

    Completed_By_Email
    (
        type = email
        displayname = "Completed By Email"
        personal data = true
        row = 3
        column = 1
        width = medium
    )

    Submission_Timestamp
    (
        type = datetime
        displayname = "Submission Timestamp"
        row = 3
        column = 1
        width = medium
    )

    Submission_Mode
    (
        type = picklist
        displayname = "Submission Mode"
        values = {"Internal","External"}
        row = 3
        column = 1
        width = medium
    )

    External_Access
    (
        type = section
        displayname = "External Access"
        visibility = true
        row = 4
        column = 1
    )

    unique Public_Token
    (
        type = text
        displayname = "Public Token"
        maxchar = 100
        row = 4
        column = 1
        width = medium
    )

    Public_Link
    (
        type = url
        displayname = "Public Link"
        row = 4
        column = 1
        width = medium
    )

    Public_Link_Generated_On
    (
        type = datetime
        displayname = "Public Link Generated On"
        row = 4
        column = 1
        width = medium
    )

    Public_Link_Expires_On
    (
        type = date
        displayname = "Public Link Expires On"
        row = 4
        column = 1
        width = medium
    )

    Questions_Generated
    (
        type = checkbox
        displayname = "Questions Generated"
        initial value = false
        row = 4
        column = 1
        width = medium
    )

    Assessment_Responses_Section
    (
        type = section
        displayname = "Assessment Response Rows"
        visibility = false
        row = 5
        column = 1
    )

    Responses
    (
        type = grid
        displayname = "Responses"
        values = Assessment_Responses.ID
        bidirectional = Assessment
        defaultrow = 0
        sorttype = fieldbased
        sort by
        (
            Category_Display_Order ascending
            Question_Display_Order ascending
        )
        row = 5
        column = 1
        width = medium
    )

    Assessment_Documents_Section
    (
        type = section
        displayname = "Assessment Document Files"
        visibility = false
        row = 6
        column = 1
    )

    Documents
    (
        type = grid
        displayname = "Documents"
        values = Assessment_Documents.ID
        bidirectional = Assessment
        defaultrow = 0
        sorttype = fieldbased
        sort by
        (
            Version_Number descending
            Upload_Date descending
        )
        row = 6
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
