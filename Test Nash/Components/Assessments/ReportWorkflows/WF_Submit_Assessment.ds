WF_Submit_Assessment as "Submit Assessment"
{
    type = functions
    form = Assessments
    execution type = for each record
    description = "Runs central assessment submission logic and creates the branded report document row."

    on start
    {
        actions
        {
            on click
            (
                thisapp.Submit_Assessment(input.ID, input.Completed_By_Name, input.Completed_By_Email, input.Assessment_Mode);
            )
        }
    }
}
