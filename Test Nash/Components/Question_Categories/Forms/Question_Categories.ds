form Question_Categories
{
    displayname = "Question Categories"

    Category_Details
    (
        type = section
        displayname = "Category Details"
        row = 1
        column = 0
    )

    must have Category_Name
    (
        type = text
        displayname = "Category Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )

    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types[Active == true].ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Display_Order
    (
        type = number
        displayname = "Display Order"
        initial value = 1
        row = 1
        column = 1
        width = medium
    )

    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )

    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
