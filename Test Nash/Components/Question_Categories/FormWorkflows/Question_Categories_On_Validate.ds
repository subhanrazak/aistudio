Question_Categories_On_Validate as "Question Categories On Validate"
{
    type = form
    form = Question_Categories
    record event = on add or edit
    description = "Ensures category display order stays positive."

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(ifnull(input.Display_Order,0) <= 0)
                {
                    input.Display_Order = 1;
                }
            )
        }
    }
}
