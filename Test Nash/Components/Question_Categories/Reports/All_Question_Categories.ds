default list All_Question_Categories
{
    displayName = "All Question Categories"
    show all rows from Question_Categories
    (
        Category_Name
        Industry_Type
        Display_Order
        Active
        Description
        (
            foldcontent = enable
        )
    )
    filters
    (
        Industry_Type
        Active
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Industry_Type ascending
    )
    sort by
    (
        Display_Order ascending
        Category_Name ascending
    )
    conditional formatting
    (
        "Highlight Inactive"
        {
            condition = (Active == false)
            fields = [Category_Name, Industry_Type, Display_Order, Active]
            format = "background-color:#ECEFF1;color:#546E7A"
        }
    )
}
