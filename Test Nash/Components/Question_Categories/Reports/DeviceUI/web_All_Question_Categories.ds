report All_Question_Categories
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Category_Name
                    Industry_Type
                    Display_Order
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Category_Name
                    Industry_Type
                    Display_Order
                    Active
                    Description
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
