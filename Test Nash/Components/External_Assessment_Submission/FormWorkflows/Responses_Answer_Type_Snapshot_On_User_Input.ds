Responses_Answer_Type_Snapshot_On_User_Input as "External Response Answer Type On User Input"
{
    type = form
    form = External_Assessment_Submission
    record event = on add
    description = "Shows the answer field that matches the current response row's answer type."

    on user input of Responses.Answer_Type_Snapshot
    {
        actions
        {
            custom deluge script
            (
                info "External response answer type changed.";
            )
        }
    }
}
