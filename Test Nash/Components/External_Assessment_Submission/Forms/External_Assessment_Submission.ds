form External_Assessment_Submission
{
    displayname = "External Assessment Submission"
    success message = "Thank you. Your assessment has been submitted."
    captcha = true

    Access_Section
    (
        type = section
        displayname = "Assessment Access"
        row = 1
        column = 0
    )

    Token
    (
        type = text
        displayname = "Token"
        row = 1
        column = 1
        width = medium
    )

    Assessment_ID
    (
        type = number
        displayname = "Assessment ID"
        row = 1
        column = 1
        width = medium
    )

    Assessment_Reference
    (
        type = text
        displayname = "Assessment Reference"
        row = 1
        column = 1
        width = medium
    )

    Project_Name
    (
        type = text
        displayname = "Project Name"
        row = 1
        column = 1
        width = medium
    )

    Customer_Name
    (
        type = text
        displayname = "Customer Name"
        row = 1
        column = 1
        width = medium
    )

    Industry_Name
    (
        type = text
        displayname = "Industry"
        row = 1
        column = 1
        width = medium
    )

    Completion_Section
    (
        type = section
        displayname = "Completed By"
        visibility = true
        row = 2
        column = 1
    )

    must have Completed_By_Name
    (
        type = text
        displayname = "Completed By Name"
        personal data = true
        row = 2
        column = 1
        width = medium
    )

    must have Completed_By_Email
    (
        type = email
        displayname = "Completed By Email"
        personal data = true
        row = 2
        column = 1
        width = medium
    )

    Response_Rows
    (
        type = section
        displayname = "Questionnaire Responses"
        visibility = false
        row = 3
        column = 1
    )

    Responses
    (
        type = grid
        displayname = "Responses"
        defaultrow = 0
        maxrow = 500
        Assessment_Response_ID
        (
            type = number
            displayname = "Assessment Response ID"
        )
        Category_Snapshot
        (
            type = text
            displayname = "Category"
        )
        Question_Text_Snapshot
        (
            type = textarea
            displayname = "Question"
            height = 120px
        )
        Answer_Type_Snapshot
        (
            type = picklist
            displayname = "Answer Type"
            values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
        )
        Option_Values_Snapshot
        (
            type = textarea
            displayname = "Options"
        )
        Mandatory_Snapshot
        (
            type = checkbox
            displayname = "Mandatory"
        )
        Single_Line_Answer
        (
            type = text
            displayname = "Text Answer"
            maxchar = 255
        )
        Paragraph_Answer
        (
            type = textarea
            displayname = "Paragraph Answer"
            height = 120px
        )
        Dropdown_Answer
        (
            type = picklist
            displayname = "Dropdown Answer"
            values = {"Not Applicable"}
        )
        Multi_Select_Answer
        (
            type = list
            displayname = "Multi-Select Answer"
            values = {"Not Applicable"}
            height = 80px
        )
        Rating_Answer
        (
            type = number
            displayname = "Rating Answer"
        )
        Yes_No_Answer
        (
            type = picklist
            displayname = "Yes / No Answer"
            values = {"Yes","No"}
        )
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit_Assessment
            (
                type = submit
                displayname = "Submit Assessment"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
    }
}
