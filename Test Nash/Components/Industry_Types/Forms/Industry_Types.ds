form Industry_Types
{
    displayname = "Industry Types"

    Industry_Details
    (
        type = section
        displayname = "Industry Details"
        row = 1
        column = 0
    )

    must have unique Industry_Name
    (
        type = text
        displayname = "Industry Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )

    unique Industry_Code
    (
        type = text
        displayname = "Industry Code"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )

    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    Display_Order
    (
        type = number
        displayname = "Display Order"
        initial value = 1
        row = 1
        column = 1
        width = medium
    )

    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
