Industry_Types_On_Validate as "Industry Types On Validate"
{
    type = form
    form = Industry_Types
    record event = on add or edit
    description = "Ensures industry display order stays positive."

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(ifnull(input.Display_Order,0) <= 0)
                {
                    input.Display_Order = 1;
                }
            )
        }
    }
}
