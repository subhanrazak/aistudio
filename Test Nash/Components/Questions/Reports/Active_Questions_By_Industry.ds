list Active_Questions_By_Industry
{
    displayName = "Active Questions By Industry"
    show all rows from Questions [Active == true]
    (
        Question_Text
        (
            foldcontent = enable
        )
        Industry_Type
        Category
        Answer_Type
        Mandatory
        Display_Order
        Active
    )
    filters
    (
        Industry_Type
        Category
        Answer_Type
        Mandatory
    )
    sort by
    (
        Industry_Type ascending
        Category ascending
        Display_Order ascending
    )
}
