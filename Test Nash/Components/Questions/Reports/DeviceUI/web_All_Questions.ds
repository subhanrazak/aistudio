report All_Questions
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Question_Text
                    Industry_Type
                    Category
                    Answer_Type
                    Mandatory
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Question_Text
                    Industry_Type
                    Category
                    Answer_Type
                    Mandatory
                    Display_Order
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
