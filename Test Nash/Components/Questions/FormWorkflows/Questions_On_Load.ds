Questions_On_Load as "Questions On Load"
{
    type = form
    form = Questions
    record event = on add or edit
    description = "Shows option values only for choice-based answer types."

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Answer_Type == "Dropdown" || input.Answer_Type == "Multi-Select")
                {
                    show Option_Values;
                }
                else
                {
                    hide Option_Values;
                }
            )
        }
    }
}
