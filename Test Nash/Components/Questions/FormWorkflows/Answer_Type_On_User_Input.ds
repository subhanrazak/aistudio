Answer_Type_On_User_Input as "Answer Type On User Input"
{
    type = form
    form = Questions
    record event = on add or edit
    description = "Toggles option value entry based on the selected answer type."

    on user input of Answer_Type
    {
        actions
        {
            custom deluge script
            (
                if(input.Answer_Type == "Dropdown" || input.Answer_Type == "Multi-Select")
                {
                    show Option_Values;
                    enable Option_Values;
                }
                else
                {
                    input.Option_Values = "";
                    hide Option_Values;
                }
            )
        }
    }
}
