Industry_Type_On_User_Input as "Industry Type On User Input"
{
    type = form
    form = Questions
    record event = on add or edit
    description = "Clears category when the industry changes so users choose a matching section."

    on user input of Industry_Type
    {
        actions
        {
            custom deluge script
            (
                input.Category = null;
            )
        }
    }
}
