form Questions
{
    displayname = "Questions"

    Question_Details
    (
        type = section
        displayname = "Question Details"
        row = 1
        column = 0
    )

    must have Question_Text
    (
        type = textarea
        displayname = "Question Text"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    must have Industry_Type
    (
        type = picklist
        displayname = "Industry Type"
        values = Industry_Types[Active == true].ID
        displayformat = [Industry_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Question_Categories[Active == true].ID
        displayformat = [Category_Name]
        allow new entries
        [
            displayname = "Add New Category"
            set values
            (
                Industry_Type = input.Industry_Type
            )
        ]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    must have Answer_Type
    (
        type = picklist
        displayname = "Answer Type"
        values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
        row = 1
        column = 1
        width = medium
    )

    Option_Values
    (
        type = textarea
        displayname = "Option Values"
        height = 100px
        row = 1
        column = 1
        width = medium
        description [ type = tooltip  message = "Use one option per line, or comma-separated values, for Dropdown and Multi-Select questions." ]
    )

    Mandatory
    (
        type = checkbox
        displayname = "Mandatory"
        initial value = false
        row = 1
        column = 1
        width = medium
    )

    Display_Order
    (
        type = number
        displayname = "Display Order"
        initial value = 1
        row = 1
        column = 1
        width = medium
    )

    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 1
        width = medium
    )

    Help_Text
    (
        type = textarea
        displayname = "Help Text"
        height = 80px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
