form Assessment_Documents
{
    displayname = "Assessment Documents"

    Document_Details
    (
        type = section
        displayname = "Document Details"
        row = 1
        column = 0
    )

    must have Assessment
    (
        type = picklist
        displayname = "Assessment"
        values = Assessments.ID
        displayformat = [Assessment_Reference]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    must have Document_Name
    (
        type = text
        displayname = "Document Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )

    Document_Type
    (
        type = picklist
        displayname = "Document Type"
        values = {"Generated Report","Supporting"}
        initial value = "Supporting"
        row = 1
        column = 1
        width = medium
    )

    Document_File
    (
        type = upload file
        displayname = "Document File"
        file count = 1
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 1
        width = medium
    )

    Document_URL
    (
        type = url
        displayname = "Document URL"
        row = 1
        column = 1
        width = medium
    )

    Uploaded_By
    (
        type = picklist
        displayname = "Uploaded By"
        module = users
        displayformat = [name]
        row = 1
        column = 1
        width = medium
    )

    Upload_Date
    (
        type = datetime
        displayname = "Upload Date"
        row = 1
        column = 1
        width = medium
    )

    Version_Number
    (
        type = number
        displayname = "Version Number"
        initial value = 1
        row = 1
        column = 1
        width = medium
    )

    Revision_Notes
    (
        type = textarea
        displayname = "Revision Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    Source_Action
    (
        type = picklist
        displayname = "Source Action"
        values = {"Manual Upload","Generated on Submit","Regenerated"}
        initial value = "Manual Upload"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
