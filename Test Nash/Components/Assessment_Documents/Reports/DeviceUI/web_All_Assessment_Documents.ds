report All_Assessment_Documents
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Assessment
                    Document_Name
                    Document_Type
                    Document_File
                    Document_URL
                    Uploaded_By
                    Upload_Date
                    Version_Number
                    Source_Action
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Assessment
                    Document_Name
                    Document_Type
                    Document_File
                    Document_URL
                    Uploaded_By
                    Upload_Date
                    Version_Number
                    Source_Action
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
