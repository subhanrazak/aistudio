default list All_Assessment_Documents
{
    displayName = "All Assessment Documents"
    show all rows from Assessment_Documents
    (
        Assessment
        Document_Name
        Document_Type
        Document_File
        Document_URL
        Uploaded_By
        Upload_Date
        (
            displayformat = dateonly
        )
        Version_Number
        Source_Action
    )
    filters
    (
        Assessment
        Document_Type
        Uploaded_By
        Upload_Date
        Source_Action
    )
    sort by
    (
        Assessment ascending
        Version_Number descending
        Upload_Date descending
    )
}
