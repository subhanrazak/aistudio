report All_Assessment_Responses
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Assessment
                    Category_Snapshot
                    Question_Text_Snapshot
                    Answer_Type_Snapshot
                    Normalized_Answer
                    Row_Status
                    Completed_Mode
                    Submitted_At
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Assessment
                    Category_Snapshot
                    Category_Display_Order
                    Question_Text_Snapshot
                    Question_Display_Order
                    Answer_Type_Snapshot
                    Normalized_Answer
                    Row_Status
                    Completed_Mode
                    Submitted_At
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
