form Assessment_Responses
{
    displayname = "Assessment Responses"

    Response_Context
    (
        type = section
        displayname = "Response Context"
        row = 1
        column = 0
    )

    must have Assessment
    (
        type = picklist
        displayname = "Assessment"
        values = Assessments.ID
        displayformat = [Assessment_Reference]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Question_Bank_Question
    (
        type = picklist
        displayname = "Question Bank Question"
        values = Questions.ID
        displayformat = [Question_Text]
        searchable = true
        row = 1
        column = 1
        width = medium
    )

    Category_Snapshot
    (
        type = text
        displayname = "Category Snapshot"
        row = 1
        column = 1
        width = medium
    )

    Category_Display_Order
    (
        type = number
        displayname = "Category Display Order"
        row = 1
        column = 1
        width = medium
    )

    Question_Text_Snapshot
    (
        type = textarea
        displayname = "Question Snapshot"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    Question_Display_Order
    (
        type = number
        displayname = "Question Display Order"
        row = 1
        column = 1
        width = medium
    )

    Industry_Type_Snapshot
    (
        type = text
        displayname = "Industry Type Snapshot"
        row = 1
        column = 1
        width = medium
    )

    Answer_Type_Snapshot
    (
        type = picklist
        displayname = "Answer Type Snapshot"
        values = {"Single-Line Text","Paragraph","Dropdown","Multi-Select","Rating/Scale","Yes-No"}
        row = 1
        column = 1
        width = medium
    )

    Option_Values_Snapshot
    (
        type = textarea
        displayname = "Option Values Snapshot"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    Mandatory_Snapshot
    (
        type = checkbox
        displayname = "Mandatory Snapshot"
        row = 1
        column = 1
        width = medium
    )

    Answer_Section
    (
        type = section
        displayname = "Answer"
        visibility = true
        row = 2
        column = 1
    )

    Single_Line_Answer
    (
        type = text
        displayname = "Single Line Answer"
        maxchar = 255
        row = 2
        column = 1
        width = medium
    )

    Paragraph_Answer
    (
        type = textarea
        displayname = "Paragraph Answer"
        height = 120px
        row = 2
        column = 1
        width = medium
    )

    Dropdown_Answer
    (
        type = picklist
        displayname = "Dropdown Answer"
        values = {"Not Applicable"}
        row = 2
        column = 1
        width = medium
    )

    Multi_Select_Answer
    (
        type = list
        displayname = "Multi Select Answer"
        values = {"Not Applicable"}
        height = 80px
        row = 2
        column = 1
        width = medium
    )

    Rating_Answer
    (
        type = number
        displayname = "Rating Answer"
        row = 2
        column = 1
        width = medium
    )

    Yes_No_Answer
    (
        type = picklist
        displayname = "Yes No Answer"
        values = {"Yes","No"}
        row = 2
        column = 1
        width = medium
    )

    Normalized_Answer
    (
        type = textarea
        displayname = "Normalized Answer"
        height = 100px
        row = 2
        column = 1
        width = medium
    )

    Submission_Metadata
    (
        type = section
        displayname = "Submission Metadata"
        visibility = true
        row = 3
        column = 1
    )

    Completed_By_Name
    (
        type = text
        displayname = "Completed By Name"
        personal data = true
        row = 3
        column = 1
        width = medium
    )

    Completed_By_Email
    (
        type = email
        displayname = "Completed By Email"
        personal data = true
        row = 3
        column = 1
        width = medium
    )

    Completed_Mode
    (
        type = picklist
        displayname = "Completed Mode"
        values = {"Internal","External"}
        row = 3
        column = 1
        width = medium
    )

    Submitted_At
    (
        type = datetime
        displayname = "Submitted At"
        row = 3
        column = 1
        width = medium
    )

    Row_Status
    (
        type = picklist
        displayname = "Row Status"
        values = {"Draft","Answered","Submitted"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
