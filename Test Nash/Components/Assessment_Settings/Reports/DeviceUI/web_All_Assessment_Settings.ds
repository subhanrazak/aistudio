report All_Assessment_Settings
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Setting_Name
                    Default_Validity_Months
                    Reminder_Days_Before_Expiry
                    Notify_Customer_On_Expiry
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Setting_Name
                    Default_Validity_Months
                    Reminder_Days_Before_Expiry
                    Notify_Customer_On_Expiry
                    Branding_Name
                    Active
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
