form Assessment_Settings
{
    displayname = "Assessment Settings"

    Validity_Settings
    (
        type = section
        displayname = "Validity Settings"
        row = 1
        column = 0
    )

    must have unique Setting_Name
    (
        type = text
        displayname = "Setting Name"
        maxchar = 100
        initial value = "Default"
        row = 1
        column = 1
        width = medium
    )

    Default_Validity_Months
    (
        type = number
        displayname = "Default Validity Months"
        initial value = 3
        row = 1
        column = 1
        width = medium
    )

    Reminder_Days_Before_Expiry
    (
        type = number
        displayname = "Reminder Days Before Expiry"
        initial value = 15
        row = 1
        column = 1
        width = medium
    )

    Notify_Customer_On_Expiry
    (
        type = checkbox
        displayname = "Notify Customer On Expiry"
        initial value = true
        row = 1
        column = 1
        width = medium
    )

    Branding_Section
    (
        type = section
        displayname = "Branding"
        visibility = true
        row = 2
        column = 1
    )

    Branding_Name
    (
        type = text
        displayname = "Branding Name"
        initial value = "Kannanware"
        row = 2
        column = 1
        width = medium
    )

    Logo_URL
    (
        type = url
        displayname = "Logo URL"
        row = 2
        column = 1
        width = medium
    )

    Report_Header_Text
    (
        type = text
        displayname = "Report Header Text"
        initial value = "Current State Assessment Report"
        row = 2
        column = 1
        width = medium
    )

    Report_Footer_Text
    (
        type = text
        displayname = "Report Footer Text"
        initial value = "Confidential - Kannanware"
        row = 2
        column = 1
        width = medium
    )

    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
