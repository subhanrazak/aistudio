form Customers
{
    displayname = "Customers"

    Customer_Details
    (
        type = section
        displayname = "Customer Details"
        row = 1
        column = 0
    )

    must have unique Customer_Name
    (
        type = text
        displayname = "Customer Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )

    Primary_Contact_Name
    (
        type = text
        displayname = "Primary Contact Name"
        maxchar = 150
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    Primary_Contact_Email
    (
        type = email
        displayname = "Primary Contact Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    Primary_Contact_Phone
    (
        type = phonenumber
        displayname = "Primary Contact Phone"
        personal data = true
        row = 1
        column = 1
        width = medium
    )

    Customer_Status
    (
        type = picklist
        displayname = "Customer Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
