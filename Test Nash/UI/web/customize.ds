customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header,.zc-menu-header{background:#083D56;} .zc-button-primary,.zc-primary{background:#0E7C86;border-color:#0E7C86;} .zc-report-title,.zc-page-title{color:#083D56;}"
    }
}
