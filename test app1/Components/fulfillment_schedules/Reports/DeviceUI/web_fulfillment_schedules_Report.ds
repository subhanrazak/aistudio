report fulfillment_schedules_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								order as "Order"
								scheduled_ship_date as "Scheduled Ship Date"
								scheduled_carrier as "Scheduled Carrier"
								estimated_delivery_date as "Estimated Delivery Date"
								status as "Status"
								priority as "Priority"
								notes as "Notes"
								planned_dispatch_time as "Planned Dispatch Time"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
								order as "Order"
								scheduled_ship_date as "Scheduled Ship Date"
								scheduled_carrier as "Scheduled Carrier"
								estimated_delivery_date as "Estimated Delivery Date"
								status as "Status"
								priority as "Priority"
								notes as "Notes"
								planned_dispatch_time as "Planned Dispatch Time"
							)
						)
						datablock2
						(
		     				title = "Scheduled Carrier"
		     				related field = scheduled_carrier
							fields
							(
								area_id as "Area Id"
								code_name as "Code Name"
								company_id as "Company Id"
								email as "Email"
								name as "Name"
								personal_id as "Personal ID"
								phone_number as "Phone Number"
							)
						)
						datablock3
						(
		     				title = "Order"
		     				related field = order
							fields
							(
								order_id as "Order ID"
								customer as "Customer"
								salesperson as "Salesperson"
								order_date as "Order Date"
								expected_shipment_date as "Expected Shipment Date"
								status as "Status"
								priority as "Priority"
								total_amount as "Total Amount"
								currency as "Currency"
								fulfillment_status as "Fulfillment Status"
								tracking_number as "Tracking Number"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
							)
						)
				)
			
}