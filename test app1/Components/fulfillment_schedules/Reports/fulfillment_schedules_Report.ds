list fulfillment_schedules_Report
{

			displayName = "Fulfillment Schedules Report"
			show all rows from fulfillment_schedules    
			(
				order as "Order"
				scheduled_ship_date as "Scheduled Ship Date"
				scheduled_carrier as "Scheduled Carrier"
				estimated_delivery_date as "Estimated Delivery Date"
				status as "Status"
				priority as "Priority"
				notes as "Notes"
				planned_dispatch_time as "Planned Dispatch Time"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Delivered")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Failed")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "In Transit")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		
}