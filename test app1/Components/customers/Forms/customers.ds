	 			row = 1
	 			column = 1   
				width = medium
			)
			company_name
			(
    			type = text
				displayname = "Company Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			country_code
			(
    			type = text
				displayname = "Country Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have customer_display_name
			(
    			type = text
				displayname = "Customer Display Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_email
			(
    			type = email
				displayname = "Customer Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_mobile
			(
    			type = text
				displayname = "Customer Mobile"
	 			row = 1
	 			column = 1   
				width = medium
			)
			customer_phone
			(
    			type = text
				displayname = "Customer Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			exchange_rate
			(
				type = decimal
				displayname = "Exchange Rate"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			facebook
			(
    			type = text
				displayname = "Facebook"
	 			row = 1
	 			column = 1   
				width = medium
			)
			first_name1
			(
    			type = text
				displayname = "First Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gst_number
			(
    			type = text
				displayname = "GST Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_time
			(
    			type = datetime
				displayname = "Last Modified Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_name1
			(
    			type = text
				displayname = "Last Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			legal_name
			(
    			type = text
				displayname = "Legal Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			outstanding_receivables
			(
				type = decimal
				displayname = "Outstanding Receivables"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			pan
			(
    			type = text
				displayname = "PAN"
	 			row = 1
	 			column = 1   
				width = medium
			)
			portal_language
			(
    			type = text
				displayname = "Portal Language"
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_address
			(
    			type = textarea
				displayname = "Shipping Address - Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_attention
			(
    			type = text
				displayname = "Shipping Address - Attention"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_city
			(
    			type = text
				displayname = "Shipping Address - City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_country
			(
    			type = text
				displayname = "Shipping Address - Country"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_fax
			(
    			type = text
				displayname = "Shipping Address - Fax"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_phone
			(
    			type = text
				displayname = "Shipping Address - Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_pin_code
			(
    			type = text
				displayname = "Shipping Address - Pin Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_state
			(
    			type = text
				displayname = "Shipping Address - State"
	 			row = 1
	 			column = 1   
				width = medium
			)
			shipping_address_street2
			(
    			type = text
				displayname = "Shipping Address - Street2"
	 			row = 1
	 			column = 1   
				width = medium
			)
			tax_registration_number
			(
    			type = text
				displayname = "Tax Registration Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			twitter
			(
    			type = text
				displayname = "Twitter"
	 			row = 1
	 			column = 1   
				width = medium
			)
			unused_credits
			(
				type = decimal
				displayname = "Unused Credits"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			vat_registartion_number
			(
    			type = text
				displayname = "VAT Registration Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}