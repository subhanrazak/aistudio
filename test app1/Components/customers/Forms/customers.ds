form customers
{

			displayname = "Customers"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			avatax_exempt_number
			(
    			type = text
				displayname = "Avatax Exempt Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			avatax_use_code
			(
    			type = text
				displayname = "Avatax Use Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_address
			(
    			type = textarea
				displayname = "Billing Address - Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_attention
			(
    			type = text
				displayname = "Billing Address - Attention"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_city
			(
    			type = text
				displayname = "Billing Address - City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_country
			(
    			type = text
				displayname = "Billing Address - Country"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_fax
			(
    			type = text
				displayname = "Billing Address - Fax"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_phone
			(
    			type = text
				displayname = "Billing Address - Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_pin_code
			(
    			type = text
				displayname = "Billing Address - Pin Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_state
			(
    			type = text
				displayname = "Billing Address - State"
	 			row = 1
	 			column = 1   
				width = medium
			)
			billing_address_street2
			(
    			type = text
