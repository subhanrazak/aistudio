list payment_records_Report
{

			displayName = "Payment Records Report"
			show all rows from payment_records    
			(
				order as "Order"
				payment_method as "Payment Method"
				amount as "Amount"
				(
					display = total,average,min,max	
				)
				currency as "Currency"
				payment_date as "Payment Date"
				status as "Status"
				transaction_id as "Transaction ID"
				reference_number as "Reference Number"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (payment_method == "Bank Transfer")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (payment_method == "Card")
				fields = [payment_method]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (payment_method == "Cash")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (payment_method == "Stripe")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		
}