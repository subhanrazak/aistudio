list inventory_Report
{

			displayName = "Inventory Report"
			show all rows from inventory    
			(
				product as "Product"
				warehouse as "Warehouse"
				current_stock as "Current Stock"
				reorder_point as "Reorder Point"
				last_updated as "Last Updated"
				available_stock as "Available Stock"
				reserved_stock as "Reserved Stock"
				unit_of_measure as "Unit of Measure"
				location as "Location"
			)
		
}