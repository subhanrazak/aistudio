form inventory
{

			displayname = "Inventory"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			product
			(
				type = picklist	
				displayname = "Product"
				values  = items.ID
    			displayformat = [name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			warehouse
			(
				type = picklist	
				displayname = "Warehouse"
				values  = transfer_orders.ID
    			displayformat = [created_by]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_stock
			(
				type = number
				displayname = "Current Stock"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			reorder_point
			(
				type = number
				displayname = "Reorder Point"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_stock
			(
				type = number
				displayname = "Available Stock"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			reserved_stock
			(
				type = number
				displayname = "Reserved Stock"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			unit_of_measure
			(
    			type = text
				displayname = "Unit of Measure"
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
    			type = text
				displayname = "Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}