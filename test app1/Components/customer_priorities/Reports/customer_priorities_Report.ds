list customer_priorities_Report
{

			displayName = "Customer Priorities Report"
			show all rows from customer_priorities    
			(
				customer as "Customer"
				priority_level as "Priority Level"
				effective_from as "Effective From"
				effective_to as "Effective To"
				updated_by as "Updated By"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority_level == "Preferred")
				fields = [priority_level]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority_level == "Standard")
				fields = [priority_level]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		
}