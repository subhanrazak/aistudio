form order_items
{

			displayname = "Order Items"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order
			(
				type = list	
				displayname = "Order"
				values  = orders.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			product
			(
				type = picklist	
				displayname = "Product"
				values  = items.ID
    			displayformat = [name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			quantity
			(
				type = number
				displayname = "Quantity"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			unit_price
			(
				displayname = "Unit Price"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			discount_amount
			(
				displayname = "Discount Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			line_total
			(
				displayname = "Line Total"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			tax_rate
			(
    			type = percentage
				displayname = "Tax Rate"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			fulfilled_quantity
			(
				type = number
				displayname = "Fulfilled Quantity"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}