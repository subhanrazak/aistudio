list sales_orders_Report
{

			displayName = "Sales Orders Report"
			show all rows from sales_orders    
			(
				created_time as "Created Time"
				currency as "Currency"
				customer_name as "Customer Name"
				delivery_method as "Delivery Method"
				expected_shipment_date as "Expected Shipment Date"
				last_modified_time as "Last Modified Time"
				reference_number as "Reference Number"
				sales_order_date as "Sales Order Date"
				sales_order_number as "Sales Order Number"
				salesperson_name as "Salesperson Name"
				total as "Total"
			)
		
}