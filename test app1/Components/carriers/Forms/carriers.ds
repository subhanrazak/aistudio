form carriers
{

			displayname = "Carriers"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			area_id
			(
    			type = text
				displayname = "Area Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			code_name
			(
    			type = text
				displayname = "Code Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			company_id
			(
    			type = text
				displayname = "Company Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			personal_id
			(
    			type = text
				displayname = "Personal ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have phone_number
			(
    			type = text
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}