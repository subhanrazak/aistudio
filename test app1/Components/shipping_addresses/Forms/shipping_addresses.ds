form shipping_addresses
{

			displayname = "Shipping Addresses"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			order
			(
				type = list	
				displayname = "Order"
				values  = orders.ID
    			displayformat = [order_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address_line1
			(
    			type = text
				displayname = "Address Line 1"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address_line2
			(
    			type = text
				displayname = "Address Line 2"
	 			row = 1
	 			column = 1   
				width = medium
			)
			city
			(
    			type = text
				displayname = "City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			state
			(
    			type = text
				displayname = "State"
	 			row = 1
	 			column = 1   
				width = medium
			)
			postal_code1
			(
    			type = text
				displayname = "Postal Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			country1
			(
    			type = text
				displayname = "Country"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_default
			(
    			type = checkbox
				displayname = "Is Default"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}