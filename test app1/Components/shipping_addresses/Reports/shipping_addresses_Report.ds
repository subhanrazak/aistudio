list shipping_addresses_Report
{

			displayName = "Shipping Addresses Report"
			show all rows from shipping_addresses    
			(
				order as "Order"
				name as "Name"
				address_line1 as "Address Line 1"
				address_line2 as "Address Line 2"
				city as "City"
				state as "State"
				postal_code1 as "Postal Code"
				country1 as "Country"
				phone as "Phone"
				email as "Email"
				is_default as "Is Default"
			)
		
}