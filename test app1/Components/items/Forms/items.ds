form items
{

			displayname = "Items"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			brand
			(
    			type = text
				displayname = "Brand"
	 			row = 1
	 			column = 1   
				width = medium
			)
			cost_price
			(
				type = decimal
				displayname = "Cost Price"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			dimension_unit
			(
    			type = text
				displayname = "Dimension Unit"
	 			row = 1
	 			column = 1   
				width = medium
			)
			ean
			(
				type = number
				displayname = "EAN"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			height
			(
				type = decimal
				displayname = "Height"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			hsn_or_sac_code
			(
				type = number
				displayname = "HSN Or SAC Code"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			isbn
			(
    			type = text
				displayname = "ISBN"
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_time
			(
    			type = datetime
				displayname = "Last Modified Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			length_field
			(
				type = decimal
				displayname = "Length"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			manufacturer
			(
    			type = text
				displayname = "Manufacturer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			mpn
			(
    			type = text
				displayname = "MPN"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			opening_stock
			(
				type = decimal
