"Logistics Partner (Carrier)"
{

				name = "Logistics Partner (Carrier)"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Receive scheduled shipment details and dispatch instructions \n"
				ModulePermissions
				{
					carriers
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							carriers_Report={"View","Edit","Delete"}
						}
					}
					shipping_addresses
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							shipping_addresses_Report={"View"}
						}
					}
					order_status_logs
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_status_logs_by_status={"View","Edit","Delete"}
							order_status_logs_Report={"View","Edit","Delete"}
						}
					}
				}
			
}