"Sales Operations Manager"
{

				name = "Sales Operations Manager"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Review and confirm sales orders before processing \n"
				ModulePermissions
				{
					customers
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							customers_Report={"View"}
						}
					}
					customer_priorities
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							customer_priorities_Report={"View","Edit","Delete"}
							customer_priorities_by_priority_level={"View","Edit","Delete"}
						}
					}
					order_status_logs
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_status_logs_by_status={"View"}
							order_status_logs_Report={"View"}
						}
					}
					order_items
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_items_Report={"View"}
						}
					}
					sales_orders
					{
						enabled= Viewall,Modifyall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							sales_orders_Report={"View","Edit","Delete"}
						}
					}
					Admin_Dashboard
					{
						enabled = tab
					}
				}
			
}