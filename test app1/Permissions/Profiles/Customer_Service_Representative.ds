"Customer Service Representative"
{

				name = "Customer Service Representative"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Respond to customer inquiries about order status and delivery timelines \n"
				ModulePermissions
				{
					order_adjustments
					{
						enabled= Create,Viewall,Modifyall,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_adjustments_by_adjustment_type={"View","Edit","Delete"}
							order_adjustments_Report={"View","Edit","Delete"}
						}
					}
					orders
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							orders_by_status={"View"}
							orders_Report={"View"}
						}
					}
					customers
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							customers_Report={"View"}
						}
					}
					shipping_addresses
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							shipping_addresses_Report={"View"}
						}
					}
					order_status_logs
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_status_logs_by_status={"View","Edit","Delete"}
							order_status_logs_Report={"View","Edit","Delete"}
						}
					}
					Admin_Dashboard
					{
						enabled = tab
					}
				}
			
}