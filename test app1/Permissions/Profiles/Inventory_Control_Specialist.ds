"Inventory Control Specialist"
{

				name = "Inventory Control Specialist"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Monitor real-time inventory levels across all warehouses \n"
				ModulePermissions
				{
					orders
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							orders_by_status={"View"}
							orders_Report={"View"}
						}
					}
					inventory
					{
						enabled= Viewall,Modifyall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							inventory_Report={"View","Edit","Delete"}
						}
					}
					transfer_orders
					{
						enabled= Create,Viewall,Modifyall,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							transfer_orders_Report={"View","Edit","Delete"}
						}
					}
					order_items
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_items_Report={"View"}
						}
					}
					Admin_Dashboard
					{
						enabled = tab
					}
				}
			
}