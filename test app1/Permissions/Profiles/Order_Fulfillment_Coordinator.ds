"Order Fulfillment Coordinator"
{

				name = "Order Fulfillment Coordinator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Oversee the end-to-end fulfillment process for orders \n"
				ModulePermissions
				{
					fulfillment_schedules
					{
						enabled= Create,Viewall,Modifyall,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							fulfillment_schedules_Report={"View","Edit","Delete"}
							fulfillment_schedules_by_status={"View","Edit","Delete"}
						}
					}
					orders
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							orders_by_status={"View"}
							orders_Report={"View"}
						}
					}
					inventory
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							inventory_Report={"View"}
						}
					}
					shipping_addresses
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							shipping_addresses_Report={"View"}
						}
					}
					order_status_logs
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							order_status_logs_by_status={"View","Edit","Delete"}
							order_status_logs_Report={"View","Edit","Delete"}
						}
					}
				}
			
}