<page linkname = "DashBoard" displayname = "Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<row>
					<column width='75%'>
						<row>
							<column width='26%'>
								<file name:Panel_1.ds/>
							</column>
							<column width='26%'>
								<file name:Panel_2.ds/>
							</column>
							<column width='24%'>
								<file name:Panel_3.ds/>
							</column>
							<column width='24%'>
								<file name:Panel_4.ds/>
							</column>
						</row>
						<row>
							<column width='100%'>
								<file name:Grouped_Panel_1.ds/>
							</column>
						</row>
					</column>
					<column width='25%'>
						<row>
							<column width='100%'>
								<file name:Panel_Button_1.ds/>
							</column>
						</row>
						<row>
							<column width='100%'>
								<file name:Panel_Button_2.ds/>
							</column>
						</row>
						<row>
							<column width='100%'>
								<file name:Panel_Button_3.ds/>
							</column>
						</row>
						<row>
							<column width='100%'>
								<file name:Panel_Button_4.ds/>
							</column>
						</row>
					</column>
				</row>
				<row>
					<column width='50%'>
						<chart elementName='Chart 1' title='Reorder Point by Opening Stock' titleSize='15px' type='Scatter' xtitle='Reorder Point' ytitle='Opening Stock' bgColor='#FFFFFF' theme='theme' legendPos='none' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='items' xfield='reorder_point' yfields='value:opening_stock' groupBy='brand' DelugeCriteria='reorder_point is not null' /> </column>
					<column width='50%'>
						<chart elementName='Chart 2' title='Available Stock by Reorder Point' titleSize='15px' type='Scatter' xtitle='Available Stock' ytitle='Reorder Point' bgColor='#FFFFFF' theme='#198391' legendPos='none' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='inventory' xfield='available_stock' yfields='value:reorder_point' groupBy='product' DelugeCriteria='available_stock is not null' /> </column>
				</row>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:Report.ds/> </column>
		</row>
	</layout>
</zml>
</content>