<panel elementName='Panel 3'>
									<pr width='fill' height='fill'>
										<pc padding='20px' bgColor='#9366F9' width='100%' hAlign='left' vAlign='middle'>
											<pr width='auto' height='auto'>
												<pc padding='0px' hAlign='left'>
													<pr>
														<pc>
															<image marginLeft='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#AF8CFF' width='52px' height='52px' type='icon' value='business-percentage-39' size='22px' cornerRadius='10px' iconType='outline' /> </pc>
													</pr>
													<pr>
														<pc>
															<text marginTop='12px' color='#FFFFFF' size='24px' bold='true' type='Form Data' displayType='actual' decimalPlaces='2' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' value='thisapp.order_items.discount_amount.sum'>
															</text>

														</pc>
													</pr>
													<pr>
														<pc>
															<text marginTop='5px' color='#FFFFFF' size='15px' type='Text' value='Total Discount Amount'>
															</text>

														</pc>
													</pr>
												</pc>
											</pr>
										</pc>
									</pr>
</panel>