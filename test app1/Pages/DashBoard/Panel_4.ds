<panel elementName='Panel 4'>
									<pr width='fill' height='fill'>
										<pc padding='20px' bgColor='#734AD0' width='100%' hAlign='left' vAlign='middle'>
											<pr width='auto' height='auto'>
												<pc paddingTop='0px' paddingLeft='10px' paddingRight='0px' paddingBottom='0px' hAlign='left'>
													<pr>
														<pc>
															<image marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#9B69FB' width='52px' height='52px' type='icon' value='shopping-tag-sale' size='22px' cornerRadius='10px' iconType='outline' /> </pc>
													</pr>
													<pr>
														<pc>
															<text marginTop='12px' color='#FFFFFF' size='24px' bold='true' type='Form Data' displayType='actual' decimalPlaces='2' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' value='thisapp.order_items.unit_price.sum'>
															</text>

														</pc>
													</pr>
													<pr>
														<pc>
															<text marginTop='5px' color='#FFFFFF' size='15px' type='Text' value='Total Unit Price'>
															</text>

														</pc>
													</pr>
												</pc>
											</pr>
										</pc>
									</pr>
</panel>