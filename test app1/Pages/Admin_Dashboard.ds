<page linkname = "Admin_Dashboard" displayname = "Admin Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Admin_Hero' elementName='Admin_Hero'>
          <![CDATA[htmlpage Admin_Hero()
             content
             <%{%>
                 <file name:Admin_Hero.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='KPI_Cards' elementName='KPI_Cards'>
          <![CDATA[htmlpage KPI_Cards()
             content
             <%{%>
                 <file name:KPI_Cards.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Operations_Grid' elementName='Operations_Grid'>
          <![CDATA[htmlpage Operations_Grid()
             content
             <%{%>
                 <file name:Operations_Grid.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Activity_Table' elementName='Activity_Table'>
          <![CDATA[htmlpage Activity_Table()
             content
             <%{%>
                 <file name:Activity_Table.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Quick_Links' elementName='Quick_Links'>
          <![CDATA[htmlpage Quick_Links()
             content
             <%{%>
                 <file name:Quick_Links.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
