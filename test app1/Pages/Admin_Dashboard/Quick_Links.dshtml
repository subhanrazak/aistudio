<div class="admin-dashboard-scope admin-section">
  <div class="admin-shell">
    <section class="admin-card admin-glass">
      <div class="admin-card-header">
        <div>
          <h3 class="admin-card-title">Admin Shortcuts</h3>
          <div class="admin-card-subtitle">Fast access to operational forms and management reports</div>
        </div>
        <span class="admin-status-pill admin-badge-soft-blue"><i class="zc-li-outline ui-1-settings-gear-63"></i>Creator actions</span>
      </div>
      <div class="admin-links-grid">
        <a class="admin-link-tile" href="#Form:orders?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#38bdf8"><i class="zc-li-outline ui-1-simple-add"></i></span>
          <span><span class="admin-link-title">Add Order</span><span class="admin-link-helper">Create a sales order</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Form:inventory?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#2dd4bf"><i class="zc-li-outline shopping-stock"></i></span>
          <span><span class="admin-link-title">Add Inventory</span><span class="admin-link-helper">Register stock position</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Form:fulfillment_schedules?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#a78bfa"><i class="zc-li-outline business-notes"></i></span>
          <span><span class="admin-link-title">Add Fulfillment Schedule</span><span class="admin-link-helper">Plan dispatch activity</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Report:orders_Report?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#60a5fa"><i class="zc-li-outline files-2-doc"></i></span>
          <span><span class="admin-link-title">Orders Report</span><span class="admin-link-helper">Review order pipeline</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Report:inventory_Report?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#34d399"><i class="zc-li-outline shopping-label"></i></span>
          <span><span class="admin-link-title">Inventory Report</span><span class="admin-link-helper">Audit stock and reorder risk</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Report:payment_records_Report?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#fbbf24"><i class="zc-li-outline shopping-receipt"></i></span>
          <span><span class="admin-link-title">Payment Records Report</span><span class="admin-link-helper">Track collections and refunds</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
        <a class="admin-link-tile" href="#Report:customers_Report?zc_LoadIn=dialog&amp;zc_Header=true">
          <span class="admin-link-icon" style="--accent:#fb7185"><i class="zc-li-outline users-single-01"></i></span>
          <span><span class="admin-link-title">Customers Report</span><span class="admin-link-helper">View customer master data</span></span>
          <i class="admin-link-arrow zc-li-outline arrows-1-tail-right"></i>
        </a>
      </div>
    </section>
  </div>
</div>
