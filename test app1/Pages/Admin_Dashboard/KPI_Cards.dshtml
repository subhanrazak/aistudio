<%
totalOrderValue = ifnull(orders[ID != 0].sum(total_amount),0);
paymentRecordsCount = payment_records[ID != 0].count();
completedPaymentsCount = payment_records[status == "Completed"].count();
pendingPaymentsCount = payment_records[status == "Pending"].count();
lowStockInventoryCount = inventory[available_stock <= reorder_point].count();
scheduledFulfillmentCount = fulfillment_schedules[status == "Scheduled"].count();
%>
<div class="admin-dashboard-scope admin-section">
  <div class="admin-shell">
    <div class="admin-kpi-grid">
      <article class="admin-kpi-card admin-glass" style="--accent:#38bdf8;--accent-bg:rgba(56,189,248,.14);--accent-border:rgba(56,189,248,.28);--accent-glow:rgba(56,189,248,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline shopping-cart-simple"></i></div>
        <div class="admin-kpi-value">$<%=totalOrderValue%></div>
        <div class="admin-kpi-title">Total Order Value</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline arrows-1-tail-right"></i> Sum of orders.total_amount</div>
      </article>
      <article class="admin-kpi-card admin-glass" style="--accent:#a78bfa;--accent-bg:rgba(167,139,250,.14);--accent-border:rgba(167,139,250,.28);--accent-glow:rgba(167,139,250,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline shopping-receipt"></i></div>
        <div class="admin-kpi-value"><%=paymentRecordsCount%></div>
        <div class="admin-kpi-title">Payment Records</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline business-chart-bar-32"></i> Live operational volume</div>
      </article>
      <article class="admin-kpi-card admin-glass" style="--accent:#34d399;--accent-bg:rgba(52,211,153,.14);--accent-border:rgba(52,211,153,.28);--accent-glow:rgba(52,211,153,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline ui-1-check-circle-08"></i></div>
        <div class="admin-kpi-value"><%=completedPaymentsCount%></div>
        <div class="admin-kpi-title">Completed Payments</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline ui-2-small-add"></i> Confirmed payment status</div>
      </article>
      <article class="admin-kpi-card admin-glass" style="--accent:#fbbf24;--accent-bg:rgba(251,191,36,.14);--accent-border:rgba(251,191,36,.28);--accent-glow:rgba(251,191,36,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline ui-2-time"></i></div>
        <div class="admin-kpi-value"><%=pendingPaymentsCount%></div>
        <div class="admin-kpi-title">Pending Payments</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline ui-3-alert"></i> Static trend helper: monitor daily</div>
      </article>
      <article class="admin-kpi-card admin-glass" style="--accent:#fb7185;--accent-bg:rgba(251,113,133,.14);--accent-border:rgba(251,113,133,.28);--accent-glow:rgba(251,113,133,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline shopping-stock"></i></div>
        <div class="admin-kpi-value"><%=lowStockInventoryCount%></div>
        <div class="admin-kpi-title">Low-Stock Records</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline ui-3-alert"></i> available_stock at or below reorder_point</div>
      </article>
      <article class="admin-kpi-card admin-glass" style="--accent:#2dd4bf;--accent-bg:rgba(45,212,191,.14);--accent-border:rgba(45,212,191,.28);--accent-glow:rgba(45,212,191,.16);">
        <div class="admin-icon-orb"><i class="zc-li-outline business-notes"></i></div>
        <div class="admin-kpi-value"><%=scheduledFulfillmentCount%></div>
        <div class="admin-kpi-title">Scheduled Fulfillment</div>
        <div class="admin-kpi-helper"><i class="zc-li-outline arrows-1-tail-right"></i> Scheduled dispatch queue</div>
      </article>
    </div>
  </div>
</div>
