	menu
	{
	
				space Space
				{
					displayname = "Space"
					icon = "objects-spaceship"
	
					section Section_1
					{
						displayname = "Dashboard"
						icon = "ui-1-dashboard-half"
						page DashBoard
						{
							icon = "ui-1-dashboard-half"
						}
						page Admin_Dashboard
						{
							icon = "business-chart-bar-33"
						}
					}
					section Section_2
					{
						displayname = "Orders"
						icon = "shopping-list"
						form  orders
						{
							icon = "ui-1-bold-add"
						}
						report orders_Report
						{
							icon = "shopping-list"
						}
						report orders_by_status
						{
							icon = "business-pin"
						}
