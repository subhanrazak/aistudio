	pages
	{
		page Admin_Dashboard
		{
					displayname = "Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Admin_Hero' elementName='Admin_Hero'>\n\t\t\t\t\t<![CDATA[htmlpage Admin_Hero()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ntotalOrders = orders[ID != 0].count();\ntotalCustomers = customers[ID != 0].count();\ntotalItems = items[ID != 0].count();\ntotalInventoryRecords = inventory[ID != 0].count();\ntotalPaymentRecords = payment_records[ID != 0].count();\nlowStockCount = inventory[available_stock &lt;= reorder_point].count();\nactiveFulfillments = fulfillment_schedules[status == &quot;Scheduled&quot; || status == &quot;In Transit&quot;].count();\n%&gt;\n&lt;style&gt;\n/* ===== ZCS global utility sheet included once for Admin_Dashboard ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--column-gap: 0px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; --column-gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; --column-gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; --column-gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; --column-gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; --column-gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; --column-gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-p-25 { padding: 1.5625rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-14 { padding-left: .875rem; padding-right: .875rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-my-16 { margin-top: 1rem; margin-bottom: 1rem; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-full { border-radius: 100%; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-40 { font-size: 2.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* ===== ZCS component CSS: button-primary-button ===== */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* ===== ZCS component CSS: badge-filled-badge ===== */\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: #fff; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }\n\n/* ===== ZCS component CSS: table-simple-table ===== */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: #fff; overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }\n\n/* ===== ZCS component CSS: quick-actions-card-type-quick-actions ===== */\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }\n\n/* ===== ZCS component CSS: chart-donut-chart-with-text ===== */\n.zcs-legend-wrapper li { list-style-type: none; }\n.zcs-legend-wrapper li label { min-width: 120px; }\n.zcs-legend-wrapper li label:before { content: &apos;&apos;; display: inline-block; vertical-align: top; width: 12px; height: 12px; margin: 4px 12px 4px 0; border-radius: 50%; }\n.zcs-legend-wrapper li:nth-child(1) label:before { background-color: #2A6FFC; }\n.zcs-legend-wrapper li:nth-child(2) label:before { background-color: #A855F7; }\n.zcs-legend-wrapper li:nth-child(3) label:before { background-color: #14B8A6; }\n.zcs-legend-wrapper li:nth-child(4) label:before { background-color: #F59E0B; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg { width: var(--donut-donut_size); height: var(--donut-donut_size); overflow: hidden; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle { cx: var(--donut-cx); cy: var(--donut-cy); stroke-width: var(--donut-stroke_width); fill: transparent; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1) { stroke: #2A6FFC; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a1) / 100)); stroke-dashoffset: calc((2 * var(--donut-pi) * var(--donut-r)) / 4); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2) { stroke: #A855F7; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a2) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3) { stroke: #14B8A6; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a3) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4) { stroke: #F59E0B; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a4) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100)); }\n\n/* ===== ZCS component CSS: progress-bar-range-bar-with-text ===== */\n.zcs-progress-bar { height: 8px; background-color: rgba(148, 163, 184, .16); overflow: hidden; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n\n/* ===== Admin Dashboard executive-dark theme ===== */\n.zc-pb-page-content-wrapper div#zppagesLive,\n.zc-pb-page-content-wrapper div#elementsContainer,\n.zc-pb-page-content-wrapper .elemContainment,\n.zc-pb-page-content-wrapper .zcpage-elemContainer { height: 100%; background: #070b18 !important; }\n.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-container,\n.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { border-radius: 0 !important; background: transparent !important; box-shadow: none !important; }\n.zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,\n.zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment,\n.zc-pb-page-content-wrapper .zc-pb-tile-container { padding: 0 !important; }\n#splash-screen { display: none !important; }\n.admin-dashboard-scope { --admin-bg: #070b18; --admin-panel: rgba(15, 23, 42, .72); --admin-panel-strong: rgba(17, 24, 39, .88); --admin-border: rgba(148, 163, 184, .18); --admin-text: #f8fafc; --admin-muted: #94a3b8; --admin-soft: #cbd5e1; --admin-blue: #38bdf8; --admin-purple: #a78bfa; --admin-teal: #2dd4bf; --admin-green: #34d399; --admin-yellow: #fbbf24; --admin-red: #fb7185; font-family: Inter, Roboto, Arial, sans-serif; color: var(--admin-text); background: radial-gradient(circle at top left, rgba(56, 189, 248, .20), transparent 28%), radial-gradient(circle at 80% 8%, rgba(167, 139, 250, .20), transparent 32%), linear-gradient(135deg, #070b18 0%, #0f172a 48%, #111827 100%); box-sizing: border-box; }\n.admin-dashboard-scope * { box-sizing: border-box; }\n.admin-section { padding: 0 24px 24px; background: transparent; }\n.admin-section:first-child { padding-top: 24px; }\n.admin-shell { max-width: 1480px; margin: 0 auto; }\n.admin-glass { background: linear-gradient(145deg, rgba(15, 23, 42, .82), rgba(17, 24, 39, .58)); border: 1px solid var(--admin-border); box-shadow: 0 24px 70px rgba(0, 0, 0, .32); backdrop-filter: blur(18px); }\n.admin-hero { position: relative; overflow: hidden; border-radius: 28px; padding: 32px; }\n.admin-hero:before { content: &apos;&apos;; position: absolute; inset: -1px; background: radial-gradient(circle at 16% 0%, rgba(56, 189, 248, .24), transparent 32%), radial-gradient(circle at 100% 10%, rgba(167, 139, 250, .22), transparent 35%); pointer-events: none; }\n.admin-hero-content { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(320px, .9fr); gap: 28px; align-items: stretch; }\n.admin-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: #bae6fd; border: 1px solid rgba(56, 189, 248, .26); background: rgba(14, 165, 233, .10); padding: 7px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n.admin-hero h1 { margin: 16px 0 10px; font-size: clamp(34px, 4vw, 58px); line-height: .98; letter-spacing: -0.055em; }\n.admin-hero p { margin: 0; color: var(--admin-soft); font-size: 16px; max-width: 760px; }\n.admin-hero-metrics { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 12px; margin-top: 26px; }\n.admin-mini-metric { border-radius: 18px; padding: 16px; background: rgba(2, 6, 23, .45); border: 1px solid rgba(148, 163, 184, .14); }\n.admin-mini-metric .label, .admin-label { color: var(--admin-muted); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }\n.admin-mini-metric .value { display: block; margin-top: 7px; font-size: 28px; line-height: 1; font-weight: 800; letter-spacing: -.04em; }\n.admin-command-panel { border-radius: 24px; padding: 20px; background: rgba(2, 6, 23, .40); border: 1px solid rgba(148, 163, 184, .16); display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }\n.admin-command-panel h3 { margin: 0; font-size: 18px; }\n.admin-action-chips, .admin-chip-grid { display: flex; flex-wrap: wrap; gap: 10px; }\n.admin-chip, .admin-command-panel .zcs-button { border-radius: 999px; border: 1px solid rgba(148, 163, 184, .18); background: rgba(15, 23, 42, .80); color: var(--admin-text); min-height: 40px; }\n.admin-chip { display: inline-flex; align-items: center; gap: 8px; padding: 10px 13px; font-size: 13px; font-weight: 650; }\n.admin-chip:hover, .admin-command-panel .zcs-button:hover { border-color: rgba(56, 189, 248, .55); background: rgba(14, 165, 233, .16); color: #e0f2fe; }\n.admin-live-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }\n.admin-live-item { border-radius: 16px; padding: 12px; background: rgba(15, 23, 42, .52); border: 1px solid rgba(148, 163, 184, .12); }\n.admin-live-item strong { display: block; color: var(--admin-text); font-size: 18px; }\n.admin-kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(170px, 1fr)); gap: 16px; }\n.admin-kpi-card { min-height: 178px; border-radius: 24px; padding: 20px; position: relative; overflow: hidden; }\n.admin-kpi-card:after { content: &apos;&apos;; position: absolute; width: 140px; height: 140px; right: -52px; top: -52px; border-radius: 50%; background: var(--accent-glow, rgba(56, 189, 248, .16)); }\n.admin-icon-orb { width: 42px; height: 42px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: var(--accent-bg, rgba(56, 189, 248, .14)); color: var(--accent, #38bdf8); border: 1px solid var(--accent-border, rgba(56, 189, 248, .24)); }\n.admin-kpi-value { margin: 16px 0 4px; font-size: 30px; line-height: 1; font-weight: 850; letter-spacing: -.04em; }\n.admin-kpi-title { color: var(--admin-soft); font-size: 13px; font-weight: 700; }\n.admin-kpi-helper { color: var(--admin-muted); font-size: 12px; margin-top: 13px; display: flex; align-items: center; gap: 6px; }\n.admin-dashboard-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; }\n.admin-card { border-radius: 24px; padding: 20px; }\n.admin-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }\n.admin-card-title { margin: 0; color: var(--admin-text); font-size: 18px; font-weight: 800; letter-spacing: -.02em; }\n.admin-card-subtitle { color: var(--admin-muted); font-size: 12px; margin-top: 4px; }\n.admin-status-list { display: flex; flex-direction: column; gap: 13px; }\n.admin-status-row { display: grid; grid-template-columns: minmax(118px, 1fr) minmax(0, 2fr) 52px; align-items: center; gap: 12px; }\n.admin-status-name { color: var(--admin-soft); font-size: 13px; display: flex; align-items: center; gap: 8px; }\n.admin-dot { width: 9px; height: 9px; border-radius: 999px; background: var(--dot, #38bdf8); box-shadow: 0 0 18px var(--dot, #38bdf8); }\n.admin-bar { height: 10px; border-radius: 999px; background: rgba(148, 163, 184, .13); overflow: hidden; }\n.admin-bar &gt; span { display: block; height: 100%; width: var(--bar-width, 0%); border-radius: inherit; background: linear-gradient(90deg, var(--bar-from, #38bdf8), var(--bar-to, #a78bfa)); }\n.admin-status-count { color: var(--admin-text); text-align: right; font-weight: 750; }\n.admin-donut-card { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 16px; align-items: center; }\n.admin-donut-card .zcs-donut-chart-wrapper { padding: 0; gap: 14px; justify-content: flex-start; --donut-cx: 82px; --donut-cy: 82px; --donut-r: 68; --donut-stroke_width: 16; --donut-pi: 3.14; --donut-donut_size: 164px; }\n.admin-donut-card .zcs-donut-chart-name { width: 96px; color: var(--admin-text); left: 34px; top: 58px; }\n.admin-donut-card .zcs-legend-wrapper label { color: var(--admin-soft); }\n.admin-risk-list { display: flex; flex-direction: column; gap: 10px; }\n.admin-risk-row { display: grid; grid-template-columns: minmax(0, 1fr) 90px 90px 94px; gap: 10px; align-items: center; padding: 12px; border-radius: 16px; background: rgba(2, 6, 23, .36); border: 1px solid rgba(148, 163, 184, .12); }\n.admin-risk-product { color: var(--admin-text); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.admin-risk-meta { color: var(--admin-muted); font-size: 12px; }\n.admin-empty { border: 1px dashed rgba(148, 163, 184, .28); color: var(--admin-muted); border-radius: 18px; padding: 22px; text-align: center; }\n.admin-activity-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }\n.admin-table-card { padding: 0; overflow: hidden; border-radius: 24px; }\n.admin-table-card .admin-card-header { padding: 20px 20px 0; }\n.admin-table-card .zcs-table-wrapper { border: 0; background: transparent; border-radius: 0; }\n.admin-table-card table th { color: #93c5fd !important; background: rgba(15, 23, 42, .78) !important; border-color: rgba(148, 163, 184, .12) !important; }\n.admin-table-card table td { color: var(--admin-soft) !important; border-color: rgba(148, 163, 184, .10) !important; background: rgba(2, 6, 23, .16); }\n.admin-table-card table tbody tr:hover td { background: rgba(14, 165, 233, .08) !important; }\n.admin-record-title { color: var(--admin-text); font-weight: 750; }\n.admin-record-muted { color: var(--admin-muted); font-size: 12px; }\n.admin-status-pill, .admin-table-card .zcs-badge { border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 750; display: inline-flex; align-items: center; gap: 6px; }\n.admin-table-mobile-cards { display: none; }\n.admin-links-grid { display: grid; grid-template-columns: repeat(7, minmax(150px, 1fr)); gap: 14px; }\n.admin-link-tile { min-height: 132px; border-radius: 22px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; color: var(--admin-text); background: linear-gradient(145deg, rgba(15, 23, 42, .78), rgba(30, 41, 59, .42)); border: 1px solid rgba(148, 163, 184, .16); transition: border-color .18s ease, transform .18s ease, background .18s ease; }\n.admin-link-tile:hover { transform: translateY(-2px); border-color: rgba(56, 189, 248, .48); background: linear-gradient(145deg, rgba(14, 165, 233, .15), rgba(30, 41, 59, .52)); }\n.admin-link-icon { width: 42px; height: 42px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: rgba(56, 189, 248, .12); color: var(--accent, #38bdf8); border: 1px solid rgba(56, 189, 248, .20); }\n.admin-link-title { font-size: 14px; font-weight: 800; margin-top: 14px; }\n.admin-link-helper { color: var(--admin-muted); font-size: 12px; margin-top: 4px; }\n.admin-link-arrow { color: var(--admin-muted); align-self: flex-end; }\n.admin-badge-soft-blue { background: rgba(56, 189, 248, .14); color: #bae6fd; border: 1px solid rgba(56, 189, 248, .24); }\n.admin-badge-soft-green { background: rgba(52, 211, 153, .14); color: #bbf7d0; border: 1px solid rgba(52, 211, 153, .24); }\n.admin-badge-soft-yellow { background: rgba(251, 191, 36, .14); color: #fde68a; border: 1px solid rgba(251, 191, 36, .24); }\n.admin-badge-soft-red { background: rgba(251, 113, 133, .14); color: #fecdd3; border: 1px solid rgba(251, 113, 133, .24); }\n.admin-badge-soft-purple { background: rgba(167, 139, 250, .14); color: #ddd6fe; border: 1px solid rgba(167, 139, 250, .24); }\n@media (max-width: 1280px) { .admin-kpi-grid { grid-template-columns: repeat(3, minmax(180px, 1fr)); } .admin-links-grid { grid-template-columns: repeat(4, minmax(150px, 1fr)); } }\n@media (max-width: 980px) { .admin-hero-content, .admin-dashboard-grid, .admin-activity-grid, .admin-donut-card { grid-template-columns: 1fr; } .admin-hero-metrics { grid-template-columns: repeat(2, 1fr); } .admin-links-grid { grid-template-columns: repeat(2, minmax(150px, 1fr)); } }\n@media (max-width: 720px) { .admin-section { padding: 0 14px 18px; } .admin-section:first-child { padding-top: 14px; } .admin-hero { padding: 22px; border-radius: 22px; } .admin-kpi-grid { grid-template-columns: 1fr; } .admin-hero-metrics { grid-template-columns: 1fr; } .admin-live-strip { grid-template-columns: 1fr; } .admin-risk-row { grid-template-columns: 1fr 1fr; } .admin-table-card .zcs-table-wrapper { display: none; } .admin-table-mobile-cards { display: grid; gap: 10px; padding: 0 16px 16px; } .admin-mobile-record { border: 1px solid rgba(148, 163, 184, .12); background: rgba(2, 6, 23, .32); border-radius: 16px; padding: 13px; } .admin-links-grid { grid-template-columns: 1fr; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;admin-dashboard-scope admin-section&quot;&gt;\n\t&lt;div class=&quot;admin-shell&quot;&gt;\n\t\t&lt;section class=&quot;admin-hero admin-glass&quot;&gt;\n\t\t\t&lt;div class=&quot;admin-hero-content&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-eyebrow&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\tExecutive operations cockpit\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;h1&gt;Admin Command Center&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Management visibility across sales orders, fulfillment schedules, payment health, inventory risk, and customer momentum from the operating data already in this app.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-hero-metrics&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mini-metric&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Total Orders&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;value&quot;&gt;&lt;%=totalOrders%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mini-metric&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Customers&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;value&quot;&gt;&lt;%=totalCustomers%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mini-metric&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Items&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;value&quot;&gt;&lt;%=totalItems%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mini-metric&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Inventory Records&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;value&quot;&gt;&lt;%=totalInventoryRecords%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;aside class=&quot;admin-command-panel&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-header&quot; style=&quot;margin-bottom:14px;&quot;&gt;\n\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h3&gt;Command shortcuts&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Creator links open core forms and reports without JavaScript&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;admin-status-pill admin-badge-soft-blue&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;%=zoho.currentdate%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-action-chips&quot;&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:orders?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Add Order&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;admin-chip&quot; href=&quot;#Report:orders_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;Orders Report&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;admin-chip&quot; href=&quot;#Report:inventory_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-stock&quot;&gt;&lt;/i&gt;Inventory&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;admin-chip&quot; href=&quot;#Report:payment_records_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-receipt&quot;&gt;&lt;/i&gt;Payments&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-live-strip&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-live-item&quot;&gt;&lt;span class=&quot;admin-label&quot;&gt;Low-stock watch&lt;/span&gt;&lt;strong&gt;&lt;%=lowStockCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-live-item&quot;&gt;&lt;span class=&quot;admin-label&quot;&gt;Active fulfillment&lt;/span&gt;&lt;strong&gt;&lt;%=activeFulfillments%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-live-item&quot;&gt;&lt;span class=&quot;admin-label&quot;&gt;Payment records&lt;/span&gt;&lt;strong&gt;&lt;%=totalPaymentRecords%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='KPI_Cards' elementName='KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage KPI_Cards()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ntotalOrderValue = ifnull(orders[ID != 0].sum(total_amount),0);\npaymentRecordsCount = payment_records[ID != 0].count();\ncompletedPaymentsCount = payment_records[status == &quot;Completed&quot;].count();\npendingPaymentsCount = payment_records[status == &quot;Pending&quot;].count();\nlowStockInventoryCount = inventory[available_stock &lt;= reorder_point].count();\nscheduledFulfillmentCount = fulfillment_schedules[status == &quot;Scheduled&quot;].count();\n%&gt;\n&lt;div class=&quot;admin-dashboard-scope admin-section&quot;&gt;\n\t&lt;div class=&quot;admin-shell&quot;&gt;\n\t\t&lt;div class=&quot;admin-kpi-grid&quot;&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#38bdf8;--accent-bg:rgba(56,189,248,.14);--accent-border:rgba(56,189,248,.28);--accent-glow:rgba(56,189,248,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;$&lt;%=totalOrderValue%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Total Order Value&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt; Sum of orders.total_amount&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#a78bfa;--accent-bg:rgba(167,139,250,.14);--accent-border:rgba(167,139,250,.28);--accent-glow:rgba(167,139,250,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-receipt&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;&lt;%=paymentRecordsCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Payment Records&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt; Live operational volume&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#34d399;--accent-bg:rgba(52,211,153,.14);--accent-border:rgba(52,211,153,.28);--accent-glow:rgba(52,211,153,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;&lt;%=completedPaymentsCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Completed Payments&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-small-add&quot;&gt;&lt;/i&gt; Confirmed payment status&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#fbbf24;--accent-bg:rgba(251,191,36,.14);--accent-border:rgba(251,191,36,.28);--accent-glow:rgba(251,191,36,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;&lt;%=pendingPaymentsCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Pending Payments&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Static trend helper: monitor daily&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#fb7185;--accent-bg:rgba(251,113,133,.14);--accent-border:rgba(251,113,133,.28);--accent-glow:rgba(251,113,133,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-stock&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;&lt;%=lowStockInventoryCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Low-Stock Records&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; available_stock at or below reorder_point&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t\t&lt;article class=&quot;admin-kpi-card admin-glass&quot; style=&quot;--accent:#2dd4bf;--accent-bg:rgba(45,212,191,.14);--accent-border:rgba(45,212,191,.28);--accent-glow:rgba(45,212,191,.16);&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-icon-orb&quot;&gt;&lt;i class=&quot;zc-li-outline business-notes&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-value&quot;&gt;&lt;%=scheduledFulfillmentCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-title&quot;&gt;Scheduled Fulfillment&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-helper&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt; Scheduled dispatch queue&lt;/div&gt;\n\t\t\t&lt;/article&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operations_Grid' elementName='Operations_Grid'>\n\t\t\t\t\t<![CDATA[htmlpage Operations_Grid()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ntotalOrders = orders[ID != 0].count();\ndraftOrders = orders[status == &quot;Draft&quot;].count();\ndeliveredOrders = orders[status == &quot;Delivered&quot;].count();\nshippedOrders = orders[status == &quot;Shipped&quot;].count();\nconfirmedOrders = orders[status == &quot;Confirmed&quot;].count();\ncancelledOrders = orders[status == &quot;Cancelled&quot;].count();\nprocessingOrders = orders[status == &quot;Processing&quot;].count();\nif(totalOrders &gt; 0)\n{\n\tdraftPct = (draftOrders * 100) / totalOrders;\n\tdeliveredPct = (deliveredOrders * 100) / totalOrders;\n\tshippedPct = (shippedOrders * 100) / totalOrders;\n\tconfirmedPct = (confirmedOrders * 100) / totalOrders;\n\tcancelledPct = (cancelledOrders * 100) / totalOrders;\n\tprocessingPct = (processingOrders * 100) / totalOrders;\n}\nelse\n{\n\tdraftPct = 0;\n\tdeliveredPct = 0;\n\tshippedPct = 0;\n\tconfirmedPct = 0;\n\tcancelledPct = 0;\n\tprocessingPct = 0;\n}\n\ntotalFulfillment = fulfillment_schedules[ID != 0].count();\nscheduledFulfillment = fulfillment_schedules[status == &quot;Scheduled&quot;].count();\ndeliveredFulfillment = fulfillment_schedules[status == &quot;Delivered&quot;].count();\ninTransitFulfillment = fulfillment_schedules[status == &quot;In Transit&quot;].count();\nfailedFulfillment = fulfillment_schedules[status == &quot;Failed&quot;].count();\nif(totalFulfillment &gt; 0)\n{\n\tscheduledFulfillmentPct = (scheduledFulfillment * 100) / totalFulfillment;\n\tdeliveredFulfillmentPct = (deliveredFulfillment * 100) / totalFulfillment;\n\tinTransitFulfillmentPct = (inTransitFulfillment * 100) / totalFulfillment;\n\tfailedFulfillmentPct = (failedFulfillment * 100) / totalFulfillment;\n}\nelse\n{\n\tscheduledFulfillmentPct = 0;\n\tdeliveredFulfillmentPct = 0;\n\tinTransitFulfillmentPct = 0;\n\tfailedFulfillmentPct = 0;\n}\n\ntotalPayments = payment_records[ID != 0].count();\nbankTransferPayments = payment_records[payment_method == &quot;Bank Transfer&quot;].count();\npaypalPayments = payment_records[payment_method == &quot;PayPal&quot;].count();\nstripePayments = payment_records[payment_method == &quot;Stripe&quot;].count();\ncashPayments = payment_records[payment_method == &quot;Cash&quot;].count();\ncardPayments = payment_records[payment_method == &quot;Card&quot;].count();\nif(totalPayments &gt; 0)\n{\n\tbankTransferPct = (bankTransferPayments * 100) / totalPayments;\n\tpaypalPct = (paypalPayments * 100) / totalPayments;\n\tstripePct = (stripePayments * 100) / totalPayments;\n\tcashPct = (cashPayments * 100) / totalPayments;\n\tcardPct = (cardPayments * 100) / totalPayments;\n}\nelse\n{\n\tbankTransferPct = 0;\n\tpaypalPct = 0;\n\tstripePct = 0;\n\tcashPct = 0;\n\tcardPct = 0;\n}\n%&gt;\n&lt;div class=&quot;admin-dashboard-scope admin-section&quot;&gt;\n\t&lt;div class=&quot;admin-shell&quot;&gt;\n\t\t&lt;div class=&quot;admin-dashboard-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Order Status Distribution&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Counts from orders.status&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-status-pill admin-badge-soft-blue&quot;&gt;&lt;%=totalOrders%&gt; orders&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-status-list&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#64748b&quot;&gt;&lt;/span&gt;Draft&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=draftPct%&gt;%;--bar-from:#64748b;--bar-to:#94a3b8;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=draftOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#34d399&quot;&gt;&lt;/span&gt;Delivered&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=deliveredPct%&gt;%;--bar-from:#10b981;--bar-to:#6ee7b7;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=deliveredOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#38bdf8&quot;&gt;&lt;/span&gt;Shipped&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=shippedPct%&gt;%;--bar-from:#0284c7;--bar-to:#38bdf8;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=shippedOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#a78bfa&quot;&gt;&lt;/span&gt;Confirmed&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=confirmedPct%&gt;%;--bar-from:#7c3aed;--bar-to:#c4b5fd;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=confirmedOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#fb7185&quot;&gt;&lt;/span&gt;Cancelled&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=cancelledPct%&gt;%;--bar-from:#e11d48;--bar-to:#fb7185;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=cancelledOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#fbbf24&quot;&gt;&lt;/span&gt;Processing&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=processingPct%&gt;%;--bar-from:#d97706;--bar-to:#fbbf24;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=processingOrders%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Fulfillment Status Distribution&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;ZCS donut-style block from fulfillment_schedules.status&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-status-pill admin-badge-soft-purple&quot;&gt;&lt;%=totalFulfillment%&gt; schedules&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-donut-card&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-p-20 zcs-box-border&quot; style=&quot;--donut-a1:&lt;%=scheduledFulfillmentPct%&gt;;--donut-a2:&lt;%=deliveredFulfillmentPct%&gt;;--donut-a3:&lt;%=inTransitFulfillmentPct%&gt;;--donut-a4:&lt;%=failedFulfillmentPct%&gt;;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t&lt;svg class=&quot;zcs-rounded-full&quot;&gt;&lt;circle r=&quot;68&quot;&gt;&lt;/circle&gt;&lt;circle r=&quot;68&quot;&gt;&lt;/circle&gt;&lt;circle r=&quot;68&quot;&gt;&lt;/circle&gt;&lt;circle r=&quot;68&quot;&gt;&lt;/circle&gt;&lt;/svg&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-donut-chart-name zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&quot;&gt;&lt;%=totalFulfillment%&gt;&lt;br&gt;total&lt;/h6&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Scheduled: &lt;strong&gt;&lt;%=scheduledFulfillment%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Delivered: &lt;strong&gt;&lt;%=deliveredFulfillment%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;In Transit: &lt;strong&gt;&lt;%=inTransitFulfillment%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Failed: &lt;strong&gt;&lt;%=failedFulfillment%&gt;&lt;/strong&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Payment Method Distribution&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Counts from payment_records.payment_method&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-status-pill admin-badge-soft-green&quot;&gt;&lt;%=totalPayments%&gt; payments&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-status-list&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#38bdf8&quot;&gt;&lt;/span&gt;Bank Transfer&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=bankTransferPct%&gt;%;--bar-from:#0284c7;--bar-to:#38bdf8;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=bankTransferPayments%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#a78bfa&quot;&gt;&lt;/span&gt;PayPal&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=paypalPct%&gt;%;--bar-from:#7c3aed;--bar-to:#c4b5fd;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=paypalPayments%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#2dd4bf&quot;&gt;&lt;/span&gt;Stripe&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=stripePct%&gt;%;--bar-from:#0f766e;--bar-to:#2dd4bf;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=stripePayments%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#fbbf24&quot;&gt;&lt;/span&gt;Cash&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=cashPct%&gt;%;--bar-from:#d97706;--bar-to:#fbbf24;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=cashPayments%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-status-row&quot;&gt;&lt;div class=&quot;admin-status-name&quot;&gt;&lt;span class=&quot;admin-dot&quot; style=&quot;--dot:#34d399&quot;&gt;&lt;/span&gt;Card&lt;/div&gt;&lt;div class=&quot;admin-bar&quot;&gt;&lt;span style=&quot;--bar-width:&lt;%=cardPct%&gt;%;--bar-from:#059669;--bar-to:#6ee7b7;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;admin-status-count&quot;&gt;&lt;%=cardPayments%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Inventory Risk Watch&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Up to 8 records where available_stock is at or below reorder_point&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;admin-status-pill admin-badge-soft-red&quot; href=&quot;#Report:inventory_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;Open report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-risk-list&quot;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\triskShown = 0;\n\t\t\t\t\tfor each invRec in inventory[available_stock &lt;= reorder_point] sort by available_stock asc\n\t\t\t\t\t{\n\t\t\t\t\t\tif(riskShown &lt; 8)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tproductName = &quot;Product not set&quot;;\n\t\t\t\t\t\t\tif(invRec.product != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tproductName = ifnull(invRec.product.name,&quot;Product &quot; + invRec.product);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tavailableQty = ifnull(invRec.available_stock,0);\n\t\t\t\t\t\t\treorderQty = ifnull(invRec.reorder_point,0);\n\t\t\t\t\t\t\triskClass = &quot;admin-badge-soft-yellow&quot;;\n\t\t\t\t\t\t\triskText = &quot;Watch&quot;;\n\t\t\t\t\t\t\tif(availableQty &lt;= 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\triskClass = &quot;admin-badge-soft-red&quot;;\n\t\t\t\t\t\t\t\triskText = &quot;Critical&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;admin-risk-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-risk-product&quot;&gt;&lt;%=productName%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-risk-meta&quot;&gt;Inventory ID &lt;%=invRec.ID%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;admin-risk-meta&quot;&gt;Available&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=availableQty%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;admin-risk-meta&quot;&gt;Reorder&lt;/span&gt;&lt;br&gt;&lt;strong&gt;&lt;%=reorderQty%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;admin-status-pill &lt;%=riskClass%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;%=riskText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\triskShown = riskShown + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(riskShown == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;&lt;div class=&quot;admin-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; No inventory records are currently below reorder point.&lt;/div&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Activity_Table' elementName='Activity_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Activity_Table()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;div class=&quot;admin-dashboard-scope admin-section&quot;&gt;\n\t&lt;div class=&quot;admin-shell&quot;&gt;\n\t\t&lt;div class=&quot;admin-activity-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;admin-table-card admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Recent Orders&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Latest records by order_date&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;admin-status-pill admin-badge-soft-blue&quot; href=&quot;#Report:orders_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;View all&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Order&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Date&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Total&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\torderShown = 0;\n\t\t\t\t\t\t\tfor each recentOrder in orders[ID != 0] sort by order_date desc\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(orderShown &lt; 6)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\torderLabel = ifnull(recentOrder.order_id,&quot;Order &quot; + recentOrder.ID);\n\t\t\t\t\t\t\t\t\torderDate = ifnull(recentOrder.order_date,&quot;No date&quot;);\n\t\t\t\t\t\t\t\t\tcustomerName = &quot;Unassigned&quot;;\n\t\t\t\t\t\t\t\t\tif(recentOrder.customer != null)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcustomerName = ifnull(recentOrder.customer.customer_display_name,&quot;Customer &quot; + recentOrder.customer);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\torderStatus = ifnull(recentOrder.status,&quot;Not set&quot;);\n\t\t\t\t\t\t\t\t\torderTotal = ifnull(recentOrder.total_amount,0);\n\t\t\t\t\t\t\t\t\tstatusClass = &quot;admin-badge-soft-blue&quot;;\n\t\t\t\t\t\t\t\t\tif(orderStatus == &quot;Delivered&quot; || orderStatus == &quot;Shipped&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;admin-badge-soft-green&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse if(orderStatus == &quot;Cancelled&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;admin-badge-soft-red&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse if(orderStatus == &quot;Processing&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;admin-badge-soft-yellow&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;admin-record-title&quot;&gt;&lt;%=orderLabel%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=orderDate%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=customerName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;admin-status-pill &lt;%=statusClass%&gt;&quot;&gt;&lt;%=orderStatus%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;$&lt;%=orderTotal%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\torderShown = orderShown + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(orderShown == 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14&quot;&gt;No orders found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-table-mobile-cards&quot;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tmobOrderShown = 0;\n\t\t\t\t\tfor each mobOrder in orders[ID != 0] sort by order_date desc\n\t\t\t\t\t{\n\t\t\t\t\t\tif(mobOrderShown &lt; 4)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmobOrderLabel = ifnull(mobOrder.order_id,&quot;Order &quot; + mobOrder.ID);\n\t\t\t\t\t\t\tmobCustomer = &quot;Unassigned&quot;;\n\t\t\t\t\t\t\tif(mobOrder.customer != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tmobCustomer = ifnull(mobOrder.customer.customer_display_name,&quot;Customer &quot; + mobOrder.customer);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;admin-mobile-record&quot;&gt;&lt;div class=&quot;admin-record-title&quot;&gt;&lt;%=mobOrderLabel%&gt;&lt;/div&gt;&lt;div class=&quot;admin-record-muted&quot;&gt;&lt;%=ifnull(mobOrder.order_date,&quot;No date&quot;)%&gt; · &lt;%=mobCustomer%&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px;&quot;&gt;&lt;span class=&quot;admin-status-pill admin-badge-soft-blue&quot;&gt;&lt;%=ifnull(mobOrder.status,&quot;Not set&quot;)%&gt;&lt;/span&gt; &lt;strong&gt;$&lt;%=ifnull(mobOrder.total_amount,0)%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\tmobOrderShown = mobOrderShown + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;admin-table-card admin-card admin-glass&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Recent Payments&lt;/h3&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Latest records by payment_date&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;admin-status-pill admin-badge-soft-green&quot; href=&quot;#Report:payment_records_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;View all&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Payment Date&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Order&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Method&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Amount&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\tpaymentShown = 0;\n\t\t\t\t\t\t\tfor each recentPayment in payment_records[ID != 0] sort by payment_date desc\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif(paymentShown &lt; 6)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tpaymentDate = ifnull(recentPayment.payment_date,&quot;No date&quot;);\n\t\t\t\t\t\t\t\t\tpaymentOrder = &quot;Unlinked&quot;;\n\t\t\t\t\t\t\t\t\tif(recentPayment.order != null)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpaymentOrder = recentPayment.order;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tpaymentMethod = ifnull(recentPayment.payment_method,&quot;Not set&quot;);\n\t\t\t\t\t\t\t\t\tpaymentAmount = ifnull(recentPayment.amount,0);\n\t\t\t\t\t\t\t\t\tpaymentStatus = ifnull(recentPayment.status,&quot;Not set&quot;);\n\t\t\t\t\t\t\t\t\tpaymentStatusClass = &quot;admin-badge-soft-blue&quot;;\n\t\t\t\t\t\t\t\t\tif(paymentStatus == &quot;Completed&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpaymentStatusClass = &quot;admin-badge-soft-green&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse if(paymentStatus == &quot;Failed&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpaymentStatusClass = &quot;admin-badge-soft-red&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse if(paymentStatus == &quot;Pending&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpaymentStatusClass = &quot;admin-badge-soft-yellow&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse if(paymentStatus == &quot;Refunded&quot;)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tpaymentStatusClass = &quot;admin-badge-soft-purple&quot;;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=paymentDate%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;admin-record-title&quot;&gt;&lt;%=paymentOrder%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=paymentMethod%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;$&lt;%=paymentAmount%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;admin-status-pill &lt;%=paymentStatusClass%&gt;&quot;&gt;&lt;%=paymentStatus%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\tpaymentShown = paymentShown + 1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(paymentShown == 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14&quot;&gt;No payment records found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-table-mobile-cards&quot;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tmobPaymentShown = 0;\n\t\t\t\t\tfor each mobPayment in payment_records[ID != 0] sort by payment_date desc\n\t\t\t\t\t{\n\t\t\t\t\t\tif(mobPaymentShown &lt; 4)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;admin-mobile-record&quot;&gt;&lt;div class=&quot;admin-record-title&quot;&gt;$&lt;%=ifnull(mobPayment.amount,0)%&gt; · &lt;%=ifnull(mobPayment.payment_method,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;admin-record-muted&quot;&gt;&lt;%=ifnull(mobPayment.payment_date,&quot;No date&quot;)%&gt; · &lt;%=ifnull(mobPayment.order,&quot;Unlinked&quot;)%&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px;&quot;&gt;&lt;span class=&quot;admin-status-pill admin-badge-soft-green&quot;&gt;&lt;%=ifnull(mobPayment.status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\tmobPaymentShown = mobPaymentShown + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Quick_Links' elementName='Quick_Links'>\n\t\t\t\t\t<![CDATA[htmlpage Quick_Links()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;div class=&quot;admin-dashboard-scope admin-section&quot;&gt;\n\t&lt;div class=&quot;admin-shell&quot;&gt;\n\t\t&lt;section class=&quot;admin-card admin-glass&quot;&gt;\n\t\t\t&lt;div class=&quot;admin-card-header&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;admin-card-title&quot;&gt;Admin Shortcuts&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;admin-card-subtitle&quot;&gt;Fast access to operational forms and management reports&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;admin-status-pill admin-badge-soft-blue&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-63&quot;&gt;&lt;/i&gt;Creator actions&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;admin-links-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Form:orders?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#38bdf8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Add Order&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Create a sales order&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Form:inventory?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#2dd4bf&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-stock&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Add Inventory&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Register stock position&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Form:fulfillment_schedules?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#a78bfa&quot;&gt;&lt;i class=&quot;zc-li-outline business-notes&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Add Fulfillment Schedule&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Plan dispatch activity&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Report:orders_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#60a5fa&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Orders Report&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Review order pipeline&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Report:inventory_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#34d399&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-label&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Inventory Report&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Audit stock and reorder risk&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Report:payment_records_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#fbbf24&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-receipt&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Payment Records Report&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;Track collections and refunds&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;admin-link-tile&quot; href=&quot;#Report:customers_Report?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;admin-link-icon&quot; style=&quot;--accent:#fb7185&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span&gt;&lt;span class=&quot;admin-link-title&quot;&gt;Customers Report&lt;/span&gt;&lt;span class=&quot;admin-link-helper&quot;&gt;View customer master data&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;i class=&quot;admin-link-arrow zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page DashBoard
