list Pending_PO_Approvals
{

			displayName = "Pending PO Approvals"
			show all rows from Purchase_Orders  [PO_Status == "Submitted for Approval"]  
			(
				PO_Number
				Vendor
				PO_Date
				Expected_Delivery_Date
				PO_Status
				Requested_By
				Approved_By
				Total_Amount
				Linked_Production
				Linked_Service
			)
			filters
			(
				Vendor
				PO_Status
				Requested_By
			)
			sort by
			(
				PO_Date descending
			)
		
}