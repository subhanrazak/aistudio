calendar PO_Receiving_Calendar
{

			displayName = "PO Receiving Calendar"
			show all rows from Purchase_Orders  [Expected_Delivery_Date is not null]  
			(
				PO_Number
				Vendor
				Expected_Delivery_Date
				PO_Status
				Requested_By
			)
			filters
			(
				Vendor
				PO_Status
				Requested_By
			)
			options
			(
				week start day = monday
				display field = PO_Number
				start date = Expected_Delivery_Date
			)
		
}