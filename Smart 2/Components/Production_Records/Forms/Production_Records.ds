form Production_Records
{

			displayname = "Production Records"
			Production_Details
			(
				type = section
				displayname = "Production Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Production_Code
			(
    			type = autonumber
				displayname = "Production Code"
				start index = 1901
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Order
			(
				type = picklist	
				displayname = "Customer Order"
				values  = Customer_Orders.ID
    			displayformat = [Order_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Order_Line
			(
				type = picklist	
				displayname = "Order Line"
				values  = Order_Line_Items.ID
    			displayformat = [Line_Number]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Product
			(
				type = picklist	
				values  = Product_Catalogue.ID
    			displayformat = [Product_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product_Description
			(
    			type = textarea
				displayname = "Product Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Colour
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = decimal
	 			row = 1
	 			column = 2   
				width = medium
			)
			Unit
			(
				type = picklist	
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Dimensions
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Planning_Status
			(
				type = section
				displayname = "Planning Status"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Manufacturing_Mode
			(
				type = picklist
				displayname = "Manufacturing Mode"
				maxchar = 100
				values = {"Manufacture","Purchase Finished Product"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Production_Status
			(
				type = picklist
				displayname = "Production Status"
				maxchar = 100
				values = {"Awaiting Green Light","Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","On Hold","Cancelled"}
				initial value = "Awaiting Green Light"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Priority_Sequence
			(
				type = number
				displayname = "Priority Sequence"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Suggested_Group_Key
			(
    			type = text
				displayname = "Suggested Group Key"
				maxchar = 150
	 			row = 2
	 			column = 2   
				width = medium
			)
			Manufacturing_Group
			(
				type = picklist	
				displayname = "Manufacturing Group"
				values  = Manufacturing_Groups.ID
    			displayformat = [Group_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Material_Status
			(
				type = picklist
				displayname = "Material Status"
				maxchar = 100
				values = {"Not Checked","Shortage Identified","Requested","Ordered","Received","Not Required"}
				initial value = "Not Checked"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Powder_Details
			(
				type = section
				displayname = "Powder Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Requires_Powder_Coating
			(
    			type = checkbox
				displayname = "Requires Powder Coating"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Powder
			(
				type = picklist	
				values  = Powder_Coating_Inventory.ID
    			displayformat = [Powder_Name]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Powder_Qty_Used
			(
				type = decimal
				displayname = "Powder Qty Used"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Powder_Coating_Status
			(
				type = picklist
				displayname = "Powder Coating Status"
				maxchar = 100
				values = {"Not Required","Pending","In Progress","Completed"}
	 			row = 3
	 			column = 2   
				width = medium
			)
			Powder_Consumption_Posted
			(
    			type = checkbox
				displayname = "Powder Consumption Posted"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Purchase_Readiness
			(
				type = section
				displayname = "Purchase Readiness"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Linked_PO
			(
				type = picklist	
				displayname = "Linked PO"
				values  = Purchase_Orders.ID
    			displayformat = [PO_Number]
	 			row = 4
	 			column = 1   
				width = medium
			)
			Material_Consumption_Posted
			(
    			type = checkbox
				displayname = "Material Consumption Posted"
				initial value = false
	 			row = 4
	 			column = 2   
				width = medium
			)
			Ready_For_Installation_Date
			(
    			type = date
				displayname = "Ready For Installation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Workshop_Notes
			(
    			type = textarea
				displayname = "Workshop Notes"
				height = 120px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Material_Usage_Section
			(
				type = section
				displayname = "Material Usage"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Materials_Usage
			(
				type = grid
				displayname = "Materials Usage"
				values  = Production_Material_Usage.ID
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}