list Ready_For_Installation_Items
{

			displayName = "Ready For Installation Items"
			show all rows from Production_Records  [Production_Status == "Ready for Installation" || Production_Status == "Purchased and Received"]  
			(
				Production_Code
				Customer_Order
				Order_Line
				Product
				Colour
				Quantity
				Manufacturing_Mode
				Production_Status
				Priority_Sequence
				Manufacturing_Group
				Material_Status
				Powder_Coating_Status
				Linked_PO
			)
			filters
			(
				Customer_Order
				Product
				Manufacturing_Mode
				Production_Status
				Manufacturing_Group
			)
			sort by
			(
				Priority_Sequence ascending
			)
		
}