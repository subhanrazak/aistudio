spreadsheet Production_Priority_Planner
{

			displayName = "Production Priority Planner"
			show all rows from Production_Records    
			(
				Production_Code
				Customer_Order
				Product
				Colour
				Quantity
				Production_Status
				Priority_Sequence
				Manufacturing_Group
			)
			filters
			(
				Customer_Order
				Product
				Production_Status
				Manufacturing_Group
			)
			sort by
			(
				Priority_Sequence ascending
			)
		
}