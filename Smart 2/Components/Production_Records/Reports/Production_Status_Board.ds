kanban Production_Status_Board
{

			displayName = "Production Status Board"
			show all rows from Production_Records    
			(
				Production_Code
				Customer_Order
				Product
				Colour
				Quantity
				Production_Status
				Priority_Sequence
				Manufacturing_Group
			)
			filters
			(
				Customer_Order
				Product
				Production_Status
				Manufacturing_Group
			)
			sort by
			(
				Priority_Sequence ascending
			)
			options
			(
	 			display field = Production_Status
				sort order  = custom
				record count  = enable
	 		)
		
}