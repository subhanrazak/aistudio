Target_Module_On_User_Input as "Target Module On User Input"
{

				type =  form
				form = Action_Comments

				record event = on add or edit

				on user input of Target_Module
				{
					actions 
					{
						custom deluge script
						(
											clear New_Status;
										if(input.Target_Module == "Customer_Orders")
										{
											input.New_Status:ui.add({"Green Light","On Hold","Cancelled"});
										}
										else if(input.Target_Module == "Production_Records")
										{
											input.New_Status:ui.add({"Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","On Hold","Cancelled"});
										}
										else if(input.Target_Module == "Purchase_Orders")
										{
											input.New_Status:ui.add({"Submitted for Approval","Approved","Ordered","Partially Received","Received","Cancelled"});
										}
										else if(input.Target_Module == "Installation_Schedules")
										{
											input.New_Status:ui.add({"Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"});
										}
										else if(input.Target_Module == "Permit_Records")
										{
											input.New_Status:ui.add({"Preparing","Submitted","Approved","Rejected","Expired","Not Required"});
										}
										else if(input.Target_Module == "Service_Requests")
										{
											input.New_Status:ui.add({"Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"});
										}
						)
					}
				}

			
}