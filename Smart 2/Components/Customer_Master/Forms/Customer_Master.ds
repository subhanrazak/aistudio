form Customer_Master
{

			displayname = "Customer Master"
			Customer_Details
			(
				type = section
				displayname = "Customer Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer_Code
			(
    			type = autonumber
				displayname = "Customer Code"
				start index = 1201
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Name
			(
    			type = text
				displayname = "Customer Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Person
			(
    			type = text
				displayname = "Contact Person"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
			)
			Alternate_Phone
			(
    			type = phonenumber
				displayname = "Alternate Phone"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Area_or_City
			(
    			type = text
				displayname = "Area / City"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Preferred_Contact_Method
			(
				type = picklist
				displayname = "Preferred Contact Method"
				maxchar = 100
				values = {"Phone","Email","WhatsApp","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			GST_or_Tax_Number
			(
    			type = text
				displayname = "GST / Tax Number"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Address_Details
			(
				type = section
				displayname = "Address Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Billing_Address
			(
    			type = address
				displayname = "Billing Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
			)
			Installation_Address
			(
    			type = address
				displayname = "Installation Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notes_Status
			(
				type = section
				displayname = "Notes Status"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}