Order_Line_Powder_Input as "Order Line Powder Input"
{

				type =  form
				form = Order_Line_Items

				record event = on add or edit

				on user input of Requires_Powder_Coating
				{
					actions 
					{
						custom deluge script
						(
											if(input.Requires_Powder_Coating == true)
										{
											show Powder;
											show Estimated_Powder_Qty;
										}
										else
										{
											hide Powder;
											hide Estimated_Powder_Qty;
											clear Powder;
										}
						)
					}
				}

			
}