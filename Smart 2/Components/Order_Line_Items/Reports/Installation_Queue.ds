list Installation_Queue
{

			displayName = "Installation Queue"
			show all rows from Order_Line_Items    
			(
				Customer_Order
				Line_Number
				Product
				Product_Description
				Colour
				Quantity
				Unit
				Manufacturing_Mode
				Production_Queue_No
				Installation_Queue_No
				Permit_Required
				custom action "Set Installation Queue"
				(
	  			workflow = Open_Set_Installation_Queue_Position
				column header = "Set Installation Queue"
				success message = "Opening queue position form..."
				)
			)
			filters
			(
				Customer_Order
				Product
				Manufacturing_Mode
				Permit_Required
			)
			sort by
			(
				Installation_Queue_No ascending
				Line_Number ascending
			)
		
}