form Create_Template
{

			displayname = "Create Template"
			success message = "Template Saved Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Email_For
			(
				type = picklist
				displayname = "Email For"
				maxchar = 100
				values = {"Order Update","Purchase Order","Service Request","Installation","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Title
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Template_Subject
			(
    			type = text
				displayname = "Template Subject"
				maxchar = 200
	 			row = 1
	 			column = 1   
				width = medium
			)
			Template
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Template_Notes
			(
    			type = plaintext
				value = "Use placeholders such as ${Order_Code}, ${Customer_Name}, ${PO_Number}, or ${Service_Code} where needed."
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}