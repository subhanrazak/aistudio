Validate_Product_BOM_Items as "Validate Product BOM Items"
{

				type =  form
				form = Product_BOM_Items

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Quantity_Per_Unit,0) < 0)
										{
											alert "Quantity per unit cannot be negative.";
											cancel submit;
										}
										if(ifnull(input.Wastage_Percent,0) < 0)
										{
											alert "Wastage percent cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}