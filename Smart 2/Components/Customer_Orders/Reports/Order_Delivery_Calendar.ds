calendar Order_Delivery_Calendar
{

			displayName = "Order Delivery Calendar"
			show all rows from Customer_Orders    
			(
				Order_Code
				Customer
				Expected_Delivery_Date
				Order_Status
				Area_or_City
			)
			filters
			(
				Customer
				Order_Status
				Area_or_City
			)
			options
			(
				week start day = monday
				display field = Order_Code
				start date = Expected_Delivery_Date
			)
		
}