form Customer_Orders
{

			displayname = "Customer Orders"
			Invoice_Details
			(
				type = section
				displayname = "Invoice Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_Code
			(
    			type = autonumber
				displayname = "Order Code"
				start index = 1701
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Zoho_Books_Invoice_Number
			(
    			type = text
				displayname = "Zoho Books Invoice Number"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Zoho_Books_Invoice_ID
			(
    			type = text
				displayname = "Zoho Books Invoice ID"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Zoho_Books_Invoice_URL
			(
    			type = url
				displayname = "Zoho Books Invoice URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer
			(
				type = picklist	
				values  = Customer_Master.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer_Name_Snapshot
			(
    			type = text
				displayname = "Customer Name Snapshot"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Phone
			(
    			type = phonenumber
				displayname = "Customer Phone"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer_Email
			(
    			type = email
				displayname = "Customer Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Area_or_City
			(
    			type = text
				displayname = "Area / City"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Dates_Status
			(
				type = section
				displayname = "Dates Status"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Invoice_Date
			(
    			type = date
				displayname = "Invoice Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Order_Placement_Date
			(
    			type = date
				displayname = "Order Placement Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Expected_Delivery_Date
			(
    			type = date
				displayname = "Expected Delivery Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Requires_Permit
			(
    			type = checkbox
				displayname = "Requires Permit"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Permit_Status
			(
				type = picklist
				displayname = "Permit Status"
				maxchar = 100
				values = {"Not Required","Required","Preparing","Submitted","Approved","Rejected","Expired"}
				initial value = "Not Required"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Order_Status
			(
				type = picklist
				displayname = "Order Status"
				maxchar = 100
				values = {"Awaiting Green Light","Green Light","In Production","Material Hold","Ready for Installation","Installation Scheduled","Installed","Inspection Required","Completed","On Hold","Cancelled"}
				initial value = "Awaiting Green Light"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Admin_Green_Light_Date
			(
    			type = date
				displayname = "Admin Green Light Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Address_Details
			(
				type = section
				displayname = "Address Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Billing_Address
			(
    			type = address
				displayname = "Billing Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
			)
			Installation_Address
			(
    			type = address
				displayname = "Installation Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 2   
				width = medium
			)
			Invoice_Amounts
			(
				type = section
				displayname = "Invoice Amounts"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Subtotal
			(
				type = decimal
	 			row = 4
	 			column = 1   
				width = medium
			)
			Discount_Total
			(
				type = decimal
				displayname = "Discount Total"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Tax_Total
			(
				type = decimal
				displayname = "Tax Total"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Shipping_or_Adjustment
			(
				type = decimal
				displayname = "Shipping / Adjustment"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Total_Amount
			(
				type = decimal
				displayname = "Total Amount"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Invoice_PDF
			(
    			type = upload file
				displayname = "Invoice PDF"
				browse = local_drive, google_docs, zoho_docs
	 			row = 4
	 			column = 2   
				width = medium
			)
			Order_Line_Items_Section
			(
				type = section
				displayname = "Order Line Items"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Line_Items
			(
				type = grid
				displayname = "Line Items"
				values  = Order_Line_Items.ID
				defaultrow = 1
				sorttype = fieldbased
				sort by
				(
					Line_Number ascending
				)
	 			row = 5
	 			column = 1   
				width = medium
			)
			Notes
			(
				type = section
				displayname = "Internal Notes"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Internal_Notes
			(
    			type = textarea
				displayname = "Internal Notes"
				height = 120px
	 			row = 6
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}