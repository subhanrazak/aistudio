default list All_Permit_Records
{

			displayName = "All Permit Records"
			show all rows from Permit_Records    
			(
				Permit_Code
				Customer_Order
				Customer
				Permit_Required
				Permit_Status
				Authority_Name
				Permit_Number
				Submitted_Date
				Approved_Date
				Expiry_Date
			)
			filters
			(
				Permit_Status
				Authority_Name
			)
			sort by
			(
				Submitted_Date descending
			)
		
}