Service_Parts_Usage_On_Validate as "Service Parts Usage On Validate"
{

				type =  form
				form = Service_Parts_Usage

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Quantity_Used,0) < 0)
										{
											alert "Quantity used cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}