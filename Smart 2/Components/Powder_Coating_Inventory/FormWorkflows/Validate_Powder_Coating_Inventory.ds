Validate_Powder_Coating_Inventory as "Validate Powder Coating Inventory"
{

				type =  form
				form = Powder_Coating_Inventory

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Available_Quantity,0) < 0)
										{
											alert "Available quantity cannot be negative.";
											cancel submit;
										}
										if(ifnull(input.Reorder_Level,0) < 0)
										{
											alert "Reorder level cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}