default list All_Powders
{

			displayName = "All Powders"
			show all rows from Powder_Coating_Inventory    
			(
				Powder_Code
				Powder_Name
				Colour_Family
				Vendor
				Stock_Unit
				Available_Quantity
				Reorder_Level
				Active
			)
			filters
			(
				Colour_Family
				Vendor
				Active
			)
			sort by
			(
				Powder_Name ascending
			)
		
}