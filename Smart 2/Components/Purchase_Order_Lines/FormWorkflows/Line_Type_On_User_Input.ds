Line_Type_On_User_Input as "Line Type On User Input"
{

				type =  form
				form = Purchase_Order_Lines

				record event = on add or edit

				on user input of Line_Type
				{
					actions 
					{
						custom deluge script
						(
											hide Material;
										hide Powder;
										hide Product;
										clear Material;
										clear Powder;
										clear Product;
										if(input.Line_Type == "Raw Material" || input.Line_Type == "Service Part")
										{
											show Material;
										}
										else if(input.Line_Type == "Powder")
										{
											show Powder;
										}
										else if(input.Line_Type == "Finished Product")
										{
											show Product;
										}
						)
					}
				}

			
}