Purchase_Order_Lines_On_Validate as "Purchase Order Lines On Validate"
{

				type =  form
				form = Purchase_Order_Lines

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Quantity,0) < 0 || ifnull(input.Unit_Rate,0) < 0 || ifnull(input.Line_Discount,0) < 0 || ifnull(input.Line_Tax,0) < 0 || ifnull(input.Line_Total,0) < 0 || ifnull(input.Received_Quantity,0) < 0)
										{
											alert "Quantities and amounts cannot be negative.";
											cancel submit;
										}
										if(input.Line_Type == "Raw Material" || input.Line_Type == "Service Part" && input.Material == null)
										{
											alert "Select a material for raw material or service part lines.";
											cancel submit;
										}
										if(input.Line_Type == "Powder" && input.Powder == null)
										{
											alert "Select a powder item for powder lines.";
											cancel submit;
										}
										if(input.Line_Type == "Finished Product" && input.Product == null)
										{
											alert "Select a product for finished product lines.";
											cancel submit;
										}
						)
					}
				}

			
}