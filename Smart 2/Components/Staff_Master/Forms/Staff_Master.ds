form Staff_Master
{

			displayname = "Staff Master"
			Staff_Details
			(
				type = section
				displayname = "Staff Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Staff_Code
			(
    			type = autonumber
				displayname = "Staff Code"
				start index = 1101
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Staff_Name
			(
    			type = text
				displayname = "Staff Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Role
			(
				type = picklist
				values = {"Office","Production","Purchase/Stores","Installation","Service","Admin","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			User_Email
			(
    			type = email
				displayname = "User Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}