form Product_Catalogue
{

			displayname = "Product Catalogue"
			Product_Details
			(
				type = section
				displayname = "Product Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Product_Code
			(
    			type = text
				displayname = "Product Code"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Name
			(
    			type = text
				displayname = "Product Name"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Product_Category
			(
				type = picklist
				displayname = "Product Category"
				maxchar = 100
				values = {"Roller Shutter","Security Shutter","Garage Shutter","Window Shutter","Door Shutter","Accessory","Service Part","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Manufacturing_Mode
			(
				type = picklist
				displayname = "Default Manufacturing Mode"
				maxchar = 100
				values = {"Manufacture","Purchase Finished Product","Either"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Colour_Required
			(
    			type = checkbox
				displayname = "Colour Required"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Standard_Colours
			(
    			type = textarea
				displayname = "Standard Colours"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Operational_Defaults
			(
				type = section
				displayname = "Operational Defaults"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Requires_Powder_Coating
			(
    			type = checkbox
				displayname = "Requires Powder Coating"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Default_Powder
			(
				type = picklist	
				displayname = "Default Powder"
				values  = Powder_Coating_Inventory.ID
    			displayformat = [Powder_Name]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Requires_Permit_By_Default
			(
    			type = checkbox
				displayname = "Requires Permit By Default"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Default_Install_Hours
			(
				type = decimal
				displayname = "Default Install Hours"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Default_Unit
			(
				type = picklist	
				displayname = "Default Unit"
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}