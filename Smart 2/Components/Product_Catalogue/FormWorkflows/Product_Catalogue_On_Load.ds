Product_Catalogue_On_Load as "Product Catalogue On Load"
{

				type =  form
				form = Product_Catalogue

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Requires_Powder_Coating == true)
										{
											show Default_Powder;
										}
										else
										{
											hide Default_Powder;
											clear Default_Powder;
										}
						)
					}
				}

			
}