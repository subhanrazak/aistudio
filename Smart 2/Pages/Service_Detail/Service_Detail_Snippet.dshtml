<%
	svc_rec = Service_Requests[ID == input.Service_ID];
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-danger-soft: #FFECEF; --zcs-warning-soft: #FFF6E3; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; --zcs-purple-soft: #F0ECFF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
a { text-decoration: none; }
.service-detail-page, .service-detail-page * { box-sizing: border-box; }
.service-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 24px; overflow: auto; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-5 { margin-top: .3125rem; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: #fff; }
/* ZCS Header, Button, Badge, Table, Timeline, No Data adaptations */
.zcs-page-header { border: 1px solid var(--zcs-border-color); border-radius: 18px; background: rgba(255,255,255,.88); box-shadow: 0 12px 32px rgba(16,24,40,.06); margin-bottom: 16px; }
.zcs-back { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.zcs-back:hover { background: var(--zcs-theme-brand-color); color: #fff; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }
.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-button { background-color: var(--zcs-theme-brand-color); border: 1px solid var(--zcs-theme-brand-color); color: #fff; }
.zcs-primary-button:hover { filter: brightness(.96); color: #fff; }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; }
.zcs-badge-filled { border: 1px solid transparent; color: #fff; }
.zcs-badge-filled-outline { border: 1px solid; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; }
.zcs-badge-filled.zcs-badge-grey { background-color: #5D6372; border-color: #5D6372; }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #EEF1F7; border-color: #5D6372; color: #5D6372; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 880px; }
.zcs-table-wrapper table thead { top: 0; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-nodata-wrapper { min-height: 104px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.zcs-tl-indicator { width: 60px; left: 16.6667%; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs-theme-brand-color); border: 1px solid #fff; box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-icon { width: 35px; height: 35px; background: #EEF1F7; color: #5D6372; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }
.zcs-tl-li-complete .zcs-tl-icon { background:#E4FCF3; color:#179E6C; }
.zcs-tl-li-active .zcs-tl-icon { background:var(--zcs-brand-soft); color:var(--zcs-theme-brand-color); animation: pulse-dot 1.25s cubic-bezier(.455,.03,.515,.955) -.4s infinite; }
@keyframes pulse-dot { 0% { transform: scale(.88); } 50% { transform: scale(1); } 100% { transform: scale(.88); } }
.service-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #18335C); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }
.service-hero:after { content: ''; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }
.service-hero-main, .service-hero-side { position: relative; z-index: 1; }
.service-hero-main { flex: 1 1 640px; min-width: 0; }
.service-hero-side { flex: 0 0 270px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 18px; padding: 16px; backdrop-filter: blur(10px); }
.service-kicker { letter-spacing: .08em; opacity: .78; }
.service-hero-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 6px 0 8px; }
.service-hero-subtitle { color: rgba(255,255,255,.82); margin: 0; max-width: 880px; }
.service-action-group { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; }
.service-action { min-width: auto; min-height: 31px; padding: 5px 10px; border-radius: 8px; font-size: 12px; line-height: 1.2; }
.service-action-triage { --action-soft:#F0ECFF; border-color:#7656D6; color:#7656D6; }
.service-action-scheduled { --action-soft:#E8EFFF; border-color:#2A6FFC; color:#2A6FFC; }
.service-action-progress { --action-soft:#EAF7FF; border-color:#1094C5; color:#1094C5; }
.service-action-parts { --action-soft:#FCF4E6; border-color:#B8770D; color:#B8770D; }
.service-action-repaired { --action-soft:#E4FCF3; border-color:#179E6C; color:#179E6C; }
.service-action-completed { --action-soft:#EAFBF4; border-color:#007943; color:#007943; }
.service-action-closed { --action-soft:#EEF1F7; border-color:#5D6372; color:#5D6372; }
.service-action-cancelled { --action-soft:#FDE3E6; border-color:#FE455D; color:#FE455D; }
.service-action:hover { background: var(--action-soft, var(--zcs-brand-soft)); }
.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.detail-card { background: #fff; border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 10px 30px rgba(16,24,40,.05); overflow: hidden; }
.detail-span-12 { grid-column: span 12; }
.detail-span-8 { grid-column: span 8; }
.detail-span-6 { grid-column: span 6; }
.detail-span-4 { grid-column: span 4; }
.detail-card-header { padding: 18px 18px 0; display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
.detail-card-title { font-size: 18px; line-height: 1.25; margin: 0; }
.detail-card-note { color: var(--zcs-teritiary-text-color); font-size: 13px; margin: 4px 0 0; }
.detail-card-body { padding: 18px; }
.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.kv { border: 1px solid var(--zcs-border-color); border-radius: 14px; padding: 12px; background: #FBFCFF; min-width: 0; }
.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
.kv-value { margin-top: 4px; color: var(--zcs-primary-text-color); font-size: 14px; overflow-wrap: anywhere; }
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.kpi { border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; padding: 14px; }
.kpi-icon { width: 38px; height: 38px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.kpi-label { color: var(--zcs-teritiary-text-color); font-size: 12px; margin-top: 8px; }
.kpi-value { font-size: 26px; font-weight: 700; line-height: 1.1; margin-top: 2px; }
.row-link { color: var(--zcs-theme-brand-color); font-weight: 600; }
.row-link:hover { text-decoration: underline; }
.info-box, .photo-box { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; }
.alert-list { display: flex; flex-direction: column; gap: 10px; }
.alert-row { display: flex; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }
.alert-row i { margin-top: 2px; }
.alert-ok { background: #F5FFFA; border-color: #CFF4E4; }
.alert-ok i { color: #179E6C; }
.alert-warn { background: #FFF8EA; border-color: #F7DFA8; }
.alert-warn i { color: #B8770D; }
.alert-danger { background: #FFF1F3; border-color: #FAC4CD; }
.alert-danger i { color: #FE455D; }
.stock-warning { color:#B8770D; font-weight:600; }
.stock-danger { color:#FE455D; font-weight:600; }
.stock-ok { color:#179E6C; font-weight:600; }
.link-list { display: flex; flex-direction: column; gap: 12px; }
.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; }
.comment-module { display:inline-flex; align-items:center; padding: 2px 8px; border-radius: 999px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); font-size: 12px; font-weight: 600; }
.comment-text { white-space: pre-wrap; }
.mobile-stack { display: none; }
.mobile-record { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; margin-bottom: 10px; }
.empty-soft { border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 16px; color: var(--zcs-teritiary-text-color); background: #FBFCFF; }
@media (max-width: 1180px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 768px) { .service-detail-page { padding: 12px; } .zcs-page-header { padding: 12px 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .service-hero { padding: 18px; border-radius: 18px; } .service-hero-side { flex-basis: auto; width: 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-table { display: none; } .mobile-stack { display: block; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; max-width: 100%; flex-basis: auto; } .zcs-tl-li .zcs-col-10 { max-width: 100%; flex-basis: auto; padding-left: 60px; padding-right: 0; } .link-row { flex-direction: column; } .service-action { flex: 1 1 auto; } }
@media (max-width: 560px) { .service-action-group { flex-direction: column; } .service-action { width: 100%; } }
</style>
<div class="service-detail-page">
<%
	if(svc_rec.count() == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No service request found</h5>
				<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">Service_ID <%=input.Service_ID%> does not match an existing Service_Requests record.</p>
				<a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12" href="#Page:Service_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span>Service Home</span></a>
			</div>
		</div>
<%
	}
	else
	{
		customer_rec = Customer_Master[ID == svc_rec.Customer];
		order_rec = Customer_Orders[ID == svc_rec.Related_Order];
		partRecords = Service_Parts_Usage[Service_Request == svc_rec.ID];
		primaryPo = Purchase_Orders[ID == svc_rec.Linked_PO];
		servicePOs = Purchase_Orders[Linked_Service == svc_rec.ID];
		actionComments = Action_Comments[Target_Module == "Service_Requests" && Lookup_ID == svc_rec.ID];
		partsCount = partRecords.count();
		shortageCount = 0;
		reorderWarnCount = 0;
		unpostedCount = 0;
		for each  stockUsage in partRecords
		{
			stockQty = ifnull(stockUsage.Material.Available_Quantity,0);
			reorderQty = ifnull(stockUsage.Material.Reorder_Level,0);
			usedQty = ifnull(stockUsage.Quantity_Used,0);
			if(usedQty > stockQty)
			{
				shortageCount = shortageCount + 1;
			}
			if(stockQty <= reorderQty)
			{
				reorderWarnCount = reorderWarnCount + 1;
			}
			if(stockUsage.Stock_Deducted != true)
			{
				unpostedCount = unpostedCount + 1;
			}
		}
		poCount = servicePOs.count();
		if(primaryPo.count() > 0)
		{
			poCount = poCount + 1;
		}
		statusClass = "zcs-badge-grey";
		if(svc_rec.Service_Status == "New" || svc_rec.Service_Status == "Triage")
		{
			statusClass = "zcs-badge-orange";
		}
		else if(svc_rec.Service_Status == "Scheduled")
		{
			statusClass = "zcs-badge-blue";
		}
		else if(svc_rec.Service_Status == "In Progress")
		{
			statusClass = "zcs-badge-theme";
		}
		else if(svc_rec.Service_Status == "Parts Required")
		{
			statusClass = "zcs-badge-yellow";
		}
		else if(svc_rec.Service_Status == "Repaired" || svc_rec.Service_Status == "Completed" || svc_rec.Service_Status == "Closed")
		{
			statusClass = "zcs-badge-green";
		}
		else if(svc_rec.Service_Status == "Cancelled")
		{
			statusClass = "zcs-badge-red";
		}
		priorityClass = "zcs-badge-blue";
		if(svc_rec.Priority == "Urgent")
		{
			priorityClass = "zcs-badge-red";
		}
		else if(svc_rec.Priority == "High")
		{
			priorityClass = "zcs-badge-orange";
		}
		else if(svc_rec.Priority == "Low")
		{
			priorityClass = "zcs-badge-grey";
		}
		completionReady = false;
		if(svc_rec.Service_Status == "Completed" || svc_rec.Service_Status == "Closed")
		{
			completionReady = true;
		}
		returnUrl = "%23Page%3AService_Detail%3FService_ID%3D" + svc_rec.ID;
		%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
			<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
				<a href="#Page:Service_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left"></i></a>
				<div class="zcs-ellipsis">
					<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Service Detail</h5>
					<div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=svc_rec.Service_Code%> - <%=ifnull(svc_rec.Customer_Name,"Customer pending")%></div>
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Service_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Service Home</span></a>
<%
		if(order_rec.count() > 0)
		{
			orderUrl = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=orderUrl%>"><i class="zcs-button-icon zc-li-outline files-single"></i><span class="zcs-button-text">Related order</span></a>
<%
		}
		%>
</div>
		</div>

		<section class="service-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
			<div class="service-hero-main">
				<div class="service-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Issue, schedule, technician, parts, PO, photos, and closure</div>
				<h1 class="service-hero-title"><%=ifnull(svc_rec.Customer_Name,"Customer pending")%></h1>
				<p class="service-hero-subtitle"><%=svc_rec.Service_Code%> is currently <%=svc_rec.Service_Status%>. Use the Add Comments popup links below to record status changes and preserve the audit trail.</p>
				<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
					<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-13"><%=svc_rec.Service_Status%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=priorityClass%>"><span class="zcs-badge-text zcs-font-13">Priority: <%=ifnull(svc_rec.Priority,"Not set")%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(shortageCount > 0,"zcs-badge-red",if(reorderWarnCount > 0,"zcs-badge-yellow","zcs-badge-green"))%>"><i class="zcs-badge-icon zc-li-outline business-box"></i><span class="zcs-badge-text zcs-font-13">Stock warnings: <%=shortageCount + reorderWarnCount%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(completionReady == true,"zcs-badge-green","zcs-badge-grey")%>"><i class="zcs-badge-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-badge-text zcs-font-13">Completion: <%=if(completionReady == true,"Reached","Pending")%></span></span>
				</div>
				<div class="service-action-group">
<%
		actionStatuses = {"Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"};
		for each  actionStatus in actionStatuses
		{
			actionParam = actionStatus;
			actionClass = "service-action-progress";
			actionIcon = "loader-dots-06";
			if(actionStatus == "Triage")
			{
				actionClass = "service-action-triage";
				actionIcon = "ui-2-alert-circle";
			}
			else if(actionStatus == "Scheduled")
			{
				actionClass = "service-action-scheduled";
				actionIcon = "ui-2-time";
			}
			else if(actionStatus == "In Progress")
			{
				actionParam = "In%20Progress";
			}
			else if(actionStatus == "Parts Required")
			{
				actionParam = "Parts%20Required";
				actionClass = "service-action-parts";
				actionIcon = "shopping-tag";
			}
			else if(actionStatus == "Repaired")
			{
				actionClass = "service-action-repaired";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Completed")
			{
				actionClass = "service-action-completed";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Closed")
			{
				actionClass = "service-action-closed";
				actionIcon = "ui-1-lock";
			}
			else if(actionStatus == "Cancelled")
			{
				actionClass = "service-action-cancelled";
				actionIcon = "ui-1-simple-remove";
			}
			actionHref = "#Form:Action_Comments?Target_Module=Service_Requests&Lookup_ID=" + svc_rec.ID + "&New_Status=" + actionParam + "&Return_Page=Service_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<a class="zcs-button zcs-primary-outline-button service-action <%=actionClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=actionHref%>"><i class="zcs-button-icon zc-li-outline <%=actionIcon%>"></i><span><%=actionStatus%></span></a>
<%
		}
		%>
</div>
			</div>
			<div class="service-hero-side">
				<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Technician</div>
				<div class="zcs-font-16 zcs-font-semibold zcs-mt-4"><%=ifnull(svc_rec.Technician.Employee_Name,"Unassigned")%></div>
				<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Scheduled start: <%=ifnull(svc_rec.Scheduled_Start,"Not set")%></div>
				<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Scheduled end: <%=ifnull(svc_rec.Scheduled_End,"Not set")%></div>
				<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Linked POs: <%=poCount%></div>
			</div>
		</section>

		<div class="detail-grid">
			<section class="detail-card detail-span-8">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Issue details</h2><p class="detail-card-note">Problem description and product or shutter context.</p></div></div>
				<div class="detail-card-body">
					<div class="kv-grid">
						<div class="kv"><div class="kv-label">Service code</div><div class="kv-value"><%=svc_rec.Service_Code%></div></div>
						<div class="kv"><div class="kv-label">Request date</div><div class="kv-value"><%=ifnull(svc_rec.Request_Date,"Not set")%></div></div>
						<div class="kv"><div class="kv-label">Product or shutter details</div><div class="kv-value"><%=ifnull(svc_rec.Product_or_Shutter_Details,"No product details captured.")%></div></div>
						<div class="kv"><div class="kv-label">Related order</div><div class="kv-value">
<%
		if(order_rec.count() > 0)
		{
			orderUrl2 = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<a class="row-link" href="<%=orderUrl2%>"><%=order_rec.Order_Code%></a>
<%
		}
		else
		{
			%>
No related order linked
<%
		}
		%>
</div></div>
						<div class="kv" style="grid-column:1 / -1;"><div class="kv-label">Issue description</div><div class="kv-value"><%=ifnull(svc_rec.Issue_Description,"Issue description pending.")%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-4">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Service KPIs</h2><p class="detail-card-note">Parts, stock, POs, and comments.</p></div></div>
				<div class="detail-card-body">
					<div class="kpi-grid">
						<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline shopping-tag"></i></span><div class="kpi-label">Parts rows</div><div class="kpi-value"><%=partsCount%></div></div>
						<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline ui-2-alert-circle"></i></span><div class="kpi-label">Stock warnings</div><div class="kpi-value"><%=shortageCount + reorderWarnCount%></div></div>
						<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline shopping-cart-simple"></i></span><div class="kpi-label">Linked POs</div><div class="kpi-value"><%=poCount%></div></div>
						<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline files-2-doc"></i></span><div class="kpi-label">Comments</div><div class="kpi-value"><%=actionComments.count()%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Contact and address</h2><p class="detail-card-note">Customer lookup plus request snapshot contact details.</p></div></div>
				<div class="detail-card-body">
					<div class="kv-grid">
						<div class="kv"><div class="kv-label">Customer</div><div class="kv-value">
<%
		if(customer_rec.count() > 0)
		{
			%>
<%=customer_rec.Customer_Name%>
<%
		}
		else
		{
			%>
<%=ifnull(svc_rec.Customer_Name,"Customer pending")%>
<%
		}
		%>
</div></div>
						<div class="kv"><div class="kv-label">Contact person</div><div class="kv-value">
<%
		if(customer_rec.count() > 0)
		{
			%>
<%=ifnull(customer_rec.Contact_Person,"Not entered")%>
<%
		}
		else
		{
			%>
Not available
<%
		}
		%>
</div></div>
						<div class="kv"><div class="kv-label">Phone</div><div class="kv-value"><%=ifnull(svc_rec.Phone,"No phone")%></div></div>
						<div class="kv"><div class="kv-label">Email</div><div class="kv-value"><%=ifnull(svc_rec.Email,"No email")%></div></div>
						<div class="kv"><div class="kv-label">Preferred contact</div><div class="kv-value">
<%
		if(customer_rec.count() > 0)
		{
			%>
<%=ifnull(customer_rec.Preferred_Contact_Method,"Not set")%>
<%
		}
		else
		{
			%>
Not available
<%
		}
		%>
</div></div>
						<div class="kv"><div class="kv-label">Area or city</div><div class="kv-value">
<%
		if(customer_rec.count() > 0)
		{
			%>
<%=ifnull(customer_rec.Area_or_City,"Not set")%>
<%
		}
		else
		{
			%>
<%=ifnull(svc_rec.Service_Address.district_city,"Not set")%>
<%
		}
		%>
</div></div>
						<div class="kv" style="grid-column:1 / -1;"><div class="kv-label">Service address</div><div class="kv-value"><%=ifnull(svc_rec.Service_Address.address_line_1,"Not entered")%> <%=ifnull(svc_rec.Service_Address.address_line_2,"")%><br><%=ifnull(svc_rec.Service_Address.district_city,"")%> <%=ifnull(svc_rec.Service_Address.state_province,"")%> <%=ifnull(svc_rec.Service_Address.postal_Code,"")%> <%=ifnull(svc_rec.Service_Address.country,"")%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Schedule and technician</h2><p class="detail-card-note">Visit timing, assigned service staff, and technician notes.</p></div></div>
				<div class="detail-card-body">
					<div class="kv-grid">
						<div class="kv"><div class="kv-label">Scheduled start</div><div class="kv-value"><%=ifnull(svc_rec.Scheduled_Start,"Not set")%></div></div>
						<div class="kv"><div class="kv-label">Scheduled end</div><div class="kv-value"><%=ifnull(svc_rec.Scheduled_End,"Not set")%></div></div>
						<div class="kv"><div class="kv-label">Technician</div><div class="kv-value"><%=ifnull(svc_rec.Technician.Employee_Name,"Unassigned")%></div></div>
						<div class="kv"><div class="kv-label">Technician email</div><div class="kv-value"><%=ifnull(svc_rec.Technician.Email,"Not entered")%></div></div>
						<div class="kv" style="grid-column:1 / -1;"><div class="kv-label">Technician notes</div><div class="kv-value"><%=ifnull(svc_rec.Technician_Notes,"No technician notes captured yet.")%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-12">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Parts usage and stock warnings</h2><p class="detail-card-note">Service_Parts_Usage rows, material stock, reorder status, and stock-posting state.</p></div></div>
				<div class="detail-card-body">
					<div class="alert-list zcs-mb-0">
						<div class="alert-row <%=if(shortageCount > 0,"alert-danger",if(reorderWarnCount > 0,"alert-warn","alert-ok"))%>"><i class="zc-li-outline ui-2-alert-circle"></i><div><strong>Stock check</strong><div class="zcs-font-13 zcs-mt-4"><%=shortageCount%> part row(s) exceed available stock and <%=reorderWarnCount%> row(s) are at or below reorder level. <%=unpostedCount%> row(s) are not yet stock-posted.</div></div></div>
					</div>
					<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-table zcs-mt-12">
						<table class="zcs-w-full">
							<thead class="zcs-sticky"><tr>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Part</th>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Used</th>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Available</th>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Reorder</th>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Warning</th>
								<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Posted</th>
							</tr></thead>
							<tbody>
<%
		partRows = 0;
		for each  partUsage in partRecords
		{
			partRows = partRows + 1;
			availableQty = ifnull(partUsage.Material.Available_Quantity,0);
			reorderLevel = ifnull(partUsage.Material.Reorder_Level,0);
			qtyUsed = ifnull(partUsage.Quantity_Used,0);
			warningText = "Sufficient";
			warningClass = "stock-ok";
			if(qtyUsed > availableQty)
			{
				warningText = "Insufficient stock";
				warningClass = "stock-danger";
			}
			else if(availableQty <= reorderLevel)
			{
				warningText = "At or below reorder level";
				warningClass = "stock-warning";
			}
			%>
<tr>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(partUsage.Material.Material_Name,"Material pending")%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(partUsage.Notes,"No usage notes")%></span></td>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=qtyUsed%> <%=ifnull(partUsage.Unit.Unit_Name,"")%></td>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=availableQty%> <%=ifnull(partUsage.Material.Stock_Unit.Unit_Name,"")%></td>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=reorderLevel%></td>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><span class="<%=warningClass%>"><%=warningText%></span></td>
									<td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(partUsage.Stock_Deducted == true,"zcs-badge-green","zcs-badge-orange")%>"><span class="zcs-badge-text zcs-font-12"><%=if(partUsage.Stock_Deducted == true,"Posted","Pending")%></span></span></td>
								</tr>
<%
		}
		if(partRows == 0)
		{
			%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="6">No Service_Parts_Usage rows are linked to this request.</td></tr>
<%
		}
		%>
</tbody>
						</table>
					</div>
					<div class="mobile-stack zcs-mt-12">
<%
		mobilePartRows = 0;
		for each  mobileUsage in partRecords
		{
			mobilePartRows = mobilePartRows + 1;
			mobileAvailable = ifnull(mobileUsage.Material.Available_Quantity,0);
			mobileReorder = ifnull(mobileUsage.Material.Reorder_Level,0);
			mobileUsed = ifnull(mobileUsage.Quantity_Used,0);
			mobileWarning = "Sufficient";
			if(mobileUsed > mobileAvailable)
			{
				mobileWarning = "Insufficient stock";
			}
			else if(mobileAvailable <= mobileReorder)
			{
				mobileWarning = "At or below reorder level";
			}
			%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=ifnull(mobileUsage.Material.Material_Name,"Material pending")%></strong><span class="zcs-font-12 zcs-color-tertiary"><%=if(mobileUsage.Stock_Deducted == true,"Posted","Pending")%></span></div><div class="zcs-font-13 zcs-mt-6">Used <%=mobileUsed%> <%=ifnull(mobileUsage.Unit.Unit_Name,"")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Available <%=mobileAvailable%> - Reorder <%=mobileReorder%></div><div class="zcs-font-13 zcs-mt-4"><%=mobileWarning%></div></div>
<%
		}
		if(mobilePartRows == 0)
		{
			%>
<div class="empty-soft">No Service_Parts_Usage rows are linked to this request.</div>
<%
		}
		%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Linked PO status</h2><p class="detail-card-note">Purchase orders linked from Service_Requests.Linked_PO or Purchase_Orders.Linked_Service.</p></div></div>
				<div class="detail-card-body">
					<div class="link-list">
<%
		poRowsShown = 0;
		if(primaryPo.count() > 0)
		{
			poRowsShown = poRowsShown + 1;
			poDetailUrl = "#Page:Purchase_Order_Detail?PO_ID=" + primaryPo.ID;
			poStatusClass = "zcs-badge-blue";
			if(primaryPo.PO_Status == "Received")
			{
				poStatusClass = "zcs-badge-green";
			}
			else if(primaryPo.PO_Status == "Cancelled")
			{
				poStatusClass = "zcs-badge-red";
			}
			else if(primaryPo.PO_Status == "Draft")
			{
				poStatusClass = "zcs-badge-grey";
			}
			else if(primaryPo.PO_Status == "Submitted for Approval")
			{
				poStatusClass = "zcs-badge-orange";
			}
			else if(primaryPo.PO_Status == "Partially Received")
			{
				poStatusClass = "zcs-badge-yellow";
			}
			%>
<div class="link-row"><div><a class="row-link" href="<%=poDetailUrl%>"><%=primaryPo.PO_Number%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=ifnull(primaryPo.Vendor.Vendor_Name,"Vendor pending")%> - Expected <%=ifnull(primaryPo.Expected_Delivery_Date,"Not set")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Linked through Service_Requests.Linked_PO</div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=poStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=primaryPo.PO_Status%></span></span></div>
<%
		}
		for each  svcPo in servicePOs
		{
			if(primaryPo.count() == 0 || svcPo.ID != primaryPo.ID)
			{
				poRowsShown = poRowsShown + 1;
				svcPoDetailUrl = "#Page:Purchase_Order_Detail?PO_ID=" + svcPo.ID;
				svcPoStatusClass = "zcs-badge-blue";
				if(svcPo.PO_Status == "Received")
				{
					svcPoStatusClass = "zcs-badge-green";
				}
				else if(svcPo.PO_Status == "Cancelled")
				{
					svcPoStatusClass = "zcs-badge-red";
				}
				else if(svcPo.PO_Status == "Draft")
				{
					svcPoStatusClass = "zcs-badge-grey";
				}
				else if(svcPo.PO_Status == "Submitted for Approval")
				{
					svcPoStatusClass = "zcs-badge-orange";
				}
				else if(svcPo.PO_Status == "Partially Received")
				{
					svcPoStatusClass = "zcs-badge-yellow";
				}
				%>
<div class="link-row"><div><a class="row-link" href="<%=svcPoDetailUrl%>"><%=svcPo.PO_Number%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=ifnull(svcPo.Vendor.Vendor_Name,"Vendor pending")%> - Expected <%=ifnull(svcPo.Expected_Delivery_Date,"Not set")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Linked through Purchase_Orders.Linked_Service</div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=svcPoStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=svcPo.PO_Status%></span></span></div>
<%
			}
		}
		if(poRowsShown == 0)
		{
			%>
<div class="empty-soft">No linked purchase orders were found for this service request.</div>
<%
		}
		%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Completion status and photos</h2><p class="detail-card-note">Closure readiness, stock-posting flag, completion date, and uploaded service photos.</p></div></div>
				<div class="detail-card-body">
					<div class="kv-grid">
						<div class="kv"><div class="kv-label">Completion date</div><div class="kv-value"><%=ifnull(svc_rec.Completion_Date,"Not set")%></div></div>
						<div class="kv"><div class="kv-label">Stock consumption posted</div><div class="kv-value"><%=if(svc_rec.Stock_Consumption_Posted == true,"Yes","No")%></div></div>
						<div class="kv"><div class="kv-label">Completion-ready status</div><div class="kv-value"><%=if(completionReady == true,"Completed or closed","Not completed")%></div></div>
						<div class="kv"><div class="kv-label">Unposted parts rows</div><div class="kv-value"><%=unpostedCount%></div></div>
					</div>
					<div class="photo-box zcs-mt-12">
						<div class="zcs-flex zcs-align-items-center zcs-gap-8"><i class="zc-li-outline files-archive-3d-content"></i><strong>Service photos</strong></div>
						<div class="zcs-font-13 zcs-color-secondary zcs-mt-8">
<%
		photoValue = ifnull(svc_rec.Service_Photos,"");
		if(photoValue != "")
		{
			%>
<%=svc_rec.Service_Photos%>
<%
		}
		else
		{
			%>
No service photos are attached yet.
<%
		}
		%>
</div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Status timeline</h2><p class="detail-card-note">Current progress through the service lifecycle.</p></div></div>
				<div class="detail-card-body">
					<div class="zcs-timeline-wrapper">
						<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		stepStatuses = {"New","Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed"};
		currentStepIndex = stepStatuses.indexOf(svc_rec.Service_Status);
		for each index stepIndex in stepStatuses
		{
			stepStatus = stepStatuses.get(stepIndex);
			tlClass = "";
			iconName = "ui-2-time";
			if(currentStepIndex > stepIndex)
			{
				tlClass = "zcs-tl-li-complete";
				iconName = "ui-1-check-circle-08";
			}
			else if(currentStepIndex == stepIndex)
			{
				tlClass = "zcs-tl-li-active";
				iconName = "loader-dots-06";
			}
			%>
<li class="zcs-tl-li <%=tlClass%> zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline <%=iconName%>"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Step <%=stepIndex + 1%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=stepStatus%></h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0"><%=if(currentStepIndex > stepIndex,"Completed or passed",if(currentStepIndex == stepIndex,"Current stage","Awaiting previous stage"))%></p></div></li>
<%
		}
		if(svc_rec.Service_Status == "Cancelled")
		{
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline ui-2-alert-circle" style="background:#FDE3E6;color:#FE455D;"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Exception</span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0">Cancelled</h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0">See comment history for cancellation reason.</p></div></li>
<%
		}
		%>
</ul>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Service readiness checks</h2><p class="detail-card-note">Operational flags that affect repair, completion, and closure.</p></div></div>
				<div class="detail-card-body">
					<div class="alert-list">
						<div class="alert-row <%=if(svc_rec.Technician != null,"alert-ok","alert-warn")%>"><i class="zc-li-outline users-single-03"></i><div><strong>Technician assignment</strong><div class="zcs-font-13 zcs-mt-4"><%=ifnull(svc_rec.Technician.Employee_Name,"No technician assigned")%></div></div></div>
						<div class="alert-row <%=if(svc_rec.Scheduled_Start != null,"alert-ok","alert-warn")%>"><i class="zc-li-outline ui-2-time"></i><div><strong>Schedule</strong><div class="zcs-font-13 zcs-mt-4">Start: <%=ifnull(svc_rec.Scheduled_Start,"Not set")%>. End: <%=ifnull(svc_rec.Scheduled_End,"Not set")%>.</div></div></div>
						<div class="alert-row <%=if(shortageCount == 0,"alert-ok","alert-danger")%>"><i class="zc-li-outline business-box"></i><div><strong>Parts stock</strong><div class="zcs-font-13 zcs-mt-4"><%=shortageCount%> shortage warning(s). <%=unpostedCount%> usage row(s) awaiting stock posting.</div></div></div>
						<div class="alert-row <%=if(completionReady == true,"alert-ok","alert-warn")%>"><i class="zc-li-outline ui-1-check-circle-08"></i><div><strong>Closure</strong><div class="zcs-font-13 zcs-mt-4">Completion date: <%=ifnull(svc_rec.Completion_Date,"Not set")%>. Technician notes: <%=if(ifnull(svc_rec.Technician_Notes,"") != "","Captured","Pending")%>.</div></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-12">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Comment history</h2><p class="detail-card-note">Action_Comments audit trail for this service request.</p></div></div>
				<div class="detail-card-body">
					<div class="zcs-timeline-wrapper">
						<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		commentRows = 0;
		for each  comment in Action_Comments[Target_Module == "Service_Requests" && Lookup_ID == svc_rec.ID] sort by Action_Date desc
		{
			commentRows = commentRows + 1;
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=comment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=comment.New_Status%></h6><span class="comment-module">Service <%=svc_rec.Service_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(comment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=comment.Comments%></p></div></li>
<%
		}
		if(commentRows == 0)
		{
			%>
<li><div class="empty-soft">No Action_Comments have been recorded for this service request yet.</div></li>
<%
		}
		%>
</ul>
					</div>
				</div>
			</section>
		</div>
<%
	}
	%>
</div>