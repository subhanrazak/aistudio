.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-green { color: #179e6c; }
.zcs-red { color: #fe455d; }
.zcs-yellow { color: #b8770d; }
.zcs-l_blue { color: #1094c5; }
.zcs-blue { color: #09598e; }
.zcs-d_blue { color: #1328cd; }
.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }
.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }
.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }
.zcs-fw-button { width: 100%; }
.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0px; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }
.zcs-tl-icon { width: 35px; height: 35px; background-color: #F5F4FA; color: #4B4274; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }
.zcs-tl-li-active .zcs-tl-icon { background-color: #E8EFFF; color: #2A6FFC; }
.zcs-tl-li-complete .zcs-tl-icon { background-color: #E4FCF3; color: #179E6C; }
.detail-shell { max-width: 1440px; margin: 0 auto; }
.detail-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }
.detail-hero:after { content: ''; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }
.detail-hero-main, .detail-hero-side { position: relative; z-index: 1; }
.detail-hero-main { min-width: 280px; flex: 1 1 620px; }
.detail-hero-side { flex: 0 1 360px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }
.detail-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }
.detail-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }
.detail-hero-subtitle { color: rgba(255,255,255,.78); max-width: 820px; margin: 8px 0 0; }
.detail-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.detail-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }
.detail-action-ready { background: #179E6C; }
.detail-action-progress { background: #2A6FFC; }
.detail-action-inspection { background: #8200DB; }
.detail-action-hold { background: #F4660C; }
.detail-action-cancel { background: #FE455D; }
.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }
.detail-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
.detail-card-body { padding: 18px 20px; }
.detail-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }
.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }
.detail-span-12 { grid-column: span 12; }
.detail-span-8 { grid-column: span 8; }
.detail-span-6 { grid-column: span 6; }
.detail-span-4 { grid-column: span 4; }
.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }
.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }
.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }
.link-list { display: flex; flex-direction: column; gap: 10px; }
.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }
.detail-link:hover, .row-link:hover { text-decoration: underline; }
.blocker-list { display: grid; gap: 10px; }
.blocker { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }
.blocker i { margin-top: 2px; }
.blocker-ok { background: var(--zcs-success-soft); border-color: #BEEBD7; color: #176B4B; }
.blocker-warn { background: var(--zcs-warning-soft); border-color: #FFE0A3; color: #8A5A00; }
.blocker-danger { background: var(--zcs-danger-soft); border-color: #FFC3CC; color: #8B1B2B; }
.products-summary { white-space: pre-wrap; word-break: break-word; padding: 16px; border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; }
.photo-box { border: 1px dashed var(--zcs-border-color); border-radius: 16px; padding: 18px; background: #FBFCFF; word-break: break-word; }
.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }
.comment-text { white-space: pre-wrap; word-break: break-word; }
.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }
.mobile-stack { display: none; }
@media (max-width: 1100px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 768px) { .install-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .detail-hero { padding: 18px; } .detail-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .link-row { flex-direction: column; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }
</style>
<div class="install-detail-page">
	<div class="detail-shell">
<%
	if(inst_rec.count() == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center" style="min-height:60vh;">
				<div class="zcs-nodata-content zcs-p-20 zcs-box-border detail-card">
					<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Installation not found</h5>
					<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">No Installation_Schedules record matched Installation_ID <%=input.Installation_ID%>.</p>
				</div>
			</div>
<%
	}
	else
	{
		order_rec = Customer_Orders[ID == inst_rec.Customer_Order];
		productionRecords = Production_Records[Customer_Order == inst_rec.Customer_Order];
		permitRecords = Permit_Records[Customer_Order == inst_rec.Customer_Order];
		prodCount = productionRecords.count();
		readyCount = Production_Records[Customer_Order == inst_rec.Customer_Order && Production_Status == "Ready for Installation" || Production_Status == "Purchased and Received"].count();
		blockedProdCount = prodCount - readyCount;
		openPermitCount = Permit_Records[Customer_Order == inst_rec.Customer_Order && Permit_Status != "Approved" && Permit_Status != "Not Required"].count();
		scheduleSet = false;
		if(inst_rec.Scheduled_Start != null && inst_rec.Scheduled_End != null && inst_rec.Crew_Lead != null)
		{
			scheduleSet = true;
		}
		qcClear = true;
		if(inst_rec.Internal_QC_Required == true && inst_rec.Internal_QC_Status != "Passed" && inst_rec.Internal_QC_Status != "Not Required")
		{
			qcClear = false;
		}
		blockerCount = 0;
		if(inst_rec.Production_Readiness_Status != "Ready")
		{
			blockerCount = blockerCount + 1;
		}
		if(!(inst_rec.Permit_Clearance_Status == "Approved" || inst_rec.Permit_Clearance_Status == "Not Required"))
		{
			blockerCount = blockerCount + 1;
		}
		if(inst_rec.Installation_Status == "Scheduled" || inst_rec.Installation_Status == "In Progress" || inst_rec.Installation_Status == "Installed" || inst_rec.Installation_Status == "Inspection Required" || inst_rec.Installation_Status == "Inspection Completed" || inst_rec.Installation_Status == "Completed")
		{
			if(scheduleSet == false)
			{
				blockerCount = blockerCount + 1;
			}
		}
		if(qcClear == false)
		{
			blockerCount = blockerCount + 1;
		}
		instStatusClass = "zcs-badge-blue";
		if(inst_rec.Installation_Status == "Completed" || inst_rec.Installation_Status == "Installed" || inst_rec.Installation_Status == "Inspection Completed")
		{
			instStatusClass = "zcs-badge-green";
		}
		else if(inst_rec.Installation_Status == "Cancelled")
		{
			instStatusClass = "zcs-badge-red";
		}
		else if(inst_rec.Installation_Status == "On Hold")
		{
			instStatusClass = "zcs-badge-orange";
		}
		else if(inst_rec.Installation_Status == "Forecast" || inst_rec.Installation_Status == "Waiting for Production" || inst_rec.Installation_Status == "Ready to Schedule")
		{
			instStatusClass = "zcs-badge-yellow";
		}
		returnUrl = "%23Page%3AInstallation_Detail%3FInstallation_ID%3D" + inst_rec.ID;
		%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
				<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
					<a href="#Page:Installation_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left"></i></a>
					<div class="zcs-ellipsis">
						<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Installation Detail</h5>
						<div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=inst_rec.Installation_Code%> - <%=ifnull(inst_rec.Area_or_City,"Location pending")%></div>
					</div>
				</div>
				<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Installation_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Installation Home</span></a>
<%
		if(order_rec.count() > 0)
		{
			orderUrl = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=orderUrl%>"><i class="zcs-button-icon zc-li-outline files-single"></i><span class="zcs-button-text">Order</span></a>
<%
		}
		%>
</div>
			</div>

			<section class="detail-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
				<div class="detail-hero-main">
					<div class="detail-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Schedule, readiness, crew, QC, and completion</div>
					<h1 class="detail-hero-title"><%=ifnull(inst_rec.Customer_Name_Snapshot,"Customer pending")%></h1>
					<p class="detail-hero-subtitle"><%=inst_rec.Installation_Code%> is currently <%=inst_rec.Installation_Status%>. Production readiness, permit clearance, schedule, crew lead, QC, photos, and comments are shown below.</p>
					<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
						<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=instStatusClass%>"><span class="zcs-badge-text zcs-font-13"><%=inst_rec.Installation_Status%></span></span>
						<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(inst_rec.Production_Readiness_Status == "Ready","zcs-badge-green","zcs-badge-yellow")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline design-2-ungroup"></i><span class="zcs-badge-text zcs-font-13">Production: <%=inst_rec.Production_Readiness_Status%></span></span>
						<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(inst_rec.Permit_Clearance_Status == "Approved" || inst_rec.Permit_Clearance_Status == "NotRequired","zcs-badge-green","zcs-badge-yellow")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-15"></i><span class="zcs-badge-text zcs-font-13">Permit: <%=inst_rec.Permit_Clearance_Status%></span></span>
					</div>
					<div class="detail-action-group">
<%
		actionStatuses = {"Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"};
		for each  actionStatus in actionStatuses
		{
			actionParam = "";
			actionClass = "detail-action-progress";
			actionIcon = "loader-dots-06";
			if(actionStatus == "Ready to Schedule")
			{
				actionParam = "Ready%20to%20Schedule";
				actionClass = "detail-action-ready";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Scheduled")
			{
				actionParam = "Scheduled";
				actionIcon = "ui-2-time";
			}
			else if(actionStatus == "In Progress")
			{
				actionParam = "In%20Progress";
			}
			else if(actionStatus == "Installed")
			{
				actionParam = "Installed";
				actionClass = "detail-action-ready";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Inspection Required")
			{
				actionParam = "Inspection%20Required";
				actionClass = "detail-action-inspection";
				actionIcon = "ui-2-alert-circle";
			}
			else if(actionStatus == "Inspection Completed")
			{
				actionParam = "Inspection%20Completed";
				actionClass = "detail-action-inspection";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Completed")
			{
				actionParam = "Completed";
				actionClass = "detail-action-ready";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "On Hold")
			{
				actionParam = "On%20Hold";
				actionClass = "detail-action-hold";
				actionIcon = "ui-2-time";
			}
			else if(actionStatus == "Cancelled")
			{
				actionParam = "Cancelled";
				actionClass = "detail-action-cancel";
				actionIcon = "ui-1-simple-remove";
			}
			actionHref = "#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=" + inst_rec.ID + "&New_Status=" + actionParam + "&Return_Page=Installation_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<a class="zcs-button zcs-primary-button detail-action <%=actionClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=actionHref%>"><i class="zcs-button-icon zc-li-outline <%=actionIcon%>"></i><span><%=actionStatus%></span></a>
<%
		}
		%>
</div>
				</div>
				<div class="detail-hero-side">
					<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Assigned crew lead</div>
					<div class="zcs-font-16 zcs-font-semibold zcs-mt-4"><%=ifnull(inst_rec.Crew_Lead.Employee_Name,"Unassigned")%></div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Scheduled start: <%=ifnull(inst_rec.Scheduled_Start,"Not set")%></div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Estimated hours: <%=ifnull(inst_rec.Estimated_Hours,0)%></div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Open blockers: <%=blockerCount%></div>
				</div>
			</section>

			<div class="detail-grid">
				<section class="detail-card detail-span-8">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Customer and location</h2><p class="detail-card-note">Order, customer, and install-site snapshot for field teams.</p></div></div>
					<div class="detail-card-body">
						<div class="kv-grid">
							<div class="kv"><div class="kv-label">Customer</div><div class="kv-value"><%=ifnull(inst_rec.Customer_Name_Snapshot,"Pending")%></div></div>
							<div class="kv"><div class="kv-label">Area or city</div><div class="kv-value"><%=ifnull(inst_rec.Area_or_City,"Pending")%></div></div>
							<div class="kv"><div class="kv-label">Order</div><div class="kv-value">
<%
		if(order_rec.count() > 0)
		{
			orderUrl2 = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<a class="row-link" href="<%=orderUrl2%>"><%=order_rec.Order_Code%></a>
<%
		}
		else
		{
			%>
Order not found
<%
		}
		%>
</div></div>
							<div class="kv"><div class="kv-label">Forecast date</div><div class="kv-value"><%=ifnull(inst_rec.Forecast_Date,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Phone</div><div class="kv-value">
<%
		if(order_rec.count() > 0)
		{
			%>
<%=ifnull(order_rec.Customer_Phone,"Not entered")%>
<%
		}
		else
		{
			%>
Not available
<%
		}
		%>
</div></div>
							<div class="kv"><div class="kv-label">Email</div><div class="kv-value">
<%
		if(order_rec.count() > 0)
		{
			%>
<%=ifnull(order_rec.Customer_Email,"Not entered")%>
<%
		}
		else
		{
			%>
Not available
<%
		}
		%>
</div></div>
							<div class="kv" style="grid-column:1 / -1;"><div class="kv-label">Installation address</div><div class="kv-value"><%=ifnull(inst_rec.Installation_Address.address_line_1,"Not entered")%> <%=ifnull(inst_rec.Installation_Address.address_line_2,"")%><br><%=ifnull(inst_rec.Installation_Address.district_city,"")%> <%=ifnull(inst_rec.Installation_Address.state_province,"")%> <%=ifnull(inst_rec.Installation_Address.postal_Code,"")%></div></div>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-4">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Readiness summary</h2><p class="detail-card-note">Blocking status before dispatch or completion.</p></div></div>
					<div class="detail-card-body">
						<div class="kpi-grid" style="grid-template-columns:1fr 1fr;">
							<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline design-2-ungroup"></i></span><div class="kpi-label">Production ready</div><div class="kpi-value"><%=readyCount%>/<%=prodCount%></div></div>
							<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline files-folder-15"></i></span><div class="kpi-label">Open permits</div><div class="kpi-value"><%=openPermitCount%></div></div>
							<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline ui-2-alert-circle"></i></span><div class="kpi-label">Blockers</div><div class="kpi-value"><%=blockerCount%></div></div>
							<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span><div class="kpi-label">QC</div><div class="kpi-value zcs-font-18"><%=inst_rec.Internal_QC_Status%></div></div>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Products summary</h2><p class="detail-card-note">Copied from order lines when the schedule was created.</p></div></div>
					<div class="detail-card-body">
						<div class="products-summary"><%=ifnull(inst_rec.Products_Summary,"No products summary has been captured.")%></div>
					</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Readiness blockers</h2><p class="detail-card-note">Resolve these before field completion.</p></div></div>
					<div class="detail-card-body">
						<div class="blocker-list">
							<div class="blocker <%=if(inst_rec.Production_Readiness_Status == "Ready","blocker-ok","blocker-warn")%>"><i class="zc-li-outline design-2-ungroup"></i><div><strong>Production readiness: <%=inst_rec.Production_Readiness_Status%></strong><div class="zcs-font-13 zcs-mt-4"><%=blockedProdCount%> linked production item(s) are not ready or received.</div></div></div>
							<div class="blocker <%=if(inst_rec.Permit_Clearance_Status == "Approved" || inst_rec.Permit_Clearance_Status == "NotRequired","blocker-ok","blocker-warn")%>"><i class="zc-li-outline files-folder-15"></i><div><strong>Permit clearance: <%=inst_rec.Permit_Clearance_Status%></strong><div class="zcs-font-13 zcs-mt-4"><%=openPermitCount%> linked permit record(s) still require clearance.</div></div></div>
							<div class="blocker <%=if(scheduleSet == true,"blocker-ok","blocker-warn")%>"><i class="zc-li-outline ui-2-time"></i><div><strong>Schedule and crew</strong><div class="zcs-font-13 zcs-mt-4">Start, end, and crew lead are <%=if(scheduleSet == true,"assigned","not fully assigned")%>.</div></div></div>
							<div class="blocker <%=if(qcClear == true,"blocker-ok","blocker-danger")%>"><i class="zc-li-outline ui-1-check-circle-08"></i><div><strong>Internal QC: <%=inst_rec.Internal_QC_Status%></strong><div class="zcs-font-13 zcs-mt-4">QC required: <%=if(inst_rec.Internal_QC_Required == true,"Yes","No")%>. QC date: <%=ifnull(inst_rec.Internal_QC_Date,"Not set")%>.</div></div></div>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Schedule and crew lead</h2><p class="detail-card-note">Timing, estimated hours, and assigned lead.</p></div></div>
					<div class="detail-card-body">
						<div class="kv-grid">
							<div class="kv"><div class="kv-label">Scheduled start</div><div class="kv-value"><%=ifnull(inst_rec.Scheduled_Start,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Scheduled end</div><div class="kv-value"><%=ifnull(inst_rec.Scheduled_End,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Estimated hours</div><div class="kv-value"><%=ifnull(inst_rec.Estimated_Hours,0)%></div></div>
							<div class="kv"><div class="kv-label">Priority sequence</div><div class="kv-value"><%=ifnull(inst_rec.Priority_Sequence,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Crew lead</div><div class="kv-value"><%=ifnull(inst_rec.Crew_Lead.Employee_Name,"Unassigned")%></div></div>
							<div class="kv"><div class="kv-label">Crew email</div><div class="kv-value"><%=ifnull(inst_rec.Crew_Lead.Email,"Not entered")%></div></div>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Internal QC and completion</h2><p class="detail-card-note">Quality gate, field notes, and completion photo attachment status.</p></div></div>
					<div class="detail-card-body">
						<div class="kv-grid">
							<div class="kv"><div class="kv-label">QC required</div><div class="kv-value"><%=if(inst_rec.Internal_QC_Required == true,"Yes","No")%></div></div>
							<div class="kv"><div class="kv-label">QC status</div><div class="kv-value"><%=inst_rec.Internal_QC_Status%></div></div>
							<div class="kv"><div class="kv-label">QC date</div><div class="kv-value"><%=ifnull(inst_rec.Internal_QC_Date,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Field notes</div><div class="kv-value"><%=ifnull(inst_rec.Field_Notes,"No field notes captured.")%></div></div>
						</div>
						<div class="photo-box zcs-mt-12">
							<div class="zcs-flex zcs-align-items-center zcs-gap-8"><i class="zc-li-outline files-archive-3d-content"></i><strong>Completion photos</strong></div>
							<div class="zcs-font-13 zcs-color-secondary zcs-mt-8">
<%
		photoValue = ifnull(inst_rec.Completion_Photos,"");
		if(photoValue != "")
		{
			%>
<%=inst_rec.Completion_Photos%>
<%
		}
		else
		{
			%>
No completion photos are attached yet.
<%
		}
		%>
</div>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-12">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Linked production records</h2><p class="detail-card-note">Products, production readiness, material, and powder state for this installation.</p></div></div>
					<div class="detail-card-body">
						<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only">
							<table class="zcs-w-full">
								<thead class="zcs-sticky"><tr>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Production</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Product</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Qty</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Production status</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Material</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Powder</th>
								</tr></thead>
								<tbody>
<%
		prodRows = 0;
		for each  prod in Production_Records[Customer_Order == inst_rec.Customer_Order] sort by Priority_Sequence asc
		{
			prodRows = prodRows + 1;
			prodStatusClass = "zcs-badge-blue";
			if(prod.Production_Status == "Ready for Installation" || prod.Production_Status == "Purchased and Received")
			{
				prodStatusClass = "zcs-badge-green";
			}
			else if(prod.Production_Status == "Cancelled")
			{
				prodStatusClass = "zcs-badge-red";
			}
			else if(prod.Production_Status == "Material Shortage" || prod.Production_Status == "On Hold")
			{
				prodStatusClass = "zcs-badge-orange";
			}
			prodUrl = "#Page:Production_Detail?Production_ID=" + prod.ID;
			%>
<tr>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><a class="row-link" href="<%=prodUrl%>"><%=prod.Production_Code%></a></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(prod.Product.Product_Name,"Product pending")%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(prod.Colour,"Colour not set")%> - <%=ifnull(prod.Dimensions,"No dimensions")%></span></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=ifnull(prod.Quantity,0)%> <%=ifnull(prod.Unit.Unit_Name,"")%></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=prodStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=prod.Production_Status%></span></span></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(prod.Material_Status,"Not checked")%></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(prod.Powder_Coating_Status,"Not required")%></td>
									</tr>
<%
		}
		if(prodRows == 0)
		{
			%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="6">No linked Production_Records were found for this installation order.</td></tr>
<%
		}
		%>
</tbody>
							</table>
						</div>
						<div class="mobile-stack">
<%
		mobileProdRows = 0;
		for each  mprod in Production_Records[Customer_Order == inst_rec.Customer_Order] sort by Priority_Sequence asc
		{
			mobileProdRows = mobileProdRows + 1;
			mprodUrl = "#Page:Production_Detail?Production_ID=" + mprod.ID;
			%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><a class="row-link" href="<%=mprodUrl%>"><strong><%=mprod.Production_Code%></strong></a><span class="zcs-font-12 zcs-color-tertiary"><%=mprod.Production_Status%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-6"><%=ifnull(mprod.Product.Product_Name,"Product pending")%> - <%=ifnull(mprod.Colour,"Colour not set")%></div><div class="zcs-font-13 zcs-mt-8">Qty <%=ifnull(mprod.Quantity,0)%> <%=ifnull(mprod.Unit.Unit_Name,"")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Material <%=ifnull(mprod.Material_Status,"Not checked")%> - Powder <%=ifnull(mprod.Powder_Coating_Status,"Not required")%></div></div>
<%
		}
		if(mobileProdRows == 0)
		{
			%>
<div class="empty-soft">No linked Production_Records were found for this installation order.</div>
<%
		}
		%>
</div>
					</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Permit clearance</h2><p class="detail-card-note">Order-level permits affecting the installation schedule.</p></div></div>
					<div class="detail-card-body">
<%
		if(permitRecords.count() == 0)
		{
			%>
<div class="empty-soft">No linked Permit_Records were found. Installation permit clearance is <%=inst_rec.Permit_Clearance_Status%>.</div>
<%
		}
		else
		{
			%>
<div class="link-list">
<%
			for each  permit in permitRecords
			{
				permitUrl = "#Page:Permit_Detail?Permit_ID=" + permit.ID;
				permitStatusClass = "zcs-badge-blue";
				if(permit.Permit_Status == "Approved" || permit.Permit_Status == "Not Required")
				{
					permitStatusClass = "zcs-badge-green";
				}
				else if(permit.Permit_Status == "Rejected" || permit.Permit_Status == "Expired")
				{
					permitStatusClass = "zcs-badge-red";
				}
				else if(permit.Permit_Status == "Required" || permit.Permit_Status == "Preparing")
				{
					permitStatusClass = "zcs-badge-yellow";
				}
				%>
<div class="link-row"><div><a class="row-link" href="<%=permitUrl%>"><%=permit.Permit_Code%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=ifnull(permit.Authority_Name,"Authority pending")%> - <%=ifnull(permit.Permit_Number,"No number")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Submitted <%=ifnull(permit.Submitted_Date,"Not set")%> - Approved <%=ifnull(permit.Approved_Date,"Not set")%></div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=permitStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=permit.Permit_Status%></span></span></div>
<%
			}
			%>
</div>
<%
		}
		%>
</div>
				</section>

				<section class="detail-card detail-span-6">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Status timeline</h2><p class="detail-card-note">Current progress through the installation lifecycle.</p></div></div>
					<div class="detail-card-body">
						<div class="zcs-timeline-wrapper">
							<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		stepStatuses = {"Forecast","Waiting for Production","Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed"};
		currentStepIndex = stepStatuses.indexOf(inst_rec.Installation_Status);
		for each index stepIndex in stepStatuses
		{
			stepStatus = stepStatuses.get(stepIndex);
			tlClass = "";
			iconName = "ui-2-time";
			if(currentStepIndex > stepIndex)
			{
				tlClass = "zcs-tl-li-complete";
				iconName = "ui-1-check-circle-08";
			}
			else if(currentStepIndex == stepIndex)
			{
				tlClass = "zcs-tl-li-active";
				iconName = "loader-dots-06";
			}
			%>
<li class="zcs-tl-li <%=tlClass%> zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline <%=iconName%>"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Step <%=stepIndex + 1%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=stepStatus%></h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0"><%=if(currentStepIndex > stepIndex,"Completed or passed",if(currentStepIndex == stepIndex,"Current stage","Awaiting previous stage"))%></p></div></li>
<%
		}
		if(inst_rec.Installation_Status == "On Hold" || inst_rec.Installation_Status == "Cancelled")
		{
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline ui-2-alert-circle" style="background:#FDE3E6;color:#FE455D;"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Exception</span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=inst_rec.Installation_Status%></h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0">See comment history for reason and next action.</p></div></li>
<%
		}
		%>
</ul>
						</div>
					</div>
				</section>

				<section class="detail-card detail-span-12">
					<div class="detail-card-header"><div><h2 class="detail-card-title">Comment history</h2><p class="detail-card-note">Action_Comments audit trail for this installation and linked order, production, and permit records.</p></div></div>
					<div class="detail-card-body">
						<div class="zcs-timeline-wrapper">
							<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		commentRows = 0;
		for each  comment in Action_Comments[Target_Module == "Installation_Schedules" && Lookup_ID == inst_rec.ID] sort by Action_Date desc
		{
			commentRows = commentRows + 1;
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=comment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=comment.New_Status%></h6><span class="comment-module">Installation <%=inst_rec.Installation_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(comment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=comment.Comments%></p></div></li>
<%
		}
		if(order_rec.count() > 0)
		{
			for each  orderComment in Action_Comments[Target_Module == "Customer_Orders" && Lookup_ID == order_rec.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=orderComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=orderComment.New_Status%></h6><span class="comment-module">Order <%=order_rec.Order_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(orderComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=orderComment.Comments%></p></div></li>
<%
			}
		}
		for each  prodCommentTarget in productionRecords
		{
			for each  prodComment in Action_Comments[Target_Module == "Production_Records" && Lookup_ID == prodCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=prodComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=prodComment.New_Status%></h6><span class="comment-module">Production <%=prodCommentTarget.Production_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(prodComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=prodComment.Comments%></p></div></li>
<%
			}
		}
		for each  permitCommentTarget in permitRecords
		{
			for each  permitComment in Action_Comments[Target_Module == "Permit_Records" && Lookup_ID == permitCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=permitComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=permitComment.New_Status%></h6><span class="comment-module">Permit <%=permitCommentTarget.Permit_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(permitComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=permitComment.Comments%></p></div></li>
<%
			}
		}
		if(commentRows == 0)
		{
			%>
<li><div class="empty-soft">No Action_Comments have been recorded for this installation or linked operational records.</div></li>
<%
		}
		%>
</ul>
						</div>
					</div>
				</section>
			</div>
<%
	}
	%>
</div>
</div>