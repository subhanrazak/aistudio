<page linkname = "FA_Team_Dashboard" displayname = "F&amp;A Team Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='FA_Dashboard_Overview' elementName='FA_Dashboard_Overview'>
          <![CDATA[htmlpage FA_Dashboard_Overview()
             content
             <%{%>
                 <file name:FA_Dashboard_Overview.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Attendance_Invoice_List_FA.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Consumable_Invoice_List_FA.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Warning_List_FA.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Vendor_Master_List.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:FMS_Employee_Master_List.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Audit_Log_Books_Push.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
