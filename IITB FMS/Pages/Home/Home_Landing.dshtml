<%
loginEmail = zoho.loginuser;
displayUser = zoho.loginuser;
if(displayUser == null || displayUser == "")
{
    displayUser = zoho.loginuserid;
}
profileName = thisapp.permissions.loginUserProfile();
roleDisplay = profileName;
if(profileName == "Infra_Team")
{
    roleDisplay = "Infra Team";
}
else if(profileName == "FA_Team")
{
    roleDisplay = "F&A Team";
}
else if(profileName == "FMS_Vendor")
{
    roleDisplay = "FMS Vendor";
}
else if(profileName == "Administrator")
{
    roleDisplay = "Administrator";
}

infraAttendancePending = 0;
infraConsumablePending = 0;
infraMaintenanceSubmitted = 0;
infraAssetsDue = 0;
infraWarningsOpen = 0;
infraPendingTotal = 0;

faAttendanceInvoicePending = 0;
faConsumablePending = 0;
faDisciplinaryPending = 0;
faPendingTotal = 0;

vendorAttendanceAction = 0;
vendorInvoiceAction = 0;
vendorMaintenanceAction = 0;
vendorWarningAction = 0;
vendorPendingTotal = 0;

if(profileName == "Infra_Team" || profileName == "Administrator")
{
    infraAttendancePending = Attendance_Submission[Status == "Pending Validation"].count();
    infraConsumablePending = Consumable_Invoice[Status == "Pending Infra Validation"].count();
    infraMaintenanceSubmitted = Maintenance_Task[Status == "Submitted"].count();
    infraAssetsDue = Asset_Master[Status == "Active" && Next_Maintenance_Date <= zoho.currentdate.addDay(7)].count();
    infraWarningsOpen = Warning_Penalty[Status != "Acknowledged" && Status != "Cancelled"].count();
    infraPendingTotal = infraAttendancePending + infraConsumablePending + infraMaintenanceSubmitted + infraAssetsDue + infraWarningsOpen;
}

if(profileName == "FA_Team" || profileName == "Administrator")
{
    faAttendanceInvoicePending = Attendance_Invoice[Status == "Pending F&A Validation"].count();
    faConsumablePending = Consumable_Invoice[Status == "Pending F&A Validation"].count();
    faDisciplinaryPending = Warning_Penalty[Issue_Type == "Disciplinary" && Status == "Pending F&A Action"].count();
    faPendingTotal = faAttendanceInvoicePending + faConsumablePending + faDisciplinaryPending;
}

if(profileName == "FMS_Vendor" || profileName == "Administrator")
{
    vendorAttendanceAction = Attendance_Submission[Vendor_Email == loginEmail && (Status == "Pending Upload" || Status == "Rejected")].count();
    vendorInvoiceAction = Attendance_Invoice[Vendor_Email == loginEmail && Status == "Rejected"].count() + Consumable_Invoice[Vendor_Email == loginEmail && Status == "Rejected"].count();
    vendorMaintenanceAction = Maintenance_Task[Vendor_Email == loginEmail && (Status == "Pending" || Status == "Rejected")].count();
    vendorWarningAction = Warning_Penalty[Vendor_Email == loginEmail && Status == "Pending FMS Acknowledgement"].count();
    vendorPendingTotal = vendorAttendanceAction + vendorInvoiceAction + vendorMaintenanceAction + vendorWarningAction;
}

primaryDashboard = "Home";
primaryDashboardLabel = "Stay on Home";
primaryPending = 0;
if(profileName == "Infra_Team")
{
    primaryDashboard = "Infra_Team_Dashboard";
    primaryDashboardLabel = "Open Infra dashboard";
    primaryPending = infraPendingTotal;
}
else if(profileName == "FA_Team")
{
    primaryDashboard = "FA_Team_Dashboard";
    primaryDashboardLabel = "Open F&A dashboard";
    primaryPending = faPendingTotal;
}
else if(profileName == "FMS_Vendor")
{
    primaryDashboard = "FMS_Vendor_Dashboard";
    primaryDashboardLabel = "Open Vendor dashboard";
    primaryPending = vendorPendingTotal;
}
primaryUrl = "#Page:" + primaryDashboard;
%>
<style>
/* ===== zcs-global.css: utility classes used by fetched ZCS components on this page ===== */
:root {
    --zcs-theme-brand-color: var(--zcs_brand_color);
    --zcs-light-bg-color: var(--zcs_brand_light_color);
    --zcs-primary-text-color: var(--zcs_primary_text_color);
    --zcs-secondary-text-color: var(--zcs_secondary_text_color);
    --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
    --zcs-border-color: var(--zcs_tertiary_border_color);
    --zcs-white-color: #FFFFFF;
    --zcs-black-color: #000000;
    --zcs-primary-btn-color: var(--zcs_brand_color);
    --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color);
    --iitb-blue: #004B8D;
    --iitb-blue-dark: #002F6C;
    --iitb-blue-light: #E8F2FC;
    --fms-saffron: #F7A600;
    font-size: 16px;
    line-height: 1.5;
}
* { box-sizing: border-box; }
a { text-decoration: none; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #E4E8F0; border-radius: 12px; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-stretch { align-items: stretch; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-w-full { width: 100%; }
.zcs-col-common { flex: 1 1 0%; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-box-border { box-sizing: border-box; }
.zcs-p-8 { padding: 0.5rem; }
.zcs-p-10 { padding: 0.625rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-5 { padding-top: 0.3125rem; padding-bottom: 0.3125rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-rounded-xl { border-radius: 0.75rem; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ===== button-primary-button CSS, deduped for primary and outline actions ===== */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease; }
.zcs-button:hover { transform: translateY(-1px); }
.zcs-primary-button { background-color: var(--iitb-blue); color: #FFFFFF; border: 1px solid var(--iitb-blue); }
.zcs-primary-button.zcs-button:hover { background-color: var(--iitb-blue-dark); border-color: var(--iitb-blue-dark); color: #FFFFFF; }
.zcs-primary-outline-button { border: 1px solid var(--iitb-blue); background-color: #FFFFFF; color: var(--iitb-blue); }
.zcs-primary-outline-button:hover { background-color: var(--iitb-blue-light); border-color: var(--iitb-blue); color: var(--iitb-blue); }
.zcs-button-icon { width: 16px; max-height: 16px; }

/* ===== badge-badge-with-icon CSS ===== */
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8F2FC; border-color: var(--iitb-blue); color: var(--iitb-blue); }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FFF7E1; border-color: #D99000; color: #9B6500; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #F4F6F8; border-color: #A5AAB3; color: #3F4652; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #C81E35; }

/* ===== card-template CSS adapted for dashboard cards ===== */
.zcs-template-card { width: 100%; min-height: 258px; overflow: hidden; }
.zcs-card-header { border-bottom: 1px solid #E6EAF2; }
.zcs-card-content { flex: 1 1 auto; }
.zcs-template-card .zcs-card-footer { background-color: #F8FAFD; border-top: 1px solid #E6EAF2; position: static; display: flex; }
.zcs-template-card .zcs-card-footer .zcs-button { min-height: 32px; }
.zcs-card-action { background-color: #FFFFFF; }
.zcs-card-action:hover { color: var(--iitb-blue); background-color: var(--iitb-blue-light); }

/* ===== header-heading-with-actions CSS scoped to this landing page ===== */
.zcs-page-header { border-bottom: 1px solid rgba(255,255,255,0.18); }

/* ===== FMS Home custom layout, built on ZCS components ===== */
.fms-home { min-height: 100%; padding: 0; background: #F2F5FA; color: #172033; font-family: Lato, Arial, sans-serif; }
.fms-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 88% 18%, rgba(247,166,0,0.34) 0, rgba(247,166,0,0.18) 17%, transparent 36%), linear-gradient(135deg, var(--iitb-blue-dark) 0%, var(--iitb-blue) 58%, #0A6EB8 100%);
    color: #FFFFFF;
}
.fms-hero:before {
    content: "";
    position: absolute;
    inset: -80px -60px auto auto;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 50%;
}
.fms-hero:after {
    content: "";
    position: absolute;
    right: 80px;
    bottom: -110px;
    width: 240px;
    height: 240px;
    border: 32px solid rgba(255,255,255,0.08);
    border-radius: 50%;
}
.fms-hero-content { position: relative; z-index: 1; padding: 30px; }
.fms-brand-mark { width: 42px; height: 42px; border-radius: 12px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; }
.fms-brand-mark i { font-size: 22px; }
.fms-hero-title { margin: 0; font-size: 30px; line-height: 1.18; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF; }
.fms-hero-subtitle { max-width: 760px; margin: 10px 0 0; color: rgba(255,255,255,0.86); font-size: 15px; line-height: 1.6; }
.fms-hero .zcs-color-primary, .fms-hero .zcs-color-secondary { color: #FFFFFF; }
.fms-hero .zcs-primary-outline-button { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.74); color: #FFFFFF; }
.fms-hero .zcs-primary-outline-button:hover { background: rgba(255,255,255,0.18); color: #FFFFFF; }
.fms-kpi-strip { margin-top: 24px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.fms-kpi-card { padding: 16px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.12); border-radius: 14px; backdrop-filter: blur(8px); min-height: 104px; }
.fms-kpi-card .fms-kpi-value { display: block; color: #FFFFFF; font-size: 29px; line-height: 1; font-weight: 700; }
.fms-kpi-card .fms-kpi-label { display: block; margin-top: 8px; color: rgba(255,255,255,0.84); font-size: 13px; line-height: 1.35; }
.fms-kpi-card .fms-kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; background: rgba(255,255,255,0.16); color: #FFFFFF; }
.fms-body { padding: 26px 30px 34px; }
.fms-section-heading { margin-bottom: 16px; }
.fms-section-heading h2 { margin: 0; color: #172033; font-size: 22px; font-weight: 700; }
.fms-section-heading p { margin: 6px 0 0; color: #647084; font-size: 14px; line-height: 1.55; }
.fms-card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
.fms-dashboard-card { border: 1px solid #E1E7F0; box-shadow: 0 12px 30px rgba(20, 38, 72, 0.08); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; }
.fms-dashboard-card:hover { transform: translateY(-3px); border-color: rgba(0,75,141,0.42); box-shadow: 0 18px 36px rgba(20, 38, 72, 0.13); }
.fms-card-topline { height: 4px; background: linear-gradient(90deg, var(--iitb-blue), #0A6EB8 70%, var(--fms-saffron)); }
.fms-card-icon { width: 44px; height: 44px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: var(--iitb-blue-light); color: var(--iitb-blue); margin-bottom: 14px; }
.fms-card-icon i { font-size: 22px; }
.fms-card-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.fms-card-count { min-width: 42px; padding: 6px 8px; text-align: center; border-radius: 10px; background: #F1F6FD; color: var(--iitb-blue); font-weight: 700; font-size: 18px; line-height: 1; }
.fms-card-count span { display: block; margin-top: 3px; color: #6E7A8E; font-weight: 500; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; }
.fms-card-description { margin: 12px 0 14px; color: #596579; font-size: 14px; line-height: 1.55; }
.fms-mini-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
.fms-mini-metric { padding: 10px; border-radius: 10px; background: #F8FAFD; border: 1px solid #EEF2F7; }
.fms-mini-metric strong { display: block; color: #162033; font-size: 17px; line-height: 1; }
.fms-mini-metric span { display: block; margin-top: 5px; color: #6B7588; font-size: 11px; line-height: 1.3; }
.fms-summary-panel { margin-top: 20px; padding: 18px; border-radius: 14px; border: 1px solid #E1E7F0; background: #FFFFFF; box-shadow: 0 10px 24px rgba(20,38,72,0.06); }
.fms-summary-panel p { margin: 0; color: #586579; font-size: 14px; line-height: 1.6; }
.fms-summary-panel strong { color: #172033; }
@media (max-width: 1180px) {
    .fms-kpi-strip, .fms-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
    .fms-hero-content, .fms-body { padding: 22px 18px; }
    .zcs-page-header { padding: 16px 18px; align-items: flex-start; flex-direction: column; }
    .fms-hero-title { font-size: 24px; }
    .fms-kpi-strip, .fms-card-grid { grid-template-columns: 1fr; }
}
</style>

<div class="fms-home">
    <section class="fms-hero">
        <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border'>
            <div class='zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis'>
                <div class="fms-brand-mark zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink">
                    <i class="zc-li-outline ui-1-home-minimal"></i>
                </div>
                <div class="zcs-ellipsis">
                    <h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'>FMS Home</h5>
                    <div class='zcs-font-13 zcs-lh-body zcs-color-secondary zcs-ellipsis'>IIT Bombay Facilities Management System</div>
                </div>
            </div>
            <div class='zcs-flex zcs-align-items-center zcs-gap-12'>
                <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'>
                    <i class='zcs-badge-icon zcs-no-shrink zc-li-outline users_single-03'></i>
                    <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=roleDisplay%></span>
                </div>
                <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=primaryUrl%>'>
                    <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
                    <span class='zcs-button-text'><%=primaryDashboardLabel%></span>
                </a>
            </div>
        </div>

        <div class="fms-hero-content">
            <div class="zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-20">
                <div>
                    <h1 class="fms-hero-title">Hello <%=displayUser%></h1>
                    <p class="fms-hero-subtitle">Use this page-first entry point to reach the Facilities Management queues assigned to your profile. Dashboard access is enforced by profile page permissions, so each user opens only the role dashboard enabled for them.</p>
                </div>
                <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'>
                    <i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time'></i>
                    <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=primaryPending%> pending in your queue</span>
                </div>
            </div>

            <div class="fms-kpi-strip">
                <div class="fms-kpi-card">
                    <span class="fms-kpi-icon"><i class="zc-li-outline ui-2-time"></i></span>
                    <span class="fms-kpi-value"><%=primaryPending%></span>
                    <span class="fms-kpi-label">Pending items for your active profile</span>
                </div>
                <div class="fms-kpi-card">
                    <span class="fms-kpi-icon"><i class="zc-li-outline files_single-content-03"></i></span>
                    <span class="fms-kpi-value"><%=vendorPendingTotal%></span>
                    <span class="fms-kpi-label">Vendor action items visible to this login</span>
                </div>
                <div class="fms-kpi-card">
                    <span class="fms-kpi-icon"><i class="zc-li-outline business_chart-bar-32"></i></span>
                    <span class="fms-kpi-value"><%=infraPendingTotal%></span>
                    <span class="fms-kpi-label">Infra validation and maintenance queue</span>
                </div>
                <div class="fms-kpi-card">
                    <span class="fms-kpi-icon"><i class="zc-li-outline business_money-coins"></i></span>
                    <span class="fms-kpi-value"><%=faPendingTotal%></span>
                    <span class="fms-kpi-label">F&A invoice and disciplinary queue</span>
                </div>
            </div>
        </div>
    </section>

    <main class="fms-body">
        <div class="fms-section-heading">
            <h2>Navigate to your workspace</h2>
            <p>Cards remain visible as a landing map. The app profiles decide which destination page can be opened by each user.</p>
        </div>

        <div class="fms-card-grid">
            <div class='zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card'>
                <div class="fms-card-topline"></div>
                <div class='zcs-card-header zcs-p-16 zcs-box-border zcs-relative'>
                    <div class="fms-card-title-row">
                        <div>
                            <span class="fms-card-icon"><i class="zc-li-outline ui-1-home-minimal"></i></span>
                            <h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Home</h6>
                        </div>
                        <div class="fms-card-count">0<span>Data</span></div>
                    </div>
                </div>
                <div class='zcs-card-content zcs-col-common zcs-p-16 zcs-box-border'>
                    <p class="fms-card-description">Role-aware landing page with profile-safe routing, IITB-blue styling, and a quick view of pending work.</p>
                    <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'>
                        <i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
                        <span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Current entry point</span>
                    </div>
                </div>
                <div class='zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute'>
                    <a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Page:Home'>
                        <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
                        <span class='zcs-button-text'>Open Home</span>
                    </a>
                </div>
            </div>

            <div class='zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card'>
                <div class="fms-card-topline"></div>
                <div class='zcs-card-header zcs-p-16 zcs-box-border zcs-relative'>
                    <div class="fms-card-title-row">
                        <div>
                            <span class="fms-card-icon"><i class="zc-li-outline business_chart-bar-32"></i></span>
                            <h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Infra Team Dashboard</h6>
                        </div>
                        <div class="fms-card-count"><%=infraPendingTotal%><span>Queue</span></div>
                    </div>
                </div>
                <div class='zcs-card-content zcs-col-common zcs-p-16 zcs-box-border'>
                    <p class="fms-card-description">Attendance validation, consumable infra checks, submitted maintenance reports, asset due dates, and warning cases.</p>
                    <div class="fms-mini-metrics">
                        <div class="fms-mini-metric"><strong><%=infraAttendancePending%></strong><span>Attendance</span></div>
                        <div class="fms-mini-metric"><strong><%=infraMaintenanceSubmitted%></strong><span>Maintenance</span></div>
                    </div>
                </div>
                <div class='zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute'>
                    <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Page:Infra_Team_Dashboard'>
                        <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
                        <span class='zcs-button-text'>Open dashboard</span>
                    </a>
                </div>
            </div>

            <div class='zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card'>
                <div class="fms-card-topline"></div>
                <div class='zcs-card-header zcs-p-16 zcs-box-border zcs-relative'>
                    <div class="fms-card-title-row">
                        <div>
                            <span class="fms-card-icon"><i class="zc-li-outline business_money-coins"></i></span>
                            <h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>F&A Team Dashboard</h6>
                        </div>
                        <div class="fms-card-count"><%=faPendingTotal%><span>Queue</span></div>
                    </div>
                </div>
                <div class='zcs-card-content zcs-col-common zcs-p-16 zcs-box-border'>
                    <p class="fms-card-description">Attendance invoices, consumable F&A approvals, disciplinary actions, vendor references, and finance audit activity.</p>
                    <div class="fms-mini-metrics">
                        <div class="fms-mini-metric"><strong><%=faAttendanceInvoicePending%></strong><span>Attendance invoices</span></div>
                        <div class="fms-mini-metric"><strong><%=faConsumablePending%></strong><span>Consumables</span></div>
                    </div>
                </div>
                <div class='zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute'>
                    <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Page:FA_Team_Dashboard'>
                        <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
                        <span class='zcs-button-text'>Open dashboard</span>
                    </a>
                </div>
            </div>

            <div class='zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card'>
                <div class="fms-card-topline"></div>
                <div class='zcs-card-header zcs-p-16 zcs-box-border zcs-relative'>
                    <div class="fms-card-title-row">
                        <div>
                            <span class="fms-card-icon"><i class="zc-li-outline users_single-03"></i></span>
                            <h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>FMS Vendor Dashboard</h6>
                        </div>
                        <div class="fms-card-count"><%=vendorPendingTotal%><span>Mine</span></div>
                    </div>
                </div>
                <div class='zcs-card-content zcs-col-common zcs-p-16 zcs-box-border'>
                    <p class="fms-card-description">Attendance uploads, own invoices, maintenance reports, warning acknowledgements, employee roster, and asset reference.</p>
                    <div class="fms-mini-metrics">
                        <div class="fms-mini-metric"><strong><%=vendorAttendanceAction%></strong><span>Attendance</span></div>
                        <div class="fms-mini-metric"><strong><%=vendorWarningAction%></strong><span>Acknowledgements</span></div>
                    </div>
                </div>
                <div class='zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute'>
                    <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Page:FMS_Vendor_Dashboard'>
                        <i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
                        <span class='zcs-button-text'>Open dashboard</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="fms-summary-panel">
            <p><strong>App summary:</strong> IITB FMS centralizes vendor attendance uploads, invoices, consumable validation, employee warnings, scheduled maintenance, and audit logging. Use the dashboard matching your profile for operational lists and workflow actions; this Home page does not expose data-entry controls.</p>
        </div>
    </main>
</div>
