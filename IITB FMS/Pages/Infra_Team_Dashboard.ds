<page linkname = "Infra_Team_Dashboard" displayname = "Infra Team Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Infra_Dashboard_Overview' elementName='Infra_Dashboard_Overview'>
          <![CDATA[htmlpage Infra_Dashboard_Overview()
             content
             <%{%>
                 <file name:Infra_Dashboard_Overview.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Attendance_Submission_List_Infra.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Consumable_Invoice_List_Infra.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Maintenance_Task_List_Infra.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Asset_Master_List_Infra.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Warning_List_Infra.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:FMS_Employee_Attendance_Data.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Audit_Log.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
