"FA_Team"
{
    name        = "FA_Team"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Finance staff who validate invoices, record disciplinary action, and later push bills to Zoho Books."

    ModulePermissions
    {
        User_Master
        {
            enabled = Viewall,View,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Vendor_Master_List={"View"}
            }
        }
        FMS_Employee_Master
        {
            enabled = Viewall,View,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                FMS_Employee_Master_List={"View"}
            }
        }
        Warning_Penalty_Type_Master
        {
            enabled = Viewall,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Warning_Penalty_Type_Master_List={"View"}
            }
        }
        Attendance_Submission
        {
            enabled = Viewall,View,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Attendance_Submission_List_All={"View"}
            }
        }
        Attendance_Record
        {
            enabled = Viewall,View,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                FMS_Employee_Attendance_Data={"View"}
            }
        }
        Attendance_Invoice
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Attendance_Invoice_List_FA={"View"}
            }
        }
        Consumable_Invoice
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Consumable_Invoice_List_FA={"View"}
            }
        }
        Warning_Penalty
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Warning_List_FA={"View"}
            }
        }
        Action_Capture
        {
            enabled = Create,View,Edit
            allFieldsVisible = false
            FieldPermissions
            {
                Target_Form{visibility:false}
                Target_Record_ID{visibility:false}
                Action_Code{visibility:false}
            }
        }
        Audit_Log
        {
            enabled = Viewall,View,Search,Export
            allFieldsVisible = true
            ReportPermissions
            {
                Audit_Log_List={"View"}
            }
        }
        Home
        {
            enabled = tab
        }
