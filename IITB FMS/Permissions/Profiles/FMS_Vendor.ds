"FMS_Vendor"
{
    name        = "FMS_Vendor"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Vendor users who upload attendance files, submit invoices and maintenance reports, and acknowledge warnings."

    ModulePermissions
