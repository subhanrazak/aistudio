customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header,.zc-menu-space-active{background:#004B8D;} .zc-menu-component-active,.zc-menu-section-active{color:#004B8D;} .zc-page-title{font-weight:600;}"
    }
}
