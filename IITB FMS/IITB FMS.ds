se' heightType='custom' heightValue='520' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Maintenance_Task_List_Infra_Embed' title='Maintenance Reports Submitted to Infra' titleColor='#172033' boldTitle='true' appLinkName='thisapp' linkName='Maintenance_Task_List_Infra' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='true' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Asset_Master_List_Infra_Embed' title='Active Assets and Maintenance Due Soon' titleColor='#172033' boldTitle='true' appLinkName='thisapp' linkName='Asset_Master_List_Infra' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='true' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='520' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Warning_List_Infra_Embed' title='Warnings and Disciplinary Cases' titleColor='#172033' boldTitle='true' appLinkName='thisapp' linkName='Warning_List_Infra' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='true' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='500' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='FMS_Employee_Attendance_Data_Embed' title='FMS Employee Attendance Data Snapshot' titleColor='#172033' boldTitle='true' appLinkName='thisapp' linkName='FMS_Employee_Attendance_Data' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='true' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='460' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Audit_Log_Recent_Activity_Embed' title='Audit Log Recent Activity' titleColor='#172033' boldTitle='true' appLinkName='thisapp' linkName='Audit_Log_List' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='true' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Action_Capture_On_Load as "Action Capture On Load"
			{
			    type = form
			    form = Action_Capture
			    record event = on add
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Target_Form;
			                hide Target_Record_ID;
			                hide Action_Taken;
			                hide Action_Taken_Date;
			                hide Acknowledgement_Comment;
			                if(input.Action_Code == "WARNING_FA_ACTION")
			                {
			                    hide Reason;
			                    show Action_Taken;
			                    show Action_Taken_Date;
			                }
			                else if(input.Action_Code == "WARNING_ACKNOWLEDGE")
			                {
			                    hide Reason;
			                    show Acknowledgement_Comment;
			                }
			                else
			                {
			                    show Reason;
			                }
			            )
			        }
			    }
			}

			Action_Capture_On_Validate as "Action Capture On Validate"
			{
			    type = form
			    form = Action_Capture
			    record event = on add
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Target_Form in {"", " ", "null"} || input.Target_Record_ID == null)
			                {
			                    alert "This action must be opened from a report button.";
			                    cancel submit;
			                }
			                if(input.Action_Code in {"ATTENDANCE_REJECT", "ATTENDANCE_INVOICE_REJECT", "CONSUMABLE_INFRA_REJECT", "CONSUMABLE_FA_REJECT", "MAINTENANCE_REJECT"} && input.Reason in {"", " ", "null"})
			                {
			                    alert "Reason is required for rejection.";
			                    cancel submit;
			                }
			                if(input.Action_Code == "WARNING_FA_ACTION" && (input.Action_Taken in {"", " ", "null"} || input.Action_Taken_Date == null))
			                {
			                    alert "Action taken and action taken date are required.";
			                    cancel submit;
			                }
			                if(input.Action_Code == "WARNING_ACKNOWLEDGE" && input.Acknowledgement_Comment in {"", " ", "null"})
			                {
			                    alert "Acknowledgement comment is required.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Action_Code_On_User_Input as "Action Code On User Input"
			{
			    type = form
			    form = Action_Capture
			    record event = on add
			
			    on user input of Action_Code
			    {
			        actions
			        {
			            custom deluge script
			            (
			                hide Action_Taken;
			                hide Action_Taken_Date;
			                hide Acknowledgement_Comment;
			                if(input.Action_Code == "WARNING_FA_ACTION")
			                {
			                    hide Reason;
			                    show Action_Taken;
			                    show Action_Taken_Date;
			                }
			                else if(input.Action_Code == "WARNING_ACKNOWLEDGE")
			                {
			                    hide Reason;
			                    show Acknowledgement_Comment;
			                }
			                else
			                {
			                    show Reason;
			                }
			            )
			        }
			    }
			}

			Action_Capture_Submit_Action as "Submit Action"
			{
			    type = form
			    form = Action_Capture
			    button = Submit_Action
			
			    on click
			    {
			        actions
			        {
			            on click
			            (
			                targetId = input.Target_Record_ID;
			                if(input.Action_Code == "ATTENDANCE_REJECT")
			                {
			                    attendanceSubmissionRec = Attendance_Submission[ID == targetId];
			                    if(attendanceSubmissionRec.count() > 0 && attendanceSubmissionRec.Status == "Pending Validation")
			                    {
			                        oldStatus = attendanceSubmissionRec.Status;
			                        attendanceSubmissionRec.Status = "Rejected";
			                        attendanceSubmissionRec.Remarks = input.Reason;
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Attendance"
			                            Source_Form = "Attendance_Submission"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = attendanceSubmissionRec.Submission_ID.toString()
			                            Action_Type = "Rejected"
			                            Old_Status = oldStatus
			                            New_Status = "Rejected"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Reason
			                        ]
			                    }
			                }
			                else if(input.Action_Code == "ATTENDANCE_INVOICE_REJECT")
			                {
			                    attendanceInvoiceRec = Attendance_Invoice[ID == targetId];
			                    if(attendanceInvoiceRec.count() > 0 && attendanceInvoiceRec.Status == "Pending F&A Validation")
			                    {
			                        oldStatus = attendanceInvoiceRec.Status;
			                        attendanceInvoiceRec.Status = "Rejected";
			                        attendanceInvoiceRec.Rejection_Reason = input.Reason;
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Attendance Invoice"
			                            Source_Form = "Attendance_Invoice"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = attendanceInvoiceRec.Invoice_Number
			                            Action_Type = "Rejected"
			                            Old_Status = oldStatus
			                            New_Status = "Rejected"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Reason
			                        ]
			                    }
			                }
			                else if(input.Action_Code == "CONSUMABLE_INFRA_REJECT" || input.Action_Code == "CONSUMABLE_FA_REJECT")
			                {
			                    consumableInvoiceRec = Consumable_Invoice[ID == targetId];
			                    if(consumableInvoiceRec.count() > 0)
			                    {
			                        oldStatus = consumableInvoiceRec.Status;
			                        consumableInvoiceRec.Status = "Rejected";
			                        consumableInvoiceRec.Rejection_Reason = input.Reason;
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Consumables"
			                            Source_Form = "Consumable_Invoice"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = consumableInvoiceRec.Invoice_Number
			                            Action_Type = "Rejected"
			                            Old_Status = oldStatus
			                            New_Status = "Rejected"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Reason
			                        ]
			                    }
			                }
			                else if(input.Action_Code == "WARNING_FA_ACTION")
			                {
			                    warningFARec = Warning_Penalty[ID == targetId];
			                    if(warningFARec.count() > 0 && warningFARec.Status == "Pending F&A Action")
			                    {
			                        oldStatus = warningFARec.Status;
			                        warningFARec.Action_Taken_By_FA = input.Action_Taken;
			                        warningFARec.Action_Taken_Date = input.Action_Taken_Date;
			                        warningFARec.Status = "Pending FMS Acknowledgement";
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Disciplinary"
			                            Source_Form = "Warning_Penalty"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = warningFARec.Warning_ID.toString()
			                            Action_Type = "Status Changed"
			                            Old_Status = oldStatus
			                            New_Status = "Pending FMS Acknowledgement"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Action_Taken
			                        ]
			                        if(warningFARec.Vendor_Email not in {"", " ", "null"})
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : warningFARec.Vendor_Email
			                                subject : "DISCIPLINARY_ACTION_TAKEN: " + warningFARec.Warning_ID
			                                message : "F&A action has been recorded for the disciplinary case. Action: " + input.Action_Taken + ". Please acknowledge the case."
			                            )
			                        }
			                    }
			                }
			                else if(input.Action_Code == "WARNING_ACKNOWLEDGE")
			                {
			                    warningAckRec = Warning_Penalty[ID == targetId];
			                    if(warningAckRec.count() > 0 && warningAckRec.Status == "Pending FMS Acknowledgement")
			                    {
			                        oldStatus = warningAckRec.Status;
			                        warningAckRec.FMS_Acknowledgement_Comment = input.Acknowledgement_Comment;
			                        warningAckRec.Status = "Acknowledged";
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Disciplinary"
			                            Source_Form = "Warning_Penalty"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = warningAckRec.Warning_ID.toString()
			                            Action_Type = "Acknowledged"
			                            Old_Status = oldStatus
			                            New_Status = "Acknowledged"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Acknowledgement_Comment
			                        ]
			                        infraRecipients = List();
			                        for each infraUserRec in User_Master[Role == "Infra Team" && Status == "Active"]
			                        {
			                            infraRecipients.add(infraUserRec.Email);
			                        }
			                        if(infraRecipients.size() > 0)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : infraRecipients
			                                subject : "WARNING_ACKNOWLEDGED: " + warningAckRec.Warning_ID
			                                message : "The vendor has acknowledged warning / penalty case " + warningAckRec.Warning_ID + ". Comment: " + input.Acknowledgement_Comment
			                            )
			                        }
			                    }
			                }
			                else if(input.Action_Code == "MAINTENANCE_REJECT")
			                {
			                    maintenanceTaskRec = Maintenance_Task[ID == targetId];
			                    if(maintenanceTaskRec.count() > 0 && maintenanceTaskRec.Status == "Submitted")
			                    {
			                        oldStatus = maintenanceTaskRec.Status;
			                        maintenanceTaskRec.Status = "Rejected";
			                        maintenanceTaskRec.Rejection_Remarks = input.Reason;
			                        insert into Maintenance_Task_History
			                        [
			                            Maintenance_Task = maintenanceTaskRec.ID
			                            Vendor_Email = maintenanceTaskRec.Vendor_Email
			                            Status = "Rejected"
			                            Comments = input.Reason
			                            Updated_By_Email = zoho.loginuser
			                            Updated_On = zoho.currenttime
			                        ]
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Maintenance"
			                            Source_Form = "Maintenance_Task"
			                            Source_Record_ID = targetId
			                            Source_Record_Label = maintenanceTaskRec.Task_ID.toString()
			                            Action_Type = "Rejected"
			                            Old_Status = oldStatus
			                            New_Status = "Rejected"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = input.Reason
			                        ]
			                        if(maintenanceTaskRec.Vendor_Email not in {"", " ", "null"})
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : maintenanceTaskRec.Vendor_Email
			                                subject : "MAINTENANCE_REJECTED: " + maintenanceTaskRec.Task_ID
			                                message : "Maintenance task was rejected. Reason: " + input.Reason
			                            )
			                        }
			                    }
			                }
			                openUrl("#Page:Home", "same window");
			            )
			        }
			    }
			}

			Asset_Category_Master_Delete_Validate as "Asset Category Master Delete Validation"
			{
			    type = form
			    form = Asset_Category_Master
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Administrator-only delete permission plus dependency checks are completed after Asset_Master exists.
			            )
			        }
			    }
			}

			Asset_Category_Master_On_Validate as "Asset Category Master On Validate"
			{
			    type = form
			    form = Asset_Category_Master
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                duplicateCategories = Asset_Category_Master[Category_Name == input.Category_Name && Status == "Active" && ID != input.ID];
			                if(input.Status == "Active" && duplicateCategories.count() > 0)
			                {
			                    alert "An active asset category with this name already exists.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Master_Delete_Validate as "Asset Master Delete Validation"
			{
			    type = form
			    form = Asset_Master
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                schedules = Maintenance_Schedule_Configuration[Asset == input.ID];
			                tasks = Maintenance_Task[Asset == input.ID];
			                if(schedules.count() > 0 || tasks.count() > 0)
			                {
			                    alert "This asset is referenced by maintenance schedules or tasks. Remove dependent records manually before deletion.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Asset_Master_On_Load as "Asset Master On Load"
			{
			    type = form
			    form = Asset_Master
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Next_Maintenance_Date;
			            )
			        }
			    }
			}

			Asset_Master_On_Validate as "Asset Master On Validate"
			{
			    type = form
			    form = Asset_Master
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                categoryRec = Asset_Category_Master[ID == input.Category];
			                if(categoryRec.count() == 0 || categoryRec.Status != "Active")
			                {
			                    alert "Select an active asset category.";
			                    cancel submit;
			                }
			                if(input.Purchase_Date != null && input.Warranty_Expiry != null && input.Warranty_Expiry < input.Purchase_Date)
			                {
			                    alert "Warranty expiry cannot be before purchase date.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Asset_Master_Status_Change_Log as "Asset Master Status Change Log"
			{
			    type = form
			    form = Asset_Master
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(old.Status != input.Status)
			                {
			                    insert into Audit_Log
			                    [
			                        Module_Name = "Maintenance"
			                        Source_Form = "Asset_Master"
			                        Source_Record_ID = input.ID
			                        Source_Record_Label = input.Asset_Code
			                        Action_Type = "Status Changed"
			                        Old_Status = old.Status
			                        New_Status = input.Status
			                        Performed_By_Email = zoho.loginuser
			                        Performed_On = zoho.currenttime
			                        Details = "Asset status changed."
			                    ]
			                }
			            )
			        }
			    }
			}

			Attendance_Invoice_Delete_Validate as "Attendance Invoice Delete Validation"
			{
			    type = form
			    form = Attendance_Invoice
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Approved")
			                {
			                    alert "Approved attendance invoices cannot be deleted. Use administrative correction with manual dependent cleanup if needed.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Attendance_Invoice_On_Load as "Attendance Invoice On Load"
			{
			    type = form
			    form = Attendance_Invoice
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Vendor;
			                disable Vendor_Email;
			                disable Month;
			                disable Month_Number;
			                disable Year;
			                disable Submitted_By_Email;
			                disable Status;
			            )
			        }
			    }
			}

			Attendance_Invoice_On_Success as "Attendance Invoice On Success"
			{
			    type = form
			    form = Attendance_Invoice
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Submitted_By_Email = zoho.loginuser;
			                input.Status = "Pending F&A Validation";
			                insert into Audit_Log
			                [
			                    Module_Name = "Attendance Invoice"
			                    Source_Form = "Attendance_Invoice"
			                    Source_Record_ID = input.ID
			                    Source_Record_Label = input.Invoice_Number
			                    Action_Type = "Submitted"
			                    New_Status = "Pending F&A Validation"
			                    Performed_By_Email = zoho.loginuser
			                    Performed_On = zoho.currenttime
			                    Details = "Attendance invoice submitted for F&A validation."
			                ]
