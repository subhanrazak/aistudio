		{
					displayname = "FMS Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Home_Landing' elementName='Home_Landing'>\n\t\t\t\t\t<![CDATA[htmlpage Home_Landing()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuser;\ndisplayUser = zoho.loginuser;\nif(displayUser == null || displayUser == &quot;&quot;)\n{\n\t\tdisplayUser = zoho.loginuserid;\n}\nprofileName = thisapp.permissions.loginUserProfile();\nroleDisplay = profileName;\nif(profileName == &quot;Infra_Team&quot;)\n{\n\t\troleDisplay = &quot;Infra Team&quot;;\n}\nelse if(profileName == &quot;FA_Team&quot;)\n{\n\t\troleDisplay = &quot;F&amp;A Team&quot;;\n}\nelse if(profileName == &quot;FMS_Vendor&quot;)\n{\n\t\troleDisplay = &quot;FMS Vendor&quot;;\n}\nelse if(profileName == &quot;Administrator&quot;)\n{\n\t\troleDisplay = &quot;Administrator&quot;;\n}\n\ninfraAttendancePending = 0;\ninfraConsumablePending = 0;\ninfraMaintenanceSubmitted = 0;\ninfraAssetsDue = 0;\ninfraWarningsOpen = 0;\ninfraPendingTotal = 0;\n\nfaAttendanceInvoicePending = 0;\nfaConsumablePending = 0;\nfaDisciplinaryPending = 0;\nfaPendingTotal = 0;\n\nvendorAttendanceAction = 0;\nvendorInvoiceAction = 0;\nvendorMaintenanceAction = 0;\nvendorWarningAction = 0;\nvendorPendingTotal = 0;\n\nif(profileName == &quot;Infra_Team&quot; || profileName == &quot;Administrator&quot;)\n{\n\t\tinfraAttendancePending = Attendance_Submission[Status == &quot;Pending Validation&quot;].count();\n\t\tinfraConsumablePending = Consumable_Invoice[Status == &quot;Pending Infra Validation&quot;].count();\n\t\tinfraMaintenanceSubmitted = Maintenance_Task[Status == &quot;Submitted&quot;].count();\n\t\tinfraAssetsDue = Asset_Master[Status == &quot;Active&quot; &amp;&amp; Next_Maintenance_Date &lt;= zoho.currentdate.addDay(7)].count();\n\t\tinfraWarningsOpen = Warning_Penalty[Status != &quot;Acknowledged&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\t\tinfraPendingTotal = infraAttendancePending + infraConsumablePending + infraMaintenanceSubmitted + infraAssetsDue + infraWarningsOpen;\n}\n\nif(profileName == &quot;FA_Team&quot; || profileName == &quot;Administrator&quot;)\n{\n\t\tfaAttendanceInvoicePending = Attendance_Invoice[Status == &quot;Pending F&amp;A Validation&quot;].count();\n\t\tfaConsumablePending = Consumable_Invoice[Status == &quot;Pending F&amp;A Validation&quot;].count();\n\t\tfaDisciplinaryPending = Warning_Penalty[Issue_Type == &quot;Disciplinary&quot; &amp;&amp; Status == &quot;Pending F&amp;A Action&quot;].count();\n\t\tfaPendingTotal = faAttendanceInvoicePending + faConsumablePending + faDisciplinaryPending;\n}\n\nif(profileName == &quot;FMS_Vendor&quot; || profileName == &quot;Administrator&quot;)\n{\n\t\tvendorAttendanceAction = Attendance_Submission[Vendor_Email == loginEmail &amp;&amp; (Status == &quot;Pending Upload&quot; || Status == &quot;Rejected&quot;)].count();\n\t\tvendorInvoiceAction = Attendance_Invoice[Vendor_Email == loginEmail &amp;&amp; Status == &quot;Rejected&quot;].count() + Consumable_Invoice[Vendor_Email == loginEmail &amp;&amp; Status == &quot;Rejected&quot;].count();\n\t\tvendorMaintenanceAction = Maintenance_Task[Vendor_Email == loginEmail &amp;&amp; (Status == &quot;Pending&quot; || Status == &quot;Rejected&quot;)].count();\n\t\tvendorWarningAction = Warning_Penalty[Vendor_Email == loginEmail &amp;&amp; Status == &quot;Pending FMS Acknowledgement&quot;].count();\n\t\tvendorPendingTotal = vendorAttendanceAction + vendorInvoiceAction + vendorMaintenanceAction + vendorWarningAction;\n}\n\nprimaryDashboard = &quot;Home&quot;;\nprimaryDashboardLabel = &quot;Stay on Home&quot;;\nprimaryPending = 0;\nif(profileName == &quot;Infra_Team&quot;)\n{\n\t\tprimaryDashboard = &quot;Infra_Team_Dashboard&quot;;\n\t\tprimaryDashboardLabel = &quot;Open Infra dashboard&quot;;\n\t\tprimaryPending = infraPendingTotal;\n}\nelse if(profileName == &quot;FA_Team&quot;)\n{\n\t\tprimaryDashboard = &quot;FA_Team_Dashboard&quot;;\n\t\tprimaryDashboardLabel = &quot;Open F&amp;A dashboard&quot;;\n\t\tprimaryPending = faPendingTotal;\n}\nelse if(profileName == &quot;FMS_Vendor&quot;)\n{\n\t\tprimaryDashboard = &quot;FMS_Vendor_Dashboard&quot;;\n\t\tprimaryDashboardLabel = &quot;Open Vendor dashboard&quot;;\n\t\tprimaryPending = vendorPendingTotal;\n}\nprimaryUrl = &quot;#Page:&quot; + primaryDashboard;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css: utility classes used by fetched ZCS components on this page ===== */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-black-color: #000000;\n\t\t--zcs-primary-btn-color: var(--zcs_brand_color);\n\t\t--zcs-primary-btn-text-color: var(--zcs_brand_foreground_color);\n\t\t--iitb-blue: #004B8D;\n\t\t--iitb-blue-dark: #002F6C;\n\t\t--iitb-blue-light: #E8F2FC;\n\t\t--fms-saffron: #F7A600;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n* { box-sizing: border-box; }\na { text-decoration: none; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #E4E8F0; border-radius: 12px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-stretch { align-items: stretch; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-w-full { width: 100%; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-10 { padding: 0.625rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-5 { padding-top: 0.3125rem; padding-bottom: 0.3125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ===== button-primary-button CSS, deduped for primary and outline actions ===== */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease; }\n.zcs-button:hover { transform: translateY(-1px); }\n.zcs-primary-button { background-color: var(--iitb-blue); color: #FFFFFF; border: 1px solid var(--iitb-blue); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--iitb-blue-dark); border-color: var(--iitb-blue-dark); color: #FFFFFF; }\n.zcs-primary-outline-button { border: 1px solid var(--iitb-blue); background-color: #FFFFFF; color: var(--iitb-blue); }\n.zcs-primary-outline-button:hover { background-color: var(--iitb-blue-light); border-color: var(--iitb-blue); color: var(--iitb-blue); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* ===== badge-badge-with-icon CSS ===== */\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8F2FC; border-color: var(--iitb-blue); color: var(--iitb-blue); }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FFF7E1; border-color: #D99000; color: #9B6500; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #F4F6F8; border-color: #A5AAB3; color: #3F4652; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #C81E35; }\n\n/* ===== card-template CSS adapted for dashboard cards ===== */\n.zcs-template-card { width: 100%; min-height: 258px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid #E6EAF2; }\n.zcs-card-content { flex: 1 1 auto; }\n.zcs-template-card .zcs-card-footer { background-color: #F8FAFD; border-top: 1px solid #E6EAF2; position: static; display: flex; }\n.zcs-template-card .zcs-card-footer .zcs-button { min-height: 32px; }\n.zcs-card-action { background-color: #FFFFFF; }\n.zcs-card-action:hover { color: var(--iitb-blue); background-color: var(--iitb-blue-light); }\n\n/* ===== header-heading-with-actions CSS scoped to this landing page ===== */\n.zcs-page-header { border-bottom: 1px solid rgba(255,255,255,0.18); }\n\n/* ===== FMS Home custom layout, built on ZCS components ===== */\n.fms-home { min-height: 100%; padding: 0; background: #F2F5FA; color: #172033; font-family: Lato, Arial, sans-serif; }\n.fms-hero {\n\t\tposition: relative;\n\t\toverflow: hidden;\n\t\tbackground: radial-gradient(circle at 88% 18%, rgba(247,166,0,0.34) 0, rgba(247,166,0,0.18) 17%, transparent 36%), linear-gradient(135deg, var(--iitb-blue-dark) 0%, var(--iitb-blue) 58%, #0A6EB8 100%);\n\t\tcolor: #FFFFFF;\n}\n.fms-hero:before {\n\t\tcontent: &quot;&quot;;\n\t\tposition: absolute;\n\t\tinset: -80px -60px auto auto;\n\t\twidth: 300px;\n\t\theight: 300px;\n\t\tborder: 1px solid rgba(255,255,255,0.16);\n\t\tborder-radius: 50%;\n}\n.fms-hero:after {\n\t\tcontent: &quot;&quot;;\n\t\tposition: absolute;\n\t\tright: 80px;\n\t\tbottom: -110px;\n\t\twidth: 240px;\n\t\theight: 240px;\n\t\tborder: 32px solid rgba(255,255,255,0.08);\n\t\tborder-radius: 50%;\n}\n.fms-hero-content { position: relative; z-index: 1; padding: 30px; }\n.fms-brand-mark { width: 42px; height: 42px; border-radius: 12px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; }\n.fms-brand-mark i { font-size: 22px; }\n.fms-hero-title { margin: 0; font-size: 30px; line-height: 1.18; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF; }\n.fms-hero-subtitle { max-width: 760px; margin: 10px 0 0; color: rgba(255,255,255,0.86); font-size: 15px; line-height: 1.6; }\n.fms-hero .zcs-color-primary, .fms-hero .zcs-color-secondary { color: #FFFFFF; }\n.fms-hero .zcs-primary-outline-button { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.74); color: #FFFFFF; }\n.fms-hero .zcs-primary-outline-button:hover { background: rgba(255,255,255,0.18); color: #FFFFFF; }\n.fms-kpi-strip { margin-top: 24px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }\n.fms-kpi-card { padding: 16px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.12); border-radius: 14px; backdrop-filter: blur(8px); min-height: 104px; }\n.fms-kpi-card .fms-kpi-value { display: block; color: #FFFFFF; font-size: 29px; line-height: 1; font-weight: 700; }\n.fms-kpi-card .fms-kpi-label { display: block; margin-top: 8px; color: rgba(255,255,255,0.84); font-size: 13px; line-height: 1.35; }\n.fms-kpi-card .fms-kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; background: rgba(255,255,255,0.16); color: #FFFFFF; }\n.fms-body { padding: 26px 30px 34px; }\n.fms-section-heading { margin-bottom: 16px; }\n.fms-section-heading h2 { margin: 0; color: #172033; font-size: 22px; font-weight: 700; }\n.fms-section-heading p { margin: 6px 0 0; color: #647084; font-size: 14px; line-height: 1.55; }\n.fms-card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }\n.fms-dashboard-card { border: 1px solid #E1E7F0; box-shadow: 0 12px 30px rgba(20, 38, 72, 0.08); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; }\n.fms-dashboard-card:hover { transform: translateY(-3px); border-color: rgba(0,75,141,0.42); box-shadow: 0 18px 36px rgba(20, 38, 72, 0.13); }\n.fms-card-topline { height: 4px; background: linear-gradient(90deg, var(--iitb-blue), #0A6EB8 70%, var(--fms-saffron)); }\n.fms-card-icon { width: 44px; height: 44px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: var(--iitb-blue-light); color: var(--iitb-blue); margin-bottom: 14px; }\n.fms-card-icon i { font-size: 22px; }\n.fms-card-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }\n.fms-card-count { min-width: 42px; padding: 6px 8px; text-align: center; border-radius: 10px; background: #F1F6FD; color: var(--iitb-blue); font-weight: 700; font-size: 18px; line-height: 1; }\n.fms-card-count span { display: block; margin-top: 3px; color: #6E7A8E; font-weight: 500; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; }\n.fms-card-description { margin: 12px 0 14px; color: #596579; font-size: 14px; line-height: 1.55; }\n.fms-mini-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }\n.fms-mini-metric { padding: 10px; border-radius: 10px; background: #F8FAFD; border: 1px solid #EEF2F7; }\n.fms-mini-metric strong { display: block; color: #162033; font-size: 17px; line-height: 1; }\n.fms-mini-metric span { display: block; margin-top: 5px; color: #6B7588; font-size: 11px; line-height: 1.3; }\n.fms-summary-panel { margin-top: 20px; padding: 18px; border-radius: 14px; border: 1px solid #E1E7F0; background: #FFFFFF; box-shadow: 0 10px 24px rgba(20,38,72,0.06); }\n.fms-summary-panel p { margin: 0; color: #586579; font-size: 14px; line-height: 1.6; }\n.fms-summary-panel strong { color: #172033; }\n@media (max-width: 1180px) {\n\t\t.fms-kpi-strip, .fms-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 700px) {\n\t\t.fms-hero-content, .fms-body { padding: 22px 18px; }\n\t\t.zcs-page-header { padding: 16px 18px; align-items: flex-start; flex-direction: column; }\n\t\t.fms-hero-title { font-size: 24px; }\n\t\t.fms-kpi-strip, .fms-card-grid { grid-template-columns: 1fr; }\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;fms-home&quot;&gt;\n\t\t&lt;section class=&quot;fms-hero&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-brand-mark zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-home-minimal&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;FMS Home&lt;/h5&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;IIT Bombay Facilities Management System&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline users_single-03&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=roleDisplay%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=primaryUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;&lt;%=primaryDashboardLabel%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;fms-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-start zcs-justify-space-between zcs-gap-20&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h1 class=&quot;fms-hero-title&quot;&gt;Hello &lt;%=displayUser%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fms-hero-subtitle&quot;&gt;Use this page-first entry point to reach the Facilities Management queues assigned to your profile. Dashboard access is enforced by profile page permissions, so each user opens only the role dashboard enabled for them.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=primaryPending%&gt; pending in your queue&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;fms-kpi-strip&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-value&quot;&gt;&lt;%=primaryPending%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-label&quot;&gt;Pending items for your active profile&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files_single-content-03&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-value&quot;&gt;&lt;%=vendorPendingTotal%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-label&quot;&gt;Vendor action items visible to this login&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business_chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-value&quot;&gt;&lt;%=infraPendingTotal%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-label&quot;&gt;Infra validation and maintenance queue&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business_money-coins&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-value&quot;&gt;&lt;%=faPendingTotal%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-kpi-label&quot;&gt;F&amp;A invoice and disciplinary queue&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;main class=&quot;fms-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fms-section-heading&quot;&gt;\n\t\t\t\t\t\t&lt;h2&gt;Navigate to your workspace&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p&gt;Cards remain visible as a landing map. The app profiles decide which destination page can be opened by each user.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;fms-card-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-topline&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-header zcs-p-16 zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-home-minimal&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Home&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-count&quot;&gt;0&lt;span&gt;Data&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fms-card-description&quot;&gt;Role-aware landing page with profile-safe routing, IITB-blue styling, and a quick view of pending work.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Current entry point&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:Home&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Home&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-topline&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-header zcs-p-16 zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business_chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Infra Team Dashboard&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-count&quot;&gt;&lt;%=infraPendingTotal%&gt;&lt;span&gt;Queue&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fms-card-description&quot;&gt;Attendance validation, consumable infra checks, submitted maintenance reports, asset due dates, and warning cases.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metrics&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=infraAttendancePending%&gt;&lt;/strong&gt;&lt;span&gt;Attendance&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=infraMaintenanceSubmitted%&gt;&lt;/strong&gt;&lt;span&gt;Maintenance&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:Infra_Team_Dashboard&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open dashboard&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-topline&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-header zcs-p-16 zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business_money-coins&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;F&amp;A Team Dashboard&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-count&quot;&gt;&lt;%=faPendingTotal%&gt;&lt;span&gt;Queue&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fms-card-description&quot;&gt;Attendance invoices, consumable F&amp;A approvals, disciplinary actions, vendor references, and finance audit activity.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metrics&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=faAttendanceInvoicePending%&gt;&lt;/strong&gt;&lt;span&gt;Attendance invoices&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=faConsumablePending%&gt;&lt;/strong&gt;&lt;span&gt;Consumables&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:FA_Team_Dashboard&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open dashboard&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&apos;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative fms-dashboard-card&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-topline&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-header zcs-p-16 zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fms-card-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users_single-03&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;FMS Vendor Dashboard&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-card-count&quot;&gt;&lt;%=vendorPendingTotal%&gt;&lt;span&gt;Mine&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fms-card-description&quot;&gt;Attendance uploads, own invoices, maintenance reports, warning acknowledgements, employee roster, and asset reference.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metrics&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=vendorAttendanceAction%&gt;&lt;/strong&gt;&lt;span&gt;Attendance&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fms-mini-metric&quot;&gt;&lt;strong&gt;&lt;%=vendorWarningAction%&gt;&lt;/strong&gt;&lt;span&gt;Acknowledgements&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-card-footer zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-text-center zcs-gap-10 zcs-p-10 zcs-box-border zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-5 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:FMS_Vendor_Dashboard&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open dashboard&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;fms-summary-panel&quot;&gt;\n\t\t\t\t\t\t&lt;p&gt;&lt;strong&gt;App summary:&lt;/strong&gt; IITB FMS centralizes vendor attendance uploads, invoices, consumable validation, employee warnings, scheduled maintenance, and audit logging. Use the dashboard matching your profile for operational lists and workflow actions; this Home page does not expose data-entry controls.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/main&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Infra_Team_Dashboard
		{
					displayname = "Infra Team Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Infra_Dashboard_Overview' elementName='Infra_Dashboard_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Infra_Dashboard_Overview()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuserid;\ndisplayUser = zoho.loginuser;\nif(displayUser == null || displayUser == &quot;&quot;)\n{\n\t\tdisplayUser = loginEmail;\n}\ncurrentMonthNumber = zoho.currentdate.getMonth();\ncurrentYear = zoho.currentdate.getYear();\n\npendingAttendance = Attendance_Submission[Status == &quot;Pending Validation&quot;].count();\npendingConsumables = Consumable_Invoice[Status == &quot;Pending Infra Validation&quot;].count();\nsubmittedMaintenance = Maintenance_Task[Status == &quot;Submitted&quot;].count();\nassetsDueSoon = Asset_Master[Status == &quot;Active&quot; &amp;&amp; Next_Maintenance_Date &gt;= zoho.currentdate &amp;&amp; Next_Maintenance_Date &lt;= zoho.currentdate.addDay(7)].count();\nopenWarnings = Warning_Penalty[Status != &quot;Acknowledged&quot; &amp;&amp; Status != &quot;Cancelled&quot;].count();\n\nactiveVendors = User_Master[Role == &quot;Vendor&quot; &amp;&amp; Status == &quot;Active&quot;].count();\nuploadPending = Attendance_Submission[Month_Number == currentMonthNumber &amp;&amp; Year == currentYear &amp;&amp; Status == &quot;Pending Upload&quot;].count();\nuploadSubmitted = Attendance_Submission[Month_Number == currentMonthNumber &amp;&amp; Year == currentYear &amp;&amp; Status != &quot;Pending Upload&quot;].count();\nuploadTotal = uploadPending + uploadSubmitted;\nuploadPct = 0;\nif(uploadTotal &gt; 0)\n{\n\t\tuploadPct = (uploadSubmitted * 100) / uploadTotal;\n}\n\nmaintenanceApproved = Maintenance_Task[Status == &quot;Approved&quot;].count();\nmaintenanceSubmitted = Maintenance_Task[Status == &quot;Submitted&quot;].count();\nmaintenancePending = Maintenance_Task[Status == &quot;Pending&quot;].count();\nmaintenanceRejected = Maintenance_Task[Status == &quot;Rejected&quot;].count();\nmaintenanceOverdue = Maintenance_Task[Task_Due_Date &lt; zoho.currentdate &amp;&amp; Status != &quot;Approved&quot;].count();\nmaintenanceTotal = maintenanceApproved + maintenanceSubmitted + maintenancePending + maintenanceRejected;\nmaintenanceApprovedPct = 0;\nmaintenanceSubmittedPct = 0;\nmaintenanceOverduePct = 0;\nif(maintenanceTotal &gt; 0)\n{\n\t\tmaintenanceApprovedPct = (maintenanceApproved * 100) / maintenanceTotal;\n\t\tmaintenanceSubmittedPct = (maintenanceSubmitted * 100) / maintenanceTotal;\n\t\tmaintenanceOverduePct = (maintenanceOverdue * 100) / maintenanceTotal;\n}\n\ntotalAssets = Asset_Master[Status == &quot;Active&quot;].count();\nassetCategories = Asset_Category_Master[Status == &quot;Active&quot;] sort by Category_Name asc;\n\nwarningsRaised = Warning_Penalty[Status == &quot;Raised&quot;].count();\nwarningsFA = Warning_Penalty[Status == &quot;Pending F&amp;A Action&quot;].count();\nwarningsFMS = Warning_Penalty[Status == &quot;Pending FMS Acknowledgement&quot;].count();\nwarningsClosed = Warning_Penalty[Status == &quot;Acknowledged&quot;].count() + Warning_Penalty[Status == &quot;Cancelled&quot;].count();\nwarningsTotal = warningsRaised + warningsFA + warningsFMS + warningsClosed;\nwRaisedPct = 0;\nwFAPct = 0;\nwFMSPct = 0;\nwClosedPct = 0;\nif(warningsTotal &gt; 0)\n{\n\t\twRaisedPct = (warningsRaised * 100) / warningsTotal;\n\t\twFAPct = (warningsFA * 100) / warningsTotal;\n\t\twFMSPct = (warningsFMS * 100) / warningsTotal;\n\t\twClosedPct = (warningsClosed * 100) / warningsTotal;\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility stylesheet included once for this page: compact utility subset used by fetched ZCS components. */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-black-color: #000000;\n\t\t--iitb-blue: #004B8D;\n\t\t--iitb-blue-dark: #002F6C;\n\t\t--iitb-blue-light: #E8F2FC;\n\t\t--fms-saffron: #F7A600;\n\t\t--infra-green: #179E6C;\n\t\t--infra-red: #D93045;\n\t\t--infra-yellow: #B8770D;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zc-pb-page-content-wrapper div#zppagesLive,\n.zc-pb-page-content-wrapper div#elementsContainer,\n.zc-pb-page-content-wrapper .elemContainment,\n.zc-pb-page-content-wrapper .zcpage-elemContainer { height: 100%; }\n.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { box-shadow: none !important; }\n* { box-sizing: border-box; }\na { text-decoration: none; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #E4E8F0; border-radius: 12px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-40 { font-size: 2.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-rounded-full { border-radius: 100%; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n/* ZCS component CSS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-quick-action-item.zcs-card:hover .zcs-quick-action-text { text-decoration: none; }\n/* ZCS component CSS: card-fleets-performance-metrics */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F6); overflow: hidden; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n/* ZCS component CSS: chart-donut-chart-with-text */\n.zcs-legend-wrapper li { list-style-type: none; }\n.zcs-legend-wrapper li label { min-width: 160px; }\n.zcs-legend-wrapper li label:before { content: &apos;&apos;; display: inline-block; vertical-align: top; width: 12px; height: 12px; margin: 4px 12px 4px 0; border-radius: 50%; }\n.zcs-legend-wrapper li:nth-child(1) label:before { background-color: #FECE56; }\n.zcs-legend-wrapper li:nth-child(2) label:before { background-color: #36A2EB; }\n.zcs-legend-wrapper li:nth-child(3) label:before { background-color: #FF6283; }\n.zcs-legend-wrapper li:nth-child(4) label:before { background-color: #28CC97; }\n:root { --donut-cx: 82px; --donut-cy: 82px; --donut-r: 64; --donut-stroke_width: 18; --donut-pi: 3.14; --donut-a1: 0; --donut-a2: 0; --donut-a3: 0; --donut-a4: 0; --donut-space_value: 0; --donut-donut_size: calc(var(--donut-cx) + var(--donut-cy)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg { width: var(--donut-donut_size); height: var(--donut-donut_size); overflow: hidden; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle { cx: var(--donut-cx); cy: var(--donut-cy); r: var(--donut-r); stroke-width: var(--donut-stroke_width); fill: transparent; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1) { stroke: #FECE56; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a1) / 100)); stroke-dashoffset: calc((2 * var(--donut-pi) * var(--donut-r)) / 4); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2) { stroke: #36A2EB; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a2) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3) { stroke: #FF6283; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a3) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4) { stroke: #28CC97; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a4) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100)); }\n/* Infra dashboard custom layout using ZCS tokens/components */\n.infra-dashboard { min-height: 100%; background: #F2F5FA; color: #172033; font-family: Lato, Arial, sans-serif; }\n.infra-hero { position: relative; overflow: hidden; border-radius: 0; color: #FFFFFF; background: radial-gradient(circle at 86% 20%, rgba(247,166,0,0.34) 0, rgba(247,166,0,0.18) 18%, transparent 38%), linear-gradient(135deg, var(--iitb-blue-dark) 0%, var(--iitb-blue) 58%, #0A6EB8 100%); }\n.infra-hero:before { content: &apos;&apos;; position: absolute; right: -88px; top: -116px; width: 330px; height: 330px; border: 1px solid rgba(255,255,255,0.16); border-radius: 50%; }\n.infra-hero:after { content: &apos;&apos;; position: absolute; right: 95px; bottom: -125px; width: 260px; height: 260px; border: 34px solid rgba(255,255,255,0.08); border-radius: 50%; }\n.infra-hero-content { position: relative; z-index: 1; padding: 28px 30px 30px; }\n.infra-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }\n.infra-brand-mark { width: 44px; height: 44px; border-radius: 13px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; }\n.infra-brand-mark i { font-size: 23px; }\n.infra-title { margin: 0; font-size: 30px; line-height: 1.18; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF; }\n.infra-subtitle { max-width: 850px; margin: 10px 0 0; color: rgba(255,255,255,0.86); font-size: 15px; line-height: 1.6; }\n.infra-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }\n.infra-chip-link { min-height: 36px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px; border-radius: 9px; color: #FFFFFF; border: 1px solid rgba(255,255,255,0.50); background: rgba(255,255,255,0.12); font-size: 13px; font-weight: 600; }\n.infra-chip-link:hover { background: rgba(255,255,255,0.20); color: #FFFFFF; }\n.infra-kpi-grid { margin-top: 24px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }\n.infra-kpi-card { min-height: 126px; padding: 16px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.12); border-radius: 14px; backdrop-filter: blur(8px); }\n.infra-kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; background: rgba(255,255,255,0.16); color: #FFFFFF; }\n.infra-kpi-icon i { font-size: 18px; }\n.infra-kpi-value { display: block; color: #FFFFFF; font-size: 30px; line-height: 1; font-weight: 700; }\n.infra-kpi-label { display: block; margin-top: 8px; color: rgba(255,255,255,0.84); font-size: 13px; line-height: 1.35; }\n.infra-kpi-card.urgent { border-color: rgba(247,166,0,0.55); }\n.infra-body { padding: 26px 30px 32px; }\n.infra-section-heading { margin: 0 0 16px; }\n.infra-section-heading h2 { margin: 0; color: #172033; font-size: 22px; font-weight: 700; }\n.infra-section-heading p { margin: 6px 0 0; color: #647084; font-size: 14px; line-height: 1.55; }\n.infra-insights-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: stretch; }\n.infra-card { border: 1px solid #E1E7F0; box-shadow: 0 12px 30px rgba(20,38,72,0.08); }\n.infra-card-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid #E8EDF5; }\n.infra-card-title h3 { margin: 0; font-size: 18px; color: #172033; }\n.infra-card-title span { color: #647084; font-size: 12px; }\n.infra-numberline { display: flex; align-items: baseline; justify-content: space-between; margin: 16px 0 10px; gap: 12px; }\n.infra-numberline strong { font-size: 28px; color: #172033; line-height: 1; }\n.infra-numberline small { color: #647084; font-size: 13px; }\n.infra-muted { color: #647084; font-size: 13px; line-height: 1.5; }\n.infra-bar-list { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }\n.infra-bar-row { display: grid; grid-template-columns: minmax(120px, 1fr) minmax(160px, 2fr) 42px; gap: 10px; align-items: center; }\n.infra-bar-label { color: #41506B; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.infra-bar-track { height: 8px; background: #EEF2F6; border-radius: 8px; overflow: hidden; }\n.infra-bar-fill { height: 100%; background: linear-gradient(90deg, var(--iitb-blue), #0A6EB8); border-radius: 8px; }\n.infra-bar-count { text-align: right; font-size: 13px; font-weight: 700; color: #172033; }\n.infra-status-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }\n.infra-badge { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 5px 10px; font-size: 12px; font-weight: 700; border: 1px solid #DDE5F0; color: #41506B; background: #FFFFFF; }\n.infra-badge.green { border-color: #BFEAD9; color: var(--infra-green); background: #EAFBF4; }\n.infra-badge.yellow { border-color: #F3DCA5; color: var(--infra-yellow); background: #FFF8E5; }\n.infra-badge.red { border-color: #F4BDC5; color: var(--infra-red); background: #FDECEF; }\n.infra-badge.blue { border-color: #C8DEF3; color: var(--iitb-blue); background: var(--iitb-blue-light); }\n.infra-action-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }\n.infra-action-group .zcs-quick-actions-wrapper { height: 100%; }\n.infra-action-group .zcs-quick-action-link { color: #172033; }\n.infra-action-group .zcs-quick-action-icon { color: var(--iitb-blue); width: 18px; text-align: center; }\n.infra-empty { padding: 12px; border: 1px dashed #CBD5E1; border-radius: 10px; color: #647084; background: #F8FAFD; }\n.infra-report-note { margin-top: 20px; padding: 13px 14px; border-radius: 12px; border: 1px solid #DCE8F8; color: #41506B; background: #F8FBFF; font-size: 13px; line-height: 1.55; }\n@media (max-width: 1280px) { .infra-kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .infra-action-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 860px) { .infra-kpi-grid, .infra-insights-grid, .infra-action-grid { grid-template-columns: 1fr; } .infra-hero-actions { justify-content: flex-start; } .infra-bar-row { grid-template-columns: 1fr; gap: 6px; } .infra-bar-count { text-align: left; } }\n&lt;/style&gt;\n&lt;div class=&quot;infra-dashboard&quot;&gt;\n\t\t&lt;section class=&quot;infra-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;infra-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-16 zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-brand-mark&quot;&gt;&lt;i class=&quot;zc-li-outline buildings-2_factory&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h1 class=&quot;infra-title&quot;&gt;Infra Team Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;infra-subtitle&quot;&gt;Hello &lt;%=displayUser%&gt;. Validate vendor attendance, consumable invoices, maintenance reports, assets due soon, warnings, and setup records from one control surface.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-hero-actions&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-chip-link&quot; href=&quot;#Report:Attendance_Submission_List_Infra&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;Validate attendance&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-chip-link&quot; href=&quot;#Report:Consumable_Invoice_List_Infra&quot;&gt;&lt;i class=&quot;zc-li-outline shopping_cart-modern&quot;&gt;&lt;/i&gt;Validate consumables&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-chip-link&quot; href=&quot;#Form:Warning_Penalty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;New warning&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-chip-link&quot; href=&quot;#Report:Audit_Log_List&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-single-content-03&quot;&gt;&lt;/i&gt;Audit log&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-kpi-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-kpi-card urgent&quot; href=&quot;#Report:Attendance_Submission_List_Infra&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-wm&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-value&quot;&gt;&lt;%=pendingAttendance%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-label&quot;&gt;Pending attendance validations&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-kpi-card urgent&quot; href=&quot;#Report:Consumable_Invoice_List_Infra&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline shopping_bag-16&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-value&quot;&gt;&lt;%=pendingConsumables%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-label&quot;&gt;Pending consumable Infra validations&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-kpi-card&quot; href=&quot;#Report:Maintenance_Task_List_Infra&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline design-2_ruler-pencil&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-value&quot;&gt;&lt;%=submittedMaintenance%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-label&quot;&gt;Submitted maintenance reports&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-kpi-card&quot; href=&quot;#Report:Asset_Master_List_Infra&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-value&quot;&gt;&lt;%=assetsDueSoon%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-label&quot;&gt;Assets due within 7 days&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;infra-kpi-card urgent&quot; href=&quot;#Report:Warning_List_Infra&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-value&quot;&gt;&lt;%=openWarnings%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-kpi-label&quot;&gt;Open warnings and disciplinary cases&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t\t&lt;section class=&quot;infra-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;infra-section-heading&quot;&gt;\n\t\t\t\t\t\t&lt;h2&gt;Operational health snippets&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p&gt;Live summaries built from Infra-permitted forms, followed by full-width working lists below.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;infra-insights-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-card-title&quot;&gt;&lt;h3&gt;Vendor attendance upload status&lt;/h3&gt;&lt;span&gt;This month&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-numberline&quot;&gt;&lt;strong&gt;&lt;%=uploadPct%&gt;%&lt;/strong&gt;&lt;small&gt;&lt;%=uploadSubmitted%&gt; submitted of &lt;%=uploadTotal%&gt; submission records&lt;/small&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=uploadPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-status-badges&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-badge blue&quot;&gt;&lt;i class=&quot;zc-li-outline users-wm&quot;&gt;&lt;/i&gt;&lt;%=activeVendors%&gt; active vendors&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-badge green&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;%=uploadSubmitted%&gt; uploaded&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;infra-badge yellow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;%=uploadPending%&gt; pending upload&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;infra-muted zcs-m-0&quot;&gt;Use the attendance validation list to approve or reject submissions waiting for Infra validation.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-card-title&quot;&gt;&lt;h3&gt;Maintenance schedule adherence&lt;/h3&gt;&lt;span&gt;All tasks&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Approved tasks&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=maintenanceApproved%&gt; (&lt;%=maintenanceApprovedPct%&gt;%)&lt;/span&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=maintenanceApprovedPct%&gt;%; background:#179E6C;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Submitted for Infra review&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=maintenanceSubmitted%&gt; (&lt;%=maintenanceSubmittedPct%&gt;%)&lt;/span&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=maintenanceSubmittedPct%&gt;%; background:#36A2EB;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;Overdue and not approved&lt;/span&gt;&lt;span class=&quot;zcs-color-tertiary&quot;&gt;&lt;%=maintenanceOverdue%&gt; (&lt;%=maintenanceOverduePct%&gt;%)&lt;/span&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=maintenanceOverduePct%&gt;%; background:#D93045;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-status-badges&quot;&gt;&lt;span class=&quot;infra-badge yellow&quot;&gt;&lt;%=maintenancePending%&gt; pending&lt;/span&gt;&lt;span class=&quot;infra-badge red&quot;&gt;&lt;%=maintenanceRejected%&gt; rejected&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-card-title&quot;&gt;&lt;h3&gt;Asset category distribution&lt;/h3&gt;&lt;span&gt;&lt;%=totalAssets%&gt; active assets&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-bar-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tif(assetCategories.count() == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-empty&quot;&gt;No active asset categories are configured.&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tfor each cat in assetCategories\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcatCount = Asset_Master[Status == &quot;Active&quot; &amp;&amp; Category == cat.ID].count();\n\t\t\t\t\t\t\t\t\t\tcatPct = 0;\n\t\t\t\t\t\t\t\t\t\tif(totalAssets &gt; 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tcatPct = (catCount * 100) / totalAssets;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-bar-label&quot;&gt;&lt;%=cat.Category_Name%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-bar-track&quot;&gt;&lt;div class=&quot;infra-bar-fill&quot; style=&quot;width:&lt;%=catPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-bar-count&quot;&gt;&lt;%=catCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;infra-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;infra-card-title&quot;&gt;&lt;h3&gt;Warning status breakdown&lt;/h3&gt;&lt;span&gt;&lt;%=warningsTotal%&gt; cases&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-p-20 zcs-box-border&quot; style=&quot;--donut-a1:&lt;%=wRaisedPct%&gt;; --donut-a2:&lt;%=wFAPct%&gt;; --donut-a3:&lt;%=wFMSPct%&gt;; --donut-a4:&lt;%=wClosedPct%&gt;;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;svg class=&quot;zcs-rounded-full&quot;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-donut-chart-name zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&quot;&gt;&lt;%=openWarnings%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-font-normal&quot;&gt;Open&lt;/span&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Raised: &lt;%=warningsRaised%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-cente