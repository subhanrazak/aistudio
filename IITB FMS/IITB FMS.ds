		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( User_ID User_Name Vendor_Code GSTIN Contact_Person Contact_Phone Status ) ) )
		        menu ( header ( Edit Duplicate Delete ) )
		    )
		}
	
		report Warning_List_FA
		{
		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Warning_ID Date Vendor Employee Warning_Penalty_Type Status "Enter Action Taken" ) ) )
		        menu ( header ( Edit Duplicate Delete "Enter Action Taken" ) record ( Edit Duplicate Delete "Enter Action Taken" ) )
		        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Warning_ID Date Vendor Employee Warning_Penalty_Type Reason_Description Action_Taken_By_FA Status "Enter Action Taken" ) ) )
		        menu ( header ( Edit Duplicate Delete "Enter Action Taken" ) )
		    )
		}
	
		report Warning_List_FMS
		{
		    quickview
		    (
		        layout ( type = -1 datablock1 ( layout type = -1 fields ( Warning_ID Date Issue_Type Warning_Penalty_Type Status "Acknowledge" ) ) )
		        menu ( header ( Edit Duplicate Delete "Acknowledge" ) record ( Edit Duplicate Delete "Acknowledge" ) )
		        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
		    )
		    detailview
		    (
		        layout ( type = 1 datablock1 ( layout type = -2 fields ( Warning_ID Date Issue_Type Warning_Penalty_Type Reason_Description Action_Taken_By_FA FMS_Acknowledgement_Comment Status "Acknowledge" ) ) )
		        menu ( header ( Edit Duplicate Delete "Acknowledge" ) )
		    )
		}
	}
