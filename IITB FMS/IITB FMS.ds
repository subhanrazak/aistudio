s-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step 2&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Infra validation&lt;/h6&gt;&lt;span class=&quot;fms-status-pill zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=currentSubmissionStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;fms-tl-description zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;Track approval or rejection for the submitted attendance file before invoice submission.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative fms-tl-&lt;%=invoiceState%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step 3&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Attendance invoice submission&lt;/h6&gt;&lt;span class=&quot;fms-status-pill zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=currentInvoiceStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;fms-tl-description zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;Invoice number: &lt;%=ifnull(currentInvoiceNumber,&quot;Not submitted&quot;)%&gt;. Submit after the attendance file is approved.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative fms-tl-&lt;%=faState%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-col-2 zcs-col-sm-12 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step 4&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-col-sm-12 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;F&amp;amp;A validation&lt;/h6&gt;&lt;span class=&quot;fms-status-pill zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=currentInvoiceStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;fms-tl-description zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;Review rejected invoices from the attendance invoice list and resubmit with corrections.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/article&gt;\n\n\t\t&lt;aside class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick links&lt;/h5&gt;\n\t\t\t&lt;ul class=&quot;fms-action-list