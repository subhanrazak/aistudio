			Attendance_Invoice_On_Validate as "Attendance Invoice On Validate"
			{
			    type = form
			    form = Attendance_Invoice
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                submissionRec = Attendance_Submission[ID == input.Attendance_Submission];
			                if(submissionRec.count() == 0 || submissionRec.Status != "Approved")
			                {
			                    alert "Attendance invoices can be submitted only for approved attendance submissions.";
			                    cancel submit;
			                }
			                if(submissionRec.count() > 0)
			                {
			                    input.Vendor = submissionRec.Vendor;
			                    input.Vendor_Email = submissionRec.Vendor_Email;
			                    input.Month = submissionRec.Month;
			                    input.Month_Number = submissionRec.Month_Number;
			                    input.Year = submissionRec.Year;
			                }
			                if(ifnull(input.Sub_Total,0) <= 0 || ifnull(input.Tax,0) < 0)
			                {
			                    alert "Sub Total must be greater than zero and Tax cannot be negative.";
			                    cancel submit;
			                }
			                duplicates = Attendance_Invoice[Vendor == input.Vendor && Invoice_Number == input.Invoice_Number && ID != input.ID];
			                if(duplicates.count() > 0)
			                {
			                    alert "This invoice number already exists for the selected vendor.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

