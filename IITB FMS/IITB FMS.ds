			                {
			                    if(input.Frequency == "Weekly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(7);
			                    }
			                    else if(input.Frequency == "Monthly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(1);
			                    }
			                    else if(input.Frequency == "Quarterly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(3);
			                    }
			                    else if(input.Frequency == "Other" && ifnull(input.Interval,0) > 0)
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
			                    }
			                }
			            )
			        }
			    }
			}

