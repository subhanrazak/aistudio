application "IITB-FMS"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Action_Capture
		{
		    displayname = "Action Capture"
		    store data in zc = false
		
		    Action_Details
		    (
		        type = section
		        displayname = "Action Details"
		        row = 1
		        column = 0
		    )
		    Action_Context
		    (
		        type = plaintext
		        displayname = "Action Context"
		        value = "Capture rejection reasons, F&A action details, or vendor acknowledgement comments from report buttons."
		        row = 1
		        column = 1
		        width = medium
		    )
		    Target_Form
		    (
		        type = text
		        displayname = "Target Form"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Target_Record_ID
		    (
		        type = number
		        displayname = "Target Record ID"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action_Code
		    (
		        type = picklist
		        displayname = "Action Code"
		        values = {"ATTENDANCE_REJECT", "ATTENDANCE_INVOICE_REJECT", "CONSUMABLE_INFRA_REJECT", "CONSUMABLE_FA_REJECT", "WARNING_FA_ACTION", "WARNING_ACKNOWLEDGE", "MAINTENANCE_REJECT"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reason
		    (
		        type = textarea
		        displayname = "Reason"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Action_Taken
		    (
		        type = textarea
		        displayname = "Action Taken"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Action_Taken_Date
		    (
		        type = date
		        displayname = "Action Taken Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Acknowledgement_Comment
		    (
		        type = textarea
		        displayname = "Acknowledgement Comment"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        Submit_Action
		        (
		            type = button
		            displayname = "Submit"
		        )
		        Reset
		        (
		            type = reset
		            displayname = "Reset"
		        )
		    }
		}

		form Asset_Category_Master
		{
		    displayname = "Asset Category Master"
		
		    Category_Details
		    (
		        type = section
		        displayname = "Category Details"
		        row = 1
		        column = 0
		    )
		    must have unique Category_Name
		    (
		        type = text
		        displayname = "Category Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Asset_Master
		{
		    displayname = "Asset Master"
		
		    Asset_Details
		    (
		        type = section
		        displayname = "Asset Details"
		        row = 1
		        column = 0
		    )
		    Asset_ID
		    (
		        type = autonumber
		        displayname = "Asset ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have unique Asset_Code
		    (
		        type = text
		        displayname = "Asset Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Asset_Name
		    (
		        type = text
		        displayname = "Asset Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Asset_Category_Master[Status == "Active"].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Location
		    (
		        type = text
		        displayname = "Location"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Brand_Model
		    (
		        type = text
		        displayname = "Brand / Model"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Dates_Status
		    (
		        type = section
		        displayname = "Dates and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Purchase_Date
		    (
		        type = date
		        displayname = "Purchase Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Warranty_Expiry
		    (
		        type = date
		        displayname = "Warranty Expiry"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Next_Maintenance_Date
		    (
		        type = date
		        displayname = "Next Maintenance Date"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Attendance_Invoice
		{
		    displayname = "Attendance Invoice"
		
		    Invoice_Details
		    (
		        type = section
		        displayname = "Invoice Details"
		        row = 1
		        column = 0
		    )
		    Invoice_ID
		    (
		        type = autonumber
		        displayname = "Invoice ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Attendance_Submission
		    (
		        type = picklist
		        displayname = "Attendance Submission"
		        values = Attendance_Submission[Status == "Approved"].ID
		        displayformat = [Submission_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = User_Master[Role == "Vendor"].ID
		        displayformat = [User_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Vendor_Email
		    (
		        type = email
		        displayname = "Vendor Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Month
		    (
		        type = picklist
		        displayname = "Month"
		        values = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Month_Number
		    (
		        type = number
		        displayname = "Month Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Year
		    (
		        type = number
		        displayname = "Year"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Invoice_Number
		    (
		        type = text
		        displayname = "Invoice Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Amounts_Status
		    (
		        type = section
		        displayname = "Amounts and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Sub_Total
		    (
		        type = INR
		        displayname = "Sub Total"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 12
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Tax
		    (
		        type = INR
		        displayname = "Tax"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 12
		        row = 2
		        column = 2
		        width = medium
		    )
		    Total_Amount
		    (
		        type = formula
		        displayname = "Total Amount"
		        value = Sub_Total + Tax
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Invoice_File
		    (
		        type = upload file
		        displayname = "Invoice File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Pending F&A Validation", "Approved", "Rejected"}
		        initial value = "Pending F&A Validation"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Submitted_By_Email
		    (
		        type = email
		        displayname = "Submitted By Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Attendance_Record
		{
		    displayname = "Attendance Record"
		
		    Attendance_Details
		    (
		        type = section
		        displayname = "Attendance Details"
		        row = 1
		        column = 0
		    )
		    Record_ID
		    (
		        type = autonumber
		        displayname = "Record ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Employee
		    (
		        type = picklist
		        displayname = "Employee"
		        values = FMS_Employee_Master[Status == "Active"].ID
		        displayformat = [Employee_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Biometric_Code
		    (
		        type = text
		        displayname = "Biometric Code"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = User_Master[Role == "Vendor"].ID
		        displayformat = [User_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vendor_Email
		    (
		        type = email
		        displayname = "Vendor Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Date
		    (
		        type = date
		        displayname = "Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have In_Time
		    (
		        type = text
		        displayname = "In Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Out_Time
		    (
		        type = text
		        displayname = "Out Time"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Month
		    (
		        type = number
		        displayname = "Month"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Year
		    (
		        type = number
		        displayname = "Year"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Attendance_Submission
		{
		    displayname = "Attendance Submission"
		
		    Submission_Details
		    (
		        type = section
		        displayname = "Submission Details"
		        row = 1
		        column = 0
		    )
		    Submission_ID
		    (
		        type = autonumber
		        displayname = "Submission ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Month
		    (
		        type = picklist
		        displayname = "Month"
		        values = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Month_Number
		    (
		        type = number
		        displayname = "Month Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Year
		    (
		        type = number
		        displayname = "Year"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = User_Master[Role == "Vendor" && Status == "Active"].ID
		        displayformat = [User_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Vendor_Email
		    (
		        type = email
		        displayname = "Vendor Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Date_of_Submission
		    (
		        type = date
		        displayname = "Date of Submission"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Files_Status
		    (
		        type = section
		        displayname = "Files and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    FMS_Attendance_File
		    (
		        type = upload file
		        displayname = "FMS Attendance File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 1
		        width = medium
		    )
		    Infra_Verified_Excel
		    (
		        type = upload file
		        displayname = "Infra Verified Excel"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Pending Upload", "Pending Validation", "Approved", "Rejected"}
		        initial value = "Pending Upload"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Submitted_By_Email
		    (
		        type = email
		        displayname = "Submitted By Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Log
		{
		    displayname = "Audit Log"
		
		    Log_Details
		    (
		        type = section
		        displayname = "Log Details"
		        row = 1
		        column = 0
		    )
		    Log_ID
		    (
		        type = autonumber
		        displayname = "Log ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Module_Name
		    (
		        type = picklist
		        displayname = "Module Name"
		        values = {"Attendance", "Attendance Invoice", "Consumables", "Disciplinary", "Maintenance", "Integration", "Settings"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_Form
		    (
		        type = text
		        displayname = "Source Form"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Source_Record_ID
		    (
		        type = number
		        displayname = "Source Record ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_Record_Label
		    (
		        type = text
		        displayname = "Source Record Label"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action_Type
		    (
		        type = picklist
		        displayname = "Action Type"
		        values = {"Created", "Uploaded", "Submitted", "Approved", "Rejected", "Cancelled", "Acknowledged", "Status Changed", "API Pull", "Books Push", "Error", "Deleted Blocked"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Old_Status
		    (
		        type = text
		        displayname = "Old Status"
		        row = 1
		        column = 2
		        width = medium
		    )
		    New_Status
		    (
		        type = text
		        displayname = "New Status"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Actor_Details
		    (
		        type = section
		        displayname = "Actor Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Performed_By_Email
		    (
		        type = email
		        displayname = "Performed By Email"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Performed_On
		    (
		        type = datetime
		        displayname = "Performed On"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Details
		    (
		        type = textarea
		        displayname = "Details"
		        height = 150px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Consumable_Category_Master
		{
		    displayname = "Consumable Category Master"
		
		    Category_Details
		    (
		        type = section
		        displayname = "Category Details"
		        row = 1
		        column = 0
		    )
		    must have unique Category_Name
		    (
		        type = text
		        displayname = "Category Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Consumable_Invoice
		{
		    displayname = "Consumable Invoice"
		
		    Invoice_Details
		    (
		        type = section
		        displayname = "Invoice Details"
		        row = 1
		        column = 0
		    )
		    Invoice_ID
		    (
		        type = autonumber
		        displayname = "Invoice ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Invoice_Number
		    (
		        type = text
		        displayname = "Invoice Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = User_Master[Role == "Vendor" && Status == "Active"].ID
		        displayformat = [User_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vendor_Email
		    (
		        type = email
		        displayname = "Vendor Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Consumable_Category
		    (
		        type = picklist
		        displayname = "Consumable Category"
		        values = Consumable_Category_Master[Status == "Active"].ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Amounts_Status
		    (
		        type = section
		        displayname = "Amounts and Status"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Sub_Total
		    (
		        type = INR
		        displayname = "Sub Total"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 12
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Tax
		    (
		        type = INR
		        displayname = "Tax"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 12
		        row = 2
		        column = 2
		        width = medium
		    )
		    Total_Amount
		    (
		        type = formula
		        displayname = "Total Amount"
		        value = Sub_Total + Tax
		        visibility = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Invoice_File
		    (
		        type = upload file
		        displayname = "Invoice File"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 2
		        width = medium
		    )
		    Supporting_Documents
		    (
		        type = upload file
		        displayname = "Supporting Documents"
		        file count = 10
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Pending Infra Validation", "Pending F&A Validation", "Approved", "Rejected"}
		        initial value = "Pending Infra Validation"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Submitted_By_Email
		    (
		        type = email
		        displayname = "Submitted By Email"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Submitted_Date
		    (
		        type = datetime
		        displayname = "Submitted Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Line_Item_Details
		    (
		        type = section
		        displayname = "Line Items"
		        visibility = false
		        row = 3
		        column = 1
		    )
		    Line_Items
		    (
		        type = grid
		        displayname = "Line Items"
		        defaultrow = 1
		        maxrow = 100
		        Item
		        (
		            type = picklist
		            displayname = "Item"
		            values = Consumable_Item_Master[Status == "Active"].ID
		            displayformat = [Item_Name]
		            searchable = true
		        )
		        Qty
		        (
		            type = number
		            displayname = "Qty"
		        )
		        Unit_Rate
		        (
		            type = INR
		            displayname = "Unit Rate"
		            format = commadotindian
		            decimalplace = 2
		            maxchar = 12
		        )
		        Amount
		        (
		            type = INR
		            displayname = "Amount"
		            format = commadotindian
		            decimalplace = 2
		            maxchar = 12
		        )
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
