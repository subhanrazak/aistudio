		form Email_Template
		{
		    displayname = "Email Template"
		
		    Template_Guidance
		    (
		        type = section
		        displayname = "Template Guidance"
		        row = 1
		        column = 0
		    )
		    Template_Guide
		    (
		        type = plaintext
		        displayname = "Template Guide"
		        value = "Use unique Template Code values such as ATTENDANCE_UPLOADED, ATTENDANCE_APPROVED, ATTENDANCE_REJECTED, ATTENDANCE_INVOICE_SUBMITTED, ATTENDANCE_INVOICE_APPROVED, ATTENDANCE_INVOICE_REJECTED, CONSUMABLE_SUBMITTED, CONSUMABLE_INFRA_APPROVED, CONSUMABLE_REJECTED, CONSUMABLE_FA_APPROVED, WARNING_CREATED, DISCIPLINARY_CREATED, DISCIPLINARY_ACTION_TAKEN, WARNING_ACKNOWLEDGED, MAINTENANCE_TASK_CREATED, MAINTENANCE_SUBMITTED, MAINTENANCE_APPROVED, and MAINTENANCE_REJECTED. Use placeholders like ${VendorName}, ${Month}, ${Year}, ${Status}, ${Reason}, ${RecordLink}, ${EmployeeName}, ${AssetName}, ${InvoiceNumber}, and ${Amount}."
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Template_Code
		    (
		        type = text
		        displayname = "Template Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Template_Details
		    (
		        type = section
		        displayname = "Template Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Template_Name
		    (
		        type = text
		        displayname = "Template Name"
		        row = 2
		        column = 1
		        width = medium
		    )
