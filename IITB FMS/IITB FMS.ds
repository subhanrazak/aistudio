			Maintenance_Task_On_Validate as "Maintenance Task On Validate"
			{
			    type = form
			    form = Maintenance_Task
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                scheduleRec = Maintenance_Schedule_Configuration[ID == input.Schedule];
			                if(scheduleRec.count() == 0 || scheduleRec.Status != "Active")
			                {
			                    alert "Select an active maintenance schedule.";
			                    cancel submit;
			                }
			                if(scheduleRec.count() > 0)
			                {
			                    input.Asset = scheduleRec.Asset;
			                    input.Assigned_To = scheduleRec.Assigned_To;
			                    input.Vendor = scheduleRec.Vendor;
			                    input.Vendor_Email = scheduleRec.Vendor_Email;
			                    input.Frequency = scheduleRec.Frequency;
			                    if(input.Task_Due_Date == null)
			                    {
			                        input.Task_Due_Date = scheduleRec.Next_Due_Date;
			                    }
			                }
			                duplicates = Maintenance_Task[Schedule == input.Schedule && Task_Due_Date == input.Task_Due_Date && ID != input.ID];
			                if(duplicates.count() > 0)
			                {
			                    alert "A maintenance task already exists for this schedule and due date.";
			                    cancel submit;
			                }
			                if((input.Status == "Submitted" || input.Status == "Approved") && input.Maintenance_Report_File == null)
			                {
			                    alert "Maintenance report file is required before submission or approval.";
			                    cancel submit;
			                }
			                if(input.Status == "Rejected" && input.Rejection_Remarks in {"", " ", "null"})
			                {
			                    alert "Rejection remarks are required when a task is rejected.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Maintenance_Task_Status_Change as "Maintenance Task Status Change"
			{
			    type = form
			    form = Maintenance_Task
			    record event = on edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(old.Status != input.Status)
			                {
			                    insert into Maintenance_Task_History
			                    [
			                        Maintenance_Task = input.ID
			                        Vendor_Email = input.Vendor_Email
			                        Status = input.Status
			                        Comments = if(input.Status == "Rejected", input.Rejection_Remarks, input.FMS_Comments)
			                        Updated_By_Email = zoho.loginuser
			                        Updated_On = zoho.currenttime
			                    ]
			                    insert into Audit_Log
			                    [
			                        Module_Name = "Maintenance"
			                        Source_Form = "Maintenance_Task"
			                        Source_Record_ID = input.ID
			                        Source_Record_Label = input.Task_ID.toString()
			                        Action_Type = "Status Changed"
			                        Old_Status = old.Status
			                        New_Status = input.Status
			                        Performed_By_Email = zoho.loginuser
			                        Performed_On = zoho.currenttime
			                        Details = if(input.Status == "Rejected", input.Rejection_Remarks, input.FMS_Comments)
			                    ]
			                    if(input.Status == "Submitted")
			                    {
			                        infraRecipients = List();
			                        for each infraUserRec in User_Master[Role == "Infra Team" && Status == "Active"]
			                        {
			                            infraRecipients.add(infraUserRec.Email);
			                        }
			                        if(infraRecipients.size() > 0)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : infraRecipients
			                                subject : "MAINTENANCE_SUBMITTED: " + input.Task_ID
			                                message : "Maintenance task has been submitted for Infra approval."
			                                attachments : file : Maintenance_Report_File
			                            )
			                        }
			                    }
			                    else if(input.Status == "Rejected" && input.Vendor_Email not in {"", " ", "null"})
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : input.Vendor_Email
			                            subject : "MAINTENANCE_REJECTED: " + input.Task_ID
			                            message : "Maintenance task was rejected. Reason: " + input.Rejection_Remarks
			                        )
			                    }
			                }
			            )
			        }
			    }
			}

