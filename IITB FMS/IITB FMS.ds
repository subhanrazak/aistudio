		list Maintenance_Task_List_FMS
		{
		    displayName = "Maintenance Task List - FMS"
		    show all rows from Maintenance_Task [Vendor_Email == zoho.loginuser && (Status == "Pending" || Status == "Rejected")]
		    (
		        Task_ID
		        Asset
		        Frequency
		        Task_Due_Date
		        Status
		        FMS_Comments
		        Maintenance_Report_File
		        custom action "Edit Report"
		        (
		            workflow = WF_Open_Submit_Maintenance_Report
		            show action for each record = true
		            column header = "Edit Report"
		            success message = "Opening maintenance task for report upload."
		            condition = (Status == "Pending" || Status == "Rejected")
		        )
		        custom action "Submit Report"
		        (
		            workflow = WF_Submit_Maintenance_Report
		            show action for each record = true
		            column header = "Submit Report"
		            success message = "Maintenance report submitted."
		            condition = (Status == "Pending" || Status == "Rejected")
		        )
		    )
		    filters
		    (
		        Status
		        Asset
		        Task_Due_Date
		    )
		    sort by
		    (
		        Task_Due_Date ascending
		    )
		    conditional formatting
		    (
		        "Overdue Maintenance"
		        {
		            condition = (Task_Due_Date < zoho.currentdate && Status != "Approved")
		            fields = [Task_ID, Asset, Task_Due_Date, Status]
		            format = "background-color:#FFE0E0;color:#B00020;font-weight:bold"
		        }
		    )
		}

		list Maintenance_Task_List_Infra
		{
		    displayName = "Maintenance Task List - Infra"
		    show all rows from Maintenance_Task
		    (
		        Task_ID
		        Asset
		        Assigned_To
		        Frequency
		        Task_Due_Date
		        Status
		        FMS_Comments
		        Maintenance_Report_File
		        Rejection_Remarks
		        custom action "Approve"
		        (
		            workflow = WF_Approve_Maintenance_Task
		            show action for each record = true
		            column header = "Approve"
		            success message = "Maintenance task approved."
		            condition = (Status == "Submitted")
		        )
		        custom action "Reject"
		        (
		            workflow = WF_Reject_Maintenance_Task
		            show action for each record = true
		            column header = "Reject"
		            success message = "Opening rejection form."
		            condition = (Status == "Submitted")
		        )
		    )
		    filters
		    (
		        Status
		        Asset
		        Assigned_To
		        Task_Due_Date
		    )
		    sort by
		    (
		        Status descending
		        Task_Due_Date ascending
		    )
		}

		list Maintenance_Task_History_Report
		{
		    displayName = "Maintenance Task History Report"
		    show all rows from Maintenance_Task_History
		    (
		        History_ID
		        Maintenance_Task
		        Status
		        Comments
		        Updated_By_Email
		        Updated_On
		    )
		    filters
		    (
		        Maintenance_Task
		        Status
		        Updated_On
		    )
		    sort by
		    (
		        Updated_On ascending
		    )
		}

		default list User_Master_List
		{
		    displayName = "User Master List"
		    show all rows from User_Master
		    (
		        User_ID
		        User_Name
		        Role
		        Email
		        Phone
		        Status
		    )
		    filters
		    (
		        Role
		        Status
		    )
		    sort by
		    (
		        Role ascending
		        User_Name ascending
		    )
		}

		list Vendor_Master_List
		{
		    displayName = "Vendor Master List"
		    show all rows from User_Master [Role == "Vendor"]
		    (
		        User_ID
		        User_Name
		        Vendor_Code
		        GSTIN
		        Contact_Person
		        Contact_Phone
		        Status
		    )
		    filters
		    (
		        Status
		    )
		    sort by
		    (
		        User_Name ascending
		    )
		}

		list Warning_List_FA
		{
		    displayName = "Warning List - F&A"
		    show all rows from Warning_Penalty [Issue_Type == "Disciplinary" && Status == "Pending F&A Action"]
		    (
		        Warning_ID
		        Date
		        Vendor
		        Employee
		        Warning_Penalty_Type
		        Reason_Description
		        Action_Taken_By_FA
		        Status
		        custom action "Enter Action Taken"
		        (
		            workflow = WF_Enter_FA_Action_Warning_Penalty
		            show action for each record = true
		            column header = "Enter Action Taken"
		            success message = "Opening action capture form."
		            condition = (Status == "Pending F&A Action")
		        )
		    )
		    filters
		    (
		        Vendor
		        Employee
		        Warning_Penalty_Type
		        Status
		        Date
		    )
		    sort by
		    (
		        Date ascending
		    )
		}

		list Warning_List_FMS
		{
		    displayName = "Warning List - FMS"
		    show all rows from Warning_Penalty [Vendor_Email == zoho.loginuser]
		    (
		        Warning_ID
		        Date
		        Issue_Type
		        Warning_Penalty_Type
		        Reason_Description
		        Action_Taken_By_FA
		        FMS_Acknowledgement_Comment
		        Status
		        custom action "Acknowledge"
		        (
		            workflow = WF_Acknowledge_Warning_Penalty
		            show action for each record = true
		            column header = "Acknowledge"
		            success message = "Opening acknowledgement form."
		            condition = (Status == "Pending FMS Acknowledgement")
		        )
		    )
		    filters
		    (
		        Issue_Type
		        Warning_Penalty_Type
		        Status
		        Date
		    )
		    sort by
		    (
		        Date descending
		    )
		}

		list Warning_List_Infra
		{
		    displayName = "Warning List - Infra"
		    show all rows from Warning_Penalty
		    (
		        Warning_ID
		        Date
		        Vendor
		        Employee
		        Issue_Type
		        Warning_Penalty_Type
		        Reason_Description
		        Status
		        Action_Taken_By_FA
		        Action_Taken_Date
		        custom action "Cancel"
		        (
		            workflow = WF_Cancel_Warning_Penalty
		            show action for each record = true
		            column header = "Cancel"
		            success message = "Warning / penalty case cancelled."
		            condition = (Status != "Acknowledged" && Status != "Cancelled")
		            confirmation before execution
		            (
		                message for individual record = "Cancel this warning / penalty case?"
		                confirm button text = "Cancel Case"
		                cancel button text = "Go Back"
		            )
		        )
		    )
		    filters
		    (
		        Vendor
		        Employee
		        Issue_Type
		        Warning_Penalty_Type
		        Status
		        Date
		    )
		    sort by
		    (
		        Date descending
		    )
		}

		default list Warning_Penalty_Type_Master_List
		{
		    displayName = "Warning / Penalty Type Master List"
		    show all rows from Warning_Penalty_Type_Master
		    (
		        Issue_Type
		        Type_Name
		        Description
		        Status
		    )
		    filters
		    (
		        Issue_Type
		        Status
		    )
		    sort by
		    (
		        Issue_Type ascending
		        Type_Name ascending
		    )
		}
	}

	pages
	{
		page FA_Team_Dashboard
		{
					displayname = "F&amp;A Team Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='FA_Dashboard_Overview' elementName='FA_Dashboard_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage FA_Dashboard_Overview()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nloginEmail = zoho.loginuserid;\ndisplayUser = zoho.loginuser;\nif(displayUser == null || displayUser == &quot;&quot;)\n{\n\t\tdisplayUser = loginEmail;\n}\ncurrentMonthNumber = zoho.currentdate.getMonth();\ncurrentYear = zoho.currentdate.getYear();\n\npendingAttendanceInvoices = Attendance_Invoice[Status == &quot;Pending F&amp;A Validation&quot;].count();\npendingConsumableInvoices = Consumable_Invoice[Status == &quot;Pending F&amp;A Validation&quot;].count();\npendingDisciplinaryActions = Warning_Penalty[Status == &quot;Pending F&amp;A Action&quot;].count();\n\nmonthInvoiceValue = 0.0;\nfor each attInv in Attendance_Invoice[ID != 0]\n{\n\t\tif(attInv.Invoice_Date != null &amp;&amp; attInv.Invoice_Date.getMonth() == currentMonthNumber &amp;&amp; attInv.Invoice_Date.getYear() == currentYear)\n\t\t{\n\t\t\t\tmonthInvoiceValue = monthInvoiceValue + ifnull(attInv.Total_Amount,0.0);\n\t\t}\n}\nfor each conInv in Consumable_Invoice[ID != 0]\n{\n\t\tif(conInv.Invoice_Date != null &amp;&amp; conInv.Invoice_Date.getMonth() == currentMonthNumber &amp;&amp; conInv.Invoice_Date.getYear() == currentYear)\n\t\t{\n\t\t\t\tmonthInvoiceValue = monthInvoiceValue + ifnull(conInv.Total_Amount,0.0);\n\t\t}\n}\n\nbooksApprovalsThisMonth = 0;\nfor each logRec in Audit_Log[Module_Name == &quot;Integration&quot; &amp;&amp; Action_Type == &quot;Books Push&quot; &amp;&amp; New_Status == &quot;Approved&quot;]\n{\n\t\tif(logRec.Performed_On != null &amp;&amp; logRec.Performed_On.getMonth() == currentMonthNumber &amp;&amp; logRec.Performed_On.getYear() == currentYear)\n\t\t{\n\t\t\t\tbooksApprovalsThisMonth = booksApprovalsThisMonth + 1;\n\t\t}\n}\n\nstatusPendingFA = pendingAttendanceInvoices + pendingConsumableInvoices;\nstatusPendingInfra = Consumable_Invoice[Status == &quot;Pending Infra Validation&quot;].count();\nstatusApproved = Attendance_Invoice[Status == &quot;Approved&quot;].count() + Consumable_Invoice[Status == &quot;Approved&quot;].count();\nstatusRejected = Attendance_Invoice[Status == &quot;Rejected&quot;].count() + Consumable_Invoice[Status == &quot;Rejected&quot;].count();\nstatusTotal = statusPendingFA + statusPendingInfra + statusApproved + statusRejected;\npctPendingFA = 0;\npctPendingInfra = 0;\npctApproved = 0;\npctRejected = 0;\nif(statusTotal &gt; 0)\n{\n\t\tpctPendingFA = (statusPendingFA * 100) / statusTotal;\n\t\tpctPendingInfra = (statusPendingInfra * 100) / statusTotal;\n\t\tpctApproved = (statusApproved * 100) / statusTotal;\n\t\tpctRejected = (statusRejected * 100) / statusTotal;\n}\n\nrejectedAttendance = Attendance_Invoice[Status == &quot;Rejected&quot;].count();\nrejectedConsumables = Consumable_Invoice[Status == &quot;Rejected&quot;].count();\nrejectedTotal = rejectedAttendance + rejectedConsumables;\nfmsAckPending = Warning_Penalty[Status == &quot;Pending FMS Acknowledgement&quot;].count();\nactiveVendors = User_Master[Role == &quot;Vendor&quot; &amp;&amp; Status == &quot;Active&quot;].count();\nactiveEmployees = FMS_Employee_Master[Status == &quot;Active&quot;].count();\n\nmaxVendorSpend = 0.0;\nfor each vendorCalc in User_Master[Role == &quot;Vendor&quot; &amp;&amp; Status == &quot;Active&quot;]\n{\n\t\tvendorSpendCalc = ifnull(Attendance_Invoice[Vendor == vendorCalc.ID &amp;&amp; Status == &quot;Approved&quot;].sum(Total_Amount),0.0) + ifnull(Consumable_Invoice[Vendor == vendorCalc.ID &amp;&amp; Status == &quot;Approved&quot;].sum(Total_Amount),0.0);\n\t\tif(vendorSpendCalc &gt; maxVendorSpend)\n\t\t{\n\t\t\t\tmaxVendorSpend = vendorSpendCalc;\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility stylesheet included once for this page: compact utility subset used by fetched ZCS components. */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --fa-blue: #004B8D; --fa-blue-dark: #002F6C; --fa-gold: #F7A600; --fa-green: #179E6C; --fa-red: #D93045; --fa-yellow: #B8770D; font-size: 16px; line-height: 1.5; }\n.zc-pb-page-content-wrapper div#zppagesLive, .zc-pb-page-content-wrapper div#elementsContainer, .zc-pb-page-content-wrapper .elemContainment, .zc-pb-page-content-wrapper .zcpage-elemContainer { height: 100%; }\n.zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { box-shadow: none !important; }\n* { box-sizing: border-box; } a { text-decoration: none; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #E4E8F0; border-radius: 12px; }\n.zcs-row { display: flex; flex-wrap: wrap; } .zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center, .zcs-align-center { align-items: center; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-4 { gap: 0.25rem; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-10 { gap: 0.625rem; } .zcs-gap-12 { gap: 0.75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: 0.5rem; } .zcs-p-10 { padding: 0.625rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; } .zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; } .zcs-py-5 { padding-top: 0.3125rem; padding-bottom: 0.3125rem; } .zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; } .zcs-m-0 { margin: 0; }\n.zcs-w-full { width: 100%; } .zcs-font-11 { font-size: 0.6875rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-13 { font-size: 0.8125rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-15 { font-size: 0.9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-40 { font-size: 2.5rem; }\n.zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-rounded-sm { border-radius: 0.25rem; } .zcs-rounded-md { border-radius: 0.375rem; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-rounded-full { border-radius: 100%; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; } .zcs-box-border { box-sizing: border-box; } .zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-sticky { position: sticky; } .zcs-cursor-pointer { cursor: pointer; }\n/* ZCS component CSS: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); } .zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); } .zcs-button:hover { filter: brightness(0.96); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; } .zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; } .zcs-table-wrapper .zcs-green { color: #179E6C; } .zcs-table-wrapper .zcs-red { color: #FE455D; } .zcs-table-wrapper .zcs-yellow { color: #B8770D; } .zcs-table-wrapper .zcs-blue { color: #09598E; }\n/* ZCS component CSS: chart-donut-chart-with-text */\n.zcs-legend-wrapper li { list-style-type: none; } .zcs-legend-wrapper li label { min-width: 170px; } .zcs-legend-wrapper li label:before { content: &apos;&apos;; display: inline-block; vertical-align: top; width: 12px; height: 12px; margin: 4px 12px 4px 0; border-radius: 50%; } .zcs-legend-wrapper li:nth-child(1) label:before { background-color: #FECE56; } .zcs-legend-wrapper li:nth-child(2) label:before { background-color: #36A2EB; } .zcs-legend-wrapper li:nth-child(3) label:before { background-color: #FF6283; } .zcs-legend-wrapper li:nth-child(4) label:before { background-color: #28CC97; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg { width: var(--donut-donut_size); height: var(--donut-donut_size); overflow: hidden; } .zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle { cx: var(--donut-cx); cy: var(--donut-cy); r: var(--donut-r); stroke-width: var(--donut-stroke_width); fill: transparent; } .zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1) { stroke: #FECE56; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a1) / 100)); stroke-dashoffset: calc((2 * var(--donut-pi) * var(--donut-r)) / 4); } .zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2) { stroke: #36A2EB; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a2) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)); } .zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3) { stroke: #FF6283; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a3) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100)); } .zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4) { stroke: #28CC97; stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a4) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100)); }\n/* ZCS component CSS: card-fleets-performance-metrics */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F6); overflow: hidden; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n/* ZCS component CSS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n/* F&amp;A dashboard layout */\n.fa-dashboard { min-height: 100%; background: #F2F5FA; color: #172033; font-family: Lato, Arial, sans-serif; }\n.fa-hero { position: relative; overflow: hidden; color: #FFFFFF; background: radial-gradient(circle at 88% 18%, rgba(247,166,0,0.34) 0, rgba(247,166,0,0.18) 18%, transparent 38%), linear-gradient(135deg, var(--fa-blue-dark) 0%, var(--fa-blue) 58%, #0A6EB8 100%); }\n.fa-hero:before { content: &apos;&apos;; position: absolute; right: -90px; top: -115px; width: 330px; height: 330px; border: 1px solid rgba(255,255,255,0.16); border-radius: 50%; }\n.fa-hero:after { content: &apos;&apos;; position: absolute; right: 96px; bottom: -126px; width: 260px; height: 260px; border: 34px solid rgba(255,255,255,0.08); border-radius: 50%; }\n.fa-hero-content { position: relative; z-index: 1; padding: 28px 30px 30px; }\n.fa-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }\n.fa-brand-mark { width: 44px; height: 44px; border-radius: 13px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; }\n.fa-brand-mark i { font-size: 23px; }\n.fa-title { margin: 0; font-size: 30px; line-height: 1.18; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF; }\n.fa-subtitle { max-width: 900px; margin: 10px 0 0; color: rgba(255,255,255,0.86); font-size: 15px; line-height: 1.6; }\n.fa-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }\n.fa-chip-link { min-height: 36px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px; border-radius: 9px; color: #FFFFFF; border: 1px solid rgba(255,255,255,0.50); background: rgba(255,255,255,0.12); font-size: 13px; font-weight: 600; }\n.fa-chip-link:hover { background: rgba(255,255,255,0.20); color: #FFFFFF; }\n.fa-kpi-grid { margin-top: 24px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }\n.fa-kpi-card { min-height: 126px; padding: 16px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.12); border-radius: 14px; backdrop-filter: blur(8px); }\n.fa-kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; background: rgba(255,255,255,0.16); color: #FFFFFF; }\n.fa-kpi-icon i { font-size: 18px; }\n.fa-kpi-value { display: block; color: #FFFFFF; font-size: 30px; line-height: 1; font-weight: 700; }\n.fa-kpi-label { display: block; margin-top: 8px; color: rgba(255,255,255,0.84); font-size: 13px; line-height: 1.35; }\n.fa-kpi-card.urgent { border-color: rgba(247,166,0,0.55); }\n.fa-body { padding: 26px 30px 32px; }\n.fa-section-heading { margin: 0 0 16px; }\n.fa-section-heading h2 { margin: 0; color: #172033; font-size: 22px; font-weight: 700; }\n.fa-section-heading p { margin: 6px 0 0; color: #647084; font-size: 14px; line-height: 1.55; }\n.fa-insights-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: stretch; }\n.fa-card { border: 1px solid #E1E7F0; box-shadow: 0 12px 30px rgba(20,38,72,0.08); }\n.fa-card-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid #E8EDF5; }\n.fa-card-title h3 { margin: 0; font-size: 18px; color: #172033; }\n.fa-card-title span { color: #647084; font-size: 12px; }\n.fa-numberline { display: flex; align-items: baseline; justify-content: space-between; margin: 16px 0 10px; gap: 12px; }\n.fa-numberline strong { font-size: 28px; color: #172033; line-height: 1; }\n.fa-numberline small { color: #647084; font-size: 13px; }\n.fa-muted { color: #647084; font-size: 13px; line-height: 1.5; }\n.fa-bar-list { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }\n.fa-bar-row { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(160px, 2fr) 90px; gap: 10px; align-items: center; }\n.fa-bar-label { color: #41506B; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.fa-bar-track { height: 8px; background: #EEF2F6; border-radius: 8px; overflow: hidden; }\n.fa-bar-fill { height: 100%; border-radius: 8px; background: var(--zcs_brand_color); }\n.fa-bar-value { color: #172033; font-size: 13px; text-align: right; white-space: nowrap; }\n.fa-status-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; margin-top: 14px; }\n.fa-status-mini { padding: 12px; border: 1px solid #E6EBF2; border-radius: 10px; background: #FBFCFE; }\n.fa-status-mini b { display: block; font-size: 20px; color: #172033; line-height: 1; }\n.fa-status-mini span { display: block; margin-top: 6px; color: #647084; font-size: 12px; }\n.fa-table-empty { padding: 20px; color: #647084; text-align: center; }\n.fa-quick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.fa-panel-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr); gap: 18px; margin-top: 18px; }\n.fa-note-list { margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }\n.fa-note-list li { list-style-type: none; display: flex; gap: 10px; align-items: flex-start; color: #41506B; font-size: 13px; line-height: 1.45; }\n.fa-note-list i { color: var(--zcs_brand_color); margin-top: 2px; }\n@media (max-width: 1180px) { .fa-kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .fa-insights-grid, .fa-panel-grid { grid-template-columns: 1fr; } }\n@media (max-width: 760px) { .fa-hero-content, .fa-body { padding: 20px; } .fa-kpi-grid, .fa-status-grid, .fa-quick-grid { grid-template-columns: 1fr; } .fa-title { font-size: 24px; } .fa-bar-row { grid-template-columns: 1fr; gap: 6px; } .fa-bar-value { text-align: left; } }\n&lt;/style&gt;\n&lt;div class=&quot;fa-dashboard&quot;&gt;\n\t\t&lt;div class=&quot;fa-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fa-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;fa-title-row&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-brand-mark&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h1 class=&quot;fa-title&quot;&gt;F&amp;amp;A Team Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;fa-subtitle&quot;&gt;Hello &lt;%=displayUser%&gt;. Track invoice validation queues, disciplinary follow-up, rejected resubmissions, vendor references, and the local Books push audit scaffold. No live Books calls are made from this page.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-hero-actions&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;fa-chip-link&quot; href=&quot;#Report:Attendance_Invoice_List_FA&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-single-copy-04&quot;&gt;&lt;/i&gt;Attendance invoices&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;fa-chip-link&quot; href=&quot;#Report:Consumable_Invoice_List_FA&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart&quot;&gt;&lt;/i&gt;Consumable invoices&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;fa-chip-link&quot; href=&quot;#Report:Audit_Log_List&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;Audit log&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-card urgent&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-single-copy-04&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-value&quot;&gt;&lt;%=pendingAttendanceInvoices%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-label&quot;&gt;Pending attendance invoices&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-card urgent&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-value&quot;&gt;&lt;%=pendingConsumableInvoices%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-label&quot;&gt;Pending consumable F&amp;amp;A invoices&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-card urgent&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-value&quot;&gt;&lt;%=pendingDisciplinaryActions%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-label&quot;&gt;Pending disciplinary actions&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-value&quot;&gt;INR &lt;%=monthInvoiceValue%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-label&quot;&gt;Total invoice value this month&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-value&quot;&gt;&lt;%=booksApprovalsThisMonth%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;fa-kpi-label&quot;&gt;Approved Books push audit entries this month&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;fa-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fa-section-heading&quot;&gt;\n\t\t\t\t\t\t&lt;h2&gt;F&amp;amp;A operating snapshot&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p&gt;Invoice and warning data is sourced from local Creator records and audit logs.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fa-insights-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border fa-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3&gt;Invoice status breakdown&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;&lt;%=statusTotal%&gt; records&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-12 zcs-p-20 zcs-box-border&quot; style=&quot;--donut-cx:82px; --donut-cy:82px; --donut-r:64; --donut-stroke_width:18; --donut-pi:3.14; --donut-a1:&lt;%=pctPendingFA%&gt;; --donut-a2:&lt;%=pctApproved%&gt;; --donut-a3:&lt;%=pctRejected%&gt;; --donut-a4:&lt;%=pctPendingInfra%&gt;; --donut-donut_size:164px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;svg class=&quot;zcs-rounded-full&quot;&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;circle&gt;&lt;/circle&gt;&lt;/svg&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-donut-chart-name zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&quot;&gt;Invoices&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Pending F&amp;amp;A: &lt;%=statusPendingFA%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Approved: &lt;%=statusApproved%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Rejected: &lt;%=statusRejected%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Pending Infra: &lt;%=statusPendingInfra%&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-status-grid&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-status-mini&quot;&gt;&lt;b&gt;&lt;%=pendingAttendanceInvoices%&gt;&lt;/b&gt;&lt;span&gt;Attendance queue&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-status-mini&quot;&gt;&lt;b&gt;&lt;%=pendingConsumableInvoices%&gt;&lt;/b&gt;&lt;span&gt;Consumable queue&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-status-mini&quot;&gt;&lt;b&gt;&lt;%=rejectedTotal%&gt;&lt;/b&gt;&lt;span&gt;Rejected items&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-status-mini&quot;&gt;&lt;b&gt;&lt;%=booksApprovalsThisMonth%&gt;&lt;/b&gt;&lt;span&gt;Books approvals&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border fa-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3&gt;Vendor-wise approved spend&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;&lt;%=activeVendors%&gt; active vendors&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tvendorIndex = 0;\n\t\t\t\t\t\t\t\t\t\tfor each vendorRec in User_Master[Role == &quot;Vendor&quot; &amp;&amp; Status == &quot;Active&quot;] sort by User_Name asc\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif(vendorIndex &lt; 6)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tvendorSpend = ifnull(Attendance_Invoice[Vendor == vendorRec.ID &amp;&amp; Status == &quot;Approved&quot;].sum(Total_Amount),0.0) + ifnull(Consumable_Invoice[Vendor == vendorRec.ID &amp;&amp; Status == &quot;Approved&quot;].sum(Total_Amount),0.0);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tvendorPct = 0;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(maxVendorSpend &gt; 0)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tvendorPct = (vendorSpend * 100) / maxVendorSpend;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tvendorName = ifnull(vendorRec.User_Name,&quot;Vendor&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-label&quot;&gt;&lt;%=vendorName%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-track&quot;&gt;&lt;div class=&quot;fa-bar-fill&quot; style=&quot;width:&lt;%=vendorPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-value&quot;&gt;INR &lt;%=vendorSpend%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tvendorIndex = vendorIndex + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(vendorIndex == 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;fa-table-empty&quot;&gt;No active vendor spend is available yet.&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fa-panel-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border fa-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3&gt;Rejected invoices awaiting resubmission&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;&lt;%=rejectedTotal%&gt; rejected&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot; style=&quot;margin-top:16px; max-height:330px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Vendor&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\trejectedRows = 0;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tfor each rAtt in Attendance_Invoice[Status == &quot;Rejected&quot;] sort by Invoice_Date desc\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(rejectedRows &lt; 5)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\trejectedRows = rejectedRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Attendance&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(rAtt.Invoice_Number,rAtt.Invoice_ID)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(rAtt.Vendor.User_Name,&quot;Vendor&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;INR &lt;%=ifnull(rAtt.Total_Amount,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&quot;&gt;Rejected&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tfor each rCon in Consumable_Invoice[Status == &quot;Rejected&quot;] sort by Invoice_Date desc\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(rejectedRows &lt; 10)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\trejectedRows = rejectedRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Consumable&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(rCon.Invoice_Number,rCon.Invoice_ID)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(rCon.Vendor.User_Name,&quot;Vendor&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;INR &lt;%=ifnull(rCon.Total_Amount,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&quot;&gt;Rejected&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(rejectedRows == 0)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td class=&quot;fa-table-empty&quot; colspan=&quot;5&quot;&gt;No rejected invoices are currently awaiting resubmission.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border fa-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-card-title&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3&gt;Disciplinary cases pending FMS acknowledgement&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span&gt;&lt;%=fmsAckPending%&gt; cases&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-numberline&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=fmsAckPending%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;small&gt;Awaiting FMS acknowledgement&lt;/small&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;fa-bar-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tcaseRows = 0;\n\t\t\t\t\t\t\t\t\t\tfor each warnRec in Warning_Penalty[Status == &quot;Pending FMS Acknowledgement&quot;] sort by Date asc\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif(caseRows &lt; 5)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tcaseRows = caseRows + 1;\n\t\t\