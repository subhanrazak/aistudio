			User_Master_On_Validate as "User Master On Validate"
			{
			    type = form
			    form = User_Master
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Active" && input.Role == "Vendor")
			                {
			                    if(input.Email in {"", " ", "null"})
			                    {
			                        alert "Email is required for active vendors.";
			                        cancel submit;
			                    }
			                    if(input.Vendor_Code in {"", " ", "null"} || input.GSTIN in {"", " ", "null"} || input.PAN_Number in {"", " ", "null"} || input.Bank_Account_Number in {"", " ", "null"} || input.IFSC_Code in {"", " ", "null"} || input.Bank_Name in {"", " ", "null"} || input.Contact_Person in {"", " ", "null"} || input.Contact_Phone in {"", " ", "null"} || input.Billing_Address in {"", " ", "null"})
			                    {
			                        alert "Vendor tax, bank, contact, and billing details are required for active vendors.";
			                        cancel submit;
			                    }
			                }
			                if(input.Status == "Active" && (input.Role == "Infra Team" || input.Role == "F&A Team") && input.Email in {"", " ", "null"})
			                {
			                    alert "Email is required for active internal notification recipients.";
			                    cancel submit;
			                }
			                if(input.Email not in {"", " ", "null"})
			                {
			                    duplicateUsers = User_Master[Email == input.Email && ID != input.ID && Status == "Active"];
			                    if(duplicateUsers.count() > 0)
			                    {
			                        alert "Another active User Master record already uses this email.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_Issue_Type_On_User_Input as "Warning Penalty Issue Type On User Input"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on add or edit
			
			    on user input of Issue_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Warning_Penalty_Type = null;
			                clear Warning_Penalty_Type;
			                if(input.Issue_Type not in {"", " ", "null"})
			                {
			                    for each warningTypeRec in Warning_Penalty_Type_Master[Issue_Type == input.Issue_Type && Status == "Active"] sort by Type_Name
			                    {
			                        Warning_Penalty_Type:ui.add(warningTypeRec.ID);
			                    }
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_Vendor_On_User_Input as "Warning Penalty Vendor On User Input"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on add or edit
			
			    on user input of Vendor
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Employee = null;
			                clear Employee;
			                vendorRec = User_Master[ID == input.Vendor];
			                if(vendorRec.count() > 0)
			                {
			                    input.Vendor_Email = vendorRec.Email;
			                    for each employeeRec in FMS_Employee_Master[Vendor == input.Vendor && Status == "Active"] sort by Employee_Name
			                    {
			                        Employee:ui.add(employeeRec.ID);
			                    }
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_Delete_Validate as "Warning Penalty Delete Validation"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status not in {"Raised", "Cancelled"} || input.Action_Taken_By_FA not in {"", " ", "null"} || input.FMS_Acknowledgement_Comment not in {"", " ", "null"})
			                {
			                    alert "Only raised or cancelled cases with no action/acknowledgement history can be deleted. Remove dependencies manually before administrative cleanup.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_On_Load as "Warning Penalty On Load"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Vendor_Email;
			                disable Raised_By_Email;
			                disable Status;
			                disable Action_Taken_By_FA;
			                disable Action_Taken_Date;
			                disable FMS_Acknowledgement_Comment;
			                clear Employee;
			                clear Warning_Penalty_Type;
			                if(input.Vendor != null)
			                {
			                    for each employeeRec in FMS_Employee_Master[Vendor == input.Vendor && Status == "Active"] sort by Employee_Name
			                    {
			                        Employee:ui.add(employeeRec.ID);
			                    }
			                }
			                if(input.Issue_Type not in {"", " ", "null"})
			                {
			                    for each warningTypeRec in Warning_Penalty_Type_Master[Issue_Type == input.Issue_Type && Status == "Active"] sort by Type_Name
			                    {
			                        Warning_Penalty_Type:ui.add(warningTypeRec.ID);
			                    }
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_On_Success as "Warning Penalty On Success"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Raised_By_Email = zoho.loginuser;
			                if(input.Issue_Type == "Warning")
			                {
			                    input.Status = "Pending FMS Acknowledgement";
			                    nextStatus = "Pending FMS Acknowledgement";
			                    templateCode = "WARNING_CREATED";
			                }
			                else
			                {
			                    input.Status = "Pending F&A Action";
			                    nextStatus = "Pending F&A Action";
			                    templateCode = "DISCIPLINARY_CREATED";
			                }
			                insert into Audit_Log
			                [
			                    Module_Name = "Disciplinary"
			                    Source_Form = "Warning_Penalty"
			                    Source_Record_ID = input.ID
			                    Source_Record_Label = input.Warning_ID.toString()
			                    Action_Type = "Created"
			                    New_Status = nextStatus
			                    Performed_By_Email = zoho.loginuser
			                    Performed_On = zoho.currenttime
			                    Details = "Warning / penalty case created."
			                ]
			                if(input.Vendor_Email not in {"", " ", "null"})
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Vendor_Email
			                        subject : templateCode + ": " + input.Warning_ID
			                        message : "A " + input.Issue_Type + " case has been created and is currently " + nextStatus + ". Reason: " + input.Reason_Description
			                    )
			                }
			                infraRecipients = List();
			                for each infraUserRec in User_Master[Role == "Infra Team" && Status == "Active"]
			                {
			                    infraRecipients.add(infraUserRec.Email);
			                }
			                if(infraRecipients.size() > 0)
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : infraRecipients
			                        subject : templateCode + ": " + input.Warning_ID
			                        message : "A " + input.Issue_Type + " case has been created for vendor " + input.Vendor_Email + ". Status: " + nextStatus
			                    )
			                }
			                if(input.Issue_Type == "Disciplinary")
			                {
			                    faRecipients = List();
			                    for each faUserRec in User_Master[Role == "F&A Team" && Status == "Active"]
			                    {
			                        faRecipients.add(faUserRec.Email);
			                    }
			                    if(faRecipients.size() > 0)
			                    {
			                        sendmail
			                        (
			                            from : zoho.adminuserid
			                            to : faRecipients
			                            subject : "DISCIPLINARY_CREATED: " + input.Warning_ID
			                            message : "A disciplinary case is pending F&A action. Reason: " + input.Reason_Description
			                        )
			                    }
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_On_Validate as "Warning Penalty On Validate"
			{
			    type = form
			    form = Warning_Penalty
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                vendorRec = User_Master[ID == input.Vendor];
			                if(vendorRec.count() == 0 || vendorRec.Role != "Vendor" || vendorRec.Status != "Active")
			                {
			                    alert "Select an active vendor.";
			                    cancel submit;
			                }
			                if(vendorRec.count() > 0)
			                {
			                    input.Vendor_Email = vendorRec.Email;
			                }
			                employeeRec = FMS_Employee_Master[ID == input.Employee];
			                if(employeeRec.count() == 0 || employeeRec.Status != "Active" || employeeRec.Vendor != input.Vendor)
			                {
			                    alert "Select an active employee for the selected vendor.";
			                    cancel submit;
			                }
			                typeRec = Warning_Penalty_Type_Master[ID == input.Warning_Penalty_Type];
			                if(typeRec.count() == 0 || typeRec.Status != "Active" || typeRec.Issue_Type != input.Issue_Type)
			                {
			                    alert "Select an active warning / penalty type that matches the issue type.";
			                    cancel submit;
			                }
			                if(input.Status == "Pending F&A Action" && input.Issue_Type != "Disciplinary")
			                {
			                    alert "Only disciplinary cases can be pending F&A action.";
			                    cancel submit;
			                }
			                if(input.Status == "Pending FMS Acknowledgement" && input.Issue_Type == "Disciplinary" && (input.Action_Taken_By_FA in {"", " ", "null"} || input.Action_Taken_Date == null))
			                {
			                    alert "F&A action and action date are required before vendor acknowledgement.";
			                    cancel submit;
			                }
			                if(input.Status == "Acknowledged" && input.FMS_Acknowledgement_Comment in {"", " ", "null"})
			                {
			                    alert "Acknowledgement comment is required.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Warning_Penalty_Type_Master_Delete_Validate as "Warning Penalty Type Master Delete Validation"
			{
			    type = form
			    form = Warning_Penalty_Type_Master
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Administrator-only delete permission plus dependency checks are completed after Warning_Penalty exists.
			            )
			        }
			    }
			}

			Warning_Penalty_Type_Master_On_Validate as "Warning Penalty Type Master On Validate"
			{
			    type = form
			    form = Warning_Penalty_Type_Master
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                duplicateTypes = Warning_Penalty_Type_Master[Issue_Type == input.Issue_Type && Type_Name == input.Type_Name && Status == "Active" && ID != input.ID];
			                if(input.Status == "Active" && duplicateTypes.count() > 0)
			                {
			                    alert "An active type with this name already exists for the selected issue type.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

