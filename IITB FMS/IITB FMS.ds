			Monthly_Attendance_Record_Auto_Creation as "Monthly Attendance Record Auto-Creation"
			{
			    type = schedule
			    start = "2025-01-01 09:00:00"
			    frequency = monthly
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                monthList = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"};
			                currentMonthNumber = zoho.currentdate.getMonth();
			                currentMonthName = monthList.get(currentMonthNumber - 1);
			                currentYear = zoho.currentdate.getYear();
			                vendors = User_Master[Role == "Vendor" && Status == "Active"];
			                for each vendorRec in vendors
			                {
			                    existingSubmissions = Attendance_Submission[Vendor == vendorRec.ID && Month_Number == currentMonthNumber && Year == currentYear];
			                    if(existingSubmissions.count() == 0)
			                    {
			                        newSubmission = insert into Attendance_Submission
			                        [
			                            Month = currentMonthName
			                            Month_Number = currentMonthNumber
			                            Year = currentYear
			                            Vendor = vendorRec.ID
			                            Vendor_Email = vendorRec.Email
			                            Date_of_Submission = zoho.currentdate
			                            Status = "Pending Upload"
			                        ];
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Attendance"
			                            Source_Form = "Attendance_Submission"
			                            Source_Record_ID = newSubmission
			                            Source_Record_Label = vendorRec.User_Name + " - " + currentMonthName + " " + currentYear
			                            Action_Type = "Created"
			                            New_Status = "Pending Upload"
			                            Performed_By_Email = zoho.loginuser
			                            Performed_On = zoho.currenttime
			                            Details = "Monthly attendance submission auto-created."
			                        ]
			                    }
			                }
			            )
			        }
			    }
			}

			Auto_Create_Maintenance_Tasks_Daily_Check as "Auto Create Maintenance Tasks Daily Check"
			{
			    type = schedule
			    start = "2025-01-01 07:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                dueSchedules = Maintenance_Schedule_Configuration[Status == "Active" && Next_Due_Date == zoho.currentdate];
			                for each scheduleRec in dueSchedules
			                {
			                    existingTask = Maintenance_Task[Schedule == scheduleRec.ID && Task_Due_Date == scheduleRec.Next_Due_Date];
			                    if(existingTask.count() == 0)
			                    {
			                        taskId = insert into Maintenance_Task
			                        [
			                            Schedule = scheduleRec.ID
			                            Asset = scheduleRec.Asset
			                            Assigned_To = scheduleRec.Assigned_To
			                            Vendor = scheduleRec.Vendor
			                            Vendor_Email = scheduleRec.Vendor_Email
			                            Task_Due_Date = scheduleRec.Next_Due_Date
			                            Frequency = scheduleRec.Frequency
			                            Status = "Pending"
			                        ];
			                        insert into Maintenance_Task_History
			                        [
			                            Maintenance_Task = taskId
			                            Vendor_Email = scheduleRec.Vendor_Email
			                            Status = "Pending"
			                            Comments = "Task auto-created from schedule."
			                            Updated_By_Email = zoho.adminuserid
			                            Updated_On = zoho.currenttime
			                        ]
			                        insert into Audit_Log
			                        [
			                            Module_Name = "Maintenance"
			                            Source_Form = "Maintenance_Task"
			                            Source_Record_ID = taskId
			                            Source_Record_Label = taskId.toString()
			                            Action_Type = "Created"
			                            New_Status = "Pending"
			                            Performed_By_Email = zoho.adminuserid
			                            Performed_On = zoho.currenttime
			                            Details = "Maintenance task auto-created from due schedule."
			                        ]
			                        if(scheduleRec.Vendor_Email not in {"", " ", "null"})
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : scheduleRec.Vendor_Email
			                                subject : "MAINTENANCE_TASK_CREATED"
			                                message : "A maintenance task is due today for your assigned asset."
			                            )
			                        }
			                        infraRecipients = List();
			                        for each infraUserRec in User_Master[Role == "Infra Team" && Status == "Active"]
			                        {
			                            infraRecipients.add(infraUserRec.Email);
			                        }
			                        if(infraRecipients.size() > 0)
			                        {
			                            sendmail
			                            (
			                                from : zoho.adminuserid
			                                to : infraRecipients
			                                subject : "MAINTENANCE_TASK_CREATED"
			                                message : "A maintenance task was auto-created for a due schedule."
			                            )
			                        }
			                    }
			                }
			            )
			        }
			    }
			}
		}

