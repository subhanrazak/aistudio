			Consumable_Invoice_On_Success as "Consumable Invoice On Success"
			{
			    type = form
			    form = Consumable_Invoice
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Submitted_By_Email = zoho.loginuser;
			                input.Submitted_Date = zoho.currenttime;
			                input.Status = "Pending Infra Validation";
			                insert into Audit_Log
			                [
			                    Module_Name = "Consumables"
			                    Source_Form = "Consumable_Invoice"
			                    Source_Record_ID = input.ID
			                    Source_Record_Label = input.Invoice_Number
			                    Action_Type = "Submitted"
			                    New_Status = "Pending Infra Validation"
			                    Performed_By_Email = zoho.loginuser
			                    Performed_On = zoho.currenttime
			                    Details = "Consumable invoice submitted for Infra validation."
			                ]
			                infraRecipients = List();
			                for each infraUserRec in User_Master[Role == "Infra Team" && Status == "Active"]
			                {
			                    infraRecipients.add(infraUserRec.Email);
			                }
			                if(infraRecipients.size() > 0)
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : infraRecipients
			                        subject : "Consumable invoice submitted: " + input.Invoice_Number
			                        message : "A consumable invoice has been submitted by " + input.Vendor_Email + " and is pending Infra validation. Amount: " + input.Total_Amount
			                        attachments : file : Invoice_File
			                    )
			                }
			            )
			        }
			    }
			}

			Consumable_Invoice_On_Validate as "Consumable Invoice On Validate"
			{
			    type = form
			    form = Consumable_Invoice
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                vendorRec = User_Master[ID == input.Vendor];
			                if(vendorRec.count() == 0 || vendorRec.Role != "Vendor" || vendorRec.Status != "Active")
			                {
			                    alert "Select an active vendor.";
			                    cancel submit;
			                }
			                if(vendorRec.count() > 0)
			                {
			                    input.Vendor_Email = vendorRec.Email;
			                }
			                if(input.Line_Items.isEmpty())
			                {
			                    alert "At least one line item is required.";
			                    cancel submit;
			                }
			                computedSubtotal = 0;
			                for each itemLine in input.Line_Items
			                {
			                    if(ifnull(itemLine.Qty,0) <= 0 || ifnull(itemLine.Unit_Rate,0) <= 0)
			                    {
			                        alert "Line item quantity and unit rate must be greater than zero.";
			                        cancel submit;
			                    }
			                    computedSubtotal = computedSubtotal + (itemLine.Qty * itemLine.Unit_Rate);
			                }
			                input.Sub_Total = computedSubtotal;
			                if(ifnull(input.Tax,0) < 0)
			                {
			                    alert "Tax cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Line_Item_Item_On_User_Input as "Line Item Item On User Input"
			{
			    type = form
			    form = Consumable_Invoice
			    record event = on add or edit
			
			    on user input of Line_Items.Item
			    {
			        actions
			        {
			            custom deluge script
			            (
			                itemRec = Consumable_Item_Master[ID == row.Item];
			                if(itemRec.count() > 0)
			                {
			                    row.Unit_Rate = itemRec.Unit_Price;
			                }
			                row.Amount = ifnull(row.Qty,0) * ifnull(row.Unit_Rate,0);
			                computedSubtotal = 0;
			                for each itemLine in input.Line_Items
			                {
			                    computedSubtotal = computedSubtotal + (ifnull(itemLine.Qty,0) * ifnull(itemLine.Unit_Rate,0));
			                }
			                input.Sub_Total = computedSubtotal;
			            )
			        }
			    }
			}

