erdue &lt;%=maintenanceOverdueCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;fms-kpi-value&quot;&gt;&lt;%=maintenanceDueCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Maintenance tasks due or overdue for report upload&lt;/div&gt;\n\t\t&lt;/article&gt;\n\n\t\t&lt;article class=&quot;fms-kpi-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border fms-warning&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fms-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Pending ack&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;fms-kpi-value&quot;&gt;&lt;%=warningsPendingCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Warnings pending FMS acknowledgement&lt;/div&gt;\n\t\t&lt;/article&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;fms-shell-grid&quot;&gt;\n\t\t&lt;article class=&quot;fms-timeline-card zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fms-section-title&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zc-li-outline design-todo zcs-color-theme zcs-font-20&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-lh-heading zcs-color-primary&quot;&gt;Current month submission tracker&lt;/h2&gt;\n\t\t\t\t&lt;/div&g