			Maintenance_Schedule_Frequency_On_User_Input as "Maintenance Schedule Frequency On User Input"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on add or edit
			
			    on user input of Frequency
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Frequency == "Other")
			                {
			                    show Interval;
			                    enable Interval;
			                }
			                else
			                {
			                    input.Interval = null;
			                    hide Interval;
			                }
			                if(input.Start_Date != null)
			                {
			                    if(input.Frequency == "Weekly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(7);
			                    }
			                    else if(input.Frequency == "Monthly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(1);
			                    }
			                    else if(input.Frequency == "Quarterly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(3);
			                    }
			                    else if(input.Frequency == "Other" && ifnull(input.Interval,0) > 0)
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
			                    }
			                }
			            )
			        }
			    }
			}

			Maintenance_Schedule_Interval_On_User_Input as "Maintenance Schedule Interval On User Input"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on add or edit
			
			    on user input of Interval
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Frequency == "Other" && input.Start_Date != null && ifnull(input.Interval,0) > 0)
			                {
			                    input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
			                }
			            )
			        }
			    }
			}

			Maintenance_Schedule_Configuration_Delete_Validate as "Maintenance Schedule Configuration Delete Validation"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                tasks = Maintenance_Task[Schedule == input.ID];
			                if(tasks.count() > 0)
			                {
			                    alert "This schedule has maintenance tasks. Remove dependent tasks manually before deletion.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			}

			Maintenance_Schedule_Configuration_On_Load as "Maintenance Schedule Configuration On Load"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Vendor;
			                disable Vendor_Email;
			                disable Next_Due_Date;
			                if(input.Frequency == "Other")
			                {
			                    show Interval;
			                    enable Interval;
			                }
			                else
			                {
			                    hide Interval;
			                }
			                if(input.Start_Date != null && input.Frequency not in {"", " ", "null"})
			                {
			                    if(input.Frequency == "Weekly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(7);
			                    }
			                    else if(input.Frequency == "Monthly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(1);
			                    }
			                    else if(input.Frequency == "Quarterly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(3);
			                    }
			                    else if(input.Frequency == "Other" && ifnull(input.Interval,0) > 0)
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
			                    }
			                }
			            )
			        }
			    }
			}

			Maintenance_Schedule_Configuration_On_Success as "Maintenance Schedule Configuration On Success"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                earliestSchedules = Maintenance_Schedule_Configuration[Asset == input.Asset && Status == "Active"] sort by Next_Due_Date range from 1 to 1;
			                assetRec = Asset_Master[ID == input.Asset];
			                if(assetRec.count() > 0 && earliestSchedules.count() > 0)
			                {
			                    assetRec.Next_Maintenance_Date = earliestSchedules.Next_Due_Date;
			                }
			                insert into Audit_Log
			                [
			                    Module_Name = "Maintenance"
			                    Source_Form = "Maintenance_Schedule_Configuration"
			                    Source_Record_ID = input.ID
			                    Source_Record_Label = input.Schedule_ID.toString()
			                    Action_Type = "Saved"
			                    New_Status = input.Status
			                    Performed_By_Email = zoho.loginuser
			                    Performed_On = zoho.currenttime
			                    Details = "Maintenance schedule saved and asset next maintenance date refreshed."
			                ]
			            )
			        }
			    }
			}

			Maintenance_Schedule_Configuration_On_Validate as "Maintenance Schedule Configuration On Validate"
			{
			    type = form
			    form = Maintenance_Schedule_Configuration
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                assetRec = Asset_Master[ID == input.Asset];
			                if(assetRec.count() == 0 || assetRec.Status != "Active")
			                {
			                    alert "Select an active asset.";
			                    cancel submit;
			                }
			                employeeRec = FMS_Employee_Master[ID == input.Assigned_To];
			                if(employeeRec.count() == 0 || employeeRec.Status != "Active")
			                {
			                    alert "Select an active FMS employee.";
			                    cancel submit;
			                }
			                if(employeeRec.count() > 0)
			                {
			                    input.Vendor = employeeRec.Vendor;
			                    input.Vendor_Email = employeeRec.Vendor_Email;
			                }
			                if(input.Frequency == "Other" && ifnull(input.Interval,0) <= 0)
			                {
			                    alert "Interval must be greater than zero when frequency is Other.";
			                    cancel submit;
			                }
			                if(input.Start_Date != null && input.Frequency not in {"", " ", "null"})
			                {
			                    if(input.Frequency == "Weekly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(7);
			                    }
			                    else if(input.Frequency == "Monthly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(1);
			                    }
			                    else if(input.Frequency == "Quarterly")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addMonth(3);
			                    }
			                    else if(input.Frequency == "Other")
			                    {
			                        input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
			                    }
			                }
			                if(input.Next_Due_Date < input.Start_Date)
			                {
			                    alert "Next due date cannot be before start date.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

