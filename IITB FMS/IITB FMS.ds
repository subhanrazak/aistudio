		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Warning_Penalty
		{
		    displayname = "Warning / Penalty Form"
		
		    Case_Details
		    (
		        type = section
		        displayname = "Case Details"
		        row = 1
		        column = 0
		    )
		    Warning_ID
		    (
		        type = autonumber
		        displayname = "Warning ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Date
		    (
		        type = date
		        displayname = "Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = User_Master[Role == "Vendor" && Status == "Active"].ID
		        displayformat = [User_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Vendor_Email
		    (
		        type = email
		        displayname = "Vendor Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee
		    (
		        type = picklist
		        displayname = "Employee"
		        values = FMS_Employee_Master[Status == "Active"].ID
		        displayformat = [Employee_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Issue_Type
		    (
		        type = picklist
		        displayname = "Issue Type"
		        values = {"Warning", "Disciplinary"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Warning_Penalty_Type
		    (
		        type = picklist
		        displayname = "Warning / Penalty Type"
		        values = Warning_Penalty_Type_Master[Status == "Active"].ID
		        displayformat = [Type_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Reason_Description
		    (
		        type = textarea
		        displayname = "Reason Description"
		        height = 160px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Action_Acknowledgement
		    (
		        type = section
		        displayname = "Action and Acknowledgement"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Action_Taken_By_FA
		    (
		        type = textarea
		        displayname = "Action Taken By F&A"
		        height = 140px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Action_Taken_Date
		    (
		        type = date
		        displayname = "Action Taken Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    FMS_Acknowledgement_Comment
		    (
		        type = textarea
		        displayname = "FMS Acknowledgement Comment"
		        height = 140px
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Raised", "Pending F&A Action", "Pending FMS Acknowledgement", "Acknowledged", "Cancelled"}
		        initial value = "Raised"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Raised_By_Email
		    (
		        type = email
		        displayname = "Raised By Email"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Warning_Penalty_Type_Master
		{
		    displayname = "Warning / Penalty Type Master"
		
		    Type_Details
		    (
		        type = section
		        displayname = "Type Details"
		        row = 1
		        column = 0
		    )
		    must have Issue_Type
		    (
		        type = picklist
		        displayname = "Issue Type"
		        values = {"Warning", "Disciplinary"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Type_Name
		    (
		        type = text
		        displayname = "Type Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list Asset_Category_Master_List
		{
		    displayName = "Asset Category Master List"
		    show all rows from Asset_Category_Master
		    (
		        Category_Name
		        Description
		        Status
		    )
		    filters
		    (
		        Status
		    )
		    sort by
		    (
		        Category_Name ascending
		    )
		}

		list Asset_Master_List_Infra
		{
		    displayName = "Asset Master List - Infra"
		    show all rows from Asset_Master [Status == "Active"]
		    (
		        Asset_Code
		        Asset_Name
		        Category
		        Location
		        Brand_Model
		        Purchase_Date
		        Warranty_Expiry
		        Next_Maintenance_Date
		        Status
		    )
		    filters
		    (
		        Category
		        Status
		        Next_Maintenance_Date
		    )
		    sort by
		    (
		        Next_Maintenance_Date ascending
		    )
		    conditional formatting
		    (
		        "Maintenance Due Soon"
		        {
		            condition = (Next_Maintenance_Date in next 7 days)
		            fields = [Asset_Code, Asset_Name, Next_Maintenance_Date]
		            format = "background-color:#FFF4CC;color:#8A5A00;font-weight:bold"
		        }
		    )
		}

		list Asset_Reference_List_FMS
		{
		    displayName = "Asset Reference List - FMS"
		    show all rows from Asset_Master [Status == "Active"]
		    (
		        Asset_Code
		        Asset_Name
		        Category
		        Location
		        Brand_Model
		        Next_Maintenance_Date
		        Status
		    )
		    filters
		    (
		        Category
		        Status
		        Next_Maintenance_Date
		    )
		    sort by
		    (
		        Asset_Name ascending
		    )
		}

		list Attendance_Invoice_List_FA
		{
		    displayName = "Attendance Invoice List (F&A)"
		    show all rows from Attendance_Invoice
		    (
		        Invoice_ID
		        Vendor
		        Month
		        Month_Number
		        Year
		        Invoice_Number
		        Invoice_Date
		        Sub_Total
		        Tax
		        Total_Amount
		        Invoice_File
		        Status
		        custom action "Approve"
		        (
		            workflow = WF_Approve_Attendance_Invoice
		            show action for each record = true
		            column header = "Approve"
		            success message = "Attendance invoice approved."
		            condition = (Status == "Pending F&A Validation")
		        )
		        custom action "Reject"
		        (
		            workflow = WF_Reject_Attendance_Invoice
		            show action for each record = true
		            column header = "Reject"
		            success message = "Opening rejection form."
		            condition = (Status == "Pending F&A Validation")
		        )
		    )
		    filters
		    (
		        Vendor
		        Month
		        Year
		        Status
		    )
		    sort by
		    (
		        Status ascending
		        Year descending
		        Month_Number descending
		    )
		    conditional formatting
		    (
		        "Pending F&A Validation"
		        {
		            condition = (Status == "Pending F&A Validation")
		            fields = [Invoice_ID, Vendor, Invoice_Number, Status]
		            format = "background-color:#FFF3CD;color:#664D03"
		        }
		        "Rejected"
		        {
		            condition = (Status == "Rejected")
		            fields = [Invoice_ID, Vendor, Invoice_Number, Status]
		            format = "background-color:#F8D7DA;color:#842029"
		        }
		    )
		}

		list Attendance_Invoice_List_FMS
		{
		    displayName = "Attendance Invoice List (FMS View)"
