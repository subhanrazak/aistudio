Audit_Log_On_Validate as "Audit Log On Validate"
{
    type = form
    form = Audit_Log
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Performed_By_Email in {"", " ", "null"})
                {
                    input.Performed_By_Email = zoho.loginuser;
                }
                if(input.Performed_On == null)
                {
                    input.Performed_On = zoho.currenttime;
                }
            )
        }
    }
}
