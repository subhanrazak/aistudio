form Audit_Log
{
    displayname = "Audit Log"

    Log_Details
    (
        type = section
        displayname = "Log Details"
        row = 1
        column = 0
    )
    Log_ID
    (
        type = autonumber
        displayname = "Log ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Module_Name
    (
        type = picklist
        displayname = "Module Name"
        values = {"Attendance", "Attendance Invoice", "Consumables", "Disciplinary", "Maintenance", "Integration", "Settings"}
        row = 1
        column = 1
        width = medium
    )
    Source_Form
    (
        type = text
        displayname = "Source Form"
        row = 1
        column = 2
        width = medium
    )
    Source_Record_ID
    (
        type = number
        displayname = "Source Record ID"
        row = 1
        column = 1
        width = medium
    )
    Source_Record_Label
    (
        type = text
        displayname = "Source Record Label"
        row = 1
        column = 2
        width = medium
    )
    must have Action_Type
    (
        type = picklist
        displayname = "Action Type"
        values = {"Created", "Uploaded", "Submitted", "Approved", "Rejected", "Cancelled", "Acknowledged", "Status Changed", "API Pull", "Books Push", "Error", "Deleted Blocked"}
        row = 1
        column = 1
        width = medium
    )
    Old_Status
    (
        type = text
        displayname = "Old Status"
        row = 1
        column = 2
        width = medium
    )
    New_Status
    (
        type = text
        displayname = "New Status"
        row = 1
        column = 1
        width = medium
    )

    Actor_Details
    (
        type = section
        displayname = "Actor Details"
        visibility = true
        row = 2
        column = 1
    )
    Performed_By_Email
    (
        type = email
        displayname = "Performed By Email"
        row = 2
        column = 1
        width = medium
    )
    must have Performed_On
    (
        type = datetime
        displayname = "Performed On"
        row = 2
        column = 2
        width = medium
    )
    Details
    (
        type = textarea
        displayname = "Details"
        height = 150px
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
