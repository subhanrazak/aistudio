default list Audit_Log_List
{
    displayName = "Audit Log List"
    show all rows from Audit_Log
    (
        Log_ID
        Module_Name
        Source_Form
        Source_Record_Label
        Action_Type
        Old_Status
        New_Status
        Performed_By_Email
        Performed_On
        Details
    )
    filters
    (
        Module_Name
        Action_Type
        Performed_On
    )
    sort by
    (
        Performed_On descending
    )
}
