report Audit_Log_List
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Log_ID Module_Name Source_Form Action_Type Performed_By_Email Performed_On ) ) )
        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Log_ID Module_Name Source_Form Source_Record_Label Action_Type Old_Status New_Status Performed_By_Email Performed_On Details ) ) )
        menu ( header ( Edit Duplicate Delete ) )
    )
}
