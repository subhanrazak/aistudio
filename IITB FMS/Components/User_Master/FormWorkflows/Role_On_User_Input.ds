Role_On_User_Input as "Role On User Input"
{
    type = form
    form = User_Master
    record event = on add or edit

    on user input of Role
    {
        actions
        {
            custom deluge script
            (
                if(input.Role == "Vendor")
                {
                    show Vendor_Code;
                    show GSTIN;
                    show PAN_Number;
                    show Bank_Account_Number;
                    show IFSC_Code;
                    show Bank_Name;
                    show Branch_Name;
                    show Contact_Person;
                    show Contact_Phone;
                    show Contact_Email;
                    show Billing_Address;
                }
                else
                {
                    hide Vendor_Code;
                    hide GSTIN;
                    hide PAN_Number;
                    hide Bank_Account_Number;
                    hide IFSC_Code;
                    hide Bank_Name;
                    hide Branch_Name;
                    hide Contact_Person;
                    hide Contact_Phone;
                    hide Contact_Email;
                    hide Billing_Address;
                }
            )
        }
    }
}
