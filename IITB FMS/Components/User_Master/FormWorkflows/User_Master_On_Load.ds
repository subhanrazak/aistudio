User_Master_On_Load as "User Master On Load"
{
    type = form
    form = User_Master
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Role != "Vendor")
                {
                    hide Vendor_Code;
                    hide GSTIN;
                    hide PAN_Number;
                    hide Bank_Account_Number;
                    hide IFSC_Code;
                    hide Bank_Name;
                    hide Branch_Name;
                    hide Contact_Person;
                    hide Contact_Phone;
                    hide Contact_Email;
                    hide Billing_Address;
                }
            )
        }
    }
}
