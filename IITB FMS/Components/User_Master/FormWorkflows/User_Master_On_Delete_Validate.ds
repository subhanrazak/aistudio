User_Master_On_Delete_Validate as "User Master Delete Validation"
{
    type = form
    form = User_Master
    record event = on delete

    on validate
    {
        actions
        {
            custom deluge script
            (
                // Dependent-record delete checks are completed after all modules exist.
                // Operational design requires manual dependent cleanup/reassignment before Administrator deletes a user/vendor master record.
            )
        }
    }
}
