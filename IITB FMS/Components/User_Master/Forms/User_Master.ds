form User_Master
{
    displayname = "User Master"

    Basic_Details
    (
        type = section
        displayname = "Basic Details"
        row = 1
        column = 0
    )
    User_ID
    (
        type = autonumber
        displayname = "User ID"
        start index = 1
        row = 1
        column = 1
    )
    must have User_Name
    (
        type = text
        displayname = "User Name"
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 2
        width = medium
    )
    Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
    )
    must have Role
    (
        type = picklist
        displayname = "Role"
        values = {"Vendor", "F&A Team", "Infra Team"}
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    Vendor_Details
    (
        type = section
        displayname = "Vendor Details"
        visibility = true
        row = 2
        column = 1
    )
    Vendor_Code
    (
        type = text
        displayname = "Vendor Code"
        row = 2
        column = 1
        width = medium
    )
    GSTIN
    (
        type = text
        displayname = "GSTIN"
        row = 2
        column = 2
        width = medium
    )
    PAN_Number
    (
        type = text
        displayname = "PAN Number"
        row = 2
        column = 1
        width = medium
    )
    Bank_Account_Number
    (
        type = text
        displayname = "Bank Account Number"
        row = 2
        column = 2
        width = medium
    )
    IFSC_Code
    (
        type = text
        displayname = "IFSC Code"
        row = 2
        column = 1
        width = medium
    )
    Bank_Name
    (
        type = text
        displayname = "Bank Name"
        row = 2
        column = 2
        width = medium
    )
    Branch_Name
    (
        type = text
        displayname = "Branch Name"
        row = 2
        column = 1
        width = medium
    )

    Contact_Details
    (
        type = section
        displayname = "Contact Details"
        visibility = true
        row = 3
        column = 1
    )
    Contact_Person
    (
        type = text
        displayname = "Contact Person"
        row = 3
        column = 1
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 3
        column = 2
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 3
        column = 1
        width = medium
    )
    Billing_Address
    (
        type = textarea
        displayname = "Billing Address"
        height = 100px
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
