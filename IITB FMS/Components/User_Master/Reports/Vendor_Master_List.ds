list Vendor_Master_List
{
    displayName = "Vendor Master List"
    show all rows from User_Master [Role == "Vendor"]
    (
        User_ID
        User_Name
        Vendor_Code
        GSTIN
        Contact_Person
        Contact_Phone
        Status
    )
    filters
    (
        Status
    )
    sort by
    (
        User_Name ascending
    )
}
