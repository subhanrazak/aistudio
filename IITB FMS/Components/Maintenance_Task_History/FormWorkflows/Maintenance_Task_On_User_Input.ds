Maintenance_Task_History_Task_On_User_Input as "Maintenance Task History Task On User Input"
{
    type = form
    form = Maintenance_Task_History
    record event = on add or edit

    on user input of Maintenance_Task
    {
        actions
        {
            custom deluge script
            (
                taskRec = Maintenance_Task[ID == input.Maintenance_Task];
                if(taskRec.count() > 0)
                {
                    input.Vendor_Email = taskRec.Vendor_Email;
                }
            )
        }
    }
}
