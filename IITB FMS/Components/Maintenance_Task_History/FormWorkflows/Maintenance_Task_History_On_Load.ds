Maintenance_Task_History_On_Load as "Maintenance Task History On Load"
{
    type = form
    form = Maintenance_Task_History
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Vendor_Email;
                disable Updated_By_Email;
                disable Updated_On;
            )
        }
    }
}
