form Maintenance_Task_History
{
    displayname = "Maintenance Task History"

    History_Details
    (
        type = section
        displayname = "History Details"
        row = 1
        column = 0
    )
    History_ID
    (
        type = autonumber
        displayname = "History ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Maintenance_Task
    (
        type = picklist
        displayname = "Maintenance Task"
        values = Maintenance_Task.ID
        displayformat = [Task_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor_Email
    (
        type = email
        displayname = "Vendor Email"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Pending", "Submitted", "Approved", "Rejected"}
        row = 1
        column = 1
        width = medium
    )
    Comments
    (
        type = textarea
        displayname = "Comments"
        height = 140px
        row = 1
        column = 2
        width = medium
    )
    Updated_By_Email
    (
        type = email
        displayname = "Updated By Email"
        row = 1
        column = 1
        width = medium
    )
    must have Updated_On
    (
        type = datetime
        displayname = "Updated On"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
