list Maintenance_Task_History_Report
{
    displayName = "Maintenance Task History Report"
    show all rows from Maintenance_Task_History
    (
        History_ID
        Maintenance_Task
        Status
        Comments
        Updated_By_Email
        Updated_On
    )
    filters
    (
        Maintenance_Task
        Status
        Updated_On
    )
    sort by
    (
        Updated_On ascending
    )
}
