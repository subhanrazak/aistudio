Action_Capture_On_Load as "Action Capture On Load"
{
    type = form
    form = Action_Capture
    record event = on add

    on load
    {
        actions
        {
            custom deluge script
            (
                hide Target_Form;
                hide Target_Record_ID;
                hide Action_Taken;
                hide Action_Taken_Date;
                hide Acknowledgement_Comment;
                if(input.Action_Code == "WARNING_FA_ACTION")
                {
                    hide Reason;
                    show Action_Taken;
                    show Action_Taken_Date;
                }
                else if(input.Action_Code == "WARNING_ACKNOWLEDGE")
                {
                    hide Reason;
                    show Acknowledgement_Comment;
                }
                else
                {
                    show Reason;
                }
            )
        }
    }
}
