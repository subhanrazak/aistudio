form Action_Capture
{
    displayname = "Action Capture"
    store data in zc = false

    Action_Details
    (
        type = section
        displayname = "Action Details"
        row = 1
        column = 0
    )
    Action_Context
    (
        type = plaintext
        displayname = "Action Context"
        value = "Capture rejection reasons, F&A action details, or vendor acknowledgement comments from report buttons."
        row = 1
        column = 1
        width = medium
    )
    Target_Form
    (
        type = text
        displayname = "Target Form"
        row = 1
        column = 1
        width = medium
    )
    Target_Record_ID
    (
        type = number
        displayname = "Target Record ID"
        row = 1
        column = 2
        width = medium
    )
    must have Action_Code
    (
        type = picklist
        displayname = "Action Code"
        values = {"ATTENDANCE_REJECT", "ATTENDANCE_INVOICE_REJECT", "CONSUMABLE_INFRA_REJECT", "CONSUMABLE_FA_REJECT", "WARNING_FA_ACTION", "WARNING_ACKNOWLEDGE", "MAINTENANCE_REJECT"}
        row = 1
        column = 1
        width = medium
    )
    Reason
    (
        type = textarea
        displayname = "Reason"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Action_Taken
    (
        type = textarea
        displayname = "Action Taken"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Action_Taken_Date
    (
        type = date
        displayname = "Action Taken Date"
        row = 1
        column = 2
        width = medium
    )
    Acknowledgement_Comment
    (
        type = textarea
        displayname = "Acknowledgement Comment"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        Submit_Action
        (
            type = button
            displayname = "Submit"
        )
        Reset
        (
            type = reset
            displayname = "Reset"
        )
    }
}
