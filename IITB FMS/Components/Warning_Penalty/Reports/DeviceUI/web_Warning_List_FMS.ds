report Warning_List_FMS
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Warning_ID Date Issue_Type Warning_Penalty_Type Reason_Description Action_Taken_By_FA FMS_Acknowledgement_Comment Status "Acknowledge" ) ) )
        menu ( header ( Edit Duplicate Delete "Acknowledge" ) record ( Edit Duplicate Delete "Acknowledge" ) )
