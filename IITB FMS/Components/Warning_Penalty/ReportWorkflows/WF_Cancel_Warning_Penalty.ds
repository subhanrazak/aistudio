WF_Cancel_Warning_Penalty as "Cancel Warning Penalty"
{
    type = functions
    form = Warning_Penalty
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                if(input.Status != "Acknowledged" && input.Status != "Cancelled")
                {
                    oldStatus = input.Status;
                    input.Status = "Cancelled";
                    insert into Audit_Log
                    [
                        Module_Name = "Disciplinary"
                        Source_Form = "Warning_Penalty"
                        Source_Record_ID = input.ID
                        Source_Record_Label = input.Warning_ID.toString()
                        Action_Type = "Cancelled"
                        Old_Status = oldStatus
                        New_Status = "Cancelled"
                        Performed_By_Email = zoho.loginuser
                        Performed_On = zoho.currenttime
                        Details = "Warning / penalty case cancelled."
                    ]
                }
            )
        }
    }
}
