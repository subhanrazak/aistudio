WF_Enter_FA_Action_Warning_Penalty as "Enter F&A Action Warning Penalty"
{
    type = functions
    form = Warning_Penalty
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Action_Capture?Target_Form=Warning_Penalty&Target_Record_ID=" + input.ID + "&Action_Code=WARNING_FA_ACTION", "same window");
            )
        }
    }
}
