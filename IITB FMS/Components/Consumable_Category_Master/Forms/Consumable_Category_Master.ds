form Consumable_Category_Master
{
    displayname = "Consumable Category Master"

    Category_Details
    (
        type = section
        displayname = "Category Details"
        row = 1
        column = 0
    )
    must have unique Category_Name
    (
        type = text
        displayname = "Category Name"
        row = 1
        column = 1
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
