WF_Reject_Attendance_Invoice as "Reject Attendance Invoice"
{
    type = functions
    form = Attendance_Invoice
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Action_Capture?Target_Form=Attendance_Invoice&Target_Record_ID=" + input.ID + "&Action_Code=ATTENDANCE_INVOICE_REJECT", "same window");
            )
        }
    }
}
