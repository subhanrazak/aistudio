form Attendance_Invoice
{
    displayname = "Attendance Invoice"

    Invoice_Details
    (
        type = section
        displayname = "Invoice Details"
        row = 1
        column = 0
    )
    Invoice_ID
    (
        type = autonumber
        displayname = "Invoice ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Attendance_Submission
    (
        type = picklist
        displayname = "Attendance Submission"
        values = Attendance_Submission[Status == "Approved"].ID
        displayformat = [Submission_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = User_Master[Role == "Vendor"].ID
        displayformat = [User_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Vendor_Email
    (
        type = email
        displayname = "Vendor Email"
        row = 1
        column = 1
        width = medium
    )
    Month
    (
        type = picklist
        displayname = "Month"
        values = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
        row = 1
        column = 2
        width = medium
    )
    Month_Number
    (
        type = number
        displayname = "Month Number"
        row = 1
        column = 1
        width = medium
    )
    Year
    (
        type = number
        displayname = "Year"
        row = 1
        column = 2
        width = medium
    )
    must have Invoice_Number
    (
        type = text
        displayname = "Invoice Number"
        row = 1
        column = 1
        width = medium
    )
    must have Invoice_Date
    (
        type = date
        displayname = "Invoice Date"
        row = 1
        column = 2
        width = medium
    )

    Amounts_Status
    (
        type = section
        displayname = "Amounts and Status"
        visibility = true
        row = 2
        column = 1
    )
    must have Sub_Total
    (
        type = INR
        displayname = "Sub Total"
        format = commadotindian
        decimalplace = 2
        maxchar = 12
        row = 2
        column = 1
        width = medium
    )
    must have Tax
    (
        type = INR
        displayname = "Tax"
        format = commadotindian
        decimalplace = 2
        maxchar = 12
        row = 2
        column = 2
        width = medium
    )
    Total_Amount
    (
        type = formula
        displayname = "Total Amount"
        value = Sub_Total + Tax
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    must have Invoice_File
    (
        type = upload file
        displayname = "Invoice File"
        browse = local_drive, google_docs, zoho_docs
        row = 2
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Pending F&A Validation", "Approved", "Rejected"}
        initial value = "Pending F&A Validation"
        row = 2
        column = 1
        width = medium
    )
    Submitted_By_Email
    (
        type = email
        displayname = "Submitted By Email"
        row = 2
        column = 2
        width = medium
    )
    Rejection_Reason
    (
        type = textarea
        displayname = "Rejection Reason"
        height = 120px
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
