report Attendance_Invoice_List_FA
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Invoice_ID Vendor Invoice_Number Total_Amount Status "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) record ( Edit Duplicate Delete "Approve" "Reject" ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Invoice_ID Vendor Month Month_Number Year Invoice_Number Invoice_Date Sub_Total Tax Total_Amount Invoice_File Status "Approve" "Reject" ) ) )
