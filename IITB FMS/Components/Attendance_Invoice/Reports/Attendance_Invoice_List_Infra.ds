list Attendance_Invoice_List_Infra
{
    displayName = "Attendance Invoice List (Infra View)"
    show all rows from Attendance_Invoice
    (
        Invoice_ID
        Vendor
        Month
        Month_Number
        Year
        Invoice_Number
        Invoice_Date
        Total_Amount
        Status
    )
    filters
    (
        Vendor
        Month
        Year
        Status
    )
    sort by
    (
        Year descending
        Month_Number descending
    )
}
