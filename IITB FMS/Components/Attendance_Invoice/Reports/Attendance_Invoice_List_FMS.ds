list Attendance_Invoice_List_FMS
{
    displayName = "Attendance Invoice List (FMS View)"
    show all rows from Attendance_Invoice [Vendor_Email == zoho.loginuser]
    (
        Invoice_ID
        Month
        Month_Number
        Year
        Invoice_Number
        Invoice_Date
        Total_Amount
        Invoice_File
        Status
        Rejection_Reason
    )
    filters
    (
        Month
        Year
        Status
    )
    sort by
    (
        Year descending
        Month_Number descending
    )
}
