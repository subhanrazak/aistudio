Attendance_Submission_On_User_Input as "Attendance Submission On User Input"
{
    type = form
    form = Attendance_Invoice
    record event = on add or edit

    on user input of Attendance_Submission
    {
        actions
        {
            custom deluge script
            (
                submissionRec = Attendance_Submission[ID == input.Attendance_Submission];
                if(submissionRec.count() > 0)
                {
                    input.Vendor = submissionRec.Vendor;
                    input.Vendor_Email = submissionRec.Vendor_Email;
                    input.Month = submissionRec.Month;
                    input.Month_Number = submissionRec.Month_Number;
                    input.Year = submissionRec.Year;
                }
            )
        }
    }
}
