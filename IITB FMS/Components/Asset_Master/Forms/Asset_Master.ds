form Asset_Master
{
    displayname = "Asset Master"

    Asset_Details
    (
        type = section
        displayname = "Asset Details"
        row = 1
        column = 0
    )
    Asset_ID
    (
        type = autonumber
        displayname = "Asset ID"
        start index = 1
        row = 1
        column = 1
    )
    must have unique Asset_Code
    (
        type = text
        displayname = "Asset Code"
        row = 1
        column = 1
        width = medium
    )
    must have Asset_Name
    (
        type = text
        displayname = "Asset Name"
        row = 1
        column = 2
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Asset_Category_Master[Status == "Active"].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Location
    (
        type = text
        displayname = "Location"
        row = 1
        column = 2
        width = medium
    )
    Brand_Model
    (
        type = text
        displayname = "Brand / Model"
        row = 1
        column = 1
        width = medium
    )

    Dates_Status
    (
        type = section
        displayname = "Dates and Status"
        visibility = true
        row = 2
        column = 1
    )
    Purchase_Date
    (
        type = date
        displayname = "Purchase Date"
        row = 2
        column = 1
        width = medium
    )
    Warranty_Expiry
    (
        type = date
        displayname = "Warranty Expiry"
        row = 2
        column = 2
        width = medium
    )
    Next_Maintenance_Date
    (
        type = date
        displayname = "Next Maintenance Date"
        row = 2
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
