list Attendance_Record_Admin_List
{
    displayName = "Attendance Record Admin List"
    show all rows from Attendance_Record
    (
        Record_ID
        Employee
        Biometric_Code
        Vendor
        Date
        In_Time
        Out_Time
        Month
        Year
    )
    filters
    (
        Vendor
        Date
        Month
        Year
    )
    sort by
    (
        Date descending
    )
}
