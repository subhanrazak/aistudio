default list FMS_Employee_Attendance_Data
{
    displayName = "FMS Employee Attendance Data (All Roles)"
    show all rows from Attendance_Record
    (
        Employee
        Vendor
        Date
        In_Time
        Out_Time
        Month
        Year
    )
    filters
    (
        Vendor
        Month
        Year
    )
    sort by
    (
        Date descending
        Employee ascending
    )
}
