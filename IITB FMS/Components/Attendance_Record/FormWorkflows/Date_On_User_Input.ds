Attendance_Record_Date_On_User_Input as "Attendance Record Date On User Input"
{
    type = form
    form = Attendance_Record
    record event = on add or edit

    on user input of Date
    {
        actions
        {
            custom deluge script
            (
                if(input.Date != null)
                {
                    input.Month = input.Date.getMonth();
                    input.Year = input.Date.getYear();
                }
            )
        }
    }
}
