Attendance_Record_On_Load as "Attendance Record On Load"
{
    type = form
    form = Attendance_Record
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Biometric_Code;
                disable Vendor;
                disable Vendor_Email;
                disable Month;
                disable Year;
            )
        }
    }
}
