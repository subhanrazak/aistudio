form Attendance_Record
{
    displayname = "Attendance Record"

    Attendance_Details
    (
        type = section
        displayname = "Attendance Details"
        row = 1
        column = 0
    )
    Record_ID
    (
        type = autonumber
        displayname = "Record ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Employee
    (
        type = picklist
        displayname = "Employee"
        values = FMS_Employee_Master[Status == "Active"].ID
        displayformat = [Employee_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Biometric_Code
    (
        type = text
        displayname = "Biometric Code"
        row = 1
        column = 2
        width = medium
    )
    Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = User_Master[Role == "Vendor"].ID
        displayformat = [User_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor_Email
    (
        type = email
        displayname = "Vendor Email"
        row = 1
        column = 2
        width = medium
    )
    must have Date
    (
        type = date
        displayname = "Date"
        row = 1
        column = 1
        width = medium
    )
    must have In_Time
    (
        type = text
        displayname = "In Time"
        row = 1
        column = 2
        width = medium
    )
    must have Out_Time
    (
        type = text
        displayname = "Out Time"
        row = 1
        column = 1
        width = medium
    )
    Month
    (
        type = number
        displayname = "Month"
        row = 1
        column = 2
        width = medium
    )
    Year
    (
        type = number
        displayname = "Year"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
