form Warning_Penalty_Type_Master
{
    displayname = "Warning / Penalty Type Master"

    Type_Details
    (
        type = section
        displayname = "Type Details"
        row = 1
        column = 0
    )
    must have Issue_Type
    (
        type = picklist
        displayname = "Issue Type"
        values = {"Warning", "Disciplinary"}
        row = 1
        column = 1
        width = medium
    )
    must have Type_Name
    (
        type = text
        displayname = "Type Name"
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
