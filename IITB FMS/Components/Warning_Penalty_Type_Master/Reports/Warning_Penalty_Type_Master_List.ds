default list Warning_Penalty_Type_Master_List
{
    displayName = "Warning / Penalty Type Master List"
    show all rows from Warning_Penalty_Type_Master
    (
        Issue_Type
        Type_Name
        Description
        Status
    )
    filters
    (
        Issue_Type
        Status
    )
    sort by
    (
        Issue_Type ascending
        Type_Name ascending
    )
}
