default list Email_Template_List
{
    displayName = "Email Template List"
    show all rows from Email_Template
    (
        Template_Code
        Template_Name
        Module_Name
        Event_Name
        Content_Type
        Status
    )
    filters
    (
        Module_Name
        Status
    )
    sort by
    (
        Module_Name ascending
        Template_Code ascending
    )
}
