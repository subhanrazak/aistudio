form Email_Template
{
    displayname = "Email Template"

    Template_Guidance
    (
        type = section
        displayname = "Template Guidance"
        row = 1
        column = 0
    )
    Template_Guide
    (
        type = plaintext
        displayname = "Template Guide"
        value = "Use unique Template Code values such as ATTENDANCE_UPLOADED, ATTENDANCE_APPROVED, ATTENDANCE_REJECTED, ATTENDANCE_INVOICE_SUBMITTED, ATTENDANCE_INVOICE_APPROVED, ATTENDANCE_INVOICE_REJECTED, CONSUMABLE_SUBMITTED, CONSUMABLE_INFRA_APPROVED, CONSUMABLE_REJECTED, CONSUMABLE_FA_APPROVED, WARNING_CREATED, DISCIPLINARY_CREATED, DISCIPLINARY_ACTION_TAKEN, WARNING_ACKNOWLEDGED, MAINTENANCE_TASK_CREATED, MAINTENANCE_SUBMITTED, MAINTENANCE_APPROVED, and MAINTENANCE_REJECTED. Use placeholders like ${VendorName}, ${Month}, ${Year}, ${Status}, ${Reason}, ${RecordLink}, ${EmployeeName}, ${AssetName}, ${InvoiceNumber}, and ${Amount}."
        row = 1
        column = 1
        width = medium
    )
    must have unique Template_Code
    (
        type = text
        displayname = "Template Code"
        row = 1
        column = 1
        width = medium
    )

    Template_Details
    (
        type = section
        displayname = "Template Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Template_Name
    (
        type = text
        displayname = "Template Name"
        row = 2
        column = 1
        width = medium
    )
    must have Module_Name
    (
        type = picklist
        displayname = "Module Name"
        values = {"Attendance", "Attendance Invoice", "Consumables", "Disciplinary", "Maintenance", "Integration", "Settings"}
        row = 2
        column = 2
        width = medium
    )
    must have Event_Name
    (
        type = text
        displayname = "Event Name"
        row = 2
        column = 1
        width = medium
    )
    must have Subject
    (
        type = text
        displayname = "Subject"
        row = 2
        column = 2
        width = medium
    )
    must have Body
    (
        type = textarea
        displayname = "Body"
        height = 200px
        row = 2
        column = 1
        width = medium
    )
    must have Content_Type
    (
        type = picklist
        displayname = "Content Type"
        values = {"HTML", "Plain Text"}
        initial value = "HTML"
        row = 2
        column = 2
        width = medium
    )
    CC
    (
        type = text
        displayname = "CC"
        row = 2
        column = 1
        width = medium
    )
    BCC
    (
        type = text
        displayname = "BCC"
        row = 2
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
