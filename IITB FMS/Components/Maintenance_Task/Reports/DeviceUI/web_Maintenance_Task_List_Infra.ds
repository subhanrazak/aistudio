report Maintenance_Task_List_Infra
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Task_ID Asset Assigned_To Frequency Task_Due_Date Status FMS_Comments Maintenance_Report_File Rejection_Remarks "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) record ( Edit Duplicate Delete "Approve" "Reject" ) )
        action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Task_ID
                    Asset
                    Assigned_To
                    Frequency
                    Task_Due_Date
                    Status
                    FMS_Comments
                    Maintenance_Report_File
                    Rejection_Remarks
                    "Approve"
                    "Reject"
                )
            )
        )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) )
    )
}
