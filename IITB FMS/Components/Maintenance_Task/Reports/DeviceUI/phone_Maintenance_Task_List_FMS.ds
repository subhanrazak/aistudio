report Maintenance_Task_List_FMS
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Task_ID Asset Task_Due_Date Status "Edit Report" "Submit Report" ) ) )
        menu ( header ( Edit Duplicate Delete "Edit Report" "Submit Report" ) record ( Edit Duplicate Delete "Edit Report" "Submit Report" ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Task_ID Asset Frequency Task_Due_Date Status FMS_Comments Maintenance_Report_File "Edit Report" "Submit Report" ) ) )
        menu ( header ( Edit Duplicate Delete "Edit Report" "Submit Report" ) )
    )
}
