list Maintenance_Task_All_List
{
    displayName = "Maintenance Task All List"
    show all rows from Maintenance_Task
    (
        Task_ID
        Asset
        Assigned_To
        Vendor
        Task_Due_Date
        Status
    )
    filters
    (
        Vendor
        Status
        Task_Due_Date
    )
    sort by
    (
        Task_Due_Date descending
    )
}
