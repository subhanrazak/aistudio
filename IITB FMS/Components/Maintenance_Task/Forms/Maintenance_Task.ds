form Maintenance_Task
{
    displayname = "Maintenance Task"

    Task_Details
    (
        type = section
        displayname = "Task Details"
        row = 1
        column = 0
    )
    Task_ID
    (
        type = autonumber
        displayname = "Task ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Schedule
    (
        type = picklist
        displayname = "Schedule"
        values = Maintenance_Schedule_Configuration[Status == "Active"].ID
        displayformat = [Schedule_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Asset
    (
        type = picklist
        displayname = "Asset"
        values = Asset_Master[Status == "Active"].ID
        displayformat = [Asset_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Assigned_To
    (
        type = picklist
        displayname = "Assigned To"
        values = FMS_Employee_Master[Status == "Active"].ID
        displayformat = [Employee_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = User_Master[Role == "Vendor" && Status == "Active"].ID
        displayformat = [User_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Vendor_Email
    (
        type = email
        displayname = "Vendor Email"
        row = 1
        column = 1
        width = medium
    )

    Execution_Details
    (
        type = section
        displayname = "Execution Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Task_Due_Date
    (
        type = date
        displayname = "Task Due Date"
        row = 2
        column = 1
        width = medium
    )
    Frequency
    (
        type = picklist
        displayname = "Frequency"
        values = {"Weekly", "Monthly", "Quarterly", "Other"}
        row = 2
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Pending", "Submitted", "Approved", "Rejected"}
        initial value = "Pending"
        row = 2
        column = 1
        width = medium
    )
    FMS_Comments
    (
        type = textarea
        displayname = "FMS Comments"
        height = 140px
        row = 2
        column = 2
        width = medium
    )
    Maintenance_Report_File
    (
        type = upload file
        displayname = "Maintenance Report File"
        browse = local_drive, google_docs, zoho_docs
        row = 2
        column = 1
        width = medium
    )
    Rejection_Remarks
    (
        type = textarea
        displayname = "Rejection Remarks"
        height = 120px
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
