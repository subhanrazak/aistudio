WF_Reject_Maintenance_Task as "Reject Maintenance Task"
{
    type = functions
    form = Maintenance_Task
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Action_Capture?Target_Form=Maintenance_Task&Target_Record_ID=" + input.ID + "&Action_Code=MAINTENANCE_REJECT", "same window");
            )
        }
    }
}
