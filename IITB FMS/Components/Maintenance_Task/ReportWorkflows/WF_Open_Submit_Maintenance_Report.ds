WF_Open_Submit_Maintenance_Report as "Open Submit Maintenance Report"
{
    type = functions
    form = Maintenance_Task
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Maintenance_Task?recLinkID=" + input.ID, "same window");
            )
        }
    }
}
