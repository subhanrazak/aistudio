Maintenance_Task_On_Success as "Maintenance Task On Success"
{
    type = form
    form = Maintenance_Task
    record event = on add

    on success
    {
        actions
        {
            custom deluge script
            (
                insert into Maintenance_Task_History
                [
                    Maintenance_Task = input.ID
                    Vendor_Email = input.Vendor_Email
                    Status = input.Status
                    Comments = "Task created."
                    Updated_By_Email = zoho.loginuser
                    Updated_On = zoho.currenttime
                ]
                insert into Audit_Log
                [
                    Module_Name = "Maintenance"
                    Source_Form = "Maintenance_Task"
                    Source_Record_ID = input.ID
                    Source_Record_Label = input.Task_ID.toString()
                    Action_Type = "Created"
                    New_Status = input.Status
                    Performed_By_Email = zoho.loginuser
                    Performed_On = zoho.currenttime
                    Details = "Maintenance task created."
                ]
            )
        }
    }
}
