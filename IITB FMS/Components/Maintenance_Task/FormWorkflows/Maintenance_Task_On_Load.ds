Maintenance_Task_On_Load as "Maintenance Task On Load"
{
    type = form
    form = Maintenance_Task
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Asset;
                disable Assigned_To;
                disable Vendor;
                disable Vendor_Email;
                disable Task_Due_Date;
                disable Frequency;
                disable Status;
                disable Rejection_Remarks;
            )
        }
    }
}
