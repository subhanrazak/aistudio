default list Consumable_Item_Master_List
{
    displayName = "Consumable Item Master List"
    show all rows from Consumable_Item_Master
    (
        Item_Name
        Category
        Unit
        Unit_Price
        Status
    )
    filters
    (
        Category
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Status ascending
    )
    sort by
    (
        Category ascending
        Item_Name ascending
    )
}
