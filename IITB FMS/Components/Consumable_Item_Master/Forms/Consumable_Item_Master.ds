form Consumable_Item_Master
{
    displayname = "Consumable Item Master"

    Item_Details
    (
        type = section
        displayname = "Item Details"
        row = 1
        column = 0
    )
    must have Item_Name
    (
        type = text
        displayname = "Item Name"
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Consumable_Category_Master[Status == "Active"].ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Unit
    (
        type = text
        displayname = "Unit"
        row = 1
        column = 1
        width = medium
    )
    must have Unit_Price
    (
        type = INR
        displayname = "Unit Price"
        format = commadotindian
        decimalplace = 2
        maxchar = 12
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
