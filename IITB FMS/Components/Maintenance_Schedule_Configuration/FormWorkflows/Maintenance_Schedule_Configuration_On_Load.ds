Maintenance_Schedule_Configuration_On_Load as "Maintenance Schedule Configuration On Load"
{
    type = form
    form = Maintenance_Schedule_Configuration
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Vendor;
                disable Vendor_Email;
                disable Next_Due_Date;
                if(input.Frequency == "Other")
                {
                    show Interval;
                    enable Interval;
                }
                else
                {
                    hide Interval;
                }
                if(input.Start_Date != null && input.Frequency not in {"", " ", "null"})
                {
                    if(input.Frequency == "Weekly")
                    {
                        input.Next_Due_Date = input.Start_Date.addDay(7);
                    }
                    else if(input.Frequency == "Monthly")
                    {
                        input.Next_Due_Date = input.Start_Date.addMonth(1);
                    }
                    else if(input.Frequency == "Quarterly")
                    {
                        input.Next_Due_Date = input.Start_Date.addMonth(3);
                    }
                    else if(input.Frequency == "Other" && ifnull(input.Interval,0) > 0)
                    {
                        input.Next_Due_Date = input.Start_Date.addDay(input.Interval);
                    }
                }
            )
        }
    }
}
