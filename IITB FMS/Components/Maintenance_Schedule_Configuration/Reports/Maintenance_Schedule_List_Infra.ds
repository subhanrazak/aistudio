list Maintenance_Schedule_List_Infra
{
    displayName = "Maintenance Schedule List - Infra"
    show all rows from Maintenance_Schedule_Configuration [Status == "Active"]
    (
        Schedule_ID
        Asset
        Frequency
        Interval
        Assigned_To
        Start_Date
        Next_Due_Date
        Status
    )
    filters
    (
        Asset
        Assigned_To
        Frequency
        Status
        Next_Due_Date
    )
    sort by
    (
        Next_Due_Date ascending
    )
}
