list Attendance_Submission_List_All
{
    displayName = "Attendance Submission List (All)"
    show all rows from Attendance_Submission
    (
        Submission_ID
        Vendor
        Month
        Month_Number
        Year
        Date_of_Submission
        Status
    )
    filters
    (
        Vendor
        Month
        Year
        Status
    )
    sort by
    (
        Year descending
        Month_Number descending
    )
}
