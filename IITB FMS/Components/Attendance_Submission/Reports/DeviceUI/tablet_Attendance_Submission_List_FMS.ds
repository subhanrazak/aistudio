report Attendance_Submission_List_FMS
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Submission_ID Month Year Date_of_Submission Status "Upload" ) ) )
        menu ( header ( Edit Duplicate Delete "Upload" ) record ( Edit Duplicate Delete "Upload" ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Submission_ID Month Month_Number Year Date_of_Submission Status "Upload" ) ) )
        menu ( header ( Edit Duplicate Delete "Upload" ) )
    )
}
