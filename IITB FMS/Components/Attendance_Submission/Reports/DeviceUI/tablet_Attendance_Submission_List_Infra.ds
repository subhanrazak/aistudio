report Attendance_Submission_List_Infra
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Submission_ID Vendor Month Year Status "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) record ( Edit Duplicate Delete "Approve" "Reject" ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Submission_ID Vendor Month Month_Number Year FMS_Attendance_File Infra_Verified_Excel Status "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) )
    )
}
