WF_Reject_Attendance_Submission as "Reject Attendance Submission"
{
    type = functions
    form = Attendance_Submission
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Action_Capture?Target_Form=Attendance_Submission&Target_Record_ID=" + input.ID + "&Action_Code=ATTENDANCE_REJECT", "same window");
            )
        }
    }
}
