WF_Upload_Attendance_File as "Upload Attendance File"
{
    type = functions
    form = Attendance_Submission
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Attendance_Submission?recLinkID=" + input.ID, "same window");
            )
        }
    }
}
