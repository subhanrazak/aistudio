Attendance_Submission_Vendor_On_User_Input as "Attendance Submission Vendor On User Input"
{
    type = form
    form = Attendance_Submission
    record event = on add or edit

    on user input of Vendor
    {
        actions
        {
            custom deluge script
            (
                vendorRec = User_Master[ID == input.Vendor];
                if(vendorRec.count() > 0)
                {
                    input.Vendor_Email = vendorRec.Email;
                }
            )
        }
    }
}
