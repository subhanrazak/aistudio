Attendance_Submission_On_Load as "Attendance Submission On Load"
{
    type = form
    form = Attendance_Submission
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Month_Number;
                disable Vendor_Email;
                disable Submitted_By_Email;
            )
        }
    }
}
