Attendance_Submission_Delete_Validate as "Attendance Submission Delete Validation"
{
    type = form
    form = Attendance_Submission
    record event = on delete

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Status == "Approved")
                {
                    alert "Approved attendance submissions cannot be deleted. Remove dependent records manually and use administrative controls if correction is required.";
                    cancel delete;
                }
            )
        }
    }
}
