WF_Infra_Reject_Consumable_Invoice as "Infra Reject Consumable Invoice"
{
    type = functions
    form = Consumable_Invoice
    execution type = for each record

    on start
    {
        actions
        {
            on click
            (
                openUrl("#Form:Action_Capture?Target_Form=Consumable_Invoice&Target_Record_ID=" + input.ID + "&Action_Code=CONSUMABLE_INFRA_REJECT", "same window");
            )
        }
    }
}
