Consumable_Invoice_On_Load as "Consumable Invoice On Load"
{
    type = form
    form = Consumable_Invoice
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Vendor_Email;
                disable Sub_Total;
                disable Submitted_By_Email;
                disable Submitted_Date;
                disable Status;
            )
        }
    }
}
