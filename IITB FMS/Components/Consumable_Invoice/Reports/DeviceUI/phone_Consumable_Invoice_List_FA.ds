report Consumable_Invoice_List_FA
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Invoice_ID Vendor Consumable_Category Total_Amount Status "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) record ( Edit Duplicate Delete "Approve" "Reject" ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Invoice_ID Vendor Invoice_Number Invoice_Date Consumable_Category Sub_Total Tax Total_Amount Invoice_File Supporting_Documents Status Submitted_Date "Approve" "Reject" ) ) )
        menu ( header ( Edit Duplicate Delete "Approve" "Reject" ) )
    )
}
