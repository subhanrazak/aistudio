list Consumable_Invoice_List_FMS
{
    displayName = "Consumable Invoice List (FMS View)"
    show all rows from Consumable_Invoice [Vendor_Email == zoho.loginuser]
    (
        Invoice_ID
        Invoice_Number
        Invoice_Date
        Consumable_Category
        Total_Amount
        Status
        Submitted_Date
        Rejection_Reason
    )
    filters
    (
        Consumable_Category
        Status
        Submitted_Date
    )
    sort by
    (
        Submitted_Date descending
    )
}
