list Consumable_Invoice_All_List
{
    displayName = "Consumable Invoice All List"
    show all rows from Consumable_Invoice
    (
        Invoice_ID
        Vendor
        Invoice_Number
        Invoice_Date
        Consumable_Category
        Total_Amount
        Status
        Submitted_Date
    )
    filters
    (
        Vendor
        Consumable_Category
        Status
        Submitted_Date
    )
    sort by
    (
        Submitted_Date descending
    )
}
