default list FMS_Employee_Master_List
{
    displayName = "FMS Employee Master List"
    show all rows from FMS_Employee_Master
    (
        Employee_ID
        Employee_Name
        Biometric_Code
        Vendor
        Vendor_Email
        Designation
        Contact_Phone
        Status
    )
    filters
    (
        Vendor
        Status
    )
    sort by
    (
        Vendor ascending
        Employee_Name ascending
    )
}
