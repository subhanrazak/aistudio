report FMS_Employee_Master_List
{
    quickview
    (
        layout ( type = -1 datablock1 ( layout type = -1 fields ( Employee_ID Employee_Name Vendor Vendor_Email Contact_Phone Status ) ) )
        menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) )
        action ( on tap ( View Record ) on long press ( Edit Delete Duplicate View Record ) on left swipe ( Delete ) on right swipe ( Edit ) )
    )
    detailview
    (
        layout ( type = 1 datablock1 ( layout type = -2 fields ( Employee_ID Employee_Name Biometric_Code Vendor Vendor_Email Designation Contact_Phone Status ) ) )
        menu ( header ( Edit Duplicate Delete ) )
    )
}
