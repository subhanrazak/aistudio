form FMS_Employee_Master
{
    displayname = "FMS Employee Master"

    Employee_Details
    (
        type = section
        displayname = "Employee Details"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 1
        row = 1
        column = 1
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        row = 1
        column = 1
        width = medium
    )
    must have unique Biometric_Code
    (
        type = text
        displayname = "Biometric / Employee Code"
        row = 1
        column = 2
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = User_Master[Role == "Vendor" && Status == "Active"].ID
        displayformat = [User_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Vendor_Email
    (
        type = email
        displayname = "Vendor Email"
        row = 1
        column = 2
        width = medium
    )
    must have Designation
    (
        type = text
        displayname = "Designation"
        row = 1
        column = 1
        width = medium
    )
    must have Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 1
        column = 2
        width = medium
    )
    Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
    )
    must have Join_Date
    (
        type = date
        displayname = "Join Date"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Photo
    (
        type = upload file
        displayname = "Photo"
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
