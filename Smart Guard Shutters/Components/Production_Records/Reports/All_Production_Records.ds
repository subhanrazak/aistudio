default list All_Production_Records
{

			displayName = "All Production Records"
			show all rows from Production_Records    
			(
				Production_Code
				Customer_Order
				Order_Line
				Product
				Colour
				Quantity
				Manufacturing_Mode
				Production_Status
				Priority_Sequence
				Manufacturing_Group
				Material_Status
				Powder_Coating_Status
				Linked_PO
			)
			filters
			(
				Customer_Order
				Product
				Colour
				Manufacturing_Mode
				Production_Status
				Manufacturing_Group
				Material_Status
			)
			sort by
			(
				Priority_Sequence ascending
			)
		
}