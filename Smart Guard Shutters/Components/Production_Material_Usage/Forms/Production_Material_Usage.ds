form Production_Material_Usage
{

			displayname = "Production Material Usage"
			Usage_Details
			(
				type = section
				displayname = "Usage Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Production_Record
			(
				type = picklist	
				displayname = "Production Record"
				values  = Production_Records.ID
    			displayformat = [Production_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Material
			(
				type = picklist	
				values  = Material_Master.ID
    			displayformat = [Material_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Estimated_Quantity
			(
				type = decimal
				displayname = "Estimated Quantity"
				decimalplace = 3
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Quantity
			(
				type = decimal
				displayname = "Actual Quantity"
				decimalplace = 3
	 			row = 1
	 			column = 2   
				width = medium
			)
			Unit
			(
				type = picklist	
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Stock_Deducted
			(
    			type = checkbox
				displayname = "Stock Deducted"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}