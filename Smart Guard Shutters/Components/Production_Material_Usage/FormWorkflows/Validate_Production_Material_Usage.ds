Validate_Production_Material_Usage as "Validate Production Material Usage"
{

				type =  form
				form = Production_Material_Usage

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Estimated_Quantity,0) < 0 || ifnull(input.Actual_Quantity,0) < 0)
										{
											alert "Estimated and actual quantities cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}