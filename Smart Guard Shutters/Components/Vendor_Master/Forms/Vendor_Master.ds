form Vendor_Master
{

			displayname = "Vendor Master"
			Vendor_Details
			(
				type = section
				displayname = "Vendor Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Vendor_Code
			(
    			type = autonumber
				displayname = "Vendor Code"
				start index = 1301
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor_Name
			(
    			type = text
				displayname = "Vendor Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor_Type
			(
				type = picklist
				displayname = "Vendor Type"
				maxchar = 100
				values = {"Raw Material","Powder Coating","Finished Product","Service Parts","General"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Contact_Person
			(
    			type = text
				displayname = "Contact Person"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 2   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			GST_or_Tax_Number
			(
    			type = text
				displayname = "GST / Tax Number"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Commercial_Details
			(
				type = section
				displayname = "Commercial Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
			)
			Payment_Terms
			(
    			type = text
				displayname = "Payment Terms"
				maxchar = 150
	 			row = 2
	 			column = 2   
				width = medium
			)
			Lead_Time_Days
			(
				type = number
				displayname = "Lead Time Days"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}