default list All_Vendors
{

			displayName = "All Vendors"
			show all rows from Vendor_Master    
			(
				Vendor_Code
				Vendor_Name
				Vendor_Type
				Contact_Person
				Phone
				Email
				GST_or_Tax_Number
				Lead_Time_Days
				Active
			)
			filters
			(
				Vendor_Type
				Active
			)
			sort by
			(
				Vendor_Name ascending
			)
		
}