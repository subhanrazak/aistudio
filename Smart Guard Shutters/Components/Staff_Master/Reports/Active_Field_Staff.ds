list Active_Field_Staff
{

			displayName = "Active Field Staff"
			show all rows from Staff_Master  [Active == true && Role == "Installation" || Role == "Service" || Role == "Production"]  
			(
				Staff_Code
				Staff_Name
				Role
				User_Email
				Phone
				Active
			)
			filters
			(
				Role
				Active
			)
			sort by
			(
				Staff_Name ascending
			)
		
}