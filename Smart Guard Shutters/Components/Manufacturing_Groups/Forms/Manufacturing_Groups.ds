form Manufacturing_Groups
{

			displayname = "Manufacturing Groups"
			Group_Details
			(
				type = section
				displayname = "Group Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Group_Code
			(
    			type = autonumber
				displayname = "Group Code"
				start index = 1801
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Group_Name
			(
    			type = text
				displayname = "Group Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Suggested_Basis
			(
				type = picklist
				displayname = "Suggested Basis"
				maxchar = 100
				values = {"Product","Colour","Product and Colour","Date","Custom"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Product
			(
				type = picklist	
				values  = Product_Catalogue.ID
    			displayformat = [Product_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Colour
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Planned_Date
			(
    			type = date
				displayname = "Planned Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Group_Status
			(
				type = picklist
				displayname = "Group Status"
				maxchar = 100
				values = {"Open","In Progress","Completed","Cancelled"}
				initial value = "Open"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}