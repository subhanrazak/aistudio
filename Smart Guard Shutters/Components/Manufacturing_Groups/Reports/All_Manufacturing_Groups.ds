default list All_Manufacturing_Groups
{

			displayName = "All Manufacturing Groups"
			show all rows from Manufacturing_Groups    
			(
				Group_Code
				Group_Name
				Suggested_Basis
				Product
				Colour
				Planned_Date
				Group_Status
				Active
			)
			filters
			(
				Suggested_Basis
				Product
				Group_Status
				Active
			)
			sort by
			(
				Planned_Date ascending
			)
		
}