list Orders_Awaiting_Green_Light
{

			displayName = "Orders Awaiting Green Light"
			show all rows from Customer_Orders  [Order_Status == "Awaiting Green Light"]  
			(
				Order_Code
				Zoho_Books_Invoice_Number
				Customer
				Area_or_City
				Invoice_Date
				Order_Placement_Date
				Expected_Delivery_Date
				Requires_Permit
				Permit_Status
				Order_Status
				Total_Amount
			)
			filters
			(
				Customer
				Area_or_City
				Requires_Permit
				Permit_Status
				Order_Status
			)
			sort by
			(
				Order_Placement_Date ascending
			)
		
}