Customer_Order_Customer_Input as "Customer Order Customer Input"
{

				type =  form
				form = Customer_Orders

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											cust = Customer_Master[ID == input.Customer];
											if(cust.count() > 0)
											{
												input.Customer_Name_Snapshot = cust.Customer_Name;
												input.Customer_Phone = cust.Phone;
												input.Customer_Email = cust.Email;
												input.Billing_Address = cust.Billing_Address;
												input.Installation_Address = cust.Installation_Address;
												input.Area_or_City = cust.Area_or_City;
											}
										}
						)
					}
				}

			
}