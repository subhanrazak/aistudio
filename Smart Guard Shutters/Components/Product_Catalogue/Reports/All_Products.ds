default list All_Products
{

			displayName = "All Products"
			show all rows from Product_Catalogue    
			(
				Product_Code
				Product_Name
				Product_Category
				Default_Manufacturing_Mode
				Colour_Required
				Requires_Powder_Coating
				Requires_Permit_By_Default
				Default_Install_Hours
				Default_Unit
				Active
			)
			filters
			(
				Product_Category
				Default_Manufacturing_Mode
				Active
			)
			sort by
			(
				Product_Name ascending
			)
		
}