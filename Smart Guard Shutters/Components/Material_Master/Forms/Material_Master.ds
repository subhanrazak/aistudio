form Material_Master
{

			displayname = "Material Master"
			Material_Details
			(
				type = section
				displayname = "Material Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Material_Code
			(
    			type = autonumber
				displayname = "Material Code"
				start index = 1401
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Material_Name
			(
    			type = text
				displayname = "Material Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Material_Category
			(
				type = picklist
				displayname = "Material Category"
				maxchar = 100
				values = {"Slat","Motor","Guide","Bottom Bar","Bracket","Fastener","Electrical","Service Part","Packaging","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Stock_Unit
			(
				type = picklist	
				displayname = "Stock Unit"
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Default_Vendor
			(
				type = picklist	
				displayname = "Default Vendor"
				values  = Vendor_Master.ID
    			displayformat = [Vendor_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Stock_Details
			(
				type = section
				displayname = "Stock Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Available_Quantity
			(
				type = decimal
				displayname = "Available Quantity"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reorder_Level
			(
				type = decimal
				displayname = "Reorder Level"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Last_Updated
			(
    			type = date
				displayname = "Last Updated"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}