default list All_Product_BOM_Items
{

			displayName = "All Product BOM Items"
			show all rows from Product_BOM_Items    
			(
				BOM_Code
				Product
				Material
				Quantity_Per_Unit
				Unit
				Wastage_Percent
				Active
			)
			filters
			(
				Product
				Material
				Active
			)
			sort by
			(
				Product ascending
			)
		
}