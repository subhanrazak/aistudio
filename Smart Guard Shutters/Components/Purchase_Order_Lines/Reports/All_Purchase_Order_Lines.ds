default list All_Purchase_Order_Lines
{

			displayName = "All Purchase Order Lines"
			show all rows from Purchase_Order_Lines    
			(
				Purchase_Order
				Line_Number
				Line_Type
				Material
				Powder
				Product
				Quantity
				Unit
				Unit_Rate
				Line_Total
				Received_Quantity
				Received_Date
				Stock_Posted
			)
			filters
			(
				Purchase_Order
				Line_Type
				Material
				Powder
				Product
				Stock_Posted
			)
		
}