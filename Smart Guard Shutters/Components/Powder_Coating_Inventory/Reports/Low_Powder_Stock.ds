list Low_Powder_Stock
{

			displayName = "Low Powder Stock"
			show all rows from Powder_Coating_Inventory  [Available_Quantity <= Reorder_Level && Active == true]  
			(
				Powder_Code
				Powder_Name
				Colour_Family
				Vendor
				Stock_Unit
				Available_Quantity
				Reorder_Level
				Active
			)
			filters
			(
				Colour_Family
				Vendor
				Active
			)
			sort by
			(
				Powder_Name ascending
			)
		
}