Update_Powder_Last_Updated as "Update Powder Last Updated"
{

				type =  form
				form = Powder_Coating_Inventory

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Last_Updated == null)
										{
											input.Last_Updated = zoho.currentdate;
										}
						)
					}
				}

			
}