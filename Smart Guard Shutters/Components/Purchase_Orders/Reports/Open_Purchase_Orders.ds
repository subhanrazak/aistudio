list Open_Purchase_Orders
{

			displayName = "Open Purchase Orders"
			show all rows from Purchase_Orders  [PO_Status != "Received" && PO_Status != "Cancelled"]  
			(
				PO_Number
				Vendor
				PO_Date
				Expected_Delivery_Date
				PO_Status
				Requested_By
				Approved_By
				Total_Amount
				Linked_Production
				Linked_Service
			)
			filters
			(
				Vendor
				PO_Status
				Requested_By
			)
			sort by
			(
				PO_Date descending
			)
		
}