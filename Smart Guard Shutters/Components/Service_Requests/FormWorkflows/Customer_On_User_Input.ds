Customer_On_User_Input as "Customer On User Input"
{

				type =  form
				form = Service_Requests

				record event = on add or edit

				on user input of Customer
				{
					actions 
					{
						custom deluge script
						(
											if(input.Customer != null)
										{
											input.Customer_Name = input.Customer.Customer_Name;
											input.Phone = input.Customer.Phone;
											input.Email = input.Customer.Email;
											input.Service_Address.address_line_1 = input.Customer.Installation_Address.address_line_1;
											input.Service_Address.address_line_2 = input.Customer.Installation_Address.address_line_2;
											input.Service_Address.district_city = input.Customer.Installation_Address.district_city;
											input.Service_Address.state_province = input.Customer.Installation_Address.state_province;
											input.Service_Address.postal_Code = input.Customer.Installation_Address.postal_Code;
											input.Service_Address.country = input.Customer.Installation_Address.country;
											input.Service_Address.latitude = input.Customer.Installation_Address.latitude;
											input.Service_Address.longitude = input.Customer.Installation_Address.longitude;
										}
						)
					}
				}

			
}