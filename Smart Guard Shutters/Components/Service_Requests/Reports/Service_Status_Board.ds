kanban Service_Status_Board
{

			displayName = "Service Status Board"
			show all rows from Service_Requests    
			(
				Service_Code
				Customer
				Customer_Name
				Priority
				Service_Status
				Request_Date
				Scheduled_Start
				Technician
				Completion_Date
			)
			filters
			(
				Priority
				Service_Status
				Technician
			)
			sort by
			(
				Request_Date descending
			)
			options
			(
	 			display field = Service_Status
	 			emptycolumn = "No Status"
				sort order  = ascending
				record count  = enable
	 		)
		
}