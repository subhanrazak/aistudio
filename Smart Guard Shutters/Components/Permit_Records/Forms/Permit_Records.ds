form Permit_Records
{

			displayname = "Permit Records"
			Permit_Details
			(
				type = section
				displayname = "Permit Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Permit_Code
			(
    			type = autonumber
				displayname = "Permit Code"
				start index = 2201
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Order
			(
				type = picklist	
				displayname = "Customer Order"
				values  = Customer_Orders.ID
    			displayformat = [Order_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = Customer_Master.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Permit_Required
			(
    			type = checkbox
				displayname = "Permit Required"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Permit_Status
			(
				type = picklist
				displayname = "Permit Status"
				maxchar = 100
				values = {"Required","Preparing","Submitted","Approved","Rejected","Expired","Not Required"}
				initial value = "Required"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Authority_Name
			(
    			type = text
				displayname = "Authority Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Permit_Number
			(
    			type = text
				displayname = "Permit Number"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Permit_Timeline
			(
				type = section
				displayname = "Permit Timeline"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Submitted_Date
			(
    			type = date
				displayname = "Submitted Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Approved_Date
			(
    			type = date
				displayname = "Approved Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Expiry_Date
			(
    			type = date
				displayname = "Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Permit_Documents
			(
    			type = upload file
				displayname = "Permit Documents"
    			file count = 10
				browse = local_drive
	 			row = 2
	 			column = 2   
				width = medium
			)
			Permit_Notes
			(
    			type = textarea
				displayname = "Permit Notes"
				height = 140px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}