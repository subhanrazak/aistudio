.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: #fff; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
a { text-decoration: none; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }
.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }
.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }
.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 840px; }
.zcs-table-wrapper table thead { top: 0; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-quick-action-item { list-style-type: none; }
.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }
.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }
.zcs-nodata-wrapper { min-height: 94px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.purchase-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }
.purchase-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1B2E5F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }
.purchase-hero:after { content: ''; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }
.purchase-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
.purchase-eyebrow { letter-spacing: .08em; opacity: .78; }
.purchase-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }
.purchase-subtitle { max-width: 860px; color: rgba(255,255,255,.82); margin: 0; }
.purchase-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }
.purchase-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
.purchase-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
.purchase-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }
.purchase-kpi-card:before { content: ''; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }
.purchase-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }
.purchase-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }
.purchase-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }
.purchase-kpi-link, .purchase-row-link, .purchase-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }
.purchase-section-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .85fr); gap: 16px; margin-top: 16px; }
.purchase-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.purchase-panel { padding: 18px; }
.purchase-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.purchase-panel-title { margin: 0; font-size: 18px; }
.purchase-note { color: var(--zcs-teritiary-text-color); }
.purchase-action-group { display: flex; flex-wrap: wrap; gap: 6px; }
.purchase-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; line-height: 1.2; }
.purchase-action-submit { --action-color:#B8770D; border-color:#B8770D; color:#B8770D; }
.purchase-action-approve { --action-color:#179E6C; border-color:#179E6C; color:#179E6C; }
.purchase-action-order { --action-color:#2A6FFC; border-color:#2A6FFC; color:#2A6FFC; }
.purchase-action-receive { --action-color:#1094C5; border-color:#1094C5; color:#1094C5; }
.purchase-action-cancel { --action-color:#FE455D; border-color:#FE455D; color:#FE455D; }
.purchase-action:hover { background: color-mix(in srgb, var(--action-color, var(--zcs-theme-brand-color)) 10%, #fff); }
.purchase-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.purchase-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }
.purchase-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }
.purchase-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.purchase-stock-warning { color: #B8770D; }
.purchase-stock-critical { color: #FE455D; }
.purchase-money { font-variant-numeric: tabular-nums; }
.purchase-linked-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
@media (max-width: 1240px) { .purchase-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .purchase-section-grid { grid-template-columns: 1fr; } }
@media (max-width: 900px) { .purchase-two-col { grid-template-columns: 1fr; } .purchase-hero-content { flex-direction: column; } .purchase-hero-meta { width: 100%; box-sizing: border-box; } }
@media (max-width: 640px) { .purchase-home-shell { padding: 12px; } .purchase-hero { padding: 18px; border-radius: 18px; } .purchase-kpi-grid { grid-template-columns: 1fr; } .purchase-panel { padding: 14px; } .purchase-quick-grid { grid-template-columns: 1fr; } .purchase-panel-header { align-items: flex-start; flex-direction: column; } .purchase-responsive-table table, .purchase-responsive-table thead, .purchase-responsive-table tbody, .purchase-responsive-table th, .purchase-responsive-table td, .purchase-responsive-table tr { display: block; min-width: 0; width: 100%; } .purchase-responsive-table thead { display: none; } .purchase-responsive-table tbody tr { border-top: 1px solid var(--zcs-border-color); padding: 10px 0; } .purchase-responsive-table tbody tr:first-child { border-top: none; } .purchase-responsive-table tbody tr td { border-top: none; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 8px; padding: 6px 12px; } .purchase-responsive-table tbody tr td:before { content: attr(data-label); color: var(--zcs-teritiary-text-color); font-size: 12px; font-weight: 600; } .purchase-responsive-table tbody tr td[colspan]:before { content: ''; display:none; } .purchase-action-group { margin-top: 4px; } }
</style>
<div class="purchase-home-shell">
		<section class="purchase-hero">
				<div class="purchase-hero-content">
						<div>
								<div class="purchase-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold">Purchase and stores workspace</div>
								<h1 class="purchase-title zcs-font-bold">Purchase Home</h1>
								<p class="purchase-subtitle zcs-font-15">Stock alerts, PO approvals, ordering, receiving, vendor access, and production or service-linked purchase needs in one mobile-ready view.</p>
						</div>
						<div class="purchase-hero-meta">
								<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Signed in</div>
								<div class="zcs-font-16 zcs-font-semibold zcs-mt-4"><%=zoho.loginuser%></div>
								<div class="zcs-font-12 zcs-mt-4" style="color:rgba(255,255,255,.72);"><%=zoho.currentdate%></div>
						</div>
				</div>
		</section>

		<section class="purchase-kpi-grid">
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#FFECEF;--kpi-color:#FE455D;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=lowMaterialsCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Low raw material stock</div>
								<a class="purchase-kpi-link" href="#Report:Low_Material_Stock">Open alert report</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#FFF6E3;--kpi-color:#B8770D;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline design-palette zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=lowPowdersCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Low powder stock</div>
								<a class="purchase-kpi-link" href="#Report:Low_Powder_Stock">Open powder alerts</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=pendingApprovalsCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Pending PO approvals</div>
								<a class="purchase-kpi-link" href="#Report:Pending_PO_Approvals">Approval queue</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#EAFBF4;--kpi-color:#179E6C;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline shopping-cart-simple zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=openPOsCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Open purchase orders</div>
								<a class="purchase-kpi-link" href="#Report:Open_Purchase_Orders">Open PO report</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#F0ECFF;--kpi-color:#7656D6;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-60 zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=expectedReceivingCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Expected receiving entries</div>
								<a class="purchase-kpi-link" href="#Report:PO_Receiving_Calendar">Receiving calendar</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#EAF7FF;--kpi-color:#1094C5;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline arrows-1-tail-right zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold"><%=purchaseNeedsCount%></div>
								<div class="purchase-kpi-label zcs-font-13">Production/service purchase needs</div>
								<a class="purchase-kpi-link" href="#Report:All_Production_Records">Review source work</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#F8F0EB;--kpi-color:#F4660C;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-money-coins zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold purchase-money"><%=ifnull(openPOValue,0)%></div>
								<div class="purchase-kpi-label zcs-font-13">Open PO total value</div>
								<a class="purchase-kpi-link" href="#Report:All_Purchase_Orders">Financial PO list</a>
						</div>
				</div>
				<div class="purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#EEF1F7;--kpi-color:#5D6372;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc zcs-font-20"></i></div>
								<div class="purchase-kpi-value zcs-font-bold purchase-money"><%=ifnull(pendingPOValue,0)%></div>
								<div class="purchase-kpi-label zcs-font-13">Pending approval value</div>
								<a class="purchase-kpi-link" href="#Report:Pending_PO_Approvals">Approve with comments</a>
						</div>
				</div>
		</section>

		<section class="purchase-section-grid">
				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Pending PO approvals</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Use Add Comments popup links for approval decisions. Financial totals are visible for Purchase Stores users.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:Pending_PO_Approvals">Full approval queue</a>
						</div>
						<div class="purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky">
												<tr>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">PO</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Vendor</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Requested by</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Subtotal / Tax / Total</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Add Comments</th>
												</tr>
										</thead>
										<tbody>
<%
	pendingRows = 0;
	for each  po in Purchase_Orders[PO_Status == "Submitted for Approval"] sort by PO_Date asc
	{
		if(pendingRows < 8)
		{
			pendingRows = pendingRows + 1;
			approveUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + po.ID + "&New_Status=Approved&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			cancelUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + po.ID + "&New_Status=Cancelled&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<tr>
																		<td data-label="PO" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=po.PO_Number%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(po.PO_Date,"PO date pending")%></span></td>
																		<td data-label="Vendor" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(po.Vendor.Vendor_Name,"Vendor pending")%><br><span class="zcs-font-12 zcs-color-tertiary">Expected: <%=ifnull(po.Expected_Delivery_Date,"Not set")%></span></td>
																		<td data-label="Requested by" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(po.Requested_By.Employee_Name,"Not set")%></td>
																		<td data-label="Subtotal / Tax / Total" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right purchase-money"><span class="zcs-font-12 zcs-color-tertiary">Subtotal</span> <%=ifnull(po.Subtotal,0)%><br><span class="zcs-font-12 zcs-color-tertiary">Tax</span> <%=ifnull(po.Tax_Total,0)%><br><strong><%=ifnull(po.Total_Amount,0)%></strong></td>
																		<td data-label="Status" class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><span class="zcs-badge-text zcs-font-12"><%=po.PO_Status%></span></span></td>
																		<td data-label="Add Comments" class="zcs-px-16 zcs-py-10 zcs-box-border"><div class="purchase-action-group"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-approve zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=approveUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span>Approved</span></a><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=cancelUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-simple-remove"></i><span>Cancelled</span></a></div></td>
																</tr>
<%
		}
	}
	if(pendingRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="6">No POs are currently submitted for approval.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
				</div>

				<div class="zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
						<h2 class="purchase-panel-title zcs-font-semibold">Vendor quick links</h2>
						<div class="purchase-quick-grid">
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Form:Vendor_Master?zc_LoadIn=dialog"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-handshake"></i></span><span><strong>Add vendor</strong><br><span class="zcs-font-12 zcs-color-tertiary">Create vendor master</span></span></a>
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Vendors"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-single-03"></i></span><span><strong>All vendors</strong><br><span class="zcs-font-12 zcs-color-tertiary">Contacts and lead times</span></span></a>
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Form:Purchase_Orders?zc_LoadIn=dialog"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline shopping-cart-simple"></i></span><span><strong>Create purchase order</strong><br><span class="zcs-font-12 zcs-color-tertiary">Header and lines</span></span></a>
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Purchase_Order_Lines"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc"></i></span><span><strong>PO lines</strong><br><span class="zcs-font-12 zcs-color-tertiary">Rates, tax, receipts</span></span></a>
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:Low_Material_Stock"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert"></i></span><span><strong>Material alerts</strong><br><span class="zcs-font-12 zcs-color-tertiary">Raw material reorder list</span></span></a>
								<a class="purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:PO_Receiving_Calendar"><span class="purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-60"></i></span><span><strong>Receiving calendar</strong><br><span class="zcs-font-12 zcs-color-tertiary">Expected delivery dates</span></span></a>
						</div>
				</div>
		</section>

		<section class="purchase-two-col">
				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Low raw material stock</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Available quantity is at or below reorder level.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:Low_Material_Stock">All materials</a>
						</div>
						<div class="purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Material</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Available</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Reorder</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Vendor</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Action</th></tr></thead>
										<tbody>
<%
	matRows = 0;
	for each  mat in Material_Master[Available_Quantity <= Reorder_Level && Active == true] sort by Available_Quantity asc
	{
		if(matRows < 8)
		{
			matRows = matRows + 1;
			shortage = ifnull(mat.Reorder_Level,0) - ifnull(mat.Available_Quantity,0);
			%>
<tr><td data-label="Material" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=mat.Material_Name%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(mat.Material_Category,"Category pending")%> \u00B7 <%=ifnull(mat.Stock_Unit.Unit_Name,"Unit pending")%></span></td><td data-label="Available" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-stock-critical"><%=ifnull(mat.Available_Quantity,0)%></td><td data-label="Reorder" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right"><%=ifnull(mat.Reorder_Level,0)%><br><span class="zcs-font-12 zcs-color-tertiary">Need <%=shortage%></span></td><td data-label="Vendor" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(mat.Default_Vendor.Vendor_Name,"Vendor not set")%></td><td data-label="Action" class="zcs-px-16 zcs-py-10 zcs-box-border"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Form:Purchase_Orders?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline shopping-cart-simple"></i><span>Create PO</span></a></td></tr>
<%
		}
	}
	if(matRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No low raw material stock alerts.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
				</div>

				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Low powder stock</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Powder coating inventory at or below reorder level.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:Low_Powder_Stock">All powders</a>
						</div>
						<div class="purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Powder</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Available</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Reorder</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Vendor</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Action</th></tr></thead>
										<tbody>
<%
	powderRows = 0;
	for each  powder in Powder_Coating_Inventory[Available_Quantity <= Reorder_Level && Active == true] sort by Available_Quantity asc
	{
		if(powderRows < 8)
		{
			powderRows = powderRows + 1;
			powderNeed = ifnull(powder.Reorder_Level,0) - ifnull(powder.Available_Quantity,0);
			%>
<tr><td data-label="Powder" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=powder.Powder_Name%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(powder.Colour_Family,"Colour pending")%> \u00B7 <%=ifnull(powder.Stock_Unit.Unit_Name,"Unit pending")%></span></td><td data-label="Available" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-stock-critical"><%=ifnull(powder.Available_Quantity,0)%></td><td data-label="Reorder" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right"><%=ifnull(powder.Reorder_Level,0)%><br><span class="zcs-font-12 zcs-color-tertiary">Need <%=powderNeed%></span></td><td data-label="Vendor" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(powder.Vendor.Vendor_Name,"Vendor not set")%></td><td data-label="Action" class="zcs-px-16 zcs-py-10 zcs-box-border"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Form:Purchase_Orders?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline shopping-cart-simple"></i><span>Create PO</span></a></td></tr>
<%
		}
	}
	if(powderRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No low powder stock alerts.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
				</div>
		</section>

		<section class="purchase-section-grid">
				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Open purchase orders</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Includes draft, approval, ordered, and partially received POs. Status changes are captured through Add Comments.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:Open_Purchase_Orders">Open PO report</a>
						</div>
						<div class="purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">PO</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Vendor / Link</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Expected</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Discount / Tax / Total</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Add Comments</th></tr></thead>
										<tbody>
<%
	openRows = 0;
	for each  opo in Purchase_Orders[PO_Status != "Received" && PO_Status != "Cancelled"] sort by Expected_Delivery_Date asc
	{
		if(openRows < 10)
		{
			openRows = openRows + 1;
			statusClass = "zcs-badge-grey";
			if(opo.PO_Status == "Submitted for Approval")
			{
				statusClass = "zcs-badge-orange";
			}
			else if(opo.PO_Status == "Approved" || opo.PO_Status == "Ordered")
			{
				statusClass = "zcs-badge-blue";
			}
			else if(opo.PO_Status == "Partially Received")
			{
				statusClass = "zcs-badge-yellow";
			}
			submitUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Submitted%20for%20Approval&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			approveUrlO = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Approved&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			orderedUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Ordered&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			partialUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Partially%20Received&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			receivedUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Received&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			cancelUrlO = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + opo.ID + "&New_Status=Cancelled&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<tr><td data-label="PO" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=opo.PO_Number%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(opo.PO_Date,"PO date pending")%></span></td><td data-label="Vendor / Link" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(opo.Vendor.Vendor_Name,"Vendor pending")%><br><span class="zcs-font-12 zcs-color-tertiary">Production: <%=ifnull(opo.Linked_Production.Production_Code,"None")%> \u00B7 Service: <%=ifnull(opo.Linked_Service.Service_Code,"None")%></span></td><td data-label="Expected" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(opo.Expected_Delivery_Date,"Not set")%></td><td data-label="Discount / Tax / Total" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-money"><span class="zcs-font-12 zcs-color-tertiary">Discount</span> <%=ifnull(opo.Discount_Total,0)%><br><span class="zcs-font-12 zcs-color-tertiary">Tax</span> <%=ifnull(opo.Tax_Total,0)%><br><strong><%=ifnull(opo.Total_Amount,0)%></strong></td><td data-label="Status" class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-12"><%=opo.PO_Status%></span></span></td><td data-label="Add Comments" class="zcs-px-16 zcs-py-10 zcs-box-border"><div class="purchase-action-group">
<%
			if(opo.PO_Status == "Draft")
			{
				%>
<a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-submit zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=submitUrl%>">Submitted for Approval</a>
<%
			}
			if(opo.PO_Status == "Submitted for Approval")
			{
				%>
<a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-approve zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=approveUrlO%>">Approved</a>
<%
			}
			if(opo.PO_Status == "Approved")
			{
				%>
<a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=orderedUrl%>">Ordered</a>
<%
			}
			if(opo.PO_Status == "Ordered" || opo.PO_Status == "Partially Received")
			{
				%>
<a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=partialUrl%>">Partially Received</a><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=receivedUrl%>">Received</a>
<%
			}
			%>
<a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=cancelUrlO%>">Cancelled</a></div></td></tr>
<%
		}
	}
	if(openRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="6">No open purchase orders.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
				</div>

				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Expected receiving list</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Receiving calendar view plus near-term ordered or approved PO list.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:PO_Receiving_Calendar">Calendar</a>
						</div>
						<div class="zcs-flex zcs-direction-column zcs-gap-12">
<%
	recvRows = 0;
	for each  recv in Purchase_Orders[PO_Status == "Approved" || PO_Status == "Ordered" || PO_Status == "Partially Received" && Expected_Delivery_Date != null] sort by Expected_Delivery_Date asc
	{
		if(recvRows < 8)
		{
			recvRows = recvRows + 1;
			recvStatusClass = "zcs-badge-blue";
			if(recv.PO_Status == "Partially Received")
			{
				recvStatusClass = "zcs-badge-yellow";
			}
			recvPartialUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + recv.ID + "&New_Status=Partially%20Received&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			recvReceivedUrl = "#Form:Action_Comments?Target_Module=Purchase_Orders&Lookup_ID=" + recv.ID + "&New_Status=Received&Return_Page=Purchase_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<div class="purchase-linked-card"><div class="zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start"><div><strong><%=recv.PO_Number%></strong><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(recv.Vendor.Vendor_Name,"Vendor pending")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Expected: <%=recv.Expected_Delivery_Date%> \u00B7 Total: <span class="purchase-money"><%=ifnull(recv.Total_Amount,0)%></span></div></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=recvStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=recv.PO_Status%></span></span></div><div class="purchase-action-group zcs-mt-10"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=recvPartialUrl%>">Partially Received</a><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=recvReceivedUrl%>">Received</a></div></div>
<%
		}
	}
	if(recvRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No expected receiving dates are pending.</h5></div></div>
<%
	}
	%>
</div>
				</div>
		</section>

		<section class="purchase-two-col">
				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Recently received POs</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Latest received purchase orders and stock posting reference.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:All_Purchase_Orders">All purchase orders</a>
						</div>
						<div class="purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">PO</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Vendor</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Expected date</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Total</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Status</th></tr></thead>
										<tbody>
<%
	receivedRows = 0;
	for each  rpo in Purchase_Orders[PO_Status == "Received"] sort by Expected_Delivery_Date desc
	{
		if(receivedRows < 8)
		{
			receivedRows = receivedRows + 1;
			%>
<tr><td data-label="PO" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=rpo.PO_Number%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(rpo.PO_Date,"PO date pending")%></span></td><td data-label="Vendor" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(rpo.Vendor.Vendor_Name,"Vendor pending")%></td><td data-label="Expected date" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(rpo.Expected_Delivery_Date,"Not set")%></td><td data-label="Total" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-money"><%=ifnull(rpo.Total_Amount,0)%></td><td data-label="Status" class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-12"><%=rpo.PO_Status%></span></span></td></tr>
<%
		}
	}
	if(receivedRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No POs have been marked received yet.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
				</div>

				<div class="purchase-panel zcs-card">
						<div class="purchase-panel-header">
								<div>
										<h2 class="purchase-panel-title zcs-font-semibold">Production and service-linked purchase needs</h2>
										<p class="purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0">Create linked POs from shortage, final-product purchase, and service parts-required records.</p>
								</div>
								<a class="purchase-panel-link" href="#Report:All_Purchase_Orders">PO report</a>
						</div>
						<div class="zcs-flex zcs-direction-column zcs-gap-12">
<%
	needRows = 0;
	for each  prod in Production_Records[Production_Status == "Material Shortage" || Production_Status == "Final Product Purchase" || Material_Status == "Shortage Identified" || Material_Status == "Requested" || Manufacturing_Mode == "Purchase Finished Product" && Production_Status != "Purchased and Received" && Production_Status != "Ready for Installation" && Production_Status != "Cancelled"] sort by Priority_Sequence asc
	{
		if(needRows < 5)
		{
			needRows = needRows + 1;
			createProdPOUrl = "#Form:Purchase_Orders?Linked_Production=" + prod.ID + "&zc_LoadIn=dialog";
			%>
<div class="purchase-linked-card"><div class="zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start"><div><strong>Production <%=prod.Production_Code%></strong><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(prod.Product.Product_Name,"Product pending")%> \u00B7 Qty <%=ifnull(prod.Quantity,0)%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Mode: <%=ifnull(prod.Manufacturing_Mode,"Not set")%> \u00B7 Material: <%=ifnull(prod.Material_Status,"Not checked")%> \u00B7 Linked PO: <%=ifnull(prod.Linked_PO.PO_Number,"None")%></div></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><span class="zcs-badge-text zcs-font-12"><%=prod.Production_Status%></span></span></div><div class="purchase-action-group zcs-mt-10"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=createProdPOUrl%>"><i class="zcs-button-icon zc-li-outline shopping-cart-simple"></i><span>Create linked PO</span></a><a class="zcs-button zcs-primary-outline-button purchase-action zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Report:All_Production_Records"><i class="zcs-button-icon zc-li-outline ui-1-eye-17"></i><span>Production report</span></a></div></div>
<%
		}
	}
	for each  svc in Service_Requests[Service_Status == "Parts Required"] sort by Request_Date asc
	{
		if(needRows < 8)
		{
			needRows = needRows + 1;
			createSvcPOUrl = "#Form:Purchase_Orders?Linked_Service=" + svc.ID + "&zc_LoadIn=dialog";
			%>
<div class="purchase-linked-card"><div class="zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start"><div><strong>Service <%=svc.Service_Code%></strong><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(svc.Customer_Name,"Customer pending")%> \u00B7 <%=ifnull(svc.Priority,"Priority pending")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Request: <%=ifnull(svc.Request_Date,"Not set")%> \u00B7 Linked PO: <%=ifnull(svc.Linked_PO.PO_Number,"None")%></div></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><span class="zcs-badge-text zcs-font-12"><%=svc.Service_Status%></span></span></div><div class="purchase-action-group zcs-mt-10"><a class="zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=createSvcPOUrl%>"><i class="zcs-button-icon zc-li-outline shopping-cart-simple"></i><span>Create linked PO</span></a><a class="zcs-button zcs-primary-outline-button purchase-action zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Report:All_Service_Requests"><i class="zcs-button-icon zc-li-outline ui-1-eye-17"></i><span>Service report</span></a></div></div>
<%
		}
	}
	if(needRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No production or service-linked purchase needs are waiting.</h5></div></div>
<%
	}
	%>
</div>
				</div>
		</section>
</div>