<%
	order_rec = Customer_Orders[ID == input.Order_ID];
	canViewFinancial = false;
	currentProfile = thisapp.permissions.loginUserProfile();
	if(currentProfile == "Administrator" || currentProfile == "Office_Staff" || currentProfile == "Admin")
	{
		canViewFinancial = true;
	}
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
.order-detail-page, .order-detail-page * { box-sizing: border-box; }
.order-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zc-font-family, "Poppins", "Zoho Puvi", Arial, sans-serif); padding: 24px; }
a { text-decoration: none; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-5 { margin-top: .3125rem; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mt-20 { margin-top: 1.25rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-green { color: #179e6c; }
.zcs-red { color: #fe455d; }
.zcs-yellow { color: #b8770d; }
.zcs-l_blue { color: #1094c5; }
.zcs-blue { color: #09598e; }
.zcs-d_blue { color: #1328cd; }
.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }
.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }
.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }
.zcs-fw-button { width: 100%; }
.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0px; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }
.detail-shell { max-width: 1440px; margin: 0 auto; }
.detail-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }
.detail-hero:after { content: ''; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }
.detail-hero-main, .detail-hero-side { position: relative; z-index: 1; }
.detail-hero-main { min-width: 280px; flex: 1 1 520px; }
.detail-hero-side { flex: 0 1 320px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }
.detail-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }
.detail-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }
.detail-hero-subtitle { color: rgba(255,255,255,.78); max-width: 740px; margin: 8px 0 0; }
.detail-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.detail-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }
.detail-action-green { --zcs-button-color: #179E6C; background: #179E6C; }
.detail-action-hold { --zcs-button-color: #F4660C; background: #F4660C; }
.detail-action-cancel { --zcs-button-color: #FE455D; background: #FE455D; }
.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }
.detail-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
.detail-card-body { padding: 18px 20px; }
.detail-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }
.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }
.detail-span-12 { grid-column: span 12; }
.detail-span-8 { grid-column: span 8; }
.detail-span-6 { grid-column: span 6; }
.detail-span-4 { grid-column: span 4; }
.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }
.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }
.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }
.readiness-bar { height: 10px; border-radius: 999px; overflow: hidden; background: #E8ECF5; margin-top: 12px; }
.readiness-fill { height: 100%; background: linear-gradient(90deg, #179E6C, var(--zcs-theme-brand-color)); border-radius: inherit; }
.link-list { display: flex; flex-direction: column; gap: 10px; }
.link-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }
.detail-link:hover, .row-link:hover { text-decoration: underline; }
.production-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.production-card { border: 1px solid var(--zcs-border-color); border-radius: 16px; padding: 14px; background: #FBFCFF; }
.production-meta { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; margin-top: 12px; }
.production-meta div { font-size: 12px; color: var(--zcs-secondary-text-color); }
.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }
.comment-text { white-space: pre-wrap; word-break: break-word; }
.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }
.finance-locked { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; background: var(--zcs-warning-soft); color: #8A5A00; border: 1px solid #FFE0A3; }
.mobile-stack { display: none; }
@media (max-width: 1100px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .production-list { grid-template-columns: 1fr; } }
@media (max-width: 768px) { .order-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .detail-hero { padding: 18px; } .detail-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid, .production-meta { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }
</style>
<div class="order-detail-page">
		<div class="detail-shell">
<%
	if(order_rec.count() == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center" style="min-height:60vh;">
								<div class="zcs-nodata-content zcs-p-20 zcs-box-border detail-card">
										<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Order not found</h5>
										<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">No Customer_Orders record matched Order_ID <%=input.Order_ID%>.</p>
								</div>
						</div>
<%
	}
	else
	{
		productionRecords = Production_Records[Customer_Order == order_rec.ID];
		permitRecords = Permit_Records[Customer_Order == order_rec.ID];
		installationRecords = Installation_Schedules[Customer_Order == order_rec.ID];
		prodCount = productionRecords.count();
		readyCount = Production_Records[Customer_Order == order_rec.ID && Production_Status == "Ready for Installation" || Production_Status == "Purchased and Received"].count();
		shortageCount = Production_Records[Customer_Order == order_rec.ID && Production_Status == "Material Shortage" || Material_Status == "Shortage Identified"].count();
		readinessPct = 0;
		if(prodCount > 0)
		{
			readinessPct = (readyCount * 100) / prodCount;
		}
		orderStatusClass = "zcs-badge-blue";
		if(order_rec.Order_Status == "Completed" || order_rec.Order_Status == "Installed" || order_rec.Order_Status == "Green Light")
		{
			orderStatusClass = "zcs-badge-green";
		}
		else if(order_rec.Order_Status == "Cancelled")
		{
			orderStatusClass = "zcs-badge-grey";
		}
		else if(order_rec.Order_Status == "On Hold" || order_rec.Order_Status == "Material Hold")
		{
			orderStatusClass = "zcs-badge-orange";
		}
		else if(order_rec.Order_Status == "Awaiting Green Light")
		{
			orderStatusClass = "zcs-badge-yellow";
		}
		returnUrl = "%23Page%3AOrder_Detail%3FOrder_ID%3D" + order_rec.ID;
		greenUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + order_rec.ID + "&New_Status=Green%20Light&Return_Page=Order_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
		holdUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + order_rec.ID + "&New_Status=On%20Hold&Return_Page=Order_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
		cancelUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + order_rec.ID + "&New_Status=Cancelled&Return_Page=Order_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
		%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
								<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
										<a href="#Page:Office_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left"></i></a>
										<div class="zcs-ellipsis">
												<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Order Detail</h5>
												<div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=order_rec.Order_Code%> - Invoice <%=ifnull(order_rec.Zoho_Books_Invoice_Number,"Not entered")%></div>
										</div>
								</div>
								<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
										<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Office_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Office Home</span></a>
										<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Admin_Home"><i class="zcs-button-icon zc-li-outline ui-1-home-minimal"></i><span class="zcs-button-text">Admin Home</span></a>
								</div>
						</div>
						<section class="detail-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
								<div class="detail-hero-main">
										<div class="detail-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Mirrored invoice and operations order</div>
										<h1 class="detail-hero-title"><%=ifnull(order_rec.Customer_Name_Snapshot,"Customer pending")%></h1>
										<p class="detail-hero-subtitle">Invoice <%=ifnull(order_rec.Zoho_Books_Invoice_Number,"Not entered")%> is currently <%=order_rec.Order_Status%>. Production, permit, installation, purchasing, and approval comments are shown below.</p>
										<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
												<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=orderStatusClass%>"><span class="zcs-badge-text zcs-font-13"><%=order_rec.Order_Status%></span></span>
												<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13">Permit: <%=order_rec.Permit_Status%></span></span>
										</div>
										<div class="detail-action-group">
												<a class="zcs-button zcs-primary-button detail-action detail-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=greenUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span>Green Light</span></a>
												<a class="zcs-button zcs-primary-button detail-action detail-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=holdUrl%>"><i class="zcs-button-icon zc-li-outline ui-2-time"></i><span>On Hold</span></a>
												<a class="zcs-button zcs-primary-button detail-action detail-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=cancelUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-simple-remove"></i><span>Cancelled</span></a>
										</div>
								</div>
								<div class="detail-hero-side">
										<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Signed in</div>
										<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Profile: <%=currentProfile%></div>
										<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Financial totals: <%=if(canViewFinancial == true,"Visible","Restricted")%></div>
								</div>
						</section>
						<div class="detail-grid">
								<section class="detail-card detail-span-8">
										<div class="detail-card-header">
												<div><h2 class="detail-card-title">Invoice and customer details</h2><p class="detail-card-note">Customer snapshots and copied Zoho Books invoice context.</p></div>
<%
		if(order_rec.Zoho_Books_Invoice_URL != null && order_rec.Zoho_Books_Invoice_URL != "")
		{
			%>
<a class="detail-link zcs-font-13" href="<%=order_rec.Zoho_Books_Invoice_URL%>" target="_blank">Open Books invoice</a>
<%
		}
		%>
</div>
										<div class="detail-card-body">
												<div class="kv-grid">
														<div class="kv"><div class="kv-label">Customer</div><div class="kv-value"><%=ifnull(order_rec.Customer_Name_Snapshot,"Pending")%></div></div>
														<div class="kv"><div class="kv-label">Area or city</div><div class="kv-value"><%=ifnull(order_rec.Area_or_City,"Pending")%></div></div>
														<div class="kv"><div class="kv-label">Phone</div><div class="kv-value"><%=ifnull(order_rec.Customer_Phone,"Not entered")%></div></div>
														<div class="kv"><div class="kv-label">Email</div><div class="kv-value"><%=ifnull(order_rec.Customer_Email,"Not entered")%></div></div>
														<div class="kv"><div class="kv-label">Invoice date</div><div class="kv-value"><%=ifnull(order_rec.Invoice_Date,"Not set")%></div></div>
														<div class="kv"><div class="kv-label">Expected delivery</div><div class="kv-value"><%=ifnull(order_rec.Expected_Delivery_Date,"Not set")%></div></div>
														<div class="kv"><div class="kv-label">Billing address</div><div class="kv-value"><%=ifnull(order_rec.Billing_Address.address_line_1,"Not entered")%> <%=ifnull(order_rec.Billing_Address.address_line_2,"")%><br><%=ifnull(order_rec.Billing_Address.district_city,"")%> <%=ifnull(order_rec.Billing_Address.state_province,"")%> <%=ifnull(order_rec.Billing_Address.postal_Code,"")%></div></div>
														<div class="kv"><div class="kv-label">Installation address</div><div class="kv-value"><%=ifnull(order_rec.Installation_Address.address_line_1,"Not entered")%> <%=ifnull(order_rec.Installation_Address.address_line_2,"")%><br><%=ifnull(order_rec.Installation_Address.district_city,"")%> <%=ifnull(order_rec.Installation_Address.state_province,"")%> <%=ifnull(order_rec.Installation_Address.postal_Code,"")%></div></div>
												</div>
										</div>
								</section>
								<section class="detail-card detail-span-4">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Financial totals</h2><p class="detail-card-note">Visible only to administrator and office profiles.</p></div></div>
										<div class="detail-card-body">
<%
		if(canViewFinancial == true)
		{
			%>
<div class="kv-grid" style="grid-template-columns:1fr;">
																<div class="kv"><div class="kv-label">Subtotal</div><div class="kv-value"><%=ifnull(order_rec.Subtotal,0)%></div></div>
																<div class="kv"><div class="kv-label">Discount</div><div class="kv-value"><%=ifnull(order_rec.Discount_Total,0)%></div></div>
																<div class="kv"><div class="kv-label">Tax</div><div class="kv-value"><%=ifnull(order_rec.Tax_Total,0)%></div></div>
																<div class="kv"><div class="kv-label">Shipping or adjustment</div><div class="kv-value"><%=ifnull(order_rec.Shipping_or_Adjustment,0)%></div></div>
																<div class="kv" style="background:var(--zcs-brand-soft);"><div class="kv-label">Total amount</div><div class="kv-value zcs-font-24 zcs-font-bold"><%=ifnull(order_rec.Total_Amount,0)%></div></div>
														</div>
<%
		}
		else
		{
			%>
<div class="finance-locked"><i class="zc-li-outline ui-1-lock"></i><span>Financial invoice totals are hidden for this profile.</span></div>
<%
		}
		%>
</div>
								</section>
								<section class="detail-card detail-span-12">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Operational readiness</h2><p class="detail-card-note">Production, permit, installation, and purchase linkage at a glance.</p></div></div>
										<div class="detail-card-body">
												<div class="kpi-grid">
														<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline design-2-ungroup"></i></span><div class="kpi-label">Production records</div><div class="kpi-value"><%=prodCount%></div></div>
														<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span><div class="kpi-label">Ready or received</div><div class="kpi-value"><%=readyCount%></div><div class="readiness-bar"><div class="readiness-fill" style="width:<%=readinessPct%>%;"></div></div></div>
														<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline ui-2-alert-circle"></i></span><div class="kpi-label">Material shortages</div><div class="kpi-value"><%=shortageCount%></div></div>
														<div class="kpi"><span class="kpi-icon"><i class="zc-li-outline files-folder-15"></i></span><div class="kpi-label">Permits</div><div class="kpi-value"><%=permitRecords.count()%></div></div>
												</div>
										</div>
								</section>
								<section class="detail-card detail-span-12">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Line items</h2><p class="detail-card-note">Products copied from the mirrored invoice/order.</p></div></div>
										<div class="detail-card-body">
												<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only">
														<table class="zcs-w-full">
																<thead class="zcs-sticky"><tr>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Line</th>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Product</th>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Size and colour</th>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Qty</th>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Mode</th>
																		<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Permit</th>
<%
		if(canViewFinancial == true)
		{
			%>
<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Line total</th>
<%
		}
		%>
</tr></thead>
																<tbody>
<%
		lineRows = 0;
		for each  line in order_rec.Line_Items
		{
			lineRows = lineRows + 1;
			%>
<tr>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(line.Line_Number,lineRows)%></td>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ifnull(line.Product.Product_Name,"Product pending")%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(line.Product_Description,"No description")%></span></td>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(line.Width,0)%> x <%=ifnull(line.Height,0)%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(line.Colour,"Colour not set")%></span></td>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=ifnull(line.Quantity,0)%> <%=ifnull(line.Unit.Unit_Name,"")%></td>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(line.Manufacturing_Mode,"Pending")%><br><span class="zcs-font-12 zcs-color-tertiary">Powder: <%=if(line.Requires_Powder_Coating == true,"Required","Not required")%></span></td>
																				<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=if(line.Permit_Required == true,"Required","Not required")%></td>
<%
			if(canViewFinancial == true)
			{
				%>
<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=ifnull(line.Line_Total,0)%></td>
<%
			}
			%>
</tr>
<%
		}
		if(lineRows == 0)
		{
			colCount = 6;
			if(canViewFinancial == true)
			{
				colCount = 7;
			}
			%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="<%=colCount%>">No line items are attached to this order.</td></tr>
<%
		}
		%>
</tbody>
														</table>
												</div>
												<div class="mobile-stack">
<%
		mobileLineRows = 0;
		for each  mline in order_rec.Line_Items
		{
			mobileLineRows = mobileLineRows + 1;
			%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=ifnull(mline.Product.Product_Name,"Product pending")%></strong><span class="zcs-font-12 zcs-color-tertiary">Line <%=ifnull(mline.Line_Number,mobileLineRows)%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-6"><%=ifnull(mline.Product_Description,"No description")%></div><div class="zcs-font-13 zcs-mt-8">Qty <%=ifnull(mline.Quantity,0)%> <%=ifnull(mline.Unit.Unit_Name,"")%> - <%=ifnull(mline.Colour,"Colour not set")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Mode <%=ifnull(mline.Manufacturing_Mode,"Pending")%> - Permit <%=if(mline.Permit_Required == true,"Required","Not required")%></div>
<%
			if(canViewFinancial == true)
			{
				%>
<div class="zcs-font-14 zcs-font-semibold zcs-mt-8">Line total: <%=ifnull(mline.Line_Total,0)%></div>
<%
			}
			%>
</div>
<%
		}
		if(mobileLineRows == 0)
		{
			%>
<div class="empty-soft">No line items are attached to this order.</div>
<%
		}
		%>
</div>
										</div>
								</section>
								<section class="detail-card detail-span-8">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Production readiness</h2><p class="detail-card-note"><%=readyCount%> of <%=prodCount%> production records are ready or purchased and received.</p></div></div>
										<div class="detail-card-body">
<%
		if(prodCount == 0)
		{
			%>
<div class="empty-soft">No linked Production_Records were found for this order.</div>
<%
		}
		else
		{
			%>
<div class="production-list">
<%
			for each  prod in Production_Records[Customer_Order == order_rec.ID] sort by Priority_Sequence asc
			{
				prodStatusClass = "zcs-badge-blue";
				if(prod.Production_Status == "Ready for Installation" || prod.Production_Status == "Purchased and Received")
				{
					prodStatusClass = "zcs-badge-green";
				}
				else if(prod.Production_Status == "Cancelled")
				{
					prodStatusClass = "zcs-badge-grey";
				}
				else if(prod.Production_Status == "Material Shortage" || prod.Production_Status == "On Hold")
				{
					prodStatusClass = "zcs-badge-orange";
				}
				prodDetailUrl = "#Page:Production_Detail?Production_ID=" + prod.ID;
				%>
<div class="production-card">
																		<div class="zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start">
																				<div><a class="row-link" href="<%=prodDetailUrl%>"><strong><%=prod.Production_Code%></strong></a><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(prod.Product.Product_Name,"Product pending")%> - <%=ifnull(prod.Colour,"Colour not set")%></div></div>
																				<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=prodStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=prod.Production_Status%></span></span>
																		</div>
																		<div class="production-meta"><div>Qty: <%=ifnull(prod.Quantity,0)%> <%=ifnull(prod.Unit.Unit_Name,"")%></div><div>Priority: <%=ifnull(prod.Priority_Sequence,"Not set")%></div><div>Mode: <%=ifnull(prod.Manufacturing_Mode,"Pending")%></div><div>Material: <%=ifnull(prod.Material_Status,"Not checked")%></div><div>Powder: <%=ifnull(prod.Powder_Coating_Status,"Not required")%></div><div>Ready date: <%=ifnull(prod.Ready_For_Installation_Date,"Pending")%></div></div>
																</div>
<%
			}
			%>
</div>
<%
		}
		%>
</div>
								</section>
								<section class="detail-card detail-span-4">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Permit status</h2><p class="detail-card-note">Order permit records and clearance.</p></div></div>
										<div class="detail-card-body">
<%
		if(permitRecords.count() == 0)
		{
			%>
<div class="empty-soft">No linked Permit_Records were found. Order permit status is <%=order_rec.Permit_Status%>.</div>
<%
		}
		else
		{
			%>
<div class="link-list">
<%
			for each  permit in permitRecords
			{
				permitUrl = "#Page:Permit_Detail?Permit_ID=" + permit.ID;
				permitStatusClass = "zcs-badge-blue";
				if(permit.Permit_Status == "Approved" || permit.Permit_Status == "Not Required")
				{
					permitStatusClass = "zcs-badge-green";
				}
				else if(permit.Permit_Status == "Rejected" || permit.Permit_Status == "Expired")
				{
					permitStatusClass = "zcs-badge-red";
				}
				else if(permit.Permit_Status == "Required" || permit.Permit_Status == "Preparing")
				{
					permitStatusClass = "zcs-badge-yellow";
				}
				%>
<div class="link-row"><div><a class="row-link" href="<%=permitUrl%>"><%=permit.Permit_Code%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=ifnull(permit.Authority_Name,"Authority pending")%> - <%=ifnull(permit.Permit_Number,"No number")%></div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=permitStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=permit.Permit_Status%></span></span></div>
<%
			}
			%>
</div>
<%
		}
		%>
</div>
								</section>
								<section class="detail-card detail-span-6">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Installation schedule</h2><p class="detail-card-note">Readiness, schedule, crew lead, and QC status.</p></div></div>
										<div class="detail-card-body">
<%
		if(installationRecords.count() == 0)
		{
			%>
<div class="empty-soft">No linked Installation_Schedules record was found for this order.</div>
<%
		}
		else
		{
			%>
<div class="link-list">
<%
			for each  inst in Installation_Schedules[Customer_Order == order_rec.ID] sort by Priority_Sequence asc
			{
				instUrl = "#Page:Installation_Detail?Installation_ID=" + inst.ID;
				instStatusClass = "zcs-badge-blue";
				if(inst.Installation_Status == "Completed" || inst.Installation_Status == "Installed" || inst.Installation_Status == "Inspection Completed")
				{
					instStatusClass = "zcs-badge-green";
				}
				else if(inst.Installation_Status == "Cancelled")
				{
					instStatusClass = "zcs-badge-grey";
				}
				else if(inst.Installation_Status == "On Hold")
				{
					instStatusClass = "zcs-badge-orange";
				}
				%>
<div class="link-row"><div><a class="row-link" href="<%=instUrl%>"><%=inst.Installation_Code%></a><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(inst.Area_or_City,"Location pending")%> - <%=ifnull(inst.Crew_Lead.Employee_Name,"Crew not assigned")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Forecast <%=ifnull(inst.Forecast_Date,"Not set")%> - Scheduled <%=ifnull(inst.Scheduled_Start,"Not set")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Production <%=inst.Production_Readiness_Status%> - Permit <%=inst.Permit_Clearance_Status%> - QC <%=inst.Internal_QC_Status%></div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=instStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=inst.Installation_Status%></span></span></div>
<%
			}
			%>
</div>
<%
		}
		%>
</div>
								</section>
								<section class="detail-card detail-span-6">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Purchase order links</h2><p class="detail-card-note">POs linked to production records for this order.</p></div></div>
										<div class="detail-card-body">
												<div class="link-list">
<%
		poRows = 0;
		for each  prodPO in productionRecords
		{
			if(prodPO.Linked_PO != null)
			{
				for each  poFromLookup in Purchase_Orders[ID == prodPO.Linked_PO]
				{
					poRows = poRows + 1;
					poUrl = "#Page:Purchase_Order_Detail?PO_ID=" + poFromLookup.ID;
					%>
<div class="link-row"><div><a class="row-link" href="<%=poUrl%>"><%=poFromLookup.PO_Number%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Linked from production <%=prodPO.Production_Code%> - Vendor <%=ifnull(poFromLookup.Vendor.Vendor_Name,"Vendor pending")%></div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12"><%=poFromLookup.PO_Status%></span></span></div>
<%
				}
			}
			for each  linkedPO in Purchase_Orders[Linked_Production == prodPO.ID]
			{
				poRows = poRows + 1;
				linkedPoUrl = "#Page:Purchase_Order_Detail?PO_ID=" + linkedPO.ID;
				%>
<div class="link-row"><div><a class="row-link" href="<%=linkedPoUrl%>"><%=linkedPO.PO_Number%></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Linked production <%=prodPO.Production_Code%> - Vendor <%=ifnull(linkedPO.Vendor.Vendor_Name,"Vendor pending")%></div></div><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12"><%=linkedPO.PO_Status%></span></span></div>
<%
			}
		}
		if(poRows == 0)
		{
			%>
<div class="empty-soft">No linked Purchase_Orders were found from this order's production records.</div>
<%
		}
		%>
</div>
										</div>
								</section>
								<section class="detail-card detail-span-12">
										<div class="detail-card-header"><div><h2 class="detail-card-title">Comment history</h2><p class="detail-card-note">Action_Comments audit trail for the order and linked production, permit, installation, and PO records.</p></div></div>
										<div class="detail-card-body">
												<div class="zcs-timeline-wrapper">
														<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		commentRows = 0;
		for each  comment in Action_Comments[Target_Module == "Customer_Orders" && Lookup_ID == order_rec.ID] sort by Action_Date desc
		{
			commentRows = commentRows + 1;
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=comment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=comment.New_Status%></h6><span class="comment-module">Customer_Orders</span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(comment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=comment.Comments%></p></div></li>
<%
		}
		for each  prodCommentTarget in productionRecords
		{
			for each  prodComment in Action_Comments[Target_Module == "Production_Records" && Lookup_ID == prodCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=prodComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=prodComment.New_Status%></h6><span class="comment-module">Production <%=prodCommentTarget.Production_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(prodComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=prodComment.Comments%></p></div></li>
<%
			}
		}
		for each  permitCommentTarget in permitRecords
		{
			for each  permitComment in Action_Comments[Target_Module == "Permit_Records" && Lookup_ID == permitCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=permitComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=permitComment.New_Status%></h6><span class="comment-module">Permit <%=permitCommentTarget.Permit_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(permitComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=permitComment.Comments%></p></div></li>
<%
			}
		}
		for each  instCommentTarget in installationRecords
		{
			for each  instComment in Action_Comments[Target_Module == "Installation_Schedules" && Lookup_ID == instCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=instComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=instComment.New_Status%></h6><span class="comment-module">Installation <%=instCommentTarget.Installation_Code%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(instComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=instComment.Comments%></p></div></li>
<%
			}
		}
		for each  prodForPOComments in productionRecords
		{
			if(prodForPOComments.Linked_PO != null)
			{
				for each  linkedLookupPOCommentTarget in Purchase_Orders[ID == prodForPOComments.Linked_PO]
				{
					for each  linkedLookupPOComment in Action_Comments[Target_Module == "Purchase_Orders" && Lookup_ID == linkedLookupPOCommentTarget.ID] sort by Action_Date desc
					{
						commentRows = commentRows + 1;
						%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=linkedLookupPOComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=linkedLookupPOComment.New_Status%></h6><span class="comment-module">PO <%=linkedLookupPOCommentTarget.PO_Number%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(linkedLookupPOComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=linkedLookupPOComment.Comments%></p></div></li>
<%
					}
				}
			}
			for each  poCommentTarget in Purchase_Orders[Linked_Production == prodForPOComments.ID]
			{
				for each  poComment in Action_Comments[Target_Module == "Purchase_Orders" && Lookup_ID == poCommentTarget.ID] sort by Action_Date desc
				{
					commentRows = commentRows + 1;
					%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=poComment.Action_Date%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=poComment.New_Status%></h6><span class="comment-module">PO <%=poCommentTarget.PO_Number%></span><span class="zcs-font-14 zcs-color-secondary"><%=ifnull(poComment.Submitted_By,"Unknown")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=poComment.Comments%></p></div></li>
<%
				}
			}
		}
		if(commentRows == 0)
		{
			%>
<li><div class="empty-soft">No Action_Comments have been recorded for this order or its linked operational records.</div></li>
<%
		}
		%>
</ul>
												</div>
										</div>
								</section>
						</div>
<%
	}
	%>
</div>
</div>