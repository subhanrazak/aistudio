.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-10 { padding: .625rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: #fff; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }
.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }
.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }
.zcs-template-card-badge { top: 0; right: 0; background-color: var(--zcs-theme-brand-color); border-bottom-left-radius: 32px; }
.zcs-template-card .zcs-card-footer { background-color: #4C4C4C; display: none; bottom: 0; }
.zcs-template-card:hover .zcs-card-footer { display: flex; }
.zcs-badge { width: auto; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; text-decoration: none; }
.zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs_brand_foreground_color, #fff); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-green { color: #179E6C; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-red { color: #FE455D; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-yellow { color: #B8770D; }
.zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-blue { color: #2A6FFC; }
.zcs-quick-action-item { list-style-type: none; }
.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }
.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }
.zcs-nodata-wrapper { min-height: 94px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
a { text-decoration: none; }
.office-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 32%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }
.office-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1B2E5F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }
.office-hero:after { content: ''; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }
.office-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
.office-eyebrow { letter-spacing: .08em; opacity: .78; }
.office-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }
.office-subtitle { max-width: 820px; color: rgba(255,255,255,.82); margin: 0; }
.office-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 210px; backdrop-filter: blur(10px); }
.office-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
.office-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
.office-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }
.office-kpi-card:before { content: ''; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }
.office-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }
.office-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }
.office-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }
.office-kpi-link, .office-row-link, .office-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }
.office-section-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .85fr); gap: 16px; margin-top: 16px; }
.office-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.office-panel { padding: 18px; }
.office-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.office-panel-title { margin: 0; font-size: 18px; }
.office-status-row { display: grid; grid-template-columns: minmax(160px, .8fr) minmax(0, 1.4fr) 54px; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF1F7; }
.office-status-row:last-child { border-bottom: none; }
.office-progress { height: 8px; background: var(--zcs-brand-soft); overflow: hidden; border-radius: 99px; }
.office-progress-fill { height: inherit; border-radius: inherit; background: var(--bar-color, var(--zcs-theme-brand-color)); min-width: 2px; }
.office-action-group { display: flex; flex-wrap: wrap; gap: 6px; }
.office-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; }
.office-action-hold { background: #FAAE13; color: #fff; }
.office-action-cancel { background: #FE455D; color: #fff; }
.office-action-green { background: #179E6C; color: #fff; }
.office-mobile-card-list { display: none; }
.office-mobile-record { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #fff; }
.office-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.office-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }
.office-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }
.office-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.office-note { color: var(--zcs-teritiary-text-color); }
@media (max-width: 1240px) { .office-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .office-section-grid { grid-template-columns: 1fr; } }
@media (max-width: 900px) { .office-two-col { grid-template-columns: 1fr; } .office-hero-content { flex-direction: column; } .office-hero-meta { width: 100%; box-sizing: border-box; } }
@media (max-width: 640px) { .office-home-shell { padding: 12px; } .office-hero { padding: 18px; border-radius: 18px; } .office-kpi-grid { grid-template-columns: 1fr; } .office-panel { padding: 14px; } .office-quick-grid { grid-template-columns: 1fr; } .office-table-wrap { display: none; } .office-mobile-card-list { display: grid; gap: 10px; } .office-panel-header { align-items: flex-start; flex-direction: column; } .office-status-row { grid-template-columns: 1fr; gap: 6px; } }
</style>
<div class="office-home-shell">
		<section class="office-hero">
				<div class="office-hero-content">
						<div>
								<div class="office-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold">Office workspace</div>
								<h1 class="office-title zcs-font-bold">Office Home</h1>
								<p class="office-subtitle zcs-font-15">Invoice mirror follow-up, green-light decisions, permit monitoring, and customer/order readiness in one mobile-ready workspace.</p>
						</div>
						<div class="office-hero-meta">
								<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Signed in</div>
								<div class="zcs-font-16 zcs-font-semibold zcs-mt-4"><%=zoho.loginuser%></div>
								<div class="zcs-font-12 zcs-mt-4" style="color:rgba(255,255,255,.72);"><%=zoho.currentdate%></div>
						</div>
				</div>
		</section>

		<section class="office-kpi-grid">
				<div class="office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#FFF6E3;--kpi-color:#B8770D;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time zcs-font-20"></i></div>
								<div class="office-kpi-value zcs-font-bold"><%=awaitingGreenCount%></div>
								<div class="office-kpi-label zcs-font-13">Orders awaiting office decision</div>
								<a class="office-kpi-link" href="#Report:Orders_Awaiting_Green_Light">Review queue</a>
						</div>
				</div>
				<div class="office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc zcs-font-20"></i></div>
								<div class="office-kpi-value zcs-font-bold"><%=recentOrdersCount%></div>
								<div class="office-kpi-label zcs-font-13">Mirrored invoices/orders</div>
								<a class="office-kpi-link" href="#Report:All_Customer_Orders">Open orders</a>
						</div>
				</div>
				<div class="office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#F0ECFF;--kpi-color:#7656D6;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-paper zcs-font-20"></i></div>
								<div class="office-kpi-value zcs-font-bold"><%=activePermitsCount%></div>
								<div class="office-kpi-label zcs-font-13">Active permits</div>
								<a class="office-kpi-link" href="#Report:Active_Permits">Permit queue</a>
						</div>
				</div>
				<div class="office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#FFECEF;--kpi-color:#FE455D;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert zcs-font-20"></i></div>
								<div class="office-kpi-value zcs-font-bold"><%=blockedInstallationsCount%></div>
								<div class="office-kpi-label zcs-font-13">Installations blocked</div>
								<a class="office-kpi-link" href="#Report:All_Installation_Schedules">View schedules</a>
						</div>
				</div>
		</section>

		<section class="office-section-grid">
				<div class="office-panel zcs-card">
						<div class="office-panel-header">
								<div>
										<h2 class="office-panel-title zcs-font-semibold">Orders awaiting green light</h2>
										<p class="office-note zcs-font-13 zcs-mt-4 zcs-mb-0">Use Add Comments popup links to set Green Light, On Hold, or Cancelled.</p>
								</div>
								<a class="office-panel-link" href="#Report:Orders_Awaiting_Green_Light">Full queue</a>
						</div>
						<div class="office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky">
												<tr>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Order</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Customer</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Expected</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Amount</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Add Comments</th>
												</tr>
										</thead>
										<tbody>
<%
	greenRows = 0;
	for each  ord in Customer_Orders[Order_Status == "Awaiting Green Light" || Order_Status == "On Hold"] sort by Order_Placement_Date asc
	{
		if(greenRows < 8)
		{
			greenRows = greenRows + 1;
			statusClass = "zcs-badge-yellow";
			if(ord.Order_Status == "On Hold")
			{
				statusClass = "zcs-badge-grey";
			}
			returnUrl = "%23Page%3AOffice_Home";
			greenUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + ord.ID + "&New_Status=Green%20Light&Return_Page=Office_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			holdUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + ord.ID + "&New_Status=On%20Hold&Return_Page=Office_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			cancelUrl = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + ord.ID + "&New_Status=Cancelled&Return_Page=Office_Home&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<tr>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><%=ord.Order_Code%></strong><br><span class="zcs-font-12 zcs-color-tertiary"><%=ord.Zoho_Books_Invoice_Number%></span></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(ord.Customer_Name_Snapshot,"Customer pending")%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(ord.Area_or_City,"Area pending")%></span></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(ord.Expected_Delivery_Date,"Not set")%></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=ifnull(ord.Total_Amount,0)%></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-12"><%=ord.Order_Status%></span></span></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border"><div class="office-action-group"><a class="zcs-button zcs-primary-button office-action office-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=greenUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span>Green Light</span></a><a class="zcs-button zcs-primary-button office-action office-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=holdUrl%>"><i class="zcs-button-icon zc-li-outline ui-2-time"></i><span>On Hold</span></a><a class="zcs-button zcs-primary-button office-action office-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=cancelUrl%>"><i class="zcs-button-icon zc-li-outline ui-1-simple-remove"></i><span>Cancelled</span></a></div></td>
																</tr>
<%
		}
	}
	if(greenRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="6">No orders are waiting for a green-light decision.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
						<div class="office-mobile-card-list">
<%
	greenMobileRows = 0;
	for each  mord in Customer_Orders[Order_Status == "Awaiting Green Light" || Order_Status == "On Hold"] sort by Order_Placement_Date asc
	{
		if(greenMobileRows < 8)
		{
			greenMobileRows = greenMobileRows + 1;
			returnUrlM = "%23Page%3AOffice_Home";
			greenUrlM = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + mord.ID + "&New_Status=Green%20Light&Return_Page=Office_Home&Return_URL=" + returnUrlM + "&zc_LoadIn=dialog";
			holdUrlM = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + mord.ID + "&New_Status=On%20Hold&Return_Page=Office_Home&Return_URL=" + returnUrlM + "&zc_LoadIn=dialog";
			cancelUrlM = "#Form:Action_Comments?Target_Module=Customer_Orders&Lookup_ID=" + mord.ID + "&New_Status=Cancelled&Return_Page=Office_Home&Return_URL=" + returnUrlM + "&zc_LoadIn=dialog";
			%>
<div class="office-mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=mord.Order_Code%></strong><span class="zcs-yellow zcs-font-12"><%=mord.Order_Status%></span></div><div class="zcs-font-13 zcs-color-primary zcs-mt-4"><%=ifnull(mord.Customer_Name_Snapshot,"Customer pending")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Amount: <%=ifnull(mord.Total_Amount,0)%> \u00B7 Expected: <%=ifnull(mord.Expected_Delivery_Date,"Not set")%></div><div class="office-action-group zcs-mt-8"><a class="zcs-button zcs-primary-button office-action office-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=greenUrlM%>">Green Light</a><a class="zcs-button zcs-primary-button office-action office-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=holdUrlM%>">On Hold</a><a class="zcs-button zcs-primary-button office-action office-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=cancelUrlM%>">Cancelled</a></div></div>
<%
		}
	}
	if(greenMobileRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No orders are waiting for a green-light decision.</h5></div></div>
<%
	}
	%>
</div>
				</div>

				<div class="zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
						<h2 class="office-panel-title zcs-font-semibold">Customer and order quick links</h2>
						<div class="office-quick-grid">
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Form:Customer_Master?zc_LoadIn=dialog"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-single-03"></i></span><span><strong>Add customer</strong><br><span class="zcs-font-12 zcs-color-tertiary">Create customer record</span></span></a>
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Form:Customer_Orders?zc_LoadIn=dialog"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc"></i></span><span><strong>Add mirrored order</strong><br><span class="zcs-font-12 zcs-color-tertiary">Manual invoice copy</span></span></a>
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Customers"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-eye-17"></i></span><span><strong>Customers</strong><br><span class="zcs-font-12 zcs-color-tertiary">Search customer master</span></span></a>
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Customer_Orders"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-paper"></i></span><span><strong>Orders and invoices</strong><br><span class="zcs-font-12 zcs-color-tertiary">All mirrored orders</span></span></a>
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:Active_Permits"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert"></i></span><span><strong>Active permits</strong><br><span class="zcs-font-12 zcs-color-tertiary">Monitor permit status</span></span></a>
								<a class="office-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Installation_Schedules"><span class="office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-60"></i></span><span><strong>Installations</strong><br><span class="zcs-font-12 zcs-color-tertiary">Readiness and blockers</span></span></a>
						</div>
				</div>
		</section>

		<section class="office-two-col">
				<div class="office-panel zcs-card">
						<div class="office-panel-header">
								<h2 class="office-panel-title zcs-font-semibold">Recent invoices/orders</h2>
								<a class="office-panel-link" href="#Report:All_Customer_Orders">All orders</a>
						</div>
						<div class="office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky">
												<tr>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Invoice</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Customer</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Date</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Amount</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
												</tr>
										</thead>
										<tbody>
<%
	recentRows = 0;
	for each  recent in Customer_Orders[ID != 0] sort by Order_Placement_Date desc
	{
		if(recentRows < 7)
		{
			recentRows = recentRows + 1;
			rStatusClass = "zcs-badge-theme";
			if(recent.Order_Status == "Awaiting Green Light" || recent.Order_Status == "Material Hold")
			{
				rStatusClass = "zcs-badge-yellow";
			}
			if(recent.Order_Status == "Ready for Installation" || recent.Order_Status == "Installed" || recent.Order_Status == "Completed")
			{
				rStatusClass = "zcs-badge-green";
			}
			if(recent.Order_Status == "Cancelled")
			{
				rStatusClass = "zcs-badge-red";
			}
			%>
<tr>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=recent.Zoho_Books_Invoice_Number%><br><span class="zcs-font-12 zcs-color-tertiary"><%=recent.Order_Code%></span></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(recent.Customer_Name_Snapshot,"Customer pending")%></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(recent.Invoice_Date,recent.Order_Placement_Date)%></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right"><%=ifnull(recent.Total_Amount,0)%></td>
																		<td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=rStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=recent.Order_Status%></span></span></td>
																</tr>
<%
		}
	}
	if(recentRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No mirrored orders have been added yet.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
						<div class="office-mobile-card-list">
<%
	recentMobileRows = 0;
	for each  recentM in Customer_Orders[ID != 0] sort by Order_Placement_Date desc
	{
		if(recentMobileRows < 7)
		{
			recentMobileRows = recentMobileRows + 1;
			%>
<div class="office-mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=recentM.Zoho_Books_Invoice_Number%></strong><span class="zcs-font-12 zcs-color-tertiary"><%=recentM.Order_Status%></span></div><div class="zcs-font-13 zcs-color-primary zcs-mt-4"><%=ifnull(recentM.Customer_Name_Snapshot,"Customer pending")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Amount: <%=ifnull(recentM.Total_Amount,0)%> \u00B7 Date: <%=ifnull(recentM.Invoice_Date,recentM.Order_Placement_Date)%></div></div>
<%
		}
	}
	if(recentMobileRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No mirrored orders have been added yet.</h5></div></div>
<%
	}
	%>
</div>
				</div>

				<div class="office-panel zcs-card">
						<div class="office-panel-header">
								<h2 class="office-panel-title zcs-font-semibold">Active orders by status</h2>
								<a class="office-panel-link" href="#Report:Active_Orders">Active report</a>
						</div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Awaiting Green Light</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#FAAE13;width:<%=awaitingPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusAwaitingCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Green Light</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#179E6C;width:<%=greenPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusGreenCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">In Production</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#2A6FFC;width:<%=productionPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusProductionCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Material Hold</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#F4660C;width:<%=materialHoldPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusMaterialHoldCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Ready for Installation</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#179E6C;width:<%=readyPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusReadyCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Installation Scheduled</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#1094C5;width:<%=scheduledPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusScheduledCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Installed</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#179E6C;width:<%=installedPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusInstalledCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">Inspection Required</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#7656D6;width:<%=inspectionPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusInspectionCount%></div></div>
						<div class="office-status-row"><div class="zcs-font-13 zcs-color-primary">On Hold</div><div class="office-progress"><div class="office-progress-fill" style="--bar-color:#242424;width:<%=onHoldPct%>%;"></div></div><div class="zcs-font-13 zcs-font-semibold zcs-text-right"><%=statusOnHoldCount%></div></div>
				</div>
		</section>

		<section class="office-two-col">
				<div class="office-panel zcs-card">
						<div class="office-panel-header">
								<h2 class="office-panel-title zcs-font-semibold">Active permits</h2>
								<a class="office-panel-link" href="#Report:Active_Permits">All active permits</a>
						</div>
						<div class="office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Permit</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Order</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Authority</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Submitted</th></tr></thead>
										<tbody>
<%
	permitRows = 0;
	for each  permit in Permit_Records[Permit_Status != "Approved" && Permit_Status != "Not Required" && Permit_Status != "Expired"] sort by Submitted_Date desc
	{
		if(permitRows < 6)
		{
			permitRows = permitRows + 1;
			pClass = "zcs-badge-blue";
			if(permit.Permit_Status == "Required" || permit.Permit_Status == "Preparing")
			{
				pClass = "zcs-badge-yellow";
			}
			if(permit.Permit_Status == "Rejected")
			{
				pClass = "zcs-badge-red";
			}
			%>
<tr><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=permit.Permit_Code%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(permit.Permit_Number,"Number pending")%></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=permit.Customer_Order.Order_Code%><br><span class="zcs-font-12 zcs-color-tertiary"><%=permit.Customer.Customer_Name%></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(permit.Authority_Name,"Authority pending")%></td><td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=pClass%>"><span class="zcs-badge-text zcs-font-12"><%=permit.Permit_Status%></span></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(permit.Submitted_Date,"Not submitted")%></td></tr>
<%
		}
	}
	if(permitRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No active permits are blocking office readiness.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
						<div class="office-mobile-card-list">
<%
	permitMobileRows = 0;
	for each  permitM in Permit_Records[Permit_Status != "Approved" && Permit_Status != "Not Required" && Permit_Status != "Expired"] sort by Submitted_Date desc
	{
		if(permitMobileRows < 6)
		{
			permitMobileRows = permitMobileRows + 1;
			%>
<div class="office-mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=permitM.Permit_Code%></strong><span class="zcs-font-12 zcs-color-tertiary"><%=permitM.Permit_Status%></span></div><div class="zcs-font-13 zcs-color-primary zcs-mt-4"><%=permitM.Customer_Order.Order_Code%> \u00B7 <%=permitM.Customer.Customer_Name%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=ifnull(permitM.Authority_Name,"Authority pending")%> \u00B7 Submitted: <%=ifnull(permitM.Submitted_Date,"Not submitted")%></div></div>
<%
		}
	}
	if(permitMobileRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No active permits are blocking office readiness.</h5></div></div>
<%
	}
	%>
</div>
				</div>

				<div class="office-panel zcs-card">
						<div class="office-panel-header">
								<h2 class="office-panel-title zcs-font-semibold">Installations blocked by permit or production</h2>
								<a class="office-panel-link" href="#Report:All_Installation_Schedules">All schedules</a>
						</div>
						<div class="office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Install</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Customer</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Production</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Permit</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Forecast</th></tr></thead>
										<tbody>
<%
	blockRows = 0;
	for each  inst in Installation_Schedules[Permit_Clearance_Status == "Blocked" || Permit_Clearance_Status == "Required" || Permit_Clearance_Status == "Submitted" || Production_Readiness_Status == "Not Ready" || Production_Readiness_Status == "Partially Ready" && Installation_Status != "Completed" && Installation_Status != "Cancelled"] sort by Priority_Sequence asc
	{
		if(blockRows < 6)
		{
			blockRows = blockRows + 1;
			prodClass = "zcs-badge-blue";
			if(inst.Production_Readiness_Status == "Not Ready")
			{
				prodClass = "zcs-badge-red";
			}
			if(inst.Production_Readiness_Status == "Partially Ready")
			{
				prodClass = "zcs-badge-yellow";
			}
			permitClass = "zcs-badge-blue";
			if(inst.Permit_Clearance_Status == "Blocked")
			{
				permitClass = "zcs-badge-red";
			}
			if(inst.Permit_Clearance_Status == "Required" || inst.Permit_Clearance_Status == "Submitted")
			{
				permitClass = "zcs-badge-yellow";
			}
			%>
<tr><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=inst.Installation_Code%><br><span class="zcs-font-12 zcs-color-tertiary"><%=inst.Customer_Order.Order_Code%></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(inst.Customer_Name_Snapshot,inst.Customer.Customer_Name)%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(inst.Area_or_City,"Area pending")%></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=prodClass%>"><span class="zcs-badge-text zcs-font-12"><%=inst.Production_Readiness_Status%></span></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=permitClass%>"><span class="zcs-badge-text zcs-font-12"><%=inst.Permit_Clearance_Status%></span></span></td><td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=ifnull(inst.Forecast_Date,"Not set")%></td></tr>
<%
		}
	}
	if(blockRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No installations are currently blocked by permit or production readiness.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
						<div class="office-mobile-card-list">
<%
	blockMobileRows = 0;
	for each  instM in Installation_Schedules[Permit_Clearance_Status == "Blocked" || Permit_Clearance_Status == "Required" || Permit_Clearance_Status == "Submitted" || Production_Readiness_Status == "Not Ready" || Production_Readiness_Status == "Partially Ready" && Installation_Status != "Completed" && Installation_Status != "Cancelled"] sort by Priority_Sequence asc
	{
		if(blockMobileRows < 6)
		{
			blockMobileRows = blockMobileRows + 1;
			%>
<div class="office-mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><strong><%=instM.Installation_Code%></strong><span class="zcs-font-12 zcs-color-tertiary"><%=instM.Customer_Order.Order_Code%></span></div><div class="zcs-font-13 zcs-color-primary zcs-mt-4"><%=ifnull(instM.Customer_Name_Snapshot,instM.Customer.Customer_Name)%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Production: <%=instM.Production_Readiness_Status%> \u00B7 Permit: <%=instM.Permit_Clearance_Status%></div></div>
<%
		}
	}
	if(blockMobileRows == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center"><div class="zcs-nodata-content zcs-p-20 zcs-box-border"><h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No installations are currently blocked by permit or production readiness.</h5></div></div>
<%
	}
	%>
</div>
				</div>
		</section>
</div>