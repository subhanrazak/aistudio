<%
	awaitingGreenOrders = Customer_Orders[Order_Status == "Awaiting Green Light" || Order_Status == "On Hold"];
	recentOrders = Customer_Orders[ID != 0];
	activePermits = Permit_Records[Permit_Status != "Approved" && Permit_Status != "Not Required" && Permit_Status != "Expired"];
	blockedInstallations = Installation_Schedules[Permit_Clearance_Status == "Blocked" || Permit_Clearance_Status == "Required" || Permit_Clearance_Status == "Submitted" || Production_Readiness_Status == "Not Ready" || Production_Readiness_Status == "Partially Ready" && Installation_Status != "Completed" && Installation_Status != "Cancelled"];
	activeOrders = Customer_Orders[Order_Status != "Completed" && Order_Status != "Cancelled"];
	awaitingGreenCount = awaitingGreenOrders.count();
	recentOrdersCount = recentOrders.count();
	activePermitsCount = activePermits.count();
	blockedInstallationsCount = blockedInstallations.count();
	activeOrdersCount = activeOrders.count();
	statusAwaitingCount = Customer_Orders[Order_Status == "Awaiting Green Light"].count();
	statusGreenCount = Customer_Orders[Order_Status == "Green Light"].count();
	statusProductionCount = Customer_Orders[Order_Status == "In Production"].count();
	statusMaterialHoldCount = Customer_Orders[Order_Status == "Material Hold"].count();
	statusReadyCount = Customer_Orders[Order_Status == "Ready for Installation"].count();
	statusScheduledCount = Customer_Orders[Order_Status == "Installation Scheduled"].count();
	statusInstalledCount = Customer_Orders[Order_Status == "Installed"].count();
	statusInspectionCount = Customer_Orders[Order_Status == "Inspection Required"].count();
	statusOnHoldCount = Customer_Orders[Order_Status == "On Hold"].count();
	awaitingPct = 0;
	greenPct = 0;
	productionPct = 0;
	materialHoldPct = 0;
	readyPct = 0;
	scheduledPct = 0;
	installedPct = 0;
	inspectionPct = 0;
	onHoldPct = 0;
	if(activeOrdersCount > 0)
	{
		awaitingPct = (statusAwaitingCount * 100) / activeOrdersCount;
		greenPct = (statusGreenCount * 100) / activeOrdersCount;
		productionPct = (statusProductionCount * 100) / activeOrdersCount;
		materialHoldPct = (statusMaterialHoldCount * 100) / activeOrdersCount;
		readyPct = (statusReadyCount * 100) / activeOrdersCount;
		scheduledPct = (statusScheduledCount * 100) / activeOrdersCount;
		installedPct = (statusInstalledCount * 100) / activeOrdersCount;
		inspectionPct = (statusInspectionCount * 100) / activeOrdersCount;
		onHoldPct = (statusOnHoldCount * 100) / activeOrdersCount;
	}
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
