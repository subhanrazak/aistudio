<style>
/* ===== zcs-global (once per page) ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; } :root { font-size: 16px; line-height: 1.5; --column-gap: 0px; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; } .zcs-flex { display: flex; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-16 { gap: 1rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-16 { padding: 1rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; } .zcs-m-0 { margin: 0; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-bold { font-weight: 700; } .zcs-font-semibold { font-weight: 600; } .zcs-font-medium { font-weight: 500; } .zcs-font-normal { font-weight: 400; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-tertiary { color: var(--zcs_tertiary_text_color); } .zcs-color-white { color: #FFFFFF; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-box-border { box-sizing: border-box; } .zcs-w-full { width: 100%; } .zcs-no-shrink { flex-shrink: 0; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }

/* ===== KPI Cards ===== */
.hc-kpi-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px;
    box-sizing: border-box;
    background-color: var(--zcs-page-bg-color, #F3F3F4);
}
.hc-kpi-card {
    flex: 1 1 calc(25% - 12px);
    min-width: 180px;
    background-color: var(--zcs-white-color, #FFFFFF);
    border: 1px solid #e7e7ee;
    border-radius: 12px;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.hc-kpi-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.hc-kpi-icon-wrap.blue  { background-color: #E8F1FB; }
.hc-kpi-icon-wrap.green { background-color: #E6F7F0; }
.hc-kpi-icon-wrap.red   { background-color: #FDECEA; }
.hc-kpi-icon-wrap.orange{ background-color: #FEF3E6; }
.hc-kpi-icon-wrap i { font-size: 20px; font-style: normal; }
.hc-kpi-icon-wrap.blue  i { color: #1565C0; }
.hc-kpi-icon-wrap.green i { color: #179E6C; }
.hc-kpi-icon-wrap.red   i { color: #FE455D; }
.hc-kpi-icon-wrap.orange i { color: #E07B00; }
.hc-kpi-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--zcs_secondary_text_color, #6B7280);
    line-height: 1.4;
    margin: 0;
}
.hc-kpi-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--zcs_primary_text_color, #1a1a2e);
    line-height: 1.2;
    margin: 0;
}
.hc-kpi-sub {
    font-size: 0.75rem;
    color: var(--zcs_tertiary_text_color, #9CA3AF);
    margin: 0;
}
.hc-kpi-header {
    padding: 16px 16px 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.hc-kpi-header h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--zcs_primary_text_color, #1a1a2e);
    margin: 0;
}
</style>

<%
  todayDate = zoho.currentdate;
  sevenDaysAgo = todayDate.subDay(6);

  calcRecords = Headcount_Calculator[Calc_Date >= sevenDaysAgo && Calc_Date <= todayDate];
  totalRequiredHC = calcRecords.sum(Required_HC_Rounded);
  avgUtilisation = calcRecords.avg(Utilisation_Percent);
  avgGap = calcRecords.avg(Gap);

  actualRecords = HC_Actual_Entry[Entry_Date == todayDate];
  totalPresentHC = actualRecords.sum(Present_Count);

  if(totalRequiredHC == null) { totalRequiredHC = 0; }
  if(totalPresentHC == null) { totalPresentHC = 0; }
  if(avgGap == null) { avgGap = 0; }
  if(avgUtilisation == null) { avgUtilisation = 0; }

  avgGapDisplay = avgGap.round(1);
  avgUtilDisplay = avgUtilisation.round(1);
%>

<div class="hc-kpi-header">
  <i class="zc-li-outline ui-1-bar-chart-stats-up" style="font-size:18px;color:var(--zcs_brand_color);"></i>
  <h2>Headcount KPIs — Last 7 Days</h2>
</div>

<div class="hc-kpi-row">

  <div class="hc-kpi-card">
    <div class="hc-kpi-icon-wrap blue">
      <i class="zc-li-outline users-wm-man-woman"></i>
    </div>
    <p class="hc-kpi-label">Total Required HC</p>
    <p class="hc-kpi-value"><%= totalRequiredHC %></p>
    <p class="hc-kpi-sub">Sum over last 7 days</p>
  </div>

  <div class="hc-kpi-card">
    <div class="hc-kpi-icon-wrap green">
      <i class="zc-li-outline ui-1-check-circle-08"></i>
    </div>
    <p class="hc-kpi-label">Total Present HC</p>
    <p class="hc-kpi-value"><%= totalPresentHC %></p>
    <p class="hc-kpi-sub">Actual entries for today</p>
  </div>

  <div class="hc-kpi-card">
    <div class="hc-kpi-icon-wrap red">
      <i class="zc-li-outline ui-2-alert-circle"></i>
    </div>
    <p class="hc-kpi-label">Average Gap</p>
    <p class="hc-kpi-value"><%= avgGapDisplay %></p>
    <p class="hc-kpi-sub">Avg HC gap over last 7 days</p>
  </div>

  <div class="hc-kpi-card">
    <div class="hc-kpi-icon-wrap orange">
      <i class="zc-li-outline ui-2-time"></i>
    </div>
    <p class="hc-kpi-label">Avg Utilisation %</p>
    <p class="hc-kpi-value"><%= avgUtilDisplay %>%</p>
    <p class="hc-kpi-sub">Avg utilisation over last 7 days</p>
  </div>

</div>
