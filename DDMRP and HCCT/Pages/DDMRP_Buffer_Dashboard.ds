<page linkname = "DDMRP_Buffer_Dashboard" displayname = "DDMRP Buffer Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Buffer_KPI_Cards' elementName='Buffer_KPI_Cards'>
          <![CDATA[htmlpage Buffer_KPI_Cards()
             content
             <%{%>
                 <file name:Buffer_KPI_Cards.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Buffer_RAG_Table' elementName='Buffer_RAG_Table'>
          <![CDATA[htmlpage Buffer_RAG_Table()
             content
             <%{%>
                 <file name:Buffer_RAG_Table.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:RED_Parts_Panel.ds/>
      </column>
      <column width='50%'>
        <file name:Supply_Alerts_Panel.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:NFP_Trend_Panel.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
