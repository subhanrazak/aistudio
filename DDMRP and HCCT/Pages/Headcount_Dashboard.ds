<page linkname = "Headcount_Dashboard" displayname = "Headcount Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='HC_KPI_Cards' elementName='HC_KPI_Cards'>
          <![CDATA[htmlpage HC_KPI_Cards()
            content
            <%{%>
                <file name:HC_KPI_Cards.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:HC_Dept_Chart.ds/>
      </column>
      <column width='50%'>
        <file name:HC_Shift_Summary.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='HC_Alert_Panel' elementName='HC_Alert_Panel'>
          <![CDATA[htmlpage HC_Alert_Panel()
            content
            <%{%>
                <file name:HC_Alert_Panel.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:HC_Weekly_Trend.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
