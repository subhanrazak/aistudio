"Supply_Planner"
{
    name        = "Supply_Planner"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Full access to DDMRP module: create/edit decoupling points, buffer profiles, view all reports"

    ModulePermissions
    {
        Employee_Master
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Employees={"View"}
                Employees_By_Department={"View"}
            }
        }
        Production_Plan
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Production_Plans={"View"}
                Weekly_Production_Plans={"View"}
            }
        }
        Shift_Configuration
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Shifts={"View"}
            }
        }
        Headcount_Calculator
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                HC_Summary={"View"}
                HC_Gap_Alert_Log={"View"}
                Shift_Utilisation_Summary={"View"}
            }
        }
        HC_Actual_Entry
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_HC_Actual={"View"}
                Department_HC_Actual={"View"}
            }
        }
        Part_SKU_Master
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Parts={"View","Edit","Delete"}
                Active_Parts={"View","Edit","Delete"}
            }
        }
        Decoupling_Point_Master
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Decoupling_Points={"View","Edit","Delete"}
                Active_Decoupling_Points={"View","Edit","Delete"}
            }
        }
        Buffer_Profile_Levels
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Buffer_Profiles={"View","Edit","Delete"}
            }
        }
        Daily_Stock_Snapshot
        {
            enabled          = Create,Viewall,Modifyall,Import,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Stock_Snapshots={"View","Edit","Delete"}
                Latest_Stock_Snapshots={"View","Edit","Delete"}
            }
        }
        NFP_Status_Log
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_NFP_Status={"View","Edit","Delete"}
                Parts_In_RED={"View","Edit","Delete"}
                NFP_Trend={"View","Edit","Delete"}
            }
        }
        Supply_Alert_Log
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supply_Alerts={"View","Edit","Delete"}
                Unacknowledged_Alerts={"View","Edit","Delete"}
                ADU_History={"View","Edit","Delete"}
            }
        }
        Headcount_Dashboard
        {
            enabled = tab
        }
        DDMRP_Buffer_Dashboard
        {
            enabled = tab
        }
    }
}
