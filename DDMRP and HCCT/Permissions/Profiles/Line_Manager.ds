"Line_Manager"
{
    name        = "Line_Manager"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Create/Edit HC Actual Entry; View own department reports"

    ModulePermissions
    {
        Employee_Master
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Employees={"View"}
                Employees_By_Department={"View"}
            }
        }
        Production_Plan
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Production_Plans={"View"}
                Weekly_Production_Plans={"View"}
            }
        }
        Shift_Configuration
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Shifts={"View"}
            }
        }
        Headcount_Calculator
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                HC_Summary={"View"}
                HC_Gap_Alert_Log={"View"}
                Shift_Utilisation_Summary={"View"}
            }
        }
        HC_Actual_Entry
        {
            enabled          = Create,Viewall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_HC_Actual={"View","Edit"}
                Department_HC_Actual={"View","Edit"}
            }
        }
        Part_SKU_Master
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Parts={"View"}
                Active_Parts={"View"}
            }
        }
        Decoupling_Point_Master
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Decoupling_Points={"View"}
                Active_Decoupling_Points={"View"}
            }
        }
        Buffer_Profile_Levels
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Buffer_Profiles={"View"}
            }
        }
        Daily_Stock_Snapshot
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Stock_Snapshots={"View"}
                Latest_Stock_Snapshots={"View"}
            }
        }
        NFP_Status_Log
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_NFP_Status={"View"}
                Parts_In_RED={"View"}
                NFP_Trend={"View"}
            }
        }
        Supply_Alert_Log
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supply_Alerts={"View"}
                Unacknowledged_Alerts={"View"}
                ADU_History={"View"}
            }
        }
        Headcount_Dashboard
        {
            enabled = tab
        }
        DDMRP_Buffer_Dashboard
        {
            enabled = tab
        }
    }
}
