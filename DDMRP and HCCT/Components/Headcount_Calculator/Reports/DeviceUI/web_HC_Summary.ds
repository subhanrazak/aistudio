report HC_Summary
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Calc_Date
                    Department
                    Shift
                    Required_HC_Rounded
                    Gap
                    Utilisation_Percent
                    Alert_Triggered
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Calc_Date
                    Department
                    Production_Line
                    Shift
                    Planned_Output
                    Required_HC
                    Required_HC_Rounded
                    Gap
                    Utilisation_Percent
                    Alert_Triggered
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
