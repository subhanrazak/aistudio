list Shift_Utilisation_Summary
{
    displayName = "Shift Utilisation Summary"
    show all rows from Headcount_Calculator
    (
        Shift
        Department
        Required_HC_Rounded
        (
            display = total
        )
        Gap
        (
            display = average
        )
        Utilisation_Percent
        (
            display = average
        )
    )
    group by ( Shift ascending )
    sort by ( Utilisation_Percent ascending )
}
