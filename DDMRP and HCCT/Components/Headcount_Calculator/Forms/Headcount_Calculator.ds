form Headcount_Calculator
{
    displayname = "Headcount Calculator"

    Calculation_Inputs
    (
        type = section
        displayname = "Calculation Inputs"
        row = 1
        column = 0
    )
    Calc_ID
    (
        type = autonumber
        displayname = "Calc ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
        row = 1
        column = 1
        width = medium
    )
    must have Shift
    (
        type = picklist
        displayname = "Shift"
        values = {"Morning","Afternoon","Night","General"}
        row = 1
        column = 2
        width = medium
    )
    must have Calc_Date
    (
        type = date
        displayname = "Calculation Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Production_Line
    (
        type = text
        displayname = "Production Line"
        row = 1
        column = 2
        width = medium
    )
    Plan_Parameters
    (
        type = section
        displayname = "Plan Parameters"
        visibility = true
        row = 2
        column = 1
    )
    must have Planned_Output
    (
        type = number
        displayname = "Planned Output Units"
        row = 2
        column = 1
        width = medium
    )
    must have Cycle_Time_Seconds
    (
        type = decimal
        displayname = "Cycle Time (seconds)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    must have Available_Hours
    (
        type = decimal
        displayname = "Available Hours"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    must have Efficiency_Percent
    (
        type = decimal
        displayname = "Efficiency (%)"
        decimalplace = 2
        initial value = 85.0
        row = 2
        column = 2
        width = medium
    )
    Calculated_Results
    (
        type = section
        displayname = "Calculated Results"
        visibility = true
        row = 3
        column = 1
    )
    Required_HC
    (
        type = decimal
        displayname = "Required Headcount"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Required_HC_Rounded
    (
        type = number
        displayname = "Required HC (Rounded)"
        row = 3
        column = 2
        width = medium
    )
    Gap
    (
        type = decimal
        displayname = "HC Gap (Required - Actual)"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Utilisation_Percent
    (
        type = decimal
        displayname = "Utilisation (%)"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Alert_Triggered
    (
        type = checkbox
        displayname = "Alert Triggered"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Calculate"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Recalculate"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
