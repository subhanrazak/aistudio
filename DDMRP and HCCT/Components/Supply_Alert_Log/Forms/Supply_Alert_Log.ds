form Supply_Alert_Log
{
    displayname = "Supply Alert Log"

    Alert_Details
    (
        type = section
        displayname = "Alert Details"
        row = 1
        column = 0
    )
    Alert_ID
    (
        type = autonumber
        displayname = "Alert ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Part
    (
        type = picklist
        displayname = "Part / SKU"
        values = Part_SKU_Master.ID
        displayformat = [Part_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Alert_Date
    (
        type = date
        displayname = "Alert Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Alert_Information
    (
        type = section
        displayname = "Alert Information"
        visibility = true
        row = 2
        column = 1
    )
    Alert_Type
    (
        type = picklist
        displayname = "Alert Type"
        values = {"RED Zone Breach","YELLOW Zone Warning","Stock-Out Risk","Manual Alert"}
        initial value = "RED Zone Breach"
        row = 2
        column = 1
        width = medium
    )
    NFP_At_Alert
    (
        type = decimal
        displayname = "NFP at Time of Alert"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Buffer_Status
    (
        type = picklist
        displayname = "Buffer Status at Alert"
        values = {"RED","YELLOW","GREEN"}
        row = 2
        column = 1
        width = medium
    )
    PO_Draft_Created
    (
        type = checkbox
        displayname = "PO Draft Created"
        initial value = false
        row = 2
        column = 2
        width = medium
    )
    Acknowledgment
    (
        type = section
        displayname = "Acknowledgment"
        visibility = true
        row = 3
        column = 1
    )
    Acknowledged
    (
        type = checkbox
        displayname = "Acknowledged"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Acknowledged_By
    (
        type = text
        displayname = "Acknowledged By"
        row = 3
        column = 2
        width = medium
    )
    Acknowledged_Date
    (
        type = date
        displayname = "Acknowledged Date"
        row = 3
        column = 1
        width = medium
    )
    Resolution_Notes
    (
        type = textarea
        displayname = "Resolution Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
