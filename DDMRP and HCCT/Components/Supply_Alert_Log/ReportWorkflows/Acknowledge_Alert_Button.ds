Acknowledge_Alert_Button as "Acknowledge Alert"
{
    type = functions
    form = Supply_Alert_Log
    execution type = for each record

    on start
    {
        actions
        {
            on click

            (
                update Supply_Alert_Log[ID == input.ID]
                [
                    Acknowledged = true
                    Acknowledged_By = zoho.loginuser
                    Acknowledged_Date = zoho.currentdate
                ];
            )

        }
    }
}
