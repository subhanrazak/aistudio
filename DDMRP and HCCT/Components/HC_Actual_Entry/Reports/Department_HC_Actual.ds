list Department_HC_Actual
{
    displayName = "Department-wise HC Actual"
    show all rows from HC_Actual_Entry
    (
        Department
        Entry_Date
        Shift
        Present_Count
        (
            display = total
        )
        Absent_Count
        (
            display = total
        )
        Total_Workforce
    )
    group by ( Department ascending )
    sort by ( Entry_Date descending )
}
