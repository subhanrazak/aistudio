form HC_Actual_Entry
{
    displayname = "HC Actual Entry"

    Attendance_Details
    (
        type = section
        displayname = "Attendance Details"
        row = 1
        column = 0
    )
    Entry_ID
    (
        type = autonumber
        displayname = "Entry ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Entry_Date
    (
        type = date
        displayname = "Entry Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
        row = 1
        column = 2
        width = medium
    )
    Headcount_Counts
    (
        type = section
        displayname = "Headcount Counts"
        visibility = true
        row = 2
        column = 1
    )
    must have Present_Count
    (
        type = number
        displayname = "Present Count"
        row = 2
        column = 1
        width = medium
    )
    Absent_Count
    (
        type = number
        displayname = "Absent Count"
        row = 2
        column = 2
        width = medium
    )
    Contractor_Count
    (
        type = number
        displayname = "Contractor Count"
        row = 2
        column = 1
        width = medium
    )
    Total_Workforce
    (
        type = formula
        displayname = "Total Workforce"
        value = Present_Count + Absent_Count
        visibility = true
        row = 2
        column = 2
        width = medium
    )
    Notes_Section
    (
        type = section
        displayname = "Notes"
        visibility = true
        row = 3
        column = 1
    )
    Shift
    (
        type = picklist
        displayname = "Shift"
        values = {"Morning","Afternoon","Night","General"}
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
