report All_Production_Plans
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Production_Line
                    SKU
                    Planned_Output_Units
                    Week
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Production_Line
                    SKU
                    Planned_Output_Units
                    Cycle_Time
                    Week
                    Shift
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
