form Production_Plan
{
    displayname = "Production Plan"

    Plan_Details
    (
        type = section
        displayname = "Plan Details"
        row = 1
        column = 0
    )
    Plan_ID
    (
        type = autonumber
        displayname = "Plan ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Production_Line
    (
        type = text
        displayname = "Production Line"
        row = 1
        column = 1
        width = medium
    )
    must have SKU
    (
        type = text
        displayname = "SKU / Product Code"
        row = 1
        column = 2
        width = medium
    )
    Output_Timing
    (
        type = section
        displayname = "Output & Timing"
        visibility = true
        row = 2
        column = 1
    )
    must have Planned_Output_Units
    (
        type = number
        displayname = "Planned Output Units"
        row = 2
        column = 1
        width = medium
    )
    must have Cycle_Time
    (
        type = decimal
        displayname = "Cycle Time (seconds)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    must have Week
    (
        type = date
        displayname = "Week Starting Date"
        row = 2
        column = 1
        width = medium
    )
    Shift
    (
        type = picklist
        displayname = "Shift"
        values = {"Morning","Afternoon","Night","General"}
        row = 2
        column = 2
        width = medium
    )
    Notes_Status
    (
        type = section
        displayname = "Notes & Status"
        visibility = true
        row = 3
        column = 1
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft","Confirmed","In Progress","Completed"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
