default list All_Stock_Snapshots
{
    displayName = "All Stock Snapshots"
    show all rows from Daily_Stock_Snapshot
    (
        Snapshot_Date
        Part
        On_Hand_Qty
        (
            display = total
        )
        On_Order_Qty
        (
            display = total
        )
        Qualified_Demand
        (
            display = total
        )
        Source
    )
    filters ( Part  Source )
    sort by ( Snapshot_Date descending )
}
