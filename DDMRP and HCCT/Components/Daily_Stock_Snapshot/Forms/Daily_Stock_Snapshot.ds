form Daily_Stock_Snapshot
{
    displayname = "Daily Stock Snapshot"

    Snapshot_Details
    (
        type = section
        displayname = "Snapshot Details"
        row = 1
        column = 0
    )
    Snapshot_ID
    (
        type = autonumber
        displayname = "Snapshot ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Part
    (
        type = picklist
        displayname = "Part / SKU"
        values = Part_SKU_Master.ID
        displayformat = [Part_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Snapshot_Date
    (
        type = date
        displayname = "Snapshot Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Stock_Quantities
    (
        type = section
        displayname = "Stock Quantities"
        visibility = true
        row = 2
        column = 1
    )
    must have On_Hand_Qty
    (
        type = decimal
        displayname = "On-Hand Quantity"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    On_Order_Qty
    (
        type = decimal
        displayname = "On-Order Quantity"
        decimalplace = 2
        initial value = 0.0
        row = 2
        column = 2
        width = medium
    )
    Qualified_Demand
    (
        type = decimal
        displayname = "Qualified Demand"
        decimalplace = 2
        initial value = 0.0
        row = 2
        column = 1
        width = medium
    )
    Source
    (
        type = picklist
        displayname = "Data Source"
        values = {"Manual Entry","Zoho Inventory Sync","Import"}
        initial value = "Manual Entry"
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
