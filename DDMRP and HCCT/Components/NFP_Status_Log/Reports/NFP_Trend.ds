list NFP_Trend
{
    displayName = "NFP 14-Day Trend"
    show all rows from NFP_Status_Log
    (
        NFP_Date
        Part
        NFP
        (
            display = average
        )
        Status
        Red_Zone_Value
        Yellow_Zone_Value
    )
    filters ( Part  Status )
    sort by ( NFP_Date descending )
}
