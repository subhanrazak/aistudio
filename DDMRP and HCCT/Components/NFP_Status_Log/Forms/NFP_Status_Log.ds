form NFP_Status_Log
{
    displayname = "NFP Status Log"

    NFP_Record
    (
        type = section
        displayname = "NFP Record"
        row = 1
        column = 0
    )
    NFP_ID
    (
        type = autonumber
        displayname = "NFP ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Part
    (
        type = picklist
        displayname = "Part / SKU"
        values = Part_SKU_Master.ID
        displayformat = [Part_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have NFP_Date
    (
        type = date
        displayname = "NFP Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Calculated_Values
    (
        type = section
        displayname = "Calculated Values"
        visibility = true
        row = 2
        column = 1
    )
    NFP
    (
        type = decimal
        displayname = "Net Flow Position (NFP)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Buffer Status"
        values = {"RED","YELLOW","GREEN"}
        row = 2
        column = 2
        width = medium
    )
    Red_Zone_Value
    (
        type = decimal
        displayname = "Red Zone Top"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Yellow_Zone_Value
    (
        type = decimal
        displayname = "Yellow Zone Top"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Action_Tracking
    (
        type = section
        displayname = "Action Tracking"
        visibility = true
        row = 3
        column = 1
    )
    Action_Triggered
    (
        type = checkbox
        displayname = "Action Triggered"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    PO_Draft_Created
    (
        type = checkbox
        displayname = "PO Draft Created (Zoho Books)"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
