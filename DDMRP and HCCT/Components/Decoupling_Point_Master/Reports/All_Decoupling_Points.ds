default list All_Decoupling_Points
{
    displayName = "All Decoupling Points"
    show all rows from Decoupling_Point_Master
    (
        Part
        Lead_Time_Days
        Lead_Time_Factor
        Variability_Factor
        Order_Cycle_Days
        Active_Status
    )
    filters ( Active_Status  Variability_Factor )
    sort by ( Part ascending )
}
