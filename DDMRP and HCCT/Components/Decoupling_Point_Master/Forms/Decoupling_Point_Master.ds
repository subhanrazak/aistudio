form Decoupling_Point_Master
{
    displayname = "Decoupling Point Master"

    Decoupling_Point
    (
        type = section
        displayname = "Decoupling Point"
        row = 1
        column = 0
    )
    DP_ID
    (
        type = autonumber
        displayname = "DP ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Part
    (
        type = picklist
        displayname = "Part / SKU"
        values = Part_SKU_Master.ID
        displayformat = [Part_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Active_Status
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Lead_Time_Parameters
    (
        type = section
        displayname = "Lead Time Parameters"
        visibility = true
        row = 2
        column = 1
    )
    must have Lead_Time_Days
    (
        type = number
        displayname = "Decoupled Lead Time (Days)"
        row = 2
        column = 1
        width = medium
    )
    Lead_Time_Factor
    (
        type = decimal
        displayname = "Lead Time Factor (0-1)"
        decimalplace = 2
        initial value = 0.5
        row = 2
        column = 2
        width = medium
    )
    Variability_Factor
    (
        type = picklist
        displayname = "Demand Variability Factor"
        values = {"Low (0.1)","Medium (0.5)","High (1.0)"}
        row = 2
        column = 1
        width = medium
    )
    Order_Parameters
    (
        type = section
        displayname = "Order Parameters"
        visibility = true
        row = 3
        column = 1
    )
    must have Order_Cycle_Days
    (
        type = number
        displayname = "Order Cycle (Days)"
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
