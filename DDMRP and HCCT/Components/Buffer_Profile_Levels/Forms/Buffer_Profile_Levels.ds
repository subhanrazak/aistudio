form Buffer_Profile_Levels
{
    displayname = "Buffer Profile & Levels"

    Part_Profile
    (
        type = section
        displayname = "Part & Profile"
        row = 1
        column = 0
    )
    Buffer_ID
    (
        type = autonumber
        displayname = "Buffer ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Part
    (
        type = picklist
        displayname = "Part / SKU"
        values = Part_SKU_Master.ID
        displayformat = [Part_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Last_Calculated
    (
        type = date
        displayname = "Last Calculated Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Buffer_Zones
    (
        type = section
        displayname = "Buffer Zones"
        visibility = true
        row = 2
        column = 1
    )
    Red_Zone
    (
        type = decimal
        displayname = "Red Zone (Top)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Yellow_Zone
    (
        type = decimal
        displayname = "Yellow Zone (Top)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Green_Zone
    (
        type = decimal
        displayname = "Green Zone (Top)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Variability_Factor
    (
        type = picklist
        displayname = "Variability Factor Applied"
        values = {"Low (0.1)","Medium (0.5)","High (1.0)"}
        row = 2
        column = 2
        width = medium
    )
    Override
    (
        type = section
        displayname = "Override"
        visibility = true
        row = 3
        column = 1
    )
    Manual_Override
    (
        type = checkbox
        displayname = "Manual Override Active"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Override_Notes
    (
        type = textarea
        displayname = "Override Notes"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
