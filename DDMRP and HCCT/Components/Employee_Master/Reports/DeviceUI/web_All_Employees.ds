report All_Employees
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Employee_Name
                    Department
                    Role
                    Shift
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Employee_Name
                    Department
                    Role
                    Shift
                    Location
                    Employment_Type
                    Status
                    Join_Date
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
