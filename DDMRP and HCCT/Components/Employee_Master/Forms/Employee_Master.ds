form Employee_Master
{
    displayname = "Employee Master"

    Employee_Info
    (
        type = section
        displayname = "Employee Information"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
        row = 1
        column = 2
        width = medium
    )
    Role_Shift
    (
        type = section
        displayname = "Role & Shift"
        visibility = true
        row = 2
        column = 1
    )
    must have Role
    (
        type = text
        displayname = "Role / Designation"
        row = 2
        column = 1
        width = medium
    )
    must have Shift
    (
        type = picklist
        displayname = "Shift"
        values = {"Morning","Afternoon","Night","General"}
        row = 2
        column = 2
        width = medium
    )
    Location
    (
        type = text
        displayname = "Location / Plant"
        row = 2
        column = 1
        width = medium
    )
    Employment_Type
    (
        type = picklist
        displayname = "Employment Type"
        values = {"Permanent","Contract","Contractor","Apprentice"}
        row = 2
        column = 2
        width = medium
    )
    Contact_Status
    (
        type = section
        displayname = "Contact & Status"
        visibility = true
        row = 3
        column = 1
    )
    Email
    (
        type = email
        displayname = "Email Address"
        row = 3
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone Number"
        allowedcountries = {in}
        defaultcountry = "in"
        row = 3
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive","On Leave"}
        initial value = "Active"
        row = 3
        column = 1
        width = medium
    )
    Join_Date
    (
        type = date
        displayname = "Date of Joining"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
