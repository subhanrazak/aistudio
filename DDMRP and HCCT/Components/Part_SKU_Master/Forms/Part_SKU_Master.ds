form Part_SKU_Master
{
    displayname = "Part / SKU Master"

    Part_Identification
    (
        type = section
        displayname = "Part Identification"
        row = 1
        column = 0
    )
    Part_ID
    (
        type = autonumber
        displayname = "Part ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have unique Part_Code
    (
        type = text
        displayname = "Part Code"
        row = 1
        column = 1
        width = medium
    )
    must have Part_Description
    (
        type = text
        displayname = "Part Description"
        row = 1
        column = 2
        width = medium
    )
    Classification
    (
        type = section
        displayname = "Classification"
        visibility = true
        row = 2
        column = 1
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = {"Battery Cell","Motor","Controller","Chassis","Brakes","Wiring Harness","Fasteners","Packaging","Other"}
        row = 2
        column = 1
        width = medium
    )
    Supplier
    (
        type = text
        displayname = "Supplier Name"
        row = 2
        column = 2
        width = medium
    )
    Unit
    (
        type = picklist
        displayname = "Unit of Measure"
        values = {"Each","Kg","Litre","Metre","Set","Box","Pallet"}
        row = 2
        column = 1
        width = medium
    )
    MOQ
    (
        type = number
        displayname = "Minimum Order Quantity (MOQ)"
        row = 2
        column = 2
        width = medium
    )
    DDMRP_Parameters
    (
        type = section
        displayname = "DDMRP Parameters"
        visibility = true
        row = 3
        column = 1
    )
    ADU
    (
        type = decimal
        displayname = "Average Daily Usage (ADU)"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    ADU_Last_Updated
    (
        type = date
        displayname = "ADU Last Updated Date"
        row = 3
        column = 2
        width = medium
    )
    Lead_Time_Days
    (
        type = number
        displayname = "Lead Time (Days)"
        row = 3
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive","Discontinued"}
        initial value = "Active"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
