default list All_Parts
{
    displayName = "All Parts / SKUs"
    show all rows from Part_SKU_Master
    (
        Part_Code
        Part_Description
        Category
        Supplier
        Unit
        MOQ
        ADU
        ADU_Last_Updated
        Lead_Time_Days
        Status
    )
    filters ( Category  Supplier  Status )
    sort by ( Part_Code ascending )
}
