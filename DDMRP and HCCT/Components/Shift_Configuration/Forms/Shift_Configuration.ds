form Shift_Configuration
{
    displayname = "Shift Configuration"

    Shift_Details
    (
        type = section
        displayname = "Shift Details"
        row = 1
        column = 0
    )
    must have Shift_Name
    (
        type = text
        displayname = "Shift Name"
        row = 1
        column = 1
        width = medium
    )
    must have Production_Line
    (
        type = text
        displayname = "Production Line"
        row = 1
        column = 2
        width = medium
    )
    Timing
    (
        type = section
        displayname = "Timing"
        visibility = true
        row = 2
        column = 1
    )
    must have Start_Time
    (
        type = time
        displayname = "Start Time"
        row = 2
        column = 1
        width = medium
    )
    must have End_Time
    (
        type = time
        displayname = "End Time"
        row = 2
        column = 2
        width = medium
    )
    Break_Duration_Minutes
    (
        type = number
        displayname = "Break Duration (mins)"
        row = 2
        column = 1
        width = medium
    )
    Available_Hours
    (
        type = decimal
        displayname = "Available Hours (hrs)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Schedule
    (
        type = section
        displayname = "Schedule"
        visibility = true
        row = 3
        column = 1
    )
    Days
    (
        type = checkboxes
        displayname = "Working Days"
        values = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"}
        row = 3
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
