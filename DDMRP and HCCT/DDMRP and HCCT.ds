	menu
	{
	    space Headcount_Space
	    {
	        displayname = "Headcount Planning"
	        icon = "users-multiple-11"
	
	        section HC_Dashboard_Section
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-bar-33"
	
	            page Headcount_Dashboard
	            {
	                icon = "business-chart-pie-36"
	            }
	        }
	
	        section HC_Planning_Section
	        {
	            displayname = "Planning"
	            icon = "business-board-30"
	
	            form Headcount_Calculator
	            {
	                icon = "business-calculator"
	            }
	            report HC_Summary
	            {
	                icon = "business-chart-bar-32"
	            }
	            report HC_Gap_Alert_Log
	            {
	                icon = "business-goal-65"
	            }
	            report Shift_Utilisation_Summary
	            {
	                icon = "business-chart-growth"
	            }
	        }
	
	        section HC_Attendance_Section
	        {
	            displayname = "Attendance"
	            icon = "users-badge-13"
	
	            form HC_Actual_Entry
	            {
	                icon = "users-add-27"
	            }
	            report All_HC_Actual
	            {
	                icon = "tech-desktop"
	            }
	            report Department_HC_Actual
	            {
	                icon = "business-hierarchy-53"
	            }
	        }
	
	        section HC_MasterData_Section
	        {
	            displayname = "Master Data"
	            icon = "business-briefcase-24"
	
	            form Employee_Master
	            {
	                icon = "users-single-body"
	            }
	            report All_Employees
	            {
	                icon = "users-multiple-19"
	            }
	            report Employees_By_Department
	            {
	                icon = "business-hierarchy-55"
	            }
	            form Production_Plan
	            {
	                icon = "business-board-28"
	            }
	            report All_Production_Plans
	            {
	                icon = "tech-desktop"
	            }
	            report Weekly_Production_Plans
	            {
	                icon = "business-agenda"
	            }
	            form Shift_Configuration
	            {
	                icon = "business-progress"
	            }
	            report All_Shifts
	            {
	                icon = "tech-desktop"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    space DDMRP_Space
	    {
	        displayname = "DDMRP Buffer Engine"
	        icon = "business-factory"
	
	        section DDMRP_Dashboard_Section
	        {
	            displayname = "Dashboards"
	            icon = "business-chart-bar-33"
	
	            page DDMRP_Buffer_Dashboard
	            {
	                icon = "business-chart-pie-35"
	            }
	        }
	
	        section Buffer_Management_Section
	        {
	            displayname = "Buffer Management"
	            icon = "business-stock"
	
	            form Buffer_Profile_Levels
	            {
	                icon = "business-strategy"
	            }
	            report All_Buffer_Profiles
	            {
	                icon = "tech-desktop"
	            }
	            form Decoupling_Point_Master
	            {
	                icon = "business-connect"
	            }
	            report All_Decoupling_Points
	            {
	                icon = "tech-desktop"
	            }
	            report Active_Decoupling_Points
	            {
	                icon = "business-goal-64"
	            }
	        }
	
	        section Status_Alerts_Section
	        {
	            displayname = "Status & Alerts"
	            icon = "business-badge"
	
	            form NFP_Status_Log
	            {
	                icon = "business-notes"
	            }
	            report All_NFP_Status
	            {
	                icon = "business-chart-bar-32"
	            }
	            report Parts_In_RED
	            {
	                icon = "business-goal-65"
	            }
	            report NFP_Trend
	            {
	                icon = "business-chart-growth"
	            }
	            form Supply_Alert_Log
	            {
	                icon = "business-sign"
	            }
	            report All_Supply_Alerts
	            {
	                icon = "tech-desktop"
	            }
	            report Unacknowledged_Alerts
	            {
	                icon = "objects-cone"
	            }
	            report ADU_History
	            {
	                icon = "business-chart-growth"
	            }
	        }
	
	        section Stock_Section
	        {
	            displayname = "Stock"
	            icon = "business-briefcase-26"
	
	            form Daily_Stock_Snapshot
	            {
	                icon = "business-math"
	            }
	            report All_Stock_Snapshots
	            {
	                icon = "tech-desktop"
	            }
	            report Latest_Stock_Snapshots
	            {
	                icon = "business-chart-bar-32"
	            }
	        }
	
	        section DDMRP_MasterData_Section
	        {
	            displayname = "Part Master"
	            icon = "business-books"
	
	            form Part_SKU_Master
	            {
	                icon = "business-briefcase-25"
	            }
	            report All_Parts
	            {
	                icon = "users-multiple-19"
	            }
	            report Active_Parts
	            {
	                icon = "business-goal-64"
	            }
	        }
	
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_6"
	        variant = "variant_1"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_name"
	        placement = "left"
	    }
	}
	}
