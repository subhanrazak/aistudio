		    PO_Draft_Created
		    (
		        type = checkbox
		        displayname = "PO Draft Created (Zoho Books)"
		        initial value = false
		        row = 3
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
