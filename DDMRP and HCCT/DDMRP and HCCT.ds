application "DDMRP-and-HCCT"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Buffer_Profile_Levels
		{
		    displayname = "Buffer Profile & Levels"
		
		    Part_Profile
		    (
		        type = section
		        displayname = "Part & Profile"
		        row = 1
		        column = 0
		    )
		    Buffer_ID
		    (
		        type = autonumber
		        displayname = "Buffer ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Part
		    (
		        type = picklist
		        displayname = "Part / SKU"
		        values = Part_SKU_Master.ID
		        displayformat = [Part_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Last_Calculated
		    (
		        type = date
		        displayname = "Last Calculated Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Buffer_Zones
		    (
		        type = section
		        displayname = "Buffer Zones"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Red_Zone
		    (
		        type = decimal
		        displayname = "Red Zone (Top)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Yellow_Zone
		    (
		        type = decimal
		        displayname = "Yellow Zone (Top)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Green_Zone
		    (
		        type = decimal
		        displayname = "Green Zone (Top)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Variability_Factor
		    (
		        type = picklist
		        displayname = "Variability Factor Applied"
		        values = {"Low (0.1)","Medium (0.5)","High (1.0)"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Override
		    (
		        type = section
		        displayname = "Override"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Manual_Override
		    (
		        type = checkbox
		        displayname = "Manual Override Active"
		        initial value = false
		        row = 3
		        column = 1
		        width = medium
		    )
		    Override_Notes
		    (
		        type = textarea
		        displayname = "Override Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Daily_Stock_Snapshot
		{
		    displayname = "Daily Stock Snapshot"
		
		    Snapshot_Details
		    (
		        type = section
		        displayname = "Snapshot Details"
		        row = 1
		        column = 0
		    )
		    Snapshot_ID
		    (
		        type = autonumber
		        displayname = "Snapshot ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Part
		    (
		        type = picklist
		        displayname = "Part / SKU"
		        values = Part_SKU_Master.ID
		        displayformat = [Part_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Snapshot_Date
		    (
		        type = date
		        displayname = "Snapshot Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Stock_Quantities
		    (
		        type = section
		        displayname = "Stock Quantities"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have On_Hand_Qty
		    (
		        type = decimal
		        displayname = "On-Hand Quantity"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    On_Order_Qty
		    (
		        type = decimal
		        displayname = "On-Order Quantity"
		        decimalplace = 2
		        initial value = 0.0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Qualified_Demand
		    (
		        type = decimal
		        displayname = "Qualified Demand"
		        decimalplace = 2
		        initial value = 0.0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Source
		    (
		        type = picklist
		        displayname = "Data Source"
		        values = {"Manual Entry","Zoho Inventory Sync","Import"}
		        initial value = "Manual Entry"
		        row = 2
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Decoupling_Point_Master
		{
		    displayname = "Decoupling Point Master"
		
		    Decoupling_Point
		    (
		        type = section
		        displayname = "Decoupling Point"
		        row = 1
		        column = 0
		    )
		    DP_ID
		    (
		        type = autonumber
		        displayname = "DP ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Part
		    (
		        type = picklist
		        displayname = "Part / SKU"
		        values = Part_SKU_Master.ID
		        displayformat = [Part_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Active_Status
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Lead_Time_Parameters
		    (
		        type = section
		        displayname = "Lead Time Parameters"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Lead_Time_Days
		    (
		        type = number
		        displayname = "Decoupled Lead Time (Days)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Lead_Time_Factor
		    (
		        type = decimal
		        displayname = "Lead Time Factor (0-1)"
		        decimalplace = 2
		        initial value = 0.5
		        row = 2
		        column = 2
		        width = medium
		    )
		    Variability_Factor
		    (
		        type = picklist
		        displayname = "Demand Variability Factor"
		        values = {"Low (0.1)","Medium (0.5)","High (1.0)"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Order_Parameters
		    (
		        type = section
		        displayname = "Order Parameters"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Order_Cycle_Days
		    (
		        type = number
		        displayname = "Order Cycle (Days)"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Employee_Master
		{
		    displayname = "Employee Master"
		
		    Employee_Info
		    (
		        type = section
		        displayname = "Employee Information"
		        row = 1
		        column = 0
		    )
		    Employee_ID
		    (
		        type = autonumber
		        displayname = "Employee ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = text
		        displayname = "Employee Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Role_Shift
		    (
		        type = section
		        displayname = "Role & Shift"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Role
		    (
		        type = text
		        displayname = "Role / Designation"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Shift
		    (
		        type = picklist
		        displayname = "Shift"
		        values = {"Morning","Afternoon","Night","General"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Location
		    (
		        type = text
		        displayname = "Location / Plant"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Employment_Type
		    (
		        type = picklist
		        displayname = "Employment Type"
		        values = {"Permanent","Contract","Contractor","Apprentice"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Contact_Status
		    (
		        type = section
		        displayname = "Contact & Status"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Email
		    (
		        type = email
		        displayname = "Email Address"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone Number"
		        allowedcountries = {in}
		        defaultcountry = "in"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive","On Leave"}
		        initial value = "Active"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Join_Date
		    (
		        type = date
		        displayname = "Date of Joining"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form HC_Actual_Entry
		{
		    displayname = "HC Actual Entry"
		
		    Attendance_Details
		    (
		        type = section
		        displayname = "Attendance Details"
		        row = 1
		        column = 0
		    )
		    Entry_ID
		    (
		        type = autonumber
		        displayname = "Entry ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Entry_Date
		    (
		        type = date
		        displayname = "Entry Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Headcount_Counts
		    (
		        type = section
		        displayname = "Headcount Counts"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Present_Count
		    (
		        type = number
		        displayname = "Present Count"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Absent_Count
		    (
		        type = number
		        displayname = "Absent Count"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Contractor_Count
		    (
		        type = number
		        displayname = "Contractor Count"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Total_Workforce
		    (
		        type = formula
		        displayname = "Total Workforce"
		        value = Present_Count + Absent_Count
		        visibility = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes_Section
		    (
		        type = section
		        displayname = "Notes"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Shift
		    (
		        type = picklist
		        displayname = "Shift"
		        values = {"Morning","Afternoon","Night","General"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Headcount_Calculator
		{
		    displayname = "Headcount Calculator"
		
		    Calculation_Inputs
		    (
		        type = section
		        displayname = "Calculation Inputs"
		        row = 1
		        column = 0
		    )
		    Calc_ID
		    (
		        type = autonumber
		        displayname = "Calc ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = {"Assembly","Paint","Battery","Quality","Logistics","Maintenance","HR","Finance","IT"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Shift
		    (
		        type = picklist
		        displayname = "Shift"
		        values = {"Morning","Afternoon","Night","General"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Calc_Date
		    (
		        type = date
		        displayname = "Calculation Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Production_Line
		    (
		        type = text
		        displayname = "Production Line"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Plan_Parameters
		    (
		        type = section
		        displayname = "Plan Parameters"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Planned_Output
		    (
		        type = number
		        displayname = "Planned Output Units"
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Cycle_Time_Seconds
		    (
		        type = decimal
		        displayname = "Cycle Time (seconds)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Available_Hours
		    (
		        type = decimal
		        displayname = "Available Hours"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Efficiency_Percent
		    (
		        type = decimal
		        displayname = "Efficiency (%)"
		        decimalplace = 2
		        initial value = 85.0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Calculated_Results
		    (
		        type = section
		        displayname = "Calculated Results"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Required_HC
		    (
		        type = decimal
		        displayname = "Required Headcount"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Required_HC_Rounded
		    (
		        type = number
		        displayname = "Required HC (Rounded)"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Gap
		    (
		        type = decimal
		        displayname = "HC Gap (Required - Actual)"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Utilisation_Percent
		    (
		        type = decimal
		        displayname = "Utilisation (%)"
		        decimalplace = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Alert_Triggered
		    (
		        type = checkbox
		        displayname = "Alert Triggered"
		        initial value = false
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Calculate"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Recalculate"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form NFP_Status_Log
		{
		    displayname = "NFP Status Log"
		
		    NFP_Record
		    (
		        type = section
		        displayname = "NFP Record"
		        row = 1
		        column = 0
		    )
		    NFP_ID
		    (
		        type = autonumber
		        displayname = "NFP ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Part
		    (
		        type = picklist
		        displayname = "Part / SKU"
		        values = Part_SKU_Master.ID
		        displayformat = [Part_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have NFP_Date
		    (
		        type = date
		        displayname = "NFP Date"
		        initial value = "${zoho.currentdate}"
