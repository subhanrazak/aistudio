form Customer_Master
{
    title
    {
        displayname = "Customer Master"
        on add = "Add Customer"
        on edit = "Edit Customer"
    }

    Company_Details
    (
        type = section
        displayname = "Company Details"
        row = 1
        column = 0
    )
    must have Company_Name
    (
        type = text
        displayname = "Company Name"
        row = 1
        column = 1
        width = medium
    )
    Customer_Code
    (
        type = text
        displayname = "Customer Code"
        description
        [
            type = tooltip
            message = "Internal / SAP customer code"
        ]
        row = 1
        column = 2
        width = medium
    )
    must have Customer_Type
    (
        type = picklist
        displayname = "Type of Customer"
        values = {"OEM","Tier 1","Tier 2"}
        row = 1
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )

    Primary_Contact
    (
        type = section
        displayname = "Primary Point of Contact"
        visibility = true
        row = 2
        column = 1
    )
    must have POC_Name
    (
        type = name
        displayname = "Primary Contact Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Mrs.","Ms.","Dr."}
            visibility = false
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 2
        column = 1
        width = medium
    )
    POC_Designation
    (
        type = text
        displayname = "Designation"
        row = 2
        column = 2
        width = medium
    )
    must have POC_Email
    (
        type = email
        displayname = "Email"
        row = 2
        column = 1
        width = medium
    )
    POC_Phone
    (
        type = phonenumber
        displayname = "Phone"
        allowedcountries = {in,gb,us}
        defaultcountry = "in"
        row = 2
        column = 2
        width = medium
    )

    Secondary_Contact
    (
        type = section
        displayname = "Secondary Point of Contact"
        visibility = true
        row = 3
        column = 1
    )
    Secondary_POC_Name
    (
        type = name
        displayname = "Secondary Contact Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Mrs.","Ms.","Dr."}
            visibility = false
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 3
        column = 1
        width = medium
    )
    Secondary_POC_Designation
    (
        type = text
        displayname = "Designation"
        row = 3
        column = 2
        width = medium
    )
    Secondary_POC_Email
    (
        type = email
        displayname = "Email"
        row = 3
        column = 1
        width = medium
    )
    Secondary_POC_Phone
    (
        type = phonenumber
        displayname = "Phone"
        allowedcountries = {in,gb,us}
        defaultcountry = "in"
        row = 3
        column = 2
        width = medium
    )

    Notes_Section
    (
        type = section
        displayname = "Additional Notes"
        visibility = true
        row = 4
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 80px
        row = 4
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Customer"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Customer"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
