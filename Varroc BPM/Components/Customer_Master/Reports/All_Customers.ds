default list All_Customers
{
    displayName = "All Customers"
    show all rows from Customer_Master
    (
        Company_Name
        Customer_Code
        Customer_Type
        POC_Name
        POC_Email
        POC_Phone
        Status
    )
    filters
    (
        Customer_Type
        Status
    )
    sort by
    (
        Company_Name ascending
    )
}
