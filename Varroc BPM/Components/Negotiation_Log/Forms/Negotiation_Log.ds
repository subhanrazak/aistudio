form Negotiation_Log
{
    displayname = "Negotiation Log"

    Negotiation_Entry
    (
        type = section
        displayname = "Negotiation Entry"
        row = 1
        column = 0
    )
    must have Revision_Reference
    (
        type = picklist
        displayname = "Revision Reference"
        values = Revision_Request.ID
        displayformat = [Revision_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Customer_Display
    (
        type = formula
        displayname = "Customer Name"
        value = Revision_Reference.Customer_Name_Display
        visibility = true
        row = 1
        column = 2
        width = medium
    )
    Round_Number
    (
        type = number
        displayname = "Round Number"
        row = 1
        column = 1
        width = medium
    )
    Negotiation_Date
    (
        type = date
        displayname = "Negotiation Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Negotiated_By
    (
        type = text
        displayname = "Negotiated By"
        row = 1
        column = 1
        width = medium
    )

    Proposals_Section
    (
        type = section
        displayname = "Proposals"
        visibility = true
        row = 2
        column = 1
    )
    must have Varroc_Proposal
    (
        type = textarea
        displayname = "Varroc Proposal / Position"
        height = 80px
        row = 2
        column = 1
        width = medium
    )
    Customer_Counter_Proposal
    (
        type = textarea
        displayname = "Customer Counter-Proposal"
        height = 80px
        row = 2
        column = 2
        width = medium
    )
    Gap_Summary
    (
        type = textarea
        displayname = "Gap Summary / Key Points of Contention"
        row = 2
        column = 1
        width = medium
    )

    Resolution_Section
    (
        type = section
        displayname = "Resolution"
        visibility = true
        row = 3
        column = 1
    )
    Round_Status
    (
        type = picklist
        displayname = "Round Status"
        values = {"Open","Resolved","Escalated","Stalled"}
        initial value = "Open"
        row = 3
        column = 1
        width = medium
    )
    Resolution_Notes
    (
        type = textarea
        displayname = "Resolution Notes"
        row = 3
        column = 2
        width = medium
    )
    Next_Action
    (
        type = text
        displayname = "Next Action"
        row = 3
        column = 1
        width = medium
    )
    Next_Action_Date
    (
        type = date
        displayname = "Next Action Date"
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Log Negotiation Round"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
