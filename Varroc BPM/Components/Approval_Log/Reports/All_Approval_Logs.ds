default list All_Approval_Logs
{
    displayName = "All Approval Actions"
    show all rows from Approval_Log
    (
        Revision_Reference
        Approval_Level
        Action
        Action_By
        Action_Date
        SO_Number_Ref
    )
    filters
    (
        Approval_Level
        Action
    )
    sort by
    (
        Action_Date descending
    )
}
