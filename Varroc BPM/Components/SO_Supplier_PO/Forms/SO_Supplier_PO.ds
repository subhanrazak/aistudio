form SO_Supplier_PO
{
    title
    {
        displayname = "SO Supplier PO"
        on add = "Add Supplier PO"
        on edit = "Edit Supplier PO"
    }


    Supplier_PO_Entry
    (
        type = section
        displayname = "Supplier PO Entry"
        row = 1
        column = 0
    )
    must have Supplier_Name
    (
        type = text
        displayname = "Supplier Name"
        row = 1
        column = 1
        width = medium
    )
    must have Material
    (
        type = text
        displayname = "Material"
        row = 1
        column = 2
        width = medium
    )
    Contracted_Price
    (
        type = INR
        displayname = "Contracted Price (INR)"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Supplier_PO_Number
    (
        type = text
        displayname = "Supplier PO Number"
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add Supplier PO"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
