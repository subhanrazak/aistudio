list Internally_Approved_Revisions
{
    displayName = "Approved - Awaiting Customer Comm"
    show all rows from Revision_Request [Overall_Status == "Internally Approved" || Overall_Status == "Customer Communication"]
    (
        Revision_ID
        SO_Reference
        Customer_Name_Display
        Revision_Type
        Total_Financial_Impact
        Level3_Date
        Overall_Status
    )
    sort by
    (
        Level3_Date ascending
    )
}
