default list All_Revisions
{
    displayName = "All Revisions"
    show all rows from Revision_Request
    (
        Revision_ID
        SO_Reference
        Customer_Name_Display
        Revision_Type
        Overall_Status
        Urgency
        Total_Financial_Impact
        Revision_Date
    )
    filters
    (
        Overall_Status
        Revision_Type
        Urgency
    )
    sort by
    (
        Revision_Date descending
    )
    conditional formatting
    (
        "Urgent Revision"
        {
            condition = (Urgency == "Urgent")
            fields = [Revision_ID, Revision_Type, Overall_Status, Urgency]
            format = "background-color:#FFE8E8;color:#CC0000;font-weight:bold"
        }
        "Info Requested"
        {
            condition = (Overall_Status == "Info Requested")
            fields = [Revision_ID, Overall_Status]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
