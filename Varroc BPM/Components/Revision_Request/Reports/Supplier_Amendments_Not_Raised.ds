list Supplier_Amendments_Not_Raised
{
    displayName = "Customer Accepted - Supplier Not Updated"
    show all rows from Revision_Request [Overall_Status == "Customer Accepted"]
    (
        Revision_ID
        SO_Reference
        Customer_Name_Display
        Revision_Type
        Total_Financial_Impact
        Level3_Date
        Overall_Status
    )
    sort by
    (
        Level3_Date ascending
    )
    conditional formatting
    (
        "Needs Attention"
        {
            condition = (Overall_Status == "Customer Accepted")
            fields = [Revision_ID, Overall_Status]
            format = "background-color:#FFF3CD;color:#856404;font-weight:bold"
        }
    )
}
