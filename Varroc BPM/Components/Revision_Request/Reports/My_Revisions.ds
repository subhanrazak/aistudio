list My_Revisions
{
    displayName = "My Revisions"
    show all rows from Revision_Request [Added_User == zoho.loginuser]
    (
        Revision_ID
        SO_Reference
        Revision_Type
        Overall_Status
        Total_Financial_Impact
        Revision_Date
        SLA_Deadline
    )
    filters
    (
        Overall_Status
        Revision_Type
    )
    sort by
    (
        Revision_Date descending
    )
}
