default list All_Customer_Communications
{
    displayName = "All Customer Communications"
    show all rows from Customer_Communication
    (
        Revision_Reference
        Customer_Display
        SO_Number_Display
        Communication_Date
        Customer_Response
        Amended_SO_Number
        Response_Date
    )
    filters
    (
        Customer_Response
    )
    sort by
    (
        Communication_Date descending
    )
    conditional formatting
    (
        "No Response"
        {
            condition = (Customer_Response == "No Response")
            fields = [Revision_Reference, Customer_Display, Customer_Response]
            format = "background-color:#FFD6D6;color:#CC0000"
        }
        "Accepted"
        {
            condition = (Customer_Response == "Accepted")
            fields = [Revision_Reference, Customer_Display, Customer_Response]
            format = "background-color:#D4EDDA;color:#155724"
        }
        "Under Negotiation"
        {
            condition = (Customer_Response == "Under Negotiation")
            fields = [Customer_Response]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
