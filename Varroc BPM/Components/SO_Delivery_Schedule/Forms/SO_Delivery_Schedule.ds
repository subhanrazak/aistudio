form SO_Delivery_Schedule
{
    title
    {
        displayname = "SO Delivery Schedule"
        on add = "Add Delivery Schedule"
        on edit = "Edit Delivery Schedule"
    }


    Schedule_Entry
    (
        type = section
        displayname = "Schedule Entry"
        row = 1
        column = 0
    )
    must have Period
    (
        type = text
        displayname = "Period (Month / Quarter)"
        row = 1
        column = 1
        width = medium
    )
    must have Quantity
    (
        type = number
        displayname = "Quantity"
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Add Schedule Entry"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
