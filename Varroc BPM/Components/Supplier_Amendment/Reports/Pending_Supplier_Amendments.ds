list Pending_Supplier_Amendments
{
    displayName = "Pending Supplier Amendments"
    show all rows from Supplier_Amendment [Supplier_Response == "Pending" || Supplier_Response == "Under Negotiation"]
    (
        Revision_Reference
        Customer_Display
        Customer_Amended_SO_Reference
        Supplier_Name
        Amendment_Type
        Amendment_Date
        Supplier_Response
    )
    sort by
    (
        Amendment_Date ascending
    )
}
