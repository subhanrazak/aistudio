form SO_Baseline
{
    title
    {
        displayname = "SO Baseline"
        on add = "Add SO Baseline"
        on edit = "Edit SO Baseline"
    }

    SO_Details
    (
        type = section
        displayname = "SO Details"
        row = 1
        column = 0
    )
    must have unique SO_Number
    (
        type = text
        displayname = "SO Number"
        description
        [
            type = tooltip
            message = "Sales Order number from SAP"
        ]
        row = 1
        column = 1
        width = medium
    )
    must have Customer_Name
    (
        type = text
        displayname = "Customer Name"
        row = 1
        column = 2
        width = medium
    )
    Customer_Code
    (
        type = text
        displayname = "Customer Code"
        row = 1
        column = 1
        width = medium
    )

    must have SO_Date
    (
        type = date
        displayname = "SO Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Agreement_Date
    (
        type = date
        displayname = "Agreement Date"
        row = 1
        column = 1
        width = medium
    )
    Validity_Period
    (
        type = date
        displayname = "Validity Period (End Date)"
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Closed"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )

    Product_And_Pricing
    (
        type = section
        displayname = "Product and Pricing"
        visibility = true
        row = 2
        column = 1
    )
    must have Product_Name
    (
        type = text
        displayname = "Product Name"
        row = 2
        column = 1
        width = medium
    )
    Product_Code
    (
        type = text
        displayname = "Product Code"
        row = 2
        column = 2
        width = medium
    )
    must have Agreed_Unit_Price
    (
        type = INR
        displayname = "Agreed Unit Price (INR)"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    must have Total_PO_Value
    (
        type = INR
        displayname = "Total PO Value (INR)"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Currency
    (
        type = picklist
        displayname = "Currency"
        values = {"INR","USD","EUR","GBP"}
        initial value = "INR"
        row = 2
        column = 1
        width = medium
    )

    Delivery_Schedule_Section
    (
        type = section
        displayname = "Delivery Schedule"
        visibility = false
        row = 3
        column = 1
    )
    Delivery_Schedule
    (
        type = grid
        displayname = "Delivery Schedule"
        values = SO_Delivery_Schedule.ID
        viewtype = "list"
        row = 3
        column = 1
        width = medium
    )

    Linked_Supplier_POs_Section
    (
        type = section
        displayname = "Linked Supplier POs"
        visibility = false
        row = 4
        column = 1
    )
    Supplier_POs
    (
        type = grid
        displayname = "Linked Supplier POs"
        values = SO_Supplier_PO.ID
        viewtype = "list"
        row = 4
        column = 1
        width = medium
    )

    Notes_Section
    (
        type = section
        displayname = "Notes"
        visibility = true
        row = 5
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes / Remarks"
        row = 5
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Create Baseline"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
