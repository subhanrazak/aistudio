default list All_SO_Baselines
{
    displayName = "All SO Baselines"
    show all rows from SO_Baseline
    (
        SO_Number
        Customer_Name
        Product_Name
        Total_PO_Value
        Status
        SO_Date
    )
    filters
    (
        Status
        Customer_Name
    )
    sort by
    (
        SO_Date descending
    )
}
