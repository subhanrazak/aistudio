list Active_SOs
{
    displayName = "Active Sales Orders"
    show all rows from SO_Baseline [Status == "Active"]
    (
        SO_Number
        Customer_Name
        Product_Name
        Agreed_Unit_Price
        Total_PO_Value
        SO_Date
        Validity_Period
    )
    filters
    (
        Customer_Name
    )
    sort by
    (
        SO_Date descending
    )
}
