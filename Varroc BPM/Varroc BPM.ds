	        {
	            displayname = "Supplier"
	            icon = "business-briefcase-24"
	
	            form Supplier_Amendment
	            {
	                icon = "business-briefcase-24"
	            }
	            report All_Supplier_Amendments
	            {
	                icon = "business-briefcase-26"
	            }
	            report Pending_Supplier_Amendments
	            {
	                icon = "files-exclamation"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "poppins"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	}
	}
}
