application "Varroc-BPM"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Approval_Log
		{
		    displayname = "Approval Log"
		
		    Approval_Action
		    (
		        type = section
		        displayname = "Approval Action"
		        row = 1
		        column = 0
		    )
		    must have Revision_Reference
		    (
		        type = picklist
		        displayname = "Revision Reference"
		        values = Revision_Request.ID
		        displayformat = [Revision_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Approval_Level
		    (
		        type = picklist
		        displayname = "Approval Level"
		        values = {"Level 1 - Procurement Manager","Level 2 - Finance","Level 3 - Commercial Head"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Action
		    (
		        type = picklist
		        displayname = "Action Taken"
		        values = {"Approved","Rejected","Request Info","Submitted"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Comments
		    (
		        type = textarea
		        displayname = "Comments"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Action_By
		    (
		        type = text
		        displayname = "Actioned By"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Action_Date
		    (
		        type = datetime
		        displayname = "Action Date/Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    SO_Number_Ref
		    (
		        type = text
		        displayname = "SO Number"
		        description
		        [
		            type = tooltip
		            message = "Auto-populated from Revision for quick search"
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Log Action"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Customer_Communication
		{
		    title
		    {
		        displayname = "Customer Communication"
		        on add = "Log Customer Communication"
		        on edit = "Update Customer Response"
		    }
		
		    Communication_Details
		    (
		        type = section
		        displayname = "Communication Details"
		        row = 1
		        column = 0
		    )
		    must have Revision_Reference
		    (
		        type = picklist
		        displayname = "Revision Reference"
		        values = Revision_Request.ID
		        displayformat = [Revision_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    SO_Number_Display
		    (
		        type = formula
		        displayname = "SO Number"
		        value = Revision_Reference.SO_Reference.SO_Number
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Customer_Display
		    (
		        type = formula
		        displayname = "Customer Name"
		        value = Revision_Reference.Customer_Name_Display
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Communication_Date
		    (
		        type = date
		        displayname = "Communication Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Proposed_Effective_Date
		    (
		        type = date
		        displayname = "Proposed Effective Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Communication_Notes
		    (
		        type = textarea
		        displayname = "Revision Notice / Communication Summary"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Attached_Documents
		    (
		        type = upload file
		        displayname = "Attached Documents"
		        file count = 5
		        browse = local_drive
		        row = 1
		        column = 1
		        width = medium
		    )
		    Communicated_By
		    (
		        type = text
		        displayname = "Communicated By"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Customer_Response_Section
		    (
		        type = section
		        displayname = "Customer Response"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Customer_Response
		    (
		        type = picklist
		        displayname = "Customer Response"
		        values = {"Pending","Accepted","Rejected","Under Negotiation","No Response"}
		        initial value = "Pending"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Response_Date
		    (
		        type = date
		        displayname = "Response Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Amended_SO_Number
		    (
		        type = text
		        displayname = "Amended SO Number (from Customer)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection / Counter Reason"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Follow_Up_Count
		    (
		        type = number
		        displayname = "Follow-up Count"
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Last_Follow_Up_Date
		    (
		        type = date
		        displayname = "Last Follow-up Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Log Communication"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update Response"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Negotiation_Log
		{
		    displayname = "Negotiation Log"
		
		    Negotiation_Entry
		    (
		        type = section
		        displayname = "Negotiation Entry"
		        row = 1
		        column = 0
		    )
		    must have Revision_Reference
		    (
		        type = picklist
		        displayname = "Revision Reference"
		        values = Revision_Request.ID
		        displayformat = [Revision_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer_Display
		    (
		        type = formula
		        displayname = "Customer Name"
		        value = Revision_Reference.Customer_Name_Display
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Round_Number
		    (
		        type = number
		        displayname = "Round Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Negotiation_Date
		    (
		        type = date
		        displayname = "Negotiation Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Negotiated_By
		    (
		        type = text
		        displayname = "Negotiated By"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Proposals_Section
		    (
		        type = section
		        displayname = "Proposals"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Varroc_Proposal
		    (
		        type = textarea
		        displayname = "Varroc Proposal / Position"
		        height = 80px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Customer_Counter_Proposal
		    (
		        type = textarea
		        displayname = "Customer Counter-Proposal"
		        height = 80px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Gap_Summary
		    (
		        type = textarea
		        displayname = "Gap Summary / Key Points of Contention"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Resolution_Section
		    (
		        type = section
		        displayname = "Resolution"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Round_Status
		    (
		        type = picklist
		        displayname = "Round Status"
		        values = {"Open","Resolved","Escalated","Stalled"}
		        initial value = "Open"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Resolution_Notes
		    (
		        type = textarea
		        displayname = "Resolution Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Next_Action
		    (
		        type = text
		        displayname = "Next Action"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Next_Action_Date
		    (
		        type = date
		        displayname = "Next Action Date"
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Log Negotiation Round"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Revision_Request
		{
		    title
		    {
		        displayname = "Revision Request"
		        on add = "Raise Revision Request"
		        on edit = "Edit Revision Request"
		    }
		
		    Revision_Details
		    (
		        type = section
		        displayname = "Revision Details"
		        row = 1
		        column = 0
		    )
		    Revision_ID
		    (
		        type = autonumber
		        displayname = "Revision ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have SO_Reference
		    (
		        type = picklist
		        displayname = "SO Reference"
		        values = SO_Baseline.ID
		        displayformat = [SO_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Customer_Name_Display
		    (
		        type = formula
		        displayname = "Customer Name"
		        value = SO_Reference.Customer_Name
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Revision_Type
		    (
		        type = picklist
		        displayname = "Revision Type"
		        values = {"Raw Material Cost Change","Forex Movement","Freight Cost Change","Shipping Mode Change","Scope Change - Specification","Scope Change - Quantity Revision","Market Demand Change","Engineering Change (ECN)","Timeline / Delivery Change","Supplier-Driven Cost Change"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Urgency
		    (
		        type = radiobuttons
		        displayname = "Urgency"
		        values = {"Standard","Urgent"}
		        initial value = "Standard"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Revision_Date
		    (
		        type = date
		        displayname = "Revision Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Change_Description
		    (
		        type = section
		        displayname = "Change Description"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Description
		    (
		        type = textarea
		        displayname = "Description of Change"
		        description
		        [
		            type = tooltip
		            message = "What changed, why it changed, and what the impact is"
		        ]
		        height = 80px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Old_Value
		    (
		        type = text
		        displayname = "Old Value (Price / Qty / Spec / Timeline)"
		        row = 2
		        column = 2
		        width = medium
		    )
		    New_Value
		    (
		        type = text
		        displayname = "New Value (Price / Qty / Spec / Timeline)"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Impact_Direction
		    (
		        type = radiobuttons
		        displayname = "Financial Impact Direction"
		        values = {"Increase","Decrease"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Financial_Impact_Per_Unit
		    (
		        type = INR
		        displayname = "Financial Impact Per Unit (INR)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Total_Financial_Impact
		    (
		        type = INR
		        displayname = "Total Financial Impact (INR)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Supporting_Documents_Section
		    (
		        type = section
		        displayname = "Supporting Documents"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Supporting_Documents
		    (
		        type = upload file
		        displayname = "Supporting Documents"
		        file count = 10
		        browse = local_drive
		        row = 3
		        column = 1
		        width = medium
		    )
		    Document_Notes
		    (
		        type = textarea
		        displayname = "Document Notes"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Overall_Status_Section
		    (
		        type = section
		        displayname = "Overall Status"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Overall_Status
		    (
		        type = picklist
		        displayname = "Overall Status"
		        values = {"Draft","Submitted","Level 1 Review","Level 2 Review","Level 3 Review","Internally Approved","Rejected","Info Requested","Customer Communication","Under Negotiation","Customer Accepted","Customer Rejected","Supplier Amendment Raised","Completed"}
		        initial value = "Draft"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Submitted_Date
		    (
		        type = datetime
		        displayname = "Submitted Date"
		        row = 4
		        column = 2
		        width = medium
		    )
		    SLA_Deadline
		    (
		        type = date
		        displayname = "SLA Deadline"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Submitted_By
		    (
		        type = text
		        displayname = "Submitted By"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    Level1_Approval_Section
		    (
		        type = section
		        displayname = "Level 1 Approval - Procurement Manager"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Level1_Action
		    (
		        type = picklist
		        displayname = "L1 Decision"
		        values = {"Pending","Approved","Rejected","Request Info"}
		        initial value = "Pending"
		        row = 5
		        column = 1
		        width = medium
		    )
		    Level1_Comments
		    (
		        type = textarea
		        displayname = "L1 Comments"
		        row = 5
		        column = 2
		        width = medium
		    )
		    Level1_Approved_By
		    (
		        type = text
		        displayname = "L1 Actioned By"
		        row = 5
		        column = 1
		        width = medium
		    )
		    Level1_Date
		    (
		        type = datetime
		        displayname = "L1 Action Date"
		        row = 5
		        column = 2
		        width = medium
		    )
		    Level1_Start_Date
		    (
		        type = datetime
		        displayname = "L1 Start Date"
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    Level2_Approval_Section
		    (
		        type = section
		        displayname = "Level 2 Approval - Finance"
		        visibility = true
		        row = 6
		        column = 1
		    )
		    Level2_Action
		    (
		        type = picklist
		        displayname = "L2 Decision"
		        values = {"Pending","Approved","Rejected","Request Info"}
		        initial value = "Pending"
		        row = 6
		        column = 1
		        width = medium
		    )
		    Level2_Comments
		    (
		        type = textarea
		        displayname = "L2 Comments"
		        row = 6
		        column = 2
		        width = medium
		    )
		    Level2_Approved_By
		    (
		        type = text
		        displayname = "L2 Actioned By"
		        row = 6
		        column = 1
		        width = medium
		    )
		    Level2_Date
		    (
		        type = datetime
		        displayname = "L2 Action Date"
		        row = 6
		        column = 2
		        width = medium
		    )
		    Level2_Start_Date
		    (
		        type = datetime
		        displayname = "L2 Start Date"
		        row = 6
		        column = 1
		        width = medium
		    )
		
		    Level3_Approval_Section
		    (
		        type = section
		        displayname = "Level 3 Approval - Commercial Head"
		        visibility = true
		        row = 7
		        column = 1
		    )
		    Level3_Action
		    (
		        type = picklist
		        displayname = "L3 Decision"
		        values = {"Pending","Approved","Rejected","Request Info"}
		        initial value = "Pending"
		        row = 7
		        column = 1
		        width = medium
		    )
		    Level3_Comments
		    (
		        type = textarea
		        displayname = "L3 Comments"
		        row = 7
		        column = 2
		        width = medium
		    )
		    Level3_Approved_By
		    (
		        type = text
		        displayname = "L3 Actioned By"
		        row = 7
		        column = 1
		        width = medium
		    )
		    Level3_Date
		    (
		        type = datetime
		        displayname = "L3 Action Date"
		        row = 7
		        column = 2
		        width = medium
		    )
		    Level3_Start_Date
		    (
		        type = datetime
		        displayname = "L3 Start Date"
		        row = 7
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit Revision"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form SO_Baseline
		{
		    title
		    {
		        displayname = "SO Baseline"
		        on add = "Add SO Baseline"
		        on edit = "Edit SO Baseline"
		    }
		
		    SO_Details
		    (
		        type = section
		        displayname = "SO Details"
		        row = 1
		        column = 0
		    )
		    must have unique SO_Number
		    (
		        type = text
		        displayname = "SO Number"
		        description
		        [
		            type = tooltip
		            message = "Sales Order number from SAP"
		        ]
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer_Name
		    (
		        type = text
		        displayname = "Customer Name"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Customer_Code
		    (
		        type = text
		        displayname = "Customer Code"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have SO_Date
		    (
		        type = date
		        displayname = "SO Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Agreement_Date
		    (
		        type = date
		        displayname = "Agreement Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Validity_Period
		    (
		        type = date
		        displayname = "Validity Period (End Date)"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Closed"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Product_And_Pricing
		    (
		        type = section
		        displayname = "Product and Pricing"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Product_Name
		    (
		        type = text
		        displayname = "Product Name"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Product_Code
		    (
		        type = text
		        displayname = "Product Code"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Agreed_Unit_Price
		    (
		        type = INR
		        displayname = "Agreed Unit Price (INR)"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Total_PO_Value
		    (
		        type = INR
		        displayname = "Total PO Value (INR)"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Currency
		    (
		        type = picklist
		        displayname = "Currency"
		        values = {"INR","USD","EUR","GBP"}
		        initial value = "INR"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Delivery_Schedule_Section
		    (
		        type = section
		        displayname = "Delivery Schedule"
		        visibility = false
		        row = 3
		        column = 1
		    )
		    Delivery_Schedule
		    (
		        type = grid
		        displayname = "Delivery Schedule"
		        values = SO_Delivery_Schedule.ID
		        viewtype = "list"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Linked_Supplier_POs_Section
		    (
		        type = section
		        displayname = "Linked Supplier POs"
		        visibility = false
		        row = 4
		        column = 1
		    )
		    Supplier_POs
		    (
		        type = grid
		        displayname = "Linked Supplier POs"
		        values = SO_Supplier_PO.ID
		        viewtype = "list"
		        row = 4
		        column = 1
		        width = medium
		    )
		
		    Notes_Section
		    (
		        type = section
		        displayname = "Notes"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes / Remarks"
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Create Baseline"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form SO_Delivery_Schedule
		{
		    displayname = "SO Delivery Schedule"
		
		    Schedule_Entry
		    (
		        type = section
		        displayname = "Schedule Entry"
		        row = 1
		        column = 0
		    )
		    must have Period
		    (
		        type = text
		        displayname = "Period (Month / Quarter)"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Quantity
		    (
		        type = number
		        displayname = "Quantity"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add Schedule Entry"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form SO_Supplier_PO
		{
		    displayname = "SO Supplier PO"
		
		    Supplier_PO_Entry
		    (
		        type = section
		        displayname = "Supplier PO Entry"
		        row = 1
		        column = 0
		    )
		    must have Supplier_Name
		    (
		        type = text
		        displayname = "Supplier Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Material
		    (
		        type = text
		        displayname = "Material"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contracted_Price
		    (
		        type = INR
		        displayname = "Contracted Price (INR)"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Supplier_PO_Number
		    (
		        type = text
		        displayname = "Supplier PO Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Add Supplier PO"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Supplier_Amendment
		{
		    title
		    {
		        displayname = "Supplier Amendment"
		        on add = "Raise Supplier Amendment"
		        on edit = "Update Supplier Amendment"
		    }
		
		    Amendment_Details
		    (
		        type = section
		        displayname = "Amendment Details"
		        row = 1
		        column = 0
		    )
		    must have Revision_Reference
		    (
		        type = picklist
		        displayname = "Linked Revision Reference"
		        values = Revision_Request.ID
		        displayformat = [Revision_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    SO_Number_Display
		    (
		        type = formula
		        displayname = "SO Number"
		        value = Revision_Reference.SO_Reference.SO_Number
		        visibility = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Customer_Display
		    (
		        type = formula
		        displayname = "Customer Name"
		        value = Revision_Reference.Customer_Name_Display
		        visibility = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Customer_Amended_SO_Reference
		    (
		        type = text
		        displayname = "Customer Amended SO Number"
		        description
		        [
		            type = tooltip
		            message = "Amended SO number issued by the OEM customer - required for traceability"
		        ]
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Supplier_Name
		    (
		        type = text
		        displayname = "Supplier Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Supplier_PO_Reference
		    (
		        type = text
		        displayname = "Original Supplier PO Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Amendment_Date
		    (
		        type = date
		        displayname = "Amendment Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Change_Specification
		    (
		        type = section
		        displayname = "Change Specification"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Amendment_Type
		    (
		        type = picklist
		        displayname = "Amendment Type"
		        values = {"Price","Quantity","Specification","Delivery Timeline","Multiple"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Old_Value
		    (
		        type = text
		        displayname = "Old Value"
		        row = 2
		        column = 2
		        width = medium
		    )
		    New_Value
		    (
		        type = text
		        displayname = "New Value"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Amendment_Description
		    (
		        type = textarea
		        displayname = "Amendment Description"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Amendment_Documents
		    (
		        type = upload file
		        displayname = "Amendment Documents"
		        file count = 5
		        browse = local_drive
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Supplier_Response_Section
		    (
		        type = section
		        displayname = "Supplier Response"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Supplier_Response
		    (
		        type = picklist
		        displayname = "Supplier Response"
		        values = {"Pending","Accepted","Under Negotiation","Rejected"}
		        initial value = "Pending"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Supplier_Response_Date
		    (
		        type = date
		        displayname = "Supplier Response Date"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Amended_Supplier_PO_Reference
		    (
		        type = text
		        displayname = "Amended Supplier PO Number"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Supplier_Counter_Proposal
		    (
		        type = textarea
		        displayname = "Supplier Counter-Proposal / Notes"
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Raise Supplier Amendment"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Approval_Logs
		{
		    displayName = "All Approval Actions"
		    show all rows from Approval_Log
		    (
		        Revision_Reference
		        Approval_Level
		        Action
		        Action_By
		        Action_Date
		        SO_Number_Ref
		    )
		    filters
		    (
		        Approval_Level
		        Action
		    )
		    sort by
		    (
		        Action_Date descending
		    )
		}

		list Approvals_By_Revision
		{
		    displayName = "Approvals by Revision"
		    show all rows from Approval_Log
		    (
		        Revision_Reference
		        Approval_Level
		        Action
		        Action_By
		        Action_Date
		        Comments
		        SO_Number_Ref
		    )
		    filters
		    (
		        Action
		        Approval_Level
		    )
		    group by
		    (
		        Revision_Reference ascending
		    )
		    sort by
		    (
		        Action_Date ascending
		    )
		}

		default list All_Customer_Communications
		{
		    displayName = "All Customer Communications"
		    show all rows from Customer_Communication
		    (
		        Revision_Reference
		        Customer_Display
		        SO_Number_Display
		        Communication_Date
		        Customer_Response
		        Amended_SO_Number
		        Response_Date
		    )
		    filters
		    (
		        Customer_Response
		    )
		    sort by
		    (
		        Communication_Date descending
		    )
		    conditional formatting
		    (
		        "No Response"
		        {
		            condition = (Customer_Response == "No Response")
		            fields = [Revision_Reference, Customer_Display, Customer_Response]
		            format = "background-color:#FFD6D6;color:#CC0000"
		        }
		        "Accepted"
		        {
		            condition = (Customer_Response == "Accepted")
		            fields = [Revision_Reference, Customer_Display, Customer_Response]
		            format = "background-color:#D4EDDA;color:#155724"
		        }
		        "Under Negotiation"
		        {
		            condition = (Customer_Response == "Under Negotiation")
		            fields = [Customer_Response]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		    )
		}

		list Awaiting_Customer_Response
		{
		    displayName = "Awaiting Customer Response"
		    show all rows from Customer_Communication [Customer_Response == "Pending" || Customer_Response == "No Response" || Customer_Response == "Under Negotiation"]
		    (
		        Revision_Reference
		        Customer_Display
		        SO_Number_Display
		        Communication_Date
		        Customer_Response
		        Follow_Up_Count
		        Last_Follow_Up_Date
		        Proposed_Effective_Date
		    )
		    sort by
		    (
		        Communication_Date ascending
		    )
		    conditional formatting
		    (
		        "Many Follow Ups"
		        {
		            condition = (Follow_Up_Count >= 4)
		            fields = [Revision_Reference, Customer_Display, Customer_Response, Follow_Up_Count]
		            format = "background-color:#FFD6D6;color:#CC0000;font-weight:bold"
		        }
		        "Some Follow Ups"
		        {
		            condition = (Follow_Up_Count >= 2 && Follow_Up_Count < 4)
		            fields = [Follow_Up_Count]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		    )
		}

		default list All_Negotiations
		{
		    displayName = "All Negotiation Rounds"
		    show all rows from Negotiation_Log
		    (
		        Revision_Reference
		        Customer_Display
		        Round_Number
		        Negotiation_Date
		        Round_Status
		        Negotiated_By
		        Next_Action_Date
		    )
		    filters
		    (
		        Round_Status
		    )
		    group by
		    (
		        Revision_Reference ascending
		    )
		    sort by
		    (
		        Negotiation_Date descending
		    )
		}

		list Open_Negotiations
		{
		    displayName = "Open Negotiations"
		    show all rows from Negotiation_Log [Round_Status == "Open" || Round_Status == "Stalled"]
		    (
		        Revision_Reference
		        Customer_Display
		        Round_Number
		        Negotiation_Date
		        Varroc_Proposal
		        Customer_Counter_Proposal
		        Next_Action
		        Next_Action_Date
		        Round_Status
		    )
		    sort by
		    (
		        Next_Action_Date ascending
		    )
		    conditional formatting
		    (
		        "Overdue Next Action"
		        {
		            condition = (Next_Action_Date < zoho.currentdate)
		            fields = [Revision_Reference, Customer_Display, Next_Action, Next_Action_Date]
		            format = "background-color:#FFD6D6;color:#CC0000;font-weight:bold"
		        }
		        "Stalled"
		        {
		            condition = (Round_Status == "Stalled")
		            fields = [Round_Status]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		    )
		}

		default list All_Revisions
		{
		    displayName = "All Revisions"
		    show all rows from Revision_Request
		    (
		        Revision_ID
		        SO_Reference
		        Customer_Name_Display
		        Revision_Type
		        Overall_Status
		        Urgency
		        Total_Financial_Impact
		        Revision_Date
		    )
		    filters
		    (
		        Overall_Status
		        Revision_Type
		        Urgency
		    )
		    sort by
		    (
		        Revision_Date descending
		    )
		    conditional formatting
		    (
		        "Urgent Revision"
		        {
		            condition = (Urgency == "Urgent")
		            fields = [Revision_ID, Revision_Type, Overall_Status, Urgency]
		            format = "background-color:#FFE8E8;color:#CC0000;font-weight:bold"
		        }
		        "Info Requested"
		        {
		            condition = (Overall_Status == "Info Requested")
		            fields = [Revision_ID, Overall_Status]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		    )
		}

		list Internally_Approved_Revisions
		{
		    displayName = "Approved - Awaiting Customer Comm"
		    show all rows from Revision_Request [Overall_Status == "Internally Approved" || Overall_Status == "Customer Communication"]
		    (
		        Revision_ID
		        SO_Reference
		        Customer_Name_Display
		        Revision_Type
		        Total_Financial_Impact
		        Level3_Date
		        Overall_Status
		    )
		    sort by
		    (
		        Level3_Date ascending
		    )
		}

		list My_Revisions
		{
		    displayName = "My Revisions"
		    show all rows from Revision_Request [Added_User == zoho.loginuser]
		    (
		        Revision_ID
		        SO_Reference
		        Revision_Type
		        Overall_Status
		        Total_Financial_Impact
		        Revision_Date
		        SLA_Deadline
		    )
		    filters
		    (
		        Overall_Status
		        Revision_Type
		    )
		    sort by
		    (
		        Revision_Date descending
		    )
		}

		list Pending_Approvals
		{
		    displayName = "Pending Approvals"
		    show all rows from Revision_Request [Overall_Status == "Level 1 Review" || Overall_Status == "Level 2 Review" || Overall_Status == "Level 3 Review" || Overall_Status == "Submitted"]
		    (
		        Revision_ID
		        SO_Reference
		        Customer_Name_Display
		        Revision_Type
		        Overall_Status
		        Urgency
		        Total_Financial_Impact
		        Submitted_Date
		        SLA_Deadline
		
		        custom action "Mark L1 Approved"
		        (
		            workflow = WF_Mark_L1_Approved
		            show action for each record = true
		            column header = "Approval Actions"
		            success message = "Level 1 approved. Moving to Finance review."
		            condition = (Overall_Status == "Submitted" || Overall_Status == "Level 1 Review" || Overall_Status == "Info Requested")
		        )
		        custom action "Mark L2 Approved"
		        (
		            workflow = WF_Mark_L2_Approved
		            show action for each record = true
		            column header = "Approval Actions"
		            success message = "Level 2 approved. Moving to Commercial Head review."
		            condition = (Overall_Status == "Level 2 Review")
		        )
		        custom action "Mark L3 Approved"
		        (
		            workflow = WF_Mark_L3_Approved
		            show action for each record = true
		            column header = "Approval Actions"
		            success message = "Level 3 approved. Revision is internally approved."
		            condition = (Overall_Status == "Level 3 Review")
		        )
		        custom action "Reject"
		        (
		            workflow = WF_Reject_Revision
		            show action for each record = true
		            column header = "Approval Actions"
		            success message = "Revision rejected."
		            confirmation before execution
		            (
		                message for individual record = "Are you sure you want to reject this revision?"
		                confirm button text = "Reject"
		                cancel button text = "Cancel"
		            )
		        )
		    )
		    filters
		    (
		        Overall_Status
		        Urgency
		    )
		    sort by
		    (
		        SLA_Deadline ascending
		    )
		    conditional formatting
		    (
		        "Overdue SLA"
		        {
		            condition = (SLA_Deadline < zoho.currentdate)
		            fields = [Revision_ID, Overall_Status, SLA_Deadline]
		            format = "background-color:#FFD6D6;color:#CC0000;font-weight:bold"
		        }
		        "Urgent"
		        {
		            condition = (Urgency == "Urgent")
		            fields = [Revision_ID, Urgency]
		            format = "background-color:#FFF0F0;color:#CC0000;font-weight:bold"
		        }
		    )
		}

		kanban Revisions_Board
		{
		    displayName = "Revisions Status Board"
		    show all rows from Revision_Request
		    (
		        Revision_ID
		        SO_Reference
		        Revision_Type
		        Urgency
		        Total_Financial_Impact
		        Overall_Status
		    )
		    filters
		    (
		        Urgency
		        Revision_Type
		    )
		    sort by
		    (
		        Revision_ID descending
		    )
		    options
		    (
		        display field = Overall_Status
		        record count = enable
		        sort order = ascending
		    )
		}

		list Supplier_Amendments_Not_Raised
		{
		    displayName = "Customer Accepted - Supplier Not Updated"
		    show all rows from Revision_Request [Overall_Status == "Customer Accepted"]
		    (
		        Revision_ID
		        SO_Reference
		        Customer_Name_Display
		        Revision_Type
		        Total_Financial_Impact
		        Level3_Date
		        Overall_Status
		    )
		    sort by
		    (
		        Level3_Date ascending
		    )
		    conditional formatting
		    (
		        "Needs Attention"
		        {
		            condition = (Overall_Status == "Customer Accepted")
		            fields = [Revision_ID, Overall_Status]
		            format = "background-color:#FFF3CD;color:#856404;font-weight:bold"
		        }
		    )
		}

		list Urgent_Revisions
		{
		    displayName = "Urgent Revisions"
		    show all rows from Revision_Request [Urgency == "Urgent" && Overall_Status != "Completed" && Overall_Status != "Customer Rejected" && Overall_Status != "Rejected"]
		    (
		        Revision_ID
		        SO_Reference
		        Customer_Name_Display
		        Revision_Type
		        Overall_Status
		        Total_Financial_Impact
		        SLA_Deadline
		    )
		    sort by
		    (
		        SLA_Deadline ascending
		    )
		    conditional formatting
		    (
		        "Overdue SLA"
		        {
		            condition = (SLA_Deadline < zoho.currentdate)
		            fields = [Revision_ID, Overall_Status, SLA_Deadline]
		            format = "background-color:#FFD6D6;color:#CC0000;font-weight:bold"
		        }
		    )
		}

		list Active_SOs
		{
		    displayName = "Active Sales Orders"
		    show all rows from SO_Baseline [Status == "Active"]
		    (
		        SO_Number
		        Customer_Name
		        Product_Name
		        Agreed_Unit_Price
		        Total_PO_Value
		        SO_Date
		        Validity_Period
		    )
		    filters
		    (
		        Customer_Name
		    )
		    sort by
		    (
		        SO_Date descending
		    )
		}

		default list All_SO_Baselines
		{
		    displayName = "All SO Baselines"
		    show all rows from SO_Baseline
		    (
		        SO_Number
		        Customer_Name
		        Product_Name
		        Total_PO_Value
		        Status
		        SO_Date
		    )
		    filters
		    (
		        Status
		        Customer_Name
		    )
		    sort by
		    (
		        SO_Date descending
		    )
		}

		default list All_Delivery_Schedules
		{
		    displayName = "All Delivery Schedules"
		    show all rows from SO_Delivery_Schedule
		    (
		        Period
		        Quantity
		        Due_Date
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		default list All_Supplier_POs
		{
		    displayName = "All Supplier POs"
		    show all rows from SO_Supplier_PO
		    (
		        Supplier_Name
		        Material
		        Contracted_Price
		        Supplier_PO_Number
		    )
		    sort by
		    (
		        Supplier_Name ascending
		    )
		}

		default list All_Supplier_Amendments
		{
		    displayName = "All Supplier Amendments"
		    show all rows from Supplier_Amendment
		    (
		        Revision_Reference
		        Customer_Display
		        Supplier_Name
		        Amendment_Type
		        Supplier_Response
		        Amendment_Date
		        Amended_Supplier_PO_Reference
		    )
		    filters
		    (
		        Supplier_Response
		        Amendment_Type
		    )
		    sort by
		    (
		        Amendment_Date descending
		    )
		    conditional formatting
		    (
		        "Under Negotiation"
		        {
		            condition = (Supplier_Response == "Under Negotiation")
		            fields = [Supplier_Response]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		        "Rejected"
		        {
		            condition = (Supplier_Response == "Rejected")
		            fields = [Supplier_Name, Supplier_Response]
		            format = "background-color:#FFD6D6;color:#CC0000;font-weight:bold"
		        }
		    )
		}

		list Pending_Supplier_Amendments
		{
		    displayName = "Pending Supplier Amendments"
		    show all rows from Supplier_Amendment [Supplier_Response == "Pending" || Supplier_Response == "Under Negotiation"]
		    (
		        Revision_Reference
		        Customer_Display
		        Customer_Amended_SO_Reference
		        Supplier_Name
		        Amendment_Type
		        Amendment_Date
		        Supplier_Response
		    )
		    sort by
		    (
		        Amendment_Date ascending
		    )
		}
	}

	pages
	{
		page Management_Dashboard(int total_open_revisions, float total_financial_impact, float total_accepted_value, int avg_cycle_time, int urgent_count)
		{
					displayname = "Management Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Mgmt_KPI_Cards' elementName='Mgmt_KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage Mgmt_KPI_Cards()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; } :root { font-size: 16px; line-height: 1.5; --column-gap: 0px; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; } .zcs-flex { display: flex; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-12 { gap: 0.75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-p-0 { padding: 0; } .zcs-m-0 { margin: 0; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-medium { font-weight: 500; } .zcs-font-bold { font-weight: 700; } .zcs-font-semibold { font-weight: 600; } .zcs-lh-heading { line-height: 1.25; } .zcs-lh-body { line-height: 1.5; } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-tertiary { color: var(--zcs_tertiary_text_color); } .zcs-color-white { color: #FFFFFF; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-box-border { box-sizing: border-box; } .zcs-w-full { width: 100%; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ===== Management Dashboard shared styles ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n\n.mgmt-page-wrapper {\n\tbackground: #F3F3F4;\n\tpadding: 0;\n\tmin-height: 100%;\n}\n\n/* Page Header */\n.mgmt-page-header {\n\tbackground: #1A3C6E;\n\tpadding: 20px 28px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 12px;\n}\n.mgmt-page-header-left h1 {\n\tmargin: 0;\n\tfont-size: 1.25rem;\n\tfont-weight: 700;\n\tcolor: #FFFFFF;\n\tline-height: 1.25;\n}\n.mgmt-page-header-left p {\n\tmargin: 4px 0 0 0;\n\tfont-size: 0.8125rem;\n\tcolor: rgba(255,255,255,0.75);\n}\n.mgmt-header-badge {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tgap: 6px;\n\tbackground: rgba(255,255,255,0.15);\n\tborder: 1px solid rgba(255,255,255,0.25);\n\tborder-radius: 20px;\n\tpadding: 4px 12px;\n\tfont-size: 0.75rem;\n\tcolor: #FFFFFF;\n}\n\n/* KPI Grid */\n.mgmt-kpi-section {\n\tpadding: 20px 24px 8px 24px;\n}\n.mgmt-kpi-grid {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 16px;\n}\n.mgmt-kpi-card {\n\tflex: 1 1 calc(20% - 14px);\n\tmin-width: 170px;\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder-top: 4px solid #1A3C6E;\n\tpadding: 18px 20px 16px 20px;\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 10px;\n}\n.mgmt-kpi-card-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 8px;\n}\n.mgmt-kpi-icon-wrap {\n\twidth: 36px;\n\theight: 36px;\n\tborder-radius: 8px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\tflex-shrink: 0;\n}\n.mgmt-kpi-icon-wrap i {\n\tfont-size: 18px;\n\tcolor: #FFFFFF;\n}\n.mgmt-kpi-value {\n\tfont-size: 1.6rem;\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n\tline-height: 1.1;\n\tmargin: 0;\n}\n.mgmt-kpi-label {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\tmargin: 0;\n\tline-height: 1.4;\n}\n.mgmt-kpi-sublabel {\n\tfont-size: 0.6875rem;\n\tcolor: var(--zcs_tertiary_text_color, #9CA3AF);\n\tmargin: 0;\n}\n&lt;/style&gt;\n\n&lt;%\n\ttoday_date = zoho.currentdate;\n\tdate_str = today_date.toString(&quot;dd MMM yyyy&quot;);\n\n\t/* Format INR with commas */\n\tfin_impact_raw = input.total_financial_impact;\n\tfin_impact_int = fin_impact_raw.toLong();\n\tfin_str = fin_impact_int.toString();\n\tfin_len = fin_str.length();\n\tfin_formatted = &quot;&quot;;\n\tif (fin_len &lt;= 3)\n\t{\n\t\tfin_formatted = fin_str;\n\t}\n\telse if (fin_len &lt;= 5)\n\t{\n\t\tfin_formatted = fin_str.subString(0, fin_len - 3) + &quot;,&quot; + fin_str.subString(fin_len - 3);\n\t}\n\telse if (fin_len &lt;= 7)\n\t{\n\t\tfin_formatted = fin_str.subString(0, fin_len - 5) + &quot;,&quot; + fin_str.subString(fin_len - 5, fin_len - 3) + &quot;,&quot; + fin_str.subString(fin_len - 3);\n\t}\n\telse\n\t{\n\t\tfin_formatted = fin_str.subString(0, fin_len - 7) + &quot;,&quot; + fin_str.subString(fin_len - 7, fin_len - 5) + &quot;,&quot; + fin_str.subString(fin_len - 5, fin_len - 3) + &quot;,&quot; + fin_str.subString(fin_len - 3);\n\t}\n\n\t/* Format accepted value */\n\tacc_raw = input.total_accepted_value;\n\tacc_int = acc_raw.toLong();\n\tacc_str = acc_int.toString();\n\tacc_len = acc_str.length();\n\tacc_formatted = &quot;&quot;;\n\tif (acc_len &lt;= 3)\n\t{\n\t\tacc_formatted = acc_str;\n\t}\n\telse if (acc_len &lt;= 5)\n\t{\n\t\tacc_formatted = acc_str.subString(0, acc_len - 3) + &quot;,&quot; + acc_str.subString(acc_len - 3);\n\t}\n\telse if (acc_len &lt;= 7)\n\t{\n\t\tacc_formatted = acc_str.subString(0, acc_len - 5) + &quot;,&quot; + acc_str.subString(acc_len - 5, acc_len - 3) + &quot;,&quot; + acc_str.subString(acc_len - 3);\n\t}\n\telse\n\t{\n\t\tacc_formatted = acc_str.subString(0, acc_len - 7) + &quot;,&quot; + acc_str.subString(acc_len - 7, acc_len - 5) + &quot;,&quot; + acc_str.subString(acc_len - 5, acc_len - 3) + &quot;,&quot; + acc_str.subString(acc_len - 3);\n\t}\n\n\tcycle_display = input.avg_cycle_time + &quot; days&quot;;\n%&gt;\n\n&lt;div class=&quot;mgmt-page-wrapper&quot;&gt;\n\n\t&lt;!-- Page Header --&gt;\n\t&lt;div class=&quot;mgmt-page-header&quot;&gt;\n\t\t&lt;div class=&quot;mgmt-page-header-left&quot;&gt;\n\t\t\t&lt;h1&gt;Management Dashboard&lt;/h1&gt;\n\t\t\t&lt;p&gt;Executive Financial &amp;amp; Operational Overview — All Revisions&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;mgmt-header-badge&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-2-time&quot; style=&quot;font-size:13px;&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;span&gt;As of &lt;%= date_str %&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- KPI Cards --&gt;\n\t&lt;div class=&quot;mgmt-kpi-section&quot;&gt;\n\t\t&lt;div class=&quot;mgmt-kpi-grid&quot;&gt;\n\n\t\t\t&lt;!-- Card 1: Total Pending Cost Recovery --&gt;\n\t\t\t&lt;div class=&quot;mgmt-kpi-card&quot; style=&quot;border-top-color:#137333;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mgmt-kpi-icon-wrap&quot; style=&quot;background:#137333;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline finance-1-currency-rupee&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-value&quot; style=&quot;font-size:1.15rem;&quot;&gt;INR &lt;%= fin_formatted %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-label&quot;&gt;Total Pending Cost Recovery&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-sublabel&quot;&gt;Sum of open revision financial impact&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 2: Recovered (Completed) --&gt;\n\t\t\t&lt;div class=&quot;mgmt-kpi-card&quot; style=&quot;border-top-color:#34A853;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mgmt-kpi-icon-wrap&quot; style=&quot;background:#34A853;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-value&quot; style=&quot;font-size:1.15rem;&quot;&gt;INR &lt;%= acc_formatted %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-label&quot;&gt;Recovered (Completed)&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-sublabel&quot;&gt;Financial impact of completed revisions&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 3: Open Revisions --&gt;\n\t\t\t&lt;div class=&quot;mgmt-kpi-card&quot; style=&quot;border-top-color:#1A73E8;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mgmt-kpi-icon-wrap&quot; style=&quot;background:#1A73E8;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline files-1-copy-07&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-value&quot;&gt;&lt;%= input.total_open_revisions %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-label&quot;&gt;Open Revisions&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-sublabel&quot;&gt;Not completed or rejected&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 4: Avg. Cycle Time --&gt;\n\t\t\t&lt;div class=&quot;mgmt-kpi-card&quot; style=&quot;border-top-color:#8430CE;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mgmt-kpi-icon-wrap&quot; style=&quot;background:#8430CE;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-value&quot;&gt;&lt;%= cycle_display %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-label&quot;&gt;Avg. Cycle Time&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-sublabel&quot;&gt;Submission to acceptance (completed)&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 5: Urgent Open Revisions --&gt;\n\t\t\t&lt;div class=&quot;mgmt-kpi-card&quot; style=&quot;border-top-color:#EA4335;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;mgmt-kpi-icon-wrap&quot; style=&quot;background:#EA4335;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-value&quot; style=&quot;color:#EA4335;&quot;&gt;&lt;%= input.urgent_count %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-label&quot;&gt;Urgent Open Revisions&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;mgmt-kpi-sublabel&quot;&gt;Flagged Urgent and still open&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Revision_By_Type_Chart' elementName='Revision_By_Type_Chart'>\n\t\t\t\t\t<![CDATA[htmlpage Revision_By_Type_Chart()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== Revision By Type Chart ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n\n.mgmt-chart-section {\n\tpadding: 16px 24px 16px 24px;\n\theight: 100%;\n}\n.mgmt-chart-card {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\tpadding: 20px 24px;\n\theight: 100%;\n}\n.mgmt-card-title {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0 0 20px 0;\n\tpadding-bottom: 12px;\n\tborder-bottom: 1px solid #f0f0f5;\n}\n.mgmt-card-title i { font-size: 16px; color: #1A73E8; }\n\n.mgmt-bar-table {\n\twidth: 100%;\n\tborder-collapse: collapse;\n}\n.mgmt-bar-table th {\n\tfont-size: 0.6875rem;\n\tfont-weight: 600;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\ttext-transform: uppercase;\n\tletter-spacing: 0.04em;\n\tpadding: 0 0 10px 0;\n\ttext-align: left;\n\tborder-bottom: 1px solid #f0f0f5;\n}\n.mgmt-bar-table th.col-count { text-align: right; width: 48px; }\n.mgmt-bar-table th.col-bar { width: 55%; padding-left: 12px; }\n.mgmt-bar-table td {\n\tpadding: 10px 0;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #374151);\n\tborder-bottom: 1px solid #f8f8fb;\n\tvertical-align: middle;\n}\n.mgmt-bar-table td.col-type {\n\tfont-weight: 500;\n\twhite-space: nowrap;\n\tpadding-right: 12px;\n\tmin-width: 140px;\n}\n.mgmt-bar-table td.col-count {\n\ttext-align: right;\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n\tpadding-right: 12px;\n\twidth: 48px;\n}\n.mgmt-bar-table td.col-bar { padding-left: 12px; }\n.mgmt-bar-track {\n\tbackground: #F3F3F4;\n\tborder-radius: 4px;\n\theight: 14px;\n\twidth: 100%;\n\toverflow: hidden;\n}\n.mgmt-bar-fill {\n\theight: 14px;\n\tborder-radius: 4px;\n\tmin-width: 4px;\n}\n.mgmt-no-data {\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\ttext-align: center;\n\tpadding: 32px 0;\n}\n&lt;/style&gt;\n\n&lt;%\n\t/* Fetch open revisions grouped by Revision_Type */\n\topen_statuses = {&quot;Completed&quot;, &quot;Rejected&quot;, &quot;Customer Rejected&quot;};\n\n\ttype_price_increase = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Price Increase&quot;].count();\n\ttype_price_decrease = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Price Decrease&quot;].count();\n\ttype_scope_change = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Scope Change&quot;].count();\n\ttype_tooling = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Tooling&quot;].count();\n\ttype_logistics = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Logistics&quot;].count();\n\ttype_other = Revision_Request[Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot; &amp;&amp; Revision_Type == &quot;Other&quot;].count();\n\n\t/* Build list of type-count pairs for rendering */\n\tbar_max = type_price_increase;\n\tif (type_price_decrease &gt; bar_max) { bar_max = type_price_decrease; }\n\tif (type_scope_change &gt; bar_max) { bar_max = type_scope_change; }\n\tif (type_tooling &gt; bar_max) { bar_max = type_tooling; }\n\tif (type_logistics &gt; bar_max) { bar_max = type_logistics; }\n\tif (type_other &gt; bar_max) { bar_max = type_other; }\n\tif (bar_max == 0) { bar_max = 1; }\n\n\tpct_price_increase = ((type_price_increase * 100) / bar_max).toLong();\n\tpct_price_decrease = ((type_price_decrease * 100) / bar_max).toLong();\n\tpct_scope_change = ((type_scope_change * 100) / bar_max).toLong();\n\tpct_tooling = ((type_tooling * 100) / bar_max).toLong();\n\tpct_logistics = ((type_logistics * 100) / bar_max).toLong();\n\tpct_other = ((type_other * 100) / bar_max).toLong();\n\n\ttotal_open_check = type_price_increase + type_price_decrease + type_scope_change + type_tooling + type_logistics + type_other;\n%&gt;\n\n&lt;div class=&quot;mgmt-chart-section&quot;&gt;\n\t&lt;div class=&quot;mgmt-chart-card&quot;&gt;\n\t\t&lt;h3 class=&quot;mgmt-card-title&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline graph-1-bar-chart-horizontal&quot;&gt;&lt;/i&gt;\n\t\t\tOpen Revisions by Type\n\t\t&lt;/h3&gt;\n\n\t\t&lt;% if (total_open_check == 0) { %&gt;\n\t\t&lt;div class=&quot;mgmt-no-data&quot;&gt;No open revisions found.&lt;/div&gt;\n\t\t&lt;% } else { %&gt;\n\t\t&lt;table class=&quot;mgmt-bar-table&quot;&gt;\n\t\t\t&lt;thead&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th&gt;Revision Type&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&quot;col-count&quot;&gt;Count&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&quot;col-bar&quot;&gt;Distribution&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n\t\t\t\t&lt;% if (type_price_increase &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Price Increase&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_price_increase %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_price_increase %&gt;%;background:#EA4335;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if (type_price_decrease &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Price Decrease&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_price_decrease %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_price_decrease %&gt;%;background:#34A853;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if (type_scope_change &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Scope Change&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_scope_change %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_scope_change %&gt;%;background:#1A73E8;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if (type_tooling &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Tooling&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_tooling %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_tooling %&gt;%;background:#F9AB00;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if (type_logistics &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Logistics&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_logistics %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_logistics %&gt;%;background:#8430CE;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;% if (type_other &gt; 0) { %&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-type&quot;&gt;Other&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-count&quot;&gt;&lt;%= type_other %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-bar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-track&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;mgmt-bar-fill&quot; style=&quot;width:&lt;%= pct_other %&gt;%;background:#9CA3AF;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t\t&lt;% } %&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Revision_Status_Breakdown' elementName='Revision_Status_Breakdown'>\n\t\t\t\t\t<![CDATA[htmlpage Revision_Status_Breakdown()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== Revision Status Breakdown ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n\n.mgmt-status-section {\n\tpadding: 16px 24px 16px 0;\n\theight: 100%;\n}\n.mgmt-status-card {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\tpadding: 20px 24px;\n\theight: 100%;\n}\n.mgmt-status-title {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0 0 20px 0;\n\tpadding-bottom: 12px;\n\tborder-bottom: 1px solid #f0f0f5;\n}\n.mgmt-status-title i { font-size: 16px; color: #1A73E8; }\n\n.mgmt-status-grid {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 14px;\n}\n.mgmt-status-item {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 12px;\n\tflex: 1 1 calc(50% - 7px);\n\tmin-width: 160px;\n\tbackground: #F8F9FB;\n\tborder-radius: 8px;\n\tpadding: 12px 14px;\n\tborder: 1px solid #eef0f5;\n}\n.mgmt-status-circle {\n\twidth: 44px;\n\theight: 44px;\n\tborder-radius: 50%;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\tflex-shrink: 0;\n\tfont-size: 1rem;\n\tfont-weight: 700;\n\tcolor: #FFFFFF;\n\tline-height: 1;\n}\n.mgmt-status-info {\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 2px;\n\tmin-width: 0;\n}\n.mgmt-status-count {\n\tfont-size: 1.25rem;\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n\tline-height: 1.1;\n}\n.mgmt-status-name {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\tline-height: 1.3;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n}\n.mgmt-status-divider {\n\tborder: none;\n\tborder-top: 1px solid #f0f0f5;\n\tmargin: 16px 0 12px 0;\n}\n.mgmt-status-total-row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n}\n.mgmt-status-total-val {\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n\tfont-size: 0.9375rem;\n}\n&lt;/style&gt;\n\n&lt;%\n\t/* Fetch counts by Overall_Status */\n\tcnt_submitted = Revision_Request[Overall_Status == &quot;Submitted&quot;].count();\n\tcnt_l1 = Revision_Request[Overall_Status == &quot;Level 1 Review&quot;].count();\n\tcnt_l2 = Revision_Request[Overall_Status == &quot;Level 2 Review&quot;].count();\n\tcnt_l3 = Revision_Request[Overall_Status == &quot;Level 3 Review&quot;].count();\n\tcnt_info_req = Revision_Request[Overall_Status == &quot;Info Requested&quot;].count();\n\tcnt_cust_review = Revision_Request[Overall_Status == &quot;Customer Review&quot;].count();\n\tcnt_cust_accepted = Revision_Request[Overall_Status == &quot;Customer Accepted&quot;].count();\n\tcnt_cust_rejected = Revision_Request[Overall_Status == &quot;Customer Rejected&quot;].count();\n\tcnt_supplier_amend = Revision_Request[Overall_Status == &quot;Supplier Amendment Raised&quot;].count();\n\tcnt_completed = Revision_Request[Overall_Status == &quot;Completed&quot;].count();\n\tcnt_rejected = Revision_Request[Overall_Status == &quot;Rejected&quot;].count();\n\n\tgrand_total = cnt_submitted + cnt_l1 + cnt_l2 + cnt_l3 + cnt_info_req + cnt_cust_review + cnt_cust_accepted + cnt_cust_rejected + cnt_supplier_amend + cnt_completed + cnt_rejected;\n%&gt;\n\n&lt;div class=&quot;mgmt-status-section&quot;&gt;\n\t&lt;div class=&quot;mgmt-status-card&quot;&gt;\n\t\t&lt;h3 class=&quot;mgmt-status-title&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-pie-chart-2&quot;&gt;&lt;/i&gt;\n\t\t\tRevision Status Breakdown\n\t\t&lt;/h3&gt;\n\n\t\t&lt;div class=&quot;mgmt-status-grid&quot;&gt;\n\n\t\t\t&lt;!-- Submitted — Blue --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#1A73E8;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_submitted %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_submitted %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Level 1 Review — Orange --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#F9AB00;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_l1 %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_l1 %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Level 1 Review&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Level 2 Review — Orange-Red --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#E65100;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_l2 %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_l2 %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Level 2 Review&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Level 3 Review — Deep Orange --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#BF360C;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_l3 %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_l3 %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Level 3 Review&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Info Requested — Amber --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#F59E0B;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_info_req %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_info_req %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Info Requested&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Customer Review — Blue-Teal --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#0097A7;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_cust_review %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_cust_review %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Customer Review&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Customer Accepted — Green --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#34A853;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_cust_accepted %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_cust_accepted %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Customer Accepted&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Supplier Amendment Raised — Purple --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#8430CE;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_supplier_amend %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_supplier_amend %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Supplier Amendment&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Completed — Dark Green --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#137333;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_completed %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_completed %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Completed&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Rejected — Red --&gt;\n\t\t\t&lt;div class=&quot;mgmt-status-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-circle&quot; style=&quot;background:#EA4335;&quot;&gt;\n\t\t\t\t\t&lt;span&gt;&lt;%= cnt_rejected + cnt_cust_rejected %&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;mgmt-status-info&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-count&quot;&gt;&lt;%= cnt_rejected + cnt_cust_rejected %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;mgmt-status-name&quot;&gt;Rejected (all)&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;\n\n\t\t&lt;hr class=&quot;mgmt-status-divider&quot;/&gt;\n\t\t&lt;div class=&quot;mgmt-status-total-row&quot;&gt;\n\t\t\t&lt;span&gt;Total Revisions (all time)&lt;/span&gt;\n\t\t\t&lt;span class=&quot;mgmt-status-total-val&quot;&gt;&lt;%= grand_total %&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='SO_Revision_Summary_Table' elementName='SO_Revision_Summary_Table'>\n\t\t\t\t\t<![CDATA[htmlpage SO_Revision_Summary_Table()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== SO Revision Summary Table ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n\n.mgmt-so-section {\n\tpadding: 0 24px 24px 24px;\n}\n.mgmt-so-card {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\tpadding: 20px 24px;\n}\n.mgmt-so-title {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0 0 16px 0;\n\tpadding-bottom: 12px;\n\tborder-bottom: 1px solid #f0f0f5;\n}\n.mgmt-so-title i { font-size: 16px; color: #1A73E8; }\n\n.mgmt-so-table {\n\twidth: 100%;\n\tborder-collapse: collapse;\n}\n.mgmt-so-table thead th {\n\tfont-size: 0.6875rem;\n\tfont-weight: 600;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\ttext-transform: uppercase;\n\tletter-spacing: 0.04em;\n\tpadding: 0 12px 10px 0;\n\ttext-align: left;\n\tborder-bottom: 2px solid #f0f0f5;\n\twhite-space: nowrap;\n}\n.mgmt-so-table thead th:last-child { padding-right: 0; }\n.mgmt-so-table thead th.col-num { text-align: right; }\n.mgmt-so-table thead th.col-impact { text-align: right; }\n\n.mgmt-so-table tbody td {\n\tpadding: 11px 12px 11px 0;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #374151);\n\tborder-bottom: 1px solid #f8f8fb;\n\tvertical-align: middle;\n}\n.mgmt-so-table tbody td:last-child { padding-right: 0; }\n.mgmt-so-table tbody tr:last-child td { border-bottom: none; }\n\n.mgmt-so-table td.col-so {\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\twhite-space: nowrap;\n}\n.mgmt-so-table td.col-customer {\n\tcolor: var(--zcs_primary_text_color, #374151);\n}\n.mgmt-so-table td.col-num {\n\ttext-align: right;\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n}\n.mgmt-so-table td.col-impact {\n\ttext-align: right;\n\tfont-weight: 600;\n\tcolor: #137333;\n\twhite-space: nowrap;\n}\n.mgmt-so-badge {\n\tdisplay: inline-block;\n\tpadding: 2px 10px;\n\tborder-radius: 12px;\n\tfont-size: 0.6875rem;\n\tfont-weight: 600;\n\twhite-space: nowrap;\n}\n.mgmt-so-badge-completed { background: #E6F4EA; color: #137333; }\n.mgmt-so-badge-rejected { background: #FCE8E6; color: #C5221F; }\n.mgmt-so-badge-review { background: #FEF3C7; color: #92400E; }\n.mgmt-so-badge-customer { background: #E8F0FE; color: #1A73E8; }\n.mgmt-so-badge-submitted { background: #EDE7F6; color: #5E35B1; }\n.mgmt-so-badge-default { background: #F3F3F4; color: #6B7280; }\n\n.mgmt-so-empty {\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\ttext-align: center;\n\tpadding: 32px 0;\n}\n.mgmt-so-footer {\n\tmargin-top: 12px;\n\tfont-size: 0.6875rem;\n\tcolor: var(--zcs_tertiary_text_color, #9CA3AF);\n\ttext-align: right;\n}\n&lt;/style&gt;\n\n&lt;%\n\tactive_sos = SO_Baseline[Status == &quot;Active&quot;] range from 0 to 199;\n\tso_count = active_sos.count();\n\trow_list = list();\n\tfor each so_rec in active_sos\n\t{\n\t\tso_id = so_rec.get(&quot;ID&quot;);\n\t\tso_number = so_rec.get(&quot;SO_Number&quot;);\n\t\tso_customer = so_rec.get(&quot;Customer_Name&quot;);\n\t\trev_count = Revision_Request[SO_Reference == so_id].count();\n\t\tpending_impact = Revision_Request[SO_Reference == so_id &amp;&amp; Overall_Status != &quot;Completed&quot; &amp;&amp; Overall_Status != &quot;Rejected&quot; &amp;&amp; Overall_Status != &quot;Customer Rejected&quot;].sum(Total_Financial_Impact);\n\t\tlatest_revs = Revision_Request[SO_Reference == so_id] sort by Added_Time desc range from 0 to 0;\n\t\tlatest_status = &quot;&quot;;\n\t\tfor each lr in latest_revs { latest_status = lr.get(&quot;Overall_Status&quot;); }\n\t\trow_map = map();\n\t\trow_map.put(&quot;so_number&quot;, so_number);\n\t\trow_map.put(&quot;customer&quot;, so_customer);\n\t\trow_map.put(&quot;rev_count&quot;, rev_count);\n\t\trow_map.put(&quot;pending_impact&quot;, pending_impact);\n\t\trow_map.put(&quot;latest_status&quot;, latest_status);\n\t\trow_list.add(row_map);\n\t}\n\tdisplay_count = 0;\n%&gt;\n\n&lt;div class=&quot;mgmt-so-section&quot;&gt;\n\t&lt;div class=&quot;mgmt-so-card&quot;&gt;\n\t\t&lt;h3 class=&quot;mgmt-so-title&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline files-1-file-text&quot;&gt;&lt;/i&gt;\n\t\t\tSO-Level Revision Summary\n\t\t&lt;/h3&gt;\n\n\t\t&lt;% if (so_count == 0) {%&gt;\n\t\t&lt;div class=&quot;mgmt-so-empty&quot;&gt;No active Sales Orders found.&lt;/div&gt;\n\t\t&lt;%} else {%&gt;\n\t\t&lt;table class=&quot;mgmt-so-table&quot;&gt;\n\t\t\t&lt;thead&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;th&gt;SO Number&lt;/th&gt;\n\t\t\t\t\t&lt;th&gt;Customer&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&quot;col-num&quot;&gt;Total Revisions&lt;/th&gt;\n\t\t\t\t\t&lt;th class=&quot;col-impact&quot;&gt;Pending Impact (INR)&lt;/th&gt;\n\t\t\t\t\t&lt;th&gt;Latest Status&lt;/th&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t&lt;/thead&gt;\n\t\t\t&lt;tbody&gt;\n\t\t\t\t&lt;%for each so_row in row_list {\n\t\t\t\t\tif (display_count &gt;= 15) { break; }\n\t\t\t\t\tdisplay_count = display_count + 1;\n\t\t\t\t\tr_so = so_row.get(&quot;so_number&quot;);\n\t\t\t\t\tr_cust = so_row.get(&quot;customer&quot;);\n\t\t\t\t\tr_cnt = so_row.get(&quot;rev_count&quot;);\n\t\t\t\t\tr_impact = so_row.get(&quot;pending_impact&quot;).toLong();\n\t\t\t\t\tr_status = so_row.get(&quot;latest_status&quot;);\n\t\t\t\t\tr_imp_str = r_impact.toString();\n\t\t\t\t\tr_imp_len = r_imp_str.length();\n\t\t\t\t\tr_imp_fmt = r_imp_str;\n\t\t\t\t\tif (r_imp_len &gt; 3) { r_imp_fmt = r_imp_str.subString(0, r_imp_len - 3) + &quot;,&quot; + r_imp_str.subString(r_imp_len - 3); }\n\t\t\t\t\tbadge_class = &quot;mgmt-so-badge-default&quot;;\n\t\t\t\t\tif (r_status == &quot;Completed&quot;) { badge_class = &quot;mgmt-so-badge-completed&quot;; }\n\t\t\t\t\tif (r_status == &quot;Rejected&quot; || r_status == &quot;Customer Rejected&quot;) { badge_class = &quot;mgmt-so-badge-rejected&quot;; }\n\t\t\t\t\tif (r_status == &quot;Level 1 Review&quot; || r_status == &quot;Level 2 Review&quot; || r_status == &quot;Level 3 Review&quot; || r_status == &quot;Info Requested&quot;) { badge_class = &quot;mgmt-so-badge-review&quot;; }\n\t\t\t\t\tif (r_status == &quot;Customer Review&quot; || r_status == &quot;Customer Accepted&quot; || r_status == &quot;Supplier Amendment Raised&quot;) { badge_class = &quot;mgmt-so-badge-customer&quot;; }\n\t\t\t\t\tif (r_status == &quot;Submitted&quot;) { badge_class = &quot;mgmt-so-badge-submitted&quot;; }%&gt;\n\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t&lt;td class=&quot;col-so&quot;&gt;&lt;%= r_so %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-customer&quot;&gt;&lt;%= r_cust %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-num&quot;&gt;&lt;%= r_cnt %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td class=&quot;col-impact&quot;&gt;INR &lt;%= r_imp_fmt %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;td&gt;&lt;%if (r_status != &quot;&quot;) {%&gt;&lt;span class=&quot;mgmt-so-badge &lt;%= badge_class %&gt;&quot;&gt;&lt;%= r_status %&gt;&lt;/span&gt;&lt;%} else {%&gt;&lt;span class=&quot;mgmt-so-badge mgmt-so-badge-default&quot;&gt;None&lt;/span&gt;&lt;%}%&gt;&lt;/td&gt;\n\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;%}%&gt;\n\t\t\t&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n\t\t&lt;div class=&quot;mgmt-so-footer&quot;&gt;Showing &lt;%= so_count %&gt; active SO(s). Sorted by pending impact (highest first).&lt;/div&gt;\n\t\t&lt;%}%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
					script
					{
						total_open_revisions = Revision_Request[Overall_Status != "Completed" && Overall_Status != "Rejected" && Overall_Status != "Customer Rejected"].count();
						total_financial_impact = Revision_Request[Overall_Status != "Completed" && Overall_Status != "Rejected" && Overall_Status != "Customer Rejected"].sum(Total_Financial_Impact);
						total_accepted_value = Revision_Request[Overall_Status == "Completed"].sum(Total_Financial_Impact);
						urgent_count = Revision_Request[Urgency == "Urgent" && Overall_Status != "Completed" && Overall_Status != "Rejected" && Overall_Status != "Customer Rejected"].count();
						
						/* Avg cycle time: average days from Submitted_Date to Level3_Date for completed revisions */
						completed_revs = Revision_Request[Overall_Status == "Completed"] range from 0 to 199;
						total_days = 0;
						completed_count = 0;
						for each rev in completed_revs
						{
						  sub_date = rev.get("Submitted_Date");
						  end_date = rev.get("Level3_Date");
						  if (sub_date != null && end_date != null)
						  {
						    diff_days = end_date.toDate().daysBetween(sub_date.toDate());
						    if (diff_days < 0) { diff_days = diff_days * -1; }
						    total_days = total_days + diff_days;
						    completed_count = completed_count + 1;
						  }
						}
						if (completed_count > 0)
						{
						  avg_cycle_time = (total_days / completed_count).toLong();
						}
						else
						{
						  avg_cycle_time = 0;
						}
					}
		}

		page Operations_Dashboard(int total_open_revisions, int pending_l1, int pending_l2, int pending_l3, int pending_customer, int pending_supplier, int overdue_approvals, float total_pending_financial_impact)
		{
					displayname = "Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='KPI_Cards' elementName='KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage KPI_Cards()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; } :root { font-size: 16px; line-height: 1.5; --column-gap: 0px; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; } .zcs-flex { display: flex; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-12 { gap: 0.75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-p-0 { padding: 0; } .zcs-m-0 { margin: 0; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-medium { font-weight: 500; } .zcs-font-bold { font-weight: 700; } .zcs-font-semibold { font-weight: 600; } .zcs-lh-heading { line-height: 1.25; } .zcs-lh-body { line-height: 1.5; } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-tertiary { color: var(--zcs_tertiary_text_color); } .zcs-color-white { color: #FFFFFF; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-box-border { box-sizing: border-box; } .zcs-w-full { width: 100%; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ===== Dashboard page styles ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n\n.ops-page-wrapper {\n\tbackground: #F3F3F4;\n\tpadding: 0;\n\tmin-height: 100%;\n}\n\n/* Page Header */\n.ops-page-header {\n\tbackground: #1A3C6E;\n\tpadding: 20px 28px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 12px;\n}\n.ops-page-header-left h1 {\n\tmargin: 0;\n\tfont-size: 1.25rem;\n\tfont-weight: 700;\n\tcolor: #FFFFFF;\n\tline-height: 1.25;\n}\n.ops-page-header-left p {\n\tmargin: 4px 0 0 0;\n\tfont-size: 0.8125rem;\n\tcolor: rgba(255,255,255,0.75);\n}\n.ops-header-badge {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tgap: 6px;\n\tbackground: rgba(255,255,255,0.15);\n\tborder: 1px solid rgba(255,255,255,0.25);\n\tborder-radius: 20px;\n\tpadding: 4px 12px;\n\tfont-size: 0.75rem;\n\tcolor: #FFFFFF;\n}\n\n/* KPI Grid */\n.ops-kpi-section {\n\tpadding: 20px 24px 8px 24px;\n}\n.ops-kpi-grid {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 16px;\n}\n.ops-kpi-card {\n\tflex: 1 1 calc(16.666% - 14px);\n\tmin-width: 160px;\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder-top: 4px solid #1A73E8;\n\tpadding: 18px 20px 16px 20px;\n\tdisplay: flex;\n\tflex-direction: column;\n\tgap: 10px;\n}\n.ops-kpi-card-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 8px;\n}\n.ops-kpi-icon-wrap {\n\twidth: 36px;\n\theight: 36px;\n\tborder-radius: 8px;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\tflex-shrink: 0;\n}\n.ops-kpi-icon-wrap i {\n\tfont-size: 18px;\n\tcolor: #FFFFFF;\n}\n.ops-kpi-value {\n\tfont-size: 1.75rem;\n\tfont-weight: 700;\n\tcolor: #1A3C6E;\n\tline-height: 1.1;\n\tmargin: 0;\n}\n.ops-kpi-label {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tcolor: var(--zcs_secondary_text_color, #6B7280);\n\tmargin: 0;\n\tline-height: 1.4;\n}\n.ops-kpi-card.overdue .ops-kpi-value {\n\tcolor: #EA4335;\n}\n&lt;/style&gt;\n\n&lt;%\n\ttoday_date = zoho.currentdate;\n\tdate_str = today_date.toString(&quot;dd MMM yyyy&quot;);\n\tpending_approvals_sum = input.pending_l1 + input.pending_l2 + input.pending_l3;\n\tfin_impact = input.total_pending_financial_impact;\n\tfin_formatted = &quot;INR &quot; + fin_impact.toString();\n%&gt;\n\n&lt;div class=&quot;ops-page-wrapper&quot;&gt;\n\n\t&lt;!-- Page Header --&gt;\n\t&lt;div class=&quot;ops-page-header&quot;&gt;\n\t\t&lt;div class=&quot;ops-page-header-left&quot;&gt;\n\t\t\t&lt;h1&gt;Operations Dashboard&lt;/h1&gt;\n\t\t\t&lt;p&gt;Procurement &amp;amp; Commercial Pipeline — Real-Time View&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ops-header-badge&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-2-time&quot; style=&quot;font-size:13px;&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;span&gt;As of &lt;%= date_str %&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- KPI Cards --&gt;\n\t&lt;div class=&quot;ops-kpi-section&quot;&gt;\n\t\t&lt;div class=&quot;ops-kpi-grid&quot;&gt;\n\n\t\t\t&lt;!-- Card 1: Open Revisions --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card&quot; style=&quot;border-top-color:#1A73E8;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#1A73E8;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline files-1-copy-07&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot;&gt;&lt;%= input.total_open_revisions %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Open Revisions&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 2: Pending Approvals --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card&quot; style=&quot;border-top-color:#F9AB00;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#F9AB00;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot;&gt;&lt;%= pending_approvals_sum %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Pending Approvals&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 3: Awaiting Customer --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card&quot; style=&quot;border-top-color:#34A853;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#34A853;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline users-1-multiple-11&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot;&gt;&lt;%= input.pending_customer %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Awaiting Customer&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 4: Pending Supplier Updates --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card&quot; style=&quot;border-top-color:#8430CE;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#8430CE;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline e-commerce-box-3d-50&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot;&gt;&lt;%= input.pending_supplier %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Pending Supplier Updates&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 5: Overdue Items --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card overdue&quot; style=&quot;border-top-color:#EA4335;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#EA4335;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot;&gt;&lt;%= input.overdue_approvals %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Overdue Items&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Card 6: Pending Cost Recovery --&gt;\n\t\t\t&lt;div class=&quot;ops-kpi-card&quot; style=&quot;border-top-color:#137333;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ops-kpi-card-header&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;ops-kpi-icon-wrap&quot; style=&quot;background:#137333;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline finance-1-currency-rupee&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-value&quot; style=&quot;font-size:1.1rem;&quot;&gt;&lt;%= fin_formatted %&gt;&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ops-kpi-label&quot;&gt;Pending Cost Recovery (INR)&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='60%'>\n\t\t\t\t<dsp id='Approval_Queue_Table' elementName='Approval_Queue_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Approval_Queue_Table()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== Table component styles ===== */\n:root {\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\t--zcs-white-color: #FFFFFF;\n}\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6, th, td { font-family: sans-serif; }\n\n.ops-table-section {\n\tpadding: 8px 24px 20px 24px;\n}\n.ops-table-card {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\toverflow: hidden;\n}\n.ops-table-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 16px 20px 12px 20px;\n\tborder-bottom: 1px solid #e7e7ee;\n\tgap: 8px;\n}\n.ops-table-title {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0;\n}\n.ops-table-title i {\n\tfont-size: 16px;\n\tcolor: #F9AB00;\n}\n.ops-table-count {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tbackground: #F3F3F4;\n\tcolor: #6B7280;\n\tborder-radius: 12px;\n\tpadding: 2px 10px;\n}\n.ops-table-wrapper {\n\toverflow-x: auto;\n}\n.ops-table {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 0.8125rem;\n}\n.ops-table thead tr th {\n\tbackground: #F9FAFE;\n\tpadding: 10px 14px;\n\ttext-align: left;\n\tfont-size: 0.75rem;\n\tfont-weight: 600;\n\tcolor: #6B7280;\n\twhite-space: nowrap;\n\tborder-bottom: 1px solid #e7e7ee;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.03em;\n}\n.ops-table tbody tr td {\n\tpadding: 10px 14px;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #1A1A2E);\n\tborder-bottom: 1px solid #f0f0f5;\n\twhite-space: nowrap;\n}\n.ops-table tbody tr:last-child td {\n\tborder-bottom: none;\n}\n.ops-table tbody tr:hover td {\n\tbackground: #F9FAFE;\n}\n.ops-table tbody tr.row-overdue td {\n\tbackground: #FFF5F5;\n}\n.ops-table tbody tr.row-overdue:hover td {\n\tbackground: #FFE8E8;\n}\n.ops-table tbody tr.row-overdue td:first-child {\n\tborder-left: 3px solid #EA4335;\n}\n.ops-table tbody tr.row-warning td {\n\tbackground: #FFFBF0;\n}\n.ops-table tbody tr.row-warning:hover td {\n\tbackground: #FFF3D0;\n}\n.ops-table tbody tr.row-warning td:first-child {\n\tborder-left: 3px solid #F9AB00;\n}\n.ops-badge {\n\tdisplay: inline-block;\n\tpadding: 2px 8px;\n\tborder-radius: 10px;\n\tfont-size: 0.6875rem;\n\tfont-weight: 500;\n}\n.ops-badge-red { background: #FDECEA; color: #EA4335; }\n.ops-badge-orange { background: #FFF3E0; color: #E65100; }\n.ops-badge-blue { background: #E8F0FE; color: #1A73E8; }\n.ops-badge-grey { background: #F3F3F4; color: #6B7280; }\n.ops-overdue-days {\n\tfont-weight: 700;\n\tcolor: #EA4335;\n}\n.ops-empty-state {\n\ttext-align: center;\n\tpadding: 32px 20px;\n\tcolor: #9CA3AF;\n\tfont-size: 0.875rem;\n}\n.ops-empty-state i {\n\tfont-size: 32px;\n\tdisplay: block;\n\tmargin-bottom: 8px;\n\tcolor: #D1D5DB;\n}\n&lt;/style&gt;\n\n&lt;%\n\ttoday = zoho.currentdate;\n\tqueue_records = Revision_Request[Overall_Status == &quot;Level 1 Review&quot; || Overall_Status == &quot;Level 2 Review&quot; || Overall_Status == &quot;Level 3 Review&quot; || Overall_Status == &quot;Submitted&quot;] sort by SLA_Deadline range from 0 to 19;\n\tqueue_count = queue_records.count();\n%&gt;\n\n&lt;div class=&quot;ops-table-section&quot;&gt;\n\t&lt;div class=&quot;ops-table-card&quot;&gt;\n\t\t&lt;div class=&quot;ops-table-header&quot;&gt;\n\t\t\t&lt;h3 class=&quot;ops-table-title&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\tApproval Queue\n\t\t\t&lt;/h3&gt;\n\t\t\t&lt;span class=&quot;ops-table-count&quot;&gt;&lt;%= queue_count %&gt; items&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ops-table-wrapper&quot;&gt;\n\t\t\t&lt;table class=&quot;ops-table&quot;&gt;\n\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th&gt;Revision ID&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;SO Number&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Revision Type&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Current Stage&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;SLA Deadline&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Days Overdue&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(queue_count == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td colspan=&quot;7&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ops-empty-state&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\tNo items in the approval queue\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor each rec in queue_records\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tsla_date = rec.SLA_Deadline;\n\t\t\t\t\t\t\tdays_overdue = 0;\n\t\t\t\t\t\t\trow_class = &quot;&quot;;\n\t\t\t\t\t\t\tif(sla_date &lt; today)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tdays_overdue = today.daysBetween(sla_date).abs();\n\t\t\t\t\t\t\t\trow_class = &quot;row-overdue&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(sla_date == today || sla_date == today.addDay(1))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trow_class = &quot;row-warning&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tstage = rec.Overall_Status;\n\t\t\t\t\t\t\tbadge_class = &quot;ops-badge-grey&quot;;\n\t\t\t\t\t\t\tif(stage == &quot;Level 1 Review&quot;) { badge_class = &quot;ops-badge-blue&quot;; }\n\t\t\t\t\t\t\tif(stage == &quot;Level 2 Review&quot;) { badge_class = &quot;ops-badge-orange&quot;; }\n\t\t\t\t\t\t\tif(stage == &quot;Level 3 Review&quot;) { badge_class = &quot;ops-badge-red&quot;; }\n\t\t\t\t\t\t\tif(stage == &quot;Submitted&quot;) { badge_class = &quot;ops-badge-grey&quot;; }\n\t\t\t\t\t\t\tsla_str = sla_date.toString(&quot;dd MMM yyyy&quot;);\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr class=&quot;&lt;%= row_class %&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%= rec.Revision_ID %&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= rec.get(&quot;SO_Reference&quot;).get(&quot;SO_Number&quot;) %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= rec.get(&quot;Customer_Name_Display&quot;) %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= rec.Revision_Type %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;span class=&quot;ops-badge &lt;%= badge_class %&gt;&quot;&gt;&lt;%= stage %&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= sla_str %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tif(days_overdue &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;ops-overdue-days&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-solid ui-2-alert-circle&quot; style=&quot;font-size:12px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;%= days_overdue %&gt; day&lt;% if(days_overdue != 1) { %&gt;s&lt;% } %&gt;\n\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t&lt;span style=&quot;color:#9CA3AF;&quot;&gt;—&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='40%'>\n\t\t\t\t<dsp id='Customer_Response_Table' elementName='Customer_Response_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Customer_Response_Table()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== Customer Response Table styles ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6, th, td { font-family: sans-serif; }\n\n.ops-table-section-cr {\n\tpadding: 8px 24px 20px 0;\n}\n.ops-table-card-cr {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\toverflow: hidden;\n\theight: 100%;\n}\n.ops-table-header-cr {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 16px 20px 12px 20px;\n\tborder-bottom: 1px solid #e7e7ee;\n\tgap: 8px;\n}\n.ops-table-title-cr {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0;\n}\n.ops-table-title-cr i {\n\tfont-size: 16px;\n\tcolor: #34A853;\n}\n.ops-table-count-cr {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tbackground: #F3F3F4;\n\tcolor: #6B7280;\n\tborder-radius: 12px;\n\tpadding: 2px 10px;\n}\n.ops-table-wrapper-cr {\n\toverflow-x: auto;\n}\n.ops-table-cr {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 0.8125rem;\n}\n.ops-table-cr thead tr th {\n\tbackground: #F9FAFE;\n\tpadding: 10px 14px;\n\ttext-align: left;\n\tfont-size: 0.75rem;\n\tfont-weight: 600;\n\tcolor: #6B7280;\n\twhite-space: nowrap;\n\tborder-bottom: 1px solid #e7e7ee;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.03em;\n}\n.ops-table-cr tbody tr td {\n\tpadding: 10px 14px;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #1A1A2E);\n\tborder-bottom: 1px solid #f0f0f5;\n\twhite-space: nowrap;\n}\n.ops-table-cr tbody tr:last-child td {\n\tborder-bottom: none;\n}\n.ops-table-cr tbody tr:hover td {\n\tbackground: #F9FAFE;\n}\n.ops-badge-cr-pending { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #FFF3E0; color: #E65100; }\n.ops-badge-cr-noresp { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #FDECEA; color: #EA4335; }\n.ops-badge-cr-negotiation { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #E8F0FE; color: #1A73E8; }\n.ops-empty-state-cr {\n\ttext-align: center;\n\tpadding: 32px 20px;\n\tcolor: #9CA3AF;\n\tfont-size: 0.875rem;\n}\n.ops-empty-state-cr i {\n\tfont-size: 32px;\n\tdisplay: block;\n\tmargin-bottom: 8px;\n\tcolor: #D1D5DB;\n}\n&lt;/style&gt;\n\n&lt;%\n\tcr_records = Customer_Communication[Customer_Response == &quot;Pending&quot; || Customer_Response == &quot;No Response&quot; || Customer_Response == &quot;Under Negotiation&quot;] sort by Communication_Date range from 0 to 19;\n\tcr_count = cr_records.count();\n%&gt;\n\n&lt;div class=&quot;ops-table-section-cr&quot;&gt;\n\t&lt;div class=&quot;ops-table-card-cr&quot;&gt;\n\t\t&lt;div class=&quot;ops-table-header-cr&quot;&gt;\n\t\t\t&lt;h3 class=&quot;ops-table-title-cr&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline users-1-multiple-11&quot;&gt;&lt;/i&gt;\n\t\t\t\tAwaiting Customer Response\n\t\t\t&lt;/h3&gt;\n\t\t\t&lt;span class=&quot;ops-table-count-cr&quot;&gt;&lt;%= cr_count %&gt; items&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ops-table-wrapper-cr&quot;&gt;\n\t\t\t&lt;table class=&quot;ops-table-cr&quot;&gt;\n\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th&gt;Revision ID&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Comm. Date&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Response Status&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Follow-ups&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(cr_count == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td colspan=&quot;5&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ops-empty-state-cr&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline users-1-multiple-11&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\tNo pending customer responses\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor each crec in cr_records\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tresp_status = crec.Customer_Response;\n\t\t\t\t\t\t\tbadge_cls = &quot;ops-badge-cr-pending&quot;;\n\t\t\t\t\t\t\tif(resp_status == &quot;No Response&quot;) { badge_cls = &quot;ops-badge-cr-noresp&quot;; }\n\t\t\t\t\t\t\tif(resp_status == &quot;Under Negotiation&quot;) { badge_cls = &quot;ops-badge-cr-negotiation&quot;; }\n\t\t\t\t\t\t\tcomm_date_str = crec.Communication_Date.toString(&quot;dd MMM yyyy&quot;);\n\t\t\t\t\t\t\tfollowup_count = crec.Follow_Up_Count;\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%= crec.get(&quot;Revision_Reference&quot;).get(&quot;Revision_ID&quot;) %&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= crec.get(&quot;Customer_Display&quot;) %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= comm_date_str %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;span class=&quot;&lt;%= badge_cls %&gt;&quot;&gt;&lt;%= resp_status %&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td style=&quot;text-align:center;&quot;&gt;&lt;%= followup_count %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='60%'>\n\t\t\t\t<dsp id='Supplier_Pending_Table' elementName='Supplier_Pending_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Supplier_Pending_Table()\ncontent\n&lt;%{%&gt;\n\t\t&lt;style&gt;\n/* ===== Supplier Pending Table styles ===== */\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6, th, td { font-family: sans-serif; }\n\n.ops-table-section-sp {\n\tpadding: 0 24px 24px 24px;\n}\n.ops-table-card-sp {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\toverflow: hidden;\n}\n.ops-table-header-sp {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 16px 20px 12px 20px;\n\tborder-bottom: 1px solid #e7e7ee;\n\tgap: 8px;\n}\n.ops-table-title-sp {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0;\n}\n.ops-table-title-sp i {\n\tfont-size: 16px;\n\tcolor: #8430CE;\n}\n.ops-table-count-sp {\n\tfont-size: 0.75rem;\n\tfont-weight: 500;\n\tbackground: #F3F3F4;\n\tcolor: #6B7280;\n\tborder-radius: 12px;\n\tpadding: 2px 10px;\n}\n.ops-table-wrapper-sp {\n\toverflow-x: auto;\n}\n.ops-table-sp {\n\twidth: 100%;\n\tborder-collapse: collapse;\n\tfont-size: 0.8125rem;\n}\n.ops-table-sp thead tr th {\n\tbackground: #F9FAFE;\n\tpadding: 10px 14px;\n\ttext-align: left;\n\tfont-size: 0.75rem;\n\tfont-weight: 600;\n\tcolor: #6B7280;\n\twhite-space: nowrap;\n\tborder-bottom: 1px solid #e7e7ee;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.03em;\n}\n.ops-table-sp tbody tr td {\n\tpadding: 10px 14px;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #1A1A2E);\n\tborder-bottom: 1px solid #f0f0f5;\n\twhite-space: nowrap;\n}\n.ops-table-sp tbody tr:last-child td {\n\tborder-bottom: none;\n}\n.ops-table-sp tbody tr:hover td {\n\tbackground: #F9FAFE;\n}\n.ops-badge-sp-pending { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #F3E8FF; color: #8430CE; }\n.ops-badge-sp-negotiation { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #E8F0FE; color: #1A73E8; }\n.ops-empty-state-sp {\n\ttext-align: center;\n\tpadding: 32px 20px;\n\tcolor: #9CA3AF;\n\tfont-size: 0.875rem;\n}\n.ops-empty-state-sp i {\n\tfont-size: 32px;\n\tdisplay: block;\n\tmargin-bottom: 8px;\n\tcolor: #D1D5DB;\n}\n&lt;/style&gt;\n\n&lt;%\n\tsp_records = Supplier_Amendment[Supplier_Response == &quot;Pending&quot; || Supplier_Response == &quot;Under Negotiation&quot;] sort by Amendment_Date range from 0 to 9;\n\tsp_count = sp_records.count();\n%&gt;\n\n&lt;div class=&quot;ops-table-section-sp&quot;&gt;\n\t&lt;div class=&quot;ops-table-card-sp&quot;&gt;\n\t\t&lt;div class=&quot;ops-table-header-sp&quot;&gt;\n\t\t\t&lt;h3 class=&quot;ops-table-title-sp&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline e-commerce-box-3d-50&quot;&gt;&lt;/i&gt;\n\t\t\t\tPending Supplier Amendments\n\t\t\t&lt;/h3&gt;\n\t\t\t&lt;span class=&quot;ops-table-count-sp&quot;&gt;&lt;%= sp_count %&gt; items&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ops-table-wrapper-sp&quot;&gt;\n\t\t\t&lt;table class=&quot;ops-table-sp&quot;&gt;\n\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th&gt;Revision ID&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Supplier&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Amendment Type&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Amendment Date&lt;/th&gt;\n\t\t\t\t\t\t&lt;th&gt;Response Status&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tif(sp_count == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td colspan=&quot;5&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ops-empty-state-sp&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline e-commerce-box-3d-50&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\tNo pending supplier amendments\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor each srec in sp_records\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\ts_resp = srec.Supplier_Response;\n\t\t\t\t\t\t\ts_badge = &quot;ops-badge-sp-pending&quot;;\n\t\t\t\t\t\t\tif(s_resp == &quot;Under Negotiation&quot;) { s_badge = &quot;ops-badge-sp-negotiation&quot;; }\n\t\t\t\t\t\t\tamend_date_str = srec.Amendment_Date.toString(&quot;dd MMM yyyy&quot;);\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%= srec.get(&quot;Revision_Reference&quot;).get(&quot;Revision_ID&quot;) %&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= srec.get(&quot;Supplier_Name&quot;) %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= srec.Amendment_Type %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%= amend_date_str %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;span class=&quot;&lt;%= s_badge %&gt;&quot;&gt;&lt;%= s_resp %&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='40%'>\n\t\t\t\t<dsp id='Pipeline_Note' elementName='Pipeline_Note'>\n\t\t\t\t\t<![CDATA[htmlpage Pipeline_Note()\ncontent\n&lt;%{%&gt;\n<style>\n* { box-sizing: border-box; }\nbody, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }\n.ops-note-section { padding: 0 24px 24px 0; }\n.ops-note-card {\n\tbackground: #FFFFFF;\n\tborder-radius: 10px;\n\tbox-shadow: 0 1px 4px rgba(0,0,0,0.07);\n\tborder: 1px solid #e7e7ee;\n\tpadding: 20px;\n\theight: 100%;\n}\n.ops-note-title {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 8px;\n\tfont-size: 0.9375rem;\n\tfont-weight: 600;\n\tcolor: #1A3C6E;\n\tmargin: 0 0 16px 0;\n}\n.ops-note-title i { font-size: 16px; color: #1A73E8; }\n.ops-legend-item {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 10px;\n\tmargin-bottom: 10px;\n\tfont-size: 0.8125rem;\n\tcolor: var(--zcs_primary_text_color, #374151);\n}\n.ops-legend-dot {\n\twidth: 12px;\n\theight: 12px;\n\tborder-radius: 3px;\n\tflex-shrink: 0;\n}\n.ops-divider { border: none; border-top: 1px solid #f0f0f5; margin: 14px 0; }\n.ops-note-info {\n\tfont-size: 0.75rem;\n\tcolor: #9CA3AF;\n\tline-height: 1.5;\n}\n</style>\n<div class=\"ops-note-section\">\n\t<div class=\"ops-note-card\">\n\t\t<h3 class=\"ops-note-title\">\n\t\t\t<i class=\"zc-li-outline files-1-copy-07\"></i>\n\t\t\tPipeline Legend\n\t\t</h3>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#EA4335;\"></div>\n\t\t\t<span>Red row — SLA deadline passed (overdue)</span>\n\t\t</div>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#F9AB00;\"></div>\n\t\t\t<span>Orange row — SLA deadline today or tomorrow</span>\n\t\t</div>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#34A853;\"></div>\n\t\t\t<span>Normal row — within SLA window</span>\n\t\t</div>\n\t\t<hr class=\"ops-divider\"/>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#1A73E8;\"></div>\n\t\t\t<span>Level 1 Review</span>\n\t\t</div>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#E65100;\"></div>\n\t\t\t<span>Level 2 Review</span>\n\t\t</div>\n\t\t<div class=\"ops-legend-item\">\n\t\t\t<div class=\"ops-legend-dot\" style=\"background:#EA4335;\"></div>\n\t\t\t<span>Level 3 Review</span>\n\t\t</div>\n\t\t<hr class=\"ops-divider\"/>\n\t\t<p class=\"ops-note-info\">\n\t\t\tTables show up to 20 records sorted by earliest deadline first. Supplier amendments limited to 10 records. Data refreshes on each page load.\n\t\t</p>\n\t</div>\n</div>\n&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
					script
					{
						total_open_revisions = Revision_Request[Overall_Status != "Completed" && Overall_Status != "Rejected" && Overall_Status != "Customer Rejected"].count();
						pending_l1 = Revision_Request[Overall_Status == "Level 1 Review"].count();
						pending_l2 = Revision_Request[Overall_Status == "Level 2 Review"].count();
						pending_l3 = Revision_Request[Overall_Status == "Level 3 Review"].count();
						pending_customer = Customer_Communication[Customer_Response == "Pending" || Customer_Response == "No Response" || Customer_Response == "Under Negotiation"].count();
						pending_supplier = Supplier_Amendment[Supplier_Response == "Pending" || Supplier_Response == "Under Negotiation"].count();
						overdue_approvals = Revision_Request[SLA_Deadline < zoho.currentdate && (Overall_Status == "Level 1 Review" || Overall_Status == "Level 2 Review" || Overall_Status == "Level 3 Review" || Overall_Status == "Submitted")].count();
						total_pending_financial_impact = Revision_Request[Overall_Status != "Completed" && Overall_Status != "Rejected" && Overall_Status != "Customer Rejected"].sum(Total_Financial_Impact);
					}
		}
	}

	workflow
	{
		form
		{
			Customer_Communication_On_Edit as "Customer Communication - On Edit Success"
			{
			    type = form
			    form = Customer_Communication
			    record event = on edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                revRef = input.Revision_Reference;
			                revID = input.Revision_Reference.Revision_ID;
			                customer = input.Customer_Display;
			                soNum = input.SO_Number_Display;
			
			                if (input.Customer_Response == "Accepted")
			                {
			                    // Unlock supplier amendment module
			                    update Revision_Request[ID == revRef]
			                    [
			                        Overall_Status = "Customer Accepted"
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "procurement.manager@varroc.com"
			                        subject : "Customer ACCEPTED Revision " + revID + " - Raise Supplier Amendment"
			                        message : "Customer " + customer + " has accepted Revision " + revID + " (SO: " + soNum + ").<br><br><b>Amended SO Number:</b> " + input.Amended_SO_Number + "<br><br>The Supplier PO Amendment module is now unlocked. Please raise the corresponding supplier amendment."
			                    )
			                }
			                else if (input.Customer_Response == "Rejected")
			                {
			                    update Revision_Request[ID == revRef]
			                    [
			                        Overall_Status = "Customer Rejected"
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Customer REJECTED Revision " + revID
			                        message : "Customer " + customer + " has rejected the amendment request for Revision " + revID + " (SO: " + soNum + ").<br><br><b>Reason:</b> " + input.Rejection_Reason + "<br><br>Please decide on the next steps."
			                    )
			                }
			                else if (input.Customer_Response == "Under Negotiation")
			                {
			                    update Revision_Request[ID == revRef]
			                    [
			                        Overall_Status = "Under Negotiation"
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Customer Counter-Proposal Received - Revision " + revID
			                        message : "Customer " + customer + " has provided a counter-proposal for Revision " + revID + " (SO: " + soNum + ").<br><br>Please log the negotiation details in the Negotiation Log and respond to the customer."
			                    )
			                }
			            )
			        }
			    }
			}

			Customer_Communication_On_Add as "Customer Communication - On Add Success"
			{
			    type = form
			    form = Customer_Communication
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Set communicated by to current user
			                input.Communicated_By = zoho.loginuser;
			
			                // Update Revision Request status to Customer Communication
			                update Revision_Request[ID == input.Revision_Reference]
			                [
			                    Overall_Status = "Customer Communication"
			                ]
			            )
			        }
			    }
			}

			Negotiation_Log_On_Add as "Negotiation Log - On Add Success"
			{
			    type = form
			    form = Negotiation_Log
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Set negotiated by to current user
			                input.Negotiated_By = zoho.loginuser;
			
			                // Auto-compute round number: find highest existing round for this revision and add 1
			                maxRound = 0;
			                for each existingRound in Negotiation_Log[Revision_Reference == input.Revision_Reference]
			                {
			                    if (existingRound.Round_Number > maxRound)
			                    {
			                        maxRound = existingRound.Round_Number;
			                    }
			                }
			                nextRound = maxRound + 1;
			
			                update Negotiation_Log[ID == input.ID]
			                [
			                    Round_Number = nextRound
			                    Negotiated_By = zoho.loginuser
			                ]
			
			                // Notify Commercial Head
			                revID = input.Revision_Reference.Revision_ID;
			                customer = input.Customer_Display;
			
			                sendmail
			                (
			                    from : zoho.adminuserid
			                    to : "commercial.head@varroc.com"
			                    subject : "Negotiation Round " + nextRound + " Logged - Revision " + revID
			                    message : "A new negotiation round has been logged for Revision " + revID + " with customer " + customer + ".<br><br><b>Round Number:</b> " + nextRound + "<br><b>Varroc Position:</b> " + input.Varroc_Proposal + "<br><b>Customer Counter-Proposal:</b> " + input.Customer_Counter_Proposal + "<br><b>Next Action Date:</b> " + input.Next_Action_Date
			                )
			            )
			        }
			    }
			}

			Revision_Request_On_Edit_Success as "Revision Request - On Edit Success"
			{
			    type = form
			    form = Revision_Request
			    record event = on edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                revID = input.Revision_ID;
			                soNum = input.SO_Reference.SO_Number;
			                customer = input.Customer_Name_Display;
			
			                // --- LEVEL 1 APPROVAL ---
			                if (input.Level1_Action == "Approved" && (input.Overall_Status == "Submitted" || input.Overall_Status == "Level 1 Review" || input.Overall_Status == "Info Requested"))
			                {
			                    if (input.Level1_Date == null)
			                    {
			                        input.Level1_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Level 2 Review";
			                    input.Level2_Action = "Pending";
			                    input.Level2_Start_Date = zoho.currenttime;
			                    input.SLA_Deadline = zoho.currentdate.addDay(2);
			
			                    // Insert approval log
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 1 - Procurement Manager"
			                        Action = "Approved"
			                        Comments = input.Level1_Comments
			                        Action_By = input.Level1_Approved_By
			                        Action_Date = input.Level1_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "finance@varroc.com"
			                        subject : "Revision " + revID + " - Level 2 Finance Approval Required"
			                        message : "Revision Request " + revID + " (SO: " + soNum + ", Customer: " + customer + ") has been approved at Level 1 and now requires Finance approval.<br><br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact + "<br><b>SLA Deadline:</b> " + input.SLA_Deadline
			                    )
			                }
			                else if (input.Level1_Action == "Rejected" && (input.Overall_Status == "Submitted" || input.Overall_Status == "Level 1 Review" || input.Overall_Status == "Info Requested"))
			                {
			                    if (input.Level1_Date == null)
			                    {
			                        input.Level1_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Rejected";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 1 - Procurement Manager"
			                        Action = "Rejected"
			                        Comments = input.Level1_Comments
			                        Action_By = input.Level1_Approved_By
			                        Action_Date = input.Level1_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "Revision " + revID + " Rejected at Level 1"
			                        message : "Your Revision Request " + revID + " has been rejected by the Procurement Manager.<br><b>Comments:</b> " + input.Level1_Comments
			                    )
			                }
			                else if (input.Level1_Action == "Request Info" && (input.Overall_Status == "Submitted" || input.Overall_Status == "Level 1 Review"))
			                {
			                    input.Overall_Status = "Info Requested";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 1 - Procurement Manager"
			                        Action = "Request Info"
			                        Comments = input.Level1_Comments
			                        Action_By = input.Level1_Approved_By
			                        Action_Date = zoho.currenttime
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "More Information Required - Revision " + revID
			                        message : "Additional information is required for Revision Request " + revID + ".<br><b>Comments:</b> " + input.Level1_Comments
			                    )
			                }
			
			                if (input.Level2_Action == "Approved" && input.Overall_Status == "Level 2 Review")
			                {
			                    if (input.Level2_Date == null)
			                    {
			                        input.Level2_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Level 3 Review";
			                    input.Level3_Action = "Pending";
			                    input.Level3_Start_Date = zoho.currenttime;
			                    input.SLA_Deadline = zoho.currentdate.addDay(2);
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 2 - Finance"
			                        Action = "Approved"
			                        Comments = input.Level2_Comments
			                        Action_By = input.Level2_Approved_By
			                        Action_Date = input.Level2_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Revision " + revID + " - Level 3 Final Approval Required"
			                        message : "Revision Request " + revID + " (SO: " + soNum + ", Customer: " + customer + ") has been approved by Finance and now requires final Commercial Head approval.<br><br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact + "<br><b>SLA Deadline:</b> " + input.SLA_Deadline
			                    )
			                }
			
			                if (input.Level2_Action == "Rejected" && input.Overall_Status == "Level 2 Review")
			                {
			                    if (input.Level2_Date == null)
			                    {
			                        input.Level2_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Rejected";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 2 - Finance"
			                        Action = "Rejected"
			                        Comments = input.Level2_Comments
			                        Action_By = input.Level2_Approved_By
			                        Action_Date = input.Level2_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "Revision " + revID + " Rejected at Level 2 - Finance"
			                        message : "Revision Request " + revID + " has been rejected by Finance.<br><b>Comments:</b> " + input.Level2_Comments
			                    )
			                }
			
			                if (input.Level2_Action == "Request Info" && input.Overall_Status == "Level 2 Review")
			                {
			                    input.Overall_Status = "Info Requested";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 2 - Finance"
			                        Action = "Request Info"
			                        Comments = input.Level2_Comments
			                        Action_By = input.Level2_Approved_By
			                        Action_Date = zoho.currenttime
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "More Information Required - Revision " + revID + " (Finance Review)"
			                        message : "Finance has requested additional information for Revision Request " + revID + ".<br><b>Comments:</b> " + input.Level2_Comments
			                    )
			                }
			
			                if (input.Level3_Action == "Approved" && input.Overall_Status == "Level 3 Review")
			                {
			                    if (input.Level3_Date == null)
			                    {
			                        input.Level3_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Internally Approved";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 3 - Commercial Head"
			                        Action = "Approved"
			                        Comments = input.Level3_Comments
			                        Action_By = input.Level3_Approved_By
			                        Action_Date = input.Level3_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Revision " + revID + " Internally Approved - Initiate Customer Communication"
			                        message : "Revision Request " + revID + " (SO: " + soNum + ", Customer: " + customer + ") has been fully approved internally.<br><br>Please initiate formal customer communication.<br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact
			                    )
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "Revision " + revID + " - Internal Approval Complete"
			                        message : "Your Revision Request " + revID + " has been approved by all three internal levels. The Commercial Head will now initiate customer communication."
			                    )
			                }
			
			                if (input.Level3_Action == "Rejected" && input.Overall_Status == "Level 3 Review")
			                {
			                    if (input.Level3_Date == null)
			                    {
			                        input.Level3_Date = zoho.currenttime;
			                    }
			                    input.Overall_Status = "Rejected";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 3 - Commercial Head"
			                        Action = "Rejected"
			                        Comments = input.Level3_Comments
			                        Action_By = input.Level3_Approved_By
			                        Action_Date = input.Level3_Date
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "Revision " + revID + " Rejected at Level 3 - Commercial Head"
			                        message : "Revision Request " + revID + " has been rejected at the final approval stage.<br><b>Comments:</b> " + input.Level3_Comments
			                    )
			                }
			
			                if (input.Level3_Action == "Request Info" && input.Overall_Status == "Level 3 Review")
			                {
			                    input.Overall_Status = "Info Requested";
			
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = "Level 3 - Commercial Head"
			                        Action = "Request Info"
			                        Comments = input.Level3_Comments
			                        Action_By = input.Level3_Approved_By
			                        Action_Date = zoho.currenttime
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "More Information Required - Revision " + revID + " (Commercial Head Review)"
			                        message : "The Commercial Head has requested additional information for Revision Request " + revID + ".<br><b>Comments:</b> " + input.Level3_Comments
			                    )
			                }
			            )
			        }
			    }
			}

			Revision_Request_On_Load as "Revision Request - On Load"
			{
			    type = form
			    form = Revision_Request
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                currentStatus = input.Overall_Status;
			
			                // Disable L1 fields unless status is at L1 stage
			                if (currentStatus != "Submitted" && currentStatus != "Level 1 Review" && currentStatus != "Info Requested" && currentStatus != "Draft")
			                {
			                    disable Level1_Action;
			                    disable Level1_Comments;
			                }
			
			                // Disable L2 fields unless status is at L2 stage
			                if (currentStatus != "Level 2 Review")
			                {
			                    disable Level2_Action;
			                    disable Level2_Comments;
			                }
			
			                // Disable L3 fields unless status is at L3 stage
			                if (currentStatus != "Level 3 Review")
			                {
			                    disable Level3_Action;
			                    disable Level3_Comments;
			                }
			
			                // Disable metadata fields that are auto-set
			                disable Level1_Approved_By;
			                disable Level1_Date;
			                disable Level1_Start_Date;
			                disable Level2_Approved_By;
			                disable Level2_Date;
			                disable Level2_Start_Date;
			                disable Level3_Approved_By;
			                disable Level3_Date;
			                disable Level3_Start_Date;
			                disable Submitted_By;
			                disable Submitted_Date;
			                disable Revision_Date;
			            )
			        }
			    }
			}

			Revision_Request_On_Add_Success as "Revision Request - On Add Success"
			{
			    type = form
			    form = Revision_Request
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Set submission metadata
			                input.Submitted_Date = zoho.currenttime;
			                input.Submitted_By = zoho.loginuser;
			                input.Overall_Status = "Submitted";
			                input.Level1_Action = "Pending";
			                input.Level1_Start_Date = zoho.currenttime;
			
			                // Set SLA deadline based on urgency
			                if (input.Urgency == "Urgent")
			                {
			                    input.SLA_Deadline = zoho.currentdate.addDay(1);
			                }
			                else
			                {
			                    input.SLA_Deadline = zoho.currentdate.addDay(3);
			                }
			
			                // Send notification email to Procurement Manager profile users
			                // Notify Procurement Manager
			                emailBody = "A new Revision Request has been submitted and requires your review.<br><br>"
			                    + "<b>Revision ID:</b> " + input.Revision_ID + "<br>"
			                    + "<b>SO Reference:</b> " + input.SO_Reference.SO_Number + "<br>"
			                    + "<b>Customer:</b> " + input.Customer_Name_Display + "<br>"
			                    + "<b>Revision Type:</b> " + input.Revision_Type + "<br>"
			                    + "<b>Description:</b> " + input.Description + "<br>"
			                    + "<b>Total Financial Impact:</b> INR " + input.Total_Financial_Impact + "<br>"
			                    + "<b>Urgency:</b> " + input.Urgency + "<br>"
			                    + "<b>SLA Deadline:</b> " + input.SLA_Deadline + "<br>";
			
			                sendmail
			                (
			                    from : zoho.adminuserid
			                    to : "procurement.manager@varroc.com"
			                    subject : "New Revision Request: " + input.Revision_ID + " - " + input.Revision_Type
			                    message : emailBody
			                )
			            )
			        }
			    }
			}

			Supplier_Amendment_On_Edit as "Supplier Amendment - On Edit Success"
			{
			    type = form
			    form = Supplier_Amendment
			    record event = on edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                revRef = input.Revision_Reference;
			                revID = input.Revision_Reference.Revision_ID;
			
			                if (input.Supplier_Response == "Accepted")
			                {
			                    // Close the revision as fully completed
			                    update Revision_Request[ID == revRef]
			                    [
			                        Overall_Status = "Completed"
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Revision " + revID + " COMPLETED - End-to-End Amendment Chain Closed"
			                        message : "Revision " + revID + " is now fully closed.<br><br><b>Supplier:</b> " + input.Supplier_Name + "<br><b>Amended Supplier PO:</b> " + input.Amended_Supplier_PO_Reference + "<br><br>The full amendment cycle (SO revision → internal approval → customer acceptance → supplier PO amendment) is complete."
			                    )
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "procurement.manager@varroc.com"
			                        subject : "Revision " + revID + " COMPLETED"
			                        message : "Supplier " + input.Supplier_Name + " has accepted the amendment for Revision " + revID + ". Amended Supplier PO: " + input.Amended_Supplier_PO_Reference + ". The revision is now marked as Completed."
			                    )
			                }
			                else if (input.Supplier_Response == "Rejected")
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "procurement.manager@varroc.com"
			                        subject : "ALERT: Supplier Rejected Amendment - Revision " + revID
			                        message : "Supplier " + input.Supplier_Name + " has rejected the amendment for Revision " + revID + ".<br><br><b>Supplier Notes:</b> " + input.Supplier_Counter_Proposal + "<br><br>Escalation and renegotiation required."
			                    )
			                }
			            )
			        }
			    }
			}

			Supplier_Amendment_On_Load as "Supplier Amendment - On Load"
			{
			    type = form
			    form = Supplier_Amendment
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Check if linked revision is in Customer Accepted status
			                if (input.Revision_Reference != null)
			                {
			                    revRecord = Revision_Request[ID == input.Revision_Reference];
			                    if (revRecord.Overall_Status != "Customer Accepted" && revRecord.Overall_Status != "Supplier Amendment Raised" && revRecord.Overall_Status != "Completed")
			                    {
			                        // Disable all editable fields as a soft lock
			                        disable Supplier_Name;
			                        disable Supplier_PO_Reference;
			                        disable Amendment_Type;
			                        disable Old_Value;
			                        disable New_Value;
			                        disable Amendment_Description;
			                        disable Customer_Amended_SO_Reference;
			                        disable Supplier_Response;
			                        disable Supplier_Response_Date;
			                        disable Amended_Supplier_PO_Reference;
			                        disable Supplier_Counter_Proposal;
			                    }
			                }
			            )
			        }
			    }
			}

			Supplier_Amendment_On_Add as "Supplier Amendment - On Add Success"
			{
			    type = form
			    form = Supplier_Amendment
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                revRef = input.Revision_Reference;
			                revRecord = Revision_Request[ID == revRef];
			
			                // Warn if revision is not in Customer Accepted status
			                if (revRecord.Overall_Status != "Customer Accepted")
			                {
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : zoho.loginuser
			                        subject : "Warning: Supplier Amendment raised for non-accepted Revision"
			                        message : "You have raised a supplier amendment for Revision " + input.Revision_Reference.Revision_ID + " which currently has status: " + revRecord.Overall_Status + ".<br><br>Supplier amendments should only be raised after the customer has formally accepted the revision and an amended SO number is on record."
			                    )
			                }
			                else
			                {
			                    // Update Revision Request status
			                    update Revision_Request[ID == revRef]
			                    [
			                        Overall_Status = "Supplier Amendment Raised"
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "procurement.manager@varroc.com"
			                        subject : "Supplier Amendment Raised - Revision " + input.Revision_Reference.Revision_ID
			                        message : "A supplier amendment has been raised for Revision " + input.Revision_Reference.Revision_ID + ".<br><br><b>Supplier:</b> " + input.Supplier_Name + "<br><b>Amendment Type:</b> " + input.Amendment_Type + "<br><b>Customer Amended SO:</b> " + input.Customer_Amended_SO_Reference
			                    )
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Customer_Followup_Schedule as "Customer Follow-up Reminder - Daily"
			{
			    type = schedule
			    start = "2025-01-01 09:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                today = zoho.currentdate;
			                followupThreshold = today.subDay(7);
			
			                // Fetch all pending / no-response communications older than 7 days
			                pendingComms = Customer_Communication[(Customer_Response == "Pending" || Customer_Response == "No Response") && Communication_Date <= followupThreshold];
			
			                for each comm in pendingComms
			                {
			                    daysSince = today - comm.Communication_Date;
			
			                    // Increment follow-up count and update last follow-up date
			                    newCount = comm.Follow_Up_Count + 1;
			                    update Customer_Communication[ID == comm.ID]
			                    [
			                        Follow_Up_Count = newCount
			                        Last_Follow_Up_Date = today
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : comm.Communicated_By
			                        subject : "Follow-up Required: Customer response pending for Revision " + comm.Revision_Reference.Revision_ID
			                        message : "Customer " + comm.Customer_Display + " has not responded to the amendment request for Revision " + comm.Revision_Reference.Revision_ID + " (SO: " + comm.SO_Number_Display + ").<br><br><b>Communication Date:</b> " + comm.Communication_Date + "<br><b>Days Since Communication:</b> " + daysSince + "<br><b>Follow-up Count:</b> " + newCount + "<br><br>Please follow up immediately."
			                    )
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "commercial.head@varroc.com"
			                        subject : "Customer Follow-up Alert: Revision " + comm.Revision_Reference.Revision_ID + " (" + daysSince + " days)"
			                        message : "No customer response received for Revision " + comm.Revision_Reference.Revision_ID + " after " + daysSince + " days. Follow-up count: " + newCount + "."
			                    )
			                }
			            )
			        }
			    }
			}

			SLA_Escalation as "SLA Escalation - Daily Check"
			{
			    type = schedule
			    start = "2025-01-01 08:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                today = zoho.currentdate;
			
			                // Level 1 escalation - revisions waiting > 3 days
			                l1Overdue = Revision_Request[(Overall_Status == "Submitted" || Overall_Status == "Level 1 Review") && Level1_Start_Date <= today.subDay(3)];
			                for each rev in l1Overdue
			                {
			                    daysWaiting = today - rev.Level1_Start_Date.toDate();
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "procurement.head@varroc.com"
			                        subject : "ESCALATION: Revision " + rev.Revision_ID + " overdue at Level 1 (" + daysWaiting + " days)"
			                        message : "Revision Request " + rev.Revision_ID + " (SO: " + rev.SO_Reference.SO_Number + ") has been waiting for Level 1 Procurement Manager approval for " + daysWaiting + " days.<br><br>SLA deadline was: " + rev.SLA_Deadline + "<br><b>Please take immediate action.</b>"
			                    )
			                }
			
			                // Level 2 escalation - revisions waiting > 2 days
			                l2Overdue = Revision_Request[Overall_Status == "Level 2 Review" && Level2_Start_Date <= today.subDay(2)];
			                for each rev in l2Overdue
			                {
			                    daysWaiting = today - rev.Level2_Start_Date.toDate();
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "finance.head@varroc.com"
			                        subject : "ESCALATION: Revision " + rev.Revision_ID + " overdue at Level 2 Finance (" + daysWaiting + " days)"
			                        message : "Revision Request " + rev.Revision_ID + " (SO: " + rev.SO_Reference.SO_Number + ") has been waiting for Finance approval for " + daysWaiting + " days.<br><br>SLA deadline was: " + rev.SLA_Deadline + "<br><b>Please take immediate action.</b>"
			                    )
			                }
			
			                // Level 3 escalation - revisions waiting > 2 days
			                l3Overdue = Revision_Request[Overall_Status == "Level 3 Review" && Level3_Start_Date <= today.subDay(2)];
			                for each rev in l3Overdue
			                {
			                    daysWaiting = today - rev.Level3_Start_Date.toDate();
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : "ceo@varroc.com"
			                        subject : "ESCALATION: Revision " + rev.Revision_ID + " overdue at Level 3 Commercial Head (" + daysWaiting + " days)"
			                        message : "Revision Request " + rev.Revision_ID + " (SO: " + rev.SO_Reference.SO_Number + ") has been waiting for Commercial Head final approval for " + daysWaiting + " days.<br><br>SLA deadline was: " + rev.SLA_Deadline + "<br><b>This requires CEO/MD attention.</b>"
			                    )
			                }
			            )
			        }
			    }
			}
		}

		functions
		{
			WF_Mark_L1_Approved as "Mark L1 Approved"
			{
			    type = functions
			    form = Revision_Request
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                update Revision_Request[ID == input.ID]
			                [
			                    Level1_Action = "Approved"
			                    Level1_Date = zoho.currenttime
			                    Level1_Approved_By = zoho.loginuser
			                    Overall_Status = "Level 2 Review"
			                    Level2_Action = "Pending"
			                    Level2_Start_Date = zoho.currenttime
			                    SLA_Deadline = zoho.currentdate.addDay(2)
			                ]
			
			                soNum = input.SO_Reference.SO_Number;
			                customer = input.Customer_Name_Display;
			
			                insert into Approval_Log
			                [
			                    Revision_Reference = input.ID
			                    Approval_Level = "Level 1 - Procurement Manager"
			                    Action = "Approved"
			                    Comments = input.Level1_Comments
			                    Action_By = zoho.loginuser
			                    Action_Date = zoho.currenttime
			                    SO_Number_Ref = soNum
			                ]
			
			                sendmail
			                (
			                    from : zoho.adminuserid
			                    to : "finance@varroc.com"
			                    subject : "Revision " + input.Revision_ID + " - Level 2 Finance Approval Required"
			                    message : "Revision Request " + input.Revision_ID + " (SO: " + soNum + ", Customer: " + customer + ") has been approved at Level 1 and now requires Finance approval.<br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact
			                )
			            )
			        }
			    }
			}

			WF_Mark_L2_Approved as "Mark L2 Approved"
			{
			    type = functions
			    form = Revision_Request
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                update Revision_Request[ID == input.ID]
			                [
			                    Level2_Action = "Approved"
			                    Level2_Date = zoho.currenttime
			                    Level2_Approved_By = zoho.loginuser
			                    Overall_Status = "Level 3 Review"
			                    Level3_Action = "Pending"
			                    Level3_Start_Date = zoho.currenttime
			                    SLA_Deadline = zoho.currentdate.addDay(2)
			                ]
			
			                soNum = input.SO_Reference.SO_Number;
			                customer = input.Customer_Name_Display;
			
			                insert into Approval_Log
			                [
			                    Revision_Reference = input.ID
			                    Approval_Level = "Level 2 - Finance"
			                    Action = "Approved"
			                    Comments = input.Level2_Comments
			                    Action_By = zoho.loginuser
			                    Action_Date = zoho.currenttime
			                    SO_Number_Ref = soNum
			                ]
			
			                sendmail
			                (
			                    from : zoho.adminuserid
			                    to : "commercial.head@varroc.com"
			                    subject : "Revision " + input.Revision_ID + " - Level 3 Final Approval Required"
			                    message : "Revision Request " + input.Revision_ID + " (SO: " + soNum + ", Customer: " + customer + ") has been approved by Finance and now requires final Commercial Head approval.<br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact
			                )
			            )
			        }
			    }
			}

			WF_Mark_L3_Approved as "Mark L3 Approved"
			{
			    type = functions
			    form = Revision_Request
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                update Revision_Request[ID == input.ID]
			                [
			                    Level3_Action = "Approved"
			                    Level3_Date = zoho.currenttime
			                    Level3_Approved_By = zoho.loginuser
			                    Overall_Status = "Internally Approved"
			                ]
			
			                soNum = input.SO_Reference.SO_Number;
			                customer = input.Customer_Name_Display;
			
			                insert into Approval_Log
			                [
			                    Revision_Reference = input.ID
			                    Approval_Level = "Level 3 - Commercial Head"
			                    Action = "Approved"
			                    Comments = input.Level3_Comments
			                    Action_By = zoho.loginuser
			                    Action_Date = zoho.currenttime
			                    SO_Number_Ref = soNum
			                ]
			
			                sendmail
			                (
			                    from : zoho.adminuserid
			                    to : "commercial.head@varroc.com"
			                    subject : "Revision " + input.Revision_ID + " Internally Approved - Initiate Customer Communication"
			                    message : "Revision " + input.Revision_ID + " (SO: " + soNum + ", Customer: " + customer + ") has been fully approved internally. Please initiate formal customer communication.<br><b>Financial Impact:</b> INR " + input.Total_Financial_Impact
			                )
			            )
			        }
			    }
			}

			WF_Reject_Revision as "Reject Revision"
			{
			    type = functions
			    form = Revision_Request
			    execution type = for each record
			
			    on start
			    {
			        actions
			        {
			            on click
			            (
			                currentStatus = input.Overall_Status;
			                soNum = input.SO_Reference.SO_Number;
			                approvalLevel = "";
			                rejectedBy = zoho.loginuser;
			
			                if (currentStatus == "Submitted" || currentStatus == "Level 1 Review" || currentStatus == "Info Requested")
			                {
			                    approvalLevel = "Level 1 - Procurement Manager";
			                    update Revision_Request[ID == input.ID]
			                    [
			                        Level1_Action = "Rejected"
			                        Level1_Date = zoho.currenttime
			                        Level1_Approved_By = rejectedBy
			                        Overall_Status = "Rejected"
			                    ]
			                }
			                else if (currentStatus == "Level 2 Review")
			                {
			                    approvalLevel = "Level 2 - Finance";
			                    update Revision_Request[ID == input.ID]
			                    [
			                        Level2_Action = "Rejected"
			                        Level2_Date = zoho.currenttime
			                        Level2_Approved_By = rejectedBy
			                        Overall_Status = "Rejected"
			                    ]
			                }
			                else if (currentStatus == "Level 3 Review")
			                {
			                    approvalLevel = "Level 3 - Commercial Head";
			                    update Revision_Request[ID == input.ID]
			                    [
			                        Level3_Action = "Rejected"
			                        Level3_Date = zoho.currenttime
			                        Level3_Approved_By = rejectedBy
			                        Overall_Status = "Rejected"
			                    ]
			                }
			
			                if (approvalLevel != "")
			                {
			                    insert into Approval_Log
			                    [
			                        Revision_Reference = input.ID
			                        Approval_Level = approvalLevel
			                        Action = "Rejected"
			                        Action_By = rejectedBy
			                        Action_Date = zoho.currenttime
			                        SO_Number_Ref = soNum
			                    ]
			
			                    sendmail
			                    (
			                        from : zoho.adminuserid
			                        to : input.Added_User
			                        subject : "Revision " + input.Revision_ID + " Rejected"
			                        message : "Your Revision Request " + input.Revision_ID + " has been rejected at " + approvalLevel + "."
			                    )
			                }
			            )
			        }
			    }
			}
		}
	}

