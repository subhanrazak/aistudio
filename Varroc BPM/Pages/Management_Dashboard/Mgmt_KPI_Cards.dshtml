<style>
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; } :root { font-size: 16px; line-height: 1.5; --column-gap: 0px; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; } .zcs-flex { display: flex; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-gap-8 { gap: 0.5rem; } .zcs-gap-12 { gap: 0.75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-p-0 { padding: 0; } .zcs-m-0 { margin: 0; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-medium { font-weight: 500; } .zcs-font-bold { font-weight: 700; } .zcs-font-semibold { font-weight: 600; } .zcs-lh-heading { line-height: 1.25; } .zcs-lh-body { line-height: 1.5; } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-tertiary { color: var(--zcs_tertiary_text_color); } .zcs-color-white { color: #FFFFFF; } .zcs-rounded-lg { border-radius: 0.5rem; } .zcs-rounded-xl { border-radius: 0.75rem; } .zcs-box-border { box-sizing: border-box; } .zcs-w-full { width: 100%; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ===== Management Dashboard shared styles ===== */
* { box-sizing: border-box; }
body, div, span, p, h1, h2, h3, h4, h5, h6 { font-family: sans-serif; }

.mgmt-page-wrapper {
  background: #F3F3F4;
  padding: 0;
  min-height: 100%;
}

/* Page Header */
.mgmt-page-header {
  background: #1A3C6E;
  padding: 20px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.mgmt-page-header-left h1 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.25;
}
.mgmt-page-header-left p {
  margin: 4px 0 0 0;
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.75);
}
.mgmt-header-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.75rem;
  color: #FFFFFF;
}

/* KPI Grid */
.mgmt-kpi-section {
  padding: 20px 24px 8px 24px;
}
.mgmt-kpi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.mgmt-kpi-card {
  flex: 1 1 calc(20% - 14px);
  min-width: 170px;
  background: #FFFFFF;
  border-radius: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  border-top: 4px solid #1A3C6E;
  padding: 18px 20px 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.mgmt-kpi-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.mgmt-kpi-icon-wrap {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mgmt-kpi-icon-wrap i {
  font-size: 18px;
  color: #FFFFFF;
}
.mgmt-kpi-value {
  font-size: 1.6rem;
  font-weight: 700;
  color: #1A3C6E;
  line-height: 1.1;
  margin: 0;
}
.mgmt-kpi-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--zcs_secondary_text_color, #6B7280);
  margin: 0;
  line-height: 1.4;
}
.mgmt-kpi-sublabel {
  font-size: 0.6875rem;
  color: var(--zcs_tertiary_text_color, #9CA3AF);
  margin: 0;
}
</style>

<%
  today_date = zoho.currentdate;
  date_str = today_date.toString("dd MMM yyyy");

  /* Format INR with commas */
  fin_impact_raw = input.total_financial_impact;
  fin_impact_int = fin_impact_raw.toLong();
  fin_str = fin_impact_int.toString();
  fin_len = fin_str.length();
  fin_formatted = "";
  if (fin_len <= 3)
  {
    fin_formatted = fin_str;
  }
  else if (fin_len <= 5)
  {
    fin_formatted = fin_str.subString(0, fin_len - 3) + "," + fin_str.subString(fin_len - 3);
  }
  else if (fin_len <= 7)
  {
    fin_formatted = fin_str.subString(0, fin_len - 5) + "," + fin_str.subString(fin_len - 5, fin_len - 3) + "," + fin_str.subString(fin_len - 3);
  }
  else
  {
    fin_formatted = fin_str.subString(0, fin_len - 7) + "," + fin_str.subString(fin_len - 7, fin_len - 5) + "," + fin_str.subString(fin_len - 5, fin_len - 3) + "," + fin_str.subString(fin_len - 3);
  }

  /* Format accepted value */
  acc_raw = input.total_accepted_value;
  acc_int = acc_raw.toLong();
  acc_str = acc_int.toString();
  acc_len = acc_str.length();
  acc_formatted = "";
  if (acc_len <= 3)
  {
    acc_formatted = acc_str;
  }
  else if (acc_len <= 5)
  {
    acc_formatted = acc_str.subString(0, acc_len - 3) + "," + acc_str.subString(acc_len - 3);
  }
  else if (acc_len <= 7)
  {
    acc_formatted = acc_str.subString(0, acc_len - 5) + "," + acc_str.subString(acc_len - 5, acc_len - 3) + "," + acc_str.subString(acc_len - 3);
  }
  else
  {
    acc_formatted = acc_str.subString(0, acc_len - 7) + "," + acc_str.subString(acc_len - 7, acc_len - 5) + "," + acc_str.subString(acc_len - 5, acc_len - 3) + "," + acc_str.subString(acc_len - 3);
  }

  cycle_display = input.avg_cycle_time + " days";
%>

<div class="mgmt-page-wrapper">

  <!-- Page Header -->
  <div class="mgmt-page-header">
    <div class="mgmt-page-header-left">
      <h1>Management Dashboard</h1>
      <p>Executive Financial &amp; Operational Overview — All Revisions</p>
    </div>
    <div class="mgmt-header-badge">
      <i class="zc-li-outline ui-2-time" style="font-size:13px;"></i>
      <span>As of <%= date_str %></span>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="mgmt-kpi-section">
    <div class="mgmt-kpi-grid">

      <!-- Card 1: Total Pending Cost Recovery -->
      <div class="mgmt-kpi-card" style="border-top-color:#137333;">
        <div class="mgmt-kpi-card-header">
          <div class="mgmt-kpi-icon-wrap" style="background:#137333;">
            <i class="zc-li-outline finance-1-currency-rupee"></i>
          </div>
        </div>
        <p class="mgmt-kpi-value" style="font-size:1.15rem;">INR <%= fin_formatted %></p>
        <p class="mgmt-kpi-label">Total Pending Cost Recovery</p>
        <p class="mgmt-kpi-sublabel">Sum of open revision financial impact</p>
      </div>

      <!-- Card 2: Recovered (Completed) -->
      <div class="mgmt-kpi-card" style="border-top-color:#34A853;">
        <div class="mgmt-kpi-card-header">
          <div class="mgmt-kpi-icon-wrap" style="background:#34A853;">
            <i class="zc-li-outline ui-1-check-circle-08"></i>
          </div>
        </div>
        <p class="mgmt-kpi-value" style="font-size:1.15rem;">INR <%= acc_formatted %></p>
        <p class="mgmt-kpi-label">Recovered (Completed)</p>
        <p class="mgmt-kpi-sublabel">Financial impact of completed revisions</p>
      </div>

      <!-- Card 3: Open Revisions -->
      <div class="mgmt-kpi-card" style="border-top-color:#1A73E8;">
        <div class="mgmt-kpi-card-header">
          <div class="mgmt-kpi-icon-wrap" style="background:#1A73E8;">
            <i class="zc-li-outline files-1-copy-07"></i>
          </div>
        </div>
        <p class="mgmt-kpi-value"><%= input.total_open_revisions %></p>
        <p class="mgmt-kpi-label">Open Revisions</p>
        <p class="mgmt-kpi-sublabel">Not completed or rejected</p>
      </div>

      <!-- Card 4: Avg. Cycle Time -->
      <div class="mgmt-kpi-card" style="border-top-color:#8430CE;">
        <div class="mgmt-kpi-card-header">
          <div class="mgmt-kpi-icon-wrap" style="background:#8430CE;">
            <i class="zc-li-outline ui-2-time"></i>
          </div>
        </div>
        <p class="mgmt-kpi-value"><%= cycle_display %></p>
        <p class="mgmt-kpi-label">Avg. Cycle Time</p>
        <p class="mgmt-kpi-sublabel">Submission to acceptance (completed)</p>
      </div>

      <!-- Card 5: Urgent Open Revisions -->
      <div class="mgmt-kpi-card" style="border-top-color:#EA4335;">
        <div class="mgmt-kpi-card-header">
          <div class="mgmt-kpi-icon-wrap" style="background:#EA4335;">
            <i class="zc-li-outline ui-2-alert-circle"></i>
          </div>
        </div>
        <p class="mgmt-kpi-value" style="color:#EA4335;"><%= input.urgent_count %></p>
        <p class="mgmt-kpi-label">Urgent Open Revisions</p>
        <p class="mgmt-kpi-sublabel">Flagged Urgent and still open</p>
      </div>

    </div>
  </div>

</div>
