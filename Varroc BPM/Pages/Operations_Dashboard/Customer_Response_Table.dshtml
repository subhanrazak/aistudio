<style>
/* ===== Customer Response Table styles ===== */
* { box-sizing: border-box; }
body, div, span, p, h1, h2, h3, h4, h5, h6, th, td { font-family: sans-serif; }

.ops-table-section-cr {
  padding: 8px 24px 20px 0;
}
.ops-table-card-cr {
  background: #FFFFFF;
  border-radius: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  border: 1px solid #e7e7ee;
  overflow: hidden;
  height: 100%;
}
.ops-table-header-cr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 12px 20px;
  border-bottom: 1px solid #e7e7ee;
  gap: 8px;
}
.ops-table-title-cr {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9375rem;
  font-weight: 600;
  color: #1A3C6E;
  margin: 0;
}
.ops-table-title-cr i {
  font-size: 16px;
  color: #34A853;
}
.ops-table-count-cr {
  font-size: 0.75rem;
  font-weight: 500;
  background: #F3F3F4;
  color: #6B7280;
  border-radius: 12px;
  padding: 2px 10px;
}
.ops-table-wrapper-cr {
  overflow-x: auto;
}
.ops-table-cr {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8125rem;
}
.ops-table-cr thead tr th {
  background: #F9FAFE;
  padding: 10px 14px;
  text-align: left;
  font-size: 0.75rem;
  font-weight: 600;
  color: #6B7280;
  white-space: nowrap;
  border-bottom: 1px solid #e7e7ee;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.ops-table-cr tbody tr td {
  padding: 10px 14px;
  font-size: 0.8125rem;
  color: var(--zcs_primary_text_color, #1A1A2E);
  border-bottom: 1px solid #f0f0f5;
  white-space: nowrap;
}
.ops-table-cr tbody tr:last-child td {
  border-bottom: none;
}
.ops-table-cr tbody tr:hover td {
  background: #F9FAFE;
}
.ops-badge-cr-pending { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #FFF3E0; color: #E65100; }
.ops-badge-cr-noresp { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #FDECEA; color: #EA4335; }
.ops-badge-cr-negotiation { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #E8F0FE; color: #1A73E8; }
.ops-empty-state-cr {
  text-align: center;
  padding: 32px 20px;
  color: #9CA3AF;
  font-size: 0.875rem;
}
.ops-empty-state-cr i {
  font-size: 32px;
  display: block;
  margin-bottom: 8px;
  color: #D1D5DB;
}
</style>

<%
  cr_records = Customer_Communication[Customer_Response == "Pending" || Customer_Response == "No Response" || Customer_Response == "Under Negotiation"] sort by Communication_Date range from 0 to 19;
  cr_count = cr_records.count();
%>

<div class="ops-table-section-cr">
  <div class="ops-table-card-cr">
    <div class="ops-table-header-cr">
      <h3 class="ops-table-title-cr">
        <i class="zc-li-outline users-1-multiple-11"></i>
        Awaiting Customer Response
      </h3>
      <span class="ops-table-count-cr"><%= cr_count %> items</span>
    </div>
    <div class="ops-table-wrapper-cr">
      <table class="ops-table-cr">
        <thead>
          <tr>
            <th>Revision ID</th>
            <th>Customer</th>
            <th>Comm. Date</th>
            <th>Response Status</th>
            <th>Follow-ups</th>
          </tr>
        </thead>
        <tbody>
          <%
            if(cr_count == 0)
            {
          %>
          <tr>
            <td colspan="5">
              <div class="ops-empty-state-cr">
                <i class="zc-li-outline users-1-multiple-11"></i>
                No pending customer responses
              </div>
            </td>
          </tr>
          <%
            }
            for each crec in cr_records
            {
              resp_status = crec.Customer_Response;
              badge_cls = "ops-badge-cr-pending";
              if(resp_status == "No Response") { badge_cls = "ops-badge-cr-noresp"; }
              if(resp_status == "Under Negotiation") { badge_cls = "ops-badge-cr-negotiation"; }
              comm_date_str = crec.Communication_Date.toString("dd MMM yyyy");
              followup_count = crec.Follow_Up_Count;
          %>
          <tr>
            <td><strong><%= crec.get("Revision_Reference").get("Revision_ID") %></strong></td>
            <td><%= crec.get("Customer_Display") %></td>
            <td><%= comm_date_str %></td>
            <td><span class="<%= badge_cls %>"><%= resp_status %></span></td>
            <td style="text-align:center;"><%= followup_count %></td>
          </tr>
          <%
            }
          %>
        </tbody>
      </table>
    </div>
  </div>
</div>
