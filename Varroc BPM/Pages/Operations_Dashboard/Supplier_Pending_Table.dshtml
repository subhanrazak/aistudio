<style>
/* ===== Supplier Pending Table styles ===== */
* { box-sizing: border-box; }
body, div, span, p, h1, h2, h3, h4, h5, h6, th, td { font-family: sans-serif; }

.ops-table-section-sp {
  padding: 0 24px 24px 24px;
}
.ops-table-card-sp {
  background: #FFFFFF;
  border-radius: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.07);
  border: 1px solid #e7e7ee;
  overflow: hidden;
}
.ops-table-header-sp {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 12px 20px;
  border-bottom: 1px solid #e7e7ee;
  gap: 8px;
}
.ops-table-title-sp {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9375rem;
  font-weight: 600;
  color: #1A3C6E;
  margin: 0;
}
.ops-table-title-sp i {
  font-size: 16px;
  color: #8430CE;
}
.ops-table-count-sp {
  font-size: 0.75rem;
  font-weight: 500;
  background: #F3F3F4;
  color: #6B7280;
  border-radius: 12px;
  padding: 2px 10px;
}
.ops-table-wrapper-sp {
  overflow-x: auto;
}
.ops-table-sp {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8125rem;
}
.ops-table-sp thead tr th {
  background: #F9FAFE;
  padding: 10px 14px;
  text-align: left;
  font-size: 0.75rem;
  font-weight: 600;
  color: #6B7280;
  white-space: nowrap;
  border-bottom: 1px solid #e7e7ee;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.ops-table-sp tbody tr td {
  padding: 10px 14px;
  font-size: 0.8125rem;
  color: var(--zcs_primary_text_color, #1A1A2E);
  border-bottom: 1px solid #f0f0f5;
  white-space: nowrap;
}
.ops-table-sp tbody tr:last-child td {
  border-bottom: none;
}
.ops-table-sp tbody tr:hover td {
  background: #F9FAFE;
}
.ops-badge-sp-pending { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #F3E8FF; color: #8430CE; }
.ops-badge-sp-negotiation { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; background: #E8F0FE; color: #1A73E8; }
.ops-empty-state-sp {
  text-align: center;
  padding: 32px 20px;
  color: #9CA3AF;
  font-size: 0.875rem;
}
.ops-empty-state-sp i {
  font-size: 32px;
  display: block;
  margin-bottom: 8px;
  color: #D1D5DB;
}
</style>

<%
  sp_records = Supplier_Amendment[Supplier_Response == "Pending" || Supplier_Response == "Under Negotiation"] sort by Amendment_Date range from 0 to 9;
  sp_count = sp_records.count();
%>

<div class="ops-table-section-sp">
  <div class="ops-table-card-sp">
    <div class="ops-table-header-sp">
      <h3 class="ops-table-title-sp">
        <i class="zc-li-outline e-commerce-box-3d-50"></i>
        Pending Supplier Amendments
      </h3>
      <span class="ops-table-count-sp"><%= sp_count %> items</span>
    </div>
    <div class="ops-table-wrapper-sp">
      <table class="ops-table-sp">
        <thead>
          <tr>
            <th>Revision ID</th>
            <th>Supplier</th>
            <th>Amendment Type</th>
            <th>Amendment Date</th>
            <th>Response Status</th>
          </tr>
        </thead>
        <tbody>
          <%
            if(sp_count == 0)
            {
          %>
          <tr>
            <td colspan="5">
              <div class="ops-empty-state-sp">
                <i class="zc-li-outline e-commerce-box-3d-50"></i>
                No pending supplier amendments
              </div>
            </td>
          </tr>
          <%
            }
            for each srec in sp_records
            {
              s_resp = srec.Supplier_Response;
              s_badge = "ops-badge-sp-pending";
              if(s_resp == "Under Negotiation") { s_badge = "ops-badge-sp-negotiation"; }
              amend_date_str = srec.Amendment_Date.toString("dd MMM yyyy");
          %>
          <tr>
            <td><strong><%= srec.get("Revision_Reference").get("Revision_ID") %></strong></td>
            <td><%= srec.get("Supplier_Name") %></td>
            <td><%= srec.Amendment_Type %></td>
            <td><%= amend_date_str %></td>
            <td><span class="<%= s_badge %>"><%= s_resp %></span></td>
          </tr>
          <%
            }
          %>
        </tbody>
      </table>
    </div>
  </div>
</div>
