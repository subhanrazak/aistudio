"Administrator"
{
    name        = "Administrator"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true }
    description = "Full administrative access to all modules, forms, reports, and configurations"

    ModulePermissions
    {
        SO_Baseline
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_SO_Baselines={"View","Edit","Delete"}
                Active_SOs={"View","Edit","Delete"}
            }
        }

        Revision_Request
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Revisions={"View","Edit","Delete"}
                My_Revisions={"View","Edit","Delete"}
                Urgent_Revisions={"View","Edit","Delete"}
                Pending_Approvals={"View","Edit","Delete"}
                Revisions_Board={"View","Edit","Delete"}
                Internally_Approved_Revisions={"View","Edit","Delete"}
            }
        }

        Approval_Log
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Approval_Logs={"View","Edit","Delete"}
                Approvals_By_Revision={"View","Edit","Delete"}
            }
        }

        Customer_Communication
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Customer_Communications={"View","Edit","Delete"}
                Awaiting_Customer_Response={"View","Edit","Delete"}
            }
        }

        Negotiation_Log
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Negotiations={"View","Edit","Delete"}
                Open_Negotiations={"View","Edit","Delete"}
            }
        }

        Supplier_Amendment
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supplier_Amendments={"View","Edit","Delete"}
                Pending_Supplier_Amendments={"View","Edit","Delete"}
            }
        }

        SO_Delivery_Schedule
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Delivery_Schedules={"View","Edit","Delete"}
            }
        }

        SO_Supplier_PO
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supplier_POs={"View","Edit","Delete"}
            }
        }

        Operations_Dashboard
        {
            enabled = tab
        }

        Management_Dashboard
        {
            enabled = tab
        }
    }
}
