"Procurement Staff"
{
    name        = "Procurement Staff"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Procurement team members who raise and track revision requests"

    ModulePermissions
    {
        SO_Baseline
        {
            enabled          = View,Viewall,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_SO_Baselines={"View"}
                Active_SOs={"View"}
            }
        }

        Revision_Request
        {
            enabled          = Create,View,Viewall,Edit,Search,Tab,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Level1_Action{visibility:true,readonly:true}
                Level1_Comments{visibility:true,readonly:true}
                Level1_Approved_By{visibility:true,readonly:true}
                Level1_Date{visibility:true,readonly:true}
                Level1_Start_Date{visibility:true,readonly:true}
                Level2_Action{visibility:true,readonly:true}
                Level2_Comments{visibility:true,readonly:true}
                Level2_Approved_By{visibility:true,readonly:true}
                Level2_Date{visibility:true,readonly:true}
                Level2_Start_Date{visibility:true,readonly:true}
                Level3_Action{visibility:true,readonly:true}
                Level3_Comments{visibility:true,readonly:true}
                Level3_Approved_By{visibility:true,readonly:true}
                Level3_Date{visibility:true,readonly:true}
                Level3_Start_Date{visibility:true,readonly:true}
                Overall_Status{visibility:true,readonly:true}
                Submitted_By{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Revisions={"View"}
                My_Revisions={"View"}
                Urgent_Revisions={"View"}
            }
        }

        Approval_Log
        {
            enabled          = View,Viewall,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Approval_Logs={"View"}
                Approvals_By_Revision={"View"}
            }
        }

        Customer_Communication
        {
            enabled          = Create,View,Viewall,Edit,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Customer_Communications={"View"}
                Awaiting_Customer_Response={"View"}
            }
        }

        Negotiation_Log
        {
            enabled          = Create,View,Viewall,Edit,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Negotiations={"View"}
                Open_Negotiations={"View"}
            }
        }

        Supplier_Amendment
        {
            enabled          = Create,View,Viewall,Edit,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supplier_Amendments={"View"}
                Pending_Supplier_Amendments={"View"}
            }
        }

        SO_Delivery_Schedule
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Delivery_Schedules={"View"}
            }
        }

        SO_Supplier_PO
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Supplier_POs={"View"}
            }
        }

        Operations_Dashboard
        {
            enabled = tab
        }
    }
}
