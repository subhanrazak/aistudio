"School_Admin"
{
    name        = "School_Admin"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:false }
    description = "Full school administration access for the academic module."

    ModulePermissions
    {
        Academic_Years
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Academic_Years={"View","Edit","Delete"}
            }
        }
        Subjects
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Subjects={"View","Edit","Delete"}
            }
        }
        Staff
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Staff={"View","Edit","Delete"}
            }
        }
        Classes
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Classes={"View","Edit","Delete"}
            }
        }
        Students
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Students={"View","Edit","Delete"}
                Active_Students={"View","Edit","Delete"}
            }
        }
        Class_Subjects
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Class_Subject_Mapping={"View","Edit","Delete"}
            }
        }
        Attendance
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Attendance_Register={"View","Edit","Delete"}
                Attendance_Calendar={"View","Edit","Delete"}
            }
        }
        Lesson_Plans
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Lesson_Plan_Register={"View","Edit","Delete"}
                Lesson_Plan_Calendar={"View","Edit","Delete"}
            }
        }
        Exams
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Exam_Schedule={"View","Edit","Delete"}
                Exam_Calendar={"View","Edit","Delete"}
            }
        }
        Marks
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Marks_Register={"View","Edit","Delete"}
                Failed_Students={"View","Edit","Delete"}
            }
        }
        Academic_Overview
        {
            enabled = tab
        }
    }
}
