"Department_Manager"
{
    name        = "Department_Manager"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "College management users with read-only oversight of transport activity."

    ModulePermissions
    {
        Departments
        {
            enabled = Viewall,View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Departments={"View"}
                Active_Departments={"View"}
            }
            FieldPermissions
            {
                Department_Information{visibility:true,readonly:true}
                Department_Name{visibility:true,readonly:true}
                Department_Code{visibility:true,readonly:true}
                Manager_Name{visibility:true,readonly:true}
                Manager_Email{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Notes{visibility:true,readonly:true}
            }
        }
        Staff_Directory
        {
            enabled = Viewall,View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Active_Staff_By_Department={"View"}
            }
            FieldPermissions
            {
                Staff_Information{visibility:true,readonly:true}
                Staff_ID{visibility:true,readonly:true}
                Staff_Name{visibility:true,readonly:true}
                Email{visibility:true,readonly:true}
                Phone{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Staff_Role{visibility:true,readonly:true}
                Active_Status{visibility:true,readonly:true}
                Notes{visibility:true,readonly:true}
            }
        }
        Vehicles
        {
            enabled = Viewall,View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Vehicles={"View"}
            }
            FieldPermissions
            {
                Vehicle_Information{visibility:true,readonly:true}
                Vehicle_Number{visibility:true,readonly:true}
                Vehicle_Type{visibility:true,readonly:true}
                Seating_Capacity{visibility:true,readonly:true}
                Fuel_Type{visibility:true,readonly:true}
                Registration_Expiry{visibility:true,readonly:true}
                Insurance_Expiry{visibility:true,readonly:true}
                Fitness_Certificate_Expiry{visibility:true,readonly:true}
                Active_Status{visibility:true,readonly:true}
                Availability_Status{visibility:true,readonly:true}
                Current_Odometer{visibility:true,readonly:true}
                Notes{visibility:true,readonly:true}
            }
        }
        Transport_Requests
        {
            enabled = Viewall,View,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                All_Transport_Requests={"View"}
                Completed_Trips={"View"}
                Transport_Status_Board={"View"}
                Trip_Calendar={"View"}
            }
            FieldPermissions
            {
                Request_Details{visibility:true,readonly:true}
                Request_Number{visibility:true,readonly:true}
                Requester{visibility:true,readonly:true}
                Requester_Email{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Request_DateTime{visibility:true,readonly:true}
                Travel_Start{visibility:true,readonly:true}
                Travel_End{visibility:true,readonly:true}
                Destination{visibility:true,readonly:true}
                Pickup_Location{visibility:true,readonly:true}
                Passenger_Count{visibility:true,readonly:true}
                Preferred_Vehicle_Type{visibility:true,readonly:true}
                Purpose{visibility:true,readonly:true}
                Additional_Requirements{visibility:true,readonly:true}
                Approval_and_Assignment{visibility:true,readonly:true}
                Request_Status{visibility:true,readonly:true}
                Manager_Remarks{visibility:true,readonly:true}
                Approval_DateTime{visibility:true,readonly:true}
                Approved_By_Email{visibility:true,readonly:true}
                Assigned_Vehicle{visibility:true,readonly:true}
                Assigned_Driver{visibility:true,readonly:true}
                Assignment_DateTime{visibility:true,readonly:true}
                Assignment_Remarks{visibility:true,readonly:true}
                Driver_and_Completion{visibility:true,readonly:true}
                Driver_Acknowledgement{visibility:true,readonly:true}
                Driver_Remarks{visibility:true,readonly:true}
                Completion_Remarks{visibility:true,readonly:true}
                Completed_By_Email{visibility:true,readonly:true}
                Completed_DateTime{visibility:true,readonly:true}
                Approval_Notification_Sent{visibility:false}
                Rejection_Notification_Sent{visibility:false}
                Assignment_Notification_Sent{visibility:false}
                Completion_Notification_Sent{visibility:false}
            }
        }
        Transport_Dashboard
        {
            enabled = tab
        }
    }
}
