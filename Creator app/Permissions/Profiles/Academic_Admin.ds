"Academic_Admin"
{
    name        = "Academic_Admin"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:false }
    description = "Academic administration access for academic setup and monitoring."

    ModulePermissions
    {
        Academic_Years
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Academic_Years={"View","Edit","Delete"}
            }
        }
        Subjects
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Subjects={"View","Edit","Delete"}
            }
        }
        Staff
        {
            enabled          = Viewall,Export,Tab,View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Staff={"View"}
            }
            FieldPermissions
            {
                Section_Staff{visibility:true,readonly:true}
                Staff_ID{visibility:true,readonly:true}
                Staff_Code{visibility:true,readonly:true}
                Staff_Name{visibility:true,readonly:true}
                Email{visibility:true,readonly:true}
                Phone{visibility:true,readonly:true}
                Staff_Role{visibility:true,readonly:true}
                Employment_Status{visibility:true,readonly:true}
                Joining_Date{visibility:true,readonly:true}
                Specialization{visibility:true,readonly:true}
                Remarks{visibility:true,readonly:true}
            }
        }
        Classes
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Classes={"View","Edit","Delete"}
            }
        }
        Students
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Students={"View","Edit","Delete"}
                Active_Students={"View","Edit","Delete"}
            }
        }
        Class_Subjects
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Class_Subject_Mapping={"View","Edit","Delete"}
            }
        }
        Attendance
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Attendance_Register={"View","Edit","Delete"}
                Attendance_Calendar={"View","Edit","Delete"}
            }
        }
        Lesson_Plans
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Lesson_Plan_Register={"View","Edit","Delete"}
                Lesson_Plan_Calendar={"View","Edit","Delete"}
            }
        }
        Exams
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Exam_Schedule={"View","Edit","Delete"}
                Exam_Calendar={"View","Edit","Delete"}
            }
        }
        Marks
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Marks_Register={"View","Edit","Delete"}
                Failed_Students={"View","Edit","Delete"}
            }
        }
        Academic_Overview
        {
            enabled = tab
        }
    }
}
