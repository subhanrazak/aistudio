"Teaching_Staff"
{
    name        = "Teaching_Staff"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Teaching staff access for classes, attendance, lesson plans, exams, and marks."

    ModulePermissions
    {
        Academic_Years
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Academic_Years={"View"}
            }
        }
        Subjects
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Subjects={"View"}
            }
        }
        Staff
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Staff={"View"}
            }
            FieldPermissions
            {
                Section_Staff{visibility:true,readonly:true}
                Staff_ID{visibility:true,readonly:true}
                Staff_Code{visibility:true,readonly:true}
                Staff_Name{visibility:true,readonly:true}
                Email{visibility:true,readonly:true}
                Phone{visibility:true,readonly:true}
                Staff_Role{visibility:true,readonly:true}
                Employment_Status{visibility:true,readonly:true}
                Joining_Date{visibility:true,readonly:true}
                Specialization{visibility:true,readonly:true}
                Remarks{visibility:false}
            }
        }
        Classes
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Classes={"View"}
            }
        }
        Students
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Students={"View"}
                Active_Students={"View"}
            }
            FieldPermissions
            {
                Section_Student{visibility:true,readonly:true}
                Student_ID{visibility:true,readonly:true}
                Admission_Number{visibility:true,readonly:true}
                Student_Name{visibility:true,readonly:true}
                Gender{visibility:true,readonly:true}
                Date_of_Birth{visibility:true,readonly:true}
                Class{visibility:true,readonly:true}
                Roll_Number{visibility:true,readonly:true}
                Parent_Name{visibility:true,readonly:true}
                Parent_Email{visibility:true,readonly:true}
                Parent_Phone{visibility:true,readonly:true}
                Admission_Date{visibility:true,readonly:true}
                Enrollment_Status{visibility:true,readonly:true}
                Address{visibility:false}
                Medical_Notes{visibility:false}
            }
        }
        Class_Subjects
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Class_Subject_Mapping={"View"}
            }
        }
        Attendance
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Attendance_Register={"View","Edit"}
                Attendance_Calendar={"View","Edit"}
            }
        }
        Lesson_Plans
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Lesson_Plan_Register={"View","Edit"}
                Lesson_Plan_Calendar={"View","Edit"}
            }
        }
        Exams
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Exam_Schedule={"View"}
                Exam_Calendar={"View"}
            }
        }
        Marks
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Marks_Register={"View","Edit"}
                Failed_Students={"View"}
            }
        }
        Academic_Overview
        {
            enabled = tab
        }
    }
}
