"Transport_Manager"
{
    name        = "Transport_Manager"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Transport office users who manage masters, approvals, assignments, and completion."

    ModulePermissions
    {
        Departments
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Departments={"View","Edit","Delete"}
                Active_Departments={"View","Edit"}
            }
        }
        Staff_Directory
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Staff_Directory={"View","Edit","Delete"}
                Active_Staff_By_Department={"View","Edit"}
            }
        }
        Transport_Team
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Transport_Team={"View","Edit","Delete"}
                Active_Approvers={"View","Edit"}
            }
        }
        Drivers
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Drivers={"View","Edit","Delete"}
                Available_Drivers={"View","Edit"}
                Driver_License_Expiry={"View","Edit"}
            }
        }
        Vehicles
        {
            enabled = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Vehicles={"View","Edit","Delete"}
                Available_Vehicles={"View","Edit"}
                Vehicle_Compliance_Expiry={"View","Edit"}
            }
        }
        Transport_Requests
        {
            enabled = Create,Viewall,Modifyall,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Transport_Requests={"View","Edit","Delete"}
                My_Transport_Requests={"View","Edit"}
                Pending_Transport_Approvals={"View","Edit"}
                Approved_For_Assignment={"View","Edit"}
                Assigned_Trips={"View","Edit"}
                Driver_My_Trips={"View","Edit"}
                Completed_Trips={"View","Edit"}
                Transport_Status_Board={"View","Edit"}
                Trip_Calendar={"View","Edit"}
            }
        }
        Transport_Dashboard
        {
            enabled = tab
        }
    }
