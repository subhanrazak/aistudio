"Driver"
{
    name        = "Driver"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Drivers who view assigned trips and update driver-side trip progress."

    ModulePermissions
    {
        Drivers
        {
            enabled = View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Driver_Information{visibility:true,readonly:true}
                Driver_Name{visibility:true,readonly:true}
                Driver_Email{visibility:true,readonly:true}
                Driver_Phone{visibility:true,readonly:true}
                License_Number{visibility:true,readonly:true}
                License_Expiry{visibility:true,readonly:true}
                Badge_Number{visibility:true,readonly:true}
                Active_Status{visibility:true,readonly:true}
                Availability_Status{visibility:true,readonly:true}
                Notes{visibility:false}
            }
        }
        Transport_Requests
        {
            enabled = Viewall,View,Edit,Search,Tab
            allFieldsVisible = false
            ReportPermissions
            {
                Driver_My_Trips={"View","Edit"}
                Trip_Calendar={"View"}
            }
            FieldPermissions
            {
                Request_Details{visibility:true,readonly:true}
                Request_Number{visibility:true,readonly:true}
                Requester{visibility:true,readonly:true}
                Requester_Email{visibility:false}
                Department{visibility:true,readonly:true}
                Request_DateTime{visibility:true,readonly:true}
                Travel_Start{visibility:true,readonly:true}
                Travel_End{visibility:true,readonly:true}
                Destination{visibility:true,readonly:true}
                Pickup_Location{visibility:true,readonly:true}
                Passenger_Count{visibility:true,readonly:true}
                Preferred_Vehicle_Type{visibility:true,readonly:true}
                Purpose{visibility:true,readonly:true}
                Additional_Requirements{visibility:true,readonly:true}
                Approval_and_Assignment{visibility:true,readonly:true}
                Request_Status{visibility:true,readonly:true}
                Manager_Remarks{visibility:true,readonly:true}
                Approval_DateTime{visibility:true,readonly:true}
                Approved_By_Email{visibility:false}
                Assigned_Vehicle{visibility:true,readonly:true}
                Assigned_Driver{visibility:true,readonly:true}
                Assignment_DateTime{visibility:true,readonly:true}
                Assignment_Remarks{visibility:true,readonly:true}
                Driver_and_Completion{visibility:true,readonly:true}
                Driver_Acknowledgement{visibility:true,readonly:false}
                Driver_Remarks{visibility:true,readonly:false}
                Completion_Remarks{visibility:true,readonly:false}
                Completed_By_Email{visibility:true,readonly:true}
                Completed_DateTime{visibility:true,readonly:true}
                Approval_Notification_Sent{visibility:false}
                Rejection_Notification_Sent{visibility:false}
                Assignment_Notification_Sent{visibility:false}
                Completion_Notification_Sent{visibility:false}
            }
        }
    }
}
