Attendance_On_Load as "Prepare Attendance Form"
{
    type = form
    form = Attendance
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Attendance_Date == null)
                {
                    input.Attendance_Date = zoho.currentdate;
                }
                if(input.Class == null)
                {
                    clear Student;
                }
            )
        }
    }
}
