form Attendance
{
    displayname = "Attendance"
    Section_Attendance
    (
        type = section
        displayname = "Attendance Details"
        row = 1
        column = 0
    )
    must have Class
    (
        type = picklist
        displayname = "Class"
        values = Classes.ID
        displayformat = [Class_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Student
    (
        type = picklist
        displayname = "Student"
        values = Students.ID
        displayformat = [Admission_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Attendance_Date
    (
        type = date
        displayname = "Attendance Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Session
    (
        type = picklist
        displayname = "Session"
        values = {"Full Day","AM","PM"}
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Present","Absent","Late","Excused"}
        row = 1
        column = 1
        width = medium
    )
    Marked_By
    (
        type = picklist
        displayname = "Marked By"
        values = Staff.ID
        displayformat = [Staff_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save attendance"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
