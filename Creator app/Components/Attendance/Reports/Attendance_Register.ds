default list Attendance_Register
{
    displayName = "Attendance Register"
    show all rows from Attendance
    (
        Class
        Student
        Attendance_Date
        Session
        Status
        Marked_By
        Remarks
    )
    filters
    (
        Class
        Student
        Attendance_Date
        Session
        Status
    )
    sort by
    (
        Attendance_Date descending
    )
}
