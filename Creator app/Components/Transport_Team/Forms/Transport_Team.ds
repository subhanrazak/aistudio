form Transport_Team
{
    displayname = "Transport Team"
    Team_Member_Information
    (
        type = section
        displayname = "Team Member Information"
        row = 1
        column = 0
    )
    must have Member_Name
    (
        type = text
        displayname = "Member Name"
        row = 1
        column = 1
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 1
        width = medium
    )
    must have Team_Role
    (
        type = picklist
        displayname = "Team Role"
        values = {"Transport Manager", "Coordinator", "Dispatcher"}
        row = 1
        column = 2
        width = medium
    )
    Can_Approve
    (
        type = checkbox
        displayname = "Can Approve Requests"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    must have Active_Status
    (
        type = picklist
        displayname = "Active Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
