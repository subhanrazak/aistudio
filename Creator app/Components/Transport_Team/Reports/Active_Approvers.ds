list Active_Approvers
{
    displayName = "Active Approvers"
    show all rows from Transport_Team [Active_Status == "Active" && Can_Approve == true]
    (
        Member_Name
        Email
        Phone
        Team_Role
    )
    filters
    (
        Team_Role
    )
    sort by
    (
        Member_Name ascending
    )
}
