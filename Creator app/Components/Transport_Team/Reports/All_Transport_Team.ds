default list All_Transport_Team
{
    displayName = "All Transport Team"
    show all rows from Transport_Team
    (
        Member_Name
        Email
        Phone
        Team_Role
        Can_Approve
        Active_Status
    )
    filters
    (
        Team_Role
        Can_Approve
        Active_Status
    )
    sort by
    (
        Member_Name ascending
    )
}
