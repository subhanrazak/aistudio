form Departments
{
    displayname = "Departments"
    Department_Information
    (
        type = section
        displayname = "Department Information"
        row = 1
        column = 0
    )
    must have unique Department_Name
    (
        type = text
        displayname = "Department Name"
        row = 1
        column = 1
        width = medium
    )
    unique Department_Code
    (
        type = text
        displayname = "Department Code"
        row = 1
        column = 2
        width = medium
    )
    Manager_Name
    (
        type = text
        displayname = "Manager Name"
        row = 1
        column = 1
        width = medium
    )
    Manager_Email
    (
        type = email
        displayname = "Manager Email"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
