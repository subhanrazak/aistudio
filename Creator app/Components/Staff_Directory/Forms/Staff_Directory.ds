form Staff_Directory
{
    displayname = "Staff Directory"
    Staff_Information
    (
        type = section
        displayname = "Staff Information"
        row = 1
        column = 0
    )
    unique Staff_ID
    (
        type = text
        displayname = "Staff ID"
        row = 1
        column = 1
        width = medium
    )
    must have Staff_Name
    (
        type = text
        displayname = "Staff Name"
        row = 1
        column = 2
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 2
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Staff_Role
    (
        type = picklist
        displayname = "Staff Role"
        values = {"Teaching", "Non-Teaching", "Administration", "Management", "Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Active_Status
    (
        type = picklist
        displayname = "Active Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
