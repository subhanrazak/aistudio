list Active_Staff_By_Department
{
    displayName = "Active Staff By Department"
    show all rows from Staff_Directory [Active_Status == "Active"]
    (
        Staff_Name
        Email
        Phone
        Department
        Staff_Role
    )
    filters
    (
        Department
        Staff_Role
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Department ascending
    )
    sort by
    (
        Staff_Name ascending
    )
}
