form Academic_Years
{
    displayname = "Academic Years"
    Section_Academic_Year
    (
        type = section
        displayname = "Academic Year Details"
        row = 1
        column = 0
    )
    must have unique Academic_Year_Name
    (
        type = text
        displayname = "Academic Year"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 2
        width = medium
    )
    must have End_Date
    (
        type = date
        displayname = "End Date"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Planned","Active","Closed"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save academic year"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
