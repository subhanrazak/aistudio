Academic_Years_On_Validate as "Validate Academic Year Dates"
{
    type = form
    form = Academic_Years
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.End_Date < input.Start_Date)
                {
                    alert "End Date cannot be before Start Date.";
                    cancel submit;
                }
            )
        }
    }
}
