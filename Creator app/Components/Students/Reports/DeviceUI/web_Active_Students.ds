report Active_Students
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Admission_Number
                    Student_Name
                    Class
                    Roll_Number
                    Parent_Name
                    Parent_Phone
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Admission_Number
                    Student_Name
                    Class
                    Roll_Number
                    Parent_Name
                    Parent_Phone
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}