default list All_Students
{
    displayName = "All Students"
    show all rows from Students
    (
        Admission_Number
        Student_Name
        Gender
        Class
        Roll_Number
        Parent_Name
        Parent_Phone
        Admission_Date
        Enrollment_Status
    )
    filters
    (
        Class
        Gender
        Enrollment_Status
    )
    sort by
    (
        Student_Name ascending
    )
}
