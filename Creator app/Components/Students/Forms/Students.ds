form Students
{
    displayname = "Students"
    Section_Student
    (
        type = section
        displayname = "Student Details"
        row = 1
        column = 0
    )
    Student_ID
    (
        type = autonumber
        displayname = "Student ID"
        start index = 10001
        row = 1
        column = 1
        width = medium
    )
    must have unique Admission_Number
    (
        type = text
        displayname = "Admission Number"
        maxchar = 30
        row = 1
        column = 2
        width = medium
    )
    must have Student_Name
    (
        type = name
        displayname = "Student Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Master","Miss"}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 1
        width = medium
    )
    must have Gender
    (
        type = radiobuttons
        displayname = "Gender"
        values = {"Male","Female","Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Date_of_Birth
    (
        type = date
        displayname = "Date of Birth"
        row = 1
        column = 1
        width = medium
    )
    must have Class
    (
        type = picklist
        displayname = "Class"
        values = Classes.ID
        displayformat = [Class_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Roll_Number
    (
        type = number
        displayname = "Roll Number"
        row = 1
        column = 1
        width = medium
    )
    must have Parent_Name
    (
        type = text
        displayname = "Parent Name"
        maxchar = 100
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Parent_Email
    (
        type = email
        displayname = "Parent Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Parent_Phone
    (
        type = phonenumber
        displayname = "Parent Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Admission_Date
    (
        type = date
        displayname = "Admission Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    must have Enrollment_Status
    (
        type = picklist
        displayname = "Enrollment Status"
        values = {"Active","Inactive","Graduated","Transferred"}
        row = 1
        column = 2
        width = medium
    )
    Address
    (
        type = textarea
        displayname = "Address"
        personal data = true
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Medical_Notes
    (
        type = textarea
        displayname = "Medical Notes"
        personal data = true
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save student"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
