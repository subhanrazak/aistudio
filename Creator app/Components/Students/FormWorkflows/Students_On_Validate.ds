Students_On_Validate as "Validate Student Details"
{
    type = form
    form = Students
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Date_of_Birth > zoho.currentdate)
                {
                    alert "Date of Birth cannot be in the future.";
                    cancel submit;
                }
                if(input.Admission_Date < input.Date_of_Birth)
                {
                    alert "Admission Date cannot be before Date of Birth.";
                    cancel submit;
                }
            )
        }
    }
}
