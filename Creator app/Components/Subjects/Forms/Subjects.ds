form Subjects
{
    displayname = "Subjects"
    Section_Subject
    (
        type = section
        displayname = "Subject Details"
        row = 1
        column = 0
    )
    must have unique Subject_Code
    (
        type = text
        displayname = "Subject Code"
        maxchar = 20
        row = 1
        column = 1
        width = medium
    )
    must have unique Subject_Name
    (
        type = text
        displayname = "Subject Name"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    must have Subject_Type
    (
        type = picklist
        displayname = "Subject Type"
        values = {"Core","Language","Elective","Practical","Co-curricular"}
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save subject"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
