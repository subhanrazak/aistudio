form Marks
{
    displayname = "Marks"
    Section_Marks
    (
        type = section
        displayname = "Marks Details"
        row = 1
        column = 0
    )
    must have Exam
    (
        type = picklist
        displayname = "Exam"
        values = Exams.ID
        displayformat = [Exam_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Student
    (
        type = picklist
        displayname = "Student"
        values = Students.ID
        displayformat = [Admission_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Marks_Obtained
    (
        type = decimal
        displayname = "Marks Obtained"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Percentage
    (
        type = decimal
        displayname = "Percentage"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Grade
    (
        type = text
        displayname = "Grade"
        maxchar = 5
        row = 1
        column = 1
        width = medium
    )
    Result
    (
        type = picklist
        displayname = "Result"
        values = {"Pass","Fail","Absent"}
        row = 1
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save marks"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
