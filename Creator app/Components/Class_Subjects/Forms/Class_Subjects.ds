form Class_Subjects
{
    displayname = "Class Subject Mapping"
    Section_Mapping
    (
        type = section
        displayname = "Mapping Details"
        row = 1
        column = 0
    )
    must have unique Mapping_Code
    (
        type = text
        displayname = "Mapping Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Academic_Year
    (
        type = picklist
        displayname = "Academic Year"
        values = Academic_Years.ID
        displayformat = [Academic_Year_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Class
    (
        type = picklist
        displayname = "Class"
        values = Classes.ID
        displayformat = [Class_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Subject
    (
        type = picklist
        displayname = "Subject"
        values = Subjects.ID
        displayformat = [Subject_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Teacher
    (
        type = picklist
        displayname = "Teacher"
        values = Staff.ID
        displayformat = [Staff_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Weekly_Periods
    (
        type = number
        displayname = "Weekly Periods"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        row = 1
        column = 1
        width = medium
    )
    Syllabus_Notes
    (
        type = textarea
        displayname = "Syllabus Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save class subject mapping"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
