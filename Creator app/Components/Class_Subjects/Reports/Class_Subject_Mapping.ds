default list Class_Subject_Mapping
{
    displayName = "Class Subject Mapping"
    show all rows from Class_Subjects
    (
        Mapping_Code
        Academic_Year
        Class
        Subject
        Teacher
        Weekly_Periods
        Status
    )
    filters
    (
        Academic_Year
        Class
        Subject
        Teacher
        Status
    )
    sort by
    (
        Class ascending
    )
}
