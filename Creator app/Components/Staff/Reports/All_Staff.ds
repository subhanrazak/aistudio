default list All_Staff
{
    displayName = "All Staff"
    show all rows from Staff
    (
        Staff_Code
        Staff_Name
        Email
        Phone
        Staff_Role
        Employment_Status
        Joining_Date
    )
    filters
    (
        Staff_Role
        Employment_Status
    )
    sort by
    (
        Staff_Name ascending
    )
}
