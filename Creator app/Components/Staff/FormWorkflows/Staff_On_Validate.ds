Staff_On_Validate as "Validate Staff Details"
{
    type = form
    form = Staff
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Joining_Date != null && input.Joining_Date > zoho.currentdate)
                {
                    alert "Joining Date cannot be in the future.";
                    cancel submit;
                }
            )
        }
    }
}
