form Staff
{
    displayname = "Staff"
    Section_Staff
    (
        type = section
        displayname = "Staff Details"
        row = 1
        column = 0
    )
    Staff_ID
    (
        type = autonumber
        displayname = "Staff ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have unique Staff_Code
    (
        type = text
        displayname = "Staff Code"
        maxchar = 20
        row = 1
        column = 1
        width = medium
    )
    must have Staff_Name
    (
        type = name
        displayname = "Staff Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            value = {"Mr.","Mrs.","Ms.","Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 2
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Staff_Role
    (
        type = picklist
        displayname = "Staff Role"
        values = {"Teaching Staff","Admin","Office Staff","Academic Admin","Security","Inventory Admin","Librarian","Hostel Admin","Transport Admin"}
        row = 1
        column = 1
        width = medium
    )
    must have Employment_Status
    (
        type = picklist
        displayname = "Employment Status"
        values = {"Active","On Leave","Inactive"}
        row = 1
        column = 2
        width = medium
    )
    Joining_Date
    (
        type = date
        displayname = "Joining Date"
        row = 1
        column = 1
        width = medium
    )
    Specialization
    (
        type = text
        displayname = "Specialization"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save staff member"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
