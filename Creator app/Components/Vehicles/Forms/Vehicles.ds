form Vehicles
{
    displayname = "Vehicles"
    Vehicle_Information
    (
        type = section
        displayname = "Vehicle Information"
        row = 1
        column = 0
    )
    must have unique Vehicle_Number
    (
        type = text
        displayname = "Vehicle Number"
        row = 1
        column = 1
        width = medium
    )
    must have Vehicle_Type
    (
        type = picklist
        displayname = "Vehicle Type"
        values = {"Bus", "Van", "Car", "Jeep", "Tempo Traveller", "Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Seating_Capacity
    (
        type = number
        displayname = "Seating Capacity"
        row = 1
        column = 1
        width = medium
    )
    Fuel_Type
    (
        type = picklist
        displayname = "Fuel Type"
        values = {"Diesel", "Petrol", "CNG", "Electric", "Hybrid", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Registration_Expiry
    (
        type = date
        displayname = "Registration Expiry"
        row = 1
        column = 1
        width = medium
    )
    Insurance_Expiry
    (
        type = date
        displayname = "Insurance Expiry"
        row = 1
        column = 2
        width = medium
    )
    Fitness_Certificate_Expiry
    (
        type = date
        displayname = "Fitness Certificate Expiry"
        row = 1
        column = 1
        width = medium
    )
    must have Active_Status
    (
        type = picklist
        displayname = "Active Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    must have Availability_Status
    (
        type = picklist
        displayname = "Availability Status"
        values = {"Available", "Assigned", "Maintenance", "Inactive"}
        initial value = "Available"
        row = 1
        column = 1
        width = medium
    )
    Current_Odometer
    (
        type = number
        displayname = "Current Odometer"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
