list Vehicle_Compliance_Expiry
{
    displayName = "Vehicle Compliance Expiry"
    show all rows from Vehicles [Active_Status == "Active"]
    (
        Vehicle_Number
        Vehicle_Type
        Registration_Expiry
        Insurance_Expiry
        Fitness_Certificate_Expiry
        Availability_Status
    )
    filters
    (
        Registration_Expiry
        Insurance_Expiry
        Fitness_Certificate_Expiry
    )
    sort by
    (
        Insurance_Expiry ascending
    )
}
