default list All_Vehicles
{
    displayName = "All Vehicles"
    show all rows from Vehicles
    (
        Vehicle_Number
        Vehicle_Type
        Seating_Capacity
        Fuel_Type
        Registration_Expiry
        Insurance_Expiry
        Fitness_Certificate_Expiry
        Active_Status
        Availability_Status
        Current_Odometer
    )
    filters
    (
        Vehicle_Type
        Active_Status
        Availability_Status
    )
    sort by
    (
        Vehicle_Number ascending
    )
}
