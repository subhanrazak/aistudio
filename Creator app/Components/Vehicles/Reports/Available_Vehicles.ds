list Available_Vehicles
{
    displayName = "Available Vehicles"
    show all rows from Vehicles [Active_Status == "Active" && Availability_Status == "Available"]
    (
        Vehicle_Number
        Vehicle_Type
        Seating_Capacity
        Fuel_Type
        Availability_Status
    )
    filters
    (
        Vehicle_Type
        Seating_Capacity
    )
    sort by
    (
        Vehicle_Type ascending
        Vehicle_Number ascending
    )
}
