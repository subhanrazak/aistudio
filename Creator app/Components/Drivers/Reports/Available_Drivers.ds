list Available_Drivers
{
    displayName = "Available Drivers"
    show all rows from Drivers [Active_Status == "Active" && Availability_Status == "Available"]
    (
        Driver_Name
        Driver_Email
        Driver_Phone
        License_Expiry
        Availability_Status
    )
    filters
    (
        Availability_Status
    )
    sort by
    (
        Driver_Name ascending
    )
}
