default list All_Drivers
{
    displayName = "All Drivers"
    show all rows from Drivers
    (
        Driver_Name
        Driver_Email
        Driver_Phone
        License_Number
        License_Expiry
        Badge_Number
        Active_Status
        Availability_Status
    )
    filters
    (
        Active_Status
        Availability_Status
    )
    sort by
    (
        Driver_Name ascending
    )
}
