list Driver_License_Expiry
{
    displayName = "Driver License Expiry"
    show all rows from Drivers [Active_Status == "Active"]
    (
        Driver_Name
        Driver_Email
        Driver_Phone
        License_Number
        License_Expiry
        Availability_Status
    )
    filters
    (
        License_Expiry
        Availability_Status
    )
    sort by
    (
        License_Expiry ascending
    )
}
