form Drivers
{
    displayname = "Drivers"
    Driver_Information
    (
        type = section
        displayname = "Driver Information"
        row = 1
        column = 0
    )
    must have Driver_Name
    (
        type = text
        displayname = "Driver Name"
        row = 1
        column = 1
        width = medium
    )
    must have unique Driver_Email
    (
        type = email
        displayname = "Driver Email"
        row = 1
        column = 2
        width = medium
    )
    Driver_Phone
    (
        type = phonenumber
        displayname = "Driver Phone"
        row = 1
        column = 1
        width = medium
    )
    must have unique License_Number
    (
        type = text
        displayname = "License Number"
        row = 1
        column = 2
        width = medium
    )
    License_Expiry
    (
        type = date
        displayname = "License Expiry"
        row = 1
        column = 1
        width = medium
    )
    Badge_Number
    (
        type = text
        displayname = "Badge Number"
        row = 1
        column = 2
        width = medium
    )
    must have Active_Status
    (
        type = picklist
        displayname = "Active Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    must have Availability_Status
    (
        type = picklist
        displayname = "Availability Status"
        values = {"Available", "Assigned", "On Leave", "Inactive"}
        initial value = "Available"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
