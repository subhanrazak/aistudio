Lesson_Plans_On_Load as "Prepare Lesson Plan Form"
{
    type = form
    form = Lesson_Plans
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if(input.Plan_Status == "Completed")
                {
                    show Completion_Date;
                }
                else
                {
                    hide Completion_Date;
                }
            )
        }
    }
}
