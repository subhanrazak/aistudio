form Lesson_Plans
{
    displayname = "Lesson Plans"
    Section_Lesson_Plan
    (
        type = section
        displayname = "Lesson Plan Details"
        row = 1
        column = 0
    )
    must have Class_Subject
    (
        type = picklist
        displayname = "Class Subject"
        values = Class_Subjects.ID
        displayformat = [Mapping_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Plan_Date
    (
        type = date
        displayname = "Plan Date"
        row = 1
        column = 2
        width = medium
    )
    must have Topic
    (
        type = text
        displayname = "Topic"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Learning_Objectives
    (
        type = textarea
        displayname = "Learning Objectives"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    must have Plan_Status
    (
        type = picklist
        displayname = "Plan Status"
        values = {"Planned","In Progress","Completed","Delayed"}
        row = 1
        column = 1
        width = medium
    )
    Completion_Date
    (
        type = date
        displayname = "Completion Date"
        row = 1
        column = 2
        width = medium
    )
    Teacher_Notes
    (
        type = textarea
        displayname = "Teacher Notes"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save lesson plan"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
