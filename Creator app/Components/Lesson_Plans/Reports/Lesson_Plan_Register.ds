default list Lesson_Plan_Register
{
    displayName = "Lesson Plan Register"
    show all rows from Lesson_Plans
    (
        Class_Subject
        Plan_Date
        Topic
        Plan_Status
        Completion_Date
    )
    filters
    (
        Class_Subject
        Plan_Date
        Plan_Status
    )
    sort by
    (
        Plan_Date descending
    )
}
