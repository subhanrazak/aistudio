calendar Lesson_Plan_Calendar
{
    displayName = "Lesson Plan Calendar"
    show all rows from Lesson_Plans
    (
        Class_Subject
        Plan_Date
        Topic
        Plan_Status
    )
    filters
    (
        Plan_Status
    )
    options
    (
        display type = month
        week start day = monday
        display field = Topic
        start date = Plan_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
