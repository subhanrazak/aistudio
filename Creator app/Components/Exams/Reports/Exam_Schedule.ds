default list Exam_Schedule
{
    displayName = "Exam Schedule"
    show all rows from Exams
    (
        Exam_Name
        Academic_Year
        Class
        Subject
        Exam_Date
        Exam_Type
        Max_Marks
        Pass_Marks
        Status
    )
    filters
    (
        Academic_Year
        Class
        Subject
        Exam_Type
        Status
    )
    sort by
    (
        Exam_Date descending
    )
}
