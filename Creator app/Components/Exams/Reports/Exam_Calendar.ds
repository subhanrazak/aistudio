calendar Exam_Calendar
{
    displayName = "Exam Calendar"
    show all rows from Exams
    (
        Exam_Name
        Class
        Subject
        Exam_Date
        Status
    )
    filters
    (
        Class
        Status
    )
    options
    (
        display type = month
        week start day = monday
        display field = Exam_Name
        start date = Exam_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
