form Exams
{
    displayname = "Exams"
    Section_Exam
    (
        type = section
        displayname = "Exam Details"
        row = 1
        column = 0
    )
    must have Exam_Name
    (
        type = text
        displayname = "Exam Name"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    must have Academic_Year
    (
        type = picklist
        displayname = "Academic Year"
        values = Academic_Years.ID
        displayformat = [Academic_Year_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Class
    (
        type = picklist
        displayname = "Class"
        values = Classes.ID
        displayformat = [Class_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Subject
    (
        type = picklist
        displayname = "Subject"
        values = Subjects.ID
        displayformat = [Subject_Code]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Exam_Date
    (
        type = date
        displayname = "Exam Date"
        row = 1
        column = 1
        width = medium
    )
    must have Exam_Type
    (
        type = picklist
        displayname = "Exam Type"
        values = {"Unit Test","Mid Term","Final","Assignment","Practical"}
        row = 1
        column = 2
        width = medium
    )
    must have Max_Marks
    (
        type = decimal
        displayname = "Max Marks"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    must have Pass_Marks
    (
        type = decimal
        displayname = "Pass Marks"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Scheduled","Completed","Cancelled"}
        row = 1
        column = 1
        width = medium
    )
    Instructions
    (
        type = textarea
        displayname = "Instructions"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save exam"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
