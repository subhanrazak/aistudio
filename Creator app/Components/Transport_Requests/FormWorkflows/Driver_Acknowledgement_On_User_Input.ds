Driver_Acknowledgement_On_User_Input as "Driver Acknowledgement On User Input"
{
    type = form
    form = Transport_Requests
    record event = on add or edit
    description = "Guides drivers when acknowledging or declining an assigned trip."

    on user input of Driver_Acknowledgement
    {
        actions
        {
            custom deluge script
            (
                if(input.Driver_Acknowledgement == "Unable To Serve")
                {
                    alert "Please enter Driver Remarks explaining why you are unable to serve this trip.";
                }
                else if(input.Driver_Acknowledgement == "Acknowledged")
                {
                    alert "Trip acknowledged. Add Driver Remarks if the transport team needs any note.";
                }
            )
        }
    }
}
