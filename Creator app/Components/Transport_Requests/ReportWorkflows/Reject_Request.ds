Reject_Request as "Reject Request"
{
    type = functions
    form = Transport_Requests
    execution type = for each record
    description = "Rejects a pending transport request from the approvals report."

    on start
    {
        actions
        {
            on click
            (
                if(input.Request_Status == "Pending")
                {
                    input.Request_Status = "Rejected";
                    input.Approved_By_Email = zoho.loginuserid;
                    input.Approval_DateTime = zoho.currenttime;
                    if(input.Manager_Remarks == null || input.Manager_Remarks == "")
                    {
                        input.Manager_Remarks = "Rejected by transport manager.";
                    }
                }
            )
        }
    }
}
