form Transport_Requests
{
    displayname = "Transport Requests"
    success message = "Transport request saved successfully."
    record owner = Added_User
    Request_Details
    (
        type = section
        displayname = "Request Details"
        row = 1
        column = 0
    )
    Request_Number
    (
        type = autonumber
        displayname = "Request Number"
        start index = 1000
        row = 1
        column = 1
        width = medium
    )
    Requester
    (
        type = picklist
        displayname = "Requester"
        values = Staff_Directory.ID
        displayformat = [Staff_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Requester_Email
    (
        type = email
        displayname = "Requester Email"
        row = 1
        column = 2
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Request_DateTime
    (
        type = datetime
        displayname = "Request Date/Time"
        row = 1
        column = 2
        width = medium
    )
    must have Travel_Start
    (
        type = datetime
        displayname = "Travel Start"
        row = 1
        column = 1
        width = medium
    )
    must have Travel_End
    (
        type = datetime
        displayname = "Travel End"
        row = 1
        column = 2
        width = medium
    )
    must have Destination
    (
        type = text
        displayname = "Destination"
        row = 1
        column = 1
        width = medium
    )
    must have Pickup_Location
    (
        type = text
        displayname = "Pickup Location"
        row = 1
        column = 2
        width = medium
    )
    must have Passenger_Count
    (
        type = number
        displayname = "Passenger Count"
        row = 1
        column = 1
        width = medium
    )
    Preferred_Vehicle_Type
    (
        type = picklist
        displayname = "Preferred Vehicle Type"
        values = {"Bus", "Van", "Car", "Jeep", "Tempo Traveller", "Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Purpose
    (
        type = textarea
        displayname = "Purpose of Travel"
        row = 1
        column = 1
        width = medium
    )
    Additional_Requirements
    (
        type = textarea
        displayname = "Additional Requirements"
        row = 1
        column = 2
        width = medium
    )
    Approval_and_Assignment
    (
        type = section
        displayname = "Approval and Assignment"
        visibility = true
        row = 2
        column = 1
    )
    must have Request_Status
    (
        type = picklist
        displayname = "Request Status"
        values = {"Pending", "Approved", "Rejected", "Vehicle Assigned", "Completed"}
        initial value = "Pending"
        row = 2
        column = 1
        width = medium
    )
    Manager_Remarks
    (
        type = textarea
        displayname = "Manager Remarks"
        row = 2
        column = 2
        width = medium
    )
    Approval_DateTime
    (
        type = datetime
        displayname = "Approval Date/Time"
        row = 2
        column = 1
        width = medium
    )
    Approved_By_Email
    (
        type = email
        displayname = "Approved By Email"
        row = 2
        column = 2
        width = medium
    )
    Assigned_Vehicle
    (
        type = picklist
        displayname = "Assigned Vehicle"
        values = Vehicles.ID
        displayformat = [Vehicle_Number]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Assigned_Driver
    (
        type = picklist
        displayname = "Assigned Driver"
        values = Drivers.ID
        displayformat = [Driver_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    Assignment_DateTime
    (
        type = datetime
        displayname = "Assignment Date/Time"
        row = 2
        column = 1
        width = medium
    )
    Assignment_Remarks
    (
        type = textarea
        displayname = "Assignment Remarks"
        row = 2
        column = 2
        width = medium
    )
    Driver_and_Completion
    (
        type = section
        displayname = "Driver and Completion"
        visibility = true
        row = 3
        column = 1
    )
    Driver_Acknowledgement
    (
        type = picklist
        displayname = "Driver Acknowledgement"
        values = {"Pending", "Acknowledged", "Unable To Serve"}
        initial value = "Pending"
        row = 3
        column = 1
        width = medium
    )
    Driver_Remarks
    (
        type = textarea
        displayname = "Driver Remarks"
        row = 3
        column = 2
        width = medium
    )
    Completion_Remarks
    (
        type = textarea
        displayname = "Completion Remarks"
        row = 3
        column = 1
        width = medium
    )
    Completed_By_Email
    (
        type = email
        displayname = "Completed By Email"
        row = 3
        column = 2
        width = medium
    )
    Completed_DateTime
    (
        type = datetime
        displayname = "Completed Date/Time"
        row = 3
        column = 1
        width = medium
    )
    Approval_Notification_Sent
    (
        type = checkbox
        displayname = "Approval Notification Sent"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    Rejection_Notification_Sent
    (
        type = checkbox
        displayname = "Rejection Notification Sent"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Assignment_Notification_Sent
    (
        type = checkbox
        displayname = "Assignment Notification Sent"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    Completion_Notification_Sent
    (
        type = checkbox
        displayname = "Completion Notification Sent"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
