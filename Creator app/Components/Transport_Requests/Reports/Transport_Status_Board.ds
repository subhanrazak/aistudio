kanban Transport_Status_Board
{
    displayName = "Transport Status Board"
    show all rows from Transport_Requests
    (
        Request_Number
        Requester
        Department
        Travel_Start
        Destination
        Assigned_Vehicle
        Assigned_Driver
        Request_Status
    )
    filters
    (
        Department
        Travel_Start
        Assigned_Driver
    )
    sort by
    (
        Travel_Start ascending
    )
    options
    (
        display field = Request_Status
        sort order = ascending
        record count = enable
    )
}
