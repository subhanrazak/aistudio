list Completed_Trips
{
    displayName = "Completed Trips"
    show all rows from Transport_Requests [Request_Status == "Completed"]
    (
        Request_Number
        Requester
        Department
        Travel_Start
        Travel_End
        Destination
        Assigned_Vehicle
        Assigned_Driver
        Completed_By_Email
        Completed_DateTime
        Completion_Remarks
    )
    filters
    (
        Department
        Assigned_Vehicle
        Assigned_Driver
        Travel_Start
    )
    sort by
    (
        Completed_DateTime descending
    )
}
