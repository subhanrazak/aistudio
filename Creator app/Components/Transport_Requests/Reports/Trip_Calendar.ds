calendar Trip_Calendar
{
    displayName = "Trip Calendar"
    show all rows from Transport_Requests [Request_Status != "Rejected"]
    (
        Request_Number
        Requester
        Department
        Travel_Start
        Travel_End
        Destination
        Assigned_Vehicle
        Assigned_Driver
        Request_Status
    )
    filters
    (
        Department
        Request_Status
        Assigned_Vehicle
        Assigned_Driver
    )
    options
    (
        display type = month
        week start day = monday
        display field = Request_Number
        start date = Travel_Start
        end date = Travel_End
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
