form Classes
{
    displayname = "Classes"
    Section_Class
    (
        type = section
        displayname = "Class Details"
        row = 1
        column = 0
    )
    must have unique Class_Code
    (
        type = text
        displayname = "Class Code"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have Class_Name
    (
        type = text
        displayname = "Class Name"
        maxchar = 50
        row = 1
        column = 2
        width = medium
    )
    must have Section
    (
        type = text
        displayname = "Section"
        maxchar = 10
        row = 1
        column = 1
        width = medium
    )
    must have Academic_Year
    (
        type = picklist
        displayname = "Academic Year"
        values = Academic_Years.ID
        displayformat = [Academic_Year_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Class_Teacher
    (
        type = picklist
        displayname = "Class Teacher"
        values = Staff.ID
        displayformat = [Staff_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Capacity
    (
        type = number
        displayname = "Capacity"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        row = 1
        column = 1
        width = medium
    )
    Classroom
    (
        type = text
        displayname = "Classroom"
        maxchar = 50
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save class"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
