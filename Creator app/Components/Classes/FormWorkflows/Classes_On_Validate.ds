Classes_On_Validate as "Validate Class Details"
{
    type = form
    form = Classes
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Capacity != null && input.Capacity <= 0)
                {
                    alert "Capacity must be greater than zero.";
                    cancel submit;
                }
            )
        }
    }
}
