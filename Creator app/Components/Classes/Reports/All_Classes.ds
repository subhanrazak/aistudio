default list All_Classes
{
    displayName = "All Classes"
    show all rows from Classes
    (
        Class_Code
        Class_Name
        Section
        Academic_Year
        Class_Teacher
        Capacity
        Status
        Classroom
    )
    filters
    (
        Academic_Year
        Status
    )
    sort by
    (
        Class_Code ascending
    )
}
