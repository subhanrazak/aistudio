        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Class_Code
                    Class_Name
                    Section
                    Academic_Year
                    Class_Teacher
                    Capacity
                    Status
                    Classroom
                )
            )
        )
        menu
        (
