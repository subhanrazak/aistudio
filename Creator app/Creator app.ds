		report My_Transport_Requests
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Request_Number Department Travel_Start Travel_End Destination Request_Status Assigned_Vehicle Assigned_Driver ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Request_Number Department Request_DateTime Travel_Start Travel_End Destination Passenger_Count Request_Status Manager_Remarks Assigned_Vehicle Assigned_Driver Assignment_Remarks Completed_DateTime ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Pending_Transport_Approvals
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Request_Number Requester Department Travel_Start Travel_End Destination Passenger_Count Preferred_Vehicle_Type Request_Status "Approve Request" "Reject Request" ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Request_Number Requester Department Request_DateTime Travel_Start Travel_End Destination Passenger_Count Preferred_Vehicle_Type Purpose Manager_Remarks Request_Status "Approve Request" "Reject Request" ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Transport_Status_Board
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Request_Number Requester Department Travel_Start Destination Assigned_Vehicle Assigned_Driver Request_Status ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Request_Number Requester Department Travel_Start Destination Assigned_Vehicle Assigned_Driver Request_Status ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Trip_Calendar
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Request_Number Requester Department Travel_Start Travel_End Destination Assigned_Vehicle Assigned_Driver Request_Status ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Request_Number Requester Department Travel_Start Travel_End Destination Assigned_Vehicle Assigned_Driver Request_Status ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report Active_Approvers
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Member_Name Email Phone Team_Role ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Member_Name Email Phone Team_Role ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report All_Transport_Team
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Member_Name Email Phone Team_Role Can_Approve Active_Status ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Member_Name Email Phone Team_Role Can_Approve Active_Status ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
		}
	
		report All_Vehicles
		{
		    quickview ( layout ( type = -1 datablock1 ( layout type = -1 fields ( Vehicle_Number Vehicle_Type Seating_Capacity Fuel_Type Registration_Expiry Insurance_Expiry Fitness_Certificate_Expiry Active_Status Availability_Status Current_Odometer ) ) ) menu ( header ( Edit Duplicate Delete ) record ( Edit Duplicate Delete ) ) action ( on click ( View Record ) on right click ( Edit Delete Duplicate View Record ) ) )
		    detailview ( layout ( type = 1 datablock1 ( layout type = -2 fields ( Vehicle_Number Vehicle_Type Seating_Capacity Fuel_Type Registration_Expiry Insurance_Expiry Fitness_Certificate_Expiry Active_Status Availability_Status Current_Odometer ) ) ) menu ( header ( Edit Duplicate Delete ) ) )
