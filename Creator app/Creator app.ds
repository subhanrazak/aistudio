	reports
	{
		default list All_Academic_Years
		{
		    displayName = "All Academic Years"
		    show all rows from Academic_Years
		    (
		        Academic_Year_Name
		        Start_Date
		        End_Date
		        Status
		        Notes
		    )
		    filters
		    (
		        Status
		    )
		    sort by
		    (
		        Start_Date descending
		    )
		}

		calendar Attendance_Calendar
		{
		    displayName = "Attendance Calendar"
		    show all rows from Attendance
		    (
		        Class
		        Student
		        Attendance_Date
		        Status
		    )
		    filters
		    (
		        Class
		        Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Student
		        start date = Attendance_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		default list Attendance_Register
		{
		    displayName = "Attendance Register"
		    show all rows from Attendance
		    (
		        Class
		        Student
		        Attendance_Date
		        Session
		        Status
		        Marked_By
		        Remarks
		    )
		    filters
		    (
		        Class
		        Student
		        Attendance_Date
		        Session
		        Status
		    )
		    sort by
		    (
		        Attendance_Date descending
		    )
		}

		default list Class_Subject_Mapping
		{
		    displayName = "Class Subject Mapping"
		    show all rows from Class_Subjects
		    (
		        Mapping_Code
		        Academic_Year
		        Class
		        Subject
		        Teacher
		        Weekly_Periods
		        Status
		    )
		    filters
		    (
		        Academic_Year
		        Class
		        Subject
		        Teacher
		        Status
		    )
		    sort by
		    (
		        Class ascending
		    )
		}

		default list All_Classes
		{
		    displayName = "All Classes"
		    show all rows from Classes
		    (
		        Class_Code
		        Class_Name
		        Section
		        Academic_Year
		        Class_Teacher
		        Capacity
		        Status
		        Classroom
		    )
		    filters
		    (
		        Academic_Year
		        Status
		    )
		    sort by
		    (
		        Class_Code ascending
		    )
		}

		list Active_Departments
		{
		    displayName = "Active Departments"
		    show all rows from Departments [Status == "Active"]
		    (
		        Department_Name
		        Department_Code
		        Manager_Name
		        Manager_Email
		    )
		    filters
		    (
		        Department_Name
		    )
		    sort by
		    (
		        Department_Name ascending
		    )
		}

		default list All_Departments
		{
		    displayName = "All Departments"
		    show all rows from Departments
		    (
		        Department_Name
		        Department_Code
		        Manager_Name
		        Manager_Email
		        Status
		    )
		    filters
		    (
		        Status
		        Department_Name
		    )
		    sort by
		    (
		        Department_Name ascending
		    )
		}

		default list All_Drivers
		{
		    displayName = "All Drivers"
		    show all rows from Drivers
		    (
		        Driver_Name
		        Driver_Email
		        Driver_Phone
		        License_Number
		        License_Expiry
		        Badge_Number
		        Active_Status
		        Availability_Status
		    )
		    filters
		    (
		        Active_Status
		        Availability_Status
		    )
		    sort by
		    (
		        Driver_Name ascending
		    )
		}

