		    (
		        type = autonumber
		        displayname = "Student ID"
		        start index = 10001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Admission_Number
		    (
		        type = text
		        displayname = "Admission Number"
		        maxchar = 30
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Student_Name
		    (
		        type = name
		        displayname = "Student Name"
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            visibility = false
		            value = {"Master","Miss"}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Gender
		    (
		        type = radiobuttons
		        displayname = "Gender"
		        values = {"Male","Female","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
