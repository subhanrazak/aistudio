		        personal data = true
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Medical_Notes
		    (
		        type = textarea
		        displayname = "Medical Notes"
		        personal data = true
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
