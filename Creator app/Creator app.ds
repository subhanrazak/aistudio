	share_settings
	{
	"Academic_Admin"
	{
	    name        = "Academic_Admin"
	    type        = Users_Permissions
	    permissions = { Chat:true, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:false }
	    description = "Academic administration access for academic setup and monitoring."
	
	    ModulePermissions
	    {
	        Academic_Years
	        {
	            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Academic_Years={"View","Edit","Delete"}
	            }
	        }
	        Subjects
	        {
	            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Subjects={"View","Edit","Delete"}
	            }
