application "Creator-app"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Academic_Years
		{
		    displayname = "Academic Years"
		    Section_Academic_Year
		    (
		        type = section
		        displayname = "Academic Year Details"
		        row = 1
		        column = 0
		    )
		    must have unique Academic_Year_Name
		    (
		        type = text
		        displayname = "Academic Year"
		        maxchar = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have End_Date
		    (
		        type = date
		        displayname = "End Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Planned","Active","Closed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save academic year"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Attendance
		{
		    displayname = "Attendance"
		    Section_Attendance
		    (
		        type = section
		        displayname = "Attendance Details"
		        row = 1
		        column = 0
		    )
		    must have Class
		    (
		        type = picklist
		        displayname = "Class"
		        values = Classes.ID
		        displayformat = [Class_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Student
		    (
		        type = picklist
		        displayname = "Student"
		        values = Students.ID
		        displayformat = [Admission_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Attendance_Date
		    (
		        type = date
		        displayname = "Attendance Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Session
		    (
		        type = picklist
		        displayname = "Session"
		        values = {"Full Day","AM","PM"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Present","Absent","Late","Excused"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Marked_By
		    (
		        type = picklist
		        displayname = "Marked By"
		        values = Staff.ID
		        displayformat = [Staff_Code]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save attendance"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Class_Subjects
		{
		    displayname = "Class Subject Mapping"
		    Section_Mapping
		    (
		        type = section
		        displayname = "Mapping Details"
		        row = 1
		        column = 0
		    )
		    must have unique Mapping_Code
		    (
		        type = text
		        displayname = "Mapping Code"
		        maxchar = 40
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Academic_Year
		    (
		        type = picklist
		        displayname = "Academic Year"
		        values = Academic_Years.ID
		        displayformat = [Academic_Year_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Class
		    (
		        type = picklist
		        displayname = "Class"
		        values = Classes.ID
		        displayformat = [Class_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Subject
		    (
		        type = picklist
		        displayname = "Subject"
		        values = Subjects.ID
		        displayformat = [Subject_Code]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Teacher
		    (
		        type = picklist
		        displayname = "Teacher"
		        values = Staff.ID
		        displayformat = [Staff_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Weekly_Periods
		    (
		        type = number
		        displayname = "Weekly Periods"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Syllabus_Notes
		    (
		        type = textarea
		        displayname = "Syllabus Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save class subject mapping"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Classes
		{
		    displayname = "Classes"
		    Section_Class
		    (
		        type = section
		        displayname = "Class Details"
		        row = 1
		        column = 0
		    )
		    must have unique Class_Code
		    (
		        type = text
		        displayname = "Class Code"
		        maxchar = 30
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Class_Name
		    (
		        type = text
		        displayname = "Class Name"
		        maxchar = 50
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Section
		    (
		        type = text
		        displayname = "Section"
		        maxchar = 10
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Academic_Year
		    (
		        type = picklist
		        displayname = "Academic Year"
		        values = Academic_Years.ID
		        displayformat = [Academic_Year_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Class_Teacher
		    (
		        type = picklist
		        displayname = "Class Teacher"
		        values = Staff.ID
		        displayformat = [Staff_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Capacity
		    (
		        type = number
		        displayname = "Capacity"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Classroom
		    (
		        type = text
		        displayname = "Classroom"
		        maxchar = 50
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save class"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Departments
		{
		    displayname = "Departments"
		    Department_Information
		    (
		        type = section
		        displayname = "Department Information"
		        row = 1
		        column = 0
		    )
		    must have unique Department_Name
		    (
		        type = text
		        displayname = "Department Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    unique Department_Code
		    (
		        type = text
		        displayname = "Department Code"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Manager_Name
		    (
		        type = text
		        displayname = "Manager Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Manager_Email
		    (
		        type = email
		        displayname = "Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Drivers
		{
		    displayname = "Drivers"
		    Driver_Information
		    (
		        type = section
		        displayname = "Driver Information"
		        row = 1
		        column = 0
		    )
		    must have Driver_Name
		    (
		        type = text
		        displayname = "Driver Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Driver_Email
		    (
		        type = email
		        displayname = "Driver Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Driver_Phone
		    (
		        type = phonenumber
		        displayname = "Driver Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique License_Number
		    (
		        type = text
		        displayname = "License Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    License_Expiry
		    (
		        type = date
		        displayname = "License Expiry"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Badge_Number
		    (
		        type = text
		        displayname = "Badge Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Active_Status
		    (
		        type = picklist
		        displayname = "Active Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Availability_Status
		    (
		        type = picklist
		        displayname = "Availability Status"
		        values = {"Available", "Assigned", "On Leave", "Inactive"}
		        initial value = "Available"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Exams
		{
		    displayname = "Exams"
		    Section_Exam
		    (
		        type = section
		        displayname = "Exam Details"
		        row = 1
		        column = 0
		    )
		    must have Exam_Name
		    (
		        type = text
		        displayname = "Exam Name"
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Academic_Year
		    (
		        type = picklist
		        displayname = "Academic Year"
		        values = Academic_Years.ID
		        displayformat = [Academic_Year_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Class
		    (
		        type = picklist
		        displayname = "Class"
		        values = Classes.ID
		        displayformat = [Class_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Subject
		    (
		        type = picklist
		        displayname = "Subject"
		        values = Subjects.ID
		        displayformat = [Subject_Code]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Exam_Date
		    (
		        type = date
		        displayname = "Exam Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Exam_Type
		    (
		        type = picklist
		        displayname = "Exam Type"
		        values = {"Unit Test","Mid Term","Final","Assignment","Practical"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Max_Marks
		    (
		        type = decimal
		        displayname = "Max Marks"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Pass_Marks
		    (
		        type = decimal
		        displayname = "Pass Marks"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Scheduled","Completed","Cancelled"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Instructions
		    (
		        type = textarea
		        displayname = "Instructions"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save exam"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Lesson_Plans
		{
		    displayname = "Lesson Plans"
		    Section_Lesson_Plan
		    (
		        type = section
		        displayname = "Lesson Plan Details"
		        row = 1
		        column = 0
		    )
		    must have Class_Subject
		    (
		        type = picklist
		        displayname = "Class Subject"
		        values = Class_Subjects.ID
		        displayformat = [Mapping_Code]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Plan_Date
		    (
		        type = date
		        displayname = "Plan Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Topic
		    (
		        type = text
		        displayname = "Topic"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Learning_Objectives
		    (
		        type = textarea
		        displayname = "Learning Objectives"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Plan_Status
		    (
		        type = picklist
		        displayname = "Plan Status"
		        values = {"Planned","In Progress","Completed","Delayed"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Completion_Date
		    (
		        type = date
		        displayname = "Completion Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Teacher_Notes
		    (
		        type = textarea
		        displayname = "Teacher Notes"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save lesson plan"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Marks
		{
		    displayname = "Marks"
		    Section_Marks
		    (
		        type = section
		        displayname = "Marks Details"
		        row = 1
		        column = 0
		    )
		    must have Exam
		    (
		        type = picklist
		        displayname = "Exam"
		        values = Exams.ID
		        displayformat = [Exam_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Student
		    (
		        type = picklist
		        displayname = "Student"
		        values = Students.ID
		        displayformat = [Admission_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Marks_Obtained
		    (
		        type = decimal
		        displayname = "Marks Obtained"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Percentage
		    (
		        type = decimal
		        displayname = "Percentage"
		        decimalplace = 2
		        row = 1
		        column = 2
		        width = medium
		    )
		    Grade
		    (
		        type = text
		        displayname = "Grade"
		        maxchar = 5
		        row = 1
		        column = 1
		        width = medium
		    )
		    Result
		    (
		        type = picklist
		        displayname = "Result"
		        values = {"Pass","Fail","Absent"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save marks"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Staff
		{
		    displayname = "Staff"
		    Section_Staff
		    (
		        type = section
		        displayname = "Staff Details"
		        row = 1
		        column = 0
		    )
		    Staff_ID
		    (
		        type = autonumber
		        displayname = "Staff ID"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Staff_Code
		    (
		        type = text
		        displayname = "Staff Code"
		        maxchar = 20
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Staff_Name
		    (
		        type = name
		        displayname = "Staff Name"
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            value = {"Mr.","Mrs.","Ms.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have unique Email
		    (
		        type = email
		        displayname = "Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Staff_Role
		    (
		        type = picklist
		        displayname = "Staff Role"
		        values = {"Teaching Staff","Admin","Office Staff","Academic Admin","Security","Inventory Admin","Librarian","Hostel Admin","Transport Admin"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employment_Status
		    (
		        type = picklist
		        displayname = "Employment Status"
		        values = {"Active","On Leave","Inactive"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Joining_Date
		    (
		        type = date
		        displayname = "Joining Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Specialization
		    (
		        type = text
		        displayname = "Specialization"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save staff member"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
