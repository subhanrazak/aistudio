	pages
	{
		page Academic_Overview
		{
					displayname = "Academic Overview"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Academic_Overview_Snippet' elementName='Academic_Overview_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Academic_Overview_Snippet()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nactiveStudents = Students[Enrollment_Status == &quot;Active&quot;].count();\nactiveStaff = Staff[Employment_Status == &quot;Active&quot;].count();\nactiveClasses = Classes[Status == &quot;Active&quot;].count();\nactiveSubjects = Subjects[Status == &quot;Active&quot;].count();\ntodayAttendance = Attendance[Attendance_Date == zoho.currentdate].count();\nupcomingScheduledExams = Exams[Status == &quot;Scheduled&quot; &amp;&amp; Exam_Date &gt;= zoho.currentdate].count();\ncompletedLessonPlans = Lesson_Plans[Plan_Status == &quot;Completed&quot;].count();\n\npassMarks = Marks[Result == &quot;Pass&quot;].count();\nfailMarks = Marks[Result == &quot;Fail&quot;].count();\nabsentMarks = Marks[Result == &quot;Absent&quot;].count();\nmarkOutcomeCount = passMarks + failMarks;\npassRate = 0;\nif(markOutcomeCount &gt; 0)\n{\n\t\tpassRate = (passMarks * 100) / markOutcomeCount;\n}\n\nattendanceTotal = Attendance[ID != 0].count();\npresentCount = Attendance[Status == &quot;Present&quot;].count();\nabsentCount = Attendance[Status == &quot;Absent&quot;].count();\nlateCount = Attendance[Status == &quot;Late&quot;].count();\nexcusedCount = Attendance[Status == &quot;Excused&quot;].count();\npresentPct = 0;\nabsentPct = 0;\nlatePct = 0;\nexcusedPct = 0;\nif(attendanceTotal &gt; 0)\n{\n\t\tpresentPct = (presentCount * 100) / attendanceTotal;\n\t\tabsentPct = (absentCount * 100) / attendanceTotal;\n\t\tlatePct = (lateCount * 100) / attendanceTotal;\n\t\texcusedPct = (excusedCount * 100) / attendanceTotal;\n}\n\nexamTotal = Exams[ID != 0].count();\nscheduledExamCount = Exams[Status == &quot;Scheduled&quot;].count();\ncompletedExamCount = Exams[Status == &quot;Completed&quot;].count();\ncancelledExamCount = Exams[Status == &quot;Cancelled&quot;].count();\nscheduledExamPct = 0;\ncompletedExamPct = 0;\ncancelledExamPct = 0;\nif(examTotal &gt; 0)\n{\n\t\tscheduledExamPct = (scheduledExamCount * 100) / examTotal;\n\t\tcompletedExamPct = (completedExamCount * 100) / examTotal;\n\t\tcancelledExamPct = (cancelledExamCount * 100) / examTotal;\n}\n\nlessonPlanTotal = Lesson_Plans[ID != 0].count();\nplannedLessonCount = Lesson_Plans[Plan_Status == &quot;Planned&quot;].count();\ninProgressLessonCount = Lesson_Plans[Plan_Status == &quot;In Progress&quot;].count();\ncompletedLessonCount = Lesson_Plans[Plan_Status == &quot;Completed&quot;].count();\ndelayedLessonCount = Lesson_Plans[Plan_Status == &quot;Delayed&quot;].count();\nplannedLessonPct = 0;\ninProgressLessonPct = 0;\ncompletedLessonPct = 0;\ndelayedLessonPct = 0;\nif(lessonPlanTotal &gt; 0)\n{\n\t\tplannedLessonPct = (plannedLessonCount * 100) / lessonPlanTotal;\n\t\tinProgressLessonPct = (inProgressLessonCount * 100) / lessonPlanTotal;\n\t\tcompletedLessonPct = (completedLessonCount * 100) / lessonPlanTotal;\n\t\tdelayedLessonPct = (delayedLessonCount * 100) / lessonPlanTotal;\n}\n\nuserLabel = zoho.loginuser;\nif(userLabel == null || userLabel == &quot;&quot;)\n{\n\t\tuserLabel = zoho.loginuserid;\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset used by this page, included once for this page */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-page-bg-color: #F3F3F4;\n\t\t--zcs-success-color: #179E6C;\n\t\t--zcs-danger-color: #FE455D;\n\t\t--zcs-warning-color: #FAAE13;\n\t\t--zcs-info-color: #2A6FFC;\n}\n.zcs-row { display:flex; flex-wrap:wrap; }\n.zcs-flex { display:flex; }\n.zcs-inline-flex { display:inline-flex; }\n.zcs-direction-column { flex-direction:column; }\n.zcs-align-items-center, .zcs-align-center { align-items:center; }\n.zcs-align-items-start { align-items:flex-start; }\n.zcs-justify-center { justify-content:center; }\n.zcs-justify-space-between { justify-content:space-between; }\n.zcs-gap-4 { gap:.25rem; }\n.zcs-gap-6 { gap:.375rem; }\n.zcs-gap-8 { gap:.5rem; }\n.zcs-gap-10 { gap:.625rem; }\n.zcs-gap-12 { gap:.75rem; }\n.zcs-gap-16 { gap:1rem; }\n.zcs-gap-20 { gap:1.25rem; }\n.zcs-p-0 { padding:0; }\n.zcs-p-8 { padding:.5rem; }\n.zcs-p-10 { padding:.625rem; }\n.zcs-p-12 { padding:.75rem; }\n.zcs-p-16 { padding:1rem; }\n.zcs-p-20 { padding:1.25rem; }\n.zcs-p-24 { padding:1.5rem; }\n.zcs-px-8 { padding-left:.5rem; padding-right:.5rem; }\n.zcs-px-10 { padding-left:.625rem; padding-right:.625rem; }\n.zcs-px-12 { padding-left:.75rem; padding-right:.75rem; }\n.zcs-px-16 { padding-left:1rem; padding-right:1rem; }\n.zcs-px-20 { padding-left:1.25rem; padding-right:1.25rem; }\n.zcs-py-2 { padding-top:.125rem; padding-bottom:.125rem; }\n.zcs-py-4 { padding-top:.25rem; padding-bottom:.25rem; }\n.zcs-py-6 { padding-top:.375rem; padding-bottom:.375rem; }\n.zcs-py-8 { padding-top:.5rem; padding-bottom:.5rem; }\n.zcs-py-10 { padding-top:.625rem; padding-bottom:.625rem; }\n.zcs-py-12 { padding-top:.75rem; padding-bottom:.75rem; }\n.zcs-m-0 { margin:0; }\n.zcs-mt-4 { margin-top:.25rem; }\n.zcs-mt-8 { margin-top:.5rem; }\n.zcs-mt-12 { margin-top:.75rem; }\n.zcs-mt-16 { margin-top:1rem; }\n.zcs-mb-8 { margin-bottom:.5rem; }\n.zcs-w-full { width:100%; }\n.zcs-col-common { flex:1 1 0%; }\n.zcs-col-auto { flex:0 0 auto; }\n.zcs-font-11 { font-size:.6875rem; }\n.zcs-font-12 { font-size:.75rem; }\n.zcs-font-13 { font-size:.8125rem; }\n.zcs-font-14 { font-size:.875rem; }\n.zcs-font-15 { font-size:.9375rem; }\n.zcs-font-16 { font-size:1rem; }\n.zcs-font-18 { font-size:1.125rem; }\n.zcs-font-20 { font-size:1.25rem; }\n.zcs-font-24 { font-size:1.5rem; }\n.zcs-font-28 { font-size:1.75rem; }\n.zcs-font-40 { font-size:2.5rem; }\n.zcs-font-normal { font-weight:400; }\n.zcs-font-medium { font-weight:500; }\n.zcs-font-semibold { font-weight:600; }\n.zcs-font-bold { font-weight:700; }\n.zcs-lh-body { line-height:1.5; }\n.zcs-lh-heading { line-height:1.25; }\n.zcs-uppercase { text-transform:uppercase; }\n.zcs-text-left { text-align:left; }\n.zcs-text-right { text-align:right; }\n.zcs-text-center { text-align:center; }\n.zcs-rounded-sm { border-radius:.25rem; }\n.zcs-rounded-md { border-radius:.375rem; }\n.zcs-rounded-lg { border-radius:.5rem; }\n.zcs-rounded-xl { border-radius:.75rem; }\n.zcs-rounded-2xl { border-radius:1rem; }\n.zcs-rounded-half { border-radius:50%; }\n.zcs-box-border { box-sizing:border-box; }\n.zcs-relative { position:relative; }\n.zcs-sticky { position:sticky; }\n.zcs-overflow-auto { overflow:auto; }\n.zcs-ellipsis { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.zcs-color-theme { color:var(--zcs-theme-brand-color); }\n.zcs-color-primary { color:var(--zcs-primary-text-color); }\n.zcs-color-secondary { color:var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color:var(--zcs-teritiary-text-color); }\n.zcs-color-white { color:var(--zcs-white-color); }\n.zcs-color-green { color:#179E6C; }\n.zcs-color-red { color:#FE455D; }\n.zcs-color-yellow { color:#b8770d; }\n.zcs-color-blue { color:#2A6FFC; }\n.zcs-card { background:var(--zcs-white-color); border:1px solid var(--zcs-border-color); border-radius:12px; }\n\n/* ZCS table-simple-table CSS */\n:root { --zcs-thead-color:#F9FAFE; --zcs-tr-h-color:#F9FAFE; }\n.zcs-table-wrapper { border:1px solid var(--zcs-border-color); background-color:var(--zcs-white-color); overflow:auto; }\n.zcs-table-wrapper table { line-height:normal; border-collapse:collapse; }\n.zcs-table-wrapper table thead { top:0; }\n.zcs-table-wrapper table thead tr th { background-color:var(--zcs-thead-color); box-shadow:0 -1px 0 0 var(--zcs-border-color) inset; white-space:nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color:var(--zcs-white-color); box-shadow:none; }\n.zcs-table-wrapper table tbody tr td { border-top:1px solid var(--zcs-border-color); vertical-align:top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color:transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color:var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color:#179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color:#fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color:#b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color:#09598e; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color:#1094c5; }\n\n/* ZCS badge-filled-badge CSS */\n.zcs-badge { width:auto; }\n.zcs-badge-filled { border:1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color:var(--zcs-theme-brand-color); border-color:var(--zcs-theme-brand-color); color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color:#179E6C; border-color:#179E6C; color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color:#FE455D; border-color:#FE455D; color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color:#242424; border-color:#242424; color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color:#FAAE13; border-color:#FAAE13; color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color:#2A6FFC; border-color:#2A6FFC; color:var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color:#F4660C; border-color:#F4660C; color:var(--zcs-white-color); }\n\n/* ZCS legend-legend-with-count CSS */\n.zcs-legend-wrapper li { list-style-type:none; }\n.zcs-legend-wrapper li label { min-width:120px; }\n.zcs-legend-wrapper li label:before { content:&apos;&apos;; display:inline-block; vertical-align:top; width:12px; height:12px; margin:4px 12px 4px 0; border-radius:50%; }\n.zcs-legend-wrapper li:nth-child(1) label:before { background-color:#FECE56; }\n.zcs-legend-wrapper li:nth-child(2) label:before { background-color:#36A2EB; }\n.zcs-legend-wrapper li:nth-child(3) label:before { background-color:#FF6283; }\n.zcs-legend-wrapper li:nth-child(4) label:before { background-color:#28CC97; }\n\n/* ZCS progress-bar-range-bar-with-text CSS */\n.zcs-progress-bar { height:8px; background-color:var(--zcs_component_hover_color); overflow:hidden; }\n.zcs-progress-bar-indicator { height:inherit; border-radius:inherit; background-color:var(--zcs-theme-brand-color); }\n\n.academic-overview { min-height:100%; background:var(--zcs-page-bg-color); padding:24px; box-sizing:border-box; color:var(--zcs-primary-text-color); }\n.ao-header { background:linear-gradient(135deg, var(--zcs-theme-brand-color), var(--zcs_brand_dark_color)); color:var(--zcs-white-color); border-radius:18px; padding:24px; position:relative; overflow:hidden; }\n.ao-header:after { content:&apos;&apos;; position:absolute; width:280px; height:280px; border:32px solid rgba(255,255,255,.10); border-radius:50%; right:-72px; top:-118px; }\n.ao-header:before { content:&apos;&apos;; position:absolute; width:160px; height:160px; border:18px solid rgba(255,255,255,.08); border-radius:50%; right:128px; bottom:-92px; }\n.ao-header-content { position:relative; z-index:1; }\n.ao-header h1 { margin:0; color:var(--zcs-white-color); font-size:28px; line-height:1.2; font-weight:700; }\n.ao-header p { margin:8px 0 0; color:rgba(255,255,255,.86); max-width:760px; }\n.ao-readonly-badge { background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.24); color:var(--zcs-white-color); }\n.ao-grid { display:grid; gap:16px; }\n.ao-kpi-grid { grid-template-columns:repeat(4, minmax(0, 1fr)); margin-top:16px; }\n.ao-analytics-grid { grid-template-columns:1.15fr .85fr; margin-top:16px; }\n.ao-table-grid { grid-template-columns:1fr 1fr; margin-top:16px; }\n.ao-kpi-card { padding:18px; min-height:132px; position:relative; overflow:hidden; }\n.ao-kpi-card:after { content:&apos;&apos;; position:absolute; width:92px; height:92px; right:-34px; bottom:-34px; border-radius:50%; background:var(--zcs_component_hover_color); }\n.ao-kpi-icon { width:42px; height:42px; border-radius:12px; color:var(--zcs-theme-brand-color); background:var(--zcs-light-bg-color); font-size:20px; }\n.ao-kpi-label { color:var(--zcs-secondary-text-color); }\n.ao-kpi-value { font-size:28px; font-weight:700; line-height:1.1; color:var(--zcs-primary-text-color); margin-top:12px; }\n.ao-kpi-note { color:var(--zcs-teritiary-text-color); margin-top:6px; }\n.ao-section { padding:18px; }\n.ao-section-title { margin:0; color:var(--zcs-primary-text-color); font-size:18px; font-weight:650; line-height:1.25; }\n.ao-section-subtitle { margin:4px 0 0; color:var(--zcs-secondary-text-color); }\n.ao-status-row { display:grid; grid-template-columns:132px 1fr 48px; gap:12px; align-items:center; }\n.ao-status-dot { width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:8px; }\n.ao-dot-green { background:#179E6C; }\n.ao-dot-red { background:#FE455D; }\n.ao-dot-yellow { background:#FAAE13; }\n.ao-dot-blue { background:#2A6FFC; }\n.ao-dot-orange { background:#F4660C; }\n.ao-dot-grey { background:#242424; }\n.ao-bar-green .zcs-progress-bar-indicator { background:#179E6C; }\n.ao-bar-red .zcs-progress-bar-indicator { background:#FE455D; }\n.ao-bar-yellow .zcs-progress-bar-indicator { background:#FAAE13; }\n.ao-bar-blue .zcs-progress-bar-indicator { background:#2A6FFC; }\n.ao-bar-orange .zcs-progress-bar-indicator { background:#F4660C; }\n.ao-bar-grey .zcs-progress-bar-indicator { background:#242424; }\n.ao-summary-card { background:#F9FAFE; border:1px solid var(--zcs-border-color); border-radius:12px; padding:14px; }\n.ao-pass-ring { width:138px; height:138px; border-radius:50%; background:conic-gradient(var(--zcs-theme-brand-color) 0 &lt;%=passRate%&gt;%, var(--zcs_component_hover_color) &lt;%=passRate%&gt;% 100%); margin:auto; display:flex; align-items:center; justify-content:center; }\n.ao-pass-ring-inner { width:98px; height:98px; border-radius:50%; background:var(--zcs-white-color); display:flex; align-items:center; justify-content:center; flex-direction:column; }\n.ao-muted { color:var(--zcs-secondary-text-color); }\n.ao-empty { color:var(--zcs-secondary-text-color); padding:26px 16px; text-align:center; }\n.ao-table-wrapper { max-height:360px; }\n.ao-table-wrapper table { min-width:100%; }\n.ao-table-wrapper th, .ao-table-wrapper td { white-space:nowrap; }\n.ao-table-wrapper td.ao-wrap { white-space:normal; min-width:180px; }\n.ao-health-strip { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; }\n.ao-health-item { border:1px solid var(--zcs-border-color); border-radius:10px; padding:10px 12px; background:var(--zcs-white-color); }\n@media (max-width:1280px) { .ao-kpi-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }\n@media (max-width:900px) { .academic-overview { padding:16px; } .ao-analytics-grid, .ao-table-grid { grid-template-columns:1fr; } .ao-health-strip { grid-template-columns:repeat(2, 1fr); } }\n@media (max-width:560px) { .ao-kpi-grid, .ao-health-strip { grid-template-columns:1fr; } .ao-status-row { grid-template-columns:1fr; gap:6px; } .ao-header h1 { font-size:24px; } }\n&lt;/style&gt;\n&lt;div class=&quot;academic-overview&quot;&gt;\n\t\t&lt;div class=&quot;ao-header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ao-header-content zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14&quot; style=&quot;color:rgba(255,255,255,.82);&quot;&gt;Hello &lt;%=userLabel%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1&gt;Academic Overview&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-lh-body&quot;&gt;Read-only snapshot of students, staff, classes, subjects, attendance, lesson planning, exams, and marks.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-md zcs-px-12 zcs-py-6 zcs-box-border ao-readonly-badge&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-medium zcs-lh-body&quot;&gt;Read only&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ao-grid ao-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Active Students&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=activeStudents%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Enrollment status is Active&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Active Staff&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=activeStaff%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Employment status is Active&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-02&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Active Classes&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=activeClasses%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Class status is Active&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-todo&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Active Subjects&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=activeSubjects%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Subject status is Active&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-folded-content&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Today Attendance&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=todayAttendance%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Records dated today&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Upcoming Exams&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=upcomingScheduledExams%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Scheduled from today onward&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline education-agenda-bookmark&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Completed Plans&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=completedLessonPlans%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;Lesson plans completed&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ao-kpi-card zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase&quot;&gt;Marks Pass Rate&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-value&quot;&gt;&lt;%=passRate%&gt;%&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;ao-kpi-note zcs-font-12&quot;&gt;&lt;%=passMarks%&gt; pass of &lt;%=markOutcomeCount%&gt; assessed outcomes&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ao-grid ao-analytics-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Attendance Status Distribution&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Total attendance records: &lt;%=attendanceTotal%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Attendance&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-green&quot;&gt;&lt;/span&gt;Present&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-green&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=presentPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=presentCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-red&quot;&gt;&lt;/span&gt;Absent&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-red&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=absentPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=absentCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-yellow&quot;&gt;&lt;/span&gt;Late&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-yellow&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=latePct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=lateCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-blue&quot;&gt;&lt;/span&gt;Excused&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-blue&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=excusedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=excusedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Academic Health Summary&lt;/h2&gt;\n\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Exam completion, lesson planning progress, and marks outcome rate.&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-16 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-pass-ring&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-pass-ring-inner&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-28 zcs-font-bold zcs-color-theme&quot;&gt;&lt;%=passRate%&gt;%&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 ao-muted&quot;&gt;Pass rate&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper zcs-legend-with-count zcs-col-common&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Pass&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=passMarks%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Fail&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=failMarks%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Absent&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=absentMarks%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;ao-health-strip zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-health-item&quot;&gt;&lt;div class=&quot;zcs-font-12 ao-muted zcs-uppercase&quot;&gt;Exam records&lt;/div&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold&quot;&gt;&lt;%=examTotal%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-health-item&quot;&gt;&lt;div class=&quot;zcs-font-12 ao-muted zcs-uppercase&quot;&gt;Lesson plans&lt;/div&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold&quot;&gt;&lt;%=lessonPlanTotal%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-health-item&quot;&gt;&lt;div class=&quot;zcs-font-12 ao-muted zcs-uppercase&quot;&gt;Passed marks&lt;/div&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold&quot;&gt;&lt;%=passMarks%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-health-item&quot;&gt;&lt;div class=&quot;zcs-font-12 ao-muted zcs-uppercase&quot;&gt;Failed marks&lt;/div&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold&quot;&gt;&lt;%=failMarks%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ao-grid ao-analytics-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Exam Status Summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Scheduled, completed, and cancelled exam records.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-semibold zcs-color-theme&quot;&gt;&lt;%=examTotal%&gt; total&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-blue&quot;&gt;&lt;/span&gt;Scheduled&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-blue&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=scheduledExamPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=scheduledExamCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-green&quot;&gt;&lt;/span&gt;Completed&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-green&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=completedExamPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=completedExamCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-grey&quot;&gt;&lt;/span&gt;Cancelled&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-grey&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=cancelledExamPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=cancelledExamCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Lesson Plan Status Summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Planning and completion flow across lesson plans.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-semibold zcs-color-theme&quot;&gt;&lt;%=lessonPlanTotal%&gt; total&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-blue&quot;&gt;&lt;/span&gt;Planned&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-blue&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=plannedLessonPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=plannedLessonCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-yellow&quot;&gt;&lt;/span&gt;In Progress&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-yellow&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=inProgressLessonPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=inProgressLessonCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-green&quot;&gt;&lt;/span&gt;Completed&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-green&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=completedLessonPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=completedLessonCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;ao-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14&quot;&gt;&lt;span class=&quot;ao-status-dot ao-dot-red&quot;&gt;&lt;/span&gt;Delayed&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar-wrapper ao-bar-red&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=delayedLessonPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=delayedLessonCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ao-grid ao-table-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Recent Exams&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Latest exam schedule records by exam date.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Latest 5&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ao-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Exam&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Class&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Subject&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Date&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\trecentExams = Exams[ID != 0] sort by Exam_Date desc;\n\t\t\t\t\t\t\t\t\t\trenderedExams = 0;\n\t\t\t\t\t\t\t\t\t\tfor each ex in recentExams\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif(renderedExams &lt; 5)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texamStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(ex.Status == &quot;Completed&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\texamStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse if(ex.Status == &quot;Cancelled&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\texamStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texamName = ifnull(ex.Exam_Name,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tclassCode = ifnull(ex.Class.Class_Code,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tsubjectCode = ifnull(ex.Subject.Subject_Code,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap&quot;&gt;&lt;%=examName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=classCode%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=subjectCode%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ex.Exam_Date%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=examStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ex.Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\trenderedExams = renderedExams + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(renderedExams == 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;ao-empty zcs-font-14&quot; colspan=&quot;5&quot;&gt;No exam records found.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;ao-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;ao-section-title&quot;&gt;Recent Low-Performing or Failed Results&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;ao-section-subtitle zcs-font-13&quot;&gt;Marks with Fail result or percentage below 40.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Watchlist&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper ao-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Student&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Exam&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Marks&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Percent&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Result&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tlowMarks = Marks[Result == &quot;Fail&quot; || Percentage &lt; 40] sort by Added_Time desc;\n\t\t\t\t\t\t\t\t\t\trenderedMarks = 0;\n\t\t\t\t\t\t\t\t\t\tfor each mk in lowMarks\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif(renderedMarks &lt; 5)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmarkStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(mk.Result == &quot;Absent&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tmarkStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstudentName = ifnull(mk.Student.Student_Name,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\texamTitle = ifnull(mk.Exam.Exam_Name,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpercentText = ifnull(mk.Percentage,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tresultText = ifnull(mk.Result,&quot;Low&quot;);\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap&quot;&gt;&lt;%=studentName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap&quot;&gt;&lt;%=examTitle%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=mk.Marks_Obtained%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=percentText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=markStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=resultText%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\trenderedMarks = renderedMarks + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(renderedMarks == 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;ao-empty zcs-font-14&quot; colspan=&quot;5&quot;&gt;No low-performing or failed mark records found.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Transport_Dashboard
		{
					displayname = "Transport Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Operational_Overview' elementName='Operational_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Operational_Overview()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\tpendingRequests = Transport_Requests[Request_Status == &quot;Pending&quot;].count();\n\tapprovedAwaiting = Transport_Requests[Request_Status == &quot;Approved&quot;].count();\n\tassignedTrips = Transport_Requests[Request_Status == &quot;Vehicle Assigned&quot;].count();\n\trejectedRequests = Transport_Requests[Request_Status == &quot;Rejected&quot;].count();\n\tcompletedTrips = Transport_Requests[Request_Status == &quot;Completed&quot;].count();\n\n\tcompletedTripsThisMonth = 0;\n\tcurrentMonth = zoho.currentdate.toString(&quot;MM&quot;);\n\tcurrentYear = zoho.currentdate.toString(&quot;yyyy&quot;);\n\tfor each completedRequest in Transport_Requests[Request_Status == &quot;Completed&quot; &amp;&amp; Completed_DateTime != null]\n\t{\n\t\tif(completedRequest.Completed_DateTime.toString(&quot;MM&quot;) == currentMonth &amp;&amp; completedRequest.Completed_DateTime.toString(&quot;yyyy&quot;) == currentYear)\n\t\t{\n\t\t\tcompletedTripsThisMonth = completedTripsThisMonth + 1;\n\t\t}\n\t}\n\n\tavailableVehicles = Vehicles[Active_Status == &quot;Active&quot; &amp;&amp; Availability_Status == &quot;Available&quot;].count();\n\tavailableDrivers = Drivers[Active_Status == &quot;Active&quot; &amp;&amp; Availability_Status == &quot;Available&quot;].count();\n\n\tvehicleAvailable = Vehicles[Availability_Status == &quot;Available&quot;].count();\n\tvehicleAssigned = Vehicles[Availability_Status == &quot;Assigned&quot;].count();\n\tvehicleMaintenance = Vehicles[Availability_Status == &quot;Maintenance&quot;].count();\n\tvehicleInactive = Vehicles[Availability_Status == &quot;Inactive&quot;].count();\n\ttotalVehicleStatus = vehicleAvailable + vehicleAssigned + vehicleMaintenance + vehicleInactive;\n\tif(totalVehicleStatus == 0)\n\t{\n\t\ttotalVehicleBasis = 1;\n\t}\n\telse\n\t{\n\t\ttotalVehicleBasis = totalVehicleStatus;\n\t}\n\tvehicleAvailablePct = (vehicleAvailable * 100) / totalVehicleBasis;\n\tvehicleAssignedPct = (vehicleAssigned * 100) / totalVehicleBasis;\n\tvehicleMaintenancePct = (vehicleMaintenance * 100) / totalVehicleBasis;\n\tvehicleInactivePct = (vehicleInactive * 100) / totalVehicleBasis;\n\n\tdriverAvailable = Drivers[Availability_Status == &quot;Available&quot;].count();\n\tdriverAssigned = Drivers[Availability_Status == &quot;Assigned&quot;].count();\n\tdriverOnLeave = Drivers[Availability_Status == &quot;On Leave&quot;].count();\n\tdriverInactive = Drivers[Availability_Status == &quot;Inactive&quot;].count();\n\ttotalDriverStatus = driverAvailable + driverAssigned + driverOnLeave + driverInactive;\n\tif(totalDriverStatus == 0)\n\t{\n\t\ttotalDriverBasis = 1;\n\t}\n\telse\n\t{\n\t\ttotalDriverBasis = totalDriverStatus;\n\t}\n\tdriverAvailablePct = (driverAvailable * 100) / totalDriverBasis;\n\tdriverAssignedPct = (driverAssigned * 100) / totalDriverBasis;\n\tdriverOnLeavePct = (driverOnLeave * 100) / totalDriverBasis;\n\tdriverInactivePct = (driverInactive * 100) / totalDriverBasis;\n\n\ttotalRequestStatus = pendingRequests + approvedAwaiting + assignedTrips + rejectedRequests + completedTrips;\n\tif(totalRequestStatus == 0)\n\t{\n\t\ttotalStatusBasis = 1;\n\t}\n\telse\n\t{\n\t\ttotalStatusBasis = totalRequestStatus;\n\t}\n\tpendingPct = (pendingRequests * 100) / totalStatusBasis;\n\tapprovedPct = (approvedAwaiting * 100) / totalStatusBasis;\n\tassignedPct = (assignedTrips * 100) / totalStatusBasis;\n\trejectedPct = (rejectedRequests * 100) / totalStatusBasis;\n\tcompletedPct = (completedTrips * 100) / totalStatusBasis;\n\n\tnextWeek = zoho.currenttime.addDay(7);\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for this page: functional ZCS utility subset used by this dashboard ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF);\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color, #12132B);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #6B7280);\n\t--zcs-border-color: var(--zcs_tertiary_border_color, #E5E7EB);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--zcs-success-color: #179E6C;\n\t--zcs-warning-color: #FAAE13;\n\t--zcs-danger-color: #FE455D;\n\t--zcs-info-color: #2A6FFC;\n\t--zcs-component-hover-color: var(--zcs_component_hover_color, #F4F6FA);\n\t--column-gap: 0px;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; }\n.zcs-col-3 { flex: 0 0 calc(25% - var(--column-gap) * .75); max-width: calc(25% - var(--column-gap) * .75); }\n.zcs-col-4 { flex: 0 0 calc(33.333333% - var(--column-gap) * .666667); max-width: calc(33.333333% - var(--column-gap) * .666667); }\n.zcs-col-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); }\n.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }\n@media (max-width: 1280px) { .zcs-col-lg-4 { flex: 0 0 calc(33.333333% - var(--column-gap) * .666667); max-width: calc(33.333333% - var(--column-gap) * .666667); } .zcs-col-lg-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); } .zcs-col-lg-12 { flex: 0 0 100%; max-width: 100%; } }\n@media (max-width: 992px) { .zcs-col-md-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); } .zcs-col-md-12 { flex: 0 0 100%; max-width: 100%; } }\n@media (max-width: 768px) { .zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; } }\n@media (max-width: 576px) { .zcs-col-xs-12 { flex: 0 0 100%; max-width: 100%; } }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; --column-gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; --column-gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; --column-gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; --column-gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; --column-gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; --column-gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-sticky { position: sticky; }\n.zcs-relative { position: relative; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\na { text-decoration: none; }\n\n/* ZCS Primary Button component: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }\n.zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1E40AF); color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background: var(--zcs-component-hover-color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n\n/* ZCS Filled Badge component: badge-filled-badge */\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n\n/* ZCS Progress Bar styles from card-fleets-performance-metrics */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs-component-hover-color); overflow: hidden; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }\n\n/* ZCS Simple Table component: table-simple-table */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1120px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr.zcs-tnodata:hover td { background-color: transparent; }\n\n/* Transport dashboard composition */\n.transport-dashboard, .transport-dashboard * { box-sizing: border-box; }\n.transport-dashboard { width: 100%; min-height: 100%; padding: 20px; background: var(--zcs-page-bg-color); font-family: Inter, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.transport-header { overflow: hidden; position: relative; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1E40AF); color: var(--zcs-white-color); border-radius: 18px; padding: 24px; }\n.transport-header:after { content: &apos;&apos;; position: absolute; right: -80px; top: -90px; width: 260px; height: 260px; border-radius: 50%; border: 34px solid rgba(255,255,255,.14); }\n.transport-header:before { content: &apos;&apos;; position: absolute; right: 120px; bottom: -70px; width: 180px; height: 180px; border-radius: 50%; border: 22px solid rgba(255,255,255,.10); }\n.transport-header-content { position: relative; z-index: 1; }\n.transport-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.16); color: rgba(255,255,255,.95); font-size: 12px; font-weight: 600; }\n.transport-title { margin: 12px 0 4px; font-size: 28px; line-height: 1.2; font-weight: 700; }\n.transport-subtitle { margin: 0; max-width: 760px; color: rgba(255,255,255,.86); font-size: 14px; line-height: 1.6; }\n.transport-header-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n.transport-meta-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.14); color: rgba(255,255,255,.94); font-size: 13px; }\n.transport-section { margin-top: 18px; }\n.transport-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }\n.transport-section-title h3 { margin: 0; font-size: 18px; font-weight: 650; color: var(--zcs-primary-text-color); }\n.transport-section-title p { margin: 4px 0 0; color: var(--zcs-teritiary-text-color); font-size: 13px; }\n.metric-card { min-height: 142px; position: relative; overflow: hidden; }\n.metric-card:after { content: &apos;&apos;; position: absolute; right: -32px; bottom: -38px; width: 112px; height: 112px; border-radius: 50%; background: var(--metric-soft-color, var(--zcs-light-bg-color)); opacity: .9; }\n.metric-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--metric-soft-color, var(--zcs-light-bg-color)); color: var(--metric-color, var(--zcs-theme-brand-color)); font-size: 18px; }\n.metric-label { color: var(--zcs-teritiary-text-color); font-size: 13px; line-height: 1.35; }\n.metric-value { font-size: 30px; line-height: 1; font-weight: 750; color: var(--zcs-primary-text-color); }\n.metric-foot { font-size: 12px; color: var(--zcs-secondary-text-color); }\n.status-stack { display: flex; height: 18px; overflow: hidden; border-radius: 999px; background: var(--zcs-component-hover-color); }\n.status-stack span { display: block; min-width: 0; }\n.status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }\n.status-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; }\n.status-list { list-style: none; }\n.status-list li + li { margin-top: 12px; }\n.status-name { display: inline-flex; align-items: center; gap: 8px; }\n.availability-card { min-height: 122px; }\n.availability-count { font-size: 26px; font-weight: 750; line-height: 1; color: var(--zcs-primary-text-color); }\n.availability-label { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.no-data-row { padding: 26px 16px; color: var(--zcs-teritiary-text-color); text-align: center; }\n.quick-link-bar { display: flex; flex-wrap: wrap; gap: 10px; }\n.trip-destination { max-width: 220px; white-space: normal; line-height: 1.35; }\n@media (max-width: 768px) { .transport-dashboard { padding: 14px; } .transport-title { font-size: 24px; } .transport-section-title { align-items: flex-start; flex-direction: column; } .quick-link-bar { width: 100%; } .quick-link-bar .zcs-button { width: 100%; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;transport-dashboard&quot;&gt;\n\t&lt;section class=&quot;transport-header&quot;&gt;\n\t\t&lt;div class=&quot;transport-header-content&quot;&gt;\n\t\t\t&lt;span class=&quot;transport-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Operational dashboard&lt;/span&gt;\n\t\t\t&lt;h1 class=&quot;transport-title&quot;&gt;Transport Dashboard&lt;/h1&gt;\n\t\t\t&lt;p class=&quot;transport-subtitle&quot;&gt;Current request volumes, assignment workload, fleet availability, driver availability, and upcoming trip commitments for transport operations and college management.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;transport-header-meta&quot;&gt;\n\t\t\t\t&lt;span class=&quot;transport-meta-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Server-rendered counts&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;transport-meta-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Next 7 days trip window&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;transport-meta-pill&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt; Quick access to operational reports&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;transport-section&quot;&gt;\n\t\t&lt;div class=&quot;zcs-row zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card&quot; style=&quot;--metric-color:#FAAE13;--metric-soft-color:#FCF4E6;&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;metric-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Pending&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;metric-label&quot;&gt;Pending Requests&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;metric-value&quot;&gt;&lt;%=pendingRequests%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;metric-foot&quot;&gt;Awaiting department or transport review&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card&quot; style=&quot;--metric-color:#2A6FFC;--metric-soft-color:#E8EFFF;&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;metric-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Approved&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div cl