<%
activeStudents = Students[Enrollment_Status == "Active"].count();
activeStaff = Staff[Employment_Status == "Active"].count();
activeClasses = Classes[Status == "Active"].count();
activeSubjects = Subjects[Status == "Active"].count();
todayAttendance = Attendance[Attendance_Date == zoho.currentdate].count();
upcomingScheduledExams = Exams[Status == "Scheduled" && Exam_Date >= zoho.currentdate].count();
completedLessonPlans = Lesson_Plans[Plan_Status == "Completed"].count();

passMarks = Marks[Result == "Pass"].count();
failMarks = Marks[Result == "Fail"].count();
absentMarks = Marks[Result == "Absent"].count();
markOutcomeCount = passMarks + failMarks;
passRate = 0;
if(markOutcomeCount > 0)
{
    passRate = (passMarks * 100) / markOutcomeCount;
}

attendanceTotal = Attendance[ID != 0].count();
presentCount = Attendance[Status == "Present"].count();
absentCount = Attendance[Status == "Absent"].count();
lateCount = Attendance[Status == "Late"].count();
excusedCount = Attendance[Status == "Excused"].count();
presentPct = 0;
absentPct = 0;
latePct = 0;
excusedPct = 0;
if(attendanceTotal > 0)
{
    presentPct = (presentCount * 100) / attendanceTotal;
    absentPct = (absentCount * 100) / attendanceTotal;
    latePct = (lateCount * 100) / attendanceTotal;
    excusedPct = (excusedCount * 100) / attendanceTotal;
}

examTotal = Exams[ID != 0].count();
scheduledExamCount = Exams[Status == "Scheduled"].count();
completedExamCount = Exams[Status == "Completed"].count();
cancelledExamCount = Exams[Status == "Cancelled"].count();
scheduledExamPct = 0;
completedExamPct = 0;
cancelledExamPct = 0;
if(examTotal > 0)
{
    scheduledExamPct = (scheduledExamCount * 100) / examTotal;
    completedExamPct = (completedExamCount * 100) / examTotal;
    cancelledExamPct = (cancelledExamCount * 100) / examTotal;
}

lessonPlanTotal = Lesson_Plans[ID != 0].count();
plannedLessonCount = Lesson_Plans[Plan_Status == "Planned"].count();
inProgressLessonCount = Lesson_Plans[Plan_Status == "In Progress"].count();
completedLessonCount = Lesson_Plans[Plan_Status == "Completed"].count();
delayedLessonCount = Lesson_Plans[Plan_Status == "Delayed"].count();
plannedLessonPct = 0;
inProgressLessonPct = 0;
completedLessonPct = 0;
delayedLessonPct = 0;
if(lessonPlanTotal > 0)
{
    plannedLessonPct = (plannedLessonCount * 100) / lessonPlanTotal;
    inProgressLessonPct = (inProgressLessonCount * 100) / lessonPlanTotal;
    completedLessonPct = (completedLessonCount * 100) / lessonPlanTotal;
    delayedLessonPct = (delayedLessonCount * 100) / lessonPlanTotal;
}

userLabel = zoho.loginuser;
if(userLabel == null || userLabel == "")
{
    userLabel = zoho.loginuserid;
}
%>
<style>
/* ZCS global utility subset used by this page, included once for this page */
:root {
    --zcs-theme-brand-color: var(--zcs_brand_color);
    --zcs-light-bg-color: var(--zcs_brand_light_color);
    --zcs-primary-text-color: var(--zcs_primary_text_color);
    --zcs-secondary-text-color: var(--zcs_secondary_text_color);
    --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
    --zcs-border-color: var(--zcs_tertiary_border_color);
    --zcs-white-color: #FFFFFF;
    --zcs-page-bg-color: #F3F3F4;
    --zcs-success-color: #179E6C;
    --zcs-danger-color: #FE455D;
    --zcs-warning-color: #FAAE13;
    --zcs-info-color: #2A6FFC;
}
.zcs-row { display:flex; flex-wrap:wrap; }
.zcs-flex { display:flex; }
.zcs-inline-flex { display:inline-flex; }
.zcs-direction-column { flex-direction:column; }
.zcs-align-items-center, .zcs-align-center { align-items:center; }
.zcs-align-items-start { align-items:flex-start; }
.zcs-justify-center { justify-content:center; }
.zcs-justify-space-between { justify-content:space-between; }
.zcs-gap-4 { gap:.25rem; }
.zcs-gap-6 { gap:.375rem; }
.zcs-gap-8 { gap:.5rem; }
.zcs-gap-10 { gap:.625rem; }
.zcs-gap-12 { gap:.75rem; }
.zcs-gap-16 { gap:1rem; }
.zcs-gap-20 { gap:1.25rem; }
.zcs-p-0 { padding:0; }
.zcs-p-8 { padding:.5rem; }
.zcs-p-10 { padding:.625rem; }
.zcs-p-12 { padding:.75rem; }
.zcs-p-16 { padding:1rem; }
.zcs-p-20 { padding:1.25rem; }
.zcs-p-24 { padding:1.5rem; }
.zcs-px-8 { padding-left:.5rem; padding-right:.5rem; }
.zcs-px-10 { padding-left:.625rem; padding-right:.625rem; }
.zcs-px-12 { padding-left:.75rem; padding-right:.75rem; }
.zcs-px-16 { padding-left:1rem; padding-right:1rem; }
.zcs-px-20 { padding-left:1.25rem; padding-right:1.25rem; }
.zcs-py-2 { padding-top:.125rem; padding-bottom:.125rem; }
.zcs-py-4 { padding-top:.25rem; padding-bottom:.25rem; }
.zcs-py-6 { padding-top:.375rem; padding-bottom:.375rem; }
.zcs-py-8 { padding-top:.5rem; padding-bottom:.5rem; }
.zcs-py-10 { padding-top:.625rem; padding-bottom:.625rem; }
.zcs-py-12 { padding-top:.75rem; padding-bottom:.75rem; }
.zcs-m-0 { margin:0; }
.zcs-mt-4 { margin-top:.25rem; }
.zcs-mt-8 { margin-top:.5rem; }
.zcs-mt-12 { margin-top:.75rem; }
.zcs-mt-16 { margin-top:1rem; }
.zcs-mb-8 { margin-bottom:.5rem; }
.zcs-w-full { width:100%; }
.zcs-col-common { flex:1 1 0%; }
.zcs-col-auto { flex:0 0 auto; }
.zcs-font-11 { font-size:.6875rem; }
.zcs-font-12 { font-size:.75rem; }
.zcs-font-13 { font-size:.8125rem; }
.zcs-font-14 { font-size:.875rem; }
.zcs-font-15 { font-size:.9375rem; }
.zcs-font-16 { font-size:1rem; }
.zcs-font-18 { font-size:1.125rem; }
.zcs-font-20 { font-size:1.25rem; }
.zcs-font-24 { font-size:1.5rem; }
.zcs-font-28 { font-size:1.75rem; }
.zcs-font-40 { font-size:2.5rem; }
.zcs-font-normal { font-weight:400; }
.zcs-font-medium { font-weight:500; }
.zcs-font-semibold { font-weight:600; }
.zcs-font-bold { font-weight:700; }
.zcs-lh-body { line-height:1.5; }
.zcs-lh-heading { line-height:1.25; }
.zcs-uppercase { text-transform:uppercase; }
.zcs-text-left { text-align:left; }
.zcs-text-right { text-align:right; }
.zcs-text-center { text-align:center; }
.zcs-rounded-sm { border-radius:.25rem; }
.zcs-rounded-md { border-radius:.375rem; }
.zcs-rounded-lg { border-radius:.5rem; }
.zcs-rounded-xl { border-radius:.75rem; }
.zcs-rounded-2xl { border-radius:1rem; }
.zcs-rounded-half { border-radius:50%; }
.zcs-box-border { box-sizing:border-box; }
.zcs-relative { position:relative; }
.zcs-sticky { position:sticky; }
.zcs-overflow-auto { overflow:auto; }
.zcs-ellipsis { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.zcs-color-theme { color:var(--zcs-theme-brand-color); }
.zcs-color-primary { color:var(--zcs-primary-text-color); }
.zcs-color-secondary { color:var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color:var(--zcs-teritiary-text-color); }
.zcs-color-white { color:var(--zcs-white-color); }
.zcs-color-green { color:#179E6C; }
.zcs-color-red { color:#FE455D; }
.zcs-color-yellow { color:#b8770d; }
.zcs-color-blue { color:#2A6FFC; }
.zcs-card { background:var(--zcs-white-color); border:1px solid var(--zcs-border-color); border-radius:12px; }

/* ZCS table-simple-table CSS */
:root { --zcs-thead-color:#F9FAFE; --zcs-tr-h-color:#F9FAFE; }
.zcs-table-wrapper { border:1px solid var(--zcs-border-color); background-color:var(--zcs-white-color); overflow:auto; }
.zcs-table-wrapper table { line-height:normal; border-collapse:collapse; }
.zcs-table-wrapper table thead { top:0; }
.zcs-table-wrapper table thead tr th { background-color:var(--zcs-thead-color); box-shadow:0 -1px 0 0 var(--zcs-border-color) inset; white-space:nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color:var(--zcs-white-color); box-shadow:none; }
.zcs-table-wrapper table tbody tr td { border-top:1px solid var(--zcs-border-color); vertical-align:top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color:transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color:var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color:#179e6c; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color:#fe455d; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color:#b8770d; }
.zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color:#09598e; }
.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color:#1094c5; }

/* ZCS badge-filled-badge CSS */
.zcs-badge { width:auto; }
.zcs-badge-filled { border:1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color:var(--zcs-theme-brand-color); border-color:var(--zcs-theme-brand-color); color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color:#179E6C; border-color:#179E6C; color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color:#FE455D; border-color:#FE455D; color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color:#242424; border-color:#242424; color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color:#FAAE13; border-color:#FAAE13; color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color:#2A6FFC; border-color:#2A6FFC; color:var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color:#F4660C; border-color:#F4660C; color:var(--zcs-white-color); }

/* ZCS legend-legend-with-count CSS */
.zcs-legend-wrapper li { list-style-type:none; }
.zcs-legend-wrapper li label { min-width:120px; }
.zcs-legend-wrapper li label:before { content:''; display:inline-block; vertical-align:top; width:12px; height:12px; margin:4px 12px 4px 0; border-radius:50%; }
.zcs-legend-wrapper li:nth-child(1) label:before { background-color:#FECE56; }
.zcs-legend-wrapper li:nth-child(2) label:before { background-color:#36A2EB; }
.zcs-legend-wrapper li:nth-child(3) label:before { background-color:#FF6283; }
.zcs-legend-wrapper li:nth-child(4) label:before { background-color:#28CC97; }

/* ZCS progress-bar-range-bar-with-text CSS */
.zcs-progress-bar { height:8px; background-color:var(--zcs_component_hover_color); overflow:hidden; }
.zcs-progress-bar-indicator { height:inherit; border-radius:inherit; background-color:var(--zcs-theme-brand-color); }

.academic-overview { min-height:100%; background:var(--zcs-page-bg-color); padding:24px; box-sizing:border-box; color:var(--zcs-primary-text-color); }
.ao-header { background:linear-gradient(135deg, var(--zcs-theme-brand-color), var(--zcs_brand_dark_color)); color:var(--zcs-white-color); border-radius:18px; padding:24px; position:relative; overflow:hidden; }
.ao-header:after { content:''; position:absolute; width:280px; height:280px; border:32px solid rgba(255,255,255,.10); border-radius:50%; right:-72px; top:-118px; }
.ao-header:before { content:''; position:absolute; width:160px; height:160px; border:18px solid rgba(255,255,255,.08); border-radius:50%; right:128px; bottom:-92px; }
.ao-header-content { position:relative; z-index:1; }
.ao-header h1 { margin:0; color:var(--zcs-white-color); font-size:28px; line-height:1.2; font-weight:700; }
.ao-header p { margin:8px 0 0; color:rgba(255,255,255,.86); max-width:760px; }
.ao-readonly-badge { background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.24); color:var(--zcs-white-color); }
.ao-grid { display:grid; gap:16px; }
.ao-kpi-grid { grid-template-columns:repeat(4, minmax(0, 1fr)); margin-top:16px; }
.ao-analytics-grid { grid-template-columns:1.15fr .85fr; margin-top:16px; }
.ao-table-grid { grid-template-columns:1fr 1fr; margin-top:16px; }
.ao-kpi-card { padding:18px; min-height:132px; position:relative; overflow:hidden; }
.ao-kpi-card:after { content:''; position:absolute; width:92px; height:92px; right:-34px; bottom:-34px; border-radius:50%; background:var(--zcs_component_hover_color); }
.ao-kpi-icon { width:42px; height:42px; border-radius:12px; color:var(--zcs-theme-brand-color); background:var(--zcs-light-bg-color); font-size:20px; }
.ao-kpi-label { color:var(--zcs-secondary-text-color); }
.ao-kpi-value { font-size:28px; font-weight:700; line-height:1.1; color:var(--zcs-primary-text-color); margin-top:12px; }
.ao-kpi-note { color:var(--zcs-teritiary-text-color); margin-top:6px; }
.ao-section { padding:18px; }
.ao-section-title { margin:0; color:var(--zcs-primary-text-color); font-size:18px; font-weight:650; line-height:1.25; }
.ao-section-subtitle { margin:4px 0 0; color:var(--zcs-secondary-text-color); }
.ao-status-row { display:grid; grid-template-columns:132px 1fr 48px; gap:12px; align-items:center; }
.ao-status-dot { width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:8px; }
.ao-dot-green { background:#179E6C; }
.ao-dot-red { background:#FE455D; }
.ao-dot-yellow { background:#FAAE13; }
.ao-dot-blue { background:#2A6FFC; }
.ao-dot-orange { background:#F4660C; }
.ao-dot-grey { background:#242424; }
.ao-bar-green .zcs-progress-bar-indicator { background:#179E6C; }
.ao-bar-red .zcs-progress-bar-indicator { background:#FE455D; }
.ao-bar-yellow .zcs-progress-bar-indicator { background:#FAAE13; }
.ao-bar-blue .zcs-progress-bar-indicator { background:#2A6FFC; }
.ao-bar-orange .zcs-progress-bar-indicator { background:#F4660C; }
.ao-bar-grey .zcs-progress-bar-indicator { background:#242424; }
.ao-summary-card { background:#F9FAFE; border:1px solid var(--zcs-border-color); border-radius:12px; padding:14px; }
.ao-pass-ring { width:138px; height:138px; border-radius:50%; background:conic-gradient(var(--zcs-theme-brand-color) 0 <%=passRate%>%, var(--zcs_component_hover_color) <%=passRate%>% 100%); margin:auto; display:flex; align-items:center; justify-content:center; }
.ao-pass-ring-inner { width:98px; height:98px; border-radius:50%; background:var(--zcs-white-color); display:flex; align-items:center; justify-content:center; flex-direction:column; }
.ao-muted { color:var(--zcs-secondary-text-color); }
.ao-empty { color:var(--zcs-secondary-text-color); padding:26px 16px; text-align:center; }
.ao-table-wrapper { max-height:360px; }
.ao-table-wrapper table { min-width:100%; }
.ao-table-wrapper th, .ao-table-wrapper td { white-space:nowrap; }
.ao-table-wrapper td.ao-wrap { white-space:normal; min-width:180px; }
.ao-health-strip { display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; }
.ao-health-item { border:1px solid var(--zcs-border-color); border-radius:10px; padding:10px 12px; background:var(--zcs-white-color); }
@media (max-width:1280px) { .ao-kpi-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } }
@media (max-width:900px) { .academic-overview { padding:16px; } .ao-analytics-grid, .ao-table-grid { grid-template-columns:1fr; } .ao-health-strip { grid-template-columns:repeat(2, 1fr); } }
@media (max-width:560px) { .ao-kpi-grid, .ao-health-strip { grid-template-columns:1fr; } .ao-status-row { grid-template-columns:1fr; gap:6px; } .ao-header h1 { font-size:24px; } }
</style>
<div class="academic-overview">
    <div class="ao-header">
        <div class="ao-header-content zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16">
            <div>
                <div class="zcs-font-14" style="color:rgba(255,255,255,.82);">Hello <%=userLabel%></div>
                <h1>Academic Overview</h1>
                <p class="zcs-font-14 zcs-lh-body">Read-only snapshot of students, staff, classes, subjects, attendance, lesson planning, exams, and marks.</p>
            </div>
            <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-md zcs-px-12 zcs-py-6 zcs-box-border ao-readonly-badge">
                <i class="zc-li-outline ui-1-check-circle-08"></i>
                <span class="zcs-badge-text zcs-font-13 zcs-font-medium zcs-lh-body">Read only</span>
            </div>
        </div>
    </div>

    <div class="ao-grid ao-kpi-grid">
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Active Students</span>
                    <span class="ao-kpi-value"><%=activeStudents%></span>
                    <span class="ao-kpi-note zcs-font-12">Enrollment status is Active</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-single-01"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Active Staff</span>
                    <span class="ao-kpi-value"><%=activeStaff%></span>
                    <span class="ao-kpi-note zcs-font-12">Employment status is Active</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-single-02"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Active Classes</span>
                    <span class="ao-kpi-value"><%=activeClasses%></span>
                    <span class="ao-kpi-note zcs-font-12">Class status is Active</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline design-todo"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Active Subjects</span>
                    <span class="ao-kpi-value"><%=activeSubjects%></span>
                    <span class="ao-kpi-note zcs-font-12">Subject status is Active</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-single-folded-content"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Today Attendance</span>
                    <span class="ao-kpi-value"><%=todayAttendance%></span>
                    <span class="ao-kpi-note zcs-font-12">Records dated today</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Upcoming Exams</span>
                    <span class="ao-kpi-value"><%=upcomingScheduledExams%></span>
                    <span class="ao-kpi-note zcs-font-12">Scheduled from today onward</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline education-agenda-bookmark"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Completed Plans</span>
                    <span class="ao-kpi-value"><%=completedLessonPlans%></span>
                    <span class="ao-kpi-note zcs-font-12">Lesson plans completed</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08"></i></div>
            </div>
        </div>
        <div class="ao-kpi-card zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-gap-12">
                <div class="zcs-flex zcs-direction-column">
                    <span class="ao-kpi-label zcs-font-13 zcs-font-medium zcs-uppercase">Marks Pass Rate</span>
                    <span class="ao-kpi-value"><%=passRate%>%</span>
                    <span class="ao-kpi-note zcs-font-12"><%=passMarks%> pass of <%=markOutcomeCount%> assessed outcomes</span>
                </div>
                <div class="ao-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-chart-bar-32"></i></div>
            </div>
        </div>
    </div>

    <div class="ao-grid ao-analytics-grid">
        <div class="ao-section zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
                <div>
                    <h2 class="ao-section-title">Attendance Status Distribution</h2>
                    <p class="ao-section-subtitle zcs-font-13">Total attendance records: <%=attendanceTotal%></p>
                </div>
                <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme">
                    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Attendance</span>
                </div>
            </div>
            <div class="zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16">
                <div class="ao-status-row">
                    <div class="zcs-font-14 zcs-color-primary"><span class="ao-status-dot ao-dot-green"></span>Present</div>
                    <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-green"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=presentPct%>%;"></div></div></div>
                    <div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=presentCount%></div>
                </div>
                <div class="ao-status-row">
                    <div class="zcs-font-14 zcs-color-primary"><span class="ao-status-dot ao-dot-red"></span>Absent</div>
                    <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-red"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=absentPct%>%;"></div></div></div>
                    <div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=absentCount%></div>
                </div>
                <div class="ao-status-row">
                    <div class="zcs-font-14 zcs-color-primary"><span class="ao-status-dot ao-dot-yellow"></span>Late</div>
                    <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-yellow"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=latePct%>%;"></div></div></div>
                    <div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=lateCount%></div>
                </div>
                <div class="ao-status-row">
                    <div class="zcs-font-14 zcs-color-primary"><span class="ao-status-dot ao-dot-blue"></span>Excused</div>
                    <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 ao-bar-blue"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=excusedPct%>%;"></div></div></div>
                    <div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=excusedCount%></div>
                </div>
            </div>
        </div>

        <div class="ao-section zcs-card zcs-box-border">
            <h2 class="ao-section-title">Academic Health Summary</h2>
            <p class="ao-section-subtitle zcs-font-13">Exam completion, lesson planning progress, and marks outcome rate.</p>
            <div class="zcs-flex zcs-align-items-center zcs-gap-16 zcs-mt-16">
                <div class="ao-pass-ring">
                    <div class="ao-pass-ring-inner">
                        <span class="zcs-font-28 zcs-font-bold zcs-color-theme"><%=passRate%>%</span>
                        <span class="zcs-font-12 ao-muted">Pass rate</span>
                    </div>
                </div>
                <div class="zcs-legend-wrapper zcs-legend-with-count zcs-col-common">
                    <ul class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0">
                        <li class="zcs-flex zcs-align-center zcs-gap-8"><label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Pass</label><span class="zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary"><%=passMarks%></span></li>
                        <li class="zcs-flex zcs-align-center zcs-gap-8"><label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Fail</label><span class="zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary"><%=failMarks%></span></li>
                        <li class="zcs-flex zcs-align-center zcs-gap-8"><label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">Absent</label><span class="zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary"><%=absentMarks%></span></li>
                    </ul>
                </div>
            </div>
            <div class="ao-health-strip zcs-mt-16">
                <div class="ao-health-item"><div class="zcs-font-12 ao-muted zcs-uppercase">Exam records</div><div class="zcs-font-20 zcs-font-bold"><%=examTotal%></div></div>
                <div class="ao-health-item"><div class="zcs-font-12 ao-muted zcs-uppercase">Lesson plans</div><div class="zcs-font-20 zcs-font-bold"><%=lessonPlanTotal%></div></div>
                <div class="ao-health-item"><div class="zcs-font-12 ao-muted zcs-uppercase">Passed marks</div><div class="zcs-font-20 zcs-font-bold"><%=passMarks%></div></div>
                <div class="ao-health-item"><div class="zcs-font-12 ao-muted zcs-uppercase">Failed marks</div><div class="zcs-font-20 zcs-font-bold"><%=failMarks%></div></div>
            </div>
        </div>
    </div>

    <div class="ao-grid ao-analytics-grid">
        <div class="ao-section zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
                <div>
                    <h2 class="ao-section-title">Exam Status Summary</h2>
                    <p class="ao-section-subtitle zcs-font-13">Scheduled, completed, and cancelled exam records.</p>
                </div>
                <span class="zcs-font-14 zcs-font-semibold zcs-color-theme"><%=examTotal%> total</span>
            </div>
            <div class="zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16">
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-blue"></span>Scheduled</div><div class="zcs-progress-bar-wrapper ao-bar-blue"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=scheduledExamPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=scheduledExamCount%></div></div>
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-green"></span>Completed</div><div class="zcs-progress-bar-wrapper ao-bar-green"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=completedExamPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=completedExamCount%></div></div>
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-grey"></span>Cancelled</div><div class="zcs-progress-bar-wrapper ao-bar-grey"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=cancelledExamPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=cancelledExamCount%></div></div>
            </div>
        </div>

        <div class="ao-section zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
                <div>
                    <h2 class="ao-section-title">Lesson Plan Status Summary</h2>
                    <p class="ao-section-subtitle zcs-font-13">Planning and completion flow across lesson plans.</p>
                </div>
                <span class="zcs-font-14 zcs-font-semibold zcs-color-theme"><%=lessonPlanTotal%> total</span>
            </div>
            <div class="zcs-flex zcs-direction-column zcs-gap-16 zcs-mt-16">
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-blue"></span>Planned</div><div class="zcs-progress-bar-wrapper ao-bar-blue"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=plannedLessonPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=plannedLessonCount%></div></div>
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-yellow"></span>In Progress</div><div class="zcs-progress-bar-wrapper ao-bar-yellow"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=inProgressLessonPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=inProgressLessonCount%></div></div>
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-green"></span>Completed</div><div class="zcs-progress-bar-wrapper ao-bar-green"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=completedLessonPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=completedLessonCount%></div></div>
                <div class="ao-status-row"><div class="zcs-font-14"><span class="ao-status-dot ao-dot-red"></span>Delayed</div><div class="zcs-progress-bar-wrapper ao-bar-red"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=delayedLessonPct%>%;"></div></div></div><div class="zcs-font-14 zcs-font-semibold zcs-text-right"><%=delayedLessonCount%></div></div>
            </div>
        </div>
    </div>

    <div class="ao-grid ao-table-grid">
        <div class="ao-section zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12 zcs-mb-8">
                <div>
                    <h2 class="ao-section-title">Recent Exams</h2>
                    <p class="ao-section-subtitle zcs-font-13">Latest exam schedule records by exam date.</p>
                </div>
                <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Latest 5</span></div>
            </div>
            <div class="zcs-table-wrapper ao-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
                <table class="zcs-w-full">
                    <thead class="zcs-sticky">
                        <tr>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Exam</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Class</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Subject</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Date</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
                        </tr>
                        <tr class="zcs-tspace"><th class="zcs-p-2 zcs-box-border" colspan="5"></th></tr>
                    </thead>
                    <tbody>
                    <%
                    recentExams = Exams[ID != 0] sort by Exam_Date desc;
                    renderedExams = 0;
                    for each ex in recentExams
                    {
                        if(renderedExams < 5)
                        {
                            examStatusClass = "zcs-badge-blue";
                            if(ex.Status == "Completed")
                            {
                                examStatusClass = "zcs-badge-green";
                            }
                            else if(ex.Status == "Cancelled")
                            {
                                examStatusClass = "zcs-badge-grey";
                            }
                            examName = ifnull(ex.Exam_Name,"-");
                            classCode = ifnull(ex.Class.Class_Code,"-");
                            subjectCode = ifnull(ex.Subject.Subject_Code,"-");
                    %>
                        <tr>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap"><%=examName%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=classCode%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=subjectCode%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ex.Exam_Date%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=examStatusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=ex.Status%></span></span></td>
                        </tr>
                    <%
                            renderedExams = renderedExams + 1;
                        }
                    }
                    if(renderedExams == 0)
                    {
                    %>
                        <tr><td class="ao-empty zcs-font-14" colspan="5">No exam records found.</td></tr>
                    <%
                    }
                    %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ao-section zcs-card zcs-box-border">
            <div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12 zcs-mb-8">
                <div>
                    <h2 class="ao-section-title">Recent Low-Performing or Failed Results</h2>
                    <p class="ao-section-subtitle zcs-font-13">Marks with Fail result or percentage below 40.</p>
                </div>
                <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">Watchlist</span></div>
            </div>
            <div class="zcs-table-wrapper ao-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
                <table class="zcs-w-full">
                    <thead class="zcs-sticky">
                        <tr>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Student</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Exam</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Marks</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Percent</th>
                            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Result</th>
                        </tr>
                        <tr class="zcs-tspace"><th class="zcs-p-2 zcs-box-border" colspan="5"></th></tr>
                    </thead>
                    <tbody>
                    <%
                    lowMarks = Marks[Result == "Fail" || Percentage < 40] sort by Added_Time desc;
                    renderedMarks = 0;
                    for each mk in lowMarks
                    {
                        if(renderedMarks < 5)
                        {
                            markStatusClass = "zcs-badge-red";
                            if(mk.Result == "Absent")
                            {
                                markStatusClass = "zcs-badge-grey";
                            }
                            studentName = ifnull(mk.Student.Student_Name,"-");
                            examTitle = ifnull(mk.Exam.Exam_Name,"-");
                            percentText = ifnull(mk.Percentage,"-");
                            resultText = ifnull(mk.Result,"Low");
                    %>
                        <tr>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap"><%=studentName%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary ao-wrap"><%=examTitle%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=mk.Marks_Obtained%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=percentText%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=markStatusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=resultText%></span></span></td>
                        </tr>
                    <%
                            renderedMarks = renderedMarks + 1;
                        }
                    }
                    if(renderedMarks == 0)
                    {
                    %>
                        <tr><td class="ao-empty zcs-font-14" colspan="5">No low-performing or failed mark records found.</td></tr>
                    <%
                    }
                    %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
