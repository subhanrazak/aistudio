<%
  pendingRequests = Transport_Requests[Request_Status == "Pending"].count();
  approvedAwaiting = Transport_Requests[Request_Status == "Approved"].count();
  assignedTrips = Transport_Requests[Request_Status == "Vehicle Assigned"].count();
  rejectedRequests = Transport_Requests[Request_Status == "Rejected"].count();
  completedTrips = Transport_Requests[Request_Status == "Completed"].count();

  completedTripsThisMonth = 0;
  currentMonth = zoho.currentdate.toString("MM");
  currentYear = zoho.currentdate.toString("yyyy");
  for each completedRequest in Transport_Requests[Request_Status == "Completed" && Completed_DateTime != null]
  {
    if(completedRequest.Completed_DateTime.toString("MM") == currentMonth && completedRequest.Completed_DateTime.toString("yyyy") == currentYear)
    {
      completedTripsThisMonth = completedTripsThisMonth + 1;
    }
  }

  availableVehicles = Vehicles[Active_Status == "Active" && Availability_Status == "Available"].count();
  availableDrivers = Drivers[Active_Status == "Active" && Availability_Status == "Available"].count();

  vehicleAvailable = Vehicles[Availability_Status == "Available"].count();
  vehicleAssigned = Vehicles[Availability_Status == "Assigned"].count();
  vehicleMaintenance = Vehicles[Availability_Status == "Maintenance"].count();
  vehicleInactive = Vehicles[Availability_Status == "Inactive"].count();
  totalVehicleStatus = vehicleAvailable + vehicleAssigned + vehicleMaintenance + vehicleInactive;
  if(totalVehicleStatus == 0)
  {
    totalVehicleBasis = 1;
  }
  else
  {
    totalVehicleBasis = totalVehicleStatus;
  }
  vehicleAvailablePct = (vehicleAvailable * 100) / totalVehicleBasis;
  vehicleAssignedPct = (vehicleAssigned * 100) / totalVehicleBasis;
  vehicleMaintenancePct = (vehicleMaintenance * 100) / totalVehicleBasis;
  vehicleInactivePct = (vehicleInactive * 100) / totalVehicleBasis;

  driverAvailable = Drivers[Availability_Status == "Available"].count();
  driverAssigned = Drivers[Availability_Status == "Assigned"].count();
  driverOnLeave = Drivers[Availability_Status == "On Leave"].count();
  driverInactive = Drivers[Availability_Status == "Inactive"].count();
  totalDriverStatus = driverAvailable + driverAssigned + driverOnLeave + driverInactive;
  if(totalDriverStatus == 0)
  {
    totalDriverBasis = 1;
  }
  else
  {
    totalDriverBasis = totalDriverStatus;
  }
  driverAvailablePct = (driverAvailable * 100) / totalDriverBasis;
  driverAssignedPct = (driverAssigned * 100) / totalDriverBasis;
  driverOnLeavePct = (driverOnLeave * 100) / totalDriverBasis;
  driverInactivePct = (driverInactive * 100) / totalDriverBasis;

  totalRequestStatus = pendingRequests + approvedAwaiting + assignedTrips + rejectedRequests + completedTrips;
  if(totalRequestStatus == 0)
  {
    totalStatusBasis = 1;
  }
  else
  {
    totalStatusBasis = totalRequestStatus;
  }
  pendingPct = (pendingRequests * 100) / totalStatusBasis;
  approvedPct = (approvedAwaiting * 100) / totalStatusBasis;
  assignedPct = (assignedTrips * 100) / totalStatusBasis;
  rejectedPct = (rejectedRequests * 100) / totalStatusBasis;
  completedPct = (completedTrips * 100) / totalStatusBasis;

  nextWeek = zoho.currenttime.addDay(7);
%>
<style>
/* ===== zcs-global.css included once for this page: functional ZCS utility subset used by this dashboard ===== */
:root {
  --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC);
  --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF);
  --zcs-page-bg-color: #F3F3F4;
  --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B);
  --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563);
  --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #6B7280);
  --zcs-border-color: var(--zcs_tertiary_border_color, #E5E7EB);
  --zcs-white-color: #FFFFFF;
  --zcs-black-color: #000000;
  --zcs-success-color: #179E6C;
  --zcs-warning-color: #FAAE13;
  --zcs-danger-color: #FE455D;
  --zcs-info-color: #2A6FFC;
  --zcs-component-hover-color: var(--zcs_component_hover_color, #F4F6FA);
  --column-gap: 0px;
  font-size: 16px;
  line-height: 1.5;
}
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-col { flex-shrink: 0; width: 100%; max-width: 100%; }
.zcs-col-3 { flex: 0 0 calc(25% - var(--column-gap) * .75); max-width: calc(25% - var(--column-gap) * .75); }
.zcs-col-4 { flex: 0 0 calc(33.333333% - var(--column-gap) * .666667); max-width: calc(33.333333% - var(--column-gap) * .666667); }
.zcs-col-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
@media (max-width: 1280px) { .zcs-col-lg-4 { flex: 0 0 calc(33.333333% - var(--column-gap) * .666667); max-width: calc(33.333333% - var(--column-gap) * .666667); } .zcs-col-lg-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); } .zcs-col-lg-12 { flex: 0 0 100%; max-width: 100%; } }
@media (max-width: 992px) { .zcs-col-md-6 { flex: 0 0 calc(50% - var(--column-gap) * .5); max-width: calc(50% - var(--column-gap) * .5); } .zcs-col-md-12 { flex: 0 0 100%; max-width: 100%; } }
@media (max-width: 768px) { .zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; } }
@media (max-width: 576px) { .zcs-col-xs-12 { flex: 0 0 100%; max-width: 100%; } }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-align-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; --column-gap: .25rem; }
.zcs-gap-6 { gap: .375rem; --column-gap: .375rem; }
.zcs-gap-8 { gap: .5rem; --column-gap: .5rem; }
.zcs-gap-10 { gap: .625rem; --column-gap: .625rem; }
.zcs-gap-12 { gap: .75rem; --column-gap: .75rem; }
.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; --column-gap: 1.5rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-box-border { box-sizing: border-box; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-sticky { position: sticky; }
.zcs-relative { position: relative; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-overflow-auto { overflow: auto; }
.zcs-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
a { text-decoration: none; }

/* ZCS Primary Button component: button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
.zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs_brand_foreground_color, #FFFFFF); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1E40AF); color: var(--zcs_brand_foreground_color, #FFFFFF); }
.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-outline-button:hover { background: var(--zcs-component-hover-color); }
.zcs-button-icon { width: 16px; max-height: 16px; }

/* ZCS Filled Badge component: badge-filled-badge */
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }

/* ZCS Progress Bar styles from card-fleets-performance-metrics */
.zcs-progress-bar { height: 8px; background-color: var(--zcs-component-hover-color); overflow: hidden; }
.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }

/* ZCS Simple Table component: table-simple-table */
:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1120px; }
.zcs-table-wrapper table thead { top: 0; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr.zcs-tnodata:hover td { background-color: transparent; }

/* Transport dashboard composition */
.transport-dashboard, .transport-dashboard * { box-sizing: border-box; }
.transport-dashboard { width: 100%; min-height: 100%; padding: 20px; background: var(--zcs-page-bg-color); font-family: Inter, Arial, sans-serif; color: var(--zcs-primary-text-color); }
.transport-header { overflow: hidden; position: relative; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1E40AF); color: var(--zcs-white-color); border-radius: 18px; padding: 24px; }
.transport-header:after { content: ''; position: absolute; right: -80px; top: -90px; width: 260px; height: 260px; border-radius: 50%; border: 34px solid rgba(255,255,255,.14); }
.transport-header:before { content: ''; position: absolute; right: 120px; bottom: -70px; width: 180px; height: 180px; border-radius: 50%; border: 22px solid rgba(255,255,255,.10); }
.transport-header-content { position: relative; z-index: 1; }
.transport-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.16); color: rgba(255,255,255,.95); font-size: 12px; font-weight: 600; }
.transport-title { margin: 12px 0 4px; font-size: 28px; line-height: 1.2; font-weight: 700; }
.transport-subtitle { margin: 0; max-width: 760px; color: rgba(255,255,255,.86); font-size: 14px; line-height: 1.6; }
.transport-header-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.transport-meta-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.14); color: rgba(255,255,255,.94); font-size: 13px; }
.transport-section { margin-top: 18px; }
.transport-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.transport-section-title h3 { margin: 0; font-size: 18px; font-weight: 650; color: var(--zcs-primary-text-color); }
.transport-section-title p { margin: 4px 0 0; color: var(--zcs-teritiary-text-color); font-size: 13px; }
.metric-card { min-height: 142px; position: relative; overflow: hidden; }
.metric-card:after { content: ''; position: absolute; right: -32px; bottom: -38px; width: 112px; height: 112px; border-radius: 50%; background: var(--metric-soft-color, var(--zcs-light-bg-color)); opacity: .9; }
.metric-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--metric-soft-color, var(--zcs-light-bg-color)); color: var(--metric-color, var(--zcs-theme-brand-color)); font-size: 18px; }
.metric-label { color: var(--zcs-teritiary-text-color); font-size: 13px; line-height: 1.35; }
.metric-value { font-size: 30px; line-height: 1; font-weight: 750; color: var(--zcs-primary-text-color); }
.metric-foot { font-size: 12px; color: var(--zcs-secondary-text-color); }
.status-stack { display: flex; height: 18px; overflow: hidden; border-radius: 999px; background: var(--zcs-component-hover-color); }
.status-stack span { display: block; min-width: 0; }
.status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: 0 0 auto; }
.status-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; }
.status-list { list-style: none; }
.status-list li + li { margin-top: 12px; }
.status-name { display: inline-flex; align-items: center; gap: 8px; }
.availability-card { min-height: 122px; }
.availability-count { font-size: 26px; font-weight: 750; line-height: 1; color: var(--zcs-primary-text-color); }
.availability-label { color: var(--zcs-secondary-text-color); font-size: 13px; }
.no-data-row { padding: 26px 16px; color: var(--zcs-teritiary-text-color); text-align: center; }
.quick-link-bar { display: flex; flex-wrap: wrap; gap: 10px; }
.trip-destination { max-width: 220px; white-space: normal; line-height: 1.35; }
@media (max-width: 768px) { .transport-dashboard { padding: 14px; } .transport-title { font-size: 24px; } .transport-section-title { align-items: flex-start; flex-direction: column; } .quick-link-bar { width: 100%; } .quick-link-bar .zcs-button { width: 100%; } }
</style>

<div class="transport-dashboard">
  <section class="transport-header">
    <div class="transport-header-content">
      <span class="transport-eyebrow"><i class="zc-li-outline ui-2-time"></i> Operational dashboard</span>
      <h1 class="transport-title">Transport Dashboard</h1>
      <p class="transport-subtitle">Current request volumes, assignment workload, fleet availability, driver availability, and upcoming trip commitments for transport operations and college management.</p>
      <div class="transport-header-meta">
        <span class="transport-meta-pill"><i class="zc-li-outline ui-1-check-circle-08"></i> Server-rendered counts</span>
        <span class="transport-meta-pill"><i class="zc-li-outline ui-2-time"></i> Next 7 days trip window</span>
        <span class="transport-meta-pill"><i class="zc-li-outline arrows-1-tail-right"></i> Quick access to operational reports</span>
      </div>
    </div>
  </section>

  <section class="transport-section">
    <div class="zcs-row zcs-gap-16">
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#FAAE13;--metric-soft-color:#FCF4E6;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline ui-2-time"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Pending</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Pending Requests</span>
            <span class="metric-value"><%=pendingRequests%></span>
            <span class="metric-foot">Awaiting department or transport review</span>
          </div>
        </div>
      </div>
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#2A6FFC;--metric-soft-color:#E8EFFF;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Approved</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Approved Awaiting Assignment</span>
            <span class="metric-value"><%=approvedAwaiting%></span>
            <span class="metric-foot">Ready for vehicle and driver assignment</span>
          </div>
        </div>
      </div>
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#F4660C;--metric-soft-color:#F8F0EB;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline arrows-1-tail-right"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Assigned</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Assigned Trips</span>
            <span class="metric-value"><%=assignedTrips%></span>
            <span class="metric-foot">Trips with vehicle and driver allocated</span>
          </div>
        </div>
      </div>
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#179E6C;--metric-soft-color:#E4FCF3;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">This month</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Completed Trips This Month</span>
            <span class="metric-value"><%=completedTripsThisMonth%></span>
            <span class="metric-foot">Based on Completed DateTime in current month</span>
          </div>
        </div>
      </div>
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#09598E;--metric-soft-color:#E6F4FB;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline design-app"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Fleet</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Available Vehicles</span>
            <span class="metric-value"><%=availableVehicles%></span>
            <span class="metric-foot">Active vehicles marked Available</span>
          </div>
        </div>
      </div>
      <div class="zcs-col-4 zcs-col-lg-6 zcs-col-md-6 zcs-col-sm-12 zcs-col-xs-12">
        <div class="zcs-card zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border metric-card" style="--metric-color:#1328CD;--metric-soft-color:#E8EFFF;">
          <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
            <span class="metric-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>
            <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Drivers</span></span>
          </div>
          <div class="zcs-flex zcs-direction-column zcs-gap-8">
            <span class="metric-label">Available Drivers</span>
            <span class="metric-value"><%=availableDrivers%></span>
            <span class="metric-foot">Active drivers marked Available</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="transport-section">
    <div class="zcs-row zcs-gap-16">
      <div class="zcs-col-6 zcs-col-lg-12 zcs-col-md-12 zcs-col-sm-12 zcs-col-xs-12">
        <div class="transport-section-title">
          <div>
            <h3>Status Distribution</h3>
            <p>Request_Status split across all transport requests</p>
          </div>
          <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=totalRequestStatus%> total</span></span>
        </div>
        <div class="zcs-card zcs-flex zcs-direction-column zcs-gap-20 zcs-p-24 zcs-box-border">
          <div class="status-stack" title="Request status distribution">
            <span style="width:<%=pendingPct%>%;background:#FAAE13;"></span>
            <span style="width:<%=approvedPct%>%;background:#2A6FFC;"></span>
            <span style="width:<%=assignedPct%>%;background:#F4660C;"></span>
            <span style="width:<%=completedPct%>%;background:#179E6C;"></span>
            <span style="width:<%=rejectedPct%>%;background:#FE455D;"></span>
          </div>
          <ul class="status-list zcs-p-0 zcs-m-0">
            <li class="status-row">
              <span class="status-name zcs-font-14 zcs-color-secondary"><span class="status-dot" style="background:#FAAE13;"></span>Pending</span>
              <strong class="zcs-font-14 zcs-color-primary"><%=pendingRequests%> <span class="zcs-color-tertiary zcs-font-normal">(<%=pendingPct%>%)</span></strong>
            </li>
            <li class="status-row">
              <span class="status-name zcs-font-14 zcs-color-secondary"><span class="status-dot" style="background:#2A6FFC;"></span>Approved</span>
              <strong class="zcs-font-14 zcs-color-primary"><%=approvedAwaiting%> <span class="zcs-color-tertiary zcs-font-normal">(<%=approvedPct%>%)</span></strong>
            </li>
            <li class="status-row">
              <span class="status-name zcs-font-14 zcs-color-secondary"><span class="status-dot" style="background:#F4660C;"></span>Vehicle Assigned</span>
              <strong class="zcs-font-14 zcs-color-primary"><%=assignedTrips%> <span class="zcs-color-tertiary zcs-font-normal">(<%=assignedPct%>%)</span></strong>
            </li>
            <li class="status-row">
              <span class="status-name zcs-font-14 zcs-color-secondary"><span class="status-dot" style="background:#179E6C;"></span>Completed</span>
              <strong class="zcs-font-14 zcs-color-primary"><%=completedTrips%> <span class="zcs-color-tertiary zcs-font-normal">(<%=completedPct%>%)</span></strong>
            </li>
            <li class="status-row">
              <span class="status-name zcs-font-14 zcs-color-secondary"><span class="status-dot" style="background:#FE455D;"></span>Rejected</span>
              <strong class="zcs-font-14 zcs-color-primary"><%=rejectedRequests%> <span class="zcs-color-tertiary zcs-font-normal">(<%=rejectedPct%>%)</span></strong>
            </li>
          </ul>
        </div>
      </div>

      <div class="zcs-col-6 zcs-col-lg-12 zcs-col-md-12 zcs-col-sm-12 zcs-col-xs-12">
        <div class="transport-section-title">
          <div>
            <h3>Quick Links</h3>
            <p>Open the key reports for approvals, assignment, trips, vehicles, and drivers</p>
          </div>
        </div>
        <div class="zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-24 zcs-box-border">
          <div class="quick-link-bar">
            <a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Pending_Transport_Approvals">
              <i class="zcs-button-icon zc-li-outline ui-2-time"></i><span class="zcs-button-text">Pending Approvals</span>
            </a>
            <a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Approved_For_Assignment">
              <i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-button-text">Approved For Assignment</span>
            </a>
            <a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Assigned_Trips">
              <i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">Assigned Trips</span>
            </a>
            <a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Available_Vehicles">
              <i class="zcs-button-icon zc-li-outline design-app"></i><span class="zcs-button-text">Available Vehicles</span>
            </a>
            <a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Available_Drivers">
              <i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-button-text">Available Drivers</span>
            </a>
          </div>
          <p class="zcs-font-13 zcs-color-tertiary zcs-m-0">Dashboard counts are calculated at page load from Transport_Requests, Vehicles, and Drivers.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="transport-section">
    <div class="transport-section-title">
      <div>
        <h3>Upcoming Trips</h3>
        <p>Trips scheduled for the next 7 days, excluding rejected requests</p>
      </div>
      <span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Next 7 days</span></span>
    </div>
    <div class="zcs-table-wrapper zcs-rounded-lg zcs-box-border zcs-relative">
      <table class="zcs-w-full">
        <thead class="zcs-sticky">
          <tr>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Request No.</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Department</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Travel Start</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Travel End</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Destination</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Vehicle</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Driver</th>
            <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
          </tr>
        </thead>
        <tbody>
<%
  upcomingCount = 0;
  for each trip in Transport_Requests[Travel_Start >= zoho.currenttime && Travel_Start <= nextWeek && Request_Status != "Rejected"] sort by Travel_Start asc
  {
    if(upcomingCount < 10)
    {
      upcomingCount = upcomingCount + 1;
      requestNo = ifnull(trip.Request_Number,"-");
      departmentName = "-";
      if(trip.Department != null)
      {
        departmentName = trip.Department.Department_Name;
      }
      startText = "-";
      if(trip.Travel_Start != null)
      {
        startText = trip.Travel_Start.toString("dd-MMM-yyyy hh:mm a");
      }
      endText = "-";
      if(trip.Travel_End != null)
      {
        endText = trip.Travel_End.toString("dd-MMM-yyyy hh:mm a");
      }
      destinationText = ifnull(trip.Destination,"-");
      vehicleText = "-";
      if(trip.Assigned_Vehicle != null)
      {
        vehicleText = trip.Assigned_Vehicle.Vehicle_Number;
      }
      driverText = "-";
      if(trip.Assigned_Driver != null)
      {
        driverText = trip.Assigned_Driver.Driver_Name;
      }
      statusText = ifnull(trip.Request_Status,"-");
      statusClass = "zcs-badge-theme";
      if(statusText == "Pending")
      {
        statusClass = "zcs-badge-yellow";
      }
      else if(statusText == "Approved")
      {
        statusClass = "zcs-badge-blue";
      }
      else if(statusText == "Vehicle Assigned")
      {
        statusClass = "zcs-badge-orange";
      }
      else if(statusText == "Completed")
      {
        statusClass = "zcs-badge-green";
      }
%>
          <tr>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=requestNo%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=departmentName%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=startText%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=endText%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="trip-destination"><%=destinationText%></span></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=vehicleText%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=driverText%></td>
            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=statusText%></span></span></td>
          </tr>
<%
    }
  }
  if(upcomingCount == 0)
  {
%>
          <tr class="zcs-tnodata">
            <td colspan="8" class="no-data-row zcs-font-14 zcs-font-normal zcs-lh-body">No upcoming trips are scheduled for the next 7 days.</td>
          </tr>
<%
  }
%>
        </tbody>
      </table>
    </div>
  </section>

  <section class="transport-section">
    <div class="zcs-row zcs-gap-16">
      <div class="zcs-col-6 zcs-col-lg-12 zcs-col-md-12 zcs-col-sm-12 zcs-col-xs-12">
        <div class="transport-section-title">
          <div>
            <h3>Fleet Availability</h3>
            <p>Vehicle Availability_Status summary</p>
          </div>
        </div>
        <div class="zcs-row zcs-gap-16">
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Available</span><span class="availability-count"><%=vehicleAvailable%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=vehicleAvailablePct%>%;background:#179E6C;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Assigned</span><span class="availability-count"><%=vehicleAssigned%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=vehicleAssignedPct%>%;background:#F4660C;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Maintenance</span><span class="availability-count"><%=vehicleMaintenance%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=vehicleMaintenancePct%>%;background:#FAAE13;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Inactive</span><span class="availability-count"><%=vehicleInactive%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=vehicleInactivePct%>%;background:#FE455D;"></div></div></div></div>
        </div>
      </div>

      <div class="zcs-col-6 zcs-col-lg-12 zcs-col-md-12 zcs-col-sm-12 zcs-col-xs-12">
        <div class="transport-section-title">
          <div>
            <h3>Driver Availability</h3>
            <p>Driver Availability_Status summary</p>
          </div>
        </div>
        <div class="zcs-row zcs-gap-16">
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Available</span><span class="availability-count"><%=driverAvailable%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=driverAvailablePct%>%;background:#179E6C;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Assigned</span><span class="availability-count"><%=driverAssigned%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=driverAssignedPct%>%;background:#F4660C;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">On Leave</span><span class="availability-count"><%=driverOnLeave%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=driverOnLeavePct%>%;background:#FAAE13;"></div></div></div></div>
          <div class="zcs-col-6 zcs-col-sm-12 zcs-col-xs-12"><div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border availability-card"><span class="availability-label">Inactive</span><span class="availability-count"><%=driverInactive%></span><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=driverInactivePct%>%;background:#FE455D;"></div></div></div></div>
        </div>
      </div>
    </div>
  </section>
</div>
