"Hiring_Manager"
{
    name        = "Hiring_Manager"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "Hiring managers who review openings, applications, interviews, and selection progress."

    ModulePermissions
    {
        Departments
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                Active_Departments={"View"}
            }
        }
        Job_Openings
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Job_Openings={"View"}
                Open_Job_Openings={"View"}
                Openings_By_Status={"View"}
            }
        }
        Applicants
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Applicants={"View"}
                Active_Applicants={"View"}
            }
        }
        Applications
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Applications={"View"}
                Application_Pipeline={"View"}
                Applications_For_Offer={"View"}
            }
        }
        Interviews
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Interviews={"View"}
                Interview_Calendar={"View"}
                Pending_Feedback={"View"}
            }
        }
        Employees
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Employees={"View"}
                Active_Employees={"View"}
            }
        }
        Offers
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Offered_CTC{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Offers={"View"}
                Accepted_Offers={"View"}
                Offer_Status_Board={"View"}
            }
        }
        Recruitment_Dashboard
        {
            enabled = tab
        }
    }
}