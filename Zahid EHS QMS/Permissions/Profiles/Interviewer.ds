"Interviewer"
{
    name        = "Interviewer"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Interviewers who view assigned recruitment records and submit interview feedback."

    ModulePermissions
    {
        Job_Openings
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Opening_ID{visibility:true,readonly:true}
                Job_Title{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Hiring_Manager_Name{visibility:true,readonly:true}
                Employment_Type{visibility:true,readonly:true}
                Work_Mode{visibility:true,readonly:true}
                Location{visibility:true,readonly:true}
                Positions{visibility:true,readonly:true}
                Target_Join_Date{visibility:true,readonly:true}
                Opening_Status{visibility:true,readonly:true}
                Salary_Min{visibility:false}
                Salary_Max{visibility:false}
                Minimum_Experience_Years{visibility:true,readonly:true}
                Job_Description{visibility:true,readonly:true}
                Required_Skills{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                Open_Job_Openings={"View"}
            }
        }
        Applicants
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Applicant_ID{visibility:true,readonly:true}
                Applicant_Name{visibility:true,readonly:true}
                Email{visibility:false}
                Phone{visibility:false}
                Current_Location{visibility:true,readonly:true}
                Source{visibility:false}
                Source_Details{visibility:false}
                Highest_Qualification{visibility:true,readonly:true}
                Total_Experience_Years{visibility:true,readonly:true}
                Current_Employer{visibility:true,readonly:true}
                Current_CTC{visibility:false}
                Expected_CTC{visibility:false}
                Notice_Period_Days{visibility:false}
                Skills{visibility:true,readonly:true}
                Resume{visibility:true,readonly:true}
                Candidate_Status{visibility:true,readonly:true}
                Notes{visibility:false}
            }
            ReportPermissions
            {
                Active_Applicants={"View"}
            }
        }
        Applications
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Application_ID{visibility:true,readonly:true}
                Applicant{visibility:true,readonly:true}
                Job_Opening{visibility:true,readonly:true}
                Application_Date{visibility:true,readonly:true}
                Application_Source{visibility:false}
                Application_Status{visibility:true,readonly:true}
                Screening_Notes{visibility:false}
                Latest_Interview_Round{visibility:true,readonly:true}
                Latest_Recommendation{visibility:true,readonly:true}
                Rejection_Reason{visibility:false}
                Withdrawal_Reason{visibility:false}
                Final_Decision_Date{visibility:false}
            }
            ReportPermissions
            {
                Application_Pipeline={"View"}
            }
        }
        Interviews
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Interviews={"View"}
                Interview_Calendar={"View"}
                Pending_Feedback={"View"}
            }
        }
    }
}