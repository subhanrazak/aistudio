"HR_Recruiter"
{
    name        = "HR_Recruiter"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false }
    description = "HR recruitment team members with full operational access to recruitment records."

    ModulePermissions
    {
        Departments
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Departments={"View","Edit","Delete"}
                Active_Departments={"View","Edit","Delete"}
            }
        }
        Job_Openings
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Job_Openings={"View","Edit","Delete"}
                Open_Job_Openings={"View","Edit","Delete"}
                Openings_By_Status={"View","Edit","Delete"}
            }
        }
        Applicants
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Applicants={"View","Edit","Delete"}
                Active_Applicants={"View","Edit","Delete"}
            }
        }
        Applications
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Applications={"View","Edit","Delete"}
                Application_Pipeline={"View","Edit","Delete"}
                Applications_For_Offer={"View","Edit","Delete"}
                Rejected_Withdrawn_Applications={"View","Edit","Delete"}
            }
        }
        Interviews
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Interviews={"View","Edit","Delete"}
                Interview_Calendar={"View","Edit","Delete"}
                Pending_Feedback={"View","Edit","Delete"}
            }
        }
        Employees
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Employees={"View","Edit","Delete"}
                Active_Employees={"View","Edit","Delete"}
            }
        }
        Offers
        {
            enabled          = Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Delete,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Offers={"View","Edit","Delete"}
                Accepted_Offers={"View","Edit","Delete"}
                Offer_Status_Board={"View","Edit","Delete"}
            }
        }
        Recruitment_Dashboard
        {
            enabled = tab
        }
    }
}