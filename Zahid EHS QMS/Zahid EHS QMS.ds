	menu
	{
	    space HR_Recruitment
	    {
	        displayname = "HR Recruitment"
	        icon = "users-multiple-11"
	
	        section Dashboard_Section
	        {
	            displayname = "Dashboard"
	            icon = "business-chart-bar-33"
	
	            page Recruitment_Dashboard
	            {
	                icon = "business-chart"
	            }
	        }
	
	        section Recruitment_Setup
	        {
	            displayname = "Recruitment Setup"
	            icon = "business-briefcase-25"
	
	            form Departments
	            {
	                icon = "business-hierarchy-53"
	            }
	            report All_Departments
	            {
	                icon = "business-hierarchy-55"
	            }
	            report Active_Departments
	            {
	                icon = "business-hierarchy-56"
	            }
	            form Job_Openings
	            {
	                icon = "business-briefcase-24"
	            }
	            report All_Job_Openings
	            {
	                icon = "business-board-30"
	            }
	            report Open_Job_Openings
	            {
	                icon = "business-goal-65"
	            }
	            report Openings_By_Status
	            {
	                icon = "business-progress"
	            }
	        }
	
	        section Applicants_Pipeline
	        {
	            displayname = "Applicants & Pipeline"
	            icon = "users-contacts"
	
	            form Applicants
	            {
	                icon = "users-add-27"
	            }
	            report All_Applicants
	            {
	                icon = "users-multiple-19"
	            }
	            report Active_Applicants
	            {
	                icon = "users-single-body"
	            }
	            form Applications
	            {
	                icon = "business-connect"
	            }
	            report All_Applications
	            {
	                icon = "business-notes"
	            }
	            report Application_Pipeline
	            {
	                icon = "business-hierarchy-54"
	            }
	            report Applications_For_Offer
	            {
	                icon = "business-signature"
	            }
	            report Rejected_Withdrawn_Applications
	            {
	                icon = "users-delete-30"
	            }
	        }
	
	        section Interviews_Section
	        {
	            displayname = "Interviews"
	            icon = "business-board-27"
	
	            form Interviews
	            {
	                icon = "business-board-28"
	            }
	            report Interview_Calendar
	            {
	                icon = "business-agenda"
	            }
	            report All_Interviews
	            {
	                icon = "business-board-29"
	            }
	            report Pending_Feedback
	            {
	                icon = "business-notes"
	            }
	        }
	
	        section Offers_Employees
	        {
	            displayname = "Offers & Employees"
	            icon = "business-handshake"
	
	            form Offers
	            {
	                icon = "business-signature"
	            }
	            report All_Offers
	            {
	                icon = "business-money-time"
	            }
	            report Accepted_Offers
	            {
	                icon = "business-handshake"
	            }
	            report Offer_Status_Board
	            {
	                icon = "business-progress"
	            }
	            form Employees
	            {
	                icon = "users-badge-13"
	            }
	            report All_Employees
	            {
	                icon = "users-multiple-11"
	            }
	            report Active_Employees
	            {
	                icon = "users-single-body"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-header { letter-spacing: .01em; }"
	    }
	}
	}
}
