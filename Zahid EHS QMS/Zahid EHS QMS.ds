application "Zahid-EHS-QMS"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Applicants
		{
		    displayname = "Applicants"
		    Candidate_Profile
		    (
		        type = section
		        displayname = "Candidate Profile"
		        row = 1
		        column = 0
		    )
		    Applicant_ID
		    (
		        type = autonumber
		        displayname = "Applicant ID"
		        start index = 10000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Applicant_Name
		    (
		        type = text
		        displayname = "Applicant Name"
		        maxchar = 150
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Email
		    (
		        type = email
		        displayname = "Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Current_Location
		    (
		        type = text
		        displayname = "Current Location"
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source_Details_Section
		    (
		        type = section
		        displayname = "Source Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Source
		    (
		        type = picklist
		        displayname = "Source"
		        values = {"Job Portal", "Referral", "LinkedIn", "Agency", "Campus", "Walk-in", "Other"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Source_Details
		    (
		        type = text
		        displayname = "Source Details"
		        maxchar = 150
		        row = 2
		        column = 2
		        width = medium
		    )
		    Highest_Qualification
		    (
		        type = text
		        displayname = "Highest Qualification"
		        maxchar = 150
		        row = 2
		        column = 1
		        width = medium
		    )
		    Total_Experience_Years
		    (
		        type = decimal
		        displayname = "Total Experience Years"
		        decimalplace = 1
		        row = 2
		        column = 2
		        width = medium
		    )
		    Current_Employer
		    (
		        type = text
		        displayname = "Current Employer"
		        maxchar = 150
		        row = 2
		        column = 1
		        width = medium
		    )
		    Compensation_Availability
		    (
		        type = section
		        displayname = "Compensation & Availability"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Current_CTC
		    (
		        type = decimal
		        displayname = "Current CTC"
		        decimalplace = 2
		        row = 3
		        column = 1
		        width = medium
		    )
		    Expected_CTC
		    (
		        type = decimal
		        displayname = "Expected CTC"
		        decimalplace = 2
		        row = 3
		        column = 2
		        width = medium
		    )
		    Notice_Period_Days
		    (
		        type = number
		        displayname = "Notice Period Days"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Skills
		    (
		        type = textarea
		        displayname = "Skills"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Resume
		    (
		        type = upload file
		        displayname = "Resume"
		        browse = local_drive, google_docs, zoho_docs
		        row = 3
		        column = 1
		        width = medium
		    )
		    Candidate_Status_Section
		    (
		        type = section
		        displayname = "Candidate Status"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    must have Candidate_Status
		    (
		        type = picklist
		        displayname = "Candidate Status"
		        values = {"Active", "Blacklisted", "Hired", "Archived"}
		        initial value = "Active"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 4
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Applications
		{
		    displayname = "Applications"
		    Application_Details
		    (
		        type = section
		        displayname = "Application Details"
		        row = 1
		        column = 0
		    )
		    Application_ID
		    (
		        type = autonumber
		        displayname = "Application ID"
		        start index = 50000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Applicant
		    (
		        type = picklist
		        displayname = "Applicant"
		        values = Applicants.ID
		        displayformat = [Applicant_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Job_Opening
		    (
		        type = picklist
		        displayname = "Job Opening"
		        values = Job_Openings.ID
		        displayformat = [Job_Title]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Application_Date
		    (
		        type = date
		        displayname = "Application Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Application_Source
		    (
		        type = picklist
		        displayname = "Application Source"
		        values = {"Direct", "Recruiter Added", "Referral", "Job Portal", "Agency", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Progress_Details
		    (
		        type = section
		        displayname = "Progress Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Application_Status
		    (
		        type = picklist
		        displayname = "Application Status"
		        values = {"Applied", "Screening", "Technical Interview", "HR Interview", "Offer", "Hired", "Rejected", "Withdrawn"}
		        initial value = "Applied"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Screening_Notes
		    (
		        type = textarea
		        displayname = "Screening Notes"
		        height = 120px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Latest_Interview_Round
		    (
		        type = picklist
		        displayname = "Latest Interview Round"
		        values = {"Screening", "Technical", "HR"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Latest_Recommendation
		    (
		        type = picklist
		        displayname = "Latest Recommendation"
		        values = {"Pending", "Advance", "Hold", "Reject", "Hire"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Decision_Details
		    (
		        type = section
		        displayname = "Decision Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Withdrawal_Reason
		    (
		        type = textarea
		        displayname = "Withdrawal Reason"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Final_Decision_Date
		    (
		        type = date
		        displayname = "Final Decision Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"Applied", "Screening", "Technical Interview", "HR Interview", "Offer", "Hired", "Rejected", "Withdrawn"}
		    }
		}

		form Departments
		{
		    displayname = "Departments"
		    Department_Details
		    (
		        type = section
		        displayname = "Department Details"
		        row = 1
		        column = 0
		    )
		    Department_ID
		    (
		        type = autonumber
		        displayname = "Department ID"
		        start index = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Department_Name
		    (
		        type = text
		        displayname = "Department Name"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Department_Head
		    (
		        type = text
		        displayname = "Department Head"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    Department_Email
		    (
		        type = email
		        displayname = "Department Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active", "Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Employees
		{
		    displayname = "Employees"
		    Employee_Profile
		    (
		        type = section
		        displayname = "Employee Profile"
		        row = 1
		        column = 0
		    )
		    Employee_ID
		    (
		        type = autonumber
		        displayname = "Employee ID"
		        start index = 20000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Employee_Name
		    (
		        type = text
		        displayname = "Employee Name"
		        maxchar = 150
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Work_Email
		    (
		        type = email
		        displayname = "Work Email"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Personal_Email
		    (
		        type = email
		        displayname = "Personal Email"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Employment_Details
		    (
		        type = section
		        displayname = "Employment Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = Departments.ID
		        displayformat = [Department_Name]
		        searchable = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Designation
		    (
		        type = text
		        displayname = "Designation"
		        maxchar = 150
		        row = 2
		        column = 2
		        width = medium
		    )
		    Employment_Type
		    (
		        type = picklist
		        displayname = "Employment Type"
		        values = {"Full-time", "Part-time", "Contract", "Internship"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Joining_Date
		    (
		        type = date
		        displayname = "Joining Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Employee_Status
		    (
		        type = picklist
		        displayname = "Employee Status"
		        values = {"Active", "Inactive", "Separated"}
		        initial value = "Active"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Source_Application
		    (
		        type = picklist
		        displayname = "Source Application"
		        values = Applications.ID
		        displayformat = [Application_ID]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Interviews
		{
		    displayname = "Interviews"
		    Interview_Schedule
		    (
		        type = section
		        displayname = "Interview Schedule"
		        row = 1
		        column = 0
		    )
		    Interview_ID
		    (
		        type = autonumber
		        displayname = "Interview ID"
		        start index = 70000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Application
		    (
		        type = picklist
		        displayname = "Application"
		        values = Applications.ID
		        displayformat = [Application_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Interview_Round
		    (
		        type = picklist
		        displayname = "Interview Round"
		        values = {"Screening", "Technical", "HR"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Interview_Title
		    (
		        type = text
		        displayname = "Interview Title"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Interview_Mode
		    (
		        type = picklist
		        displayname = "Interview Mode"
		        values = {"Phone", "Video", "In-person"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Interview_Start
		    (
		        type = datetime
		        displayname = "Interview Start"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Interview_End
		    (
		        type = datetime
		        displayname = "Interview End"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Interviewer_Details
		    (
		        type = section
		        displayname = "Interviewer Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Interviewer_Name
		    (
		        type = text
		        displayname = "Interviewer Name"
		        maxchar = 100
		        row = 2
		        column = 1
		        width = medium
		    )
		    Interviewer_Email
		    (
		        type = email
		        displayname = "Interviewer Email"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Feedback_Details
		    (
		        type = section
		        displayname = "Feedback Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Interview_Status
		    (
		        type = picklist
		        displayname = "Interview Status"
		        values = {"Scheduled", "Completed", "Cancelled", "No Show", "Rescheduled"}
		        initial value = "Scheduled"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Rating
		    (
		        type = number
		        displayname = "Rating"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Recommendation
		    (
		        type = picklist
		        displayname = "Recommendation"
		        values = {"Pending", "Advance", "Hold", "Reject", "Hire"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    Feedback
		    (
		        type = textarea
		        displayname = "Feedback"
		        height = 150px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Next_Steps
		    (
		        type = textarea
		        displayname = "Next Steps"
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Job_Openings
		{
		    displayname = "Job Openings"
		    Role_Details
		    (
		        type = section
		        displayname = "Role Details"
		        row = 1
		        column = 0
		    )
		    Opening_ID
		    (
		        type = autonumber
		        displayname = "Opening ID"
		        start index = 1000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Job_Title
		    (
		        type = text
		        displayname = "Job Title"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = Departments[Status == "Active"].ID
		        displayformat = [Department_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Hiring_Manager_Name
		    (
		        type = text
		        displayname = "Hiring Manager Name"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Hiring_Manager_Email
		    (
		        type = email
		        displayname = "Hiring Manager Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Employment_Type
		    (
		        type = picklist
		        displayname = "Employment Type"
		        values = {"Full-time", "Part-time", "Contract", "Internship"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Work_Mode
		    (
		        type = picklist
		        displayname = "Work Mode"
		        values = {"On-site", "Hybrid", "Remote"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Location
		    (
		        type = text
		        displayname = "Location"
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Positions
		    (
		        type = number
		        displayname = "Positions"
		        initial value = 1
		        row = 1
		        column = 2
		        width = medium
		    )
		    Target_Join_Date
		    (
		        type = date
		        displayname = "Target Join Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Compensation_Details
		    (
		        type = section
		        displayname = "Compensation Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Minimum_Experience_Years
		    (
		        type = decimal
		        displayname = "Minimum Experience Years"
		        decimalplace = 1
		        row = 2
		        column = 1
		        width = medium
		    )
		    Salary_Min
		    (
		        type = decimal
		        displayname = "Salary Min"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Salary_Max
		    (
		        type = decimal
		        displayname = "Salary Max"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Description_Status
		    (
		        type = section
		        displayname = "Description & Status"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    must have Opening_Status
		    (
		        type = picklist
		        displayname = "Opening Status"
		        values = {"Draft", "Open", "On Hold", "Filled", "Closed"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Date_Opened
		    (
		        type = date
		        displayname = "Date Opened"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Date_Closed
		    (
		        type = date
		        displayname = "Date Closed"
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Job_Description
		    (
		        type = textarea
		        displayname = "Job Description"
		        height = 150px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Required_Skills
		    (
		        type = textarea
		        displayname = "Required Skills"
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Offers
		{
		    displayname = "Offers"
		    Offer_Details
		    (
		        type = section
		        displayname = "Offer Details"
		        row = 1
		        column = 0
		    )
		    Offer_ID
		    (
		        type = autonumber
		        displayname = "Offer ID"
		        start index = 90000
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Application
		    (
		        type = picklist
		        displayname = "Application"
		        values = Applications.ID
		        displayformat = [Application_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Offer_Date
		    (
		        type = date
		        displayname = "Offer Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Offered_Designation
		    (
		        type = text
		        displayname = "Offered Designation"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Offered_Department
		    (
		        type = picklist
		        displayname = "Offered Department"
		        values = Departments.ID
		        displayformat = [Department_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Offer_Terms
		    (
		        type = section
		        displayname = "Offer Terms"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Offered_CTC
		    (
		        type = decimal
		        displayname = "Offered CTC"
		        decimalplace = 2
		        row = 2
		        column = 1
		        width = medium
		    )
		    Expected_Joining_Date
		    (
		        type = date
		        displayname = "Expected Joining Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Offer_Status
		    (
		        type = picklist
		        displayname = "Offer Status"
		        values = {"Draft", "Sent", "Accepted", "Declined", "Withdrawn"}
		        initial value = "Draft"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Acceptance_Date
		    (
		        type = date
		        displayname = "Acceptance Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 120px
		        row = 2
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		list Active_Applicants
		{
		    displayName = "Active Applicants"
		    show all rows from Applicants [Candidate_Status == "Active"]
		    (
		        Applicant_Name
		        Email
		        Phone
		        Source
		        Total_Experience_Years
		        Skills
		    )
		    filters
		    (
		        Source
		    )
		    sort by
		    (
		        Applicant_Name ascending
		    )
		}

		default list All_Applicants
		{
		    displayName = "All Applicants"
		    show all rows from Applicants
		    (
		        Applicant_ID
		        Applicant_Name
		        Email
		        Phone
		        Current_Location
		        Source
		        Total_Experience_Years
		        Candidate_Status
		    )
		    filters
		    (
		        Candidate_Status
		        Source
		    )
		    sort by
		    (
		        Applicant_ID descending
		    )
		}

		default list All_Applications
		{
		    displayName = "All Applications"
		    show all rows from Applications
		    (
		        Application_ID
		        Applicant
		        Job_Opening
		        Application_Date
		        Application_Status
		        Latest_Interview_Round
		        Latest_Recommendation
		        Final_Decision_Date
		    )
		    filters
		    (
		        Application_Status
		        Job_Opening
		        Latest_Recommendation
		    )
		    sort by
		    (
		        Application_ID descending
		    )
		}

		kanban Application_Pipeline
		{
		    displayName = "Application Pipeline"
		    show all rows from Applications
		    (
		        Applicant
		        Job_Opening
		        Application_Date
		        Application_Status
		        Latest_Interview_Round
		        Latest_Recommendation
		    )
		    filters
		    (
		        Job_Opening
		    )
		    sort by
		    (
		        Application_Date ascending
		    )
		    options
		    (
		        display field = Application_Status
		        othercolumn = "Other"
		        sort order = ascending
		        record count = enable
		    )
		}

		list Applications_For_Offer
		{
		    displayName = "Applications For Offer"
		    show all rows from Applications [Application_Status == "Offer"]
		    (
		        Application_ID
		        Applicant
		        Job_Opening
		        Latest_Recommendation
		        Final_Decision_Date
		    )
		    sort by
		    (
		        Final_Decision_Date descending
		    )
		}

		list Rejected_Withdrawn_Applications
		{
		    displayName = "Rejected & Withdrawn Applications"
		    show all rows from Applications [Application_Status == "Rejected" || Application_Status == "Withdrawn"]
		    (
		        Application_ID
		        Applicant
		        Job_Opening
		        Application_Status
		        Rejection_Reason
		        Withdrawal_Reason
		        Final_Decision_Date
		    )
		    sort by
		    (
		        Final_Decision_Date descending
		    )
		}

		list Active_Departments
		{
		    displayName = "Active Departments"
		    show all rows from Departments [Status == "Active"]
		    (
		        Department_Name
		        Department_Head
		        Department_Email
		    )
		    sort by
		    (
		        Department_Name ascending
		    )
		}

		default list All_Departments
		{
		    displayName = "All Departments"
		    show all rows from Departments
		    (
		        Department_ID
		        Department_Name
		        Department_Head
		        Department_Email
		        Status
		    )
		    filters
		    (
		        Status
		    )
		    sort by
		    (
		        Department_Name ascending
		    )
		}

		list Active_Employees
		{
		    displayName = "Active Employees"
		    show all rows from Employees [Employee_Status == "Active"]
		    (
		        Employee_ID
		        Employee_Name
		        Work_Email
		        Department
		        Designation
		        Joining_Date
		    )
		    filters
		    (
		        Department
		    )
		    sort by
		    (
		        Employee_Name ascending
		    )
		}

		default list All_Employees
		{
		    displayName = "All Employees"
		    show all rows from Employees
		    (
		        Employee_ID
		        Employee_Name
		        Work_Email
		        Department
		        Designation
		        Employment_Type
		        Joining_Date
		        Employee_Status
		        Source_Application
		    )
		    filters
		    (
		        Department
		        Employee_Status
		        Employment_Type
		    )
		    sort by
		    (
		        Employee_ID descending
		    )
		}

		default list All_Interviews
		{
		    displayName = "All Interviews"
		    show all rows from Interviews
		    (
		        Interview_ID
		        Application
		        Interview_Round
		        Interview_Mode
		        Interview_Start
		        Interview_End
		        Interviewer_Name
		        Interview_Status
		        Rating
		        Recommendation
		    )
		    filters
		    (
		        Interview_Round
		        Interview_Status
		        Recommendation
		        Interviewer_Name
		    )
		    sort by
		    (
		        Interview_Start descending
		    )
		}

		calendar Interview_Calendar
		{
		    displayName = "Interview Calendar"
		    show all rows from Interviews
		    (
		        Interview_Title
		        Application
		        Interview_Round
		        Interview_Mode
		        Interview_Start
		        Interview_End
		        Interviewer_Name
		        Interview_Status
		    )
		    filters
		    (
		        Interview_Round
		        Interview_Status
		        Interviewer_Name
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Interview_Title
		        start date = Interview_Start
		        end date = Interview_End
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list Pending_Feedback
		{
		    displayName = "Pending Feedback"
		    show all rows from Interviews [Interview_Status == "Scheduled" || (Interview_Status == "Completed" && Recommendation is null)]
		    (
		        Interview_ID
		        Application
		        Interview_Round
		        Interview_Start
		        Interviewer_Name
		        Interview_Status
		        Recommendation
		    )
		    sort by
		    (
		        Interview_Start ascending
		    )
		}

		default list All_Job_Openings
		{
		    displayName = "All Job Openings"
		    show all rows from Job_Openings
		    (
		        Opening_ID
		        Job_Title
		        Department
		        Hiring_Manager_Name
		        Employment_Type
		        Work_Mode
		        Location
		        Positions
		        Opening_Status
		        Target_Join_Date
		    )
		    filters
		    (
		        Department
		        Opening_Status
		        Employment_Type
		        Work_Mode
		    )
		    sort by
		    (
		        Opening_ID descending
		    )
		}

		list Open_Job_Openings
		{
		    displayName = "Open Job Openings"
		    show all rows from Job_Openings [Opening_Status == "Open"]
		    (
		        Opening_ID
		        Job_Title
		        Department
		        Hiring_Manager_Name
		        Employment_Type
		        Work_Mode
		        Positions
		        Location
		        Target_Join_Date
		    )
		    filters
		    (
		        Department
		        Employment_Type
		        Work_Mode
		    )
		    sort by
		    (
		        Target_Join_Date ascending
		    )
		}

		kanban Openings_By_Status
		{
		    displayName = "Openings By Status"
		    show all rows from Job_Openings
		    (
		        Job_Title
		        Department
		        Hiring_Manager_Name
		        Positions
		        Target_Join_Date
		        Opening_Status
		    )
		    sort by
		    (
		        Target_Join_Date ascending
		    )
		    options
		    (
		        display field = Opening_Status
		        othercolumn = "Other"
		        sort order = ascending
		        record count = enable
		    )
		}

		list Accepted_Offers
		{
		    displayName = "Accepted Offers"
		    show all rows from Offers [Offer_Status == "Accepted"]
		    (
		        Offer_ID
		        Application
		        Offered_Designation
		        Offered_Department
		        Expected_Joining_Date
		        Acceptance_Date
		    )
		    sort by
		    (
		        Acceptance_Date descending
		    )
		}

		default list All_Offers
		{
		    displayName = "All Offers"
		    show all rows from Offers
		    (
		        Offer_ID
		        Application
		        Offer_Date
		        Offered_Designation
		        Offered_Department
		        Offered_CTC
		        Expected_Joining_Date
		        Offer_Status
		        Acceptance_Date
		    )
		    filters
		    (
		        Offer_Status
		        Offered_Department
		    )
		    sort by
		    (
		        Offer_ID descending
		    )
		}

		kanban Offer_Status_Board
		{
		    displayName = "Offer Status Board"
		    show all rows from Offers
		    (
		        Application
		        Offered_Designation
		        Offered_Department
		        Expected_Joining_Date
		        Offer_Status
		    )
		    sort by
		    (
		        Expected_Joining_Date ascending
		    )
		    options
		    (
		        display field = Offer_Status
		        othercolumn = "Other"
		        sort order = ascending
		        record count = enable
		    )
		}
	}

	pages
	{
		page Recruitment_Dashboard
		{
					displayname = "Recruitment Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Recruitment_Dashboard_Main' elementName='Recruitment_Dashboard_Main'>\n\t\t\t\t\t<![CDATA[htmlpage Recruitment_Dashboard_Main()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ncurrentStamp = zoho.currenttime.toString(&quot;dd-MMM-yyyy hh:mm a&quot;);\nweekEnd = zoho.currenttime.addDay(7);\nopenOpenings = Job_Openings[Opening_Status == &quot;Open&quot;].count();\nactiveApplicants = Applicants[Candidate_Status == &quot;Active&quot;].count();\nscheduledThisWeek = Interviews[Interview_Status == &quot;Scheduled&quot; &amp;&amp; Interview_Start &gt;= zoho.currenttime &amp;&amp; Interview_Start &lt;= weekEnd].count();\npendingFeedback = Interviews[Interview_Status == &quot;Scheduled&quot; || (Interview_Status == &quot;Completed&quot; &amp;&amp; Recommendation is null)].count();\noffersAccepted = Offers[Offer_Status == &quot;Accepted&quot;].count();\nhiresCreated = Employees[Source_Application != null].count();\nappliedCount = Applications[Application_Status == &quot;Applied&quot;].count();\nscreeningCount = Applications[Application_Status == &quot;Screening&quot;].count();\ntechnicalCount = Applications[Application_Status == &quot;Technical Interview&quot;].count();\nhrCount = Applications[Application_Status == &quot;HR Interview&quot;].count();\nofferStageCount = Applications[Application_Status == &quot;Offer&quot;].count();\nhiredStageCount = Applications[Application_Status == &quot;Hired&quot;].count();\nrejectedCount = Applications[Application_Status == &quot;Rejected&quot;].count();\nwithdrawnCount = Applications[Application_Status == &quot;Withdrawn&quot;].count();\ntotalPipeline = appliedCount + screeningCount + technicalCount + hrCount + offerStageCount + hiredStageCount + rejectedCount + withdrawnCount;\nmaxStage = 1;\nif(appliedCount &gt; maxStage)\n{\n\tmaxStage = appliedCount;\n}\nif(screeningCount &gt; maxStage)\n{\n\tmaxStage = screeningCount;\n}\nif(technicalCount &gt; maxStage)\n{\n\tmaxStage = technicalCount;\n}\nif(hrCount &gt; maxStage)\n{\n\tmaxStage = hrCount;\n}\nif(offerStageCount &gt; maxStage)\n{\n\tmaxStage = offerStageCount;\n}\nif(hiredStageCount &gt; maxStage)\n{\n\tmaxStage = hiredStageCount;\n}\nif(rejectedCount &gt; maxStage)\n{\n\tmaxStage = rejectedCount;\n}\nif(withdrawnCount &gt; maxStage)\n{\n\tmaxStage = withdrawnCount;\n}\nappliedPct = (appliedCount * 100) / maxStage;\nscreeningPct = (screeningCount * 100) / maxStage;\ntechnicalPct = (technicalCount * 100) / maxStage;\nhrPct = (hrCount * 100) / maxStage;\nofferStagePct = (offerStageCount * 100) / maxStage;\nhiredStagePct = (hiredStageCount * 100) / maxStage;\nrejectedPct = (rejectedCount * 100) / maxStage;\nwithdrawnPct = (withdrawnCount * 100) / maxStage;\nofferDraftCount = Offers[Offer_Status == &quot;Draft&quot;].count();\nofferSentCount = Offers[Offer_Status == &quot;Sent&quot;].count();\nofferAcceptedCount = Offers[Offer_Status == &quot;Accepted&quot;].count();\nofferDeclinedCount = Offers[Offer_Status == &quot;Declined&quot;].count();\nofferWithdrawnCount = Offers[Offer_Status == &quot;Withdrawn&quot;].count();\nmaxOffer = 1;\nif(offerDraftCount &gt; maxOffer)\n{\n\tmaxOffer = offerDraftCount;\n}\nif(offerSentCount &gt; maxOffer)\n{\n\tmaxOffer = offerSentCount;\n}\nif(offerAcceptedCount &gt; maxOffer)\n{\n\tmaxOffer = offerAcceptedCount;\n}\nif(offerDeclinedCount &gt; maxOffer)\n{\n\tmaxOffer = offerDeclinedCount;\n}\nif(offerWithdrawnCount &gt; maxOffer)\n{\n\tmaxOffer = offerWithdrawnCount;\n}\nofferDraftPct = (offerDraftCount * 100) / maxOffer;\nofferSentPct = (offerSentCount * 100) / maxOffer;\nofferAcceptedPct = (offerAcceptedCount * 100) / maxOffer;\nofferDeclinedPct = (offerDeclinedCount * 100) / maxOffer;\nofferWithdrawnPct = (offerWithdrawnCount * 100) / maxOffer;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css utility subset included once for this page after fetching zcs-global ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #5F6199); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-white-color: #FFFFFF; --zcs-page-bg-color: #F3F3F4; --zcs-component-hover-color: var(--zcs_component_hover_color, #F4F7FF); font-size: 16px; line-height: 1.5; }\n.zcs-w-full{width:100%;}.zcs-h-full{height:100%;}.zcs-wh-full{width:100%;height:100%;}.zcs-flex{display:flex;}.zcs-inline-flex{display:inline-flex;}.zcs-row{display:flex;flex-wrap:wrap;}.zcs-direction-column{flex-direction:column;}.zcs-align-items-center{align-items:center;}.zcs-align-items-start{align-items:flex-start;}.zcs-align-items-end{align-items:flex-end;}.zcs-justify-center{justify-content:center;}.zcs-justify-space-between{justify-content:space-between;}.zcs-justify-start{justify-content:flex-start;}.zcs-col-common{flex:1 1 0%;}.zcs-gap-4{gap:.25rem;}.zcs-gap-8{gap:.5rem;}.zcs-gap-10{gap:.625rem;}.zcs-gap-12{gap:.75rem;}.zcs-gap-16{gap:1rem;}.zcs-gap-20{gap:1.25rem;}.zcs-p-0{padding:0;}.zcs-p-2{padding:.125rem;}.zcs-p-8{padding:.5rem;}.zcs-p-10{padding:.625rem;}.zcs-p-12{padding:.75rem;}.zcs-p-16{padding:1rem;}.zcs-p-20{padding:1.25rem;}.zcs-p-24{padding:1.5rem;}.zcs-px-10{padding-left:.625rem;padding-right:.625rem;}.zcs-px-16{padding-left:1rem;padding-right:1rem;}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem;}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem;}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem;}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem;}.zcs-py-4{padding-top:.25rem;padding-bottom:.25rem;}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem;}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem;}.zcs-py-16{padding-top:1rem;padding-bottom:1rem;}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem;}.zcs-m-0{margin:0;}.zcs-mt-8{margin-top:.5rem;}.zcs-box-border{box-sizing:border-box;}.zcs-rounded-sm{border-radius:.25rem;}.zcs-rounded-md{border-radius:.375rem;}.zcs-rounded-lg{border-radius:.5rem;}.zcs-rounded-xl{border-radius:.75rem;}.zcs-font-11{font-size:.6875rem;}.zcs-font-12{font-size:.75rem;}.zcs-font-13{font-size:.8125rem;}.zcs-font-14{font-size:.875rem;}.zcs-font-15{font-size:.9375rem;}.zcs-font-16{font-size:1rem;}.zcs-font-18{font-size:1.125rem;}.zcs-font-20{font-size:1.25rem;}.zcs-font-22{font-size:1.375rem;}.zcs-font-28{font-size:1.75rem;}.zcs-font-30{font-size:1.875rem;}.zcs-font-normal{font-weight:400;}.zcs-font-medium{font-weight:500;}.zcs-font-semibold{font-weight:600;}.zcs-font-bold{font-weight:700;}.zcs-lh-body{line-height:1.5;}.zcs-lh-heading{line-height:1.25;}.zcs-color-primary{color:var(--zcs-primary-text-color);}.zcs-color-secondary{color:var(--zcs-secondary-text-color);}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color);}.zcs-color-white{color:var(--zcs-white-color);}.zcs-color-theme{color:var(--zcs-theme-brand-color);}.zcs-text-left{text-align:left;}.zcs-text-right{text-align:right;}.zcs-text-center{text-align:center;}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.zcs-relative{position:relative;}.zcs-absolute{position:absolute;}.zcs-sticky{position:sticky;}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px;}a{text-decoration:none;color:inherit;}\n/* ===== ZCS component CSS: card-template-default, table-simple-table, badge-filled-badge, header-heading-with-actions, chart-bar-chart ===== */\n.zcs-card-header{border-bottom:1px solid var(--zcs-border-color);}.zcs-template-card-badge{top:0;right:0;background-color:var(--zcs-theme-brand-color);border-bottom-left-radius:32px;}.zcs-template-card{overflow:hidden;}.zcs-button{width:auto;min-width:5rem;min-height:36px;}.zcs-primary-outline-button{border:1px solid var(--zcs-theme-brand-color);background-color:var(--zcs-white-color);color:var(--zcs-theme-brand-color);}.zcs-primary-outline-button:hover{background-color:var(--zcs-component-hover-color);border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color);} .zcs-button-icon{width:16px;max-height:16px;}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background-color:var(--zcs-white-color);overflow:auto;}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse;}.zcs-table-wrapper table thead{top:0;z-index:1;}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap;}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color);}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent;}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE;}.zcs-table-wrapper table tbody tr.zcs-tnodata td{color:var(--zcs-teritiary-text-color);text-align:center;}.zcs-badge{width:auto;}.zcs-badge-filled{border:1px solid transparent;}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs-theme-brand-color);border-color:var(--zcs-theme-brand-color);color:var(--zcs-white-color);}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#FFFFFF;}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#FFFFFF;}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#FFFFFF;}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#FFFFFF;}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#FFFFFF;}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#FFFFFF;}.zcs-chart ul li{list-style-type:none;}.zcs-bar-value{border-radius:999px;background-color:var(--zcs-theme-brand-color);display:block;min-width:3px;}\n/* ===== Recruitment dashboard custom layer ===== */\n.rdash *{box-sizing:border-box;}.rdash{min-height:100%;background:linear-gradient(180deg,#F8FAFF 0%,#F3F3F4 100%);padding:22px;font-family:Arial, sans-serif;color:var(--zcs-primary-text-color);}.rdash-hero{position:relative;overflow:hidden;border-radius:20px;padding:26px;background:linear-gradient(135deg,var(--zcs-theme-brand-color) 0%,#1C1C40 100%);color:#FFFFFF;box-shadow:0 12px 34px rgba(28,28,64,.18);}.rdash-hero:after{content:&quot;&quot;;position:absolute;right:-80px;top:-120px;width:340px;height:340px;border-radius:50%;border:52px solid rgba(255,255,255,.12);}.rdash-hero:before{content:&quot;&quot;;position:absolute;right:90px;bottom:-90px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.08);}.rdash-hero-content{position:relative;z-index:1;gap:18px;}.rdash-title{font-size:30px;font-weight:700;line-height:1.15;margin:0 0 8px;}.rdash-subtitle{margin:0;color:rgba(255,255,255,.82);font-size:14px;max-width:680px;}.rdash-actions{flex-wrap:wrap;}.rdash-action{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);color:#FFFFFF;border-radius:10px;padding:9px 12px;font-size:13px;display:inline-flex;gap:8px;align-items:center;}.rdash-action:hover{background:rgba(255,255,255,.22);}.rdash-stamp{margin-top:14px;color:rgba(255,255,255,.72);font-size:12px;}.rdash-grid{display:grid;gap:16px;}.rdash-kpi-grid{grid-template-columns:repeat(6,minmax(0,1fr));margin-top:18px;}.rdash-kpi{min-height:150px;color:inherit;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;}.rdash-kpi:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(28,28,64,.08);border-color:rgba(42,111,252,.35);}.rdash-kpi .zcs-card-header{min-height:62px;}.rdash-kpi-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);display:flex;align-items:center;justify-content:center;font-size:20px;flex:0 0 auto;}.rdash-kpi-value{font-size:32px;font-weight:700;line-height:1;margin:0 0 8px;}.rdash-kpi-note{font-size:12px;color:var(--zcs-teritiary-text-color);margin:0;}.rdash-main-grid{grid-template-columns:minmax(0,1.35fr) minmax(360px,.65fr);margin-top:16px;align-items:start;}.rdash-section-card{overflow:hidden;box-shadow:0 1px 2px rgba(28,28,64,.03);}.rdash-section-title{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px;margin:0;}.rdash-section-title i{color:var(--zcs-theme-brand-color);font-size:18px;}.rdash-section-meta{font-size:12px;color:var(--zcs-teritiary-text-color);}.rdash-pipeline-list,.rdash-offer-list,.rdash-hire-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}.rdash-bar-row{display:grid;grid-template-columns:150px minmax(0,1fr) 42px;gap:12px;align-items:center;}.rdash-bar-label{font-size:13px;font-weight:600;color:var(--zcs-secondary-text-color);white-space:nowrap;}.rdash-bar-track{height:10px;background:#EEF1F7;border-radius:999px;overflow:hidden;}.rdash-bar-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--zcs-theme-brand-color),#77A3FF);}.rdash-bar-count{text-align:right;font-size:13px;font-weight:700;color:var(--zcs-primary-text-color);}.rdash-table-card{margin-top:16px;}.rdash-table-wrapper{max-height:360px;}.rdash-table-wrapper table{min-width:760px;}.rdash-table-link{color:var(--zcs-theme-brand-color);font-weight:600;}.rdash-muted{color:var(--zcs-teritiary-text-color);font-size:12px;}.rdash-open-grid{grid-template-columns:minmax(0,1fr) minmax(330px,.55fr);margin-top:16px;align-items:start;}.rdash-hire-item{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:12px;border:1px solid var(--zcs-border-color);border-radius:10px;background:#FFFFFF;}.rdash-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-weight:700;flex:0 0 auto;}.rdash-empty{padding:22px;text-align:center;color:var(--zcs-teritiary-text-color);}.rdash-empty i{display:block;font-size:24px;color:var(--zcs-theme-brand-color);margin-bottom:8px;}.rdash-stage-dot{width:8px;height:8px;border-radius:50%;background:var(--zcs-theme-brand-color);display:inline-block;}.rdash-badge-soft{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color);font-weight:600;font-size:12px;}\n@media (max-width:1280px){.rdash-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr));}.rdash-main-grid,.rdash-open-grid{grid-template-columns:1fr;}}\n@media (max-width:760px){.rdash{padding:14px;}.rdash-hero{padding:20px;}.rdash-hero-content{flex-direction:column;align-items:flex-start;}.rdash-title{font-size:24px;}.rdash-kpi-grid{grid-template-columns:1fr;}.rdash-bar-row{grid-template-columns:1fr;gap:6px;}.rdash-bar-count{text-align:left;}.rdash-page-header{padding-left:0;padding-right:0;}.rdash-actions{width:100%;}.rdash-action{width:100%;justify-content:center;}}\n&lt;/style&gt;\n&lt;div class=&quot;rdash&quot;&gt;\n\t\t&lt;div class=&quot;rdash-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rdash-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-badge-soft&quot; style=&quot;background:rgba(255,255,255,.16);color:#FFFFFF;&quot;&gt;&lt;i class=&quot;zc-li-outline users-2-single-01&quot;&gt;&lt;/i&gt;&lt;span&gt;HR recruitment command center&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;rdash-title&quot;&gt;Recruitment Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-subtitle&quot;&gt;Monitor open roles, applicant flow, interviews, offers, and hires from one responsive view.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-stamp&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Refreshed &lt;%=currentStamp%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rdash-actions zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-action&quot; href=&quot;#Report:Open_Job_Openings&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span&gt;Open openings&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-action&quot; href=&quot;#Report:Application_Pipeline&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;span&gt;Pipeline&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-action&quot; href=&quot;#Report:Interview_Calendar&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;span&gt;Calendar&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-action&quot; href=&quot;#Report:Offer_Status_Board&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;span&gt;Offers&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;rdash-grid rdash-kpi-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:Open_Job_Openings&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Open openings&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=openOpenings%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Roles currently accepting candidates&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:Active_Applicants&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Active applicants&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-3-single-body&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=activeApplicants%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Candidates available in the pool&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:Interview_Calendar&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Scheduled this week&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=scheduledThisWeek%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Interviews from now through 7 days&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:Pending_Feedback&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending feedback&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-check&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=pendingFeedback%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Scheduled or awaiting recommendation&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:Accepted_Offers&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Offers accepted&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=offersAccepted%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Accepted offers ready for conversion&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-template-card rdash-kpi zcs-card zcs-flex zcs-direction-column zcs-relative&quot; href=&quot;#Report:All_Employees&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-14 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Hires created&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-2-a-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-value&quot;&gt;&lt;%=hiresCreated%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;rdash-kpi-note&quot;&gt;Employee records linked to applications&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;rdash-grid rdash-main-grid&quot;&gt;\n\t\t\t\t&lt;section class=&quot;rdash-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;rdash-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;span&gt;Pipeline summary&lt;/span&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;rdash-section-meta&quot;&gt;&lt;%=totalPipeline%&gt; total applications&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-chart zcs-w-full zcs-barchart-wrapper zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;rdash-pipeline-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Applied&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=appliedPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=appliedCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Screening&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=screeningPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=screeningCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Technical Interview&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=technicalPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=technicalCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; HR Interview&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=hrPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=hrCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Offer&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerStagePct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerStageCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Hired&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=hiredStagePct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=hiredStageCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Rejected&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=rejectedPct%&gt;%;background:linear-gradient(90deg,#FE455D,#FF9AA8);&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=rejectedCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;&lt;span class=&quot;rdash-stage-dot&quot;&gt;&lt;/span&gt; Withdrawn&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=withdrawnPct%&gt;%;background:linear-gradient(90deg,#878895,#C2C4D1);&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=withdrawnCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;rdash-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;rdash-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline business-handout&quot;&gt;&lt;/i&gt;&lt;span&gt;Offer conversion&lt;/span&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-section-meta&quot; href=&quot;#Report:All_Offers&quot;&gt;All offers&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;rdash-offer-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;Draft&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerDraftPct%&gt;%;background:#878895;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerDraftCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;Sent&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerSentPct%&gt;%;background:#2A6FFC;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerSentCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;Accepted&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerAcceptedPct%&gt;%;background:#179E6C;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerAcceptedCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;Declined&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerDeclinedPct%&gt;%;background:#FE455D;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerDeclinedCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-bar-row&quot;&gt;&lt;span class=&quot;rdash-bar-label&quot;&gt;Withdrawn&lt;/span&gt;&lt;span class=&quot;rdash-bar-track&quot;&gt;&lt;span class=&quot;zcs-bar-value rdash-bar-fill&quot; style=&quot;width:&lt;%=offerWithdrawnPct%&gt;%;background:#FAAE13;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;rdash-bar-count&quot;&gt;&lt;%=offerWithdrawnCount%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;rdash-section-card rdash-table-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;rdash-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;span&gt;Upcoming interviews&lt;/span&gt;&lt;/h2&gt;\n\t\t\t\t\t\t&lt;span class=&quot;rdash-section-meta&quot;&gt;Next 7 days&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper rdash-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Applicant / application&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Opening&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Round&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Interviewer&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Mode&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Date / time&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\ninterviewRows = 0;\nfor each interviewRec in Interviews[Interview_Status == &quot;Scheduled&quot; &amp;&amp; Interview_Start &gt;= zoho.currenttime &amp;&amp; Interview_Start &lt;= weekEnd] sort by Interview_Start asc\n{\n\tif(interviewRows &lt; 8)\n\t{\n\t\tapplicationText = &quot;-&quot;;\n\t\tapplicantText = &quot;-&quot;;\n\t\topeningText = &quot;-&quot;;\n\t\tif(interviewRec.Application != null)\n\t\t{\n\t\t\tapplicationText = ifnull(interviewRec.Application.Application_ID,&quot;-&quot;);\n\t\t\tif(interviewRec.Application.Applicant != null)\n\t\t\t{\n\t\t\t\tapplicantText = ifnull(interviewRec.Application.Applicant.Applicant_Name,&quot;-&quot;);\n\t\t\t}\n\t\t\tif(interviewRec.Application.Job_Opening != null)\n\t\t\t{\n\t\t\t\topeningText = ifnull(interviewRec.Application.Job_Opening.Job_Title,&quot;-&quot;);\n\t\t\t}\n\t\t}\n\t\tinterviewWhen = &quot;-&quot;;\n\t\tif(interviewRec.Interview_Start != null)\n\t\t{\n\t\t\tinterviewWhen = interviewRec.Interview_Start.toString(&quot;dd-MMM-yyyy hh:mm a&quot;);\n\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;a class=&quot;rdash-table-link&quot; href=&quot;#Report:All_Interviews?ID=&lt;%=interviewRec.ID%&gt;&quot;&gt;&lt;%=applicantText%&gt;&lt;/a&gt;&lt;div class=&quot;rdash-muted&quot;&gt;Application &lt;%=applicationText%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=openingText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ifnull(interviewRec.Interview_Round,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(interviewRec.Interviewer_Name,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(interviewRec.Interview_Mode,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=interviewWhen%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\tinterviewRows = interviewRows + 1;\n\t}\n}\nif(interviewRows == 0)\n{\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-font-14&quot; colspan=&quot;6&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; No scheduled interviews in the next 7 days.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;rdash-grid rdash-open-grid&quot;&gt;\n\t\t\t\t&lt;section class=&quot;rdash-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;rdash-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span&gt;Open openings summary&lt;/span&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-section-meta&quot; href=&quot;#Report:Open_Job_Openings&quot;&gt;View report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper rdash-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Role&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Department&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Positions&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Hiring manager&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Target joining&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\nopeningRows = 0;\nfor each openingRec in Job_Openings[Opening_Status == &quot;Open&quot;] sort by Target_Join_Date asc\n{\n\tif(openingRows &lt; 8)\n\t{\n\t\tdepartmentText = &quot;-&quot;;\n\t\tif(openingRec.Department != null)\n\t\t{\n\t\t\tdepartmentText = ifnull(openingRec.Department.Department_Name,&quot;-&quot;);\n\t\t}\n\t\ttargetJoinText = &quot;-&quot;;\n\t\tif(openingRec.Target_Join_Date != null)\n\t\t{\n\t\t\ttargetJoinText = openingRec.Target_Join_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;a class=&quot;rdash-table-link&quot; href=&quot;#Report:Open_Job_Openings?ID=&lt;%=openingRec.ID%&gt;&quot;&gt;&lt;%=ifnull(openingRec.Job_Title,&quot;-&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=departmentText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(openingRec.Positions,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(openingRec.Hiring_Manager_Name,&quot;-&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=targetJoinText%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\topeningRows = openingRows + 1;\n\t}\n}\nif(openingRows == 0)\n{\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;zcs-tnodata&quot;&gt;&lt;td class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-font-14&quot; colspan=&quot;5&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; No open job openings found.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;rdash-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-20 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;rdash-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline users-2-a-add&quot;&gt;&lt;/i&gt;&lt;span&gt;Recent hires&lt;/span&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-section-meta&quot; href=&quot;#Report:Active_Employees&quot;&gt;Employees&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;rdash-hire-list&quot;&gt;\n&lt;%\nhireRows = 0;\nfor each employeeRec in Employees[Employee_Status == &quot;Active&quot;] sort by Joining_Date desc\n{\n\tif(hireRows &lt; 6)\n\t{\n\t\tempDepartment = &quot;-&quot;;\n\t\tif(employeeRec.Department != null)\n\t\t{\n\t\t\tempDepartment = ifnull(employeeRec.Department.Department_Name,&quot;-&quot;);\n\t\t}\n\t\tjoiningText = &quot;-&quot;;\n\t\tif(employeeRec.Joining_Date != null)\n\t\t{\n\t\t\tjoiningText = employeeRec.Joining_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\tempName = ifnull(employeeRec.Employee_Name,&quot;Employee&quot;);\n\t\tinitialText = empName.subString(0,1);\n%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-hire-item&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-avatar&quot;&gt;&lt;%=initialText%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;rdash-table-link zcs-font-14 zcs-font-semibold&quot; href=&quot;#Report:All_Employees?ID=&lt;%=employeeRec.ID%&gt;&quot;&gt;&lt;%=empName%&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-muted&quot;&gt;&lt;%=ifnull(employeeRec.Designation,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;rdash-muted&quot;&gt;&lt;%=empDepartment%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=joiningText%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\thireRows = hireRows + 1;\n\t}\n}\nif(hireRows == 0)\n{\n%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;li class=&quot;rdash-empty&quot;&gt;&lt;i class=&quot;zc-li-outline users-2-a-add&quot;&gt;&lt;/i&gt;No active employee hires found.&lt;/li&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Applicants_On_Load as "Applicants On Load"
			{
			    type = form
			    form = Applicants
			    record event = on add or edit
			    description = "Initializes candidate status-driven field visibility."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                show Notes;
			            )
			        }
			    }
			}

			Applicants_On_Validate as "Applicants On Validate"
			{
			    type = form
			    form = Applicants
			    record event = on add or edit
			    description = "Validates candidate compensation and notice period values."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Current_CTC != null && input.Expected_CTC != null && input.Expected_CTC < input.Current_CTC)
			                {
			                    alert "Expected CTC cannot be less than Current CTC.";
			                    cancel submit;
			                }
			                if(input.Notice_Period_Days != null && input.Notice_Period_Days < 0)
			                {
			                    alert "Notice Period Days cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Candidate_Status_On_User_Input as "Candidate Status On User Input"
			{
			    type = form
			    form = Applicants
			    record event = on add or edit
			    description = "Emphasizes notes for blacklisted or archived candidates."
			
			    on user input of Candidate_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Candidate_Status == "Blacklisted" || input.Candidate_Status == "Archived")
			                {
			                    show Notes;
			                }
			                else
			                {
			                    show Notes;
			                }
			            )
			        }
			    }
			}

			Application_Status_On_User_Input as "Application Status On User Input"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			    description = "Shows decision fields that match the selected application status."
			
			    on user input of Application_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Application_Status == "Rejected")
			                {
			                    show Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else if(input.Application_Status == "Withdrawn")
			                {
			                    hide Rejection_Reason;
			                    show Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else if(input.Application_Status == "Hired")
			                {
			                    hide Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else
			                {
			                    hide Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    hide Final_Decision_Date;
			                }
			            )
			        }
			    }
			}

			Applications_On_Load as "Applications On Load"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			    description = "Initializes application decision field visibility."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Application_Status == "Rejected")
			                {
			                    show Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else if(input.Application_Status == "Withdrawn")
			                {
			                    hide Rejection_Reason;
			                    show Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else if(input.Application_Status == "Hired")
			                {
			                    hide Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    show Final_Decision_Date;
			                }
			                else
			                {
			                    hide Rejection_Reason;
			                    hide Withdrawal_Reason;
			                    hide Final_Decision_Date;
			                }
			            )
			        }
			    }
			}

			Applications_On_Success as "Applications On Success"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			    description = "Keeps applicant hiring status synchronized with application decisions."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                applicantRec = Applicants[ID == input.Applicant];
			                if(applicantRec.ID != null)
			                {
			                    if(input.Application_Status == "Hired")
			                    {
			                        applicantRec.Candidate_Status = "Hired";
			                    }
			                    else if(input.Application_Status != "Rejected" && input.Application_Status != "Withdrawn")
			                    {
			                        hiredApps = Applications[Applicant == input.Applicant && Application_Status == "Hired"];
			                        if(hiredApps.count() == 0 && applicantRec.Candidate_Status != "Blacklisted")
			                        {
			                            applicantRec.Candidate_Status = "Active";
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Applications_On_Validate as "Applications On Validate"
			{
			    type = form
			    form = Applications
			    record event = on add or edit
			    description = "Validates duplicate applications and final decision requirements."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                duplicates = Applications[Applicant == input.Applicant && Job_Opening == input.Job_Opening && ID != input.ID];
			                if(duplicates.count() > 0)
			                {
			                    alert "This applicant is already linked to this job opening.";
			                    cancel submit;
			                }
			                if(input.Application_Status == "Rejected" && (input.Rejection_Reason == null || input.Rejection_Reason == ""))
			                {
			                    alert "Rejection Reason is required when the application is Rejected.";
			                    cancel submit;
			                }
			                if(input.Application_Status == "Withdrawn" && (input.Withdrawal_Reason == null || input.Withdrawal_Reason == ""))
			                {
			                    alert "Withdrawal Reason is required when the application is Withdrawn.";
			                    cancel submit;
			                }
			                if(input.Application_Status == "Hired" || input.Application_Status == "Rejected" || input.Application_Status == "Withdrawn")
			                {
			                    if(input.Final_Decision_Date == null)
			                    {
			                        input.Final_Decision_Date = zoho.currentdate;
			                    }
			                }
			            )
			        }
			    }
			}

			Employees_On_Validate as "Employees On Validate"
			{
			    type = form
			    form = Employees
			    record event = on add or edit
			    description = "Validates basic employee active status requirements."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Employee_Status == "Active" && input.Joining_Date == null)
			                {
			                    alert "Joining Date is required for active employees.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Interview_Status_On_User_Input as "Interview Status On User Input"
			{
			    type = form
			    form = Interviews
			    record event = on add or edit
			    description = "Enables feedback fields only for completed interviews."
			
			    on user input of Interview_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Interview_Status == "Completed")
			                {
			                    show Rating;
			                    show Recommendation;
			                    show Feedback;
			                    show Next_Steps;
			                    enable Rating;
			                    enable Recommendation;
			                    enable Feedback;
			                    enable Next_Steps;
			                }
			                else
			                {
			                    hide Rating;
			                    hide Recommendation;
			                    hide Feedback;
			                    hide Next_Steps;
			                    disable Rating;
			                    disable Recommendation;
			                    disable Feedback;
			                    disable Next_Steps;
			                }
			            )
			        }
			    }
			}

			Interviews_On_Load as "Interviews On Load"
			{
			    type = form
			    form = Interviews
			    record event = on add or edit
			    description = "Initializes interview feedback field visibility and editability."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Interview_Status == "Completed")
			                {
			                    show Rating;
			                    show Recommendation;
			                    show Feedback;
			                    show Next_Steps;
			                    enable Rating;
			                    enable Recommendation;
			                    enable Feedback;
			                    enable Next_Steps;
			                }
			                else
			                {
			                    hide Rating;
			                    hide Recommendation;
			                    hide Feedback;
			                    hide Next_Steps;
			                    disable Rating;
			                    disable Recommendation;
			                    disable Feedback;
			                    disable Next_Steps;
			                }
			            )
			        }
			    }
			}

			Interviews_On_Success as "Interviews On Success"
			{
			    type = form
			    form = Interviews
			    record event = on add or edit
			    description = "Updates the linked application with the latest completed interview outcome."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                appRec = Applications[ID == input.Application];
			                if(appRec.ID != null && input.Interview_Status == "Completed")
			                {
			                    appRec.Latest_Interview_Round = input.Interview_Round;
			                    appRec.Latest_Recommendation = input.Recommendation;
			                    if(input.Recommendation == "Reject")
			                    {
			                        appRec.Application_Status = "Rejected";
			                        if(appRec.Rejection_Reason == null || appRec.Rejection_Reason == "")
			                        {
			                            appRec.Rejection_Reason = "Rejected after " + input.Interview_Round + " interview.";
			                        }
			                        appRec.Final_Decision_Date = zoho.currentdate;
			                    }
			                    else if(input.Interview_Round == "Screening" && input.Recommendation == "Advance" && appRec.Application_Status == "Screening")
			                    {
			                        appRec.Application_Status = "Technical Interview";
			                    }
			                    else if(input.Interview_Round == "Technical" && input.Recommendation == "Advance" && appRec.Application_Status == "Technical Interview")
			                    {
			                        appRec.Application_Status = "HR Interview";
			                    }
			                    else if(input.Interview_Round == "HR" && input.Recommendation == "Hire" && appRec.Application_Status == "HR Interview")
			                    {
			                        appRec.Application_Status = "Offer";
			                    }
			                }
			            )
			        }
			    }
			}

			Interviews_On_Validate as "Interviews On Validate"
			{
			    type = form
			    form = Interviews
			    record event = on add or edit
			    description = "Validates interview dates and completed feedback."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Interview_End != null && input.Interview_End < input.Interview_Start)
			                {
			                    alert "Interview End cannot be earlier than Interview Start.";
			                    cancel submit;
			                }
			                if(input.Interview_Status == "Completed")
			                {
			                    if(input.Rating == null || input.Rating < 1 || input.Rating > 5)
			                    {
			                        alert "Rating is required and must be between 1 and 5 when the interview is Completed.";
			                        cancel submit;
			                    }
			                    if(input.Recommendation == null || input.Recommendation == "")
			                    {
			                        alert "Recommendation is required when the interview is Completed.";
			                        cancel submit;
			                    }
			                    if(input.Feedback == null || input.Feedback == "")
			                    {
			                        alert "Feedback is required when the interview is Completed.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Job_Openings_On_Load as "Job Openings On Load"
			{
			    type = form
			    form = Job_Openings
			    record event = on add or edit
			    description = "Initializes opening date field visibility."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Opening_Status == "Open")
			                {
			                    show Date_Opened;
			                    hide Date_Closed;
			                }
			                else if(input.Opening_Status == "Closed" || input.Opening_Status == "Filled")
			                {
			                    show Date_Opened;
			                    show Date_Closed;
			                }
			                else
			                {
			                    hide Date_Opened;
			                    hide Date_Closed;
			                }
			            )
			        }
			    }
			}

			Job_Openings_On_Validate as "Job Openings On Validate"
			{
			    type = form
			    form = Job_Openings
			    record event = on add or edit
			    description = "Validates job opening counts, salary range, and status dates."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Positions,0) <= 0)
			                {
			                    alert "Positions must be greater than zero.";
			                    cancel submit;
			                }
			                if(input.Salary_Min != null && input.Salary_Max != null && input.Salary_Max < input.Salary_Min)
			                {
			                    alert "Salary Max cannot be less than Salary Min.";
			                    cancel submit;
			                }
			                if(input.Opening_Status == "Open" && input.Date_Opened == null)
			                {
			                    alert "Date Opened is required when the opening is Open.";
			                    cancel submit;
			                }
			                if((input.Opening_Status == "Closed" || input.Opening_Status == "Filled") && input.Date_Closed == null)
			                {
			                    alert "Date Closed is required when the opening is Closed or Filled.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Opening_Status_On_User_Input as "Opening Status On User Input"
			{
			    type = form
			    form = Job_Openings
			    record event = on add or edit
			    description = "Shows the relevant opening date fields when status changes."
			
			    on user input of Opening_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Opening_Status == "Open")
			                {
			                    show Date_Opened;
			                    hide Date_Closed;
			                }
			                else if(input.Opening_Status == "Closed" || input.Opening_Status == "Filled")
			                {
			                    show Date_Opened;
			                    show Date_Closed;
			                }
			                else
			                {
			                    hide Date_Opened;
			                    hide Date_Closed;
			                }
			            )
			        }
			    }
			}

			Offer_Status_On_User_Input as "Offer Status On User Input"
			{
			    type = form
			    form = Offers
			    record event = on add or edit
			    description = "Shows acceptance fields when an offer is accepted."
			
			    on user input of Offer_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Offer_Status == "Accepted")
			                {
			                    show Acceptance_Date;
			                    show Expected_Joining_Date;
			                }
			                else if(input.Offer_Status == "Sent")
			                {
			                    hide Acceptance_Date;
			                    show Expected_Joining_Date;
			                }
			                else
			                {
			                    hide Acceptance_Date;
			                    show Expected_Joining_Date;
			                }
			            )
			        }
			    }
			}

			Offers_On_Load as "Offers On Load"
			{
			    type = form
			    form = Offers
			    record event = on add or edit
			    description = "Initializes offer acceptance field visibility."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Offer_Status == "Accepted")
			                {
			                    show Acceptance_Date;
			                    show Expected_Joining_Date;
			                }
			                else
			                {
			                    hide Acceptance_Date;
			                    show Expected_Joining_Date;
			                }
			            )
			        }
			    }
			}

			Offers_On_Success as "Offers On Success"
			{
			    type = form
			    form = Offers
			    record event = on add or edit
			    description = "Converts accepted offers into employee records and updates linked recruitment records."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Offer_Status == "Accepted")
			                {
			                    appRec = Applications[ID == input.Application];
			                    if(appRec.ID != null)
			                    {
			                        decisionDate = ifnull(input.Acceptance_Date,zoho.currentdate);
			                        appRec.Application_Status = "Hired";
			                        appRec.Final_Decision_Date = decisionDate;
			                        applicantRec = Applicants[ID == appRec.Applicant];
			                        if(applicantRec.ID != null)
			                        {
			                            applicantRec.Candidate_Status = "Hired";
			                        }
			                        existingEmployees = Employees[Source_Application == appRec.ID];
			                        if(existingEmployees.count() == 0 && applicantRec.ID != null)
			                        {
			                            openingRec = Job_Openings[ID == appRec.Job_Opening];
			                            empType = "Full-time";
			                            if(openingRec.ID != null && openingRec.Employment_Type != null)
			                            {
			                                empType = openingRec.Employment_Type;
			                            }
			                            employeeId = insert into Employees
			                            [
			                                Employee_Name = applicantRec.Applicant_Name
			                                Work_Email = applicantRec.Email
			                                Personal_Email = applicantRec.Email
			                                Phone = applicantRec.Phone
			                                Department = input.Offered_Department
			                                Designation = input.Offered_Designation
			                                Employment_Type = empType
			                                Joining_Date = input.Expected_Joining_Date
			                                Employee_Status = "Active"
			                                Source_Application = appRec.ID
			                            ];
			                        }
			                        openingRec = Job_Openings[ID == appRec.Job_Opening];
			                        if(openingRec.ID != null)
			                        {
			                            hiredApps = Applications[Job_Opening == openingRec.ID && Application_Status == "Hired"];
			                            if(hiredApps.count() >= openingRec.Positions)
			                            {
			                                openingRec.Opening_Status = "Filled";
			                                if(openingRec.Date_Closed == null)
			                                {
			                                    openingRec.Date_Closed = zoho.currentdate;
			                                }
			                            }
			                        }
			                    }
			                }
			            )
			        }
			    }
			}

			Offers_On_Validate as "Offers On Validate"
			{
			    type = form
			    form = Offers
			    record event = on add or edit
			    description = "Validates offer acceptance requirements and duplicate active offers."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Offered_CTC != null && input.Offered_CTC < 0)
			                {
			                    alert "Offered CTC cannot be negative.";
			                    cancel submit;
			                }
			                if(input.Offer_Status == "Accepted")
			                {
			                    if(input.Acceptance_Date == null)
			                    {
			                        input.Acceptance_Date = zoho.currentdate;
			                    }
			                    if(input.Expected_Joining_Date == null)
			                    {
			                        alert "Expected Joining Date is required when the offer is Accepted.";
			                        cancel submit;
			                    }
			                }
			                activeOffers = Offers[Application == input.Application && ID != input.ID && Offer_Status != "Withdrawn" && Offer_Status != "Declined"];
			                if(activeOffers.count() > 0 && input.Offer_Status != "Withdrawn" && input.Offer_Status != "Declined")
			                {
			                    alert "Another active offer already exists for this application.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		blueprint
		{
			Application_Selection_Process as "Application Selection Process"
			{
			    type = blueprint
			    form = Applications
			
			    start
			    {
			        start stage = "Applied"
			    }
			
			    stages
			    {
			        "Applied" { }
			        "Screening" { }
			        "Technical Interview" { }
			        "HR Interview" { }
			        "Offer" { }
			        "Hired" { }
			        "Rejected" { }
			        "Withdrawn" { }
			    }
			
			    transitions
			    {
			        Shortlist as "Shortlist"
			        {
			            type = normal
			            from stage = "Applied"
			            to stage = "Screening"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			            }
			            after { }
			        }
			        Move_to_Technical as "Move to Technical"
			        {
			            type = normal
			            from stage = "Screening"
			            to stage = "Technical Interview"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			            }
			            after { }
			        }
			        Move_to_HR as "Move to HR"
			        {
			            type = normal
			            from stage = "Technical Interview"
			            to stage = "HR Interview"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			            }
			            after { }
			        }
			        Approve_for_Offer as "Approve for Offer"
			        {
			            type = normal
			            from stage = "HR Interview"
			            to stage = "Offer"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			            }
			            after { }
			        }
			        Mark_Hired as "Mark Hired"
			        {
			            type = normal
			            from stage = "Offer"
			            to stage = "Hired"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			            }
			            after { }
			        }
			        Reject as "Reject"
			        {
			            type = common
			            from stage = "Applied"
			            to stage = "Rejected"
			            common stages = {"Screening", "Technical Interview", "HR Interview", "Offer"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			                tooltip message = "Reject this candidate for the opening"
			            }
			            after { }
			        }
			        Withdraw as "Withdraw"
			        {
			            type = common
			            from stage = "Applied"
			            to stage = "Withdrawn"
			            common stages = {"Screening", "Technical Interview", "HR Interview", "Offer"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"HR_Recruiter", "Hiring_Manager"}
			                )
			                tooltip message = "Mark this application as withdrawn"
			            }
			            after { }
			        }
			    }
			}
		}
	}

