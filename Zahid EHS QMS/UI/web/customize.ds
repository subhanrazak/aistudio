customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header { letter-spacing: .01em; }"
    }
}