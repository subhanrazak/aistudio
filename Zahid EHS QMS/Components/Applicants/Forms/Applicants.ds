form Applicants
{
    displayname = "Applicants"
    Candidate_Profile
    (
        type = section
        displayname = "Candidate Profile"
        row = 1
        column = 0
    )
    Applicant_ID
    (
        type = autonumber
        displayname = "Applicant ID"
        start index = 10000
        row = 1
        column = 1
        width = medium
    )
    must have Applicant_Name
    (
        type = text
        displayname = "Applicant Name"
        maxchar = 150
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Current_Location
    (
        type = text
        displayname = "Current Location"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    Source_Details_Section
    (
        type = section
        displayname = "Source Details"
        visibility = true
        row = 2
        column = 1
    )
    Source
    (
        type = picklist
        displayname = "Source"
        values = {"Job Portal", "Referral", "LinkedIn", "Agency", "Campus", "Walk-in", "Other"}
        row = 2
        column = 1
        width = medium
    )
    Source_Details
    (
        type = text
        displayname = "Source Details"
        maxchar = 150
        row = 2
        column = 2
        width = medium
    )
    Highest_Qualification
    (
        type = text
        displayname = "Highest Qualification"
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    Total_Experience_Years
    (
        type = decimal
        displayname = "Total Experience Years"
        decimalplace = 1
        row = 2
        column = 2
        width = medium
    )
    Current_Employer
    (
        type = text
        displayname = "Current Employer"
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    Compensation_Availability
    (
        type = section
        displayname = "Compensation & Availability"
        visibility = true
        row = 3
        column = 1
    )
    Current_CTC
    (
        type = decimal
        displayname = "Current CTC"
        decimalplace = 2
        row = 3
        column = 1
        width = medium
    )
    Expected_CTC
    (
        type = decimal
        displayname = "Expected CTC"
        decimalplace = 2
        row = 3
        column = 2
        width = medium
    )
    Notice_Period_Days
    (
        type = number
        displayname = "Notice Period Days"
        row = 3
        column = 1
        width = medium
    )
    Skills
    (
        type = textarea
        displayname = "Skills"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Resume
    (
        type = upload file
        displayname = "Resume"
        browse = local_drive, google_docs, zoho_docs
        row = 3
        column = 1
        width = medium
    )
    Candidate_Status_Section
    (
        type = section
        displayname = "Candidate Status"
        visibility = true
        row = 4
        column = 1
    )
    must have Candidate_Status
    (
        type = picklist
        displayname = "Candidate Status"
        values = {"Active", "Blacklisted", "Hired", "Archived"}
        initial value = "Active"
        row = 4
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 4
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}