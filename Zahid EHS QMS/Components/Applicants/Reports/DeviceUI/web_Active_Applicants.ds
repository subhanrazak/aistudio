report Active_Applicants
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Applicant_Name
                    Email
                    Phone
                    Source
                    Total_Experience_Years
                    Skills
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
            record ( Edit Duplicate Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit Delete Duplicate View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Applicant_Name
                    Email
                    Phone
                    Source
                    Total_Experience_Years
                    Skills
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
        )
    )
}