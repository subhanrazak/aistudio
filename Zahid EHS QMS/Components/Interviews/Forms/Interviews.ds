form Interviews
{
    displayname = "Interviews"
    Interview_Schedule
    (
        type = section
        displayname = "Interview Schedule"
        row = 1
        column = 0
    )
    Interview_ID
    (
        type = autonumber
        displayname = "Interview ID"
        start index = 70000
        row = 1
        column = 1
        width = medium
    )
    must have Application
    (
        type = picklist
        displayname = "Application"
        values = Applications.ID
        displayformat = [Application_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Interview_Round
    (
        type = picklist
        displayname = "Interview Round"
        values = {"Screening", "Technical", "HR"}
        row = 1
        column = 2
        width = medium
    )
    Interview_Title
    (
        type = text
        displayname = "Interview Title"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Interview_Mode
    (
        type = picklist
        displayname = "Interview Mode"
        values = {"Phone", "Video", "In-person"}
        row = 1
        column = 2
        width = medium
    )
    must have Interview_Start
    (
        type = datetime
        displayname = "Interview Start"
        row = 1
        column = 1
        width = medium
    )
    Interview_End
    (
        type = datetime
        displayname = "Interview End"
        row = 1
        column = 2
        width = medium
    )
    Interviewer_Details
    (
        type = section
        displayname = "Interviewer Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Interviewer_Name
    (
        type = text
        displayname = "Interviewer Name"
        maxchar = 100
        row = 2
        column = 1
        width = medium
    )
    Interviewer_Email
    (
        type = email
        displayname = "Interviewer Email"
        row = 2
        column = 2
        width = medium
    )
    Feedback_Details
    (
        type = section
        displayname = "Feedback Details"
        visibility = true
        row = 3
        column = 1
    )
    must have Interview_Status
    (
        type = picklist
        displayname = "Interview Status"
        values = {"Scheduled", "Completed", "Cancelled", "No Show", "Rescheduled"}
        initial value = "Scheduled"
        row = 3
        column = 1
        width = medium
    )
    Rating
    (
        type = number
        displayname = "Rating"
        row = 3
        column = 2
        width = medium
    )
    Recommendation
    (
        type = picklist
        displayname = "Recommendation"
        values = {"Pending", "Advance", "Hold", "Reject", "Hire"}
        row = 3
        column = 1
        width = medium
    )
    Feedback
    (
        type = textarea
        displayname = "Feedback"
        height = 150px
        row = 3
        column = 2
        width = medium
    )
    Next_Steps
    (
        type = textarea
        displayname = "Next Steps"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}