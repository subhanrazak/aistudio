calendar Interview_Calendar
{
    displayName = "Interview Calendar"
    show all rows from Interviews
    (
        Interview_Title
        Application
        Interview_Round
        Interview_Mode
        Interview_Start
        Interview_End
        Interviewer_Name
        Interview_Status
    )
    filters
    (
        Interview_Round
        Interview_Status
        Interviewer_Name
    )
    options
    (
        display type = month
        week start day = monday
        display field = Interview_Title
        start date = Interview_Start
        end date = Interview_End
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}