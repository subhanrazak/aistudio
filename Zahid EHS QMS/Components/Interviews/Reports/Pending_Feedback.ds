list Pending_Feedback
{
    displayName = "Pending Feedback"
    show all rows from Interviews [Interview_Status == "Scheduled" || (Interview_Status == "Completed" && Recommendation is null)]
    (
        Interview_ID
        Application
        Interview_Round
        Interview_Start
        Interviewer_Name
        Interview_Status
        Recommendation
    )
    sort by
    (
        Interview_Start ascending
    )
}