default list All_Interviews
{
    displayName = "All Interviews"
    show all rows from Interviews
    (
        Interview_ID
        Application
        Interview_Round
        Interview_Mode
        Interview_Start
        Interview_End
        Interviewer_Name
        Interview_Status
        Rating
        Recommendation
    )
    filters
    (
        Interview_Round
        Interview_Status
        Recommendation
        Interviewer_Name
    )
    sort by
    (
        Interview_Start descending
    )
}