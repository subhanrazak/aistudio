report All_Interviews
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Interview_ID
                    Application
                    Interview_Round
                    Interview_Mode
                    Interview_Start
                    Interview_End
                    Interviewer_Name
                    Interview_Status
                    Rating
                    Recommendation
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
            record ( Edit Duplicate Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit Delete Duplicate View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Interview_ID
                    Application
                    Interview_Round
                    Interview_Mode
                    Interview_Start
                    Interview_End
                    Interviewer_Name
                    Interview_Status
                    Rating
                    Recommendation
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
        )
    )
}