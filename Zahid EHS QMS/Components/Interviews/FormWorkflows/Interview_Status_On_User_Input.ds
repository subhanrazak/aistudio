Interview_Status_On_User_Input as "Interview Status On User Input"
{
    type = form
    form = Interviews
    record event = on add or edit
    description = "Enables feedback fields only for completed interviews."

    on user input of Interview_Status
    {
        actions
        {
            custom deluge script
            (
                if(input.Interview_Status == "Completed")
                {
                    show Rating;
                    show Recommendation;
                    show Feedback;
                    show Next_Steps;
                    enable Rating;
                    enable Recommendation;
                    enable Feedback;
                    enable Next_Steps;
                }
                else
                {
                    hide Rating;
                    hide Recommendation;
                    hide Feedback;
                    hide Next_Steps;
                    disable Rating;
                    disable Recommendation;
                    disable Feedback;
                    disable Next_Steps;
                }
            )
        }
    }
}