form Job_Openings
{
    displayname = "Job Openings"
    Role_Details
    (
        type = section
        displayname = "Role Details"
        row = 1
        column = 0
    )
    Opening_ID
    (
        type = autonumber
        displayname = "Opening ID"
        start index = 1000
        row = 1
        column = 1
        width = medium
    )
    must have Job_Title
    (
        type = text
        displayname = "Job Title"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = Departments[Status == "Active"].ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Hiring_Manager_Name
    (
        type = text
        displayname = "Hiring Manager Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Hiring_Manager_Email
    (
        type = email
        displayname = "Hiring Manager Email"
        row = 1
        column = 2
        width = medium
    )
    must have Employment_Type
    (
        type = picklist
        displayname = "Employment Type"
        values = {"Full-time", "Part-time", "Contract", "Internship"}
        row = 1
        column = 1
        width = medium
    )
    Work_Mode
    (
        type = picklist
        displayname = "Work Mode"
        values = {"On-site", "Hybrid", "Remote"}
        row = 1
        column = 2
        width = medium
    )
    Location
    (
        type = text
        displayname = "Location"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    must have Positions
    (
        type = number
        displayname = "Positions"
        initial value = 1
        row = 1
        column = 2
        width = medium
    )
    Target_Join_Date
    (
        type = date
        displayname = "Target Join Date"
        row = 1
        column = 1
        width = medium
    )
    Compensation_Details
    (
        type = section
        displayname = "Compensation Details"
        visibility = true
        row = 2
        column = 1
    )
    Minimum_Experience_Years
    (
        type = decimal
        displayname = "Minimum Experience Years"
        decimalplace = 1
        row = 2
        column = 1
        width = medium
    )
    Salary_Min
    (
        type = decimal
        displayname = "Salary Min"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Salary_Max
    (
        type = decimal
        displayname = "Salary Max"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Description_Status
    (
        type = section
        displayname = "Description & Status"
        visibility = true
        row = 3
        column = 1
    )
    must have Opening_Status
    (
        type = picklist
        displayname = "Opening Status"
        values = {"Draft", "Open", "On Hold", "Filled", "Closed"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )
    Date_Opened
    (
        type = date
        displayname = "Date Opened"
        row = 3
        column = 2
        width = medium
    )
    Date_Closed
    (
        type = date
        displayname = "Date Closed"
        row = 3
        column = 2
        width = medium
    )
    must have Job_Description
    (
        type = textarea
        displayname = "Job Description"
        height = 150px
        row = 3
        column = 1
        width = medium
    )
    Required_Skills
    (
        type = textarea
        displayname = "Required Skills"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}