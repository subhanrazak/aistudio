list Open_Job_Openings
{
    displayName = "Open Job Openings"
    show all rows from Job_Openings [Opening_Status == "Open"]
    (
        Opening_ID
        Job_Title
        Department
        Hiring_Manager_Name
        Employment_Type
        Work_Mode
        Positions
        Location
        Target_Join_Date
    )
    filters
    (
        Department
        Employment_Type
        Work_Mode
    )
    sort by
    (
        Target_Join_Date ascending
    )
}