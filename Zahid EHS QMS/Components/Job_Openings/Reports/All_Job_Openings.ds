default list All_Job_Openings
{
    displayName = "All Job Openings"
    show all rows from Job_Openings
    (
        Opening_ID
        Job_Title
        Department
        Hiring_Manager_Name
        Employment_Type
        Work_Mode
        Location
        Positions
        Opening_Status
        Target_Join_Date
    )
    filters
    (
        Department
        Opening_Status
        Employment_Type
        Work_Mode
    )
    sort by
    (
        Opening_ID descending
    )
}