form Employees
{
    displayname = "Employees"
    Employee_Profile
    (
        type = section
        displayname = "Employee Profile"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 20000
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = text
        displayname = "Employee Name"
        maxchar = 150
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    must have unique Work_Email
    (
        type = email
        displayname = "Work Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Personal_Email
    (
        type = email
        displayname = "Personal Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Employment_Details
    (
        type = section
        displayname = "Employment Details"
        visibility = true
        row = 2
        column = 1
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    must have Designation
    (
        type = text
        displayname = "Designation"
        maxchar = 150
        row = 2
        column = 2
        width = medium
    )
    Employment_Type
    (
        type = picklist
        displayname = "Employment Type"
        values = {"Full-time", "Part-time", "Contract", "Internship"}
        row = 2
        column = 1
        width = medium
    )
    must have Joining_Date
    (
        type = date
        displayname = "Joining Date"
        row = 2
        column = 2
        width = medium
    )
    must have Employee_Status
    (
        type = picklist
        displayname = "Employee Status"
        values = {"Active", "Inactive", "Separated"}
        initial value = "Active"
        row = 2
        column = 1
        width = medium
    )
    Source_Application
    (
        type = picklist
        displayname = "Source Application"
        values = Applications.ID
        displayformat = [Application_ID]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}