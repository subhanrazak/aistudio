default list All_Employees
{
    displayName = "All Employees"
    show all rows from Employees
    (
        Employee_ID
        Employee_Name
        Work_Email
        Department
        Designation
        Employment_Type
        Joining_Date
        Employee_Status
        Source_Application
    )
    filters
    (
        Department
        Employee_Status
        Employment_Type
    )
    sort by
    (
        Employee_ID descending
    )
}