form Departments
{
    displayname = "Departments"
    Department_Details
    (
        type = section
        displayname = "Department Details"
        row = 1
        column = 0
    )
    Department_ID
    (
        type = autonumber
        displayname = "Department ID"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have unique Department_Name
    (
        type = text
        displayname = "Department Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Department_Head
    (
        type = text
        displayname = "Department Head"
        maxchar = 100
        row = 1
        column = 2
        width = medium
    )
    Department_Email
    (
        type = email
        displayname = "Department Email"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}