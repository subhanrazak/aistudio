report All_Departments
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Department_ID
                    Department_Name
                    Department_Head
                    Department_Email
                    Status
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
            record ( Edit Duplicate Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit Delete Duplicate View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Department_ID
                    Department_Name
                    Department_Head
                    Department_Email
                    Status
                )
            )
        )
        menu
        (
            header ( Edit Duplicate Delete )
        )
    )
}