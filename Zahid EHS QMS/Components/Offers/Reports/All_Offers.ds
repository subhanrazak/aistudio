default list All_Offers
{
    displayName = "All Offers"
    show all rows from Offers
    (
        Offer_ID
        Application
        Offer_Date
        Offered_Designation
        Offered_Department
        Offered_CTC
        Expected_Joining_Date
        Offer_Status
        Acceptance_Date
    )
    filters
    (
        Offer_Status
        Offered_Department
    )
    sort by
    (
        Offer_ID descending
    )
}