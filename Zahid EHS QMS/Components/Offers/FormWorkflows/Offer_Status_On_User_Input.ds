Offer_Status_On_User_Input as "Offer Status On User Input"
{
    type = form
    form = Offers
    record event = on add or edit
    description = "Shows acceptance fields when an offer is accepted."

    on user input of Offer_Status
    {
        actions
        {
            custom deluge script
            (
                if(input.Offer_Status == "Accepted")
                {
                    show Acceptance_Date;
                    show Expected_Joining_Date;
                }
                else if(input.Offer_Status == "Sent")
                {
                    hide Acceptance_Date;
                    show Expected_Joining_Date;
                }
                else
                {
                    hide Acceptance_Date;
                    show Expected_Joining_Date;
                }
            )
        }
    }
}