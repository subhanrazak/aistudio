form Offers
{
    displayname = "Offers"
    Offer_Details
    (
        type = section
        displayname = "Offer Details"
        row = 1
        column = 0
    )
    Offer_ID
    (
        type = autonumber
        displayname = "Offer ID"
        start index = 90000
        row = 1
        column = 1
        width = medium
    )
    must have Application
    (
        type = picklist
        displayname = "Application"
        values = Applications.ID
        displayformat = [Application_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Offer_Date
    (
        type = date
        displayname = "Offer Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    must have Offered_Designation
    (
        type = text
        displayname = "Offered Designation"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Offered_Department
    (
        type = picklist
        displayname = "Offered Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Offer_Terms
    (
        type = section
        displayname = "Offer Terms"
        visibility = true
        row = 2
        column = 1
    )
    Offered_CTC
    (
        type = decimal
        displayname = "Offered CTC"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Expected_Joining_Date
    (
        type = date
        displayname = "Expected Joining Date"
        row = 2
        column = 2
        width = medium
    )
    must have Offer_Status
    (
        type = picklist
        displayname = "Offer Status"
        values = {"Draft", "Sent", "Accepted", "Declined", "Withdrawn"}
        initial value = "Draft"
        row = 2
        column = 1
        width = medium
    )
    Acceptance_Date
    (
        type = date
        displayname = "Acceptance Date"
        row = 2
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}