list Rejected_Withdrawn_Applications
{
    displayName = "Rejected & Withdrawn Applications"
    show all rows from Applications [Application_Status == "Rejected" || Application_Status == "Withdrawn"]
    (
        Application_ID
        Applicant
        Job_Opening
        Application_Status
        Rejection_Reason
        Withdrawal_Reason
        Final_Decision_Date
    )
    sort by
    (
        Final_Decision_Date descending
    )
}