kanban Application_Pipeline
{
    displayName = "Application Pipeline"
    show all rows from Applications
    (
        Applicant
        Job_Opening
        Application_Date
        Application_Status
        Latest_Interview_Round
        Latest_Recommendation
    )
    filters
    (
        Job_Opening
    )
    sort by
    (
        Application_Date ascending
    )
    options
    (
        display field = Application_Status
        othercolumn = "Other"
        sort order = ascending
        record count = enable
    )
}