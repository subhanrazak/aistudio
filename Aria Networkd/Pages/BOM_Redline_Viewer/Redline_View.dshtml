<%
	co_rec = Change_Order[ID == -1];
	parent_rec = Item_Master[ID == -1];
	if(input.change_order_id != null)
	{
		co_rec = Change_Order[ID == input.change_order_id];
	}
	if(input.parent_item_id != null)
	{
		parent_rec = Item_Master[ID == input.parent_item_id];
	}
	co_found = false;
	parent_found = false;
	if(co_rec.count() > 0)
	{
		co_found = true;
		co_order_id = ifnull(co_rec.order_id,"-");
		co_title = ifnull(co_rec.title,"Untitled Change Order");
		co_status = ifnull(co_rec.status,"Unspecified");
		co_status_class = "zcs-badge-yellow";
		co_status_icon = "loader-dots-06";
		if(co_status == "Released" || co_status == "Approved" || co_status == "Completed" || co_status == "Closed")
		{
			co_status_class = "zcs-badge-green";
			co_status_icon = "ui-1-check-circle-08";
		}
		else if(co_status == "Rejected" || co_status == "Cancelled" || co_status == "Canceled" || co_status == "Failed")
		{
			co_status_class = "zcs-badge-red";
			co_status_icon = "ui-1-circle-remove";
		}
		else if(co_status == "Draft")
		{
			co_status_class = "zcs-badge-grey";
			co_status_icon = "ui-2-time";
		}
	}
	else
	{
		co_order_id = "Change Order not found";
		co_title = "No Change Order record matched ID " + ifnull(input.change_order_id,"-");
		co_status = "Not found";
		co_status_class = "zcs-badge-red";
		co_status_icon = "ui-1-circle-remove";
	}
	if(parent_rec.count() > 0)
	{
		parent_found = true;
		parent_apn = ifnull(parent_rec.apn,"-");
		parent_revision = ifnull(parent_rec.revision,"-");
		parent_name = ifnull(parent_rec.part_name,ifnull(parent_rec.description,"-"));
		parent_status = ifnull(parent_rec.lifecycle_phase,ifnull(parent_rec.part_status,"-"));
	}
	else
	{
		parent_apn = "Parent item not found";
		parent_revision = "-";
		parent_name = "No Item Master record matched ID " + ifnull(input.parent_item_id,"-");
		parent_status = "Not found";
	}
	bom_records = BOM_Line[ID == -1];
	redline_data = List();
	superseded_ids = List();
	total_source_rows = 0;
	unchanged_count = 0;
	modified_count = 0;
	inserted_count = 0;
	removed_count = 0;
	if(co_found == true && parent_found == true)
	{
		redline_data = thisapp.Build_BOM_Redline_Data(input.change_order_id,input.parent_item_id);
		bom_records = BOM_Line[parent_item == input.parent_item_id] sort by line_number asc;
		total_source_rows = bom_records.count();
		for each  bom_line_for_index in bom_records
		{
			if(bom_line_for_index.superseded_by != null)
			{
				superseded_ids.add(bom_line_for_index.superseded_by);
			}
		}
		for each  bom_line_for_count in bom_records
		{
			count_as_superseding_line = false;
			if(superseded_ids.contains(bom_line_for_count.ID) && bom_line_for_count.is_struck != true)
			{
				count_as_superseding_line = true;
			}
			if(count_as_superseding_line == false)
			{
				if(bom_line_for_count.superseded_by != null)
				{
					linked_insert_count = BOM_Line[ID == bom_line_for_count.superseded_by].count();
					if(linked_insert_count > 0)
					{
						modified_count = modified_count + 1;
						inserted_count = inserted_count + 1;
					}
					else if(bom_line_for_count.is_struck == true)
					{
						removed_count = removed_count + 1;
					}
				}
				else if(bom_line_for_count.is_struck == true)
				{
					removed_count = removed_count + 1;
				}
				else
				{
					unchanged_count = unchanged_count + 1;
				}
			}
		}
	}
	redline_data_size = redline_data.size();
	%>
<style>
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-border-color: var(--zcs_tertiary_border_color);
	--zcs-white-color: #FFFFFF;
	--zcs-thead-color: #F9FAFE;
	--zcs-tr-h-color: #F9FAFE;
	--zcs-zebra-even-color: #F9FAFE;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-w-full { width: 100%; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-gap-6 { gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-p-8 { padding: 0.5rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-py-20 { padding-top: 1.25rem; padding-bottom: 1.25rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: 0.25rem; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-12 { margin-top: 0.75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-font-11 { font-size: 0.6875rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-overflow-auto { overflow: auto; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }
a { text-decoration: none; }

/* ZCS component CSS: header-heading-with-back, adjusted to Nucleo icon. */
.zcs-back { width: 34px; height: 34px; border: 1px solid var(--zcs-border-color); color: var(--zcs-teritiary-text-color); background: var(--zcs-white-color); }
.zcs-back:hover { color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); }
.zcs-back-icon { font-style: normal; }
@media (max-width: 576px) {
	.zcs-page-header { padding: 12px 20px; }
}

/* ZCS component CSS: badge-badge-with-icon */
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #6b7280; color: #4b5563; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #b8770d; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }

/* ZCS component CSS: banner-outline-banner-with-icon */
.zcs-toast-link:hover { text-decoration: underline; }
.zcs-outline-toast { border: 1px solid; }
.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }
.zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); }
.zcs-info-toast { background-color: #e4f6fd; color: #024361; border-color: #0588d1; }
.zcs-warning-toast { background-color: #fef4e5; color: #663c01; border-color: #ed6c03; }
.zcs-error-toast { background-color: #feedec; color: #5f2120; border-color: #d32f2f; }

/* ZCS component CSS: table-simple-table */
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1040px; }
.zcs-table-wrapper table thead { top: 0px; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs_tertiary_border_color); }
.zcs-table-wrapper table thead tr th.zcs-green, .zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }
.zcs-table-wrapper table thead tr th.zcs-red, .zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }
.zcs-table-wrapper table thead tr th.zcs-yellow, .zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }
.zcs-table-wrapper table thead tr th.zcs-blue, .zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color: #09598e; }

.brv-page { min-height: 100%; background: #F6F7FB; }
.brv-summary-grid { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 12px; }
.brv-summary-card { border: 1px solid #e7e7ee; background: #ffffff; border-radius: 12px; padding: 14px 16px; }
.brv-summary-label { color: var(--zcs-secondary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
.brv-summary-value { color: var(--zcs-primary-text-color); font-size: 22px; font-weight: 700; line-height: 1.2; margin-top: 4px; }
.brv-subvalue { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 2px; }
.brv-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.brv-meta-card { min-width: 0; }
.brv-meta-title { color: var(--zcs-primary-text-color); font-weight: 700; font-size: 15px; }
.brv-meta-line { color: var(--zcs-secondary-text-color); font-size: 13px; margin-top: 4px; }
.brv-toolbar { border-top: 1px solid #e7e7ee; }
.brv-legend { flex-wrap: wrap; }
.brv-legend-dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; border: 1px solid transparent; }
.brv-dot-unchanged { background: #ffffff; border-color: #cfd4dc; }
.brv-dot-removed { background: #eef0f3; border-color: #9ca3af; }
.brv-dot-inserted { background: #e4fcf3; border-color: #179E6C; }
.brv-dot-modified { background: #e8efff; border-color: #2A6FFC; }
.brv-row-note { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 3px; }
.brv-part-main { font-weight: 600; color: var(--zcs-primary-text-color); }
.brv-part-sub { color: var(--zcs-secondary-text-color); font-size: 12px; margin-top: 2px; }
.brv-cell-stack { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
.brv-change-pair { display: inline-flex; flex-wrap: wrap; gap: 5px; align-items: center; }
del.old-value, .removed-row del { color: #6b7280; text-decoration: line-through; text-decoration-thickness: 1.5px; }
ins.new-value { color: #0f7b4f; background: #e4fcf3; border-bottom: 2px solid #179E6C; text-decoration: none; padding: 0 3px; border-radius: 3px; }
.removed-row td { background-color: #f3f4f6; color: #6b7280; }
.removed-row:hover td { background-color: #eef0f3 !important; }
.inserted-row td { background-color: #f0fdf7; color: #0f7b4f; }
.inserted-row:hover td { background-color: #e4fcf3 !important; }
.modified-row td { background-color: #f6f8ff; }
.modified-row:hover td { background-color: #eef3ff !important; }
.brv-status-cell { min-width: 135px; }
.brv-empty { border: 1px dashed var(--zcs_tertiary_border_color); background: #ffffff; border-radius: 12px; padding: 28px; text-align: center; }
.brv-empty i { color: var(--zcs-secondary-text-color); }
@media (max-width: 900px) {
	.brv-summary-grid, .brv-meta-grid { grid-template-columns: 1fr; }
	.brv-page-header { align-items: flex-start; flex-direction: column; }
}
</style>
<div class='brv-page zcs-w-full zcs-box-border'>
	<div class='zcs-page-header brv-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-10 zcs-ellipsis'>
			<a href='#Page:BOM_Browser?item_id=<%=input.parent_item_id%>' class='zcs-back zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-md zcs-box-border' title='Back to BOM Browser'>
				<i class='zcs-back-icon zcs-font-18 zc-li-outline arrows-1-tail-left'></i>
			</a>
			<div class='zcs-ellipsis'>
				<h5 class='zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'>BOM Redline Viewer</h5>
				<p class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-4'>Visual before and after markers for the selected Change Order and parent assembly.</p>
			</div>
		</div>
		<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=co_status_class%>'>
			<i class='zcs-badge-icon zcs-no-shrink zc-li-outline <%=co_status_icon%>'></i>
			<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=co_status%></span>
		</div>
	</div>

	<div class='zcs-px-30 zcs-py-20 zcs-box-border'>
		<div class='zcs-card zcs-p-20 zcs-box-border'>
			<div class='brv-meta-grid'>
				<div class='brv-meta-card'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
						<i class='zcs-font-18 zcs-color-theme zc-li-outline design-2-layers'></i>
						<span class='brv-meta-title'>Parent assembly</span>
					</div>
					<div class='brv-meta-line'><span class='zcs-font-semibold zcs-color-primary'><%=parent_apn%></span> Rev <%=parent_revision%></div>
					<div class='brv-meta-line'><%=parent_name%></div>
					<div class='brv-meta-line'>Lifecycle or status: <%=parent_status%></div>
				</div>
				<div class='brv-meta-card'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
						<i class='zcs-font-18 zcs-color-theme zc-li-outline files-paper'></i>
						<span class='brv-meta-title'>Change Order</span>
					</div>
					<div class='brv-meta-line'><span class='zcs-font-semibold zcs-color-primary'><%=co_order_id%></span></div>
					<div class='brv-meta-line'><%=co_title%></div>
					<div class='brv-meta-line'>Status: <%=co_status%></div>
				</div>
			</div>
		</div>

		<div class='zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-16'>
			<i class='zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info'></i>
			<div class='zcs-toast-text'>
				<p class='zcs-m-0'>This page is read-only. Snapshot field-level history is unavailable here, so modified rows are inferred from <span class='zcs-font-semibold'>BOM_Line.superseded_by</span>, removed rows from <span class='zcs-font-semibold'>BOM_Line.is_struck</span>, and unchanged rows from the current BOM marker state.</p>
			</div>
		</div>
<%
	if(co_found == false || parent_found == false)
	{
		%>
<div class='zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-mt-16'>
				<i class='zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove'></i>
				<div class='zcs-toast-text'>
					<p class='zcs-m-0'>Unable to render BOM redline rows because one or more required records were not found.</p>
				</div>
			</div>
			<div class='brv-empty zcs-mt-16'>
				<i class='zcs-font-22 zc-li-outline travel-info'></i>
				<h6 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0 zcs-mt-8'>Missing redline context</h6>
				<p class='zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-8'>Change Order ID: <%=ifnull(input.change_order_id,"-")%>. Parent Item ID: <%=ifnull(input.parent_item_id,"-")%>.</p>
			</div>
<%
	}
	else
	{
		%>
<div class='brv-summary-grid zcs-mt-16'>
				<div class='brv-summary-card'>
					<div class='brv-summary-label'>Unchanged rows</div>
					<div class='brv-summary-value'><%=unchanged_count%></div>
					<div class='brv-subvalue'>Plain BOM lines</div>
				</div>
				<div class='brv-summary-card'>
					<div class='brv-summary-label'>Removed rows</div>
					<div class='brv-summary-value'><%=removed_count%></div>
					<div class='brv-subvalue'>Grey struck rows</div>
				</div>
				<div class='brv-summary-card'>
					<div class='brv-summary-label'>Inserted rows</div>
					<div class='brv-summary-value'><%=inserted_count%></div>
					<div class='brv-subvalue'>Linked superseding lines</div>
				</div>
				<div class='brv-summary-card'>
					<div class='brv-summary-label'>Modified rows</div>
					<div class='brv-summary-value'><%=modified_count%></div>
					<div class='brv-subvalue'>Old struck and new inserted</div>
				</div>
			</div>

			<div class='zcs-card zcs-mt-16 zcs-box-border'>
				<div class='brv-toolbar zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-16 zcs-py-12 zcs-box-border'>
					<div>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0'>Redline rows</h6>
						<p class='zcs-font-13 zcs-color-secondary zcs-m-0 zcs-mt-4'>Helper returned <%=redline_data_size%> row maps from Build_BOM_Redline_Data; rendered source contains <%=total_source_rows%> BOM_Line records.</p>
					</div>
					<div class='brv-legend zcs-flex zcs-align-items-center zcs-gap-12 zcs-font-13 zcs-color-secondary'>
						<span class='zcs-inline-flex zcs-align-items-center zcs-gap-6'><span class='brv-legend-dot brv-dot-unchanged'></span>Unchanged</span>
						<span class='zcs-inline-flex zcs-align-items-center zcs-gap-6'><span class='brv-legend-dot brv-dot-removed'></span>Removed</span>
						<span class='zcs-inline-flex zcs-align-items-center zcs-gap-6'><span class='brv-legend-dot brv-dot-inserted'></span>Inserted</span>
						<span class='zcs-inline-flex zcs-align-items-center zcs-gap-6'><span class='brv-legend-dot brv-dot-modified'></span>Modified</span>
					</div>
				</div>
<%
		if(total_source_rows == 0)
		{
			%>
<div class='brv-empty zcs-m-16'>
						<i class='zcs-font-22 zc-li-outline travel-info'></i>
						<h6 class='zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0 zcs-mt-8'>No BOM rows found</h6>
						<p class='zcs-font-14 zcs-color-secondary zcs-m-0 zcs-mt-8'>The selected parent item has no BOM_Line records to render.</p>
					</div>
<%
		}
		else
		{
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
						<table class='zcs-w-full bom-redline-table'>
							<thead class='zcs-sticky'>
								<tr>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Change</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Line</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Child item</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Qty</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Ref des</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Approval</th>
									<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Notes</th>
								</tr>
								<tr class='zcs-tspace'>
									<th class='zcs-p-8 zcs-box-border' colspan='7'></th>
								</tr>
							</thead>
							<tbody>
<%
			for each  bom_line in bom_records
			{
				skip_superseding_line = false;
				if(superseded_ids.contains(bom_line.ID) && bom_line.is_struck != true)
				{
					skip_superseding_line = true;
				}
				if(skip_superseding_line == false)
				{
					old_line_number = ifnull(bom_line.line_number,"-");
					old_child_apn = ifnull(bom_line.child_item.apn,"-");
					old_child_revision = ifnull(bom_line.child_item.revision,"-");
					old_child_name = ifnull(bom_line.child_item.part_name,ifnull(bom_line.child_item.description,"-"));
					old_quantity = ifnull(bom_line.quantity,"-");
					old_ref = ifnull(bom_line.reference_designator,"-");
					old_approval = ifnull(bom_line.manufacturer_approval_status,"-");
					old_notes = ifnull(bom_line.bom_notes,"-");
					if(bom_line.superseded_by != null)
					{
						new_line = BOM_Line[ID == bom_line.superseded_by];
						if(new_line.count() > 0)
						{
							new_line_number = ifnull(new_line.line_number,"-");
							new_child_apn = ifnull(new_line.child_item.apn,"-");
							new_child_revision = ifnull(new_line.child_item.revision,"-");
							new_child_name = ifnull(new_line.child_item.part_name,ifnull(new_line.child_item.description,"-"));
							new_quantity = ifnull(new_line.quantity,"-");
							new_ref = ifnull(new_line.reference_designator,"-");
							new_approval = ifnull(new_line.manufacturer_approval_status,"-");
							new_notes = ifnull(new_line.bom_notes,"-");
							%>
<tr class='modified-row'>
										<td class='brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'>
												<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-edit-72'></i>
												<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Modified</span>
											</div>
											<div class='brv-row-note'>Before and after values</div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(bom_line.line_number != new_line.line_number)
							{
								%>
<span class='brv-change-pair'><del class='old-value'><%=old_line_number%></del><ins class='new-value'><%=new_line_number%></ins></span>
<%
							}
							else
							{
								%>
<%=old_line_number%>
<%
							}
							%>
</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(bom_line.child_item != new_line.child_item)
							{
								%>
<div class='brv-cell-stack'>
													<del class='old-value'><span class='brv-part-main'><%=old_child_apn%></span> Rev <%=old_child_revision%><span class='brv-part-sub'><%=old_child_name%></span></del>
													<ins class='new-value'><span class='brv-part-main'><%=new_child_apn%></span> Rev <%=new_child_revision%><span class='brv-part-sub'><%=new_child_name%></span></ins>
												</div>
<%
							}
							else
							{
								%>
<div class='brv-part-main'><%=old_child_apn%> Rev <%=old_child_revision%></div>
												<div class='brv-part-sub'><%=old_child_name%></div>
<%
							}
							%>
</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(bom_line.quantity != new_line.quantity)
							{
								%>
<span class='brv-change-pair'><del class='old-value'><%=old_quantity%></del><ins class='new-value'><%=new_quantity%></ins></span>
<%
							}
							else
							{
								%>
<%=old_quantity%>
<%
							}
							%>
</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(old_ref != new_ref)
							{
								%>
<span class='brv-change-pair'><del class='old-value'><%=old_ref%></del><ins class='new-value'><%=new_ref%></ins></span>
<%
							}
							else
							{
								%>
<%=old_ref%>
<%
							}
							%>
</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(old_approval != new_approval)
							{
								%>
<span class='brv-change-pair'><del class='old-value'><%=old_approval%></del><ins class='new-value'><%=new_approval%></ins></span>
<%
							}
							else
							{
								%>
<%=old_approval%>
<%
							}
							%>
</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
							if(old_notes != new_notes)
							{
								%>
<span class='brv-change-pair'><del class='old-value'><%=old_notes%></del><ins class='new-value'><%=new_notes%></ins></span>
<%
							}
							else
							{
								%>
<%=old_notes%>
<%
							}
							%>
</td>
									</tr>
									<tr class='inserted-row'>
										<td class='brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'>
												<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
												<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Inserted</span>
											</div>
											<div class='brv-row-note'>Superseding line <%=new_line.ID%></div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><ins class='new-value'><%=new_line_number%></ins></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<ins class='new-value'><span class='brv-part-main'><%=new_child_apn%> Rev <%=new_child_revision%></span><span class='brv-part-sub'><%=new_child_name%></span></ins>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body'><ins class='new-value'><%=new_quantity%></ins></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><ins class='new-value'><%=new_ref%></ins></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><ins class='new-value'><%=new_approval%></ins></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><ins class='new-value'><%=new_notes%></ins></td>
									</tr>
<%
						}
						else
						{
							%>
<tr class='removed-row'>
										<td class='brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'>
												<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove'></i>
												<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Removed</span>
											</div>
											<div class='brv-row-note'>Superseding line not found</div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_line_number%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><span class='brv-part-main'><%=old_child_apn%> Rev <%=old_child_revision%></span><span class='brv-part-sub'><%=old_child_name%></span></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_quantity%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_ref%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_approval%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_notes%></del></td>
									</tr>
<%
						}
					}
					else if(bom_line.is_struck == true)
					{
						%>
<tr class='removed-row'>
										<td class='brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red'>
												<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove'></i>
												<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Removed</span>
											</div>
											<div class='brv-row-note'>is_struck is true</div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_line_number%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><span class='brv-part-main'><%=old_child_apn%> Rev <%=old_child_revision%></span><span class='brv-part-sub'><%=old_child_name%></span></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_quantity%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_ref%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_approval%></del></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'><del><%=old_notes%></del></td>
									</tr>
<%
					}
					else
					{
						%>
<tr>
										<td class='brv-status-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body'>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey'>
												<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
												<span class='zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body'>Unchanged</span>
											</div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=old_line_number%></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
											<div class='brv-part-main'><%=old_child_apn%> Rev <%=old_child_revision%></div>
											<div class='brv-part-sub'><%=old_child_name%></div>
										</td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=old_quantity%></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=old_ref%></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=old_approval%></td>
										<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=old_notes%></td>
									</tr>
<%
					}
				}
			}
			%>
</tbody>
						</table>
					</div>
<%
		}
		%>
</div>
<%
	}
	%>
</div>
</div>