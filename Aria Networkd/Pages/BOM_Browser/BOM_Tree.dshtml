<%
	root_item = Item_Master[ID == -1];
	apn_value = "";
	lookup_label = "";
	has_request = false;
	if(input.apn != null)
	{
		apn_value = input.apn.trim();
	}
	if(input.item_id != null && input.item_id > 0)
	{
		has_request = true;
		lookup_label = "Item ID " + input.item_id;
		root_item = Item_Master[ID == input.item_id && is_deleted == false];
	}
	else if(apn_value != "")
	{
		has_request = true;
		lookup_label = "APN " + apn_value;
		root_item = Item_Master[apn == apn_value && is_deleted == false];
	}
	root_found = false;
	if(root_item.count() > 0)
	{
		root_found = true;
		root_id = root_item.ID;
		root_apn = ifnull(root_item.apn,"-");
		root_desc = ifnull(root_item.description,"-");
		root_rev = ifnull(root_item.revision,"-");
		root_lifecycle = ifnull(root_item.lifecycle_phase,"Unreleased");
		root_life_class = "zcs-badge-yellow";
		if(root_lifecycle == "Production")
		{
			root_life_class = "zcs-badge-green";
		}
		else if(root_lifecycle == "Design")
		{
			root_life_class = "zcs-badge-blue";
		}
		else if(root_lifecycle == "Deprecated")
		{
			root_life_class = "zcs-badge-orange";
		}
		else if(root_lifecycle == "Obsolete" || root_lifecycle == "Abandoned")
		{
			root_life_class = "zcs-badge-red";
		}
		else if(root_lifecycle == "Unreleased")
		{
			root_life_class = "zcs-badge-yellow";
		}
		else
		{
			root_life_class = "zcs-badge-grey";
		}
	}
	%>
<style>
/* ZCS component CSS: zcs-global utility subset used by this page. */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-white-color: #FFFFFF;
	--zcs-black-color: #000000;
	--zcs-thead-color: #F9FAFE;
	--zcs-tr-h-color: #F9FAFE;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-w-full { width: 100%; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-6 { gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-12 { margin-top: 0.75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-overflow-auto { overflow: auto; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }
a { text-decoration: none; }

/* ZCS component CSS: table-simple-table. */
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 1120px; }
.zcs-table-wrapper table thead { top: 0px; z-index: 2; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: middle; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }

/* ZCS component CSS: badge-filled-badge. */
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }

/* ZCS component CSS: button-primary-outline-button. */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-button-icon { width: 16px; max-height: 16px; }

/* BOM Browser custom hierarchy styling. */
.bom-browser { background: var(--zcs-page-bg-color, #F3F3F4); padding: 20px; box-sizing: border-box; min-height: 100%; color: var(--zcs-primary-text-color); }
.bom-header { margin-bottom: 16px; }
.bom-header-title { display: flex; align-items: center; gap: 10px; }
.bom-header-title i { color: var(--zcs_brand_color); font-size: 22px; }
.bom-root-card { margin-bottom: 16px; }
.bom-root-grid { display: grid; grid-template-columns: minmax(220px, 1.2fr) minmax(260px, 2fr) repeat(2, minmax(120px, auto)); gap: 14px; align-items: center; }
.bom-root-label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 3px; }
.bom-root-value { color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; }
.bom-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 14px 0; flex-wrap: wrap; }
.bom-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.bom-control-disabled { opacity: 0.58; cursor: default; pointer-events: none; }
.bom-expanded-note { color: var(--zcs-secondary-text-color); font-size: 13px; }
.bom-line-cell { white-space: nowrap; }
.bom-level { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; margin-right: 8px; padding: 1px 6px; border-radius: 4px; background: #F1F2F8; color: var(--zcs-secondary-text-color); font-size: 12px; }
.bom-node { display: inline-flex; align-items: center; gap: 7px; min-width: 0; }
.bom-node i { color: var(--zcs_brand_color); font-size: 14px; }
.bom-node a { color: var(--zcs_brand_color); font-weight: 600; }
.bom-depth-1 .bom-node { padding-left: 0; }
.bom-depth-2 .bom-node { padding-left: 24px; }
.bom-depth-3 .bom-node { padding-left: 48px; }
.bom-depth-4 .bom-node { padding-left: 72px; }
.bom-depth-5 .bom-node { padding-left: 96px; }
.bom-depth-6 .bom-node { padding-left: 120px; }
.bom-depth-7 .bom-node { padding-left: 144px; }
.bom-depth-8 .bom-node { padding-left: 168px; }
.bom-row .bom-node:before { content: ''; display: inline-block; width: 14px; height: 1px; background: var(--zcs_tertiary_border_color); margin-right: 2px; }
.bom-desc { max-width: 360px; white-space: normal; }
.bom-link-stack { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.bom-mini-link { display: inline-flex; align-items: center; gap: 5px; color: var(--zcs_brand_color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 4px 8px; background: #FFFFFF; font-size: 12px; }
.bom-mini-link:hover { border-color: var(--zcs_brand_color); background: var(--zcs_component_hover_color); }
.bom-empty { padding: 28px; text-align: center; }
.bom-empty i { display: block; color: var(--zcs_brand_color); font-size: 34px; margin-bottom: 10px; }
.bom-prompt-form { display: flex; gap: 10px; justify-content: center; align-items: end; flex-wrap: wrap; margin-top: 14px; }
.bom-prompt-field { text-align: left; }
.bom-prompt-field label { display: block; color: var(--zcs-secondary-text-color); font-size: 12px; margin-bottom: 4px; }
.bom-prompt-field input { min-height: 36px; min-width: 260px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 6px; padding: 6px 10px; box-sizing: border-box; font-size: 14px; color: var(--zcs-primary-text-color); background: #FFFFFF; }
.bom-warning { margin-top: 12px; padding: 12px 14px; border: 1px solid #FAAE13; border-radius: 8px; color: #8A5B00; background: #FCF4E6; }
@media (max-width: 900px) {
	.bom-browser { padding: 12px; }
	.bom-root-grid { grid-template-columns: 1fr; }
	.bom-toolbar { align-items: flex-start; }
}
</style>

<div class='bom-browser'>
	<div class='bom-header zcs-card zcs-p-20'>
		<div class='bom-header-title'>
			<i class='zc-li-outline arrows-1-tail-right'></i>
			<div>
				<h2 class='zcs-m-0 zcs-font-22 zcs-font-semibold zcs-lh-heading zcs-color-primary'>BOM Browser</h2>
				<p class='zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary'>Multi-level assembly tree with line, child item, quantity, revision, lifecycle, and approval context.</p>
			</div>
		</div>
	</div>
<%
	if(has_request == false)
	{
		%>
<div class='bom-empty zcs-card'>
		<i class='zc-li-outline ui-1-edit-72'></i>
		<h3 class='zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary'>Enter an APN to browse its BOM</h3>
		<p class='zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary'>Provide an APN, or open this page with item_id for an exact Item Master record.</p>
		<form class='bom-prompt-form' method='get' action='#Page:BOM_Browser'>
			<div class='bom-prompt-field'>
				<label for='bom_apn'>APN</label>
				<input id='bom_apn' name='apn' type='text' placeholder='Example: ASM-00001-00'>
			</div>
			<button class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' type='submit'>
				<i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
				<span class='zcs-button-text'>Open BOM</span>
			</button>
		</form>
		<p class='zcs-m-0 zcs-mt-12 zcs-font-13 zcs-color-tertiary'>URL format: #Page:BOM_Browser?apn=YOUR_APN or #Page:BOM_Browser?item_id=123456789</p>
	</div>
<%
	}
	else if(root_found == false)
	{
		%>
<div class='bom-empty zcs-card'>
		<i class='zc-li-outline ui-2-time'></i>
		<h3 class='zcs-m-0 zcs-font-18 zcs-font-semibold zcs-color-primary'>No Item Master record found</h3>
		<p class='zcs-m-0 zcs-mt-8 zcs-font-14 zcs-color-secondary'>Could not resolve <strong><%=lookup_label%></strong>. Check that the item exists and is not deleted.</p>
		<form class='bom-prompt-form' method='get' action='#Page:BOM_Browser'>
			<div class='bom-prompt-field'>
				<label for='bom_apn_retry'>Try another APN</label>
				<input id='bom_apn_retry' name='apn' type='text' placeholder='Enter APN'>
			</div>
			<button class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' type='submit'>
				<i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
				<span class='zcs-button-text'>Open BOM</span>
			</button>
		</form>
	</div>
<%
	}
	else
	{
		%>
<div class='bom-root-card zcs-card zcs-p-20'>
		<div class='bom-root-grid'>
			<div>
				<span class='bom-root-label'>Root APN</span>
				<span class='bom-root-value'><%=root_apn%></span>
			</div>
			<div>
				<span class='bom-root-label'>Description</span>
				<span class='bom-root-value'><%=root_desc%></span>
			</div>
			<div>
				<span class='bom-root-label'>Revision</span>
				<span class='bom-root-value'><%=root_rev%></span>
			</div>
			<div>
				<span class='bom-root-label'>Lifecycle</span>
				<span class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=root_life_class%>'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=root_lifecycle%></span></span>
			</div>
		</div>
	</div>

	<div class='bom-toolbar'>
		<div>
			<div class='zcs-font-16 zcs-font-semibold zcs-color-primary'>Expanded BOM Tree</div>
			<div class='bom-expanded-note'>Rendered expanded by default. Depth cap: 8 levels to avoid execution limits.</div>
		</div>
		<div class='bom-toolbar-actions'>
			<span class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-control-disabled'>
				<i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
				<span class='zcs-button-text'>Expand All</span>
			</span>
			<span class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body bom-control-disabled'>
				<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
				<span class='zcs-button-text'>Collapse All</span>
			</span>
			<a class='zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:All_Items?ID=<%=root_id%>' target='_self'>
				<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
				<span class='zcs-button-text'>Open Root Item</span>
			</a>
		</div>
	</div>

	<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
		<table class='zcs-w-full'>
			<thead class='zcs-sticky'>
				<tr>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Line</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Child APN</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Description</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Quantity</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Revision</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Lifecycle</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Approval</th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Links</th>
				</tr>
				<tr class='zcs-tspace'><th class='zcs-py-2 zcs-box-border' colspan='8'></th></tr>
			</thead>
			<tbody>
<%
		row_count = 0;
		cap_hit = false;
		for each  line1 in BOM_Line[parent_item == root_id && is_struck == false] sort by line_number asc
		{
			row_count = row_count + 1;
			child1 = Item_Master[ID == line1.child_item && is_deleted == false];
			child1_found = child1.count() > 0;
			if(child1_found)
			{
				child1_id = child1.ID;
				child1_apn = ifnull(child1.apn,"-");
				child1_desc = ifnull(child1.description,"-");
				child1_rev = ifnull(child1.revision,"-");
				child1_lifecycle = ifnull(child1.lifecycle_phase,"Unreleased");
			}
			else
			{
				child1_id = 0;
				child1_apn = "Missing item";
				child1_desc = "The child lookup could not be resolved.";
				child1_rev = "-";
				child1_lifecycle = "Unknown";
			}
			life1_class = "zcs-badge-yellow";
			if(child1_lifecycle == "Production")
			{
				life1_class = "zcs-badge-green";
			}
			else if(child1_lifecycle == "Design")
			{
				life1_class = "zcs-badge-blue";
			}
			else if(child1_lifecycle == "Deprecated")
			{
				life1_class = "zcs-badge-orange";
			}
			else if(child1_lifecycle == "Obsolete" || child1_lifecycle == "Abandoned")
			{
				life1_class = "zcs-badge-red";
			}
			else if(child1_lifecycle == "Unreleased")
			{
				life1_class = "zcs-badge-yellow";
			}
			else
			{
				life1_class = "zcs-badge-grey";
			}
			approval1 = ifnull(line1.manufacturer_approval_status,"Pending_Review");
			approval1_display = approval1.replaceAll("_"," ");
			approval1_class = "zcs-badge-orange";
			if(approval1 == "Approved")
			{
				approval1_class = "zcs-badge-green";
			}
			else if(approval1 == "Unapproved")
			{
				approval1_class = "zcs-badge-red";
			}
			%>
<tr class='bom-row bom-depth-1'>
					<td class='bom-line-cell zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='bom-level'>L1</span><%=ifnull(line1.line_number,"-")%></td>
					<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><span class='bom-node'><i class='zc-li-outline arrows-1-tail-right'></i>
<%
			if(child1_found)
			{
				%>
