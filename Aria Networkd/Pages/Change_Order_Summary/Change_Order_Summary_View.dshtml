<%
	co_list = Change_Order[ID == input.change_order_id];
	recordFound = co_list.count() > 0;
	if(recordFound)
	{
		co_rec = co_list;
		statusText = ifnull(co_rec.status,"Open");
		categoryText = ifnull(co_rec.change_category,"Not set");
		titleText = ifnull(co_rec.title,"Untitled Change Order");
		descriptionText = ifnull(co_rec.description,"No description provided.");
		orderIdText = ifnull(co_rec.order_id,co_rec.ID.toString());
		effectivityText = ifnull(co_rec.effectivity_type,"Not set");
		effectiveDateText = ifnull(co_rec.effective_date,"Not scheduled");
		expirationDateText = ifnull(co_rec.expiration_date,"Not set");
		createdDateText = ifnull(co_rec.created_date,"Not recorded");
		releaseAttemptText = ifnull(co_rec.release_last_attempt_on,"No release attempt recorded");
		estimatedCostText = ifnull(co_rec.estimated_cost_impact,"0.00");
		maxUnits = ifnull(co_rec.max_unit_count,0);
		unitsUsed = ifnull(co_rec.units_consumed,0);
		remainingUnits = maxUnits - unitsUsed;
		usagePct = 0;
		if(maxUnits > 0)
		{
			usagePct = (unitsUsed * 100) / maxUnits;
			if(usagePct > 100)
			{
				usagePct = 100;
			}
		}
		releaseError = ifnull(co_rec.release_error_flag,false);
		releaseErrorText = if(releaseError == true,"Yes","No");
		releaseDetails = ifnull(co_rec.release_error_details,"");
		costRuleCount = 0;
		for each  cost_row in co_rec.approvers
		{
			if(cost_row.added_by_cost_rule == true)
			{
				costRuleCount = costRuleCount + 1;
			}
		}
		creatorName = "Not recorded";
		if(co_rec.created_by_employee != null)
		{
			creator_rec = Employee_Master[ID == co_rec.created_by_employee];
			if(creator_rec.count() > 0)
			{
				creatorName = creator_rec.employee_name;
			}
		}
		alternativeText = "Not set";
		if(co_rec.alternative_component != null)
		{
			alt_item = Item_Master[ID == co_rec.alternative_component];
			if(alt_item.count() > 0)
			{
				alternativeText = alt_item.apn;
			}
			else
			{
				alternativeText = co_rec.alternative_component.toString();
			}
		}
		statusBadgeClass = "zcs-badge-blue";
		if(statusText == "Approved" || statusText == "Effective" || statusText == "Complete")
		{
			statusBadgeClass = "zcs-badge-green";
		}
		if(statusText == "Rejected")
		{
			statusBadgeClass = "zcs-badge-red";
		}
		if(statusText == "Cancelled" || statusText == "Expired")
		{
			statusBadgeClass = "zcs-badge-grey";
		}
		stages = {"Open","Submitted","Approval_In_Progress","Approved","Effective","Complete"};
		stageIndex = stages.indexOf(statusText);
		if(stageIndex < 0)
		{
			stageIndex = 0;
		}
		stageFail = false;
		if(statusText == "Rejected")
		{
			stageIndex = 2;
			stageFail = true;
		}
		else if(statusText == "Cancelled")
		{
			stageIndex = 0;
			stageFail = true;
		}
		else if(statusText == "Expired")
		{
			stageIndex = 4;
			stageFail = true;
		}
		if(releaseError == true)
		{
			stageFail = true;
			if(statusText == "Approved")
			{
				if(categoryText == "Deviation")
				{
					stageIndex = 4;
				}
				else
				{
					stageIndex = 5;
				}
			}
		}
	}
	%>
<style>
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-col-common { flex: 1 1 0%; }
.zcs-col-3 { flex: 0 0 25%; max-width: 25%; }
.zcs-col-4 { flex: 0 0 33.3333%; max-width: 33.3333%; }
.zcs-col-6 { flex: 0 0 50%; max-width: 50%; }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-2 { padding: .125rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-15 { padding-left: .9375rem; padding-right: .9375rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-w-full { width: 100%; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-list-none { list-style-type: none; }
.zcs-break-words { overflow-wrap: break-word; }

.zcs-outline-toast { border: 1px solid; }
.zcs-theme-toast { background-color: var(--zcs_component_hover_color); }
.zcs-outline-toast.zcs-theme-toast { border-color: var(--zcs_brand_color); }
.zcs-success-toast { background-color: #edf7ed; color: #1d4620; }
.zcs-info-toast { background-color: #e4f6fd; color: #024361; }
.zcs-warning-toast { background-color: #fef4e5; color: #663c01; }
.zcs-error-toast { background-color: #feedec; color: #5f2120; }
.zcs-toast-icon { font-size: 18px; margin-top: 1px; }

.zcs-badge { width: auto; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }

.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }

:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }
.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }

.zcs-stepper-status { width: 32px; height: 32px; border: 4px solid var(--zcs-white-color); }
.zcs-stepper:not(:last-child):before { content: ''; width: 100%; height: 1px; border-top: 1px solid var(--co-line-color, var(--zcs_tertiary_border_color)); box-sizing: border-box; position: absolute; top: calc((32px - 1px) / 2); left: 50%; }

.co-summary-page { background: #F3F3F4; padding: 20px; min-height: 100%; box-sizing: border-box; color: var(--zcs-primary-text-color); }
.co-header { padding: 20px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
.co-eyebrow { color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .04em; font-size: 12px; font-weight: 700; margin: 0 0 6px; }
.co-title { margin: 0; font-size: 24px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }
.co-description { margin: 8px 0 0; color: var(--zcs-secondary-text-color); max-width: 980px; white-space: pre-line; }
.co-card { padding: 18px; margin-top: 16px; }
.co-section-title { font-size: 16px; font-weight: 700; margin: 0 0 12px; color: var(--zcs-primary-text-color); }
.co-muted { color: var(--zcs-teritiary-text-color); }
.co-status-stepper { padding: 10px 0 2px; }
.co-status-stepper ul { list-style: none; }
.co-status-stepper .zcs-stepper-text { word-break: break-word; }
.co-stage-green { --co-line-color: #179E6C; }
.co-stage-blue { --co-line-color: #2A6FFC; }
.co-stage-red { --co-line-color: #FE455D; }
.co-stage-grey { --co-line-color: var(--zcs_tertiary_border_color); }
.co-stage-green .zcs-stepper-status { background: #179E6C; color: #FFFFFF; }
.co-stage-blue .zcs-stepper-status { background: #2A6FFC; color: #FFFFFF; }
.co-stage-red .zcs-stepper-status { background: #FE455D; color: #FFFFFF; }
.co-stage-grey .zcs-stepper-status { background: #FFFFFF; color: var(--zcs-placeholder-color); border: 1px solid var(--zcs_tertiary_border_color); }
.co-stage-green .zcs-stepper-text { color: #179E6C; font-weight: 600; }
.co-stage-blue .zcs-stepper-text { color: #2A6FFC; font-weight: 600; }
.co-stage-red .zcs-stepper-text { color: #FE455D; font-weight: 700; }
.co-stage-grey .zcs-stepper-text { color: var(--zcs-teritiary-text-color); }
.co-stage-icon { font-size: 18px; line-height: 1; }
.co-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
.co-detail-grid .co-card { margin-top: 0; }
.co-value-long { white-space: pre-line; }
.co-release-box { border: 1px solid var(--zcs_tertiary_border_color); background: #FFFFFF; border-radius: 10px; padding: 12px; min-height: 58px; color: var(--zcs-secondary-text-color); white-space: pre-line; }
.co-usage-track { height: 8px; background: #EAEBF9; border-radius: 999px; overflow: hidden; margin-top: 8px; }
.co-usage-fill { height: 8px; background: #2A6FFC; border-radius: 999px; }
.co-usage-fill.co-over { background: #FE455D; }
.co-banner-stack { display: grid; gap: 10px; margin-bottom: 16px; }
.co-not-found { max-width: 760px; margin: 40px auto; }
@media (max-width: 992px) { .zcs-col-sm-6 { flex: 0 0 50%; max-width: 50%; } .co-detail-grid { grid-template-columns: 1fr; } }
@media (max-width: 575px) { .co-summary-page { padding: 12px; } .co-header { flex-direction: column; } .zcs-col-3, .zcs-col-4, .zcs-col-6, .zcs-col-sm-6 { flex: 0 0 100%; max-width: 100%; } .co-status-stepper ul { flex-direction: column; gap: 20px; } .co-status-stepper ul .zcs-stepper { flex-direction: row; text-align: left; } .zcs-stepper:not(:last-child):before { width: 1px; height: 100%; border-left: 1px solid var(--co-line-color, var(--zcs_tertiary_border_color)); border-top: 0; left: calc((32px - 1px) / 2); top: 32px; } }
</style>
<%
	if(recordFound == false)
	{
		%>
<div class="co-summary-page">
		<div class="co-not-found zcs-card co-card">
				<div class="zcs-toast zcs-outline-toast zcs-info-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
						<i class="zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info"></i>
						<div class="zcs-toast-text">
								<p class="zcs-m-0">No Change Order was found for ID <%=input.change_order_id%>.</p>
						</div>
				</div>
		</div>
</div>
<%
	}
	else
	{
		%>
<div class="co-summary-page">
		<div class="co-header zcs-card">
				<div>
						<p class="co-eyebrow">Change Order Summary</p>
						<h1 class="co-title"><%=orderIdText%> - <%=titleText%></h1>
						<p class="co-description"><%=descriptionText%></p>
				</div>
				<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusBadgeClass%>">
						<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=statusText%></span>
				</div>
		</div>

		<div class="co-banner-stack">
<%
		if(statusText == "Rejected")
		{
			%>
<div class="zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
						<i class="zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove"></i>
						<div class="zcs-toast-text"><p class="zcs-m-0">This Change Order has been rejected. Review approver decisions and timestamps below before resubmission.</p></div>
				</div>
<%
		}
		if(statusText == "Cancelled")
		{
			%>
<div class="zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
						<i class="zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info"></i>
						<div class="zcs-toast-text"><p class="zcs-m-0">This Change Order is cancelled. Its status bar is stopped at the cancellation point.</p></div>
				</div>
<%
		}
		if(statusText == "Expired")
		{
			%>
<div class="zcs-toast zcs-outline-toast zcs-warning-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
						<i class="zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-2-time"></i>
						<div class="zcs-toast-text"><p class="zcs-m-0">This Change Order has expired. Check expiration date and deviation usage before taking further action.</p></div>
				</div>
<%
		}
		if(releaseError == true)
		{
			%>
<div class="zcs-toast zcs-outline-toast zcs-error-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
						<i class="zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-circle-remove"></i>
						<div class="zcs-toast-text"><p class="zcs-m-0">Release processing reported an error. Details and last attempt time are shown in the Release section.</p></div>
				</div>
<%
		}
		%>
</div>

		<div class="zcs-card co-card">
				<h2 class="co-section-title">Lifecycle status</h2>
				<div class="zcs-stepper-wrapper co-status-stepper">
						<ul class="zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0">
<%
		stageNo = 0;
		for each  stageName in stages
		{
			stageState = "co-stage-grey";
			stageIcon = "zc-li-outline ui-2-time";
			if(statusText == "Complete" && stageNo <= stageIndex)
			{
				stageState = "co-stage-green";
				stageIcon = "zc-li-outline ui-1-check-small";
			}
			else if(stageFail == true && stageNo == stageIndex)
			{
				stageState = "co-stage-red";
				stageIcon = "zc-li-outline ui-1-circle-remove";
			}
			else if(stageNo < stageIndex)
			{
				stageState = "co-stage-green";
				stageIcon = "zc-li-outline ui-1-check-small";
			}
			else if(stageNo == stageIndex)
			{
				stageState = "co-stage-blue";
				stageIcon = "zc-li-outline ui-2-time";
			}
			%>
<li class="zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative <%=stageState%>">
										<div class="zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border">
												<i class="co-stage-icon <%=stageIcon%>"></i>
										</div>
										<span class="zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=stageName%></span>
								</li>
<%
			stageNo = stageNo + 1;
		}
		%>
</ul>
				</div>
		</div>

		<div class="co-detail-grid">
				<div class="zcs-card co-card">
						<h2 class="co-section-title">Category and cost</h2>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
								<ul class="zcs-row zcs-p-0 zcs-m-0 zcs-list-none">
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Category</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=categoryText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Estimated Cost Impact</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">INR <%=estimatedCostText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Created By</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=creatorName%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Cost Rule Approvers</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=costRuleCount%></h6>
										</li>
								</ul>
						</div>
				</div>

				<div class="zcs-card co-card">
						<h2 class="co-section-title">Effectivity and dates</h2>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
								<ul class="zcs-row zcs-p-0 zcs-m-0 zcs-list-none">
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Effectivity Type</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=effectivityText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Effective Date</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=effectiveDateText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Expiration Date</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=expirationDateText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Created Date</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=createdDateText%></h6>
										</li>
								</ul>
						</div>
				</div>
		</div>

		<div class="co-detail-grid">
				<div class="zcs-card co-card">
						<h2 class="co-section-title">Deviation usage</h2>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
								<ul class="zcs-row zcs-p-0 zcs-m-0 zcs-list-none">
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Max Unit Count</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">
<%
		if(maxUnits > 0)
		{
			%>
<%=maxUnits%>
<%
		}
		else
		{
			%>
Not capped
<%
		}
		%>
</h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Units Consumed</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=unitsUsed%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Units Remaining</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">
<%
		if(maxUnits > 0)
		{
			%>
<%=remainingUnits%>
<%
		}
		else
		{
			%>
Not capped
<%
		}
		%>
</h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Alternative Component</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=alternativeText%></h6>
												<div class="co-usage-track"><div class="co-usage-fill style="width:<%=usagePct%>%;"></div></div>
										</li>
								</ul>
						</div>
				</div>

				<div class="zcs-card co-card">
						<h2 class="co-section-title">Release status</h2>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
								<ul class="zcs-row zcs-p-0 zcs-m-0 zcs-list-none">
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Release Error Flag</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=releaseErrorText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Release Last Attempt On</label>
												<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=releaseAttemptText%></h6>
										</li>
										<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-px-15 zcs-py-10 zcs-box-border">
												<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">Release Error Details</label>
												<div class="co-release-box">
<%
		if(releaseDetails == "")
		{
			%>
No release errors recorded.
<%
		}
		else
		{
			%>
<%=releaseDetails%>
<%
		}
		%>
</div>
										</li>
								</ul>
						</div>
				</div>
		</div>

		<div class="zcs-card co-card">
				<h2 class="co-section-title">Approver decisions</h2>
				<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
						<table class="zcs-w-full">
								<thead class="zcs-sticky">
										<tr>
												<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Approver</th>
												<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Sequence</th>
												<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Decision</th>
												<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Decided On</th>
												<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Cost Rule Flag</th>
										</tr>
										<tr class="zcs-tspace"><th class="zcs-p-2 zcs-box-border" colspan="5"></th></tr>
								</thead>
								<tbody>
<%
		approverRows = 0;
		for each  app_row in co_rec.approvers
		{
			approverRows = approverRows + 1;
			approverName = "Not assigned";
			if(app_row.approver != null)
			{
				app_emp = Employee_Master[ID == app_row.approver];
				if(app_emp.count() > 0)
				{
					approverName = app_emp.employee_name;
				}
			}
			decisionText = ifnull(app_row.decision,"Pending");
			decisionClass = "zcs-yellow";
			decisionBadgeClass = "zcs-badge-yellow";
			if(decisionText == "Approved")
			{
				decisionClass = "zcs-green";
				decisionBadgeClass = "zcs-badge-green";
			}
			else if(decisionText == "Rejected")
			{
				decisionClass = "zcs-red";
				decisionBadgeClass = "zcs-badge-red";
			}
			decidedOnText = ifnull(app_row.decided_on,"Pending");
			costRuleText = if(app_row.added_by_cost_rule == true,"Yes","No");
			costRuleBadgeClass = if(app_row.added_by_cost_rule == true,"zcs-badge-orange","zcs-badge-grey");
			%>
<tr>
												<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=approverName%></td>
												<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(app_row.sequence_no,"-")%></td>
												<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body <%=decisionClass%>">
														<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=decisionBadgeClass%>">
																<span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body"><%=decisionText%></span>
														</div>
												</td>
												<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=decidedOnText%></td>
												<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary">
														<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=costRuleBadgeClass%>">
																<span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body"><%=costRuleText%></span>
														</div>
												</td>
										</tr>
<%
		}
		if(approverRows == 0)
		{
			%>
<tr>
												<td colspan="5" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary">No approver routing rows are attached to this Change Order.</td>
										</tr>
<%
		}
		%>
</tbody>
						</table>
				</div>
		</div>
</div>
<%
	}
%>