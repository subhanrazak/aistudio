form Approval_Matrix_Line
{

			displayname = "Approval Matrix Line"
			Approval_Routing
			(
				type = section
				displayname = "Approval Routing"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have approver
			(
				type = picklist	
				displayname = "Approver"
				values  = Employee_Master[is_active == true].ID
    			displayformat = [employee_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have sequence_no
			(
				type = number
				displayname = "Sequence No"
	 			row = 1
	 			column = 2   
				width = medium
			)
			decision
			(
				type = picklist
				displayname = "Decision"
				values = {"Pending","Approved","Rejected"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			decided_on
			(
    			type = datetime
				displayname = "Decided On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			added_by_cost_rule
			(
    			type = checkbox
				displayname = "Added By Cost Rule"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}