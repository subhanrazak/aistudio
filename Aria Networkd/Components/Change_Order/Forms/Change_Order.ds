form Change_Order
{

			displayname = "Change Order"
			Main
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique order_id
			(
    			type = text
				displayname = "Order ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			source_request
			(
				type = picklist	
				displayname = "Source Request"
				values  = Change_Request.ID
    			displayformat = [request_id]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have change_category
			(
				type = picklist
				displayname = "Change Category"
				values = {"Engineering_ECO","Manufacturing_MCO","Process_PCO","Deviation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have description
			(
    			type = textarea
				displayname = "Description"
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_cost_impact
			(
				displayname = "Estimated Cost Impact"
				type = INR
				maxchar = 16
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have effectivity_type
			(
				type = picklist
				displayname = "Effectivity Type"
				values = {"Permanent_Immediate","Permanent_Scheduled","Temporary_Deviation"}
				initial value = "Permanent_Immediate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			effective_date
			(
    			type = date
				displayname = "Effective Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			expiration_date
			(
    			type = date
				displayname = "Expiration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			max_unit_count
			(
				type = number
				displayname = "Max Unit Count"
	 			row = 1
	 			column = 2   
				width = medium
			)
			alternative_component
			(
				type = picklist	
				displayname = "Alternative Component"
				values  = Item_Master[is_deleted == false].ID
    			displayformat = [apn]
	 			row = 1
	 			column = 1   
				width = medium
			)
			units_consumed
			(
				type = number
				displayname = "Units Consumed"
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Open","Submitted","Approval_In_Progress","Approved","Rejected","Effective","Complete","Cancelled","Expired"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have created_by_employee
			(
				type = picklist	
				displayname = "Created By Employee"
				values  = Employee_Master[is_active == true].ID
    			displayformat = [employee_name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			unit_cap_warning_shown
			(
    			type = checkbox
				displayname = "Unit Cap Warning Shown"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			release_error_flag
			(
    			type = checkbox
				displayname = "Release Error Flag"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			release_error_details
			(
    			type = textarea
				displayname = "Release Error Details"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			release_last_attempt_on
			(
    			type = datetime
				displayname = "Release Last Attempt On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Affected_Items_Section
			(
				type = section
				displayname = "Affected Items"
	 			row = 2
	 			column = 0   
				width = medium
			)
			affected_items
			(
				type = grid
				displayname = "Affected Items"
				values  = Change_Order_Affected_Item.ID
	 			row = 2
	 			column = 1   
				width = medium
			)
			Disposition_Section
			(
				type = section
				displayname = "Disposition"
	 			row = 3
	 			column = 0   
				width = medium
			)
			disposition
			(
				type = grid
				displayname = "Disposition"
				values  = Change_Order_Disposition.ID
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approvers_Section
			(
				type = section
				displayname = "Approvers"
	 			row = 4
	 			column = 0   
				width = medium
			)
			approvers
			(
				type = grid
				displayname = "Approvers"
				values  = Approval_Matrix_Line.ID
				sorttype = fieldbased
				sort by
				(
					sequence_no ascending
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}