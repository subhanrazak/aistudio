Force_Approval as "Force Approval"
{

				type =  functions
				form = Change_Order
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
										emp_rec = Employee_Master[ID == emp_id];
										if(emp_rec.count() > 0 && emp_rec.profile_label == "ADMIN" && input.status == "Approval_In_Progress")
										{
											for each  app_row in input.approvers
											{
												if(app_row.decision == "Pending")
												{
													app_row.decision="Approved";
													app_row.decided_on=zoho.currenttime;
												}
											}
											old_status = input.status;
											input.status = "Approved";
											thisapp.Write_Activity_Log("Change_Order",input.order_id,"status",old_status,"Approved",input.created_by_employee);
										}
					)
					}
				}
			
}