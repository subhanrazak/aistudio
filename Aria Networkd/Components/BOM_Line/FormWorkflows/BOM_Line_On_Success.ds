BOM_Line_On_Success as "BOM Line - On Success"
{

				type =  form
				form = BOM_Line

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.parent_item != null)
										{
											thisapp.Write_Activity_Log("BOM_Line",input.ID.toString(),"bom_line","","Saved BOM line",null);
										}
						)
					}
				}

			
}