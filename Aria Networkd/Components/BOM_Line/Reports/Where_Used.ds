default list Where_Used
{

			displayName = "Where Used"
			show all rows from BOM_Line    
			(
				parent_item
				child_item
				line_number
				quantity
				(
					display = total	
				)
				reference_designator
				manufacturer_approval_status
				is_struck
				(
						displaytrue = "Struck"
						displayfalse = "Active"
				)
			)
			filters
			(
				child_item
				parent_item
				manufacturer_approval_status
				is_struck
			)
			sort by
			(
				parent_item ascending
				child_item ascending
			)
		
}