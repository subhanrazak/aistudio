form BOM_Line
{

			displayname = "BOM Line"
			BOM_Line_Details
			(
				type = section
				displayname = "BOM Line Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			parent_item
			(
				type = picklist	
				displayname = "Parent Item"
				values  = Item_Master.ID
    			displayformat = [apn]
	 			row = 1
	 			column = 1   
				width = medium
			)
			line_number
			(
				type = number
				displayname = "Line Number"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have child_item
			(
				type = picklist	
				displayname = "Child Item"
				values  = Item_Master.ID
    			displayformat = [apn]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have quantity
			(
				type = decimal
				displayname = "Quantity"
				decimalplace = 3
	 			row = 1
	 			column = 2   
				width = medium
			)
			reference_designator
			(
    			type = textarea
				displayname = "Reference Designator"
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)
			manufacturer_approval_status
			(
				type = picklist
				displayname = "Manufacturer Approval Status"
				values = {"Approved","Unapproved","Pending_Review"}
				initial value = "Pending_Review"
	 			row = 1
	 			column = 2   
				width = medium
			)
			bom_notes
			(
    			type = textarea
				displayname = "BOM Notes"
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_struck
			(
    			type = checkbox
				displayname = "Is Struck"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			superseded_by
			(
				type = picklist	
				displayname = "Superseded By"
				values  = BOM_Line.ID
    			displayformat = [line_number]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}