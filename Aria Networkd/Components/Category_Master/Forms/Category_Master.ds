form Category_Master
{

			displayname = "Category Master"
			Category_Details
			(
				type = section
				displayname = "Category Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique category_name
			(
    			type = text
				displayname = "Category Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique prefix
			(
    			type = text
				displayname = "Prefix"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have item_group
			(
				type = picklist
				displayname = "Item Group"
				values = {"Electrical_Component","Mechanical_Component","Assembly","Document","Software_Firmware","Packaging"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have item_type
			(
				type = picklist
				displayname = "Item Type"
				values = {"Library_Component","Assembly_Component"}
				initial value = "Library_Component"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have id_digit_length
			(
				type = number
				displayname = "ID Digit Length"
				initial value = 5
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have version_digit_length
			(
				type = number
				displayname = "Version Digit Length"
				initial value = 2
	 			row = 1
	 			column = 2   
				width = medium
			)
			last_issued_number
			(
				type = number
				displayname = "Last Issued Number"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}