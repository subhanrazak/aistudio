default list Employee_Master_List
{

			displayName = "Employee Master List"
			show all rows from Employee_Master    
			(
				employee_name
				creator_user
				email
				profile_label
				department
				is_active
				(
						displaytrue = "Active"
						displayfalse = "Inactive"
				)
				notification_opt_in
				(
						displaytrue = "Opted In"
						displayfalse = "Opted Out"
				)
			)
			filters
			(
				profile_label
				department
				is_active
			)
			sort by
			(
				employee_name ascending
			)
		
}