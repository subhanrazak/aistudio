form Employee_Master
{

			displayname = "Employee Master"
			Employee_Details
			(
				type = section
				displayname = "Employee Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have employee_name
			(
    			type = text
				displayname = "Employee Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique creator_user
			(
    			type = picklist
				displayname = "Creator User"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have unique email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have profile_label
			(
				type = picklist
				displayname = "Profile Label"
				values = {"ENGINEER","PRODUCT_CHANGE_ANALYST","MANUFACTURING_LEAD","QUALITY_APPROVER","PROCUREMENT_APPROVER","FINANCE_APPROVER","ADMIN"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			department
			(
    			type = text
				displayname = "Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			notification_opt_in
			(
    			type = checkbox
				displayname = "Notification Opt In"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}