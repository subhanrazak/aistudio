form New_Item_Request
{

			displayname = "New Item Request"
			Request_Details
			(
				type = section
				displayname = "Request Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique nir_id
			(
    			type = text
				displayname = "NIR ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have category
			(
				type = picklist	
				displayname = "Category"
				values  = Category_Master[is_active == true].ID
    			displayformat = [category_name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			item_type_derived
			(
    			type = text
				displayname = "Item Type Derived"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			manufacturer
			(
    			type = text
				displayname = "Manufacturer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			part_number
			(
    			type = text
				displayname = "Part Number"
	 			row = 1
	 			column = 2   
				width = medium
			)
			package
			(
    			type = text
				displayname = "Package"
	 			row = 1
	 			column = 1   
				width = medium
			)
			datasheet_links
			(
    			type = textarea
				displayname = "Datasheet Links"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have raised_by_employee
			(
				type = picklist	
				displayname = "Raised By Employee"
				values  = Employee_Master[is_active == true].ID
    			displayformat = [employee_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","PCA_Review","Library_Review","Approved","Rejected"}
				initial value = "Submitted"
	 			row = 1
	 			column = 2   
				width = medium
			)
			pca_remarks
			(
    			type = textarea
				displayname = "PCA Remarks"
				height = 80px
	 			row = 1
	 			column = 1   
				width = medium
			)
			rejection_reason
			(
    			type = textarea
				displayname = "Rejection Reason"
				height = 80px
	 			row = 1
	 			column = 2   
				width = medium
			)
			request_datetime
			(
    			type = datetime
				displayname = "Request Date Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			apn
			(
    			type = text
				displayname = "APN"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Technical_Details
			(
				type = section
				displayname = "Technical Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			mpn
			(
    			type = text
				displayname = "MPN"
	 			row = 2
	 			column = 1   
				width = medium
			)
			package_detail
			(
    			type = text
				displayname = "Package Detail"
	 			row = 2
	 			column = 2   
				width = medium
			)
			single_source
			(
				type = picklist
				displayname = "Single Source"
				values = {"Yes","No","Unknown"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			supply_risk
			(
    			type = text
				displayname = "Supply Risk"
	 			row = 2
	 			column = 2   
				width = medium
			)
			rohs
			(
    			type = text
				displayname = "ROHS"
	 			row = 2
	 			column = 1   
				width = medium
			)
			schematic_symbol_name
			(
    			type = text
				displayname = "Schematic Symbol Name"
	 			row = 2
	 			column = 2   
				width = medium
			)
			footprint_name
			(
    			type = text
				displayname = "Footprint Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			alternate_status
			(
    			type = text
				displayname = "Alternate Status"
	 			row = 2
	 			column = 2   
				width = medium
			)
			mech_3d
			(
    			type = text
				displayname = "Mech 3D"
	 			row = 2
	 			column = 1   
				width = medium
			)
			alternate_1_schematic_symbol
			(
    			type = text
				displayname = "Alternate 1 Schematic Symbol"
	 			row = 2
	 			column = 2   
				width = medium
			)
			alternate_2_schematic_symbol
			(
    			type = text
				displayname = "Alternate 2 Schematic Symbol"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Alternate_Manufacturers
			(
				type = section
				displayname = "Alternate Manufacturers"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			alternate_1_manufacturer
			(
				type = picklist	
				displayname = "Alternate 1 Manufacturer"
				values  = Manufacturer_Master[is_active == true].ID
    			displayformat = [manufacturer_name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			alternate_1_mpn
			(
    			type = text
				displayname = "Alternate 1 MPN"
	 			row = 3
	 			column = 2   
				width = medium
			)
			alternate_2_manufacturer
			(
				type = picklist	
				displayname = "Alternate 2 Manufacturer"
				values  = Manufacturer_Master[is_active == true].ID
    			displayformat = [manufacturer_name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			alternate_2_mpn
			(
    			type = text
				displayname = "Alternate 2 MPN"
	 			row = 3
	 			column = 2   
				width = medium
			)
			alternate_3_manufacturer
			(
				type = picklist	
				displayname = "Alternate 3 Manufacturer"
				values  = Manufacturer_Master[is_active == true].ID
    			displayformat = [manufacturer_name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			alternate_3_mpn
			(
    			type = text
				displayname = "Alternate 3 MPN"
	 			row = 3
	 			column = 2   
				width = medium
			)
			comments
			(
    			type = textarea
				displayname = "Comments"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}