form Activity_Log
{

			displayname = "Activity Log"
			Main
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique log_id
			(
    			type = text
				displayname = "Log ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			activity_record_type
			(
				type = picklist
				displayname = "Record Type"
				values = {"Item_Master","Change_Request","Change_Order","Approval_Remarks","Item_Subscription","BOM_Line","ECN_Acknowledgment","Deviation_Consumption_Entry","New_Item_Request"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			record_id
			(
    			type = text
				displayname = "Record ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			field_changed
			(
    			type = text
				displayname = "Field Changed"
	 			row = 1
	 			column = 2   
				width = medium
			)
			old_value
			(
    			type = text
				displayname = "Old Value"
	 			row = 1
	 			column = 1   
				width = medium
			)
			new_value
			(
    			type = text
				displayname = "New Value"
	 			row = 1
	 			column = 2   
				width = medium
			)
			changed_by_employee
			(
				type = picklist	
				displayname = "Changed By Employee"
				values  = Employee_Master.ID
    			displayformat = [employee_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			changed_on
			(
    			type = datetime
				displayname = "Changed On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}