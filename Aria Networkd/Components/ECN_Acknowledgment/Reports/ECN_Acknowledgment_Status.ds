default list ECN_Acknowledgment_Status
{

			displayName = "ECN Acknowledgment Status"
			show all rows from ECN_Acknowledgment    
			(
				change_order
				recipient_employee
				status
				acknowledged_on
				(
					displayformat = dateonly
				)
				comments
				(
					foldcontent = enable
				)
			)
			filters
			(
				change_order
				recipient_employee
				status
			)
			sort by
			(
				acknowledged_on ascending
			)
			conditional formatting
			(
				"Pending"
				{
				condition = (status == "Pending")
				fields = [change_order, recipient_employee, status]
				format = "background-color:#FEF3C7;color:#92400E;font-weight:bold"
				}
				"Acknowledged"
				{
				condition = (status == "Acknowledged")
				fields = [change_order, recipient_employee, status]
				format = "background-color:#DCFCE7;color:#166534"
				}
			)
		
}