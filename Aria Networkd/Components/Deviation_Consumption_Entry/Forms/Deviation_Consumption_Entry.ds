form Deviation_Consumption_Entry
{

			displayname = "Deviation Consumption Entry"
			Main
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have linked_deviation
			(
				type = picklist	
				displayname = "Linked Deviation"
				values  = Change_Order[change_category == "Deviation" && status == "Effective"].ID
    			displayformat = [order_id]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have units_built_this_batch
			(
				type = number
				displayname = "Units Built This Batch"
	 			row = 1
	 			column = 2   
				width = medium
			)
			batch_reference
			(
    			type = text
				displayname = "Batch Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have recorded_by_employee
			(
				type = picklist	
				displayname = "Recorded By Employee"
				values  = Employee_Master[is_active == true].ID
    			displayformat = [employee_name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have recorded_on
			(
    			type = datetime
				displayname = "Recorded On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}