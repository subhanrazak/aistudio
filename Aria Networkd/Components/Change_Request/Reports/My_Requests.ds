default list My_Requests
{

			displayName = "My Requests"
			show all rows from Change_Request    
			(
				request_id
				request_type
				title
				status
				requested_by_employee
				created_date
			)
			filters
			(
				request_type
				status
				requested_by_employee
			)
			sort by
			(
				created_date descending
			)
			conditional formatting
			(
				"Rejected Request"
				{
				condition = (status == "Rejected")
				fields = [request_id, status]
				format = "background-color:#FFE0E0;color:#A00000;font-weight:bold"
				}
			)
		
}