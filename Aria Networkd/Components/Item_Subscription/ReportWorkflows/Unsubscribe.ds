Unsubscribe as "Unsubscribe"
{

				type =  functions
				form = Item_Subscription
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						old_value = input.is_active.toString();
										input.is_active = false;
										thisapp.Write_Activity_Log("Item_Subscription",input.ID.toString(),"is_active",old_value,"false",input.subscriber_employee);
					)
					}
				}
			
}