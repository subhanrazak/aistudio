kanban Items_By_Lifecycle
{

			displayName = "Items By Lifecycle"
			show all rows from Item_Master  [is_deleted == false]  
			(
				apn
				description
				revision
				part_type
				owner_employee
				lifecycle_phase
			)
			filters
			(
				part_type
				owner_employee
				lifecycle_phase
			)
			sort by
			(
				apn ascending
			)
			options
			(
	 			display field = lifecycle_phase
				sort order  = ascending
				record count  = enable
	 		)
			conditional formatting
			(
				"Obsolete"
				{
				condition = (lifecycle_phase == "Obsolete")
				fields = [apn, lifecycle_phase]
				format = "background-color:#FFE0E0;color:#A00000"
				}
				"Production"
				{
				condition = (lifecycle_phase == "Production")
				fields = [apn, lifecycle_phase]
				format = "background-color:#E7F7ED;color:#106B38"
				}
			)
		
}