list My_Working_Items
{

			displayName = "My Working Items"
			show all rows from Item_Master  [is_deleted == false && lifecycle_phase == "Unreleased"]  
			(
				apn
				category
				description
				part_status
				lifecycle_phase
				owner_employee
			)
			filters
			(
				category
				part_status
				lifecycle_phase
				owner_employee
			)
			sort by
			(
				apn ascending
			)
		
}