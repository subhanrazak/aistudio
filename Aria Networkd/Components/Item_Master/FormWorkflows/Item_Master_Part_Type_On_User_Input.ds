Item_Master_Part_Type_On_User_Input as "Item Master - Part Type On User Input"
{

				type =  form
				form = Item_Master

				record event = on add or edit

				on user input of part_type
				{
					actions 
					{
						custom deluge script
						(
											if(input.part_type == "Assembly")
										{
											show bom_lines;
										}
										else
										{
											hide bom_lines;
										}
						)
					}
				}

			
}