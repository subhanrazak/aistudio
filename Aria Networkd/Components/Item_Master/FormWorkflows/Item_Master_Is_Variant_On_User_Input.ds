Item_Master_Is_Variant_On_User_Input as "Item Master - Is Variant On User Input"
{

				type =  form
				form = Item_Master

				record event = on add or edit

				on user input of is_variant
				{
					actions 
					{
						custom deluge script
						(
											if(input.is_variant == true)
										{
											show variant_of;
											show variant_code;
										}
										else
										{
											hide variant_of;
											hide variant_code;
											input.variant_of = null;
											input.variant_code = "";
										}
						)
					}
				}

			
}