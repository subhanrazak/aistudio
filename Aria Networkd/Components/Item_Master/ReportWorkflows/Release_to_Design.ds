Release_to_Design as "Release to Design"
{

				type =  functions
				form = Item_Master
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						emp_id = thisapp.Get_Employee_For_Login(zoho.loginuser);
										emp_rec = Employee_Master[ID == emp_id];
										if(emp_rec.count() > 0 && emp_rec.profile_label in {"PRODUCT_CHANGE_ANALYST","ADMIN"})
										{
											openUrl("#Form:Change_Order?change_category=Engineering_ECO&title=Release " + input.apn + " to Design&description=Lifecycle release request for " + input.apn,"same window");
										}
					)
					}
				}
			
}