form Item_Revision_History
{

			displayname = "Item Revision History"
			Revision_Details
			(
				type = section
				displayname = "Revision Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique history_id
			(
    			type = text
				displayname = "History ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have item
			(
				type = picklist	
				displayname = "Item"
				values  = Item_Master.ID
    			displayformat = [apn]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have revision_label
			(
    			type = text
				displayname = "Revision Label"
	 			row = 1
	 			column = 1   
				width = medium
			)
			effective_change_order
			(
				type = picklist	
				displayname = "Effective Change Order"
				values  = Change_Order.ID
    			displayformat = [order_id]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have snapshot_json
			(
    			type = textarea
				displayname = "Snapshot JSON"
				height = 200px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have effective_date
			(
    			type = datetime
				displayname = "Effective Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}