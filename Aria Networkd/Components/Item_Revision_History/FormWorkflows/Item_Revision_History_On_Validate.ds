Item_Revision_History_On_Validate as "Item Revision History - On Validate"
{

				type =  form
				form = Item_Revision_History

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.history_id == null || input.history_id == "")
										{
											input.history_id = thisapp.Generate_Record_Code("REV-");
										}
										if(input.effective_date == null)
										{
											input.effective_date = zoho.currenttime;
										}
						)
					}
				}

			
}