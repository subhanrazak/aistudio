form Change_Request_Affected_Item
{

			displayname = "Change Request Affected Item"
			Affected_Item_Details
			(
				type = section
				displayname = "Affected Item Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have item
			(
				type = picklist	
				displayname = "Item"
				values  = Item_Master[is_deleted == false].ID
    			displayformat = [apn]
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}