void Release_Change_Order(int change_order_id)
{

                 	co_rec = Change_Order[ID == change_order_id];
                 	if(co_rec.count() > 0 && co_rec.status == "Approved")
                 	{
                 		try 
                 		{
                 			co_rec.release_error_flag=false;
                 			co_rec.release_error_details="";
                 			co_rec.release_last_attempt_on=zoho.currenttime;
                 			for each  affected_row in co_rec.affected_items
                 			{
                 				item_rec = Item_Master[ID == affected_row.child_item];
                 				if(item_rec.count() > 0)
                 				{
                 					old_revision = item_rec.revision;
                 					old_phase = item_rec.lifecycle_phase;
                 					if(affected_row.planned_revision_bump == true)
                 					{
                 						item_rec.revision=thisapp.Increment_Revision_Label(item_rec.revision);
                 					}
                 					if(affected_row.target_lifecycle_phase not in {"",null})
                 					{
                 						item_rec.lifecycle_phase=affected_row.target_lifecycle_phase;
                 						if(affected_row.target_lifecycle_phase in {"Design","Production"})
                 						{
                 							item_rec.part_status="Released";
                 						}
                 						else if(affected_row.target_lifecycle_phase == "Obsolete")
                 						{
                 							item_rec.part_status="Obsolete";
                 						}
                 					}
                 					if(co_rec.change_category == "Deviation")
                 					{
                 						item_rec.is_deviated=true;
                 					}
                 					thisapp.Create_Item_Revision_Snapshot(item_rec.ID,co_rec.ID);
                 					thisapp.Cascade_Revision_History(item_rec.ID,co_rec.ID);
                 					thisapp.Write_Activity_Log("Item_Master",item_rec.apn,"revision",old_revision,item_rec.revision,item_rec.owner_employee);
                 					thisapp.Write_Activity_Log("Item_Master",item_rec.apn,"lifecycle_phase",old_phase,item_rec.lifecycle_phase,item_rec.owner_employee);
                 					merge_map = Map();
                 					merge_map.put("order_id",co_rec.order_id);
                 					merge_map.put("apn",item_rec.apn);
                 					thisapp.Notify_Item_Subscribers(item_rec.ID,"ECN_RELEASED",merge_map,true);
                 				}
                 			}
                 			stakeholders = List();
                 			stakeholders.add(co_rec.created_by_employee);
                 			for each  app_row in co_rec.approvers
                 			{
                 				if(app_row.approver not in stakeholders)
                 				{
                 					stakeholders.add(app_row.approver);
                 				}
                 			}
                 			for each  affected_row in co_rec.affected_items
                 			{
                 				owner_item = Item_Master[ID == affected_row.child_item];
                 				if(owner_item.count() > 0 && owner_item.owner_employee not in stakeholders)
                 				{
                 					stakeholders.add(owner_item.owner_employee);
                 				}
                 				for each  sub_rec in Item_Subscription[item == affected_row.child_item && is_active == true]
                 				{
                 					if(sub_rec.subscriber_employee not in stakeholders)
                 					{
                 						stakeholders.add(sub_rec.subscriber_employee);
                 					}
                 				}
                 			}
                 			for each  emp_id in stakeholders
                 			{
                 				existing_ack = ECN_Acknowledgment[change_order == co_rec.ID && recipient_employee == emp_id];
                 				if(existing_ack.count() == 0)
                 				{
                 					insert into ECN_Acknowledgment
                 					[
                 						ack_id=thisapp.Generate_Record_Code("ACK-")
                 						change_order=co_rec.ID
                 						recipient_employee=emp_id
                 						status="Pending"
                 						Added_User=zoho.loginuser
                 					]
                 				}
                 			}
                 			old_status = co_rec.status;
                 			if(co_rec.change_category == "Deviation")
                 			{
                 				co_rec.status="Effective";
                 			}
                 			else
                 			{
                 				co_rec.status="Complete";
                 			}
                 			thisapp.Write_Activity_Log("Change_Order",co_rec.order_id,"status",old_status,co_rec.status,co_rec.created_by_employee);
                 		}		catch (release_error)
                 		{
                 			co_rec.release_error_flag=true;
                 			co_rec.release_error_details=release_error.toString();
                 			co_rec.release_last_attempt_on=zoho.currenttime;
                 			thisapp.Write_Activity_Log("Change_Order",co_rec.order_id,"release_error","",release_error.toString(),co_rec.created_by_employee);
                 		}
                 	}
                 
}