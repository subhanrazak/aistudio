int Get_Employee_For_Login(string login_user)
{

                 	emp_id = 0;
                 	emp_rec = Employee_Master[email == login_user && is_active == true];
                 	if(emp_rec.count() > 0)
                 	{
                 		emp_id = emp_rec.ID;
                 	}
                 	return emp_id;
                 
}