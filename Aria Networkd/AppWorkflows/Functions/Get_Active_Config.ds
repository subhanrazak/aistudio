int Get_Active_Config()
{

                 	config_id = 0;
                 	config_rec = System_Config[is_active == true] sort by Added_Time desc;
                 	if(config_rec.count() > 0)
                 	{
                 		config_id = config_rec.ID;
                 	}
                 	return config_id;
                 
}