list Get_Where_Used_Direct(int item_id)
{

                 	used_list = List();
                 	for each  bom_line in BOM_Line[child_item == item_id && is_struck == false]
                 	{
                 		row_map = Map();
                 		row_map.put("parent_item_id",bom_line.parent_item);
                 		row_map.put("line_id",bom_line.ID);
                 		used_list.add(row_map);
                 	}
                 	return used_list;
                 
}