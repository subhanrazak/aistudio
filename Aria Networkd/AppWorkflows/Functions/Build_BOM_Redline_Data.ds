list Build_BOM_Redline_Data(int change_order_id, int parent_item_id)
{

                 	redline_rows = List();
                 	for each  bom_line in BOM_Line[parent_item == parent_item_id]
                 	{
                 		row_map = Map();
                 		row_map.put("line_id",bom_line.ID);
                 		row_map.put("child_item",bom_line.child_item);
                 		row_map.put("quantity",bom_line.quantity);
                 		row_map.put("is_struck",bom_line.is_struck);
                 		row_map.put("superseded_by",bom_line.superseded_by);
                 		row_map.put("change_order_id",change_order_id);
                 		redline_rows.add(row_map);
                 	}
                 	return redline_rows;
                 
}