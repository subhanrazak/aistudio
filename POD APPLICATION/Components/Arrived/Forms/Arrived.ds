form Arrived
{

			success message = "Data Added Successfully!"
			feature property = 8
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = plaintext
				value = "<div>Are you arrived at customer's location?</div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Arrived
					(
   						type = submit
   						displayname = "Arrived"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}