report POD_Report
{

				quickview
				(
					layout
					(
		 				type = Custom
		 				selectedlayout = "Custom Layout 1"
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on tap
						(
							View Record   	   
    					)
						on long press
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Delivery_Number as "Delivery Number"
								Delivery_Notes as "Delivery Notes"
								POD_ID as "POD ID"
								S_No
								Status
							)
						)
						datablock2
						(
		     				title = "Items"
		     				related field = Items
							fields
							(
								POD_ID as "POD ID"
								Product
								Ordered_Qty as "Ordered Qty"
								Delivered_Qty as "Delivered Qty"
								Pending_Qty as "Pending Qty"
								Reason_Code as "Reason Code"
								Image
								Notes
								Status
							)
						)
						datablock3
						(
		     				title = "Delivery Number"
		     				related field = Delivery_Number
							fields
							(
								Customer
								Customer_Address as "Customer Address"
								Driver
								Route_Number as "Route Number"
								Planned_Delivery_Date as "Planned Delivery Date"
								Vehicle
								Stop_Sequence as "Stop Sequence"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}