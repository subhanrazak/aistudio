report POD_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								POD_ID as "POD ID"
								Delivery_Number as "Delivery Number"
								Delivery_Number.Driver as "Driver"
								Delivery_Number.Customer as "Customer"
								Receipient_Details.Receipient_Printed_Name as "Receipient Name"
								Receipient_Details.Receipient_Signature as "Receipient Signature"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								POD_ID as "POD ID"
								Delivery_Number as "Delivery Number"
								Delivery_Notes as "Delivery Notes"
								Status
							)
						)
						datablock4
						(
							layout type = -1
		     				title = "Receipient Details"
		     				related field = Receipient_Details.POD_Form
							fields
							(
								Receipient_Printed_Name as "Receipient Name"
								Receipient_Role as "Receipient Role"
								Receipient_Phone as "Receipient Phone"
								Receipient_Signature as "Receipient Signature"
								Delivery_Photos as "Delivery Photos"
								Delivery_Number as "Delivery Number"
							)
						)
						datablock2
						(
							layout type = -1
		     				title = "Items"
		     				related field = Items
							fields
							(
								Ordered_Qty as "Ordered Qty"
								Delivered_Qty as "Delivered Qty"
								Pending_Qty as "Pending Qty"
								Reason_Code as "Reason Code"
								Image
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}