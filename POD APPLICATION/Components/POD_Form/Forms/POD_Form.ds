form POD_Form
{

			displayname = "POD"
			success message = "Items verified"
			Items
			(
				type = grid
				values  = POD_Line_Items.ID
    			bidirectional = POD_ID
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			POD_ID
			(
    			type = text
				displayname = "POD ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Submitted","Reviewed","Confirmed"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Delivery_Notes
			(
    			type = textarea
				displayname = "Delivery Notes"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Approve_Comments
			(
    			type = textarea
				displayname = "Approve Comments"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reject_Comments
			(
    			type = textarea
				displayname = "Reject Comments"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Action_field
			(
				type = picklist
				displayname = "Action"
				maxchar = 100
				values = {"Verify Items","Capture POD"}
				initial value = "Verify Items"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Receipient_Details
			(
				type = picklist	
				displayname = "Receipient Details"
				values  = Receipient_Details.ID
    			bidirectional = POD_Form
    			displayformat = [Receipient_Printed_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = New_Customer.ID
    			displayformat = [Customer_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3","Custom stage","Pending","Assign Driver","Submitted","Approve POD","Reject POD"}
			}
		
}