form POD_Line_Items
{

			displayname = "POD Line Items"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			POD_ID
			(
				type = picklist	
				displayname = "POD ID"
				values  = POD_Form.ID
    			bidirectional = Items
    			displayformat = [POD_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product
			(
				type = picklist	
				values  = Outbound_Delivery_Line_Items.ID
    			displayformat = [Product_Display]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ordered_Qty
			(
				type = number
				displayname = "Ordered Qty"
	 			row = 1
	 			column = 1   
				width = small
			)
			Delivered_Qty
			(
				type = number
				displayname = "Delivered Qty"
	 			row = 1
	 			column = 1   
				width = small
			)
			Pending_Qty
			(
				type = number
				displayname = "Pending Qty"
	 			row = 1
	 			column = 1   
				width = small
			)
			Reason_Code
			(
				type = picklist
				displayname = "Reason Code"
				maxchar = 100
				values = {"Damaged","Customer Refused","Not on Truck","Incorrect Item"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image
			(
    			type = image
				compression = true
				source  = camera
    			file count = 10
				camera = primary
				preview duration = 0
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Delivered","Not Delivered","Partial"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}