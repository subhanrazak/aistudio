default list POD_Line_Items_Report1
{

			displayName = "POD Line Items Report"
			show all rows from POD_Line_Items    
			(
				Ordered_Qty as "Ordered Qty"
				Delivered_Qty as "Delivered Qty"
				Pending_Qty as "Pending Qty"
				Reason_Code as "Reason Code"
				Image
				Notes
				Status
				POD_ID as "POD ID"
				Product
			)
		
}