							layout type = 4
							fields
							(
								Delivery_Number as "Delivery Number"
								Delivery_Number.Delivery_Address as "Delivery Address"
								Driver.Email as "Email"
								Driver.Mobile_Number as "Mobile Number"
								Driver
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Delivery_Number as "Delivery Number"
							)
						)
					)
						menu
						(
