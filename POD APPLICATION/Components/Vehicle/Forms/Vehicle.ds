form Vehicle
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Vehicle_Number
			(
    			type = text
				displayname = "Vehicle Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Make
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Model
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vehicle_Image
			(
    			type = image
				displayname = "Vehicle Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Max_Capacity_KG
			(
				type = decimal
				displayname = "Max Capacity (KG)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vehicle_Type
			(
				type = picklist
				displayname = "Vehicle Type"
				maxchar = 100
				values = {"Bike","Auto","Mini Van","Pickup Truck","LCV","Truck","Container"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Available","Assigned","In Transit","Under Maintenance","Out of Service"}
				initial value = "Available"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			unique Vehicle_ID
			(
    			type = text
				displayname = "Vehicle ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S No"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}