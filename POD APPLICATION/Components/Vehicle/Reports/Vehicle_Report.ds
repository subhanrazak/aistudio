default list Vehicle_Report
{

			displayName = "Vehicle Report"
			show all rows from Vehicle    
			(
				Vehicle_Number as "Vehicle Number"
				Vehicle_Type as "Vehicle Type"
				Make
				Model
				Max_Capacity_KG as "Max Capacity (KG)"
				Status
				Vehicle_ID as "Vehicle ID"
				S_No as "S No"
				Vehicle_Image as "Vehicle Image"
			)
		
}