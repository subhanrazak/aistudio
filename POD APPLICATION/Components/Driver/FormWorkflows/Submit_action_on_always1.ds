Submit_action_on_always1 as "Submit action on always"
{

				type =  form
				form = Driver

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Driver_Display = thisapp.Util.DisplayFormat({"img_field_value":input.Image,"report_name":"All_Drivers","field_name":"Image","name":input.Driver_Name,"secondary_text":input.Email,"recID":input.ID});
						)
					}
				}

			
}