list All_Drivers
{

			displayName = "Drivers"
			show all rows from Driver    
			(
				Driver_ID as "Driver ID"
				Mobile_Number as "Mobile Number"
				(
					displayformat = formattednumber 
				)
				License_Number as "License Number"
				Status
				Driver_Display as "Driver"
			)
			filters
			(
				Status
			)
		
}