Show_Results as "Show Results"
{

				type =  form
				form = Order_Search

				record event = on add

				on user input of Delivery_Number
				{
					actions 
					{
						custom deluge script
						(
											public_page_url = "https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/page-perma/Order_Tracking/btKVpHWZfTYpRuTEXvVzY3AH1m4SfEP4yOk2J7eQhRyqWOT9CQj7GX8FYp5QqVhperTeHtRvgY5TFTNnBaMQ7UZERaBqehf1Cp2E";
										if(input.Delivery_Number.isEmpty() == false)
										{
											rec = Outbound_Deliveries_Form[Delivery_Number == input.Delivery_Number];
											if(rec.count() > 0)
											{
												params = "?order_id=" + rec.ID + "&page_action=detail";
											}
											else
											{
												params = "?page_action=no_result";
											}
										}
										else
										{
											params = "?page_action=no_result";
										}
										input.Search_Button = "<style>a.search-btn { background: #3d33d3; color: #fff; padding: 12px; border-radius: 5px; position: fixed; right: 110px; top: 70px; }</style><a href='" + public_page_url + params + "' class='search-btn' target='_blank'>Search</a>";
						)
					}
				}

			
}