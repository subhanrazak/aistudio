form Approve_POD
{

			displayname = "Approve POD"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div>Are you sure want to approve this POD?<br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			POD_ID
			(
				type = picklist	
				displayname = "POD ID"
				values  = POD_Form.ID
    			displayformat = [POD_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}