form Verify_OTP
{

			displayname = "Verify OTP"
			store data in zc = false
			Verify_OTP
			(
				type = section
				displayname = "Verify OTP"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			OTP
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Resend_OTP
				(
   					type = button
   					displayname = "Resend OTP"
				)
				Verify
				(
   					type = submit
   					displayname = "Verify"
				)
			}
		
}