form Collect_Customer_Feedback
{

			displayname = "Get Customer Feedback"
			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Rating
			(
				type = picklist
				maxchar = 100
				values = {"1","2","3","4","5"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Customer_ID
			(
    			type = text
				displayname = "Customer ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Outbound_Delivery_ID
			(
    			type = text
				displayname = "Outbound Delivery ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}