default list Outbound_Delivery_Line_Items_Report
{

			displayName = "Outbound Delivery Line Items Report"
			show all rows from Outbound_Delivery_Line_Items    
			(
				Ordered_Qty as "Ordered Qty"
				Delivered_Qty as "Delivered Qty"
				Status
				Outbound_Deliveries_SAP as "Delivery Number"
				Pending_Qty as "Pending Qty"
				Total_Weight as "Total Weight"
				Product
				ID
				Product_Display as "Product Display"
			)
		
}