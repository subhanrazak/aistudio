form Outbound_Delivery_Line_Items
{

			displayname = "Outbound Delivery Line Items"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Outbound_Deliveries_SAP
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			bidirectional = Products
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product
			(
				type = picklist	
				values  = New_Product.ID
    			displayformat = [Product_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product_Display
			(
    			type = formula
				displayname = "Product Display"
				value =  input.Product.Product_Name
				visibility = false
				display type = text
				format = plaintext
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Ordered_Qty
			(
				type = number
				displayname = "Ordered Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Total_Weight
			(
				type = decimal
				displayname = "Total Weight"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivered_Qty
			(
				type = number
				displayname = "Delivered Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pending_Qty
			(
				type = number
				displayname = "Pending Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","In-Transit","Delivered","Partial","Refused"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}