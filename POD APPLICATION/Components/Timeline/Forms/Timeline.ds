form Timeline
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			POD_ID
			(
				type = picklist	
				displayname = "POD ID"
				values  = POD_Form.ID
    			displayformat = [POD_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Exception_ID
			(
				type = picklist	
				displayname = "Exception ID"
				values  = New_Exception.ID
    			displayformat = [Exception_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Time
			(
    			type = datetime
				displayname = "Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Driver_ID
			(
				type = picklist	
				displayname = "Driver ID"
				values  = Driver.ID
    			displayformat = [Driver_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_ID
			(
				type = picklist	
				displayname = "Employee ID"
				values  = Employee.ID
    			displayformat = [Employee_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}