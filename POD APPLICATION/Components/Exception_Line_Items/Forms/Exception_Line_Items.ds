form Exception_Line_Items
{

			displayname = "Exception Line Items"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Exception_ID
			(
				type = picklist	
				displayname = "Exception ID"
				values  = New_Exception.ID
    			bidirectional = Exception_Items
    			displayformat = [Exception_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product
			(
				type = picklist	
				values  = Outbound_Delivery_Line_Items.ID
    			displayformat = [Product_Display]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ordered_Qty
			(
				type = number
				displayname = "Ordered Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivered_Qty
			(
				type = number
				displayname = "Delivered Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pending_Qty
			(
				type = number
				displayname = "Pending Qty"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image
			(
    			type = image
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reject_Reason
			(
				type = picklist
				displayname = "Reason"
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Delivered","Not Delivered","Partial"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}