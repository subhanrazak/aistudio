report Customer_Feedback_Report
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Delivery_Number as "Delivery Number"
								Customer.Customer as "Customer"
								Rating_Display as "Rating"
								Feedback
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Feedback
								Rating
								Customer as "Customer ID"
								Delivery_Number as "Delivery Number"
								Rating_Display as "Rating"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}