Load_action_on_add1 as "Load action on add"
{

				type =  form
				form = Receipient_Details

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Delivery_Number.isEmpty() == false)
										{
											pod_rec = POD_Form[Delivery_Number == input.Delivery_Number];
											input.POD_Form = pod_rec.ID;
										}
						)
					}
				}

			
}