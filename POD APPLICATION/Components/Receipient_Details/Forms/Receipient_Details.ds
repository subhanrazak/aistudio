form Receipient_Details
{

			displayname = "Receipient Details"
			success message = "POD captured successfully."
			Receipient_Details
			(
				type = section
				displayname = "Receipient Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Receipient_Printed_Name
			(
    			type = text
				displayname = "Receipient Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Receipient_Role
			(
    			type = text
				displayname = "Receipient Role"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Receipient_Phone
			(
    			type = phonenumber
				displayname = "Receipient Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Receipient_Signature
			(
    			type = signature
				displayname = "Receipient Signature"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Delivery_Photos
			(
    			type = image
				displayname = "Delivery Photos"
				compression = true
				source  = camera
    			file count = 10
				camera = primary
				preview duration = 0
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			POD_Form
			(
				type = picklist	
				displayname = "POD"
				values  = POD_Form.ID
    			bidirectional = Receipient_Details
    			displayformat = [POD_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}