Navigate as "Navigate"
{

				type =  functions
				form = Outbound_Deliveries_Form
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("https://www.google.com/maps/dir/?api=1&destination=" + input.Delivery_Address,"new window");
					)
					}
				}
			
}