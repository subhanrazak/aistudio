Load_action_on_always as "Load action on always"
{

				type =  form
				form = Outbound_Deliveries_Form

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Products.Delivered_Qty;
										hide Products.Pending_Qty;
										hide Products.Status;
						)
					}
				}

			
}