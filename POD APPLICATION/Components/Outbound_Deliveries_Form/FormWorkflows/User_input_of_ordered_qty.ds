User_input_of_ordered_qty as "User input of ordered qty"
{

				type =  form
				form = Outbound_Deliveries_Form

				record event = on add

				on user input of Products.Ordered_Qty
				{
					actions 
					{
						custom deluge script
						(
											if(row.Product.isEmpty() == false && row.Ordered_Qty.isEmpty() == false)
										{
											row.Total_Weight=ifNull(row.Ordered_Qty,0) * ifNull(row.Product.Weight,0);
										}
						)
					}
				}

			
}