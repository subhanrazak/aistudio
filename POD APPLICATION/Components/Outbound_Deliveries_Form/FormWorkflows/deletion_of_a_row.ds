deletion_of_a_row as "deletion of a row"
{

				type =  form
				form = Outbound_Deliveries_Form

				record event = on add or edit

				on delete row of Products
				{
					actions 
					{
						custom deluge script
						(
											prod_lis = List();
										product_ids = New_Product[Status == "Active"].ID.getAll();
										prod_lis.addAll(product_ids);
										selected_lis = input.Products.Product.getall();
										prod_lis.removeAll(selected_lis);
										row.Product:ui.add(prod_lis);
						)
					}
				}

			
}