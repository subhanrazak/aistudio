report All_Outbound_Deliveries
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Delivery_Number as "Delivery Number"
								Products.Product as "Products"
								Customer
								Delivery_Address as "Delivery Address"
								Driver
								Planned_Delivery_Date as "Planned Delivery Date"
								Delivery_Status as "Delivery Status"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							"Assign Driver"
    					)
						)
    				action
    				(
						on click
						(
							"View"
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Stop_Sequence as "Stop Sequence"
								Delivery_Number as "Delivery Number"
								Route_Number as "Route Number"
								Delivery_Status as "Delivery Status"
								Added_User as "Added User"
								Added_Time as "Added Time"
							)
						)
						datablock3
						(
		     				title = "Customer"
		     				related field = Customer
							fields
							(
								Customer_Name as "Customer Name"
								Customer_Email as "Customer Email"
								Customer_Phone as "Customer Phone"
								Customer_Logo as "Customer Logo"
								Status
								Customer
								Customer_ID as "Customer ID"
							)
						)
						datablock4
						(
		     				title = "Customer Address"
		     				related field = Customer_Address
							fields
							(
								Customer
								Address_Type as "Address Type"
								Address_Name as "Address Name"
								Customer_Address as "Customer Address"
								Is_Default_Address as "Is Default Address"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}