form Resolve_Exception
{

			displayname = "Resolve Exception"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Exception_ID
			(
				type = picklist	
				displayname = "Exception ID"
				values  = New_Exception.ID
    			displayformat = [Exception_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}