form General
{

			success message = "Data Added Successfully!"
			ID_Setup
			(
				type = section
				displayname = "ID Prefix"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Delivery_Number
			(
    			type = text
				displayname = "Delivery Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_ID
			(
    			type = text
				displayname = "Customer ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vehicle_ID
			(
    			type = text
				displayname = "Vehicle ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_ID
			(
    			type = text
				displayname = "Product ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have POD_ID
			(
    			type = text
				displayname = "POD ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Driver_ID
			(
    			type = text
				displayname = "Driver ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Employee_ID
			(
    			type = text
				displayname = "Employee ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Exception_ID
			(
    			type = text
				displayname = "Exception ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Others
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Minimum_Arrival_Distance
			(
				type = number
				displayname = "Minimum Arrival Distance (Meters)"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Exception_SLA_Due_Hrs
			(
				type = number
				displayname = "Exception SLA Due (Hrs)"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Gemini_API_Key
			(
    			type = text
				displayname = "Gemini API Key"
    			description
    			[
    				type = help_text
    			 	message = "Enter your Gemini API key to enable AI-generated delivery notes."
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		properties
		{
			total entries
			{
				allowed count = 1
			}
		}
		
}