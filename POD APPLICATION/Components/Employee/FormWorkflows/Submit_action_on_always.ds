Submit_action_on_always as "Submit action on always"
{

				type =  form
				form = Employee

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Employee_Display = thisapp.Util.DisplayFormat({"img_field_value":input.Image,"report_name":"All_Employees","field_name":"Image","name":input.Employee_Name,"secondary_text":input.Email,"recID":input.ID});
						)
					}
				}

			
}