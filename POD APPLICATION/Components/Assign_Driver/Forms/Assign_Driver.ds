form Assign_Driver
{

			displayname = "Assign Driver"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Driver
			(
				type = picklist	
				values  = Driver.ID
    			displayformat = [Driver_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vehicle
			(
				type = picklist	
				values  = Vehicle.ID
    			displayformat = [Vehicle_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Delivery_Number
			(
				type = picklist	
				displayname = "Delivery Number"
				values  = Outbound_Deliveries_Form.ID
    			displayformat = [Delivery_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}