<panel elementName='Board'>
					<pr width='fill' height='fill'>
						<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='top'>
							<pr width='auto' height='auto'>
								<pc>
									<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' borderColor='#FFFFFF' borderWidth='0px' color='#FFFFFF' bgColor='#EF4444' width='52px' height='52px' type='icon' value='ui-1-circle-remove' size='28px' cornerRadius='12px' iconType='outline' /> </pc>
								<pc padding='5px' hAlign='left'>
									<pr>
										<pc hAlign='left'>
											<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Failed Deliveries'>
											</text>

										</pc>
									</pr>
									<pr>
										<pc hAlign='left'>
											<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#000000' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' borderColor='#10B981' borderWidth='0px' criteria='Delivery_Outcome == &quot;Not Delivered&quot; &amp;&amp; Driver.Email == zoho.loginuserid' value='thisapp.Outbound_Deliveries_Form.ID.count'>
											</text>

										</pc>
									</pr>
									<pr>
										<pc>
											<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='10px' padding='0px' color='#909090' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#000000' borderWidth='0px' value='Today'>
											</text>

										</pc>
									</pr>
								</pc>
							</pr>
						</pc>
					</pr>
</panel>