<page linkname = "Supervisor_Dashboard" displayname = "Supervisor Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='25%'>
				<file name:Board.ds/>
			</column>
			<column width='25%'>
				<file name:Board.ds/>
			</column>
			<column width='25%'>
				<file name:Board.ds/>
			</column>
			<column width='25%'>
				<file name:Board.ds/>
			</column>
		</row>
		<row>
			<column width='50%'>
				<chart elementName='Chart' title='Deliveries by Status' titleColor='#222326' type='Donut' xtitle='Delivery Outcome' bgColor='#FFFFFF' theme='theme1' legendPos='center.top' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Outbound_Deliveries_Form' xfield='Delivery_Outcome' yfields='count:Order_Date' showDataLabel='true' underlyingReport='All_Outbound_Deliveries' /> </column>
			<column width='50%'>
				<file name:Report_1.ds/> </column>
		</row>
		<row>
			<column width='50%'>
				<chart elementName='Chart 1' title='Daily Delivery Trend' titleColor='#222326' type='Line' bgColor='#FFFFFF' theme='theme1' legendPos='center.top' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Outbound_Deliveries_Form' xfield='Delivered_Date' yfields='count:Order_Date' DelugeCriteria='Delivery_Outcome == &quot;Delivered&quot;' /> </column>
			<column width='50%'>
				<file name:Report_2.ds/> </column>
		</row>
		<row>
			<column width='50%'>
				<file name:Report.ds/> </column>
			<column width='50%'>
				<file name:Report_3.ds/> </column>
		</row>
	</layout>
</zml>
</content>