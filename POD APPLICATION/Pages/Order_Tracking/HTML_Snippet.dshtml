<style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', sans-serif;
            background: #F7F7F5;
            color: #1A1A1A;
            min-height: 100vh;
        }

     

        /* ===== SEARCH SECTION ===== */
        .search-section {
            max-width: 560px;
            margin: 0 auto;
            padding: 100px 24px 80px;
            text-align: center;
        }
        .search-section h1 {
            font-size: 28px;
            font-weight: 500;
            color: #1A1A1A;
            letter-spacing: -0.6px;
            margin-bottom: 8px;
        }
        .search-section p {
            font-size: 14px;
            color: #888;
            margin-bottom: 36px;
            line-height: 1.5;
        }
        .search-form {
            display: flex;
            gap: 8px;
        }
        .search-form input {
            flex: 1;
            padding: 13px 16px;
            border: 1px solid #E0E0DE;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #1A1A1A;
            background: #fff;
            outline: none;
            transition: border-color 0.2s;
        }
        .search-form input::placeholder { color: #B0B0AC; }
        .search-form input:focus { border-color: #1A1A1A; }
        .search-form button {
            padding: 13px 24px;
            background: #1A1A1A;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }
        .search-form button:hover { background: #333; }
        .search-hint {
            margin-top: 14px;
            font-size: 12px;
            color: #B0B0AC;
        }
        .search-hint code {
            background: #EEEEE9;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 11px;
            color: #888;
        }

        /* ===== NOT FOUND ===== */
        .not-found {
            max-width: 440px;
            margin: 0 auto;
            padding: 80px 24px;
            text-align: center;
        }
        .not-found-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto 20px;
            background: #EEEEE9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .not-found h2 {
            font-size: 18px;
            font-weight: 500;
            color: #1A1A1A;
            margin-bottom: 6px;
        }
        .not-found p {
            font-size: 14px;
            color: #888;
            margin-bottom: 24px;
            line-height: 1.5;
        }
        .not-found a {
            font-size: 13px;
            font-weight: 600;
            color: #1A1A1A;
            text-decoration: none;
            padding: 10px 20px;
            border: 1px solid #E0E0DE;
            border-radius: 8px;
            transition: background 0.2s;
            display: inline-block;
        }
        .not-found a:hover { background: #EEEEE9; }

        /* ===== ORDER DETAIL ===== */
        .order-detail {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 24px 80px;
        }

        /* Back link */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 500;
            color: #888;
            text-decoration: none;
            margin-bottom: 28px;
            transition: color 0.2s;
        }
        .back-link:hover { color: #1A1A1A; }

        /* Order Header */
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .order-header-left h1 {
            font-size: 24px;
            font-weight: 600;
            color: #1A1A1A;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }
        .order-header-left p {
            font-size: 13px;
            color: #888;
        }
        .order-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.2px;
        }
        .badge-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }
        .badge-delivered { background: #E8F5E8; color: #2D7A2D; }
        .badge-delivered .badge-dot { background: #2D7A2D; }
        .badge-shipped { background: #E8F0FA; color: #2563EB; }
        .badge-shipped .badge-dot { background: #2563EB; }
        .badge-processing { background: #FEF3E2; color: #B45309; }
        .badge-processing .badge-dot { background: #B45309; }
        .badge-cancelled { background: #FDE8E8; color: #C53030; }
        .badge-cancelled .badge-dot { background: #C53030; }

        /* ===== TIMELINE ===== */
        .section-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #888;
            margin-bottom: 16px;
        }
        .timeline-card {
            background: #fff;
            border: 1px solid #E8E8E6;
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 28px;
        }
        .timeline {
            position: relative;
            padding-left: 24px;
        }
        .timeline::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 6px;
            bottom: 6px;
            width: 1.5px;
            background: #E8E8E6;
        }
        .tl-item {
            position: relative;
            padding-bottom: 22px;
        }
        .tl-item:last-child { padding-bottom: 0; }
        .tl-dot {
            position: absolute;
            left: -20px;
            top: 3px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #fff;
            border: 2px solid #E0E0DE;
            z-index: 1;
        }
        .tl-item.done .tl-dot {
            background: #1A1A1A;
            border-color: #1A1A1A;
        }
        .tl-item.done .tl-dot::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #fff;
        }
        .tl-item.current .tl-dot {
            background: #fff;
            border-color: #1A1A1A;
            box-shadow: 0 0 0 3px rgba(26,26,26,0.1);
        }
        .tl-item.current .tl-dot::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #1A1A1A;
        }
        .tl-title {
            font-size: 13px;
            font-weight: 600;
            color: #1A1A1A;
            margin-bottom: 2px;
        }
        .tl-item.pending .tl-title { color: #B0B0AC; }
        .tl-desc {
            font-size: 12px;
            color: #888;
            line-height: 1.4;
        }
        .tl-item.pending .tl-desc { color: #CCCCC8; }
        .tl-date {
            font-size: 11px;
            color: #B0B0AC;
            margin-top: 2px;
        }

        /* ===== INFO GRID ===== */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 28px;
        }
        .info-block {
            background: #fff;
            border: 1px solid #E8E8E6;
            border-radius: 10px;
            padding: 16px 20px;
        }
        .info-block-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #B0B0AC;
            margin-bottom: 6px;
        }
        .info-block-value {
            font-size: 13px;
            font-weight: 500;
            color: #1A1A1A;
            line-height: 1.5;
        }

        /* ===== ITEMS TABLE ===== */
        .items-card {
            background: #fff;
            border: 1px solid #E8E8E6;
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 28px;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
        }
        .items-table thead th {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #B0B0AC;
            text-align: left;
            padding: 0 0 12px 0;
            border-bottom: 1px solid #E8E8E6;
        }
        .items-table thead th:last-child { text-align: right; }
        .items-table thead th:nth-child(2) { text-align: center; }
        .items-table tbody td {
            padding: 14px 0;
            font-size: 13px;
            color: #1A1A1A;
            border-bottom: 1px solid #F2F2F0;
            vertical-align: middle;
        }
        .items-table tbody tr:last-child td { border-bottom: none; }
        .items-table tbody td:last-child { text-align: right; font-weight: 600; }
        .items-table tbody td:nth-child(2) { text-align: center; color: #888; }
        .item-name {
            font-weight: 500;
            color: #1A1A1A;
        }
        .item-sku {
            font-size: 11px;
            color: #B0B0AC;
            margin-top: 2px;
        }

        /* ===== SUMMARY ===== */
        .summary-card {
            background: #fff;
            border: 1px solid #E8E8E6;
            border-radius: 10px;
            padding: 20px 24px;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 13px;
            color: #888;
        }
        .summary-row.total {
            border-top: 1px solid #E8E8E6;
            margin-top: 8px;
            padding-top: 12px;
            font-weight: 600;
            font-size: 15px;
            color: #1A1A1A;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 640px) {
            .info-grid { grid-template-columns: 1fr; }
            .order-header { flex-direction: column; }
            .search-form { flex-direction: column; }
            .navbar { padding: 12px 16px; }
        }
    </style>
<%
	if(input.page_action.isEmpty())
	{
		%>
<section class="search-section">
                    <h1>Track Your Order</h1>
                    <p>Enter your order ID to get real-time updates on your shipment status and delivery timeline.</p>
<!--                   <div elName='zc-component' formLinkName='Order_Search' params='Delivery_Number=<%=input.search_key%>&zc_Header=false&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Submit&amp;zc_ResetVal=Reset'></div> -->
				   
		   
				   <iframe height='500px' width='100%' frameborder='0' allowTransparency='true' scrolling='auto' src='https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/form-embed/Order_Search/8Bh5DfYUyCJ7xvJDyESgN3O11rTSxddJA5ZuHq7qUkvwBzONvVGUkFawTaROx8AtuqQbD73ZXxTrbRuXAjbNqAEEN0nHqxaY4xqD'></iframe>
                </section>
<%
	}
	else if(input.page_action == "no_result")
	{
		%>
<section class="not-found">
                    <div class="not-found-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="M21 21l-4.35-4.35"></path>
                        </svg>
                    </div>
                    <h2>Order not found</h2>
                    <p>We couldn't find an order with ID <strong><%=input.search_key%>aadad</strong>. Please double-check and try again.</p>
                    <a href="https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/page-perma/Order_Tracking/btKVpHWZfTYpRuTEXvVzY3AH1m4SfEP4yOk2J7eQhRyqWOT9CQj7GX8FYp5QqVhperTeHtRvgY5TFTNnBaMQ7UZERaBqehf1Cp2E">\u2190 Try another search</a>
                </section>
<%
	}
	else if(input.order_id.isEmpty() == false && input.page_action == "detail")
	{
		delivery_rec = Outbound_Deliveries_Form[ID == input.order_id];
		%>
<section class="order-detail">
                    <!-- Back -->
                    <a href="https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/page-perma/Order_Tracking/btKVpHWZfTYpRuTEXvVzY3AH1m4SfEP4yOk2J7eQhRyqWOT9CQj7GX8FYp5QqVhperTeHtRvgY5TFTNnBaMQ7UZERaBqehf1Cp2E" class="back-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 12H5"></path>
                            <path d="M12 19l-7-7 7-7"></path>
                        </svg>
                        Back to search
                    </a>

                    <!-- Header -->
                    <div class="order-header">
                        <div class="order-header-left">
                            <h1><%=delivery_rec.Delivery_Number%></h1>
                            <p><%=delivery_rec.Customer.Customer_Name%>\u00B7 <%=delivery_rec.Order_Date%> <%=if(delivery_rec.Delivered_Date.isEmpty() == false,"\u00B7 Delivered " + delivery_rec.Delivered_Date,null)%></p>
                        </div>
                        <div class="order-status-badge badge-delivered">
                            <span class="badge-dot"></span>
                            <%=delivery_rec.Delivery_Status%>
                        </div>
                    </div>

                    <!-- Timeline -->
                    <div class="section-label">Timeline</div>
                    <div class="timeline-card">
                        <div class="timeline">
<%
		for each  t in Timeline[Delivery_Number == delivery_rec.ID]
		{
			%>
<div class="tl-item done">
                                    <div class="tl-dot"></div>
                                    <div>
                                        <div class="tl-title"><%=t.Action_field%></div>
                                        <div class="tl-desc"><%=t.Description%></div>
                                        <div class="tl-date"><%=t.Date_Time%></div>
                                    </div>
                                </div>
<%
		}
		%>
</div>
                    </div>

                    <!-- Order Info -->
                    <div class="section-label">Details</div>
                    <div class="info-grid">
                        <div class="info-block">
                            <div class="info-block-label">Customer</div>
                            <div class="info-block-value"><%=delivery_rec.Customer.Customer_Name%><br><%=delivery_rec.Customer.Customer_Email%><br><%=delivery_rec.Customer.Customer_Phone%></div>
                        </div>
                        <div class="info-block">
                            <div class="info-block-label">Shipping Address</div>
                            <div class="info-block-value"><%=delivery_rec.Delivery_Address%></div>
                        </div>
                    </div>

                    <!-- Items -->
                   <!-- <div class="section-label">Items</div>
                    <div class="items-card">
                        <table class="items-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                                
                                    <tr>
                                        <td>
                                            <div class="item-name">Wireless Noise-Cancelling Headphones</div>
                                            <div class="item-sku">WH-1000XM5</div>
                                        </td>
                                        <td>1</td>
                                    </tr>
                                
                                    <tr>
                                        <td>
                                            <div class="item-name">USB-C Charging Cable (2m)</div>
                                            <div class="item-sku">ACC-USB-2M</div>
                                        </td>
                                        <td>2</td>
                                        <td>\u20B9599</td>
                                    </tr>
                                
                            </tbody>
                        </table>
                    </div>-->

                    <!-- Summary -->
                    <!--<div class="section-label">Summary</div>
                    <div class="summary-card">
                        <div class="summary-row"><span>Subtotal</span><span>\u20B926,188</span></div>
                        <div class="summary-row"><span>Shipping</span><span>Free</span></div>
                        <div class="summary-row"><span>Tax (GST)</span><span>\u20B94,714</span></div>
                        <div class="summary-row total"><span>Total</span><span>\u20B930,902</span></div>
                    </div>-->
                </section>
<%
	}
%>