string Styles_Creator.Element_Styles()
{

                 	style_text = ".zc-pb-page-content-wrapper div#zppagesLive, .zc-pb-page-content-wrapper div#elementsContainer, .zc-pb-page-content-wrapper .elemContainment, .zc-pb-page-content-wrapper .zcpage-elemContainer { height: 100%; } .zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment, .zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment, .zc-pb-page-content-wrapper .zc-pb-tile-container { padding: 0px; } .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-container, .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { border-radius: 0px !important; } .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { box-shadow: none !important; } #splash-screen { display: none !important; }";
                 	return style_text;
                 
}