string Util.timeSince(date date)
{

                 	seconds = toDecimal((zoho.currenttime - date)).truncate(0) / 1000;
                 	interval = seconds / 31536000;
                 	if(interval > 1)
                 	{
                 		val = interval.truncate(0);
                 		return val + if(val == 1," year ago"," years ago");
                 	}
                 	interval = seconds / 2592000;
                 	if(interval > 1)
                 	{
                 		val = interval.truncate(0);
                 		return val + if(val == 1," month ago"," months ago");
                 	}
                 	interval = seconds / 86400;
                 	if(interval > 1)
                 	{
                 		val = interval.truncate(0);
                 		return val + if(val == 1," day ago"," days ago");
                 	}
                 	interval = seconds / 3600;
                 	if(interval > 1)
                 	{
                 		val = interval.truncate(0);
                 		return val + if(val == 1," hour ago"," hours ago");
                 	}
                 	interval = seconds / 60;
                 	if(interval > 1)
                 	{
                 		val = interval.truncate(0);
                 		return val + if(val == 1," minute ago"," minutes ago");
                 	}
                 	return seconds.truncate(0) + " seconds ago";
                 
}