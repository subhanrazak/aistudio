string Styles.Color_Codes()
{

                 	style_text = ":root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; /* Button colors */ --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); /*yet to defined on layout files*/ --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); /*yet to defined on layout files*/ --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; }";
                 	return style_text;
                 
}