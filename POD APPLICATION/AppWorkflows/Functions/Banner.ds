string Styles.Banner()
{

                 	style_text = ".zcs-toast-link:hover { text-decoration: underline; } .zcs-outline-toast { border: 1px solid; } .zcs-theme-toast { background-color: var(--zcs_component_hover_color); } .zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); } .zcs-success-toast { background-color: #edf7ed; color: #1d4620; } .zcs-info-toast { background-color: #e4f6fd; color: #024361; } .zcs-warning-toast { background-color: #fef4e5; color: #663c01; } .zcs-error-toast { background-color: #feedec; color: #5f2120; } .zcs-filled-toast { color: #fff; } .zcs-filled-toast.zcs-success-toast { background-color: #2e7d32; } .zcs-filled-toast.zcs-info-toast { background-color: #0588d1; } .zcs-filled-toast.zcs-warning-toast { background-color: #ed6c03; } .zcs-filled-toast.zcs-error-toast { background-color: #d32f2f; }";
                 	return style_text;
                 
}