background-color: transparent; } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr:first-child:hover td { border-top-color: transparent; } .zcs-vertical-table-wrapper.zcs-table-wrapper table tbody tr:hover td.zcs-table-th { background-color: var(--zcs-thead-color); } .zcs-table-wrapper table thead tr th.zcs-green, .zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; } .zcs-table-wrapper table thead tr th.zcs-red, .zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; } .zcs-table-wrapper table thead tr th.zcs-yellow, .zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; } .zcs-table-wrapper table thead tr th.zcs-d_green, .zcs-table-wrapper table tbody tr td.zcs-d_green, .zcs-table-wrapper table tbody tr td .zcs-d_green { color: #007943; } .zcs-table-wrapper table thead tr th.zcs-blue, .zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-table-wrapper table tbody tr td .zcs-blue { color: #09598e; } .zcs-table-wrapper table thead tr th.zcs-l_blue, .zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table thead tr th.zcs-d_blue, .zcs-table-wrapper table tbody tr td.zcs-d_blue, .zcs-table-wrapper table tbody tr td .zcs-d_blue { color: #1328cd; } /* Custom Buttons */ .zcs-table-wrapper table tbody tr td .zcs-custom-btn, .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable { display: inline-block; vertical-align: top; border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); transition: all 0.2s linear; } .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable { opacity: 0.3; } .zcs-table-wrapper table tbody tr td .zcs-custom-btn:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); } .zcs-table-wrapper table tbody tr td .zcs-custom-btn-disable:hover { border-color: var(--zcs_tertiary_border_color); color: #666d79; } /* Custom Action Icons */ .zcs-table-wrapper table tbody tr td .zcs-approve-icon { color: #179e6c; } .zcs-table-wrapper table tbody tr td .zcs-reject-icon { color: #fe455d; } .zcs-table-wrapper table tbody tr td .zcs-custom-action-icon i:before { transition: all 0.2s ease; } .zcs-table-wrapper table tbody tr td .zcs-custom-action-icon:hover i:before { font-family: 'ZC Live Solid'; } .zcs-table-wrapper table tbody tr td .zcs-approve-icon:hover i:before { content: '\ed3d'; } .zcs-table-wrapper table tbody tr td .zcs-reject-icon:hover i:before { content: '\ed48'; } /* Zebra Table */ .zcs-table-wrapper.zcs-zebra-table table thead tr th { background-color: var(--zcs-zebra-head-color); } .zcs-table-wrapper.zcs-zebra-table table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-table-wrapper.zcs-zebra-table table tbody tr:nth-child(odd) td { background-color: var(--zcs-zebra-odd-color); } .zcs-table-wrapper.zcs-zebra-table table tbody tr:nth-child(even) td { background-color: var(--zcs-zebra-even-color); } .zcs-table-wrapper.zcs-zebra-table table tbody tr:hover td { background-color: var(--zcs-zebra-h-color); }";
			                 	rtl_text = "";
			                 	style_text = style_text + rtl_text;
			                 	return style_text;
			                 
			}

			string Styles.Timeline()
			{
			
			                 	style_text = ".zcs-tl-indicator { width: 60px; left: 16.6666666667%; } .zcs-without-time .zcs-tl-indicator { left: 0px; } .zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0px 2px 6px 0px #C4DEE4; } .zcs-tl-icon { width: 35px; height: 35px; } .zcs-tl-icon.zcs-tl-icon-yellow { background-color: #FCF4E6; color: #B8770D; } .zcs-tl-icon.zcs-tl-icon-orange { background-color: #F8F0EB; color: #F4660C; } .zcs-tl-icon.zcs-tl-icon-blue { background-color: #E8EFFF; color: #2A6FFC; } .zcs-tl-icon.zcs-tl-icon-green { background-color: #E4FCF3; color: #179E6C; } .zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; } .zcs-tl-li .zcs-tl-animation { animation: pulse-dot 1.25s cubic-bezier(0.455, 0.03, 0.515, 0.955) -.4s infinite; } @media (max-width: 768px) { .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0px 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-px-60 { padding-left: 60px; padding-right: 24px; } } @keyframes pulse-dot { 0% { transform: scale(.8); } 50% { transform: scale(1); } 100% { transform: scale(.8); } } /* RTL styles start here */ .zc-rtl-wrapper .zcs-tl-indicator { left: auto; right: 16.6666666667%; } .zc-rtl-wrapper .zcs-without-time .zcs-tl-indicator { left: auto; right: 0px; } @media (max-width: 768px) { .zc-rtl-wrapper .zcs-tl-indicator { left: auto; right: 0px; } .zc-rtl-wrapper .zcs-tl-time { text-align: right; } .zc-rtl-wrapper .zcs-tl-li .zcs-px-60 { padding-left: 24px; padding-right: 60px; } }";
			                 	return style_text;
			                 
			}

			string Styles.To_Be_Removed()
			{
			
			                 	style_text = ".zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-list-none { list-style-type: none; } .zcs-overflow-auto { overflow: auto; } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #b8770d; } .zcs-color-d_green { color: #007943; } .zcs-color-blue { color: #09598E; } .zcs-color-l_blue { color: #1094C5; } .zcs-color-d_blue { color: #1328CD; } /* Divider Lines */ .zcs-line { width: 100%; height: 100%; border: 1px solid #EBEFEF; } .zcs-line-l { width: 1px; height: 100%; background-color: #EBEFEF; } .zcs-line-r { width: 1px; height: 100%; background-color: #EBEFEF; } .zcs-line-t { width: 100%; height: 1px; background-color: #EBEFEF; } .zcs-line-b { width: 100%; height: 1px; background-color: #EBEFEF; } .zcs-font-40 { font-size: 40px; }";
			                 	return style_text;
			                 
