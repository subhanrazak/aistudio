iv&gt;&lt;div class=&quot;zcs-tl-desc&quot;&gt;Arrived at AA Block, 2nd Avenue, Anna Nagar&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-tl-item zcs-tl-item-done&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-tl-dot zcs-tl-done&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;M20 6 9 17l-5-5&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;zcs-tl-title&quot;&gt;Verification Completed&lt;/div&gt;&lt;div class=&quot;zcs-tl-time&quot;&gt;02:56 PM&lt;/div&gt;&lt;div class=&quot;zcs-tl-desc&quot;&gt;3 items verified \u00B7 1 discrepancy&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-tl-item zcs-tl-item-done&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-tl-dot zcs-tl-done&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;M20 6 9 17l-5-5&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;zcs-tl-title&quot;&gt;Signature Captured&lt;/div&gt;&lt;div class=&quot;zcs-tl-time&quot;&gt;03:00 PM&lt;/div&gt;&lt;div class=&quot;zcs-tl-desc&quot;&gt;Signed by Mr. Rajan Kumar (Store Manager)&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-tl-item&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-tl-dot zcs-tl-active&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;10&quot;/&gt;&lt;polyline points=&quot;12 6 12 12 16 14&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;zcs-tl-title&quot;&gt;POD Submitted&lt;/div&gt;&lt;div class=&quot;zcs-tl-time&quot;&gt;03:02 PM&lt;/div&gt;&lt;div class=&quot;zcs-tl-desc&quot;&gt;Outcome: Partially Delivered \u00B7 1 discrepancy \u00B7 Awaiting approval&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- Today&apos;s Stats --&gt;\n\t&lt;div class=&quot;zcs-rp-section&quot;&gt;\n\t\t&lt;div class=&quot;zcs-rp-label&quot;&gt;Today&apos;s Stats&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Stops&lt;/span&gt;&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;3 / 5&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Distance&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;112 km&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Weight&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;486 kg&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/aside&gt;\n\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse if(input.page_action == &quot;print&quot;)\n\t{\n\t\t%&gt;\n&lt;style&gt;\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\n\tfont-family: Arial, Helvetica, sans-serif;\n\tcolor: #000; background: #fff;\n\tfont-size: 12px; line-height: 1.4;\n\tmax-width: 800px; margin: 0 auto; padding: 32px;\n}\n\n/* \u2550\u2550\u2550 Print button \u2550\u2550\u2550 */\n.no-print {\n\tdisplay: flex; gap: 8px; margin-bottom: 20px;\n}\n.no-print button, .no-print a {\n\tdisplay: inline-flex; align-items: center; gap: 6px;\n\tpadding: 10px 20px; border-radius: 6px; border: 1px solid #ccc;\n\tfont-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none;\n\tcolor: #333; background: #fff;\n}\n.no-print button { background: #0F172A; color: #fff; border-color: #0F172A; }\n\n/* \u2550\u2550\u2550 Header \u2550\u2550\u2550 */\n.pod-title {\n\tfont-size: 32px; font-weight: 900; letter-spacing: 2px;\n\ttext-transform: uppercase; margin-bottom: 4px;\n}\n.pod-company {\n\tfont-size: 13px; color: #333; margin-bottom: 20px;\n}\n\n/* \u2550\u2550\u2550 Bordered tables for layout \u2550\u2550\u2550 */\n.pod-grid {\n\twidth: 100%; border-collapse: collapse; margin-bottom: 16px;\n}\n.pod-grid td {\n\tborder: 1px solid #000; padding: 6px 10px; vertical-align: top;\n}\n.pod-grid .pod-label {\n\tfont-weight: 700; font-size: 11px; white-space: nowrap; width: 160px;\n\tbackground: #f5f5f5;\n}\n.pod-grid .pod-value {\n\tfont-size: 12px; min-width: 140px;\n}\n\n/* Half-half grid */\n.pod-half {\n\twidth: 100%; border-collapse: collapse; margin-bottom: 16px;\n}\n.pod-half td {\n\twidth: 50%; vertical-align: top; padding: 0;\n}\n.pod-half td:first-child { padding-right: 8px; }\n.pod-half td:last-child { padding-left: 8px; }\n.pod-half .pod-grid { margin-bottom: 0; }\n\n/* \u2550\u2550\u2550 Section title \u2550\u2550\u2550 */\n.pod-section {\n\tfont-size: 12px; font-weight: 700; text-transform: uppercase;\n\tbackground: #000; color: #fff; padding: 5px 10px;\n\tmargin-bottom: 0;\n}\n\n/* \u2550\u2550\u2550 Items table \u2550\u2550\u2550 */\n.pod-items {\n\twidth: 100%; border-collapse: collapse; margin-bottom: 16px;\n}\n.pod-items th {\n\tbackground: #e8e8e8; border: 1px solid #000;\n\tpadding: 6px 8px; font-size: 11px; font-weight: 700;\n\ttext-align: left; text-transform: uppercase;\n}\n.pod-items td {\n\tborder: 1px solid #000; padding: 6px 8px; font-size: 12px;\n\theight: 26px;\n}\n.pod-items .r { text-align: right; }\n.pod-items .c { text-align: center; }\n.pod-items .bold { font-weight: 700; }\n\n/* Status styling */\n.pod-match { color: #000; }\n.pod-short { font-weight: 700; }\n\n/* \u2550\u2550\u2550 Totals row \u2550\u2550\u2550 */\n.pod-totals {\n\twidth: 100%; border-collapse: collapse; margin-bottom: 24px;\n}\n.pod-totals td {\n\tborder: 1px solid #000; padding: 8px 10px; font-size: 12px;\n}\n.pod-totals .pod-label { font-weight: 700; background: #f5f5f5; width: auto; }\n\n/* \u2550\u2550\u2550 Discrepancy table \u2550\u2550\u2550 */\n.pod-disc-section { margin-bottom: 16px; }\n\n/* \u2550\u2550\u2550 Notes \u2550\u2550\u2550 */\n.pod-notes {\n\twidth: 100%; border-collapse: collapse; margin-bottom: 24px;\n}\n.pod-notes td {\n\tborder: 1px solid #000; padding: 8px 10px; font-size: 12px;\n\tmin-height: 40px;\n}\n.pod-notes .pod-label { font-weight: 700; background: #f5f5f5; width: 180px; }\n\n/* \u2550\u2550\u2550 Signature block \u2550\u2550\u2550 */\n.pod-sig-grid {\n\twidth: 100%; border-collapse: collapse; margin-top: 32px;\n}\n.pod-sig-grid td {\n\twidth: 50%; vertical-align: top; padding: 0;\n}\n.pod-sig-grid td:first-child { padding-right: 24px; }\n.pod-sig-grid td:last-child { padding-left: 24px; }\n\n.pod-sig-block { margin-bottom: 20px; }\n.pod-sig-label {\n\tfont-size: 11px; font-weight: 700; margin-bottom: 4px;\n}\n.pod-sig-line {\n\tborder-bottom: 1px solid #000; height: 32px; margin-bottom: 4px;\n}\n.pod-sig-img {\n\tborder: 1px solid #ccc; padding: 8px; margin-bottom: 4px;\n\ttext-align: center; min-height: 60px;\n}\n.pod-sig-img img { max-height: 60px; }\n.pod-sig-date { font-size: 10px; color: #666; }\n\n/* \u2550\u2550\u2550 Footer \u2550\u2550\u2550 */\n.pod-footer {\n\tmargin-top: 24px; padding-top: 10px;\n\tborder-top: 2px solid #000;\n\tdisplay: flex; justify-content: space-between;\n\tfont-size: 9px; color: #666;\n}\n\n/* \u2550\u2550\u2550 PRINT \u2550\u2550\u2550 */\n@media print {\n\tbody { padding: 0; max-width: 100%; }\n\t.no-print { display: none !important; }\n\t.pod-items, .pod-grid, .pod-totals, .pod-notes { page-break-inside: avoid; }\n\t.pod-sig-grid { page-break-inside: avoid; }\n\t@page { margin: 12mm; }\n}\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n\n&lt;!-- Print button --&gt;\n&lt;div class=&quot;no-print&quot;&gt;\n\t&lt;button onclick=&quot;window.print()&quot;&gt;\u2399 Print / Save as PDF&lt;/button&gt;\n\t&lt;a href=&quot;#&quot; onclick=&quot;history.back();return false;&quot;&gt;\u2190 Back&lt;/a&gt;\n&lt;/div&gt;\n\n&lt;!-- \u2550\u2550\u2550 HEADER \u2550\u2550\u2550 --&gt;\n&lt;div class=&quot;pod-title&quot;&gt;Proof of Delivery&lt;/div&gt;\n&lt;div class=&quot;pod-company&quot;&gt;Your Company Name \u00B7 Unit 33, 4 Main Road, Chennai, Tamil Nadu \u2014 600040&lt;/div&gt;\n\n&lt;!-- \u2550\u2550\u2550 2-COLUMN: Customer + POD Info \u2550\u2550\u2550 --&gt;\n&lt;table class=&quot;pod-half&quot;&gt;&lt;tr&gt;\n\t&lt;td&gt;\n\t\t&lt;table class=&quot;pod-grid&quot;&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Customer Name:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;Modern Retail Mart&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Delivery Address:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;AA Block, 2nd Avenue, Anna Nagar West, Chennai - 600040&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Contact Person:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;Mr. Rajan Kumar&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Contact Number:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;+91 98765 43210&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;/table&gt;\n\t&lt;/td&gt;\n\t&lt;td&gt;\n\t\t&lt;table class=&quot;pod-grid&quot;&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;POD Number:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;OD-10018&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;POD Date:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;19-Jun-2026&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;POD Time:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;03:02 PM&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Delivery Agent:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;Murugan Vel&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td class=&quot;pod-label&quot;&gt;Agent Tel No:&lt;/td&gt;&lt;td class=&quot;pod-value&quot;&gt;9876543213&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;/table&gt;\n\t&lt;/td&gt;\n&lt;/tr&gt;&lt;/table&gt;\n\n&lt;!-- \u2550\u2550\u2550 NOTES FOR DELIVERY AGENT \u2550\u2550\u2550 --&gt;\n&lt;table class=&quot;pod-notes&quot;&gt;\n\t&lt;tr&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Notes For Delivery Agent:&lt;/td&gt;\n\t\t&lt;td&gt;Stack neatly in storage room&lt;/td&gt;\n\t&lt;/tr&gt;\n&lt;/table&gt;\n\n&lt;!-- \u2550\u2550\u2550 ITEMS DELIVERED \u2550\u2550\u2550 --&gt;\n&lt;div class=&quot;pod-section&quot;&gt;Items Delivered&lt;/div&gt;\n&lt;table class=&quot;pod-items&quot;&gt;\n\t&lt;thead&gt;\n\t\t&lt;tr&gt;\n\t\t\t&lt;th style=&quot;width:30px&quot;&gt;#&lt;/th&gt;\n\t\t\t&lt;th&gt;Item Name&lt;/th&gt;\n\t\t\t&lt;th style=&quot;width:70px&quot; class=&quot;c&quot;&gt;Ordered&lt;/th&gt;\n\t\t\t&lt;th style=&quot;width:70px&quot; class=&quot;c&quot;&gt;Delivered&lt;/th&gt;\n\t\t\t&lt;th style=&quot;width:70px&quot; class=&quot;c&quot;&gt;Pending&lt;/th&gt;\n\t\t\t&lt;th style=&quot;width:70px&quot; class=&quot;c&quot;&gt;Received&lt;/th&gt;\n\t\t\t&lt;th&gt;Reason / Notes&lt;/th&gt;\n\t\t&lt;/tr&gt;\n\t&lt;/thead&gt;\n\t&lt;tbody&gt;\n\t\t&lt;tr&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;1&lt;/td&gt;\n\t\t\t&lt;td class=&quot;bold&quot;&gt;Basmati Rice 10kg&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;8&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;8&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;0&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;Y&lt;/td&gt;\n\t\t\t&lt;td&gt;\u2014&lt;/td&gt;\n\t\t&lt;/tr&gt;\n\t\t&lt;tr&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;2&lt;/td&gt;\n\t\t\t&lt;td class=&quot;bold&quot;&gt;Rava 1kg&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;10&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c pod-short&quot;&gt;7&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c pod-short&quot;&gt;3&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;Partial&lt;/td&gt;\n\t\t\t&lt;td&gt;Damaged in transit \u2014 3 bags torn&lt;/td&gt;\n\t\t&lt;/tr&gt;\n\t\t&lt;tr&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;3&lt;/td&gt;\n\t\t\t&lt;td class=&quot;bold&quot;&gt;Jaggery 500g&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;12&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;12&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;0&lt;/td&gt;\n\t\t\t&lt;td class=&quot;c&quot;&gt;Y&lt;/td&gt;\n\t\t\t&lt;td&gt;\u2014&lt;/td&gt;\n\t\t&lt;/tr&gt;\n\t\t&lt;!-- Empty rows for manual use --&gt;\n\t\t&lt;tr&gt;&lt;td class=&quot;c&quot;&gt;4&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;tr&gt;&lt;td class=&quot;c&quot;&gt;5&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;tr&gt;&lt;td class=&quot;c&quot;&gt;6&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;tr&gt;&lt;td class=&quot;c&quot;&gt;7&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;tr&gt;&lt;td class=&quot;c&quot;&gt;8&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t&lt;/tbody&gt;\n&lt;/table&gt;\n\n&lt;!-- \u2550\u2550\u2550 TOTALS \u2550\u2550\u2550 --&gt;\n&lt;table class=&quot;pod-totals&quot;&gt;\n\t&lt;tr&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Total Items Ordered:&lt;/td&gt;\n\t\t&lt;td style=&quot;width:80px&quot; class=&quot;bold&quot;&gt;30&lt;/td&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Total Items Delivered:&lt;/td&gt;\n\t\t&lt;td style=&quot;width:80px&quot; class=&quot;bold&quot;&gt;27&lt;/td&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Total Pending:&lt;/td&gt;\n\t\t&lt;td style=&quot;width:80px&quot; class=&quot;bold&quot;&gt;3&lt;/td&gt;\n\t&lt;/tr&gt;\n\t&lt;tr&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Total Weight (kg):&lt;/td&gt;\n\t\t&lt;td class=&quot;bold&quot;&gt;96&lt;/td&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Delivery Outcome:&lt;/td&gt;\n\t\t&lt;td colspan=&quot;3&quot; class=&quot;bold&quot;&gt;Partially Delivered&lt;/td&gt;\n\t&lt;/tr&gt;\n&lt;/table&gt;\n\n&lt;!-- \u2550\u2550\u2550 DISCREPANCIES \u2550\u2550\u2550 --&gt;\n&lt;div class=&quot;pod-disc-section&quot;&gt;\n\t&lt;div class=&quot;pod-section&quot;&gt;Discrepancies&lt;/div&gt;\n\t&lt;table class=&quot;pod-items&quot;&gt;\n\t\t&lt;thead&gt;\n\t\t\t&lt;tr&gt;\n\t\t\t\t&lt;th&gt;Item&lt;/th&gt;\n\t\t\t\t&lt;th class=&quot;c&quot; style=&quot;width:70px&quot;&gt;Ordered&lt;/th&gt;\n\t\t\t\t&lt;th class=&quot;c&quot; style=&quot;width:70px&quot;&gt;Delivered&lt;/th&gt;\n\t\t\t\t&lt;th class=&quot;c&quot; style=&quot;width:70px&quot;&gt;Short&lt;/th&gt;\n\t\t\t\t&lt;th&gt;Reason&lt;/th&gt;\n\t\t\t\t&lt;th class=&quot;c&quot; style=&quot;width:70px&quot;&gt;Photo&lt;/th&gt;\n\t\t\t&lt;/tr&gt;\n\t\t&lt;/thead&gt;\n\t\t&lt;tbody&gt;\n\t\t\t&lt;tr&gt;\n\t\t\t\t&lt;td class=&quot;bold&quot;&gt;Rava 1kg&lt;/td&gt;\n\t\t\t\t&lt;td class=&quot;c&quot;&gt;10&lt;/td&gt;\n\t\t\t\t&lt;td class=&quot;c&quot;&gt;7&lt;/td&gt;\n\t\t\t\t&lt;td class=&quot;c bold&quot;&gt;3&lt;/td&gt;\n\t\t\t\t&lt;td&gt;Damaged in transit \u2014 3 bags torn during loading&lt;/td&gt;\n\t\t\t\t&lt;td class=&quot;c&quot;&gt;Yes&lt;/td&gt;\n\t\t\t&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t&lt;/tbody&gt;\n\t&lt;/table&gt;\n&lt;/div&gt;\n\n&lt;!-- \u2550\u2550\u2550 DELIVERY NOTES \u2550\u2550\u2550 --&gt;\n&lt;table class=&quot;pod-notes&quot;&gt;\n\t&lt;tr&gt;\n\t\t&lt;td class=&quot;pod-label&quot;&gt;Delivery Notes:&lt;/td&gt;\n\t\t&lt;td&gt;Delivered at back entrance. Customer requested morning deliveries going