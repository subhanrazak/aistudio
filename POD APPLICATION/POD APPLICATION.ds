\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n</panel>\n\t\t\t\t\t\t\t</column>\n\t\t\t\t\t\t</row>\n\t\t\t\t\t\t<row>\n\t\t\t\t\t\t\t<column width='100%'>\n\t\t\t\t\t\t\t\t<panel elementName='Panel 3'>\n\t\t\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle'>\n\t\t\t\t\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='#833AF0' borderColor='#833AF0' borderWidth='0px' width='0.5%' hAlign='center' vAlign='middle' cornerRadius='0px'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#833AF0' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#000000' borderWidth='0px' value='-'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc padding='20px' bgColor='transparent' bgColorType='noFill' action='OpenForm' componentLinkName='New_Product' target='new-window' borderColor='#222326' borderWidth='0px' width='99.5%' hAlign='left' vAlign='middle' cornerRadius='0px'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<image margin='0px' borderColor='#2D2D2D' borderWidth='0px' color='#000000' bgColor='transparent' bgColorType='noFill' width='40px' height='40px' type='icon' value='ui-2-small-add' size='20px' cornerRadius='40px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Add Product'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n</panel>\n\t\t\t\t\t\t\t</column>\n\t\t\t\t\t\t</row>\n\t\t\t\t\t</column>\n\t\t\t\t</row>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='Report 1' appLinkName='thisapp' linkName='All_Drivers_Location' iszreport='false' heightType='auto' heightValue='700' /> </column>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='Report' appLinkName='thisapp' linkName='Unassigned_Deliveries' iszreport='false' heightType='auto' heightValue='700' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='Report 2' appLinkName='thisapp' linkName='All_Exceptions' iszreport='false' heightType='auto' heightValue='700' /> </column>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='Report 3' appLinkName='thisapp' linkName='Customer_Feedback_Report' iszreport='false' heightType='auto' heightValue='700' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Delivery_Details(int delivery_id, int pod_id, int step, int verify_id)
		{
					displayname = "Delivery Details"
					Content="<zml mobileDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tdelivery_rec = Outbound_Deliveries_Form[ID == input.delivery_id];\n\t%&gt;\n&lt;style&gt;\n&lt;%=thisapp.Styles.outboundDetailViewStyles()%&gt;\n.zc-delivery-action-form .formContainer{\n\tdisplay: none;\n}\n.zc-delivery-action-form input.zc-live-primary-btn {\n\t\tfloat: right;\n}\n.zc-delivery-action-form .form-outer-wrapper{\n\tbox-shadow: none !important;\n}\n&lt;/style&gt;\n\n&lt;div class=&quot;zcs-shell&quot;&gt;\n&lt;div class=&quot;zcs-layout&quot;&gt;\n&lt;main class=&quot;zcs-main&quot;&gt;\n&lt;%\n\tif(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;,&quot;In Transit&quot;})\n\t{\n\t\t%&gt;\n&lt;!-- \u2500\u2500 DETAIL \u2500\u2500 --&gt;\n\t&lt;div class=&quot;zcs-view zcs-active&quot; id=&quot;v-detail&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-head&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-page-head-left&quot;&gt;\n\t\t\t\t&lt;a href=&apos;#Report:All_Outbound_Deliveries&apos; class=&quot;zcs-back&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m15 18-6-6 6-6&quot;/&gt;&lt;/svg&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-title-wrap&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-page-title&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt; &lt;span class=&quot;zcs-chip zcs-chip-pending&quot;&gt;&lt;span class=&quot;zcs-chip-dot&quot;&gt;&lt;/span&gt; &lt;%=delivery_rec.Delivery_Status%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-page-sub&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt; \u00B7 Stop #&lt;%=delivery_rec.Stop_Sequence%&gt; of 6 \u00B7 Route &lt;%=delivery_rec.Route_Number%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-page-actions&quot;&gt;\n&lt;%\n\t\tif(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;})\n\t\t{\n\t\t\t%&gt;\n&lt;a href=&apos;#Form:Start?Delivery_Number=&lt;%=input.delivery_id%&gt;&amp;Action_field=Start&amp;zc_LoadIn=dialog&apos; class=&quot;zcs-btn zcs-btn-primary&quot; &gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;&lt;rect width=&quot;8&quot; height=&quot;4&quot; x=&quot;8&quot; y=&quot;2&quot; rx=&quot;1&quot;/&gt;&lt;path d=&quot;M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2&quot;/&gt;&lt;path d=&quot;M12 11h4M12 16h4M8 11h.01M8 16h.01&quot;/&gt;&lt;/svg&gt; Start&lt;/a&gt;\n\t\t&lt;!--&lt;div class=&apos;zc-delivery-action-form&apos; elName=&apos;zc-component&apos; formLinkName=&apos;Start&apos; params=&apos;Delivery_Number=&lt;%=input.delivery_id%&gt;&amp;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Start&amp;amp;zc_ResetVal=Reset&apos; zc_MobileView=&quot;inline&quot;&gt;Loading Form...&lt;/div&gt;--&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Delivery_Status == &quot;In Transit&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;a href=&apos;#Form:Arrived?Delivery_Number=&lt;%=input.delivery_id%&gt;&amp;Action_field=Arrived&amp;zc_LoadIn=dialog&apos; class=&quot;zcs-btn zcs-btn-primary&quot; &gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;&lt;rect width=&quot;8&quot; height=&quot;4&quot; x=&quot;8&quot; y=&quot;2&quot; rx=&quot;1&quot;/&gt;&lt;path d=&quot;M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2&quot;/&gt;&lt;path d=&quot;M12 11h4M12 16h4M8 11h.01M8 16h.01&quot;/&gt;&lt;/svg&gt; Arrived&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-instr&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&quot;/&gt;&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;&lt;/svg&gt;&lt;div&gt;&lt;div class=&quot;zcs-instr-title&quot;&gt;Special Instructions&lt;/div&gt;&lt;div class=&quot;zcs-instr-text&quot;&gt;&lt;%=delivery_rec.Special_Instructions%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-grid-2&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t\t&lt;!--&lt;iframe class=&quot;zcs-map-frame&quot; src=&quot;https://www.google.com/maps/embed?pb=!1m28!1m12!1m3!1d48380.75!2d-74.19!3d40.72!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!4m13!3e6!4m5!1s0x89c2547e0e225139%3A0x28e1f3e4d7f5db6a!2sNewark%20NJ!3m2!1d40.735657!2d-74.1723667!4m5!1s0x89c253b8ddf53591%3A0x4b6a8d32a5e6d8c8!2s42%20Industrial%20Blvd%2C%20Newark%2C%20NJ!3m2!1d40.7394!2d-74.1724!5e0!3m2!1sen!2sus!4v1&quot; allowfullscreen loading=&quot;lazy&quot;&gt;&lt;/iframe&gt;--&gt;\n&lt;%\n\t\tif(delivery_rec.Delivery_Status == &quot;In Transit&quot;)\n\t\t{\n\t\t\tstart_rec = Start[Delivery_Number == input.delivery_id];\n\t\t\t%&gt;\n&lt;iframe \n\tclass=&quot;zcs-map-frame&quot;\n\tsrc=&quot;https://maps.google.com/maps?saddr=&lt;%=encodeUrl(start_rec.Modified_Location)%&gt;&amp;daddr=&lt;%=encodeUrl(delivery_rec.Delivery_Address)%&gt;&amp;output=embed&quot;\n\tallowfullscreen loading=&quot;lazy&quot;&gt;\n&lt;/iframe&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;})\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-map-empty&quot;&gt;\n\t&lt;div class=&quot;zcs-map-empty-icon&quot;&gt;\n\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t&lt;path d=&quot;M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z&quot;/&gt;\n\t\t\t&lt;circle cx=&quot;12&quot; cy=&quot;10&quot; r=&quot;3&quot;/&gt;\n\t\t&lt;/svg&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;zcs-map-empty-title&quot;&gt;Route not available&lt;/div&gt;\n\t&lt;div class=&quot;zcs-map-empty-text&quot;&gt;Tap &lt;strong&gt;Start&lt;/strong&gt; to capture your location and view the route to customer&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&quot;zcs-map-footer&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-map-addr&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;&lt;a href=&quot;https://www.google.com/maps/dir/?api=1&amp;destination=&lt;%=delivery_rec.Delivery_Address%&gt;&quot;\n\t\t\t\t\t\t\t\t\ttarget=&quot;_blank&quot; class=&quot;zcs-btn zcs-btn-red zcs-btn-sm&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot;\n\t\t\t\t\t\t\t\t\t\tstroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;polygon points=&quot;3 11 22 2 13 21 11 13 3 11&quot; /&gt;\n\t\t\t\t\t\t\t\t\t&lt;/svg&gt; Navigate&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;&lt;div class=&quot;zcs-cust&quot;&gt;&lt;div class=&quot;zcs-cust-avatar&quot;&gt;&lt;%=thisapp.Util.getInitials(delivery_rec.Customer.Customer_Name)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-cust-body&quot;&gt;&lt;div class=&quot;zcs-cust-name&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-cust-addr&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-cust-actions&quot;&gt;&lt;a href=&quot;tel: &lt;%=delivery_rec.Customer.Customer_Phone%&gt;&quot; class=&quot;zcs-cust-btn zcs-cust-btn-primary&quot;&gt;&lt;i value=&quot;ui-3-phone-call&quot; html=&quot;ui-3-phone-call&quot; class=&quot;ui-3-phone-call zc-li-outline&quot;&gt;&lt;/i&gt; Call&lt;/a&gt;&lt;a href=&quot;sms:&lt;%=delivery_rec.Customer.Customer_Phone%&gt;&quot; class=&quot;zcs-cust-btn&quot;&gt;&lt;i value=&quot;ui-2-chat&quot; html=&quot;ui-2-chat&quot; class=&quot;ui-2-chat zc-li-outline&quot;&gt;&lt;/i&gt; Message&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card&quot;&gt;&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Route / Stop&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Route_Number%&gt; \u00B7 #&lt;%=delivery_rec.Stop_Sequence%&gt; of 6&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Delivery Window&lt;/span&gt;&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;&lt;%=delivery_rec.Delivery_Window_Start%&gt; \u2013 &lt;%=delivery_rec.Delivery_Window_End%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Total Items&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Total_Items%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;Total Weight&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Total_Weight_kg%&gt; kg&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-info-row&quot;&gt;&lt;span class=&quot;zcs-info-k&quot;&gt;SAP Doc&lt;/span&gt;&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.SAP_ID%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-tbl-head&quot;&gt;&lt;div class=&quot;zcs-tbl-title&quot;&gt;Order Items&lt;/div&gt;&lt;div class=&quot;zcs-tbl-count&quot;&gt