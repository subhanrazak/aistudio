	workflow
	{
		form
		{
			Click_of_Approve as "Click of Approve"
			{
			
							type =  form
							form = Approve_POD
							button = Submit
							on click
							{
								actions 
								{
								on click
								(
									if(input.POD_ID.isEmpty() == false)
													{
														pod_rec = POD_Form[ID == input.POD_ID];
														pod_rec.Status="Approved";
														pod_rec.Approve_Comments=input.Comments;
														delivery_rec = Outbound_Deliveries_Form[ID == input.POD_ID.Delivery_Number];
														delivery_rec.Delivery_Status="POD Approved";
														insert into Timeline
														[
															Delivery_Number=input.POD_ID.Delivery_Number
															POD_ID=input.POD_ID
															Action_field="POD Approved"
															Description=input.POD_ID.POD_ID + " Approved · Comments" + input.Comments
															Date_Time=zoho.currenttime
															Added_User=zoho.loginuser
														]
													}
								)
								}
							}
						
			}

			Field_action_on_always7 as "Field action on always"
			{
			
							type =  form
							form = Approve_POD
			
							record event = on add
			
							field rules
							{
								actions 
								{
									hide Hidden_Section;
								}
							}
			
						
			}

			Field_action_on_always9 as "Field action on always"
			{
			
							type =  form
							form = Arrived
			
							record event = on add or edit
			
							field rules
							{
								actions 
								{
									hide Hidden_Section;
								}
							}
			
						
			}

			Load_action_on_always2 as "Load action on always"
			{
			
							type =  form
							form = Arrived
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(zoho.device.type == "web")
													{
														input.Notes = "<style>" + thisapp.Styles_Popup.Active() + "</style><div class='zcs-active-popup zcs-popup-content zcs-flex zcs-direction-column zcs-align-items-center zcs-p-20 zcs-box-border zcs-text-center'> <div class='zcs-popup-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-full zcs-text-center'> <i class='zcs-font-24 zc-li-outline ui-1-check-circle-08'></i> </div> <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-16 zcs-mx-0 zcs-mb-12'> Arrived </h5> <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'> Have you arrived at the delivery location? </p> </div>";
													}
													else
													{
														input.Notes = "Have you arrived at the delivery location?";
													}
									)
								}
							}
			
						
			}

			Submit_action_on_add5 as "Submit action on add"
			{
			
							type =  form
							form = Arrived
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														delivery_rec = Outbound_Deliveries_Form[ID == input.Delivery_Number];
													delivery_rec.Delivery_Status="Arrived";
													delivery_rec.Driver_Arrived_Time=zoho.currenttime;
													insert into Timeline
													[
														Action_field="Arrived at Customer"
														Driver_ID=input.Delivery_Number.Driver
														Description="Arrived at " + input.Delivery_Number.Delivery_Address
														Delivery_Number=input.Delivery_Number
														Date_Time=zoho.currenttime
														Added_User=zoho.loginuser
													]
													openUrl("#Script:page.parent.refresh ","parent window");
									)
								}
							}
			
						
			}

			Click_of_submit2 as "Click of submit"
			{
			
							type =  form
							form = Assign_Driver
							button = Submit
							on click
							{
								actions 
								{
								on click
								(
									delivery_rec = Outbound_Deliveries_Form[ID == input.Delivery_Number];
													if(delivery_rec.count() > 0)
													{
														try 
														{
															delivery_rec.Driver=input.Driver;
															delivery_rec.Vehicle=input.Vehicle;
															// 		delivery_rec.Driver_Users_Field.email=input.Driver.Email;
															delivery_rec.Delivery_Status="Assigned";
															insert into Timeline
															[
																Delivery_Number=input.Delivery_Number
																Action_field="Driver Assigned"
																Description="Assigned to " + input.Driver.Driver_Name + " · Vehicle " + input.Vehicle.Vehicle_Number + " · Route " + input.Delivery_Number.Route_Number + " · Stop #" + input.Delivery_Number.Stop_Sequence
																Date_Time=zoho.currenttime
																Added_User=zoho.loginuser
															]
															// 	Notifications
															res = zoho.pushNotification(input.Driver.Email,"New delivery assigned to you - " + input.Delivery_Number.Delivery_Number,"New delivery assigned to you","All_Outbound_Deliveries",input.Delivery_Number.ID);
														}	catch (e)
														{
															delivery_rec.Delivery_Status="Pending";
															insert into Timeline
															[
																Delivery_Number=input.Delivery_Number
																Action_field="Assignment Failed"
																Description="Driver user not found for " + ifnull(input.Driver.Driver_Name,"Unknown") + " (" + ifnull(input.Driver.Email,"No email") + ")"
																Date_Time=zoho.currenttime
																Added_User=zoho.loginuser
															]
															delivery_rec.Vehicle=null;
															delivery_rec.Driver=null;
														}
														openUrl("#Script:page.parent.refresh ","parent window");
													}
													else
													{
														alert "Delivery record is not found";
													}
								)
								}
							}
						
			}

			Field_action_on_always13 as "Field action on always"
			{
			
							type =  form
							form = Assign_Driver
			
							record event = on add
			
							field rules
							{
								actions 
								{
									hide Hidden_Section;
								}
							}
			
						
			}

			Click_of_submit1 as "Click of submit"
			{
			
							type =  form
							form = Collect_Customer_Feedback
							button = Submit
							on click
							{
								actions 
								{
								on click
								(
									if(input.Customer_ID.isEmpty() == false && input.Outbound_Delivery_ID.isEmpty() == false)
													{
														if(input.Customer_ID.length() <= 21 && input.Outbound_Delivery_ID.length() <= 21)
														{
															customer_rec = New_Customer[ID == input.Customer_ID.toLong()];
															delivery_rec = Outbound_Deliveries_Form[ID == input.Outbound_Delivery_ID.toLong()];
															if(customer_rec.count() > 0 && delivery_rec.count() > 0)
															{
																if(delivery_rec.Customer.ID == input.Customer_ID.toLong())
																{
																	if(delivery_rec.Delivery_Status in {"POD Submitted","POD Approved","POD Rejected"})
																	{
																		feedback_exist_rec = Customer_Feedback[Delivery_Number == input.Outbound_Delivery_ID.toNumber()];
																		if(feedback_exist_rec.count() > 0)
																		{
																			alert "Feedback already exist for this delivery";
																		}
																		else
																		{
																			insert into Customer_Feedback
																			[
																				Rating=input.Rating
																				Rating_Display=thisapp.Util.RatingStars({"rating":input.Rating,"show_count":true})
																				Customer=customer_rec.ID
																				Delivery_Number=delivery_rec.ID
																				Feedback=input.Feedback
																				Added_User=zoho.loginuser
																			]
																		}
																	}
																	else
																	{
																		alert "POD not yet to submitted";
																	}
																}
																else
																{
																	alert "Invalid Customer ID for this Outbound Delivery";
																}
															}
															else
															{
																alert "Invalid Customer ID or Outbound Delivery ID - Not exist";
															}
														}
														else
														{
															alert "Invalid Customer ID or Outbound Delivery ID";
														}
													}
													else
													{
														alert "Customer ID and Outbound Delivery ID are required";
													}
								)
								}
							}
						
			}

			Field_action_on_always12 as "Field action on always"
			{
			
							type =  form
							form = Collect_Customer_Feedback
			
							record event = on add
			
							field rules
							{
								actions 
