:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Overview&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Delivery #&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Customer&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Address&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Route&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Route_Number%&gt; \u00B7 #&lt;%=delivery_rec.Stop_Sequence%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Window&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;&lt;%=w_start%&gt; \u2013 &lt;%=w_end%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Arrived&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=arrived_time%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Signature&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;\u2713 Captured&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;SAP Doc&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.SAP_ID%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Items --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Items (&lt;%=total_count%&gt;)&lt;/div&gt;\n\t\t\t\t&lt;div style=&quot;padding:10px 16px&quot;&gt;\n&lt;%\n\t\tfor each  vi in v_items\n\t\t{\n\t\t\tvi_color = if(vi.Delivered_Qty == vi.Ordered_Qty,&quot;zcs-ri-ok&quot;,&quot;zcs-ri-warn&quot;);\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-ri&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-dot &lt;%=vi_color%&gt;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-name&quot;&gt;&lt;%=vi.Product.Product_Display%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-qty &lt;%=vi_color%&gt;&quot;&gt;&lt;%=vi.Delivered_Qty%&gt;/&lt;%=vi.Ordered_Qty%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Discrepancies --&gt;\n&lt;%\n\t\tif(disc_count &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot; style=&quot;color:var(--zcs-amber);background:var(--zcs-amber-bg)&quot;&gt;\n\t\t\t\t\tDiscrepancies (&lt;%=disc_count%&gt;)\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\tfor each  di in disc_items\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;zcs-disc-item&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Item&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=di.Product.Product_Display%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Qty&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-amber&quot;&gt;&lt;%=di.Ordered_Qty%&gt; \u2192 &lt;%=di.Delivered_Qty%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Reason&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=ifnull(di.Reason_Code,&quot;\u2014&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Photo&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v &lt;%=if(di.Image != null,&quot;zcs-green&quot;,&quot;zcs-amber&quot;)%&gt;&quot;&gt;\n\t\t\t\t\t\t\t&lt;%=if(di.Image != null,&quot;\u2713 Attached&quot;,&quot;\u2717 Missing&quot;)%&gt;\n\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot; style=&quot;color:var(--zcs-green);background:var(--zcs-green-bg)&quot;&gt;\n\t\t\t\t\tDiscrepancies (0)\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Status&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;\u2713 All items match&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;!-- Special Instructions --&gt;\n&lt;%\n\t\tif(delivery_rec.Special_Instructions != null &amp;&amp; delivery_rec.Special_Instructions != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-instr&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;path d=&quot;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&quot;/&gt;\n\t\t\t\t\t&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-instr-title&quot;&gt;Special Instructions&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-instr-text&quot;&gt;&lt;%=delivery_rec.Special_Instructions%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse if(delivery_rec.Delivery_Status in {&quot;POD Submitted&quot;})\n\t{\n\t\t%&gt;\n&lt;!-- \u2500\u2500 SUCCESS \u2500\u2500 --&gt;\n&lt;%\n\t\t// Pre-calculate values\n\t\tverify_lines = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id];\n\t\tdisc_items = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id &amp;&amp; Delivered_Qty != Ordered_Qty];\n\t\tdisc_count = disc_items.count();\n\t\ttotal_count = verify_lines.count();\n\t\tpod_rec = POD_Form[Delivery_Number == input.delivery_id];\n\t\thas_signature = pod_rec != null &amp;&amp; pod_rec.Receipient_Details.Receipient_Signature != null;\n\t\t// Outcome color\n\t\toutcome = delivery_rec.Delivery_Outcome;\n\t\toutcome_color = if(outcome == &quot;Delivered&quot;,&quot;zcs-green&quot;,if(outcome == &quot;Pending&quot;,&quot;&quot;,&quot;zcs-amber&quot;));\n\t\t%&gt;\n&lt;div class=&quot;zcs-view&quot; id=&quot;v-success&quot;&gt;\n\t&lt;div class=&quot;zcs-success&quot;&gt;\n\t\t&lt;div class=&quot;zcs-success-ring&quot;&gt;\n\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t&lt;path d=&quot;M20 6 9 17l-5-5&quot;/&gt;\n\t\t\t&lt;/svg&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-success-t&quot;&gt;POD Submitted&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-success-s&quot;&gt;\n\t\t\tDelivery &lt;strong&gt;&lt;%=delivery_rec.Delivery_Number%&gt;&lt;/strong&gt; sent for approval\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- Outcome Badge --&gt;\n\t\t&lt;div class=&quot;zcs-outcome-badge &lt;%=outcome_color%&gt;&quot; style=&quot;margin-bottom:20px&quot;&gt;\n\t\t\t&lt;%=outcome%&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-success-grid&quot;&gt;\n\t\t\t&lt;!-- Delivery Card --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Delivery&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Number&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Customer&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Items&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Total_Items%&gt; (&lt;%=delivery_rec.Total_Weight_kg%&gt; kg)&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Route / Stop&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Route_Number%&gt; \u00B7 #&lt;%=delivery_rec.Stop_Sequence%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- Status Card --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Status&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Outcome&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v &lt;%=outcome_color%&gt;&quot;&gt;&lt;%=outcome%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Verified&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;&lt;%=total_count%&gt; / &lt;%=total_count%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Discrepancies&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v &lt;%=if(disc_count &gt; 0,&quot;zcs-amber&quot;,&quot;zcs-green&quot;)%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;%=if(disc_count &gt; 0,disc_count + &quot; item(s)&quot;,&quot;None&quot;)%&gt;\n\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Signature&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v &lt;%=if(has_signature,&quot;zcs-green&quot;,&quot;zcs-amber&quot;)%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;%=if(has_signature,&quot;\u2713 Captured&quot;,&quot;\u2717 Missing&quot;)%&gt;\n\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Approval&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;Pending&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- Discrepancy Details (if any) --&gt;\n&lt;%\n\t\tif(disc_count &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-card&quot; style=&quot;width:100%;max-width:600px;margin-top:16px;text-align:left&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-info-head&quot; style=&quot;color:var(--zcs-amber);background:var(--zcs-amber-bg)&quot;&gt;\n\t\t\t\tDiscrepancies (&lt;%=disc_count%&gt;)\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\tfor each  di in disc_items\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;&lt;%=di.Product.Product.Product_Name%&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-amber&quot;&gt;&lt;%=di.Ordered_Qty%&gt; \u2192 &lt;%=di.Delivered_Qty%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/main&gt;\n\n&lt;!-- \u2550\u2550\u2550 RIGHT PANEL \u2550\u2550\u2550 --&gt;\n&lt;aside class=&quot;zcs-panel&quot; id=&quot;zcsPanel&quot;&gt;\n\t&lt;div class=&quot;zcs-drawer-bar&quot;&gt;&lt;/div&gt;\n\n\t&lt;!-- \u2550\u2550\u2550 ACTIVITY TIMELINE \u2550\u2550\u2550 --&gt;\n\t&lt;div class=&quot;zcs-rp-section&quot;&gt;\n\t\t&lt;div class=&quot;zcs-rp-label&quot;&gt;Activity Timeline&lt;/div&gt;\n&lt;%\n\ttl_entries = Timeline[Delivery_Number == input.delivery_id] sort by Added_Time asc;\n\ttl_total = tl_entries.count();\n\ttl_index = 0;\n\t// Icon map based on action\n\t// Done = checkmark, Active = compass, Future = dot\n\tif(tl_total == 0)\n\t{\n\t\t%&gt;\n&lt;div style=&quot;text-align:center;padding:20px 0&quot;&gt;\n\t\t\t\t&lt;div style=&quot;font-size:24px;margin-bottom:6px&quot;&gt;?&lt;/div&gt;\n\t\t\t\t&lt;div style=&quot;font-size:12px;color:var(--zcs-light)&quot;&gt;No activity yet&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tfor each  tl in tl_entries\n\t{\n\t\ttl_index = tl_index + 1;\n\t\tis_last = tl_index == tl_total;\n\t\t// Determine dot style\n\t\tif(is_last)\n\t\t{\n\t\t\titem_class = &quot;&quot;;\n\t\t\tdot_class = &quot;zcs-tl-active&quot;;\n\t\t}\n\t\telse\n\t\t{\n\t\t\titem_class = &quot;zcs-tl-item-done&quot;;\n\t\t\tdot_class = &quot;zcs-tl-done&quot;;\n\t\t}\n\t\t// Format timestamp\n\t\ttl_time = toString(tl.Date_Time,&quot;hh:mm a&quot;);\n\t\t// Duration text\n\t\tdur_text = &quot;&quot;;\n\t\t// Pick icon SVG based on action type\n\t\tif(tl.Action_field == &quot;Synced from SAP&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4&apos;/&gt;&lt;polyline points=&apos;7 10 12 15 17 10&apos;/&gt;&lt;line x1=&apos;12&apos; y1=&apos;15&apos; x2=&apos;12&apos; y2=&apos;3&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Delivery Started&quot; || tl.Action_field == &quot;Re-attempt Started&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;rect x=&apos;1&apos; y=&apos;3&apos; width=&apos;15&apos; height=&apos;13&apos;/&gt;&lt;path d=&apos;M16 8h4l3 3v5h-7V8z&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Arrived&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z&apos;/&gt;&lt;circle cx=&apos;12&apos; cy=&apos;10&apos; r=&apos;3&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Verification Completed&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;rect width=&apos;8&apos; height=&apos;4&apos; x=&apos;8&apos; y=&apos;2&apos; rx=&apos;1&apos;/&gt;&lt;path d=&apos;M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Signature Captured&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Signature Refused&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;circle cx=&apos;12&apos; cy=&apos;12&apos; r=&apos;10&apos;/&gt;&lt;line x1=&apos;15&apos; y1=&apos;9&apos; x2=&apos;9&apos; y2=&apos;15&apos;/&gt;&lt;line x1=&apos;9&apos; y1=&apos;9&apos; x2=&apos;15&apos; y2=&apos;15&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;POD Submitted&quot; || tl.Action_field == &quot;POD Re-submitted&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4&apos;/&gt;&lt;polyline points=&apos;17 8 12 3 7 8&apos;/&gt;&lt;line x1=&apos;12&apos; y1=&apos;3&apos; x2=&apos;12&apos; y2=&apos;15&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;POD Approved&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M20 6 9 17l-5-5&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;POD Rejected&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;circle cx=&apos;12&apos; cy=&apos;12&apos; r=&apos;10&apos;/&gt;&lt;line x1=&apos;15&apos; y1=&apos;9&apos; x2=&apos;9&apos; y2=&apos;15&apos;/&gt;&lt;line x1=&apos;9&apos; y1=&apos;9&apos; x2=&apos;15&apos; y2=&apos;15&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Driver Reassigned&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2&apos;/&gt;&lt;circle cx=&apos;9&apos; cy=&apos;7&apos; r=&apos;4&apos;/&gt;&lt;polyline points=&apos;16 11 18 13 22 9&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Issue Reported&quot; || tl.Action_field == &quot;Window Alert&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&apos;/&gt;&lt;path d=&apos;M12 9v4&apos;/&gt;&lt;path d=&apos;M12 17h.01&apos;/&gt;&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;SAP Updated&quot;)\n\t\t{\n\t\t\ticon_svg = &quot;&lt;path d=&apos;M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z&apos;/&gt;&quot;;\n\t\t}\n\t\telse\n\t\t{\n\t\t\t// Default: checkmark for done, dot for active\n\t\t\tif(is_last)\n\t\t\t{\n\t\t\t\ticon_svg = &quot;&lt;polygon points=&apos;3 11 22 2 13 21 11 13 3 11&apos;/&gt;&quot;;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\ticon_svg = &quot;&lt;path d=&apos;M20 6 9 17l-5-5&apos;/&gt;&quot;;\n\t\t\t}\n\t\t}\n\t\t// Color override for warnings/rejections\n\t\tdot_override = &quot;&quot;;\n\t\tif(tl.Action_field == &quot;POD Rejected&quot; || tl.Action_field == &quot;Issue Reported&quot; || tl.Action_field == &quot;Signature Refused&quot;)\n\t\t{\n\t\t\tdot_override = &quot;zcs-tl-error&quot;;\n\t\t}\n\t\telse if(tl.Action_field == &quot;Window Alert&quot;)\n\t\t{\n\t\t\tdot_override = &quot;zcs-tl-warn&quot;;\n\t\t}\n\t\t%&gt;\n&lt;div class=&quot;zcs-tl-item &lt;%=item_class%&gt;&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-tl-dot &lt;%=dot_class%&gt; &lt;%=dot_override%&gt;&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; \n\t\t\t\t\t\t stroke-width=&quot;&lt;%=if(is_last,&quot;2&quot;,&quot;3&quot;)%&gt;&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;%=icon_svg%&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-tl-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-tl-title &lt;%=if(is_last,&quot;&quot;,&quot;&quot;)%&gt;&quot;&gt;&lt;%=tl.Action_field%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-tl-time&quot;&gt;&lt;%=tl_time%&gt;&lt;%=dur_text%&gt;&lt;/div&gt;\n&lt;%\n\t\tif(tl.Description != null &amp;&amp; tl.Description != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-tl-desc&quot;&gt;&lt;%=tl.Description%&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\n\t&lt;!-- \u2550\u2550\u2550 TODAY&apos;S STATS (Dynamic) \u2550\u2550\u2550 --&gt;\n\t&lt;div class=&quot;zcs-rp-section&quot;&gt;\n\t\t&lt;div class=&quot;zcs-rp-label&quot;&gt;Today&apos;s Stats&lt;/div&gt;\n&lt;%\n\t// Get today&apos;s deliveries for this driver\n\tdriver_id = delivery_rec.Driver;\n\ttoday_deliveries = Outbound_Deliveries_Form[Driver == driver_id &amp;&amp; Planned_Delivery_Date == zoho.currentdate];\n\ttotal_stops = today_deliveries.count();\n\tcompleted_stops = 0;\n\ttotal_weight = 0;\n\ttotal_distance = 0;\n\tfor each  td in today_deliveries\n\t{\n\t\ttotal_weight = total_weight + ifnull(td.Total_Weight_kg,0);\n\t\ttotal_distance = total_distance + ifnull(td.Distance_km,0);\n\t}\n\t%&gt;\n&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Distance&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=total_distance%&gt; km&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Completed&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-v &lt;%=if(completed_stops == total_stops,&quot;zcs-green&quot;,&quot;&quot;)%&gt;&quot;&gt;\n\t\t\t\t\t&lt;%=completed_stops%&gt; / &lt;%=total_stops%&gt;\n\t\t\t\t&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Weight&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=total_weight%&gt; kg&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;/aside&gt;\n\n&lt;div class=&quot;zcs-overlay&quot; id=&quot;zcsOverlay&quot; onclick=&quot;zcsTogglePanel()&quot;&gt;&lt;/div&gt;\n&lt;button class=&quot;zcs-panel-fab&quot; id=&quot;zcsFab&quot; onclick=&quot;zcsTogglePanel()&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;10&quot; r=&quot;3&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;\n\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Driver_Dashboard
		{
					displayname = "Driver Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='20%'>\n\t\t\t\t<panel elementName='Board'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='top'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' borderColor='#FFFFFF' borderWidth='0px' color='#FFFFFF' bgColor='#EF4444' width='52px' height='52px' type='icon' value='ui-1-circle-remove' size='28px' cornerRadius='12px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Failed Deliveries'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#000000' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' borderColor='#10B981' borderWidth='0px' criteria='Delivery_Outcome == &quot;Not Delivered&quot; &amp;&amp; Driver.Email == zoho.loginuserid' value='thisapp.Outbound_Deliveries_Form.ID.count'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='10px' padding='0px' color='#909090' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#000000' borderWidth='0px' value='Today'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<panel elementName='Board'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='top'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' borderColor='#FFFFFF' borderWidth='0px' color='#FFFFFF' bgColor='#EF4444' width='52px' height='52px' type='icon' value='ui-1-circle-remove' size='28px' cornerRadius='12px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Failed Deliveries'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#000000' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' borderColor='#10B981' borderWidth='0px' criteria='Delivery_Outcome == &quot;Not Delivered&quot; &amp;&amp; Driver.Email == zoho.loginuserid' value='thisapp.Outbound_Deliveries_Form.ID.count'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='10px' padding='0px' color='#909090' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#000000' borderWidth='0px' value='Today'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<panel elementName='Board'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='top'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' borderColor='#FFFFFF' borderWidth='0px' color='#FFFFFF' bgColor='#EF4444' width='52px' height='52px' type='icon' value='ui-1-circle-remove' size='28px' cornerRadius='12px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Failed Deliveries'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#000000' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' borderColor='#10B981' borderWidth='0px' criteria='Delivery_Outcome == &quot;Not Delivered&quot; &amp;&amp; Driver.Email == zoho.loginuserid' value='thisapp.Outbound_Deliveries_Form.ID.count'>\n\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t</pc>\