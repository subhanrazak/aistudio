	functions
	{
		Deluge
		{
			string Styles_Popup.Active()
			{
			
			                 	style_text = thisapp.Styles_Popup.Popup() + ".zcs-popup-content.zcs-active-popup .zcs-popup-icon-wrapper { background-color: #e4fcf3; color: #179e6c; } .zcpopup.compact .popupbox-wrapper .statelessFormWidth .formbutton .zcs-live-primary-btn { background-color: #179e6c; border: 1px solid #179e6c; color: #FFF; } .zcpopup.compact .popupbox-wrapper .statelessFormWidth .formbutton .zcs-live-primary-btn:hover { background-color: #1EA13C; border: 1px solid #1EA13C; color: #FFF; }";
			                 	return style_text;
			                 
			}

			string Styles.App_CSS()
			{
			
			                 	to_be_removed = "a { text-decoration: none; }";
			                 	style_text = thisapp.Styles.Color_Codes() + thisapp.Styles.Grid() + thisapp.Styles_Creator.Element_Styles() + thisapp.Styles.To_Be_Removed() + to_be_removed;
			                 	return style_text;
			                 
			}

			string Styles.Avatar()
			{
			
			                 	style_text = ".zcs-avatar { width: var(--zcs-avatar-size); height: var(--zcs-avatar-size); background-color: var(--zcs_brand_color); border-radius: var(--zcs-avatar-radius); } .zcs-avatar .zcs-avatar-img { border-radius: inherit; object-fit: cover; } .zcs-avatar-badge { width: 8px; height: 8px; top: -1px; right: -1px; border: 1px solid var(--zcs-white-color); background-color: var(--zcs_brand_color); } .zcs-avatar-grp .zcs-avatar { border: 1px solid var(--zcs-white-color); margin-left: -8px; }";
			                 	return style_text;
			                 
			}

			string Styles.Badge()
			{
			
			                 	style_text = ".zcs-badge { width: max-content; white-space: nowrap; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; } /* Filled Badge */ .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-violet { background-color: #8200DB; border-color: #8200DB; color: var(--zcs-white-color); } /* Filled Outline Badge */ .zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-light-bg-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); } .zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; } .zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; } .zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; } .zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #FAAE13; } .zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; } .zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; } .zcs-badge-filled-outline.zcs-badge-violet { background-color: #F7EEFD; border-color: #8200DB; color: #8200DB; } /* Outline Badge */ .zcs-badge-outline.zcs-badge-theme { color: var(--zcs-theme-brand-color); } .zcs-badge-outline.zcs-badge-green { color: #179E6C; } .zcs-badge-outline.zcs-badge-red { color: #FE455D; } .zcs-badge-outline.zcs-badge-grey { color: #242424; } .zcs-badge-outline.zcs-badge-yellow { color: #FAAE13; } .zcs-badge-outline.zcs-badge-blue { color: #2A6FFC; } .zcs-badge-outline.zcs-badge-orange { color: #F4660C; } .zcs-badge-outline.zcs-badge-violet { color: #8200DB; }";
			                 	return style_text;
			                 
			}

			string Styles.Banner()
			{
			
			                 	style_text = ".zcs-toast-link:hover { text-decoration: underline; } .zcs-outline-toast { border: 1px solid; } .zcs-theme-toast { background-color: var(--zcs_component_hover_color); } .zcs-outline-toast.zcs-theme-toast { border: 1px solid var(--zcs_brand_color); } .zcs-success-toast { background-color: #edf7ed; color: #1d4620; } .zcs-info-toast { background-color: #e4f6fd; color: #024361; } .zcs-warning-toast { background-color: #fef4e5; color: #663c01; } .zcs-error-toast { background-color: #feedec; color: #5f2120; } .zcs-filled-toast { color: #fff; } .zcs-filled-toast.zcs-success-toast { background-color: #2e7d32; } .zcs-filled-toast.zcs-info-toast { background-color: #0588d1; } .zcs-filled-toast.zcs-warning-toast { background-color: #ed6c03; } .zcs-filled-toast.zcs-error-toast { background-color: #d32f2f; }";
			                 	return style_text;
			                 
			}

			string Styles.Button()
			{
			
			                 	style_text = ".zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-fw-button { width: 100%; } .zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); } .zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); } .zcs-secondary-button { border: 1px solid var(--zcs_primary_border_color); background-color: var(--zcs_light_grey_color); color: var(--zcs_primary_text_color); } .zcs-primary-button.zcs-custom-color { background-color: var(--zcs-button-color); } .zcs-primary-outline-button.zcs-custom-color { border-color: var(--zcs-button-color); color: var(--zcs-button-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color); } .zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); } .zcs-secondary-button:hover { background-color: --zcs_dark_grey_color; } .zcs-primary-button.zcs-custom-color:hover { background-color: var(--zcs-button-hover-color); } .zcs-primary-outline-button.zcs-custom-color:hover { background-color: var(--zcs-button-hover-color); border-color: var(--zcs-button-hover-color); } .zcs-primary-button.zcs-button:active, .zcs-primary-button.zcs-button:focus { background-color: var(--zcs_component_hover_color); outline: 2px solid var(--zcs_brand_color); outline-offset: 2px; } .zcs-primary-button.zcs-custom-color:active, .zcs-primary-button.zcs-custom-color:focus { background-color: var(--zcs-button-hover-color); outline: 2px solid var(--zcs-button-color); outline-offset: 2px; } .zcs-primary-outline-button.zcs-button:active, .zcs-primary-outline-button.zcs-button:focus { background-color: var(--zcs_component_hover_color); outline: 2px solid var(--zcs_brand_color); outline-offset: 2px; color: var(--zcs_brand_color); } .zcs-primary-outline-button.zcs-custom-color:active, .zcs-primary-outline-button.zcs-custom-color:focus { background-color: var(--zcs-button-hover-color); outline: 2px solid var(--zcs-button-color); outline-offset: 2px; } .zcs-secondary-button.zcs-button:active, .zcs-secondary-button.zcs-button:focus { background-color: --zcs_dark_grey_color; outline: 2px solid var(--zcs_primary_border_color); outline-offset: 2px; } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-button-group .zcs-button { border-radius: 6px 0px 0px 6px; } .zcs-button-group .zcs-more-options { height: 37px; background-color: var(--zcs_brand_color); border-radius: 0px 6px 6px 0px; border-color: var(--zcs_brand_color); border-left-color: var(--zcs_brand_dark_color); } .zcs-button-group .zcs-more-options .zcs-mo-icon { color: var(--zcs_brand_foreground_color); } .zcs-button-group .zcs-more-options:hover { background-color: var(--zcs_brand_dark_color); border-color: var(--zcs_brand_dark_color); color: var(--zcs_brand_foreground_color); } .zcs-button-group .zcs-more-options:hover .zcs-mo-icon { color: var(--zcs_brand_foreground_color); }";
			                 	rtl_text = ".zc-rtl-wrapper .zcs-button-group .zcs-button { border-radius: 0px 6px 6px 0px; } .zc-rtl-wrapper .zcs-button-group .zcs-more-options { border-radius: 6px 0px 0px 6px; border-left-color: var(--zcs-primary-btn-border-color); border-right-color: var(--zcs-primary-btn-h-border-color); }";
			                 	style_text = style_text + rtl_text;
			                 	return style_text;
			                 
			}

			string Styles.Color_Codes()
			{
			
			                 	style_text = ":root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; /* Button colors */ --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); /*yet to defined on layout files*/ --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); /*yet to defined on layout files*/ --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; }";
			                 	return style_text;
			                 
			}

			string Util.DisplayFormat(map params)
			{
			
			                 	img_field_value = params.get("img_field_value");
			                 	report_name = params.get("report_name");
			                 	field_name = params.get("field_name");
			                 	name = params.get("name");
			                 	secondary_text = params.get("secondary_text");
			                 	recID = params.get("recID");
			                 	style_txt = ".zc-pa-rt-clearfix { display: inline-block; vertical-align: top; } .zc-pa-rt-flt-left { float: left; } .zc-pa-rt .zc-pa-rt-img-wrapper { width: 40px; height: 40px; border-radius: 50%; padding: 5px 10px 5px 0px; box-sizing: border-box; } .zc-pa-rt .zc-pa-rt-img-wrapper img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; } .zc-pa-rt-primary-text {font-size: 14px; line-height: 1.5; font-weight: 500; letter-spacing: 0.1px; color: #131635; display: block; } .zc-pa-rt-secondary-text { font-size: 13px; line-height: 1.5; font-weight: 400; letter-spacing: 0.1px; color: #666D79; display: block; } .zc-pa-rt.zc-pa-rt-clearfix {display: flex; align-items: center;}";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-pa-rt-flt-left { float: right; } .zc-rtl-wrapper .zc-pa-rt-img-wrapper { padding: 5px 0px 5px 10px; }";
			                 	style_txt = " <style> " + style_txt + rtl_txt + " </style> ";
			                 	// img_field_value should be fetched image field value.
			                 	// report_name should be source report of image, The report must be shared with the user/ portal user.
			                 	// field_name should be actual name of image field.
			                 	final_img = "";
			                 	if(img_field_value != null && img_field_value != "")
			                 	{
			                 		// 		image_url = img_field_value.getSuffix("src = \"").getPrefix("\" lowqual");
			                 		// 		image_name = image_url.getSuffix("/image/");
			                 		// 		src = image_url.replaceAll("/sharedBy/appLinkName/viewLinkName/fieldName/image/",zoho.appuri + report_name + "/" + field_name + "/image/");
			                 		// 		emp_photo = "<img src=" + zoho.appuri + "report/Employees_Report/" + employee.ID + "/Photo/download-file?filepath=/" + employee.Photo + "&mediaType=1>";
			                 		// 		src = zoho.appuri + "report/" + report_name + "/" + recID + "/" + field_name + "/download-file?filepath=/" + img_field_value.getSuffix("image/").getPrefix("\"") + "&mediaType=1";
			                 		image_url = img_field_value.getSuffix("src = \"").getPrefix("\" lowqual");
			                 		image_name = image_url.getSuffix("/image/");
			                 		src = zoho.appuri + "report/" + report_name + "/" + recID + "/" + field_name + "/download-file?filepath=/" + image_name + "&mediaType=1";
			                 		final_img = "<style>.emp-photo{ height: 50px; border-radius: 10px; }</style><img src=" + src + " >";
			                 	}
			                 	else
			                 	{
			                 		avatar = "";
			                 		letter_to_be_displayed = "";
			                 		if(name != null)
			                 		{
			                 			name_to_list = name.toList(" ");
			                 			for each index list_index in name_to_list
			                 			{
			                 				if(name_to_list.get(list_index) != "")
			                 				{
			                 					letter_to_be_displayed = letter_to_be_displayed + name_to_list.get(list_index).subString(0,1).toUpperCase();
			                 				}
			                 				if(list_index == 3)
			                 				{
			                 					break;
			                 				}
			                 			}
			                 			avatar_style = "<style>.custom-letter-avatar{height: 100%; width: 100%;border-radius:10px;display: flex;align-items: center;justify-content: center;font-size:14px;}</style>";
			                 			background_color = "#5051f9";
			                 			background_color = "#" + randomNumber(1000000,9999999).toHex();
			                 			avatar = avatar_style + "<span style=' width: 100%; height: 100%; border-radius: 50%; display: block; background-color: " + background_color + "; font-size: 13px; font-weight: 400; line-height: 30px; color: #FFF; letter-spacing: 0.1px; text-align: center; '>" + letter_to_be_displayed + "</span>";
			                 			final_img = avatar;
			                 		}
			                 	}
			                 	Dis_Format = style_txt + "<div class='zc-pa-rt zc-pa-rt-clearfix'><div class='zc-pa-rt-flt-left zc-pa-rt-img-wrapper'>" + final_img.replaceAll("width=100%","style='width: 30px; height: 30px; border-radius: 50%; object-fit: contain;'") + "</div><div class='zc-pa-rt-flt-left'><span class='zc-pa-rt-primary-text'>" + name + "</span>";
			                 	if(secondary_text != null)
			                 	{
			                 		Dis_Format = Dis_Format + "<span class='zc-pa-rt-secondary-text'>" + secondary_text + "</span>";
			                 	}
			                 	Dis_Format = Dis_Format + "</div>";
			                 	return Dis_Format;
			                 
			}

			string Styles.Divider()
			{
			
			                 	style_text = ".zcs-divider-horizontal { border-top: 1px solid var(--zcs-border-color); } .zcs-divider-horizontal.zcs-divider-dashed { border-top-style: dashed; } .zcs-divider-horizontal.zcs-divider-dotted { border-top-style: dotted; } .zcs-divider-vertical { border-left: 1px solid var(--zcs-border-color); } .zcs-divider-vertical.zcs-divider-dashed { border-left-style: dashed; } .zcs-divider-vertical.zcs-divider-dotted { border-left-style: dotted; } .zcs-divider-card-text { border: 1px solid var(--zcs-border-color); }";
			                 	return style_text;
			                 
			}

			string Styles_Creator.Element_Styles()
			{
			
			                 	style_text = ".zc-pb-page-content-wrapper div#zppagesLive, .zc-pb-page-content-wrapper div#elementsContainer, .zc-pb-page-content-wrapper .elemContainment, .zc-pb-page-content-wrapper .zcpage-elemContainer { height: 100%; } .zc-container-wrapper .zc-main-content .inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment, .zc-full-height .zc-page-content-wrapper .zc-pb-page-content-wrapper .elemContainment, .zc-pb-page-content-wrapper .zc-pb-tile-container { padding: 0px; } .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-container, .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { border-radius: 0px !important; } .zc-page-content-wrapper .zc-pb-page-content-wrapper .zc-pb-tile-card { box-shadow: none !important; } #splash-screen { display: none !important; }";
			                 	return style_text;
			                 
			}

			string Styles.Grid()
			{
			
