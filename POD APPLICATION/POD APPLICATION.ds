=&quot;zcs-page-head&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-head-left&quot;&gt;\n\t\t\t&lt;a href=&quot;#Report:All_Outbound_Deliveries&quot; class=&quot;zcs-back&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m15 18-6-6 6-6&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&quot;zcs-page-title-wrap&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-title&quot;&gt;Verify Delivery Items&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-sub&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt; \u00B7 &lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- Steps --&gt;\n\t&lt;div class=&quot;zcs-steps&quot;&gt;\n\t\t&lt;div class=&quot;zcs-step zcs-step-active&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Verify Items&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-step&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Signature&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-step&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Notes &amp;amp; Submit&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- \u2605 NEW: Info strip above form --&gt;\n\t&lt;div class=&quot;zcs-verify-info-strip&quot;&gt;\n\t\t&lt;!-- Customer --&gt;\n\t\t&lt;div class=&quot;zcs-vis-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-icon zcs-vis-blue&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;path d=&quot;M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;7&quot; r=&quot;4&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-label&quot;&gt;Customer&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-value&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;!-- Address --&gt;\n\t\t&lt;div class=&quot;zcs-vis-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-icon zcs-vis-red&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;path d=&quot;M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;10&quot; r=&quot;3&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-label&quot;&gt;Delivery Address&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-value&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;!-- Items / Weight --&gt;\n\t\t&lt;div class=&quot;zcs-vis-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-icon zcs-vis-purple&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;path d=&quot;M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-label&quot;&gt;Total&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-value&quot;&gt;&lt;%=delivery_rec.Total_Items%&gt; items \u00B7 &lt;%=delivery_rec.Total_Weight_kg%&gt; kg&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;!-- Delivery Window --&gt;\n&lt;%\n\t\tw_start = toString(delivery_rec.Delivery_Window_Start,&quot;hh:mm a&quot;);\n\t\tw_end = toString(delivery_rec.Delivery_Window_End,&quot;hh:mm a&quot;);\n\t\t%&gt;\n&lt;div class=&quot;zcs-vis-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-icon zcs-vis-green&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;10&quot;/&gt;&lt;polyline points=&quot;12 6 12 12 16 14&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-vis-body&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-label&quot;&gt;Window&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-vis-value&quot;&gt;&lt;%=w_start%&gt; \u2013 &lt;%=w_end%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- \u2605 NEW: Special Instructions (if exists) --&gt;\n&lt;%\n\t\tif(delivery_rec.Special_Instructions != null &amp;&amp; delivery_rec.Special_Instructions != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-instr&quot; style=&quot;margin-bottom:16px&quot;&gt;\n\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t&lt;path d=&quot;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&quot;/&gt;\n\t\t\t&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;\n\t\t&lt;/svg&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;zcs-instr-title&quot;&gt;Special Instructions&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-instr-text&quot;&gt;&lt;%=delivery_rec.Special_Instructions%&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;!-- \u2605 NEW: Quick guide --&gt;\n\t&lt;div class=&quot;zcs-verify-guide&quot;&gt;\n\t\t&lt;div class=&quot;zcs-verify-guide-item&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-vg-num&quot;&gt;1&lt;/span&gt;\n\t\t\t&lt;span&gt;Check physical items against ordered qty&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-verify-guide-item&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-vg-num&quot;&gt;2&lt;/span&gt;\n\t\t\t&lt;span&gt;Enter actual delivered qty&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-verify-guide-item&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-vg-num&quot;&gt;3&lt;/span&gt;\n\t\t\t&lt;span&gt;If qty differs \u2014 select reason &amp;amp; take photo&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- Verify Form --&gt;\n\t&lt;div class=&quot;zcs-verify-form-wrap&quot;&gt;\n\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;POD_Form&apos; params=&apos;Action_field=Verify Items&amp;Delivery_Number=&lt;%=input.delivery_id%&gt;&amp;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Next&amp;amp;zc_ResetVal=Reset&apos; zc_MobileView=&quot;inline&quot;&gt;Loading Form...&lt;/div&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n&lt;%\n\t}\n\telse if(delivery_rec.Delivery_Status == &quot;Verified&quot;)\n\t{\n\t\t// Pre-calculate\n\t\tverify_items_rec = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id];\n\t\tv_items = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id];\n\t\tdisc_items = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id &amp;&amp; Delivered_Qty != Ordered_Qty];\n\t\tdisc_count = disc_items.count();\n\t\ttotal_count = v_items.count();\n\t\tmatched_count = total_count - disc_count;\n\t\tarrived_tl = Timeline[Delivery_Number == input.delivery_id &amp;&amp; Action_field == &quot;Arrived at Customer&quot;];\n\t\tarrived_time = if(arrived_tl.count() &gt; 0,toString(arrived_tl.Date_Time,&quot;hh:mm a&quot;),&quot;\u2014&quot;);\n\t\tw_start = toString(delivery_rec.Delivery_Window_Start,&quot;hh:mm a&quot;);\n\t\tw_end = toString(delivery_rec.Delivery_Window_End,&quot;hh:mm a&quot;);\n\t\tdraft_pod_rec = POD_Form[Delivery_Number == input.delivery_id &amp;&amp; Status == &quot;Draft&quot;];\n\t\t%&gt;\n&lt;div class=&quot;zcs-view zcs-active&quot; id=&quot;v-signature&quot;&gt;\n\t&lt;div class=&quot;zcs-page-head&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-head-left&quot;&gt;\n\t\t\t&lt;a href=&quot;#Report:All_Outbound_Deliveries&quot; class=&quot;zcs-back&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m15 18-6-6 6-6&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&quot;zcs-page-title-wrap&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-title&quot;&gt;Capture Signature&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-sub&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt; \u00B7 &lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- Steps --&gt;\n\t&lt;div class=&quot;zcs-steps&quot;&gt;\n\t\t&lt;div class=&quot;zcs-step zcs-step-done&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Verify Items&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-step zcs-step-active&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Signature&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-step&quot;&gt;&lt;div class=&quot;zcs-step-track&quot;&gt;&lt;/div&gt;&lt;div class=&quot;zcs-step-lbl&quot;&gt;Notes &amp;amp; Submit&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- \u2605 Discrepancy alert (if any) --&gt;\n&lt;%\n\t\tif(disc_count &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-disc&quot; style=&quot;border-radius:var(--zcs-radius);margin-bottom:16px&quot;&gt;\n\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t&lt;path d=&quot;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&quot;/&gt;\n\t\t\t&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;\n\t\t&lt;/svg&gt;\n\t\t&lt;p&gt;&lt;%=disc_count%&gt; item(s) with quantity discrepancy. Customer signs for actual quantities delivered.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;!-- \u2605 2-column layout: Form left, Info right --&gt;\n\t&lt;div class=&quot;zcs-vcols&quot;&gt;\n\n\t\t&lt;!-- LEFT: Form --&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;zcs-verify-form-wrap&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Receipient_Details&apos; \n\t\t\t\t\t\t params=&apos;Delivery_Number=&lt;%=input.delivery_id%&gt;&amp;Verify_Items=&lt;%=verify_items_rec.ID%&gt;&amp;zc_Header=false&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Next&amp;zc_ResetVal=Reset&apos; zc_MobileView=&quot;inline&quot;&gt;\n\t\t\t\t\tLoading Form...\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- RIGHT: Context cards --&gt;\n\t\t&lt;div&gt;\n\n\t\t\t&lt;!-- \u2605 Verification Summary --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Verification Summary&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-verify-summary-bar&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-vsb-fill&quot; style=&quot;width:&lt;%=(matched_count * 100 / total_count).round(0)%&gt;%&quot;&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-verify-summary-stats&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-vss-item&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-val zcs-green&quot;&gt;&lt;%=matched_count%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-label&quot;&gt;Matched&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-vss-item&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-val zcs-amber&quot;&gt;&lt;%=disc_count%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-label&quot;&gt;Discrepancy&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-vss-item&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-val&quot;&gt;&lt;%=total_count%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-vss-label&quot;&gt;Total&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- \u2605 Delivered Items --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Delivered Items&lt;/div&gt;\n\t\t\t\t&lt;div style=&quot;padding:10px 16px&quot;&gt;\n&lt;%\n\t\tfor each  vi in v_items\n\t\t{\n\t\t\tvi_color = if(vi.Delivered_Qty == vi.Ordered_Qty,&quot;zcs-ri-ok&quot;,&quot;zcs-ri-warn&quot;);\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-ri&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-dot &lt;%=vi_color%&gt;&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-name&quot;&gt;&lt;%=vi.Product.Product_Display%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-ri-qty &lt;%=vi_color%&gt;&quot;&gt;&lt;%=vi.Delivered_Qty%&gt;/&lt;%=vi.Ordered_Qty%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- \u2605 Discrepancy Details (if any) --&gt;\n&lt;%\n\t\tif(disc_count &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot; style=&quot;color:var(--zcs-amber);background:var(--zcs-amber-bg)&quot;&gt;\n\t\t\t\t\tDiscrepancies (&lt;%=disc_count%&gt;)\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\tfor each  di in disc_items\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;zcs-disc-item&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Item&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=di.Product.Product_Display%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Qty&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-amber&quot;&gt;&lt;%=di.Ordered_Qty%&gt; \u2192 &lt;%=di.Delivered_Qty%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Reason&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=ifnull(di.Reason_Code,&quot;\u2014&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;!-- \u2605 Delivery Info --&gt;\n\t\t\t&lt;div class=&quot;zcs-card&quot; style=&quot;margin-bottom:12px&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-head&quot;&gt;Delivery Info&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Delivery #&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Customer&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Address&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Route / Stop&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.Route_Number%&gt; \u00B7 #&lt;%=delivery_rec.Stop_Sequence%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Window&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v zcs-green&quot;&gt;&lt;%=w_start%&gt; \u2013 &lt;%=w_end%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;Arrived&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=arrived_time%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-info-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-k&quot;&gt;SAP Doc&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-info-v&quot;&gt;&lt;%=delivery_rec.SAP_ID%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- \u2605 Special Instructions --&gt;\n&lt;%\n\t\tif(delivery_rec.Special_Instructions != null &amp;&amp; delivery_rec.Special_Instructions != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-instr&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t\t\t\t&lt;path d=&quot;m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z&quot;/&gt;\n\t\t\t\t\t&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-instr-title&quot;&gt;Special Instructions&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-instr-text&quot;&gt;&lt;%=delivery_rec.Special_Instructions%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse if(delivery_rec.Delivery_Status == &quot;POD Captured&quot;)\n\t{\n\t\tv_items = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id];\n\t\tdisc_items = POD_Line_Items[POD_ID.Delivery_Number == input.delivery_id &amp;&amp; Delivered_Qty != Ordered_Qty];\n\t\tdisc_count = disc_items.count();\n\t\ttotal_count = v_items.count();\n\t\tmatched_count = total_count - disc_count;\n\t\tpod_rec = POD_Form[Delivery_Number == input.delivery_id];\n\t\tarrived_tl = Timeline[Delivery_Number == input.delivery_id &amp;&amp; Action_field == &quot;Arrived at Customer&quot;];\n\t\tarrived_time = if(arrived_tl.count() &gt; 0,toString(arrived_tl.Date_Time,&quot;dd-MMM-yyyy hh:mm a&quot;),&quot;\u2014&quot;);\n\t\tstarted_tl = Timeline[Delivery_Number == input.delivery_id &amp;&amp; Action_field == &quot;Delivery Started&quot;];\n\t\tstarted_time = if(started_tl.count() &gt; 0,toString(started_tl.Date_Time,&quot;hh:mm a&quot;),&quot;\u2014&quot;);\n\t\tverified_tl = Timeline[Delivery_Number == input.delivery_id &amp;&amp; Action_field == &quot;Verification Completed&quot;];\n\t\tverified_time = if(verified_tl.count() &gt; 0,toString(verified_tl.Date_Time,&quot;hh:mm a&quot;),&quot;\u2014&quot;);\n\t\tsig_tl = Timeline[Delivery_Number == input.delivery_id &amp;&amp; Action_field == &quot;Signature Captured&quot;];\n\t\tsig_time = if(sig_tl.count() &gt; 0,toString(sig_tl.Date_Time,&quot;hh:mm a&quot;),&quot;\u2014&quot;);\n\t\tw_start = toString(delivery_rec.Delivery_Window_Start,&quot;hh:mm a&quot;);\n\t\tw_end = toString(delivery_rec.Delivery_Window_End,&quot;hh:mm a&quot;);\n\t\t%&gt;\n&lt;div class=&quot;zcs-view zcs-active&quot; id=&quot;v-review&quot;&gt;\n\t&lt;div class=&quot;zcs-page-head&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-head-left&quot;&gt;\n\t\t\t&lt;a href=&quot;#Report:All_Outbound_Deliveries&quot; class=&quot;zcs-back&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m15 18-6-6 6-6&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&quot;zcs-page-title-wrap&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-title&quot;&gt;Review &amp;amp; Submit&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-sub&quot;&gt;&lt;%=delivery_rec.Delivery_Number%&gt; \u00B7 &lt;%=delivery_rec.Customer.Customer_Name%&gt;&l