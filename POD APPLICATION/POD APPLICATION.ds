0vh; } .zcs-h-min { height: min-content; } .zcs-h-max { height: max-content; } /* Width & Height */ .zcs-wh-full { width: 100%; height: 100%; } /* Font Size */ .zcs-font-10 { font-size: 0.625rem; } .zcs-font-11 { font-size: 0.6875rem; } .zcs-font-12 { font-size: 0.75rem; } .zcs-font-13 { font-size: 0.8125rem; } .zcs-font-14 { font-size: 0.875rem; } .zcs-font-15 { font-size: 0.9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-17 { font-size: 1.0625rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-19 { font-size: 1.1875rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-21 { font-size: 1.3125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-23 { font-size: 1.4375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-25 { font-size: 1.5625rem; } .zcs-font-26 { font-size: 1.625rem; } .zcs-font-27 { font-size: 1.6875rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-29 { font-size: 1.8125rem; } .zcs-font-30 { font-size: 1.875rem; } h1, h2, h3, h4, h5, h6 { line-height: 1.25; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } /* Font Weight */ .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } /* Text Transform */ .zcs-uppercase { text-transform: uppercase; } .zcs-lowercase { text-transform: lowercase; } .zcs-capitalize { text-transform: capitalize; } .zcs-normal-case { text-transform: none; } /* Text Overflow */ .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } /* Text Decoration */ .zcs-underline { text-decoration-line: underline; } .zcs-overline { text-decoration-line: overline; } .zcs-line-through { text-decoration-line: line-through; } .zcs-no-underline { text-decoration-line: none; } /* Word Break */ .zcs-break-normal { overflow-wrap: normal; word-break: normal; } .zcs-break-words { overflow-wrap: break-word; } .zcs-break-all { word-break: break-all; } /* Border Radius */ .zcs-rounded-none