		{
					displayname = "test"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet3' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet3()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;iframe loading=&quot;lazy&quot; allowfullscreen=&quot;&quot; src=&quot;https://maps.google.com/maps?saddr=Guduvancheri%2C+Chengalpattu%2CTamil+Nadu%2C603202%2CIndia&amp;amp;daddr=45%2C+Rajaji+Street%2CNear+Central+Railway+Station%2CChennai%2CTamil+Nadu%2C600003%2CIndia&amp;amp;output=embed&quot; class=&quot;zcs-map-frame&quot; sandbox=&quot;allow-popups allow-forms allow-scripts allow-same-origin allow-presentation allow-downloads allow-modals&quot;&gt;\n&lt;/iframe&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
