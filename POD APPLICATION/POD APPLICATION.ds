			string Styles.Key_Value()
			{
			
			                 	style_text = ".zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; } .zcs-labelvalue-wrapper.zcs-labelvalue-with-divider ul li:not(:last-child)::after { content: ''; width: 1px; height: 21px; display: inline-block; vertical-align: top; background-color: #EBECF0; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color: #a06309; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; } .zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }";
			                 	return style_text;
			                 
			}

			string Styles_Creator.LL_Spinner()
			{
			
			                 	style_text = ".zc-page-shimmer-wrap.page-1, .zc-report-shimmer-wrap.report-1, .zc-form-shimmer-wrap.form-1 { width: 100%; height: 100%; background-color: rgba(255, 255, 255, 0.7) !important; display: flex !important; flex-direction: row; justify-content: center; align-items: center; position: absolute; padding: 0; overflow: hidden; } .zc-content-loader .form-1.zc-form-shimmer-wrap .zc-shimmer-card { height: 10px; border-width: 0px; } .zc-content-loader .zc-report-shimmer-wrap .zc-shimmer-content { padding: 0px; border-width: 0px; } .zc-page-shimmer-wrap.page-1 *:not(.zc-shimmer-card-row), .zc-form-shimmer-wrap.form-1 *:not(.zc-shimmer-card), .zc-report-shimmer-wrap.report-1 *:not(.zc-shimmer-content), .zc-shimmer-card-row * { display: none; } .zc-shimmer-card-row, .zc-report-shimmer-wrap .zc-shimmer-content, .zc-form-shimmer-wrap .zc-shimmer-card { width: 10px; height: 10px; border-radius: 5px; background-color: var(--zcs_brand_color); color: var(--zcs_brand_color); position: relative; top: -10px; transform-origin: 5px 15px; animation: dotWindmill 2s infinite linear; margin: 0px; padding: 0px; } .zc-shimmer-card-row:before, .zc-shimmer-card-row:after, .zc-report-shimmer-wrap .zc-shimmer-content:before, .zc-report-shimmer-wrap .zc-shimmer-content:after, .zc-form-shimmer-wrap .zc-shimmer-card:before, .zc-form-shimmer-wrap .zc-shimmer-card:after { content: ''; display: inline-block; position: absolute; top: 15px; width: 10px; height: 10px; border-radius: 5px; background-color: var(--zcs_brand_color); color: var(--zcs_brand_color); } .zc-shimmer-card-row:before, .zc-report-shimmer-wrap .zc-shimmer-content:before, .zc-form-shimmer-wrap .zc-shimmer-card:before { left: -8.66px; } .zc-shimmer-card-row:after, .zc-report-shimmer-wrap .zc-shimmer-content:after, .zc-form-shimmer-wrap .zc-shimmer-card:after { left: 8.66px; }";
			                 	return style_text;
			                 
			}

			string Styles_Popup.Popup()
			{
			
			                 	style_text = ".zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .popupConentContainer .form-outer-wrapper form .formContainer { padding: 20px 30px; } .zcpopup.compact .popupbox-wrapper .form-outer-wrapper form, .zcpopup.compact .popupbox-wrapper .form-outer-wrapper form .zc-addnote-fld { width: 100%; } .zcpopup.compact .popupbox-wrapper .form-outer-wrapper form .form-group { margin-bottom: 0px; } .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .popupConentContainer .form-outer-wrapper form .zc-footer-wrapper { padding: 0px; } .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .popupConentContainer .form-outer-wrapper form .zc-footer-wrapper .formbutton { border-top: 1px solid var(--zc-scom-border-color); padding: 16px; text-align: center; } .zcpopup.compact .popupbox-wrapper .formbutton .zc-live-primary-btn { margin: 0px; }";
			                 	common_style_text = ".zcs-popup-content .zcs-popup-icon-wrapper { width: 48px; height: 48px; } .zcs-popup-content .zcs-popup-icon-wrapper i { vertical-align: top; font-style: normal; }";
			                 	style_text = style_text + common_style_text;
			                 	return style_text;
			                 
			}

			string Styles.Progress_Bar()
			{
			
			                 	style_text = ".zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }";
			                 	return style_text;
			                 
			}

			string Util.RatingStars(map ratingParams)
			{
			
			                 	rating = ratingParams.get("rating");
			                 	if(rating != null && rating <= 5)
			                 	{
			                 		rating_html = "<style>.zc-pra-star-wrapper.zc-pra-clearfix { display: flex; } .zc-pra-i-wrapper.zc-pra-flt-left i.fa { color: #ffc650; margin-left: 3px; } span.zc-pra-flt-left.zc-pra-star-txt { margin-left: 5px; }</style><div class='zc-pra-star-wrapper zc-pra-clearfix'><div class='zc-pra-i-wrapper zc-pra-flt-left'>";
			                 		if(rating >= 1)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star'></i>";
			                 		}
			                 		else if(rating < 1 && rating > 0)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-half-o'></i>";
			                 		}
			                 		else
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-o'></i>";
			                 		}
			                 		if(rating >= 2)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star'></i>";
			                 		}
			                 		else if(rating < 2 && rating > 1)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-half-o'></i>";
			                 		}
			                 		else
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-o'></i>";
			                 		}
			                 		if(rating >= 3)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star'></i>";
			                 		}
			                 		else if(rating < 3 && rating > 2)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-half-o'></i>";
			                 		}
			                 		else
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-o'></i>";
			                 		}
			                 		if(rating >= 4)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star'></i>";
			                 		}
			                 		else if(rating < 4 && rating > 3)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-half-o'></i>";
			                 		}
			                 		else
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-o'></i>";
			                 		}
			                 		if(rating >= 5)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star'></i>";
			                 		}
			                 		else if(rating < 5 && rating > 4)
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-half-o'></i>";
			                 		}
			                 		else
			                 		{
			                 			rating_html = rating_html + "<i class='fa fa-star-o'></i>";
			                 		}
			                 		rating_html = rating_html + "</div>";
			                 		if(ratingParams.get("show_count") == true)
			                 		{
			                 			rating_html = rating_html + "<span class='zc-pra-flt-left zc-pra-star-txt'>(" + rating + ")</span>";
			                 		}
			                 		rating_html = rating_html + "</div>";
			                 	}
			                 	else
			                 	{
			                 		rating_html = "";
			                 	}
			                 	return rating_html;
			                 
			}

			string Styles.Table()
			{
			
