application "POD"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "12-hr"



	forms
	{
		form Approve_POD
		{
		
					displayname = "Approve POD"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					plain
					(
		    			type = plaintext
						value = "<div>Are you sure want to approve this POD?<br /></div>"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Comments
					(
		    			type = textarea
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					POD_ID
					(
						type = picklist	
						displayname = "POD ID"
						values  = POD_Form.ID
		    			displayformat = [POD_ID]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		}

		form Arrived
		{
		
					success message = "Data Added Successfully!"
					feature property = 8
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Notes
					(
		    			type = plaintext
						value = "<div>Are you arrived at customer's location?</div>"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					must have Delivery_Number
					(
						type = picklist	
						displayname = "Delivery Number"
						values  = Outbound_Deliveries_Form.ID
		    			displayformat = [Delivery_Number]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Arrived
							(
		   						type = submit
		   						displayname = "Arrived"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
						}
					}
				
		}

		form Assign_Driver
		{
		
					displayname = "Assign Driver"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					plain
					(
		    			type = plaintext
						value = "<div><br /></div>"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Driver
					(
						type = picklist	
						values  = Driver.ID
		    			displayformat = [Driver_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Vehicle
					(
						type = picklist	
						values  = Vehicle.ID
		    			displayformat = [Vehicle_Number]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					must have Delivery_Number
					(
						type = picklist	
						displayname = "Delivery Number"
						values  = Outbound_Deliveries_Form.ID
		    			displayformat = [Delivery_Number]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		}

		form Collect_Customer_Feedback
		{
		
					displayname = "Get Customer Feedback"
					store data in zc = false
