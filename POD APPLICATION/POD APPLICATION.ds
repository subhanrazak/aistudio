		page Order_Details_New(string page_action, int record_id)
		{
					displayname = "Order Details New"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet4' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet4()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tdelivery_rec = Outbound_Deliveries_Form[ID == input.record_id];\n\tlogged_in_role = thisapp.Util.getLoggedInProfile();\n\t%&gt;\n&lt;style&gt;\n&lt;%=thisapp.Styles.App_CSS()%&gt;\n&lt;%=thisapp.Styles.Avatar()%&gt;\n&lt;%=thisapp.Styles.Button()%&gt;\n&lt;%=thisapp.Styles.Timeline()%&gt;\n&lt;%=thisapp.Styles.Key_Value()%&gt;\n&lt;%=thisapp.Styles.Badge()%&gt;\n&lt;%=thisapp.Styles.Progress_Bar()%&gt;\n&lt;%=thisapp.Styles.Divider()%&gt;\n&lt;%=thisapp.Styles.Table()%&gt;\n&lt;%=thisapp.Styles.Banner()%&gt;\n\n.zcs-page-container {\n\tbackground-color: var(--zcs-page-bg-color);\n}\n.zcs-page-fleet_job_order .zcs-page-header {\n\t\tbackground-color: #FFF;\n}\n.zcs-icon-wrapper {\n\t\twidth: 32px;\n\t\theight: 32px;\n\t\tbackground-color: #F5F4FA;\n\t\tcolor: #4B4274;\n}\n.zcs-tl-card {\n\t\tbackground-color: #FAFBFF;\n}\n.zcs-tl-icon {\n\t\tbackground-color: #F2F5FF;\n\t\tcolor: #5B5481;\n}\n.zcs-pl-60 {\n\t\tpadding: 0px 20px 0px 70px;\n}\n@media (max-width: 768px) {\n\t.zcs-labelvalue-with_divider .zcs-divider {\n\t\tdisplay: none;\n\t}\n\t.zcs-labelvalue-with_divider ul {\n\t\tgap: 16px;\n\t}\n\t.zcs-bottom-info {\n\t\theight: auto;\n\t\toverflow: initial;\n\t}\n\t.zcs-contact-card {\n\t\theight: auto;\n\t}\n}\n.zcs-labelvalue-with_divider ul li {\n\t\tmin-width: 150px;\n}\n\n.zcs-outline-toast.zcs-custom-toast {\n\t\tborder: 1px solid #5051f9;\n\tbackground-color: #ededff;\n}\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page-container zcs-page-fleet_job_order zcs-wh-full&apos;&gt;\n\t\t&lt;div class=&apos;zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-page-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-20 zcs-py-9 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-16 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;a href=&apos;#Report:All_Outbound_Deliveries&apos; class=&apos;zcs-back&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt; &lt;%=delivery_rec.Delivery_Number%&gt; &lt;/h5&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-lg zcs-px-10 zcs-py-0 zcs-box-border zcs-badge-red&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Delivery_Status%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(delivery_rec.Delivery_Status == &quot;Assigned&quot; &amp;&amp; logged_in_role in {&quot;Administrator&quot;,&quot;Admin&quot;} || delivery_rec.Driver.Email == zoho.loginuserid)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos;\n\t\t\t\thref=&apos;#Form:Start?Delivery_Number=&lt;%=input.record_id%&gt;&amp;Action_field=Start&amp;zc_LoadIn=dialog&amp;zc_Header=false&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt; &lt;i value=&quot;media-1-button-play&quot; html=&quot;media-1-button-play&quot; class=&quot;media-1-button-play zc-li-outline zcs-font-semibold&quot;&gt;&lt;/i&gt; Start &lt;/span&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\telse if(delivery_rec.Delivery_Status == &quot;In Transit&quot; &amp;&amp; logged_in_role in {&quot;Administrator&quot;,&quot;Admin&quot;} || delivery_rec.Driver.Email == zoho.loginuserid)\n\t{\n\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos;\n\t\t\t\thref=&apos;#Form:Arrived?Delivery_Number=&lt;%=input.record_id%&gt;&amp;Action_field=Start&amp;zc_LoadIn=dialog&amp;zc_Header=false&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt; &lt;i value=&quot;files-check&quot; html=&quot;files-check&quot; class=&quot;files-check zc-li-outline zcs-font-semibold&quot;&gt;&lt;/i&gt; Arrived &lt;/span&gt;\n\t\t\t&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-page-content zcs-col-common zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border zcs-overflow-auto&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column&apos;&gt;\n\t\t\t\t\n\t\t\t\t\t\n\t \n\t\t\t\t&lt;div class=&quot;zcs-toast zcs-theme-toast zcs-row zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-p-20 zcs-rounded-lg zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-sm-12 zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n&lt;%\n\tif(delivery_rec.Customer.Customer_Logo.isEmpty() == false)\n\t{\n\t\t%&gt;\n&lt;div style=&quot;--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%&quot; class=&quot;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&quot;&gt;\n\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t&lt;img alt=&quot;John Smith&quot; src=&apos;&lt;%=thisapp.Util.processImageUrl(delivery_rec.Customer.Customer_Logo,delivery_rec.Customer.ID,&quot;All_Customers&quot;,&quot;Customer_Logo&quot;)%&gt;&apos; class=&quot;zcs-avatar-img zcs-wh-full&quot; data-src=&quot;https://mockmind-api.uifaces.co/content/human/125.jpg&quot; data-zc-image-queued=&quot;true&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-common zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=delivery_rec.Customer.Customer_Name%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-theme zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t &lt;%=delivery_rec.Customer.Customer_Email%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-sm-12 zcs-row zcs-align-items-center zcs-justify-end zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a href=&quot;tel:&lt;%=delivery_rec.Customer.Customer_Phone%&gt;&quot; class=&quot;zcs-col-sm-6 zcs-col-xs-12 zcs-button zcs-secondary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-3-phone&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt; Call &lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t &lt;!-- &lt;a href=&quot;&quot; class=&quot;zcs-col-sm-6 zcs-col-xs-12 zcs-button zcs-secondary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-chat-round-content&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt; Send message &lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;--&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\n\n\t\t\t\t\n\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-horizontal&apos;&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-labelvalue-with_divider zcs-labelvalue-wrapper zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;ul class=&apos;zcs-row zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Driver &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n&lt;%\n\tif(delivery_rec.Driver.Image.isEmpty() == false)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos;\n\t\t\t\t\t\t\t\t\tstyle=&apos;--zcs-avatar-size: 24px; --zcs-avatar-radius: 50%&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;img class=&apos;zcs-avatar-img zcs-wh-full&apos; src=&apos;&lt;%=thisapp.Util.processImageUrl(delivery_rec.Driver.Image,delivery_rec.Driver.ID,&quot;All_Drivers&quot;,&quot;Image&quot;)%&gt;&apos;\n\t\t\t\t\t\t\t\t\t\talt=&apos;&lt;%=delivery_rec.Driver.Driver_Name%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;%=delivery_rec.Driver.Driver_Name%&gt;\n\t\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Vehicle &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Vehicle.Vehicle_Number%&gt;  &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Route / Stop &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Route_Number%&gt; / &lt;%=delivery_rec.Stop_Sequence%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Total Weight / Total Items &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Total_Weight_kg%&gt; KG / &lt;%=delivery_rec.Total_Items%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Planned Delivery Date &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Planned_Delivery_Date%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Delivery Window &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Delivery_Window_Start%&gt; - &lt;%=delivery_rec.Delivery_Window_End%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\tif(delivery_rec.Delivery_Status in {&quot;Verified&quot;,&quot;POD Submitted&quot;,&quot;POD Captured&quot;,&quot;POD Approved&quot;,&quot;POD Rejected&quot;})\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Delivery Address &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Delivery_Address%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t}\n\tif(delivery_rec.Delivery_Status in {&quot;POD Submitted&quot;,&quot;POD Captured&quot;,&quot;POD Approved&quot;,&quot;POD Rejected&quot;})\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-divider zcs-divider-vertical&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-sm-6 zcs-col-xs-12&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; Delivery Outcome &lt;/label&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; &lt;%=delivery_rec.Delivery_Outcome%&gt; &lt;/span&gt;\n\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(delivery_rec.Special_Instructions.isEmpty() == false)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-toast zcs-outline-toast zcs-custom-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t&lt;i class=&apos;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline travel-info&apos;&gt;&lt;/i&gt;\n\t\t&lt;div class=&apos;zcs-toast-text&apos;&gt;\n\t\t\t\t&lt;p class=&apos;zcs-m-0&apos;&gt;\n\t\t\t\t\t\t&lt;%=delivery_rec.Special_Instructions%&gt;\n\t\t\t\t&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&apos;zcs-bottom-info zcs-row zcs-gap-16 zcs-col-common zcs-overflow-auto&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-col-6 zcs-col-sm-12&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-16&apos;&gt;\n&lt;%\n\tif(delivery_rec.Delivery_Status in {&quot;Assigned&quot;,&quot;In Transit&quot;,&quot;Arrived&quot;})\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-px-24 zcs-py-16 zcs-box-border&apos;&gt; Route &lt;/h6&gt;\n&lt;%\n\t\tif(delivery_rec.Delivery_Status in {&quot;In Transit&quot;})\n\t\t{\n\t\t\tstart_rec = Start[Delivery_Number == input.record_id];\n\t\t\t%&gt;\n&lt;iframe \n\tclass=&quot;zcs-map-frame&quot;\n\tsrc=&quot;https://maps.google.com/maps?saddr=&lt;%=encodeUrl(start_rec.Modified_Location)%&gt;&amp;daddr=&lt;%=encodeUrl(delivery_rec.Delivery_Address)%&gt;&amp;output=embed&quot;\n\tallowfullscreen loading=&quot;lazy&quot; height=&quot;400px&quot;&gt;\n&lt;/iframe&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Delivery_Status in {&quot;Arrived&quot;})\n\t\t{\n\t\t\tarrived_rec = Arrived[Delivery_Number == input.record_id];\n\t\t\t%&gt;\n&lt;iframe \n\tclass=&quot;zcs-map-frame&quot;\n\tsrc=&quot;https://maps.google.com/maps?saddr=&lt;%=encodeUrl(arrived_rec.Modified_Location)%&gt;&amp;daddr=&lt;%=encodeUrl(delivery_rec.Delivery_Address)%&gt;&amp;output=embed&quot;\n\tallowfullscreen loading=&quot;lazy&quot; height=&quot;400px&quot;&gt;\n&lt;/iframe&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;})\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;i value=&quot;location-pin&quot; html=&quot;location-pin&quot; class=&quot;location-pin zc-li-outline zcs-font-40&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;\n\t\t\t\t\t\t Route not available\n\t\t\t\t&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-teritiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;\n\t\t\t\t\t\tTap Start to capture your location and view the route to customer\n\t\t\t\t&lt;/p&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;zcs-divider zcs-divider-horizontal&apos;&gt;&lt;/div&gt;\n&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16  zcs-px-24 zcs-py-12 zcs-box-border&quot;&gt;\n\t&lt;span class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt; &lt;b&gt; Delivery Address: &lt;/b&gt; &lt;%=delivery_rec.Delivery_Address%&gt; &lt;/span&gt;\n&lt;%\n\t\tif(delivery_rec.Delivery_Status in {&quot;In Transit&quot;})\n\t\t{\n\t\t\t%&gt;\n&lt;a href=&apos;https://www.google.com/maps/dir/?api=1&amp;destination=&lt;%=delivery_rec.Delivery_Address%&gt;&apos; class=&quot;zcs-col-sm-6 zcs-col-xs-12 zcs-button zcs-primary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&quot;&gt;\n\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-3-send zcs-font-semibold&quot;&gt;&lt;/i&gt;\n\t\t&lt;span class=&quot;zcs-button-text&quot;&gt; Navigate &lt;/span&gt;\n\t&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\tif(delivery_rec.Delivery_Status in {&quot;Verified&quot;,&quot;POD Captured&quot;,&quot;POD Submitted&quot;,&quot;POD Approved&quot;,&quot;POD Rejected&quot;})\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-px-24 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt; Verified Items &lt;/h6&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Product &lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Delivered / Ordered &lt;/th&gt;\n\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Pending Quantity &lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Reason Code &lt;/th&gt;\n\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Notes &lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;5&apos;&gt; &lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each  v_item in POD_Line_Items[POD_ID.Delivery_Number == input.record_id]\n\t\t{\n\t\t\tcolor_class = &quot;zcs-color-primary&quot;;\n\t\t\tif(v_item.Delivered_Qty == v_item.Ordered_Qty)\n\t\t\t{\n\t\t\t\tcolor_class = &quot;zcs-color-green&quot;;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tcolor_class = &quot;zcs-color-red&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=v_item.Product.Product.Product_Name%&gt; &lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=color_class%&gt;&apos;&gt; &lt;%=v_item.Delivered_Qty%&gt; / &lt;%=v_item.Ordered_Qty%&gt; &lt;/td&gt;\n\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=v_item.Pending_Qty%&gt; &lt;/td&gt;\n\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=v_item.Reason_Code%&gt; &lt;/td&gt;\n\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=v_item.Notes%&gt; &lt;/td&gt;\n\t\t\t\t\t\t\t \n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(delivery_rec.Delivery_Status in {&quot;POD Captured&quot;,&quot;POD Submitted&quot;,&quot;POD Approved&quot;,&quot;POD Rejected&quot;})\n\t{\n\t\trecipient_rec = Receipient_Details[Delivery_Number == input.record_id];\n\t\tsignatureURL = zoho.appuri + &quot;report/Receipient_Details_Report/&quot; + recipient_rec.ID + &quot;/Receipient_Signature/download-file?filepath=/&quot; + recipient_rec.Receipient_Signature;\n\t\t%&gt;\n&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&quot;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt; Recipient Details &lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0 zcs-gap-16&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-col-6 zcs-col-xs-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt; Recipient Name &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt; &lt;%=recipient_rec.Receipient_Printed_Name%&gt; &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-col-6 zcs-col-xs-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt; Recipient Role &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt; &lt;%=recipient_rec.Receipient_Role%&gt; &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-col-6 zcs-col-xs-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt; Recipient Phone Number &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt; &lt;%=recipient_rec.Receipient_Phone%&gt; &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-col-6 zcs-col-xs-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt; Delivery Notes &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt; &lt;%=recipient_rec.POD_Form.Delivery_Notes%&gt;   &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-col-6 zcs-col-xs-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt; Recipient Signature &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;  &lt;img src=&apos;&lt;%=signatureURL%&gt;&apos; height=&apos;100px&apos;&gt;   &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;,&quot;In Transit&quot;,&quot;Arrived&quot;})\n\t{\n\t\tif(delivery_rec.Delivery_Status in {&quot;Pending&quot;,&quot;Assigned&quot;,&quot;In Transit&quot;})\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-px-24 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt; Delivery Items &lt;/h6&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Product &lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Quantity &lt;/th&gt;\n\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Weight &lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt; Status &lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;4&apos;&gt; &lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  item in Outbound_Delivery_Line_Items[Outbound_Deliveries_SAP == input.record_id]\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=item.Product.Product_Name%&gt; &lt;/td&gt;\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=item.Ordered_Qty%&gt; &lt;/td&gt;\n\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt; &lt;%=item.Total_Weight%&gt; &lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt; &lt;%=item.Status%&gt; &lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;\n\t\t&lt;/table&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Delivery_Status == &quot;Arrived&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-box-border&apos;&gt;\n&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;POD_Form&apos; params=&apos;Delivery_Number=&lt;%=input.record_id%&gt;&amp;zc_Header=false&amp;amp;zc_SubmitVal=Next&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse if(delivery_rec.Delivery_Status in {&quot;Verified&quot;})\n\t{\n\t\tif(delivery_rec.Need_OTP_Verification == false || (delivery_rec.Need_OTP_Verification == true &amp;&amp; delivery_rec.OTP_Verified == true))\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Receipient_Details&apos; params=&apos;Delivery_Number=&lt;%=input.record_id%&gt;&amp;zc_Header=false&amp;amp;zc_SubmitVal=Next&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(delivery_rec.Need_OTP_Verification == true &amp;&amp; delivery_rec.OTP_Verified == false)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Verify_OTP&apos; params=&apos;Delivery_Number=&lt;%=input.record_id%&gt;&amp;zc_Header=false&amp;amp;zc_SubmitVal=Next&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse if(delivery_rec.Delivery_Status in {&quot;POD Captured&quot;})\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-card zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Submit_POD&apos; params=&apos;Delivery_Number=&lt;%=input.record_id%&gt;&amp;zc_Header=false&amp;amp;zc_SuccMsg=POD Submitted Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-col-6 zcs-col-sm-12&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-contact-card zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-px-16 zcs-py-24 zcs-box-border zcs-h-full&apos;&gt;\n\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt; Timeline &lt;/h6&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-timeline-wrapper zcs-without-time&apos;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&apos;&gt;\n&lt;%\n\tfor each  timeline in Timeline[Delivery_Number == input.record_id] sort by Date_Time desc\n\t{\n\t\t%&gt;\n&lt;li class=&apos;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-xl zcs-font-16 zcs-relative zc-li-outline transportation-car&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-12 zcs-pl-60 zcs-pr-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-tl-card zcs-card zcs-flex zcs-direction-column zcs-px-20 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-row zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-col-common zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt; &lt;%=timeline.Action_field%&gt; &lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;!--&lt;div class=&apos;zcs-badge zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&apos;\n\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=&apos;background-color: #FFF3E4; color: #E17800;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt; Pending &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;--&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-6&apos;&gt; &lt;%=timeline.Description%&gt; &lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; &lt;%=timeline.Date_Time%&gt; &lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-lh-body zcs-color-primary zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt; &lt;%=thisapp.Util.timeSince(timeline.Date_Time)%&gt; &lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Order_Tracking(int order_id, string page_action, string search_key)
		{
					displayname = "Order Tracking"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet2' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet2()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\t\t\t\t*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n\t\t\t\thtml { scroll-behavior: smooth; }\n\t\t\t\tbody {\n\t\t\t\t\t\tfont-family: &apos;Inter&apos;, sans-serif;\n\t\t\t\t\t\tbackground: #F7F7F5;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tmin-height: 100vh;\n\t\t\t\t}\n\n\t\t \n\n\t\t\t\t/* ===== SEARCH SECTION ===== */\n\t\t\t\t.search-section {\n\t\t\t\t\t\tmax-width: 560px;\n\t\t\t\t\t\tmargin: 0 auto;\n\t\t\t\t\t\tpadding: 100px 24px 80px;\n\t\t\t\t\t\ttext-align: center;\n\t\t\t\t}\n\t\t\t\t.search-section h1 {\n\t\t\t\t\t\tfont-size: 28px;\n\t\t\t\t\t\tfont-weight: 500;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tletter-spacing: -0.6px;\n\t\t\t\t\t\tmargin-bottom: 8px;\n\t\t\t\t}\n\t\t\t\t.search-section p {\n\t\t\t\t\t\tfont-size: 14px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t\t\tmargin-bottom: 36px;\n\t\t\t\t\t\tline-height: 1.5;\n\t\t\t\t}\n\t\t\t\t.search-form {\n\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\tgap: 8px;\n\t\t\t\t}\n\t\t\t\t.search-form input {\n\t\t\t\t\t\tflex: 1;\n\t\t\t\t\t\tpadding: 13px 16px;\n\t\t\t\t\t\tborder: 1px solid #E0E0DE;\n\t\t\t\t\t\tborder-radius: 8px;\n\t\t\t\t\t\tfont-family: &apos;Inter&apos;, sans-serif;\n\t\t\t\t\t\tfont-size: 14px;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\toutline: none;\n\t\t\t\t\t\ttransition: border-color 0.2s;\n\t\t\t\t}\n\t\t\t\t.search-form input::placeholder { color: #B0B0AC; }\n\t\t\t\t.search-form input:focus { border-color: #1A1A1A; }\n\t\t\t\t.search-form button {\n\t\t\t\t\t\tpadding: 13px 24px;\n\t\t\t\t\t\tbackground: #1A1A1A;\n\t\t\t\t\t\tcolor: #fff;\n\t\t\t\t\t\tborder: none;\n\t\t\t\t\t\tborder-radius: 8px;\n\t\t\t\t\t\tfont-family: &apos;Inter&apos;, sans-serif;\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tcursor: pointer;\n\t\t\t\t\t\ttransition: background 0.2s;\n\t\t\t\t\t\twhite-space: nowrap;\n\t\t\t\t}\n\t\t\t\t.search-form button:hover { background: #333; }\n\t\t\t\t.search-hint {\n\t\t\t\t\t\tmargin-top: 14px;\n\t\t\t\t\t\tfont-size: 12px;\n\t\t\t\t\t\tcolor: #B0B0AC;\n\t\t\t\t}\n\t\t\t\t.search-hint code {\n\t\t\t\t\t\tbackground: #EEEEE9;\n\t\t\t\t\t\tpadding: 2px 6px;\n\t\t\t\t\t\tborder-radius: 3px;\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t}\n\n\t\t\t\t/* ===== NOT FOUND ===== */\n\t\t\t\t.not-found {\n\t\t\t\t\t\tmax-width: 440px;\n\t\t\t\t\t\tmargin: 0 auto;\n\t\t\t\t\t\tpadding: 80px 24px;\n\t\t\t\t\t\ttext-align: center;\n\t\t\t\t}\n\t\t\t\t.not-found-icon {\n\t\t\t\t\t\twidth: 56px;\n\t\t\t\t\t\theight: 56px;\n\t\t\t\t\t\tmargin: 0 auto 20px;\n\t\t\t\t\t\tbackground: #EEEEE9;\n\t\t\t\t\t\tborder-radius: 50%;\n\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\talign-items: center;\n\t\t\t\t\t\tjustify-content: center;\n\t\t\t\t}\n\t\t\t\t.not-found h2 {\n\t\t\t\t\t\tfont-size: 18px;\n\t\t\t\t\t\tfont-weight: 500;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tmargin-bottom: 6px;\n\t\t\t\t}\n\t\t\t\t.not-found p {\n\t\t\t\t\t\tfont-size: 14px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t\t\tmargin-bottom: 24px;\n\t\t\t\t\t\tline-height: 1.5;\n\t\t\t\t}\n\t\t\t\t.not-found a {\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\ttext-decoration: none;\n\t\t\t\t\t\tpadding: 10px 20px;\n\t\t\t\t\t\tborder: 1px solid #E0E0DE;\n\t\t\t\t\t\tborder-radius: 8px;\n\t\t\t\t\t\ttransition: background 0.2s;\n\t\t\t\t\t\tdisplay: inline-block;\n\t\t\t\t}\n\t\t\t\t.not-found a:hover { background: #EEEEE9; }\n\n\t\t\t\t/* ===== ORDER DETAIL ===== */\n\t\t\t\t.order-detail {\n\t\t\t\t\t\tmax-width: 800px;\n\t\t\t\t\t\tmargin: 0 auto;\n\t\t\t\t\t\tpadding: 40px 24px 80px;\n\t\t\t\t}\n\n\t\t\t\t/* Back link */\n\t\t\t\t.back-link {\n\t\t\t\t\t\tdisplay: inline-flex;\n\t\t\t\t\t\talign-items: center;\n\t\t\t\t\t\tgap: 6px;\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tfont-weight: 500;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t\t\ttext-decoration: none;\n\t\t\t\t\t\tmargin-bottom: 28px;\n\t\t\t\t\t\ttransition: color 0.2s;\n\t\t\t\t}\n\t\t\t\t.back-link:hover { color: #1A1A1A; }\n\n\t\t\t\t/* Order Header */\n\t\t\t\t.order-header {\n\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\tjustify-content: space-between;\n\t\t\t\t\t\talign-items: flex-start;\n\t\t\t\t\t\tmargin-bottom: 32px;\n\t\t\t\t\t\tflex-wrap: wrap;\n\t\t\t\t\t\tgap: 16px;\n\t\t\t\t}\n\t\t\t\t.order-header-left h1 {\n\t\t\t\t\t\tfont-size: 24px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tletter-spacing: -0.5px;\n\t\t\t\t\t\tmargin-bottom: 4px;\n\t\t\t\t}\n\t\t\t\t.order-header-left p {\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t}\n\t\t\t\t.order-status-badge {\n\t\t\t\t\t\tdisplay: inline-flex;\n\t\t\t\t\t\talign-items: center;\n\t\t\t\t\t\tgap: 6px;\n\t\t\t\t\t\tpadding: 6px 14px;\n\t\t\t\t\t\tborder-radius: 6px;\n\t\t\t\t\t\tfont-size: 12px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tletter-spacing: 0.2px;\n\t\t\t\t}\n\t\t\t\t.badge-dot {\n\t\t\t\t\t\twidth: 6px;\n\t\t\t\t\t\theight: 6px;\n\t\t\t\t\t\tborder-radius: 50%;\n\t\t\t\t}\n\t\t\t\t.badge-delivered { background: #E8F5E8; color: #2D7A2D; }\n\t\t\t\t.badge-delivered .badge-dot { background: #2D7A2D; }\n\t\t\t\t.badge-shipped { background: #E8F0FA; color: #2563EB; }\n\t\t\t\t.badge-shipped .badge-dot { background: #2563EB; }\n\t\t\t\t.badge-processing { background: #FEF3E2; color: #B45309; }\n\t\t\t\t.badge-processing .badge-dot { background: #B45309; }\n\t\t\t\t.badge-cancelled { background: #FDE8E8; color: #C53030; }\n\t\t\t\t.badge-cancelled .badge-dot { background: #C53030; }\n\n\t\t\t\t/* ===== TIMELINE ===== */\n\t\t\t\t.section-label {\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\ttext-transform: uppercase;\n\t\t\t\t\t\tletter-spacing: 0.8px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t\t\tmargin-bottom: 16px;\n\t\t\t\t}\n\t\t\t\t.timeline-card {\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder: 1px solid #E8E8E6;\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\t\t\t\tpadding: 24px;\n\t\t\t\t\t\tmargin-bottom: 28px;\n\t\t\t\t}\n\t\t\t\t.timeline {\n\t\t\t\t\t\tposition: relative;\n\t\t\t\t\t\tpadding-left: 24px;\n\t\t\t\t}\n\t\t\t\t.timeline::before {\n\t\t\t\t\t\tcontent: &apos;&apos;;\n\t\t\t\t\t\tposition: absolute;\n\t\t\t\t\t\tleft: 7px;\n\t\t\t\t\t\ttop: 6px;\n\t\t\t\t\t\tbottom: 6px;\n\t\t\t\t\t\twidth: 1.5px;\n\t\t\t\t\t\tbackground: #E8E8E6;\n\t\t\t\t}\n\t\t\t\t.tl-item {\n\t\t\t\t\t\tposition: relative;\n\t\t\t\t\t\tpadding-bottom: 22px;\n\t\t\t\t}\n\t\t\t\t.tl-item:last-child { padding-bottom: 0; }\n\t\t\t\t.tl-dot {\n\t\t\t\t\t\tposition: absolute;\n\t\t\t\t\t\tleft: -20px;\n\t\t\t\t\t\ttop: 3px;\n\t\t\t\t\t\twidth: 14px;\n\t\t\t\t\t\theight: 14px;\n\t\t\t\t\t\tborder-radius: 50%;\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder: 2px solid #E0E0DE;\n\t\t\t\t\t\tz-index: 1;\n\t\t\t\t}\n\t\t\t\t.tl-item.done .tl-dot {\n\t\t\t\t\t\tbackground: #1A1A1A;\n\t\t\t\t\t\tborder-color: #1A1A1A;\n\t\t\t\t}\n\t\t\t\t.tl-item.done .tl-dot::after {\n\t\t\t\t\t\tcontent: &apos;&apos;;\n\t\t\t\t\t\tposition: absolute;\n\t\t\t\t\t\ttop: 3px;\n\t\t\t\t\t\tleft: 3px;\n\t\t\t\t\t\twidth: 4px;\n\t\t\t\t\t\theight: 4px;\n\t\t\t\t\t\tborder-radius: 50%;\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t}\n\t\t\t\t.tl-item.current .tl-dot {\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder-color: #1A1A1A;\n\t\t\t\t\t\tbox-shadow: 0 0 0 3px rgba(26,26,26,0.1);\n\t\t\t\t}\n\t\t\t\t.tl-item.current .tl-dot::after {\n\t\t\t\t\t\tcontent: &apos;&apos;;\n\t\t\t\t\t\tposition: absolute;\n\t\t\t\t\t\ttop: 3px;\n\t\t\t\t\t\tleft: 3px;\n\t\t\t\t\t\twidth: 4px;\n\t\t\t\t\t\theight: 4px;\n\t\t\t\t\t\tborder-radius: 50%;\n\t\t\t\t\t\tbackground: #1A1A1A;\n\t\t\t\t}\n\t\t\t\t.tl-title {\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tmargin-bottom: 2px;\n\t\t\t\t}\n\t\t\t\t.tl-item.pending .tl-title { color: #B0B0AC; }\n\t\t\t\t.tl-desc {\n\t\t\t\t\t\tfont-size: 12px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t\t\tline-height: 1.4;\n\t\t\t\t}\n\t\t\t\t.tl-item.pending .tl-desc { color: #CCCCC8; }\n\t\t\t\t.tl-date {\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tcolor: #B0B0AC;\n\t\t\t\t\t\tmargin-top: 2px;\n\t\t\t\t}\n\n\t\t\t\t/* ===== INFO GRID ===== */\n\t\t\t\t.info-grid {\n\t\t\t\t\t\tdisplay: grid;\n\t\t\t\t\t\tgrid-template-columns: 1fr 1fr;\n\t\t\t\t\t\tgap: 12px;\n\t\t\t\t\t\tmargin-bottom: 28px;\n\t\t\t\t}\n\t\t\t\t.info-block {\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder: 1px solid #E8E8E6;\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\t\t\t\tpadding: 16px 20px;\n\t\t\t\t}\n\t\t\t\t.info-block-label {\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\ttext-transform: uppercase;\n\t\t\t\t\t\tletter-spacing: 0.6px;\n\t\t\t\t\t\tcolor: #B0B0AC;\n\t\t\t\t\t\tmargin-bottom: 6px;\n\t\t\t\t}\n\t\t\t\t.info-block-value {\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tfont-weight: 500;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tline-height: 1.5;\n\t\t\t\t}\n\n\t\t\t\t/* ===== ITEMS TABLE ===== */\n\t\t\t\t.items-card {\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder: 1px solid #E8E8E6;\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\t\t\t\tpadding: 20px 24px;\n\t\t\t\t\t\tmargin-bottom: 28px;\n\t\t\t\t}\n\t\t\t\t.items-table {\n\t\t\t\t\t\twidth: 100%;\n\t\t\t\t\t\tborder-collapse: collapse;\n\t\t\t\t}\n\t\t\t\t.items-table thead th {\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\ttext-transform: uppercase;\n\t\t\t\t\t\tletter-spacing: 0.6px;\n\t\t\t\t\t\tcolor: #B0B0AC;\n\t\t\t\t\t\ttext-align: left;\n\t\t\t\t\t\tpadding: 0 0 12px 0;\n\t\t\t\t\t\tborder-bottom: 1px solid #E8E8E6;\n\t\t\t\t}\n\t\t\t\t.items-table thead th:last-child { text-align: right; }\n\t\t\t\t.items-table thead th:nth-child(2) { text-align: center; }\n\t\t\t\t.items-table tbody td {\n\t\t\t\t\t\tpadding: 14px 0;\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t\t\tborder-bottom: 1px solid #F2F2F0;\n\t\t\t\t\t\tvertical-align: middle;\n\t\t\t\t}\n\t\t\t\t.items-table tbody tr:last-child td { border-bottom: none; }\n\t\t\t\t.items-table tbody td:last-child { text-align: right; font-weight: 600; }\n\t\t\t\t.items-table tbody td:nth-child(2) { text-align: center; color: #888; }\n\t\t\t\t.item-name {\n\t\t\t\t\t\tfont-weight: 500;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t}\n\t\t\t\t.item-sku {\n\t\t\t\t\t\tfont-size: 11px;\n\t\t\t\t\t\tcolor: #B0B0AC;\n\t\t\t\t\t\tmargin-top: 2px;\n\t\t\t\t}\n\n\t\t\t\t/* ===== SUMMARY ===== */\n\t\t\t\t.summary-card {\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tborder: 1px solid #E8E8E6;\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\t\t\t\tpadding: 20px 24px;\n\t\t\t\t}\n\t\t\t\t.summary-row {\n\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\tjustify-content: space-between;\n\t\t\t\t\t\tpadding: 5px 0;\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\tcolor: #888;\n\t\t\t\t}\n\t\t\t\t.summary-row.total {\n\t\t\t\t\t\tborder-top: 1px solid #E8E8E6;\n\t\t\t\t\t\tmargin-top: 8px;\n\t\t\t\t\t\tpadding-top: 12px;\n\t\t\t\t\t\tfont-weight: 600;\n\t\t\t\t\t\tfont-size: 15px;\n\t\t\t\t\t\tcolor: #1A1A1A;\n\t\t\t\t}\n\n\t\t\t\t/* ===== RESPONSIVE ===== */\n\t\t\t\t@media (max-width: 640px) {\n\t\t\t\t\t\t.info-grid { grid-template-columns: 1fr; }\n\t\t\t\t\t\t.order-header { flex-direction: column; }\n\t\t\t\t\t\t.search-form { flex-direction: column; }\n\t\t\t\t\t\t.navbar { padding: 12px 16px; }\n\t\t\t\t}\n\t\t&lt;/style&gt;\n&lt;%\n\tif(input.page_action.isEmpty())\n\t{\n\t\t%&gt;\n&lt;section class=&quot;search-section&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h1&gt;Track Your Order&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;Enter your order ID to get real-time updates on your shipment status and delivery timeline.&lt;/p&gt;\n&lt;!--                   &lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Order_Search&apos; params=&apos;Delivery_Number=&lt;%=input.search_key%&gt;&amp;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt; --&gt;\n\t\t\t\t   \n\t\t   \n\t\t\t\t   &lt;iframe height=&apos;500px&apos; width=&apos;100%&apos; frameborder=&apos;0&apos; allowTransparency=&apos;true&apos; scrolling=&apos;auto&apos; src=&apos;https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/form-embed/Order_Search/8Bh5DfYUyCJ7xvJDyESgN3O11rTSxddJA5ZuHq7qUkvwBzONvVGUkFawTaROx8AtuqQbD73ZXxTrbRuXAjbNqAEEN0nHqxaY4xqD&apos;&gt;&lt;/iframe&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n&lt;%\n\t}\n\telse if(input.page_action == &quot;no_result&quot;)\n\t{\n\t\t%&gt;\n&lt;section class=&quot;not-found&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;not-found-icon&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;svg width=&quot;24&quot; height=&quot;24&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;#888&quot; stroke-width=&quot;1.5&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;circle cx=&quot;11&quot; cy=&quot;11&quot; r=&quot;8&quot;&gt;&lt;/circle&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;path d=&quot;M21 21l-4.35-4.35&quot;&gt;&lt;/path&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/svg&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2&gt;Order not found&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;We couldn&apos;t find an order with ID &lt;strong&gt;&lt;%=input.search_key%&gt;aadad&lt;/strong&gt;. Please double-check and try again.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&quot;https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/page-perma/Order_Tracking/btKVpHWZfTYpRuTEXvVzY3AH1m4SfEP4yOk2J7eQhRyqWOT9CQj7GX8FYp5QqVhperTeHtRvgY5TFTNnBaMQ7UZERaBqehf1Cp2E&quot;&gt;\u2190 Try another search&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n&lt;%\n\t}\n\telse if(input.order_id.isEmpty() == false &amp;&amp; input.page_action == &quot;detail&quot;)\n\t{\n\t\tdelivery_rec = Outbound_Deliveries_Form[ID == input.order_id];\n\t\t%&gt;\n&lt;section class=&quot;order-detail&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Back --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&quot;https://creatorapp.zohopublic.com/creatorsolutions_zylker84/pod/page-perma/Order_Tracking/btKVpHWZfTYpRuTEXvVzY3AH1m4SfEP4yOk2J7eQhRyqWOT9CQj7GX8FYp5QqVhperTeHtRvgY5TFTNnBaMQ7UZERaBqehf1Cp2E&quot; class=&quot;back-link&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;svg width=&quot;14&quot; height=&quot;14&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;path d=&quot;M19 12H5&quot;&gt;&lt;/path&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;path d=&quot;M12 19l-7-7 7-7&quot;&gt;&lt;/path&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/svg&gt;\n\t\t\t\t\t\t\t\t\t\t\t\tBack to search\n\t\t\t\t\t\t\t\t\t\t&lt;/a&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Header --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;order-header&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;order-header-left&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h1&gt;&lt;%=delivery_rec.Delivery_Number%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;\u00B7 &lt;%=delivery_rec.Order_Date%&gt; &lt;%=if(delivery_rec.Delivered_Date.isEmpty() == false,&quot;\u00B7 Delivered &quot; + delivery_rec.Delivered_Date,null)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;order-status-badge badge-delivered&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;badge-dot&quot;&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=delivery_rec.Delivery_Status%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Timeline --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;section-label&quot;&gt;Timeline&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;timeline-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;timeline&quot;&gt;\n&lt;%\n\t\tfor each  t in Timeline[Delivery_Number == delivery_rec.ID]\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;tl-item done&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;tl-dot&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;tl-title&quot;&gt;&lt;%=t.Action_field%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;tl-desc&quot;&gt;&lt;%=t.Description%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;tl-date&quot;&gt;&lt;%=t.Date_Time%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Order Info --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;section-label&quot;&gt;Details&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-grid&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block-label&quot;&gt;Customer&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block-value&quot;&gt;&lt;%=delivery_rec.Customer.Customer_Name%&gt;&lt;br&gt;&lt;%=delivery_rec.Customer.Customer_Email%&gt;&lt;br&gt;&lt;%=delivery_rec.Customer.Customer_Phone%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block-label&quot;&gt;Shipping Address&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;info-block-value&quot;&gt;&lt;%=delivery_rec.Delivery_Address%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Items --&gt;\n\t\t\t\t\t\t\t\t\t &lt;!-- &lt;div class=&quot;section-label&quot;&gt;Items&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;items-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;table class=&quot;items-table&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th&gt;Qty&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;item-name&quot;&gt;Wireless Noise-Cancelling Headphones&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;item-sku&quot;&gt;WH-1000XM5&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;1&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;item-name&quot;&gt;USB-C Charging Cable (2m)&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;item-sku&quot;&gt;ACC-USB-2M&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;2&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;\u20B9599&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;--&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;!-- Summary --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;!--&lt;div class=&quot;section-label&quot;&gt;Summary&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;summary-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;summary-row&quot;&gt;&lt;span&gt;Subtotal&lt;/span&gt;&lt;span&gt;\u20B926,188&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;summary-row&quot;&gt;&lt;span&gt;Shipping&lt;/span&gt;&lt;span&gt;Free&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;summary-row&quot;&gt;&lt;span&gt;Tax (GST)&lt;/span&gt;&lt;span&gt;\u20B94,714&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;summary-row total&quot;&gt;&lt;span&gt;Total&lt;/span&gt;&lt;span&gt;\u20B930,902&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;--&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Outbound_Deliveries_Page
		{
					displayname = "Outbound Deliveries"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Panel'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='OpenReport' componentLinkName='All_Outbound_Deliveries' target='same-window' color='theme' size='16px' borderColor='theme' borderWidth='1px' text='Pending' bgColor='transparent' bgColorType='noFill' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<panel elementName='Panel 1'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='OpenReport' componentLinkName='All_Outbound_Deliveries' target='same-window' color='theme' size='16px' borderColor='theme' borderWidth='1px' text='Pending' bgColor='transparent' bgColorType='noFill' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page POD_Details(string page_action, int pod_id)
		{
					displayname = "POD Details"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet1' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet1()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tif(input.page_action.isEmpty())\n\t{\n\t\t%&gt;\n&lt;style&gt;\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n:root {\n\t--zcs-navy: #0F172A; --zcs-slate: #334155; --zcs-muted: #64748B; --zcs-light: #94A3B8;\n\t--zcs-faint: #CBD5E1; --zcs-border: #E2E8F0; --zcs-bg: #F1F5F9; --zcs-bg-warm: #F8FAFC; --zcs-surface: #FFF;\n\t--zcs-blue: #2563EB; --zcs-blue-bg: #EFF6FF; --zcs-blue-border: #BFDBFE;\n\t--zcs-green: #16A34A; --zcs-green-bg: #F0FDF4; --zcs-green-border: #BBF7D0;\n\t--zcs-amber: #D97706; --zcs-amber-bg: #FFFBEB; --zcs-amber-border: #FDE68A;\n\t--zcs-red: #DC2626; --zcs-red-bg: #FEF2F2; --zcs-red-border: #FECACA;\n\t--zcs-radius: 12px; --zcs-radius-sm: 8px; --zcs-radius-xs: 6px;\n\t--zcs-font: &apos;Inter&apos;, -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n}\nhtml, body { height: 100%; }\nbody { font-family: var(--zcs-font); background: var(--zcs-bg); color: var(--zcs-navy); -webkit-font-smoothing: antialiased; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 LAYOUT \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-shell { min-height: 100vh; }\n.zcs-layout { display: flex; min-height: 100vh; }\n.zcs-main { flex: 1; overflow-y: auto; padding: 24px 28px; min-width: 0; }\n.zcs-panel {\n\twidth: 300px; background: var(--zcs-surface); border-left: 1px solid var(--zcs-border);\n\toverflow-y: auto; padding: 20px; flex-shrink: 0;\n}\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 BUTTONS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-btn {\n\tdisplay: inline-flex; align-items: center; justify-content: center; gap: 8px;\n\tpadding: 11px 20px; border-radius: var(--zcs-radius-sm); border: none;\n\tfont-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.12s;\n\ttext-decoration: none; line-height: 1; white-space: nowrap;\n}\n.zcs-btn svg { width: 16px; height: 16px; flex-shrink: 0; }\n.zcs-btn-primary { background: var(--zcs-blue); color: #fff; }\n.zcs-btn-green { background: var(--zcs-green); color: #fff; }\n.zcs-btn-ghost { background: var(--zcs-bg-warm); color: var(--zcs-slate); border: 1px solid var(--zcs-border); }\n.zcs-btn:active { transform: scale(0.97); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 CHIPS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }\n.zcs-chip-dot { width: 6px; height: 6px; border-radius: 50%; }\n.zcs-chip-blue { background: var(--zcs-blue-bg); color: var(--zcs-blue); }\n.zcs-chip-blue .zcs-chip-dot { background: var(--zcs-blue); }\n.zcs-chip-green { background: var(--zcs-green-bg); color: var(--zcs-green); }\n.zcs-chip-green .zcs-chip-dot { background: var(--zcs-green); }\n.zcs-chip-red { background: var(--zcs-red-bg); color: var(--zcs-red); }\n.zcs-chip-red .zcs-chip-dot { background: var(--zcs-red); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 PAGE HEADER \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-page-head {\n\tdisplay: flex; align-items: flex-start; justify-content: space-between;\n\tmargin-bottom: 20px; gap: 12px; flex-wrap: wrap;\n}\n.zcs-page-head-left { display: flex; align-items: flex-start; gap: 12px; flex: 1; min-width: 0; }\n.zcs-back {\n\twidth: 38px; height: 38px; border-radius: var(--zcs-radius-sm);\n\tborder: 1px solid var(--zcs-border); background: var(--zcs-surface);\n\tdisplay: flex; align-items: center; justify-content: center;\n\tcursor: pointer; color: var(--zcs-slate); flex-shrink: 0; margin-top: 2px; text-decoration: none;\n}\n.zcs-back svg { width: 18px; height: 18px; }\n.zcs-page-title-wrap { min-width: 0; }\n.zcs-page-title {\n\tfont-size: 22px; font-weight: 900; letter-spacing: -0.04em; color: var(--zcs-navy);\n\tdisplay: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n}\n.zcs-page-sub { font-size: 13px; color: var(--zcs-muted); margin-top: 3px; }\n.zcs-page-actions { display: flex; gap: 8px; flex-shrink: 0; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 OUTCOME BANNER \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-ob {\n\tdisplay: flex; align-items: center; justify-content: space-between;\n\tpadding: 16px 20px; border-radius: var(--zcs-radius); margin-bottom: 20px; flex-wrap: wrap; gap: 12px;\n}\n.zcs-ob-green { background: var(--zcs-green-bg); border: 1px solid var(--zcs-green-border); }\n.zcs-ob-amber { background: var(--zcs-amber-bg); border: 1px solid var(--zcs-amber-border); }\n.zcs-ob-red { background: var(--zcs-red-bg); border: 1px solid var(--zcs-red-border); }\n\n.zcs-ob-left { display: flex; align-items: center; gap: 12px; }\n.zcs-ob-icon {\n\twidth: 44px; height: 44px; border-radius: 50%;\n\tdisplay: flex; align-items: center; justify-content: center; flex-shrink: 0;\n}\n.zcs-ob-icon svg { width: 22px; height: 22px; color: #fff; }\n.zcs-ob-icon.zcs-green { background: var(--zcs-green); }\n.zcs-ob-icon.zcs-amber { background: var(--zcs-amber); }\n.zcs-ob-icon.zcs-red { background: var(--zcs-red); }\n\n.zcs-ob-title { font-size: 17px; font-weight: 800; color: var(--zcs-navy); letter-spacing: -0.02em; }\n.zcs-ob-sub { font-size: 12px; color: var(--zcs-muted); margin-top: 2px; }\n\n.zcs-ob-badge {\n\tpadding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 800;\n}\n.zcs-ob-badge.zcs-green { background: var(--zcs-green); color: #fff; }\n.zcs-ob-badge.zcs-amber { background: var(--zcs-amber); color: #fff; }\n.zcs-ob-badge.zcs-red { background: var(--zcs-red); color: #fff; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 STAT GRID \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-stat-grid {\n\tdisplay: grid; grid-template-columns: repeat(4, 1fr);\n\tgap: 12px; margin-bottom: 20px;\n}\n.zcs-stat-card {\n\tbackground: var(--zcs-surface); border: 1px solid var(--zcs-border);\n\tborder-radius: var(--zcs-radius); padding: 18px 16px; text-align: center;\n}\n.zcs-stat-val {\n\tfont-size: 26px; font-weight: 900; letter-spacing: -0.04em;\n\tcolor: var(--zcs-navy); font-variant-numeric: tabular-nums; line-height: 1;\n}\n.zcs-stat-val.zcs-green { color: var(--zcs-green); }\n.zcs-stat-val.zcs-amber { color: var(--zcs-amber); }\n.zcs-stat-val.zcs-blue { color: var(--zcs-blue); }\n.zcs-stat-label {\n\tfont-size: 10px; font-weight: 700; color: var(--zcs-light);\n\ttext-transform: uppercase; letter-spacing: 0.06em; margin-top: 6px;\n}\n.zcs-stat-sub { font-size: 11px; color: var(--zcs-muted); margin-top: 2px; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 DELIVERY JOURNEY \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-journey {\n\tdisplay: flex; align-items: center; padding: 20px 16px; overflow-x: auto;\n}\n.zcs-jstep {\n\tdisplay: flex; flex-direction: column; align-items: center;\n\tgap: 6px; flex-shrink: 0; min-width: 72px;\n}\n.zcs-jdot {\n\twidth: 30px; height: 30px; border-radius: 50%;\n\tdisplay: flex; align-items: center; justify-content: center;\n}\n.zcs-jdot svg { width: 14px; height: 14px; }\n.zcs-jdot.zcs-jdone { background: var(--zcs-green); }\n.zcs-jdot.zcs-jdone svg { color: #fff; }\n.zcs-jdot.zcs-jcurrent { background: var(--zcs-blue-bg); border: 2.5px solid var(--zcs-blue); }\n.zcs-jdot.zcs-jcurrent svg { color: var(--zcs-blue); }\n.zcs-jdot.zcs-jreject { background: var(--zcs-red); }\n.zcs-jdot.zcs-jreject svg { color: #fff; }\n.zcs-jlabel { font-size: 10px; font-weight: 700; color: var(--zcs-muted); text-align: center; }\n.zcs-jtime { font-size: 9px; color: var(--zcs-light); text-align: center; }\n.zcs-jline { flex: 1; min-width: 20px; height: 2px; background: var(--zcs-green); margin-bottom: 34px; }\n.zcs-jline.zcs-jpending { background: none; border-top: 2px dashed var(--zcs-faint); height: 0; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 APPROVAL CARD \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-approval {\n\tbackground: var(--zcs-surface); border: 2px solid var(--zcs-blue);\n\tborder-radius: var(--zcs-radius); padding: 20px; margin-bottom: 20px;\n}\n.zcs-approval-head {\n\tdisplay: flex; align-items: center; gap: 10px; margin-bottom: 4px;\n}\n.zcs-approval-icon {\n\twidth: 32px; height: 32px; border-radius: 50%; background: var(--zcs-blue-bg);\n\tdisplay: flex; align-items: center; justify-content: center; flex-shrink: 0;\n}\n.zcs-approval-icon svg { width: 16px; height: 16px; color: var(--zcs-blue); }\n.zcs-approval-title { font-size: 15px; font-weight: 800; color: var(--zcs-navy); }\n.zcs-approval-sub {\n\tfont-size: 12px; color: var(--zcs-muted); margin-bottom: 16px;\n\tpadding-bottom: 14px; border-bottom: 1px solid var(--zcs-border);\n}\n.zcs-approval-btns { display: flex; gap: 10px; }\n.zcs-btn-approve {\n\tflex: 1; padding: 14px; background: var(--zcs-green); color: #fff;\n\tborder: none; border-radius: var(--zcs-radius-sm); font-size: 14px;\n\tfont-weight: 700; cursor: pointer; display: flex; align-items: center;\n\tjustify-content: center; gap: 8px; text-decoration: none;\n}\n.zcs-btn-reject {\n\tflex: 1; padding: 14px; background: var(--zcs-surface); color: var(--zcs-red);\n\tborder: 2px solid var(--zcs-red-border); border-radius: var(--zcs-radius-sm);\n\tfont-size: 14px; font-weight: 700; cursor: pointer; display: flex;\n\talign-items: center; justify-content: center; gap: 8px; text-decoration: none;\n}\n.zcs-btn-approve svg, .zcs-btn-reject svg { width: 18px; height: 18px; }\n.zcs-btn-approve:hover { background: #15803D; }\n.zcs-btn-reject:hover { background: var(--zcs-red-bg); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 REJECTION CARD \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-rejected {\n\tbackground: var(--zcs-red-bg); border: 1px solid var(--zcs-red-border);\n\tborder-radius: var(--zcs-radius); padding: 16px; margin-bottom: 20px;\n\tdisplay: flex; gap: 12px; align-items: flex-start;\n}\n.zcs-rejected-icon {\n\twidth: 36px; height: 36px; border-radius: 50%; background: var(--zcs-red);\n\tdisplay: flex; align-items: center; justify-content: center; flex-shrink: 0;\n}\n.zcs-rejected-icon svg { width: 16px; height: 16px; color: #fff; }\n.zcs-rejected-title { font-size: 12px; font-weight: 700; color: var(--zcs-red); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }\n.zcs-rejected-text { font-size: 13px; color: #991B1B; line-height: 1.5; }\n.zcs-rejected-by { font-size: 11px; color: var(--zcs-light); margin-top: 4px; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 CARDS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-card { background: var(--zcs-surface); border: 1px solid var(--zcs-border); border-radius: var(--zcs-radius); overflow: hidden; }\n.zcs-vcols { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: start; }\n\n.zcs-info-head {\n\tpadding: 12px 16px; font-size: 11px; font-weight: 700; color: var(--zcs-muted);\n\ttext-transform: uppercase; letter-spacing: 0.06em;\n\tborder-bottom: 1px solid var(--zcs-border); background: var(--zcs-bg-warm);\n}\n.zcs-info-row {\n\tdisplay: flex; justify-content: space-between; align-items: center;\n\tpadding: 11px 16px; border-bottom: 1px solid var(--zcs-bg); font-size: 13px; gap: 12px;\n}\n.zcs-info-row:last-child { border-bottom: none; }\n.zcs-info-k { color: var(--zcs-muted); font-weight: 500; white-space: nowrap; flex-shrink: 0; }\n.zcs-info-v { font-weight: 700; color: var(--zcs-navy); text-align: right; max-width: 60%; word-break: break-word; }\n.zcs-info-v.zcs-green { color: var(--zcs-green); }\n.zcs-info-v.zcs-amber { color: var(--zcs-amber); }\n.zcs-info-v.zcs-red { color: var(--zcs-red); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 VERIFICATION BAR \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-vbar { padding: 14px 16px 0; }\n.zcs-vbar-track { height: 8px; background: var(--zcs-bg); border-radius: 4px; overflow: hidden; }\n.zcs-vbar-fill { height: 100%; border-radius: 4px; }\n.zcs-vbar-fill.zcs-green { background: var(--zcs-green); }\n.zcs-vbar-fill.zcs-amber { background: var(--zcs-amber); }\n.zcs-vbar-stats { display: flex; gap: 8px; padding: 14px 16px; }\n.zcs-vbar-stat { flex: 1; text-align: center; padding: 10px 0; border-radius: var(--zcs-radius-sm); background: var(--zcs-bg-warm); }\n.zcs-vbar-stat-val { font-size: 20px; font-weight: 900; color: var(--zcs-navy); font-variant-numeric: tabular-nums; }\n.zcs-vbar-stat-label { font-size: 10px; font-weight: 700; color: var(--zcs-light); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 ITEMS TABLE \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-tbl-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--zcs-border); }\n.zcs-tbl-title { font-size: 14px; font-weight: 700; color: var(--zcs-navy); }\n.zcs-tbl-count { font-size: 12px; color: var(--zcs-muted); }\n.zcs-itbl { width: 100%; border-collapse: collapse; }\n.zcs-itbl th { font-size: 10px; font-weight: 700; color: var(--zcs-light); text-transform: uppercase; letter-spacing: 0.06em; padding: 10px 16px; text-align: left; background: var(--zcs-bg-warm); }\n.zcs-itbl td { padding: 12px 16px; border-bottom: 1px solid var(--zcs-bg); font-size: 13px; }\n.zcs-itbl tr:last-child td { border-bottom: none; }\n.zcs-itbl .zcs-r { text-align: right; }\n.zcs-iname { font-weight: 600; color: var(--zcs-navy); }\n.zcs-iqty { font-weight: 800; font-size: 14px; font-variant-numeric: tabular-nums; }\n\n.zcs-ri-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }\n.zcs-ri-dot.zcs-ri-ok { background: var(--zcs-green); }\n.zcs-ri-dot.zcs-ri-warn { background: var(--zcs-amber); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 DISCREPANCY ITEMS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-disc-item { border-bottom: 2px solid var(--zcs-amber-border); }\n.zcs-disc-item:last-child { border-bottom: none; }\n.zcs-disc-item-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px 0; }\n.zcs-disc-item-name { font-size: 14px; font-weight: 700; color: var(--zcs-navy); }\n.zcs-disc-item-badge { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; background: var(--zcs-amber-bg); color: var(--zcs-amber); border: 1px solid var(--zcs-amber-border); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 SIGNATURE IMAGE \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-sig-img { padding: 16px; text-align: center; border-top: 1px solid var(--zcs-bg); }\n.zcs-sig-img img { max-width: 100%; max-height: 140px; border: 1px dashed var(--zcs-faint); border-radius: var(--zcs-radius-sm); padding: 8px; background: var(--zcs-bg-warm); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 PHOTO GRID \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; padding: 12px 16px; }\n.zcs-photo-thumb { aspect-ratio: 1; border-radius: var(--zcs-radius-sm); overflow: hidden; border: 1px solid var(--zcs-border); background: var(--zcs-bg); display: flex; align-items: center; justify-content: center; }\n.zcs-photo-thumb img { width: 100%; height: 100%; object-fit: cover; }\n.zcs-photo-thumb svg { width: 24px; height: 24px; color: var(--zcs-faint); }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 CUSTOMER CARD \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-driver-row { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--zcs-bg); }\n.zcs-driver-avatar {\n\twidth: 40px; height: 40px; border-radius: 10px;\n\tbackground: linear-gradient(135deg, var(--zcs-blue), #6366F1);\n\tdisplay: flex; align-items: center; justify-content: center;\n\tcolor: #fff; font-weight: 800; font-size: 14px; flex-shrink: 0;\n}\n.zcs-driver-name { font-size: 14px; font-weight: 700; color: var(--zcs-navy); }\n.zcs-driver-meta { font-size: 12px; color: var(--zcs-muted); margin-top: 1px; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 DELIVERY NOTES \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-notes-body { padding: 14px 16px; font-size: 13px; color: var(--zcs-slate); line-height: 1.6; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 INSTRUCTIONS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-instr {\n\tdisplay: flex; gap: 12px; padding: 14px 16px;\n\tbackground: var(--zcs-amber-bg); border: 1px solid var(--zcs-amber-border);\n\tborder-radius: var(--zcs-radius);\n}\n.zcs-instr &gt; svg { width: 20px; height: 20px; color: var(--zcs-amber); flex-shrink: 0; margin-top: 1px; }\n.zcs-instr-title { font-size: 11px; font-weight: 700; color: var(--zcs-amber); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }\n.zcs-instr-text { font-size: 13px; color: #78350F; line-height: 1.5; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 RIGHT PANEL: TIMELINE \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n.zcs-rp-section { margin-bottom: 20px; }\n.zcs-rp-label { font-size: 10px; font-weight: 700; color: var(--zcs-light); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }\n\n.zcs-tl-item { display: flex; gap: 10px; padding-bottom: 14px; position: relative; }\n.zcs-tl-item:last-child { padding-bottom: 0; }\n.zcs-tl-item:not(:last-child)::after { content: &quot;&quot;; position: absolute; left: 10px; top: 24px; bottom: 0; width: 2px; background: var(--zcs-border); }\n.zcs-tl-dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--zcs-border); background: var(--zcs-surface); display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; }\n.zcs-tl-dot svg { width: 11px; height: 11px; color: var(--zcs-light); }\n.zcs-tl-dot.zcs-tl-done { background: var(--zcs-green); border-color: var(--zcs-green); }\n.zcs-tl-dot.zcs-tl-done svg { color: #fff; }\n.zcs-tl-dot.zcs-tl-active { border-color: var(--zcs-blue); background: var(--zcs-blue-bg); }\n.zcs-tl-dot.zcs-tl-active svg { color: var(--zcs-blue); }\n.zcs-tl-dot.zcs-tl-error { background: var(--zcs-red); border-color: var(--zcs-red); }\n.zcs-tl-dot.zcs-tl-error svg { color: #fff; }\n.zcs-tl-item-done::after { background: var(--zcs-green) !important; }\n.zcs-tl-title { font-size: 12px; font-weight: 600; color: var(--zcs-navy); }\n.zcs-tl-title.zcs-tl-future { color: var(--zcs-light); }\n.zcs-tl-time { font-size: 11px; color: var(--zcs-light); }\n.zcs-tl-desc { font-size: 11px; color: var(--zcs-light); margin-top: 2px; line-height: 1.4; }\n\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 RESPONSIVE \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\n@media (max-width: 1200px) {\n\t.zcs-stat-grid { grid-template-columns: repeat(2, 1fr); }\n\t.zcs-vcols { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {\n\t.zcs-layout { flex-direction: column; }\n\t.zcs-main { padding: 14px; }\n\t.zcs-panel { width: 100%; border-left: none; border-top: 1px solid var(--zcs-border); }\n\t.zcs-page-title { font-size: 18px; }\n\t.zcs-page-head { flex-direction: column; }\n\t.zcs-page-actions { width: 100%; }\n\t.zcs-page-actions .zcs-btn { flex: 1; }\n\t.zcs-stat-grid { grid-template-columns: 1fr 1fr; }\n\t.zcs-vcols { grid-template-columns: 1fr; }\n\t.zcs-ob { flex-direction: column; align-items: flex-start; }\n\t.zcs-itbl .zcs-hide-mob { display: none; }\n\t.zcs-approval-btns { flex-direction: column; }\n}\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n&lt;div class=&quot;zcs-shell&quot;&gt;\n&lt;div class=&quot;zcs-layout&quot;&gt;\n&lt;main class=&quot;zcs-main&quot;&gt;\n\n\t&lt;!-- \u2550\u2550\u2550 HEADER \u2550\u2550\u2550 --&gt;\n\t&lt;div class=&quot;zcs-page-head&quot;&gt;\n\t\t&lt;div class=&quot;zcs-page-head-left&quot;&gt;\n\t\t\t&lt;a href=&quot;#&quot; class=&quot;zcs-back&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;m15 18-6-6 6-6&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&quot;zcs-page-title-wrap&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-title&quot;&gt;\n\t\t\t\t\tPOD \u2014 OD-10018\n\t\t\t\t\t&lt;span class=&quot;zcs-chip zcs-chip-blue&quot;&gt;&lt;span class=&quot;zcs-chip-dot&quot;&gt;&lt;/span&gt; POD Submitted&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-page-sub&quot;&gt;Modern Retail Mart \u00B7 Route R004 \u00B7 Stop #3&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-page-actions&quot;&gt;\n&lt;%\n\t\texport_url = &quot;/export&quot; + zoho.appuri + &quot;pdf/POD_Details?pod_id=&quot; + input.pod_id + &quot;&amp;page_action=print&amp;isc5page=true&quot;;\n\t\t%&gt;\n&lt;a href=&quot;&lt;%=export_url%&gt;&quot; target=&quot;_blank&quot; class=&quot;zcs-btn zcs-btn-ghost&quot;&gt;\n\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; stroke-linecap=&quot;round&quot;&gt;\n\t\t&lt;polyline points=&quot;6 9 6 2 18 2 18 9&quot;/&gt;\n\t\t&lt;path d=&quot;M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2&quot;/&gt;\n\t\t&lt;rect width=&quot;12&quot; height=&quot;8&quot; x=&quot;6&quot; y=&quot;14&quot;/&gt;\n\t&lt;/svg&gt;\n\tPrint / PDF\n&lt;/a&gt;\n\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- \u2550\u2550\u2550 OUTCOME BANNER \u2014 Delivered \u2550\u2550\u2550 --&gt;\n\t&lt;div class=&quot;zcs-ob zcs-ob-amber&quot;&gt;\n\t\t&lt;div class=&quot;zcs-ob-left&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-ob-icon zcs-amber&quot;&gt;\n\t\t\t\t&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2.5&quot; stroke-linecap=&quot;round&quot;&gt;&lt;path d=&quot;M12 9v4&quot;/&gt;&lt;path d=&quot;M12 17h.01&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-ob-title&quot;&gt;Partially Delivered&lt;/div&gt;\n\t\t\t\t&lt;div cla