		form Driver
		{
		
					title 
		    		{
		    			on add = "Add Driver"
		   	 			on edit = "Edit Driver"
					}
					success message = "Driver details have been saved successfully."
					feature property = 256
					Driver_Information
					(
						type = section
						displayname = "Driver Information"
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Driver_Name
					(
		    			type = text
						displayname = "Driver Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Mobile_Number
					(
		    			type = phonenumber
						displayname = "Mobile Number"
		    			defaultcountry="in"
		    			description
		    			[
		    				type = help_text
		    			 	message = "Primary contact number for the driver."
		    			]
			 			row = 1
			 			column = 1   
						width = medium
					)
					Date_Of_Birth
					(
		    			type = date
						displayname = "Date Of Birth"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Image
					(
		    			type = image
						source  = file
						aspect ratio = original
						camera = primary
						show gallery = true
						switch camera = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have License_Number
					(
		    			type = text
						displayname = "License Number"
		    			description
		    			[
		    				type = help_text
		    			 	message = "Driver license number from SAP or official records."
		    			]
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Share_App
					(
		    			type = checkbox
						displayname = "Share App?"
						initial value = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					unique Driver_ID
					(
		    			type = text
						displayname = "Driver ID"
		    			description
		    			[
		    				type = help_text
		    			 	message = "Use the unique driver code from SAP."
		    			]
			 			row = 2
			 			column = 1   
						width = medium
					)
					S_No
					(
		    			type = autonumber
						start index = 1
			 			row = 2
			 			column = 1   
						width = medium
					)
					Driver_Display
					(
		    			type = richtext
						displayname = "Driver"
						height = 200px
						toolbar = enable
						[
							style, font-color, background-color, link, bullets-and-numbering, 
							font-size : {1, 2, 3, 4, 5, 6, 7}
						]
			 			row = 2
			 			column = 1   
						width = medium
					)
					must have Status
					(
						type = picklist
						maxchar = 100
						values = {"Active","Inactive"}
						initial value = "Active"
			 			row = 2
			 			column = 1   
						width = medium
					)
					Completed_Deliveries_Count
					(
						type = number
						displayname = "Completed Deliveries Count"
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

