													}
								)
								}
							}
						
			}
		}

		approval
		{
			Supervisor_Approval as "Supervisor Approval"
			{
			
							type =  approval
							form = POD_Form
							display fields = [Delivery_Number,POD_ID,S_No]
							on start
							{
							}
							on level 1
							{
								approvers
								(
						 			role = "Supervisor"
								)
								on approve 
								{
									actions 
									{
										sendmail
										(
											from : zoho.loginuserid
											to : approver.submitter
											subject : "Approval Request"
											message : "Your request has been approved."
										)
									}
								}
								on reject
								{
			
									actions 
									{
										sendmail
										(
											from : zoho.loginuserid
											to : approver.submitter
											subject : "Approval Request"
											message : "Your request has been rejected."
										)
									}
								}
							}
						
			}
		}

		schedule
		{
			SLA_Breached as "SLA Breached"
			{
			
							type =  schedule
							form = New_Exception[Status == "Open"]
							start = Exception_SLA_Due_On
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									sla_hrs = General[ID != 0].Exception_SLA_Due_Hrs;
													input.Is_Overdue = true;
													mail_content = "<div style='margin:0;padding:20px;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;'> <table width='100%' cellpadding='0' cellspacing='0' style='max-width:650px;margin:auto;background:#ffffff;border:1px solid #dddddd;border-collapse:collapse;'> <tr> <td style='background:#d9534f;color:#ffffff;padding:16px 20px;font-size:20px;font-weight:bold;'> Exception Escalation - SLA Breached </td> </tr> <tr> <td style='padding:20px;color:#333333;font-size:14px;line-height:1.6;'> <p>Dear Administrator,</p> <p> This is an automated notification to inform you that the following exception has exceeded its configured SLA and requires your immediate attention. </p> <table width='100%' cellpadding='8' cellspacing='0' style='border-collapse:collapse;border:1px solid #dddddd;'> <tr style='background:#f2f2f2;'> <th align='left'>Field</th> <th align='left'>Value</th> </tr> <tr> <td><strong>Exception ID</strong></td> <td>" + input.Exception_ID + "</td> </tr> <tr> <td><strong>Delivery ID</strong></td> <td>" + input.Delivery_Number.Delivery_Number + "</td> </tr> <tr> <td><strong>Reported On</strong></td> <td>" + input.Reported_Date + "</td> </tr> <tr> <td><strong>SLA Due On</strong></td> <td>" + input.Exception_SLA_Due_On + "</td> </tr> <tr> <td><strong>Current Status</strong></td> <td>" + input.Status + "</td> </tr> <tr> <td><strong>Reported By</strong></td> <td>" + input.Delivery_Number.Driver.Driver_Name + "</td> </tr> </table> <p style='margin-top:20px;'> The exception has not been dispositioned within the configured SLA of <strong>" + sla_hrs + " hours</strong> and has therefore been marked as <strong style='color:#d9534f;'>Overdue</strong>. </p> <p> Kindly review the exception and take the necessary action at the earliest. </p> <p>Thank you.</p> </td> </tr> </table> </div>";
													admin_email_list = Employee[Role in {"Admin","Administrator"}].Email.getAll().toList();
													sendmail
													[
														from :zoho.adminuserid
														to :admin_email_list
														cc:"hariprasath.j.1997@gmail.com"
														subject :"Exception Escalated – SLA Breached"
														message :mail_content
													]
								)
								}
							}
						
			}

			Pending_Deliveries_Email_ as "Pending Deliveries Email to supervisor"
			{
			
							type =  schedule
							start = "2026-07-01 18:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									pending_deliveries_today = Outbound_Deliveries_Form[Planned_Delivery_Date == zoho.currentdate && Delivery_Outcome in {"Pending","Not Delivered"}];
													if(pending_deliveries_today.count() > 0)
													{
														mail_content = "<div style='font-family: Arial, Helvetica, sans-serif; font-size:14px; color:#333333; line-height:1.6;'> <p>Dear Supervisor,</p> <p> Please find the list of outbound deliveries that are still pending <strong>Proof of Delivery (POD)</strong> as of <strong>6:00 PM</strong>. </p> <p> Kindly review the pending deliveries and follow up with the respective drivers or delivery teams to ensure the PODs are submitted at the earliest. </p> <p><strong>Pending Outbound Deliveries Without POD</strong></p> <table border='1' cellspacing='0' cellpadding='8' style='border-collapse: collapse; width:100%;'> <thead style='background:#f2f2f2;'> <tr> <th align='left'>Delivery ID</th> <th align='left'>Customer Name</th> </tr> </thead> <tbody>";
														order_details_table = "";
														for each  rec in pending_deliveries_today
														{
															rec.Is_Overdue=true;
															order_details_table = order_details_table + "<tr><td>" + rec.Delivery_Number + "</td><td>" + rec.Customer.Customer_Name + "</td></tr>";
														}
														mail_content = mail_content + order_details_table;
														mail_content = mail_content + "</tbody> </table> <p>Thank you.</p> </div>";
														supervisor_email_list = Employee[Role == "Supervisor"].Email.getAll().toList();
														sendmail
														[
															from :zoho.adminuserid
															to :supervisor_email_list
															subject :"Pending Outbound Deliveries Without POD – 6:00 PM Alert"
															message :mail_content
														]
													}
								)
								}
							}
						
			}
		}

		functions
		{
			Resolve as "Resolve"
			{
			
							type =  functions
							form = New_Exception
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									openUrl("#Form:Resolve_Exception?Exception_ID=" + input.ID,"popup window","height=<height>,width=<width>");
								)
								}
							}
						
			}

			Assign_Driver as "Assign Driver"
			{
			
