			string Util.askGemini(General gen_rec, string prompt)
			{
			
			                 	gen_rec = General[ID != 0];
			                 	api_key = gen_rec.Gemini_API_Key;
			                 	model = "gemini-2.5-flash";
			                 	// free tier, fast
			                 	payload = Map();
			                 	contents = List();
			                 	content = Map();
			                 	parts = List();
			                 	part = Map();
			                 	part.put("text",prompt);
			                 	parts.add(part);
			                 	content.put("parts",parts);
			                 	contents.add(content);
			                 	payload.put("contents",contents);
			                 	try 
			                 	{
			                 		response = invokeurl
			                 		[
			                 			url :"https://generativelanguage.googleapis.com/v1beta/models/" + model + ":generateContent?key=" + api_key
			                 			type :POST
			                 			parameters:payload.toString()
			                 			headers:{"Content-Type":"application/json"}
			                 		];
			                 		// Extract text from response
			                 		result = response.get("candidates").get(0).get("content").get("parts").get(0).get("text");
			                 	}	catch (e)
			                 	{
			                 		result = "";
			                 	}
			                 	return result;
			                 
			}

			string Util.getID(string type, int s_no)
			{
			
			                 	id = "";
			                 	gen_rec = General[ID != 0];
			                 	if(type == "Product")
			                 	{
			                 		prefix = if(gen_rec.Product_ID.isEmpty() == false,gen_rec.Product_ID,"PROD");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Vehicle")
			                 	{
			                 		prefix = if(gen_rec.Vehicle_ID.isEmpty() == false,gen_rec.Vehicle_ID,"VEH");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Customer")
			                 	{
			                 		prefix = if(gen_rec.Customer_ID.isEmpty() == false,gen_rec.Customer_ID,"CUS");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Employee")
			                 	{
			                 		prefix = if(gen_rec.Employee_ID.isEmpty() == false,gen_rec.Employee_ID,"EMP");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Driver")
			                 	{
			                 		prefix = if(gen_rec.Driver_ID.isEmpty() == false,gen_rec.Driver_ID,"DRIVER");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Delivery_Number")
			                 	{
			                 		prefix = if(gen_rec.Delivery_Number.isEmpty() == false,gen_rec.Delivery_Number,"OD");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "POD")
			                 	{
			                 		prefix = if(gen_rec.POD_ID.isEmpty() == false,gen_rec.POD_ID,"POD");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	else if(type == "Exception")
			                 	{
			                 		prefix = if(gen_rec.Exception_ID.isEmpty() == false,gen_rec.Exception_ID,"EXC");
			                 		id = prefix + "-" + s_no;
			                 	}
			                 	return id;
			                 
			}

			string Util.getInitials(string str)
			{
			
			                 	characters = "";
			                 	if(str != null && str != "")
			                 	{
			                 		words = str.trim().toList(" ");
			                 		for each  w in words
			                 		{
			                 			if(w != "")
			                 			{
			                 				characters = characters + w.subString(0,1).toUpperCase();
			                 			}
			                 		}
			                 		// Max 2 characters for avatar
			                 		if(characters.length() > 2)
			                 		{
			                 			characters = characters.subString(0,2);
			                 		}
			                 	}
			                 	return characters;
			                 
			}

			string Util.getLoggedInProfile()
			{
			
			                 	profile = "";
			                 	if(zoho.loginuserid == zoho.adminuserid || thisapp.permissions.loginUserProfile() == "Administrator")
			                 	{
			                 		profile = "Administrator";
			                 	}
			                 	else
			                 	{
			                 		empRec = Employee[Email == zoho.loginuserid];
			                 		if(empRec.count() != 0)
			                 		{
			                 			profile = empRec.Role;
			                 		}
			                 	}
			                 	return profile;
			                 
			}

			void insertOutboundDeliveries()
			{
			
			                 	// ═══ CLEAN ALL DATA ═══
			                 	delete from Outbound_Deliveries_Form[ID != 0];
			                 	delete from Outbound_Delivery_Line_Items[ID != 0];
			                 	delete from Timeline[ID != 0];
			                 	delete from Start[ID != 0];
			                 	delete from Arrived[ID != 0];
			                 	delete from POD_Line_Items[ID != 0];
			                 	delete from POD_Form[ID != 0];
			                 	delete from New_Customer[ID != 0];
			                 	delete from Customer_Address[ID != 0];
			                 	delete from Driver[ID != 0];
			                 	delete from New_Product[ID != 0];
			                 	// ═══════════════════════════════════
			                 	// 1. DRIVERS
			                 	// ═══════════════════════════════════
			                 	drivers_json = {{"name":"Rajesh Kumar","email":"rajesh.k@logistics.com","mobile":"9876543210","dob":"15-Mar-1990","license":"TN-DL-1990034567"},{"name":"Suresh Mani","email":"suresh.m@logistics.com","mobile":"9876543211","dob":"22-Jul-1988","license":"TN-DL-1988045678"},{"name":"Karthik Selvam","email":"karthik.s@logistics.com","mobile":"9876543212","dob":"08-Nov-1992","license":"TN-DL-1992056789"},{"name":"Murugan Vel","email":"murugan.v@logistics.com","mobile":"9876543213","dob":"30-Jan-1985","license":"TN-DL-1985067890"}};
			                 	driver_map = Map();
			                 	for each  d in drivers_json
			                 	{
			                 		did = insert into Driver
			                 		[
			                 			Driver_Name=d.get("name")
			                 			Email=d.get("email")
			                 			Mobile_Number=d.get("mobile")
			                 			Date_Of_Birth=d.get("dob")
			                 			License_Number=d.get("license")
			                 			Share_App=true
			                 			Status="Active"
			                 			Added_User=zoho.loginuser
			                 		];
			                 		driver_map.put(d.get("name"),did);
			                 	}
			                 	// ═══════════════════════════════════
			                 	// 2. PRODUCTS
			                 	// ═══════════════════════════════════
			                 	products_json = {{"name":"Rice 25kg Bag","weight":25},{"name":"Wheat Flour 10kg","weight":10},{"name":"Sugar 5kg","weight":5},{"name":"Cooking Oil 5L","weight":4.5},{"name":"Cooking Oil 1L","weight":0.9},{"name":"Tea Powder 500g","weight":0.5},{"name":"Toor Dal 1kg","weight":1},{"name":"Salt 1kg","weight":1},{"name":"Basmati Rice 10kg","weight":10},{"name":"Soap Pack","weight":1.2},{"name":"Detergent Powder 1kg","weight":1},{"name":"Rava 1kg","weight":1},{"name":"Jaggery 500g","weight":0.5},{"name":"Coconut Oil 500ml","weight":0.5},{"name":"Ghee 1L","weight":0.9}};
			                 	product_map = Map();
			                 	for each  p in products_json
			                 	{
			                 		pid = insert into New_Product
			                 		[
			                 			Product_Name=p.get("name")
			                 			Weight=p.get("weight")
			                 			Added_User=zoho.loginuser
			                 		];
			                 		product_map.put(p.get("name"),pid);
			                 	}
			                 	// ═══════════════════════════════════
			                 	// 3. CUSTOMERS + ADDRESSES
			                 	// ═══════════════════════════════════
			                 	customers_json = {{"name":"ABC Traders","phone":"044-25671234","email":"abc.traders@email.com","addr_name":"Main Branch","addr_type":"Delivery","line1":"45, Rajaji Street","line2":"Near Central Railway Station","city":"Chennai","state":"Tamil Nadu","pin":"600003"},{"name":"Sri Ganesh Stores","phone":"044-27451234","email":"sriganesh@email.com","addr_name":"Warehouse","addr_type":"Delivery","line1":"12, GST Road","line2":"Opposite Bus Stand","city":"Chengalpattu","state":"Tamil Nadu","pin":"603001"},{"name":"Vijay Agencies","phone":"044-22341567","email":"vijay.agencies@email.com","addr_name":"Godown","addr_type":"Delivery","line1":"78, Main Road","line2":"Near Tambaram Station","city":"Chennai","state":"Tamil Nadu","pin":"600045"},{"name":"Lakshmi Distributors","phone":"044-22451890","email":"lakshmi.dist@email.com","addr_name":"Head Office","addr_type":"Delivery","line1":"23/A, Velachery Main Road","line2":"Near Phoenix Mall","city":"Chennai","state":"Tamil Nadu","pin":"600042"},{"name":"Karthik Enterprises","phone":"044-22501234","email":"karthik.ent@email.com","addr_name":"Factory","addr_type":"Delivery","line1":"SIDCO Industrial Estate","line2":"Plot 14, Phase II","city":"Chennai","state":"Tamil Nadu","pin":"600032"},{"name":"Modern Retail Mart","phone":"044-26181234","email":"modern.retail@email.com","addr_name":"Store","addr_type":"Delivery","line1":"AA Block, 2nd Avenue","line2":"Anna Nagar West","city":"Chennai","state":"Tamil Nadu","pin":"600040"},{"name":"Sun Super Market","phone":"044-24341234","email":"sun.super@email.com","addr_name":"T.Nagar Branch","addr_type":"Delivery","line1":"15, Usman Road","line2":"Near Panagal Park","city":"Chennai","state":"Tamil Nadu","pin":"600017"},{"name":"Green Foods Pvt Ltd","phone":"044-26571234","email":"green.foods@email.com","addr_name":"Processing Unit","addr_type":"Delivery","line1":"Industrial Avenue","line2":"Behind Ambattur OT","city":"Chennai","state":"Tamil Nadu","pin":"600053"},{"name":"Elite Wholesale","phone":"044-24891234","email":"elite.wholesale@email.com","addr_name":"Godown","addr_type":"Delivery","line1":"116, Mount Poonamallee Road","line2":"Porur Junction","city":"Chennai","state":"Tamil Nadu","pin":"600116"},{"name":"Sai Enterprises","phone":"044-22641234","email":"sai.ent@email.com","addr_name":"Office","addr_type":"Delivery","line1":"8, Pallavaram Main Road","line2":"Near Airport","city":"Chennai","state":"Tamil Nadu","pin":"600043"},{"name":"Murugan Stores","phone":"044-25891234","email":"murugan.stores@email.com","addr_name":"Shop","addr_type":"Delivery","line1":"32, Mint Street","line2":"Sowcarpet","city":"Chennai","state":"Tamil Nadu","pin":"600079"},{"name":"Saravana Agencies","phone":"044-24561234","email":"saravana.ag@email.com","addr_name":"Warehouse","addr_type":"Delivery","line1":"10, Arcot Road","line2":"Vadapalani","city":"Chennai","state":"Tamil Nadu","pin":"600026"}};
			                 	customer_map = Map();
