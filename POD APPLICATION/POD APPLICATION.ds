			 			row = 2
			 			column = 0   
						width = medium
					)
					Customer_ID
					(
		    			type = text
						displayname = "Customer ID"
			 			row = 2
			 			column = 1   
						width = medium
					)
					Outbound_Delivery_ID
					(
		    			type = text
						displayname = "Outbound Delivery ID"
			 			row = 2
			 			column = 1   
						width = medium
