<page linkname = "Operations_Dashboard" displayname = "Operations Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Dashboard_Summary' elementName='Dashboard_Summary'>
          <![CDATA[htmlpage Dashboard_Summary()
             content
             <%{%>
                 <file name:Dashboard_Summary.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Task_Status_Distribution_Chart.ds/>
      </column>
      <column width='50%'>
        <file name:Workload_By_Member_Chart.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Upcoming_Events_30_Days_Report.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:My_Open_Task_Assignments_Report.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Overdue_Task_Assignments_Report.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Blocked_Task_Assignments_Report.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Todays_Task_Update_Rows_Report.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
