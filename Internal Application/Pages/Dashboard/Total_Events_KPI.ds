<panel elementName='Panel 1'
 
 >
	<pr 
			width='fill'
		height='fill'
>
	<pc 
		padding = '20px'
	bgColor = '#FFCDBC'

		width = '100%'
		hAlign = 'center'
		vAlign = 'middle'
>
	<pr 
			width='auto'
		height='auto'
>
	<pc 
	
>
	<image  
		marginRight = '7px' 

	color = '#FFFFFF'
	bgColor = '#2A70E7'
	width = '52px'
	height = '52px'
	type = 'icon'
	value = 'business-gold'
	size = '24px'
	cornerRadius = '26px'
	iconType = 'solid'
/>
</pc><pc 
		padding = '5px'

		hAlign = 'left'
>
	<pr 
	>
	<pc 
	
		hAlign = 'left'
>
	<text 

	marginLeft = '0px'
	marginRight = '0px' 
	marginBottom = '0px'
	marginTop = '0px'
	color = '#2A70E7'
	size = '16px'
	type = 'Text'







	  value = 'Total Events'
>
</text>

</pc>
</pr><pr 
	>
	<pc 
	
		hAlign = 'left'
>
	<text 

	marginLeft = '0px'
	marginRight = '0px' 
	marginBottom = '0px'
	marginTop = '2px'
	color = '#2A70E7'
	size = '36px'
	bold = 'true' 
	type = 'Form Data'



	displayType = 'actual'
	thousandsSeperator = 'LOCALE'
	decimalSeperator = 'DOT'
	numberScale = 'none'




	  value = 'thisapp.Events.ID.count'
>
</text>

</pc>
</pr>
</pc>
</pr>
</pc>
</pr>
</panel>