		list All_Event_Tasks
		{
			displayName = "All Event Tasks"
			show all rows from Event_Tasks
			(
				Product
				Event
				Date_of_assign as "Date of assign"
				Total_Hours_assigned as "Total Hours assigned"
				Remaining_Hours as "Remaining Hours"
				Event.Event_Status as "Event Status"
				Event.Event_Type as "Event Type"
				Tasks
				(
					field = Tasks.Task_Name + "- " + Tasks.Assigned_To + "- " + Tasks.Status
				)
				Event_Name_Lookup as "Event Name (Lookup)"
			)
			group by
			(
				Product ascending
			)
			conditional formatting
			(
				"Event completed"
				{
					condition = (Event.Event_Status == "Completed")
					fields = [Event.Event_Status]
					format = "color:#000000;background-color:#1bbc9b;"
				}
				"Event inprogress"
				{
					condition = (Event.Event_Status == "InProgress")
					fields = [Event.Event_Status]
					format = "color:#ffffff;background-color:#107c91;"
				}
				"Event open"
				{
					condition = (Event.Event_Status == "Open")
					fields = [Event.Event_Status]
					format = "color:#333;background-color:#f1c40f;"
				}
				"New Formatting"
				{
					condition = (Event.Event_Status == "Cancelled")
					fields = [Event.Event_Status]
					format = "color:#ffffff;background-color:#e84c3d;"
				}
				"Event OnHold"
				{
					condition = (Event.Event_Status == "OnHold")
					fields = [Event.Event_Status]
					format = "color:#ffffff;background-color:#818c8e;"
				}
			)
		}

		list Event_task_2026
		{
			displayName = "Event task 2026"
			show all rows from Event_Tasks [Event.Month_and_year.contains("2026") || Event_Name_Lookup.contains("2026")]
			(
				Product
				Event
				Event.Month_and_year as "Month and year"
				Tasks
				(
					field = Tasks.Task_Name1 + "-" + Tasks.Assigned_To
				)
				Event.Event_Status as "Event Status"
			)
			group by
			(
				Event.Month_and_year custom
			)
			sort by
			(
				Event.Month_and_year custom
			)
			conditional formatting
			(
				"Zoho Creator"
				{
					condition = (Product.Product_Name == "Zoho Creator")
					fields = [Product]
					format = "color:#398ef3;"
				}
				"Zoho Deluge"
				{
					condition = (Product.Product_Name == "Zoho Deluge")
					fields = [Product]
					format = "color:#5dc35a;"
				}
				"Zoho RPA"
				{
					condition = (Product.Product_Name == "Zoho RPA")
					fields = [Product]
					format = "color:#16d0ef;"
				}
				"Zoho QEngine"
				{
					condition = (Product.Product_Name == "Zoho QEngine")
					fields = [Product]
					format = "color:#efb116;"
				}
				"Zoho Flow"
				{
					condition = (Product.Product_Name == "Zoho Flow")
					fields = [Product]
					format = "color:#c516ef;"
				}
				"DX Training"
				{
					condition = (Product.Product_Name == "DX Training")
					fields = [Product]
					format = "color:#ef166f;"
				}
			)
		}

		list All_Events
		{
			displayName = "All Events"
			show all rows from Events
			(
				Product
				Mode_of_Training as "Mode of Training"
				(
					width = 128px
				)
				Event_Type as "Event Type"
				(
					width = 185px
				)
				Event_Name as "Event Name"
				(
					width = 382px
				)
				Start_Date as "Start Date"
				(
					width = 105px
				)
				End_Date as "End Date"
				(
					width = 105px
				)
				Start_Time as "Start Time"
				End_Time as "End Time"
				DRI
				(
					width = 130px
				)
				Event_Status as "Event Status"
				(
					width = 101px
				)
				DRI_ID as "DRI ID"
				custom action "Post Event Stats"
				(
					workflow = Post_Event_Stats1
					show action in edit record menu = true
					success message = "Opening post event stats"
					condition = (Event_Type != "Adhoc")
				)
				custom action "Discount Request"
				(
					workflow = Discount_Request
					show action in edit record menu = true
					success message = "Opening discount request"
					condition = (Event_Type == "Online Training" || Event_Type == "Certification")
				)
				custom action "Add Request Survey"
				(
					workflow = Add_request_Survey
					show action in edit record menu = true
					success message = "Survey request action completed"
					condition = (Event_Type == "Online Training" && Survey_Request == "Yet to request")
				)
				Survey
				Survey_Report as "Survey Report"
				Survey_Request as "Survey Request"
			)
			group by
			(
				Product ascending
			)
			conditional formatting
			(
				"Completed"
				{
					condition = (Event_Status == "Completed")
					fields = [Event_Status]
					format = "color:#19bc9f;"
				}
				"New Formatting"
				{
					condition = (Event_Status == "Open")
					fields = [Event_Status]
					format = "color:#f1c50e;"
				}
				"New Formatting"
				{
					condition = (Event_Status == "InProgress")
					fields = [Event_Status]
					format = "color:#bd588b;"
				}
				"New Formatting"
				{
					condition = (Event_Status == "Cancelled")
					fields = [Event_Status]
					format = "color:#e64d3b;"
				}
				"New Formatting"
				{
					condition = (Event_Status == "OnHold")
					fields = [Event_Status]
					format = "color:#ffffff;background-color:#818c8e;"
				}
			)
		}

