		form Task_Updates
		{
			displayname = "Task Updates"
			success message = "Task Update Added Successfully"
			Section
			(
				type = section
				row = 1
				column = 0
				width = medium
			)
			Name
			(
				type = picklist
				values = Team_Members.ID
				displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
				row = 1
				column = 1
				width = medium
			)
			Date_field
			(
				type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
				row = 1
				column = 1
				width = medium
			)
			Instructions
			(
				type = plaintext
				value = "<div><p><b>Instructions - Updates:</b><br /></p><ul><li>Avoid using the status field for tickets.<br /></li><li>Enter the hours worked in the following format:<br /></li></ul></div><blockquote><div><ul><li>30 minutes = 0.5 hours<br /></li><li>1 hour 15 minutes = 1.25 hours<br /></li><li>2 hours 30 minutes = 2.5 hours<br /></li></ul></div></blockquote><div><ul><li>Add one entry per day; edits are allowed but not for past days.<br /></li><li>Tasks won’t appear the next day once the status is &quot;Completed.&quot;<br /></li><li>Enter task updates daily; previous day tasks can't be added later.<br /></li><li>For live sessions, mark &quot;Completed&quot; only after the session ends.<br /></li><li><b>Please don't leave the Remaining Hours empty - at least give 0 (which is default)</b></li></ul></div><div><br /></div>"
				row = 1
				column = 1
				width = medium
			)
			Updates_Section
			(
				type = section
				displayname = "Updates"
				visibility = false
				row = 2
				column = 1
				width = medium
			)
			Updates
			(
				type = grid
				values = Task_updates_subform1.ID
				auto width = false
				row = 2
				column = 1
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

