application "Internal-Application"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Country_wise_Registrations
		{
			displayname = "Country-wise Registrations"
			success message = "Source-wise Registration Added Successfully"
			Section
			(
				type = section
				row = 1
				column = 0   
				width = medium
			)
			Events
			(
				type = picklist	
				values  = Post_Event_Stats.ID
				bidirectional = Country_wise_Registrants_details
				displayformat = [Event_Name_Lookup]
				sortorder = ascending
				row = 1
				column = 1   
				width = medium
			)
			Region
			(
				type = picklist
				maxchar = 100
				values = {"APACandANZ","EMEA","Americas","APACandEMEA"}
				row = 1
				column = 1   
				width = medium
			)
			Country
			(
				type = text
				row = 1
				column = 1   
				width = medium
			)
			Registration
			(
				type = number
				row = 1
				column = 1   
				width = medium
			)
			Attendee
			(
				type = number
				row = 1
				column = 1   
				width = medium
			)
			plain
			(
				type = plaintext
				value = "<div>\n Check this <a href=\"https://sheet.zoho.com/sheet/open/lu7t8b9f413d69977417e94349c060eb1e283?sheetid=0&amp;range=A3\" target=\"_blank\" style=\"color: rgb(0, 0, 238)\" rel=\"noopener noreferrer\">sheet</a> for source grouping. \n <br>\n</div>"
				row = 1
				column = 2   
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		form Discounted_Attendees
		{
			displayname = "Discounted Attendees"
			success message = "Attendee Added Successfully"
			Section
			(
				type = section
				row = 1
				column = 0   
				width = medium
			)
			Event
			(
				type = picklist	
				values  = Post_Event_Stats.ID
				bidirectional = Discounted_Attendees
				displayformat = [Event_Name_Lookup]
				sortorder = ascending
				row = 1
				column = 1   
				width = medium
			)
			Attendees_count
			(
				type = number
				displayname = "Attendees count"
				row = 1
				column = 1   
				width = medium
			)
			Discount_in_percentage
			(
				type = percentage
				displayname = "Discount(in percentage)"
				row = 1
				column = 1   
				width = medium
			)
			Discounted_Amount
			(
				displayname = "Discounted Amount"
				type = USD
				format = commadotindian
				row = 1
				column = 1   
				width = medium
			)
			Source
			(
				type = picklist
				maxchar = 100
				values = {"PAM","Direct","Events"}
				others option = true
				row = 1
				column = 1   
				width = medium
			)
			Promocode
			(
				type = text
				row = 1
				column = 1   
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		form Discounts_Request
		{
			displayname = "Discounts Request"
			success message = "Data Added Successfully!"
			Event_Details
			(
				type = section
				displayname = "Event Details"
				visibility = true
				row = 1
				column = 0
				width = medium
			)
			Product
			(
				type = picklist
				values = Products.ID
				displayformat = [Product_Name]
				sortorder = ascending
				row = 1
				column = 1
				width = medium
			)
			Event
			(
				type = picklist
				values = Events.ID
				displayformat = [Event_Name]
				sortorder = ascending
				row = 1
				column = 1
				width = large
			)
			Event_Type
			(
				type = picklist
				displayname = "Event Type"
				maxchar = 100
				values = {"Online Training","Certification"}
				row = 1
				column = 1
				width = medium
			)
			Ticket_Reference
			(
				type = text
				displayname = "Ticket Reference"
				row = 1
				column = 1
				width = medium
			)
			Customer_Details
			(
				type = section
				displayname = "Customer Details"
				visibility = true
				row = 2
				column = 0
				width = medium
			)
			Partner_Company_Name
			(
				type = text
				displayname = "Company Name"
				row = 2
				column = 1
				width = medium
			)
			Email
			(
				type = email
				maxchar = 80
				description
				[
					type = help_text
					message = "Email address of the person requesting to pay."
				]
				row = 2
				column = 1
				width = medium
				personal data = true
			)
			Type_of_user
			(
				type = picklist
				displayname = "Type of user"
				maxchar = 100
				values = {"Partner Prospect","Partner","Customer","Zoho Internal Employee","User"}
				sortorder = ascending
				others option = true
				row = 2
				column = 1
				width = medium
			)
			No_of_T
			(
				type = number
				displayname = "No. of Tickets"
				row = 2
				column = 1
				width = medium
			)
			Actual_Amount
			(
				displayname = "Actual Amount"
				type = USD
				format = commadotindian
				description
				[
					type = help_text
					message = "Actual amount * number of tickets"
				]
				row = 2
				column = 1
				width = medium
			)
			Discount_Percentage
			(
				type = percentage
				displayname = "Discount Percentage"
				row = 2
				column = 1
				width = medium
			)
			Amount_after_discount_applied
			(
				displayname = "Amount after discount applied"
				type = USD
				format = commadotindian
				row = 2
				column = 1
				width = medium
			)
			Total_Discounted_value
			(
				type = formula
				displayname = "Total discounted amount"
				value = input.Actual_Amount - input.Amount_after_discount_applied
				visibility = false
				row = 2
				column = 1
				width = medium
			)
			Requested_by
			(
				type = email
				displayname = "Requested by"
				maxchar = 80
				description
				[
					type = help_text
					message = "Email of the person forwarded this request (either internal or external)"
				]
				row = 2
				column = 1
				width = medium
				personal data = true
			)
			Promo_code
			(
				type = section
				displayname = "Promo code"
				visibility = true
				row = 3
				column = 0
				width = medium
			)
			Promocode
			(
				type = text
				description
				[
					type = help_text
					message = "Will be updated post creation."
				]
				row = 3
				column = 1
				width = medium
			)
			Registration_Url
			(
				type = url
				displayname = "Registration Url"
				enable linkname
				description
				[
					type = help_text
					message = "Backstage URL"
				]
				row = 3
				column = 1
				width = medium
			)
			Coupon_Redeemed
			(
				type = checkbox
				displayname = "Coupon  Redeemed?"
				initial value = false
				row = 3
				column = 1
				width = medium
			)
			No_of_coupons_Redeemed
			(
				type = number
				displayname = "No.of coupons Redeemed"
				row = 3
				column = 1
				width = medium
			)
			Promo_code_status
			(
				type = radiobuttons
				displayname = "Promo code status"
				maxchar = 100
				values = {"Yet to add","Added"}
				initial value = "Yet to add"
				row = 3
				column = 1
				width = medium
			)
			Section
			(
				type = section
				visibility = true
				row = 4
				column = 0
				width = medium
			)
			Requester_email_Team_Member
			(
				type = picklist
				displayname = "Requester email - Team Member"
				values = Team_Members.ID
				displayformat = [Email]
				sortorder = ascending
				row = 4
				column = 1
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
				row = 5
				column = 0
				width = medium
			)
			Assigned_to_To_generate_Promocode
			(
				type = picklist
				displayname = "Assigned to - To generate Promocode"
				values = Team_Members.ID
				displayformat = [Email]
				sortorder = ascending
				row = 5
				column = 1
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
				visibility = true
				row = 6
				column = 0
				width = medium
			)
			Comments_if_any
			(
				type = textarea
				displayname = "Comments(if any)"
				height = 100px
				row = 6
				column = 1
				width = medium
			)
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		form Event_Tasks
		{
			displayname = "Event Tasks"
			success message = "Event Task Added Successfully"
			Section
			(
				type = section
				row = 1
				column = 0
				width = medium
			)
			Product
			(
				type = picklist
				values = Products.ID
				displayformat = [Product_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				description
				[
					type = tooltip
					message = "For non-product specific choose DX training"
				]
				row = 1
				column = 1
				width = medium
			)
			Event
			(
				type = picklist
				values = Events[Event_Status == "Open"].ID
				displayformat = [Event_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				row = 1
				column = 1
				width = medium
			)
			Event_Name_Lookup
			(
				type = text
				displayname = "Event Name (Lookup)"
				row = 1
				column = 1
				width = medium
			)
			Date_of_assign
			(
				type = date
				displayname = "Date of assign"
				alloweddays = 0,1,2,3,4,5,6
				row = 1
				column = 1
				width = medium
			)
			Total_Hours_assigned
			(
				type = decimal
				displayname = "Total Hours assigned"
				description
				[
					type = tooltip
					message = "For Ticket and Adhoc works define a higher value like 1000."
				]
				row = 1
				column = 1
				width = medium
			)
			Remaining_Hours
			(
				type = decimal
				displayname = "Remaining Hours"
				description
				[
					type = tooltip
					message = "Keeps updating automatically"
				]
				row = 1
				column = 1
				width = medium
			)
			Tasks_Section
			(
				type = section
				displayname = "Tasks"
				visibility = false
				row = 2
				column = 1
				width = medium
			)
			Tasks
			(
				type = grid
				values = Multiple_tasks_subform.ID
				bidirectional = Event_Tasks
				row = 2
				column = 1
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		form Events
		{
			success message = "Event Added Successfully"
			Event
			(
				type = section
				displayname = "Event "
				visibility = true
				row = 1
				column = 0
				width = medium
			)
			Product
			(
				type = picklist
				values = Products.ID
				displayformat = [Product_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				description
				[
					type = help_text
					message = "For Adhoc - choose product DX Training"
				]
				row = 1
				column = 1
				width = medium
			)
			Event_Name
			(
				type = text
				displayname = "Event Name"
				description
				[
					type = help_text
					message = "Check whether 'Event Name' already exist before creating.\n\nExample :\nLearning Table Series - January - 2025\nOnline Training - Stage1 - APAC - 2025\nJanuary 2025 - Tickets\nJanuary 2025 - Adhoc works\nJanuary 2025 - Associate Developer Certification"
				]
				row = 1
				column = 1
				width = medium
			)
			Event_Type
			(
				type = picklist
				displayname = "Event Type"
				maxchar = 100
				values = {"Webinar","Online Training","In-person Training","Certification","Adhoc"}
				others option = true
				description
				[
					type = help_text
					message = "For Ticket and Adhoc - choose type as adhoc"
				]
				row = 1
				column = 1
				width = medium
			)
			Mode_of_Training
			(
				type = radiobuttons
				displayname = "Mode of Training"
				maxchar = 100
				values = {"Online","Offline"}
				row = 1
				column = 1
				width = medium
			)
			must have Month_and_year
			(
				type = text
				displayname = "Month and year"
				row = 1
				column = 1
				width = medium
			)
			Time
			(
				type = section
				visibility = true
				row = 2
				column = 0
				width = medium
			)
			Start_Date
			(
				type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
				row = 2
				column = 1
				width = medium
			)
			End_Date
			(
				type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
				row = 2
				column = 1
				width = medium
			)
			Start_Time
			(
				type = time
				displayname = "Start Time"
				timedisplayoptions = "hh:mm:ss"
				description
				[
					type = tooltip
					message = "Example :\nWebinars - APAC start - 11.00 am"
				]
				row = 2
				column = 2
				width = medium
			)
			End_Time
			(
				type = time
				displayname = "End Time"
				timedisplayoptions = "hh:mm:ss"
				description
				[
					type = tooltip
					message = "Example :\nWebinars - Americas end - 10.00 pm"
				]
				row = 2
				column = 2
				width = medium
			)
			DRI2
			(
				type = section
				displayname = "DRI"
				visibility = true
				row = 3
				column = 0
				width = medium
			)
			DRI
			(
				type = picklist
				values = Team_Members.ID
				displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				row = 3
				column = 1
				width = medium
			)
			DRI_ID
			(
				type = number
				displayname = "DRI ID"
				maxchar = 19
				row = 3
				column = 1
				width = medium
			)
			Event_Status
			(
				type = picklist
				displayname = "Event Status"
				maxchar = 100
				values = {"Open","InProgress","Completed","Cancelled","OnHold","Tentative"}
				initial value = "Open"
				row = 3
				column = 1
				width = medium
			)
			Online_Training_Survey
			(
				type = section
				displayname = "Online Training - Survey"
				visibility = true
				row = 4
				column = 0
				width = medium
			)
			Survey_Request
			(
				type = picklist
				displayname = "Survey Request"
				maxchar = 100
				values = {"Requested","Added","Yet to request"}
				initial value = "Yet to request"
				row = 4
				column = 1
				width = medium
			)
			Survey
			(
				type = url
				enable linkname
				row = 4
				column = 1
				width = medium
			)
			Survey_Report
			(
				type = url
				displayname = "Survey Report"
				enable linkname
				row = 4
				column = 1
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
					reset
					(
						type = reset
						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}

		form Examination_to_Attendees
		{
			displayname = "Examination to Attendees"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
