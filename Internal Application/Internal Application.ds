				row = 1
				column = 1   
				width = medium
			)
			Number_of_users
			(
				type = number
				displayname = "Number of users"
				maxchar = 3
				row = 1
				column = 1   
				width = medium
			)
			Approximate_date_you_d_like_to_start_the_training
			(
				type = date
				displayname = "Approximate date you'd like to start the training"
				alloweddays = 0,1,2,3,4,5,6
				row = 1
				column = 1   
				width = medium
			)
			Additional_information_if_any
			(
				type = textarea
				displayname = "Additional information (if any)"
				height = 100px
				row = 1
				column = 1   
				width = medium
			)
			plain
			(
				type = plaintext
				value = "<div>\n <span style=\"font-size: 13.3333px\" class=\"size\"><span style=\"font-family: Lato, sans-serif\" class=\"font\">By submitting this form, you agree to the processing of personal data according to our&nbsp;</span></span><a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://www.zoho.com/privacy.html\" style=\"font-family: Verdana, arial, Helvetica, sans-serif\"><span style=\"font-size: 13.3333px\" class=\"size\"><span style=\"font-family: Lato, sans-serif\" class=\"font\">Privacy Policy.</span></span></a>\n <br>\n</div>"
				row = 1
				column = 1   
				width = medium
			)
		
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "Update"
					)
					cancel
					(
						type = cancel
						displayname = "Cancel"
					)
				}
			}
		}
	}

