					display = total
				)
				Backstage_Revenue as "Backstage Revenue (USD)"
				(
					display = total
				)
				Event_Type as "Event Type"
				Internal_Registrations as "Internal Registrations"
				Event_Name_Lookup as "Event Name (Lookup)"
				Event_Name.Start_Date as "Start Date"
				Manual_invoice_in_USD as "Manual invoice in USD"
				Total_Revenue_in_USD1 as "Total Revenue in USD"
				(
					display = total
				)
				Added_User as "Added User"
			)
			group by
			(
				Product_Name ascending
			)
			sort by
			(
				Event_Name ascending
			)
		}

		default list All_Products
		{
			displayName = "All Products"
			show all rows from Products    
			(
				Product_Name as "Product Name"
			)
		}

		default list All_Qr_Code_Generators
		{
			displayName = "All Qr Code Generators"
			show all rows from QR_Code_Generator
			(
				Session_URl as "Session URl"
				QR_Code as "QR Code"
				Event
			)
		}

		default list All_Revenue_Stats
		{
			displayName = "All Revenue Stats"
			show all rows from Revenue_Stats
			(
				Added_Time as "Added Time"
			)
		}

		default list All_Source_wise_Registrations
		{
			displayName = "Webinar Source-wise Registrations"
			show all rows from Source_wise_Registrations
			(
				Source_Name as "Source Name"
				Registration
				(
					display = total
				)
				Attendee
				(
					display = total
				)
				Region
				Event
			)
			group by
			(
				Event ascending
			)
		}

		default list All_Task_Updates
		{
			displayName = "All Task Updates"
			show all rows from Task_Updates
			(
				Name
				Date_field as "Date"
			)
			group by
			(
				Date_field descending
			)
			sort by
			(
				Date_field descending
			)
		}

		list Recent_Daily_Update_Submissions
		{
			displayName = "Recent Daily Update Submissions"
			show all rows from Task_Updates
			(
				Name
				Date_field
				Added_Time
			)
			sort by
			(
				Date_field descending
			)
		}

		list Completed_Task_Update_Rows
		{
			displayName = "Completed Task Update Rows"
			show all rows from Task_updates_subform1 [Status == "Completed"]
			(
				Date_field as "Date"
				Assigned_To as "Assigned To"
				Event_Tasks as "Event Tasks"
				Task_Name as "Task Name"
				Hours_worked as "Hours Worked"
				Status
				Description
			)
		}

		list My_Task_Update_Rows
		{
			displayName = "My Task Update Rows"
			show all rows from Task_updates_subform1 [Assigned_To.Email == zoho.loginuserid]
			(
				Date_field as "Date"
				Assigned_To as "Assigned To"
				Event_Tasks as "Event Tasks"
				Task_Name as "Task Name"
				Hours_worked as "Hours Worked"
				Status
				Description
			)
			sort by
			(
				Date_field descending
			)
		}

		default list Task_updates_subform1_Report
		{
			displayName = "Task updates - subform Report"
			show all rows from Task_updates_subform1
			(
				Task_Name as "Task Name"
				Description
				Hours_worked as "Hours Worked"
				Status
				Event_Tasks as "Event Tasks"
				Assigned_To as "Assigned To"
				Remaining_Hours as "Remaining Hours"
				Date_field as "Date"
				Event_Task as "Event Task"
				Task_Name1 as "Task Name"
			)
			group by
			(
				Event_Tasks ascending
			)
		}

		list Todays_Task_Update_Rows
		{
			displayName = "Today's Task Update Rows"
			show all rows from Task_updates_subform1 [Date_field == zoho.currentdate]
			(
				Date_field as "Date"
				Assigned_To as "Assigned To"
				Event_Tasks as "Event Tasks"
				Task_Name as "Task Name"
				Hours_worked as "Hours Worked"
				Status
				Description
			)
		}

		default list All_Team_Members
		{
			displayName = "All Team Members"
			show all rows from Team_Members
			(
				Name
				Reporting_to as "Reporting to"
				Products_Working_on as "Products Working on"
				Emp_ID as "Emp ID"
				Email
				users as "Users"
				Reporting_to.Email
			)
		}

		default list All_Video_Room_Usage
		{
			displayName = "All Video Room Usage"
			show all rows from Video_Room_Usage
			(
				Event
				Date_and_Time as "Date and Time"
				(
					field = Date_and_Time.Start_Date_Time1 + "," + Date_and_Time.Start_Date_Time + "," + Date_and_Time.Room_Image
				)
				Notes
				Added_User as "Added User"
			)
		}

		default list Zoho_QEngine_QA_Beginner_Certification_Enqu_Report
		{
			displayName = "Zoho QEngine - QA Beginner Certification En Report"
			show all rows from Zoho_QEngine_QA_Beginner_Certification_Enquiry    
			(
				Name 
				Email
				Number_of_Registrations as "Number of Registrations"
				Country 
				(
					enable = Link_to_Map,Show_As_Text
				)
				Company_Name as "Company Name"
				Added_Time as "Added Time"
			)
		}

		default list Zoho_RPA_Training_Enquiry_Form_Report
		{
			displayName = "Zoho RPA Training - Enquiry Form Report"
			show all rows from Zoho_RPA_Training_Enquiry_Form
			(
				Name
				Email
				Organization
				Country
				How_familiar_are_you_with_Zoho_RPA as "How familiar are you with Zoho RPA"
				Preferred_Training_Mode as "Preferred training mode"
				I_am_a as "I am a"
				Number_of_users as "Number of users"
				Approximate_date_you_d_like_to_start_the_training as "Approximate date you'd like to start the training"
				Additional_information_if_any as "Additional information (if any)"
			)
		}
	}

	pages
	{
		page Dashboard
		{
					displayname = "Dashboard"
					Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n\t \t\t width='100%'\n\t \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#A3B4F0'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#2A70E7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = '#A3B4F0'\n\n\n\n\n\n\n\t  value = 'Zoho DX Training Dashboard'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n\t \t\t width='50%'\n\t \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFCDBC'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginRight = '7px' \n\n\tcolor = '#FFFFFF'\n\tbgColor = '#2A70E7'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'business-gold'\n\tsize = '24px'\n\tcornerRadius = '26px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpadding = '5px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#2A70E7'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Events'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '2px'\n\tcolor = '#2A70E7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Events.ID.count'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n\t \t\t width='50%'\n\t \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFBCC1'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '7px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#2A70E7'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'business-money-bag'\n\tsize = '33px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\tpadding = '5px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#2A70E7'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Total Revenue'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n\t\thAlign = 'left'\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '2px'\n\tcolor = '#2A70E7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Post_Event_Stats.Backstage_Revenue.sum'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n\t \t\t width='100%'\n\t \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Stacked Column'\n\txtitle = 'Month and Year'\n\tytitle = 'Number of Events'\n\tbgColor = '#BCE0C2'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Events'\n\txfield = 'Month_and_year'\n\tyfields = 'count:Event_Name'\n\tgroupBy = 'Product.Product_Name'\n/>\n</column>\n</row><row>\n\t<column\n\t \t\t width='100%'\n\t \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Pie'\n\txtitle = 'Event Type'\n\tbgColor = '#CFBFFD'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Events'\n\txfield = 'Event_Type'\n\tyfields = 'count:Event_Type'\n/>\n</column>\n</row><row>\n\t<column\n\t \t\t width='50%'\n\t \t>\n\t<chart \n\telementName='Chart 2'\n\n\ttype = 'Donut'\n\txtitle = 'Product'\n\tytitle = 'Total Registrations'\n\tbgColor = '#BDC9F3'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Post_Event_Stats'\n\txfield = 'Product_Name.Product_Name'\n\tyfields = 'sum:Total_Registration'\n\tshowDataLabel = 'true'\n/>\n</column><column\n\t \t\t width='50%'\n\t \t>\n\t<chart \n\telementName='Chart 3'\n\n\ttype = 'Donut'\n\txtitle = 'Product'\n\tytitle = 'Total Attendees'\n\tbgColor = '#FFBCC1'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Post_Event_Stats'\n\txfield = 'Product_Name.Product_Name'\n\tyfields = 'sum:Total_Attendees'\n\tshowDataLabel = 'true'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}

		page Operations_Dashboard
		{
					displayname = "Operations Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Dashboard_Summary' elementName='Dashboard_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Dashboard_Summary()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\ntoday = zoho.currentdate;\nupcomingEventsCount = Events[Start_Date &gt;= today &amp;&amp; Start_Date &lt;= today.addDay(30)].count();\nmyOpenTasksCount = Multiple_tasks_subform[((Assigned_To.Email == zoho.loginuserid &amp;&amp; Reassigned == false) || (Reassigned_to.Email == zoho.loginuserid &amp;&amp; Reassigned == true)) &amp;&amp; Status != &quot;Completed&quot;].count();\noverdueTasksCount = Multiple_tasks_subform[Due_Date &lt; today &amp;&amp; Status != &quot;Completed&quot;].count();\nblockedTasksCount = Multiple_tasks_subform[Blocked == true &amp;&amp; Status != &quot;Completed&quot;].count();\ntodaysUpdatesCount = Task_updates_subform1[Date_field == today].count();\nremainingHours = Multiple_tasks_subform[Status != &quot;Completed&quot;].sum(Task_Remaining_Hours);\nif(remainingHours == null)\n{\n\t\tremainingHours = 0;\n}\ntodayHours = Task_updates_subform1[Date_field == today].sum(Hours_worked);\nif(todayHours == null)\n{\n\t\ttodayHours = 0;\n}\nuserName = zoho.loginuser;\nupcomingUrl = &quot;#Report:Upcoming_Events_30_Days?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\nopenTasksUrl = &quot;#Report:My_Open_Task_Assignments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\noverdueUrl = &quot;#Report:Overdue_Task_Assignments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\nblockedUrl = &quot;#Report:Blocked_Task_Assignments?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\ntodaysUpdatesUrl = &quot;#Report:Todays_Task_Update_Rows?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\nworkloadUrl = &quot;#Report:Task_Workload_By_Member?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\naddUpdateUrl = &quot;#Form:Task_Updates?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css (operations dashboard subset) ===== */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-page-bg-color: #F3F3F4;\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-black-color: #000000;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-placeholder-color: #878895;\n\t\t--column-gap: 0px;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-cursor-pointer { cursor: pointer; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-rounded-sm { border-radius: 4px; }\n.zcs-rounded-md { border-radius: 6px; }\n.zcs-rounded-lg { border-radius: 8px; }\n.zcs-rounded-xl { border-radius: 12px; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-m-0 { margin: 0; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-40 { font-size: 2.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-color-primary { color: var(--zcs_primary_text_color); }\n.zcs-color-secondary { color: var(--zcs_secondary_text_color); }\n.zcs-color-tertiary { color: var(--zcs_tertiary_text_color); }\n.zcs-color-white { color: var(--zcs-white-color); }\na { text-decoration: none; }\n\n/* ===== layout-dashboard / button-primary-outline-button ===== */\n.zcs-page-container { background-color: var(--zcs-page-bg-color); }\n.zcs-page-container-inner { min-height: 100%; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-button:hover { background-color: var(--zcs_brand_dark_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-panel-wrapper ul li { list-style-type: none; }\n.zcs-panel { border: 1px solid var(--zcs_tertiary_border_color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: border-color 0.2s ease, background-color 0.2s ease; }\n.zcs-panel-icon-wrapper { width: 40px; height: 40px; }\n.zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; }\n.zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; }\n.zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; }\n.zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; }\n.zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; }\n.zcs-panel.zcs-panel-l_blue .zcs-panel-icon-wrapper { background-color: #E8EFFF; color: #2A6FFC; }\n.zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; }\n.zcs-panel-wrapper .zcs-overlay { inset: 0; }\n.zcs-panel-wrapper li:hover .zcs-panel { border-color: var(--zcs_brand_color); background-image: linear-gradient(rgb(253 253 255 / 10%), #f7f9ff); }\n\n/* ===== badge-badge-with-icon ===== */\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n\n/* ===== table-simple-table ===== */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-red { color: #FE455D; }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-green { color: #179E6C; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-yellow { color: #B8770D; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-l_blue { color: #1094C5; }\n\n/* Operations-specific composition */\n.ops-dashboard { min-height: 100%; }\n.ops-hero { background: linear-gradient(135deg, var(--zcs_brand_color), var(--zcs_brand_dark_color)); border-radius: 16px; color: var(--zcs_brand_foreground_color); position: relative; overflow: hidden; }\n.ops-hero:after { content: &quot;&quot;; position: absolute; width: 260px; height: 260px; border: 42px solid rgba(255,255,255,0.10); border-radius: 50%; right: -70px; top: -110px; }\n.ops-hero h2, .ops-hero p { color: var(--zcs_brand_foreground_color); position: relative; z-index: 1; }\n.ops-hero .zcs-button { position: relative; z-index: 1; background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.ops-kpi-list { list-style-type: none; }\n.ops-kpi-card { min-height: 136px; }\n.ops-kpi-card .ops-kpi-value { letter-spacing: -0.03em; }\n.ops-kpi-meta { color: var(--zcs_tertiary_text_color); }\n.ops-section-card { box-shadow: 0 2px 10px rgba(18,19,43,0.04); }\n.ops-report-link { color: var(--zcs_brand_color); }\n.ops-report-link:hover { text-decoration: underline; }\n.ops-col-2 { flex: 0 0 calc(16.666% - 17px); max-width: calc(16.666% - 17px); }\n@media (max-width: 1280px) { .ops-col-2 { flex-basis: calc(33.333% - 14px); max-width: calc(33.333% - 14px); } }\n@media (max-width: 768px) {\n\t\t.zcs-page-container-inner { padding: 16px 20px; gap: 12px; }\n\t\t.ops-col-2 { flex-basis: calc(50% - 10px); max-width: calc(50% - 10px); }\n\t\t.ops-hero { flex-direction: column; align-items: flex-start; }\n}\n@media (max-width: 576px) { .ops-col-2 { flex-basis: 100%; max-width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&apos;zcs-page-container zcs-commonview zcs-wh-full ops-dashboard&apos;&gt;\n\t\t&lt;div class=&apos;zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;ops-hero zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&apos;&gt;Hello &lt;%=userName%&gt;. Today is &lt;%=today%&gt;.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&apos;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-m-0&apos;&gt;Operations Dashboard&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0&apos;&gt;Live view of upcoming events, open assignments, overdue work, blockers, today&apos;s updates, and remaining workload.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=addUpdateUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Add Daily Update&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;zcs-panel-wrapper&apos;&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;ops-kpi-list zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-calendar-date&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h4 class=&apos;ops-kpi-value zcs-font-40 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=upcomingEventsCount%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Upcoming Events (30 days)&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-kpi-meta zcs-font-12&apos;&gt;Events scheduled from today through the next 30 days&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&apos;&lt;%=upcomingUrl%&gt;&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline files-2-single-content-03&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h4 class=&apos;ops-kpi-value zcs-font-40 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=myOpenTasksCount%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Open Task Assignments&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-kpi-meta zcs-font-12&apos;&gt;Open work assigned or reassigned to you&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&apos;&lt;%=openTasksUrl%&gt;&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-3-alert&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h4 class=&apos;ops-kpi-value zcs-font-40 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=overdueTasksCount%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Overdue Tasks&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-kpi-meta zcs-font-12&apos;&gt;Open tasks past due date&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&apos;&lt;%=overdueUrl%&gt;&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-lock&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h4 class=&apos;ops-kpi-value zcs-font-40 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=blockedTasksCount%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Blocked Tasks&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-kpi-meta zcs-font-12&apos;&gt;Open tasks marked as blocked&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&apos;&lt;%=blockedUrl%&gt;&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg&apos;&gt;&lt;i class=&apos;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h4 class=&apos;ops-kpi-value zcs-font-40 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=todaysUpdatesCount%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&apos;&gt;Today&apos;s Updates&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;ops-kpi-meta zcs-font-12&apos;&gt;&lt;%=todayHours%&gt; hours logged today&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&apos;&lt;%=todaysUpdatesUrl%&gt;&apos; class=&apos;zcs-overlay zcs-wh-full zcs-absolute&apos;&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t\t&lt;li class=&apos;ops-col-2 zcs-relative zcs-cursor-pointer&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;ops-kpi-card zcs-panel zcs-panel-l_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-sh