						on click
						(
							openUrl("#Form:Post_Event_Stats?Product_Name=" + input.Product + "&Event_Name=" + input.ID + "&Event_Type=" + input.Event_Type,"popup window","height=80%,width=80%");
						)
					}
				}
			}

			Email_Invoice_Team as "Email Invoice Team"
			{
				type = functions
				form = Manual_Invoice
				execution type = for each record
			
				on start
				{
					actions
					{
						on click
						(
							sendmail
							(
								from : zoho.adminuserid
								to : input.Invoice_email_id
								cc : zoho.adminuserid
								subject : "Invoice Request for " + input.Products.Product_Name + " " + input.Event_Type
								message : "Hi Team,<br><br>Please raise an invoice for the below details:<br><br><b>Name of product: </b>" + input.Products.Product_Name + "<br><b>Invoice Category: </b>" + input.Invoice_Category + "<br><b>Name of Training/Certification: </b> " + input.Certification_training_Name + "<br><b>Region: </b> " + input.Region + "<br><b>Billing Name: </b> " + input.Billing_Name + "<br><b>Company Name: </b> " + input.Company_Name + "<br><b>Billing Address: </b> " + input.Billing_Address + "<br><b>Billing Email Address: </b> " + input.Billing_Email + "<br><b>Number of Tickets: </b> " + input.Number_of_tickets + "<br><b>Amount to be Paid: </b> " + input.Amount1 + " (Hi Team, this the final amount to be reflected in the invoice and kindly note that the tax is already added to the final amount)<br><b>Currency to be Billed: </b> " + input.Currency_to_be_billed1 + "<br><b>GST Number: </b> " + input.GST_Number + "<br><b>If you are a VAT-registered business, then your VAT ID: </b> " + input.If_you_are_a_VAT_registered_business_then_your_VAT_ID + "<br><b>Tax Exemption Certificate: </b> " + input.Tax_Exemption_Certificate + "<br><br>Thanks & Regards,<br>" + input.Handled_By1.Name + "<br>DX - Training Team"
							)
							// //from :"training@zohocreator.com"
							// 	to :"invoice@zohocorp.com"
							// 	cc: "training@zohocreator.com"
							input.Invoice_Status = "Invoice raised";
						)
					}
				}
			}
		}
	}

