ops-report-link&apos; href=&apos;&lt;%=openTasksUrl%&gt;&apos;&gt;View report&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Overdue Task Assignments&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Open work that has passed its due date&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&apos;&gt;&lt;%=overdueTasksCount%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;ops-report-link&apos; href=&apos;&lt;%=overdueUrl%&gt;&apos;&gt;View report&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Blocked Task Assignments&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Blocked tasks and blocker reasons&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;&lt;%=blockedTasksCount%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;ops-report-link&apos; href=&apos;&lt;%=blockedUrl%&gt;&apos;&gt;View report&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Today&apos;s Task Update Rows&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Updates submitted today and hours worked&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=todaysUpdatesCount%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;a class=&apos;ops-report-link&apos; href=&apos;&lt;%=todaysUpdatesUrl%&gt;&apos;&gt;View report&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<chart elementName='Task_Status_Distribution_Chart' title='Task Status Distribution' titleColor='#222326' titleSize='16px' boldTitle='true' type='Donut' bgColor='#FFFFFF' theme='theme1' legendPos='center.bottom' heightType='custom' heightValue='340px' appLinkName='thisapp' formLinkName='Multiple_tasks_subform' xfield='Status' yfields='count:Status' showDataLabel='true' underlyingReport='Task_Workload_By_Member' />\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<chart elementName='Workload_By_Member_Chart' title='Remaining Task Hours by Member' titleColor='#222326' titleSize='16px' boldTitle='true' type='Bar' xtitle='Member' ytitle='Remaining Hours' bgColor='#FFFFFF' theme='theme1' legendPos='center.bottom' heightType='custom' heightValue='340px' appLinkName='thisapp' formLinkName='Multiple_tasks_subform' xfield='Assigned_To.Email' yfields='sum:Task_Remaining_Hours' showDataLabel='true' underlyingReport='Task_Workload_By_Member' DelugeCriteria='Status != &quot;Completed&quot;' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Upcoming_Events_30_Days_Report' title='Upcoming Events (Next 30 Days)' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='Upcoming_Events_30_Days' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='My_Open_Task_Assignments_Report' title='My Open Task Assignments' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='My_Open_Task_Assignments' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Overdue_Task_Assignments_Report' title='Overdue Task Assignments' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='Overdue_Task_Assignments' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Blocked_Task_Assignments_Report' title='Blocked Task Assignments' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='Blocked_Task_Assignments' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='true' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Todays_Task_Update_Rows_Report' title='Today&apos;s Task Update Rows' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='Todays_Task_Update_Rows' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Disable as "Disable"
			{
				type = form
				form = Discounts_Request
				record event = on add
			
				field rules
				{
					actions
					{
						disable Promocode,Registration_Url,Coupon_Redeemed,No_of_coupons_Redeemed,Promo_code_status;
					}
				}
			}

			Disable2 as "Disable"
			{
				type = form
				form = Discounts_Request
				record event = on edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							if(input.Requester_email_Team_Member.Email != zoho.loginuserid)
							{
								disable Product;
								disable Event;
								disable Event_Type;
								disable Ticket_Reference;
								disable Partner_Company_Name;
								disable Email;
								disable Type_of_user;
								disable No_of_T;
								disable Discount_Percentage;
								disable Requested_by;
								disable Coupon_Redeemed;
								disable No_of_coupons_Redeemed;
								disable Promo_code_status;
							}
							disable Promo_code_status;
						)
					}
				}
			}

			Hide_fields1 as "Hide fields"
			{
				type = form
				form = Discounts_Request
				status = inactive
				record event = on edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							// No-op placeholder to keep the disabled workflow structurally complete.
						)
					}
				}
			}

			Notification3 as "Notification"
			{
				type = form
				form = Discounts_Request
				status = inactive
				record event = on add
			
				on success
				{
					actions
					{
						custom deluge script
						(
							response = zoho.pushNotification(zoho.loginuserid,"Promo code request ","New promocode has been requested by " + input.Added_User,"Discounts_Tracker_Report",input.ID);
							response1 = zoho.pushNotification(input.Assigned_to_To_generate_Promocode.Email,"Promo code request ","New promocode has been requested by " + input.Added_User,"Discounts_Tracker_Report",input.ID);
						)
					}
				}
			}

			Notification4 as "Notification"
			{
				type = form
				form = Discounts_Request
				record event = on edit
			
				on update of Registration_Url
				{
					actions
					{
						custom deluge script
						(
							response = zoho.pushNotification(input.Requester_email_Team_Member.Email,"Promo code generated ","Promocode has been generated by " + input.Modified_User,"Discounts_Tracker_Report",input.ID);
							response1 = zoho.pushNotification(input.Added_User,"Promo code generated ","Promocode has been generated by " + input.Modified_User,"Discounts_Tracker_Report",input.ID);
						)
					}
				}
			}

			Redirect_to_discount_repo as "Redirect to discount report"
			{
				type = form
				form = Discounts_Request
				record event = on edit
			
				on success
				{
					actions
					{
						openURL("#Report:Discounts_Tracker_Report","new window");
					}
				}
			}

			Requester_email_team_memb1 as "Requester email - team member"
			{
				type = form
				form = Discounts_Request
				record event = on add
			
				on load
				{
					actions
					{
						custom deluge script
						(
							req_email = Team_Members[Email == zoho.loginuserid];
							input.Requester_email_Team_Member = req_email.ID;
							disable Requester_email_Team_Member;
						)
					}
				}
			}

			Update_the_promo_code_sta as "Update the promo code status field"
			{
				type = form
				form = Discounts_Request
				record event = on edit
			
				on update of Registration_Url
				{
					actions
					{
						custom deluge script
						(
							input.Promo_code_status = "Added";
						)
					}
				}
			}

			Date_of_assign_and_reaasi as "Date of assign and reaasign"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							input.Date_of_assign = zoho.currentdate;
							disable Date_of_assign;
							hide Event_Name_Lookup;
						)
					}
				}
			}

			Disable1 as "Disable"
			{
				type = form
				form = Event_Tasks
				record event = on add
			
				on add row of Tasks
				{
					actions
					{
						custom deluge script
						(
							// if(row.Reassigned == false)
							// {
							// 	disable row.Reassigned_to;
							// }
							// hide row.Worklogs;
							// hide row.Status;
							// hide row.Event_Name_Lookup;
						)
					}
				}
			}

			Dynamic_picklist_events as "Dynamic picklist - events"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on user input of Product
				{
					actions
					{
						custom deluge script
						(
							eventslist = Events[Product == input.Product && Event_Status == "Open"];
							x = Collection();
							for each rec in eventslist
							{
								x.insert(rec.ID);
							}
							input.Event:ui.add(x);
						)
					}
				}
			}

			Enable_reassigned_to as "Enable reassigned to"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on user input of Tasks.Reassigned
				{
					actions
					{
						custom deluge script
						(
							// if(row.Reassigned == true)
							// {
							// 	enable row.Reassigned_to;
							// }
							// else
							// {
							// 	disable row.Reassigned_to;
							// }
						)
					}
				}
			}

			Event_Name_lookup as "Event Name lookup"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on user input of Event
				{
					actions
					{
						custom deluge script
						(
							input.Event_Name_Lookup = input.Event.Event_Name;
							input.Tasks.Event_Name_Lookup = input.Event_Name_Lookup;
						)
					}
				}
			}

			Event_Name_lookup_subform as "Event Name lookup - subform"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on add row of Tasks
				{
					actions
					{
						custom deluge script
						(
							// row.Event_Name_Lookup=input.Event_Name_Lookup;
						)
					}
				}
			}

			Get_the_task_Name as "Get the task Name"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on user input of Tasks.Task_Name1
				{
					actions
					{
						custom deluge script
						(
							Tasks.Task_Name=Tasks.Task_Name1.Task_Name;
						)
					}
				}
			}

			Hide1 as "Hide"
			{
				type = form
				form = Event_Tasks
				record event = on add
			
				on load
				{
					actions
					{
						custom deluge script
						(
							// hide Tasks.Worklogs;
							// hide Tasks.Status;
							// hide Tasks.Event_Name_Lookup;
							// hide Tasks.Task_Name;
						)
					}
				}
			}

			Hide2 as "Hide"
			{
				type = form
				form = Event_Tasks
				record event = on add or edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							// hide Tasks.Event_Name_Lookup;
							// disable Tasks.Worklogs;
						)
					}
				}
			}

			Not_to_allow_reassign_aft as "Not to allow reassign after completion"
			{
				type = form
				form = Event_Tasks
				record event = on edit
			
				on user input of Tasks.Reassigned
				{
					actions
					{
						custom deluge script
						(
							for each rec in input.Tasks
							{
								if(rec.Status == "Completed")
								{
									if(rec.Reassigned == true)
									{
										alert "Task is completed and cannot be reassigned";
									}
								}
							}
						)
					}
				}
			}

			Notification1 as "Notification"
			{
				type = form
				form = Event_Tasks
				record event = on add
			
				on success
				{
					actions
					{
						custom deluge script
						(
							for each rec in input.Tasks
							{
								response = zoho.pushNotification(rec.Assigned_To.Email,"New Event Assigned","New event - " + rec.Task_Name + " for " + rec.Event_Name_Lookup + " has been assigned","Tasks_Team",input.ID);
							}
						)
					}
				}
			}

			Notification2 as "Notification"
			{
				type = form
				form = Event_Tasks
				record event = on edit
			
				on success
				{
					actions
					{
						custom deluge script
						(
							for each rec in input.Tasks
							{
								if(rec.Reassigned == true && rec.Reassigned_to != null)
								{
									response = zoho.pushNotification(rec.Reassigned_to.Email,"New Event Assigned","New event - " + rec.Task_Name + " for " + rec.Event_Name_Lookup + " has been assigned","Tasks_Team",input.ID);
								}
							}
						)
					}
				}
			}

			Remaining_hours_total_hou as "Remaining hours = total hours"
			{
				type = form
				form = Event_Tasks
				record event = on add
			
				on user input of Total_Hours_assigned
				{
					actions
					{
						custom deluge script
						(
							input.Remaining_Hours = input.Total_Hours_assigned;
							disable Remaining_Hours;
						)
					}
				}
			}

			Update_worklogs_Reassigne1 as "Update worklogs - Reassigned"
			{
				type = form
				form = Event_Tasks
				record event = on edit
			
				on success
				{
					actions
					{
						custom deluge script
						(
							for each rec in input.Tasks
							{
								if(rec.Reassigned == true && rec.Reassigned_to != null && rec.Worklogs != null)
								{
									rec.Worklogs=rec.Worklogs + "\n" + "<li>" + zoho.currentdate + " - <span style='color:#0000FF;'>Reassigned from " + rec.Assigned_To.Name + " to " + rec.Reassigned_to.Name + "</span></li>";
								}
								else if(rec.Reassigned == true && rec.Reassigned_to != null && rec.Worklogs == null)
								{
									rec.Worklogs="<li>" + zoho.currentdate + " - <span style='color:#0000FF;'>Reassigned from " + rec.Assigned_To.Name + " to " + rec.Reassigned_to.Name + "</span></li>";
								}
							}
						)
					}
				}
			}

			Fetch_DRI_ID as "Fetch DRI ID"
			{
				type = form
				form = Events
				record event = on add or edit
			
				on user input of DRI
				{
					actions
					{
						custom deluge script
						(
							input.DRI_ID = input.DRI;
						)
					}
				}
			}

			Get_Month_and_Year as "Get Month and Year"
			{
				type = form
				form = Events
				record event = on add or edit
			
				on user input of End_Date
				{
					actions
					{
						custom deluge script
						(
							// Get the leave request month
							month_number = input.Start_Date.getMonth();
							month_name_map = {"1":"January","2":"February","3":"March","4":"April","5":"May","6":"June","7":"July","8":"August","9":"September","10":"October","11":"November","12":"December"};
							// Get month name
							month_name = month_name_map.get(month_number.toString());
							year_name = input.Start_Date.getYear();
							input.Month_and_year = month_name + " " + year_name;
						)
					}
				}
			}

			Hide_DRI_ID as "Hide DRI ID"
			{
				type = form
				form = Events
				record event = on add or edit
			
				on load
				{
					actions
					{
						custom deluge script
						(
							hide DRI_ID;
						)
					}
				}
			}

			Hide_fields as "Hide fields"
			{
				type = form
				form = Events
				record event = on add
			
				field rules
				{
					actions (Event_Type == "Certification" || Event_Type == "Certification")
					{
						hide DRI2,Time,Mode_of_Training;
					}
					actions (Event_Type == "Online Training")
					{
						show Online_Training_Survey;
					}
				}
			}

			Notification as "Notification"
			{
				type = form
				form = Events
				record event = on add
			
				on success
				{
					actions
					{
						custom deluge script
						(
							response = zoho.pushNotification(zoho.loginuserid,"New Event Added","New event - " + input.Event_Name + " has been added","All_Events",input.ID);
						)
					}
				}
			}

			Notification5 as "Notification"
			{
				type = form
				form = Events
				record event = on edit
			
				on update of Survey_Report
				{
					actions
					{
						custom deluge script
						(
							response = zoho.pushNotification(zoho.loginuserid,"Survey Added","Survey Added","All_Events",input.ID);
							if(input.Survey != null && input.Survey_Report != null)
							{
								input.Survey_Request = "Added";
							}
						)
					}
				}
			}

			Redirect_to_events_report as "Redirect to events report"
			{
				type = form
