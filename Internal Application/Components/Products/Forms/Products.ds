form Products
{
	success message = "Product Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Product_Name
	(
		type = text
		displayname = "Product Name"
		row = 1
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}