form Team_Members
{
	displayname = "Team Members"
	success message = "Team Member Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Name
	(
		type = name
		prefix
		(
			type = prefix
			displayname ="Prefix"
			visibility = false
			value = {"Mr.","Mrs.","Ms."}
		)
		first_name
		(
			type = first_name
			displayname ="First Name"
		)
		last_name
		(
			type = last_name
			displayname ="Last Name"
		)
		suffix
		(
			type = suffix
			displayname ="Suffix"
			visibility = false
		)
		row = 1
		column = 1
		width = medium
		personal data = true
	)
	Reporting_to
	(
		type = picklist
		displayname = "Reporting to"
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Products_Working_on
	(
		type = list
		displayname = "Products Working on"
		values = {"Creator","Deluge","QEngine","RPA","Flow","Analytics","Bookings"}
		height = 60px
		row = 1
		column = 1
		width = medium
	)
	Emp_ID
	(
		type = number
		displayname = "Emp ID"
		row = 1
		column = 1
		width = medium
	)
	Email
	(
		type = email
		maxchar = 80
		row = 1
		column = 1
		width = medium
		personal data = true
	)
	users
	(
		type = picklist
		displayname = "Users"
		module = users
		displayformat = [username]
		row = 1
		column = 1
		width = medium
		personal data = true
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}