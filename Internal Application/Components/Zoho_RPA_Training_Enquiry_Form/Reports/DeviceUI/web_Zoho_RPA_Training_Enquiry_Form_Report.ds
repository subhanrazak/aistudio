report Zoho_RPA_Training_Enquiry_Form_Report
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Name
					Email
					Organization
					Country
					How_familiar_are_you_with_Zoho_RPA as "How familiar are you with Zoho RPA"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				Delete
				Duplicate
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Name
					Email
					Organization
					Country
					How_familiar_are_you_with_Zoho_RPA as "How familiar are you with Zoho RPA"
					Preferred_Training_Mode as "Preferred training mode"
					I_am_a as "I am a"
					Number_of_users as "Number of users"
					Approximate_date_you_d_like_to_start_the_training as "Approximate date you'd like to start the training"
					Additional_information_if_any as "Additional information (if any)"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
		)
	)
}