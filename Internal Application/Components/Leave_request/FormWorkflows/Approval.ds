Approval as "Approval"
{
	type = approval
	form = Leave_request
	display fields = [Name,Leave_Type,From_Date,To_Date,Reason]
	on start
	{
		actions
		{
			Status = "Pending";
		}
	}
	on level 1
	{
		approvers
		(
			role = "CEO"
		)
		on approve
		{
			actions
			{
				Status = "Approved";
			}
		}
		on reject
		{
			actions
			{
				Status = "Rejected";
			}
		}
	}
}