Send_notification as "Send notification"
{
	type = form
	form = Leave_request
	record event = on add

	on success
	{
		actions
		{
			custom deluge script
			(
				//Notification
				leave = zoho.pushNotification(input.First_Approver,"New Leave Request","A leave request is made by " + input.Name.Name,"All_Leave_Requests",input.ID);
				//Cliq bot
				//response = zoho.cliq.postToChat(chat.get("id"),"A leave request is made by "+input.Name.Name,"ZohoChat");
			)
		}
	}
}
