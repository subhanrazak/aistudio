form Leave_request
{
	displayname = "Leave request"
	success message = "Leave Request Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Name
	(
		type = picklist
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Leave_Type
	(
		type = radiobuttons
		displayname = "Leave Type"
		maxchar = 100
		values = {"Casual","Sick","Optional Leave"}
		row = 1
		column = 1
		width = medium
	)
	From_Date
	(
		type = date
		displayname = "From Date"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = medium
	)
	To_Date
	(
		type = date
		displayname = "To Date"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = medium
	)
	must have Reason
	(
		type = textarea
		height = 100px
		row = 1
		column = 1
		width = medium
	)
	Leave_Month
	(
		type = text
		displayname = "Leave Month"
		description
		[
			type = help_text
			message = "Month of the From Date"
		]
		row = 1
		column = 1
		width = medium
	)
	First_Approver
	(
		type = picklist
		displayname = "First Approver"
		module = users
		displayformat = [emailid]
		row = 1
		column = 1
		width = medium
		personal data = true
	)
	Status
	(
		type = picklist
		maxchar = 100
		values = {"Pending","Rejected","Approved"}
		initial value = "Pending"
		row = 1
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
