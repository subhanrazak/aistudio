default list All_Leave_Requests
{
	displayName = "All Leave Requests"
	show all rows from Leave_request    
	(
		Name
		From_Date as "From Date"
		To_Date as "To Date"
		Reason
		Leave_Type as "Leave Type"
		First_Approver as "First Approver"
		Status
		Added_Time as "Added Time"
		Leave_Month as "Leave Month"
	)
	group by
	(
		Leave_Month descending
	)
	conditional formatting
	(
		"Pending"
		{
			condition = (Status == "Pending")
			fields = [Status]
			format = "color:#f1c50e;"
		}
		"Approved"
		{
			condition = (Status == "Approved")
			fields = [Status]
			format = "color:#19bc9f;"
		}
		"Rejected"
		{
			condition = (Status == "Rejected")
			fields = [Status]
			format = "color:#e64d3b;"
		}
	)
}
