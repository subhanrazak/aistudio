					Reason
					Leave_Type as "Leave Type"
					Status
					Added_Time as "Added Time"
					Leave_Month as "Leave Month"
					First_Approver as "First Approver"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				Delete
				Duplicate
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			datablock1
			(
				fields
				(
					Name
					From_Date as "From Date"
					To_Date as "To Date"
					Reason
					Leave_Type as "Leave Type"
					First_Approver as "First Approver"
					Status
					Leave_Month as "Leave Month"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
		)
	)
}
