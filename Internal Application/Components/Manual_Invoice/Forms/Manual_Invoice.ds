form Manual_Invoice
{
	displayname = "Manual Invoice"
	success message = "Manual Invoice Added Successfully"
	References
	(
		type = section
		visibility = true
		row = 1
		column = 0
		width = medium
	)
	Products
	(
		type = picklist	
		values  = Products.ID
		displayformat = [Product_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Ticket_ID
	(
		type = text
		displayname = "Ticket ID"
		row = 1
		column = 1
		width = medium
	)
	Handled_By1
	(
		type = picklist	
		displayname = "Handled By"
		values  = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Events
	(
		type = list	
		values  = Events.ID
		displayformat = [Event_Name]
		sortorder = ascending
		height = 60px
		row = 1
		column = 2
		width = medium
	)
	Event_Type
	(
		type = picklist
		displayname = "Event Type"
		maxchar = 100
		values = {"Certification","Online Training"}
		row = 1
		column = 2
		width = medium
	)
	Invoice_Category
	(
		type = text
		displayname = "Invoice Category"
		initial value = "Training"
		row = 1
		column = 2
		width = medium
	)
	Customer_Details
	(
		type = section
		displayname = "Customer Details"
		visibility = true
		row = 2
		column = 0
		width = medium
	)
	Certification_training_Name
	(
		type = text
		displayname = "Certification/training Name"
		description
		[
			type = help_text
			message = "Example:\nBusiness user Certification\nAssociate Developer Certification\nOnline Training - Business user & Associate Developer"
		]
		row = 2
		column = 1
		width = medium
	)
	Region
	(
		type = text
		displayname = "Region/Country"
		row = 2
		column = 1
		width = medium
	)
	Company_Name
	(
		type = text
		displayname = "Company Name"
		row = 2
		column = 1
		width = medium
	)
	Billing_Name
	(
		type = text
		displayname = "Billing Name"
		row = 2
		column = 1
		width = medium
	)
	Billing_Address
	(
		type = address
		displayname = "Billing Address"
		capture_coordinates = true
		adjust_using_map = false
		address_line_1
		(
			type = address_line_1
			displayname = "Address Line 1"
		)
		address_line_2
		(
			type = address_line_2
			displayname = "Address Line 2"
		)
		district_city
		(
			type = district_city
			displayname = "City / District"
		)
		state_province
		(
			type = state_province
			displayname = "State / Province"
		)
		postal_Code
		(
			type = postal_Code
			displayname = "Postal Code"
		)
		country
		(
			type = country
			displayname = "Country"
		)
		latitude
		(
			type = latitude
			displayname = "latitude"
			visibility = false
		)
		longitude
		(
			type = longitude
			displayname = "longitude"
			visibility = false
		)
		row = 2
		column = 1
		width = medium
		personal data = true
	)
	Billing_Email
	(
		type = email
		displayname = "Billing Email"
		maxchar = 80
		row = 2
		column = 1
		width = medium
		personal data = true
	)
	Comments_if_any
	(
		type = textarea
		displayname = "Comments(if any)"
		height = 100px
		row = 2
		column = 1
		width = medium
	)
	Number_of_tickets
	(
		type = number
		displayname = "Number of tickets "
		row = 2
		column = 2
		width = medium
	)
	Amount
	(
		displayname = "Amount (in USD)"
		type = USD
		format = commadotindian
		row = 2
		column = 2
		width = medium
	)
	Amount1
	(
		type = decimal
		displayname = "Amount (in the respective currency)"
		row = 2
		column = 2
		width = medium
	)
	Currency_to_be_billed1
	(
		type = picklist
		displayname = "Currency to be billed"
		maxchar = 100
		values = {"USD","INR","CAD","AED","EUR","NZD","ZAR","AUD","EGP","MYR"}
		row = 2
		column = 2
		width = medium
	)
	GST_Number
	(
		type = text
		displayname = "GST Number"
		row = 2
		column = 2
		width = medium
	)
	If_you_are_a_VAT_registered_business_then_your_VAT_ID
	(
		type = text
		displayname = "VAT ID"
		row = 2
		column = 2
		width = medium
	)
	Tax_Exemption_Certificate
	(
		type = text
		displayname = "Tax Exemption Certificate"
		row = 2
		column = 2
		width = medium
	)
	Invoice_details
	(
		type = section
		displayname = "Invoice details"
		visibility = true
		row = 3
		column = 0
		width = medium
	)
	Choose_invoice_email
	(
		type = picklist
		displayname = "Choose invoice email"
		maxchar = 100
		values = {"inv.zstoreind@zohocorp.com","invoice@zohocorp.com"}
		description
		[
			type = help_text
			message = "For India region choose - inv.zstoreind@zohocorp.com"
		]
		row = 3
		column = 1
		width = medium
	)
	Invoice_email_id
	(
		type = email
		displayname = "Invoice email id"
		maxchar = 80
		row = 3
		column = 1
		width = medium
		personal data = true
	)
	Invoice_Date
	(
		type = date
		displayname = "Invoice Date"
		initial value = "${zoho.currentdate}"
		alloweddays = 0,1,2,3,4,5,6
		row = 3
		column = 1
		width = medium
	)
	Invoice_Status
	(
		type = picklist
		displayname = "Invoice Status"
		maxchar = 100
		values = {"Invoice Created","Invoice raised","Invoice sent","Invoice Paid","Invoice Cancelled"}
		initial value = "Invoice Created"
		row = 3
		column = 1
		width = medium
	)
	Invoice_Ticket_ID
	(
		type = text
		displayname = "Invoice Ticket ID"
		row = 3
		column = 1
		width = medium
	)
	Invoice_paid_on
	(
		type = date
		displayname = "Invoice paid on "
		alloweddays = 0,1,2,3,4,5,6
		row = 3
		column = 2
		width = medium
	)
	Invoice_Number
	(
		type = text
		displayname = "Invoice Number"
		row = 3
		column = 2
		width = medium
	)
	Contact_Person
	(
		type = email
		displayname = "Contact Person"
		maxchar = 80
		description
		[
			type = help_text
			message = "Person whom we contacted from Invoice Team"
		]
		row = 3
		column = 2
		width = medium
		personal data = true
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}