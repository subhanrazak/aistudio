default list All_Manual_Invoices
{
	displayName = "All Manual Invoices"
	show all rows from Manual_Invoice
	(
		Invoice_Date as "Invoice Date"
		Products
		Event_Type as "Event Type"
		Billing_Name as "Billing Name"
		Billing_Address  as "Billing Address"
		(
			enable = Link_to_Map,Show_As_Text
		)
		Billing_Email as "Billing Email"
		Company_Name as "Company Name"
		Region as "Region/Country"
		Number_of_tickets as "Number of tickets "
		Amount as "Amount (in USD)"
		(
			display = total
		)
		GST_Number as "GST Number"
		Invoice_Status as "Invoice Status"
		Invoice_paid_on as "Invoice paid on "
		Invoice_Number as "Invoice Number"
		Ticket_ID as "Ticket ID"
		Invoice_Ticket_ID as "Invoice Ticket ID"
		custom action "Email Invoice Team"
		(
			workflow = Email_Invoice_Team
			show action in edit record menu = true
			success message = "Invoice email sent"
			condition = (Invoice_Status == "Invoice Created")
		)
		Certification_training_Name as "Certification/training Name"
		If_you_are_a_VAT_registered_business_then_your_VAT_ID as "VAT ID"
		Tax_Exemption_Certificate as "Tax Exemption Certificate"
		Handled_By1 as "Handled By"
		Invoice_Category as "Invoice Category"
		Contact_Person as "Contact Person"
		Amount1 as "Amount (in the respective currency)"
		Currency_to_be_billed1 as "Currency to be billed"
		Events
		Comments_if_any as "Comments(if any)"
		Choose_invoice_email as "Choose invoice email"
		Invoice_email_id as "Invoice email id"
	)
}