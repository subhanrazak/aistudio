report Discounts_Tracker_Report
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Product
					Event
					Event_Type as "Event Type"
					Promocode
					No_of_T as "No. of Tickets"
					Discount_Percentage as "Discount Percentage"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
				"Add promocode"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				Delete
				Duplicate
				View Record
				"Add promocode"
			)
			on left swipe
			(
				Delete
			)
			on right swipe
			(
				Edit
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Product
					Event
					Event_Type as "Event Type"
					Promocode
					No_of_T as "No. of Tickets"
					Coupon_Redeemed as "Coupon  Redeemed?"
					Discount_Percentage as "Discount Percentage"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
		)
	)
}