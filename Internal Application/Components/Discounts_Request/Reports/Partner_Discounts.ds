list Partner_Discounts
{
	displayName = "Partner Discounts"
	show all rows from Discounts_Request
	(
		Product
		Event
		Event_Type as "Event Type"
		Ticket_Reference as "Ticket Reference"
		Partner_Company_Name as "Company Name"
		Email
		Type_of_user as "Type of user"
		No_of_T as "No. of Tickets"
		Actual_Amount as "Actual Amount"
		Discount_Percentage as "Discount Percentage"
		Amount_after_discount_applied as "Amount after discount applied"
		Total_Discounted_value as "Total discounted amount"
		Requested_by as "Requested by"
		Promocode
		Registration_Url as "Registration Url"
		Coupon_Redeemed as "Coupon  Redeemed?"
		No_of_coupons_Redeemed as "No.of coupons Redeemed"
		Promo_code_status as "Promo code status"
		Requester_email_Team_Member as "Requester email - Team Member"
		Assigned_to_To_generate_Promocode as "Assigned to - To generate Promocode"
		Comments_if_any as "Comments(if any)"
	)
}