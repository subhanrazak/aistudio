form Discounts_Request
{
	displayname = "Discounts Request"
	success message = "Data Added Successfully!"
	Event_Details
	(
		type = section
		displayname = "Event Details"
		visibility = true
		row = 1
		column = 0
		width = medium
	)
	Product
	(
		type = picklist
		values = Products.ID
		displayformat = [Product_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Event
	(
		type = picklist
		values = Events.ID
		displayformat = [Event_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = large
	)
	Event_Type
	(
		type = picklist
		displayname = "Event Type"
		maxchar = 100
		values = {"Online Training","Certification"}
		row = 1
		column = 1
		width = medium
	)
	Ticket_Reference
	(
		type = text
		displayname = "Ticket Reference"
		row = 1
		column = 1
		width = medium
	)
	Customer_Details
	(
		type = section
		displayname = "Customer Details"
		visibility = true
		row = 2
		column = 0
		width = medium
	)
	Partner_Company_Name
	(
		type = text
		displayname = "Company Name"
		row = 2
		column = 1
		width = medium
	)
	Email
	(
		type = email
		maxchar = 80
		description
		[
			type = help_text
			message = "Email address of the person requesting to pay."
		]
		row = 2
		column = 1
		width = medium
		personal data = true
	)
	Type_of_user
	(
		type = picklist
		displayname = "Type of user"
		maxchar = 100
		values = {"Partner Prospect","Partner","Customer","Zoho Internal Employee","User"}
		sortorder = ascending
		others option = true
		row = 2
		column = 1
		width = medium
	)
	No_of_T
	(
		type = number
		displayname = "No. of Tickets"
		row = 2
		column = 1
		width = medium
	)
	Actual_Amount
	(
		displayname = "Actual Amount"
		type = USD
		format = commadotindian
		description
		[
			type = help_text
			message = "Actual amount * number of tickets"
		]
		row = 2
		column = 1
		width = medium
	)
	Discount_Percentage
	(
		type = percentage
		displayname = "Discount Percentage"
		row = 2
		column = 1
		width = medium
	)
	Amount_after_discount_applied
	(
		displayname = "Amount after discount applied"
		type = USD
		format = commadotindian
		row = 2
		column = 1
		width = medium
	)
	Total_Discounted_value
	(
		type = formula
		displayname = "Total discounted amount"
		value = input.Actual_Amount - input.Amount_after_discount_applied
		visibility = false
		row = 2
		column = 1
		width = medium
	)
	Requested_by
	(
		type = email
		displayname = "Requested by"
		maxchar = 80
		description
		[
			type = help_text
			message = "Email of the person forwarded this request (either internal or external)"
		]
		row = 2
		column = 1
		width = medium
		personal data = true
	)
	Promo_code
	(
		type = section
		displayname = "Promo code"
		visibility = true
		row = 3
		column = 0
		width = medium
	)
	Promocode
	(
		type = text
		description
		[
			type = help_text
			message = "Will be updated post creation."
		]
		row = 3
		column = 1
		width = medium
	)
	Registration_Url
	(
		type = url
		displayname = "Registration Url"
		enable linkname
		description
		[
			type = help_text
			message = "Backstage URL"
		]
		row = 3
		column = 1
		width = medium
	)
	Coupon_Redeemed
	(
		type = checkbox
		displayname = "Coupon  Redeemed?"
		initial value = false
		row = 3
		column = 1
		width = medium
	)
	No_of_coupons_Redeemed
	(
		type = number
		displayname = "No.of coupons Redeemed"
		row = 3
		column = 1
		width = medium
	)
	Promo_code_status
	(
		type = radiobuttons
		displayname = "Promo code status"
		maxchar = 100
		values = {"Yet to add","Added"}
		initial value = "Yet to add"
		row = 3
		column = 1
		width = medium
	)
	Section
	(
		type = section
		visibility = true
		row = 4
		column = 0
		width = medium
	)
	Requester_email_Team_Member
	(
		type = picklist
		displayname = "Requester email - Team Member"
		values = Team_Members.ID
		displayformat = [Email]
		sortorder = ascending
		row = 4
		column = 1
		width = medium
	)
	Section1
	(
		type = section
		displayname = "Section"
		visibility = true
		row = 5
		column = 0
		width = medium
	)
	Assigned_to_To_generate_Promocode
	(
		type = picklist
		displayname = "Assigned to - To generate Promocode"
		values = Team_Members.ID
		displayformat = [Email]
		sortorder = ascending
		row = 5
		column = 1
		width = medium
	)
	Section2
	(
		type = section
		displayname = "Section"
		visibility = true
		row = 6
		column = 0
		width = medium
	)
	Comments_if_any
	(
		type = textarea
		displayname = "Comments(if any)"
		height = 100px
		row = 6
		column = 1
		width = medium
	)
	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}