Add_promocode as "Add promocode"
{
	type = functions
	form = Discounts_Request
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				//openUrl("#Form:Discounts_Request?ID=" + input.ID,"popup window","height=80%,width=80%");
				openURL("#Form:Discounts_Request?recLinkID=" + input.ID + "&viewLinkName=Discounts_Tracker_Report","popup window");
			)
		}
	}
}