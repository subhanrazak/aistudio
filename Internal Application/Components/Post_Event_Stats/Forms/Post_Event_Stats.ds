form Post_Event_Stats
{
	displayname = "Post Event Stats"
	success message = "Post Event Activity Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Product_Name
	(
		type = picklist
		displayname = "Product Name"
		values = Products.ID
		displayformat = [Product_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Event_Name
	(
		type = picklist
		displayname = "Event Name"
		values = Events.ID
		displayformat = [Event_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Event_Name_Lookup
	(
		type = text
		displayname = "Event Name (Lookup)"
		row = 1
		column = 1
		width = medium
	)
	Event_Type
	(
		type = picklist
		displayname = "Event Type"
		maxchar = 100
		values = {"Webinar","Online Training","In-person Training","Certification","Adhoc"}
		row = 1
		column = 1
		width = medium
	)
	Total_Registration
	(
		type = number
		displayname = "Total Registration"
		row = 1
		column = 1
		width = medium
	)
	Total_Attendees
	(
		type = number
		displayname = "Total Attendees"
		row = 1
		column = 1
		width = medium
	)
	Source_wise_Registrants_details_Section
	(
		type = section
		displayname = "Source-wise Registrants details"
		visibility = false
		row = 2
		column = 1
		width = medium
	)
	Source_wise_Registrants_details
	(
		type = grid
		displayname = "Source-wise Registrants details"
		values = Source_wise_Registrations.ID
		bidirectional = Event
		row = 2
		column = 1
		width = medium
	)
	Country_wise_Registrants_details_Section
	(
		type = section
		displayname = "Country-wise Registrants details"
		visibility = false
		row = 3
		column = 1
		width = medium
	)
	Country_wise_Registrants_details
	(
		type = grid
		displayname = "Country-wise Registrants details"
		values = Country_wise_Registrations.ID
		bidirectional = Events
		row = 3
		column = 1
		width = medium
	)
	Revenue_Details
	(
		type = section
		displayname = "Revenue Details"
		visibility = true
		row = 4
		column = 1
		width = medium
	)
	Manual_invoice_in_USD
	(
		displayname = "Manual invoice in USD"
		type = USD
		format = commadotindian
		initial value = 0
		row = 4
		column = 1
		width = medium
	)
	Backstage_Revenue
	(
		displayname = "Backstage Revenue (USD)"
		type = USD
		format = commadotindian
		row = 4
		column = 1
		width = medium
	)
	Total_Revenue_in_USD1
	(
		type = formula
		displayname = "Total Revenue in USD"
		value = input.Manual_invoice_in_USD + input.Backstage_Revenue
		visibility = false
		row = 4
		column = 1
		width = medium
	)
	Internal_Registrations
	(
		type = number
		displayname = "Internal Registrations"
		row = 4
		column = 1
		width = medium
	)
	Discounted_Attendees_Section
	(
		type = section
		displayname = "Discounted Attendees"
		visibility = false
		row = 5
		column = 1
		width = medium
	)
	Discounted_Attendees
	(
		type = grid
		displayname = "Discounted Attendees"
		values = Discounted_Attendees.ID
		bidirectional = Event
		row = 5
		column = 1
		width = medium
	)
	Examination_Attendee_Section
	(
		type = section
		displayname = "Examination Attendee"
		visibility = false
		row = 6
		column = 1
		width = medium
	)
	Examination_Attendee
	(
		type = grid
		displayname = "Examination Attendee"
		values = Examination_to_Attendees.ID
		bidirectional = Event
		row = 6
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}