Hide_show as "Hide/show"
{
	type = form
	form = Post_Event_Stats
	record event = on add or edit

	field rules
	{
		actions (Event_Type == "Webinar")
		{
			hide Discounted_Attendees,Backstage_Revenue,Internal_Registrations,Examination_Attendee;
		}
		actions (Event_Type == "Online Training" || Event_Type == "Certification")
		{
			hide Source_wise_Registrants_details;
		}
	}
}