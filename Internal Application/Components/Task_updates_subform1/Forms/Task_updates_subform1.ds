form Task_updates_subform1
{
	displayname = "Task updates - subform"
	success message = "Data Added Successfully!"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Date_field
	(
		type = date
		displayname = "Date"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = 200px
	)
	Assigned_To
	(
		type = picklist
		displayname = "Assigned To"
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		sortorder = ascending
		row = 1
		column = 1
		width = 200px
	)
	Event_Tasks
	(
		type = picklist
		displayname = "Event Tasks"
		values = Event_Tasks.ID
		displayformat = [Event_Name_Lookup]
		sortorder = ascending
		row = 1
		column = 1
		width = 300px
	)
	Event_Task
	(
		type = textarea
		displayname = "Event Task"
		height = 100px
		row = 1
		column = 1
		width = medium
	)
	Task_Name
	(
		type = picklist
		displayname = "Task Name"
		values = Multiple_tasks_subform.ID
		displayformat = [Task_Name]
		sortorder = ascending
		row = 1
		column = 1
		width = 200px
	)
	Task_Name1
	(
		type = textarea
		displayname = "Task Name"
		height = 100px
		row = 1
		column = 1
		width = medium
	)
	Remaining_Hours
	(
		type = decimal
		displayname = "Remaining Hours"
		row = 1
		column = 1
		width = 200px
	)
	Hours_worked
	(
		type = decimal
		displayname = "Hours Worked"
		initial value = 0
		barcode = true
		camera = primary
		row = 1
		column = 1
		width = 100px
	)
	Description
	(
		type = richtext
		height = 200px
		toolbar = enable
		[
			style, font-color, background-color, alignment, link, table, bullets-and-numbering,
			font-size : {1, 2, 3, 4, 5, 6, 7},
			font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue", "EBGaramond", "RobotoCondensed", "ArchivoBlack", "Carlito", "Barlow", "Comfortaa", "Montserrat", "Nunito", "Poppins", "Quicksand", "Raleway", "Rubik", "SourceSansPro"}
		]
		row = 1
		column = 1
		width = 506px
	)
	Status
	(
		type = picklist
		maxchar = 100
		values = {"InProgress","NoProgress","Completed"}
		description
		[
			type = help_text
			message = "For Tickets - Don't use this field"
		]
		row = 1
		column = 1
		width = 200px
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}