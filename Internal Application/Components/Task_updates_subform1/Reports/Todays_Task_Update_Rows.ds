list Todays_Task_Update_Rows
{
	displayName = "Today's Task Update Rows"
	show all rows from Task_updates_subform1 [Date_field == zoho.currentdate]
	(
		Date_field as "Date"
		Assigned_To as "Assigned To"
		Event_Tasks as "Event Tasks"
		Task_Name as "Task Name"
		Hours_worked as "Hours Worked"
		Status
		Description
	)
}
