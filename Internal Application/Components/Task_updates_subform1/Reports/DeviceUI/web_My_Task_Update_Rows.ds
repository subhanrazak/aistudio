			on click
			(
				View Record
			)
			on right click
			(
				Edit
				Delete
				Duplicate
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Date_field as "Date"
					Assigned_To as "Assigned To"
