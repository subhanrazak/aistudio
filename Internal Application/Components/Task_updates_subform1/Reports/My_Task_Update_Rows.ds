list My_Task_Update_Rows
{
	displayName = "My Task Update Rows"
	show all rows from Task_updates_subform1 [Assigned_To.Email == zoho.loginuserid]
	(
		Date_field as "Date"
		Assigned_To as "Assigned To"
		Event_Tasks as "Event Tasks"
		Task_Name as "Task Name"
		Hours_worked as "Hours Worked"
		Status
		Description
	)
	sort by
	(
		Date_field descending
	)
}
