form Multiple_tasks_subform
{
	displayname = "Multiple tasks - subform"
	success message = "Data Added Successfully!"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Event_Tasks
	(
		type = picklist
		displayname = "Event Tasks"
		values = Event_Tasks.ID
		bidirectional = Tasks
		displayformat = [Event_Name_Lookup]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Event_Name_Lookup
	(
		type = text
		displayname = "Event Name (Lookup)"
		row = 1
		column = 1
		width = medium
	)
	Task_Name1
	(
		type = picklist
		displayname = "Task Name"
		values = General_Tasks.ID
		displayformat = [Task_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Task_Name
	(
		type = text
		displayname = "Task Name"
		row = 1
		column = 1
		width = medium
	)
	Assigned_To
	(
		type = picklist
		displayname = "Assigned To"
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Status
	(
		type = picklist
		maxchar = 100
		values = {"InProgress","Completed","Assigned"}
		initial value = "Assigned"
		row = 1
		column = 1
		width = medium
	)
	Reassigned
	(
		type = checkbox
		displayname = "Reassigned?"
		initial value = false
		row = 1
		column = 1
		width = medium
	)
	Reassigned_to
	(
		type = picklist
		displayname = "Reassigned to"
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Priority
	(
		type = picklist
		values = {"Low","Medium","High","Critical"}
		initial value = "Medium"
		row = 1
		column = 1
		width = medium
	)
	Due_Date
	(
		type = date
		displayname = "Due Date"
		row = 1
		column = 1
		width = medium
	)
	Estimated_Hours
	(
		type = decimal
		displayname = "Estimated Hours"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Task_Remaining_Hours
	(
		type = decimal
		displayname = "Task Remaining Hours"
		initial value = 0
		row = 1
		column = 1
		width = medium
	)
	Blocked
	(
		type = checkbox
		initial value = false
		row = 1
		column = 1
		width = medium
	)
	Blocker_Reason
	(
		type = textarea
		displayname = "Blocker Reason"
		height = 100px
		row = 1
		column = 1
		width = medium
	)
	Completion_Date
	(
		type = date
		displayname = "Completion Date"
		row = 1
		column = 1
		width = medium
	)
	Worklogs
	(
		type = richtext
		height = 200px
		toolbar = enable
		[
			style, font-color, background-color, alignment, link, table, bullets-and-numbering,
			font-size : {1, 2, 3, 4, 5, 6, 7},
			font-family : {"Serif", "Arimo", "Ptmono", "Heuristica", "OpenSans", "Tinos", "Lato", "DejaVuSans", "ComicNeue", "EBGaramond", "RobotoCondensed", "ArchivoBlack", "Carlito", "Barlow", "Comfortaa", "Montserrat", "Nunito", "Poppins", "Quicksand", "Raleway", "Rubik", "SourceSansPro"}
		]
		private = true
		row = 1
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}