Require_Blocker_Reason as "Require Blocker Reason"
{
	type = form
	form = Multiple_tasks_subform
	record event = on add or edit

	on validate
	{
		actions
		{
			custom deluge script
			(
				if(input.Blocked == true && (input.Blocker_Reason == null || input.Blocker_Reason == ""))
				{
					alert "Blocker Reason is required when a task is blocked.";
					cancel submit;
				}
			)
		}
	}
}