Set_Completion_Date as "Set Completion Date"
{
	type = form
	form = Multiple_tasks_subform
	record event = on add or edit

	on user input of Status
	{
		actions
		{
			custom deluge script
			(
				if(input.Status == "Completed")
				{
					input.Completion_Date = zoho.currentdate;
				}
				else
				{
					input.Completion_Date = null;
				}
			)
		}
	}
}