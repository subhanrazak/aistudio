Set_Task_Remaining_Hours as "Set Task Remaining Hours"
{
	type = form
	form = Multiple_tasks_subform
	record event = on add or edit

	on user input of Estimated_Hours
	{
		actions
		{
			custom deluge script
			(
				if(input.Task_Remaining_Hours == null || input.Task_Remaining_Hours == 0)
				{
					input.Task_Remaining_Hours = input.Estimated_Hours;
				}
			)
		}
	}
}