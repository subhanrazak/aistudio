list Task_Workload_By_Member
{
	displayName = "Task Workload By Member"
	show all rows from Multiple_tasks_subform
	(
		Assigned_To as "Assigned To"
		Status
		Priority
		Due_Date as "Due Date"
		Estimated_Hours as "Estimated Hours"
		(
			display = total
		)
		Task_Remaining_Hours as "Task Remaining Hours"
		(
			display = total
		)
		Task_Name as "Task Name"
		Reassigned as "Reassigned?"
		Reassigned_to as "Reassigned to"
		Blocked
	)
	filters
	(
		Assigned_To
		Status
		Priority
		Due_Date
		Blocked
	)
	group by
	(
		properties
		(
			display record count = true
		)
		Assigned_To ascending
	)
	sort by
	(
		Assigned_To ascending
		Due_Date ascending
	)
}