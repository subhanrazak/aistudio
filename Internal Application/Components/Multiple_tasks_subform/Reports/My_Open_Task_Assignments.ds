list My_Open_Task_Assignments
{
	displayName = "My Open Task Assignments"
	show all rows from Multiple_tasks_subform [((Assigned_To.Email == zoho.loginuserid && Reassigned == false) || (Reassigned_to.Email == zoho.loginuserid && Reassigned == true)) && Status != "Completed"]
	(
		Task_Name as "Task Name"
		Assigned_To as "Assigned To"
		Reassigned as "Reassigned?"
		Reassigned_to as "Reassigned to"
		Status
		Priority
		Due_Date as "Due Date"
		Estimated_Hours as "Estimated Hours"
		Task_Remaining_Hours as "Task Remaining Hours"
		Blocked
		Blocker_Reason as "Blocker Reason"
		Completion_Date as "Completion Date"
		Event_Tasks as "Event Tasks"
		Event_Name_Lookup as "Event Name (Lookup)"
		Task_Name1 as "Task Name"
	)
	filters
	(
		Status
		Priority
		Due_Date
		Blocked
	)
	sort by
	(
		Due_Date ascending
		Priority custom
	)
}