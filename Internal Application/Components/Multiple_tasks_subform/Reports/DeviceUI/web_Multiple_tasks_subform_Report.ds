{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Task_Name as "Task Name"
					Assigned_To as "Assigned To"
					Status
					Reassigned as "Reassigned?"
					Reassigned_to as "Reassigned to"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				Delete
				Duplicate
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Task_Name as "Task Name"
					Assigned_To as "Assigned To"
					Status
					Reassigned as "Reassigned?"
					Reassigned_to as "Reassigned to"
					Worklogs
					Event_Tasks as "Event Tasks"
					Event_Name_Lookup as "Event Name (Lookup)"
					Task_Name1 as "Task Name"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
		)
	)
}