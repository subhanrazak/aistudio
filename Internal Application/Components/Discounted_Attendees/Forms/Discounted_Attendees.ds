form Discounted_Attendees
{
	displayname = "Discounted Attendees"
	success message = "Attendee Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0   
		width = medium
	)
	Event
	(
		type = picklist	
		values  = Post_Event_Stats.ID
		bidirectional = Discounted_Attendees
		displayformat = [Event_Name_Lookup]
		sortorder = ascending
		row = 1
		column = 1   
		width = medium
	)
	Attendees_count
	(
		type = number
		displayname = "Attendees count"
		row = 1
		column = 1   
		width = medium
	)
	Discount_in_percentage
	(
		type = percentage
		displayname = "Discount(in percentage)"
		row = 1
		column = 1   
		width = medium
	)
	Discounted_Amount
	(
		displayname = "Discounted Amount"
		type = USD
		format = commadotindian
		row = 1
		column = 1   
		width = medium
	)
	Source
	(
		type = picklist
		maxchar = 100
		values = {"PAM","Direct","Events"}
		others option = true
		row = 1
		column = 1   
		width = medium
	)
	Promocode
	(
		type = text
		row = 1
		column = 1   
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}