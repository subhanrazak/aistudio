default list All_Discounts
{
	displayName = "All Discounts"
	show all rows from Discounted_Attendees    
	(
		Attendees_count as "Attendees count"
		Discount_in_percentage as "Discount(in percentage)"
		Discounted_Amount as "Discounted Amount"
		(
			display = total	
		)
		Source
		Promocode
		Event
	)
	group by
	(
		Event ascending
	)
}