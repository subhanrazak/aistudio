form Video_Room_Usage
{
	displayname = "Video Room Usage"
	success message = "Video Room Usage Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Event
	(
		type = picklist
		values = Events.ID
		displayformat = [Event_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Notes
	(
		type = text
		row = 1
		column = 1
		width = medium
	)
	Date_and_Time_Section
	(
		type = section
		displayname = "Date and Time"
		visibility = false
		row = 2
		column = 1
		width = medium
	)
	Date_and_Time
	(
		type = grid
		displayname = "Date and Time"
		Start_Date_Time1
		(
			type = datetime
			displayname = "Start Date-Time"
			timedisplayoptions = "hh:mm:ss"
			alloweddays = 0,1,2,3,4,5,6
			width = medium
		)
		Start_Date_Time
		(
			type = datetime
			displayname = "End Date-Time"
			timedisplayoptions = "hh:mm:ss"
			alloweddays = 0,1,2,3,4,5,6
			width = medium
		)
		Room_Image
		(
			type = image
			displayname = "Room Image"
			source = file
			aspect ratio = original
			camera = primary
			show gallery = true
			switch camera = true
			description
			[
				type = tooltip
				message = "Either use image or video"
			]
			width = medium
		)
		Room_Video
		(
			type = video
			displayname = "Room Video"
			duration = 30
			description
			[
				type = tooltip
				message = "Either use image or video"
			]
			width = medium
		)
		row = 2
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
