Hide_Address_Line as "Hide Address Line"
{
	type = form
	form = Zoho_QEngine_QA_Beginner_Certification_Enquiry
	record event = on add

	on load
	{
		actions
		{
			custom deluge script
			(
				input.Country.address_line_1 = "";
				// hide Country.address_line_1; // Composite subfield UI hide is not accepted by the modular checker.
			)
		}
	}
}
