Notify_Team as "Notify Team"
{
	type = form
	form = Zoho_QEngine_QA_Beginner_Certification_Enquiry
	record event = on add

	on success
	{
		actions
		{
			sendmail
			(
				from : zoho.adminuserid
				to : "training@zohoqengine.com"
				subject : "Enquiry received for Zoho QEngine - QA Beginner Certification"
				message : "<div>New enquiry received for Zoho QEngine - QA Beginner certification.<br></div><div><br></div><div>Name:&nbsp;${Name.first_name}&nbsp;${Name.last_name}<br></div><div><br></div><div>Email:&nbsp;${Email}<br></div><div><br></div><div>Company Name:&nbsp;${Company_Name}<br></div><div><br></div><div>Number of Registrations:&nbsp;${Number_of_Registrations}<br></div><div><br></div><div>Country:&nbsp;${Country.country}<br></div>"
			)
		}
	}
}
