			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Name
					Email
					Number_of_Registrations as "Number of Registrations"
					Country
					Company_Name as "Company Name"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
			)
		)
		action
		(
			on click
			(
				View Record
			)
			on right click
			(
				Edit
				Delete
				Duplicate
				View Record
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Name
					Email
					Number_of_Registrations as "Number of Registrations"
					Country
					Company_Name as "Company Name"
					Added_Time as "Added Time"
				)
			)
		)
		menu
		(
			header
