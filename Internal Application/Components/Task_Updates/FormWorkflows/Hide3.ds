Hide3 as "Hide"
{
	type = form
	form = Task_Updates
	record event = on edit

	on load
	{
		actions
		{
			custom deluge script
			(
				// hide Updates.Date_field;
				// hide Updates.Assigned_To;
				// disable Updates.Event_Tasks;
				// disable Updates.Task_Name;
				// disable Updates.Remaining_Hours;
				// hide Updates.Event_Tasks;
				// hide Updates.Task_Name;
				// disable Updates.Event_Task;
				// disable Updates.Task_Name1;
				// disable Updates.Status;
				for each rec in input.Updates
				{
					rec.Event_Task=rec.Event_Tasks.Event_Name_Lookup;
					rec.Task_Name1=rec.Task_Name.Task_Name;
				}
			)
		}
	}
}