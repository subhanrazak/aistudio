One_Day_After_submission as "One Day After submission"
{
	type = form
	form = Task_Updates
	record event = on add or edit

	on user input of Date_field
	{
		actions
		{
			custom deluge script
			(
				previousday = zoho.currentdate.subBusinessDay(1);
				//alert previousday ;
				if(input.Date_field != previousday && input.Date_field != zoho.currentdate)
				{
					alert "You can only update current day and previous day";
					input.Date_field = zoho.currentdate;
				}
			)
		}
	}
}