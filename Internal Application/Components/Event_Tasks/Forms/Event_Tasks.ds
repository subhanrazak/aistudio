form Event_Tasks
{
	displayname = "Event Tasks"
	success message = "Event Task Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Product
	(
		type = picklist
		values = Products.ID
		displayformat = [Product_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		description
		[
			type = tooltip
			message = "For non-product specific choose DX training"
		]
		row = 1
		column = 1
		width = medium
	)
	Event
	(
		type = picklist
		values = Events[Event_Status == "Open"].ID
		displayformat = [Event_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Event_Name_Lookup
	(
		type = text
		displayname = "Event Name (Lookup)"
		row = 1
		column = 1
		width = medium
	)
	Date_of_assign
	(
		type = date
		displayname = "Date of assign"
		alloweddays = 0,1,2,3,4,5,6
		row = 1
		column = 1
		width = medium
	)
	Total_Hours_assigned
	(
		type = decimal
		displayname = "Total Hours assigned"
		description
		[
			type = tooltip
			message = "For Ticket and Adhoc works define a higher value like 1000."
		]
		row = 1
		column = 1
		width = medium
	)
	Remaining_Hours
	(
		type = decimal
		displayname = "Remaining Hours"
		description
		[
			type = tooltip
			message = "Keeps updating automatically"
		]
		row = 1
		column = 1
		width = medium
	)
	Tasks_Section
	(
		type = section
		displayname = "Tasks"
		visibility = false
		row = 2
		column = 1
		width = medium
	)
	Tasks
	(
		type = grid
		values = Multiple_tasks_subform.ID
		bidirectional = Event_Tasks
		row = 2
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}