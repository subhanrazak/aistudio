list Event_task_2026
{
	displayName = "Event task 2026"
	show all rows from Event_Tasks [Event.Month_and_year.contains("2026") || Event_Name_Lookup.contains("2026")]
	(
		Product
		Event
		Event.Month_and_year as "Month and year"
		Tasks
		(
			field = Tasks.Task_Name1 + "-" + Tasks.Assigned_To
		)
		Event.Event_Status as "Event Status"
	)
	group by
	(
		Event.Month_and_year custom
	)
	sort by
	(
		Event.Month_and_year custom
	)
	conditional formatting
	(
		"Zoho Creator"
		{
			condition = (Product.Product_Name == "Zoho Creator")
			fields = [Product]
			format = "color:#398ef3;"
		}
		"Zoho Deluge"
		{
			condition = (Product.Product_Name == "Zoho Deluge")
			fields = [Product]
			format = "color:#5dc35a;"
		}
		"Zoho RPA"
		{
			condition = (Product.Product_Name == "Zoho RPA")
			fields = [Product]
			format = "color:#16d0ef;"
		}
		"Zoho QEngine"
		{
			condition = (Product.Product_Name == "Zoho QEngine")
			fields = [Product]
			format = "color:#efb116;"
		}
		"Zoho Flow"
		{
			condition = (Product.Product_Name == "Zoho Flow")
			fields = [Product]
			format = "color:#c516ef;"
		}
		"DX Training"
		{
			condition = (Product.Product_Name == "DX Training")
			fields = [Product]
			format = "color:#ef166f;"
		}
	)
}