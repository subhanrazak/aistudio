		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Product
					Event
					Date_of_assign as "Date of assign"
					Total_Hours_assigned as "Total Hours assigned"
					Remaining_Hours as "Remaining Hours"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
			)
		)
