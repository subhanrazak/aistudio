form Source_wise_Registrations
{
	displayname = "Source-wise Registrations"
	success message = "Source-wise Registration Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Event
	(
		type = picklist
		values = Post_Event_Stats.ID
		bidirectional = Source_wise_Registrants_details
		displayformat = [Event_Name_Lookup]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Region
	(
		type = picklist
		maxchar = 100
		values = {"APACandANZ","EMEA","Americas","APACandEMEA"}
		row = 1
		column = 1
		width = medium
	)
	Source_Name
	(
		type = picklist
		displayname = "Source Name"
		maxchar = 100
		values = {"Banner","CliqGroup","Community","Connect Post","CreatorCustomersEmailInvite","CreatorPotentialsEmailInvite","Deskticket","Emailinvite","Events","Followupemail","FromSessions","Internal","Others","MEATeam","Newsletter","SMPost","TrainingWebsite"}
		sortorder = ascending
		others option = true
		row = 1
		column = 1
		width = medium
	)
	Registration
	(
		type = number
		row = 1
		column = 1
		width = medium
	)
	Attendee
	(
		type = number
		row = 1
		column = 1
		width = medium
	)
	plain
	(
		type = plaintext
		value = "<div>\n Check this <a href=\"https://sheet.zoho.com/sheet/open/lu7t8b9f413d69977417e94349c060eb1e283?sheetid=0&amp;range=A3\" target=\"_blank\" style=\"color: rgb(0, 0, 238)\" rel=\"noopener noreferrer\">sheet</a> for source grouping.\n <br>\n</div>"
		row = 1
		column = 2
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
