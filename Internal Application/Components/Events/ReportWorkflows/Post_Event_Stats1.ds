Post_Event_Stats1 as "Post Event Stats"
{
	type = functions
	form = Events
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				openUrl("#Form:Post_Event_Stats?Product_Name=" + input.Product + "&Event_Name=" + input.ID + "&Event_Type=" + input.Event_Type,"popup window","height=80%,width=80%");
			)
		}
	}
}