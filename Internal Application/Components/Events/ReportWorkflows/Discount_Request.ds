Discount_Request as "Discount Request"
{
	type = functions
	form = Events
	execution type = for each record

	on start
	{
		actions
		{
			on click
			(
				openUrl("#Form:Discounts_Request?Product=" + input.Product + "&Event=" + input.ID + "&Event_Type=" + input.Event_Type,"popup window","height=80%,width=80%");
			)
		}
	}
}