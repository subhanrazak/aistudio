Start_Date_On_User_Input as "Start Date On User Input"
{
	type = form
	form = Events
	record event = on add or edit

	on user input of Start_Date
	{
		actions
		{
			custom deluge script
			(
				if(input.Start_Date != null)
				{
					month_number = input.Start_Date.getMonth();
					month_name_map = {"1":"January","2":"February","3":"March","4":"April","5":"May","6":"June","7":"July","8":"August","9":"September","10":"October","11":"November","12":"December"};
					month_name = month_name_map.get(month_number.toString());
					year_name = input.Start_Date.getYear();
					input.Month_and_year = month_name + " " + year_name;
				}
			)
		}
	}
}