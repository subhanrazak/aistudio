Hide_fields as "Hide fields"
{
	type = form
	form = Events
	record event = on add

	field rules
	{
		actions (Event_Type == "Certification" || Event_Type == "Certification")
		{
			hide DRI2,Time,Mode_of_Training;
		}
		actions (Event_Type == "Online Training")
		{
			show Online_Training_Survey;
		}
	}
}