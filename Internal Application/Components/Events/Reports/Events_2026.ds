list Events_2026
{
	displayName = "Events 2026"
	show all rows from Events [Month_and_year.contains("2026")]
	(
		Product
		Event_Name as "Event Name"
		Event_Type as "Event Type"
		Mode_of_Training as "Mode of Training"
		Month_and_year as "Month and year"
		Start_Date as "Start Date"
		End_Date as "End Date"
		Start_Time as "Start Time"
		End_Time as "End Time"
		DRI
		DRI_ID as "DRI ID"
		Event_Status as "Event Status"
		Survey_Request as "Survey Request"
		Survey
		Survey_Report as "Survey Report"
	)
	group by
	(
		Month_and_year ascending
	)
	conditional formatting
	(
		"New Formatting"
		{
			condition = (Event_Status == "Completed")
			fields = [Event_Status]
			format = "color:#000000;background-color:#1bbc9b;"
		}
		"New Formatting"
		{
			condition = (Event_Status == "InProgress")
			fields = [Event_Status]
			format = "color:#ffffff;background-color:#765f89;"
		}
		"New Formatting"
		{
			condition = (Event_Status == "Open")
			fields = [Event_Status]
			format = "color:#333;background-color:#f1c40f;"
		}
		"New Formatting"
		{
			condition = (Event_Status == "Cancelled")
			fields = [Event_Status]
			format = "color:#ffffff;background-color:#e84c3d;"
		}
	)
}