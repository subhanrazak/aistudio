list Upcoming_Events_30_Days
{
	displayName = "Upcoming Events 30 Days"
	show all rows from Events [Start_Date >= zoho.currentdate && Start_Date <= zoho.currentdate.addDay(30)]
	(
		Product
		Event_Name as "Event Name"
		Event_Type as "Event Type"
		Mode_of_Training as "Mode of Training"
		Start_Date as "Start Date"
		End_Date as "End Date"
		Start_Time as "Start Time"
		End_Time as "End Time"
		DRI
		Event_Status as "Event Status"
		Survey_Request as "Survey Request"
	)
	sort by
	(
		Start_Date ascending
		Start_Time ascending
	)
}