list Events_Needing_Task_Plan
{
	displayName = "Events Needing Task Plan"
	show all rows from Events [Event_Status == "Open" || Event_Status == "InProgress" || Event_Status == "Tentative"]
	(
		Product
		Event_Name as "Event Name"
		Event_Type as "Event Type"
		Start_Date as "Start Date"
		End_Date as "End Date"
		DRI
		Event_Status as "Event Status"
	)
	sort by
	(
		Start_Date ascending
	)
}