report All_Events
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Product
					Event_Name as "Event Name"
					Event_Status as "Event Status"
					Event_Type as "Event Type"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
			record
			(
				Edit
				Duplicate
				Delete
				"Post Event Stats"
				"Discount Request"
				"Add Request Survey"
			)
		)
		action
		(
			on tap
			(
				View Record
			)
			on long press
			(
				Edit
				Delete
				Duplicate
				View Record
				"Post Event Stats"
				"Discount Request"
				"Add Request Survey"
			)
			on left swipe
			(
				Delete
			)
			on right swipe
			(
				Edit
			)
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Product
					Event_Name as "Event Name"
					Event_Type as "Event Type"
					Mode_of_Training as "Mode of Training"
					Start_Date as "Start Date"
					End_Date as "End Date"
					DRI
					Event_Status as "Event Status"
				)
			)
		)
		menu
		(
			header
			(
				Edit
				Duplicate
				Delete
			)
		)
	)
}