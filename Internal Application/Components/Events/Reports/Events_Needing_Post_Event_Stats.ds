list Events_Needing_Post_Event_Stats
{
	displayName = "Events Needing Post Event Stats"
	show all rows from Events [Event_Status == "Completed"]
	(
		Product
		Event_Name as "Event Name"
		Event_Type as "Event Type"
		Start_Date as "Start Date"
		End_Date as "End Date"
		DRI
		Event_Status as "Event Status"
	)
	sort by
	(
		Start_Date descending
	)
}