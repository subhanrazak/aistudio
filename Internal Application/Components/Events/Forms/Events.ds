form Events
{
	success message = "Event Added Successfully"
	Event
	(
		type = section
		displayname = "Event "
		visibility = true
		row = 1
		column = 0
		width = medium
	)
	Product
	(
		type = picklist
		values = Products.ID
		displayformat = [Product_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		description
		[
			type = help_text
			message = "For Adhoc - choose product DX Training"
		]
		row = 1
		column = 1
		width = medium
	)
	Event_Name
	(
		type = text
		displayname = "Event Name"
		description
		[
			type = help_text
			message = "Check whether 'Event Name' already exist before creating.\n\nExample :\nLearning Table Series - January - 2025\nOnline Training - Stage1 - APAC - 2025\nJanuary 2025 - Tickets\nJanuary 2025 - Adhoc works\nJanuary 2025 - Associate Developer Certification"
		]
		row = 1
		column = 1
		width = medium
	)
	Event_Type
	(
		type = picklist
		displayname = "Event Type"
		maxchar = 100
		values = {"Webinar","Online Training","In-person Training","Certification","Adhoc"}
		others option = true
		description
		[
			type = help_text
			message = "For Ticket and Adhoc - choose type as adhoc"
		]
		row = 1
		column = 1
		width = medium
	)
	Mode_of_Training
	(
		type = radiobuttons
		displayname = "Mode of Training"
		maxchar = 100
		values = {"Online","Offline"}
		row = 1
		column = 1
		width = medium
	)
	must have Month_and_year
	(
		type = text
		displayname = "Month and year"
		row = 1
		column = 1
		width = medium
	)
	Time
	(
		type = section
		visibility = true
		row = 2
		column = 0
		width = medium
	)
	Start_Date
	(
		type = date
		displayname = "Start Date"
		alloweddays = 0,1,2,3,4,5,6
		row = 2
		column = 1
		width = medium
	)
	End_Date
	(
		type = date
		displayname = "End Date"
		alloweddays = 0,1,2,3,4,5,6
		row = 2
		column = 1
		width = medium
	)
	Start_Time
	(
		type = time
		displayname = "Start Time"
		timedisplayoptions = "hh:mm:ss"
		description
		[
			type = tooltip
			message = "Example :\nWebinars - APAC start - 11.00 am"
		]
		row = 2
		column = 2
		width = medium
	)
	End_Time
	(
		type = time
		displayname = "End Time"
		timedisplayoptions = "hh:mm:ss"
		description
		[
			type = tooltip
			message = "Example :\nWebinars - Americas end - 10.00 pm"
		]
		row = 2
		column = 2
		width = medium
	)
	DRI2
	(
		type = section
		displayname = "DRI"
		visibility = true
		row = 3
		column = 0
		width = medium
	)
	DRI
	(
		type = picklist
		values = Team_Members.ID
		displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 3
		column = 1
		width = medium
	)
	DRI_ID
	(
		type = number
		displayname = "DRI ID"
		maxchar = 19
		row = 3
		column = 1
		width = medium
	)
	Event_Status
	(
		type = picklist
		displayname = "Event Status"
		maxchar = 100
		values = {"Open","InProgress","Completed","Cancelled","OnHold","Tentative"}
		initial value = "Open"
		row = 3
		column = 1
		width = medium
	)
	Online_Training_Survey
	(
		type = section
		displayname = "Online Training - Survey"
		visibility = true
		row = 4
		column = 0
		width = medium
	)
	Survey_Request
	(
		type = picklist
		displayname = "Survey Request"
		maxchar = 100
		values = {"Requested","Added","Yet to request"}
		initial value = "Yet to request"
		row = 4
		column = 1
		width = medium
	)
	Survey
	(
		type = url
		enable linkname
		row = 4
		column = 1
		width = medium
	)
	Survey_Report
	(
		type = url
		displayname = "Survey Report"
		enable linkname
		row = 4
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}