form QR_Code_Generator
{
	displayname = "QR Code Generator"
	success message = "Qr Code Generator Added Successfully"
	Section
	(
		type = section
		row = 1
		column = 0
		width = medium
	)
	Event
	(
		type = picklist	
		values  = Events.ID
		displayformat = [Event_Name]
		allow new entries
		[
			displayname = "Add New"
		]
		sortorder = ascending
		row = 1
		column = 1
		width = medium
	)
	Session_URl
	(
		type = text
		displayname = "Session URl"
		row = 1
		column = 1
		width = medium
	)
	QR_Code
	(
		type = qrcode
		displayname = "QR Code"
		value = "${Session_URl}"
		row = 1
		column = 1
		width = medium
	)

	actions
	{
		on add
		{
			submit
			(
				type = submit
				displayname = "Submit"
			)
			reset
			(
				type = reset
				displayname = "Reset"
			)
		}
		on edit
		{
			update
			(
				type = submit
				displayname = "Update"
			)
			cancel
			(
				type = cancel
				displayname = "Cancel"
			)
		}
	}
}
