Field_Rules_On_Always as "Field Rules On Always"
{

				type =  form
				form = Role

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Approval_Limit_From,Approval_Limit_To,Is_Deleted;
					}
					actions  (Permission_Set == "Approver")
					{
						show Approval_Limit_From,Approval_Limit_To;
					}
				}

			
}