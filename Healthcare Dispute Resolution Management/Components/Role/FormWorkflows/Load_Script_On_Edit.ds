Load_Script_On_Edit as "Load Script On Edit"
{

				type =  form
				form = Role

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											currentRole = input.Role;
										roleList = {"Patient Service Executive","Billing Analyst","Managed Care Analyst","Senior Billing Analyst","Revenue Cycle Manager","Revenue Cycle Director","System Administrator"};
										addedRoleList = Role[ID != null && ID != input.ID].Role.getAll();
										roleList.removeAll(addedRoleList);
										input.Role:ui.add(roleList);
										input.Role = currentRole;
						)
					}
				}

			
}