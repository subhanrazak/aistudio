form Role
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Role
			(
				type = picklist
				maxchar = 100
				values = {"Patient Service Executive","Billing Analyst","Managed Care Analyst","Senior Billing Analyst","Revenue Cycle Manager","Revenue Cycle Director","System Administrator"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Permission_Set
			(
				type = picklist
				displayname = "Permission Set"
				maxchar = 100
				values = {"Administrator","Approver","Investigator","Service Executive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Limit_From
			(
				displayname = "Approval Limit From"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Limit_To
			(
				displayname = "Approval Limit To"
				type = INR
				format = commadotindian
    			description
    			[
    				type = help_text
    			 	message = "Leave blank for an open-ended (unlimited) top tier."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Deleted
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}