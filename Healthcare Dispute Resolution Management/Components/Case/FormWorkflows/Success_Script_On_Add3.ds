Success_Script_On_Add3 as "Success Script On Add"
{

				type =  form
				form = Case

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.Case_ID = idConfig.Case_ID + " " + input.Auto_Number;
						)
					}
				}

			
}