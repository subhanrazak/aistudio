default list SLA_Matrices
{

			displayName = "SLA Matrices"
			show all rows from SLA_Matrix
			(
				Priority
				Investigation_and_Resolution_SLA_days as "Investigation and Resolution SLA (days)"
				Resolution_Approval_SLA_days as "Resolution Approval SLA (days)"
			)
			conditional formatting
			(
				"Critical"
				{
					condition = (Priority == "Critical")
					fields = [Priority]
					format = "color:#e64d3b;"
				}
				"High"
				{
					condition = (Priority == "High")
					fields = [Priority]
					format = "color:#e77f06;"
				}
				"Medium"
				{
					condition = (Priority == "Medium")
					fields = [Priority]
					format = "color:#f1c50e;"
				}
				"Low"
				{
					condition = (Priority == "Low")
					fields = [Priority]
					format = "color:#398ef3;"
				}
			)
		
}