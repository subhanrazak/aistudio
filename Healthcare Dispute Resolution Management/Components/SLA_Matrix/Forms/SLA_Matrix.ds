form SLA_Matrix
{

			displayname = "SLA Matrix"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Priority
			(
				type = picklist
				maxchar = 100
				values = {"Critical","High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Investigation_and_Resolution_SLA_days
			(
				type = number
				displayname = "Investigation and Resolution SLA (days)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resolution_Approval_SLA_days
			(
				type = number
				displayname = "Resolution Approval SLA (days)"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}