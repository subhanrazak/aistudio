form Assign_Dispute
{

			displayname = "Assign Dispute"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Assigned_To
			(
				type = picklist	
				displayname = "Assigned To"
				values  = User.ID
    			displayformat = [" " + User_ID + " " + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Dispute
			(
				type = picklist	
				values  = Dispute_Intake.ID
    			displayformat = [Dispute_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Investigation_Resolution
			(
				type = picklist	
				displayname = "Investigation Resolution"
				values  = Investigation_Resolution.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Action_field
			(
				type = picklist
				displayname = "Action"
				maxchar = 100
				values = {"Assign_Dispute","Reassign"}
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}