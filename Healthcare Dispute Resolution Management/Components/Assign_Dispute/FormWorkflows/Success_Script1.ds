Success_Script1 as "Success Script"
{

				type =  form
				form = Assign_Dispute
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						if(input.Dispute != null && Action_field.equalsIgnoreCase("Assign_Dispute"))
										{
											disputeRec = Dispute_Intake[ID == input.Dispute];
											disputeRec.Assigned_To=input.Assigned_To;
										}
										else if(input.Investigation_Resolution != null && Action_field.equalsIgnoreCase("Reassign"))
										{
											resolutionRec = Investigation_Resolution[ID == input.Investigation_Resolution];
											resolutionRec.Approver=input.Assigned_To;
										}
					)
					}
				}
			
}