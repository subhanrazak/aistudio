form Disputed_Charge_Line
{

			displayname = "Disputed Charge Line"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Dispute
			(
				type = picklist	
				values  = Dispute_Intake.ID
    			bidirectional = Disputed_Charge_Line
    			displayformat = [Dispute_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Charge
			(
				type = picklist	
				values  = Charge.ID
    			displayformat = [Charge_ID + " - " + Service_Date]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			CPT_Code
			(
    			type = text
				displayname = "CPT Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Billed_Line_Amount
			(
				displayname = "Billed Line Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Disputed_Line_Amount
			(
				displayname = "Disputed Line Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Reason
			(
				type = picklist
				displayname = "Line Reason"
				maxchar = 100
				values = {"Duplicate","Wrong amount","Service not received","Coding"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}