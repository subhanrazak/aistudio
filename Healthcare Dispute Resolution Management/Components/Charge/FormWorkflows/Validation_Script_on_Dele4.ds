Validation_Script_on_Dele4 as "Validation Script on Delete"
{

				type =  form
				form = Charge

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											disputedChargeRecCount = Disputed_Charge_Line[Charge == input.ID].count();
										if(disputedChargeRecCount > 0)
										{
											alert disputedChargeRecCount + " dispute record(s) are linked to this charge.";
											cancel delete;
										}
						)
					}
				}

			
}