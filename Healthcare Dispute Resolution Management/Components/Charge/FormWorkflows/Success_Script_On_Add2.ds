Success_Script_On_Add2 as "Success Script On Add"
{

				type =  form
				form = Charge

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Charge_Status == null)
										{
											input.Charge_Status = "Billed";
										}
										idConfig = ID_Configuration[ID != 0];
										input.Charge_ID = idConfig.Charge_ID + " " + input.Auto_Number;
						)
					}
				}

			
}