report My_Communication_Logs
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Dispute
					Contact_Person as "Contact Person"
					Time
					Channel
					Logged_By as "Logged By"
				)
			)
		)
		menu
		(
			header ( Edit Delete )
			record ( Edit Delete )
		)
		action
		(
			on tap ( View Record )
			on long press ( Edit Delete View Record )
			on left swipe ( Delete )
			on right swipe ( Edit )
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Dispute
					Time
					Channel
					Contact_Person as "Contact Person"
					Summary
					Follow_Up_Required as "Follow-Up Required"
					Follow_Up_Date as "Follow-Up Date"
					Logged_By as "Logged By"
				)
			)
		)
		menu
		(
			header ( Edit Delete )
		)
	)
}