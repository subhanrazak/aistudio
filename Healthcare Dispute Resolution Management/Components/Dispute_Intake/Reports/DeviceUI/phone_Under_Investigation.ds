report Under_Investigation
{
	quickview
	(
		layout
		(
			type = -1
			datablock1
			(
				layout type = -1
				fields
				(
					Dispute_ID as "Dispute ID"
					Patient
					Category
					Disputed_Amount as "Disputed Amount"
					Priority
					Status
				)
			)
		)
		menu
		(
			header ( Edit Delete )
			record ( Edit Delete )
		)
		action
		(
			on tap ( View Record )
			on long press ( Edit Delete View Record )
			on left swipe ( Delete )
			on right swipe ( Edit )
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Dispute_ID as "Dispute ID"
					Patient
					Case
					Disputed_Amount as "Disputed Amount"
					Category
					Sub_Category as "Sub-Category"
					Priority
					Status
					Investigation_Due_Date as "Investigation Due Date"
					AI_Dispute_Summary as "Dispute Summary"
				)
			)
		)
		menu
		(
			header ( Edit Delete )
		)
	)
}