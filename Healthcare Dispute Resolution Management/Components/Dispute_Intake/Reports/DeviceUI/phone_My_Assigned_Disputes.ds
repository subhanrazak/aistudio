report My_Assigned_Disputes
{

				quickview
				(
					layout
					(
		 				type = Custom
		 				selectedlayout = "Custom Layout 1"
					)
						menu
						(
							header
							(
							)
						)
    				action
    				(
						on tap
						(
							View Record   	   
    					)
						on long press
						(
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Dispute_ID as "Dispute ID"
								AI_Dispute_Summary as "Dispute Summary"
								Patient.Added_Time as "Added Time"
							)
						)
						datablock4
						(
		     				title = "Case Information"
							fields
							(
								Patient
								Case
								Insurance_Payer as "Insurance Payer"
								Total_Billed_Amount as "Total Billed Amount"
								Patient_Share as "Patient Share"
							)
						)
						datablock5
						(
		     				title = "Dispute Details"
							fields
							(
								Disputed_Amount as "Disputed Amount"
								Reason_for_Dispute as "Reason for Dispute"
								Dispute_Source as "Dispute Source"
								Email
								Supporting_Documents as "Supporting Documents"
							)
						)
						datablock7
						(
		     				title = "Classification"
							fields
							(
								Category
								Sub_Category as "Sub-Category"
							)
						)
						datablock8
						(
		     				title = "Disputed Charge Line"
		     				related field = Disputed_Charge_Line
							fields
							(
								Charge
								CPT_Code as "CPT Code"
								Billed_Line_Amount as "Billed Line Amount"
								Disputed_Line_Amount as "Disputed Line Amount"
								Line_Reason as "Line Reason"
							)
						)
						datablock6
						(
		     				title = "SLA & Status"
							fields
							(
								Status
								Priority
								Investigation_Due_Date as "Investigation Due Date"
								Investigation_Start_Time as "Investigation Start Time"
							)
						)
						datablock9
						(
		     				title = "Assignment & Audit Trail"
							fields
							(
								Assigned_Role as "Assigned Role"
								Assigned_To as "Assigned To"
								Approver
								Created_By_Type as "Created By Type"
								Created_By_User as "Created By User"
								Closed_By_User as "Closed By User"
							)
						)
						datablock10
						(
		     				title = "Investigation Resolution"
		     				related field = Investigation_Resolution[Dispute.Investigation_Resolution is not null]
							fields
							(
								Resolution_ID as "Resolution ID"
								Resolution_Type as "Resolution Type"
								Approval_Status as "Approval Status"
								Root_Cause as "Root Cause"
								Adjustment_Amount as "Adjustment Amount"
								Resolution_Approval_Due_Date as "Resolution Approval Due Date"
								Findings
								Resolution_Rationale as "Resolution Rationale"
								Approver_Comments as "Approver Comments"
								Internal_Notes as "Internal Notes"
							)
						)
						datablock11
						(
		     				title = "Communication Log"
		     				related field = Communication_Log[Dispute.Communication_Log is not null]
							fields
							(
								Time
								Channel
								Contact_Person as "Contact Person"
								Summary
								Follow_Up_Required as "Follow-Up Required"
								Follow_Up_Date as "Follow-Up Date"
								Logged_By as "Logged By"
							)
						)
					)
						menu
						(
							header
							(
							)
						)
				)
			
}