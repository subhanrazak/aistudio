Load_Script_On_Edit1 as "Load Script On Edit"
{

				type =  form
				form = Dispute_Intake

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											currentSubCategory = input.Sub_Category;
										clear Sub_Category;
										input.Sub_Category:ui.add(input.Category.Sub_Category);
										input.Sub_Category = currentSubCategory;
						)
					}
				}

			
}