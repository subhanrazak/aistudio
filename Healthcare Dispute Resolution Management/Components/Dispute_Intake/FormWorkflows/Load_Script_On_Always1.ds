Load_Script_On_Always1 as "Load Script On Always"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Disputed_Charge_Line.CPT_Code;
										disable Disputed_Charge_Line.Billed_Line_Amount;
										disputeSourceList = {"Patient Call","Patient Letter","Email","Patient Portal","Internal Audit"};
										input.Dispute_Source:ui.add(disputeSourceList);
						)
					}
				}

			
}