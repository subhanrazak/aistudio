Load_Script_On_Always1 as "Load Script On Always"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
										// Subform child fields cannot be disabled directly from the parent form on-load workflow.
										disputeSourceList = {"Patient Call","Patient Letter","Email","Patient Portal","Internal Audit"};
										input.Dispute_Source:ui.add(disputeSourceList);
						)
					}
				}

			
}