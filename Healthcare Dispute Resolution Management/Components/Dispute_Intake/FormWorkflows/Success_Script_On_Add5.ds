Success_Script_On_Add5 as "Success Script On Add"
{

				type =  form
				form = Dispute_Intake

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.Dispute_ID = idConfig.Dispute_ID + " " + input.Auto_Number;
										userEmailList = User[Role == input.Assigned_Role].Email.getAll();
										for each userEmail in userEmailList
										{
											responseMessage = zoho.pushNotification(userEmail,"New Dispute Awaiting Investigation — " + input.Dispute_ID,"A new dispute " + input.Dispute_ID + " has been submitted and is pending investigation. Please pick it up and start your investigation.","Unassigned_Disputes",input.ID);
										}
						)
					}
				}

			
}