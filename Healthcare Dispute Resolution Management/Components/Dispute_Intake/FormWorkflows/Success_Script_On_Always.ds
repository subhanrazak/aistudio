Success_Script_On_Always as "Success Script On Always"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Admin_Role = Role[Permission_Set == "Administrator"].ID.getAll();
										thisapp.aiFeature.generateAIDisputeBrief(input.ID);
						)
					}
				}

			
}