Field_Rules_On_Always6 as "Field Rules On Always"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden,Email,Accept_Zia_s_Suggestion,Ask_Zia,Zia_Category,Zia_Classification_Response,Zia_Classification_Status,Zia_Sub_Category,Zia_Result,Communication_Log;
						disable Patient_Name,Patient_Share,Insurance_Payer,Total_Billed_Amount;
					}
					actions  (Dispute_Source == "Email" || Dispute_Source == "Chat Agent")
					{
						show Email;
					}
				}

			
}