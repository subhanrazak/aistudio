Field_Script_Reason as "Field Script - Reason"
{

				type =  form
				form = Dispute_Intake

				record event = on add

				on user input of Reason_for_Dispute
				{
					actions 
					{
						custom deluge script
						(
											if(input.Reason_for_Dispute != null || input.Reason_for_Dispute != "")
										{
											show Ask_Zia;
										}
										else
										{
											hide Ask_Zia;
										}
						)
					}
				}

			
}