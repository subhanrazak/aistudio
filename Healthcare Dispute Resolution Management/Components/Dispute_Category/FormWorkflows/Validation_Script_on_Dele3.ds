Validation_Script_on_Dele3 as "Validation Script on Delete"
{

				type =  form
				form = Dispute_Category

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											disputeRecCount = Dispute_Intake[Category == input.ID].count();
										if(disputeRecCount > 0)
										{
											alert disputeRecCount + " record(s) are linked to this Category. Before deleting this Sub-Category, kindly ensure that the associated Dispute(s) are updated.";
											cancel delete;
										}
						)
					}
				}

			
}