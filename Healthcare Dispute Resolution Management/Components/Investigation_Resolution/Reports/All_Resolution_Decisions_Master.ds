default list All_Resolution_Decisions_Master
{

			displayName = "All Resolution Decisions Master"
			show all rows from Investigation_Resolution    
			(
				Dispute
				Resolution_Type as "Resolution Type"
				Adjustment_Amount as "Adjustment Amount"
				Resolution_Rationale as "Resolution Rationale"
				Root_Cause as "Root Cause"
				Approval_Status as "Approval Status"
				Resolution_ID as "Resolution ID"
				Approver
				Findings
				Supporting_Evidence as "Supporting Evidence"
				Internal_Notes as "Internal Notes"
				Patient_Contacted as "Patient Contacted"
				Patient_Contact_Date as "Patient Contact Date"
				Charge_Verified as "Charge Verified"
				Patient_Contact_Summary as "Patient Contact Summary"
				Root_Cause_Detail as "Root Cause Detail"
				Resolution_Approval_Due_Date as "Resolution Approval Due Date"
				Approver_Comments as "Approver Comments"
				Created_By as "Created By"
				Approval_Time as "Approval Time"
				Resolution_Days
			)
		
}