			)
		)
		menu
		(
			header ( Edit Delete )
			record ( Edit Delete )
		)
		action
		(
			on click ( View Record )
			on right click ( Edit Delete View Record )
		)
	)
	detailview
	(
		layout
		(
			type = 1
			datablock1
			(
				layout type = -2
				fields
				(
					Resolution_ID as "Resolution ID"
