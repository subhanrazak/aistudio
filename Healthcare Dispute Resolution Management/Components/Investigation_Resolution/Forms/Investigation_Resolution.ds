form Investigation_Resolution
{

			displayname = "Investigation Resolution"
			success message = "Data Added Successfully!"
			Investigation_Notes
			(
				type = section
				displayname = "Investigation Notes"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Dispute
			(
				type = picklist	
				values  = Dispute_Intake.ID
    			bidirectional = Investigation_Resolution
    			displayformat = [Dispute_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Findings
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Charge_Verified
			(
				type = picklist
				displayname = "Charge Verified"
				maxchar = 100
				values = {"Charge Confirmed Correct","Charge Error Identified","Partially Verified","Unable to Verify","Requires Additional Documentation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internal_Notes
			(
    			type = textarea
				displayname = "Internal Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Contacted
			(
				type = radiobuttons
				displayname = "Patient Contacted"
				maxchar = 100
				values = {"Yes","No"}
				initial value = "No"
				layout = 2
	 			row = 1
	 			column = 2   
				width = medium
			)
			Patient_Contact_Date
			(
    			type = date
				displayname = "Patient Contact Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Patient_Contact_Summary
			(
    			type = textarea
				displayname = "Patient Contact Summary"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Supporting_Evidence
			(
    			type = upload file
				displayname = "Supporting Evidence"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 2   
				width = medium
			)
			Resolution_Decision
			(
				type = section
				displayname = "Resolution Decision"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Resolution_Type
			(
				type = picklist
				displayname = "Resolution Type"
				maxchar = 100
				values = {"Full Adjustment","Partial Adjustment","Denied","Payment Plan","Write-Off"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Adjustment_Amount
			(
				displayname = "Adjustment Amount"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Resolution_Rationale
			(
    			type = textarea
				displayname = "Resolution Rationale"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Root_Cause
			(
				type = picklist	
				displayname = "Root Cause"
				values  = Root_Cause.ID
    			displayformat = [Root_Cause]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Root_Cause_Detail
			(
    			type = textarea
				displayname = "Root Cause Detail"
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			Created_By
			(
				type = picklist	
				displayname = "Created By"
				values  = User.ID
    			displayformat = [User_ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Admin_Role
			(
				type = list	
				displayname = "Admin Role"
				values  = Role.ID
    			displayformat = [Role]
				sortorder = ascending
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approver_Role
			(
				type = picklist	
				displayname = "Approver Role"
				values  = Role.ID
    			displayformat = [Role]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approver
			(
				type = picklist	
				values  = User[Is_Deleted == false].ID
    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Resolution_Approval_Due_Date
			(
    			type = date
				displayname = "Resolution Approval Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending","Approved","Rejected","Returned"}
				initial value = "Pending"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approver_Comments
			(
    			type = textarea
				displayname = "Approver Comments"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Approval_Time
			(
    			type = datetime
				displayname = "Approval Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			unique Resolution_ID
			(
    			type = text
				displayname = "Resolution ID"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Resolution_Days
			(
				type = number
	 			row = 3
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  daysBetween(input.Dispute.Added_Time,input.Approval_Time)
    						visibility = false
    			)
			)
			Resubmitted_After_Rework
			(
    			type = checkbox
				displayname = "Resubmitted After Rework?"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}