Success_Script_On_Add6 as "Success Script On Add"
{

				type =  form
				form = Investigation_Resolution

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.Resolution_ID = idConfig.Resolution_ID + " " + input.Auto_Number;
						)
					}
				}

			
}