Field_Script_Resolution_T1 as "Field Script - Resolution Type"
{

				type =  form
				form = Investigation_Resolution

				record event = on add or edit

				on user input of Resolution_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Resolution_Type.endsWithIgnoreCase("Full Adjustment"))
										{
											input.Adjustment_Amount = input.Dispute.Disputed_Amount;
										}
										else
										{
											input.Adjustment_Amount = 0;
										}
						)
					}
				}

			
}