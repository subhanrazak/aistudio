Validation_Script_on_Alwa4 as "Validation Script on Always"
{

				type =  form
				form = Investigation_Resolution

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Patient_Contacted == "No")
										{
											input.Patient_Contact_Date = null;
											input.Patient_Contact_Summary = "";
										}
						)
					}
				}

			
}