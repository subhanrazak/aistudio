form ID_Configuration
{

			displayname = "ID Configuration"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			helpText
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have User_ID
			(
    			type = text
				displayname = "User ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Patient_ID
			(
    			type = text
				displayname = "Patient ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case_ID
			(
    			type = text
				displayname = "Case ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Charge_ID
			(
    			type = text
				displayname = "Charge ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Insurance_Payer_ID
			(
    			type = text
				displayname = "Insurance Payer ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Dispute_ID
			(
    			type = text
				displayname = "Dispute ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resolution_ID
			(
    			type = text
				displayname = "Resolution ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		properties
		{
			total entries
			{
				allowed count = 1
			}
		}
		
}