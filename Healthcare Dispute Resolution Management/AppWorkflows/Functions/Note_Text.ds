string Styles.Note_Text()
{

                 	color_codes = thisapp.Styles.Color_Codes();
                 	style_txt = ".zc-cis-notes-wrapper ul { padding: 0px; margin: 0px; } .zc-cis-notes-wrapper ul li { list-style-type: none; } .zc-cis-notes-wrapper ul li p { padding: 8px 8px 0px; } .zc-cis-notes-wrapper p, .zc-cis-notes-wrapper span { font-size: 14px; font-weight: 400; line-height: 1.5; letter-spacing: 0.1px; } .zc-cis-notes-wrapper p { color: " + color_codes.get("zc-cis-primary-text-color") + "; } .zc-cis-notes-wrapper span { color: " + color_codes.get("zc-cis-secondary-text-color") + "; } .zc-cis-notes-wrapper ul li p:before { content: ''; width: 5px; height: 5px; border-radius: 50%; background-color: " + color_codes.get("zc-cis-secondary-text-color") + "; display: inline-block; vertical-align: top; margin: 8px; }";
                 	return style_txt;
                 
}