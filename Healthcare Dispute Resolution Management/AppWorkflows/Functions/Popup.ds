string Styles_Popup.Popup()
{

                 	color_codes = thisapp.Styles.Color_Codes();
                 	override_style = ".zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .formContainer { padding: 20px 30px; } .zcpopup.compact .popupbox-wrapper .popupbox.formWithinPopup .popupboxOuter .form-outer-wrapper form .zc-footer-wrapper .formbutton { padding: 16px; text-align: center; } .zcpopup .statelessFormWidth .form-action .zc-live-primary-btn { padding: 8px 20px; margin: 0px; } .zcpopup.compact .form-outer-wrapper form.form-table,  .zcpopup.compact .form-outer-wrapper form.form-table .zc-addnote-fld { width: 100%; } .zcpopup .form-group { margin-bottom: 0px; }";
                 	common_style = ".zc-asm-popup-content { padding: 20px; text-align: center; } .zc-asm-popup-content .zc-asm-icon-wrapper { width: 48px; height: 48px; border-radius: 50%; text-align: center; display: inline-block; vertical-align: top; } .zc-asm-popup-content .zc-asm-icon-wrapper i { font-size: 24px; line-height: 48px; font-style: normal; vertical-align: top; } .zc-asm-popup-content h4 { font-size: 18px; font-weight: 500; line-height: 1.3; letter-spacing: 0.1px; color: " + color_codes.get("zc-asm-primary-text-color") + "; margin: 16px 0px 12px; } .zc-asm-popup-content p { font-size: 14px; font-weight: 400; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-asm-primary-text-color") + "; }";
                 	style_txt = override_style + common_style;
                 	return style_txt;
                 
}