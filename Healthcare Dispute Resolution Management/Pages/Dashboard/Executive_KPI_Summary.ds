<panel elementName='Executive_KPI_Summary'>
	<pr width='fill' height='auto'>
		<pc width='20%' paddingRight='8px' hAlign='left' vAlign='middle'>
			<pr>
				<pc padding='16px' bgColor='#FFFFFF' borderColor='#E4EAF7' borderWidth='1px' width='100%' hAlign='left' vAlign='middle' cornerRadius='10px'>
					<pr>
						<pc width='74%' hAlign='left'>
							<text margin='0px' padding='0px' color='#1B2A4A' size='14px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Total Disputes'> </text>
						</pc>
						<pc width='26%' hAlign='right'>
							<image color='#1C5CFF' bgColor='#EEF3FF' width='34px' height='34px' type='icon' value='business-chart-bar-33' size='20px' cornerRadius='17px' iconType='outline' />
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='6px' padding='0px' color='#2B2F38' size='24px' bold='true' type='variable' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='${totalDisputes}'> </text>
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='4px' padding='0px' color='#606976' size='12px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Across all Queues'> </text>
						</pc>
					</pr>
				</pc>
			</pr>
		</pc>
		<pc width='20%' paddingLeft='2px' paddingRight='8px' hAlign='left' vAlign='middle'>
			<pr>
				<pc padding='16px' bgColor='#FFFFFF' borderColor='#E4EAF7' borderWidth='1px' width='100%' hAlign='left' vAlign='middle' cornerRadius='10px'>
					<pr>
						<pc width='74%' hAlign='left'>
							<text margin='0px' padding='0px' color='#1B2A4A' size='14px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Open Disputes'> </text>
						</pc>
						<pc width='26%' hAlign='right'>
							<image color='#0E9850' bgColor='#ECFBF2' width='34px' height='34px' type='icon' value='business-progress' size='20px' cornerRadius='17px' iconType='outline' />
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='6px' padding='0px' color='#2B2F38' size='24px' bold='true' type='variable' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='${openDisputes}'> </text>
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='4px' padding='0px' color='#606976' size='12px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Across all Queues'> </text>
						</pc>
					</pr>
				</pc>
			</pr>
		</pc>
		<pc width='20%' paddingLeft='2px' paddingRight='8px' hAlign='left' vAlign='middle'>
			<pr>
				<pc padding='16px' bgColor='#FFFFFF' borderColor='#E4EAF7' borderWidth='1px' width='100%' hAlign='left' vAlign='middle' cornerRadius='10px'>
					<pr>
						<pc width='74%' hAlign='left'>
							<text margin='0px' padding='0px' color='#1B2A4A' size='14px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='SLA Breaches'> </text>
						</pc>
						<pc width='26%' hAlign='right'>
							<image color='#DD2018' bgColor='#FFF0F0' width='34px' height='34px' type='icon' value='business-money-time' size='20px' cornerRadius='17px' iconType='outline' />
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='6px' padding='0px' color='#2B2F38' size='24px' bold='true' type='variable' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='${slaBreaches}'> </text>
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='4px' padding='0px' color='#606976' size='12px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Past due and open'> </text>
						</pc>
					</pr>
				</pc>
			</pr>
		</pc>
		<pc width='20%' paddingLeft='2px' paddingRight='8px' hAlign='left' vAlign='middle'>
			<pr>
				<pc padding='16px' bgColor='#FFFFFF' borderColor='#E4EAF7' borderWidth='1px' width='100%' hAlign='left' vAlign='middle' cornerRadius='10px'>
					<pr>
						<pc width='74%' hAlign='left'>
							<text margin='0px' padding='0px' color='#1B2A4A' size='14px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Pending Approvals'> </text>
						</pc>
						<pc width='26%' hAlign='right'>
							<image color='#F07818' bgColor='#FFF4EA' width='34px' height='34px' type='icon' value='business-signature' size='20px' cornerRadius='17px' iconType='outline' />
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='6px' padding='0px' color='#2B2F38' size='24px' bold='true' type='variable' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='${pendingApprovals}'> </text>
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='4px' padding='0px' color='#606976' size='12px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Resolution decisions'> </text>
						</pc>
					</pr>
				</pc>
			</pr>
		</pc>
		<pc width='20%' paddingLeft='2px' hAlign='left' vAlign='middle'>
			<pr>
				<pc padding='16px' bgColor='#FFFFFF' borderColor='#E4EAF7' borderWidth='1px' width='100%' hAlign='left' vAlign='middle' cornerRadius='10px'>
					<pr>
						<pc width='74%' hAlign='left'>
							<text margin='0px' padding='0px' color='#1B2A4A' size='14px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Avg Resolution Time'> </text>
						</pc>
						<pc width='26%' hAlign='right'>
							<image color='#6336B8' bgColor='#F4F0FF' width='34px' height='34px' type='icon' value='business-progress' size='20px' cornerRadius='17px' iconType='outline' />
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='6px' padding='0px' color='#2B2F38' size='24px' bold='true' type='variable' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='${avgResolutionLabel}'> </text>
						</pc>
					</pr>
					<pr>
						<pc hAlign='left'>
							<text marginTop='4px' padding='0px' color='#606976' size='12px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#FFFFFF' borderWidth='0px' value='Approved resolutions'> </text>
						</pc>
					</pr>
				</pc>
			</pr>
		</pc>
	</pr>
</panel>