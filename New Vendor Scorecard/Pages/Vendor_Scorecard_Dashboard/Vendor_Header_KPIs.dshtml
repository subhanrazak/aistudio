<style>
/* ZCS global utility subset included once for this page from zcs-global */
:root {
  --zcs-theme-brand-color: var(--zcs_brand_color);
  --zcs-light-bg-color: var(--zcs_brand_light_color);
  --zcs-page-bg-color: #F3F3F4;
  --zcs-primary-text-color: var(--zcs_primary_text_color);
  --zcs-secondary-text-color: var(--zcs_secondary_text_color);
  --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
  --zcs-border-color: var(--zcs_tertiary_border_color);
  --zcs-white-color: #FFFFFF;
  --zcs-black-color: #000000;
  --zcs-thead-color: #F9FAFE;
  --zcs-tr-h-color: #F9FAFE;
  --column-gap: 0px;
}
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-text-left { text-align: left; }
.zcs-text-center { text-align: center; }
.zcs-text-right { text-align: right; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-col-3 { flex: 0 0 calc(25% - var(--column-gap) * 0.75); max-width: calc(25% - var(--column-gap) * 0.75); }
.zcs-col-4 { flex: 0 0 calc(33.3333333333% - var(--column-gap) * 0.6666666667); max-width: calc(33.3333333333% - var(--column-gap) * 0.6666666667); }
.zcs-col-6 { flex: 0 0 calc(50% - var(--column-gap) * 0.5); max-width: calc(50% - var(--column-gap) * 0.5); }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
.zcs-gap-6 { gap: 0.375rem; --column-gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; --column-gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; --column-gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; --column-gap: 0.75rem; }
.zcs-gap-15 { gap: 0.9375rem; --column-gap: 0.9375rem; }
.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-15 { padding-left: 0.9375rem; padding-right: 0.9375rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-10 { margin-top: 0.625rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-rounded-xl { border-radius: 0.75rem; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }
.zcs-list-none { list-style-type: none; }
a { text-decoration: none; }
@media (max-width: 992px) { .zcs-col-md-6 { flex: 0 0 50%; max-width: 50%; } .zcs-col-md-12 { flex: 0 0 100%; max-width: 100%; } }
@media (max-width: 576px) { .zcs-col-xs-12 { flex: 0 0 100%; max-width: 100%; } }

/* ZCS component CSS: card-profile-card */
.zcs-avatar { width: var(--zcs-avatar-size); height: var(--zcs-avatar-size); background-color: var(--zcs_brand_color); border-radius: var(--zcs-avatar-radius); }
.zcs-avatar .zcs-avatar-img { border-radius: inherit; object-fit: cover; }

/* ZCS component CSS: label-value-key-value-with-icon */
.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color: #a06309; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }

/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }

/* ZCS component CSS: table-simple-table */
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }
.zcs-table-wrapper table thead { top: 0; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }
.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }

/* Vendor scorecard page custom responsive layout */
.vendor-scorecard-shell { background: var(--zcs-page-bg-color); padding: 16px; box-sizing: border-box; }
.vendor-profile-grid { display: grid; grid-template-columns: 320px 1fr; gap: 16px; }
.vendor-kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(160px, 1fr)); gap: 12px; margin-top: 16px; }
.vendor-kpi-card { min-height: 112px; border-left: 4px solid var(--zcs_brand_color); }
.vendor-kpi-card.eval { border-left-color: #2A6FFC; }
.vendor-kpi-card.risk { border-left-color: #F4660C; }
.vendor-kpi-card.performance { border-left-color: #179E6C; }
.vendor-kpi-card.review { border-left-color: #6B7280; }
.vendor-score-value { word-break: break-word; }
.vendor-mobile-note { margin-top: 12px; color: var(--zcs-teritiary-text-color); }
@media (max-width: 1100px) {
  .vendor-profile-grid { grid-template-columns: 1fr; }
  .vendor-kpi-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
}
@media (max-width: 640px) {
  .vendor-scorecard-shell { padding: 10px; }
  .vendor-kpi-grid { grid-template-columns: 1fr; }
  .zcs-table-wrapper table { min-width: 760px; }
}
</style>
<%
vendorRows = Vendors[ID == input.Vendor_ID];
if(vendorRows.count() == 0)
{
%>
<div class='vendor-scorecard-shell'>
  <div class='zcs-card zcs-p-20 zcs-box-border'>
    <div class='zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
      <div class='zcs-nodata-content zcs-p-20 zcs-box-border'>
        <h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No vendor found for the supplied Vendor_ID.</h5>
      </div>
    </div>
  </div>
</div>
<%
}
else
{
  vendorRec = vendorRows;
  vendorName = ifnull(vendorRec.Vendor_Name,"Unnamed Vendor");
  vendorCode = ifnull(vendorRec.Vendor_Code,"Not assigned");
  vendorStatus = ifnull(vendorRec.Vendor_Status,"Not available");
  vendorTier = ifnull(vendorRec.Vendor_Tier,"Unclassified");
  riskLevel = ifnull(vendorRec.Risk_Level,"Not Assessed");
  primaryEmail = ifnull(vendorRec.Primary_Email,"No email on file");
  phone = ifnull(vendorRec.Phone,"No phone on file");
  overallScore = ifnull(vendorRec.Overall_Score,0);
  evaluationScore = ifnull(vendorRec.Evaluation_Score,0);
  riskScore = ifnull(vendorRec.Risk_Score,0);
  performanceScore = ifnull(vendorRec.Performance_Score,0);
  lastReview = vendorRec.Last_Performance_Review_Date;
  if(lastReview == null)
  {
    lastReview = vendorRec.Last_Evaluation_Date;
  }
  if(lastReview == null)
  {
    lastReviewText = "Not reviewed";
  }
  else
  {
    lastReviewText = lastReview.toString("dd-MMM-yyyy");
  }
  statusClass = "zcs-badge-grey";
  if(vendorStatus == "Approved" || vendorStatus == "Onboarded" || vendorStatus == "Registered")
  {
    statusClass = "zcs-badge-green";
  }
  else if(vendorStatus == "Under Evaluation" || vendorStatus == "Risk Review" || vendorStatus == "Onboarding")
  {
    statusClass = "zcs-badge-blue";
  }
  else if(vendorStatus == "Suspended" || vendorStatus == "Rejected")
  {
    statusClass = "zcs-badge-red";
  }
  else if(vendorStatus == "Prospective")
  {
    statusClass = "zcs-badge-yellow";
  }
  riskClass = "zcs-badge-grey";
  if(riskLevel == "Low")
  {
    riskClass = "zcs-badge-green";
  }
  else if(riskLevel == "Medium")
  {
    riskClass = "zcs-badge-yellow";
  }
  else if(riskLevel == "High")
  {
    riskClass = "zcs-badge-orange";
  }
  else if(riskLevel == "Critical")
  {
    riskClass = "zcs-badge-red";
  }
%>
<div class='vendor-scorecard-shell'>
  <div class='vendor-profile-grid'>
    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-15 zcs-p-20 zcs-box-border'>
      <div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center' style='--zcs-avatar-size: 64px; --zcs-avatar-radius: 14px'>
        <i class='zcs-font-30 zcs-color-white zc-li-outline business-store'></i>
      </div>
      <h5 class='zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'><%=vendorName%></h5>
      <div class='zcs-flex zcs-align-items-center zcs-gap-10'>
        <i class='zcs-font-14 zcs-color-primary zc-li-outline design-todo'></i>
        <span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis'><%=vendorCode%></span>
      </div>
      <div class='zcs-flex zcs-align-items-center zcs-gap-10'>
        <i class='zcs-font-14 zcs-color-primary zc-li-outline ui-1-email-85'></i>
        <span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis'><%=primaryEmail%></span>
      </div>
      <div class='zcs-flex zcs-align-items-center zcs-gap-10'>
        <i class='zcs-font-14 zcs-color-primary zc-li-outline ui-3-phone-call'></i>
        <span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis'><%=phone%></span>
      </div>
    </div>
    <div class='zcs-card zcs-p-20 zcs-box-border'>
      <div class='zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16'>
        <div>
          <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-lh-body'>Vendor Scorecard Dashboard</div>
          <h5 class='zcs-font-24 zcs-font-semibold zcs-color-primary zcs-lh-heading zcs-m-0'><%=vendorName%></h5>
        </div>
        <div class='zcs-row zcs-align-items-center zcs-gap-8'>
          <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>'>
            <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=vendorStatus%></span>
          </div>
          <div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=riskClass%>'>
            <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=riskLevel%> Risk</span>
          </div>
        </div>
      </div>
      <div class='zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-lg zcs-p-12 zcs-box-border' style='margin-top:16px;'>
        <ul class='zcs-row zcs-p-0 zcs-m-0'>
          <li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border'>
            <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Vendor Tier</label>
            <div class='zcs-flex zcs-gap-8'><i class='zcs-lh-body zcs-color-primary zc-li-outline design-todo'></i><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=vendorTier%></span></div>
          </li>
          <li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border'>
            <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Last Review Date</label>
            <div class='zcs-flex zcs-gap-8'><i class='zcs-lh-body zcs-color-primary zc-li-outline ui-2-time'></i><span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=lastReviewText%></span></div>
          </li>
        </ul>
      </div>
      <div class='vendor-mobile-note zcs-font-13 zcs-lh-body'>Tablet and mobile layouts stack profile, KPI, chart, and report sections vertically to avoid cramped report columns.</div>
    </div>
  </div>
  <div class='vendor-kpi-grid'>
    <div class='zcs-card vendor-kpi-card zcs-p-16 zcs-box-border'>
      <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary'>Overall Score</div>
      <div class='vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary'><%=overallScore%></div>
      <div class='zcs-font-12 zcs-color-tertiary'>0 to 100 composite score</div>
    </div>
    <div class='zcs-card vendor-kpi-card eval zcs-p-16 zcs-box-border'>
      <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary'>Evaluation Score</div>
      <div class='vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary'><%=evaluationScore%></div>
      <div class='zcs-font-12 zcs-color-tertiary'>Latest weighted evaluation</div>
    </div>
    <div class='zcs-card vendor-kpi-card risk zcs-p-16 zcs-box-border'>
      <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary'>Risk Score</div>
      <div class='vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary'><%=riskScore%></div>
      <div class='zcs-font-12 zcs-color-tertiary'>Lower is preferred</div>
    </div>
    <div class='zcs-card vendor-kpi-card performance zcs-p-16 zcs-box-border'>
      <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary'>Performance Score</div>
      <div class='vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary'><%=performanceScore%></div>
      <div class='zcs-font-12 zcs-color-tertiary'>Latest performance review</div>
    </div>
    <div class='zcs-card vendor-kpi-card review zcs-p-16 zcs-box-border'>
      <div class='zcs-font-13 zcs-font-medium zcs-color-tertiary'>Last Review Date</div>
      <div class='vendor-score-value zcs-font-20 zcs-font-bold zcs-color-primary' style='margin-top:8px;'><%=lastReviewText%></div>
      <div class='zcs-font-12 zcs-color-tertiary'>Evaluation or performance</div>
    </div>
  </div>
</div>
<%
}
%>