<%
reportCriteria = "Vendor == " + input.Vendor_ID;
%>
<style>
.vsc-report-card{background:#FFFFFF;border:1px solid #E7E7EE;border-radius:14px;overflow:hidden;box-sizing:border-box;font-family:lato, arimo, sans-serif;box-shadow:0 8px 20px rgba(18,19,43,0.05);}
.vsc-report-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid #E7E7EE;background:#FFFFFF;}
.vsc-report-title{margin:0;color:#222326;font-size:16px;font-weight:700;line-height:1.3;}
.vsc-report-subtitle{margin-top:3px;color:#5F6199;font-size:12px;line-height:1.4;}
.vsc-report-icon{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:17px;background:#EAF8F2;color:#179E6C;}
.vsc-report-body{height:360px;overflow:auto;}
</style>
<div class='vsc-report-card'>
  <div class='vsc-report-head'>
    <div>
      <h4 class='vsc-report-title'>Onboarding Tracker</h4>
      <div class='vsc-report-subtitle'>Onboarding tasks filtered to the selected vendor at runtime.</div>
    </div>
    <span class='vsc-report-icon'><i class='zc-li-outline ui-1-check-circle-08'></i></span>
  </div>
  <div class='vsc-report-body' zc-component='report' zc-linkname='Onboarding_Tracker' zc-criteria='<%=reportCriteria%>' zc-height='360px'></div>
</div>