<style>
.vendor-score-gauge-card {
  background: #FFFFFF;
  border: 1px solid #E7E7EE;
  border-radius: 12px;
  padding: 18px;
  box-sizing: border-box;
  min-height: 220px;
  font-family: inherit;
}
.vendor-score-gauge-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}
.vendor-score-gauge-title {
  color: var(--zcs_primary_text_color);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.25;
}
.vendor-score-gauge-subtitle {
  color: var(--zcs_tertiary_text_color);
  font-size: 12px;
  margin-top: 4px;
}
.vendor-score-gauge-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #E8EFFF;
  color: #2A6FFC;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.vendor-score-gauge-value {
  color: #12132B;
  font-size: 40px;
  font-weight: 800;
  line-height: 1;
  margin: 18px 0 8px;
}
.vendor-score-gauge-track {
  width: 100%;
  height: 12px;
  border-radius: 999px;
  background: #E8EFFF;
  overflow: hidden;
  margin: 16px 0 10px;
}
.vendor-score-gauge-fill {
  height: 100%;
  border-radius: 999px;
  background: #2A6FFC;
}
.vendor-score-gauge-scale {
  display: flex;
  justify-content: space-between;
  color: var(--zcs_tertiary_text_color);
  font-size: 12px;
}
.vendor-score-gauge-target {
  color: #179E6C;
  font-size: 13px;
  font-weight: 600;
  margin-top: 14px;
}
</style>
<%
vendorRows = Vendors[ID == input.Vendor_ID];
overallScore = 0;
if(vendorRows.count() > 0)
{
  vendorRec = vendorRows;
  overallScore = ifnull(vendorRec.Overall_Score,0);
}
scoreWidth = overallScore;
if(scoreWidth < 0)
{
  scoreWidth = 0;
}
if(scoreWidth > 100)
{
  scoreWidth = 100;
}
%>
<div class="vendor-score-gauge-card">
  <div class="vendor-score-gauge-header">
    <div>
      <div class="vendor-score-gauge-title">Overall Score Gauge</div>
      <div class="vendor-score-gauge-subtitle">Composite vendor score</div>
    </div>
    <div class="vendor-score-gauge-icon"><i class="zc-li-outline business-chart-bar-32" style="font-size:22px;"></i></div>
  </div>
  <div class="vendor-score-gauge-value"><%=overallScore%></div>
  <div class="vendor-score-gauge-track"><div class="vendor-score-gauge-fill" style="width:<%=scoreWidth%>%;"></div></div>
  <div class="vendor-score-gauge-scale"><span>0</span><span>Target 80</span><span>100</span></div>
  <div class="vendor-score-gauge-target">Target: 80 / 100</div>
</div>