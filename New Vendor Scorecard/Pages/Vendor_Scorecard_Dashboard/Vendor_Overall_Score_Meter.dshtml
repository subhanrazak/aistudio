<%
vendorRows = Vendors[ID == input.Vendor_ID];
overallScore = 0;
if(vendorRows.count() > 0)
{
  vendorRec = vendorRows;
  overallScore = ifnull(vendorRec.Overall_Score,0);
}
scoreWidth = overallScore;
if(scoreWidth < 0)
{
  scoreWidth = 0;
}
if(scoreWidth > 100)
{
  scoreWidth = 100;
}
%>
<style>
.vendor-meter-card{background:#FFFFFF;border:1px solid #E8EFFF;border-radius:18px;padding:22px;box-sizing:border-box;box-shadow:0 10px 24px rgba(18,19,43,0.07);font-family:lato, arimo, sans-serif;}
.vendor-meter-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px;}
.vendor-meter-title{margin:0;color:#222326;font-size:16px;font-weight:700;line-height:1.35;}
.vendor-meter-value{color:#12132B;font-size:34px;font-weight:800;line-height:1;}
.vendor-meter-track{height:16px;background:#E8EFFF;border-radius:999px;overflow:hidden;margin:14px 0 10px;}
.vendor-meter-fill{height:100%;background:#2A6FFC;border-radius:999px;}
.vendor-meter-foot{display:flex;justify-content:space-between;color:#5F6199;font-size:12px;line-height:1.4;}
.vendor-meter-target{color:#179E6C;font-weight:700;}
</style>
<div class='vendor-meter-card'>
  <div class='vendor-meter-head'>
    <h4 class='vendor-meter-title'>Overall Score Gauge</h4>
    <div class='vendor-meter-value'><%=overallScore%></div>
  </div>
  <div class='vendor-meter-track'>
    <div class='vendor-meter-fill' style='width:<%=scoreWidth%>%;'></div>
  </div>
  <div class='vendor-meter-foot'>
    <span>0</span>
    <span class='vendor-meter-target'>Target 80</span>
    <span>100</span>
  </div>
</div>