<page linkname = "Vendor_Scorecard_Dashboard" parameters = "int Vendor_ID" displayname = "Vendor Scorecard Dashboard"/>
<content>
<zml mobileDeviceConfig='{"layout":{"displayType":"card","design":"onebyone","forcedOrientation":false}}' tabletDeviceConfig='{"layout":{"displayType":"plain","design":"onebyone","forcedOrientation":false}}'>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Vendor_Header_KPIs' elementName='Vendor_Header_KPIs'>
          <![CDATA[htmlpage Vendor_Header_KPIs()
            content
            <%{%>
              <file name:Vendor_Header_KPIs.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Vendor_Overall_Score_Meter' elementName='Vendor_Overall_Score_Meter'>
          <![CDATA[htmlpage Vendor_Overall_Score_Meter()
            content
            <%{%>
              <file name:Vendor_Overall_Score_Meter.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Vendor_Risk_Score_Meter' elementName='Vendor_Risk_Score_Meter'>
          <![CDATA[htmlpage Vendor_Risk_Score_Meter()
            content
            <%{%>
              <file name:Vendor_Risk_Score_Meter.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Evaluation_Weighted_Score_By_Category_View' elementName='Evaluation_Weighted_Score_By_Category_View'>
          <![CDATA[htmlpage Evaluation_Weighted_Score_By_Category_View()
            content
            <%{%>
              <file name:Evaluation_Weighted_Score_By_Category_View.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Performance_Weighted_Score_By_Category_View' elementName='Performance_Weighted_Score_By_Category_View'>
          <![CDATA[htmlpage Performance_Weighted_Score_By_Category_View()
            content
            <%{%>
              <file name:Performance_Weighted_Score_By_Category_View.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Scorecard_Summary_Table' elementName='Scorecard_Summary_Table'>
          <![CDATA[htmlpage Scorecard_Summary_Table()
            content
            <%{%>
              <file name:Scorecard_Summary_Table.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Vendor_Documents_Filtered_Embed' elementName='Vendor_Documents_Filtered_Embed'>
          <![CDATA[htmlpage Vendor_Documents_Filtered_Embed()
            content
            <%{%>
              <file name:Vendor_Documents_Filtered_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Evaluation_Scores_Filtered_Embed' elementName='Evaluation_Scores_Filtered_Embed'>
          <![CDATA[htmlpage Evaluation_Scores_Filtered_Embed()
            content
            <%{%>
              <file name:Evaluation_Scores_Filtered_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Risk_Assessments_Filtered_Embed' elementName='Risk_Assessments_Filtered_Embed'>
          <![CDATA[htmlpage Risk_Assessments_Filtered_Embed()
            content
            <%{%>
              <file name:Risk_Assessments_Filtered_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Onboarding_Tracker_Filtered_Embed' elementName='Onboarding_Tracker_Filtered_Embed'>
          <![CDATA[htmlpage Onboarding_Tracker_Filtered_Embed()
            content
            <%{%>
              <file name:Onboarding_Tracker_Filtered_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Performance_Reviews_Filtered_Embed' elementName='Performance_Reviews_Filtered_Embed'>
          <![CDATA[htmlpage Performance_Reviews_Filtered_Embed()
            content
            <%{%>
              <file name:Performance_Reviews_Filtered_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
