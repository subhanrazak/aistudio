<style>
.vod-native-embed-card {
  background: var(--zcs-white-color, #FFFFFF);
  border: 1px solid var(--zcs_tertiary_border_color, #E7E7EE);
  border-radius: 12px;
  overflow: hidden;
  box-sizing: border-box;
}
.vod-native-embed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid var(--zcs_tertiary_border_color, #E7E7EE);
  box-sizing: border-box;
}
.vod-native-embed-title {
  margin: 0;
  color: var(--zcs_primary_text_color, #12132B);
  font-size: 16px;
  line-height: 1.25;
  font-weight: 600;
}
.vod-native-embed-subtitle {
  margin-top: 2px;
  color: var(--zcs_secondary_text_color, #5F6199);
  font-size: 13px;
  line-height: 1.5;
}
.vod-native-embed-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 17px;
  background: var(--zcs_brand_light_color, #EEF3FF);
  color: var(--zcs_brand_color, #2A6FFC);
}
.vod-native-embed-body {
  height: 520px;
  overflow: auto;
}
@media screen and (max-width: 700px) {
  .vod-native-embed-body { height: 420px; }
}
</style>
<div class='vod-native-embed-card'>
  <div class='vod-native-embed-header'>
    <div>
      <h3 class='vod-native-embed-title'>Vendor Pipeline</h3>
      <div class='vod-native-embed-subtitle'>Status-based vendor flow with score and risk context.</div>
    </div>
    <span class='vod-native-embed-icon'><i class='zc-li-outline business-chart-bar-33'></i></span>
  </div>
  <div class='vod-native-embed-body' zc-component='report' zc-linkname='Vendor_Pipeline' zc-height='520px'></div>
</div>
