<panel elementName='KPI_Pending_Registrations'>
  <pr width='fill' height='fill'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px' borderColor='#E7E7EE' borderWidth='1px'>
      <pr width='auto' height='auto'>
        <pc hAlign='left' vAlign='middle' bgColor='transparent'>
          <image type='icon' value='zc-li-outline ui-2-time' color='#FFFFFF' bgColor='#FAAE13' width='44px' height='44px' size='24px' cornerRadius='22px' />
        </pc>
        <pc padding='5px' hAlign='left' vAlign='middle' bgColor='transparent'>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' color='#5F6199' size='13px' type='Text' value='Pending Registrations'> </text>
            </pc>
          </pr>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' color='#B8770D' size='32px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' decimalPlaces='0' criteria='Registration_Status != &quot;Draft&quot; &amp;&amp; Registration_Status != &quot;Accepted&quot; &amp;&amp; Registration_Status != &quot;Rejected&quot;' value='thisapp.Registration.Registration_Number.count'> </text>
            </pc>
          </pr>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
