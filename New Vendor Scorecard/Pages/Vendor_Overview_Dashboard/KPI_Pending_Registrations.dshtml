<style>
.vendor-overview-kpi { background:#FFFFFF; border:1px solid #E7E7EE; border-radius:12px; padding:16px; box-sizing:border-box; display:flex; align-items:center; gap:12px; min-height:86px; }
.vendor-overview-kpi-icon { width:44px; height:44px; border-radius:22px; display:inline-flex; align-items:center; justify-content:center; color:#FFFFFF; background:#FAAE13; flex:0 0 auto; }
.vendor-overview-kpi-label { color:#5F6199; font-size:13px; line-height:1.4; }
.vendor-overview-kpi-value { color:#B8770D; font-size:32px; font-weight:700; line-height:1.1; margin-top:2px; }
</style>
<%
pendingCount = Registration[Registration_Status == "Submitted" || Registration_Status == "Under Review" || Registration_Status == "Clarification Required"].count();
%>
<div class="vendor-overview-kpi">
  <div class="vendor-overview-kpi-icon"><i class="zc-li-outline ui-2-time" style="font-size:24px;"></i></div>
  <div>
    <div class="vendor-overview-kpi-label">Pending Registrations</div>
    <div class="vendor-overview-kpi-value"><%=pendingCount%></div>
  </div>
</div>