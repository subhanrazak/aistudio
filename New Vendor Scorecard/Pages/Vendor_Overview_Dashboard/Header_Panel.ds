<panel elementName='Executive_Dashboard_Header'>
  <pr width='fill' height='auto'>
    <pc padding='20px' bgColor='theme' width='100%' hAlign='left' vAlign='middle' cornerRadius='14px'>
      <pr width='fill' height='auto'>
        <pc width='8%' hAlign='center' vAlign='middle' bgColor='transparent'>
          <image type='icon' value='zc-li-outline business-chart-bar-33' color='#FFFFFF' bgColor='rgba(255,255,255,0.18)' width='52px' height='52px' size='28px' cornerRadius='26px' />
        </pc>
        <pc width='72%' hAlign='left' vAlign='middle' bgColor='transparent' paddingLeft='8px'>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' color='#FFFFFF' size='24px' bold='true' type='Text' value='Vendor Overview Dashboard'> </text>
            </pc>
          </pr>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' color='#EAF2FF' size='14px' type='Text' value='Executive snapshot of vendor health, scorecards, pipeline, risk, and review activity.'> </text>
            </pc>
          </pr>
        </pc>
        <pc width='20%' hAlign='right' vAlign='middle' bgColor='transparent'>
          <text margin='0px' paddingTop='6px' paddingRight='12px' paddingBottom='6px' paddingLeft='12px' color='#FFFFFF' size='12px' bold='true' type='Text' bgColor='rgba(255,255,255,0.18)' cornerRadius='18px' value='Executive View'> </text>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
