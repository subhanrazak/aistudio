<panel elementName='KPI_High_Critical_Risk'>
  <pr width='fill' height='fill'>
    <pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px' borderColor='#E7E7EE' borderWidth='1px'>
      <pr width='auto' height='auto'>
        <pc hAlign='left' vAlign='middle' bgColor='transparent'>
          <image type='icon' value='zc-li-outline ui-1-alert-circle-i' color='#FFFFFF' bgColor='#FE455D' width='44px' height='44px' size='24px' cornerRadius='22px' />
        </pc>
        <pc padding='5px' hAlign='left' vAlign='middle' bgColor='transparent'>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' color='#5F6199' size='13px' type='Text' value='High/Critical Risk'> </text>
            </pc>
          </pr>
          <pr>
            <pc hAlign='left' bgColor='transparent'>
              <text margin='0px' padding='0px' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' color='#FE455D' size='32px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' decimalPlaces='0' criteria='Risk_Level != &quot;Low&quot; &amp;&amp; Risk_Level != &quot;Medium&quot; &amp;&amp; Risk_Level != &quot;Not Assessed&quot;' value='thisapp.Vendors.Vendor_Code.count'> </text>
            </pc>
          </pr>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>
