<page linkname = "Vendor_Overview_Dashboard" displayname = "Vendor Overview Dashboard"/>
<content>
<zml mobileDeviceConfig='{"layout":{"displayType":"card","design":"onebyone","forcedOrientation":false}}' tabletDeviceConfig='{"layout":{"displayType":"plain","design":"onebyone","forcedOrientation":false}}'>
  <layout>
    <row>
      <column width='100%'>
        <file name:Header_Panel.ds/>
      </column>
    </row>
    <row>
      <column width='20%'>
        <file name:KPI_Total_Vendors.ds/>
      </column>
      <column width='20%'>
        <file name:KPI_Onboarded_Vendors.ds/>
      </column>
      <column width='20%'>
        <file name:KPI_Pending_Registrations.ds/>
      </column>
      <column width='20%'>
        <file name:KPI_High_Critical_Risk.ds/>
      </column>
      <column width='20%'>
        <file name:KPI_Average_Overall_Score.ds/>
      </column>
    </row>
    <row>
      <column width='33%'>
        <file name:Chart_Vendor_Status_Distribution.ds/>
      </column>
      <column width='33%'>
        <file name:Chart_Average_Score_By_Risk.ds/>
      </column>
      <column width='34%'>
        <file name:Gauge_Average_Overall_Score.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Chart_Reviews_Over_Time.ds/>
      </column>
      <column width='50%'>
        <dsp id='Vendor_Pipeline_Embed' elementName='Vendor_Pipeline_Embed'>
          <![CDATA[htmlpage Vendor_Pipeline_Embed()
            content
            <%{%>
              <file name:Vendor_Pipeline_Embed.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Report_High_Risk_Assessments.ds/>
      </column>
      <column width='50%'>
        <file name:Report_Recent_Performance_Reviews.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Top_Vendor_Scorecards' elementName='Top_Vendor_Scorecards'>
          <![CDATA[htmlpage Top_Vendor_Scorecards()
            content
            <%{%>
              <file name:Top_Vendor_Scorecards.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
