	pages
	{
		page Vendor_Overview_Dashboard
		{
					displayname = "Vendor Overview Dashboard"
					Content="<zml mobileDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}' tabletDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"onebyone\",\"forcedOrientation\":false}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Executive_Dashboard_Header'>\n\t<pr width='fill' height='auto'>\n\t\t<pc padding='20px' bgColor='theme' width='100%' hAlign='left' vAlign='middle' cornerRadius='14px'>\n\t\t\t<pr width='fill' height='auto'>\n\t\t\t\t<pc width='8%' hAlign='center' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<image type='icon' value='zc-li-outline business-chart-bar-33' color='#FFFFFF' bgColor='rgba(255,255,255,0.18)' width='52px' height='52px' size='28px' cornerRadius='26px' />\n\t\t\t\t</pc>\n\t\t\t\t<pc width='72%' hAlign='left' vAlign='middle' bgColor='transparent' paddingLeft='8px'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#FFFFFF' size='24px' bold='true' type='Text' value='Vendor Overview Dashboard'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#EAF2FF' size='14px' type='Text' value='Executive snapshot of vendor health, scorecards, pipeline, risk, and review activity.'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t\t<pc width='20%' hAlign='right' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<text margin='0px' paddingTop='6px' paddingRight='12px' paddingBottom='6px' paddingLeft='12px' color='#FFFFFF' size='12px' bold='true' type='Text' bgColor='rgba(255,255,255,0.18)' cornerRadius='18px' value='Executive View'> </text>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='20%'>\n\t\t\t\t<panel elementName='KPI_Total_Vendors'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px' borderColor='#E7E7EE' borderWidth='1px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc hAlign='left' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<image type='icon' value='zc-li-outline users-single-02' color='#FFFFFF' bgColor='#2A6FFC' width='44px' height='44px' size='24px' cornerRadius='22px' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#5F6199' size='13px' type='Text' value='Total Vendors'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' color='#12132B' size='32px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' decimalPlaces='0' value='thisapp.Vendors.Vendor_Name.count'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<dsp id='KPI_Onboarded_Vendors_Dsp' elementName='KPI_Onboarded_Vendors'>\n\t<![CDATA[htmlpage KPI_Onboarded_Vendors_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:KPI_Onboarded_Vendors.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<dsp id='KPI_Pending_Registrations_Dsp' elementName='KPI_Pending_Registrations'>\n\t<![CDATA[htmlpage KPI_Pending_Registrations_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:KPI_Pending_Registrations.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<dsp id='KPI_High_Critical_Risk_Dsp' elementName='KPI_High_Critical_Risk'>\n\t<![CDATA[htmlpage KPI_High_Critical_Risk_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:KPI_High_Critical_Risk.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t\t<column width='20%'>\n\t\t\t\t<panel elementName='KPI_Average_Overall_Score'>\n\t<pr width='fill' height='fill'>\n\t\t<pc padding='16px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle' cornerRadius='12px' borderColor='#E7E7EE' borderWidth='1px'>\n\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t<pc hAlign='left' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<image type='icon' value='zc-li-outline business-gold' color='#FFFFFF' bgColor='#8A3DFB' width='44px' height='44px' size='24px' cornerRadius='22px' />\n\t\t\t\t</pc>\n\t\t\t\t<pc padding='5px' hAlign='left' vAlign='middle' bgColor='transparent'>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#5F6199' size='13px' type='Text' value='Average Overall Score'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t\t<pr>\n\t\t\t\t\t\t<pc hAlign='left' bgColor='transparent'>\n\t\t\t\t\t\t\t<text margin='0px' padding='0px' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' color='#8A3DFB' size='32px' bold='true' type='Form Data' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' decimalPlaces='1' value='thisapp.Vendors.Overall_Score.avg'> </text>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n\t\t\t\t</pc>\n\t\t\t</pr>\n\t\t</pc>\n\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='33%'>\n\t\t\t\t<chart elementName='Vendor_Status_Distribution' title='Vendor Status Distribution' titleColor='#222326' titleSize='16px' boldTitle='true' type='Donut' xtitle='Vendor Status' ytitle='Vendor Count' bgColor='#FFFFFF' theme='theme1' legendPos='center.bottom' heightType='custom' heightValue='320px' appLinkName='thisapp' formLinkName='Vendors' xfield='Vendor_Status' yfields='count:Vendor_Name' showDataLabel='true' underlyingReport='All_Vendors' />\n\t\t\t</column>\n\t\t\t<column width='33%'>\n\t\t\t\t<chart elementName='Score_By_Risk_Level' title='Score Distribution by Risk Level' titleColor='#222326' titleSize='16px' boldTitle='true' type='Column' xtitle='Risk Level' ytitle='Total Overall Score' bgColor='#FFFFFF' theme='theme1' legendPos='none' heightType='custom' heightValue='320px' appLinkName='thisapp' formLinkName='Vendors' xfield='Risk_Level' yfields='sum:Overall_Score' yAxisInterval='10' showDataLabel='true' underlyingReport='All_Vendors' />\n\t\t\t</column>\n\t\t\t<column width='34%'>\n\t\t\t\t<gauge elementName='Average_Overall_Score_Gauge' title='Average Overall Score Gauge' titleColor='#222326' titleSize='16px' boldTitle='true' color='#12132B' size='22px' bold='true' fontFamily='default' bgColor='#FFFFFF' theme='#2A6FFC' displayType='Percentage against a number' type='5' filledColor='#2A6FFC' nonFilledColor='#EEF3FF' targetColor='#D8D8D8' value='thisapp.Vendors.Overall_Score.avg' compareTo='100'>\n\t<target size='13px' color='#5F6199' fontFamily='default' value='85' />\n\t<maximumvalue size='13px' color='#5F6199' value='100' fontFamily='default' />\n</gauge>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<chart elementName='Reviews_Over_Time' title='Performance Reviews Over Time' titleColor='#222326' titleSize='16px' boldTitle='true' type='Area' xtitle='Review Month' ytitle='Review Count' bgColor='#FFFFFF' theme='theme1' legendPos='center.bottom' heightType='custom' heightValue='320px' appLinkName='thisapp' formLinkName='Performance_Review' xfield='Review_Date' yfields='count:Performance_Review_Number' dateGrouping='month_year' showDataLabel='true' underlyingReport='Performance_Reviews' />\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Vendor_Pipeline_Embed_Dsp' elementName='Vendor_Pipeline_Embed'>\n\t\t\t\t\t<![CDATA[htmlpage Vendor_Pipeline_Embed_Dsp()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;style&gt;\n.vod-native-embed-card {\n\tbackground: var(--zcs-white-color, #FFFFFF);\n\tborder: 1px solid var(--zcs_tertiary_border_color, #E7E7EE);\n\tborder-radius: 12px;\n\toverflow: hidden;\n\tbox-sizing: border-box;\n}\n.vod-native-embed-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 12px;\n\tpadding: 16px;\n\tborder-bottom: 1px solid var(--zcs_tertiary_border_color, #E7E7EE);\n\tbox-sizing: border-box;\n}\n.vod-native-embed-title {\n\tmargin: 0;\n\tcolor: var(--zcs_primary_text_color, #12132B);\n\tfont-size: 16px;\n\tline-height: 1.25;\n\tfont-weight: 600;\n}\n.vod-native-embed-subtitle {\n\tmargin-top: 2px;\n\tcolor: var(--zcs_secondary_text_color, #5F6199);\n\tfont-size: 13px;\n\tline-height: 1.5;\n}\n.vod-native-embed-icon {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\twidth: 34px;\n\theight: 34px;\n\tborder-radius: 17px;\n\tbackground: var(--zcs_brand_light_color, #EEF3FF);\n\tcolor: var(--zcs_brand_color, #2A6FFC);\n}\n.vod-native-embed-body {\n\theight: 520px;\n\toverflow: auto;\n}\n@media screen and (max-width: 700px) {\n\t.vod-native-embed-body { height: 420px; }\n}\n&lt;/style&gt;\n&lt;div class=&apos;vod-native-embed-card&apos;&gt;\n\t&lt;div class=&apos;vod-native-embed-header&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3 class=&apos;vod-native-embed-title&apos;&gt;Vendor Pipeline&lt;/h3&gt;\n\t\t\t&lt;div class=&apos;vod-native-embed-subtitle&apos;&gt;Status-based vendor flow with score and risk context.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&apos;vod-native-embed-icon&apos;&gt;&lt;i class=&apos;zc-li-outline business-chart-bar-33&apos;&gt;&lt;/i&gt;&lt;/span&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;vod-native-embed-body&apos; zc-component=&apos;report&apos; zc-linkname=&apos;Vendor_Pipeline&apos; zc-height=&apos;520px&apos;&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='High_Risk_Assessments_Embedded' title='High Risk Assessments' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='High_Risk_Assessments' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' />\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<report elementName='Recent_Performance_Reviews_Embedded' title='Recent Performance Review Activity' titleColor='#222326' boldTitle='true' appLinkName='thisapp' linkName='Performance_Reviews' iszreport='false' zc_Footer='true' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_Search='true' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' />\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Top_Vendor_Scorecards_Dsp' elementName='Top_Vendor_Scorecards'>\n\t\t\t\t\t<![CDATA[htmlpage Top_Vendor_Scorecards_Dsp()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttopVendors = Vendors[ID != 0] sort by Overall_Score desc range from 1 to 6;\n%&gt;\n&lt;style&gt;\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0px; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.vod-scorecard { min-height: 100%; }\n.vod-card-header { border-bottom: 1px solid var(--zcs_tertiary_border_color); }\n.vod-subtitle { color: var(--zcs_secondary_text_color); }\n.vod-vendor-name { color: var(--zcs_primary_text_color); font-weight: 600; }\n.vod-muted { color: var(--zcs_secondary_text_color); }\n.vod-link { white-space: nowrap; }\n.vod-empty { min-height: 180px; border: 1px dashed var(--zcs_tertiary_border_color); background: #F9FAFE; }\n@media screen and (max-width: 700px) {\n\t.vod-hide-sm { display: none; }\n\t.zcs-table-wrapper table { min-width: 640px; }\n\t.vod-card-header { align-items: flex-start; flex-direction: column; }\n}\n&lt;/style&gt;\n&lt;div class=&apos;vod-scorecard zcs-card zcs-flex zcs-direction-column zcs-relative&apos;&gt;\n\t&lt;div class=&apos;vod-card-header zcs-p-16 zcs-box-border zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h3 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Top Vendor Scorecards&lt;/h3&gt;\n\t\t\t&lt;div class=&apos;vod-subtitle zcs-font-13 zcs-lh-body&apos;&gt;Highest overall scores with current risk and tier.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:All_Vendors&apos;&gt;\n\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;View All Vendors&lt;/span&gt;\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;zcs-p-16 zcs-box-border&apos;&gt;\n&lt;%\n\tif(topVendors.count() == 0)\n\t{\n%&gt;\n\t\t&lt;div class=&apos;vod-empty zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18 zcs-color-tertiary&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;No vendor scorecards yet&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 vod-muted&apos;&gt;Vendor scores will appear after scorecard activity is recorded.&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n%&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Vendor&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary vod-hide-sm&apos;&gt;Tier&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Risk&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Score&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Scorecard&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;5&apos;&gt; &lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tfor each vendorRec in topVendors\n\t\t{\n\t\t\tscore = ifnull(vendorRec.Overall_Score,0);\n\t\t\tscoreBadge = &quot;zcs-badge-red&quot;;\n\t\t\tif(score &gt;= 85)\n\t\t\t{\n\t\t\t\tscoreBadge = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(score &gt;= 70)\n\t\t\t{\n\t\t\t\tscoreBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t}\n\t\t\telse if(score &gt;= 50)\n\t\t\t{\n\t\t\t\tscoreBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\triskText = ifnull(vendorRec.Risk_Level,&quot;Not Assessed&quot;);\n\t\t\triskBadge = &quot;zcs-badge-grey&quot;;\n\t\t\tif(riskText == &quot;Low&quot;)\n\t\t\t{\n\t\t\t\triskBadge = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(riskText == &quot;Medium&quot;)\n\t\t\t{\n\t\t\t\triskBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\telse if(riskText == &quot;High&quot;)\n\t\t\t{\n\t\t\t\triskBadge = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(riskText == &quot;Critical&quot;)\n\t\t\t{\n\t\t\t\triskBadge = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\tvendorUrl = &quot;#Page:Vendor_Scorecard_Dashboard?Vendor_ID=&quot; + vendorRec.ID;\n%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;vod-vendor-name&apos;&gt;&lt;%=ifnull(vendorRec.Vendor_Name,&quot;Unnamed Vendor&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;vod-muted zcs-font-12&apos;&gt;&lt;%=ifnull(vendorRec.Vendor_Code,&quot;No Code&quot;)%&gt; · &lt;%=ifnull(vendorRec.Vendor_Status,&quot;No Status&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary vod-hide-sm&apos;&gt;&lt;%=ifnull(vendorRec.Vendor_Tier,&quot;Unclassified&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=riskBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=riskText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=scoreBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=score%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;vod-link zcs-color-primary zcs-font-medium&apos; href=&apos;&lt;%=vendorUrl%&gt;&apos;&gt;Open &lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n%&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Vendor_Scorecard_Dashboard(int Vendor_ID)
		{
					displayname = "Vendor Scorecard Dashboard"
					Content="<zml mobileDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"onebyone\",\"forcedOrientation\":false}}' tabletDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"onebyone\",\"forcedOrientation\":false}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Vendor_Header_KPIs_Dsp' elementName='Vendor_Header_KPIs'>\n\t\t\t\t\t<![CDATA[htmlpage Vendor_Header_KPIs_Dsp()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;style&gt;\n/* ZCS global utility subset included once for this page from zcs-global */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\t--column-gap: 0px;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-text-left { text-align: left; }\n.zcs-text-center { text-align: center; }\n.zcs-text-right { text-align: right; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-col-3 { flex: 0 0 calc(25% - var(--column-gap) * 0.75); max-width: calc(25% - var(--column-gap) * 0.75); }\n.zcs-col-4 { flex: 0 0 calc(33.3333333333% - var(--column-gap) * 0.6666666667); max-width: calc(33.3333333333% - var(--column-gap) * 0.6666666667); }\n.zcs-col-6 { flex: 0 0 calc(50% - var(--column-gap) * 0.5); max-width: calc(50% - var(--column-gap) * 0.5); }\n.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }\n.zcs-gap-6 { gap: 0.375rem; --column-gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; --column-gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; --column-gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; --column-gap: 0.75rem; }\n.zcs-gap-15 { gap: 0.9375rem; --column-gap: 0.9375rem; }\n.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-15 { padding-left: 0.9375rem; padding-right: 0.9375rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\n.zcs-list-none { list-style-type: none; }\na { text-decoration: none; }\n@media (max-width: 992px) { .zcs-col-md-6 { flex: 0 0 50%; max-width: 50%; } .zcs-col-md-12 { flex: 0 0 100%; max-width: 100%; } }\n@media (max-width: 576px) { .zcs-col-xs-12 { flex: 0 0 100%; max-width: 100%; } }\n\n/* ZCS component CSS: card-profile-card */\n.zcs-avatar { width: var(--zcs-avatar-size); height: var(--zcs-avatar-size); background-color: var(--zcs_brand_color); border-radius: var(--zcs-avatar-radius); }\n.zcs-avatar .zcs-avatar-img { border-radius: inherit; object-fit: cover; }\n\n/* ZCS component CSS: label-value-key-value-with-icon */\n.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg { background-color: #F9FAFE; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color: #a06309; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }\n\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }\n\n/* Vendor scorecard page custom responsive layout */\n.vendor-scorecard-shell { background: var(--zcs-page-bg-color); padding: 16px; box-sizing: border-box; }\n.vendor-profile-grid { display: grid; grid-template-columns: 320px 1fr; gap: 16px; }\n.vendor-kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(160px, 1fr)); gap: 12px; margin-top: 16px; }\n.vendor-kpi-card { min-height: 112px; border-left: 4px solid var(--zcs_brand_color); }\n.vendor-kpi-card.eval { border-left-color: #2A6FFC; }\n.vendor-kpi-card.risk { border-left-color: #F4660C; }\n.vendor-kpi-card.performance { border-left-color: #179E6C; }\n.vendor-kpi-card.review { border-left-color: #6B7280; }\n.vendor-score-value { word-break: break-word; }\n.vendor-mobile-note { margin-top: 12px; color: var(--zcs-teritiary-text-color); }\n@media (max-width: 1100px) {\n\t.vendor-profile-grid { grid-template-columns: 1fr; }\n\t.vendor-kpi-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }\n}\n@media (max-width: 640px) {\n\t.vendor-scorecard-shell { padding: 10px; }\n\t.vendor-kpi-grid { grid-template-columns: 1fr; }\n\t.zcs-table-wrapper table { min-width: 760px; }\n}\n&lt;/style&gt;\n&lt;%\nvendorRows = Vendors[ID == input.Vendor_ID];\nif(vendorRows.count() == 0)\n{\n%&gt;\n&lt;div class=&apos;vendor-scorecard-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No vendor found for the supplied Vendor_ID.&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n\tvendorRec = vendorRows;\n\tvendorName = ifnull(vendorRec.Vendor_Name,&quot;Unnamed Vendor&quot;);\n\tvendorCode = ifnull(vendorRec.Vendor_Code,&quot;Not assigned&quot;);\n\tvendorStatus = ifnull(vendorRec.Vendor_Status,&quot;Not available&quot;);\n\tvendorTier = ifnull(vendorRec.Vendor_Tier,&quot;Unclassified&quot;);\n\triskLevel = ifnull(vendorRec.Risk_Level,&quot;Not Assessed&quot;);\n\tprimaryEmail = ifnull(vendorRec.Primary_Email,&quot;No email on file&quot;);\n\tphone = ifnull(vendorRec.Phone,&quot;No phone on file&quot;);\n\toverallScore = ifnull(vendorRec.Overall_Score,0);\n\tevaluationScore = ifnull(vendorRec.Evaluation_Score,0);\n\triskScore = ifnull(vendorRec.Risk_Score,0);\n\tperformanceScore = ifnull(vendorRec.Performance_Score,0);\n\tlastReview = vendorRec.Last_Performance_Review_Date;\n\tif(lastReview == null)\n\t{\n\t\tlastReview = vendorRec.Last_Evaluation_Date;\n\t}\n\tif(lastReview == null)\n\t{\n\t\tlastReviewText = &quot;Not reviewed&quot;;\n\t}\n\telse\n\t{\n\t\tlastReviewText = lastReview.toString(&quot;dd-MMM-yyyy&quot;);\n\t}\n\tstatusClass = &quot;zcs-badge-grey&quot;;\n\tif(vendorStatus == &quot;Approved&quot; || vendorStatus == &quot;Onboarded&quot; || vendorStatus == &quot;Registered&quot;)\n\t{\n\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(vendorStatus == &quot;Under Evaluation&quot; || vendorStatus == &quot;Risk Review&quot; || vendorStatus == &quot;Onboarding&quot;)\n\t{\n\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t}\n\telse if(vendorStatus == &quot;Suspended&quot; || vendorStatus == &quot;Rejected&quot;)\n\t{\n\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t}\n\telse if(vendorStatus == &quot;Prospective&quot;)\n\t{\n\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t}\n\triskClass = &quot;zcs-badge-grey&quot;;\n\tif(riskLevel == &quot;Low&quot;)\n\t{\n\t\triskClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(riskLevel == &quot;Medium&quot;)\n\t{\n\t\triskClass = &quot;zcs-badge-yellow&quot;;\n\t}\n\telse if(riskLevel == &quot;High&quot;)\n\t{\n\t\triskClass = &quot;zcs-badge-orange&quot;;\n\t}\n\telse if(riskLevel == &quot;Critical&quot;)\n\t{\n\t\triskClass = &quot;zcs-badge-red&quot;;\n\t}\n%&gt;\n&lt;div class=&apos;vendor-scorecard-shell&apos;&gt;\n\t&lt;div class=&apos;vendor-profile-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-15 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center&apos; style=&apos;--zcs-avatar-size: 64px; --zcs-avatar-radius: 14px&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-30 zcs-color-white zc-li-outline business-store&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=vendorName%&gt;&lt;/h5&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-14 zcs-color-primary zc-li-outline design-todo&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis&apos;&gt;&lt;%=vendorCode%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-14 zcs-color-primary zc-li-outline ui-1-email-85&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis&apos;&gt;&lt;%=primaryEmail%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-14 zcs-color-primary zc-li-outline ui-3-phone-call&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-ellipsis&apos;&gt;&lt;%=phone%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-16&apos;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary zcs-lh-body&apos;&gt;Vendor Scorecard Dashboard&lt;/div&gt;\n\t\t\t\t\t&lt;h5 class=&apos;zcs-font-24 zcs-font-semibold zcs-color-primary zcs-lh-heading zcs-m-0&apos;&gt;&lt;%=vendorName%&gt;&lt;/h5&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-row zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=vendorStatus%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=riskClass%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=riskLevel%&gt; Risk&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-lg zcs-p-12 zcs-box-border&apos; style=&apos;margin-top:16px;&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Vendor Tier&lt;/label&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zcs-lh-body zcs-color-primary zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=vendorTier%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Last Review Date&lt;/label&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-gap-8&apos;&gt;&lt;i class=&apos;zcs-lh-body zcs-color-primary zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=lastReviewText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-mobile-note zcs-font-13 zcs-lh-body&apos;&gt;Tablet and mobile layouts stack profile, KPI, chart, and report sections vertically to avoid cramped report columns.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;vendor-kpi-grid&apos;&gt;\n\t\t&lt;div class=&apos;zcs-card vendor-kpi-card zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Overall Score&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=overallScore%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;0 to 100 composite score&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card vendor-kpi-card eval zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Evaluation Score&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=evaluationScore%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Latest weighted evaluation&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card vendor-kpi-card risk zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Risk Score&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=riskScore%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Lower is preferred&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card vendor-kpi-card performance zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Performance Score&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-score-value zcs-font-30 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=performanceScore%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Latest performance review&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card vendor-kpi-card review zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Last Review Date&lt;/div&gt;\n\t\t\t&lt;div class=&apos;vendor-score-value zcs-font-20 zcs-font-bold zcs-color-primary&apos; style=&apos;margin-top:8px;&apos;&gt;&lt;%=lastReviewText%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Evaluation or performance&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Vendor_Overall_Score_Gauge_Dsp' elementName='Vendor_Overall_Score_Gauge'>\n\t<![CDATA[htmlpage Vendor_Overall_Score_Gauge_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Vendor_Overall_Score_Gauge.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Vendor_Risk_Score_Gauge_Dsp' elementName='Vendor_Risk_Score_Gauge'>\n\t<![CDATA[htmlpage Vendor_Risk_Score_Gauge_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Vendor_Risk_Score_Gauge.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Evaluation_Weighted_Score_By_Category_Dsp' elementName='Evaluation_Weighted_Score_By_Category'>\n\t<![CDATA[htmlpage Evaluation_Weighted_Score_By_Category_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Evaluation_Weighted_Score_By_Category.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Performance_Weighted_Score_By_Category_Dsp' elementName='Performance_Weighted_Score_By_Category'>\n\t<![CDATA[htmlpage Performance_Weighted_Score_By_Category_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Performance_Weighted_Score_By_Category.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Scorecard_Summary_Table_Dsp' elementName='Scorecard_Summary_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Scorecard_Summary_Table_Dsp()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\nvendorRows = Vendors[ID == input.Vendor_ID];\nif(vendorRows.count() == 0)\n{\n%&gt;\n&lt;div class=&apos;vendor-scorecard-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No scorecard summary is available for this Vendor_ID.&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\nelse\n{\n\tvendorRec = vendorRows;\n\tvendorStatus = ifnull(vendorRec.Vendor_Status,&quot;Not available&quot;);\n\triskLevel = ifnull(vendorRec.Risk_Level,&quot;Not Assessed&quot;);\n\tevaluationScore = ifnull(vendorRec.Evaluation_Score,0);\n\triskScore = ifnull(vendorRec.Risk_Score,0);\n\tperformanceScore = ifnull(vendorRec.Performance_Score,0);\n\tevalCount = Evaluation[Vendor == input.Vendor_ID].count();\n\tevalFinalCount = Evaluation[Vendor == input.Vendor_ID &amp;&amp; Evaluation_Status == &quot;Finalized&quot;].count();\n\triskOpenCount = Risk_Assessment[Vendor == input.Vendor_ID &amp;&amp; Risk_Status != &quot;Closed&quot;].count();\n\triskMitigationCount = Risk_Assessment[Vendor == input.Vendor_ID &amp;&amp; Risk_Status == &quot;Mitigation Required&quot;].count();\n\tonboardingCount = Onboarding[Vendor == input.Vendor_ID].count();\n\tonboardingPendingCount = Onboarding[Vendor == input.Vendor_ID &amp;&amp; Onboarding_Status != &quot;Completed&quot; &amp;&amp; Onboarding_Status != &quot;Rejected&quot;].count();\n\tonboardingCompleteCount = Onboarding[Vendor == input.Vendor_ID &amp;&amp; Onboarding_Status == &quot;Completed&quot;].count();\n\tdocCount = Documents[Vendor == input.Vendor_ID].count();\n\tdocPendingCount = Documents[Vendor == input.Vendor_ID &amp;&amp; Verification_Status == &quot;Pending&quot;].count();\n\tdocExpiredCount = Documents[Vendor == input.Vendor_ID &amp;&amp; Verification_Status == &quot;Expired&quot;].count();\n\tperfCount = Performance_Review[Vendor == input.Vendor_ID].count();\n\tperfFinalCount = Performance_Review[Vendor == input.Vendor_ID &amp;&amp; Review_Status == &quot;Finalized&quot;].count();\n\tregistrationClass = &quot;zcs-badge-yellow&quot;;\n\tif(vendorStatus == &quot;Approved&quot; || vendorStatus == &quot;Onboarded&quot; || vendorStatus == &quot;Registered&quot;)\n\t{\n\t\tregistrationClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(vendorStatus == &quot;Rejected&quot; || vendorStatus == &quot;Suspended&quot;)\n\t{\n\t\tregistrationClass = &quot;zcs-badge-red&quot;;\n\t}\n\tevaluationStatus = &quot;Needs Review&quot;;\n\tevaluationClass = &quot;zcs-badge-yellow&quot;;\n\tif(evalFinalCount &gt; 0 &amp;&amp; evaluationScore &gt;= 70)\n\t{\n\t\tevaluationStatus = &quot;Reviewed&quot;;\n\t\tevaluationClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(evalCount == 0)\n\t{\n\t\tevaluationStatus = &quot;Not Started&quot;;\n\t\tevaluationClass = &quot;zcs-badge-grey&quot;;\n\t}\n\triskStatus = &quot;Under Control&quot;;\n\triskClass = &quot;zcs-badge-green&quot;;\n\tif(riskLevel == &quot;Critical&quot; || riskMitigationCount &gt; 0)\n\t{\n\t\triskStatus = &quot;Mitigation Required&quot;;\n\t\triskClass = &quot;zcs-badge-red&quot;;\n\t}\n\telse if(riskLevel == &quot;High&quot; || riskOpenCount &gt; 0)\n\t{\n\t\triskStatus = &quot;Open Risks&quot;;\n\t\triskClass = &quot;zcs-badge-orange&quot;;\n\t}\n\telse if(riskLevel == &quot;Not Assessed&quot;)\n\t{\n\t\triskStatus = &quot;Not Assessed&quot;;\n\t\triskClass = &quot;zcs-badge-grey&quot;;\n\t}\n\tonboardingStatus = &quot;Not Started&quot;;\n\tonboardingClass = &quot;zcs-badge-grey&quot;;\n\tif(onboardingCompleteCount &gt; 0)\n\t{\n\t\tonboardingStatus = &quot;Completed&quot;;\n\t\tonboardingClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(onboardingPendingCount &gt; 0)\n\t{\n\t\tonboardingStatus = &quot;In Progress&quot;;\n\t\tonboardingClass = &quot;zcs-badge-blue&quot;;\n\t}\n\tdocumentStatus = &quot;No Documents&quot;;\n\tdocumentClass = &quot;zcs-badge-grey&quot;;\n\tif(docExpiredCount &gt; 0)\n\t{\n\t\tdocumentStatus = &quot;Expired Documents&quot;;\n\t\tdocumentClass = &quot;zcs-badge-red&quot;;\n\t}\n\telse if(docPendingCount &gt; 0)\n\t{\n\t\tdocumentStatus = &quot;Pending Verification&quot;;\n\t\tdocumentClass = &quot;zcs-badge-yellow&quot;;\n\t}\n\telse if(docCount &gt; 0)\n\t{\n\t\tdocumentStatus = &quot;Verified or Current&quot;;\n\t\tdocumentClass = &quot;zcs-badge-green&quot;;\n\t}\n\tperformanceStatus = &quot;Needs Review&quot;;\n\tperformanceClass = &quot;zcs-badge-yellow&quot;;\n\tif(perfFinalCount &gt; 0 &amp;&amp; performanceScore &gt;= 70)\n\t{\n\t\tperformanceStatus = &quot;Reviewed&quot;;\n\t\tperformanceClass = &quot;zcs-badge-green&quot;;\n\t}\n\telse if(perfCount == 0)\n\t{\n\t\tperformanceStatus = &quot;Not Started&quot;;\n\t\tperformanceClass = &quot;zcs-badge-grey&quot;;\n\t}\n\trecommendedAction = &quot;Maintain approved vendor relationship and schedule the next review.&quot;;\n\tif(vendorStatus == &quot;Rejected&quot; || vendorStatus == &quot;Suspended&quot;)\n\t{\n\t\trecommendedAction = &quot;Review vendor status before any sourcing or onboarding activity.&quot;;\n\t}\n\telse if(riskLevel == &quot;Critical&quot; || riskMitigationCount &gt; 0 || riskOpenCount &gt; 0)\n\t{\n\t\trecommendedAction = &quot;Resolve open risk items and mitigation actions before approval progression.&quot;;\n\t}\n\telse if(docExpiredCount &gt; 0 || docPendingCount &gt; 0)\n\t{\n\t\trecommendedAction = &quot;Collect and verify missing or expired vendor documents.&quot;;\n\t}\n\telse if(evalCount == 0 || evaluationScore &lt; 70)\n\t{\n\t\trecommendedAction = &quot;Complete or refresh vendor evaluation to improve evaluation score.&quot;;\n\t}\n\telse if(perfCount == 0 || performanceScore &lt; 70)\n\t{\n\t\trecommendedAction = &quot;Schedule a performance review and capture corrective action where required.&quot;;\n\t}\n\telse if(onboardingPendingCount &gt; 0)\n\t{\n\t\trecommendedAction = &quot;Complete pending onboarding tasks and confirm compliance clearance.&quot;;\n\t}\n%&gt;\n&lt;div class=&apos;vendor-scorecard-shell&apos;&gt;\n\t&lt;div class=&apos;zcs-card zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16&apos; style=&apos;margin-bottom:14px;&apos;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Scorecard Summary&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-color-primary zcs-lh-heading zcs-m-0&apos;&gt;Status by process area and recommended next action&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;i class=&apos;zcs-font-24 zcs-color-theme zc-li-outline files-single-folded-content&apos;&gt;&lt;/i&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Area&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Current Signal&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Notes&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;4&apos;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Registration&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=vendorStatus%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=registrationClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=vendorStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Vendor master profile and approval status.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Evaluation&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=evaluationScore%&gt; score, &lt;%=evalCount%&gt; records&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=evaluationClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=evaluationStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Finalized evaluations and category scores drive vendor eligibility.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Risk&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=riskLevel%&gt;, &lt;%=riskScore%&gt; score, &lt;%=riskOpenCount%&gt; open&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=riskClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=riskStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Open and mitigation-required risks should be cleared before progression.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Onboarding&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=onboardingCount%&gt; tracker records, &lt;%=onboardingPendingCount%&gt; pending&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=onboardingClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=onboardingStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Bank, contract, compliance, and ERP checks are tracked below.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Documents&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=docCount%&gt; documents, &lt;%=docPendingCount%&gt; pending, &lt;%=docExpiredCount%&gt; expired&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=documentClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=documentStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Verification and expiry status are surfaced in the document report.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Performance&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=performanceScore%&gt; score, &lt;%=perfCount%&gt; reviews&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=performanceClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=performanceStatus%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Weighted review categories feed the performance scorecard.&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-card zcs-p-16 zcs-box-border&apos; style=&apos;margin-top:14px; border-left:4px solid var(--zcs_brand_color);&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-font-18 zcs-color-theme zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-tertiary&apos;&gt;Recommended Next Action&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=recommendedAction%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n}\n%&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Vendor_Documents_Embedded_Dsp' elementName='Vendor_Documents_Embedded'>\n\t<![CDATA[htmlpage Vendor_Documents_Embedded_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Vendor_Documents_Embedded.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Evaluation_Scores_Embedded_Dsp' elementName='Evaluation_Scores_Embedded'>\n\t<![CDATA[htmlpage Evaluation_Scores_Embedded_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Evaluation_Scores_Embedded.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Risk_Assessments_Embedded_Dsp' elementName='Risk_Assessments_Embedded'>\n\t<![CDATA[htmlpage Risk_Assessments_Embedded_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Risk_Assessments_Embedded.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Onboarding_Tracker_Embedded_Dsp' elementName='Onboarding_Tracker_Embedded'>\n\t<![CDATA[htmlpage Onboarding_Tracker_Embedded_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Onboarding_Tracker_Embedded.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Performance_Reviews_Embedded_Dsp' elementName='Performance_Reviews_Embedded'>\n\t<![CDATA[htmlpage Performance_Reviews_Embedded_Dsp()\n\t\tcontent\n\t\t&lt;%{%&gt;\n\t\t\t<file name:Performance_Reviews_Embedded.dshtml/>\n\t\t&lt;%}%&gt;\n\t]]>\n</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Contacts_On_Success as "Contacts On Success"
			{
			    type = form
			    form = Contacts
			    record event = on add or edit
			    description = "Keeps only one primary contact per vendor."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Is_Primary_Contact == true)
			                {
			                    for each  contactRec in Contacts[ID != input.ID && Vendor == input.Vendor]
			                    {
			                        contactRec.Is_Primary_Contact = false;
			                    }
			                }
			            )
			        }
			    }
			}

			Contacts_On_Validate as "Contacts On Validate"
			{
			    type = form
			    form = Contacts
			    record event = on add or edit
			    description = "Validates portal contact state."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Portal_User_Type != "None" && input.Status != "Active")
			                {
			                    alert "Portal contacts must be Active.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Criteria_On_Validate as "Criteria On Validate"
			{
			    type = form
			    form = Criteria
			    record event = on add or edit
			    description = "Validates active scorecard criteria before save."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Status == "Active" && ifnull(input.Applies_To,"") == "")
			                {
			                    alert "Applies To is required for active criteria.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Documents_On_Load as "Documents On Load"
			{
			    type = form
			    form = Documents
			    record event = on add or edit
			    description = "Locks verifier fields and shows rejection reason only when needed."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Verified_By;
			                disable Verified_On;
			                if (input.Verification_Status == "Rejected")
			                {
			                    show Rejection_Reason;
			                }
			                else
			                {
			                    hide Rejection_Reason;
			                }
			            )
			        }
			    }
			}

			Documents_On_Success as "Documents On Success"
			{
			    type = form
			    form = Documents
			    record event = on add or edit
			    description = "Marks documents expired after successful save when the expiry date has passed."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Expiry_Date != null && input.Expiry_Date < zoho.currentdate && input.Verification_Status != "Expired")
			                {
			                    docRec = Documents[ID == input.ID];
			                    if (docRec.count() > 0)
			                    {
			                        docRec.Verification_Status = "Expired";
			                    }
			                }
			            )
			        }
			    }
			}

			Documents_On_Validate as "Documents On Validate"
			{
			    type = form
			    form = Documents
			    record event = on add or edit
			    description = "Validates document dates and rejection details."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Issue_Date != null && input.Expiry_Date != null && input.Expiry_Date < input.Issue_Date)
			                {
			                    alert "Expiry Date cannot be before Issue Date.";
			                    cancel submit;
			                }
			                if (input.Verification_Status == "Rejected" && input.Rejection_Reason in ["", " ", "null"])
			                {
			                    alert "Rejection Reason is required when a document is rejected.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Verification_Status_On_User_Input as "Verification Status On User Input"
			{
			    type = form
			    form = Documents
			    record event = on add or edit
			    description = "Sets verifier metadata and controls rejection reason visibility."
			
			    on user input of Verification_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Verification_Status == "Verified")
			                {
			                    input.Verified_On = zoho.currentdate;
			                    userRec = Users[Email == zoho.loginuserid];
			                    if (userRec.count() > 0)
			                    {
			                        input.Verified_By = userRec.ID;
			                    }
			                    hide Rejection_Reason;
			                }
			                else if (input.Verification_Status == "Rejected")
			                {
			                    show Rejection_Reason;
			                }
			                else
			                {
			                    hide Rejection_Reason;
			                }
			            )
			        }
			    }
			}

			Evaluation_Category_On_User_Input as "Evaluation Category On User Input"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Clears dependent criteria and score values when category changes."
			
			    on user input of Category
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Criteria = null;
			                input.Weight_Percentage = 0;
			                input.Weighted_Score = 0;
			            )
			        }
			    }
			}

			Evaluation_Criteria_On_User_Input as "Evaluation Criteria On User Input"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Loads the active evaluation weight for the selected criterion."
			
			    on user input of Criteria
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Weight_Percentage = 0;
			                input.Weighted_Score = 0;
			                if (input.Criteria != null)
			                {
			                    weightRec = Weightages[Process_Area == "Evaluation" && Criteria == input.Criteria && Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)];
			                    if (weightRec.count() > 0)
			                    {
			                        input.Weight_Percentage = ifnull(weightRec.Weight_Percentage,0);
			                        input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			                    }
			                    else
			                    {
			                        alert "No active Evaluation weightage is configured for this criterion.";
			                    }
			                }
			            )
			        }
			    }
			}

			Evaluation_On_Load as "Evaluation On Load"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Locks computed evaluation fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Weight_Percentage;
			                disable Rating_Score_Percentage;
			                disable Weighted_Score;
			            )
			        }
			    }
			}

			Evaluation_On_Success as "Evaluation On Success"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Aggregates vendor evaluation scores and updates the vendor scorecard."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                totalScore = 0;
			                evalRecords = Evaluation[Vendor == input.Vendor && Evaluation_Cycle == input.Evaluation_Cycle && (Evaluation_Status == "Reviewed" || Evaluation_Status == "Finalized")];
			                if (evalRecords.count() == 0)
			                {
			                    evalRecords = Evaluation[Vendor == input.Vendor && Evaluation_Cycle == input.Evaluation_Cycle && Evaluation_Status == "Submitted"];
			                }
			                for each evalRec in evalRecords
			                {
			                    totalScore = totalScore + ifnull(evalRec.Weighted_Score,0);
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if (vendorRec.count() > 0)
			                {
			                    vendorRec.Evaluation_Score = totalScore;
			                    vendorRec.Last_Evaluation_Date = input.Evaluation_Date;
			                    vendorRec.Overall_Score = (ifnull(vendorRec.Evaluation_Score,0) + ifnull(vendorRec.Risk_Score,0) + ifnull(vendorRec.Performance_Score,0)) / 3;
			                    if (input.Evaluation_Status == "Finalized" && vendorRec.Vendor_Status != "Rejected" && vendorRec.Vendor_Status != "Suspended")
			                    {
			                        vendorRec.Vendor_Status = "Approved";
			                    }
			                    else if (input.Evaluation_Status == "Submitted" || input.Evaluation_Status == "Reviewed")
			                    {
			                        vendorRec.Vendor_Status = "Under Evaluation";
			                    }
			                }
			            )
			        }
			    }
			}

			Evaluation_On_Validate as "Evaluation On Validate"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Validates evaluation readiness and recomputes weighted score."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                critRec = Criteria[ID == input.Criteria];
			                if (critRec.count() > 0 && critRec.Applies_To != "Evaluation")
			                {
			                    alert "Selected criterion is not configured for Evaluation.";
			                    cancel submit;
			                }
			                if (input.Evaluation_Status in {"Submitted","Reviewed","Finalized"})
			                {
			                    if (ifnull(input.Weight_Percentage,0) <= 0)
			                    {
			                        alert "Weight Percentage must be configured before submission.";
			                        cancel submit;
			                    }
			                    if (input.Rating == null)
			                    {
			                        alert "Rating is required before submission.";
			                        cancel submit;
			                    }
			                }
			                input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			            )
			        }
			    }
			}

			Evaluation_Rating_On_User_Input as "Evaluation Rating On User Input"
			{
			    type = form
			    form = Evaluation
			    record event = on add or edit
			    description = "Loads rating score percentage and recalculates weighted score."
			
			    on user input of Rating
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Rating_Score_Percentage = 0;
			                if (input.Rating != null)
			                {
			                    ratingRec = Rating_Scales[ID == input.Rating && Status == "Active" && (Process_Area == "Evaluation" || Process_Area == "General")];
			                    if (ratingRec.count() > 0)
			                    {
			                        input.Rating_Score_Percentage = ifnull(ratingRec.Score_Percentage,0);
			                    }
			                    else
			                    {
			                        alert "Selected rating scale is not active for Evaluation.";
			                    }
			                }
			                input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			            )
			        }
			    }
			}

			Onboarding_On_Load as "Onboarding On Load"
			{
			    type = form
			    form = Onboarding
			    record event = on add or edit
			    description = "Locks system-managed onboarding fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Completion_Date;
			                disable Onboarding_Score;
			            )
			        }
			    }
			}

			Onboarding_On_Success as "Onboarding On Success"
			{
			    type = form
			    form = Onboarding
			    record event = on add or edit
			    description = "Computes onboarding score and updates vendor onboarding status."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                completedChecks = 0;
			                if (input.Bank_Details_Received == true)
			                {
			                    completedChecks = completedChecks + 1;
			                }
			                if (input.Contract_Signed == true)
			                {
			                    completedChecks = completedChecks + 1;
			                }
			                if (input.Compliance_Clearance == true)
			                {
			                    completedChecks = completedChecks + 1;
			                }
			                if (input.ERP_Created == true)
			                {
			                    completedChecks = completedChecks + 1;
			                }
			                score = (completedChecks * 100) / 4;
			                onboardRec = Onboarding[ID == input.ID];
			                if (onboardRec.count() > 0)
			                {
			                    onboardRec.Onboarding_Score = score;
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if (vendorRec.count() > 0)
			                {
			                    if (input.Onboarding_Status == "Completed")
			                    {
			                        vendorRec.Vendor_Status = "Onboarded";
			                    }
			                    else if (input.Onboarding_Status == "Rejected")
			                    {
			                        vendorRec.Vendor_Status = "Rejected";
			                    }
			                    else if (input.Onboarding_Status == "In Progress" || input.Onboarding_Status == "Pending Documents" || input.Onboarding_Status == "Pending Approval")
			                    {
			                        vendorRec.Vendor_Status = "Onboarding";
			                    }
			                }
			            )
			        }
			    }
			}

			Onboarding_On_Validate as "Onboarding On Validate"
			{
			    type = form
			    form = Onboarding
			    record event = on add or edit
			    description = "Validates target dates and completion readiness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Onboarding_Start_Date != null && input.Target_Completion_Date != null && input.Target_Completion_Date < input.Onboarding_Start_Date)
			                {
			                    alert "Target Completion Date cannot be before Onboarding Start Date.";
			                    cancel submit;
			                }
			                if (input.Onboarding_Status == "Completed")
			                {
			                    if (input.Bank_Details_Received == false || input.Contract_Signed == false || input.Compliance_Clearance == false || input.ERP_Created == false)
			                    {
			                        alert "All onboarding checks must be completed before marking onboarding as Completed.";
			                        cancel submit;
			                    }
			                    if (input.Completion_Date == null)
			                    {
			                        input.Completion_Date = zoho.currentdate;
			                    }
			                }
			            )
			        }
			    }
			}

			Onboarding_Status_On_User_Input as "Onboarding Status On User Input"
			{
			    type = form
			    form = Onboarding
			    record event = on add or edit
			    description = "Maintains completion date based on onboarding status."
			
			    on user input of Onboarding_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Onboarding_Status == "Completed")
			                {
			                    input.Completion_Date = zoho.currentdate;
			                }
			                else
			                {
			                    input.Completion_Date = null;
			                }
			            )
			        }
			    }
			}

			Performance_Review_Category_On_User_Input as "Performance Review Category On User Input"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Clears dependent performance criteria and score values when category changes."
			
			    on user input of Category
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Criteria = null;
			                input.Weight_Percentage = 0;
			                input.Weighted_Score = 0;
			            )
			        }
			    }
			}

			Performance_Review_Criteria_On_User_Input as "Performance Review Criteria On User Input"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Loads the active performance review weight for the selected criterion."
			
			    on user input of Criteria
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Weight_Percentage = 0;
			                input.Weighted_Score = 0;
			                if (input.Criteria != null)
			                {
			                    weightRec = Weightages[Process_Area == "Performance Review" && Criteria == input.Criteria && Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)];
			                    if (weightRec.count() > 0)
			                    {
			                        input.Weight_Percentage = ifnull(weightRec.Weight_Percentage,0);
			                        input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			                    }
			                    else
			                    {
			                        alert "No active Performance Review weightage is configured for this criterion.";
			                    }
			                }
			            )
			        }
			    }
			}

			Performance_Review_On_Load as "Performance Review On Load"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Locks computed performance review fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Weight_Percentage;
			                disable Rating_Score_Percentage;
			                disable Weighted_Score;
			            )
			        }
			    }
			}

			Performance_Review_On_Success as "Performance Review On Success"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Aggregates performance scores and refreshes the vendor scorecard."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                totalScore = 0;
			                perfRecords = Performance_Review[Vendor == input.Vendor && Review_Period == input.Review_Period && (Review_Status == "Reviewed" || Review_Status == "Finalized")];
			                if (perfRecords.count() == 0)
			                {
			                    perfRecords = Performance_Review[Vendor == input.Vendor && Review_Period == input.Review_Period && Review_Status == "Submitted"];
			                }
			                for each perfRec in perfRecords
			                {
			                    totalScore = totalScore + ifnull(perfRec.Weighted_Score,0);
			                }
			                vendorRec = Vendors[ID == input.Vendor];
			                if (vendorRec.count() > 0)
			                {
			                    vendorRec.Performance_Score = totalScore;
			                    vendorRec.Last_Performance_Review_Date = input.Review_Date;
			                    vendorRec.Overall_Score = (ifnull(vendorRec.Evaluation_Score,0) + ifnull(vendorRec.Risk_Score,0) + ifnull(vendorRec.Performance_Score,0)) / 3;
			                    if (vendorRec.Risk_Level == "Critical")
			                    {
			                        vendorRec.Vendor_Tier = "Blocked";
			                    }
			                    else if (vendorRec.Overall_Score >= 85 && (vendorRec.Risk_Level == "Low" || vendorRec.Risk_Level == "Medium" || vendorRec.Risk_Level == "Not Assessed"))
			                    {
			                        vendorRec.Vendor_Tier = "Preferred";
			                    }
			                    else if (vendorRec.Overall_Score >= 70)
			                    {
			                        vendorRec.Vendor_Tier = "Approved";
			                    }
			                    else if (vendorRec.Overall_Score >= 50 || vendorRec.Risk_Level == "High")
			                    {
			                        vendorRec.Vendor_Tier = "Conditional";
			                    }
			                    else
			                    {
			                        vendorRec.Vendor_Tier = "Watchlist";
			                    }
			                }
			            )
			        }
			    }
			}

			Performance_Review_On_Validate as "Performance Review On Validate"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Validates performance review readiness and recomputes weighted score."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                critRec = Criteria[ID == input.Criteria];
			                if (critRec.count() > 0 && critRec.Applies_To != "Performance Review")
			                {
			                    alert "Selected criterion is not configured for Performance Review.";
			                    cancel submit;
			                }
			                if (input.Review_Status in {"Submitted","Reviewed","Finalized"} && input.Rating == null)
			                {
			                    alert "Rating is required before submission.";
			                    cancel submit;
			                }
			                if (input.Review_Date != null && input.Next_Review_Date != null && input.Next_Review_Date < input.Review_Date)
			                {
			                    alert "Next Review Date cannot be before Review Date.";
			                    cancel submit;
			                }
			                input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			            )
			        }
			    }
			}

			Performance_Review_Rating_On_User_Input as "Performance Review Rating On User Input"
			{
			    type = form
			    form = Performance_Review
			    record event = on add or edit
			    description = "Loads rating score percentage and recalculates weighted performance score."
			
			    on user input of Rating
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Rating_Score_Percentage = 0;
			                if (input.Rating != null)
			                {
			                    ratingRec = Rating_Scales[ID == input.Rating && Status == "Active" && (Process_Area == "Performance Review" || Process_Area == "General")];
			                    if (ratingRec.count() > 0)
			                    {
			                        input.Rating_Score_Percentage = ifnull(ratingRec.Score_Percentage,0);
			                    }
			                    else
			                    {
			                        alert "Selected rating scale is not active for Performance Review.";
			                    }
			                }
			                input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
			            )
			        }
			    }
			}

			Products_Services_On_Validate as "Products Services On Validate"
			{
			    type = form
			    form = Products_Services
			    record event = on add or edit
			    description = "Validates effective dates and approval readiness."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Effective_From != null && input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To cannot be before Effective From.";
			                    cancel submit;
			                }
			                if (input.Approval_Status == "Approved" && input.Effective_From == null)
			                {
			                    alert "Effective From is required before approval.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Rating_Scales_On_Validate as "Rating Scales On Validate"
			{
			    type = form
			    form = Rating_Scales
			    record event = on add or edit
			    description = "Validates rating value, score range, and active duplicate scale rows."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Rating_Value,0) <= 0)
			                {
			                    alert "Rating Value must be positive.";
			                    cancel submit;
			                }
			                if (ifnull(input.Score_Percentage,0) < 0 || ifnull(input.Score_Percentage,0) > 100)
			                {
			                    alert "Score Percentage must be between 0 and 100.";
			                    cancel submit;
			                }
			                if (input.Status == "Active")
			                {
			                    dup = Rating_Scales[ID != input.ID && Scale_Name == input.Scale_Name && Process_Area == input.Process_Area && Rating_Value == input.Rating_Value && Status == "Active"];
			                    if (dup.count() > 0)
			                    {
			                        alert "An active rating row already exists for this scale, process area, and rating value.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Registration_On_Load as "Registration On Load"
			{
			    type = form
			    form = Registration
			    record event = on add or edit
			    description = "Defaults submitter email and locks system-managed fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Submitted_By_Email in ["", " ", "null"])
			                {
			                    input.Submitted_By_Email = zoho.loginuserid;
