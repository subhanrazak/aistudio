			Vendors_On_Success as "Vendors On Success"
			{
			    type = form
			    form = Vendors
			    record event = on add or edit
			    description = "Assigns vendor tier from overall score and risk level."
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                vendorRec = Vendors[ID == input.ID];
			                if (vendorRec.count() > 0)
			                {
			                    score = ifnull(input.Overall_Score,0);
			                    risk = ifnull(input.Risk_Level,"Not Assessed");
			                    tier = "Unclassified";
			                    if (risk == "Critical")
			                    {
			                        tier = "Blocked";
			                    }
			                    else if (score >= 85 && (risk == "Low" || risk == "Medium" || risk == "Not Assessed"))
			                    {
			                        tier = "Preferred";
			                    }
			                    else if (score >= 70)
			                    {
			                        tier = "Approved";
			                    }
			                    else if (score >= 50 || risk == "High")
			                    {
			                        tier = "Conditional";
			                    }
			                    else
			                    {
			                        tier = "Watchlist";
			                    }
			                    vendorRec.Vendor_Tier = tier;
			                }
			            )
			        }
			    }
			}

			Vendors_On_Validate as "Vendors On Validate"
			{
			    type = form
			    form = Vendors
			    record event = on add or edit
			    description = "Validates vendor status and score ranges."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Vendor_Status != "Prospective" && ifnull(input.Primary_Email,"") == "")
			                {
			                    alert "Primary Email is required once a vendor moves beyond Prospective.";
			                    cancel submit;
			                }
			                if (ifnull(input.Overall_Score,0) < 0 || ifnull(input.Overall_Score,0) > 100 || ifnull(input.Evaluation_Score,0) < 0 || ifnull(input.Evaluation_Score,0) > 100 || ifnull(input.Risk_Score,0) < 0 || ifnull(input.Risk_Score,0) > 100 || ifnull(input.Performance_Score,0) < 0 || ifnull(input.Performance_Score,0) > 100)
			                {
			                    alert "All score fields must be between 0 and 100.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

