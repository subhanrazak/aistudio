		form Products_Services
		{
		    displayname = "Products & Services"
		    success message = "Product or service saved successfully."
		    Section_Product_Service
		    (
		        type = section
		        displayname = "Product Service"
		        row = 1
		        column = 0
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Item_Name
		    (
		        type = text
		        displayname = "Item Name"
		        maxchar = 180
		        row = 1
		        column = 2
		        width = medium
		    )
		    Item_Type
		    (
		        type = picklist
		        displayname = "Item Type"
		        values = {"Product","Service","Both"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Service_Category
