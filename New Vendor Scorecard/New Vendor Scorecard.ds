			Weightages_On_Validate as "Weightages On Validate"
			{
			    type = form
			    form = Weightages
			    record event = on add or edit
			    description = "Validates weight percentages, dates, duplicates, and process totals."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Weight_Percentage,0) <= 0 || ifnull(input.Weight_Percentage,0) > 100)
			                {
			                    alert "Weight Percentage must be greater than 0 and less than or equal to 100.";
			                    cancel submit;
			                }
			                if (input.Effective_From != null && input.Effective_To != null && input.Effective_To < input.Effective_From)
			                {
			                    alert "Effective To cannot be before Effective From.";
			                    cancel submit;
			                }
			                if (input.Status == "Active")
			                {
			                    dup = Weightages[ID != input.ID && Process_Area == input.Process_Area && Criteria == input.Criteria && Status == "Active"];
			                    if (dup.count() > 0)
			                    {
			                        alert "An active weightage already exists for this process and criterion.";
			                        cancel submit;
			                    }
			                    totalWeight = 0;
			                    existingWeights = Weightages[ID != input.ID && Process_Area == input.Process_Area && Status == "Active"];
			                    for each  w in existingWeights
			                    {
			                        totalWeight = totalWeight + ifnull(w.Weight_Percentage,0);
			                    }
			                    totalWeight = totalWeight + ifnull(input.Weight_Percentage,0);
			                    if (totalWeight > 100)
			                    {
			                        alert "Active weightages for this process area cannot exceed 100%. Current total would be " + totalWeight + ".";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Workflow_Configuration_On_Validate as "Workflow Configuration On Validate"
			{
			    type = form
			    form = Workflow_Configuration
			    record event = on add or edit
			    description = "Validates configured process status rows."
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Status_Order,0) < 0)
			                {
			                    alert "Status Order cannot be negative.";
			                    cancel submit;
			                }
			                if (ifnull(input.SLA_Days,0) < 0)
			                {
			                    alert "SLA Days cannot be negative.";
			                    cancel submit;
			                }
			                if (input.Status == "Active")
			                {
			                    dup = Workflow_Configuration[ID != input.ID && Process_Area == input.Process_Area && Status_Name == input.Status_Name && Status == "Active"];
			                    if (dup.count() > 0)
			                    {
			                        alert "An active status already exists for this process area.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Documents_Expiry_Reminder as "Documents Expiry Reminder"
			{
			    type = schedule
			    form = Documents[Expiry_Date is not null]
			    start = Expiry_Date at "09:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                if (input.Expiry_Date != null && input.Expiry_Date < zoho.currentdate && input.Verification_Status != "Expired")
			                {
			                    input.Verification_Status = "Expired";
			                }
			                if (input.Expiry_Date != null && input.Expiry_Date >= zoho.currentdate && input.Expiry_Date <= zoho.currentdate.addDay(30))
			                {
			                    info "Document expiring within 30 days: " + input.ID;
			                }
			            )
			        }
			    }
			}
		}
	}

	customize
	{
	    new theme = 104
	    font = "poppins"
	    color options
	    {
	        color = "104"
