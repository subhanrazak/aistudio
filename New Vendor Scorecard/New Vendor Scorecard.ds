		        type = picklist
		        displayname = "Responsible Profile"
		        values = {"Admin","Procurement Executive","Vendor Evaluator","Register Vendor","Onboarded Vendor"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    SLA_Days
		    (
		        type = number
		        displayname = "SLA Days"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notification_Required
		    (
		        type = checkbox
		        displayname = "Notification Required"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		list Active_Categories
		{
		    displayName = "Active Categories"
		    show all rows from Categories [Status == "Active"]
		    (
		        Category_Code
		        Category_Name
		        Category_Type
		        Display_Order
		    )
		    filters
		    (
		        Category_Type
		    )
		    sort by
		    (
		        Display_Order ascending
		        Category_Name ascending
		    )
		}

		default list All_Categories
		{
		    displayName = "All Categories"
		    show all rows from Categories
		    (
		        Category_Code
		        Category_Name
		        Category_Type
		        Display_Order
		        Status
		    )
		    filters
		    (
		        Category_Type
		        Status
		        "Active Categories" : (Status == "Active")
		        "Inactive Categories" : (Status == "Inactive")
		    )
		    sort by
		    (
		        Display_Order ascending
		        Category_Name ascending
		    )
		}

