application "New-Vendor-Scorecard"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Categories
		{
		    displayname = "Categories"
		    success message = "Category saved successfully."
		    Section_Basic_Info
		    (
		        type = section
		        displayname = "Basic Information"
		        row = 1
		        column = 0
		    )
		    Category_Code
		    (
		        type = autonumber
		        displayname = "Category Code"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Category_Name
		    (
		        type = text
		        displayname = "Category Name"
		        maxchar = 120
		        row = 1
		        column = 1
		        width = medium
		    )
		    Category_Type
		    (
		        type = picklist
		        displayname = "Category Type"
		        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","General"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Display_Order
		    (
		        type = number
		        displayname = "Display Order"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Created_By_Email
		    (
		        type = email
		        displayname = "Created By Email"
		        initial value = "${zoho.loginuserid}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Contacts
		{
		    displayname = "Contacts"
		    success message = "Contact saved successfully."
		    Section_Contact_Info
		    (
		        type = section
		        displayname = "Contact Information"
		        row = 1
		        column = 0
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Contact_Name
		    (
		        type = name
		        displayname = "Contact Name"
		        prefix
		        (
		            type = prefix
		            displayname = "Title"
		            visibility = false
		            value = {"Mr.","Mrs.","Ms.","Dr."}
		        )
		        first_name
		        (
		            type = first_name
		            displayname = "First Name"
		        )
		        last_name
		        (
		            type = last_name
		            displayname = "Last Name"
		        )
		        suffix
		        (
		            type = suffix
		            displayname = "Suffix"
		            visibility = false
		        )
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have unique Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Designation
		    (
		        type = text
		        displayname = "Designation"
		        maxchar = 100
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Type
		    (
		        type = picklist
		        displayname = "Contact Type"
		        values = {"Primary","Commercial","Technical","Compliance","Finance","Escalation","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Is_Primary_Contact
		    (
		        type = checkbox
		        displayname = "Is Primary Contact"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Portal_User_Type
		    (
		        type = picklist
		        displayname = "Portal User Type"
		        values = {"None","Register Vendor","Onboarded Vendor"}
		        initial value = "None"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Criteria
		{
		    displayname = "Criteria"
		    success message = "Criterion saved successfully."
		    Section_Criteria_Info
		    (
		        type = section
		        displayname = "Criteria Information"
		        row = 1
		        column = 0
		    )
		    Criteria_Code
		    (
		        type = autonumber
		        displayname = "Criteria Code"
		        start index = 2001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Categories.ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Criteria_Name
		    (
		        type = text
		        displayname = "Criteria Name"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Applies_To
		    (
		        type = picklist
		        displayname = "Applies To"
		        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Measurement_Type
		    (
		        type = picklist
		        displayname = "Measurement Type"
		        values = {"Rating Scale","Yes/No","Numeric","Text"}
		        initial value = "Rating Scale"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Is_Mandatory
		    (
		        type = checkbox
		        displayname = "Is Mandatory"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Documents
		{
		    displayname = "Documents"
		    success message = "Document saved successfully."
		    Section_Document_Info
		    (
		        type = section
		        displayname = "Document Information"
		        row = 1
		        column = 0
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Document_Type
		    (
		        type = picklist
		        displayname = "Document Type"
		        values = {"Registration","KYC","Tax","Compliance","Contract","Insurance","Quality Certificate","Financial","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Related_Process
		    (
		        type = picklist
		        displayname = "Related Process"
		        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","General"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Document_Number
		    (
		        type = text
		        displayname = "Document Number"
		        maxchar = 100
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Document_File
		    (
		        type = upload file
		        displayname = "Document File"
		        browse = local_drive
		        file count = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Issue_Date
		    (
		        type = date
		        displayname = "Issue Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Expiry_Date
		    (
		        type = date
		        displayname = "Expiry Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Verification_Status
		    (
		        type = picklist
		        displayname = "Verification Status"
		        values = {"Pending","Verified","Rejected","Expired"}
		        initial value = "Pending"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Verified_By
		    (
		        type = picklist
		        displayname = "Verified By"
		        values = Users.ID
		        displayformat = [Email]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Verified_On
		    (
		        type = date
		        displayname = "Verified On"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Rejection_Reason
		    (
		        type = textarea
		        displayname = "Rejection Reason"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Evaluation
		{
		    displayname = "Evaluation"
		    success message = "Evaluation saved successfully."
		    Section_Evaluation_Info
		    (
		        type = section
		        displayname = "Evaluation Information"
		        row = 1
		        column = 0
		    )
		    Evaluation_Number
		    (
		        type = autonumber
		        displayname = "Evaluation Number"
		        start index = 6001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Evaluation_Date
		    (
		        type = date
		        displayname = "Evaluation Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evaluation_Cycle
		    (
		        type = text
		        displayname = "Evaluation Cycle"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    Evaluator
		    (
		        type = picklist
		        displayname = "Evaluator"
		        values = Users.ID
		        displayformat = [Email]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Category
		    (
		        type = picklist
		        displayname = "Category"
		        values = Categories.ID
		        displayformat = [Category_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Criteria
		    (
		        type = picklist
		        displayname = "Criteria"
		        values = Criteria.ID
		        displayformat = [Criteria_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Rating
		    (
		        type = picklist
		        displayname = "Rating"
		        values = Rating_Scales.ID
		        displayformat = [Rating_Label]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Weight_Percentage
		    (
		        type = decimal
		        displayname = "Weight Percentage"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Rating_Score_Percentage
		    (
		        type = decimal
		        displayname = "Rating Score Percentage"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Weighted_Score
		    (
		        type = decimal
		        displayname = "Weighted Score"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evaluation_Status
		    (
		        type = picklist
		        displayname = "Evaluation Status"
		        values = {"Draft","Submitted","Reviewed","Finalized"}
		        initial value = "Draft"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Comments
		    (
		        type = textarea
		        displayname = "Comments"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Onboarding
		{
		    displayname = "Onboarding"
		    success message = "Onboarding record saved successfully."
		    Section_Onboarding_Info
		    (
		        type = section
		        displayname = "Onboarding Information"
		        row = 1
		        column = 0
		    )
		    Onboarding_Number
		    (
		        type = autonumber
		        displayname = "Onboarding Number"
		        start index = 8001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Vendor
		    (
		        type = picklist
		        displayname = "Vendor"
		        values = Vendors.ID
		        displayformat = [Vendor_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Onboarding_Start_Date
		    (
		        type = date
		        displayname = "Onboarding Start Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Assigned_To
		    (
		        type = picklist
		        displayname = "Assigned To"
		        values = Users.ID
		        displayformat = [Email]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Onboarding_Status
		    (
		        type = picklist
		        displayname = "Onboarding Status"
		        values = {"Not Started","In Progress","Pending Documents","Pending Approval","Completed","Rejected"}
		        initial value = "Not Started"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Target_Completion_Date
		    (
		        type = date
		        displayname = "Target Completion Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Completion_Date
		    (
		        type = date
		        displayname = "Completion Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Bank_Details_Received
		    (
		        type = checkbox
		        displayname = "Bank Details Received"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contract_Signed
		    (
		        type = checkbox
		        displayname = "Contract Signed"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Compliance_Clearance
		    (
		        type = checkbox
		        displayname = "Compliance Clearance"
		        initial value = false
		        row = 1
		        column = 2
		        width = medium
		    )
		    ERP_Created
		    (
		        type = checkbox
		        displayname = "ERP Created"
		        initial value = false
		        row = 1
		        column = 1
		        width = medium
		    )
		    Onboarding_Score
		    (
		        type = decimal
		        displayname = "Onboarding Score"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

