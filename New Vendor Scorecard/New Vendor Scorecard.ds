			Risk_Assessment_On_Load as "Risk Assessment On Load"
			{
			    type = form
			    form = Risk_Assessment
			    record event = on add or edit
			    description = "Locks computed risk fields."
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable Weight_Percentage;
			                disable Risk_Score_Percentage;
			                disable Weighted_Risk_Score;
			            )
			        }
			    }
