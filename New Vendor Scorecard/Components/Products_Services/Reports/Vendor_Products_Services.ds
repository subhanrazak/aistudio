default list Vendor_Products_Services
{
    displayName = "Vendor Products Services"
    show all rows from Products_Services
    (
        Vendor
        Item_Name
        Item_Type
        Service_Category
        Criticality
        Approval_Status
        Effective_From
        Effective_To
    )
    filters
    (
        Vendor
        Item_Type
        Criticality
        Approval_Status
    )
    sort by
    (
        Vendor ascending
        Item_Name ascending
    )
}
