list Critical_Products_Services
{
    displayName = "Critical Products Services"
    show all rows from Products_Services
    (
        Vendor
        Item_Name
        Item_Type
        Criticality
        Approval_Status
    )
    filters
    (
        Vendor
        Approval_Status
    )
    sort by
    (
        Vendor ascending
        Criticality descending
        Item_Name ascending
    )
}
