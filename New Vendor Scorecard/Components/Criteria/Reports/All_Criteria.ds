default list All_Criteria
{
    displayName = "All Criteria"
    show all rows from Criteria
    (
        Criteria_Code
        Category
        Criteria_Name
        Applies_To
        Measurement_Type
        Is_Mandatory
        Status
    )
    filters
    (
        Category
        Applies_To
        Status
    )
    sort by
    (
        Category ascending
        Criteria_Name ascending
    )
}
