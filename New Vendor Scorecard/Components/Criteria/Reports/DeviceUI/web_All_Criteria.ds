report All_Criteria
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Criteria_Code
                    Category
                    Criteria_Name
                    Applies_To
                    Measurement_Type
                    Is_Mandatory
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Criteria_Code
                    Category
                    Criteria_Name
                    Applies_To
                    Measurement_Type
                    Is_Mandatory
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
