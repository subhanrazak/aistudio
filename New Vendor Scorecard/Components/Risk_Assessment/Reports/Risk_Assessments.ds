default list Risk_Assessments
{
    displayName = "Risk Assessments"
    show all rows from Risk_Assessment
    (
        Risk_Assessment_Number
        Vendor
        Assessment_Date
        Assessment_Cycle
        Assessor
        Category
        Criteria
        Risk_Rating
        Weighted_Risk_Score
        Risk_Status
    )
    filters
    (
        Vendor
        Assessment_Cycle
        Assessor
        Category
        Risk_Status
    )
    sort by
    (
        Assessment_Date descending
        Vendor ascending
    )
}
