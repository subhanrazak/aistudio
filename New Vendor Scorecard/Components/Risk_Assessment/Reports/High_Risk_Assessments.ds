list High_Risk_Assessments
{
    displayName = "High Risk Assessments"
    show all rows from Risk_Assessment
    (
        Vendor
        Assessment_Date
        Category
        Criteria
        Risk_Rating
        Weighted_Risk_Score
        Mitigation_Action
        Target_Date
        Risk_Status
    )
    filters
    (
        Vendor
        Category
        Risk_Status
    )
    sort by
    (
        Weighted_Risk_Score descending
        Target_Date ascending
    )
}
