form Evaluation
{
    displayname = "Evaluation"
    success message = "Evaluation saved successfully."
    Section_Evaluation_Info
    (
        type = section
        displayname = "Evaluation Information"
        row = 1
        column = 0
    )
    Evaluation_Number
    (
        type = autonumber
        displayname = "Evaluation Number"
        start index = 6001
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Evaluation_Date
    (
        type = date
        displayname = "Evaluation Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Evaluation_Cycle
    (
        type = text
        displayname = "Evaluation Cycle"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Evaluator
    (
        type = picklist
        displayname = "Evaluator"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Category
    (
        type = picklist
        displayname = "Category"
        values = Categories.ID
        displayformat = [Category_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Criteria
    (
        type = picklist
        displayname = "Criteria"
        values = Criteria.ID
        displayformat = [Criteria_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Rating
    (
        type = picklist
        displayname = "Rating"
        values = Rating_Scales.ID
        displayformat = [Rating_Label]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Weight_Percentage
    (
        type = decimal
        displayname = "Weight Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Rating_Score_Percentage
    (
        type = decimal
        displayname = "Rating Score Percentage"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Weighted_Score
    (
        type = decimal
        displayname = "Weighted Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Evaluation_Status
    (
        type = picklist
        displayname = "Evaluation Status"
        values = {"Draft","Submitted","Reviewed","Finalized"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Comments
    (
        type = textarea
        displayname = "Comments"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
