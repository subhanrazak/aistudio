default list Vendor_Evaluations
{
    displayName = "Vendor Evaluations"
    show all rows from Evaluation
    (
        Evaluation_Number
        Vendor
        Evaluation_Date
        Evaluation_Cycle
        Evaluator
        Category
        Criteria
        Rating
        Weight_Percentage
        Weighted_Score
        Evaluation_Status
    )
    filters
    (
        Vendor
        Evaluation_Cycle
        Evaluator
        Category
        Evaluation_Status
    )
    sort by
    (
        Evaluation_Date descending
        Vendor ascending
    )
}
