Evaluation_Category_On_User_Input as "Evaluation Category On User Input"
{
    type = form
    form = Evaluation
    record event = on add or edit
    description = "Clears dependent criteria and score values when category changes."

    on user input of Category
    {
        actions
        {
            custom deluge script
            (
                input.Criteria = null;
                input.Weight_Percentage = 0;
                input.Weighted_Score = 0;
            )
        }
    }
}
