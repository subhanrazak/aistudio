Evaluation_Criteria_On_User_Input as "Evaluation Criteria On User Input"
{
    type = form
    form = Evaluation
    record event = on add or edit
    description = "Loads the active evaluation weight for the selected criterion."

    on user input of Criteria
    {
        actions
        {
            custom deluge script
            (
                input.Weight_Percentage = 0;
                input.Weighted_Score = 0;
                if (input.Criteria != null)
                {
                    weightRec = Weightages[Process_Area == "Evaluation" && Criteria == input.Criteria && Status == "Active" && Effective_From <= zoho.currentdate && (Effective_To == null || Effective_To >= zoho.currentdate)];
                    if (weightRec.count() > 0)
                    {
                        input.Weight_Percentage = ifnull(weightRec.Weight_Percentage,0);
                        input.Weighted_Score = (ifnull(input.Weight_Percentage,0) * ifnull(input.Rating_Score_Percentage,0)) / 100;
                    }
                    else
                    {
                        alert "No active Evaluation weightage is configured for this criterion.";
                    }
                }
            )
        }
    }
}
