Weightages_Category_On_User_Input as "Weightages Category On User Input"
{
    type = form
    form = Weightages
    record event = on add or edit
    description = "Clears criterion when category changes."

    on user input of Category
    {
        actions
        {
            custom deluge script
            (
                input.Criteria = null;
            )
        }
    }
}
