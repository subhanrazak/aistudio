default list Active_Weightages
{
    displayName = "Active Weightages"
    show all rows from Weightages
    (
        Process_Area
        Category
        Criteria
        Weight_Percentage
        Effective_From
        Effective_To
        Status
    )
    filters
    (
        Process_Area
        Category
        Status
    )
    sort by
    (
        Process_Area ascending
        Category ascending
        Criteria ascending
    )
}
