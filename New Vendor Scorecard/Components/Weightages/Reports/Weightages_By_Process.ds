list Weightages_By_Process
{
    displayName = "Weightages By Process"
    show all rows from Weightages
    (
        Process_Area
        Category
        Criteria
        Weight_Percentage
        Status
    )
    filters
    (
        Status
        Category
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Process_Area ascending
        Category ascending
    )
    sort by
    (
        Criteria ascending
    )
}
