list Rating_Scales_By_Process
{
    displayName = "Rating Scales By Process"
    show all rows from Rating_Scales
    (
        Process_Area
        Scale_Name
        Rating_Label
        Rating_Value
        Score_Percentage
        Status
    )
    filters
    (
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Process_Area ascending
    )
    sort by
    (
        Scale_Name ascending
        Rating_Value descending
    )
}
