default list All_Rating_Scales
{
    displayName = "All Rating Scales"
    show all rows from Rating_Scales
    (
        Scale_Name
        Process_Area
        Rating_Label
        Rating_Value
        Score_Percentage
        Risk_Flag
        Status
    )
    filters
    (
        Process_Area
        Status
        Risk_Flag
        "Active Rating Scales" : (Status == "Active")
    )
    sort by
    (
        Process_Area ascending
        Scale_Name ascending
        Rating_Value descending
    )
}
