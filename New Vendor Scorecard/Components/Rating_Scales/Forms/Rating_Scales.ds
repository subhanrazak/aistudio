form Rating_Scales
{
    displayname = "Rating Scales"
    success message = "Rating scale saved successfully."
    Section_Rating_Info
    (
        type = section
        displayname = "Rating Information"
        row = 1
        column = 0
    )
    must have Scale_Name
    (
        type = text
        displayname = "Scale Name"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    Process_Area
    (
        type = picklist
        displayname = "Process Area"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","General"}
        row = 1
        column = 2
        width = medium
    )
    must have Rating_Label
    (
        type = text
        displayname = "Rating Label"
        maxchar = 100
        row = 1
        column = 1
        width = medium
    )
    must have Rating_Value
    (
        type = number
        displayname = "Rating Value"
        row = 1
        column = 2
        width = medium
    )
    must have Score_Percentage
    (
        type = decimal
        displayname = "Score Percentage"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Risk_Flag
    (
        type = picklist
        displayname = "Risk Flag"
        values = {"Low","Medium","High","Critical","Not Applicable"}
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
