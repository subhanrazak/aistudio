default list All_Contacts
{
    displayName = "All Contacts"
    show all rows from Contacts
    (
        Vendor
        Contact_Name
        Contact_Email
        Contact_Phone
        Designation
        Contact_Type
        Is_Primary_Contact
        Portal_User_Type
        Status
    )
    filters
    (
        Vendor
        Contact_Type
        Portal_User_Type
        Status
    )
    sort by
    (
        Vendor ascending
        Contact_Name ascending
    )
}
