list Performance_Scores
{
    displayName = "Performance Scores"
    show all rows from Performance_Review
    (
        Vendor
        Review_Period
        Category
        Criteria
        Weighted_Score
        Review_Status
    )
    filters
    (
        Vendor
        Review_Period
        Category
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Vendor ascending
        Review_Period ascending
    )
    sort by
    (
        Vendor ascending
        Review_Period ascending
        Category ascending
    )
}
