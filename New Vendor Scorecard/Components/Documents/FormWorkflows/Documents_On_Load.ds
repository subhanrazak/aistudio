Documents_On_Load as "Documents On Load"
{
    type = form
    form = Documents
    record event = on add or edit
    description = "Locks verifier fields and shows rejection reason only when needed."

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Verified_By;
                disable Verified_On;
                if (input.Verification_Status == "Rejected")
                {
                    show Rejection_Reason;
                }
                else
                {
                    hide Rejection_Reason;
                }
            )
        }
    }
}
