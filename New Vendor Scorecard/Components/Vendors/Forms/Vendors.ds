form Vendors
{
    displayname = "Vendors"
    success message = "Vendor saved successfully."
    Section_Vendor_Info
    (
        type = section
        displayname = "Vendor Information"
        row = 1
        column = 0
    )
    Vendor_Code
    (
        type = autonumber
        displayname = "Vendor Code"
        start index = 4001
        row = 1
        column = 1
        width = medium
    )
    must have unique Vendor_Name
    (
        type = text
        displayname = "Vendor Name"
        maxchar = 180
        row = 1
        column = 1
        width = medium
    )
    Vendor_Type
    (
        type = picklist
        displayname = "Vendor Type"
        values = {"Manufacturer","Distributor","Service Provider","Consultant","Contractor","Other"}
        row = 1
        column = 2
        width = medium
    )
    Tax_ID
    (
        type = text
        displayname = "Tax ID"
        maxchar = 50
        row = 1
        column = 1
        width = medium
    )
    Website
    (
        type = url
        displayname = "Website"
        row = 1
        column = 2
        width = medium
    )
    Primary_Email
    (
        type = email
        displayname = "Primary Email"
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        row = 1
        column = 2
        width = medium
    )
    Address
    (
        type = address
        displayname = "Address"
        capture_coordinates = true
        adjust_using_map = true
        address_line_1
        (
            type = address_line_1
            displayname = "Street Address"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City"
        )
        state_province
        (
            type = state_province
            displayname = "State"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 1
        column = 1
        width = medium
    )
    Section_Scorecard_Status
    (
        type = section
        displayname = "Scorecard Status"
        visibility = true
        row = 2
        column = 1
    )
    Vendor_Status
    (
        type = picklist
        displayname = "Vendor Status"
        values = {"Prospective","Registered","Under Evaluation","Risk Review","Approved","Onboarding","Onboarded","Suspended","Rejected"}
        initial value = "Prospective"
        row = 2
        column = 1
        width = medium
    )
    Risk_Level
    (
        type = picklist
        displayname = "Risk Level"
        values = {"Low","Medium","High","Critical","Not Assessed"}
        initial value = "Not Assessed"
        row = 2
        column = 2
        width = medium
    )
    Overall_Score
    (
        type = decimal
        displayname = "Overall Score"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Evaluation_Score
    (
        type = decimal
        displayname = "Evaluation Score"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Risk_Score
    (
        type = decimal
        displayname = "Risk Score"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Performance_Score
    (
        type = decimal
        displayname = "Performance Score"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 2
        width = medium
    )
    Last_Evaluation_Date
    (
        type = date
        displayname = "Last Evaluation Date"
        row = 2
        column = 1
        width = medium
    )
    Last_Performance_Review_Date
    (
        type = date
        displayname = "Last Performance Review Date"
        row = 2
        column = 2
        width = medium
    )
    Vendor_Tier
    (
        type = picklist
        displayname = "Vendor Tier"
        values = {"Preferred","Approved","Conditional","Watchlist","Blocked","Unclassified"}
        initial value = "Unclassified"
        row = 2
        column = 1
        width = medium
    )
    Internal_Notes
    (
        type = textarea
        displayname = "Internal Notes"
        height = 120px
        row = 2
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
