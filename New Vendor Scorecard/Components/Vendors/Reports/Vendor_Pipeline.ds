kanban Vendor_Pipeline
{
    displayName = "Vendor Pipeline"
    show all rows from Vendors
    (
        Vendor_Code
        Vendor_Name
        Vendor_Type
        Vendor_Status
        Risk_Level
        Overall_Score
        Vendor_Tier
    )
    filters
    (
        Vendor_Type
        Risk_Level
        Vendor_Tier
    )
    sort by
    (
        Overall_Score descending
        Vendor_Name ascending
    )
    options
    (
        display field = Vendor_Status
        emptycolumn = "No Status"
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}
