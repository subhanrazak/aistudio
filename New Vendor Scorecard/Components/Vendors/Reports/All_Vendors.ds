default list All_Vendors
{
    displayName = "All Vendors"
    show all rows from Vendors
    (
        Vendor_Code
        Vendor_Name
        Vendor_Type
        Primary_Email
        Phone
        Vendor_Status
        Risk_Level
        Overall_Score
        Vendor_Tier
    )
    filters
    (
        Vendor_Type
        Vendor_Status
        Risk_Level
        Vendor_Tier
    )
    sort by
    (
        Vendor_Name ascending
    )
}
