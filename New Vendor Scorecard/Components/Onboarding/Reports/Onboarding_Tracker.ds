default list Onboarding_Tracker
{
    displayName = "Onboarding Tracker"
    show all rows from Onboarding
    (
        Onboarding_Number
        Vendor
        Onboarding_Start_Date
        Assigned_To
        Onboarding_Status
        Target_Completion_Date
        Completion_Date
        Bank_Details_Received
        Contract_Signed
        Compliance_Clearance
        ERP_Created
    )
    filters
    (
        Vendor
        Assigned_To
        Onboarding_Status
    )
    sort by
    (
        Target_Completion_Date ascending
        Vendor ascending
    )
}
