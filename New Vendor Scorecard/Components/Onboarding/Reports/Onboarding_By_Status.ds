kanban Onboarding_By_Status
{
    displayName = "Onboarding By Status"
    show all rows from Onboarding
    (
        Onboarding_Number
        Vendor
        Assigned_To
        Onboarding_Status
        Target_Completion_Date
        Completion_Date
    )
    filters
    (
        Assigned_To
        Vendor
    )
    sort by
    (
        Target_Completion_Date ascending
        Vendor ascending
    )
    options
    (
        display field = Onboarding_Status
        emptycolumn = "No Status"
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}
