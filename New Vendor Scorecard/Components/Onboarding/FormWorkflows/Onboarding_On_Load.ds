Onboarding_On_Load as "Onboarding On Load"
{
    type = form
    form = Onboarding
    record event = on add or edit
    description = "Locks system-managed onboarding fields."

    on load
    {
        actions
        {
            custom deluge script
            (
                disable Completion_Date;
                disable Onboarding_Score;
            )
        }
    }
}
