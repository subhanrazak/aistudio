form Onboarding
{
    displayname = "Onboarding"
    success message = "Onboarding record saved successfully."
    Section_Onboarding_Info
    (
        type = section
        displayname = "Onboarding Information"
        row = 1
        column = 0
    )
    Onboarding_Number
    (
        type = autonumber
        displayname = "Onboarding Number"
        start index = 8001
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Onboarding_Start_Date
    (
        type = date
        displayname = "Onboarding Start Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Assigned_To
    (
        type = picklist
        displayname = "Assigned To"
        values = Users.ID
        displayformat = [Email]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Onboarding_Status
    (
        type = picklist
        displayname = "Onboarding Status"
        values = {"Not Started","In Progress","Pending Documents","Pending Approval","Completed","Rejected"}
        initial value = "Not Started"
        row = 1
        column = 1
        width = medium
    )
    Target_Completion_Date
    (
        type = date
        displayname = "Target Completion Date"
        row = 1
        column = 2
        width = medium
    )
    Completion_Date
    (
        type = date
        displayname = "Completion Date"
        row = 1
        column = 1
        width = medium
    )
    Bank_Details_Received
    (
        type = checkbox
        displayname = "Bank Details Received"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Contract_Signed
    (
        type = checkbox
        displayname = "Contract Signed"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Compliance_Clearance
    (
        type = checkbox
        displayname = "Compliance Clearance"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    ERP_Created
    (
        type = checkbox
        displayname = "ERP Created"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Onboarding_Score
    (
        type = decimal
        displayname = "Onboarding Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
