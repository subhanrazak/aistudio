form Categories
{
    displayname = "Categories"
    success message = "Category saved successfully."
    Section_Basic_Info
    (
        type = section
        displayname = "Basic Information"
        row = 1
        column = 0
    )
    Category_Code
    (
        type = autonumber
        displayname = "Category Code"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have unique Category_Name
    (
        type = text
        displayname = "Category Name"
        maxchar = 120
        row = 1
        column = 1
        width = medium
    )
    Category_Type
    (
        type = picklist
        displayname = "Category Type"
        values = {"Registration","Evaluation","Risk Assessment","Onboarding","Performance Review","General"}
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Display_Order
    (
        type = number
        displayname = "Display Order"
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Created_By_Email
    (
        type = email
        displayname = "Created By Email"
        initial value = "${zoho.loginuserid}"
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
