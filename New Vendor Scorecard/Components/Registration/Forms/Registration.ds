form Registration
{
    displayname = "Registration"
    success message = "Registration saved successfully."
    Section_Registration_Info
    (
        type = section
        displayname = "Registration Information"
        row = 1
        column = 0
    )
    Registration_Number
    (
        type = autonumber
        displayname = "Registration Number"
        start index = 5001
        row = 1
        column = 1
        width = medium
    )
    must have Vendor
    (
        type = picklist
        displayname = "Vendor"
        values = Vendors.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Registration_Date
    (
        type = date
        displayname = "Registration Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Submitted_By_Email
    (
        type = email
        displayname = "Submitted By Email"
        row = 1
        column = 2
        width = medium
    )
    Registration_Status
    (
        type = picklist
        displayname = "Registration Status"
        values = {"Draft","Submitted","Under Review","Clarification Required","Accepted","Rejected"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    Business_Summary
    (
        type = textarea
        displayname = "Business Summary"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Years_In_Business
    (
        type = number
        displayname = "Years In Business"
        row = 1
        column = 1
        width = medium
    )
    Annual_Turnover
    (
        type = decimal
        displayname = "Annual Turnover"
        decimalplace = 2
        row = 1
        column = 2
        width = medium
    )
    Employee_Count
    (
        type = number
        displayname = "Employee Count"
        row = 1
        column = 1
        width = medium
    )
    Declaration_Accepted
    (
        type = checkbox
        displayname = "Declaration Accepted"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Registration_Score
    (
        type = decimal
        displayname = "Registration Score"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    Reviewer_Comments
    (
        type = textarea
        displayname = "Reviewer Comments"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
