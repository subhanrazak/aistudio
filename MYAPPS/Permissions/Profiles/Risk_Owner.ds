"Risk_Owner"
{
    name        = "Risk_Owner"
    type        = Users_Permissions
    permissions = { Chat:true, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Risk owner profile for assigned risk, observation, remediation, and follow-up updates."

    ModulePermissions
    {
        Risk_Register
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Risk_Code{visibility:true,readonly:true}
                Risk_Title{visibility:true,readonly:true}
                Risk_Description{visibility:true,readonly:true}
                Business_Unit_Entity{visibility:true,readonly:true}
                Auditable_Entity{visibility:true,readonly:true}
                Process_Function_Area{visibility:true,readonly:true}
                Objective_Linked{visibility:true,readonly:true}
                Risk_Category{visibility:true,readonly:true}
                Risk_Sub_Category{visibility:true,readonly:true}
                Risk_Owner{visibility:true,readonly:true}
                Risk_Coordinators{visibility:true,readonly:true}
                Requested_By{visibility:false}
                Escalation_Owner{visibility:true,readonly:true}
                Reviewer_Approver{visibility:true,readonly:true}
                Impact_Level{visibility:true,readonly:true}
                Likelihood{visibility:true,readonly:true}
                Inherent_Risk_Score{visibility:true,readonly:true}
                Control_Effectiveness{visibility:true,readonly:true}
                Control_Effectiveness_Score{visibility:true,readonly:true}
                Residual_Risk_Score{visibility:true,readonly:true}
                Residual_Risk_Rating{visibility:true,readonly:true}
                Mapped_Controls{visibility:true,readonly:true}
                Risk_Treatment{visibility:true,readonly:true}
                Target_Residual_Risk{visibility:true,readonly:true}
                Review_Frequency{visibility:true,readonly:true}
                Next_Review_Date{visibility:true,readonly:true}
                Risk_Appetite_Alignment{visibility:true,readonly:true}
                Mitigation_Plans{visibility:true,readonly:true}
                Linked_Regulations{visibility:true,readonly:true}
                Audit_Coverage{visibility:true,readonly:true}
                Additional_Notes{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Attachments{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Risks={"View"}
                High_Residual_Risks={"View"}
                Risks_Due_For_Review={"View"}
                Risk_Status_Kanban={"View"}
                Risk_Library_Cards={"View"}
            }
        }
        Audit_Observations
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Observation_ID{visibility:true,readonly:true}
                Audit{visibility:true,readonly:true}
                Observation_Template{visibility:true,readonly:true}
                Related_Test_Execution{visibility:true,readonly:true}
                Observation_Title{visibility:true,readonly:true}
                Observation_Description{visibility:true,readonly:true}
                Observation_Type{visibility:true,readonly:true}
                Severity{visibility:true,readonly:true}
                Risk_Category{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Observation_Owner{visibility:true,readonly:true}
                Root_Cause_Analysis{visibility:true,readonly:true}
                Impact_Assessment{visibility:true,readonly:true}
                Recommendations{visibility:true,readonly:true}
                Evidence_Upload{visibility:true,readonly:true}
                Action_Plan_Required{visibility:true,readonly:true}
                Target_Closure_Date{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Reviewer{visibility:false}
                Accepted_Date{visibility:false}
                Closed_Date{visibility:false}
                Version_Notes{visibility:false}
            }
            ReportPermissions
            {
                All_Audit_Observations={"View"}
                Open_Observations={"View"}
                Observations_By_Status={"View"}
                Observation_Due_Calendar={"View"}
                High_Severity_Observations={"View"}
            }
        }
        Remediation_Tasks
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = false
            FieldPermissions
            {
                Task_ID{visibility:true,readonly:true}
                Task_Name{visibility:true,readonly:true}
                Task_Source{visibility:true,readonly:true}
                Linked_Observation{visibility:true,readonly:true}
                Priority{visibility:true,readonly:true}
                Task_Owner{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Due_Date{visibility:true,readonly:true}
                Status{visibility:true,readonly:false}
                Notes_Task_Description{visibility:true,readonly:true}
                Completion_Percent{visibility:true,readonly:false}
                Completion_Evidence{visibility:true,readonly:false}
                Verified_By{visibility:true,readonly:true}
                Verified_Date{visibility:true,readonly:true}
                Closure_Notes{visibility:true,readonly:false}
            }
            ReportPermissions
            {
                Open_Remediation_Tasks={"View"}
                Tasks_By_Status={"View"}
                Task_Due_Calendar={"View"}
                Overdue_Tasks={"View"}
                Task_Library={"View"}
            }
        }
        Follow_Ups
        {
            enabled = Viewall,Modifyall,Tab,View,Edit,Search,read_comm,write_comm
            allFieldsVisible = false
            FieldPermissions
            {
                Follow_Up_ID{visibility:true,readonly:true}
