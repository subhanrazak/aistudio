                Responsible_Department{visibility:true,readonly:true}
                Observation_Finding{visibility:true,readonly:true}
                Risk_Implication{visibility:true,readonly:true}
                Risk_Category{visibility:true,readonly:true}
                Risk_Owner{visibility:true,readonly:true}
                Responsible_Person{visibility:true,readonly:true}
                Priority{visibility:true,readonly:true}
                Status{visibility:true,readonly:false}
                Original_Due_Date{visibility:true,readonly:true}
                Revised_Due_Date{visibility:true,readonly:true}
                Due_Date{visibility:true,readonly:true}
                Completion_Percent{visibility:true,readonly:false}
                Last_Updated{visibility:true,readonly:true}
                Action_Owner{visibility:true,readonly:true}
                Action_Plan{visibility:true,readonly:true}
                Current_Status{visibility:true,readonly:false}
                Notes{visibility:true,readonly:false}
            }
            ReportPermissions
            {
                Follow_Up_Schedule={"View"}
                Follow_Up_Calendar={"View"}
                Follow_Up_Tracker={"View"}
                Overdue_Follow_Ups={"View"}
                Follow_Up_Status_Kanban={"View"}
            }
        }
        Departments
        {
            enabled = Viewall,View,Search
            allFieldsVisible = false
            FieldPermissions
            {
                Department_Code{visibility:true,readonly:true}
                Department_Name{visibility:true,readonly:true}
                Department_Type{visibility:true,readonly:true}
                Parent_Department{visibility:true,readonly:true}
                Department_Head{visibility:true,readonly:true}
                Contact_Email{visibility:false}
                Risk_Profile{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Description{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Departments={"View"}
                Active_Departments={"View"}
                Department_Risk_Profile={"View"}
            }
        }
        Risk_Register_Dashboard
        {
            enabled = tab
        }
        Follow_Up_Tracker_Dashboard
        {
            enabled = tab
        }
    }
}