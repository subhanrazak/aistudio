"Executive_Viewer"
{
    name        = "Executive_Viewer"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Executive read-only profile for dashboards, approved plans, risk summaries, and follow-up analytics."

    ModulePermissions
    {
        Audit_Plans
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Plan_Code{visibility:true,readonly:true}
                Plan_Name{visibility:true,readonly:true}
                Prepared_By{visibility:true,readonly:true}
                Department{visibility:true,readonly:true}
                Created_Date{visibility:true,readonly:true}
                Approval_Level{visibility:true,readonly:true}
                Priority_for_Implementation{visibility:true,readonly:true}
                Comments_Notes{visibility:true,readonly:true}
                Planning_Year{visibility:true,readonly:true}
                Selected_Entities_Count{visibility:true,readonly:true}
                Total_Audit_Days{visibility:true,readonly:true}
                Average_Risk_Score{visibility:true,readonly:true}
                Plan_Size{visibility:true,readonly:true}
                Planned_Coverage_Percent{visibility:true,readonly:true}
                Resource_Requirement{visibility:true,readonly:true}
                Q1_Intensity_Percent{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Submitted_Date{visibility:true,readonly:true}
                Approved_Date{visibility:true,readonly:true}
                Approved_By{visibility:true,readonly:true}
                Rework_Comments{visibility:true,readonly:true}
                Validation_Message{visibility:false}
            }
            ReportPermissions
            {
                All_Audit_Plans={"View"}
                Upcoming_Audits={"View"}
                Audit_Plans_By_Year={"View"}
                Audit_Plan_Status_Board={"View"}
            }
        }
        Audits
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Audit_Code{visibility:true,readonly:true}
                Audit_Title{visibility:true,readonly:true}
                Audit_Type{visibility:true,readonly:true}
                Auditable_Entity_Department{visibility:true,readonly:true}
                Source_Plan{visibility:true,readonly:true}
                Status{visibility:true,readonly:true}
                Stage{visibility:true,readonly:true}
                Planned_Start{visibility:true,readonly:true}
                Planned_End{visibility:true,readonly:true}
                Actual_Start{visibility:true,readonly:true}
                Actual_End{visibility:true,readonly:true}
                Risk_Rating{visibility:true,readonly:true}
                Audit_Size{visibility:true,readonly:true}
                Audit_Objective_Scope{visibility:true,readonly:true}
                Lead_Auditor{visibility:true,readonly:true}
                Audit_Team_Size{visibility:true,readonly:true}
