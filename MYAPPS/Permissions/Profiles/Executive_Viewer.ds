                All_Audit_Observations={"View"}
                Open_Observations={"View"}
                Observations_By_Status={"View"}
                Observation_Due_Calendar={"View"}
                High_Severity_Observations={"View"}
            }
        }
        Internal_Audit_Dashboard
        {
            enabled = tab
        }
        Risk_Register_Dashboard
        {
            enabled = tab
        }
        Audit_Dashboard
        {
            enabled = tab
        }
        Follow_Up_Tracker_Dashboard
        {
            enabled = tab
        }
