                All_Audits={"View"}
                Active_Audits={"View"}
                Audit_Calendar={"View"}
                Audit_Status_Board={"View"}
                Completed_Audits={"View"}
            }
        }
        Risk_Register
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Risk_Code{visibility:true,readonly:true}
                Risk_Title{visibility:true,readonly:true}
                Risk_Description{visibility:true,readonly:true}
                Business_Unit_Entity{visibility:true,readonly:true}
                Auditable_Entity{visibility:true,readonly:true}
                Process_Function_Area{visibility:true,readonly:true}
                Objective_Linked{visibility:true,readonly:true}
                Risk_Category{visibility:true,readonly:true}
