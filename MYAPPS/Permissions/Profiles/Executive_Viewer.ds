        Follow_Ups
        {
            enabled = Viewall,Tab,View,Search,Export
            allFieldsVisible = false
            FieldPermissions
            {
                Follow_Up_ID{visibility:true,readonly:true}
                Source_Audit{visibility:true,readonly:true}
                Audit_Name{visibility:true,readonly:true}
                Observation{visibility:true,readonly:true}
