                Residual_Risk_Score{visibility:true,readonly:true}
                Residual_Risk_Rating{visibility:true,readonly:true}
                Mapped_Controls{visibility:true,readonly:true}
                Risk_Treatment{visibility:true,readonly:true}
                Target_Residual_Risk{visibility:true,readonly:true}
                Review_Frequency{visibility:true,readonly:true}
                Next_Review_Date{visibility:true,readonly:true}
                Risk_Appetite_Alignment{visibility:true,readonly:true}
                Mitigation_Plans{visibility:true,readonly:true}
                Linked_Regulations{visibility:true,readonly:true}
                Audit_Coverage{visibility:true,readonly:true}
                Additional_Notes{visibility:true,readonly:true}
