customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header, .zc-header { background: #fff7f8; border-bottom: 3px solid #ff2f3f; } .zc-menu, .zc-navigation { background: #fffafa; } .zc-menu .active, .zc-navigation .active { color: #ff2f3f; border-left: 3px solid #ff2f3f; } .zc-button-primary, .zc-formbutton-submit { background: #ff2f3f; border-color: #ff2f3f; color: #ffffff; } body, .zc-page-content { background: #fff7f8; }"
    }
}