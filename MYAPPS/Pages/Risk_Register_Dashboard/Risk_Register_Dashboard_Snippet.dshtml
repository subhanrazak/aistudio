<%
allRisks = Risk_Register[ID != 0];
allCount = allRisks.count();
mitigateCount = Risk_Register[Risk_Treatment == "Mitigate"].count();
acceptCount = Risk_Register[Risk_Treatment == "Accept"].count();
escalatedCount = Risk_Register[Status == "Escalated" || Risk_Treatment == "Escalate"].count();
highResidualCount = Risk_Register[Residual_Risk_Rating == "High" || Residual_Risk_Rating == "Critical"].count();

highestRiskID = 0;
highestRiskCode = "-";
highestRiskTitle = "No risk selected";
highestRiskDescription = "The highest residual risk card will appear after risk records are available.";
highestRiskOwner = "Unassigned";
highestRiskStatus = "Not Started";
highestRiskTreatment = "Pending";
highestRiskRating = "Not Rated";
highestRiskScore = 0;
highestRiskReview = "Not scheduled";
highestRiskUnit = "Not assigned";
for each topRisk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc
{
    if(highestRiskID == 0)
    {
        highestRiskID = topRisk.ID;
        highestRiskCode = ifnull(topRisk.Risk_Code,"-");
        highestRiskTitle = ifnull(topRisk.Risk_Title,"Untitled risk");
        highestRiskDescription = ifnull(topRisk.Risk_Description,"No description captured.");
        highestRiskOwner = ifnull(topRisk.Risk_Owner,"Unassigned");
        highestRiskStatus = ifnull(topRisk.Status,"Draft");
        highestRiskTreatment = ifnull(topRisk.Risk_Treatment,"Pending");
        highestRiskRating = ifnull(topRisk.Residual_Risk_Rating,"Not Rated");
        highestRiskScore = ifnull(topRisk.Residual_Risk_Score,0);
        highestRiskReview = ifnull(topRisk.Next_Review_Date,"Not scheduled");
        highestRiskUnit = ifnull(topRisk.Business_Unit_Entity,"Not assigned");
    }
}

highPct = 0;
if(allCount > 0)
{
    highPct = (highResidualCount * 100) / allCount;
}
%>
<style>
/* ZCS global utility subset included once for this page. */
:root {
    --zcs-theme-brand-color: var(--zcs_brand_color);
    --zcs-light-bg-color: var(--zcs_brand_light_color);
    --zcs-primary-text-color: var(--zcs_primary_text_color);
    --zcs-secondary-text-color: var(--zcs_secondary_text_color);
    --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
    --zcs-border-color: var(--zcs_tertiary_border_color);
    --zcs-white-color: #FFFFFF;
    --zcs-page-bg-color: #F3F3F4;
    font-size: 16px;
    line-height: 1.5;
}
.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-25{padding:1.5625rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none;color:inherit}#splash-screen{display:none!important}

/* ZCS component CSS: buttons, badges, table, progress, avatar. */
.zcs-button{width:auto;min-width:5rem;min-height:36px;transition:background-color .18s ease,border-color .18s ease,color .18s ease}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px;font-style:normal}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius);color:var(--zcs_brand_foreground_color);font-weight:700}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;z-index:2}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr.risk-row-hidden{display:none}.zcs-table-wrapper table tbody tr.risk-empty-row{display:none}.zcs-table-wrapper table tbody tr.risk-empty-row.show{display:table-row}.zcs-green{color:#179E6C}.zcs-red{color:#FE455D}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094C5}.zcs-blue{color:#09598E}

/* Page-specific layout. */
.risk-dashboard-shell{background:var(--zcs-page-bg-color);min-height:100vh;padding:20px;box-sizing:border-box;color:var(--zcs-primary-text-color)}
.risk-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:18px;padding:22px 24px;display:flex;justify-content:space-between;gap:18px;align-items:center;box-shadow:0 12px 34px rgba(20,20,60,.14)}
.risk-hero-title{font-size:26px;font-weight:700;line-height:1.15;margin:0 0 6px}.risk-hero-subtitle{font-size:14px;line-height:1.45;margin:0;max-width:760px;opacity:.88}.risk-hero-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.risk-hero .zcs-primary-button{background:#fff;color:var(--zcs_brand_color)}.risk-hero .zcs-primary-button:hover{background:rgba(255,255,255,.88)}.risk-hero .zcs-primary-outline-button{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.08);color:#fff}.risk-hero .zcs-primary-outline-button:hover{background:rgba(255,255,255,.16);color:#fff}
.risk-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:16px}.risk-kpi{padding:18px;border-radius:16px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;transition:transform .18s ease,box-shadow .18s ease}.risk-kpi:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(20,20,60,.08)}.risk-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin:0 0 8px}.risk-kpi-value{font-size:30px;line-height:1;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.risk-kpi-meta{font-size:12px;margin-top:8px;color:var(--zcs-teritiary-text-color)}.risk-kpi-icon{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:20px}.risk-kpi.warning .risk-kpi-icon{background:#FCF4E6;color:#b8770d}.risk-kpi.danger .risk-kpi-icon{background:#FDE3E6;color:#FE455D}.risk-kpi.success .risk-kpi-icon{background:#E4FCF3;color:#179E6C}
.risk-filter-card{margin-top:16px;padding:16px;border-radius:16px}.risk-filter-row{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr auto;gap:10px;align-items:end}.risk-field label{display:block;font-size:12px;font-weight:600;color:var(--zcs-secondary-text-color);margin-bottom:6px}.risk-field input,.risk-field select{width:100%;height:38px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;color:var(--zcs-primary-text-color);padding:0 11px;box-sizing:border-box;outline:none}.risk-field input:focus,.risk-field select:focus{border-color:var(--zcs_brand_color);box-shadow:0 0 0 3px var(--zcs_brand_light_color)}.risk-results-count{font-size:13px;color:var(--zcs-secondary-text-color);padding-bottom:9px;white-space:nowrap}.risk-report-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.risk-report-links a{font-size:13px;border:1px solid var(--zcs-border-color);border-radius:999px;padding:7px 11px;background:#fff;color:var(--zcs-secondary-text-color)}.risk-report-links a:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}
.risk-main-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;margin-top:16px;align-items:start}.risk-section-card{padding:18px;border-radius:16px}.risk-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.risk-section-title{font-size:18px;font-weight:700;line-height:1.25;margin:0}.risk-section-note{font-size:13px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.risk-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.risk-card-grid .risk-empty-card{display:none}.risk-card-grid .risk-empty-card.show{display:block}.risk-card{border:1px solid var(--zcs-border-color);background:#fff;border-radius:14px;padding:14px;box-sizing:border-box;display:flex;flex-direction:column;gap:12px;min-height:210px}.risk-card.risk-card-hidden{display:none}.risk-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.risk-code{font-size:12px;color:var(--zcs-teritiary-text-color);font-weight:600}.risk-card-title{font-size:16px;line-height:1.25;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.risk-card-desc{font-size:13px;line-height:1.45;color:var(--zcs-secondary-text-color);margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:56px}.risk-card-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto}.risk-owner-mini{display:flex;align-items:center;gap:8px;min-width:0}.risk-owner-mini .zcs-avatar{--zcs-avatar-size:28px;--zcs-avatar-radius:50%;font-size:12px}.risk-owner-name{font-size:13px;color:var(--zcs-secondary-text-color);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.risk-rating-red .zcs-progress-bar-indicator{background:#FE455D}.risk-rating-orange .zcs-progress-bar-indicator{background:#F4660C}.risk-rating-yellow .zcs-progress-bar-indicator{background:#FAAE13}.risk-rating-green .zcs-progress-bar-indicator{background:#179E6C}.risk-rating-grey .zcs-progress-bar-indicator{background:#878895}.risk-score-text{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--zcs-secondary-text-color);margin-top:6px}
.risk-side-stack{display:flex;flex-direction:column;gap:16px}.risk-detail-card{padding:18px;border-radius:16px}.risk-detail-header{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.risk-detail-title{font-size:18px;font-weight:700;line-height:1.25;margin:6px 0 8px}.risk-detail-desc{font-size:13px;line-height:1.45;color:var(--zcs-secondary-text-color);margin:0 0 14px}.risk-key-values{display:grid;grid-template-columns:1fr 1fr;gap:10px}.risk-kv{border:1px solid var(--zcs-border-color);border-radius:12px;padding:10px;background:#FBFCFE}.risk-kv-label{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--zcs-teritiary-text-color);margin:0 0 4px}.risk-kv-value{font-size:13px;color:var(--zcs-primary-text-color);font-weight:600;margin:0}.risk-timeline{display:flex;flex-direction:column;gap:12px;margin-top:12px}.risk-timeline-item{display:flex;gap:10px;align-items:flex-start}.risk-timeline-dot{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:13px;flex:0 0 26px}.risk-timeline-text{font-size:13px;color:var(--zcs-secondary-text-color);line-height:1.35}.risk-residual-summary{padding:16px;border-radius:16px}.risk-residual-big{font-size:30px;font-weight:700;line-height:1;color:var(--zcs-primary-text-color);margin:0}.risk-table-card{margin-top:16px;padding:18px;border-radius:16px}.risk-table-wrapper{max-height:520px}.risk-table-wrapper th,.risk-table-wrapper td{font-size:13px}.risk-table-title-cell{min-width:220px}.risk-nowrap{white-space:nowrap}.risk-no-data{text-align:center;padding:24px;color:var(--zcs-secondary-text-color);border:1px dashed var(--zcs-border-color);border-radius:14px;background:#FBFCFE}
@media (max-width:1280px){.risk-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.risk-main-grid{grid-template-columns:1fr}.risk-side-stack{display:grid;grid-template-columns:1fr 1fr}.risk-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:860px){.risk-dashboard-shell{padding:14px}.risk-hero{align-items:flex-start;flex-direction:column}.risk-hero-actions{justify-content:flex-start}.risk-filter-row{grid-template-columns:1fr}.risk-results-count{padding-bottom:0}.risk-card-grid{grid-template-columns:1fr}.risk-side-stack{display:flex}.risk-kpi-grid{grid-template-columns:1fr}.risk-key-values{grid-template-columns:1fr}}
</style>

<div class="risk-dashboard-shell">
    <section class="risk-hero">
        <div>
            <h1 class="risk-hero-title">Risk Register Dashboard</h1>
            <p class="risk-hero-subtitle">Library-style risk register view with current treatment counts, residual risk concentration, searchable cards, and a tabular risk list aligned to the Risk Register reports.</p>
        </div>
        <div class="risk-hero-actions">
            <a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Risk_Register?zc_LoadIn=dialog&amp;zc_Header=true">
                <i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
                <span class="zcs-button-text">Add Risk</span>
            </a>
            <a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:All_Risks">
                <i class="zcs-button-icon zc-li-outline files-2-archive-paper"></i>
                <span class="zcs-button-text">Open Register</span>
            </a>
        </div>
    </section>

    <section class="risk-kpi-grid">
        <a class="risk-kpi zcs-card" href="#Report:All_Risks">
            <div>
                <p class="risk-kpi-label">All Risks</p>
                <p class="risk-kpi-value"><%=allCount%></p>
                <div class="risk-kpi-meta">Complete risk library population</div>
            </div>
            <div class="risk-kpi-icon"><i class="zc-li-outline files-2-paper"></i></div>
        </a>
        <a class="risk-kpi warning zcs-card" href="#Report:All_Risks?Risk_Treatment=Mitigate">
            <div>
                <p class="risk-kpi-label">Mitigate</p>
                <p class="risk-kpi-value"><%=mitigateCount%></p>
                <div class="risk-kpi-meta">Treatment plans requiring tracking</div>
            </div>
            <div class="risk-kpi-icon"><i class="zc-li-outline ui-1-settings-gear-63"></i></div>
        </a>
        <a class="risk-kpi success zcs-card" href="#Report:All_Risks?Risk_Treatment=Accept">
            <div>
                <p class="risk-kpi-label">Accept</p>
                <p class="risk-kpi-value"><%=acceptCount%></p>
                <div class="risk-kpi-meta">Accepted within defined appetite</div>
            </div>
            <div class="risk-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div>
        </a>
        <a class="risk-kpi danger zcs-card" href="#Report:High_Residual_Risks">
            <div>
                <p class="risk-kpi-label">Escalated</p>
                <p class="risk-kpi-value"><%=escalatedCount%></p>
                <div class="risk-kpi-meta">Escalations and critical attention</div>
            </div>
            <div class="risk-kpi-icon"><i class="zc-li-outline ui-2-alert-circle-i"></i></div>
        </a>
    </section>

    <section class="risk-filter-card zcs-card">
        <div class="risk-filter-row">
            <div class="risk-field">
                <label for="riskSearch">Search risk library</label>
                <input id="riskSearch" type="search" placeholder="Search code, title, description, owner, or unit">
            </div>
            <div class="risk-field">
                <label for="deptFilter">Department</label>
                <select id="deptFilter"><option value="">All departments</option></select>
            </div>
            <div class="risk-field">
                <label for="typeFilter">Type</label>
                <select id="typeFilter">
                    <option value="">All types</option>
                    <option value="Financial">Financial</option>
                    <option value="Operational">Operational</option>
                    <option value="Compliance">Compliance</option>
                    <option value="IT">IT</option>
                    <option value="Regulatory">Regulatory</option>
                    <option value="Strategic">Strategic</option>
                    <option value="Security">Security</option>
                    <option value="Privacy">Privacy</option>
                    <option value="Third Party">Third Party</option>
                </select>
            </div>
            <div class="risk-field">
                <label for="statusFilter">Status</label>
                <select id="statusFilter">
                    <option value="">All statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Approved">Approved</option>
                    <option value="Accepted">Accepted</option>
                    <option value="Escalated">Escalated</option>
                    <option value="Closed">Closed</option>
                </select>
            </div>
            <div class="risk-results-count"><span id="riskVisibleCount"><%=allCount%></span> of <%=allCount%> visible</div>
        </div>
        <div class="risk-report-links">
            <a href="#Report:All_Risks"><i class="zc-li-outline files-2-archive-paper"></i> All Risks</a>
            <a href="#Report:Risk_Library_Cards"><i class="zc-li-outline design-image"></i> Risk Library Cards</a>
            <a href="#Report:High_Residual_Risks"><i class="zc-li-outline ui-2-alert-circle-i"></i> High Residual Risks</a>
        </div>
    </section>

    <section class="risk-main-grid">
        <div class="risk-section-card zcs-card">
            <div class="risk-section-head">
                <div>
                    <h2 class="risk-section-title">Risk Library Cards</h2>
                    <p class="risk-section-note">Category badge, title, description, owner, and residual visual from Risk_Register.</p>
                </div>
                <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme">
                    <span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body"><%=highResidualCount%> high residual</span>
                </div>
            </div>
            <div class="risk-card-grid" id="riskCardGrid">
                <%
                if(allCount == 0)
                {
                    %>
                    <div class="risk-no-data">No risk records are available yet. Use Add Risk to create the first register entry.</div>
                    <%
                }
                for each risk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc
                {
                    riskCode = ifnull(risk.Risk_Code,"-");
                    riskTitle = ifnull(risk.Risk_Title,"Untitled risk");
                    riskDesc = ifnull(risk.Risk_Description,"No description captured.");
                    riskDept = ifnull(risk.Business_Unit_Entity,"Not assigned");
                    riskCategory = ifnull(risk.Risk_Category,"Unclassified");
                    riskStatus = ifnull(risk.Status,"Draft");
                    riskOwner = ifnull(risk.Risk_Owner,"Unassigned");
                    residualRating = ifnull(risk.Residual_Risk_Rating,"Not Rated");
                    residualScore = ifnull(risk.Residual_Risk_Score,0);
                    residualPct = residualScore * 4;
                    if(residualPct > 100)
                    {
                        residualPct = 100;
                    }
                    if(residualPct < 0)
                    {
                        residualPct = 0;
                    }
                    badgeClass = "zcs-badge-grey";
                    ratingClass = "risk-rating-grey";
                    if(residualRating == "Critical")
                    {
                        badgeClass = "zcs-badge-red";
                        ratingClass = "risk-rating-red";
                    }
                    else if(residualRating == "High")
                    {
                        badgeClass = "zcs-badge-orange";
                        ratingClass = "risk-rating-orange";
                    }
                    else if(residualRating == "Medium")
                    {
                        badgeClass = "zcs-badge-yellow";
                        ratingClass = "risk-rating-yellow";
                    }
                    else if(residualRating == "Low")
                    {
                        badgeClass = "zcs-badge-green";
                        ratingClass = "risk-rating-green";
                    }
                    ownerInitial = "?";
                    if(riskOwner != null && riskOwner != "")
                    {
                        ownerInitial = riskOwner.subString(0,1).toUpperCase();
                    }
                    %>
                    <article class="risk-card" data-search="<%=riskCode%> <%=riskTitle%> <%=riskDesc%> <%=riskOwner%> <%=riskDept%>" data-dept="<%=riskDept%>" data-type="<%=riskCategory%>" data-status="<%=riskStatus%>">
                        <div class="risk-card-top">
                            <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue">
                                <span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=riskCategory%></span>
                            </div>
                            <span class="risk-code"><%=riskCode%></span>
                        </div>
                        <h3 class="risk-card-title"><%=riskTitle%></h3>
                        <p class="risk-card-desc"><%=riskDesc%></p>
                        <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 <%=ratingClass%>">
                            <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=residualPct%>%;"></div></div>
                            <div class="risk-score-text"><span>Residual <%=residualScore%></span><strong><%=residualRating%></strong></div>
                        </div>
                        <div class="risk-card-footer">
                            <div class="risk-owner-mini">
                                <div class="zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink"><%=ownerInitial%></div>
                                <span class="risk-owner-name"><%=riskOwner%></span>
                            </div>
                            <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=badgeClass%>">
                                <span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=residualRating%></span>
                            </div>
                        </div>
                    </article>
                    <%
                }
                %>
                <div class="risk-empty-card risk-no-data" id="riskEmptyCards">No risk cards match the current search and filters.</div>
            </div>
        </div>

        <aside class="risk-side-stack">
            <div class="risk-detail-card zcs-card">
                <div class="risk-detail-header">
                    <div>
                        <span class="risk-code"><%=highestRiskCode%></span>
                        <h2 class="risk-detail-title"><%=highestRiskTitle%></h2>
                    </div>
                    <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red">
                        <span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=highestRiskRating%></span>
                    </div>
                </div>
                <p class="risk-detail-desc"><%=highestRiskDescription%></p>
                <div class="risk-key-values">
                    <div class="risk-kv"><p class="risk-kv-label">Owner</p><p class="risk-kv-value"><%=highestRiskOwner%></p></div>
                    <div class="risk-kv"><p class="risk-kv-label">Business Unit</p><p class="risk-kv-value"><%=highestRiskUnit%></p></div>
                    <div class="risk-kv"><p class="risk-kv-label">Treatment</p><p class="risk-kv-value"><%=highestRiskTreatment%></p></div>
                    <div class="risk-kv"><p class="risk-kv-label">Status</p><p class="risk-kv-value"><%=highestRiskStatus%></p></div>
                </div>
                <div class="risk-timeline">
                    <div class="risk-timeline-item"><div class="risk-timeline-dot"><i class="zc-li-outline users-single-01"></i></div><div class="risk-timeline-text"><strong>Assignment</strong><br>Owner validates response plan and confirms coordinators.</div></div>
                    <div class="risk-timeline-item"><div class="risk-timeline-dot"><i class="zc-li-outline ui-2-time"></i></div><div class="risk-timeline-text"><strong>Next review</strong><br><%=highestRiskReview%></div></div>
                    <div class="risk-timeline-item"><div class="risk-timeline-dot"><i class="zc-li-outline business-chart-bar-32"></i></div><div class="risk-timeline-text"><strong>Residual target</strong><br>Track mitigation milestones and evidence placeholders.</div></div>
                </div>
            </div>

            <div class="risk-residual-summary zcs-card">
                <p class="risk-kpi-label">Residual Risk Concentration</p>
                <p class="risk-residual-big"><%=highPct%>%</p>
                <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 risk-rating-red zcs-mt-12">
                    <div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=highPct%>%;"></div></div>
                    <p class="zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0"><strong class="zcs-color-theme"><%=highResidualCount%></strong> high or critical of <%=allCount%> total risks</p>
                </div>
                <div class="risk-report-links zcs-mt-12">
                    <a href="#Report:High_Residual_Risks"><i class="zc-li-outline arrows-1-tail-right"></i> Review high residual report</a>
                </div>
            </div>
        </aside>
    </section>

    <section class="risk-table-card zcs-card">
        <div class="risk-section-head">
            <div>
                <h2 class="risk-section-title">Risk Register List</h2>
                <p class="risk-section-note">Risk_Code, title, business unit, inherent risk, control effectiveness, residual risk, owner, and status.</p>
            </div>
            <a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:All_Risks">
                <i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i>
                <span class="zcs-button-text">Full Report</span>
            </a>
        </div>
        <div class="zcs-table-wrapper risk-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
            <table class="zcs-w-full">
                <thead class="zcs-sticky">
                    <tr>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Risk Code</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Title</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Business Unit</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Inherent</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Control Effectiveness</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Residual</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Risk Owner</th>
                        <th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th>
                    </tr>
                </thead>
                <tbody id="riskTableBody">
                    <%
                    for each rowRisk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc
                    {
                        rowCode = ifnull(rowRisk.Risk_Code,"-");
                        rowTitle = ifnull(rowRisk.Risk_Title,"Untitled risk");
                        rowDesc = ifnull(rowRisk.Risk_Description,"");
                        rowDept = ifnull(rowRisk.Business_Unit_Entity,"Not assigned");
                        rowCategory = ifnull(rowRisk.Risk_Category,"Unclassified");
                        rowStatus = ifnull(rowRisk.Status,"Draft");
                        rowOwner = ifnull(rowRisk.Risk_Owner,"Unassigned");
                        rowInherent = ifnull(rowRisk.Inherent_Risk_Score,0);
                        rowControl = ifnull(rowRisk.Control_Effectiveness,"Not Tested");
                        rowResidual = ifnull(rowRisk.Residual_Risk_Score,0);
                        statusClass = "zcs-badge-grey";
                        if(rowStatus == "Approved" || rowStatus == "Accepted" || rowStatus == "Closed")
                        {
                            statusClass = "zcs-badge-green";
                        }
                        else if(rowStatus == "Escalated")
                        {
                            statusClass = "zcs-badge-red";
                        }
                        else if(rowStatus == "Under Review")
                        {
                            statusClass = "zcs-badge-orange";
                        }
                        else if(rowStatus == "Draft")
                        {
                            statusClass = "zcs-badge-yellow";
                        }
                        controlColor = "zcs-yellow";
                        if(rowControl == "Effective")
                        {
                            controlColor = "zcs-green";
                        }
                        else if(rowControl == "Ineffective")
                        {
                            controlColor = "zcs-red";
                        }
                        else if(rowControl == "Partial")
                        {
                            controlColor = "zcs-l_blue";
                        }
                        %>
                        <tr class="risk-row" data-search="<%=rowCode%> <%=rowTitle%> <%=rowDesc%> <%=rowOwner%> <%=rowDept%>" data-dept="<%=rowDept%>" data-type="<%=rowCategory%>" data-status="<%=rowStatus%>">
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap"><%=rowCode%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-table-title-cell"><%=rowTitle%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap"><%=rowDept%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=rowInherent%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body <%=controlColor%>"><%=rowControl%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary"><%=rowResidual%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap"><%=rowOwner%></td>
                            <td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body">
                                <div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=rowStatus%></span></div>
                            </td>
                        </tr>
                        <%
                    }
                    %>
                    <tr class="risk-empty-row" id="riskEmptyRows"><td colspan="8" class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary">No list rows match the current search and filters.</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

