<%
  totalAudits = Audits[ID != 0].count();
  activeAudits = Audits[Status == "Active"].count();
  totalPlans = Audit_Plans[ID != 0].count();
  openObservations = Audit_Observations[Status != "Closed" && Status != "Rejected"].count();
  overdueTasks = Remediation_Tasks[Status == "Overdue"].count();
  followUps = Follow_Ups[ID != 0].count();
%>
<style>
.legacy-audit-dashboard { font-family: Arial, sans-serif; background:#fff7f8; padding:24px; color:#1f2937; }
.legacy-audit-header { background:#111827; color:#fff; border-radius:16px; padding:24px; border-left:6px solid #ff2f3f; }
.legacy-audit-header h1 { margin:0 0 6px; font-size:28px; }
.legacy-audit-header p { margin:0; opacity:.82; }
.legacy-audit-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:20px; }
.legacy-audit-card { background:#fff; border:1px solid #ffe0e5; border-radius:14px; padding:18px; box-shadow:0 8px 24px rgba(17,24,39,.06); }
.legacy-audit-label { font-size:13px; color:#6b7280; margin-bottom:8px; }
.legacy-audit-value { font-size:30px; font-weight:800; color:#ff2f3f; }
.legacy-audit-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
.legacy-audit-actions a { text-decoration:none; background:#ff2f3f; color:#fff; padding:10px 14px; border-radius:10px; font-weight:700; font-size:13px; }
@media (max-width: 900px) { .legacy-audit-grid { grid-template-columns:1fr; } }
</style>
<div class="legacy-audit-dashboard">
  <div class="legacy-audit-header">
    <h1>Audit Dashboard</h1>
    <p>This legacy dashboard has been aligned to the current ERM/Internal Audit data model. Use the primary Internal Audit Dashboard for the full screen-inspired experience.</p>
  </div>
  <div class="legacy-audit-grid">
    <div class="legacy-audit-card"><div class="legacy-audit-label">Total Audits</div><div class="legacy-audit-value"><%=totalAudits%></div></div>
    <div class="legacy-audit-card"><div class="legacy-audit-label">Active Audits</div><div class="legacy-audit-value"><%=activeAudits%></div></div>
    <div class="legacy-audit-card"><div class="legacy-audit-label">Audit Plans</div><div class="legacy-audit-value"><%=totalPlans%></div></div>
    <div class="legacy-audit-card"><div class="legacy-audit-label">Open Observations</div><div class="legacy-audit-value"><%=openObservations%></div></div>
    <div class="legacy-audit-card"><div class="legacy-audit-label">Overdue Remediation Tasks</div><div class="legacy-audit-value"><%=overdueTasks%></div></div>
    <div class="legacy-audit-card"><div class="legacy-audit-label">Follow-Ups</div><div class="legacy-audit-value"><%=followUps%></div></div>
  </div>
  <div class="legacy-audit-actions">
    <a href="#Page:Internal_Audit_Dashboard">Open Internal Audit Dashboard</a>
    <a href="#Report:All_Audits">Audit Listings</a>
    <a href="#Report:Open_Observations">Open Observations</a>
    <a href="#Report:Follow_Up_Schedule">Follow-Up Schedule</a>
  </div>
</div>