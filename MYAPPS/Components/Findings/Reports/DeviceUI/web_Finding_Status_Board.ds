report Finding_Status_Board
{
    quickview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -1
                fields
                (
                    Finding_Number as "Finding Number"
                    Audit
                    Finding_Title as "Finding Title"
                    Severity
                    Owner_Email as "Owner Email"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Finding_Number as "Finding Number"
                    Audit
                    Finding_Title as "Finding Title"
                    Severity
                    Owner_Email as "Owner Email"
                    Due_Date as "Due Date"
                    Finding_Status as "Finding Status"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
