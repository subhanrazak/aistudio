list My_Findings
{
    displayName = "My Findings"
    show all rows from Findings [Owner_Email == zoho.loginuser]
    (
        Finding_Number as "Finding Number"
        Audit
        Finding_Title as "Finding Title"
        Severity
        Due_Date as "Due Date"
        Finding_Status as "Finding Status"
    )
    filters
    (
        Audit
        Severity
        Finding_Status
    )
    sort by
    (
        Due_Date ascending
    )
}
