kanban Finding_Status_Board
{
    displayName = "Finding Status Board"
    show all rows from Findings
    (
        Finding_Number as "Finding Number"
        Audit
        Finding_Title as "Finding Title"
        Severity
        Owner_Email as "Owner Email"
        Due_Date as "Due Date"
        Finding_Status as "Finding Status"
    )
    filters
    (
        Audit
        Severity
        Finding_Status
        Owner_Email
    )
    sort by
    (
        Due_Date ascending
    )
    options
    (
        display field = Finding_Status
        sortorder = ascending
        recordcount = enable
    )
}
