list Open_Findings
{
    displayName = "Open Findings"
    show all rows from Findings [Finding_Status != "Closed"]
    (
        Finding_Number as "Finding Number"
        Audit
        Finding_Title as "Finding Title"
        Severity
        Owner_Email as "Owner Email"
        Due_Date as "Due Date"
        Finding_Status as "Finding Status"
    )
    filters
    (
        Audit
        Severity
        Finding_Status
        Owner_Email
    )
    sort by
    (
        Due_Date ascending
    )
}
