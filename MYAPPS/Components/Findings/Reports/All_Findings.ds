default list All_Findings
{
    displayName = "All Findings"
    show all rows from Findings
    (
        Finding_Number as "Finding Number"
        Audit
        Finding_Title as "Finding Title"
        Finding_Type as "Finding Type"
        Severity
        Owner_Email as "Owner Email"
        Due_Date as "Due Date"
        Finding_Status as "Finding Status"
    )
    filters
    (
        Audit
        Finding_Type
        Severity
        Finding_Status
        Owner_Email
    )
    sort by
    (
        Due_Date ascending
    )
}
