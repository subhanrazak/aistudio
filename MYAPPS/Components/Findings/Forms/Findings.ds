form Findings
{
    displayname = "Findings"
    success message = "Finding saved successfully"
    Finding_Details
    (
        type = section
        displayname = "Finding Details"
        row = 1
        column = 0
        width = medium
    )
    Finding_Number
    (
        type = autonumber
        displayname = "Finding Number"
        start index = 1
        row = 1
        column = 1
        width = medium
    )
    must have Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Finding_Title
    (
        type = text
        displayname = "Finding Title"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Finding_Type
    (
        type = picklist
        displayname = "Finding Type"
        values = {"Nonconformity", "Observation", "Opportunity for Improvement"}
        row = 1
        column = 1
        width = medium
    )
    must have Severity
    (
        type = picklist
        values = {"Critical", "Major", "Minor", "Low"}
        row = 1
        column = 2
        width = medium
    )
    must have Description
    (
        type = textarea
        height = 180px
        row = 1
        column = 1
        width = medium
    )
    Root_Cause
    (
        type = textarea
        displayname = "Root Cause"
        height = 150px
        row = 1
        column = 2
        width = medium
    )
    must have Owner_Email
    (
        type = email
        displayname = "Owner Email"
        maxchar = 80
        row = 1
        column = 1
        width = medium
        personal data = true
    )
    must have Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 2
        width = medium
    )
    must have Finding_Status
    (
        type = picklist
        displayname = "Finding Status"
        values = {"Open", "Action Proposed", "In Progress", "Pending Verification", "Closed"}
        row = 1
        column = 1
        width = medium
    )
    Evidence_Link
    (
        type = url
        displayname = "Evidence Link"
        enable = linkname, title
        target = same window
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
