form Activities
{
    displayname = "Activities"
    success message = "Activity saved successfully"
    Activity_Details
    (
        type = section
        displayname = "Activity Details"
        row = 1
        column = 0
        width = medium
    )
    must have Activity_Subject
    (
        type = text
        displayname = "Activity Subject"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Activity_Type
    (
        type = picklist
        displayname = "Activity Type"
        values = {"Call", "Meeting", "Email", "Task", "Review", "Follow-up", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Account
    (
        type = picklist
        values = Accounts.ID
        displayformat = [Account_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Contact
    (
        type = picklist
        values = Contacts.ID
        displayformat = [Contact_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Deal
    (
        type = picklist
        values = Deals.ID
        displayformat = [Deal_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Owner_Email
    (
        type = email
        displayname = "Owner Email"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 2
        width = medium
    )
    Activity_Status
    (
        type = picklist
        displayname = "Activity Status"
        values = {"Not Started", "In Progress", "Completed", "Deferred", "Cancelled"}
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 180px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
