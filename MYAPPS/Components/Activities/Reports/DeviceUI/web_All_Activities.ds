report All_Activities
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Activity_Subject as "Activity Subject"
                    Activity_Type as "Activity Type"
                    Account
                    Contact
                    Deal
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Activity_Subject as "Activity Subject"
                    Activity_Type as "Activity Type"
                    Account
                    Contact
                    Deal
                    Audit
                    Owner_Email as "Owner Email"
                    Due_Date as "Due Date"
                    Activity_Status as "Activity Status"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
