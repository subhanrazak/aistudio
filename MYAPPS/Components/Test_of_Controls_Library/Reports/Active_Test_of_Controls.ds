list Active_Test_of_Controls
{
    displayName = "Active Test of Controls"
    show all rows from Test_of_Controls_Library [Initial_Status == "Active" || Test_Status == "Active"]
    (
        Test_ID as "Test ID"
        Test_Name as "Test Name"
        Test_Type as "Test Type"
        Control
        Control_Type as "Control Type"
        Applicable_Audit_Type as "Applicable Audit Type"
        Test_Frequency as "Test Frequency"
        Test_Status as "Test Status"
        Version
    )
    filters
    (
        Test_Type
        Control_Type
        Test_Frequency
    )
    sort by
    (
        Test_Name ascending
    )
}