kanban Test_Status_Kanban
{
    displayName = "Test Status Kanban"
    show all rows from Test_of_Controls_Library
    (
        Test_ID as "Test ID"
        Test_Name as "Test Name"
        Test_Type as "Test Type"
        Control_Type as "Control Type"
        Test_Frequency as "Test Frequency"
        Test_Status as "Test Status"
        Version
    )
    filters
    (
        Test_Type
        Control_Type
        Test_Status
    )
    sort by
    (
        Test_Name ascending
    )
    options
    (
        display field = Test_Status
        sortorder = ascending
        recordcount = enable
    )
}