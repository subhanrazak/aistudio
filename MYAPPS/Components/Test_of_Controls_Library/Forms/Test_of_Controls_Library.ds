form Test_of_Controls_Library
{
    displayname = "Test of Controls Library"
    success message = "Test of controls template saved successfully"
    Basic_Information
    (
        type = section
        displayname = "Basic Information"
        row = 1
        column = 0
    )
    must have unique Test_ID
    (
        type = text
        displayname = "Test ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Test_Name
    (
        type = text
        displayname = "Test Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    must have Test_Type
    (
        type = picklist
        displayname = "Test Type"
        values = {"Walkthrough", "Inquiry", "Inspection", "Reperformance", "Automated Testing", "Manual Testing", "Analytical Review"}
        row = 1
        column = 1
        width = medium
    )
    Control
    (
        type = picklist
        displayname = "Control"
        values = Control_Library.ID
        displayformat = [Control_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Control_Type
    (
        type = picklist
        displayname = "Control Type"
        values = {"Preventive", "Detective", "Corrective", "Directive"}
        row = 1
        column = 1
        width = medium
    )
    Applicable_Audit_Type
    (
        type = list
        displayname = "Applicable Audit Type"
        values = {"Financial Audit", "Operational Audit", "IT Audit", "Compliance Audit", "Security Audit"}
        row = 1
        column = 2
        width = medium
    )
    Test_Frequency
    (
        type = picklist
        displayname = "Test Frequency"
        values = {"Daily", "Weekly", "Monthly", "Quarterly", "Annually", "Ad hoc"}
        row = 1
        column = 1
        width = medium
    )
    Test_Objective
    (
        type = textarea
        displayname = "Test Objective"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Keywords_Tags
    (
        type = text
        displayname = "Keywords / Tags"
        maxchar = 250
        row = 1
        column = 1
        width = medium
    )
    Test_Configuration
    (
        type = section
        displayname = "Test Configuration"
        visibility = true
        row = 2
        column = 1
    )
    Sample_Size
    (
        type = number
        displayname = "Sample Size"
        row = 2
        column = 1
        width = medium
    )
    Population_Description
    (
        type = textarea
        displayname = "Population Description"
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    Sampling_Method
    (
        type = picklist
        displayname = "Sampling Method"
        values = {"Random Sampling", "Judgmental Sampling", "Statistical Sampling", "Full Population", "Exception Based"}
        row = 2
        column = 1
        width = medium
    )
    Test_Duration_Estimated_Hours
    (
        type = decimal
        displayname = "Test Duration Estimated Hours"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Expected_Evidence
    (
        type = textarea
        displayname = "Expected Evidence"
        height = 120px
        row = 2
        column = 1
        width = medium
    )
    Data_Sources
    (
        type = textarea
        displayname = "Data Sources"
        height = 120px
        row = 2
        column = 2
        width = medium
    )
    Test_Procedures
    (
        type = section
        displayname = "Test Procedures"
        visibility = true
        row = 3
        column = 1
    )
    Test_Procedure_Steps
    (
        type = textarea
        displayname = "Test Procedure Steps"
        height = 180px
        row = 3
        column = 1
        width = medium
    )
    Pass_Fail_Criteria
    (
        type = textarea
        displayname = "Pass / Fail Criteria"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Testing_Tools_Systems
    (
        type = text
        displayname = "Testing Tools / Systems"
        maxchar = 250
        row = 3
        column = 1
        width = medium
    )
    Additional_Custom_Fields
    (
        type = section
        displayname = "Additional Custom Fields"
        visibility = true
        row = 4
        column = 1
    )
    Test_Owner_Responsible_Auditor
    (
        type = picklist
        displayname = "Test Owner / Responsible Auditor"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 4
        column = 1
        width = medium
    )
    Test_Status
    (
        type = picklist
        displayname = "Test Status"
        values = {"Not Started", "In Progress", "Completed", "Exception", "Draft", "Active"}
        initial value = "Draft"
        row = 4
        column = 2
        width = medium
    )
    Test_Execution_Date
    (
        type = date
        displayname = "Test Execution Date"
        row = 4
        column = 1
        width = medium
    )
    Test_Result
    (
        type = picklist
        displayname = "Test Result"
        values = {"Pass", "Fail", "Not Applicable", "Exception"}
        row = 4
        column = 2
        width = medium
    )
    Test_Observations_Notes
    (
        type = textarea
        displayname = "Test Observations / Notes"
        height = 120px
        row = 4
        column = 1
        width = medium
    )
    Version
    (
        type = text
        displayname = "Version"
        initial value = "V1.0"
        maxchar = 20
        row = 4
        column = 2
        width = medium
    )
    Initial_Status
    (
        type = picklist
        displayname = "Initial Status"
        values = {"Draft", "Active", "Inactive"}
        row = 4
        column = 1
        width = medium
    )
    Version_Notes
    (
        type = textarea
        displayname = "Version Notes"
        height = 100px
        row = 4
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}