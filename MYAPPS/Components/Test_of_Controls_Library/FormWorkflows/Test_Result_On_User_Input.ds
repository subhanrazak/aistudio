TOC_Test_Result_On_User_Input as "TOC Test Result On User Input"
{
    type = form
    form = Test_of_Controls_Library
    record event = on add or edit

    on user input of Test_Result
    {
        actions
        {
            custom deluge script
            (
                if(input.Test_Result == "Fail" || input.Test_Result == "Exception")
                {
                    show Test_Observations_Notes;
                    enable Test_Observations_Notes;
                }
                else
                {
                    disable Test_Observations_Notes;
                }
            )
        }
    }
}