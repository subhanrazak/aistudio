form Corrective_Actions
{
    displayname = "Corrective Actions"
    success message = "Corrective action saved successfully"
    Action_Details
    (
        type = section
        displayname = "Action Details"
        row = 1
        column = 0
        width = medium
    )
    must have Finding
    (
        type = picklist
        values = Findings.ID
        displayformat = [Finding_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Action_Title
    (
        type = text
        displayname = "Action Title"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Action_Description
    (
        type = textarea
        displayname = "Action Description"
        height = 180px
        row = 1
        column = 1
        width = medium
    )
    must have Action_Owner_Email
    (
        type = email
        displayname = "Action Owner Email"
        maxchar = 80
        row = 1
        column = 2
        width = medium
        personal data = true
    )
    must have Target_Date
    (
        type = date
        displayname = "Target Date"
        row = 1
        column = 1
        width = medium
    )
    Completion_Date
    (
        type = date
        displayname = "Completion Date"
        row = 1
        column = 2
        width = medium
    )
    must have Action_Status
    (
        type = picklist
        displayname = "Action Status"
        values = {"Proposed", "Approved", "In Progress", "Completed", "Verified", "Rejected"}
        row = 1
        column = 1
        width = medium
    )
    Effectiveness_Review
    (
        type = textarea
        displayname = "Effectiveness Review"
        height = 150px
        row = 1
        column = 2
        width = medium
    )
    Proof_Link
    (
        type = url
        displayname = "Proof Link"
        enable = linkname, title
        target = same window
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
