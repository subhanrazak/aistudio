report All_Corrective_Actions
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Finding
                    Action_Title as "Action Title"
                    Action_Owner_Email as "Action Owner Email"
                    Target_Date as "Target Date"
                    Completion_Date as "Completion Date"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Finding
                    Action_Title as "Action Title"
                    Action_Owner_Email as "Action Owner Email"
                    Target_Date as "Target Date"
                    Completion_Date as "Completion Date"
                    Action_Status as "Action Status"
                    Effectiveness_Review as "Effectiveness Review"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
