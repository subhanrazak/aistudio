list Overdue_Actions
{
    displayName = "Overdue Actions"
    show all rows from Corrective_Actions [Target_Date < zoho.currentdate && Action_Status != "Completed" && Action_Status != "Verified"]
    (
        Finding
        Action_Title as "Action Title"
        Action_Owner_Email as "Action Owner Email"
        Target_Date as "Target Date"
        Action_Status as "Action Status"
    )
    filters
    (
        Finding
        Action_Owner_Email
        Action_Status
        Target_Date
    )
    sort by
    (
        Target_Date ascending
    )
}
