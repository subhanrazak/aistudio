list My_Open_Actions
{
    displayName = "My Open Actions"
    show all rows from Corrective_Actions [Action_Owner_Email == zoho.loginuser && Action_Status != "Verified"]
    (
        Finding
        Action_Title as "Action Title"
        Target_Date as "Target Date"
        Completion_Date as "Completion Date"
        Action_Status as "Action Status"
    )
    filters
    (
        Finding
        Action_Status
        Target_Date
    )
    sort by
    (
        Target_Date ascending
    )
}
