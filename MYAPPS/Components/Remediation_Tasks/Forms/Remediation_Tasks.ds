form Remediation_Tasks
{
    displayname = "Remediation Tasks"
    success message = "Remediation task saved successfully"
    Basic
    (
        type = section
        displayname = "Basic Details"
        row = 1
        column = 0
    )
    must have unique Task_ID
    (
        type = text
        displayname = "Task ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Task_Name
    (
        type = text
        displayname = "Task Name"
        maxchar = 250
        row = 1
        column = 2
        width = medium
    )
    Task_Source
    (
        type = picklist
        displayname = "Task Source"
        values = {"Planning", "Observation", "Follow-up", "Manual"}
        row = 1
        column = 1
        width = medium
    )
    Linked_Observation
    (
        type = picklist
        displayname = "Linked Observation"
        values = Audit_Observations.ID
        displayformat = [Observation_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Priority
    (
        type = picklist
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 1
        width = medium
    )
    Task_Owner
    (
        type = picklist
        displayname = "Task Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Department
    (
        type = picklist
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        values = {"Not Started", "In Progress", "Completed", "Overdue", "Cancelled"}
        initial value = "Not Started"
        row = 1
        column = 1
        width = medium
    )
    Notes_Task_Description
    (
        type = textarea
        displayname = "Notes Task Description"
        height = 160px
        row = 1
        column = 2
        width = medium
    )
    Progress
    (
        type = section
        displayname = "Progress"
        visibility = true
        row = 2
        column = 1
    )
    Completion_Percent
    (
        type = decimal
        displayname = "Completion Percent"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Completion_Evidence
    (
        type = upload file
        displayname = "Completion Evidence"
        browse = local_drive, google_docs, zoho_docs
        row = 2
        column = 2
        width = medium
    )
    Verified_By
    (
        type = picklist
        displayname = "Verified By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Verified_Date
    (
        type = date
        displayname = "Verified Date"
        row = 2
        column = 2
        width = medium
    )
    Closure_Notes
    (
        type = textarea
        displayname = "Closure Notes"
        height = 160px
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}