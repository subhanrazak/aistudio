calendar Task_Due_Calendar
{
    displayName = "Task Due Calendar"
    show all rows from Remediation_Tasks
    (
        Task_ID as "Task ID"
        Task_Name as "Task Name"
        Priority
        Department
        Task_Owner as "Task Owner"
        Due_Date as "Due Date"
        Status
    )
    filters
    (
        Priority
        Department
        Task_Owner
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
    )
    options
    (
        display type = month
        week start day = monday
        display field = Task_Name
        start date = Due_Date
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}