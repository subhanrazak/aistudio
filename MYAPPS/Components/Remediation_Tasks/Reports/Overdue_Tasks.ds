list Overdue_Tasks
{
    displayName = "Overdue Tasks"
    show all rows from Remediation_Tasks [Status == "Overdue" || (Due_Date < zoho.currentdate && Status != "Completed" && Status != "Cancelled")]
    (
        Task_ID as "Task ID"
        Linked_Observation as "Linked Observation"
        Task_Name as "Task Name"
        Priority
        Department
        Task_Owner as "Task Owner"
        Due_Date as "Due Date"
        Status
        Completion_Percent as "Completion Percent"
    )
    filters
    (
        Priority
        Department
        Task_Owner
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
}