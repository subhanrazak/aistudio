default list Task_Library
{
    displayName = "Task Library"
    show all rows from Remediation_Tasks
    (
        Task_ID as "Task ID"
        Linked_Observation as "Linked Observation"
        Task_Name as "Task Name"
        Priority
        Department
        Task_Owner as "Task Owner"
        Due_Date as "Due Date"
        Status
        Completion_Percent as "Completion Percent"
    )
    filters
    (
        Priority
        Department
        Task_Owner
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
}