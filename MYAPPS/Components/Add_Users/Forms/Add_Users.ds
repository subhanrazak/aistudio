form Add_Users
{
    displayname = "Add Users"
    success message = "User Added Successfully"
    Section
    (
        type = section
        row = 1
        column = 0
        width = medium
    )
    must have unique User_Email
    (
        type = email
        displayname = "User Email"
        maxchar = 80
        row = 1
        column = 1
        width = medium
        personal data = true
    )
    must have Profile
    (
        type = picklist
        maxchar = 100
        values = {"Choice 1"}
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            submit
            (
                type = submit
                displayname = "Add"
            )
        }
        on edit
        {
            update
            (
                type = submit
                displayname = "Update"
            )
            cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
