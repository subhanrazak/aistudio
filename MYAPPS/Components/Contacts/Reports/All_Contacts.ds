default list All_Contacts
{
    displayName = "All Contacts"
    show all rows from Contacts
    (
        Contact_Name as "Contact Name"
        Account
        Email
        Phone
        Role
        Contact_Status as "Contact Status"
    )
    filters
    (
        Account
        Contact_Status
    )
    sort by
    (
        Contact_Name ascending
    )
}
