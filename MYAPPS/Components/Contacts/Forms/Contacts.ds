form Contacts
{
    displayname = "Contacts"
    success message = "Contact saved successfully"
    Contact_Details
    (
        type = section
        displayname = "Contact Details"
        row = 1
        column = 0
        width = medium
    )
    must have Contact_Name
    (
        type = text
        displayname = "Contact Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Account
    (
        type = picklist
        values = Accounts.ID
        displayformat = [Account_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Email
    (
        type = email
        maxchar = 80
        row = 1
        column = 1
        width = medium
        personal data = true
    )
    Phone
    (
        type = phonenumber
        row = 1
        column = 2
        width = medium
        personal data = true
    )
    Role
    (
        type = text
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = text
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Contact_Status
    (
        type = picklist
        displayname = "Contact Status"
        values = {"Active", "Inactive"}
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 150px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
