list Failed_Exception_Tests
{
    displayName = "Failed Exception Tests"
    show all rows from Audit_Test_Executions [Test_Result == "Fail" || Test_Result == "Exception"]
    (
        Execution_ID as "Execution ID"
        Audit
        Test_Template as "Test Template"
        Control
        Assigned_Auditor as "Assigned Auditor"
        Test_Status as "Test Status"
        Test_Result as "Test Result"
        Follow_Up_Required as "Follow Up Required"
        Exception_Details as "Exception Details"
        Review_Status as "Review Status"
    )
    filters
    (
        Audit
        Assigned_Auditor
        Test_Result
        Follow_Up_Required
        Review_Status
    )
    sort by
    (
        Audit ascending
        Execution_ID ascending
    )
}