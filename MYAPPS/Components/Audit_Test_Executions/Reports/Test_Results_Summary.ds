list Test_Results_Summary
{
    displayName = "Test Results Summary"
    show all rows from Audit_Test_Executions
    (
        Audit
        Test_Result as "Test Result"
        Execution_ID as "Execution ID"
        Test_Status as "Test Status"
        Review_Status as "Review Status"
    )
    filters
    (
        Audit
        Test_Result
        Test_Status
        Review_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Audit ascending
        Test_Result ascending
    )
    sort by
    (
        Audit ascending
        Test_Result ascending
    )
}