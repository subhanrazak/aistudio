list Tests_By_Audit
{
    displayName = "Tests By Audit"
    show all rows from Audit_Test_Executions
    (
        Audit
        Execution_ID as "Execution ID"
        Test_Template as "Test Template"
        Control
        Assigned_Auditor as "Assigned Auditor"
        Test_Status as "Test Status"
        Test_Result as "Test Result"
        Review_Status as "Review Status"
    )
    filters
    (
        Audit
        Assigned_Auditor
        Test_Status
        Test_Result
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Audit ascending
    )
    sort by
    (
        Audit ascending
        Execution_ID ascending
    )
}