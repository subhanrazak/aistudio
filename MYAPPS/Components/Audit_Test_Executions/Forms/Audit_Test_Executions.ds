form Audit_Test_Executions
{
    displayname = "Audit Test Executions"
    success message = "Audit test execution saved successfully"
    Test_Run
    (
        type = section
        displayname = "Test Run"
        row = 1
        column = 0
    )
    must have unique Execution_ID
    (
        type = text
        displayname = "Execution ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Test_Template
    (
        type = picklist
        displayname = "Test Template"
        values = Test_of_Controls_Library.ID
        displayformat = [Test_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Control
    (
        type = picklist
        values = Control_Library.ID
        displayformat = [Control_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Assigned_Auditor
    (
        type = picklist
        displayname = "Assigned Auditor"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Test_Status
    (
        type = picklist
        displayname = "Test Status"
        values = {"Not Started", "In Progress", "Completed", "Exception"}
        initial value = "Not Started"
        row = 1
        column = 2
        width = medium
    )
    Test_Execution_Date
    (
        type = date
        displayname = "Test Execution Date"
        row = 1
        column = 1
        width = medium
    )
    Sample_Size
    (
        type = number
        displayname = "Sample Size"
        row = 1
        column = 2
        width = medium
    )
    Test_Result
    (
        type = picklist
        displayname = "Test Result"
        values = {"Pass", "Fail", "Not Applicable", "Exception", "Not Tested"}
        initial value = "Not Tested"
        row = 1
        column = 1
        width = medium
    )
    Evidence_File
    (
        type = upload file
        displayname = "Evidence File"
        browse = local_drive, google_docs, zoho_docs
        row = 1
        column = 2
        width = medium
    )
    Exception_Details
    (
        type = textarea
        displayname = "Exception Details"
        height = 140px
        row = 1
        column = 1
        width = medium
    )
    Test_Observations_Notes
    (
        type = textarea
        displayname = "Test Observations Notes"
        height = 160px
        row = 1
        column = 2
        width = medium
    )
    Follow_Up_Required
    (
        type = checkbox
        displayname = "Follow Up Required"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Review
    (
        type = section
        displayname = "Review"
        visibility = true
        row = 2
        column = 1
    )
    Reviewed_By
    (
        type = picklist
        displayname = "Reviewed By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Review_Status
    (
        type = picklist
        displayname = "Review Status"
        values = {"Pending Review", "Accepted", "Rework Required"}
        initial value = "Pending Review"
        row = 2
        column = 2
        width = medium
    )
    Review_Comments
    (
        type = textarea
        displayname = "Review Comments"
        height = 140px
        row = 2
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}