form Audit_Team_Members
{
    displayname = "Audit Team Members"
    success message = "Audit team member saved successfully"
    Profile_Details
    (
        type = section
        displayname = "Profile Details"
        row = 1
        column = 0
    )
    must have unique Member_Code
    (
        type = text
        displayname = "Member Code"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have Full_Name
    (
        type = text
        displayname = "Full Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have unique Email
    (
        type = email
        displayname = "Email"
        row = 1
        column = 1
        width = medium
        personal data = true
    )
    must have Role
    (
        type = picklist
        displayname = "Role"
        values = {"Audit Manager", "Lead Auditor", "Auditor", "Reviewer", "Approver", "Risk Owner", "Executive"}
        row = 1
        column = 2
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Skill_Area
    (
        type = list
        displayname = "Skill Area"
        values = {"Finance", "IT", "Compliance", "Operations", "Procurement", "HR", "Security", "Data Analytics", "Regulatory"}
        row = 1
        column = 2
        width = medium
    )
    Capacity_Days_Per_Year
    (
        type = number
        displayname = "Capacity Days Per Year"
        initial value = 220
        row = 1
        column = 1
        width = medium
    )
    Utilization_Target_Percent
    (
        type = decimal
        displayname = "Utilization Target Percent"
        decimalplace = 2
        initial value = 75
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}