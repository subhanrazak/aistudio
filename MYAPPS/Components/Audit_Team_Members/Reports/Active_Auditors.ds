list Active_Auditors
{
    displayName = "Active Auditors"
    show all rows from Audit_Team_Members [Status == "Active"]
    (
        Member_Code as "Member Code"
        Full_Name as "Full Name"
        Email
        Role
        Department
        Skill_Area as "Skill Area"
        Capacity_Days_Per_Year as "Capacity Days Per Year"
        Utilization_Target_Percent as "Utilization Target Percent"
        Status
    )
    filters
    (
        Role
        Department
        Skill_Area
    )
    sort by
    (
        Full_Name ascending
    )
}