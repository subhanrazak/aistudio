list Auditor_Capacity_By_Department
{
    displayName = "Auditor Capacity By Department"
    show all rows from Audit_Team_Members [Status == "Active"]
    (
        Department
        Role
        Full_Name as "Full Name"
        Capacity_Days_Per_Year as "Capacity Days Per Year"
        Utilization_Target_Percent as "Utilization Target Percent"
        Status
    )
    filters
    (
        Department
        Role
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Department ascending
        Role ascending
    )
    sort by
    (
        Department ascending
        Role ascending
        Full_Name ascending
    )
}