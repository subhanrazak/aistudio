default list All_Audit_Team_Members
{
    displayName = "All Audit Team Members"
    show all rows from Audit_Team_Members
    (
        Member_Code as "Member Code"
        Full_Name as "Full Name"
        Email
        Role
        Department
        Skill_Area as "Skill Area"
        Capacity_Days_Per_Year as "Capacity Days Per Year"
        Utilization_Target_Percent as "Utilization Target Percent"
        Status
    )
    filters
    (
        Status
        Role
        Department
    )
    sort by
    (
        Full_Name ascending
    )
}