form Deals
{
    displayname = "Deals"
    success message = "Deal saved successfully"
    Deal_Details
    (
        type = section
        displayname = "Deal Details"
        row = 1
        column = 0
        width = medium
    )
    must have Deal_Name
    (
        type = text
        displayname = "Deal Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    must have Account
    (
        type = picklist
        values = Accounts.ID
        displayformat = [Account_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Primary_Contact
    (
        type = picklist
        displayname = "Primary Contact"
        values = Contacts.ID
        displayformat = [Contact_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Deal_Stage
    (
        type = picklist
        displayname = "Deal Stage"
        values = {"Qualification", "Proposal", "Negotiation", "Won", "Lost", "On Hold"}
        row = 1
        column = 2
        width = medium
    )
    Deal_Amount
    (
        type = decimal
        displayname = "Deal Amount"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Expected_Close_Date
    (
        type = date
        displayname = "Expected Close Date"
        row = 1
        column = 2
        width = medium
    )
    Owner_Email
    (
        type = email
        displayname = "Owner Email"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Deal_Status
    (
        type = picklist
        displayname = "Deal Status"
        values = {"Open", "Won", "Lost", "Inactive"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 180px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
