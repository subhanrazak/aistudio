report Open_Deals
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Deal_Name as "Deal Name"
                    Account
                    Deal_Stage as "Deal Stage"
                    Deal_Amount as "Deal Amount"
                    Expected_Close_Date as "Expected Close Date"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Deal_Name as "Deal Name"
                    Account
                    Deal_Stage as "Deal Stage"
                    Deal_Amount as "Deal Amount"
                    Expected_Close_Date as "Expected Close Date"
                    Owner_Email as "Owner Email"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
