default list All_Deals
{
    displayName = "All Deals"
    show all rows from Deals
    (
        Deal_Name as "Deal Name"
        Account
        Primary_Contact as "Primary Contact"
        Deal_Stage as "Deal Stage"
        Deal_Amount as "Deal Amount"
        Expected_Close_Date as "Expected Close Date"
        Owner_Email as "Owner Email"
        Deal_Status as "Deal Status"
    )
    filters
    (
        Deal_Stage
        Deal_Status
        Owner_Email
    )
    sort by
    (
        Expected_Close_Date descending
    )
}
