list Open_Deals
{
    displayName = "Open Deals"
    show all rows from Deals [Deal_Status == "Open"]
    (
        Deal_Name as "Deal Name"
        Account
        Deal_Stage as "Deal Stage"
        Deal_Amount as "Deal Amount"
        Expected_Close_Date as "Expected Close Date"
        Owner_Email as "Owner Email"
    )
    filters
    (
        Deal_Stage
        Owner_Email
    )
    sort by
    (
        Expected_Close_Date ascending
    )
}
