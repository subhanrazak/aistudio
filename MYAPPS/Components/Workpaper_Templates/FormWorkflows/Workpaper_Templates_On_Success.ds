Workpaper_Templates_On_Success as "Workpaper Templates On Success"
{
    type = form
    form = Workpaper_Templates
    record event = on add or edit

    on success
    {
        actions
        {
            custom deluge script
            (
                if(input.Status == "Active" && input.Last_Review_Date == null)
                {
                    input.Last_Review_Date = zoho.currentdate;
                }
            )
        }
    }
}