form Workpaper_Templates
{
    displayname = "Workpaper Templates"
    success message = "Workpaper template saved successfully"
    Template_Header
    (
        type = section
        displayname = "Template Header"
        row = 1
        column = 0
    )
    must have unique Workpaper_ID
    (
        type = text
        displayname = "Workpaper ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Workpaper_Name
    (
        type = text
        displayname = "Workpaper Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    must have Workpaper_Type
    (
        type = picklist
        displayname = "Workpaper Type"
        values = {"Analytical", "Checklist", "Narrative", "Sampling"}
        row = 1
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft", "Active", "Inactive", "Retired"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Version
    (
        type = text
        displayname = "Version"
        initial value = "V1.0"
        maxchar = 20
        row = 1
        column = 1
        width = medium
    )
    Classification_Applicability
    (
        type = section
        displayname = "Classification & Applicability"
        visibility = true
        row = 2
        column = 1
    )
    Applicable_Audit_Type
    (
        type = list
        displayname = "Applicable Audit Type"
        values = {"Financial Audit", "Operational Audit", "IT Audit", "Compliance Audit", "RBI", "CDC Regulation", "SOC Regulation", "Financial Risk II"}
        row = 2
        column = 1
        width = medium
    )
    Risk_Category
    (
        type = picklist
        displayname = "Risk Category"
        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Security", "Privacy"}
        row = 2
        column = 2
        width = medium
    )
    Control_Type
    (
        type = picklist
        displayname = "Control Type"
        values = {"Preventive", "Detective", "Corrective", "Directive"}
        row = 2
        column = 1
        width = medium
    )
    Control_Nature
    (
        type = picklist
        displayname = "Control Nature"
        values = {"Manual", "Automated", "Semi-Automated"}
        row = 2
        column = 2
        width = medium
    )
    Mapped_Test_Type
    (
        type = picklist
        displayname = "Mapped Test Type"
        values = {"Walkthrough", "Inquiry", "Inspection", "Reperformance", "Analytical Review"}
        row = 2
        column = 1
        width = medium
    )
    Regulatory_Reference
    (
        type = text
        displayname = "Regulatory Reference"
        maxchar = 150
        row = 2
        column = 2
        width = medium
    )
    Workpaper_Objective
    (
        type = section
        displayname = "Workpaper Objective"
        visibility = true
        row = 3
        column = 1
    )
    Comments_Reviewer_Notes
    (
        type = textarea
        displayname = "Comments / Reviewer Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Guidance_Prompt
    (
        type = textarea
        displayname = "Guidance Prompt"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Standard_Procedures_Steps
    (
        type = textarea
        displayname = "Standard Procedures / Steps"
        height = 160px
        row = 3
        column = 1
        width = medium
    )
    Conclusion_Guidance
    (
        type = textarea
        displayname = "Conclusion Guidance"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Suggested_Conclusion_Options
    (
        type = list
        displayname = "Suggested Conclusion Options"
        values = {"Effective", "Partially Effective", "Ineffective", "Exception Noted", "Pass", "Fail", "Not Applicable"}
        row = 3
        column = 1
        width = medium
    )
    Evidence_Expected
    (
        type = textarea
        displayname = "Evidence Expected"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Documentation_Standards
    (
        type = textarea
        displayname = "Documentation Standards"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Common_Red_Flags
    (
        type = textarea
        displayname = "Common Red Flags"
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    Reference_Example
    (
        type = textarea
        displayname = "Reference Example"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Governance_Ownership
    (
        type = section
        displayname = "Governance & Ownership"
        visibility = true
        row = 4
        column = 1
    )
    Prepared_By
    (
        type = picklist
        displayname = "Prepared By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 4
        column = 1
        width = medium
    )
    Reviewed_By
    (
        type = picklist
        displayname = "Reviewed By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 4
        column = 2
        width = medium
    )
    Approved_By
    (
        type = picklist
        displayname = "Approved By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 4
        column = 1
        width = medium
    )
    Last_Review_Date
    (
        type = date
        displayname = "Last Review Date"
        row = 4
        column = 2
        width = medium
    )
    Change_Description
    (
        type = textarea
        displayname = "Change Description"
        height = 120px
        row = 4
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}