list Workpapers_By_Type
{
    displayName = "Workpapers By Type"
    show all rows from Workpaper_Templates
    (
        Workpaper_Type as "Workpaper Type"
        Workpaper_ID as "Workpaper ID"
        Workpaper_Name as "Workpaper Name"
        Risk_Category as "Risk Category"
        Control_Type as "Control Type"
        Status
        Version
    )
    filters
    (
        Workpaper_Type
        Risk_Category
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Workpaper_Type ascending
    )
    sort by
    (
        Workpaper_Type ascending
        Workpaper_Name ascending
    )
}