report Workpaper_Library
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Workpaper_ID as "Workpaper ID"
                    Workpaper_Name as "Workpaper Name"
                    Workpaper_Type as "Workpaper Type"
                    Applicable_Audit_Type as "Applicable Audit Type"
                    Risk_Category as "Risk Category"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Workpaper_ID as "Workpaper ID"
                    Workpaper_Name as "Workpaper Name"
                    Workpaper_Type as "Workpaper Type"
                    Applicable_Audit_Type as "Applicable Audit Type"
                    Risk_Category as "Risk Category"
                    Control_Type as "Control Type"
                    Status
                    Version
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
