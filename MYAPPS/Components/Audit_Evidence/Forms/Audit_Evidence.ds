form Audit_Evidence
{
    displayname = "Audit Evidence"
    success message = "Audit evidence saved successfully"
    Evidence_Details
    (
        type = section
        displayname = "Evidence Details"
        row = 1
        column = 0
        width = medium
    )
    Evidence_ID
    (
        type = autonumber
        displayname = "Evidence ID"
        start index = 3001
        row = 1
        column = 1
        width = medium
    )
    must have Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Finding
    (
        type = picklist
        values = Findings.ID
        displayformat = [Finding_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Evidence_Title
    (
        type = text
        displayname = "Evidence Title"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Evidence_Type
    (
        type = picklist
        displayname = "Evidence Type"
        values = {"Document", "Image", "Link", "Interview", "Observation", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Evidence_Link
    (
        type = url
        displayname = "Evidence Link"
        enable = linkname, title
        target = same window
        row = 1
        column = 1
        width = medium
    )
    Collected_By_Email
    (
        type = email
        displayname = "Collected By Email"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Collection_Date
    (
        type = date
        displayname = "Collection Date"
        row = 1
        column = 1
        width = medium
    )
    Evidence_Status
    (
        type = picklist
        displayname = "Evidence Status"
        values = {"Draft", "Submitted", "Reviewed", "Accepted", "Rejected"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 180px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
