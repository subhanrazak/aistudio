report All_Audit_Evidence
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Evidence_ID as "Evidence ID"
                    Audit
                    Finding
                    Evidence_Title as "Evidence Title"
                    Evidence_Type as "Evidence Type"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Evidence_ID as "Evidence ID"
                    Audit
                    Finding
                    Evidence_Title as "Evidence Title"
                    Evidence_Type as "Evidence Type"
                    Collected_By_Email as "Collected By Email"
                    Collection_Date as "Collection Date"
                    Evidence_Status as "Evidence Status"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
