report Upcoming_Audits
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Plan_Code as "Plan Code"
                    Plan_Name as "Plan Name"
                    Planning_Year as "Planning Year"
                    Department
                    Plan_Size as "Plan Size"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Plan_Code as "Plan Code"
                    Plan_Name as "Plan Name"
                    Planning_Year as "Planning Year"
                    Department
                    Plan_Size as "Plan Size"
                    Priority_for_Implementation as "Priority for Implementation"
                    Selected_Entities_Count as "Selected Entities Count"
                    Total_Audit_Days as "Total Audit Days"
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
