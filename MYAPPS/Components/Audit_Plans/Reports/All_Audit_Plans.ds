default list All_Audit_Plans
{
    displayName = "Audit Plans List"
    show all rows from Audit_Plans
    (
        Plan_Code as "Plan Code"
        Plan_Name as "Plan Name"
        Planning_Year as "Planning Year"
        Department
        Plan_Size as "Plan Size"
        Priority_for_Implementation as "Priority for Implementation"
        Selected_Entities_Count as "Selected Entities Count"
        Total_Audit_Days as "Total Audit Days"
        Status
    )
    filters
    (
        Planning_Year
        Department
        Plan_Size
        Priority_for_Implementation
        Status
    )
    sort by
    (
        Planning_Year descending
        Plan_Name ascending
    )
}