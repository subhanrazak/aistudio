form Audit_Plans
{
    displayname = "Audit Plans"
    success message = "Audit plan saved successfully"
    Basic_Information
    (
        type = section
        displayname = "Basic Information"
        row = 1
        column = 0
    )
    must have unique Plan_Code
    (
        type = text
        displayname = "Plan Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Plan_Name
    (
        type = text
        displayname = "Plan Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Prepared_By
    (
        type = picklist
        displayname = "Prepared By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Created_Date
    (
        type = date
        displayname = "Created Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Approval_Level
    (
        type = picklist
        displayname = "Approval Level"
        values = {"Audit Manager", "Audit Committee Chair", "Executive Committee", "Board"}
        row = 1
        column = 2
        width = medium
    )
    Priority_for_Implementation
    (
        type = picklist
        displayname = "Priority for Implementation"
        values = {"Low", "Normal", "High", "Critical"}
        initial value = "Normal"
        row = 1
        column = 1
        width = medium
    )
    Comments_Notes
    (
        type = textarea
        displayname = "Comments & Notes"
        height = 140px
        row = 1
        column = 2
        width = medium
    )
    Plan_Scope
    (
        type = section
        displayname = "Plan Scope"
        visibility = true
        row = 2
        column = 1
    )
    Planning_Year
    (
        type = picklist
        displayname = "Planning Year"
        values = {"FY2025", "FY2026", "FY2027", "FY2028"}
        row = 2
        column = 1
        width = medium
    )
    Selected_Entities_Count
    (
        type = number
        displayname = "Selected Entities Count"
        row = 2
        column = 2
        width = medium
    )
    Total_Audit_Days
    (
        type = number
        displayname = "Total Audit Days"
        row = 2
        column = 1
        width = medium
    )
    Average_Risk_Score
    (
        type = decimal
        displayname = "Average Risk Score"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Plan_Size
    (
        type = picklist
        displayname = "Plan Size"
        values = {"Small", "Medium", "Large", "Extensive"}
        row = 2
        column = 1
        width = medium
    )
    Planned_Coverage_Percent
    (
        type = decimal
        displayname = "Planned Coverage Percent"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Resource_Requirement
    (
        type = text
        displayname = "Resource Requirement"
        maxchar = 100
        row = 2
        column = 1
        width = medium
    )
    Q1_Intensity_Percent
    (
        type = decimal
        displayname = "Q1 Intensity Percent"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Approval_Status
    (
        type = section
        displayname = "Approval Status"
        visibility = true
        row = 3
        column = 1
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft", "Submitted", "Approved", "Rejected", "Sent Back for Rework", "Closed"}
        initial value = "Draft"
        row = 3
        column = 1
        width = medium
    )
    Submitted_Date
    (
        type = date
        displayname = "Submitted Date"
        row = 3
        column = 2
        width = medium
    )
    Approved_Date
    (
        type = date
        displayname = "Approved Date"
        row = 3
        column = 1
        width = medium
    )
    Approved_By
    (
        type = picklist
        displayname = "Approved By"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Rework_Comments
    (
        type = textarea
        displayname = "Rework Comments"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Validation_Message
    (
        type = textarea
        displayname = "Validation Message"
        height = 100px
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }

    blueprint components
    {
        stages = {"Draft", "Submitted", "Approved", "Rejected", "Sent Back for Rework", "Closed"}
    }
}