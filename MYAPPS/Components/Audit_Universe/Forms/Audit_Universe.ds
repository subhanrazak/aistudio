form Audit_Universe
{
    displayname = "Audit Universe"
    success message = "Auditable entity saved successfully"
    Entity_Details
    (
        type = section
        displayname = "Entity Details"
        row = 1
        column = 0
    )
    must have unique Entity_Code
    (
        type = text
        displayname = "Entity Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Auditable_Entity_Name
    (
        type = text
        displayname = "Auditable Entity Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    must have Entity_Type
    (
        type = picklist
        displayname = "Entity Type"
        values = {"Department", "Process", "IT System", "Compliance", "Vendor", "Legal Entity"}
        row = 1
        column = 1
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Risk_Category
    (
        type = picklist
        displayname = "Risk Category"
        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Strategic", "Security", "Privacy", "Third Party"}
        row = 1
        column = 1
        width = medium
    )
    must have Entity_Criticality
    (
        type = picklist
        displayname = "Entity Criticality"
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 2
        width = medium
    )
    Regulatory_Impact
    (
        type = checkbox
        displayname = "Regulatory Impact"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Never_Audited
    (
        type = checkbox
        displayname = "Never Audited"
        initial value = false
        row = 1
        column = 2
        width = medium
    )
    Last_Audit_Date
    (
        type = date
        displayname = "Last Audit Date"
        row = 1
        column = 1
        width = medium
    )
    Risk_Scoring
    (
        type = section
        displayname = "Risk Scoring"
        visibility = true
        row = 2
        column = 1
    )
    must have Inherent_Risk_Score
    (
        type = number
        displayname = "Inherent Risk Score"
        initial value = 3
        row = 2
        column = 1
        width = medium
    )
    must have Control_Effectiveness_Score
    (
        type = number
        displayname = "Control Effectiveness Score"
        initial value = 3
        row = 2
        column = 2
        width = medium
    )
    Residual_Risk_Score
    (
        type = decimal
        displayname = "Residual Risk Score"
        decimalplace = 1
        row = 2
        column = 1
        width = medium
    )
    Risk_Level
    (
        type = picklist
        displayname = "Risk Level"
        values = {"Low", "Medium", "High", "Critical"}
        row = 2
        column = 2
        width = medium
    )
    Process_Complexity
    (
        type = picklist
        displayname = "Process Complexity"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 1
        width = medium
    )
    Automation_Level
    (
        type = picklist
        displayname = "Automation Level"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 2
        width = medium
    )
    Regulatory_Sensitivity
    (
        type = picklist
        displayname = "Regulatory Sensitivity"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 1
        width = medium
    )
    Past_Issues
    (
        type = picklist
        displayname = "Past Issues"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 2
        width = medium
    )
    Effort_Days
    (
        type = number
        displayname = "Effort Days"
        initial value = 45
        row = 2
        column = 1
        width = medium
    )
    Recommended_FY
    (
        type = picklist
        displayname = "Recommended FY"
        values = {"FY2025", "FY2026", "FY2027", "FY2028"}
        row = 2
        column = 2
        width = medium
    )
    Audit_Frequency
    (
        type = picklist
        displayname = "Audit Frequency"
        values = {"Annual", "Every 2 Years", "Every 3 Years", "Quarterly", "Monthly"}
        row = 2
        column = 1
        width = medium
    )
    Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"Low", "Normal", "High", "Critical"}
        row = 2
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 2
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}