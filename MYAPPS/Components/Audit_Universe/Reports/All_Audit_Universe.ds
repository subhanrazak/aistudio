default list All_Audit_Universe
{
    displayName = "All Audit Universe"
    show all rows from Audit_Universe
    (
        Entity_Code as "Entity Code"
        Auditable_Entity_Name as "Auditable Entity Name"
        Entity_Type as "Entity Type"
        Department
        Risk_Category as "Risk Category"
        Entity_Criticality as "Entity Criticality"
        Inherent_Risk_Score as "Inherent Risk Score"
        Control_Effectiveness_Score as "Control Effectiveness Score"
        Residual_Risk_Score as "Residual Risk Score"
        Risk_Level as "Risk Level"
        Regulatory_Impact as "Regulatory Impact"
        Last_Audit_Date as "Last Audit Date"
        Recommended_FY as "Recommended FY"
        Status
    )
    filters
    (
        Department
        Entity_Type
        Risk_Category
        Risk_Level
        Status
    )
    sort by
    (
        Risk_Level descending
        Auditable_Entity_Name ascending
    )
}