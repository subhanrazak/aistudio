kanban Audit_Universe_Risk_Kanban
{
    displayName = "Audit Universe Risk Kanban"
    show all rows from Audit_Universe
    (
        Entity_Code as "Entity Code"
        Auditable_Entity_Name as "Auditable Entity Name"
        Department
        Risk_Category as "Risk Category"
        Residual_Risk_Score as "Residual Risk Score"
        Risk_Level as "Risk Level"
        Audit_Frequency as "Audit Frequency"
        Status
    )
    filters
    (
        Department
        Risk_Category
        Risk_Level
        Status
    )
    sort by
    (
        Residual_Risk_Score descending
    )
    options
    (
        display field = Risk_Level
        emptycolumn = "Unrated"
        sortorder = ascending
        recordcount = enable
    )
}