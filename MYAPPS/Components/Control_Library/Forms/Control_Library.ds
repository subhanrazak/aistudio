form Control_Library
{
    displayname = "Control Library"
    success message = "Control saved successfully"
    Control_Details
    (
        type = section
        displayname = "Control Details"
        row = 1
        column = 0
    )
    must have unique Control_Code
    (
        type = text
        displayname = "Control Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Control_Name
    (
        type = text
        displayname = "Control Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Control_Description
    (
        type = textarea
        displayname = "Control Description"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    must have Control_Type
    (
        type = picklist
        displayname = "Control Type"
        values = {"Preventive", "Detective", "Corrective", "Directive"}
        row = 1
        column = 2
        width = medium
    )
    Control_Nature
    (
        type = picklist
        displayname = "Control Nature"
        values = {"Manual", "Automated", "Semi-Automated"}
        row = 1
        column = 1
        width = medium
    )
    Control_Category
    (
        type = picklist
        displayname = "Control Category"
        values = {"Access Control", "Change Management", "Data Management", "Financial Control", "Operational Control", "Compliance Control", "Security Control", "Vendor Control"}
        row = 1
        column = 2
        width = medium
    )
    Frequency
    (
        type = picklist
        displayname = "Frequency"
        values = {"Continuous", "Daily", "Weekly", "Monthly", "Quarterly", "Annually", "Ad hoc"}
        row = 1
        column = 1
        width = medium
    )
    Owner_Department
    (
        type = picklist
        displayname = "Owner Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Control_Owner
    (
        type = picklist
        displayname = "Control Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Effectiveness_Status
    (
        type = picklist
        displayname = "Effectiveness Status"
        values = {"Effective", "Partial", "Ineffective", "Not Tested"}
        row = 1
        column = 2
        width = medium
    )
    Regulatory_Reference
    (
        type = text
        displayname = "Regulatory Reference"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}