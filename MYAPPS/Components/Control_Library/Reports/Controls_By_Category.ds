list Controls_By_Category
{
    displayName = "Controls By Category"
    show all rows from Control_Library
    (
        Control_Category as "Control Category"
        Control_Code as "Control Code"
        Control_Name as "Control Name"
        Control_Type as "Control Type"
        Control_Nature as "Control Nature"
        Frequency
        Effectiveness_Status as "Effectiveness Status"
        Status
    )
    filters
    (
        Control_Category
        Control_Type
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Control_Category ascending
    )
    sort by
    (
        Control_Category ascending
        Control_Name ascending
    )
}