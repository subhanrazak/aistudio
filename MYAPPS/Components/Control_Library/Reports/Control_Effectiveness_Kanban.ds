kanban Control_Effectiveness_Kanban
{
    displayName = "Control Effectiveness Kanban"
    show all rows from Control_Library
    (
        Control_Code as "Control Code"
        Control_Name as "Control Name"
        Control_Type as "Control Type"
        Control_Category as "Control Category"
        Owner_Department as "Owner Department"
        Effectiveness_Status as "Effectiveness Status"
        Status
    )
    filters
    (
        Control_Type
        Control_Category
        Effectiveness_Status
        Status
    )
    sort by
    (
        Control_Name ascending
    )
    options
    (
        display field = Effectiveness_Status
        emptycolumn = "Unrated"
        sortorder = ascending
        recordcount = enable
    )
}