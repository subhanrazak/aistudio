report All_Checklist_Items
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Audit
                    Checklist_Question as "Checklist Question"
                    Category
                    Result
                    Requires_Finding as "Requires Finding"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Audit
                    Checklist_Question as "Checklist Question"
                    Category
                    Result
                    Requires_Finding as "Requires Finding"
                    Evidence_Link as "Evidence Link"
                    Notes
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
