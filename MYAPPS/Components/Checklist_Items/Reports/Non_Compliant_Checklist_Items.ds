list Non_Compliant_Checklist_Items
{
    displayName = "Non-Compliant Checklist Items"
    show all rows from Checklist_Items [Result == "Non-Compliant"]
    (
        Audit
        Checklist_Question as "Checklist Question"
        Category
        Result
        Requires_Finding as "Requires Finding"
        Notes
    )
    filters
    (
        Audit
        Category
        Result
        Requires_Finding
    )
    sort by
    (
        Category ascending
    )
}
