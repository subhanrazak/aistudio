default list All_Checklist_Items
{
    displayName = "All Checklist Items"
    show all rows from Checklist_Items
    (
        Audit
        Checklist_Question as "Checklist Question"
        Category
        Result
        Requires_Finding as "Requires Finding"
        Evidence_Link as "Evidence Link"
        Notes
    )
    filters
    (
        Audit
        Category
        Result
        Requires_Finding
    )
    sort by
    (
        Category ascending
    )
}
