Checklist_Items_On_Validate as "Checklist Items On Validate"
{
    type = form
    form = Checklist_Items
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Result == "Non-Compliant" && ifnull(input.Notes, "") == "")
                {
                    alert "Notes are required when the checklist result is Non-Compliant.";
                    cancel submit;
                }
            )
        }
    }
}
