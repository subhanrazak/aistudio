kanban Audit_Status_Board
{
    displayName = "Audit Execution Board"
    show all rows from Audits
    (
        Audit_Code as "Audit Code"
        Audit_Title as "Audit Title"
        Planned_End as "Planned End"
        Status
        Stage
        Lead_Auditor as "Lead Auditor"
        Progress_Percent as "Progress Percent"
    )
    filters
    (
        Status
        Stage
        Lead_Auditor
        Planned_End
    )
    sort by
    (
        Planned_End ascending
    )
    options
    (
        display field = Stage
        sortorder = custom
        recordcount = enable
    )
}