calendar Audit_Calendar
{
    displayName = "Audit Calendar"
    show all rows from Audits
    (
        Audit_Code as "Audit Code"
        Audit_Title as "Audit Title"
        Planned_Start as "Planned Start"
        Planned_End as "Planned End"
        Status
        Stage
        Lead_Auditor as "Lead Auditor"
    )
    filters
    (
        Status
        Stage
        Lead_Auditor
        Planned_Start
    )
    sort by
    (
        Planned_Start ascending
    )
    options
    (
        display type = month
        week start day = monday
        display field = Audit_Title
        start date = Planned_Start
        end date = Planned_End
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}