default list All_Audits
{
    displayName = "Audit Listings"
    show all rows from Audits
    (
        Audit_Code as "Audit Code"
        Audit_Title as "Audit Title"
        Planned_Start as "Planned Start"
        Planned_End as "Planned End"
        Status
        Stage
        Lead_Auditor as "Lead Auditor"
        Progress_Percent as "Progress Percent"
    )
    filters
    (
        Status
        Stage
        Lead_Auditor
        Planned_Start
    )
    sort by
    (
        Planned_Start descending
        Audit_Code ascending
    )
}