list Active_Audits
{
    displayName = "Active Audits"
    show all rows from Audits [Status == "Active"]
    (
        Audit_Code as "Audit Code"
        Audit_Title as "Audit Title"
        Planned_Start as "Planned Start"
        Planned_End as "Planned End"
        Status
        Stage
        Lead_Auditor as "Lead Auditor"
        Risk_Rating as "Risk Rating"
        Progress_Percent as "Progress Percent"
    )
    filters
    (
        Status
        Stage
        Lead_Auditor
        Risk_Rating
    )
    sort by
    (
        Planned_End ascending
    )
}