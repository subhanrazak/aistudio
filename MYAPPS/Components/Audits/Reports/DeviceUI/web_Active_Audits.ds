report Active_Audits
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Audit_Code as "Audit Code"
                    Audit_Title as "Audit Title"
                    Planned_Start as "Planned Start"
                    Planned_End as "Planned End"
                    Status
                    Stage
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Audit_Code as "Audit Code"
                    Audit_Title as "Audit Title"
                    Planned_Start as "Planned Start"
                    Planned_End as "Planned End"
                    Status
                    Stage
                    Lead_Auditor as "Lead Auditor"
                    Risk_Rating as "Risk Rating"
                    Progress_Percent as "Progress Percent"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
