list Completed_Audits
{
    displayName = "Completed Audits"
    show all rows from Audits [Status == "Completed" || Status == "Closed"]
    (
        Audit_Code as "Audit Code"
        Audit_Title as "Audit Title"
        Planned_Start as "Planned Start"
        Actual_End as "Actual End"
        Status
        Stage
        Lead_Auditor as "Lead Auditor"
        Progress_Percent as "Progress Percent"
    )
    filters
    (
        Status
        Stage
        Lead_Auditor
        Actual_End
    )
    sort by
    (
        Actual_End descending
    )
}