form Audits
{
    displayname = "Audits"
    success message = "Audit record saved successfully"
    Audit_Details
    (
        type = section
        displayname = "Audit Details"
        row = 1
        column = 0
    )
    must have unique Audit_Code
    (
        type = text
        displayname = "Audit Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Audit_Title
    (
        type = text
        displayname = "Audit Title"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Audit_Type
    (
        type = picklist
        displayname = "Audit Type"
        values = {"Financial Audit", "Operational Audit", "IT Audit", "Compliance Audit", "Security Audit", "Procurement Audit"}
        row = 1
        column = 1
        width = medium
    )
    Auditable_Entity_Department
    (
        type = picklist
        displayname = "Auditable Entity Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Source_Plan
    (
        type = picklist
        displayname = "Source Plan"
        values = Audit_Plans.ID
        displayformat = [Plan_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        values = {"Active", "Inactive", "Completed", "Closed", "Cancelled"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Stage
    (
        type = picklist
        values = {"Planning", "Execution", "Reporting", "Follow-up", "Closed"}
        initial value = "Planning"
        row = 1
        column = 1
        width = medium
    )
    Schedule
    (
        type = section
        displayname = "Schedule"
        visibility = true
        row = 2
        column = 1
    )
    Planned_Start
    (
        type = date
        displayname = "Planned Start"
        row = 2
        column = 1
        width = medium
    )
    Planned_End
    (
        type = date
        displayname = "Planned End"
        row = 2
        column = 2
        width = medium
    )
    Actual_Start
    (
        type = date
        displayname = "Actual Start"
        row = 2
        column = 1
        width = medium
    )
    Actual_End
    (
        type = date
        displayname = "Actual End"
        row = 2
        column = 2
        width = medium
    )
    Risk_Rating
    (
        type = picklist
        displayname = "Risk Rating"
        values = {"Low", "Medium", "High", "Critical"}
        row = 2
        column = 1
        width = medium
    )
    Audit_Size
    (
        type = picklist
        displayname = "Audit Size"
        values = {"Small", "Medium", "Large", "Extensive"}
        row = 2
        column = 2
        width = medium
    )
    Audit_Objective_Scope
    (
        type = textarea
        displayname = "Audit Objective Scope"
        height = 160px
        row = 2
        column = 1
        width = medium
    )
    Team_Resources
    (
        type = section
        displayname = "Team Resources"
        visibility = true
        row = 3
        column = 1
    )
    Lead_Auditor
    (
        type = picklist
        displayname = "Lead Auditor"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    Audit_Team_Size
    (
        type = number
        displayname = "Audit Team Size"
        row = 3
        column = 2
        width = medium
    )
    Estimated_Effort_Hours
    (
        type = number
        displayname = "Estimated Effort Hours"
        row = 3
        column = 1
        width = medium
    )
    Indicative_Budget
    (
        type = INR
        displayname = "Indicative Budget"
        decimalplace = 2
        maxchar = 14
        row = 3
        column = 2
        width = medium
    )
    Progress_Percent
    (
        type = decimal
        displayname = "Progress Percent"
        decimalplace = 2
        initial value = 0
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 160px
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }

    blueprint components
    {
        stages = {"Planning", "Execution", "Reporting", "Follow-up", "Closed"}
    }
}