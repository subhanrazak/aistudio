form Departments
{
    displayname = "Departments"
    success message = "Department saved successfully"
    Department_Details
    (
        type = section
        displayname = "Department Details"
        row = 1
        column = 0
    )
    must have unique Department_Code
    (
        type = text
        displayname = "Department Code"
        maxchar = 30
        row = 1
        column = 1
        width = medium
    )
    must have unique Department_Name
    (
        type = text
        displayname = "Department Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    must have Department_Type
    (
        type = picklist
        displayname = "Department Type"
        values = {"Business Unit", "Department", "Process Area", "IT System", "Compliance Function", "Legal Entity"}
        row = 1
        column = 1
        width = medium
    )
    Parent_Department
    (
        type = picklist
        displayname = "Parent Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Department_Head
    (
        type = text
        displayname = "Department Head"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 1
        column = 2
        width = medium
        personal data = true
    )
    Risk_Profile
    (
        type = picklist
        displayname = "Risk Profile"
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        displayname = "Description"
        height = 120px
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}