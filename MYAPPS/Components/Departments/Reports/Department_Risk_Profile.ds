kanban Department_Risk_Profile
{
    displayName = "Department Risk Profile"
    show all rows from Departments
    (
        Department_Code as "Department Code"
        Department_Name as "Department Name"
        Department_Type as "Department Type"
        Parent_Department as "Parent Department"
        Risk_Profile as "Risk Profile"
        Status
    )
    filters
    (
        Status
        Department_Type
        Risk_Profile
    )
    sort by
    (
        Department_Name ascending
    )
    options
    (
        display field = Risk_Profile
        emptycolumn = "Unrated"
        sortorder = ascending
        recordcount = enable
    )
}