Departments_On_Validate as "Departments On Validate"
{
    type = form
    form = Departments
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if(input.Parent_Department != null && input.ID != null && input.Parent_Department == input.ID)
                {
                    alert "A department cannot be its own parent department.";
                    cancel submit;
                }
            )
        }
    }
}