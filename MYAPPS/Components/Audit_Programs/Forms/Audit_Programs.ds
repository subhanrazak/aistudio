form Audit_Programs
{
    displayname = "Audit Programs"
    success message = "Audit program saved successfully"
    Program_Details
    (
        type = section
        displayname = "Program Details"
        row = 1
        column = 0
        width = medium
    )
    Program_Code
    (
        type = autonumber
        displayname = "Program Code"
        start index = 2001
        row = 1
        column = 1
        width = medium
    )
    must have Program_Name
    (
        type = text
        displayname = "Program Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Program_Year
    (
        type = number
        displayname = "Program Year"
        maxchar = 4
        row = 1
        column = 2
        width = medium
    )
    Department
    (
        type = picklist
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Program_Owner_Email
    (
        type = email
        displayname = "Program Owner Email"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Start_Date
    (
        type = date
        displayname = "Start Date"
        row = 1
        column = 1
        width = medium
    )
    End_Date
    (
        type = date
        displayname = "End Date"
        row = 1
        column = 2
        width = medium
    )
    Program_Status
    (
        type = picklist
        displayname = "Program Status"
        values = {"Draft", "Active", "On Hold", "Completed", "Cancelled"}
        row = 1
        column = 1
        width = medium
    )
    Objectives
    (
        type = textarea
        height = 180px
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
