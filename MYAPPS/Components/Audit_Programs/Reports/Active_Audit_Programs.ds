list Active_Audit_Programs
{
    displayName = "Active Audit Programs"
    show all rows from Audit_Programs [Program_Status == "Active"]
    (
        Program_Code as "Program Code"
        Program_Name as "Program Name"
        Department
        Program_Owner_Email as "Program Owner Email"
        Start_Date as "Start Date"
        End_Date as "End Date"
        Program_Status as "Program Status"
    )
    filters
    (
        Department
        Program_Status
    )
    sort by
    (
        Start_Date ascending
    )
}
