default list All_Audit_Programs
{
    displayName = "All Audit Programs"
    show all rows from Audit_Programs
    (
        Program_Code as "Program Code"
        Program_Name as "Program Name"
        Program_Year as "Program Year"
        Department
        Program_Owner_Email as "Program Owner Email"
        Start_Date as "Start Date"
        End_Date as "End Date"
        Program_Status as "Program Status"
    )
    filters
    (
        Program_Year
        Department
        Program_Status
    )
    sort by
    (
        Program_Year descending
        Program_Name ascending
    )
}
