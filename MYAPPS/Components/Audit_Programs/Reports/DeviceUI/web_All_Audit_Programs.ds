report All_Audit_Programs
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Program_Code as "Program Code"
                    Program_Name as "Program Name"
                    Program_Year as "Program Year"
                    Department
                    Program_Owner_Email as "Program Owner Email"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Program_Code as "Program Code"
                    Program_Name as "Program Name"
                    Program_Year as "Program Year"
                    Department
                    Program_Owner_Email as "Program Owner Email"
                    Start_Date as "Start Date"
                    End_Date as "End Date"
                    Program_Status as "Program Status"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
