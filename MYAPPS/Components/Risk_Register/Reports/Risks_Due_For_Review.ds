calendar Risks_Due_For_Review
{
    displayName = "Risks Due For Review"
    show all rows from Risk_Register [Next_Review_Date != null]
    (
        Risk_Title as "Risk Title"
        Risk_Category as "Risk Category"
        Residual_Risk_Rating as "Residual Risk Rating"
        Risk_Owner as "Risk Owner"
        Next_Review_Date as "Next Review Date"
        Status
    )
    filters
    (
        Risk_Category
        Residual_Risk_Rating
        Status
    )
    options
    (
        display type = month
        week start day = monday
        display field = Risk_Title
        start date = Next_Review_Date
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}