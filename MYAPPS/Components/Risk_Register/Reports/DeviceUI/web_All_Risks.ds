report All_Risks
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Risk_Code as "Risk Code"
                    Risk_Title as "Risk Title"
                    Business_Unit_Entity as "Business Unit / Entity"
                    Inherent_Risk_Score as "Inherent Risk Score"
                    Control_Effectiveness as "Control Effectiveness"
                    Residual_Risk_Score as "Residual Risk Score"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Risk_Code as "Risk Code"
                    Risk_Title as "Risk Title"
                    Business_Unit_Entity as "Business Unit / Entity"
                    Inherent_Risk_Score as "Inherent Risk Score"
                    Control_Effectiveness as "Control Effectiveness"
                    Residual_Risk_Score as "Residual Risk Score"
                    Risk_Owner as "Risk Owner"
                    Status
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
