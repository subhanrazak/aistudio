default list All_Risks
{
    displayName = "All Risks"
    show all rows from Risk_Register
    (
        Risk_Code as "Risk Code"
        Risk_Title as "Risk Title"
        Business_Unit_Entity as "Business Unit / Entity"
        Inherent_Risk_Score as "Inherent Risk Score"
        Control_Effectiveness as "Control Effectiveness"
        Residual_Risk_Score as "Residual Risk Score"
        Risk_Owner as "Risk Owner"
        Status
    )
    filters
    (
        Business_Unit_Entity
        Control_Effectiveness
        Status
    )
    sort by
    (
        Residual_Risk_Score descending
        Risk_Title ascending
    )
}