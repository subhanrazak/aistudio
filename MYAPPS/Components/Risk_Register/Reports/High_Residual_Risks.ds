list High_Residual_Risks
{
    displayName = "High Residual Risks"
    show all rows from Risk_Register [Residual_Risk_Rating == "High" || Residual_Risk_Rating == "Critical"]
    (
        Risk_Code as "Risk Code"
        Risk_Title as "Risk Title"
        Business_Unit_Entity as "Business Unit / Entity"
        Risk_Category as "Risk Category"
        Residual_Risk_Score as "Residual Risk Score"
        Residual_Risk_Rating as "Residual Risk Rating"
        Risk_Owner as "Risk Owner"
        Next_Review_Date as "Next Review Date"
        Status
    )
    filters
    (
        Risk_Category
        Residual_Risk_Rating
        Status
    )
    sort by
    (
        Residual_Risk_Score descending
        Next_Review_Date ascending
    )
}