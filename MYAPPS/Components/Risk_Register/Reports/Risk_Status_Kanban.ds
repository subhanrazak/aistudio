kanban Risk_Status_Kanban
{
    displayName = "Risk Status Kanban"
    show all rows from Risk_Register
    (
        Risk_Code as "Risk Code"
        Risk_Title as "Risk Title"
        Risk_Category as "Risk Category"
        Residual_Risk_Rating as "Residual Risk Rating"
        Risk_Owner as "Risk Owner"
        Status
    )
    filters
    (
        Risk_Category
        Residual_Risk_Rating
        Status
    )
    sort by
    (
        Risk_Title ascending
    )
    options
    (
        display field = Status
        sortorder = ascending
        recordcount = enable
    )
}