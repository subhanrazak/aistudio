form Risk_Register
{
    displayname = "Risk Register"
    success message = "Risk saved successfully"
    Risk_Info
    (
        type = section
        displayname = "Risk Info"
        row = 1
        column = 0
    )
    must have unique Risk_Code
    (
        type = text
        displayname = "Risk Code"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Risk_Title
    (
        type = text
        displayname = "Risk Title"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    Risk_Description
    (
        type = textarea
        displayname = "Risk Description"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Business_Unit_Entity
    (
        type = picklist
        displayname = "Business Unit / Entity"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Auditable_Entity
    (
        type = picklist
        displayname = "Auditable Entity"
        values = Audit_Universe.ID
        displayformat = [Auditable_Entity_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Process_Function_Area
    (
        type = text
        displayname = "Process / Function Area"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Objective_Linked
    (
        type = text
        displayname = "Objective Linked"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    Category_Ownership
    (
        type = section
        displayname = "Category & Ownership"
        visibility = true
        row = 2
        column = 1
    )
    Risk_Category
    (
        type = picklist
        displayname = "Risk Category"
        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Strategic", "Security", "Privacy", "Third Party"}
        row = 2
        column = 1
        width = medium
    )
    Risk_Sub_Category
    (
        type = text
        displayname = "Risk Sub-Category"
        maxchar = 150
        row = 2
        column = 2
        width = medium
    )
    Risk_Owner
    (
        type = picklist
        displayname = "Risk Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Risk_Coordinators
    (
        type = textarea
        displayname = "Risk Coordinators"
        height = 120px
        row = 2
        column = 2
        width = medium
    )
    Requested_By
    (
        type = text
        displayname = "Requested By"
        maxchar = 150
        row = 2
        column = 1
        width = medium
    )
    Escalation_Owner
    (
        type = picklist
        displayname = "Escalation Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    Reviewer_Approver
    (
        type = picklist
        displayname = "Reviewer / Approver"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Risk_Assessment
    (
        type = section
        displayname = "Risk Assessment"
        visibility = true
        row = 3
        column = 1
    )
    must have Impact_Level
    (
        type = picklist
        displayname = "Impact Level"
        values = {"1-Low", "2-Moderate", "3-Medium", "4-High", "5-Critical"}
        row = 3
        column = 1
        width = medium
    )
    must have Likelihood
    (
        type = picklist
        displayname = "Likelihood"
        values = {"1-Rare", "2-Unlikely", "3-Possible", "4-Likely", "5-Almost Certain"}
        row = 3
        column = 2
        width = medium
    )
    Inherent_Risk_Score
    (
        type = decimal
        displayname = "Inherent Risk Score"
        decimalplace = 1
        row = 3
        column = 1
        width = medium
    )
    Control_Effectiveness
    (
        type = picklist
        displayname = "Control Effectiveness"
        values = {"Effective", "Partial", "Ineffective", "Not Tested"}
        row = 3
        column = 2
        width = medium
    )
    Control_Effectiveness_Score
    (
        type = decimal
        displayname = "Control Effectiveness Score"
        decimalplace = 1
        row = 3
        column = 1
        width = medium
    )
    Residual_Risk_Score
    (
        type = decimal
        displayname = "Residual Risk Score"
        decimalplace = 1
        row = 3
        column = 2
        width = medium
    )
    Residual_Risk_Rating
    (
        type = picklist
        displayname = "Residual Risk Rating"
        values = {"Low", "Medium", "High", "Critical"}
        row = 3
        column = 1
        width = medium
    )
    Mapped_Controls
    (
        type = list
        displayname = "Mapped Controls"
        values = {"Multi-Factor Authentication", "Employee Security Training", "Endpoint Protection", "Vendor Due Diligence", "Access Review", "Incident Response"}
        row = 3
        column = 2
        width = medium
    )
    Mitigation_Monitoring
    (
        type = section
        displayname = "Mitigation & Monitoring"
        visibility = true
        row = 4
        column = 1
    )
    Risk_Treatment
    (
        type = picklist
        displayname = "Risk Treatment"
        values = {"Accept", "Mitigate", "Transfer", "Avoid", "Escalate"}
        row = 4
        column = 1
        width = medium
    )
    Target_Residual_Risk
    (
        type = picklist
        displayname = "Target Residual Risk"
        values = {"Low (1-4)", "Medium (5-14)", "High (15-25)"}
        row = 4
        column = 2
        width = medium
    )
    Review_Frequency
    (
        type = picklist
        displayname = "Review Frequency"
        values = {"Monthly", "Quarterly", "Semi-Annual", "Annual"}
        row = 4
        column = 1
        width = medium
    )
    Next_Review_Date
    (
        type = date
        displayname = "Next Review Date"
        row = 4
        column = 2
        width = medium
    )
    Risk_Appetite_Alignment
    (
        type = picklist
        displayname = "Risk Appetite Alignment"
        values = {"Within Appetite", "Above Appetite", "Breach"}
        row = 4
        column = 1
        width = medium
    )
    Mitigation_Plans
    (
        type = textarea
        displayname = "Mitigation Plans"
        height = 120px
        row = 4
        column = 2
        width = medium
    )
    Linked_Regulations
    (
        type = list
        displayname = "Linked Regulations"
        values = {"RBI", "SOX", "GDPR", "ISO 27001", "SOC Regulation", "Data Encryption Standard", "Fraud Detection System", "Regulatory Compliance"}
        row = 4
        column = 1
        width = medium
    )
    Audit_Coverage
    (
        type = picklist
        displayname = "Audit Coverage"
        values = {"Not Covered", "Planned", "Covered", "Overdue"}
        row = 4
        column = 2
        width = medium
    )
    Additional_Notes
    (
        type = textarea
        displayname = "Additional Notes"
        height = 120px
        row = 4
        column = 1
        width = medium
    )
    Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft", "Under Review", "Approved", "Accepted", "Escalated", "Closed"}
        initial value = "Draft"
        row = 4
        column = 2
        width = medium
    )
    Attachments
    (
        type = upload file
        displayname = "Attachments"
        file count = 5
        browse = local_drive, google_docs, zoho_docs
        row = 4
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}