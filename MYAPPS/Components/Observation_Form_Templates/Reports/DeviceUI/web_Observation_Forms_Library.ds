report Observation_Forms_Library
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Form_ID as "Form ID"
                    Form_Name as "Form Name"
                    Observation_Type as "Observation Type"
                    Default_Severity_Level as "Default Severity Level"
                    Risk_Category as "Risk Category"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Form_ID as "Form ID"
                    Form_Name as "Form Name"
                    Observation_Type as "Observation Type"
                    Default_Severity_Level as "Default Severity Level"
                    Risk_Category as "Risk Category"
                    Required_Fields_Count as "Required Fields Count"
                    Total_Fields_Count as "Total Fields Count"
                    Initial_Status as "Initial Status"
                    Version
                    Owner
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
