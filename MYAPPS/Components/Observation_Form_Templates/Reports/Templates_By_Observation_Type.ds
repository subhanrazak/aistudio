list Templates_By_Observation_Type
{
    displayName = "Templates By Observation Type"
    show all rows from Observation_Form_Templates
    (
        Observation_Type as "Observation Type"
        Form_ID as "Form ID"
        Form_Name as "Form Name"
        Default_Severity_Level as "Default Severity Level"
        Risk_Category as "Risk Category"
        Initial_Status as "Initial Status"
        Version
        Owner
    )
    filters
    (
        Observation_Type
        Risk_Category
        Initial_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Observation_Type ascending
    )
    sort by
    (
        Observation_Type ascending
        Form_Name ascending
    )
}