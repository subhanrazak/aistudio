list Active_Observation_Form_Templates
{
    displayName = "Active Observation Form Templates"
    show all rows from Observation_Form_Templates [Initial_Status == "Active" || Initial_Status == "Published"]
    (
        Form_ID as "Form ID"
        Form_Name as "Form Name"
        Observation_Type as "Observation Type"
        Default_Severity_Level as "Default Severity Level"
        Risk_Category as "Risk Category"
        Initial_Status as "Initial Status"
        Version
        Owner
    )
    filters
    (
        Observation_Type
        Risk_Category
        Initial_Status
    )
    sort by
    (
        Form_Name ascending
    )
}