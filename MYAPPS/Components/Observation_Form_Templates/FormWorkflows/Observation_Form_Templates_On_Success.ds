Observation_Form_Templates_On_Success as "Observation Form Templates On Success"
{
    type = form
    form = Observation_Form_Templates
    record event = on add or edit

    on success
    {
        actions
        {
            custom deluge script
            (
                if(input.Initial_Status == "Published" && input.Last_Published_Date == null)
                {
                    input.Last_Published_Date = zoho.currentdate;
                }
            )
        }
    }
}