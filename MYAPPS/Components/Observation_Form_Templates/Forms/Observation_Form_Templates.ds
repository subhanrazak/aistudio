form Observation_Form_Templates
{
    displayname = "Observation Form Templates"
    success message = "Observation form template saved successfully"
    Basic_Information
    (
        type = section
        displayname = "Basic Information"
        row = 1
        column = 0
    )
    must have unique Form_ID
    (
        type = text
        displayname = "Form ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    must have Form_Name
    (
        type = text
        displayname = "Form Name"
        maxchar = 200
        row = 1
        column = 2
        width = medium
    )
    must have Observation_Type
    (
        type = picklist
        displayname = "Observation Type"
        values = {"Control Deficiency", "Process Inefficiency", "Compliance Gap", "Security Finding", "Risk Event", "Improvement Opportunity"}
        row = 1
        column = 1
        width = medium
    )
    Applicable_Audit_Type
    (
        type = list
        displayname = "Applicable Audit Type"
        values = {"Financial Audit", "Operational Audit", "IT Audit", "Compliance Audit", "Security Audit"}
        row = 1
        column = 2
        width = medium
    )
    Default_Severity_Level
    (
        type = picklist
        displayname = "Default Severity Level"
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 1
        width = medium
    )
    Risk_Category
    (
        type = picklist
        displayname = "Risk Category"
        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Security", "Privacy"}
        row = 1
        column = 2
        width = medium
    )
    Description_Purpose
    (
        type = textarea
        displayname = "Description / Purpose"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Keywords_Tags
    (
        type = text
        displayname = "Keywords / Tags"
        maxchar = 250
        row = 1
        column = 2
        width = medium
    )
    Field_Configuration
    (
        type = section
        displayname = "Field Configuration"
        visibility = true
        row = 2
        column = 1
    )
    Required_Fields_Count
    (
        type = number
        displayname = "Required Fields Count"
        initial value = 5
        row = 2
        column = 1
        width = medium
    )
    Total_Fields_Count
    (
        type = number
        displayname = "Total Fields Count"
        initial value = 9
        row = 2
        column = 2
        width = medium
    )
    Observation_Title_Required
    (
        type = checkbox
        displayname = "Observation Title Required"
        initial value = true
        row = 2
        column = 1
        width = medium
    )
    Observation_Description_Required
    (
        type = checkbox
        displayname = "Observation Description Required"
        initial value = true
        row = 2
        column = 2
        width = medium
    )
    Root_Cause_Required
    (
        type = checkbox
        displayname = "Root Cause Required"
        initial value = true
        row = 2
        column = 1
        width = medium
    )
    Impact_Assessment_Required
    (
        type = checkbox
        displayname = "Impact Assessment Required"
        initial value = true
        row = 2
        column = 2
        width = medium
    )
    Recommendations_Required
    (
        type = checkbox
        displayname = "Recommendations Required"
        initial value = true
        row = 2
        column = 1
        width = medium
    )
    Validation_Rules
    (
        type = section
        displayname = "Validation Rules"
        visibility = true
        row = 3
        column = 1
    )
    Minimum_Required_Fields
    (
        type = text
        displayname = "Minimum Required Fields"
        maxchar = 100
        row = 3
        column = 1
        width = medium
    )
    Auto_Save_Interval
    (
        type = picklist
        displayname = "Auto-Save Interval"
        values = {"Off", "Every 2 min", "Every 5 min", "Every 10 min"}
        row = 3
        column = 2
        width = medium
    )
    Require_Supporting_Evidence_Upload
    (
        type = checkbox
        displayname = "Require Supporting Evidence Upload"
        initial value = true
        row = 3
        column = 1
        width = medium
    )
    Require_Root_Cause_Analysis
    (
        type = checkbox
        displayname = "Require Root Cause Analysis"
        initial value = true
        row = 3
        column = 2
        width = medium
    )
    Require_Action_Plan_With_Timeline
    (
        type = checkbox
        displayname = "Require Action Plan With Timeline"
        initial value = true
        row = 3
        column = 1
        width = medium
    )
    Enable_Approval_Workflow
    (
        type = checkbox
        displayname = "Enable Approval Workflow"
        initial value = true
        row = 3
        column = 2
        width = medium
    )
    Auto_Notify_Observation_Owner
    (
        type = checkbox
        displayname = "Auto Notify Observation Owner"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Initial_Status
    (
        type = picklist
        displayname = "Initial Status"
        values = {"Draft", "Active", "Inactive", "Published"}
        initial value = "Draft"
        row = 3
        column = 2
        width = medium
    )
    Version
    (
        type = text
        displayname = "Version"
        initial value = "v1.0"
        maxchar = 20
        row = 3
        column = 1
        width = medium
    )
    Version_Notes
    (
        type = textarea
        displayname = "Version Notes"
        height = 100px
        row = 3
        column = 2
        width = medium
    )
    Last_Published_Date
    (
        type = date
        displayname = "Last Published Date"
        row = 3
        column = 1
        width = medium
    )
    Owner
    (
        type = picklist
        displayname = "Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 3
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}