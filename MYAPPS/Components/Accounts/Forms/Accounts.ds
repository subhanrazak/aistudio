form Accounts
{
    displayname = "Accounts"
    success message = "Account saved successfully"
    Account_Details
    (
        type = section
        displayname = "Account Details"
        row = 1
        column = 0
        width = medium
    )
    must have Account_Name
    (
        type = text
        displayname = "Account Name"
        maxchar = 150
        row = 1
        column = 1
        width = medium
    )
    Account_Type
    (
        type = picklist
        displayname = "Account Type"
        values = {"Customer", "Vendor", "Partner", "Internal", "Other"}
        row = 1
        column = 2
        width = medium
    )
    Industry
    (
        type = picklist
        values = {"Manufacturing", "Finance", "Healthcare", "Technology", "Retail", "Government", "Other"}
        row = 1
        column = 1
        width = medium
    )
    Website
    (
        type = url
        enable = linkname, title
        target = same window
        row = 1
        column = 2
        width = medium
    )
    Primary_Email
    (
        type = email
        displayname = "Primary Email"
        maxchar = 80
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        row = 1
        column = 2
        width = medium
    )
    Billing_Address
    (
        type = textarea
        displayname = "Billing Address"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Account_Status
    (
        type = picklist
        displayname = "Account Status"
        values = {"Active", "Inactive", "Prospect"}
        row = 1
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
