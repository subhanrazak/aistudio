report All_Accounts
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Account_Name as "Account Name"
                    Account_Type as "Account Type"
                    Industry
                    Primary_Email as "Primary Email"
                    Phone
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Account_Name as "Account Name"
                    Account_Type as "Account Type"
                    Industry
                    Primary_Email as "Primary Email"
                    Phone
                    Account_Status as "Account Status"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
