form Audit_Checklist_Items
{
    displayname = "Audit Checklist Items"
    success message = "Audit checklist item saved successfully"
    Checklist_Details
    (
        type = section
        displayname = "Checklist Details"
        row = 1
        column = 0
        width = medium
    )
    must have Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Checklist_Question
    (
        type = textarea
        displayname = "Checklist Question"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Category
    (
        type = picklist
        values = {"Documentation", "Process", "Compliance", "Safety", "IT", "Finance"}
        row = 1
        column = 1
        width = medium
    )
    Result
    (
        type = picklist
        values = {"Compliant", "Non-Compliant", "Not Applicable", "Observation"}
        row = 1
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 150px
        row = 1
        column = 1
        width = medium
    )
    Evidence_Link
    (
        type = url
        displayname = "Evidence Link"
        enable = linkname, title
        target = same window
        row = 1
        column = 2
        width = medium
    )
    Requires_Finding
    (
        type = checkbox
        displayname = "Requires Finding"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
