form Audit_Plan_Entities
{
    displayname = "Audit Plan Entities"
    success message = "Audit plan entity saved successfully"
    Entity_Selection
    (
        type = section
        displayname = "Entity Selection"
        row = 1
        column = 0
    )
    must have Plan
    (
        type = picklist
        displayname = "Plan"
        values = Audit_Plans.ID
        displayformat = [Plan_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Auditable_Entity
    (
        type = picklist
        displayname = "Auditable Entity"
        values = Audit_Universe.ID
        displayformat = [Auditable_Entity_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Entity_Type
    (
        type = picklist
        displayname = "Entity Type"
        values = {"Department", "Process", "IT System", "Compliance", "Vendor", "Legal Entity"}
        row = 1
        column = 2
        width = medium
    )
    Residual_Risk
    (
        type = decimal
        displayname = "Residual Risk"
        decimalplace = 1
        row = 1
        column = 1
        width = medium
    )
    Last_Audit_Date
    (
        type = date
        displayname = "Last Audit Date"
        row = 1
        column = 2
        width = medium
    )
    Audit_Triggers
    (
        type = list
        displayname = "Audit Triggers"
        values = {"Change", "New Reg", "Incident", "Management Request", "Periodic Review", "Finding Follow-up"}
        row = 1
        column = 1
        width = medium
    )
    Entity_Score
    (
        type = number
        displayname = "Entity Score"
        row = 1
        column = 2
        width = medium
    )
    Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 1
        width = medium
    )
    Recommended_FY
    (
        type = picklist
        displayname = "Recommended FY"
        values = {"FY2025", "FY2026", "FY2027"}
        row = 1
        column = 2
        width = medium
    )
    Audit_Frequency
    (
        type = picklist
        displayname = "Audit Frequency"
        values = {"Annual", "Every 2 Years", "Every 3 Years"}
        row = 1
        column = 1
        width = medium
    )
    Audit_Size_Scoring
    (
        type = section
        displayname = "Audit Size Scoring"
        visibility = true
        row = 2
        column = 1
    )
    Process_Complexity
    (
        type = picklist
        displayname = "Process Complexity"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 1
        width = medium
    )
    Automation_Level
    (
        type = picklist
        displayname = "Automation Level"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 2
        width = medium
    )
    Regulatory_Sensitivity
    (
        type = picklist
        displayname = "Regulatory Sensitivity"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 1
        width = medium
    )
    Past_Issues
    (
        type = picklist
        displayname = "Past Issues"
        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
        row = 2
        column = 2
        width = medium
    )
    Audit_Size
    (
        type = picklist
        displayname = "Audit Size"
        values = {"Small", "Medium", "Large", "Extensive"}
        row = 2
        column = 1
        width = medium
    )
    Estimated_Days
    (
        type = number
        displayname = "Estimated Days"
        row = 2
        column = 2
        width = medium
    )
    Scheduling_Assignment
    (
        type = section
        displayname = "Scheduling & Assignment"
        visibility = true
        row = 3
        column = 1
    )
    Planning_Quarter
    (
        type = picklist
        displayname = "Planning Quarter"
        values = {"Q1", "Q2", "Q3", "Q4"}
        row = 3
        column = 1
        width = medium
    )
    Assigned_Auditor
    (
        type = picklist
        displayname = "Assigned Auditor"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Skill_Required
    (
        type = picklist
        displayname = "Skill Required"
        values = {"Finance", "IT", "Compliance", "Operations", "Procurement", "HR", "Security", "Data Analytics"}
        row = 3
        column = 1
        width = medium
    )
    Assignment_Status
    (
        type = picklist
        displayname = "Assignment Status"
        values = {"Proposed", "Assigned", "Confirmed", "Deferred"}
        initial value = "Proposed"
        row = 3
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}