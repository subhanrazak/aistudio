list Audit_Size_Determination
{
    displayName = "Audit Size Determination"
    show all rows from Audit_Plan_Entities
    (
        Department
        Auditable_Entity as "Auditable Entity"
        Process_Complexity as "Process Complexity"
        Automation_Level as "Automation Level"
        Regulatory_Sensitivity as "Regulatory Sensitivity"
        Past_Issues as "Past Issues"
        Audit_Size as "Audit Size"
        Estimated_Days as "Estimated Days"
    )
    filters
    (
        Plan
        Department
        Audit_Size
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Department ascending
    )
    sort by
    (
        Department ascending
        Audit_Size descending
    )
}