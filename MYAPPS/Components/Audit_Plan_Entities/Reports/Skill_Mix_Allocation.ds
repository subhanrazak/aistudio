list Skill_Mix_Allocation
{
    displayName = "Skill Mix Allocation"
    show all rows from Audit_Plan_Entities
    (
        Assigned_Auditor as "Assigned Auditor"
        Skill_Required as "Skill Required"
        Plan
        Auditable_Entity as "Auditable Entity"
        Entity_Type as "Entity Type"
        Estimated_Days as "Estimated Days"
        Planning_Quarter as "Planning Quarter"
        Assignment_Status as "Assignment Status"
    )
    filters
    (
        Plan
        Assigned_Auditor
        Skill_Required
        Assignment_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Assigned_Auditor ascending
    )
    sort by
    (
        Assigned_Auditor ascending
        Planning_Quarter ascending
    )
}