default list All_Audit_Plan_Entities
{
    displayName = "All Audit Plan Entities"
    show all rows from Audit_Plan_Entities
    (
        Plan
        Auditable_Entity as "Auditable Entity"
        Department
        Residual_Risk as "Residual Risk"
        Entity_Score as "Entity Score"
        Priority
        Recommended_FY as "Recommended FY"
        Audit_Frequency as "Audit Frequency"
        Audit_Size as "Audit Size"
        Estimated_Days as "Estimated Days"
        Planning_Quarter as "Planning Quarter"
        Assigned_Auditor as "Assigned Auditor"
    )
    filters
    (
        Plan
        Department
        Priority
        Planning_Quarter
        Assigned_Auditor
    )
    sort by
    (
        Plan ascending
        Department ascending
    )
}