list Plan_Entities_By_Department
{
    displayName = "Plan Entities By Department"
    show all rows from Audit_Plan_Entities
    (
        Department
        Plan
        Auditable_Entity as "Auditable Entity"
        Residual_Risk as "Residual Risk"
        Entity_Score as "Entity Score"
        Priority
        Audit_Size as "Audit Size"
        Estimated_Days as "Estimated Days"
        Planning_Quarter as "Planning Quarter"
    )
    filters
    (
        Plan
        Department
        Priority
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Department ascending
    )
    sort by
    (
        Department ascending
        Entity_Score descending
    )
}