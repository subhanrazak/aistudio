list Quarterly_Audit_Schedule
{
    displayName = "Quarterly Audit Schedule"
    show all rows from Audit_Plan_Entities
    (
        Planning_Quarter as "Planning Quarter"
        Plan
        Auditable_Entity as "Auditable Entity"
        Department
        Priority
        Audit_Size as "Audit Size"
        Estimated_Days as "Estimated Days"
        Assigned_Auditor as "Assigned Auditor"
    )
    filters
    (
        Plan
        Planning_Quarter
        Assigned_Auditor
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Planning_Quarter ascending
    )
    sort by
    (
        Planning_Quarter ascending
        Priority descending
    )
}