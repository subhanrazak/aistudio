            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Department
                    Plan
                    Auditable_Entity as "Auditable Entity"
                    Residual_Risk as "Residual Risk"
                    Entity_Score as "Entity Score"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Department
                    Plan
                    Auditable_Entity as "Auditable Entity"
                    Residual_Risk as "Residual Risk"
                    Entity_Score as "Entity Score"
                    Priority
                    Audit_Size as "Audit Size"
                    Estimated_Days as "Estimated Days"
                    Planning_Quarter as "Planning Quarter"
                )
            )
        )
        menu
        (
            header
