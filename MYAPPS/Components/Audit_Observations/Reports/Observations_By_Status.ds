kanban Observations_By_Status
{
    displayName = "Observations By Status"
    show all rows from Audit_Observations
    (
        Observation_ID as "Observation ID"
        Audit
        Observation_Title as "Observation Title"
        Severity
        Department
        Observation_Owner as "Observation Owner"
        Target_Closure_Date as "Target Closure Date"
        Status
    )
    filters
    (
        Audit
        Severity
        Department
        Observation_Owner
        Target_Closure_Date
        Status
    )
    sort by
    (
        Target_Closure_Date ascending
    )
    options
    (
        display field = Status
        sortorder = custom
        recordcount = enable
    )
}