calendar Observation_Due_Calendar
{
    displayName = "Observation Due Calendar"
    show all rows from Audit_Observations
    (
        Observation_ID as "Observation ID"
        Observation_Title as "Observation Title"
        Severity
        Department
        Observation_Owner as "Observation Owner"
        Target_Closure_Date as "Target Closure Date"
        Status
    )
    filters
    (
        Severity
        Department
        Observation_Owner
        Target_Closure_Date
        Status
    )
    sort by
    (
        Target_Closure_Date ascending
    )
    options
    (
        display type = month
        week start day = monday
        display field = Observation_Title
        start date = Target_Closure_Date
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}