default list All_Audit_Observations
{
    displayName = "All Audit Observations"
    show all rows from Audit_Observations
    (
        Observation_ID as "Observation ID"
        Audit
        Observation_Title as "Observation Title"
        Severity
        Risk_Category as "Risk Category"
        Department
        Observation_Owner as "Observation Owner"
        Target_Closure_Date as "Target Closure Date"
        Status
    )
    filters
    (
        Audit
        Severity
        Risk_Category
        Department
        Observation_Owner
        Status
        Target_Closure_Date
    )
    sort by
    (
        Target_Closure_Date ascending
        Severity descending
    )
}