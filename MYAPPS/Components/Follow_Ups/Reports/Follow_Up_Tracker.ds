list Follow_Up_Tracker
{
    displayName = "Follow Up Tracker"
    show all rows from Follow_Ups
    (
        Follow_Up_ID as "Follow Up ID"
        Source_Audit as "Source Audit"
        Responsible_Department as "Responsible Department"
        Priority
        Status
        Completion_Percent as "Completion Percent"
        Due_Date as "Due Date"
        Last_Updated as "Last Updated"
    )
    filters
    (
        Source_Audit
        Responsible_Department
        Priority
        Status
        Due_Date
        Last_Updated
    )
    sort by
    (
        Last_Updated descending
        Due_Date ascending
    )
}