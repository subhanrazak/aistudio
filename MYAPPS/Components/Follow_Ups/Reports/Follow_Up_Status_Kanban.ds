kanban Follow_Up_Status_Kanban
{
    displayName = "Follow Up Status Kanban"
    show all rows from Follow_Ups
    (
        Follow_Up_ID as "Follow Up ID"
        Observation
        Source_Audit as "Source Audit"
        Responsible_Person as "Responsible Person"
        Priority
        Due_Date as "Due Date"
        Completion_Percent as "Completion Percent"
        Status
    )
    filters
    (
        Observation
        Source_Audit
        Responsible_Person
        Priority
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
    options
    (
        display field = Status
        sortorder = custom
        recordcount = enable
    )
}