default list Follow_Up_Schedule
{
    displayName = "Follow Up Schedule"
    show all rows from Follow_Ups
    (
        Follow_Up_ID as "Follow Up ID"
        Observation
        Source_Audit as "Source Audit"
        Action_Plan as "Action Plan"
        Responsible_Person as "Responsible Person"
        Priority
        Due_Date as "Due Date"
        Status
    )
    filters
    (
        Observation
        Source_Audit
        Responsible_Person
        Priority
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
}