calendar Follow_Up_Calendar
{
    displayName = "Follow Up Calendar"
    show all rows from Follow_Ups
    (
        Follow_Up_ID as "Follow Up ID"
        Observation
        Responsible_Person as "Responsible Person"
        Priority
        Due_Date as "Due Date"
        Status
    )
    filters
    (
        Observation
        Responsible_Person
        Priority
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
    )
    options
    (
        display type = month
        week start day = monday
        display field = Follow_Up_ID
        start date = Due_Date
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}