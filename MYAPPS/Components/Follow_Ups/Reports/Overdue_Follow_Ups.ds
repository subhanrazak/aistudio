list Overdue_Follow_Ups
{
    displayName = "Overdue Follow Ups"
    show all rows from Follow_Ups [(Status == "Overdue") || (Due_Date < zoho.currentdate && Status != "Completed" && Status != "Closed")]
    (
        Follow_Up_ID as "Follow Up ID"
        Observation
        Source_Audit as "Source Audit"
        Responsible_Department as "Responsible Department"
        Responsible_Person as "Responsible Person"
        Priority
        Due_Date as "Due Date"
        Completion_Percent as "Completion Percent"
        Status
    )
    filters
    (
        Observation
        Source_Audit
        Responsible_Department
        Responsible_Person
        Priority
        Due_Date
        Status
    )
    sort by
    (
        Due_Date ascending
        Priority descending
    )
}