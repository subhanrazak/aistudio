form Follow_Ups
{
    displayname = "Follow-Ups"
    success message = "Follow-up saved successfully"
    Follow_Up_Details
    (
        type = section
        displayname = "Follow-Up Details"
        row = 1
        column = 0
    )
    must have unique Follow_Up_ID
    (
        type = text
        displayname = "Follow Up ID"
        maxchar = 40
        row = 1
        column = 1
        width = medium
    )
    Source_Audit
    (
        type = picklist
        displayname = "Source Audit"
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Audit_Name
    (
        type = text
        displayname = "Audit Name"
        maxchar = 200
        row = 1
        column = 1
        width = medium
    )
    Observation
    (
        type = picklist
        values = Audit_Observations.ID
        displayformat = [Observation_Title]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Observation_Category
    (
        type = picklist
        displayname = "Observation Category"
        values = {"Financial Control", "Operational Process", "IT & Data Security", "Compliance & Governance", "Regulatory"}
        row = 1
        column = 1
        width = medium
    )
    Responsible_Department
    (
        type = picklist
        displayname = "Responsible Department"
        values = Departments.ID
        displayformat = [Department_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Observation_Finding
    (
        type = textarea
        displayname = "Observation Finding"
        height = 140px
        row = 1
        column = 1
        width = medium
    )
    Risk_Implication
    (
        type = textarea
        displayname = "Risk Implication"
        height = 140px
        row = 1
        column = 2
        width = medium
    )
    Risk_Category
    (
        type = picklist
        displayname = "Risk Category"
        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Security", "Privacy"}
        row = 1
        column = 1
        width = medium
    )
    Risk_Owner
    (
        type = picklist
        displayname = "Risk Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Tracking
    (
        type = section
        displayname = "Tracking"
        visibility = true
        row = 2
        column = 1
    )
    Responsible_Person
    (
        type = picklist
        displayname = "Responsible Person"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Priority
    (
        type = picklist
        values = {"Low", "Medium", "High", "Critical"}
        row = 2
        column = 2
        width = medium
    )
    Status
    (
        type = picklist
        values = {"Open", "In Progress", "Pending", "Completed", "Overdue", "Closed"}
        initial value = "Open"
        row = 2
        column = 1
        width = medium
    )
    Original_Due_Date
    (
        type = date
        displayname = "Original Due Date"
        row = 2
        column = 2
        width = medium
    )
    Revised_Due_Date
    (
        type = date
        displayname = "Revised Due Date"
        row = 2
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 2
        column = 2
        width = medium
    )
    Completion_Percent
    (
        type = decimal
        displayname = "Completion Percent"
        decimalplace = 2
        initial value = 0
        row = 2
        column = 1
        width = medium
    )
    Last_Updated
    (
        type = date
        displayname = "Last Updated"
        row = 2
        column = 2
        width = medium
    )
    Action_Owner
    (
        type = picklist
        displayname = "Action Owner"
        values = Audit_Team_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Action_Plan
    (
        type = textarea
        displayname = "Action Plan"
        height = 160px
        row = 2
        column = 2
        width = medium
    )
    Current_Status
    (
        type = picklist
        displayname = "Current Status"
        values = {"Not Started", "In Progress", "Completed", "Overdue"}
        row = 2
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 140px
        row = 2
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}