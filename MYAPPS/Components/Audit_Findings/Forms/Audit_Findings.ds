form Audit_Findings
{
    displayname = "Audit Findings"
    success message = "Audit finding saved successfully"
    Finding_Details
    (
        type = section
        displayname = "Finding Details"
        row = 1
        column = 0
        width = medium
    )
    Audit_Finding_Number
    (
        type = autonumber
        displayname = "Audit Finding Number"
        start index = 4001
        row = 1
        column = 1
        width = medium
    )
    must have Audit
    (
        type = picklist
        values = Audits.ID
        displayformat = [Audit_Title]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Finding_Title
    (
        type = text
        displayname = "Finding Title"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Finding_Type
    (
        type = picklist
        displayname = "Finding Type"
        values = {"Non-Conformance", "Observation", "Opportunity for Improvement", "Risk", "Control Gap"}
        row = 1
        column = 1
        width = medium
    )
    Severity
    (
        type = picklist
        values = {"Low", "Medium", "High", "Critical"}
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        height = 180px
        row = 1
        column = 1
        width = medium
    )
    Owner_Email
    (
        type = email
        displayname = "Owner Email"
        maxchar = 80
        row = 1
        column = 2
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 1
        column = 1
        width = medium
    )
    Finding_Status
    (
        type = picklist
        displayname = "Finding Status"
        values = {"Open", "In Review", "Action Required", "Closed"}
        row = 1
        column = 2
        width = medium
    )
    Evidence_Link
    (
        type = url
        displayname = "Evidence Link"
        enable = linkname, title
        target = same window
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
