-agenda zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;apw-kpi-card zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0&quot;&gt;Resource requirement&lt;/p&gt;&lt;h2 class=&quot;zcs-font-20 zcs-color-primary zcs-m-0&quot;&gt;&lt;%=resourceRequirement%&gt;&lt;/h2&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;capacity and skill demand&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;apw-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-wm zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;basic-details&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16 zcs-mb-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;apw-section-title&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Basic Details&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Current audit plan header and approval routing.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;apw-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;%=selectedPlanStatus%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper&quot;&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-row zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-3 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Prepared by&lt;/label&gt;&lt;div class=&quot;zcs-flex zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01 zcs-color-primary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;&lt;%=preparedByName%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-3 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Department&lt;/label&gt;&lt;div class=&quot;zcs-flex zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline business-building zcs-color-primary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;&lt;%=selectedPlanDept%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-3 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Plan size&lt;/label&gt;&lt;div class=&quot;zcs-flex zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline design-measure-big zcs-color-primary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;&lt;%=selectedPlanSize%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-3 zcs-px-15 zcs-py-10 zcs-box-border&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Implementation priority&lt;/label&gt;&lt;div class=&quot;zcs-flex zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-color-primary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;&lt;%=selectedPlanPriority%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;selection&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Department-wise 3-year Plan Summary&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Counts are sourced from Audit_Plan_Entities by department and recommended FY.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Department&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;FY2025&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;FY2026&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;FY2027&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Total&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tsummaryRows = 0;\n\t\t\t\t\tfor each deptRec in Departments[ID != 0] sort by Department_Name asc\n\t\t\t\t\t{\n\t\t\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfy2025 = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2025&quot;].count();\n\t\t\t\t\t\t\tfy2026 = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2026&quot;].count();\n\t\t\t\t\t\t\tfy2027 = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2027&quot;].count();\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfy2025 = Audit_Plan_Entities[Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2025&quot;].count();\n\t\t\t\t\t\t\tfy2026 = Audit_Plan_Entities[Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2026&quot;].count();\n\t\t\t\t\t\t\tfy2027 = Audit_Plan_Entities[Department == deptRec.ID &amp;&amp; Recommended_FY == &quot;FY2027&quot;].count();\n\t\t\t\t\t\t}\n\t\t\t\t\t\trowTotal = fy2025 + fy2026 + fy2027;\n\t\t\t\t\t\tif(rowTotal &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tsummaryRows = summaryRows + 1;\n\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=deptRec.Department_Name%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=fy2025%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=fy2026%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=fy2027%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-semibold zcs-color-primary&quot;&gt;&lt;%=rowTotal%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(summaryRows == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;apw-empty&quot;&gt;No department summary records found for this plan.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;apw-two-col&quot;&gt;\n\t\t\t&lt;div id=&quot;priority-frequency&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Priority &amp; Frequency&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Grouped by Department.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Frequency&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Score&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tcurrentDept = &quot;&quot;;\n\t\t\t\t\tpRows = 0;\n\t\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tpEntities = Audit_Plan_Entities[Plan == selectedPlanID];\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tpEntities = Audit_Plan_Entities[ID != 0];\n\t\t\t\t\t}\n\t\t\t\t\tfor each ent in pEntities\n\t\t\t\t\t{\n\t\t\t\t\t\tdeptName = ifnull(ent.Department.Department_Name,&quot;No Department&quot;);\n\t\t\t\t\t\tif(currentDept != deptName)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcurrentDept = deptName;\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tgroup&quot;&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-5 zcs-font-14&quot;&gt;&lt;%=deptName%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\tpriorityClass = &quot;apw-pill-medium&quot;;\n\t\t\t\t\t\tif(ent.Priority == &quot;Critical&quot;) { priorityClass = &quot;apw-pill-critical&quot;; }\n\t\t\t\t\t\telse if(ent.Priority == &quot;High&quot;) { priorityClass = &quot;apw-pill-high&quot;; }\n\t\t\t\t\t\telse if(ent.Priority == &quot;Low&quot;) { priorityClass = &quot;apw-pill-low&quot;; }\n\t\t\t\t\t\tpRows = pRows + 1;\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Auditable_Entity.Auditable_Entity_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;apw-pill &lt;%=priorityClass%&gt;&quot;&gt;&lt;%=ifnull(ent.Priority,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Audit_Frequency,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Entity_Score,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\tif(pRows == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;apw-empty&quot;&gt;No priority and frequency rows found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div id=&quot;audit-size&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Audit Size Scoring&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Grouped by Department with scoring factors.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Complexity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Regulatory&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Size&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Days&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\tcurrentDept = &quot;&quot;;\n\t\t\t\t\tsRows = 0;\n\t\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tsEntities = Audit_Plan_Entities[Plan == selectedPlanID];\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tsEntities = Audit_Plan_Entities[ID != 0];\n\t\t\t\t\t}\n\t\t\t\t\tfor each ent in sEntities\n\t\t\t\t\t{\n\t\t\t\t\t\tdeptName = ifnull(ent.Department.Department_Name,&quot;No Department&quot;);\n\t\t\t\t\t\tif(currentDept != deptName)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcurrentDept = deptName;\n\t\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tgroup&quot;&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-5 zcs-font-14&quot;&gt;&lt;%=deptName%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\tsRows = sRows + 1;\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Auditable_Entity.Auditable_Entity_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Process_Complexity,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Regulatory_Sensitivity,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;apw-pill&quot;&gt;&lt;%=ifnull(ent.Audit_Size,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Estimated_Days,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\tif(sRows == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;apw-empty&quot;&gt;No audit size scoring rows found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;quarterly-planning&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Quarterly Planning&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Distribution grouped by Planning Quarter.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;apw-quarter-strip zcs-mb-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Q1&lt;/span&gt;&lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=q1Days%&gt; days&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=q1Pct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Q2&lt;/span&gt;&lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=q2Days%&gt; days&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=q2Pct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Q3&lt;/span&gt;&lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=q3Days%&gt; days&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=q3Pct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 zcs-p-16 zcs-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;Q4&lt;/span&gt;&lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=q4Days%&gt; days&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=q4Pct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Department&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Days&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;%\n\t\t\t\tqRows = 0;\n\t\t\t\tcurrentQuarter = &quot;&quot;;\n\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tqEntities = Audit_Plan_Entities[Plan == selectedPlanID] sort by Planning_Quarter asc;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tqEntities = Audit_Plan_Entities[ID != 0] sort by Planning_Quarter asc;\n\t\t\t\t}\n\t\t\t\tfor each ent in qEntities\n\t\t\t\t{\n\t\t\t\t\tquarterName = ifnull(ent.Planning_Quarter,&quot;Unscheduled&quot;);\n\t\t\t\t\tif(currentQuarter != quarterName)\n\t\t\t\t\t{\n\t\t\t\t\t\tcurrentQuarter = quarterName;\n\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tgroup&quot;&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-5 zcs-font-14&quot;&gt;&lt;%=quarterName%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\tqRows = qRows + 1;\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Auditable_Entity.Auditable_Entity_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Department.Department_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Priority,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Estimated_Days,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\tif(qRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;apw-empty&quot;&gt;No quarterly planning rows found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;skill-mix&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Skill Mix Allocation&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Assignments grouped by Assigned Auditor.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Entity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Skill Required&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Quarter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assignment Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Days&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;%\n\t\t\t\taRows = 0;\n\t\t\t\tcurrentAuditor = &quot;&quot;;\n\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t{\n\t\t\t\t\taEntities = Audit_Plan_Entities[Plan == selectedPlanID];\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\taEntities = Audit_Plan_Entities[ID != 0];\n\t\t\t\t}\n\t\t\t\tfor each ent in aEntities\n\t\t\t\t{\n\t\t\t\t\tauditorName = ifnull(ent.Assigned_Auditor.Full_Name,&quot;Unassigned&quot;);\n\t\t\t\t\tif(currentAuditor != auditorName)\n\t\t\t\t\t{\n\t\t\t\t\t\tcurrentAuditor = auditorName;\n\t\t\t\t\t\t%&gt;&lt;tr class=&quot;zcs-tgroup&quot;&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-5 zcs-font-14&quot;&gt;&lt;%=auditorName%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t\taRows = aRows + 1;\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Auditable_Entity.Auditable_Entity_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Skill_Required,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Planning_Quarter,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;apw-pill&quot;&gt;&lt;%=ifnull(ent.Assignment_Status,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Estimated_Days,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\tif(aRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;apw-empty&quot;&gt;No skill allocation rows found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;review&quot; class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16 zcs-mb-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;apw-section-title&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Review &amp; Approve&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Readiness charts, schedule, assignments, resource utilization, and validation status.&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;apw-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-calendar-date&quot;&gt;&lt;/i&gt;Submitted: &lt;%=submittedDateText%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;apw-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Audits by priority&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Critical&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-red&quot; style=&quot;width:&lt;%=criticalPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=criticalCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;High&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-yellow&quot; style=&quot;width:&lt;%=highPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=highCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Medium&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-blue&quot; style=&quot;width:&lt;%=mediumPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=mediumCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Low&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-green&quot; style=&quot;width:&lt;%=lowPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=lowCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Audits by size&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Extensive&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-red&quot; style=&quot;width:&lt;%=extensivePct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=extensiveCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Large&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-yellow&quot; style=&quot;width:&lt;%=largePct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=largeCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Medium&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-blue&quot; style=&quot;width:&lt;%=sizeMediumPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=sizeMediumCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;apw-chart-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Small&lt;/span&gt;&lt;div class=&quot;apw-bar-track&quot;&gt;&lt;div class=&quot;apw-bar apw-bar-green&quot; style=&quot;width:&lt;%=smallPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=smallCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;apw-section zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Schedule &amp; Assignment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Quarter&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Auditor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Days&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;%\n\t\t\t\tschedRows = 0;\n\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tschedEntities = Audit_Plan_Entities[Plan == selectedPlanID] sort by Planning_Quarter asc;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tschedEntities = Audit_Plan_Entities[ID != 0] sort by Planning_Quarter asc;\n\t\t\t\t}\n\t\t\t\tfor each ent in schedEntities\n\t\t\t\t{\n\t\t\t\t\tschedRows = schedRows + 1;\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Auditable_Entity.Auditable_Entity_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Planning_Quarter,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Assigned_Auditor.Full_Name,&quot;Unassigned&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;span class=&quot;apw-pill&quot;&gt;&lt;%=ifnull(ent.Assignment_Status,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ent.Estimated_Days,0)%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\tif(schedRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;apw-empty&quot;&gt;No schedule and assignment rows found.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;apw-section zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Auditor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Skill Area&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Assigned Days&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Capacity&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Utilization&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;%\n\t\t\t\tutilRows = 0;\n\t\t\t\tfor each auditor in Audit_Team_Members[Status == &quot;Active&quot;] sort by Full_Name asc\n\t\t\t\t{\n\t\t\t\t\tif(selectedPlanID &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tassignedDays = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Assigned_Auditor == auditor.ID].sum(Estimated_Days);\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tassignedDays = Audit_Plan_Entities[Assigned_Auditor == auditor.ID].sum(Estimated_Days);\n\t\t\t\t\t}\n\t\t\t\t\tif(assignedDays == null)\n\t\t\t\t\t{\n\t\t\t\t\t\tassignedDays = 0;\n\t\t\t\t\t}\n\t\t\t\t\tcapacityDays = ifnull(auditor.Capacity_Days_Per_Year,0);\n\t\t\t\t\tutilPct = 0;\n\t\t\t\t\tif(capacityDays &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tutilPct = (assignedDays * 100) / capacityDays;\n\t\t\t\t\t}\n\t\t\t\t\tif(assignedDays &gt; 0 || selectedPlanID == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tutilRows = utilRows + 1;\n\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=auditor.Full_Name%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(auditor.Skill_Area,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=assignedDays%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=capacityDays%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=utilPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-font-12 zcs-color-primary zcs-m-0&quot;&gt;&lt;strong class=&quot;zcs-color-theme&quot;&gt;&lt;%=utilPct%&gt;%&lt;/strong&gt; utilized&lt;/p&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(utilRows == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;apw-empty&quot;&gt;No active auditor utilization rows found for assigned work.&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-toast zcs-success-toast zcs-w-full zcs-flex zcs-gap-8 zcs-px-16 zcs-py-12 zcs-rounded-sm zcs-box-border zcs-font-14 zcs-lh-body zcs-color-primary zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-toast-icon zcs-no-shrink zcs-lh-body zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;div class=&quot;zcs-toast-text&quot;&gt;&lt;p class=&quot;zcs-m-0&quot;&gt;&lt;strong&gt;Validation readiness:&lt;/strong&gt; &lt;%=validationMessage%&gt; Submitted date: &lt;%=submittedDateText%&gt;.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;apw-section zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;apw-section-title zcs-mb-16&quot;&gt;&lt;h2 class=&quot;zcs-font-18 zcs-font-semibold zcs-color-primary zcs-m-0&quot;&gt;Referenced Creator Reports&lt;/h2&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;The workspace links to and embeds the approved planning reports.&lt;/p&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;apw-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;apw-reference-embed zcs-p-12 zcs-box-border&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Audit_Plans_List&quot; zc-height=&quot;300px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;apw-reference-embed zcs-p-12 zcs-box-border&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Plan_Entities_By_Department&quot; zc-height=&quot;300px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Follow_Up_Tracker_Dashboard
		{
					displayname = "Follow Up Tracker Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Follow_Up_Tracker_Dashboard_Analytics' elementName='Follow_Up_Tracker_Dashboard_Analytics'>\n\t\t\t\t\t<![CDATA[htmlpage Follow_Up_Tracker_Dashboard_Analytics()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\ttoday = zoho.currentdate;\n\ttotalFollowUps = Follow_Ups[ID != 0].count();\n\tcompletedOnly = Follow_Ups[Status == &quot;Completed&quot;].count();\n\tclosedOnly = Follow_Ups[Status == &quot;Closed&quot;].count();\n\tcompletedFollowUps = completedOnly + closedOnly;\n\tinProgressFollowUps = Follow_Ups[Status == &quot;In Progress&quot;].count();\n\tpendingFollowUps = Follow_Ups[Status == &quot;Pending&quot;].count();\n\topenFollowUps = Follow_Ups[Status == &quot;Open&quot;].count();\n\toverdueFollowUps = Follow_Ups[(Status == &quot;Overdue&quot;) || (Due_Date &lt; today &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;)].count();\n\n\tclosureDaysTotal = 0;\n\tclosureDaysCount = 0;\n\tfor each closureRec in Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated != null]\n\t{\n\t\tif(closureRec.Added_Time != null)\n\t\t{\n\t\t\trecClosureDays = closureRec.Added_Time.toDate().daysBetween(closureRec.Last_Updated);\n\t\t\tif(recClosureDays &lt; 0)\n\t\t\t{\n\t\t\t\trecClosureDays = 0;\n\t\t\t}\n\t\t\tclosureDaysTotal = closureDaysTotal + recClosureDays;\n\t\t\tclosureDaysCount = closureDaysCount + 1;\n\t\t}\n\t}\n\tavgClosureTime = 0;\n\tif(closureDaysCount &gt; 0)\n\t{\n\t\tavgClosureTime = closureDaysTotal / closureDaysCount;\n\t}\n\n\tstatusOpen = openFollowUps;\n\tstatusProgress = inProgressFollowUps;\n\tstatusPending = pendingFollowUps;\n\tstatusCompleted = completedOnly;\n\tstatusOverdue = overdueFollowUps;\n\tstatusClosed = closedOnly;\n\tstatusMax = statusOpen;\n\tif(statusProgress &gt; statusMax){statusMax = statusProgress;}\n\tif(statusPending &gt; statusMax){statusMax = statusPending;}\n\tif(statusCompleted &gt; statusMax){statusMax = statusCompleted;}\n\tif(statusOverdue &gt; statusMax){statusMax = statusOverdue;}\n\tif(statusClosed &gt; statusMax){statusMax = statusClosed;}\n\tif(statusMax == 0){statusMax = 1;}\n\tstatusOpenPct = (statusOpen * 100) / statusMax;\n\tstatusProgressPct = (statusProgress * 100) / statusMax;\n\tstatusPendingPct = (statusPending * 100) / statusMax;\n\tstatusCompletedPct = (statusCompleted * 100) / statusMax;\n\tstatusOverduePct = (statusOverdue * 100) / statusMax;\n\tstatusClosedPct = (statusClosed * 100) / statusMax;\n\n\tcriticalPriority = Follow_Ups[Priority == &quot;Critical&quot;].count();\n\thighPriority = Follow_Ups[Priority == &quot;High&quot;].count();\n\tmediumPriority = Follow_Ups[Priority == &quot;Medium&quot;].count();\n\tlowPriority = Follow_Ups[Priority == &quot;Low&quot;].count();\n\tpriorityTotal = criticalPriority + highPriority + mediumPriority + lowPriority;\n\tcriticalPct = 0;\n\thighPct = 0;\n\tmediumPct = 0;\n\tlowPct = 0;\n\tif(priorityTotal &gt; 0)\n\t{\n\t\tcriticalPct = (criticalPriority * 100) / priorityTotal;\n\t\thighPct = (highPriority * 100) / priorityTotal;\n\t\tmediumPct = (mediumPriority * 100) / priorityTotal;\n\t\tlowPct = 100 - criticalPct - highPct - mediumPct;\n\t}\n\n\tnotDueAging = Follow_Ups[Due_Date &gt;= today &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tage0to7 = Follow_Ups[Due_Date &lt; today &amp;&amp; Due_Date &gt;= today.subDay(7) &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tage8to30 = Follow_Ups[Due_Date &lt; today.subDay(7) &amp;&amp; Due_Date &gt;= today.subDay(30) &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tageOver30 = Follow_Ups[Due_Date &lt; today.subDay(30) &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\tagingTotal = notDueAging + age0to7 + age8to30 + ageOver30;\n\tnotDuePct = 0;\n\tage0to7Pct = 0;\n\tage8to30Pct = 0;\n\tageOver30Pct = 0;\n\tif(agingTotal &gt; 0)\n\t{\n\t\tnotDuePct = (notDueAging * 100) / agingTotal;\n\t\tage0to7Pct = (age0to7 * 100) / agingTotal;\n\t\tage8to30Pct = (age8to30 * 100) / agingTotal;\n\t\tageOver30Pct = 100 - notDuePct - age0to7Pct - age8to30Pct;\n\t}\n\n\ttrend1Start = today.subDay(150);\n\ttrend1End = today.subDay(121);\n\ttrend2Start = today.subDay(120);\n\ttrend2End = today.subDay(91);\n\ttrend3Start = today.subDay(90);\n\ttrend3End = today.subDay(61);\n\ttrend4Start = today.subDay(60);\n\ttrend4End = today.subDay(31);\n\ttrend5Start = today.subDay(30);\n\ttrend5End = today.subDay(8);\n\ttrend6Start = today.subDay(7);\n\ttrend6End = today;\n\ttrend1 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend1Start &amp;&amp; Last_Updated &lt;= trend1End].count();\n\ttrend2 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend2Start &amp;&amp; Last_Updated &lt;= trend2End].count();\n\ttrend3 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend3Start &amp;&amp; Last_Updated &lt;= trend3End].count();\n\ttrend4 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend4Start &amp;&amp; Last_Updated &lt;= trend4End].count();\n\ttrend5 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend5Start &amp;&amp; Last_Updated &lt;= trend5End].count();\n\ttrend6 = Follow_Ups[(Status == &quot;Completed&quot; || Status == &quot;Closed&quot;) &amp;&amp; Last_Updated &gt;= trend6Start &amp;&amp; Last_Updated &lt;= trend6End].count();\n\ttrendMax = trend1;\n\tif(trend2 &gt; trendMax){trendMax = trend2;}\n\tif(trend3 &gt; trendMax){trendMax = trend3;}\n\tif(trend4 &gt; trendMax){trendMax = trend4;}\n\tif(trend5 &gt; trendMax){trendMax = trend5;}\n\tif(trend6 &gt; trendMax){trendMax = trend6;}\n\tif(trendMax == 0){trendMax = 1;}\n\ttrendY1 = 92 - ((trend1 * 80) / trendMax);\n\ttrendY2 = 92 - ((trend2 * 80) / trendMax);\n\ttrendY3 = 92 - ((trend3 * 80) / trendMax);\n\ttrendY4 = 92 - ((trend4 * 80) / trendMax);\n\ttrendY5 = 92 - ((trend5 * 80) / trendMax);\n\ttrendY6 = 92 - ((trend6 * 80) / trendMax);\n\ttrendLabel1 = trend1Start.toString(&quot;MMM dd&quot;);\n\ttrendLabel2 = trend2Start.toString(&quot;MMM dd&quot;);\n\ttrendLabel3 = trend3Start.toString(&quot;MMM dd&quot;);\n\ttrendLabel4 = trend4Start.toString(&quot;MMM dd&quot;);\n\ttrendLabel5 = trend5Start.toString(&quot;MMM dd&quot;);\n\ttrendLabel6 = trend6Start.toString(&quot;MMM dd&quot;);\n\n\tcategoryList = {&quot;Financial Control&quot;, &quot;Operational Process&quot;, &quot;IT &amp; Data Security&quot;, &quot;Compliance &amp; Governance&quot;, &quot;Regulatory&quot;};\n\tlastRefresh = today.toString(&quot;dd-MMM-yyyy&quot;);\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for this page; adapted from zcs-global. */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--fu-green: #179E6C;\n\t--fu-blue: #2A6FFC;\n\t--fu-sky: #1094C5;\n\t--fu-yellow: #FAAE13;\n\t--fu-orange: #F4660C;\n\t--fu-red: #FE455D;\n\t--fu-purple: #6C5CE7;\n\t--fu-ink: var(--zcs_primary_text_color);\n\t--fu-muted: var(--zcs_secondary_text_color);\n\t--fu-border: var(--zcs_tertiary_border_color);\n\t--fu-panel: #FFFFFF;\n\t--fu-soft: #F9FAFE;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-justify-end { justify-content: flex-end; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\na { text-decoration: none; }\n\n/* ZCS component CSS: button-primary-outline-button and header-heading-with-actions. */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 1px solid var(--zcs_brand_color); }\n.zcs-primary-outline-button { background-color: var(--zcs-white-color); color: var(--zcs_brand_color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-page-header { background: linear-gradient(135deg, var(--zcs_brand_color), var(--fu-purple)); border-radius: 18px; color: var(--zcs_brand_foreground_color); box-shadow: 0 16px 38px rgba(34, 48, 92, .16); overflow: hidden; position: relative; }\n.zcs-page-header:after { content: &apos;&apos;; position: absolute; right: -90px; top: -120px; width: 280px; height: 280px; border-radius: 50%; border: 42px solid rgba(255,255,255,.12); }\n.zcs-page-header h5, .zcs-page-header .zcs-color-primary, .zcs-page-header .zcs-color-secondary { color: #FFFFFF; }\n.zcs-page-header .fu-header-subtitle { color: rgba(255,255,255,.82); }\n.zcs-page-header .zcs-button { position: relative; z-index: 1; border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.14); color: #FFFFFF; backdrop-filter: blur(6px); }\n.zcs-page-header .zcs-button:hover { background: rgba(255,255,255,.22); color: #FFFFFF; }\n\n/* ZCS component CSS: label-value-key-value-with-icon. */\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color: #a06309; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }\n\n/* ZCS component CSS: table-simple-table. */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper .zcs-yellow { color: #b8770d; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper .zcs-l_blue { color: #1094c5; }\n\n/* ZCS component CSS: chart-bar-chart, chart-area-chart, chart-donut-chart-with-text, chart-stack-column-chart. */\n.zcs-chart ul li, .zcs-legend-wrapper li { list-style-type: none; }\n.zcs-chart-y-axis-text { width: 42px; }\n.zcs-chart-y-axis-line { border-top: 1px dashed #EBECF0; }\n.zcs-scrollable-container { top: 10px; left: 42px; width: calc(100% - 42px); height: calc(100% + 12px); overflow: hidden; }\n.zcs-bar-value { width: 30px; border-radius: 6px 6px 0 0; background-color: #FF7300; }\n.zcs-area-value { background-image: linear-gradient(#3388FF, #FFF); clip-path: polygon(0% calc(100%*(1 - var(--start))), 100% calc(100%*(1 - var(--end))), 100% 100%, 0% 100%); }\n.zcs-stackedbarchart-wrapper .zcs-bar-value { border-radius: 0; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg { width: var(--donut-donut_size); height: var(--donut-donut_size); overflow: hidden; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle { cx: var(--donut-cx); cy: var(--donut-cy); stroke-width: var(--donut-stroke_width); fill: transparent; }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(1) { stroke: var(--fu-red); stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a1) / 100)); stroke-dashoffset: calc((2 * var(--donut-pi) * var(--donut-r)) / 4); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(2) { stroke: var(--fu-orange); stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a2) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(3) { stroke: var(--fu-yellow); stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a3) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100)); }\n.zcs-donut-chart-wrapper .zcs-simple-donut-chart svg circle:nth-child(4) { stroke: var(--fu-green); stroke-dasharray: calc(2 * var(--donut-pi) * var(--donut-r) * var(--donut-a4) / 100) calc(2 * var(--donut-pi) * var(--donut-r) * calc(1 - var(--donut-a4) / 100)); stroke-dashoffset: calc(((2 * var(--donut-pi) * var(--donut-r)) / 4) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a1) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a2) / 100) - (2 * var(--donut-pi) * var(--donut-r) * var(--donut-a3) / 100)); }\n.zcs-legend-wrapper li label:before { content: &apos;&apos;; display: inline-block; vertical-align: top; width: 12px; height: 12px; margin: 4px 10px 4px 0; border-radius: 50%; }\n.zcs-legend-wrapper li:nth-child(1) label:before { background-color: var(--fu-red); }\n.zcs-legend-wrapper li:nth-child(2) label:before { background-color: var(--fu-orange); }\n.zcs-legend-wrapper li:nth-child(3) label:before { background-color: var(--fu-yellow); }\n.zcs-legend-wrapper li:nth-child(4) label:before { background-color: var(--fu-green); }\n\n.fu-page { min-height: 100%; background: #F3F4F8; padding: 18px; box-sizing: border-box; font-family: inherit; }\n.fu-grid { display: grid; gap: 16px; }\n.fu-kpi-grid { grid-template-columns: repeat(6, minmax(150px, 1fr)); }\n.fu-two-col { grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr); }\n.fu-two-col-even { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.fu-card { background: var(--fu-panel); border: 1px solid var(--fu-border); border-radius: 16px; box-shadow: 0 10px 26px rgba(20, 35, 80, .06); overflow: hidden; }\n.fu-card-pad { padding: 18px; }\n.fu-card-title { margin: 0; color: var(--fu-ink); font-size: 16px; font-weight: 700; line-height: 1.25; }\n.fu-card-note { color: var(--fu-muted); font-size: 12px; margin-top: 4px; }\n.fu-kpi { min-height: 118px; position: relative; }\n.fu-kpi:before { content: &apos;&apos;; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--kpi-color); }\n.fu-kpi-icon { width: 38px; height: 38px; border-radius: 12px; background: color-mix(in srgb, var(--kpi-color) 12%, white); color: var(--kpi-color); font-size: 20px; }\n.fu-kpi-value { font-size: 28px; font-weight: 800; color: var(--fu-ink); line-height: 1; margin-top: 12px; }\n.fu-kpi-label { color: var(--fu-muted); font-size: 13px; margin-top: 6px; }\n.fu-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 999px; background: #F3F4F8; color: var(--fu-muted); font-size: 12px; }\n.fu-mini-link { color: var(--zcs_brand_color); font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }\n.fu-status-list { display: grid; gap: 12px; margin-top: 18px; }\n.fu-status-row { display: grid; grid-template-columns: 132px 1fr 46px; gap: 10px; align-items: center; }\n.fu-track { height: 11px; border-radius: 999px; background: #EEF0F6; overflow: hidden; }\n.fu-fill { height: 100%; width: var(--bar-width); min-width: 2px; border-radius: 999px; background: var(--bar-color); }\n.fu-chart-frame { height: 250px; margin-top: 16px; border: 1px solid #EEF0F6; border-radius: 14px; background: linear-gradient(180deg, #FFFFFF, #FAFBFF); padding: 10px; }\n.fu-line-svg { width: 100%; height: 100%; overflow: visible; }\n.fu-line-grid { stroke: #E9ECF5; stroke-width: 1; stroke-dasharray: 4 4; }\n.fu-line-area { fill: url(#fuTrendGradient); opacity: .88; }\n.fu-line { fill: none; stroke: var(--zcs_brand_color); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }\n.fu-line-dot { fill: #FFFFFF; stroke: var(--zcs_brand_color); stroke-width: 3; }\n.fu-axis-label { fill: var(--fu-muted); font-size: 11px; }\n.fu-axis-value { fill: var(--fu-ink); font-size: 11px; font-weight: 700; }\n.fu-donut-box { min-height: 260px; }\n.fu-donut-center { width: 116px; }\n.fu-legend-value { color: var(--fu-muted); margin-left: auto; font-weight: 600; }\n.fu-aging-stack { display: flex; height: 34px; border-radius: 12px; overflow: hidden; background: #EEF0F6; margin-top: 20px; }\n.fu-aging-segment { min-width: 2px; width: var(--aging-width); background: var(--aging-color); display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 12px; font-weight: 700; }\n.fu-aging-legend { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 10px; margin-top: 16px; }\n.fu-legend-chip { display: flex; align-items: center; gap: 8px; color: var(--fu-muted); font-size: 13px; }\n.fu-dot { width: 10px; height: 10px; border-radius: 999px; background: var(--dot-color); }\n.fu-table-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.fu-progress { height: 7px; min-width: 90px; border-radius: 999px; background: #EEF0F6; overflow: hidden; }\n.fu-progress span { display: block; height: 100%; width: var(--progress); background: var(--fu-green); border-radius: inherit; }\n.fu-nodata { padding: 22px; text-align: center; color: var(--fu-muted); }\n@media (max-width: 1280px) { .fu-kpi-grid { grid-template-columns: repeat(3, minmax(160px, 1fr)); } .fu-two-col, .fu-two-col-even { grid-template-columns: 1fr; } }\n@media (max-width: 680px) { .fu-page { padding: 12px; } .fu-kpi-grid { grid-template-columns: 1fr; } .zcs-page-header { align-items: flex-start; flex-direction: column; } .fu-status-row { grid-template-columns: 105px 1fr 36px; } .fu-aging-legend { grid-template-columns: 1fr; } }\n&lt;/style&gt;\n&lt;div class=&quot;fu-page&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis&quot; style=&quot;position:relative;z-index:1;&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-24 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Follow-Up Tracker Dashboard&lt;/h5&gt;\n\t\t\t&lt;div class=&quot;fu-header-subtitle zcs-font-14&quot;&gt;Analytics across status, priority, aging, responsibility, and observation category. Refreshed &lt;%=lastRefresh%&gt;.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot; style=&quot;position:relative;z-index:1;flex-wrap:wrap;&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Follow_Up_Schedule&quot; target=&quot;same-window&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline design-todo&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Follow Up Schedule&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Overdue_Follow_Ups&quot; target=&quot;same-window&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Overdue Follow Ups&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;fu-grid fu-kpi-grid zcs-mt-12&quot;&gt;\n\t\t&lt;div class=&quot;fu-card fu-card-pad fu-kpi zcs-labelvalue-wrapper&quot; style=&quot;--kpi-color:var(--fu-blue);&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-