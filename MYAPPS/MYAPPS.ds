		blueprint
		{
			Observation_Lifecycle as "Observation Lifecycle"
			{
			    type = blueprint
			    form = Audit_Observations
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Under Review" { }
			        "Accepted" { }
			        "Remediation" { }
			        "Closed" { }
			        "Rejected" { }
			    }
			
			    transitions
			    {
			        Submit_For_Review as "Submit For Review"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Under Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Auditor", "Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Under Review";
			                    )
			                }
			            }
			        }
			        Accept_Observation as "Accept Observation"
			        {
			            type = normal
			            from stage = "Under Review"
			            to stage = "Accepted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Accepted";
			                    Accepted_Date = zoho.currentdate;
			                    )
			                }
			            }
			        }
			        Reject_Observation as "Reject Observation"
			        {
			            type = normal
			            from stage = "Under Review"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Rejected";
			                    )
			                }
			            }
			        }
			        Start_Remediation as "Start Remediation"
			        {
			            type = normal
			            from stage = "Accepted"
			            to stage = "Remediation"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Risk_Owner", "Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Remediation";
			                    )
			                }
			            }
			        }
			        Close_Observation as "Close Observation"
			        {
			            type = normal
			            from stage = "Remediation"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Close this observation?"
			                    confirm button text = "Close"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Closed";
			                    Closed_Date = zoho.currentdate;
			                    )
			                }
			            }
			        }
			        Rework_Observation as "Rework Observation"
			        {
			            type = common
			            from stage = "Under Review"
			            to stage = "Draft"
			            common stages = {"Accepted", "Remediation"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			                tooltip message = "Return the observation to draft for rework"
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Status = "Draft";
			                    )
			                }
			            }
			        }
			    }
			}

			Audit_Plan_Lifecycle as "Audit Plan Lifecycle"
			{
			    type = blueprint
			    form = Audit_Plans
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Submitted" { }
			        "Approved" { }
			        "Rejected" { }
			        "Sent Back for Rework" { }
			        "Closed" { }
			    }
			
			    transitions
			    {
			        Submit_Plan as "Submit Plan"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Submitted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager", "Auditor"}
			                )
			            }
			            after { }
			        }
			        Approve_Plan as "Approve Plan"
			        {
			            type = normal
			            from stage = "Submitted"
			            to stage = "Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after { }
			        }
			        Send_Back_for_Rework as "Send Back for Rework"
			        {
			            type = normal
			            from stage = "Submitted"
			            to stage = "Sent Back for Rework"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after { }
			        }
			        Resubmit_Plan as "Resubmit Plan"
			        {
			            type = normal
			            from stage = "Sent Back for Rework"
			            to stage = "Submitted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager", "Auditor"}
			                )
			            }
			            after { }
			        }
			        Reject_Plan as "Reject Plan"
			        {
			            type = normal
			            from stage = "Submitted"
			            to stage = "Rejected"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after { }
			        }
			        Close_Plan as "Close Plan"
			        {
			            type = normal
			            from stage = "Approved"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after { }
			        }
			    }
			}

			Audit_Lifecycle as "Audit Lifecycle"
			{
			    type = blueprint
			    form = Audits
			
			    start
			    {
			        start stage = "Planning"
			    }
			
			    stages
			    {
			        "Planning" { }
			        "Execution" { }
			        "Reporting" { }
			        "Follow-up" { }
			        "Closed" { }
			    }
			
			    transitions
			    {
			        Start_Execution as "Start Execution"
			        {
			            type = normal
			            from stage = "Planning"
			            to stage = "Execution"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Stage = "Execution";
			                    Status = "Active";
			                    Actual_Start = zoho.currentdate;
			                    )
			                }
			            }
			        }
			        Move_To_Reporting as "Move To Reporting"
			        {
			            type = normal
			            from stage = "Execution"
			            to stage = "Reporting"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                    userfields = {Lead_Auditor}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Stage = "Reporting";
			                    Progress_Percent = 70;
			                    )
			                }
			            }
			        }
			        Move_To_Follow_Up as "Move To Follow-up"
			        {
			            type = normal
			            from stage = "Reporting"
			            to stage = "Follow-up"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Stage = "Follow-up";
			                    Progress_Percent = 90;
			                    )
			                }
			            }
			        }
			        Close_Audit as "Close Audit"
			        {
			            type = normal
			            from stage = "Follow-up"
			            to stage = "Closed"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			                confirmation before execution
			                (
			                    message = "Close this audit engagement?"
			                    confirm button text = "Close"
			                    cancel button text = "Cancel"
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Stage = "Closed";
			                    Status = "Closed";
			                    Actual_End = zoho.currentdate;
			                    Progress_Percent = 100;
			                    )
			                }
			            }
			        }
			        Send_Back_For_Rework as "Send Back For Rework"
			        {
			            type = common
			            from stage = "Execution"
			            to stage = "Planning"
			            common stages = {"Reporting", "Follow-up"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Audit_Manager"}
			                )
			                tooltip message = "Return this audit to planning for rework"
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Stage = "Planning";
			                    Status = "Active";
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

