			Risk_Register_On_Load as "Risk Register On Load"
			{
			    type = form
			    form = Risk_Register
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Risk_Treatment == "Mitigate" || input.Risk_Treatment == "Escalate")
			                {
			                    show Mitigation_Plans;
			                    show Next_Review_Date;
			                    enable Mitigation_Plans;
			                    enable Next_Review_Date;
			                }
			                else if(input.Risk_Treatment == "Accept")
			                {
			                    hide Mitigation_Plans;
			                    disable Next_Review_Date;
			                }
			            )
			        }
			    }
			}

			Risk_Register_On_Success as "Risk Register On Success"
			{
			    type = form
			    form = Risk_Register
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                impactScore = 0;
			                likelihoodScore = 0;
			                if(input.Impact_Level != null)
			                {
			                    impactScore = input.Impact_Level.getPrefix("-").toDecimal();
			                }
			                if(input.Likelihood != null)
			                {
			                    likelihoodScore = input.Likelihood.getPrefix("-").toDecimal();
			                }
			                input.Inherent_Risk_Score = impactScore * likelihoodScore;
			                controlScore = 1;
			                if(input.Control_Effectiveness == "Effective")
			                {
			                    controlScore = 4;
			                }
			                else if(input.Control_Effectiveness == "Partial")
			                {
			                    controlScore = 2;
			                }
			                else if(input.Control_Effectiveness == "Ineffective")
			                {
			                    controlScore = 0;
			                }
			                else
			                {
			                    controlScore = 1;
			                }
			                input.Control_Effectiveness_Score = controlScore;
			                residual = input.Inherent_Risk_Score - controlScore;
			                if(residual < 1)
			                {
			                    residual = 1;
			                }
			                input.Residual_Risk_Score = residual.round(1);
			                if(input.Residual_Risk_Score <= 4)
			                {
			                    input.Residual_Risk_Rating = "Low";
			                }
			                else if(input.Residual_Risk_Score <= 14)
			                {
			                    input.Residual_Risk_Rating = "Medium";
			                }
			                else if(input.Residual_Risk_Score <= 20)
			                {
			                    input.Residual_Risk_Rating = "High";
			                }
			                else
			                {
			                    input.Residual_Risk_Rating = "Critical";
			                }
			            )
			        }
			    }
			}

			Risk_Register_On_Validate as "Risk Register On Validate"
			{
			    type = form
			    form = Risk_Register
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Impact_Level == null || input.Likelihood == null)
			                {
			                    alert "Impact level and likelihood are required for risk assessment.";
			                    cancel submit;
			                }
			                if(input.Review_Frequency != null && input.Next_Review_Date == null)
			                {
			                    alert "Next review date is required when review frequency is selected.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Risk_Treatment_On_User_Input as "Risk Treatment On User Input"
			{
			    type = form
			    form = Risk_Register
			    record event = on add or edit
			
			    on user input of Risk_Treatment
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Risk_Treatment == "Mitigate" || input.Risk_Treatment == "Escalate")
			                {
			                    show Mitigation_Plans;
			                    show Next_Review_Date;
			                    enable Mitigation_Plans;
			                    enable Next_Review_Date;
			                }
			                else if(input.Risk_Treatment == "Accept")
			                {
			                    hide Mitigation_Plans;
			                    disable Next_Review_Date;
			                }
			                else
			                {
			                    show Mitigation_Plans;
			                    show Next_Review_Date;
			                }
			            )
			        }
			    }
			}

