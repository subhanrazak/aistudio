		        Residual_Risk_Rating
		        Status
		    )
		    sort by
		    (
		        Residual_Risk_Score descending
		        Next_Review_Date ascending
		    )
		}

		list Risk_Library_Cards
		{
		    displayName = "Risk Library Cards"
		    show all rows from Risk_Register
		    (
		        Risk_Title as "Risk Title"
		        Risk_Category as "Risk Category"
		        Risk_Description as "Risk Description"
		        Residual_Risk_Rating as "Residual Risk Rating"
		        Status
		    )
		    filters
		    (
		        Risk_Category
		        Residual_Risk_Rating
		        Status
		    )
		    sort by
		    (
		        Risk_Title ascending
		    )
		}

		kanban Risk_Status_Kanban
		{
		    displayName = "Risk Status Kanban"
		    show all rows from Risk_Register
		    (
		        Risk_Code as "Risk Code"
		        Risk_Title as "Risk Title"
		        Risk_Category as "Risk Category"
		        Residual_Risk_Rating as "Residual Risk Rating"
		        Risk_Owner as "Risk Owner"
		        Status
		    )
		    filters
		    (
		        Risk_Category
		        Residual_Risk_Rating
		        Status
		    )
		    sort by
		    (
		        Risk_Title ascending
		    )
		    options
		    (
		        display field = Status
		        sortorder = ascending
		        recordcount = enable
		    )
		}

		calendar Risks_Due_For_Review
		{
		    displayName = "Risks Due For Review"
		    show all rows from Risk_Register [Next_Review_Date != null]
		    (
		        Risk_Title as "Risk Title"
		        Risk_Category as "Risk Category"
		        Residual_Risk_Rating as "Residual Risk Rating"
		        Risk_Owner as "Risk Owner"
		        Next_Review_Date as "Next Review Date"
		        Status
		    )
		    filters
		    (
		        Risk_Category
		        Residual_Risk_Rating
		        Status
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Risk_Title
		        start date = Next_Review_Date
		        allowed views = month,week,day
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list Active_Test_of_Controls
		{
		    displayName = "Active Test of Controls"
		    show all rows from Test_of_Controls_Library [Initial_Status == "Active" || Test_Status == "Active"]
		    (
		        Test_ID as "Test ID"
		        Test_Name as "Test Name"
		        Test_Type as "Test Type"
		        Control
		        Control_Type as "Control Type"
		        Applicable_Audit_Type as "Applicable Audit Type"
		        Test_Frequency as "Test Frequency"
		        Test_Status as "Test Status"
		        Version
		    )
		    filters
		    (
		        Test_Type
		        Control_Type
		        Test_Frequency
		    )
		    sort by
		    (
		        Test_Name ascending
		    )
		}

		kanban Test_Status_Kanban
		{
		    displayName = "Test Status Kanban"
		    show all rows from Test_of_Controls_Library
		    (
		        Test_ID as "Test ID"
		        Test_Name as "Test Name"
		        Test_Type as "Test Type"
		        Control_Type as "Control Type"
		        Test_Frequency as "Test Frequency"
		        Test_Status as "Test Status"
		        Version
		    )
		    filters
		    (
		        Test_Type
		        Control_Type
		        Test_Status
		    )
		    sort by
		    (
		        Test_Name ascending
		    )
		    options
		    (
		        display field = Test_Status
		        sortorder = ascending
		        recordcount = enable
		    )
		}

		default list Test_of_Controls_Report
		{
		    displayName = "Test of Controls Library"
		    show all rows from Test_of_Controls_Library
		    (
		        Test_ID as "Test ID"
		        Test_Name as "Test Name"
		        Test_Type as "Test Type"
		        Control
		        Control_Type as "Control Type"
		        Applicable_Audit_Type as "Applicable Audit Type"
		        Test_Frequency as "Test Frequency"
		        Test_Status as "Test Status"
		        Version
		    )
		    filters
		    (
		        Test_Type
		        Control_Type
		        Applicable_Audit_Type
		        Test_Status
		    )
		    sort by
		    (
		        Test_Name ascending
		    )
		}

		list Tests_By_Control_Type
		{
		    displayName = "Tests By Control Type"
		    show all rows from Test_of_Controls_Library
		    (
		        Control_Type as "Control Type"
		        Test_ID as "Test ID"
		        Test_Name as "Test Name"
		        Test_Type as "Test Type"
		        Control
		        Test_Frequency as "Test Frequency"
		        Test_Status as "Test Status"
		        Version
		    )
		    filters
		    (
		        Control_Type
		        Test_Type
		        Test_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Control_Type ascending
		    )
		    sort by
		    (
		        Control_Type ascending
		        Test_Name ascending
		    )
		}

		list Active_Workpaper_Templates
		{
		    displayName = "Active Workpaper Templates"
		    show all rows from Workpaper_Templates [Status == "Active"]
		    (
		        Workpaper_ID as "Workpaper ID"
		        Workpaper_Name as "Workpaper Name"
		        Workpaper_Type as "Workpaper Type"
		        Applicable_Audit_Type as "Applicable Audit Type"
		        Risk_Category as "Risk Category"
		        Control_Type as "Control Type"
		        Status
		        Version
		    )
		    filters
		    (
		        Workpaper_Type
		        Risk_Category
		        Control_Type
		    )
		    sort by
		    (
		        Workpaper_Name ascending
		    )
		}

		default list Workpaper_Library
		{
		    displayName = "Workpaper Library"
		    show all rows from Workpaper_Templates
		    (
		        Workpaper_ID as "Workpaper ID"
		        Workpaper_Name as "Workpaper Name"
		        Workpaper_Type as "Workpaper Type"
		        Applicable_Audit_Type as "Applicable Audit Type"
		        Risk_Category as "Risk Category"
		        Control_Type as "Control Type"
		        Status
		        Version
		    )
		    filters
		    (
		        Workpaper_Type
		        Risk_Category
		        Control_Type
		        Status
		    )
		    sort by
		    (
		        Workpaper_Name ascending
		    )
		}

		list Workpapers_By_Type
		{
		    displayName = "Workpapers By Type"
		    show all rows from Workpaper_Templates
		    (
		        Workpaper_Type as "Workpaper Type"
		        Workpaper_ID as "Workpaper ID"
		        Workpaper_Name as "Workpaper Name"
		        Risk_Category as "Risk Category"
		        Control_Type as "Control Type"
		        Status
		        Version
		    )
		    filters
		    (
		        Workpaper_Type
		        Risk_Category
		        Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Workpaper_Type ascending
		    )
		    sort by
		    (
		        Workpaper_Type ascending
		        Workpaper_Name ascending
		    )
		}
	}

	pages
	{
		page Audit_Dashboard
		{
					displayname = "Audit Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Audit_Dashboard_Overview' elementName='Audit_Dashboard_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Audit_Dashboard_Overview()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\ttotalAudits = Audits[ID != 0].count();\n\tactiveAudits = Audits[Status == &quot;Active&quot;].count();\n\ttotalPlans = Audit_Plans[ID != 0].count();\n\topenObservations = Audit_Observations[Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Rejected&quot;].count();\n\toverdueTasks = Remediation_Tasks[Status == &quot;Overdue&quot;].count();\n\tfollowUps = Follow_Ups[ID != 0].count();\n%&gt;\n&lt;style&gt;\n.legacy-audit-dashboard { font-family: Arial, sans-serif; background:#fff7f8; padding:24px; color:#1f2937; }\n.legacy-audit-header { background:#111827; color:#fff; border-radius:16px; padding:24px; border-left:6px solid #ff2f3f; }\n.legacy-audit-header h1 { margin:0 0 6px; font-size:28px; }\n.legacy-audit-header p { margin:0; opacity:.82; }\n.legacy-audit-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:20px; }\n.legacy-audit-card { background:#fff; border:1px solid #ffe0e5; border-radius:14px; padding:18px; box-shadow:0 8px 24px rgba(17,24,39,.06); }\n.legacy-audit-label { font-size:13px; color:#6b7280; margin-bottom:8px; }\n.legacy-audit-value { font-size:30px; font-weight:800; color:#ff2f3f; }\n.legacy-audit-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }\n.legacy-audit-actions a { text-decoration:none; background:#ff2f3f; color:#fff; padding:10px 14px; border-radius:10px; font-weight:700; font-size:13px; }\n@media (max-width: 900px) { .legacy-audit-grid { grid-template-columns:1fr; } }\n&lt;/style&gt;\n&lt;div class=&quot;legacy-audit-dashboard&quot;&gt;\n\t&lt;div class=&quot;legacy-audit-header&quot;&gt;\n\t\t&lt;h1&gt;Audit Dashboard&lt;/h1&gt;\n\t\t&lt;p&gt;This legacy dashboard has been aligned to the current ERM/Internal Audit data model. Use the primary Internal Audit Dashboard for the full screen-inspired experience.&lt;/p&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;legacy-audit-grid&quot;&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Total Audits&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=totalAudits%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Active Audits&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=activeAudits%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Audit Plans&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=totalPlans%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Open Observations&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=openObservations%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Overdue Remediation Tasks&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=overdueTasks%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;legacy-audit-card&quot;&gt;&lt;div class=&quot;legacy-audit-label&quot;&gt;Follow-Ups&lt;/div&gt;&lt;div class=&quot;legacy-audit-value&quot;&gt;&lt;%=followUps%&gt;&lt;/div&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;legacy-audit-actions&quot;&gt;\n\t\t&lt;a href=&quot;#Page:Internal_Audit_Dashboard&quot;&gt;Open Internal Audit Dashboard&lt;/a&gt;\n\t\t&lt;a href=&quot;#Report:All_Audits&quot;&gt;Audit Listings&lt;/a&gt;\n\t\t&lt;a href=&quot;#Report:Open_Observations&quot;&gt;Open Observations&lt;/a&gt;\n\t\t&lt;a href=&quot;#Report:Follow_Up_Schedule&quot;&gt;Follow-Up Schedule&lt;/a&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Audit_Planning_Workspace(int Plan_ID)
		{
					displayname = "Audit Planning Workspace"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Planning_Workspace_Snippet' elementName='Planning_Workspace_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Planning_Workspace_Snippet()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nselectedPlanID = 0;\nselectedPlanName = &quot;Latest available plan&quot;;\nselectedPlanCode = &quot;-&quot;;\nselectedPlanYear = &quot;All FY&quot;;\nselectedPlanDept = &quot;All Departments&quot;;\nselectedPlanSize = &quot;-&quot;;\nselectedPlanPriority = &quot;-&quot;;\nselectedPlanStatus = &quot;-&quot;;\npreparedByName = &quot;-&quot;;\nresourceRequirement = &quot;To be confirmed&quot;;\nsubmittedDateText = &quot;Not submitted&quot;;\nvalidationMessage = &quot;Workspace is generated from live plan and plan-entity records.&quot;;\nplanFound = false;\nif(input.Plan_ID != null &amp;&amp; input.Plan_ID &gt; 0)\n{\n\tplanRecords = Audit_Plans[ID == input.Plan_ID];\n}\nelse\n{\n\tplanRecords = Audit_Plans[ID != 0] sort by Created_Date desc;\n}\nfor each planRec in planRecords\n{\n\tselectedPlanID = planRec.ID;\n\tselectedPlanName = ifnull(planRec.Plan_Name,&quot;Untitled audit plan&quot;);\n\tselectedPlanCode = ifnull(planRec.Plan_Code,&quot;-&quot;);\n\tselectedPlanYear = ifnull(planRec.Planning_Year,&quot;All FY&quot;);\n\tselectedPlanDept = ifnull(planRec.Department.Department_Name,&quot;All Departments&quot;);\n\tselectedPlanSize = ifnull(planRec.Plan_Size,&quot;-&quot;);\n\tselectedPlanPriority = ifnull(planRec.Priority_for_Implementation,&quot;-&quot;);\n\tselectedPlanStatus = ifnull(planRec.Status,&quot;-&quot;);\n\tpreparedByName = ifnull(planRec.Prepared_By.Full_Name,&quot;-&quot;);\n\tresourceRequirement = ifnull(planRec.Resource_Requirement,&quot;To be confirmed&quot;);\n\tif(planRec.Submitted_Date != null)\n\t{\n\t\tsubmittedDateText = planRec.Submitted_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t}\n\tvalidationMessage = ifnull(planRec.Validation_Message,&quot;Plan validation checks are ready for review.&quot;);\n\tplanFound = true;\n\tbreak;\n}\nif(planFound == true &amp;&amp; selectedPlanID &gt; 0)\n{\n\tentityCount = Audit_Plan_Entities[Plan == selectedPlanID].count();\n\ttotalAuditDays = Audit_Plan_Entities[Plan == selectedPlanID].sum(Estimated_Days);\n\tfyPlanCount = Audit_Plans[Planning_Year == selectedPlanYear].count();\n\tq1Days = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Planning_Quarter == &quot;Q1&quot;].sum(Estimated_Days);\n\tq2Days = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Planning_Quarter == &quot;Q2&quot;].sum(Estimated_Days);\n\tq3Days = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Planning_Quarter == &quot;Q3&quot;].sum(Estimated_Days);\n\tq4Days = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Planning_Quarter == &quot;Q4&quot;].sum(Estimated_Days);\n\tcriticalCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Priority == &quot;Critical&quot;].count();\n\thighCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Priority == &quot;High&quot;].count();\n\tmediumCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Priority == &quot;Medium&quot;].count();\n\tlowCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Priority == &quot;Low&quot;].count();\n\textensiveCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Audit_Size == &quot;Extensive&quot;].count();\n\tlargeCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Audit_Size == &quot;Large&quot;].count();\n\tsizeMediumCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Audit_Size == &quot;Medium&quot;].count();\n\tsmallCount = Audit_Plan_Entities[Plan == selectedPlanID &amp;&amp; Audit_Size == &quot;Small&quot;].count();\n}\nelse\n{\n\tentityCount = Audit_Plan_Entities[ID != 0].count();\n\ttotalAuditDays = Audit_Plan_Entities[ID != 0].sum(Estimated_Days);\n\tfyPlanCount = Audit_Plans[ID != 0].count();\n\tq1Days = Audit_Plan_Entities[Planning_Quarter == &quot;Q1&quot;].sum(Estimated_Days);\n\tq2Days = Audit_Plan_Entities[Planning_Quarter == &quot;Q2&quot;].sum(Estimated_Days);\n\tq3Days = Audit_Plan_Entities[Planning_Quarter == &quot;Q3&quot;].sum(Estimated_Days);\n\tq4Days = Audit_Plan_Entities[Planning_Quarter == &quot;Q4&quot;].sum(Estimated_Days);\n\tcriticalCount = Audit_Plan_Entities[Priority == &quot;Critical&quot;].count();\n\thighCount = Audit_Plan_Entities[Priority == &quot;High&quot;].count();\n\tmediumCount = Audit_Plan_Entities[Priority == &quot;Medium&quot;].count();\n\tlowCount = Audit_Plan_Entities[Priority == &quot;Low&quot;].count();\n\textensiveCount = Audit_Plan_Entities[Audit_Size == &quot;Extensive&quot;].count();\n\tlargeCount = Audit_Plan_Entities[Audit_Size == &quot;Large&quot;].count();\n\tsizeMediumCount = Audit_Plan_Entities[Audit_Size == &quot;Medium&quot;].count();\n\tsmallCount = Audit_Plan_Entities[Audit_Size == &quot;Small&quot;].count();\n}\nif(totalAuditDays == null)\n{\n\ttotalAuditDays = 0;\n}\nif(q1Days == null)\n{\n\tq1Days = 0;\n}\nif(q2Days == null)\n{\n\tq2Days = 0;\n}\nif(q3Days == null)\n{\n\tq3Days = 0;\n}\nif(q4Days == null)\n{\n\tq4Days = 0;\n}\nmaxPriority = criticalCount;\nif(highCount &gt; maxPriority)\n{\n\tmaxPriority = highCount;\n}\nif(mediumCount &gt; maxPriority)\n{\n\tmaxPriority = mediumCount;\n}\nif(lowCount &gt; maxPriority)\n{\n\tmaxPriority = lowCount;\n}\ncriticalPct = 0;\nhighPct = 0;\nmediumPct = 0;\nlowPct = 0;\nif(maxPriority &gt; 0)\n{\n\tcriticalPct = (criticalCount * 100) / maxPriority;\n\thighPct = (highCount * 100) / maxPriority;\n\tmediumPct = (mediumCount * 100) / maxPriority;\n\tlowPct = (lowCount * 100) / maxPriority;\n}\nmaxSize = extensiveCount;\nif(largeCount &gt; maxSize)\n{\n\tmaxSize = largeCount;\n}\nif(sizeMediumCount &gt; maxSize)\n{\n\tmaxSize = sizeMediumCount;\n}\nif(smallCount &gt; maxSize)\n{\n\tmaxSize = smallCount;\n}\nextensivePct = 0;\nlargePct = 0;\nsizeMediumPct = 0;\nsmallPct = 0;\nif(maxSize &gt; 0)\n{\n\textensivePct = (extensiveCount * 100) / maxSize;\n\tlargePct = (largeCount * 100) / maxSize;\n\tsizeMediumPct = (sizeMediumCount * 100) / maxSize;\n\tsmallPct = (smallCount * 100) / maxSize;\n}\nqTotalDays = q1Days + q2Days + q3Days + q4Days;\nq1Pct = 0;\nq2Pct = 0;\nq3Pct = 0;\nq4Pct = 0;\nif(qTotalDays &gt; 0)\n{\n\tq1Pct = (q1Days * 100) / qTotalDays;\n\tq2Pct = (q2Days * 100) / qTotalDays;\n\tq3Pct = (q3Days * 100) / qTotalDays;\n\tq4Pct = (q4Days * 100) / qTotalDays;\n}\n%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for this page ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; --column-gap: 0px; }\n.zcs-row { display:flex; flex-wrap:wrap; }\n.zcs-flex { display:flex; }\n.zcs-inline-flex { display:inline-flex; }\n.zcs-direction-column { flex-direction:column; }\n.zcs-align-items-center { align-items:center; }\n.zcs-align-items-start { align-items:flex-start; }\n.zcs-justify-center { justify-content:center; }\n.zcs-justify-space-between { justify-content:space-between; }\n.zcs-gap-4 { gap:.25rem; }\n.zcs-gap-6 { gap:.375rem; }\n.zcs-gap-8 { gap:.5rem; }\n.zcs-gap-10 { gap:.625rem; }\n.zcs-gap-12 { gap:.75rem; }\n.zcs-gap-16 { gap:1rem; }\n.zcs-gap-20 { gap:1.25rem; }\n.zcs-gap-24 { gap:1.5rem; }\n.zcs-p-0 { padding:0; }\n.zcs-p-8 { padding:.5rem; }\n.zcs-p-12 { padding:.75rem; }\n.zcs-p-16 { padding:1rem; }\n.zcs-p-20 { padding:1.25rem; }\n.zcs-p-24 { padding:1.5rem; }\n.zcs-px-10 { padding-left:.625rem; padding-right:.625rem; }\n.zcs-px-12 { padding-left:.75rem; padding-right:.75rem; }\n.zcs-px-15 { padding-left:.9375rem; padding-right:.9375rem; }\n.zcs-px-16 { padding-left:1rem; padding-right:1rem; }\n.zcs-px-20 { padding-left:1.25rem; padding-right:1.25rem; }\n.zcs-px-24 { padding-left:1.5rem; padding-right:1.5rem; }\n.zcs-px-30 { padding-left:1.875rem; padding-right:1.875rem; }\n.zcs-py-0 { padding-top:0; padding-bottom:0; }\n.zcs-py-5 { padding-top:.3125rem; padding-bottom:.3125rem; }\n.zcs-py-8 { padding-top:.5rem; padding-bottom:.5rem; }\n.zcs-py-10 { padding-top:.625rem; padding-bottom:.625rem; }\n.zcs-py-12 { padding-top:.75rem; padding-bottom:.75rem; }\n.zcs-py-16 { padding-top:1rem; padding-bottom:1rem; }\n.zcs-py-20 { padding-top:1.25rem; padding-bottom:1.25rem; }\n.zcs-py-24 { padding-top:1.5rem; padding-bottom:1.5rem; }\n.zcs-m-0 { margin:0; }\n.zcs-mt-8 { margin-top:.5rem; }\n.zcs-mt-16 { margin-top:1rem; }\n.zcs-mb-12 { margin-bottom:.75rem; }\n.zcs-mb-16 { margin-bottom:1rem; }\n.zcs-w-full { width:100%; }\n.zcs-h-full { height:100%; }\n.zcs-wh-full { width:100%; height:100%; }\n.zcs-col-common { flex:1 1 0%; min-width:0; }\n.zcs-col-3 { flex:0 0 25%; max-width:25%; }\n.zcs-col-4 { flex:0 0 33.333%; max-width:33.333%; }\n.zcs-col-6 { flex:0 0 50%; max-width:50%; }\n.zcs-col-12 { flex:0 0 100%; max-width:100%; }\n.zcs-no-shrink { flex-shrink:0; }\n.zcs-box-border { box-sizing:border-box; }\n.zcs-rounded-sm { border-radius:4px; }\n.zcs-rounded-md { border-radius:6px; }\n.zcs-rounded-lg { border-radius:8px; }\n.zcs-rounded-xl { border-radius:12px; }\n.zcs-rounded-half { border-radius:50%; }\n.zcs-relative { position:relative; }\n.zcs-sticky { position:sticky; }\n.zcs-text-left { text-align:left; }\n.zcs-text-right { text-align:right; }\n.zcs-text-center { text-align:center; }\n.zcs-font-11 { font-size:.6875rem; }\n.zcs-font-12 { font-size:.75rem; }\n.zcs-font-13 { font-size:.8125rem; }\n.zcs-font-14 { font-size:.875rem; }\n.zcs-font-15 { font-size:.9375rem; }\n.zcs-font-16 { font-size:1rem; }\n.zcs-font-18 { font-size:1.125rem; }\n.zcs-font-20 { font-size:1.25rem; }\n.zcs-font-24 { font-size:1.5rem; }\n.zcs-font-30 { font-size:1.875rem; }\n.zcs-font-normal { font-weight:400; }\n.zcs-font-medium { font-weight:500; }\n.zcs-font-semibold { font-weight:600; }\n.zcs-font-bold { font-weight:700; }\n.zcs-lh-body { line-height:1.5; }\n.zcs-lh-heading { line-height:1.25; }\n.zcs-color-theme { color:var(--zcs-theme-brand-color); }\n.zcs-color-primary { color:var(--zcs-primary-text-color); }\n.zcs-color-secondary { color:var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color:var(--zcs-teritiary-text-color); }\n.zcs-color-white { color:#fff; }\n.zcs-card { background-color:var(--zcs-white-color); border:1px solid #e7e7ee; border-radius:12px; }\na { text-decoration:none; }\n#splash-screen { display:none !important; }\n/* ===== ZCS component CSS: buttons, tabs, stepper, table, banner, progress, label-value ===== */\n.zcs-button { width:auto; min-width:5rem; min-height:36px; transition:all .2s ease; }\n.zcs-primary-button { background-color:var(--zcs_brand_color); color:var(--zcs_brand_foreground_color); }\n.zcs-primary-outline-button { border:1px solid var(--zcs_brand_color); background-color:var(--zcs-white-color); color:var(--zcs_brand_color); }\n.zcs-primary-button:hover { background-color:var(--zcs_brand_dark_color); }\n.zcs-primary-outline-button:hover { background-color:var(--zcs_component_hover_color); border-color:var(--zcs_brand_color); color:var(--zcs_brand_color); }\n.zcs-button-icon { width:16px; max-height:16px; }\n.zcs-horizontal-tabhead { box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset; overflow-x:auto; overflow-y:hidden; scrollbar-width:none; }\n.zcs-horizontal-tabhead::-webkit-scrollbar { display:none; }\n.zcs-horizontal-tabitem { list-style-type:none; border-bottom:2px solid transparent; letter-spacing:.1px; }\n.zcs-horizontal-tabtext { white-space:nowrap; }\n.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink, .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color:var(--zcs_brand_color); }\n.zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color:var(--zcs_brand_color); }\n.zcs-stepper-wrapper { overflow-x:auto; padding:10px 0; }\n.zcs-stepper-status { width:32px; height:32px; background-color:var(--zcs_brand_color); border:4px solid var(--zcs-white-color); box-shadow:0 0 0 1px var(--zcs_brand_color); }\n.zcs-stepper-count { display:none; }\n.zcs-stepper-icon.zcs-stepper-failed { display:none; }\n.zcs-stepper:not(:last-child):before { content:&apos;&apos;; width:100%; height:1px; border-top:1px solid var(--zcs_brand_color); box-sizing:border-box; position:absolute; top:16px; left:50%; }\n.zcs-stepper-active .zcs-stepper-status { border:1px solid var(--zcs_brand_color); outline:4px solid var(--zcs-white-color); background-color:var(--zcs-white-color); }\n.zcs-stepper-active .zcs-stepper-count { display:flex; border-width:0; color:var(--zcs_brand_color); }\n.zcs-stepper-active .zcs-stepper-icon { display:none; }\n.zcs-stepper-active .zcs-stepper-text { font-weight:600; color:var(--zcs_brand_color); }\n.zcs-stepper.zcs-stepper-active:before, .zcs-stepper.zcs-stepper-active~.zcs-stepper:before { border-color:var(--zcs_tertiary_border_color); }\n.zcs-stepper-active~.zcs-stepper .zcs-stepper-status { background-color:var(--zcs-white-color); box-shadow:0 0 0 1px var(--zcs_tertiary_border_color); }\n.zcs-stepper-active~.zcs-stepper .zcs-stepper-count { display:flex; }\n.zcs-stepper-active~.zcs-stepper .zcs-stepper-icon { display:none; }\n.zcs-stepper-active~.zcs-stepper .zcs-stepper-text { color:var(--zcs_tertiary_text_color); }\n.zcs-table-wrapper { border:1px solid var(--zcs_tertiary_border_color); background-color:var(--zcs-white-color); overflow:auto; }\n.zcs-table-wrapper table { line-height:normal; border-collapse:collapse; min-width:840px; }\n.zcs-table-wrapper table thead { top:0; z-index:1; }\n.zcs-table-wrapper table thead tr th { background-color:#F9FAFE; box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space:nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top:1px solid var(--zcs_tertiary_border_color); vertical-align:top; }\n.zcs-table-wrapper table tbody tr.zcs-tgroup td { background-color:#F1F2F8; font-weight:600; }\n.zcs-table-wrapper table tbody tr:hover td { background-color:#F9FAFE; }\n.zcs-green { color:#179e6c; }\n.zcs-red { color:#fe455d; }\n.zcs-yellow { color:#b8770d; }\n.zcs-blue { color:#09598e; }\n.zcs-l_blue { color:#1094c5; }\n.zcs-toast { border:1px solid transparent; }\n.zcs-success-toast { background-color:#edf7ed; color:#1d4620; }\n.zcs-info-toast { background-color:#e4f6fd; color:#024361; }\n.zcs-warning-toast { background-color:#fef4e5; color:#663c01; }\n.zcs-progress-bar { height:8px; background-color:var(--zcs_component_hover_color); overflow:hidden; }\n.zcs-progress-bar-indicator { height:inherit; border-radius:inherit; background-color:var(--zcs_brand_color); }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-yellow { color:#a06309; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color:#179e6c; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color:#2a6ffc; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color:#FE455D; }\n/* ===== Page-specific planning workspace ===== */\n.apw-page { min-height:100%; background:var(--zcs-page-bg-color); padding:24px; box-sizing:border-box; }\n.apw-shell { max-width:1480px; margin:0 auto; }\n.apw-header { background:linear-gradient(135deg, var(--zcs-white-color), var(--zcs_component_hover_color)); border:1px solid var(--zcs_tertiary_border_color); border-radius:16px; }\n.apw-eyebrow { text-transform:uppercase; letter-spacing:.08em; }\n.apw-kpi-grid { display:grid; grid-template-columns:repeat(4, minmax(180px, 1fr)); gap:16px; }\n.apw-kpi-card { position:relative; overflow:hidden; }\n.apw-kpi-card:after { content:&apos;&apos;; position:absolute; width:86px; height:86px; border-radius:50%; right:-28px; bottom:-28px; background:var(--zcs_brand_light_color); opacity:.55; }\n.apw-kpi-icon { width:42px; height:42px; border-radius:12px; background:var(--zcs_brand_light_color); color:var(--zcs_brand_color); }\n.apw-section { margin-top:18px; }\n.apw-section-title { border-left:4px solid var(--zcs_brand_color); padding-left:12px; }\n.apw-two-col { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1fr); gap:18px; }\n.apw-three-col { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:18px; }\n.apw-chart-row { display:grid; grid-template-columns:120px minmax(0, 1fr) 48px; gap:12px; align-items:center; margin:12px 0; }\n.apw-bar-track { height:12px; background:var(--zcs_component_hover_color); border-radius:999px; overflow:hidden; }\n.apw-bar { height:100%; border-radius:999px; background:var(--zcs_brand_color); }\n.apw-bar-red { background:#fe455d; }\n.apw-bar-yellow { background:#b8770d; }\n.apw-bar-green { background:#179e6c; }\n.apw-bar-blue { background:#1094c5; }\n.apw-pill { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:3px 9px; font-size:12px; font-weight:600; background:var(--zcs_component_hover_color); color:var(--zcs_primary_text_color); white-space:nowrap; }\n.apw-pill-critical { background:#feedec; color:#9f1239; }\n.apw-pill-high { background:#fef4e5; color:#8a4b00; }\n.apw-pill-medium { background:#e4f6fd; color:#024361; }\n.apw-pill-low { background:#edf7ed; color:#1d4620; }\n.apw-reference-embed { min-height:320px; border:1px dashed var(--zcs_tertiary_border_color); border-radius:12px; background:var(--zcs-white-color); overflow:auto; }\n.apw-quarter-strip { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:12px; }\n.apw-muted { color:var(--zcs_tertiary_text_color); }\n.apw-empty { padding:20px; text-align:center; color:var(--zcs_tertiary_text_color); }\n@media (max-width:1100px) { .apw-kpi-grid, .apw-quarter-strip { grid-template-columns:repeat(2, minmax(0, 1fr)); } .apw-two-col, .apw-three-col { grid-template-columns:1fr; } }\n@media (max-width:680px) { .apw-page { padding:12px; } .apw-kpi-grid, .apw-quarter-strip { grid-template-columns:1fr; } .zcs-col-3, .zcs-col-4, .zcs-col-6 { flex-basis:100%; max-width:100%; } .zcs-stepper-wrapper ul { min-width:920px; } }\n&lt;/style&gt;\n&lt;div class=&quot;apw-page&quot;&gt;\n\t&lt;div class=&quot;apw-shell zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t&lt;div class=&quot;apw-header zcs-p-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-16 zcs-row&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-common&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;apw-eyebrow zcs-font-12 zcs-font-bold zcs-color-theme&quot;&gt;Audit planning workspace&lt;/span&gt;\n\t\t\t\t\t&lt;h1 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=selectedPlanName%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;Plan &lt;strong&gt;&lt;%=selectedPlanCode%&gt;&lt;/strong&gt; for &lt;strong&gt;&lt;%=selectedPlanYear%&gt;&lt;/strong&gt;, owned by &lt;strong&gt;&lt;%=selectedPlanDept%&gt;&lt;/strong&gt;. This workspace summarizes selected entities, prioritization, sizing, schedule, skills, and approval readiness.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Audit_Plans&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-single-folded-content&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Audit Plans List&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Plan_Entities_By_Department&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline design-todo&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Plan Entities&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-stepper-wrapper&quot;&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&quot;&gt;&lt;div class=&quot;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-stepper-count zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;1&lt;/h6&gt;&lt;i class=&quot;zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-color-white zc-li-outline ui-1-check-small&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-stepper-text zcs-font-14 zcs-lh-body zcs-color-primary&quot;&gt;Basic Details&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&quot;&gt;&lt;div class=&quot;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-stepper-count zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;2&lt;/h6&gt;&lt;i class=&quot;zcs-stepp