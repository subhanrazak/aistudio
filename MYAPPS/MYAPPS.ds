		    (
		        type = email
		        displayname = "Owner Email"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		        personal data = true
		    )
		    must have Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Finding_Status
		    (
		        type = picklist
		        displayname = "Finding Status"
		        values = {"Open", "Action Proposed", "In Progress", "Pending Verification", "Closed"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evidence_Link
		    (
		        type = url
		        displayname = "Evidence Link"
		        enable = linkname, title
		        target = same window
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

