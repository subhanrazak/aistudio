application "MYAPPS"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Accounts
		{
		    displayname = "Accounts"
		    success message = "Account saved successfully"
		    Account_Details
		    (
		        type = section
		        displayname = "Account Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Account_Name
		    (
		        type = text
		        displayname = "Account Name"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Account_Type
		    (
		        type = picklist
		        displayname = "Account Type"
		        values = {"Customer", "Vendor", "Partner", "Internal", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Industry
		    (
		        type = picklist
		        values = {"Manufacturing", "Finance", "Healthcare", "Technology", "Retail", "Government", "Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Website
		    (
		        type = url
		        enable = linkname, title
		        target = same window
		        row = 1
		        column = 2
		        width = medium
		    )
		    Primary_Email
		    (
		        type = email
		        displayname = "Primary Email"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        row = 1
		        column = 2
		        width = medium
		    )
		    Billing_Address
		    (
		        type = textarea
		        displayname = "Billing Address"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Account_Status
		    (
		        type = picklist
		        displayname = "Account Status"
		        values = {"Active", "Inactive", "Prospect"}
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Activities
		{
		    displayname = "Activities"
		    success message = "Activity saved successfully"
		    Activity_Details
		    (
		        type = section
		        displayname = "Activity Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Activity_Subject
		    (
		        type = text
		        displayname = "Activity Subject"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Activity_Type
		    (
		        type = picklist
		        displayname = "Activity Type"
		        values = {"Call", "Meeting", "Email", "Task", "Review", "Follow-up", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Account
		    (
		        type = picklist
		        values = Accounts.ID
		        displayformat = [Account_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact
		    (
		        type = picklist
		        values = Contacts.ID
		        displayformat = [Contact_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Deal
		    (
		        type = picklist
		        values = Deals.ID
		        displayformat = [Deal_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Audit
		    (
		        type = picklist
		        values = Audits.ID
		        displayformat = [Audit_Title]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Owner Email"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Activity_Status
		    (
		        type = picklist
		        displayname = "Activity Status"
		        values = {"Not Started", "In Progress", "Completed", "Deferred", "Cancelled"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 180px
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Add_Users
		{
		    displayname = "Add Users"
		    success message = "User Added Successfully"
		    Section
		    (
		        type = section
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have unique User_Email
		    (
		        type = email
		        displayname = "User Email"
		        maxchar = 80
		        row = 1
		        column = 1
		        width = medium
		        personal data = true
		    )
		    must have Profile
		    (
		        type = picklist
		        maxchar = 100
		        values = {"Choice 1"}
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            submit
		            (
		                type = submit
		                displayname = "Add"
		            )
		        }
		        on edit
		        {
		            update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Checklist_Items
		{
		    displayname = "Audit Checklist Items"
		    success message = "Audit checklist item saved successfully"
		    Checklist_Details
		    (
		        type = section
		        displayname = "Checklist Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    must have Audit
		    (
		        type = picklist
		        values = Audits.ID
		        displayformat = [Audit_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Checklist_Question
		    (
		        type = textarea
		        displayname = "Checklist Question"
		        height = 120px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Category
		    (
		        type = picklist
		        values = {"Documentation", "Process", "Compliance", "Safety", "IT", "Finance"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Result
		    (
		        type = picklist
		        values = {"Compliant", "Non-Compliant", "Not Applicable", "Observation"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 150px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evidence_Link
		    (
		        type = url
		        displayname = "Evidence Link"
		        enable = linkname, title
		        target = same window
		        row = 1
		        column = 2
		        width = medium
		    )
		    Requires_Finding
		    (
		        type = checkbox
		        displayname = "Requires Finding"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Evidence
		{
		    displayname = "Audit Evidence"
		    success message = "Audit evidence saved successfully"
		    Evidence_Details
		    (
		        type = section
		        displayname = "Evidence Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    Evidence_ID
		    (
		        type = autonumber
		        displayname = "Evidence ID"
		        start index = 3001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Audit
		    (
		        type = picklist
		        values = Audits.ID
		        displayformat = [Audit_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Finding
		    (
		        type = picklist
		        values = Findings.ID
		        displayformat = [Finding_Title]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Evidence_Title
		    (
		        type = text
		        displayname = "Evidence Title"
		        maxchar = 150
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evidence_Type
		    (
		        type = picklist
		        displayname = "Evidence Type"
		        values = {"Document", "Image", "Link", "Interview", "Observation", "Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Evidence_Link
		    (
		        type = url
		        displayname = "Evidence Link"
		        enable = linkname, title
		        target = same window
		        row = 1
		        column = 1
		        width = medium
		    )
		    Collected_By_Email
		    (
		        type = email
		        displayname = "Collected By Email"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    Collection_Date
		    (
		        type = date
		        displayname = "Collection Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Evidence_Status
		    (
		        type = picklist
		        displayname = "Evidence Status"
		        values = {"Draft", "Submitted", "Reviewed", "Accepted", "Rejected"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        height = 180px
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Findings
		{
		    displayname = "Audit Findings"
		    success message = "Audit finding saved successfully"
		    Finding_Details
		    (
		        type = section
		        displayname = "Finding Details"
		        row = 1
		        column = 0
		        width = medium
		    )
		    Audit_Finding_Number
		    (
		        type = autonumber
		        displayname = "Audit Finding Number"
		        start index = 4001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Audit
		    (
		        type = picklist
		        values = Audits.ID
		        displayformat = [Audit_Title]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Finding_Title
		    (
		        type = text
		        displayname = "Finding Title"
		        maxchar = 150
		        row = 1
		        column = 2
		        width = medium
		    )
		    Finding_Type
		    (
		        type = picklist
		        displayname = "Finding Type"
		        values = {"Non-Conformance", "Observation", "Opportunity for Improvement", "Risk", "Control Gap"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Severity
		    (
		        type = picklist
		        values = {"Low", "Medium", "High", "Critical"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        height = 180px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Owner Email"
		        maxchar = 80
		        row = 1
		        column = 2
		        width = medium
		    )
		    Due_Date
		    (
		        type = date
		        displayname = "Due Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Finding_Status
		    (
		        type = picklist
		        displayname = "Finding Status"
		        values = {"Open", "In Review", "Action Required", "Closed"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Evidence_Link
		    (
		        type = url
		        displayname = "Evidence Link"
		        enable = linkname, title
		        target = same window
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Observations
		{
		    displayname = "Audit Observations"
		    success message = "Audit observation saved successfully"
		    Basic
		    (
		        type = section
		        displayname = "Basic Details"
		        row = 1
		        column = 0
		    )
		    must have unique Observation_ID
		    (
		        type = text
		        displayname = "Observation ID"
		        maxchar = 40
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Audit
		    (
		        type = picklist
		        values = Audits.ID
		        displayformat = [Audit_Title]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Observation_Template
		    (
		        type = picklist
		        displayname = "Observation Template"
		        values = Observation_Form_Templates.ID
		        displayformat = [Form_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Related_Test_Execution
		    (
		        type = picklist
		        displayname = "Related Test Execution"
		        values = Audit_Test_Executions.ID
		        displayformat = [Execution_ID]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Observation_Title
		    (
		        type = text
		        displayname = "Observation Title"
		        maxchar = 250
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Observation_Description
		    (
		        type = textarea
		        displayname = "Observation Description"
		        height = 160px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Observation_Type
		    (
		        type = picklist
		        displayname = "Observation Type"
		        values = {"Control Deficiency", "Process Inefficiency", "Compliance Gap", "Security Finding", "Risk Event", "Improvement Opportunity"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Severity
		    (
		        type = picklist
		        values = {"Low", "Medium", "High", "Critical"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Risk_Category
		    (
		        type = picklist
		        displayname = "Risk Category"
		        values = {"Financial", "Operational", "Compliance", "IT", "Regulatory", "Security", "Privacy"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Department
		    (
		        type = picklist
		        values = Departments.ID
		        displayformat = [Department_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Observation_Owner
		    (
		        type = picklist
		        displayname = "Observation Owner"
		        values = Audit_Team_Members.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Analysis
		    (
		        type = section
		        displayname = "Analysis"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Root_Cause_Analysis
		    (
		        type = textarea
		        displayname = "Root Cause Analysis"
		        height = 160px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Impact_Assessment
		    (
		        type = textarea
		        displayname = "Impact Assessment"
		        height = 160px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Recommendations
		    (
		        type = textarea
		        height = 160px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Evidence_Upload
		    (
		        type = upload file
		        displayname = "Evidence Upload"
		        browse = local_drive, google_docs, zoho_docs
		        row = 2
		        column = 2
		        width = medium
		    )
		    Action_Plan_Required
		    (
		        type = checkbox
		        displayname = "Action Plan Required"
		        initial value = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Target_Closure_Date
		    (
		        type = date
		        displayname = "Target Closure Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Workflow
		    (
		        type = section
		        displayname = "Workflow"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Status
		    (
		        type = picklist
		        values = {"Draft", "Under Review", "Accepted", "Remediation", "Closed", "Rejected"}
		        initial value = "Draft"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Reviewer
		    (
		        type = picklist
		        values = Audit_Team_Members.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Accepted_Date
		    (
		        type = date
		        displayname = "Accepted Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Closed_Date
		    (
		        type = date
		        displayname = "Closed Date"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Version_Notes
		    (
		        type = textarea
		        displayname = "Version Notes"
		        height = 140px
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
		    blueprint components
		    {
		        stages = {"Draft", "Under Review", "Accepted", "Remediation", "Closed", "Rejected"}
		    }
		}

		form Audit_Plan_Entities
		{
		    displayname = "Audit Plan Entities"
		    success message = "Audit plan entity saved successfully"
		    Entity_Selection
		    (
		        type = section
		        displayname = "Entity Selection"
		        row = 1
		        column = 0
		    )
		    must have Plan
		    (
		        type = picklist
		        displayname = "Plan"
		        values = Audit_Plans.ID
		        displayformat = [Plan_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Auditable_Entity
		    (
		        type = picklist
		        displayname = "Auditable Entity"
		        values = Audit_Universe.ID
		        displayformat = [Auditable_Entity_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Department
		    (
		        type = picklist
		        displayname = "Department"
		        values = Departments.ID
		        displayformat = [Department_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Entity_Type
		    (
		        type = picklist
		        displayname = "Entity Type"
		        values = {"Department", "Process", "IT System", "Compliance", "Vendor", "Legal Entity"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Residual_Risk
		    (
		        type = decimal
		        displayname = "Residual Risk"
		        decimalplace = 1
		        row = 1
		        column = 1
		        width = medium
		    )
		    Last_Audit_Date
		    (
		        type = date
		        displayname = "Last Audit Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Audit_Triggers
		    (
		        type = list
		        displayname = "Audit Triggers"
		        values = {"Change", "New Reg", "Incident", "Management Request", "Periodic Review", "Finding Follow-up"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Entity_Score
		    (
		        type = number
		        displayname = "Entity Score"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Priority
		    (
		        type = picklist
		        displayname = "Priority"
		        values = {"Low", "Medium", "High", "Critical"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Recommended_FY
		    (
		        type = picklist
		        displayname = "Recommended FY"
		        values = {"FY2025", "FY2026", "FY2027"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Audit_Frequency
		    (
		        type = picklist
		        displayname = "Audit Frequency"
		        values = {"Annual", "Every 2 Years", "Every 3 Years"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Audit_Size_Scoring
		    (
		        type = section
		        displayname = "Audit Size Scoring"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Process_Complexity
		    (
		        type = picklist
		        displayname = "Process Complexity"
		        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Automation_Level
		    (
		        type = picklist
		        displayname = "Automation Level"
		        values = {"1-Very Low", "2-Low", "3-Medium", "4-High", "5-Very High"}
		        row = 2
		        column = 2
		        width = medium
		    )
		    Regulatory_Sensitivity
		    (
