	reports
	{
		default list All_Accounts
		{
		    displayName = "All Accounts"
		    show all rows from Accounts
		    (
		        Account_Name as "Account Name"
		        Account_Type as "Account Type"
		        Industry
		        Primary_Email as "Primary Email"
		        Phone
		        Account_Status as "Account Status"
		    )
		    filters
		    (
		        Account_Type
		        Industry
		        Account_Status
		    )
		    sort by
		    (
		        Account_Name ascending
		    )
		}

		default list All_Activities
		{
		    displayName = "All Activities"
		    show all rows from Activities
		    (
		        Activity_Subject as "Activity Subject"
		        Activity_Type as "Activity Type"
		        Account
		        Contact
		        Deal
		        Audit
		        Owner_Email as "Owner Email"
		        Due_Date as "Due Date"
		        Activity_Status as "Activity Status"
		    )
		    filters
		    (
		        Activity_Type
		        Account
		        Owner_Email
		        Activity_Status
		    )
		    sort by
		    (
		        Due_Date descending
		    )
		}

		list Open_Activities
		{
		    displayName = "Open Activities"
		    show all rows from Activities [Activity_Status != "Completed" && Activity_Status != "Cancelled"]
		    (
		        Activity_Subject as "Activity Subject"
		        Activity_Type as "Activity Type"
		        Owner_Email as "Owner Email"
		        Due_Date as "Due Date"
		        Activity_Status as "Activity Status"
		    )
		    filters
		    (
		        Activity_Type
		        Owner_Email
		        Activity_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		default list All_Users
		{
		    displayName = "All Users"
		    show all rows from Add_Users
		    (
		        User_Email as "User Email"
		        Profile
		    )
		}

		default list All_Audit_Checklist_Items
		{
		    displayName = "All Audit Checklist Items"
		    show all rows from Audit_Checklist_Items
		    (
		        Audit
		        Checklist_Question as "Checklist Question"
		        Category
		        Result
		        Requires_Finding as "Requires Finding"
		        Evidence_Link as "Evidence Link"
		        Notes
		    )
		    filters
		    (
		        Audit
		        Category
		        Result
		        Requires_Finding
		    )
		    sort by
		    (
		        Category ascending
		    )
		}

		list Non_Compliant_Audit_Checklist_Items
		{
		    displayName = "Non-Compliant Audit Checklist Items"
		    show all rows from Audit_Checklist_Items [Result == "Non-Compliant"]
		    (
		        Audit
		        Checklist_Question as "Checklist Question"
		        Category
		        Result
		        Requires_Finding as "Requires Finding"
		        Evidence_Link as "Evidence Link"
		    )
		    filters
		    (
		        Audit
		        Category
		        Requires_Finding
		    )
		    sort by
		    (
		        Category ascending
		    )
		}

		default list All_Audit_Evidence
		{
		    displayName = "All Audit Evidence"
		    show all rows from Audit_Evidence
		    (
		        Evidence_ID as "Evidence ID"
		        Audit
		        Finding
		        Evidence_Title as "Evidence Title"
		        Evidence_Type as "Evidence Type"
		        Collected_By_Email as "Collected By Email"
		        Collection_Date as "Collection Date"
		        Evidence_Status as "Evidence Status"
		    )
		    filters
		    (
		        Audit
		        Finding
		        Evidence_Type
		        Evidence_Status
		    )
		    sort by
		    (
		        Collection_Date descending
		    )
		}

		list Submitted_Evidence
		{
		    displayName = "Submitted Evidence"
		    show all rows from Audit_Evidence [Evidence_Status == "Submitted" || Evidence_Status == "Reviewed"]
		    (
		        Evidence_ID as "Evidence ID"
		        Audit
		        Finding
		        Evidence_Title as "Evidence Title"
		        Evidence_Type as "Evidence Type"
		        Collection_Date as "Collection Date"
		        Evidence_Status as "Evidence Status"
		    )
		    filters
		    (
		        Audit
		        Evidence_Type
		        Evidence_Status
		    )
		    sort by
		    (
		        Collection_Date descending
		    )
		}

		default list All_Audit_Findings
		{
		    displayName = "All Audit Findings"
		    show all rows from Audit_Findings
		    (
		        Audit_Finding_Number as "Audit Finding Number"
		        Audit
		        Finding_Title as "Finding Title"
		        Finding_Type as "Finding Type"
		        Severity
		        Owner_Email as "Owner Email"
		        Due_Date as "Due Date"
		        Finding_Status as "Finding Status"
		    )
		    filters
		    (
		        Audit
		        Severity
		        Owner_Email
		        Finding_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		list Open_Audit_Findings
		{
		    displayName = "Open Audit Findings"
		    show all rows from Audit_Findings [Finding_Status != "Closed"]
		    (
		        Audit_Finding_Number as "Audit Finding Number"
		        Audit
		        Finding_Title as "Finding Title"
		        Severity
		        Owner_Email as "Owner Email"
		        Due_Date as "Due Date"
		        Finding_Status as "Finding Status"
		    )
		    filters
		    (
		        Audit
		        Severity
		        Owner_Email
		        Finding_Status
		    )
		    sort by
		    (
		        Due_Date ascending
		    )
		}

		default list All_Audit_Observations
		{
		    displayName = "All Audit Observations"
		    show all rows from Audit_Observations
		    (
		        Observation_ID as "Observation ID"
		        Audit
		        Observation_Title as "Observation Title"
