g%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fu-status-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Completed&lt;/span&gt;&lt;div class=&quot;fu-track&quot;&gt;&lt;div class=&quot;fu-fill&quot; style=&quot;--bar-width:&lt;%=statusCompletedPct%&gt;%;--bar-color:var(--fu-green);&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=statusCompleted%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fu-status-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Overdue&lt;/span&gt;&lt;div class=&quot;fu-track&quot;&gt;&lt;div class=&quot;fu-fill&quot; style=&quot;--bar-width:&lt;%=statusOverduePct%&gt;%;--bar-color:var(--fu-red);&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=statusOverdue%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fu-status-row&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Closed&lt;/span&gt;&lt;div class=&quot;fu-track&quot;&gt;&lt;div class=&quot;fu-fill&quot; style=&quot;--bar-width:&lt;%=statusClosedPct%&gt;%;--bar-color:var(--fu-purple);&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-font-13 zcs-text-right&quot;&gt;&lt;%=statusClosed%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;fu-card fu-card-pad&quot;&gt;\n\t\t\t&lt;h3 class=&quot;fu-card-title&quot;&gt;Follow-ups by Priority&lt;/h3&gt;\n\t\t\t&lt;div class=&quot;fu-card-note&quot;&gt;CSS/SVG donut approximation grouped by Priority.&lt;/div&gt;\n\t\t\t&lt;div class=&quot;fu-donut-box zcs-donut-chart-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-20 zcs-p-20 zcs-box-border&quot; style=&quot;--donut-cx:100px;--donut-cy:100px;--donut-r:78;--donut-stroke_width:22;--donut-pi:3.14;--donut-a1:&lt;%=criticalPct%&gt;;--donut-a2:&lt;%=highPct%&gt;;--donut-a3:&lt;%=mediumPct%&gt;;--donut-a4:&lt;%=lowPct%&gt;;--donut-donut_size:200px;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-donut-chart zcs-simple-donut-chart zcs-flex zcs-align-items-center zcs-justify-center zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;svg class=&quot;zcs-rounded-full&quot; viewBox=&quot;0 0 200 200&quot;&gt;\n\t\t\t\t\t\t&lt;circle r=&quot;78&quot;&gt;&lt;/circle&gt;\n\t\t\t\t\t\t&lt;circle r=&quot;78&quot;&gt;&lt;/circle&gt;\n\t\t\t\t\t\t&lt;circle r=&quot;78&quot;&gt;&lt;/circle&gt;\n\t\t\t\t\t\t&lt;circle r=&quot;78&quot;&gt;&lt;/circle&gt;\n\t\t\t\t\t&lt;/svg&gt;\n\t\t\t\t\t&lt;h6 class=&quot;fu-donut-center zcs-donut-chart-name zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-absolute zcs-text-center&quot;&gt;&lt;%=priorityTotal%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Priority total&lt;/span&gt;&lt;/h6&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-legend-wrapper zcs-col-common&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Critical&lt;/label&gt;&lt;span class=&quot;fu-legend-value&quot;&gt;&lt;%=criticalPriority%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;High&lt;/label&gt;&lt;span class=&quot;fu-legend-value&quot;&gt;&lt;%=highPriority%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Medium&lt;/label&gt;&lt;span class=&quot;fu-legend-value&quot;&gt;&lt;%=mediumPriority%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;Low&lt;/label&gt;&lt;span class=&quot;fu-legend-value&quot;&gt;&lt;%=lowPriority%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;fu-grid fu-two-col zcs-mt-12&quot;&gt;\n\t\t&lt;div class=&quot;fu-card fu-card-pad&quot;&gt;\n\t\t\t&lt;h3 class=&quot;fu-card-title&quot;&gt;Closure Timeline Trend&lt;/h3&gt;\n\t\t\t&lt;div class=&quot;fu-card-note&quot;&gt;Line and area chart based on Completed or Closed follow-ups by Last Updated date.&lt;/div&gt;\n\t\t\t&lt;div class=&quot;fu-chart-frame zcs-chart zcs-areachart-wrapper zcs-relative&quot;&gt;\n\t\t\t\t&lt;svg class=&quot;fu-line-svg&quot; viewBox=&quot;0 0 560 140&quot; preserveAspectRatio=&quot;none&quot;&gt;\n\t\t\t\t\t&lt;defs&gt;\n\t\t\t\t\t\t&lt;linearGradient id=&quot;fuTrendGradient&quot; x1=&quot;0&quot; x2=&quot;0&quot; y1=&quot;0&quot; y2=&quot;1&quot;&gt;\n\t\t\t\t\t\t\t&lt;stop offset=&quot;0%&quot; stop-color=&quot;var(--zcs_brand_color)&quot; stop-opacity=&quot;0.30&quot;&gt;&lt;/stop&gt;\n\t\t\t\t\t\t\t&lt;stop offset=&quot;100%&quot; stop-color=&quot;var(--zcs_brand_color)&quot; stop-opacity=&quot;0.02&quot;&gt;&lt;/stop&gt;\n\t\t\t\t\t\t&lt;/linearGradient&gt;\n\t\t\t\t\t&lt;/defs&gt;\n\t\t\t\t\t&lt;line class=&quot;fu-line-grid&quot; x1=&quot;20&quot; x2=&quot;540&quot; y1=&quot;12&quot; y2=&quot;12&quot;&gt;&lt;/line&gt;\n\t\t\t\t\t&lt;line class=&quot;fu-line-grid&quot; x1=&quot;20&quot; x2=&quot;540&quot; y1=&quot;52&quot; y2=&quot;52&quot;&gt;&lt;/line&gt;\n\t\t\t\t\t&lt;line class=&quot;fu-line-grid&quot; x1=&quot;20&quot; x2=&quot;540&quot; y1=&quot;92&quot; y2=&quot;92&quot;&gt;&lt;/line&gt;\n\t\t\t\t\t&lt;polygon class=&quot;fu-line-area&quot; points=&quot;20,92 20,&lt;%=trendY1%&gt; 120,&lt;%=trendY2%&gt; 220,&lt;%=trendY3%&gt; 320,&lt;%=trendY4%&gt; 420,&lt;%=trendY5%&gt; 520,&lt;%=trendY6%&gt; 520,92&quot;&gt;&lt;/polygon&gt;\n\t\t\t\t\t&lt;polyline class=&quot;fu-line&quot; points=&quot;20,&lt;%=trendY1%&gt; 120,&lt;%=trendY2%&gt; 220,&lt;%=trendY3%&gt; 320,&lt;%=trendY4%&gt; 420,&lt;%=trendY5%&gt; 520,&lt;%=trendY6%&gt;&quot;&gt;&lt;/polyline&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;20&quot; cy=&quot;&lt;%=trendY1%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;20&quot; y=&quot;&lt;%=trendY1 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend1%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;120&quot; cy=&quot;&lt;%=trendY2%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;120&quot; y=&quot;&lt;%=trendY2 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend2%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;220&quot; cy=&quot;&lt;%=trendY3%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;220&quot; y=&quot;&lt;%=trendY3 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend3%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;320&quot; cy=&quot;&lt;%=trendY4%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;320&quot; y=&quot;&lt;%=trendY4 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend4%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;420&quot; cy=&quot;&lt;%=trendY5%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;420&quot; y=&quot;&lt;%=trendY5 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend5%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;circle class=&quot;fu-line-dot&quot; cx=&quot;520&quot; cy=&quot;&lt;%=trendY6%&gt;&quot; r=&quot;4&quot;&gt;&lt;/circle&gt;&lt;text class=&quot;fu-axis-value&quot; x=&quot;520&quot; y=&quot;&lt;%=trendY6 - 7%&gt;&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trend6%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;20&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel1%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;120&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel2%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;220&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel3%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;320&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel4%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;420&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel5%&gt;&lt;/text&gt;\n\t\t\t\t\t&lt;text class=&quot;fu-axis-label&quot; x=&quot;520&quot; y=&quot;127&quot; text-anchor=&quot;middle&quot;&gt;&lt;%=trendLabel6%&gt;&lt;/text&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;fu-card fu-card-pad&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;fu-card-title&quot;&gt;Follow-ups Aging Analysis&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-card-note&quot;&gt;Stacked bar for open, pending, in-progress, and overdue follow-ups by due-date aging.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;fu-mini-link&quot; href=&quot;#Report:Overdue_Follow_Ups&quot; target=&quot;same-window&quot;&gt;Review overdue &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-chart zcs-stackedbarchart-wrapper&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fu-aging-stack&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-aging-segment&quot; style=&quot;--aging-width:&lt;%=notDuePct%&gt;%;--aging-color:var(--fu-green);&quot;&gt;&lt;%=notDueAging%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-aging-segment&quot; style=&quot;--aging-width:&lt;%=age0to7Pct%&gt;%;--aging-color:var(--fu-yellow);&quot;&gt;&lt;%=age0to7%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-aging-segment&quot; style=&quot;--aging-width:&lt;%=age8to30Pct%&gt;%;--aging-color:var(--fu-orange);&quot;&gt;&lt;%=age8to30%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-aging-segment&quot; style=&quot;--aging-width:&lt;%=ageOver30Pct%&gt;%;--aging-color:var(--fu-red);&quot;&gt;&lt;%=ageOver30%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fu-aging-legend&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-legend-chip&quot;&gt;&lt;span class=&quot;fu-dot&quot; style=&quot;--dot-color:var(--fu-green);&quot;&gt;&lt;/span&gt;Not due &lt;strong&gt;&lt;%=notDueAging%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-legend-chip&quot;&gt;&lt;span class=&quot;fu-dot&quot; style=&quot;--dot-color:var(--fu-yellow);&quot;&gt;&lt;/span&gt;0 to 7 days &lt;strong&gt;&lt;%=age0to7%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-legend-chip&quot;&gt;&lt;span class=&quot;fu-dot&quot; style=&quot;--dot-color:var(--fu-orange);&quot;&gt;&lt;/span&gt;8 to 30 days &lt;strong&gt;&lt;%=age8to30%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-legend-chip&quot;&gt;&lt;span class=&quot;fu-dot&quot; style=&quot;--dot-color:var(--fu-red);&quot;&gt;&lt;/span&gt;Over 30 days &lt;strong&gt;&lt;%=ageOver30%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;fu-grid fu-two-col-even zcs-mt-12&quot;&gt;\n\t\t&lt;div class=&quot;fu-card fu-card-pad&quot;&gt;\n\t\t\t&lt;div class=&quot;fu-table-titlebar&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;fu-card-title&quot;&gt;Follow-up Summary by Observation Category&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-card-note&quot;&gt;Grouped from Follow_Ups by Observation_Category.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Category&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Total&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Open&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;In Progress&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Completed&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Overdue&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;6&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tfor each cat in categoryList\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tcatTotal = Follow_Ups[Observation_Category == cat].count();\n\t\t\t\t\t\t\tcatOpen = Follow_Ups[Observation_Category == cat &amp;&amp; Status == &quot;Open&quot;].count();\n\t\t\t\t\t\t\tcatProgress = Follow_Ups[Observation_Category == cat &amp;&amp; Status == &quot;In Progress&quot;].count();\n\t\t\t\t\t\t\tcatComplete = Follow_Ups[Observation_Category == cat &amp;&amp; (Status == &quot;Completed&quot; || Status == &quot;Closed&quot;)].count();\n\t\t\t\t\t\t\tcatOverdue = Follow_Ups[Observation_Category == cat &amp;&amp; ((Status == &quot;Overdue&quot;) || (Due_Date &lt; today &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;))].count();\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=cat%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=catTotal%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&quot;&gt;&lt;%=catOpen%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&quot;&gt;&lt;%=catProgress%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&quot;&gt;&lt;%=catComplete%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&quot;&gt;&lt;%=catOverdue%&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;fu-card fu-card-pad&quot;&gt;\n\t\t\t&lt;div class=&quot;fu-table-titlebar&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;fu-card-title&quot;&gt;Follow-up Responsibility by Department&lt;/h3&gt;\n\t\t\t\t\t&lt;div class=&quot;fu-card-note&quot;&gt;Grouped from Follow_Ups by Responsible_Department.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Department&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Total&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;In Progress&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Overdue&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Completion&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tdeptRows = 0;\n\t\t\t\t\t\tfor each dept in Departments[ID != 0] sort by Department_Name asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tdeptTotal = Follow_Ups[Responsible_Department == dept.ID].count();\n\t\t\t\t\t\t\tif(deptTotal &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tdeptRows = deptRows + 1;\n\t\t\t\t\t\t\t\tdeptProgress = Follow_Ups[Responsible_Department == dept.ID &amp;&amp; Status == &quot;In Progress&quot;].count();\n\t\t\t\t\t\t\t\tdeptComplete = Follow_Ups[Responsible_Department == dept.ID &amp;&amp; (Status == &quot;Completed&quot; || Status == &quot;Closed&quot;)].count();\n\t\t\t\t\t\t\t\tdeptOverdue = Follow_Ups[Responsible_Department == dept.ID &amp;&amp; ((Status == &quot;Overdue&quot;) || (Due_Date &lt; today &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;))].count();\n\t\t\t\t\t\t\t\tdeptCompletionRate = (deptComplete * 100) / deptTotal;\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=dept.Department_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=deptTotal%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&quot;&gt;&lt;%=deptProgress%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&quot;&gt;&lt;%=deptOverdue%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;div class=&quot;fu-progress&quot;&gt;&lt;span style=&quot;--progress:&lt;%=deptCompletionRate%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong&gt;&lt;%=deptCompletionRate%&gt;%&lt;/strong&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(deptRows == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;fu-nodata&quot; colspan=&quot;5&quot;&gt;No department responsibility data is available yet.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Internal_Audit_Dashboard
		{
					displayname = "Internal Audit Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Internal_Audit_Dashboard_Overview' elementName='Internal_Audit_Dashboard_Overview'>\n\t\t\t\t\t<![CDATA[htmlpage Internal_Audit_Dashboard_Overview()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\ttoday = zoho.currentdate;\n\tweekEnd = today.addDay(7);\n\n\ttotalAudits = Audits[ID != 0].count();\n\tactiveAudits = Audits[Status == &quot;Active&quot;].count();\n\tcompletedAudits = Audits[Status == &quot;Completed&quot; || Status == &quot;Closed&quot;].count();\n\topenObservations = Audit_Observations[Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Rejected&quot;].count();\n\tfollowUpItems = Follow_Ups[ID != 0].count();\n\tdueThisWeek = Follow_Ups[Due_Date &gt;= today &amp;&amp; Due_Date &lt;= weekEnd &amp;&amp; Status != &quot;Completed&quot; &amp;&amp; Status != &quot;Closed&quot;].count();\n\ttestTotal = Audit_Test_Executions[ID != 0].count();\n\n\tsampleMode = totalAudits == 0 &amp;&amp; openObservations == 0 &amp;&amp; followUpItems == 0 &amp;&amp; testTotal == 0;\n\tkpiTotalAudits = totalAudits;\n\tkpiActiveAudits = activeAudits;\n\tkpiCompletedAudits = completedAudits;\n\tkpiOpenObservations = openObservations;\n\tkpiFollowUpItems = followUpItems;\n\tkpiDueThisWeek = dueThisWeek;\n\tif(sampleMode)\n\t{\n\t\tkpiTotalAudits = 24;\n\t\tkpiActiveAudits = 8;\n\t\tkpiCompletedAudits = 13;\n\t\tkpiOpenObservations = 17;\n\t\tkpiFollowUpItems = 9;\n\t\tkpiDueThisWeek = 4;\n\t}\n\n\tpassTests = Audit_Test_Executions[Test_Result == &quot;Pass&quot;].count();\n\tfailTests = Audit_Test_Executions[Test_Result == &quot;Fail&quot;].count();\n\texceptionTests = Audit_Test_Executions[Test_Result == &quot;Exception&quot;].count();\n\tnotTestedTests = Audit_Test_Executions[Test_Result == &quot;Not Tested&quot; || Test_Result == &quot;Not Applicable&quot;].count();\n\tcompletedTests = Audit_Test_Executions[Test_Status == &quot;Completed&quot;].count();\n\tpendingReviewTests = Audit_Test_Executions[Review_Status == &quot;Pending Review&quot;].count();\n\tif(testTotal == 0)\n\t{\n\t\tpassTests = 18;\n\t\tfailTests = 3;\n\t\texceptionTests = 2;\n\t\tnotTestedTests = 5;\n\t\tcompletedTests = 21;\n\t\tpendingReviewTests = 4;\n\t\ttestTotal = 28;\n\t}\n%&gt;\n&lt;style&gt;\n/* zcs-global.css: shared utility subset included once for this page */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #ff2f3f);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color, #fff0f2);\n\t--zcs-app-header-color: #141525;\n\t--zcs-page-bg-color: #f3f3f6;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color, #171827);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #5f6375);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895);\n\t--zcs-border-color: var(--zcs_tertiary_border_color, #e7e7ee);\n\t--zcs-white-color: #ffffff;\n\t--zcs-black-color: #000000;\n\t--zcs-primary-btn-color: var(--zcs_brand_color, #ff2f3f);\n\t--zcs-primary-btn-border-color: var(--zcs_brand_color, #ff2f3f);\n\t--zcs-primary-btn-text-color: var(--zcs_brand_foreground_color, #ffffff);\n\t--audit-accent: #ff2f3f;\n\t--audit-dark: #111321;\n\t--audit-dark-2: #1b1d30;\n\t--audit-muted: #74798a;\n\t--audit-soft: #f5f6fa;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-col-auto{flex:0 0 auto;width:auto}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}.zcs-overflow-hidden{overflow:hidden}.zcs-overflow-auto{overflow:auto}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-lg{border-radius:8px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-2xl{border-radius:16px}.zcs-rounded-half{border-radius:50%}.zcs-rounded-full{border-radius:100%}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-25{padding:1.5625rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-font-10{font-size:.625rem}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:40px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-uppercase{text-transform:uppercase}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:#fff}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-green{color:#179e6c}.zcs-color-red{color:#fe455d}.zcs-color-yellow{color:#b8770d}.zcs-color-blue{color:#09598e}.zcs-color-l_blue{color:#1094c5}a{text-decoration:none}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.zcs-list-none{list-style-type:none}\n/* ZCS button-primary-button */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color, #ff2f3f);color:var(--zcs_brand_foreground_color, #ffffff)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color, #ff2f3f);background-color:var(--zcs-white-color);color:var(--zcs_brand_color, #ff2f3f)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color, #dfe2eb);background-color:var(--zcs_light_grey_color, #f3f4f7);color:var(--zcs-primary-text-color)}.zcs-primary-button.zcs-custom-color{background-color:var(--zcs-button-color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color, #d81f31)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color, #fff0f2);border-color:var(--zcs_brand_color, #ff2f3f);color:var(--zcs_brand_color, #ff2f3f)}.zcs-primary-button.zcs-button:active,.zcs-primary-button.zcs-button:focus{outline:2px solid var(--zcs_brand_color, #ff2f3f);outline-offset:2px}.zcs-button-icon{width:16px;max-height:16px}\n/* ZCS quick-actions-card-type-quick-actions */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color, #ff2f3f)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color, #ff2f3f)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:none}\n/* ZCS filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color, #ff2f3f);border-color:var(--zcs_brand_color, #ff2f3f);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179e6c;border-color:#179e6c;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#fe455d;border-color:#fe455d;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#faae13;border-color:#faae13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2a6ffc;border-color:#2a6ffc;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#f4660c;border-color:#f4660c;color:#fff}\n/* ZCS table-simple-table */\n:root{--zcs-thead-color:#f9fafe;--zcs-tr-h-color:#f9fafe;--zcs-tgroup-color:#f1f2f8;--zcs-tgroup-h-color:#f1f2f8}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color, #e7e7ee);background-color:#fff;overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color, #e7e7ee) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:#fff;box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color, #e7e7ee)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table thead tr th.zcs-green,.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table thead tr th.zcs-red,.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}.zcs-table-wrapper table thead tr th.zcs-yellow,.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table thead tr th.zcs-blue,.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}.zcs-table-wrapper table thead tr th.zcs-l_blue,.zcs-table-wrapper table tbody tr td.zcs-l_blue,.zcs-table-wrapper table tbody tr td .zcs-l_blue{color:#1094c5}\n/* Audit dashboard layout */\n.audit-dashboard *{box-sizing:border-box}.audit-dashboard{min-height:100%;background:linear-gradient(180deg,var(--audit-dark) 0, var(--audit-dark) 220px, #f3f4f8 220px, #f3f4f8 100%);font-family:Inter,Arial,sans-serif;color:var(--zcs-primary-text-color);padding:22px}.audit-shell{max-width:1440px;margin:0 auto}.audit-hero{background:radial-gradient(circle at 88% 15%, rgba(255,47,63,.38) 0, rgba(255,47,63,0) 28%),linear-gradient(135deg,#171a2c 0,#111321 58%,#241725 100%);border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:24px;color:#fff;box-shadow:0 18px 44px rgba(0,0,0,.18);position:relative;overflow:hidden}.audit-hero:after{content:&quot;&quot;;position:absolute;right:-70px;top:-80px;width:240px;height:240px;border:1px solid rgba(255,255,255,.13);border-radius:50%;box-shadow:0 0 0 38px rgba(255,255,255,.035),0 0 0 78px rgba(255,255,255,.025)}.audit-hero-content{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:18px}.audit-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,47,63,.16);border:1px solid rgba(255,47,63,.42);color:#ffd9dd;border-radius:999px;padding:6px 12px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em}.audit-hero h1{font-size:30px;line-height:1.15;margin:12px 0 8px;font-weight:700}.audit-hero p{margin:0;color:#c7cad6;font-size:14px}.audit-hero-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.audit-hero .zcs-button{background:#ff2f3f;color:#fff;border:0}.audit-hero .audit-secondary-link{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);color:#fff}.audit-kpi-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;margin-top:18px}.audit-kpi-card{padding:16px;background:#fff;border:1px solid #ececf2;border-radius:16px;box-shadow:0 10px 24px rgba(25,28,45,.06);min-height:120px}.audit-kpi-icon{width:38px;height:38px;border-radius:12px;background:#fff0f2;color:#ff2f3f;display:flex;align-items:center;justify-content:center;font-size:19px}.audit-kpi-label{color:#6d7282;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.audit-kpi-value{font-size:30px;font-weight:800;line-height:1;margin-top:12px;color:#151622}.audit-kpi-foot{margin-top:9px;color:#8a8f9e;font-size:12px}.audit-section{margin-top:18px}.audit-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.audit-section-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:700;color:#171827;margin:0}.audit-section-title i{color:#ff2f3f}.audit-section-link{font-size:13px;font-weight:700;color:#ff2f3f}.audit-quick-actions-wrapper{background:#fff;border-radius:16px}.audit-quick-actions-wrapper ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.audit-quick-actions-wrapper .zcs-quick-action-item{border-radius:14px;transition:all .18s ease}.audit-quick-actions-wrapper .zcs-quick-action-link{min-height:58px}.audit-quick-actions-wrapper .zcs-quick-action-icon{width:34px;height:34px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#fff0f2;color:#ff2f3f;font-size:18px}.audit-quick-count{margin-left:auto;background:#f3f4f8;color:#5f6375;border-radius:999px;padding:2px 8px;font-size:12px;font-weight:700}.audit-two-col{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);gap:18px}.audit-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.audit-record-card{border-radius:16px;padding:16px;position:relative;overflow:hidden}.audit-record-card:before{content:&quot;&quot;;position:absolute;left:0;top:0;bottom:0;width:4px;background:#ff2f3f}.audit-record-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.audit-record-code{font-size:12px;font-weight:800;color:#ff2f3f;letter-spacing:.04em;text-transform:uppercase}.audit-record-title{font-size:16px;font-weight:750;color:#171827;margin:6px 0 8px;line-height:1.3}.audit-record-meta{display:flex;flex-wrap:wrap;gap:8px 12px;color:#74798a;font-size:12px}.audit-record-meta span{display:inline-flex;align-items:center;gap:5px}.audit-progress-track{height:7px;background:#eef0f5;border-radius:999px;overflow:hidden;margin-top:14px}.audit-progress-bar{height:100%;background:linear-gradient(90deg,#ff2f3f,#ff7380);border-radius:999px}.audit-card-actions{display:flex;align-items:center;justify-content:space-between;margin-top:12px}.audit-mini-link{font-size:13px;font-weight:700;color:#ff2f3f;display:inline-flex;align-items:center;gap:6px}.audit-observation-card{border-radius:16px;padding:16px}.audit-observation-card .audit-record-title{margin-top:8px}.audit-severity-high{color:#fe455d}.audit-severity-medium{color:#b8770d}.audit-severity-low{color:#179e6c}.audit-table-card{border-radius:16px;padding:16px;background:#fff;border:1px solid #ececf2;box-shadow:0 10px 24px rgba(25,28,45,.05)}.audit-table-wrapper{border-radius:12px;max-height:420px}.audit-table-wrapper td,.audit-table-wrapper th{vertical-align:middle}.audit-status-pill{white-space:nowrap}.audit-empty{border:1px dashed #d9dce7;border-radius:14px;background:#fafbfe;padding:18px;text-align:center;color:#74798a}.audit-empty i{display:block;color:#ff2f3f;font-size:28px;margin-bottom:8px}.audit-subtle-note{display:inline-flex;align-items:center;gap:7px;background:#fff7f8;color:#b72634;border:1px solid #ffd7dc;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:700}.audit-source-strip{display:flex;align-items:center;gap:8px;color:#8a8f9e;font-size:12px}.audit-source-strip i{color:#ff2f3f}.audit-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.audit-result-meter{height:9px;background:#eff1f6;border-radius:999px;overflow:hidden;min-width:92px}.audit-result-meter span{display:block;height:100%;border-radius:999px;background:#ff2f3f}.audit-result-meter.pass span{background:#179e6c}.audit-result-meter.fail span{background:#fe455d}.audit-result-meter.pending span{background:#2a6ffc}.audit-result-meter.exception span{background:#f4660c}@media(max-width:1200px){.audit-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.audit-two-col,.audit-summary-grid{grid-template-columns:1fr}.audit-quick-actions-wrapper ul{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.audit-dashboard{padding:14px}.audit-hero-content{flex-direction:column;align-items:flex-start}.audit-hero-actions{justify-content:flex-start}.audit-kpi-grid,.audit-card-grid,.audit-quick-actions-wrapper ul{grid-template-columns:1fr}.audit-hero h1{font-size:24px}}\n&lt;/style&gt;\n\n&lt;div class=&quot;audit-dashboard&quot;&gt;\n\t&lt;div class=&quot;audit-shell&quot;&gt;\n\t\t&lt;header class=&quot;audit-hero&quot;&gt;\n\t\t\t&lt;div class=&quot;audit-hero-content&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;span class=&quot;audit-eyebrow&quot;&gt;&lt;i class=&quot;zc-li-outline business-board-30&quot;&gt;&lt;/i&gt; Internal Audit Command Center&lt;/span&gt;\n\t\t\t\t\t&lt;h1&gt;Internal Audit Dashboard&lt;/h1&gt;\n\t\t\t\t\t&lt;p&gt;Landing view for engagements, observations, follow-ups, approvals, and control test execution results.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-hero-actions&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Audits&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Audit Listings&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button audit-secondary-link zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Audit_Plans&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Audit Plans&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/header&gt;\n\n\t\t&lt;section class=&quot;audit-kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Total Audits&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiTotalAudits%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Audit records tracked&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Active Audits&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiActiveAudits%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Currently in progress&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Completed Audits&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiCompletedAudits%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Closed or completed&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Open Observations&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiOpenObservations%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Awaiting remediation&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Follow-up Items&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin-copy&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiFollowUpItems%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Action tracking items&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;audit-kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;&lt;span class=&quot;audit-kpi-label&quot;&gt;Due This Week&lt;/span&gt;&lt;span class=&quot;audit-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-value&quot;&gt;&lt;%=kpiDueThisWeek%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-kpi-foot&quot;&gt;Next 7 calendar days&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;% if(sampleMode) { %&gt;\n\t\t\t&lt;div class=&quot;audit-section audit-subtle-note&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Showing sample placeholders because no audit dashboard data exists yet.&lt;/div&gt;\n\t\t&lt;% } %&gt;\n\n\t\t&lt;section class=&quot;audit-section&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper audit-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-head zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;audit-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt; Quick Actions&lt;/h5&gt;\n\t\t\t\t\t&lt;span class=&quot;audit-source-strip&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; Report links&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Report:All_Audits&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-board-30&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;My Audits&lt;/span&gt;&lt;span class=&quot;audit-quick-count&quot;&gt;&lt;%=kpiActiveAudits%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Report:Open_Observations&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;My Observations&lt;/span&gt;&lt;span class=&quot;audit-quick-count&quot;&gt;&lt;%=kpiOpenObservations%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Report:Follow_Up_Schedule&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;My Follow-ups&lt;/span&gt;&lt;span class=&quot;audit-quick-count&quot;&gt;&lt;%=kpiDueThisWeek%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Report:All_Audit_Plans&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;My Approvals&lt;/span&gt;&lt;span class=&quot;audit-quick-count&quot;&gt;&lt;%=Audit_Observations[Status == &quot;Under Review&quot;].count()%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;audit-section audit-two-col&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-head&quot;&gt;\n\t\t\t\t\t&lt;h2 class=&quot;audit-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline business-board-30&quot;&gt;&lt;/i&gt; My Audit Engagements&lt;/h2&gt;\n\t\t\t\t\t&lt;a class=&quot;audit-section-link&quot; href=&quot;#Report:All_Audits&quot;&gt;View all&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;audit-card-grid&quot;&gt;\n\t\t\t\t\t&lt;% if(totalAudits == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-record-card zcs-property-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;audit-record-code&quot;&gt;AUD-2025-014&lt;/div&gt;&lt;div class=&quot;audit-record-title&quot;&gt;Procurement Process Review&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Execution&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; 12-Aug-2025&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Lead: R. Mehta&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Risk: High&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-progress-track&quot;&gt;&lt;div class=&quot;audit-progress-bar&quot; style=&quot;width:62%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;audit-card-actions&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;62% complete&lt;/span&gt;&lt;a class=&quot;audit-mini-link&quot; href=&quot;#Report:All_Audits&quot;&gt;Open &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-record-card zcs-property-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;&lt;div&gt;&lt;div class=&quot;audit-record-code&quot;&gt;AUD-2025-009&lt;/div&gt;&lt;div class=&quot;audit-record-title&quot;&gt;IT Access Controls Audit&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Reporting&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; 22-Aug-2025&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Lead: A. Shah&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Risk: Critical&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-progress-track&quot;&gt;&lt;div class=&quot;audit-progress-bar&quot; style=&quot;width:84%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;audit-card-actions&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;84% complete&lt;/span&gt;&lt;a class=&quot;audit-mini-link&quot; href=&quot;#Report:All_Audits&quot;&gt;Open &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { auditShown = 0; for each a in Audits[ID != 0] sort by Planned_Start desc { if(auditShown &lt; 4) { auditShown = auditShown + 1; auditTitle = ifnull(a.Audit_Title,&quot;Untitled Audit&quot;); auditCode = ifnull(a.Audit_Code,&quot;AUD-&quot; + a.ID); auditStatus = ifnull(a.Status,&quot;Active&quot;); auditStage = ifnull(a.Stage,&quot;Planning&quot;); auditRisk = ifnull(a.Risk_Rating,&quot;Medium&quot;); leadName = &quot;Unassigned&quot;; if(a.Lead_Auditor != null) { leadName = a.Lead_Auditor.Full_Name; } startText = &quot;Not scheduled&quot;; if(a.Planned_Start != null) { startText = a.Planned_Start.toString(&quot;dd-MMM-yyyy&quot;); } progressValue = ifnull(a.Progress_Percent,0); if(progressValue &gt; 100) { progressValue = 100; } if(progressValue &lt; 0) { progressValue = 0; } stageClass = &quot;zcs-badge-blue&quot;; if(auditStage == &quot;Closed&quot; || auditStatus == &quot;Completed&quot; || auditStatus == &quot;Closed&quot;) { stageClass = &quot;zcs-badge-green&quot;; } else if(auditStage == &quot;Follow-up&quot; || auditStage == &quot;Reporting&quot;) { stageClass = &quot;zcs-badge-orange&quot;; } auditUrl = &quot;#Report:All_Audits?ID=&quot; + a.ID; %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-record-card zcs-property-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;div class=&quot;audit-record-code&quot;&gt;&lt;%=auditCode%&gt;&lt;/div&gt;&lt;div class=&quot;audit-record-title&quot;&gt;&lt;%=auditTitle%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=stageClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=auditStage%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; &lt;%=startText%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Lead: &lt;%=leadName%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Risk: &lt;%=auditRisk%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-progress-track&quot;&gt;&lt;div class=&quot;audit-progress-bar&quot; style=&quot;width:&lt;%=progressValue%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-card-actions&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=progressValue%&gt;% complete&lt;/span&gt;&lt;a class=&quot;audit-mini-link&quot; href=&quot;&lt;%=auditUrl%&gt;&quot;&gt;Open &lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } } } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-head&quot;&gt;\n\t\t\t\t\t&lt;h2 class=&quot;audit-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Observations &amp; Findings&lt;/h2&gt;\n\t\t\t\t\t&lt;a class=&quot;audit-section-link&quot; href=&quot;#Report:Open_Observations&quot;&gt;Open observations&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;% if(openObservations == 0) { %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-observation-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;High&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;OBS-2025-031&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-title&quot;&gt;Vendor onboarding documentation gaps&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; Procurement Process Review&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Due 29-Aug-2025&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-observation-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Medium&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;OBS-2025-028&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-title&quot;&gt;User access recertification delayed&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; IT Access Controls Audit&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Due 05-Sep-2025&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } else { obsShown = 0; for each obs in Audit_Observations[Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Rejected&quot;] sort by Target_Closure_Date asc { if(obsShown &lt; 4) { obsShown = obsShown + 1; obsCode = ifnull(obs.Observation_ID,&quot;OBS-&quot; + obs.ID); obsTitle = ifnull(obs.Observation_Title,&quot;Untitled observation&quot;); obsSeverity = ifnull(obs.Severity,&quot;Medium&quot;); obsStatus = ifnull(obs.Status,&quot;Draft&quot;); obsAuditTitle = &quot;Unlinked audit&quot;; if(obs.Audit != null) { obsAuditTitle = obs.Audit.Audit_Title; } closureText = &quot;No due date&quot;; if(obs.Target_Closure_Date != null) { closureText = obs.Target_Closure_Date.toString(&quot;dd-MMM-yyyy&quot;); } severityClass = &quot;zcs-badge-yellow&quot;; if(obsSeverity == &quot;Critical&quot; || obsSeverity == &quot;High&quot;) { severityClass = &quot;zcs-badge-red&quot;; } else if(obsSeverity == &quot;Medium&quot;) { severityClass = &quot;zcs-badge-orange&quot;; } else if(obsSeverity == &quot;Low&quot;) { severityClass = &quot;zcs-badge-green&quot;; } obsUrl = &quot;#Report:Open_Observations?ID=&quot; + obs.ID; %&gt;\n\t\t\t\t\t\t&lt;div class=&quot;audit-observation-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-top&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=severityClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=obsSeverity%&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=obsCode%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-title&quot;&gt;&lt;a class=&quot;zcs-color-primary&quot; href=&quot;&lt;%=obsUrl%&gt;&quot;&gt;&lt;%=obsTitle%&gt;&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;audit-record-meta&quot;&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; &lt;%=obsAuditTitle%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Due &lt;%=closureText%&gt;&lt;/span&gt;&lt;span&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; &lt;%=obsStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% } } } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;audit-section audit-summary-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;audit-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-head&quot;&gt;\n\t\t\t\t\t&lt;h2 class=&quot;audit-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Follow-up Status&lt;/h2&gt;\n\t\t\t\t\t&lt;a class=&quot;audit-section-link&quot; href=&quot;#Report:Follow_Up_Schedule&quot;&gt;Schedule&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Item&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Owner&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Due&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Completion&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;5&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;% if(followUpItems == 0) { %&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;FU-2025-017&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Update vendor approval matrix&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;S. Rao&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;29-Aug-2025&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&quot;&gt;In Progress&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;55%&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;FU-2025-019&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Evidence for access review&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;A. Shah&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;02-Sep-2025&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&quot;&gt;Pending&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;20%&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;% } else { fuShown = 0; for each fu in Follow_Ups[ID != 0] sort by Due_Date asc { if(fuShown &lt; 6) { fuShown = fuShown + 1; fuCode = ifnull(fu.Follow_Up_ID,&quot;FU-&quot; + fu.ID); fuTitle = ifnull(fu.Observation_Finding,ifnull(fu.Action_Plan,&quot;Follow-up action&quot;)); ownerName = &quot;Unassigned&quot;; if(fu.Responsible_Person != null) { ownerName = fu.Responsible_Person.Full_Name; } dueText = &quot;No due date&quot;; if(fu.Due_Date != null) { dueText = fu.Due_Date.toString(&quot;dd-MMM-yyyy&quot;); } fuStatus = ifnull(fu.Status,&quot;Open&quot;); fuPct = ifnull(fu.Completion_Percent,0); statusTextClass = &quot;zcs-l_blue&quot;; if(fuStatus == &quot;Completed&quot; || fuStatus == &quot;Closed&quot;) { statusTextClass = &quot;zcs-green&quot;; } else if(fuStatus == &quot;Overdue&quot;) { statusTextClass = &quot;zcs-red&quot;; } else if(fuStatus == &quot;In Progress&quot;) { statusTextClass = &quot;zcs-yellow&quot;; } fuUrl = &quot;#Report:Follow_Up_Schedule?ID=&quot; + fu.ID; %&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;a class=&quot;zcs-color-primary&quot; href=&quot;&lt;%=fuUrl%&gt;&quot;&gt;&lt;%=fuCode%&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=fuTitle%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ownerName%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=dueText%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=statusTextClass%&gt;&quot;&gt;&lt;%=fuStatus%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=fuPct%&gt;%&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;% } } } %&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;audit-table-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;audit-section-head&quot;&gt;\n\t\t\t\t\t&lt;h2 class=&quot;audit-section-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; Test Results Summary&lt;/h2&gt;\n\t\t\t\t\t&lt;span class=&quot;audit-source-strip&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; Audit Test Executions&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper audit-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Result&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Count&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Share&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Signal&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;4&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t&lt;% passPct = 0; failPct = 0; exceptionPct = 0; notTestedPct = 0; if(testTotal &gt; 0) { passPct = (passTests * 100) / testTotal; failPct = (failTests * 100) / testTotal; exceptionPct = (exceptionTests * 100) / testTotal; notTestedPct = (notTestedTests * 100) / testTotal; } %&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&quot;&gt;Pass&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=passTests%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;audit-result-meter pass&quot;&gt;&lt;span style=&quot;width:&lt;%=passPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Effective&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&quot;&gt;Fail&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=failTests%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;audit-result-meter fail&quot;&gt;&lt;span style=&quot;width:&lt;%=failPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Exception&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&quot;&gt;Exception&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=exceptionTests%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;audit-result-meter exception&quot;&gt;&lt;span style=&quot;width:&lt;%=exceptionPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Review&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&quot;&gt;Not Tested&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=notTestedTests%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border&quot;&gt;&lt;div class=&quot;audit-result-meter pending&quot;&gt;&lt;span style=&quot;width:&lt;%=notTestedPct%&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Pending&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-mt-16 zcs-row-wrap&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;audit-subtle-note&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt; &lt;%=completedTests%&gt; completed tests&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;audit-subtle-note&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; &lt;%=pendingReviewTests%&gt; pending review&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Risk_Register_Dashboard
		{
					displayname = "Risk Register Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Risk_Register_Dashboard_Snippet' elementName='Risk_Register_Dashboard_Snippet'>\n\t\t\t\t\t<![CDATA[htmlpage Risk_Register_Dashboard_Snippet()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nallRisks = Risk_Register[ID != 0];\nallCount = allRisks.count();\nmitigateCount = Risk_Register[Risk_Treatment == &quot;Mitigate&quot;].count();\nacceptCount = Risk_Register[Risk_Treatment == &quot;Accept&quot;].count();\nescalatedCount = Risk_Register[Status == &quot;Escalated&quot; || Risk_Treatment == &quot;Escalate&quot;].count();\nhighResidualCount = Risk_Register[Residual_Risk_Rating == &quot;High&quot; || Residual_Risk_Rating == &quot;Critical&quot;].count();\n\nhighestRiskID = 0;\nhighestRiskCode = &quot;-&quot;;\nhighestRiskTitle = &quot;No risk selected&quot;;\nhighestRiskDescription = &quot;The highest residual risk card will appear after risk records are available.&quot;;\nhighestRiskOwner = &quot;Unassigned&quot;;\nhighestRiskStatus = &quot;Not Started&quot;;\nhighestRiskTreatment = &quot;Pending&quot;;\nhighestRiskRating = &quot;Not Rated&quot;;\nhighestRiskScore = 0;\nhighestRiskReview = &quot;Not scheduled&quot;;\nhighestRiskUnit = &quot;Not assigned&quot;;\nfor each topRisk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc\n{\n\t\tif(highestRiskID == 0)\n\t\t{\n\t\t\t\thighestRiskID = topRisk.ID;\n\t\t\t\thighestRiskCode = ifnull(topRisk.Risk_Code,&quot;-&quot;);\n\t\t\t\thighestRiskTitle = ifnull(topRisk.Risk_Title,&quot;Untitled risk&quot;);\n\t\t\t\thighestRiskDescription = ifnull(topRisk.Risk_Description,&quot;No description captured.&quot;);\n\t\t\t\thighestRiskOwner = ifnull(topRisk.Risk_Owner,&quot;Unassigned&quot;);\n\t\t\t\thighestRiskStatus = ifnull(topRisk.Status,&quot;Draft&quot;);\n\t\t\t\thighestRiskTreatment = ifnull(topRisk.Risk_Treatment,&quot;Pending&quot;);\n\t\t\t\thighestRiskRating = ifnull(topRisk.Residual_Risk_Rating,&quot;Not Rated&quot;);\n\t\t\t\thighestRiskScore = ifnull(topRisk.Residual_Risk_Score,0);\n\t\t\t\thighestRiskReview = ifnull(topRisk.Next_Review_Date,&quot;Not scheduled&quot;);\n\t\t\t\thighestRiskUnit = ifnull(topRisk.Business_Unit_Entity,&quot;Not assigned&quot;);\n\t\t}\n}\n\nhighPct = 0;\nif(allCount &gt; 0)\n{\n\t\thighPct = (highResidualCount * 100) / allCount;\n}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for this page. */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-page-bg-color: #F3F3F4;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-col-common{flex:1 1 0;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-25{padding:1.5625rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-box-border{box-sizing:border-box}.zcs-cursor-pointer{cursor:pointer}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-text-left{text-align:left}.zcs-text-right{text-align:right}.zcs-text-center{text-align:center}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}a{text-decoration:none;color:inherit}#splash-screen{display:none!important}\n\n/* ZCS component CSS: buttons, badges, table, progress, avatar. */\n.zcs-button{width:auto;min-width:5rem;min-height:36px;transition:background-color .18s ease,border-color .18s ease,color .18s ease}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px;font-style:normal}.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:#fff}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:#fff}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:#fff}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:#fff}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:#fff}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:#fff}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:#fff}.zcs-progress-bar{height:8px;background-color:var(--zcs_component_hover_color)}.zcs-progress-bar-indicator{height:inherit;border-radius:inherit;background-color:var(--zcs_brand_color)}.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius);color:var(--zcs_brand_foreground_color);font-weight:700}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0;z-index:2}.zcs-table-wrapper table thead tr th{background-color:#F9FAFE;box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color);vertical-align:middle}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:#F9FAFE}.zcs-table-wrapper table tbody tr.risk-row-hidden{display:none}.zcs-table-wrapper table tbody tr.risk-empty-row{display:none}.zcs-table-wrapper table tbody tr.risk-empty-row.show{display:table-row}.zcs-green{color:#179E6C}.zcs-red{color:#FE455D}.zcs-yellow{color:#b8770d}.zcs-l_blue{color:#1094C5}.zcs-blue{color:#09598E}\n\n/* Page-specific layout. */\n.risk-dashboard-shell{background:var(--zcs-page-bg-color);min-height:100vh;padding:20px;box-sizing:border-box;color:var(--zcs-primary-text-color)}\n.risk-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));color:var(--zcs_brand_foreground_color);border-radius:18px;padding:22px 24px;display:flex;justify-content:space-between;gap:18px;align-items:center;box-shadow:0 12px 34px rgba(20,20,60,.14)}\n.risk-hero-title{font-size:26px;font-weight:700;line-height:1.15;margin:0 0 6px}.risk-hero-subtitle{font-size:14px;line-height:1.45;margin:0;max-width:760px;opacity:.88}.risk-hero-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}.risk-hero .zcs-primary-button{background:#fff;color:var(--zcs_brand_color)}.risk-hero .zcs-primary-button:hover{background:rgba(255,255,255,.88)}.risk-hero .zcs-primary-outline-button{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.08);color:#fff}.risk-hero .zcs-primary-outline-button:hover{background:rgba(255,255,255,.16);color:#fff}\n.risk-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:16px}.risk-kpi{padding:18px;border-radius:16px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;transition:transform .18s ease,box-shadow .18s ease}.risk-kpi:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(20,20,60,.08)}.risk-kpi-label{font-size:13px;color:var(--zcs-secondary-text-color);margin:0 0 8px}.risk-kpi-value{font-size:30px;line-height:1;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.risk-kpi-meta{font-size:12px;margin-top:8px;color:var(--zcs-teritiary-text-color)}.risk-kpi-icon{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:20px}.risk-kpi.warning .risk-kpi-icon{background:#FCF4E6;color:#b8770d}.risk-kpi.danger .risk-kpi-icon{background:#FDE3E6;color:#FE455D}.risk-kpi.success .risk-kpi-icon{background:#E4FCF3;color:#179E6C}\n.risk-filter-card{margin-top:16px;padding:16px;border-radius:16px}.risk-filter-row{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr auto;gap:10px;align-items:end}.risk-field label{display:block;font-size:12px;font-weight:600;color:var(--zcs-secondary-text-color);margin-bottom:6px}.risk-field input,.risk-field select{width:100%;height:38px;border:1px solid var(--zcs-border-color);border-radius:9px;background:#fff;color:var(--zcs-primary-text-color);padding:0 11px;box-sizing:border-box;outline:none}.risk-field input:focus,.risk-field select:focus{border-color:var(--zcs_brand_color);box-shadow:0 0 0 3px var(--zcs_brand_light_color)}.risk-results-count{font-size:13px;color:var(--zcs-secondary-text-color);padding-bottom:9px;white-space:nowrap}.risk-report-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.risk-report-links a{font-size:13px;border:1px solid var(--zcs-border-color);border-radius:999px;padding:7px 11px;background:#fff;color:var(--zcs-secondary-text-color)}.risk-report-links a:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}\n.risk-main-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;margin-top:16px;align-items:start}.risk-section-card{padding:18px;border-radius:16px}.risk-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.risk-section-title{font-size:18px;font-weight:700;line-height:1.25;margin:0}.risk-section-note{font-size:13px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.risk-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.risk-card-grid .risk-empty-card{display:none}.risk-card-grid .risk-empty-card.show{display:block}.risk-card{border:1px solid var(--zcs-border-color);background:#fff;border-radius:14px;padding:14px;box-sizing:border-box;display:flex;flex-direction:column;gap:12px;min-height:210px}.risk-card.risk-card-hidden{display:none}.risk-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.risk-code{font-size:12px;color:var(--zcs-teritiary-text-color);font-weight:600}.risk-card-title{font-size:16px;line-height:1.25;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.risk-card-desc{font-size:13px;line-height:1.45;color:var(--zcs-secondary-text-color);margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:56px}.risk-card-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto}.risk-owner-mini{display:flex;align-items:center;gap:8px;min-width:0}.risk-owner-mini .zcs-avatar{--zcs-avatar-size:28px;--zcs-avatar-radius:50%;font-size:12px}.risk-owner-name{font-size:13px;color:var(--zcs-secondary-text-color);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.risk-rating-red .zcs-progress-bar-indicator{background:#FE455D}.risk-rating-orange .zcs-progress-bar-indicator{background:#F4660C}.risk-rating-yellow .zcs-progress-bar-indicator{background:#FAAE13}.risk-rating-green .zcs-progress-bar-indicator{background:#179E6C}.risk-rating-grey .zcs-progress-bar-indicator{background:#878895}.risk-score-text{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--zcs-secondary-text-color);margin-top:6px}\n.risk-side-stack{display:flex;flex-direction:column;gap:16px}.risk-detail-card{padding:18px;border-radius:16px}.risk-detail-header{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.risk-detail-title{font-size:18px;font-weight:700;line-height:1.25;margin:6px 0 8px}.risk-detail-desc{font-size:13px;line-height:1.45;color:var(--zcs-secondary-text-color);margin:0 0 14px}.risk-key-values{display:grid;grid-template-columns:1fr 1fr;gap:10px}.risk-kv{border:1px solid var(--zcs-border-color);border-radius:12px;padding:10px;background:#FBFCFE}.risk-kv-label{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--zcs-teritiary-text-color);margin:0 0 4px}.risk-kv-value{font-size:13px;color:var(--zcs-primary-text-color);font-weight:600;margin:0}.risk-timeline{display:flex;flex-direction:column;gap:12px;margin-top:12px}.risk-timeline-item{display:flex;gap:10px;align-items:flex-start}.risk-timeline-dot{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);font-size:13px;flex:0 0 26px}.risk-timeline-text{font-size:13px;color:var(--zcs-secondary-text-color);line-height:1.35}.risk-residual-summary{padding:16px;border-radius:16px}.risk-residual-big{font-size:30px;font-weight:700;line-height:1;color:var(--zcs-primary-text-color);margin:0}.risk-table-card{margin-top:16px;padding:18px;border-radius:16px}.risk-table-wrapper{max-height:520px}.risk-table-wrapper th,.risk-table-wrapper td{font-size:13px}.risk-table-title-cell{min-width:220px}.risk-nowrap{white-space:nowrap}.risk-no-data{text-align:center;padding:24px;color:var(--zcs-secondary-text-color);border:1px dashed var(--zcs-border-color);border-radius:14px;background:#FBFCFE}\n@media (max-width:1280px){.risk-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.risk-main-grid{grid-template-columns:1fr}.risk-side-stack{display:grid;grid-template-columns:1fr 1fr}.risk-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (max-width:860px){.risk-dashboard-shell{padding:14px}.risk-hero{align-items:flex-start;flex-direction:column}.risk-hero-actions{justify-content:flex-start}.risk-filter-row{grid-template-columns:1fr}.risk-results-count{padding-bottom:0}.risk-card-grid{grid-template-columns:1fr}.risk-side-stack{display:flex}.risk-kpi-grid{grid-template-columns:1fr}.risk-key-values{grid-template-columns:1fr}}\n&lt;/style&gt;\n\n&lt;div class=&quot;risk-dashboard-shell&quot;&gt;\n\t\t&lt;section class=&quot;risk-hero&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h1 class=&quot;risk-hero-title&quot;&gt;Risk Register Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t&lt;p class=&quot;risk-hero-subtitle&quot;&gt;Library-style risk register view with current treatment counts, residual risk concentration, searchable cards, and a tabular risk list aligned to the Risk Register reports.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;risk-hero-actions&quot;&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Risk_Register?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Add Risk&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Risks&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-2-archive-paper&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Register&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;risk-kpi-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;risk-kpi zcs-card&quot; href=&quot;#Report:All_Risks&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-label&quot;&gt;All Risks&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-value&quot;&gt;&lt;%=allCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-meta&quot;&gt;Complete risk library population&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;risk-kpi warning zcs-card&quot; href=&quot;#Report:All_Risks?Risk_Treatment=Mitigate&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-label&quot;&gt;Mitigate&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-value&quot;&gt;&lt;%=mitigateCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-meta&quot;&gt;Treatment plans requiring tracking&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-63&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;risk-kpi success zcs-card&quot; href=&quot;#Report:All_Risks?Risk_Treatment=Accept&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-label&quot;&gt;Accept&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-value&quot;&gt;&lt;%=acceptCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-meta&quot;&gt;Accepted within defined appetite&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;risk-kpi danger zcs-card&quot; href=&quot;#Report:High_Residual_Risks&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-label&quot;&gt;Escalated&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-value&quot;&gt;&lt;%=escalatedCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-meta&quot;&gt;Escalations and critical attention&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle-i&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;risk-filter-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;risk-filter-row&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-field&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;label for=&quot;riskSearch&quot;&gt;Search risk library&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input id=&quot;riskSearch&quot; type=&quot;search&quot; placeholder=&quot;Search code, title, description, owner, or unit&quot;&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-field&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;label for=&quot;deptFilter&quot;&gt;Department&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select id=&quot;deptFilter&quot;&gt;&lt;option value=&quot;&quot;&gt;All departments&lt;/option&gt;&lt;/select&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-field&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;label for=&quot;typeFilter&quot;&gt;Type&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select id=&quot;typeFilter&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;&quot;&gt;All types&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Financial&quot;&gt;Financial&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Operational&quot;&gt;Operational&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Compliance&quot;&gt;Compliance&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;IT&quot;&gt;IT&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Regulatory&quot;&gt;Regulatory&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Strategic&quot;&gt;Strategic&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Security&quot;&gt;Security&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Privacy&quot;&gt;Privacy&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Third Party&quot;&gt;Third Party&lt;/option&gt;\n\t\t\t\t\t\t\t\t&lt;/select&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-field&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;label for=&quot;statusFilter&quot;&gt;Status&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select id=&quot;statusFilter&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;&quot;&gt;All statuses&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Draft&quot;&gt;Draft&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Under Review&quot;&gt;Under Review&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Approved&quot;&gt;Approved&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Accepted&quot;&gt;Accepted&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Escalated&quot;&gt;Escalated&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;option value=&quot;Closed&quot;&gt;Closed&lt;/option&gt;\n\t\t\t\t\t\t\t\t&lt;/select&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-results-count&quot;&gt;&lt;span id=&quot;riskVisibleCount&quot;&gt;&lt;%=allCount%&gt;&lt;/span&gt; of &lt;%=allCount%&gt; visible&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;risk-report-links&quot;&gt;\n\t\t\t\t\t\t&lt;a href=&quot;#Report:All_Risks&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-archive-paper&quot;&gt;&lt;/i&gt; All Risks&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&quot;#Report:Risk_Library_Cards&quot;&gt;&lt;i class=&quot;zc-li-outline design-image&quot;&gt;&lt;/i&gt; Risk Library Cards&lt;/a&gt;\n\t\t\t\t\t\t&lt;a href=&quot;#Report:High_Residual_Risks&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle-i&quot;&gt;&lt;/i&gt; High Residual Risks&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;risk-main-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;risk-section-card zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-section-head&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;risk-section-title&quot;&gt;Risk Library Cards&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-section-note&quot;&gt;Category badge, title, description, owner, and residual visual from Risk_Register.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=highResidualCount%&gt; high residual&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-card-grid&quot; id=&quot;riskCardGrid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tif(allCount == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-no-data&quot;&gt;No risk records are available yet. Use Add Risk to create the first register entry.&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tfor each risk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\triskCode = ifnull(risk.Risk_Code,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\triskTitle = ifnull(risk.Risk_Title,&quot;Untitled risk&quot;);\n\t\t\t\t\t\t\t\t\t\triskDesc = ifnull(risk.Risk_Description,&quot;No description captured.&quot;);\n\t\t\t\t\t\t\t\t\t\triskDept = ifnull(risk.Business_Unit_Entity,&quot;Not assigned&quot;);\n\t\t\t\t\t\t\t\t\t\triskCategory = ifnull(risk.Risk_Category,&quot;Unclassified&quot;);\n\t\t\t\t\t\t\t\t\t\triskStatus = ifnull(risk.Status,&quot;Draft&quot;);\n\t\t\t\t\t\t\t\t\t\triskOwner = ifnull(risk.Risk_Owner,&quot;Unassigned&quot;);\n\t\t\t\t\t\t\t\t\t\tresidualRating = ifnull(risk.Residual_Risk_Rating,&quot;Not Rated&quot;);\n\t\t\t\t\t\t\t\t\t\tresidualScore = ifnull(risk.Residual_Risk_Score,0);\n\t\t\t\t\t\t\t\t\t\tresidualPct = residualScore * 4;\n\t\t\t\t\t\t\t\t\t\tif(residualPct &gt; 100)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tresidualPct = 100;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tif(residualPct &lt; 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tresidualPct = 0;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\tratingClass = &quot;risk-rating-grey&quot;;\n\t\t\t\t\t\t\t\t\t\tif(residualRating == &quot;Critical&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tratingClass = &quot;risk-rating-red&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(residualRating == &quot;High&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tratingClass = &quot;risk-rating-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(residualRating == &quot;Medium&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tratingClass = &quot;risk-rating-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if(residualRating == &quot;Low&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tratingClass = &quot;risk-rating-green&quot;;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\townerInitial = &quot;?&quot;;\n\t\t\t\t\t\t\t\t\t\tif(riskOwner != null &amp;&amp; riskOwner != &quot;&quot;)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\townerInitial = riskOwner.subString(0,1).toUpperCase();\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;article class=&quot;risk-card&quot; data-search=&quot;&lt;%=riskCode%&gt; &lt;%=riskTitle%&gt; &lt;%=riskDesc%&gt; &lt;%=riskOwner%&gt; &lt;%=riskDept%&gt;&quot; data-dept=&quot;&lt;%=riskDept%&gt;&quot; data-type=&quot;&lt;%=riskCategory%&gt;&quot; data-status=&quot;&lt;%=riskStatus%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-card-top&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=riskCategory%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;risk-code&quot;&gt;&lt;%=riskCode%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;risk-card-title&quot;&gt;&lt;%=riskTitle%&gt;&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-card-desc&quot;&gt;&lt;%=riskDesc%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 &lt;%=ratingClass%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=residualPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-score-text&quot;&gt;&lt;span&gt;Residual &lt;%=residualScore%&gt;&lt;/span&gt;&lt;strong&gt;&lt;%=residualRating%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-card-footer&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-owner-mini&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&quot;&gt;&lt;%=ownerInitial%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;risk-owner-name&quot;&gt;&lt;%=riskOwner%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=badgeClass%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=residualRating%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-empty-card risk-no-data&quot; id=&quot;riskEmptyCards&quot;&gt;No risk cards match the current search and filters.&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;aside class=&quot;risk-side-stack&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;risk-detail-card zcs-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-detail-header&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;risk-code&quot;&gt;&lt;%=highestRiskCode%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;risk-detail-title&quot;&gt;&lt;%=highestRiskTitle%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=highestRiskRating%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-detail-desc&quot;&gt;&lt;%=highestRiskDescription%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-key-values&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kv&quot;&gt;&lt;p class=&quot;risk-kv-label&quot;&gt;Owner&lt;/p&gt;&lt;p class=&quot;risk-kv-value&quot;&gt;&lt;%=highestRiskOwner%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kv&quot;&gt;&lt;p class=&quot;risk-kv-label&quot;&gt;Business Unit&lt;/p&gt;&lt;p class=&quot;risk-kv-value&quot;&gt;&lt;%=highestRiskUnit%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kv&quot;&gt;&lt;p class=&quot;risk-kv-label&quot;&gt;Treatment&lt;/p&gt;&lt;p class=&quot;risk-kv-value&quot;&gt;&lt;%=highestRiskTreatment%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-kv&quot;&gt;&lt;p class=&quot;risk-kv-label&quot;&gt;Status&lt;/p&gt;&lt;p class=&quot;risk-kv-value&quot;&gt;&lt;%=highestRiskStatus%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-timeline&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-timeline-item&quot;&gt;&lt;div class=&quot;risk-timeline-dot&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;risk-timeline-text&quot;&gt;&lt;strong&gt;Assignment&lt;/strong&gt;&lt;br&gt;Owner validates response plan and confirms coordinators.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-timeline-item&quot;&gt;&lt;div class=&quot;risk-timeline-dot&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;risk-timeline-text&quot;&gt;&lt;strong&gt;Next review&lt;/strong&gt;&lt;br&gt;&lt;%=highestRiskReview%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-timeline-item&quot;&gt;&lt;div class=&quot;risk-timeline-dot&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;risk-timeline-text&quot;&gt;&lt;strong&gt;Residual target&lt;/strong&gt;&lt;br&gt;Track mitigation milestones and evidence placeholders.&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;risk-residual-summary zcs-card&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-kpi-label&quot;&gt;Residual Risk Concentration&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-residual-big&quot;&gt;&lt;%=highPct%&gt;%&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6 risk-rating-red zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=highPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0&quot;&gt;&lt;strong class=&quot;zcs-color-theme&quot;&gt;&lt;%=highResidualCount%&gt;&lt;/strong&gt; high or critical of &lt;%=allCount%&gt; total risks&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;risk-report-links zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&quot;#Report:High_Residual_Risks&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt; Review high residual report&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/aside&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;risk-table-card zcs-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;risk-section-head&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;risk-section-title&quot;&gt;Risk Register List&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;risk-section-note&quot;&gt;Risk_Code, title, business unit, inherent risk, control effectiveness, residual risk, owner, and status.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Risks&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Full Report&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper risk-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Risk Code&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Title&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Business Unit&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Inherent&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Control Effectiveness&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Residual&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Risk Owner&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody id=&quot;riskTableBody&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\tfor each rowRisk in Risk_Register[ID != 0] sort by Residual_Risk_Score desc\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\trowCode = ifnull(rowRisk.Risk_Code,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowTitle = ifnull(rowRisk.Risk_Title,&quot;Untitled risk&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowDesc = ifnull(rowRisk.Risk_Description,&quot;&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowDept = ifnull(rowRisk.Business_Unit_Entity,&quot;Not assigned&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowCategory = ifnull(rowRisk.Risk_Category,&quot;Unclassified&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowStatus = ifnull(rowRisk.Status,&quot;Draft&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowOwner = ifnull(rowRisk.Risk_Owner,&quot;Unassigned&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowInherent = ifnull(rowRisk.Inherent_Risk_Score,0);\n\t\t\t\t\t\t\t\t\t\t\t\trowControl = ifnull(rowRisk.Control_Effectiveness,&quot;Not Tested&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\trowResidual = ifnull(rowRisk.Residual_Risk_Score,0);\n\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(rowStatus == &quot;Approved&quot; || rowStatus == &quot;Accepted&quot; || rowStatus == &quot;Closed&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(rowStatus == &quot;Escalated&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(rowStatus == &quot;Under Review&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(rowStatus == &quot;Draft&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tcontrolColor = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(rowControl == &quot;Effective&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tcontrolColor = &quot;zcs-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(rowControl == &quot;Ineffective&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tcontrolColor = &quot;zcs-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\telse if(rowControl == &quot;Partial&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tcontrolColor = &quot;zcs-l_blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;risk-row&quot; data-search=&quot;&lt;%=rowCode%&gt; &lt;%=rowTitle%&gt; &lt;%=rowDesc%&gt; &lt;%=rowOwner%&gt; &lt;%=rowDept%&gt;&quot; data-dept=&quot;&lt;%=rowDept%&gt;&quot; data-type=&quot;&lt;%=rowCategory%&gt;&quot; data-status=&quot;&lt;%=rowStatus%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap&quot;&gt;&lt;%=rowCode%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-table-title-cell&quot;&gt;&lt;%=rowTitle%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap&quot;&gt;&lt;%=rowDept%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=rowInherent%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=controlColor%&gt;&quot;&gt;&lt;%=rowControl%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=rowResidual%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary risk-nowrap&quot;&gt;&lt;%=rowOwner%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=rowStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;risk-empty-row&quot; id=&quot;riskEmptyRows&quot;&gt;&lt;td colspan=&quot;8&quot; class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;No list rows match the current search and filters.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Add_Update_User1 as "Add / Update User"
			{
			    type =  form
			    form = Add_Users
			
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                info thisapp.permissions.assignUserInProfile(input.User_Email,input.Profile);
			                info input.User_Email;
			                info input.Profile;
			            )
			        }
			    }
			
			}

			Delete_Users as "Delete Users"
			{
			    type =  form
			    form = Add_Users
			
			    record event = on delete
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                thisapp.permissions.deleteUser(input.User_Email);
			                info "deleted:" + input.User_Email;
			            )
			        }
			    }
			
			}

			Disable_email as "Disable email"
			{
			    type =  form
			    form = Add_Users
			
			    record event = on edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                disable User_Email;
			                existingProfile = input.Profile;
			                clear Profile;
			                userProfiles = thisapp.permissions.PROFILES().toList();
			                index = 0;
			                for each  elemnt in userProfiles
			                {
			                    if(elemnt == "Administrator")
			                    {
			                        userProfiles.remove(index);
			                    }
			                    index = index + 1;
			                }
			                input.Profile:ui.append(userProfiles);
			                input.Profile = existingProfile;
			            )
			        }
			    }
			
			}

			Populate_profiles_on_load as "Populate profiles on load"
			{
			    type =  form
			    form = Add_Users
			
			    record event = on add
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                clear Profile;
			                userProfiles = thisapp.permissions.PROFILES().toList();
			                index = 0;
			                for each  elemnt in userProfiles
			                {
			                    if(elemnt == "Administrator")
			                    {
			                        userProfiles.remove(index);
			                    }
			                    index = index + 1;
			                }
			                input.Profile:ui.append(userProfiles);
			            )
			        }
			    }
			
			}

			Audit_Observations_On_Success as "Audit Observations On Success"
			{
			    type = form
			    form = Audit_Observations
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Accepted" && input.Accepted_Date == null)
			                {
			                    input.Accepted_Date = zoho.currentdate;
			                }
			                if(input.Status == "Closed" && input.Closed_Date == null)
			                {
			                    input.Closed_Date = zoho.currentdate;
			                }
			                if(input.Status == "Accepted" && input.Action_Plan_Required == true)
			                {
			                    input.Version_Notes = ifnull(input.Version_Notes,"") + "\nRemediation task required after observation acceptance.";
			                }
			            )
			        }
			    }
			}

			Audit_Observations_On_Validate as "Audit Observations On Validate"
			{
			    type = form
			    form = Audit_Observations
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                template_requires_root = false;
			                template_requires_impact = false;
			                template_requires_recommendations = false;
			                template_requires_evidence = false;
			                if(input.Observation_Template != null)
			                {
			                    obs_template = Observation_Form_Templates[ID == input.Observation_Template];
			                    if(obs_template.count() > 0)
			                    {
			                        template_requires_root = obs_template.Require_Root_Cause_Analysis;
			                        template_requires_impact = obs_template.Impact_Assessment_Required;
			                        template_requires_recommendations = obs_template.Recommendations_Required;
			                        template_requires_evidence = obs_template.Require_Supporting_Evidence_Upload;
			                    }
			                }
			                severe_observation = input.Severity in {"High", "Critical"};
			                if((template_requires_root == true || severe_observation) && ifnull(input.Root_Cause_Analysis,"") == "")
			                {
			                    alert "Root cause analysis is required for this observation.";
			                    cancel submit;
			                }
			                if((template_requires_impact == true || severe_observation) && ifnull(input.Impact_Assessment,"") == "")
			                {
			                    alert "Impact assessment is required for this observation.";
			                    cancel submit;
			                }
			                if((template_requires_recommendations == true || severe_observation) && ifnull(input.Recommendations,"") == "")
			                {
			                    alert "Recommendations are required for this observation.";
			                    cancel submit;
			                }
			                if((template_requires_evidence == true || severe_observation) && input.Evidence_Upload == null)
			                {
			                    alert "Evidence upload is required for this observation.";
			                    cancel submit;
			                }
			                if(input.Action_Plan_Required == true && input.Target_Closure_Date == null)
			                {
			                    alert "Target closure date is required when an action plan is required.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Plan_Entities_On_Success as "Audit Plan Entities On Success"
			{
			    type = form
			    form = Audit_Plan_Entities
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                plan_records = Audit_Plans[ID == input.Plan];
			                if(plan_records.count() > 0)
			                {
			                    selected_count = Audit_Plan_Entities[Plan == input.Plan].count();
			                    total_days = Audit_Plan_Entities[Plan == input.Plan].sum(Estimated_Days);
			                    avg_score = Audit_Plan_Entities[Plan == input.Plan].avg(Entity_Score);
			                    q1_days = Audit_Plan_Entities[Plan == input.Plan && Planning_Quarter == "Q1"].sum(Estimated_Days);
			                    if(total_days == null)
			                    {
			                        total_days = 0;
			                    }
			                    if(avg_score == null)
			                    {
			                        avg_score = 0;
			                    }
			                    if(q1_days == null)
			                    {
			                        q1_days = 0;
			                    }
			                    plan_records.Selected_Entities_Count = selected_count;
			                    plan_records.Total_Audit_Days = total_days;
			                    plan_records.Average_Risk_Score = avg_score;
			                    if(total_days >= 120)
			                    {
			                        plan_records.Plan_Size = "Extensive";
			                    }
			                    else if(total_days >= 75)
			                    {
			                        plan_records.Plan_Size = "Large";
			                    }
			                    else if(total_days >= 35)
			                    {
			                        plan_records.Plan_Size = "Medium";
			                    }
			                    else
			                    {
			                        plan_records.Plan_Size = "Small";
			                    }
			                    if(selected_count > 0)
			                    {
			                        plan_records.Planned_Coverage_Percent = (selected_count * 100) / Audit_Universe[ID != 0].count();
			                    }
			                    else
			                    {
			                        plan_records.Planned_Coverage_Percent = 0;
			                    }
			                    if(total_days > 0)
			                    {
			                        plan_records.Q1_Intensity_Percent = (q1_days * 100) / total_days;
			                    }
			                    else
			                    {
			                        plan_records.Q1_Intensity_Percent = 0;
			                    }
			                }
			            )
			        }
			    }
			}

			Audit_Plan_Entities_On_Validate as "Audit Plan Entities On Validate"
			{
			    type = form
			    form = Audit_Plan_Entities
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                duplicate_entities = Audit_Plan_Entities[Plan == input.Plan && Auditable_Entity == input.Auditable_Entity && ID != input.ID];
			                if(duplicate_entities.count() > 0)
			                {
			                    alert "This auditable entity is already included in the selected audit plan.";
			                    cancel submit;
			                }
			                if(ifnull(input.Residual_Risk,0) < 0 || ifnull(input.Residual_Risk,0) > 5)
			                {
			                    alert "Residual risk must be between 0 and 5.";
			                    cancel submit;
			                }
			                score = ifnull(input.Residual_Risk,0) * 20;
			                if(input.Process_Complexity != null)
			                {
			                    score = score + input.Process_Complexity.getPrefix("-").toNumber() * 5;
			                }
			                if(input.Automation_Level != null)
			                {
			                    score = score + (6 - input.Automation_Level.getPrefix("-").toNumber()) * 3;
			                }
			                if(input.Regulatory_Sensitivity != null)
			                {
			                    score = score + input.Regulatory_Sensitivity.getPrefix("-").toNumber() * 4;
			                }
			                if(input.Past_Issues != null)
			                {
			                    score = score + input.Past_Issues.getPrefix("-").toNumber() * 4;
			                }
			                if(input.Entity_Score == null || input.Entity_Score == 0)
			                {
			                    input.Entity_Score = score.round(0);
			                }
			                if(input.Priority == null || input.Priority == "")
			                {
			                    if(input.Entity_Score >= 120)
			                    {
			                        input.Priority = "Critical";
			                    }
			                    else if(input.Entity_Score >= 90)
			                    {
			                        input.Priority = "High";
			                    }
			                    else if(input.Entity_Score >= 60)
			                    {
			                        input.Priority = "Medium";
			                    }
			                    else
			                    {
			                        input.Priority = "Low";
			                    }
			                }
			                complexity_points = 0;
			                if(input.Process_Complexity != null)
			                {
			                    complexity_points = complexity_points + input.Process_Complexity.getPrefix("-").toNumber();
			                }
			                if(input.Regulatory_Sensitivity != null)
			                {
			                    complexity_points = complexity_points + input.Regulatory_Sensitivity.getPrefix("-").toNumber();
			                }
			                if(input.Past_Issues != null)
			                {
			                    complexity_points = complexity_points + input.Past_Issues.getPrefix("-").toNumber();
			                }
			                if(input.Entity_Score >= 130 || complexity_points >= 13)
			                {
			                    input.Audit_Size = "Extensive";
			                    input.Estimated_Days = ifnull(input.Estimated_Days,25);
			                }
			                else if(input.Entity_Score >= 95 || complexity_points >= 10)
			                {
			                    input.Audit_Size = "Large";
			                    input.Estimated_Days = ifnull(input.Estimated_Days,18);
			                }
			                else if(input.Entity_Score >= 60 || complexity_points >= 7)
			                {
			                    input.Audit_Size = "Medium";
			                    input.Estimated_Days = ifnull(input.Estimated_Days,10);
			                }
			                else
			                {
			                    input.Audit_Size = "Small";
			                    input.Estimated_Days = ifnull(input.Estimated_Days,5);
			                }
			            )
			        }
			    }
			}

			Audit_Plans_On_Success as "Audit Plans On Success"
			{
			    type = form
			    form = Audit_Plans
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Submitted" && input.Submitted_Date == null)
			                {
			                    input.Submitted_Date = zoho.currentdate;
			                }
			                if(input.Status == "Approved" && input.Approved_Date == null)
			                {
			                    input.Approved_Date = zoho.currentdate;
			                }
			            )
			        }
			    }
			}

			Audit_Plans_On_Validate as "Audit Plans On Validate"
			{
			    type = form
			    form = Audit_Plans
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Status == "Submitted" && ifnull(input.Selected_Entities_Count,0) <= 0)
			                {
			                    alert "At least one auditable entity must be selected before submitting the plan.";
			                    cancel submit;
			                }
			                if(input.Status == "Submitted" && input.Submitted_Date == null)
			                {
			                    input.Submitted_Date = zoho.currentdate;
			                }
			                if(input.Status == "Approved" && input.Approved_By == null)
			                {
			                    alert "Approved by is required before approving the plan.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Team_Members_On_Validate as "Audit Team Members On Validate"
			{
			    type = form
			    form = Audit_Team_Members
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Capacity_Days_Per_Year,0) <= 0)
			                {
			                    alert "Capacity days per year must be greater than zero.";
			                    cancel submit;
			                }
			                if(ifnull(input.Utilization_Target_Percent,0) < 0 || ifnull(input.Utilization_Target_Percent,0) > 100)
			                {
			                    alert "Utilization target percent must be between 0 and 100.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audit_Test_Executions_On_Load as "Audit Test Executions On Load"
			{
			    type = form
			    form = Audit_Test_Executions
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Test_Result in {"Fail", "Exception"})
			                {
			                    show Exception_Details;
			                    enable Exception_Details;
			                    show Follow_Up_Required;
			                    enable Follow_Up_Required;
			                }
			                else
			                {
			                    hide Exception_Details;
			                    disable Exception_Details;
			                    hide Follow_Up_Required;
			                    disable Follow_Up_Required;
			                }
			            )
			        }
			    }
			}

			Audit_Test_Executions_On_Success as "Audit Test Executions On Success"
			{
			    type = form
			    form = Audit_Test_Executions
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Test_Result in {"Fail", "Exception"})
			                {
			                    input.Follow_Up_Required = true;
			                    input.Test_Status = "Exception";
			                }
			                else if(input.Test_Result in {"Pass", "Not Applicable"})
			                {
			                    input.Test_Status = "Completed";
			                }
			            )
			        }
			    }
			}

			Audit_Test_Executions_On_Validate as "Audit Test Executions On Validate"
			{
			    type = form
			    form = Audit_Test_Executions
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Test_Result in {"Pass", "Fail", "Exception"} && input.Evidence_File == null)
			                {
			                    alert "Evidence file is required for Pass, Fail, or Exception results.";
			                    cancel submit;
			                }
			                if(input.Test_Result in {"Fail", "Exception"} && ifnull(input.Exception_Details,"") == "")
			                {
			                    alert "Exception details are required for Fail or Exception results.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Test_Result_On_User_Input as "Test Result On User Input"
			{
			    type = form
			    form = Audit_Test_Executions
			    record event = on add or edit
			
			    on user input of Test_Result
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Test_Result in {"Fail", "Exception"})
			                {
			                    show Exception_Details;
			                    enable Exception_Details;
			                    show Follow_Up_Required;
			                    enable Follow_Up_Required;
			                    input.Follow_Up_Required = true;
			                }
			                else
			                {
			                    hide Exception_Details;
			                    disable Exception_Details;
			                    hide Follow_Up_Required;
			                    disable Follow_Up_Required;
			                    input.Follow_Up_Required = false;
			                }
			            )
			        }
			    }
			}

			Audit_Universe_On_Success as "Audit Universe On Success"
			{
			    type = form
			    form = Audit_Universe
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                residual = ifnull(input.Inherent_Risk_Score,0) - (ifnull(input.Control_Effectiveness_Score,0) / 2.0);
			                if(residual < 1)
			                {
			                    residual = 1;
			                }
			                input.Residual_Risk_Score = residual.round(1);
			                if(input.Residual_Risk_Score <= 2)
			                {
			                    input.Risk_Level = "Low";
			                    input.Audit_Frequency = "Every 3 Years";
			                }
			                else if(input.Residual_Risk_Score <= 3)
			                {
			                    input.Risk_Level = "Medium";
			                    input.Audit_Frequency = "Every 2 Years";
			                }
			                else if(input.Residual_Risk_Score <= 4)
			                {
			                    input.Risk_Level = "High";
			                    input.Audit_Frequency = "Annual";
			                }
			                else
			                {
			                    input.Risk_Level = "Critical";
			                    input.Audit_Frequency = "Annual";
			                }
			            )
			        }
			    }
			}

			Audit_Universe_On_Validate as "Audit Universe On Validate"
			{
			    type = form
			    form = Audit_Universe
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(ifnull(input.Inherent_Risk_Score,0) < 1 || ifnull(input.Inherent_Risk_Score,0) > 5)
			                {
			                    alert "Inherent risk score must be between 1 and 5.";
			                    cancel submit;
			                }
			                if(ifnull(input.Control_Effectiveness_Score,0) < 1 || ifnull(input.Control_Effectiveness_Score,0) > 5)
			                {
			                    alert "Control effectiveness score must be between 1 and 5.";
			                    cancel submit;
			                }
			                if(ifnull(input.Effort_Days,0) < 0)
			                {
			                    alert "Effort days cannot be negative.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Audits_On_Success as "Audits On Success"
			{
			    type = form
			    form = Audits
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Stage == "Execution" && input.Actual_Start == null)
			                {
			                    input.Actual_Start = zoho.currentdate;
			                }
			                if(input.Stage == "Closed" && input.Actual_End == null)
			                {
			                    input.Actual_End = zoho.currentdate;
			                    input.Progress_Percent = 100;
			                    input.Status = "Closed";
			                }
			                if(input.Stage == "Reporting" && ifnull(input.Progress_Percent,0) < 70)
			                {
			                    input.Progress_Percent = 70;
			                }
			                if(input.Stage == "Follow-up" && ifnull(input.Progress_Percent,0) < 90)
			                {
			                    input.Progress_Percent = 90;
			                }
			            )
			        }
			    }
			}

			Audits_On_Validate as "Audits On Validate"
			{
			    type = form
			    form = Audits
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Planned_Start != null && input.Planned_End != null && input.Planned_End < input.Planned_Start)
			                {
			                    alert "Planned end date must be on or after planned start date.";
			                    cancel submit;
			                }
			                if(ifnull(input.Audit_Team_Size,0) <= 0)
			                {
			                    alert "Audit team size must be greater than zero.";
			                    cancel submit;
			                }
			                if(ifnull(input.Progress_Percent,0) < 0 || ifnull(input.Progress_Percent,0) > 100)
			                {
			                    alert "Progress percent must be between 0 and 100.";
