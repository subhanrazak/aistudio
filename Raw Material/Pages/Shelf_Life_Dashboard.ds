<page linkname = "Shelf_Life_Dashboard" displayname = "Shelf-Life Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Shelf_Life_Dashboard_Header' elementName='Shelf_Life_Dashboard_Header'>
          <![CDATA[htmlpage Shelf_Life_Dashboard_Header()
            content
            <%{%>
                <file name:Shelf_Life_Dashboard_Header.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='65%'>
        <dsp id='Traffic_Light_KPIs' elementName='Traffic_Light_KPIs'>
          <![CDATA[htmlpage Traffic_Light_KPIs()
            content
            <%{%>
                <file name:Traffic_Light_KPIs.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
      <column width='35%'>
        <dsp id='Risk_Summary' elementName='Risk_Summary'>
          <![CDATA[htmlpage Risk_Summary()
            content
            <%{%>
                <file name:Risk_Summary.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='55%'>
        <file name:Expiry_Timeline_Chart.ds/>
      </column>
      <column width='45%'>
        <file name:FEFO_Compliance_Gauge.ds/>
      </column>
    </row>
    <row>
      <column width='40%'>
        <dsp id='topAtRiskSnippet' elementName='Top_At_Risk'>
          <![CDATA[htmlpage topAtRiskSnippet()
             content
             <%{%>
                 <file name:Top_At_Risk.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
      <column width='60%'>
        <file name:Disposition_Tracker_Report.ds/>
      </column>
    </row>
    <row>
      <column width='50%'>
        <file name:Status_Distribution_Chart.ds/>
      </column>
      <column width='50%'>
        <dsp id='varByGroupSnippet' elementName='VAR_By_Group'>
          <![CDATA[htmlpage varByGroupSnippet()
             content
             <%{%>
                 <file name:VAR_By_Group.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Top_5_Urgent_Report.ds/>
      </column>
    </row>
    <row>
      <column width='100%'>
        <file name:Monthly_Writeoff_Trend.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
