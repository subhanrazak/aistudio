<gauge elementName='FEFO_Compliance_Gauge'
       title='FEFO Compliance %'
       titleColor='#222326'
       boldTitle='true'
       type='3'
       displayType='Percentage against a number'
       value='thisapp.FEFO_Log.ID.count'
       compareTo='100'
       color='#1b5e20'
       size='24px'
       bgColor='#FFFFFF'
       theme='theme1'
       criteria='Was_Oldest_Batch == true'>
  <target size='14px' color='#1b5e20' fontFamily='default' value='95' />
  <ranges>
    <range color='#e53935' width='60' />
    <range color='#f57c00' width='20' />
    <range color='#388e3c' width='20' />
  </ranges>
  <maximumvalue size='14px' color='#555555' value='100' />
</gauge>
