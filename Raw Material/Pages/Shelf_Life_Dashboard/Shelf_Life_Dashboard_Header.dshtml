<style>
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; }
.zcs-flex { display: flex; }
.zcs-align-items-center { align-items: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-direction-column { flex-direction: column; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-m-0 { margin: 0; }
.zcs-font-bold { font-weight: 700; }

/* Header component styles */
.slm-header {
  background: linear-gradient(135deg, #1a237e 0%, #283593 100%);
  padding: 20px 28px;
  box-sizing: border-box;
  width: 100%;
}
.slm-header-title {
  font-size: 22px;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 4px 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.slm-header-subtitle {
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  margin: 0;
}
.slm-header-icon {
  font-size: 22px;
  color: #ffffff;
}
.slm-date-badge {
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 8px;
  padding: 8px 16px;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 6px;
}
</style>
<div class="slm-header zcs-flex zcs-align-items-center zcs-justify-space-between">
  <div class="zcs-flex zcs-direction-column zcs-gap-4">
    <h1 class="slm-header-title">
      <i class="slm-header-icon zc-li-outline science-chemistry-flask-01"></i>
      Raw Material Shelf-Life Monitor
    </h1>
    <p class="slm-header-subtitle">Real-time expiry tracking, FEFO compliance, and disposition management</p>
  </div>
  <div class="slm-date-badge">
    <i class="zc-li-outline ui-1-calendar-grid-58" style="font-size:14px;"></i>
    <%=zoho.currentdate.toString("dd MMM yyyy")%>
  </div>
</div>
