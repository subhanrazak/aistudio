<style>
.slm-kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
  padding: 12px;
  box-sizing: border-box;
  width: 100%;
}
.slm-kpi-card {
  border-radius: 12px;
  padding: 20px 16px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 6px;
}
.slm-kpi-card-red {
  background: linear-gradient(135deg, #c62828 0%, #e53935 100%);
}
.slm-kpi-card-amber {
  background: linear-gradient(135deg, #e65100 0%, #f57c00 100%);
}
.slm-kpi-card-green {
  background: linear-gradient(135deg, #1b5e20 0%, #388e3c 100%);
}
.slm-kpi-icon {
  font-size: 28px;
  color: rgba(255,255,255,0.85);
  margin-bottom: 4px;
}
.slm-kpi-count {
  font-size: 52px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  margin: 0;
}
.slm-kpi-label {
  font-size: 14px;
  font-weight: 700;
  color: rgba(255,255,255,0.95);
  margin: 4px 0 0 0;
}
.slm-kpi-sub {
  font-size: 11px;
  color: rgba(255,255,255,0.7);
  margin: 0;
}
</style>
<div class="slm-kpi-grid">
  <div class="slm-kpi-card slm-kpi-card-red">
    <i class="slm-kpi-icon zc-li-solid ui-1-simple-remove"></i>
    <p class="slm-kpi-count"><%=Batch_Monitor[Status_Color == "Red"].count()%></p>
    <p class="slm-kpi-label">Expired Batches</p>
    <p class="slm-kpi-sub">Immediate Action Required</p>
  </div>
  <div class="slm-kpi-card slm-kpi-card-amber">
    <i class="slm-kpi-icon zc-li-solid ui-2-time"></i>
    <p class="slm-kpi-count"><%=Batch_Monitor[Status_Color == "Amber"].count()%></p>
    <p class="slm-kpi-label">Warning Zone</p>
    <p class="slm-kpi-sub">Approaching Expiry</p>
  </div>
  <div class="slm-kpi-card slm-kpi-card-green">
    <i class="slm-kpi-icon zc-li-solid ui-1-check-circle-08"></i>
    <p class="slm-kpi-count"><%=Batch_Monitor[Status_Color == "Green"].count()%></p>
    <p class="slm-kpi-label">Safe Batches</p>
    <p class="slm-kpi-sub">Within Shelf Life</p>
  </div>
</div>
