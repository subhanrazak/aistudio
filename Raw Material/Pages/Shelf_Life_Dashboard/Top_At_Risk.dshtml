<style>
.tar-card { background: #fff; border-radius: 10px; padding: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow: hidden; }
.tar-header { background: #fff; padding: 14px 16px; display: flex; align-items: center; border-bottom: 1px solid #f0f0f0; }
.tar-icon { width: 32px; height: 32px; border-radius: 16px; background: #fdecea; display: flex; align-items: center; justify-content: center; margin-right: 10px; flex-shrink: 0; font-size: 14px; color: #c62828; font-weight: 700; }
.tar-title { font-size: 15px; font-weight: 700; color: #1a1a2e; }
.tar-row { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid #f5f5f5; }
.tar-row:last-child { border-bottom: none; }
.tar-rank { width: 32px; font-size: 17px; font-weight: 800; color: #c62828; flex-shrink: 0; }
.tar-name { flex: 1; font-size: 13px; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tar-count { font-size: 18px; font-weight: 800; color: #e53935; min-width: 40px; text-align: right; }
.tar-empty { padding: 20px 16px; color: #999; font-size: 13px; text-align: center; }
</style>
<div class="tar-card">
  <div class="tar-header">
    <div class="tar-icon">!</div>
    <div class="tar-title">Top 10 Materials at Risk (Red/Amber Batches)</div>
  </div>
  <div>
<%
  // Aggregate Red+Amber batch count per material
  riskBatches = Batch_Monitor[Status_Color == "Red" || Status_Color == "Amber"];
  allMaterials = Materials[ID != 0];
  matCountList = list();
  for each mat in allMaterials
  {
    cnt = Batch_Monitor[Status_Color == "Red" || Status_Color == "Amber"].count();
    matBatches = Batch_Monitor[Status_Color == "Red" || Status_Color == "Amber" && Material == mat.ID];
    batchCnt = matBatches.count();
    if(batchCnt > 0)
    {
      padded = "00000" + batchCnt;
      padded = padded.subString(padded.length() - 6);
      matCountList.add(padded + "||" + mat.Material_Number + " - " + mat.Material_Description);
    }
  }
  matCountList = matCountList.sort(false);
  rank = 1;
  if(matCountList.size() == 0)
  {
    %><div class="tar-empty">No at-risk batches found.</div><%
  }
  for each item in matCountList
  {
    if(rank <= 10)
    {
      cntStr = item.getPrefix("||");
      matName = item.getSuffix("||");
      batchCount = cntStr.toLong();
      %><div class="tar-row">
        <div class="tar-rank"><%=rank%></div>
        <div class="tar-name"><%=matName%></div>
        <div class="tar-count"><%=batchCount%></div>
      </div><%
      rank = rank + 1;
    }
  }
%>
  </div>
</div>
