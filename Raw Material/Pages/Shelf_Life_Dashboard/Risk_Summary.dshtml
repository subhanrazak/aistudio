<style>
.slm-risk-wrap {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px;
  box-sizing: border-box;
  height: 100%;
}
.slm-risk-card {
  background: #ffffff;
  border-radius: 10px;
  padding: 18px 16px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
  border: 1px solid #e7e7ee;
}
.slm-risk-card-red {
  border-left: 4px solid #c62828;
}
.slm-risk-card-orange {
  border-left: 4px solid #f57c00;
}
.slm-risk-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
}
.slm-risk-card-icon-red {
  font-size: 18px;
  color: #c62828;
}
.slm-risk-card-icon-orange {
  font-size: 18px;
  color: #f57c00;
}
.slm-risk-card-title {
  font-size: 12px;
  font-weight: 600;
  color: #555577;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.slm-risk-value {
  font-size: 32px;
  font-weight: 800;
  color: #1a1a2e;
  margin: 0;
  line-height: 1.1;
}
.slm-risk-value-red {
  color: #c62828;
}
.slm-risk-value-orange {
  color: #e65100;
}
</style>
<div class="slm-risk-wrap">
  <div class="slm-risk-card slm-risk-card-red">
    <div class="slm-risk-card-header">
      <i class="slm-risk-card-icon-red zc-li-outline e-commerce-money-bag"></i>
      <p class="slm-risk-card-title">Total Value at Risk</p>
    </div>
    <p class="slm-risk-value slm-risk-value-red"><%=Batch_Monitor[Status_Color == "Red"].sum(Value_At_Risk) + Batch_Monitor[Status_Color == "Amber"].sum(Value_At_Risk)%></p>
  </div>
  <div class="slm-risk-card slm-risk-card-orange">
    <div class="slm-risk-card-header">
      <i class="slm-risk-card-icon-orange zc-li-outline ui-1-notes-paper-text"></i>
      <p class="slm-risk-card-title">Open Disposition Actions</p>
    </div>
    <p class="slm-risk-value slm-risk-value-orange"><%=Disposition_Actions[Status == "Pending" || Status == "In Review" || Status == "Pending Re-test"].count()%></p>
  </div>
</div>
