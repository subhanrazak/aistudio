form Materials
{
    displayname = "Materials"

    Material_Master
    (
        type    = section
        row     = 1
        column  = 0
    )
    must have unique Material_Number
    (
        type        = text
        displayname = "Material Number (MATNR)"
        maxchar     = 18
        row         = 1
    )
    must have Material_Description
    (
        type        = text
        displayname = "Material Description (MAKTX)"
        maxchar     = 200
        row         = 1
    )
    must have Material_Group
    (
        type          = picklist
        displayname   = "Material Group"
        values        = Material_Groups.ID
        displayformat = [Material_Group_Name]
        searchable    = true
        row           = 1
    )
    Unit_of_Measure
    (
        type        = text
        displayname = "Base Unit of Measure"
        maxchar     = 10
        row         = 1
    )

    Shelf_Life_Settings
    (
        type       = section
        displayname = "Shelf Life Settings"
        visibility = true
        row        = 2
        column     = 1
    )
    Total_Shelf_Life_Days
    (
        type        = number
        displayname = "Total Shelf Life (Days) — MHDHB"
        row         = 2
    )
    Min_Remaining_Shelf_Life_Days
    (
        type        = number
        displayname = "Min Remaining Shelf Life (Days) — MHDRZ"
        row         = 2
    )
    Standard_Cost
    (
        type         = decimal
        displayname  = "Standard Cost per Unit (STPRS)"
        decimalplace = 2
        row          = 2
    )
    Currency
    (
        type        = text
        displayname = "Currency"
        maxchar     = 3
        row         = 2
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
