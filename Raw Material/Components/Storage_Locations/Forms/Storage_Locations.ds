form Storage_Locations
{
    displayname = "Storage Locations"

    Location_Info
    (
        type    = section
        row     = 1
        column  = 0
    )
    must have unique Location_Code
    (
        type        = text
        displayname = "Location Code (LGORT)"
        maxchar     = 10
        row         = 1
    )
    must have Location_Name
    (
        type        = text
        displayname = "Location Name (LGOBE)"
        maxchar     = 100
        row         = 1
    )
    Plant_Code
    (
        type        = text
        displayname = "Plant Code (WERKS)"
        maxchar     = 10
        row         = 1
    )
    Location_Description
    (
        type        = textarea
        displayname = "Description"
        row         = 1
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
