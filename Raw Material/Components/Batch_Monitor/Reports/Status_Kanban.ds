kanban Status_Kanban
{
    displayName = "Batch Status Board"
    show all rows from Batch_Monitor
    (
        Batch_Number
        Material
        Expiry_Date
        Days_To_Expiry
        Storage_Location
        Status_Color
    )
    sort by ( Days_To_Expiry ascending )
    options
    (
        display field = Status_Color
        sort order   = ascending
        record count = enable
    )
}
