report All_Batches
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Batch_Number
                    Material
                    Expiry_Date
                    Days_To_Expiry
                    Status_Color
                    Unrestricted_Stock
                    "Create Disposition"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Batch_Number
                    Material
                    Expiry_Date
                    Days_To_Expiry
                    Pct_Shelf_Life_Remaining
                    Status_Color
                    Unrestricted_Stock
                    Value_At_Risk
                    Storage_Location
                    Material_Group_Name
                    Last_Synced_Date
                    "Create Disposition"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
