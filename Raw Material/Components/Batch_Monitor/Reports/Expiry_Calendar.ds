calendar Expiry_Calendar
{
    displayName = "Expiry Calendar"
    show all rows from Batch_Monitor
    (
        Batch_Number
        Material
        Expiry_Date
        Status_Color
    )
    options
    (
        display type  = month
        display field = Batch_Number
        start date    = Expiry_Date
        default date
        (
            day   = Today
            month = Currentmonth
            year  = Currentyear
        )
    )
}
