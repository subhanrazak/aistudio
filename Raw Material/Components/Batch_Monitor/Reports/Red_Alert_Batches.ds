list Red_Alert_Batches
{
    displayName = "Red — Expired Batches"
    show all rows from Batch_Monitor [Status_Color == "Red"]
    (
        Batch_Number
        Material
        Expiry_Date
        Days_To_Expiry
        Unrestricted_Stock
        Value_At_Risk
        Storage_Location
        Status_Color
        Material_Group_Name

        custom action "Create Disposition"
        (
            workflow = Create_Disposition
            show action for each record = true
        )
    )
    sort by ( Days_To_Expiry ascending )
}
