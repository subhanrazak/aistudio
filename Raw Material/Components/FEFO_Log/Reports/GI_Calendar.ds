calendar GI_Calendar
{
    displayName = "GI Calendar"
    show all rows from FEFO_Log
    (
        GI_Date
        Material
        Batch_Consumed
        Quantity_Issued
    )
    options
    (
        display type  = month
        display field = Material
        start date    = GI_Date
        default date
        (
            day   = Today
            month = Currentmonth
            year  = Currentyear
        )
    )
}
