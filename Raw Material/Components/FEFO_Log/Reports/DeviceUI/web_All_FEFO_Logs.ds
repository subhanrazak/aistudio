report All_FEFO_Logs
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    GI_Date
                    Material
                    Batch_Consumed
                    Quantity_Issued
                    Was_Oldest_Batch
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    GI_Date
                    Material
                    Batch_Consumed
                    Quantity_Issued
                    UoM
                    Was_Oldest_Batch
                    Production_Order_Ref
                    Recorded_By
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
