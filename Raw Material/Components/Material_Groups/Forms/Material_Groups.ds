form Material_Groups
{
    displayname = "Material Groups"

    Basic_Info
    (
        type    = section
        row     = 1
        column  = 0
    )
    must have unique Material_Group_Code
    (
        type        = text
        displayname = "Material Group Code"
        maxchar     = 20
        row         = 1
    )
    must have Material_Group_Name
    (
        type        = text
        displayname = "Material Group Name"
        maxchar     = 100
        row         = 1
    )
    Example_Materials
    (
        type        = textarea
        displayname = "Example Materials"
        row         = 1
    )
    Description
    (
        type        = textarea
        displayname = "Description"
        row         = 1
    )

    Alert_Thresholds
    (
        type       = section
        displayname = "Alert Thresholds"
        visibility = true
        row        = 2
        column     = 1
    )
    must have Amber_Warning_Days
    (
        type        = number
        displayname = "Amber Warning (Days Before Expiry)"
        row         = 2
    )
    must have Red_Alert_Days
    (
        type        = number
        displayname = "Red Alert (Days Before Expiry)"
        row         = 2
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
