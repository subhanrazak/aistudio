"Admin"
{
    name        = "Admin"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:false }
    description = "Administrator — full configuration, master data, approves Return to Vendor"

    ModulePermissions
    {
        Material_Groups
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Import,Export,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Material_Groups={"View","Edit","Delete"}
            }
        }

        Storage_Locations
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Import,Export,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Storage_Locations={"View","Edit","Delete"}
            }
        }

        Materials
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Import,Export,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Materials={"View","Edit","Delete"}
                Materials_By_Group={"View","Edit","Delete"}
            }
        }

        Batch_Monitor
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Import,Export,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View","Edit","Delete"}
                Red_Alert_Batches={"View","Edit","Delete"}
                Amber_Warning_Batches={"View","Edit","Delete"}
                Status_Kanban={"View","Edit","Delete"}
                Expiry_Calendar={"View","Edit","Delete"}
                Top_5_Urgent_Batches={"View","Edit","Delete"}
            }
        }

        Disposition_Actions
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Dispositions={"View","Edit","Delete"}
                Pending_Dispositions={"View","Edit","Delete"}
                Disposition_Kanban={"View","Edit","Delete"}
            }
        }

        FEFO_Log
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Import,Export,Tab,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_FEFO_Logs={"View","Edit","Delete"}
                GI_Calendar={"View","Edit","Delete"}
            }
        }

        Shelf_Life_Dashboard
        {
            enabled = tab
        }
    }
