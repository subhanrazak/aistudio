"QA_Manager"
{
    name        = "QA_Manager"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Quality assurance — approves Extend Shelf Life (after re-test), Dispose/Write-Off, Transfer"

    ModulePermissions
    {
        Material_Groups
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Material_Groups={"View"}
            }
        }

        Storage_Locations
        {
            enabled          = View,Viewall,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Storage_Locations={"View"}
            }
        }

        Materials
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Materials={"View"}
                Materials_By_Group={"View"}
            }
        }

        Batch_Monitor
        {
            enabled          = View,Viewall,Edit,Modifyall,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View"}
                Red_Alert_Batches={"View"}
                Amber_Warning_Batches={"View"}
                Status_Kanban={"View"}
                Expiry_Calendar={"View"}
                Top_5_Urgent_Batches={"View"}
            }
        }

        Disposition_Actions
        {
            enabled          = View,Viewall,Edit,Modifyall,Search,Tab
            allFieldsVisible = false
            FieldPermissions
            {
                Batch_Reference{visibility:true,readonly:true}
                Requester_Name{visibility:true,readonly:true}
                Disposition_Notes{visibility:true,readonly:true}
                Requested_Date{visibility:true,readonly:true}
                Action_Type{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Dispositions={"View"}
                Pending_Dispositions={"View"}
                Disposition_Kanban={"View"}
            }
        }

        FEFO_Log
        {
            enabled          = View,Viewall,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_FEFO_Logs={"View"}
                GI_Calendar={"View"}
            }
        }

        Shelf_Life_Dashboard
        {
            enabled = tab
        }
    }
}
