"Warehouse_Manager"
{
    name        = "Warehouse_Manager"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Warehouse operations — monitors batches, initiates and approves Consume dispositions"

    ModulePermissions
    {
        Material_Groups
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Material_Groups={"View"}
            }
        }

        Storage_Locations
        {
            enabled          = View,Viewall,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Storage_Locations={"View"}
            }
        }

        Materials
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Materials={"View"}
                Materials_By_Group={"View"}
            }
        }

        Batch_Monitor
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View"}
                Red_Alert_Batches={"View"}
                Amber_Warning_Batches={"View"}
                Status_Kanban={"View"}
                Expiry_Calendar={"View"}
                Top_5_Urgent_Batches={"View"}
            }
        }

        Disposition_Actions
        {
            enabled          = Create,View,Viewall,Edit,Search,Tab
            allFieldsVisible = false
            FieldPermissions
            {
                QA_Review_Notes{visibility:true,readonly:true}
                QA_Reviewer{visibility:true,readonly:true}
                QA_Review_Date{visibility:true,readonly:true}
                Retest_Lab_Reference{visibility:true,readonly:true}
                Retest_Outcome{visibility:true,readonly:true}
                Controller_Approval_Notes{visibility:true,readonly:true}
                Controller_Reviewer{visibility:true,readonly:true}
                Approval_Date{visibility:true,readonly:true}
                Rejection_Reason{visibility:true,readonly:true}
            }
            ReportPermissions
            {
                All_Dispositions={"View"}
                Pending_Dispositions={"View"}
                Disposition_Kanban={"View"}
            }
        }

        FEFO_Log
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_FEFO_Logs={"View"}
                GI_Calendar={"View"}
            }
        }

        Shelf_Life_Dashboard
        {
            enabled = tab
        }
    }
}
