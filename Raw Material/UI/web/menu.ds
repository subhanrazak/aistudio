menu
{
    space Shelf_Life_Monitor_Space
    {
        displayname = "Shelf-Life Monitor"
        icon = "business-factory"

        section Dashboard_Section
        {
            displayname = "Dashboard"
            icon = "business-chart"

            page Shelf_Life_Dashboard
            {
                icon = "business-chart-bar-33"
            }
        }

        section Batch_Monitoring_Section
        {
            displayname = "Batch Monitoring"
            icon = "business-stock"

            form Batch_Monitor
            {
                icon = "business-stock"
            }
            report All_Batches
            {
                icon = "tech-desktop"
            }
            report Red_Alert_Batches
            {
                icon = "business-chart-growth"
            }
            report Amber_Warning_Batches
            {
                icon = "business-percentage-39"
            }
            report Status_Kanban
            {
                icon = "business-board-30"
            }
            report Expiry_Calendar
            {
                icon = "business-agenda"
            }
            report Top_5_Urgent_Batches
            {
                icon = "business-goal-64"
            }
        }

        section Disposition_Section
        {
            displayname = "Disposition Actions"
            icon = "business-hammer"

            form Disposition_Actions
            {
                icon = "business-hammer"
            }
            report All_Dispositions
            {
                icon = "tech-desktop"
            }
            report Pending_Dispositions
            {
                icon = "business-progress"
            }
            report Disposition_Kanban
            {
                icon = "business-board-28"
            }
        }

        section FEFO_Section
        {
            displayname = "FEFO Compliance"
            icon = "business-chart-pie-36"

            form FEFO_Log
            {
                icon = "business-notes"
            }
            report All_FEFO_Logs
            {
                icon = "tech-desktop"
            }
            report GI_Calendar
            {
                icon = "business-agenda"
            }
        }

        section Master_Data_Section
        {
            displayname = "Master Data"
            icon = "business-briefcase-24"

            form Materials
            {
                icon = "business-books"
            }
            report All_Materials
            {
                icon = "tech-desktop"
            }
            report Materials_By_Group
            {
                icon = "business-hierarchy-53"
            }
            form Material_Groups
            {
                icon = "business-hierarchy-55"
            }
            report All_Material_Groups
            {
                icon = "tech-desktop"
            }
            form Storage_Locations
