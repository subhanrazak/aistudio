<page linkname = "Todays_Reminders" displayname = "Today's Reminders"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Reminder_Summary' elementName='Reminder_Summary'>
          <![CDATA[htmlpage Reminder_Summary()
            content
            <%{%>
              <file name:Reminder_Summary.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Grouped_Reminders' elementName='Grouped_Reminders'>
          <![CDATA[htmlpage Grouped_Reminders()
            content
            <%{%>
              <file name:Grouped_Reminders.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Reminder_Log_Table' elementName='Reminder_Log_Table'>
          <![CDATA[htmlpage Reminder_Log_Table()
            content
            <%{%>
              <file name:Reminder_Log_Table.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>