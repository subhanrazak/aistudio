<style>
.health-actions-shell { padding: 0 20px 20px; background: var(--zcs-page-bg-color); box-sizing: border-box; }
.health-actions-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
.zcs-quick-actions-wrapper { height: 100%; }
.zcs-quick-action-item { list-style-type: none; }
.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }
.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }
.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }
.health-action-card { min-height: 96px; transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; }
.health-action-card:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(18,19,43,0.07); }
.health-action-card .zcs-quick-action-link { height: 100%; align-items: flex-start; }
.health-action-icon { width: 38px; height: 38px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); font-size: 18px; flex: 0 0 auto; }
.health-action-copy { min-width: 0; }
.health-action-subtext { display: block; margin-top: 4px; color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.35; }
@media (max-width: 1100px) { .health-actions-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 700px) { .health-actions-shell { padding: 0 12px 12px; } .health-actions-grid { grid-template-columns: 1fr; gap: 10px; } .health-action-card { min-height: auto; } }
</style>
<div class="health-actions-shell">
  <div class="zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
    <div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
      <h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quick actions</h5>
      <span class="zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary">Caregiver shortcuts</span>
    </div>
    <ul class="health-actions-grid zcs-p-0 zcs-m-0">
      <li class="zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border">
        <a class="zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Family_Members">
          <span class="health-action-icon"><i class="zc-li-outline ui-1-simple-add"></i></span>
          <span class="health-action-copy"><span class="zcs-quick-action-text zcs-font-medium">Add Family Member</span><span class="health-action-subtext">Create a household profile</span></span>
        </a>
      </li>
      <li class="zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border">
        <a class="zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Medications">
          <span class="health-action-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span>
          <span class="health-action-copy"><span class="zcs-quick-action-text zcs-font-medium">Log Medication</span><span class="health-action-subtext">Add a medicine schedule</span></span>
        </a>
      </li>
      <li class="zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border">
        <a class="zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Health_Records">
          <span class="health-action-icon"><i class="zc-li-outline files-2-doc"></i></span>
          <span class="health-action-copy"><span class="zcs-quick-action-text zcs-font-medium">Add Health Record</span><span class="health-action-subtext">Store visits, labs, and notes</span></span>
        </a>
      </li>
      <li class="zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border">
        <a class="zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Prescription_Scans">
          <span class="health-action-icon"><i class="zc-li-outline ui-1-zoom"></i></span>
          <span class="health-action-copy"><span class="zcs-quick-action-text zcs-font-medium">Scan Prescription</span><span class="health-action-subtext">Upload image or PDF for OCR</span></span>
        </a>
      </li>
      <li class="zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border">
        <a class="zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Page:Todays_Reminders">
          <span class="health-action-icon"><i class="zc-li-outline ui-2-time"></i></span>
          <span class="health-action-copy"><span class="zcs-quick-action-text zcs-font-medium">View Today's Reminders</span><span class="health-action-subtext">Open the reminder schedule</span></span>
        </a>
      </li>
    </ul>
  </div>
</div>