<%
  today = zoho.currentdate;
  ownerEmail = zoho.loginuser;
  familyCount = Family_Members[Owner_Email == ownerEmail].count();
  activeMeds = Medications[Owner_Email == ownerEmail && Is_Active == true && Start_Date <= today && (End_Date == null || End_Date >= today)];
  activeMedCount = activeMeds.count();
  todaysReminderSlots = 0;
  for each med in activeMeds
  {
    if(med.Reminder_Times != null)
    {
      todaysReminderSlots = todaysReminderSlots + med.Reminder_Times.size();
    }
  }
  pendingReviews = Prescription_Scans[Owner_Email == ownerEmail && Saved_Health_Record == null && (OCR_Status == "Extracted" || OCR_Status == "OCR Failed")].count();
%>
<style>
/* ZCS global utility sheet is intentionally included once on this page in KPI_Cards. */
:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; font-size: 16px; line-height: 1.5; --column-gap: 0px; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-justify-center { justify-content: center; }
.zcs-gap-4 { gap: 0.25rem; --column-gap: 0.25rem; }
.zcs-gap-8 { gap: 0.5rem; --column-gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; --column-gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; --column-gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }
.zcs-gap-18 { gap: 1.125rem; --column-gap: 1.125rem; }
.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }
.zcs-p-0 { padding: 0rem; }
.zcs-p-10 { padding: 0.625rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-14 { padding: 0.875rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-18 { padding: 1.125rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-m-0 { margin: 0rem; }
.zcs-mt-4 { margin-top: 0.25rem; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-12 { margin-top: 0.75rem; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-font-11 { font-size: 0.6875rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-lh-body { line-height: 1.5; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-rounded-xl { border-radius: 0.75rem; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-box-border { box-sizing: border-box; }
.zcs-cursor-pointer { cursor: pointer; }
.zcs-relative { position: relative; }
.zcs-sticky { position: sticky; }
.zcs-overflow-auto { overflow: auto; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
a { text-decoration: none; }
.health-dashboard { background: var(--zcs-page-bg-color); padding: 20px; box-sizing: border-box; }
.health-hero { width: 100%; border-radius: 16px; padding: 24px; box-sizing: border-box; color: #FFFFFF; background: radial-gradient(circle at 92% 18%, rgba(255,255,255,0.24) 0 72px, transparent 73px), radial-gradient(circle at 78% 88%, rgba(255,255,255,0.14) 0 108px, transparent 109px), linear-gradient(135deg, var(--zcs_brand_color), var(--zcs_brand_dark_color)); }
.health-hero h1 { margin: 0; color: #FFFFFF; font-size: 28px; line-height: 1.2; font-weight: 700; }
.health-hero p { margin: 8px 0 0; color: rgba(255,255,255,0.88); font-size: 14px; max-width: 720px; }
.health-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.health-kpi-card { min-height: 128px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: var(--zcs-white-color); padding: 18px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 10px 26px rgba(18,19,43,0.06); }
.health-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.health-kpi-icon { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); font-size: 20px; }
.health-kpi-label { margin: 0; color: var(--zcs-secondary-text-color); font-size: 13px; font-weight: 500; }
.health-kpi-value { margin: 14px 0 2px; color: var(--zcs-primary-text-color); font-size: 32px; line-height: 1; font-weight: 700; }
.health-kpi-note { margin: 0; color: var(--zcs-teritiary-text-color); font-size: 12px; }
.health-kpi-warning .health-kpi-icon { color: #b8770d; background: #FCF4E6; }
.health-kpi-green .health-kpi-icon { color: #179E6C; background: #E4FCF3; }
.health-kpi-blue .health-kpi-icon { color: #2A6FFC; background: #E8EFFF; }
@media (max-width: 992px) { .health-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .health-hero h1 { font-size: 24px; } }
@media (max-width: 576px) { .health-dashboard { padding: 12px; } .health-hero { padding: 18px; } .health-kpi-grid { grid-template-columns: 1fr; gap: 12px; } .health-kpi-card { min-height: 112px; padding: 16px; } .health-kpi-value { font-size: 28px; } }
</style>
<div class="health-dashboard">
  <div class="health-hero">
    <h1>Health Dashboard</h1>
    <p>Welcome, <%= zoho.loginuser %>. Review household health activity, medication coverage, reminders, and prescriptions that need attention.</p>
  </div>
  <div class="health-kpi-grid">
    <div class="health-kpi-card health-kpi-blue">
      <div class="health-kpi-top">
        <p class="health-kpi-label">Total family members</p>
        <span class="health-kpi-icon"><i class="zc-li-outline users-mm"></i></span>
      </div>
      <div>
        <div class="health-kpi-value"><%= familyCount %></div>
        <p class="health-kpi-note">Household profiles owned by you</p>
      </div>
    </div>
    <div class="health-kpi-card health-kpi-green">
      <div class="health-kpi-top">
        <p class="health-kpi-label">Active medications</p>
        <span class="health-kpi-icon"><i class="zc-li-outline ui-1-heart"></i></span>
      </div>
      <div>
        <div class="health-kpi-value"><%= activeMedCount %></div>
        <p class="health-kpi-note">Active courses in date range</p>
      </div>
    </div>
    <div class="health-kpi-card">
      <div class="health-kpi-top">
        <p class="health-kpi-label">Today's reminder slots</p>
        <span class="health-kpi-icon"><i class="zc-li-outline ui-2-time"></i></span>
      </div>
      <div>
        <div class="health-kpi-value"><%= todaysReminderSlots %></div>
        <p class="health-kpi-note">Medication/time combinations for today</p>
      </div>
    </div>
    <div class="health-kpi-card health-kpi-warning">
      <div class="health-kpi-top">
        <p class="health-kpi-label">Pending prescription reviews</p>
        <span class="health-kpi-icon"><i class="zc-li-outline files-2-doc"></i></span>
      </div>
      <div>
        <div class="health-kpi-value"><%= pendingReviews %></div>
        <p class="health-kpi-note">Extracted or failed OCR not yet saved</p>
      </div>
    </div>
  </div>
</div>