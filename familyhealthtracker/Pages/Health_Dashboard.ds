<page linkname = "Health_Dashboard" displayname = "Health Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='KPI_Cards' elementName='KPI_Cards'>
          <![CDATA[htmlpage KPI_Cards()
            content
            <%{%>
              <file name:KPI_Cards.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Quick_Actions' elementName='Quick_Actions'>
          <![CDATA[htmlpage Quick_Actions()
            content
            <%{%>
              <file name:Quick_Actions.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='60%'>
        <dsp id='Recent_Activity' elementName='Recent_Activity'>
          <![CDATA[htmlpage Recent_Activity()
            content
            <%{%>
              <file name:Recent_Activity.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
      <column width='40%'>
        <dsp id='Upcoming_Reminders' elementName='Upcoming_Reminders'>
          <![CDATA[htmlpage Upcoming_Reminders()
            content
            <%{%>
              <file name:Upcoming_Reminders.dshtml/>
            <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>