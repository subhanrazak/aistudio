customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "poppins"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "none"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-content{background:#f7fbfc;}"
    }
}
