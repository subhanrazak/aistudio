	menu
	{
	    space Health_Tracker
	    {
	        displayname = "Family Health Tracker"
	        icon = "health-hospital-33"
	
	        section Overview
	        {
	            displayname = "Overview"
	            icon = "health-pulse-chart"
	
	            page Health_Dashboard
	            {
	                icon = "health-pulse-chart"
	            }
	            page Todays_Reminders
	            {
	                icon = "health-pill-container-44"
	            }
	        }
	
	        section Family
	        {
	            displayname = "Family"
	            icon = "users-multiple-19"
	
	            form Family_Members
	            {
	                icon = "users-parent"
	            }
	            report All_Family_Members
	            {
	                icon = "users-contacts"
	            }
	            report Family_Member_Directory
	            {
	                icon = "users-multiple-19"
	            }
	        }
	
	        section Care_Management
	        {
	            displayname = "Care Management"
	            icon = "health-pill-43"
	
	            form Medications
	            {
	                icon = "health-pill-container-47"
	            }
	            report All_Medications
	            {
	                icon = "health-pill-container-44"
	            }
	            report Active_Medications
	            {
	                icon = "health-pill-42"
	            }
	            report Medication_Course_Calendar
	            {
	                icon = "health-notebook"
	            }
	            form Health_Records
	            {
	                icon = "health-notebook"
	            }
	            report All_Health_Records
	            {
	                icon = "files-single-content-03"
	            }
	            report Health_Record_Timeline
	            {
	                icon = "files-time"
	            }
	            report Vaccination_Records
	            {
	                icon = "health-syringe"
	            }
	        }
	
	        section Prescription_Scanning
	        {
	            displayname = "Prescription Scanning"
	            icon = "files-upload"
	
	            form Prescription_Scans
	            {
	                icon = "files-upload"
	            }
	            report Pending_Prescription_Review
	            {
	                icon = "files-exclamation"
	            }
	            report All_Prescription_Scans
	            {
	                icon = "files-gallery"
	            }
	        }
	
	        section Reminder_Logs
	        {
	            displayname = "Reminder Logs"
	            icon = "files-time"
	
	            form Reminder_Log
	            {
	                icon = "files-time"
	            }
	            report Todays_Reminder_Log
	            {
	                icon = "health-pill-container-44"
	            }
	            report All_Reminder_Log
	            {
	                icon = "files-archive-content"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "poppins"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "none"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-content{background:#f7fbfc;}"
	    }
	}
	}
}
