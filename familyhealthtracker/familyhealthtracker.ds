	customize
	{
	    font = "poppins"
	    logo
	    {
	        preference = "none"
	        placement = "left"
	    }
	}

	share_settings
	{
	"Caregiver_Portal"
	{
	    name        = "Caregiver_Portal"
	    type        = customer_portal
	    permissions = { Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true }
	    description = "Customer portal profile for authenticated household caregivers who manage family health data."
	
	    ModulePermissions
	    {
	        Family_Members
	        {
	            enabled          = Create, View, Edit, Delete, Search, Tab, Viewall, Modifyall, Import, Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Family_Members={"View","Edit","Delete"}
	                Family_Member_Directory={"View","Edit","Delete"}
	            }
	        }
	
	        Health_Records
	        {
	            enabled          = Create, View, Edit, Delete, Search, Tab, Viewall, Modifyall, Import, Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Health_Records={"View","Edit","Delete"}
	                Health_Record_Timeline={"View","Edit","Delete"}
	                Vaccination_Records={"View","Edit","Delete"}
	            }
	        }
	
	        Medications
	        {
	            enabled          = Create, View, Edit, Delete, Search, Tab, Viewall, Modifyall, Import, Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Medications={"View","Edit","Delete"}
	                Active_Medications={"View","Edit","Delete"}
	                Medication_Course_Calendar={"View","Edit","Delete"}
	            }
	        }
	
	        Reminder_Log
	        {
	            enabled          = View, Search, Tab, Viewall, Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                Todays_Reminder_Log={"View"}
	                All_Reminder_Log={"View"}
	            }
	        }
	
	        Prescription_Scans
	        {
	            enabled          = Create, View, Edit, Delete, Search, Tab, Viewall, Modifyall, Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Prescription_Scans={"View","Edit","Delete"}
	                Pending_Prescription_Review={"View","Edit","Delete"}
	            }
	        }
	
	        Health_Dashboard
	        {
	            enabled = tab
	        }
	
	        Todays_Reminders
	        {
	            enabled = tab
	        }
	    }
	}
	}

	web
	{
	forms
	{
	    form Family_Members
	    {
	        label placement = top
	    }
	    form Health_Records
	    {
	        label placement = top
	    }
	    form Medications
	    {
	        label placement = top
	    }
	    form Reminder_Log
	    {
	        label placement = top
	    }
	    form Prescription_Scans
	    {
	        label placement = top
	    }
	}
	reports
	{
		report All_Family_Members
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Full_Name
		                    Relation
		                    Date_of_Birth
		                    Blood_Group
		                    Known_Allergies
		                    Notes
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Full_Name
		                    Relation
		                    Date_of_Birth
		                    Blood_Group
		                    Known_Allergies
		                    Notes
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	
