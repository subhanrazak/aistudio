application "familyhealthtracker"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Family_Members
		{
		    displayname = "Family Members"
		    success message = "Family member saved successfully."
		    record owner = Added_User
		    Personal_Info
		    (
		        type = section
		        displayname = "Personal Information"
		        row = 1
		        column = 0
		    )
		    must have Full_Name
		    (
		        type = text
		        displayname = "Full Name"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Date_of_Birth
		    (
		        type = date
		        displayname = "Date of Birth"
		        personal data = true
		        isephi = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Relation
		    (
		        type = picklist
		        displayname = "Relation"
		        values = {"Self","Spouse","Child","Parent","Grandparent","Sibling","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Blood_Group
		    (
		        type = picklist
		        displayname = "Blood Group"
		        values = {"A+","A-","B+","B-","AB+","AB-","O+","O-","Unknown"}
		        initial value = "Unknown"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Health_Notes
		    (
		        type = section
		        displayname = "Health Notes"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Known_Allergies
		    (
		        type = textarea
		        displayname = "Known Allergies"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		        height = 100px
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 2
		        width = medium
		        height = 100px
		    )
		    System_Details
		    (
		        type = section
		        displayname = "System Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Caregiver Email"
		        personal data = true
		        isencrypted = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save this family member"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		                tooltip = "Update this family member"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Health_Records
		{
		    displayname = "Health Records"
		    success message = "Health record saved successfully."
		    record owner = Added_User
		    Record_Info
		    (
		        type = section
		        displayname = "Record Information"
		        row = 1
		        column = 0
		    )
		    must have Member
		    (
		        type = picklist
		        displayname = "Family Member"
		        values = Family_Members.ID
		        displayformat = [Full_Name]
		        allow new entries
		        [
		            displayname = "Add Family Member"
		        ]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Record_Type
		    (
		        type = picklist
		        displayname = "Record Type"
		        values = {"Consultation","Lab Report","Prescription","Vaccination","Other"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Record_Date
		    (
		        type = date
		        displayname = "Record Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Timeline_Date_Time
		    (
		        type = datetime
		        displayname = "Timeline Date & Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Clinical_Details
		    (
		        type = section
		        displayname = "Clinical Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Description
		    (
		        type = textarea
		        displayname = "Description / Notes"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		        height = 140px
		    )
		    Doctor_Name
		    (
		        type = text
		        displayname = "Doctor Name"
		        personal data = true
		        isephi = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Hospital_Clinic
		    (
		        type = text
		        displayname = "Hospital / Clinic"
		        personal data = true
		        isephi = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Record_File
		    (
		        type = upload file
		        displayname = "Attached File"
		        browse = local_drive
		        row = 2
		        column = 1
		        width = medium
		    )
		    OCR_Text
		    (
		        type = textarea
		        displayname = "Prescription / OCR Text"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 2
		        width = medium
		        height = 160px
		    )
		    System_Details
		    (
		        type = section
		        displayname = "System Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Source
		    (
		        type = picklist
		        displayname = "Source"
		        values = {"Manual Entry","Prescription Scan"}
		        initial value = "Manual Entry"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Caregiver Email"
		        personal data = true
		        isencrypted = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save this health record"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		                tooltip = "Update this health record"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Medications
		{
		    displayname = "Medications"
		    success message = "Medication saved successfully."
		    record owner = Added_User
		    Medication_Info
		    (
		        type = section
		        displayname = "Medication Information"
		        row = 1
		        column = 0
		    )
		    must have Member
		    (
		        type = picklist
		        displayname = "Family Member"
		        values = Family_Members.ID
		        displayformat = [Full_Name]
		        allow new entries
		        [
		            displayname = "Add Family Member"
		        ]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Medicine_Name
		    (
		        type = text
		        displayname = "Medicine Name"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Dosage
		    (
		        type = text
		        displayname = "Dosage"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Frequency
		    (
		        type = picklist
		        displayname = "Frequency"
		        values = {"Once daily","Twice daily","Three times daily","Four times daily","As needed","Custom"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Schedule_Info
		    (
		        type = section
		        displayname = "Schedule"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        initial value = "${zoho.currentdate}"
		        row = 2
		        column = 1
		        width = medium
		    )
		    End_Date
		    (
		        type = date
		        displayname = "End Date"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Reminder_Times
		    (
		        type = checkboxes
		        displayname = "Reminder Times"
		        values = {"06:00","08:00","10:00","12:00","14:00","16:00","18:00","20:00","22:00"}
		        layout = 3
		        row = 2
		        column = 1
		        width = medium
		    )
		    Is_Active
		    (
		        type = checkbox
		        displayname = "Active"
		        initial value = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes_Section
		    (
		        type = section
		        displayname = "Notes"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 3
		        column = 1
		        width = medium
		        height = 120px
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Caregiver Email"
		        personal data = true
		        isencrypted = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save this medication"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		                tooltip = "Update this medication"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Prescription_Scans
		{
		    displayname = "Prescription Scans"
		    success message = "Prescription scan saved successfully."
		    record owner = Added_User
		    Scan_Info
		    (
		        type = section
		        displayname = "Scan Information"
		        row = 1
		        column = 0
		    )
		    must have Member
		    (
		        type = picklist
		        displayname = "Family Member"
		        values = Family_Members.ID
		        displayformat = [Full_Name]
		        allow new entries
		        [
		            displayname = "Add Family Member"
		        ]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Prescription_File
		    (
		        type = upload file
		        displayname = "Prescription Image / PDF"
		        browse = local_drive
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Scan_Date
		    (
		        type = date
		        displayname = "Scan Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    OCR_Status
		    (
		        type = picklist
		        displayname = "OCR Status"
		        values = {"Uploaded","Processing","Extracted","OCR Failed","Saved"}
		        initial value = "Uploaded"
		        row = 1
		        column = 2
		        width = medium
		    )
		    OCR_Review
		    (
		        type = section
		        displayname = "OCR Review"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Extracted_Text
		    (
		        type = textarea
		        displayname = "Extracted Text"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		        height = 180px
		    )
		    Reviewed_Text
		    (
		        type = textarea
		        displayname = "Reviewed Text"
		        personal data = true
		        isephi = true
		        isencrypted = true
		        row = 2
		        column = 2
		        width = medium
		        height = 180px
		    )
		    Save_As_Health_Record
		    (
		        type = checkbox
		        displayname = "Save as Health Record"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    Saved_Health_Record
		    (
		        type = picklist
		        displayname = "Saved Health Record"
		        values = Health_Records.ID
		        displayformat = [Record_Type]
		        searchable = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    System_Details
		    (
		        type = section
		        displayname = "System Details"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Caregiver Email"
		        personal data = true
		        isencrypted = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Error_Message
		    (
		        type = textarea
		        displayname = "Error Message"
		        row = 3
		        column = 2
		        width = medium
		        height = 100px
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save and run OCR"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		                tooltip = "Update this scan"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Reminder_Log
		{
		    displayname = "Reminder Log"
		    success message = "Reminder log saved successfully."
		    Reminder_Info
		    (
		        type = section
		        displayname = "Reminder Information"
		        row = 1
		        column = 0
		    )
		    must have Medication
		    (
		        type = picklist
		        displayname = "Medication"
		        values = Medications.ID
		        displayformat = [Medicine_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Member
		    (
		        type = picklist
		        displayname = "Family Member"
		        values = Family_Members.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Reminder_Time
		    (
		        type = picklist
		        displayname = "Reminder Time"
		        values = {"06:00","08:00","10:00","12:00","14:00","16:00","18:00","20:00","22:00"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Notify_Date
		    (
		        type = date
		        displayname = "Notify Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Notified_At
		    (
		        type = datetime
		        displayname = "Notified At"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Delivery_Details
		    (
		        type = section
		        displayname = "Delivery Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Owner_Email
		    (
		        type = email
		        displayname = "Caregiver Email"
		        personal data = true
		        isencrypted = true
		        row = 2
		        column = 1
		        width = medium
		    )
		    Email_Status
		    (
		        type = picklist
		        displayname = "Email Status"
		        values = {"Sent","Failed","Skipped"}
		        initial value = "Sent"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        row = 2
		        column = 1
		        width = medium
		        height = 100px
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		                tooltip = "Save this reminder log"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		                tooltip = "Update this reminder log"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Family_Members
		{
		    displayName = "All Family Members"
		    show all rows from Family_Members [Owner_Email == zoho.loginuser]
		    (
		        Full_Name
		        Date_of_Birth
		        (
		            displayformat = fulldate
		        )
		        Relation
		        Blood_Group
		        Known_Allergies
		        (
		            foldcontent = enable
		        )
		        Notes
		        (
		            foldcontent = enable
		        )
		        Owner_Email
		    )
		    filters
		    (
		        Relation
		        Blood_Group
		    )
		    sort by
		    (
		        Full_Name ascending
		    )
		}

		list Family_Member_Directory
		{
		    displayName = "Family Member Directory"
		    show all rows from Family_Members [Owner_Email == zoho.loginuser]
		    (
		        Full_Name
		        Relation
		        Date_of_Birth
		        Blood_Group
		        Owner_Email
		    )
		    filters
		    (
		        Relation
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Relation ascending
		    )
		    sort by
		    (
		        Full_Name ascending
		    )
		}

		default list All_Health_Records
		{
		    displayName = "All Health Records"
		    show all rows from Health_Records [Owner_Email == zoho.loginuser]
		    (
		        Member
		        Record_Type
		        Record_Date
		        (
		            displayformat = fulldate
		        )
		        Timeline_Date_Time
		        (
		            displayformat = dateonly
		        )
		        Description
		        (
		            foldcontent = enable
		        )
		        Doctor_Name
		        Hospital_Clinic
		        Record_File
		        Source
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Record_Type
		        Record_Date
		        Source
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Member ascending
		    )
		    sort by
		    (
		        Record_Date descending
		    )
		}

		timeline Health_Record_Timeline
		{
		    displayName = "Health Record Timeline"
		    show all rows from Health_Records [Owner_Email == zoho.loginuser]
		    (
		        Member
		        Record_Type
		        Timeline_Date_Time
		        Record_Date
		        Description
		        Doctor_Name
		        Hospital_Clinic
		        Source
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Record_Type
		        Source
		    )
		    sort by
		    (
		        Timeline_Date_Time descending
		    )
		    options
		    (
		        display field = Record_Type
		        start date = Timeline_Date_Time
		    )
		}

		list Vaccination_Records
		{
		    displayName = "Vaccination Records"
		    show all rows from Health_Records [Owner_Email == zoho.loginuser && Record_Type == "Vaccination"]
		    (
		        Member
		        Record_Date
		        (
		            displayformat = fulldate
		        )
		        Description
		        (
		            foldcontent = enable
		        )
		        Doctor_Name
		        Hospital_Clinic
		        Record_File
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Record_Date
		    )
		    sort by
		    (
		        Record_Date descending
		    )
		}

		list Active_Medications
		{
		    displayName = "Active Medications"
		    show all rows from Medications [Owner_Email == zoho.loginuser && Is_Active == true]
		    (
		        Member
		        Medicine_Name
		        Dosage
		        Frequency
		        Start_Date
		        End_Date
		        Reminder_Times
		        (
		            delimiter = comma
		        )
		        Is_Active
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Reminder_Times
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Member ascending
		    )
		    sort by
		    (
		        Medicine_Name ascending
		    )
		}

		default list All_Medications
		{
		    displayName = "All Medications"
		    show all rows from Medications [Owner_Email == zoho.loginuser]
		    (
		        Member
		        Medicine_Name
		        Dosage
		        Frequency
		        Start_Date
		        (
		            displayformat = fulldate
		        )
		        End_Date
		        (
		            displayformat = fulldate
		        )
		        Reminder_Times
		        (
		            delimiter = comma
		        )
		        Is_Active
		        (
		            displaytrue = "Active"
		            displayfalse = "Inactive"
		        )
		        Notes
		        (
		            foldcontent = enable
		        )
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Is_Active
		        Start_Date
		        Reminder_Times
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Member ascending
		    )
		    sort by
		    (
		        Medicine_Name ascending
		    )
		}

		calendar Medication_Course_Calendar
		{
		    displayName = "Medication Course Calendar"
		    show all rows from Medications [Owner_Email == zoho.loginuser && Is_Active == true]
		    (
		        Member
		        Medicine_Name
		        Start_Date
		        End_Date
		        Reminder_Times
		        Is_Active
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Reminder_Times
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Medicine_Name
		        start date = Start_Date
		        end date = End_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		default list All_Prescription_Scans
		{
		    displayName = "All Prescription Scans"
		    show all rows from Prescription_Scans [Owner_Email == zoho.loginuser]
		    (
		        Member
		        Prescription_File
		        Scan_Date
		        OCR_Status
		        Extracted_Text
		        (
		            foldcontent = enable
		        )
		        Reviewed_Text
		        (
		            foldcontent = enable
		        )
		        Save_As_Health_Record
		        Saved_Health_Record
		        Error_Message
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Scan_Date
		        OCR_Status
		        Save_As_Health_Record
		    )
		    sort by
		    (
		        Scan_Date descending
		    )
		}

		list Pending_Prescription_Review
		{
		    displayName = "Pending Prescription Review"
		    show all rows from Prescription_Scans [Owner_Email == zoho.loginuser && (OCR_Status == "Extracted" || OCR_Status == "OCR Failed") && Saved_Health_Record is null]
		    (
		        Member
		        Prescription_File
		        Scan_Date
		        OCR_Status
		        Reviewed_Text
		        Save_As_Health_Record
		        Error_Message
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Scan_Date
		        OCR_Status
		    )
		    sort by
		    (
		        Scan_Date descending
		    )
		}

		list All_Reminder_Log
		{
		    displayName = "All Reminder Log"
		    show all rows from Reminder_Log [Owner_Email == zoho.loginuser]
		    (
		        Member
		        Medication
		        Reminder_Time
		        Notify_Date
		        Notified_At
		        Email_Status
		        Notes
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Notify_Date
		        Reminder_Time
		        Email_Status
		    )
		    sort by
		    (
		        Notify_Date descending
		        Reminder_Time descending
		    )
		}

		default list Todays_Reminder_Log
		{
		    displayName = "Today's Reminder Log"
		    show all rows from Reminder_Log [Owner_Email == zoho.loginuser && Notify_Date == zoho.currentdate]
		    (
		        Member
		        Medication
		        Reminder_Time
		        Notify_Date
		        Notified_At
		        Email_Status
		        Notes
		        Owner_Email
		    )
		    filters
		    (
		        Member
		        Reminder_Time
		        Email_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Reminder_Time ascending
		    )
		    sort by
		    (
		        Reminder_Time ascending
		    )
		}
	}

	pages
	{
		page Health_Dashboard
		{
					displayname = "Health Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='KPI_Cards' elementName='KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage KPI_Cards()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttoday = zoho.currentdate;\n\townerEmail = zoho.loginuser;\n\tfamilyCount = Family_Members[Owner_Email == ownerEmail].count();\n\tactiveMeds = Medications[Owner_Email == ownerEmail &amp;&amp; Is_Active == true &amp;&amp; Start_Date &lt;= today &amp;&amp; (End_Date == null || End_Date &gt;= today)];\n\tactiveMedCount = activeMeds.count();\n\ttodaysReminderSlots = 0;\n\tfor each med in activeMeds\n\t{\n\t\tif(med.Reminder_Times != null)\n\t\t{\n\t\t\ttodaysReminderSlots = todaysReminderSlots + med.Reminder_Times.size();\n\t\t}\n\t}\n\tpendingReviews = Prescription_Scans[Owner_Email == ownerEmail &amp;&amp; Saved_Health_Record == null &amp;&amp; (OCR_Status == &quot;Extracted&quot; || OCR_Status == &quot;OCR Failed&quot;)].count();\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet is intentionally included once on this page in KPI_Cards. */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-primary-btn-h-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-border-color: var(--zcs_brand_dark_color); --zcs-primary-btn-h-text-color: var(--zcs_brand_foreground_color); --zcs-primary-outline-btn-color: var(--zcs-white-color); --zcs-primary-outline-btn-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-text-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-color: var(--zcs_brand_light_color); --zcs-primary-outline-btn-h-border-color: var(--zcs_brand_color); --zcs-primary-outline-btn-h-text-color: var(--zcs_brand_color); --zcs-secondary-btn-color: var(--zcs_light_grey_color); --zcs-secondary-btn-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-text-color: var(--zcs_primary_text_color); --zcs-secondary-btn-h-color: var(--zcs_dark_grey_color); --zcs-secondary-btn-h-border-color: var(--zcs_primary_border_color); --zcs-secondary-btn-h-text-color: var(--zcs_primary_text_color); --zcs-tooltip-bg-color: #363636; font-size: 16px; line-height: 1.5; --column-gap: 0px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-justify-center { justify-content: center; }\n.zcs-gap-4 { gap: 0.25rem; --column-gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; --column-gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; --column-gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; --column-gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }\n.zcs-gap-18 { gap: 1.125rem; --column-gap: 1.125rem; }\n.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }\n.zcs-p-0 { padding: 0rem; }\n.zcs-p-10 { padding: 0.625rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-14 { padding: 0.875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-18 { padding: 1.125rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-m-0 { margin: 0rem; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-cursor-pointer { cursor: pointer; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\na { text-decoration: none; }\n.health-dashboard { background: var(--zcs-page-bg-color); padding: 20px; box-sizing: border-box; }\n.health-hero { width: 100%; border-radius: 16px; padding: 24px; box-sizing: border-box; color: #FFFFFF; background: radial-gradient(circle at 92% 18%, rgba(255,255,255,0.24) 0 72px, transparent 73px), radial-gradient(circle at 78% 88%, rgba(255,255,255,0.14) 0 108px, transparent 109px), linear-gradient(135deg, var(--zcs_brand_color), var(--zcs_brand_dark_color)); }\n.health-hero h1 { margin: 0; color: #FFFFFF; font-size: 28px; line-height: 1.2; font-weight: 700; }\n.health-hero p { margin: 8px 0 0; color: rgba(255,255,255,0.88); font-size: 14px; max-width: 720px; }\n.health-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.health-kpi-card { min-height: 128px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: var(--zcs-white-color); padding: 18px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 10px 26px rgba(18,19,43,0.06); }\n.health-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.health-kpi-icon { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); font-size: 20px; }\n.health-kpi-label { margin: 0; color: var(--zcs-secondary-text-color); font-size: 13px; font-weight: 500; }\n.health-kpi-value { margin: 14px 0 2px; color: var(--zcs-primary-text-color); font-size: 32px; line-height: 1; font-weight: 700; }\n.health-kpi-note { margin: 0; color: var(--zcs-teritiary-text-color); font-size: 12px; }\n.health-kpi-warning .health-kpi-icon { color: #b8770d; background: #FCF4E6; }\n.health-kpi-green .health-kpi-icon { color: #179E6C; background: #E4FCF3; }\n.health-kpi-blue .health-kpi-icon { color: #2A6FFC; background: #E8EFFF; }\n@media (max-width: 992px) { .health-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .health-hero h1 { font-size: 24px; } }\n@media (max-width: 576px) { .health-dashboard { padding: 12px; } .health-hero { padding: 18px; } .health-kpi-grid { grid-template-columns: 1fr; gap: 12px; } .health-kpi-card { min-height: 112px; padding: 16px; } .health-kpi-value { font-size: 28px; } }\n&lt;/style&gt;\n&lt;div class=&quot;health-dashboard&quot;&gt;\n\t&lt;div class=&quot;health-hero&quot;&gt;\n\t\t&lt;h1&gt;Health Dashboard&lt;/h1&gt;\n\t\t&lt;p&gt;Welcome, &lt;%= zoho.loginuser %&gt;. Review household health activity, medication coverage, reminders, and prescriptions that need attention.&lt;/p&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;health-kpi-grid&quot;&gt;\n\t\t&lt;div class=&quot;health-kpi-card health-kpi-blue&quot;&gt;\n\t\t\t&lt;div class=&quot;health-kpi-top&quot;&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-label&quot;&gt;Total family members&lt;/p&gt;\n\t\t\t\t&lt;span class=&quot;health-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-mm&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;health-kpi-value&quot;&gt;&lt;%= familyCount %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-note&quot;&gt;Household profiles owned by you&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;health-kpi-card health-kpi-green&quot;&gt;\n\t\t\t&lt;div class=&quot;health-kpi-top&quot;&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-label&quot;&gt;Active medications&lt;/p&gt;\n\t\t\t\t&lt;span class=&quot;health-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-heart&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;health-kpi-value&quot;&gt;&lt;%= activeMedCount %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-note&quot;&gt;Active courses in date range&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;health-kpi-card&quot;&gt;\n\t\t\t&lt;div class=&quot;health-kpi-top&quot;&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-label&quot;&gt;Today&apos;s reminder slots&lt;/p&gt;\n\t\t\t\t&lt;span class=&quot;health-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;health-kpi-value&quot;&gt;&lt;%= todaysReminderSlots %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-note&quot;&gt;Medication/time combinations for today&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;health-kpi-card health-kpi-warning&quot;&gt;\n\t\t\t&lt;div class=&quot;health-kpi-top&quot;&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-label&quot;&gt;Pending prescription reviews&lt;/p&gt;\n\t\t\t\t&lt;span class=&quot;health-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;health-kpi-value&quot;&gt;&lt;%= pendingReviews %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;health-kpi-note&quot;&gt;Extracted or failed OCR not yet saved&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Quick_Actions' elementName='Quick_Actions'>\n\t\t\t\t\t<![CDATA[htmlpage Quick_Actions()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;style&gt;\n.health-actions-shell { padding: 0 20px 20px; background: var(--zcs-page-bg-color); box-sizing: border-box; }\n.health-actions-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }\n.zcs-quick-actions-wrapper { height: 100%; }\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }\n.health-action-card { min-height: 96px; transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; }\n.health-action-card:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(18,19,43,0.07); }\n.health-action-card .zcs-quick-action-link { height: 100%; align-items: flex-start; }\n.health-action-icon { width: 38px; height: 38px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); font-size: 18px; flex: 0 0 auto; }\n.health-action-copy { min-width: 0; }\n.health-action-subtext { display: block; margin-top: 4px; color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.35; }\n@media (max-width: 1100px) { .health-actions-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }\n@media (max-width: 700px) { .health-actions-shell { padding: 0 12px 12px; } .health-actions-grid { grid-template-columns: 1fr; gap: 10px; } .health-action-card { min-height: auto; } }\n&lt;/style&gt;\n&lt;div class=&quot;health-actions-shell&quot;&gt;\n\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Caregiver shortcuts&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;ul class=&quot;health-actions-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Family_Members&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-copy&quot;&gt;&lt;span class=&quot;zcs-quick-action-text zcs-font-medium&quot;&gt;Add Family Member&lt;/span&gt;&lt;span class=&quot;health-action-subtext&quot;&gt;Create a household profile&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Medications&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-copy&quot;&gt;&lt;span class=&quot;zcs-quick-action-text zcs-font-medium&quot;&gt;Log Medication&lt;/span&gt;&lt;span class=&quot;health-action-subtext&quot;&gt;Add a medicine schedule&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Health_Records&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-copy&quot;&gt;&lt;span class=&quot;zcs-quick-action-text zcs-font-medium&quot;&gt;Add Health Record&lt;/span&gt;&lt;span class=&quot;health-action-subtext&quot;&gt;Store visits, labs, and notes&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Prescription_Scans&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-copy&quot;&gt;&lt;span class=&quot;zcs-quick-action-text zcs-font-medium&quot;&gt;Scan Prescription&lt;/span&gt;&lt;span class=&quot;health-action-subtext&quot;&gt;Upload image or PDF for OCR&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card health-action-card zcs-px-12 zcs-py-12 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-gap-10 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Page:Todays_Reminders&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;health-action-copy&quot;&gt;&lt;span class=&quot;zcs-quick-action-text zcs-font-medium&quot;&gt;View Today&apos;s Reminders&lt;/span&gt;&lt;span class=&quot;health-action-subtext&quot;&gt;Open the reminder schedule&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='60%'>\n\t\t\t\t<dsp id='Recent_Activity' elementName='Recent_Activity'>\n\t\t\t\t\t<![CDATA[htmlpage Recent_Activity()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\townerEmail = zoho.loginuser;\n%&gt;\n&lt;style&gt;\n:root {\n\t--zcs-thead-color: #F9FAFE;\n\t--zcs-tr-h-color: #F9FAFE;\n\t--zcs-tgroup-color: #F1F2F8;\n\t--zcs-tgroup-h-color: #F1F2F8;\n\t--zcs-zebra-head-color: #F1F2F8;\n\t--zcs-zebra-odd-color: var(--zcs-white-color);\n\t--zcs-zebra-even-color: #F9FAFE;\n\t--zcs-zebra-h-color: #F1F2F8;\n}\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0px; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr:first-child:hover td { border-color: var(--zcs_tertiary_border_color); }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.activity-shell { padding: 0 10px 20px 20px; background: var(--zcs-page-bg-color); box-sizing: border-box; }\n.activity-card { height: 100%; min-height: 460px; box-shadow: 0 10px 26px rgba(18,19,43,0.05); }\n.activity-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; }\n.activity-section-title h6 { margin: 0; }\n.activity-list { display: flex; flex-direction: column; gap: 10px; }\n.activity-item { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 10px; padding: 12px; box-sizing: border-box; background: var(--zcs-white-color); }\n.activity-item-top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }\n.activity-item-title { margin: 0; color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; line-height: 1.3; }\n.activity-item-meta { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.4; }\n.activity-item-desc { margin: 8px 0 0; color: var(--zcs-teritiary-text-color); font-size: 12px; line-height: 1.45; }\n.activity-empty { border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 10px; padding: 18px; color: var(--zcs-secondary-text-color); text-align: center; font-size: 13px; }\n.activity-link { color: var(--zcs_brand_color); font-size: 12px; white-space: nowrap; }\n@media (max-width: 900px) { .activity-shell { padding: 0 12px 12px; } .activity-card { min-height: auto; } }\n&lt;/style&gt;\n&lt;div class=&quot;activity-shell&quot;&gt;\n\t&lt;div class=&quot;activity-card zcs-card zcs-flex zcs-direction-column zcs-gap-18 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Recent activity&lt;/h5&gt;\n\t\t\t&lt;a class=&quot;activity-link&quot; href=&quot;#Report:Health_Record_Timeline&quot;&gt;View timeline&lt;/a&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;activity-section-title&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;Latest health records&lt;/h6&gt;\n\t\t\t\t&lt;a class=&quot;activity-link&quot; href=&quot;#Report:All_Health_Records&quot;&gt;All records&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;activity-list&quot;&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\trecordCount = 0;\n\t\t\t\t\tfor each rec in Health_Records[Owner_Email == ownerEmail] sort by Record_Date desc\n\t\t\t\t\t{\n\t\t\t\t\t\tif(recordCount &lt; 5)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trecordCount = recordCount + 1;\n\t\t\t\t\t\t\tmemberName = ifnull(rec.Member.Full_Name,&quot;Family member&quot;);\n\t\t\t\t\t\t\trecordType = ifnull(rec.Record_Type,&quot;Health record&quot;);\n\t\t\t\t\t\t\trecordDate = if(rec.Record_Date != null,rec.Record_Date.toString(&quot;dd-MMM-yyyy&quot;),&quot;No date&quot;);\n\t\t\t\t\t\t\tdescText = ifnull(rec.Description,&quot;&quot;);\n\t\t\t\t%&gt;\n\t\t\t\t&lt;div class=&quot;activity-item&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;activity-item-top&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;activity-item-title&quot;&gt;&lt;%= recordType %&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;activity-item-meta&quot;&gt;&lt;%= memberName %&gt; | &lt;%= recordDate %&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;activity-link&quot; href=&quot;#Report:All_Health_Records?ID=&lt;%= rec.ID %&gt;&quot;&gt;Open&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;% if(descText != &quot;&quot;) { %&gt;\n\t\t\t\t\t&lt;p class=&quot;activity-item-desc&quot;&gt;&lt;%= descText %&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(recordCount == 0)\n\t\t\t\t\t{\n\t\t\t\t%&gt;\n\t\t\t\t&lt;div class=&quot;activity-empty&quot;&gt;No health records yet. Use Add Health Record to start the timeline.&lt;/div&gt;\n\t\t\t\t&lt;% } %&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;activity-section-title&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;Recent prescription scans&lt;/h6&gt;\n\t\t\t\t&lt;a class=&quot;activity-link&quot; href=&quot;#Report:All_Prescription_Scans&quot;&gt;All scans&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Member&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Scan date&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;OCR status&lt;/th&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-2 zcs-box-border&quot; colspan=&quot;3&quot;&gt; &lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tscanCount = 0;\n\t\t\t\t\t\tfor each scan in Prescription_Scans[Owner_Email == ownerEmail] sort by Scan_Date desc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(scanCount &lt; 5)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tscanCount = scanCount + 1;\n\t\t\t\t\t\t\t\tscanMember = ifnull(scan.Member.Full_Name,&quot;Family member&quot;);\n\t\t\t\t\t\t\t\tscanDate = if(scan.Scan_Date != null,scan.Scan_Date.toString(&quot;dd-MMM-yyyy&quot;),&quot;No date&quot;);\n\t\t\t\t\t\t\t\tscanStatus = ifnull(scan.OCR_Status,&quot;Uploaded&quot;);\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t\t\t\t\tif(scanStatus == &quot;Extracted&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(scanStatus == &quot;OCR Failed&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(scanStatus == &quot;Processing&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(scanStatus == &quot;Uploaded&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= scanMember %&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= scanDate %&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled &lt;%= badgeClass %&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= scanStatus %&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(scanCount == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot; colspan=&quot;3&quot;&gt;No prescription scans yet.&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;% } %&gt;\n\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='40%'>\n\t\t\t\t<dsp id='Upcoming_Reminders' elementName='Upcoming_Reminders'>\n\t\t\t\t\t<![CDATA[htmlpage Upcoming_Reminders()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttoday = zoho.currentdate;\n\townerEmail = zoho.loginuser;\n%&gt;\n&lt;style&gt;\n.reminders-shell { padding: 0 20px 20px 10px; background: var(--zcs-page-bg-color); box-sizing: border-box; }\n.reminders-card { min-height: 460px; box-shadow: 0 10px 26px rgba(18,19,43,0.05); }\n.reminder-list { display: flex; flex-direction: column; gap: 10px; }\n.reminder-item { display: grid; grid-template-columns: minmax(72px, 92px) minmax(0, 1fr) auto; gap: 12px; align-items: center; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; background: var(--zcs-white-color); padding: 12px; box-sizing: border-box; }\n.reminder-time { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 42px; border-radius: 10px; color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); font-size: 14px; font-weight: 700; }\n.reminder-title { margin: 0; color: var(--zcs-primary-text-color); font-size: 14px; font-weight: 600; line-height: 1.3; }\n.reminder-meta { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 12px; line-height: 1.4; }\n.reminder-empty { border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 12px; padding: 24px; text-align: center; color: var(--zcs-secondary-text-color); background: var(--zcs-white-color); }\n.reminder-empty i { display: block; margin-bottom: 8px; color: var(--zcs_brand_color); font-size: 28px; }\n.reminder-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 14px; }\n.reminder-footer a { color: var(--zcs_brand_color); font-size: 13px; font-weight: 500; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n@media (max-width: 900px) { .reminders-shell { padding: 0 12px 12px; } .reminders-card { min-height: auto; } }\n@media (max-width: 576px) { .reminder-item { grid-template-columns: 1fr; align-items: flex-start; } .reminder-time { justify-content: flex-start; padding: 0 12px; width: fit-content; } .reminder-footer { flex-direction: column; align-items: flex-start; } }\n&lt;/style&gt;\n&lt;div class=&quot;reminders-shell&quot;&gt;\n\t&lt;div class=&quot;reminders-card zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Upcoming reminders&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;%= today.toString(&quot;dd-MMM-yyyy&quot;) %&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;reminder-list&quot;&gt;\n\t\t\t&lt;%\n\t\t\t\treminderRows = List();\n\t\t\t\tfor each med in Medications[Owner_Email == ownerEmail &amp;&amp; Is_Active == true &amp;&amp; Start_Date &lt;= today &amp;&amp; (End_Date == null || End_Date &gt;= today)] sort by Medicine_Name asc\n\t\t\t\t{\n\t\t\t\t\tif(med.Reminder_Times != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tfor each slot in med.Reminder_Times\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tslotText = slot.toString();\n\t\t\t\t\t\t\treminderRows.add(slotText + &quot;|&quot; + med.ID);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treminderRows = reminderRows.sort(true);\n\t\t\t\trowCount = 0;\n\t\t\t\tfor each reminderKey in reminderRows\n\t\t\t\t{\n\t\t\t\t\tif(rowCount &lt; 8)\n\t\t\t\t\t{\n\t\t\t\t\t\tkeyParts = reminderKey.toList(&quot;|&quot;);\n\t\t\t\t\t\treminderTime = keyParts.get(0);\n\t\t\t\t\t\tmedicationId = keyParts.get(1).toLong();\n\t\t\t\t\t\tmedRows = Medications[ID == medicationId];\n\t\t\t\t\t\tif(medRows.count() &gt; 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmed = medRows;\n\t\t\t\t\t\t\trowCount = rowCount + 1;\n\t\t\t\t\t\t\tmemberName = ifnull(med.Member.Full_Name,&quot;Family member&quot;);\n\t\t\t\t\t\t\tmedicineName = ifnull(med.Medicine_Name,&quot;Medication&quot;);\n\t\t\t\t\t\t\tdosageText = ifnull(med.Dosage,&quot;Dosage not specified&quot;);\n\t\t\t\t\t\t\tsentLog = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Medication == med.ID &amp;&amp; Notify_Date == today &amp;&amp; Reminder_Time == reminderTime &amp;&amp; Email_Status == &quot;Sent&quot;];\n\t\t\t\t\t\t\tif(sentLog.count() &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\tbadgeText = &quot;Sent&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\tbadgeText = &quot;Scheduled&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t%&gt;\n\t\t\t&lt;div class=&quot;reminder-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;reminder-time&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%= reminderTime %&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;p class=&quot;reminder-title&quot;&gt;&lt;%= medicineName %&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p class=&quot;reminder-meta&quot;&gt;&lt;%= memberName %&gt; | &lt;%= dosageText %&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled &lt;%= badgeClass %&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= badgeText %&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(rowCount == 0)\n\t\t\t\t{\n\t\t\t%&gt;\n\t\t\t&lt;div class=&quot;reminder-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;No active medication reminders are configured for today.&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;reminder-footer&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary&quot;&gt;Showing the next available fixed reminder slots.&lt;/span&gt;\n\t\t\t&lt;a href=&quot;#Page:Todays_Reminders&quot;&gt;View Today&apos;s Reminders&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Todays_Reminders
		{
					displayname = "Today's Reminders"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Reminder_Summary' elementName='Reminder_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Reminder_Summary()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttoday = zoho.currentdate;\n\townerEmail = zoho.loginuser;\n\tfixedSlots = {&quot;06:00&quot;,&quot;08:00&quot;,&quot;10:00&quot;,&quot;12:00&quot;,&quot;14:00&quot;,&quot;16:00&quot;,&quot;18:00&quot;,&quot;20:00&quot;,&quot;22:00&quot;};\n\ttotalDueSlots = 0;\n\tpendingSlots = 0;\n\tfor each med in Medications[Owner_Email == ownerEmail &amp;&amp; Is_Active == true &amp;&amp; Start_Date &lt;= today &amp;&amp; (End_Date == null || End_Date &gt;= today)]\n\t{\n\t\tfor each slot in fixedSlots\n\t\t{\n\t\t\tif(med.Reminder_Times != null &amp;&amp; med.Reminder_Times.contains(slot))\n\t\t\t{\n\t\t\t\ttotalDueSlots = totalDueSlots + 1;\n\t\t\t\tsentRows = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Medication == med.ID &amp;&amp; Reminder_Time == slot &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Sent&quot;];\n\t\t\t\tfailedRows = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Medication == med.ID &amp;&amp; Reminder_Time == slot &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Failed&quot;];\n\t\t\t\tif(sentRows.count() == 0 &amp;&amp; failedRows.count() == 0)\n\t\t\t\t{\n\t\t\t\t\tpendingSlots = pendingSlots + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\talreadyNotified = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Sent&quot;].count();\n\tfailedReminderEmails = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Failed&quot;].count();\n\tsentPercent = 0;\n\tif(totalDueSlots &gt; 0)\n\t{\n\t\tsentPercent = (alreadyNotified * 100) / totalDueSlots;\n\t\tif(sentPercent &gt; 100)\n\t\t{\n\t\t\tsentPercent = 100;\n\t\t}\n\t}\n%&gt;\n&lt;style&gt;\n/* ZCS global utility sheet is included once for the Todays_Reminders page. */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color); --zcs-light-bg-color: var(--zcs_brand_light_color); --zcs-app-header-color: #1c1c40; --zcs-page-bg-color: #F3F3F4; --zcs-primary-text-color: var(--zcs_primary_text_color); --zcs-secondary-text-color: var(--zcs_secondary_text_color); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color); --zcs-border-color: var(--zcs_tertiary_border_color); --zcs-placeholder-color: #878895; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; --zcs-primary-btn-color: var(--zcs_brand_color); --zcs-primary-btn-border-color: var(--zcs_brand_color); --zcs-primary-btn-text-color: var(--zcs_brand_foreground_color); --zcs-tooltip-bg-color: #363636; font-size: 16px; line-height: 1.5; --column-gap: 0px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-col-common { flex: 1 1 0%; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-justify-center { justify-content: center; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-gap-4 { gap: 0.25rem; --column-gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; --column-gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; --column-gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; --column-gap: 0.75rem; }\n.zcs-gap-14 { gap: 0.875rem; --column-gap: 0.875rem; }\n.zcs-gap-16 { gap: 1rem; --column-gap: 1rem; }\n.zcs-gap-18 { gap: 1.125rem; --column-gap: 1.125rem; }\n.zcs-gap-20 { gap: 1.25rem; --column-gap: 1.25rem; }\n.zcs-p-0 { padding: 0rem; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-10 { padding: 0.625rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-14 { padding: 0.875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-18 { padding: 1.125rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-4 { padding-top: 0.25rem; padding-bottom: 0.25rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-m-0 { margin: 0rem; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-6 { margin-top: 0.375rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mt-12 { margin-top: 0.75rem; }\n.zcs-mx-0 { margin-left: 0rem; margin-right: 0rem; }\n.zcs-mb-0 { margin-bottom: 0rem; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-40 { font-size: 40px; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n/* Card component: card-template-default, adapted for read-only reminder cards. */\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-template-card-badge { top: 0px; right: 0px; background-color: var(--theme_brand_color); border-bottom-left-radius: 32px; }\n/* Badge component: badge-badge-with-icon. */\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color); border-color: var(--zcs_brand_color); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #b8770d; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n/* Table component: table-simple-table. */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; --zcs-tgroup-color: #F1F2F8; --zcs-tgroup-h-color: #F1F2F8; }\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0px; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0px -1px 0px 0px var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n/* Today&apos;s Reminders page styles. */\n.reminder-page { background: var(--zcs-page-bg-color); padding: 18px 20px 0; box-sizing: border-box; }\n.reminder-hero { min-height: 108px; border-radius: 18px; padding: 20px; background: linear-gradient(135deg, var(--zcs_brand_color), #1094C5); color: var(--zcs-white-color); box-shadow: 0 14px 30px rgba(18,19,43,0.10); }\n.reminder-hero h2, .reminder-hero p { color: var(--zcs-white-color); }\n.reminder-hero-icon { width: 48px; height: 48px; border-radius: 16px; background: rgba(255,255,255,0.18); font-size: 26px; }\n.reminder-metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }\n.reminder-page .rem-metric-card, .reminder-page .rem-med-card { width: auto; height: auto; min-height: 0; overflow: visible; box-shadow: 0 10px 24px rgba(18,19,43,0.05); }\n.rem-metric-value { font-size: 32px; line-height: 1; font-weight: 700; color: var(--zcs-primary-text-color); }\n.rem-metric-icon { width: 38px; height: 38px; border-radius: 12px; font-size: 20px; }\n.rem-metric-icon.total { color: var(--zcs_brand_color); background: var(--zcs_brand_light_color); }\n.rem-metric-icon.sent { color: #179E6C; background: #E4FCF3; }\n.rem-metric-icon.pending { color: #b8770d; background: #FCF4E6; }\n.rem-metric-icon.failed { color: #FE455D; background: #FDE3E6; }\n.reminder-progress { height: 8px; border-radius: 20px; overflow: hidden; background: #EFF1F7; }\n.reminder-progress span { display: block; height: 100%; border-radius: inherit; background: var(--zcs_brand_color); }\n.reminder-chip-row { margin-top: 14px; }\n.reminder-chip-row .zcs-badge { min-height: 30px; }\n.rem-section-shell { padding: 16px 20px 0; background: var(--zcs-page-bg-color); box-sizing: border-box; }\n.rem-section-card { box-shadow: 0 10px 24px rgba(18,19,43,0.05); }\n.rem-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.rem-section-heading h3 { margin: 0; color: var(--zcs-primary-text-color); font-size: 20px; line-height: 1.25; font-weight: 700; }\n.rem-section-heading p { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.rem-member-group { margin-top: 16px; border: 1px solid var(--zcs_tertiary_border_color); border-radius: 16px; overflow: hidden; background: var(--zcs-white-color); }\n.rem-member-header { background: var(--zcs_brand_light_color); padding: 14px 16px; color: var(--zcs_brand_color); font-weight: 700; }\n.rem-time-group { padding: 14px 16px 16px; border-top: 1px solid var(--zcs_tertiary_border_color); }\n.rem-time-title { display: inline-flex; align-items: center; gap: 8px; color: var(--zcs-primary-text-color); font-size: 15px; font-weight: 700; margin-bottom: 12px; }\n.rem-med-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.rem-med-name { font-size: 16px; font-weight: 700; color: var(--zcs-primary-text-color); margin: 0; }\n.rem-med-meta { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; line-height: 1.45; }\n.rem-notes { margin-top: 10px; padding: 10px; border-radius: 10px; background: #F9FAFE; color: var(--zcs-secondary-text-color); font-size: 13px; line-height: 1.45; }\n.rem-empty { border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 14px; background: var(--zcs-white-color); color: var(--zcs-secondary-text-color); min-height: 120px; }\n.rem-log-footer { margin-top: 12px; display: flex; justify-content: flex-end; }\n.rem-log-footer a { color: var(--zcs_brand_color); font-size: 13px; font-weight: 600; }\n@media (max-width: 1100px) { .reminder-metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .rem-med-grid { grid-template-columns: 1fr; } }\n@media (max-width: 700px) { .reminder-page, .rem-section-shell { padding-left: 12px; padding-right: 12px; } .reminder-hero { flex-direction: column; align-items: flex-start; } .reminder-metric-grid { grid-template-columns: 1fr; } .rem-section-heading { flex-direction: column; align-items: flex-start; } }\n&lt;/style&gt;\n&lt;div class=&quot;reminder-page&quot;&gt;\n\t&lt;div class=&quot;reminder-hero zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-box-border&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Today, &lt;%= today.toString(&quot;dd-MMM-yyyy&quot;) %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10&quot;&gt;Today&apos;s Reminders&lt;/h2&gt;\n\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-6&quot;&gt;Read-only medication plan for your household, grouped by family member and fixed reminder time.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;reminder-hero-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&quot;&gt;&lt;i class=&quot;zc-li-outline health-pill-container-44&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;reminder-metric-grid&quot;&gt;\n\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative rem-metric-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Total due slots&lt;/h6&gt;\n\t\t\t\t&lt;span class=&quot;rem-metric-icon total zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rem-metric-value&quot;&gt;&lt;%= totalDueSlots %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Active medication doses scheduled today.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative rem-metric-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Already notified&lt;/h6&gt;\n\t\t\t\t&lt;span class=&quot;rem-metric-icon sent zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rem-metric-value&quot;&gt;&lt;%= alreadyNotified %&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;reminder-progress zcs-mt-12&quot;&gt;&lt;span style=&quot;width:&lt;%= sentPercent %&gt;%&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Reminder_Log records with Email Status = Sent.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative rem-metric-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending&lt;/h6&gt;\n\t\t\t\t&lt;span class=&quot;rem-metric-icon pending zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rem-metric-value&quot;&gt;&lt;%= pendingSlots %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Due slots without a Sent or Failed log yet.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative rem-metric-card&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;h6 class=&quot;zcs-font-15 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Failed emails&lt;/h6&gt;\n\t\t\t\t&lt;span class=&quot;rem-metric-icon failed zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rem-metric-value&quot;&gt;&lt;%= failedReminderEmails %&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0 zcs-mt-8&quot;&gt;Reminder_Log records with Email Status = Failed.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&quot;reminder-chip-row zcs-flex zcs-row-wrap zcs-gap-10&quot;&gt;\n\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Fixed slots: 06:00 to 22:00&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Email schedules handle sending&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Read-only view&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Grouped_Reminders' elementName='Grouped_Reminders'>\n\t\t\t\t\t<![CDATA[htmlpage Grouped_Reminders()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttoday = zoho.currentdate;\n\townerEmail = zoho.loginuser;\n\tfixedSlots = {&quot;06:00&quot;,&quot;08:00&quot;,&quot;10:00&quot;,&quot;12:00&quot;,&quot;14:00&quot;,&quot;16:00&quot;,&quot;18:00&quot;,&quot;20:00&quot;,&quot;22:00&quot;};\n\trenderedGroups = 0;\n%&gt;\n&lt;div class=&quot;rem-section-shell&quot;&gt;\n\t&lt;div class=&quot;rem-section-card zcs-card zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;rem-section-heading&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h3&gt;Medication plan by family member&lt;/h3&gt;\n\t\t\t\t&lt;p&gt;Each card is a due medication slot for today. Status is read from Reminder_Log for the same medication, time, and date.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-theme zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline health-pill-container-44&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Active medications only&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\tfor each member in Family_Members[Owner_Email == ownerEmail] sort by Full_Name asc\n\t\t\t{\n\t\t\t\tmemberHasAny = false;\n\t\t\t\tfor each slot in fixedSlots\n\t\t\t\t{\n\t\t\t\t\tslotCount = 0;\n\t\t\t\t\tfor each med in Medications[Owner_Email == ownerEmail &amp;&amp; Member == member.ID &amp;&amp; Is_Active == true &amp;&amp; Start_Date &lt;= today &amp;&amp; (End_Date == null || End_Date &gt;= today)]\n\t\t\t\t\t{\n\t\t\t\t\t\tif(med.Reminder_Times != null &amp;&amp; med.Reminder_Times.contains(slot))\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tslotCount = slotCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(slotCount &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tif(memberHasAny == false)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmemberHasAny = true;\n\t\t\t\t\t\t\trenderedGroups = renderedGroups + 1;\n\t\t%&gt;\n\t\t&lt;div class=&quot;rem-member-group&quot;&gt;\n\t\t\t&lt;div class=&quot;rem-member-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;span&gt;&lt;%= ifnull(member.Full_Name,&quot;Family member&quot;) %&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= ifnull(member.Relation,&quot;Household&quot;) %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t%&gt;\n\t\t\t&lt;div class=&quot;rem-time-group&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rem-time-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%= slot %&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;rem-med-grid&quot;&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tfor each med in Medications[Owner_Email == ownerEmail &amp;&amp; Member == member.ID &amp;&amp; Is_Active == true &amp;&amp; Start_Date &lt;= today &amp;&amp; (End_Date == null || End_Date &gt;= today)]\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif(med.Reminder_Times != null &amp;&amp; med.Reminder_Times.contains(slot))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tmedicineName = ifnull(med.Medicine_Name,&quot;Medication&quot;);\n\t\t\t\t\t\t\t\tdosageText = ifnull(med.Dosage,&quot;Dosage not specified&quot;);\n\t\t\t\t\t\t\t\tfrequencyText = ifnull(med.Frequency,&quot;Frequency not specified&quot;);\n\t\t\t\t\t\t\t\tnotesText = ifnull(med.Notes,&quot;&quot;);\n\t\t\t\t\t\t\t\tif(notesText == &quot;&quot;)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tnotesText = &quot;No notes&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tsentRows = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Medication == med.ID &amp;&amp; Reminder_Time == slot &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Sent&quot;];\n\t\t\t\t\t\t\t\tfailedRows = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Medication == med.ID &amp;&amp; Reminder_Time == slot &amp;&amp; Notify_Date == today &amp;&amp; Email_Status == &quot;Failed&quot;];\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\tbadgeText = &quot;Pending&quot;;\n\t\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline loader-dots-06&quot;;\n\t\t\t\t\t\t\t\tif(sentRows.count() &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\tbadgeText = &quot;Sent&quot;;\n\t\t\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse if(failedRows.count() &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\tbadgeText = &quot;Failed&quot;;\n\t\t\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative rem-med-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-header zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;rem-med-name&quot;&gt;&lt;%= medicineName %&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%= badgeClass %&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink &lt;%= badgeIcon %&gt;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= badgeText %&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;rem-med-meta&quot;&gt;&lt;strong&gt;Dosage:&lt;/strong&gt; &lt;%= dosageText %&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;rem-med-meta&quot;&gt;&lt;strong&gt;Frequency:&lt;/strong&gt; &lt;%= frequencyText %&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rem-notes&quot;&gt;&lt;%= notesText %&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(memberHasAny == true)\n\t\t\t\t{\n\t\t%&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(renderedGroups == 0)\n\t\t\t{\n\t\t%&gt;\n\t\t&lt;div class=&quot;zcs-nodata-wrapper rem-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-30 zcs-color-theme&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No active medication reminders are due today.&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\t}\n\t\t%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Reminder_Log_Table' elementName='Reminder_Log_Table'>\n\t\t\t\t\t<![CDATA[htmlpage Reminder_Log_Table()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t\t&lt;%\n\ttoday = zoho.currentdate;\n\townerEmail = zoho.loginuser;\n\tlogCount = Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Notify_Date == today].count();\n%&gt;\n&lt;div class=&quot;rem-section-shell&quot;&gt;\n\t&lt;div class=&quot;rem-section-card zcs-card zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;rem-section-heading&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;h3&gt;Today&apos;s reminder delivery log&lt;/h3&gt;\n\t\t\t\t&lt;p&gt;Audit trail for emails recorded today. The page only reads Reminder_Log and does not send notifications.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-time&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= logCount %&gt; log records&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;%\n\t\t\tif(logCount &gt; 0)\n\t\t\t{\n\t\t%&gt;\n\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Member&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Medication&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Reminder Time&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Notified At&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Email Status&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Notes&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;6&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\tfor each logRow in Reminder_Log[Owner_Email == ownerEmail &amp;&amp; Notify_Date == today] sort by Reminder_Time asc\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmemberName = ifnull(logRow.Member.Full_Name,&quot;Family member&quot;);\n\t\t\t\t\t\t\tmedicationName = ifnull(logRow.Medication.Medicine_Name,&quot;Medication&quot;);\n\t\t\t\t\t\t\treminderTime = ifnull(logRow.Reminder_Time,&quot;-&quot;);\n\t\t\t\t\t\t\tnotifiedAtText = &quot;-&quot;;\n\t\t\t\t\t\t\tif(logRow.Notified_At != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tnotifiedAtText = logRow.Notified_At.toString(&quot;dd-MMM-yyyy HH:mm&quot;);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tstatusText = ifnull(logRow.Email_Status,&quot;Pending&quot;);\n\t\t\t\t\t\t\tnotesText = ifnull(logRow.Notes,&quot;&quot;);\n\t\t\t\t\t\t\tif(notesText == &quot;&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tnotesText = &quot;-&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline loader-dots-06&quot;;\n\t\t\t\t\t\t\tif(statusText == &quot;Sent&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\telse if(statusText == &quot;Failed&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tbadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\tbadgeIcon = &quot;zc-li-outline ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= memberName %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= medicationName %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= reminderTime %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= notifiedAtText %&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline &lt;%= badgeClass %&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zcs-badge-icon zcs-no-shrink &lt;%= badgeIcon %&gt;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%= statusText %&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/span&gt;\n\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%= notesText %&gt;&lt;/td&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;rem-log-footer&quot;&gt;&lt;a href=&quot;#Report:Todays_Reminder_Log&quot;&gt;Open full reminder log report&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t%&gt;\n\t\t&lt;div class=&quot;zcs-nodata-wrapper rem-empty zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline files-time zcs-font-30 zcs-color-theme&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No reminder emails have been logged today.&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;rem-log-footer&quot;&gt;&lt;a href=&quot;#Report:Todays_Reminder_Log&quot;&gt;Open full reminder log report&lt;/a&gt;&lt;/div&gt;\n\t\t&lt;%\n\t\t\t}\n\t\t%&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Family_Members_On_Validate as "Family Members On Validate"
			{
			    type = form
			    form = Family_Members
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Owner_Email == null || input.Owner_Email == "")
			                {
			                    input.Owner_Email = zoho.loginuser;
			                }
			                if(input.Owner_Email != null && input.Owner_Email != "" && input.Owner_Email != zoho.loginuser)
			                {
			                    alert "You are not authorized to submit this family member record.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Health_Records_On_Validate as "Health Records On Validate"
			{
			    type = form
			    form = Health_Records
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Owner_Email == null || input.Owner_Email == "")
			                {
			                    input.Owner_Email = zoho.loginuser;
			                }
			                if(input.Owner_Email != zoho.loginuser)
			                {
			                    alert "You are not authorized to submit this health record.";
			                    cancel submit;
			                }
			                member_record = Family_Members[ID == input.Member];
			                if(member_record.count() == 0 || member_record.Owner_Email != zoho.loginuser)
			                {
			                    alert "Please select a family member that belongs to your household.";
			                    cancel submit;
			                }
			                if(input.Timeline_Date_Time == null && input.Record_Date != null)
			                {
			                    input.Timeline_Date_Time = input.Record_Date.toString("dd-MMM-yyyy") + " 09:00:00";
			                }
			            )
			        }
			    }
			}

			Medications_On_Validate as "Medications On Validate"
			{
			    type = form
			    form = Medications
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Owner_Email == null || input.Owner_Email == "")
			                {
			                    input.Owner_Email = zoho.loginuser;
			                }
			                if(input.Owner_Email != zoho.loginuser)
			                {
			                    alert "You are not authorized to submit this medication.";
			                    cancel submit;
			                }
			                member_record = Family_Members[ID == input.Member];
			                if(member_record.count() == 0 || member_record.Owner_Email != zoho.loginuser)
			                {
			                    alert "Please select a family member that belongs to your household.";
			                    cancel submit;
			                }
			                if(input.End_Date != null && input.Start_Date != null && input.End_Date < input.Start_Date)
			                {
			                    alert "End Date cannot be earlier than Start Date.";
			                    cancel submit;
			                }
			                if(input.Is_Active == true && (input.Reminder_Times == null || input.Reminder_Times.isEmpty()))
			                {
			                    alert "Select at least one reminder time for an active medication.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Prescription_Scans_On_Success as "Prescription Scans On Success"
			{
			    type = form
			    form = Prescription_Scans
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                current_scan = Prescription_Scans[ID == input.ID];
			                if(input.Prescription_File != null && (input.OCR_Status == null || input.OCR_Status == "" || input.OCR_Status == "Uploaded"))
			                {
			                    current_scan.OCR_Status = "Processing";
			                    try
			                    {
			                        ai_response = zoho.ai.recognizeText(input.Prescription_File,"DOCUMENTROTATE","eng");
			                        extracted_text = ai_response.getJSON("text");
			                        status_flag = ai_response.getJSON("status");
			                        if(extracted_text != null && extracted_text != "")
			                        {
			                            current_scan.Extracted_Text = extracted_text;
			                            if(current_scan.Reviewed_Text == null || current_scan.Reviewed_Text == "")
			                            {
			                                current_scan.Reviewed_Text = extracted_text;
			                            }
			                            current_scan.OCR_Status = "Extracted";
			                            current_scan.Error_Message = "";
			                        }
			                        else
			                        {
			                            current_scan.OCR_Status = "OCR Failed";
			                            current_scan.Error_Message = ifnull(ai_response.getJSON("statusMessage"),"No text was extracted from the prescription file.");
			                        }
			                    }
			                    catch(e)
			                    {
			                        current_scan.OCR_Status = "OCR Failed";
			                        current_scan.Error_Message = e.message;
			                    }
			                }
			                if(current_scan.Save_As_Health_Record == true && current_scan.Saved_Health_Record == null)
			                {
			                    record_text = current_scan.Reviewed_Text;
			                    if(record_text == null || record_text == "")
			                    {
			                        record_text = current_scan.Extracted_Text;
			                    }
			                    if(record_text != null && record_text != "")
			                    {
			                        health_record_id = insert into Health_Records
			                        [
			                            Member = current_scan.Member
			                            Record_Type = "Prescription"
			                            Record_Date = current_scan.Scan_Date
			                            Timeline_Date_Time = zoho.currenttime
			                            Description = "Prescription saved from scan"
			                            OCR_Text = record_text
			                            Source = "Prescription Scan"
			                            Owner_Email = current_scan.Owner_Email
			                        ];
			                        current_scan.Saved_Health_Record = health_record_id;
			                        current_scan.OCR_Status = "Saved";
			                    }
			                }
			            )
			        }
			    }
			}

			Prescription_Scans_On_Validate as "Prescription Scans On Validate"
			{
			    type = form
			    form = Prescription_Scans
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Owner_Email == null || input.Owner_Email == "")
			                {
			                    input.Owner_Email = zoho.loginuser;
			                }
			                if(input.Owner_Email != zoho.loginuser)
			                {
			                    alert "You are not authorized to submit this prescription scan.";
			                    cancel submit;
			                }
			                member_record = Family_Members[ID == input.Member];
			                if(member_record.count() == 0 || member_record.Owner_Email != zoho.loginuser)
			                {
			                    alert "Please select a family member that belongs to your household.";
			                    cancel submit;
			                }
			                if(input.Prescription_File != null)
			                {
			                    file_suffix = input.Prescription_File.getSuffix(".").toLowerCase();
			                    if(file_suffix not in {"jpg","jpeg","png","webp","pdf"})
			                    {
			                        alert "Only JPG, PNG, WEBP, or PDF prescription files are allowed.";
			                        cancel submit;
			                    }
			                }
			                if(input.Save_As_Health_Record == true && (input.Reviewed_Text == null || input.Reviewed_Text == "") && (input.Extracted_Text == null || input.Extracted_Text == ""))
			                {
			                    alert "OCR or reviewed text is required before saving as a health record.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Reminder_Log_On_Validate as "Reminder Log On Validate"
			{
			    type = form
			    form = Reminder_Log
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Owner_Email == null || input.Owner_Email == "")
			                {
			                    input.Owner_Email = zoho.loginuser;
			                }
			                duplicate_logs = Reminder_Log[Medication == input.Medication && Reminder_Time == input.Reminder_Time && Notify_Date == input.Notify_Date && Owner_Email == input.Owner_Email && ID != input.ID];
			                if(duplicate_logs.count() > 0)
			                {
			                    alert "A reminder notification has already been logged for this medication, time, and date.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}
		}

		schedule
		{
			Medication_Reminder_0600 as "Medication Reminder 06:00"
			{
			    type = schedule
			    start = "2026-08-05 06:00:00"
			    frequency = daily
			    time zone = "Asia/Kolkata"
			
			    on start
			    {
			        actions
			        {
			            on load
			            (
			                slot = "06:00";
			                meds = Medications[Is_Active == true && Start_Date <= zoho.currentdate];
			                for each med in meds
			                {
			                    if((med.End_Date == null || med.End_Date >= zoho.currentdate) && med.Reminder_Times.contains(slot))
			                    {
			                        existing_log = Reminder_Log[Medication == med.ID && Reminder_Time == slot && Notify_Date == zoho.currentdate];
			                        if(existing_log.count() == 0)
			                        {
			                            member_name = "Family member";
			                            member_record = Family_Members[ID == med.Member];
			                            if(member_record.count() > 0)
			                            {
			                                member_name = member_record.Full_Name;
			                            }
			                            try
			                            {
			                                sendmail
			                                (
			                                    from : zoho.adminuserid
			                                    to : med.Owner_Email
			                                    subject : "Medication reminder: " + med.Medicine_Name
			                                    message : "Reminder for " + member_name + ": " + med.Medicine_Name + " is due at " + slot + ". Dosage: " + ifnull(med.Dosage,"Not specified") + ". Frequency: " + ifnull(med.Frequency,"Not specified") + ". Notes: " + ifnull(med.Notes,"None")
			                                )
			                                log_id = insert into Reminder_Log
			                                [
			                                    Medication = med.ID
			                                    Member = med.Member
			                                    Reminder_Time = slot
			                                    Notify_Date = zoho.currentdate
			                                    Notified_At = zoho.currenttime
			                                    Owner_Email = med.Owner_Email
			                                    Email_Status = "Sent"
			                                    Notes = "Reminder email sent."
			                                ];
			                            }
			                            catch(e)
			                            {
			                                log_id = insert into Reminder_Log
			                                [
			                                    Medication = med.ID
			                                    Member = med.Member
			                                    Reminder_Time = slot
			                                    Notify_Date = zoho.currentdate
			                                    Notified_At = zoho.currenttime
			                                    Owner_Email = med.Owner_Email
			                                    Email_Status = "Failed"
