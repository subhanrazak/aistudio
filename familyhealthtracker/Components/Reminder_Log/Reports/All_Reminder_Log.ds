list All_Reminder_Log
{
    displayName = "All Reminder Log"
    show all rows from Reminder_Log [Owner_Email == zoho.loginuser]
    (
        Member
        Medication
        Reminder_Time
        Notify_Date
        Notified_At
        Email_Status
        Notes
        Owner_Email
    )
    filters
    (
        Member
        Notify_Date
        Reminder_Time
        Email_Status
    )
    sort by
    (
        Notify_Date descending
        Reminder_Time descending
    )
}
