form Reminder_Log
{
    displayname = "Reminder Log"
    success message = "Reminder log saved successfully."
    Reminder_Info
    (
        type = section
        displayname = "Reminder Information"
        row = 1
        column = 0
    )
    must have Medication
    (
        type = picklist
        displayname = "Medication"
        values = Medications.ID
        displayformat = [Medicine_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Member
    (
        type = picklist
        displayname = "Family Member"
        values = Family_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Reminder_Time
    (
        type = picklist
        displayname = "Reminder Time"
        values = {"06:00","08:00","10:00","12:00","14:00","16:00","18:00","20:00","22:00"}
        row = 1
        column = 1
        width = medium
    )
    must have Notify_Date
    (
        type = date
        displayname = "Notify Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Notified_At
    (
        type = datetime
        displayname = "Notified At"
        row = 1
        column = 1
        width = medium
    )
    Delivery_Details
    (
        type = section
        displayname = "Delivery Details"
        visibility = true
        row = 2
        column = 1
    )
    Owner_Email
    (
        type = email
        displayname = "Caregiver Email"
        personal data = true
        isencrypted = true
        row = 2
        column = 1
        width = medium
    )
    Email_Status
    (
        type = picklist
        displayname = "Email Status"
        values = {"Sent","Failed","Skipped"}
        initial value = "Sent"
        row = 2
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        row = 2
        column = 1
        width = medium
        height = 100px
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save this reminder log"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
                tooltip = "Update this reminder log"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
