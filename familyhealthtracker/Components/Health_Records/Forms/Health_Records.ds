form Health_Records
{
    displayname = "Health Records"
    success message = "Health record saved successfully."
    record owner = Added_User
    Record_Info
    (
        type = section
        displayname = "Record Information"
        row = 1
        column = 0
    )
    must have Member
    (
        type = picklist
        displayname = "Family Member"
        values = Family_Members.ID
        displayformat = [Full_Name]
        allow new entries
        [
            displayname = "Add Family Member"
        ]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Record_Type
    (
        type = picklist
        displayname = "Record Type"
        values = {"Consultation","Lab Report","Prescription","Vaccination","Other"}
        row = 1
        column = 2
        width = medium
    )
    must have Record_Date
    (
        type = date
        displayname = "Record Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    Timeline_Date_Time
    (
        type = datetime
        displayname = "Timeline Date & Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )
    Clinical_Details
    (
        type = section
        displayname = "Clinical Details"
        visibility = true
        row = 2
        column = 1
    )
    Description
    (
        type = textarea
        displayname = "Description / Notes"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 1
        width = medium
        height = 140px
    )
    Doctor_Name
    (
        type = text
        displayname = "Doctor Name"
        personal data = true
        isephi = true
        row = 2
        column = 2
        width = medium
    )
    Hospital_Clinic
    (
        type = text
        displayname = "Hospital / Clinic"
        personal data = true
        isephi = true
        row = 2
        column = 2
        width = medium
    )
    Record_File
    (
        type = upload file
        displayname = "Attached File"
        browse = local_drive
        row = 2
        column = 1
        width = medium
    )
    OCR_Text
    (
        type = textarea
        displayname = "Prescription / OCR Text"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 2
        width = medium
        height = 160px
    )
    System_Details
    (
        type = section
        displayname = "System Details"
        visibility = true
        row = 3
        column = 1
    )
    Source
    (
        type = picklist
        displayname = "Source"
        values = {"Manual Entry","Prescription Scan"}
        initial value = "Manual Entry"
        row = 3
        column = 1
        width = medium
    )
    Owner_Email
    (
        type = email
        displayname = "Caregiver Email"
        personal data = true
        isencrypted = true
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save this health record"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
                tooltip = "Update this health record"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
