default list All_Health_Records
{
    displayName = "All Health Records"
    show all rows from Health_Records [Owner_Email == zoho.loginuser]
    (
        Member
        Record_Type
        Record_Date
        (
            displayformat = fulldate
        )
        Timeline_Date_Time
        (
            displayformat = dateonly
        )
        Description
        (
            foldcontent = enable
        )
        Doctor_Name
        Hospital_Clinic
        Record_File
        Source
        Owner_Email
    )
    filters
    (
        Member
        Record_Type
        Record_Date
        Source
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Member ascending
    )
    sort by
    (
        Record_Date descending
    )
}
