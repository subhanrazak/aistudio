timeline Health_Record_Timeline
{
    displayName = "Health Record Timeline"
    show all rows from Health_Records [Owner_Email == zoho.loginuser]
    (
        Member
        Record_Type
        Timeline_Date_Time
        Record_Date
        Description
        Doctor_Name
        Hospital_Clinic
        Source
        Owner_Email
    )
    filters
    (
        Member
        Record_Type
        Source
    )
    sort by
    (
        Timeline_Date_Time descending
    )
    options
    (
        display field = Record_Type
        start date = Timeline_Date_Time
    )
}
