default list All_Prescription_Scans
{
    displayName = "All Prescription Scans"
    show all rows from Prescription_Scans [Owner_Email == zoho.loginuser]
    (
        Member
        Prescription_File
        Scan_Date
        OCR_Status
        Extracted_Text
        (
            foldcontent = enable
        )
        Reviewed_Text
        (
            foldcontent = enable
        )
        Save_As_Health_Record
        Saved_Health_Record
        Error_Message
        Owner_Email
    )
    filters
    (
        Member
        Scan_Date
        OCR_Status
        Save_As_Health_Record
    )
    sort by
    (
        Scan_Date descending
    )
}
