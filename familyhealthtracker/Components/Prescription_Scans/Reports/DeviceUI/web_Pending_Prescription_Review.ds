report Pending_Prescription_Review
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Member
                    Prescription_File
                    Scan_Date
                    OCR_Status
                    Reviewed_Text
                    Save_As_Health_Record
                    Error_Message
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Member
                    Prescription_File
                    Scan_Date
                    OCR_Status
                    Reviewed_Text
                    Save_As_Health_Record
                    Error_Message
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
