form Prescription_Scans
{
    displayname = "Prescription Scans"
    success message = "Prescription scan saved successfully."
    record owner = Added_User
    Scan_Info
    (
        type = section
        displayname = "Scan Information"
        row = 1
        column = 0
    )
    must have Member
    (
        type = picklist
        displayname = "Family Member"
        values = Family_Members.ID
        displayformat = [Full_Name]
        allow new entries
        [
            displayname = "Add Family Member"
        ]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Prescription_File
    (
        type = upload file
        displayname = "Prescription Image / PDF"
        browse = local_drive
        row = 1
        column = 2
        width = medium
    )
    must have Scan_Date
    (
        type = date
        displayname = "Scan Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 1
        width = medium
    )
    OCR_Status
    (
        type = picklist
        displayname = "OCR Status"
        values = {"Uploaded","Processing","Extracted","OCR Failed","Saved"}
        initial value = "Uploaded"
        row = 1
        column = 2
        width = medium
    )
    OCR_Review
    (
        type = section
        displayname = "OCR Review"
        visibility = true
        row = 2
        column = 1
    )
    Extracted_Text
    (
        type = textarea
        displayname = "Extracted Text"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 1
        width = medium
        height = 180px
    )
    Reviewed_Text
    (
        type = textarea
        displayname = "Reviewed Text"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 2
        width = medium
        height = 180px
    )
    Save_As_Health_Record
    (
        type = checkbox
        displayname = "Save as Health Record"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    Saved_Health_Record
    (
        type = picklist
        displayname = "Saved Health Record"
        values = Health_Records.ID
        displayformat = [Record_Type]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    System_Details
    (
        type = section
        displayname = "System Details"
        visibility = true
        row = 3
        column = 1
    )
    Owner_Email
    (
        type = email
        displayname = "Caregiver Email"
        personal data = true
        isencrypted = true
        row = 3
        column = 1
        width = medium
    )
    Error_Message
    (
        type = textarea
        displayname = "Error Message"
        row = 3
        column = 2
        width = medium
        height = 100px
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save and run OCR"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
                tooltip = "Update this scan"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
