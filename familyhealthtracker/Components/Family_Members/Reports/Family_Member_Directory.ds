list Family_Member_Directory
{
    displayName = "Family Member Directory"
    show all rows from Family_Members [Owner_Email == zoho.loginuser]
    (
        Full_Name
        Relation
        Date_of_Birth
        Blood_Group
        Owner_Email
    )
    filters
    (
        Relation
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Relation ascending
    )
    sort by
    (
        Full_Name ascending
    )
}
