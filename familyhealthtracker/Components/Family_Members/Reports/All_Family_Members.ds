default list All_Family_Members
{
    displayName = "All Family Members"
    show all rows from Family_Members [Owner_Email == zoho.loginuser]
    (
        Full_Name
        Date_of_Birth
        (
            displayformat = fulldate
        )
        Relation
        Blood_Group
        Known_Allergies
        (
            foldcontent = enable
        )
        Notes
        (
            foldcontent = enable
        )
        Owner_Email
    )
    filters
    (
        Relation
        Blood_Group
    )
    sort by
    (
        Full_Name ascending
    )
}
