form Family_Members
{
    displayname = "Family Members"
    success message = "Family member saved successfully."
    record owner = Added_User
    Personal_Info
    (
        type = section
        displayname = "Personal Information"
        row = 1
        column = 0
    )
    must have Full_Name
    (
        type = text
        displayname = "Full Name"
        personal data = true
        isephi = true
        isencrypted = true
        row = 1
        column = 1
        width = medium
    )
    Date_of_Birth
    (
        type = date
        displayname = "Date of Birth"
        personal data = true
        isephi = true
        row = 1
        column = 2
        width = medium
    )
    must have Relation
    (
        type = picklist
        displayname = "Relation"
        values = {"Self","Spouse","Child","Parent","Grandparent","Sibling","Other"}
        row = 1
        column = 1
        width = medium
    )
    Blood_Group
    (
        type = picklist
        displayname = "Blood Group"
        values = {"A+","A-","B+","B-","AB+","AB-","O+","O-","Unknown"}
        initial value = "Unknown"
        row = 1
        column = 2
        width = medium
    )
    Health_Notes
    (
        type = section
        displayname = "Health Notes"
        visibility = true
        row = 2
        column = 1
    )
    Known_Allergies
    (
        type = textarea
        displayname = "Known Allergies"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 1
        width = medium
        height = 100px
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        personal data = true
        isephi = true
        isencrypted = true
        row = 2
        column = 2
        width = medium
        height = 100px
    )
    System_Details
    (
        type = section
        displayname = "System Details"
        visibility = true
        row = 3
        column = 1
    )
    Owner_Email
    (
        type = email
        displayname = "Caregiver Email"
        personal data = true
        isencrypted = true
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save this family member"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
                tooltip = "Update this family member"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
