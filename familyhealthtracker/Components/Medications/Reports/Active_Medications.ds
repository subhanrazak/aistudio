list Active_Medications
{
    displayName = "Active Medications"
    show all rows from Medications [Owner_Email == zoho.loginuser && Is_Active == true]
    (
        Member
        Medicine_Name
        Dosage
        Frequency
        Start_Date
        End_Date
        Reminder_Times
        (
            delimiter = comma
        )
        Is_Active
        Owner_Email
    )
    filters
    (
        Member
        Reminder_Times
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Member ascending
    )
    sort by
    (
        Medicine_Name ascending
    )
}
