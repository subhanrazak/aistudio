default list All_Medications
{
    displayName = "All Medications"
    show all rows from Medications [Owner_Email == zoho.loginuser]
    (
        Member
        Medicine_Name
        Dosage
        Frequency
        Start_Date
        (
            displayformat = fulldate
        )
        End_Date
        (
            displayformat = fulldate
        )
        Reminder_Times
        (
            delimiter = comma
        )
        Is_Active
        (
            displaytrue = "Active"
            displayfalse = "Inactive"
        )
        Notes
        (
            foldcontent = enable
        )
        Owner_Email
    )
    filters
    (
        Member
        Is_Active
        Start_Date
        Reminder_Times
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Member ascending
    )
    sort by
    (
        Medicine_Name ascending
    )
}
