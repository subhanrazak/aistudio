form Medications
{
    displayname = "Medications"
    success message = "Medication saved successfully."
    record owner = Added_User
    Medication_Info
    (
        type = section
        displayname = "Medication Information"
        row = 1
        column = 0
    )
    must have Member
    (
        type = picklist
        displayname = "Family Member"
        values = Family_Members.ID
        displayformat = [Full_Name]
        allow new entries
        [
            displayname = "Add Family Member"
        ]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Medicine_Name
    (
        type = text
        displayname = "Medicine Name"
        personal data = true
        isephi = true
        isencrypted = true
        row = 1
        column = 2
        width = medium
    )
    Dosage
    (
        type = text
        displayname = "Dosage"
        personal data = true
        isephi = true
        isencrypted = true
        row = 1
        column = 1
        width = medium
    )
    Frequency
    (
        type = picklist
        displayname = "Frequency"
        values = {"Once daily","Twice daily","Three times daily","Four times daily","As needed","Custom"}
        row = 1
        column = 2
        width = medium
    )
    Schedule_Info
    (
        type = section
        displayname = "Schedule"
        visibility = true
        row = 2
        column = 1
    )
    must have Start_Date
    (
        type = date
        displayname = "Start Date"
        initial value = "${zoho.currentdate}"
        row = 2
        column = 1
        width = medium
    )
    End_Date
    (
        type = date
        displayname = "End Date"
        row = 2
        column = 2
        width = medium
    )
    must have Reminder_Times
    (
        type = checkboxes
        displayname = "Reminder Times"
        values = {"06:00","08:00","10:00","12:00","14:00","16:00","18:00","20:00","22:00"}
        layout = 3
        row = 2
        column = 1
        width = medium
    )
    Is_Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 2
        column = 2
        width = medium
    )
    Notes_Section
    (
        type = section
        displayname = "Notes"
        visibility = true
        row = 3
        column = 1
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        personal data = true
        isephi = true
        isencrypted = true
        row = 3
        column = 1
        width = medium
        height = 120px
    )
    Owner_Email
    (
        type = email
        displayname = "Caregiver Email"
        personal data = true
        isencrypted = true
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
                tooltip = "Save this medication"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
                tooltip = "Update this medication"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
