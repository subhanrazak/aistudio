"Staff"
{
    name        = "Staff"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:true }
    description = "Clinic staff profile for day-to-day health care management without delete rights or direct audit-log access."

    ModulePermissions
    {
        Insurance_Providers
        {
            enabled          = Viewall,Tab,View,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Insurance_Providers={"View"}
                Active_Insurance_Providers={"View"}
            }
        }
        Staff_Members
        {
            enabled          = Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                Staff_Directory={"View"}
                Active_Doctors={"View"}
            }
            FieldPermissions
            {
                Staff_Code{visibility:true,readonly:true}
                Full_Name{visibility:true,readonly:true}
                Role{visibility:true,readonly:true}
                Specialty{visibility:true,readonly:true}
                Email{visibility:true,readonly:false}
                Phone{visibility:true,readonly:false}
                Active{visibility:true,readonly:false}
                Available_For_Appointments{visibility:true,readonly:false}
                Standard_Consultation_Fee{visibility:true,readonly:true}
            }
        }
        Patients
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Patients={"View"}
                Active_Patients={"View"}
                Patient_Insurance_Status={"View"}
            }
        }
        Appointments
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Appointments={"View"}
                Appointment_Calendar={"View"}
                Today_Appointments={"View"}
                Appointment_Status_Board={"View"}
            }
            FieldPermissions
            {
                Appointment_Number{visibility:true,readonly:true}
                Patient{visibility:true,readonly:false}
                Provider{visibility:true,readonly:false}
                Appointment_Date{visibility:true,readonly:false}
                Appointment_Time{visibility:true,readonly:false}
                Visit_Type{visibility:true,readonly:false}
                Appointment_Status{visibility:true,readonly:false}
                Reason_for_Visit{visibility:true,readonly:false}
                Followup_Reason{visibility:true,readonly:false}
                Cancellation_Reason{visibility:true,readonly:false}
                Internal_Notes{visibility:false}
            }
        }
        Consultations
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Consultations={"View"}
                Recent_Consultations={"View"}
                Follow_Up_Calendar={"View"}
            }
            FieldPermissions
            {
                Consultation_Number{visibility:true,readonly:true}
                Patient{visibility:true,readonly:false}
                Appointment{visibility:true,readonly:false}
                Provider{visibility:true,readonly:false}
                Consultation_DateTime{visibility:true,readonly:false}
                Symptoms{visibility:true,readonly:false}
                Vital_Temperature{visibility:true,readonly:false}
                Vital_Pulse{visibility:true,readonly:false}
                Blood_Pressure{visibility:true,readonly:false}
                Weight{visibility:true,readonly:false}
                Diagnosis{visibility:true,readonly:false}
                Treatment_Plan{visibility:true,readonly:false}
                Visit_Outcome{visibility:true,readonly:false}
                Requires_Follow_Up{visibility:true,readonly:false}
                Follow_Up_Date{visibility:true,readonly:false}
                Referral_Notes{visibility:true,readonly:false}
                Internal_Admin_Notes{visibility:false}
            }
        }
        Prescriptions
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Prescriptions={"View"}
                Active_Prescriptions={"View"}
                Patient_Prescription_History={"View"}
            }
        }
        Invoices
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Invoices={"View"}
                Outstanding_Invoices={"View"}
                Paid_Invoices={"View"}
            }
        }
        Insurance_Claims
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = false
            ReportPermissions
            {
                All_Insurance_Claims={"View"}
                Open_Insurance_Claims={"View"}
                Claim_Status_Board={"View"}
            }
            FieldPermissions
            {
                Claim_Number{visibility:true,readonly:true}
                Patient{visibility:true,readonly:false}
                Insurance_Provider{visibility:true,readonly:false}
                Invoice{visibility:true,readonly:false}
                Claim_Date{visibility:true,readonly:false}
                Claim_Amount{visibility:true,readonly:false}
                Approved_Amount{visibility:true,readonly:false}
                Copay_Amount{visibility:true,readonly:false}
                Claim_Status{visibility:true,readonly:false}
                Claim_Reference_Number{visibility:true,readonly:false}
                Submission_Date{visibility:true,readonly:false}
                Approval_Date{visibility:true,readonly:false}
                Denial_Reason{visibility:true,readonly:false}
                Internal_Notes{visibility:false}
            }
        }
        Payments
        {
            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
            allFieldsVisible = true
            ReportPermissions
            {
                All_Payments={"View"}
                Received_Payments={"View"}
                Payment_Register={"View"}
            }
        }
        Clinic_Dashboard
        {
            enabled = tab
        }
    }
}

