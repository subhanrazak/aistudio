<%
activePatients = Patients[Status == "Active"].count();
todayAppointments = Appointments[Appointment_Date == zoho.currentdate].count();
checkedInAppointments = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Checked In"].count();
openInsuranceClaims = Insurance_Claims[Claim_Status != "Approved" && Claim_Status != "Denied" && Claim_Status != "Closed"].count();
outstandingInvoices = Invoices[Balance_Due > 0 && Invoice_Status != "Cancelled"];
outstandingInvoiceBalance = 0;
if(outstandingInvoices.count() > 0)
{
    outstandingInvoiceBalance = ifnull(outstandingInvoices.sum(Balance_Due),0);
}
receivedPaymentsThisMonth = 0;
currentMonth = zoho.currentdate.getMonth();
currentYear = zoho.currentdate.getYear();
for each paymentRecord in Payments[Payment_Status == "Received"]
{
    if(paymentRecord.Payment_Date != null && paymentRecord.Payment_Date.getMonth() == currentMonth && paymentRecord.Payment_Date.getYear() == currentYear)
    {
        receivedPaymentsThisMonth = receivedPaymentsThisMonth + ifnull(paymentRecord.Amount,0);
    }
}
%>
<style>
/* zcs-global.css essentials included once for Clinic_Dashboard */
:root {
    --zcs-theme-brand-color: var(--zcs_brand_color);
    --zcs-light-bg-color: var(--zcs_brand_light_color);
    --zcs-page-bg-color: #F3F3F4;
    --zcs-primary-text-color: var(--zcs_primary_text_color);
    --zcs-secondary-text-color: var(--zcs_secondary_text_color);
    --zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
    --zcs-border-color: var(--zcs_tertiary_border_color);
    --zcs-white-color: #FFFFFF;
    --zcs-black-color: #000000;
    --zcs-thead-color: #F9FAFE;
    --zcs-tr-h-color: #F9FAFE;
}
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: 0.25rem; }
.zcs-gap-6 { gap: 0.375rem; }
.zcs-gap-8 { gap: 0.5rem; }
.zcs-gap-10 { gap: 0.625rem; }
.zcs-gap-12 { gap: 0.75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: 0.5rem; }
.zcs-p-12 { padding: 0.75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-8 { padding-left: 0.5rem; padding-right: 0.5rem; }
.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }
.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }
.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }
.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: 0.25rem; }
.zcs-mt-5 { margin-top: 0.3125rem; }
.zcs-mt-8 { margin-top: 0.5rem; }
.zcs-mt-10 { margin-top: 0.625rem; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-w-full { width: 100%; }
.zcs-h-full { height: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-rounded-sm { border-radius: 0.25rem; }
.zcs-rounded-md { border-radius: 0.375rem; }
.zcs-rounded-lg { border-radius: 0.5rem; }
.zcs-rounded-xl { border-radius: 0.75rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-col-common { flex: 1 1 0; min-width: 0; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-font-11 { font-size: 0.6875rem; }
.zcs-font-12 { font-size: 0.75rem; }
.zcs-font-13 { font-size: 0.8125rem; }
.zcs-font-14 { font-size: 0.875rem; }
.zcs-font-15 { font-size: 0.9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }
a { text-decoration: none; }

/* badge-badge-with-icon */
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #a06309; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }

/* progress-bar-range-bar-with-texts */
.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); overflow: hidden; }
.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }

/* table-simple-table */
.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }
.zcs-table-wrapper table thead { top: 0; }
.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }
.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }
.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }
.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #a06309; }
.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }

/* timeline-simple-timeline */
.zcs-timeline-wrapper ul { list-style: none; }
.zcs-tl-indicator { width: 60px; left: 16.6667%; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }

/* Clinic dashboard */
.clinic-dashboard-shell { width: 100%; box-sizing: border-box; font-family: inherit; color: var(--zcs-primary-text-color); }
.clinic-dashboard-header { min-height: 96px; padding: 22px 24px; margin-bottom: 16px; overflow: hidden; position: relative; background: linear-gradient(120deg, var(--zcs_brand_color), color-mix(in srgb, var(--zcs_brand_color) 70%, #1328CD)); color: var(--zcs_brand_foreground_color); }
.clinic-dashboard-header:after { content: ''; position: absolute; width: 280px; height: 280px; right: -80px; top: -112px; border-radius: 50%; border: 34px solid rgba(255,255,255,0.12); }
.clinic-header-title { position: relative; z-index: 1; font-size: 24px; line-height: 1.2; font-weight: 700; margin: 0; color: var(--zcs_brand_foreground_color); }
.clinic-header-subtitle { position: relative; z-index: 1; margin: 6px 0 0; color: rgba(255,255,255,0.86); font-size: 14px; }
.clinic-header-meta { position: relative; z-index: 1; color: rgba(255,255,255,0.9); font-size: 13px; text-align: right; }
.clinic-kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(150px, 1fr)); gap: 14px; }
.clinic-kpi-card { display: flex; flex-direction: column; gap: 12px; padding: 18px; min-height: 132px; transition: border-color .15s ease, transform .15s ease; }
.clinic-kpi-card:hover { border-color: var(--zcs_brand_color); transform: translateY(-1px); }
.clinic-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.clinic-kpi-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs_component_hover_color); color: var(--zcs_brand_color); font-size: 20px; }
.clinic-kpi-value { font-size: 28px; font-weight: 700; line-height: 1; color: var(--zcs-primary-text-color); word-break: break-word; }
.clinic-kpi-label { font-size: 13px; color: var(--zcs-secondary-text-color); line-height: 1.35; }
.clinic-card { padding: 18px; }
.clinic-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 14px; }
.clinic-section-title h3 { margin: 0; font-size: 18px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }
.clinic-section-title span, .clinic-muted { color: var(--zcs-secondary-text-color); font-size: 13px; }
.clinic-link { color: var(--zcs_brand_color); font-weight: 600; font-size: 13px; }
.clinic-status-grid { display: grid; grid-template-columns: repeat(3, minmax(135px, 1fr)); gap: 12px; }
.clinic-status-card { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; padding: 14px; background: var(--zcs-white-color); }
.clinic-status-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.clinic-status-label { color: var(--zcs-secondary-text-color); font-size: 13px; }
.clinic-status-count { color: var(--zcs-primary-text-color); font-size: 22px; font-weight: 700; }
.clinic-status-card .zcs-progress-bar-indicator { background: var(--clinic-accent, var(--zcs_brand_color)); }
.clinic-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(190px, 1fr)); gap: 12px; }
.clinic-summary-tile { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; padding: 14px; background: #fff; }
.clinic-summary-label { font-size: 13px; color: var(--zcs-secondary-text-color); margin: 0 0 6px; }
.clinic-summary-value { font-size: 24px; line-height: 1.1; font-weight: 700; color: var(--zcs-primary-text-color); margin: 0; }
.clinic-summary-foot { font-size: 12px; color: var(--zcs-teritiary-text-color); margin-top: 8px; }
.clinic-activity-layout { display: grid; grid-template-columns: repeat(3, minmax(210px, 1fr)); gap: 14px; }
.clinic-activity-column { min-height: 100%; }
.clinic-mini-title { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; font-size: 15px; font-weight: 700; color: var(--zcs-primary-text-color); }
.clinic-feed-list { display: flex; flex-direction: column; gap: 12px; }
.clinic-feed-item { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 10px; padding: 12px; background: #fff; }
.clinic-feed-primary { font-size: 14px; font-weight: 600; color: var(--zcs-primary-text-color); margin: 0 0 4px; }
.clinic-feed-secondary { font-size: 12px; color: var(--zcs-secondary-text-color); margin: 0 0 8px; }
.clinic-empty { display: flex; align-items: center; justify-content: center; min-height: 86px; color: var(--zcs-secondary-text-color); border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 10px; background: #fff; font-size: 13px; }
.clinic-open-work-grid { display: grid; grid-template-columns: repeat(3, minmax(240px, 1fr)); gap: 14px; }
.clinic-table-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 10px; }
.clinic-table-title h4 { margin: 0; font-size: 15px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }
.clinic-compact-table .zcs-table-wrapper { max-height: 340px; }
.clinic-compact-table td, .clinic-compact-table th { vertical-align: top; }
.clinic-money { white-space: nowrap; }
@media (max-width: 1280px) {
    .clinic-kpi-grid { grid-template-columns: repeat(3, minmax(170px, 1fr)); }
    .clinic-open-work-grid, .clinic-activity-layout { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
    .clinic-dashboard-header { flex-direction: column; align-items: flex-start; }
    .clinic-header-meta { text-align: left; }
    .clinic-kpi-grid, .clinic-status-grid, .clinic-summary-grid { grid-template-columns: 1fr; }
    .zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; }
    .zcs-tl-li { flex-direction: column; }
    .zcs-tl-indicator { left: 0; }
    .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; }
}
</style>
<div class="clinic-dashboard-shell">
    <div class="clinic-dashboard-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
        <div>
            <h1 class="clinic-header-title">Clinic Dashboard</h1>
            <p class="clinic-header-subtitle">Operational view for patient flow, billing work, insurance, and follow-up activity.</p>
        </div>
        <div class="clinic-header-meta">
            <div><i class="zc-li-outline ui-1-calendar-60"></i> <%=zoho.currentdate%></div>
            <div>Signed in as <%=zoho.loginuser%></div>
        </div>
    </div>
    <div class="clinic-kpi-grid">
        <a class="clinic-kpi-card zcs-card" href="#Report:Active_Patients">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline users-single-01"></i></span><span class="clinic-link">Open</span></div>
            <div class="clinic-kpi-value"><%=activePatients%></div>
            <div class="clinic-kpi-label">Total active patients</div>
        </a>
        <a class="clinic-kpi-card zcs-card" href="#Report:Today_Appointments">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline ui-1-calendar-check-59"></i></span><span class="clinic-link">Today</span></div>
            <div class="clinic-kpi-value"><%=todayAppointments%></div>
            <div class="clinic-kpi-label">Today appointments</div>
        </a>
        <a class="clinic-kpi-card zcs-card" href="#Report:Today_Appointments?Appointment_Status=Checked%20In">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></span><span class="clinic-link">Flow</span></div>
            <div class="clinic-kpi-value"><%=checkedInAppointments%></div>
            <div class="clinic-kpi-label">Checked-in appointments</div>
        </a>
        <a class="clinic-kpi-card zcs-card" href="#Report:Open_Insurance_Claims">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline business-briefcase-24"></i></span><span class="clinic-link">Work</span></div>
            <div class="clinic-kpi-value"><%=openInsuranceClaims%></div>
            <div class="clinic-kpi-label">Open insurance claims</div>
        </a>
        <a class="clinic-kpi-card zcs-card" href="#Report:Outstanding_Invoices">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline business-money-coins"></i></span><span class="clinic-link">AR</span></div>
            <div class="clinic-kpi-value clinic-money">$<%=outstandingInvoiceBalance%></div>
            <div class="clinic-kpi-label">Outstanding invoice balance</div>
        </a>
        <a class="clinic-kpi-card zcs-card" href="#Report:Received_Payments">
            <div class="clinic-kpi-top"><span class="clinic-kpi-icon"><i class="zc-li-outline business-chart-bar-32"></i></span><span class="clinic-link">Month</span></div>
            <div class="clinic-kpi-value clinic-money">$<%=receivedPaymentsThisMonth%></div>
            <div class="clinic-kpi-label">Received payments this month</div>
        </a>
    </div>
</div>
