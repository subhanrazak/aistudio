<%
requestedCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Requested"].count();
confirmedCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Confirmed"].count();
checkedInCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Checked In"].count();
completedCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Completed"].count();
cancelledCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "Cancelled"].count();
noShowCount = Appointments[Appointment_Date == zoho.currentdate && Appointment_Status == "No Show"].count();
statusTotal = requestedCount + confirmedCount + checkedInCount + completedCount + cancelledCount + noShowCount;
requestedPct = if(statusTotal > 0,(requestedCount * 100) / statusTotal,0);
confirmedPct = if(statusTotal > 0,(confirmedCount * 100) / statusTotal,0);
checkedInPct = if(statusTotal > 0,(checkedInCount * 100) / statusTotal,0);
completedPct = if(statusTotal > 0,(completedCount * 100) / statusTotal,0);
cancelledPct = if(statusTotal > 0,(cancelledCount * 100) / statusTotal,0);
noShowPct = if(statusTotal > 0,(noShowCount * 100) / statusTotal,0);
%>
<div class="clinic-dashboard-shell clinic-card zcs-card">
    <div class="clinic-section-title">
        <h3><i class="zc-li-outline ui-2-time-clock"></i> Appointment status today</h3>
        <a class="clinic-link" href="#Report:Today_Appointments">View appointments</a>
    </div>
    <div class="clinic-status-grid">
        <div class="clinic-status-card" style="--clinic-accent:#2A6FFC;">
            <div class="clinic-status-head"><span class="clinic-status-label">Requested</span><span class="clinic-status-count"><%=requestedCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=requestedPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=requestedPct%>%</span></p></div>
        </div>
        <div class="clinic-status-card" style="--clinic-accent:#1094C5;">
            <div class="clinic-status-head"><span class="clinic-status-label">Confirmed</span><span class="clinic-status-count"><%=confirmedCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=confirmedPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=confirmedPct%>%</span></p></div>
        </div>
        <div class="clinic-status-card" style="--clinic-accent:#F4660C;">
            <div class="clinic-status-head"><span class="clinic-status-label">Checked In</span><span class="clinic-status-count"><%=checkedInCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=checkedInPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=checkedInPct%>%</span></p></div>
        </div>
        <div class="clinic-status-card" style="--clinic-accent:#179E6C;">
            <div class="clinic-status-head"><span class="clinic-status-label">Completed</span><span class="clinic-status-count"><%=completedCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=completedPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=completedPct%>%</span></p></div>
        </div>
        <div class="clinic-status-card" style="--clinic-accent:#FE455D;">
            <div class="clinic-status-head"><span class="clinic-status-label">Cancelled</span><span class="clinic-status-count"><%=cancelledCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=cancelledPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=cancelledPct%>%</span></p></div>
        </div>
        <div class="clinic-status-card" style="--clinic-accent:#a06309;">
            <div class="clinic-status-head"><span class="clinic-status-label">No Show</span><span class="clinic-status-count"><%=noShowCount%></span></div>
            <div class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6"><div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=noShowPct%>%;"></div></div><p class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-secondary">Share</span><span class="zcs-color-primary"><%=noShowPct%>%</span></p></div>
        </div>
    </div>
</div>
