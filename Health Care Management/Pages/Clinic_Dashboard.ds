<page linkname = "Clinic_Dashboard" displayname = "Clinic Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='Clinic_KPI_Cards' elementName='Clinic_KPI_Cards'>
          <![CDATA[htmlpage Clinic_KPI_Cards()
            content
             <%{%>
                 <file name:Clinic_KPI_Cards.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='50%'>
        <dsp id='Appointment_Status_Summary' elementName='Appointment_Status_Summary'>
          <![CDATA[htmlpage Appointment_Status_Summary()
            content
             <%{%>
                 <file name:Appointment_Status_Summary.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
      <column width='50%'>
        <dsp id='Billing_Claims_Summary' elementName='Billing_Claims_Summary'>
          <![CDATA[htmlpage Billing_Claims_Summary()
            content
             <%{%>
                 <file name:Billing_Claims_Summary.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Followup_Activity_Feed' elementName='Followup_Activity_Feed'>
          <![CDATA[htmlpage Followup_Activity_Feed()
            content
             <%{%>
                 <file name:Followup_Activity_Feed.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='Open_Work_Table' elementName='Open_Work_Table'>
          <![CDATA[htmlpage Open_Work_Table()
            content
             <%{%>
                 <file name:Open_Work_Table.dshtml/>
             <%}%>
          ]]>
        </dsp>
      </column>
    </row>
  </layout>
</zml>
</content>
