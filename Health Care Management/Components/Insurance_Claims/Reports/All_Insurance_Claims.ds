default list All_Insurance_Claims
{
    displayName = "All Insurance Claims"
    show all rows from Insurance_Claims
    (
        Claim_Number
        Patient
        Insurance_Provider
        Invoice
        Claim_Date
        Claim_Amount
        Approved_Amount
        Copay_Amount
        Claim_Status
        Claim_Reference_Number
    )
    filters
    (
        Claim_Status
        Insurance_Provider
    )
    sort by
    (
        Claim_Date descending
    )
}
