list Open_Insurance_Claims
{
    displayName = "Open Insurance Claims"
    show all rows from Insurance_Claims [Claim_Status not in {"Approved","Denied","Closed"}]
    (
        Claim_Number
        Patient
        Insurance_Provider
        Invoice
        Claim_Date
        Claim_Amount
        Claim_Status
    )
    filters
    (
        Claim_Status
        Insurance_Provider
    )
    sort by
    (
        Claim_Date ascending
    )
}
