kanban Claim_Status_Board
{
    displayName = "Claim Status Board"
    show all rows from Insurance_Claims
    (
        Claim_Number
        Patient
        Insurance_Provider
        Invoice
        Claim_Amount
        Approved_Amount
        Claim_Status
    )
    filters
    (
        Insurance_Provider
        Claim_Status
    )
    sort by
    (
        Claim_Amount descending
    )
    options
    (
        display field = Claim_Status
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}
