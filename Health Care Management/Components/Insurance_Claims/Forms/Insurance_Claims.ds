form Insurance_Claims
{
    displayname = "Insurance Claims"
    Claim_Details
    (
        type = section
        displayname = "Claim Details"
        row = 1
        column = 0
    )
    Claim_Number
    (
        type = autonumber
        displayname = "Claim Number"
        start index = 70001
        row = 1
        column = 1
        width = medium
    )
    must have Patient
    (
        type = picklist
        displayname = "Patient"
        values = Patients.ID
        displayformat = [Patient_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Insurance_Provider
    (
        type = picklist
        displayname = "Insurance Provider"
        values = Insurance_Providers.ID
        displayformat = [Provider_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Invoice
    (
        type = picklist
        displayname = "Invoice"
        values = Invoices.ID
        displayformat = [Invoice_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Claim_Date
    (
        type = date
        displayname = "Claim Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    must have Claim_Amount
    (
        type = decimal
        displayname = "Claim Amount"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Approved_Amount
    (
        type = decimal
        displayname = "Approved Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    Copay_Amount
    (
        type = decimal
        displayname = "Copay Amount"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 1
        width = medium
    )
    must have Claim_Status
    (
        type = picklist
        displayname = "Claim Status"
        values = {"Draft","Submitted","Under Review","Approved","Partially Approved","Denied","Closed"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Claim_Reference_Number
    (
        type = text
        displayname = "Claim Reference Number"
        row = 1
        column = 1
        width = medium
    )
    Submission_Date
    (
        type = date
        displayname = "Submission Date"
        row = 1
        column = 2
        width = medium
    )
    Approval_Date
    (
        type = date
        displayname = "Approval Date"
        row = 1
        column = 1
        width = medium
    )
    Denial_Reason
    (
        type = textarea
        displayname = "Denial Reason"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Internal_Notes
    (
        type = textarea
        displayname = "Internal Notes"
        private = true
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
    blueprint components
    {
        stages = {"Draft","Submitted","Under Review","Approved","Partially Approved","Denied","Closed"}
    }
}
