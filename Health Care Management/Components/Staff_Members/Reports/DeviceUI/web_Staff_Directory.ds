report Staff_Directory
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Staff_Code
                    Full_Name
                    Role
                    Specialty
                    Email
                    Phone
                    Active
                    Available_For_Appointments
                    Standard_Consultation_Fee
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Staff_Code
                    Full_Name
                    Role
                    Specialty
                    Email
                    Phone
                    Active
                    Available_For_Appointments
                    Standard_Consultation_Fee
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
