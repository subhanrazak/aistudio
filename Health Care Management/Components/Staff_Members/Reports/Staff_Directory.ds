default list Staff_Directory
{
    displayName = "Staff Directory"
    show all rows from Staff_Members
    (
        Staff_Code
        Full_Name
        Role
        Specialty
        Email
        Phone
        Active
        Available_For_Appointments
        Standard_Consultation_Fee
    )
    filters
    (
        Role
        Active
        Available_For_Appointments
    )
    sort by
    (
        Full_Name ascending
    )
}
