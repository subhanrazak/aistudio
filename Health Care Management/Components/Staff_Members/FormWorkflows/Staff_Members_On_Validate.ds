Staff_Members_On_Validate as "Staff Members On Validate"
{
    type = form
    form = Staff_Members
    record event = on add or edit

    on validate
    {
        actions
        {
            custom deluge script
            (
                if (input.Active == false && input.Available_For_Appointments == true)
                {
                    alert "Inactive staff cannot be marked available for appointments.";
                    cancel submit;
                }
            )
        }
    }
}
