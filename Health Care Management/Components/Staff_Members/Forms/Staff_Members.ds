form Staff_Members
{
    displayname = "Staff Members"
    Staff_Details
    (
        type = section
        displayname = "Staff Details"
        row = 1
        column = 0
    )
    Staff_Code
    (
        type = autonumber
        displayname = "Staff Code"
        start index = 5001
        row = 1
        column = 1
        width = medium
    )
    must have Full_Name
    (
        type = text
        displayname = "Full Name"
        row = 1
        column = 1
        width = medium
    )
    must have Role
    (
        type = picklist
        displayname = "Role"
        values = {"Doctor","Nurse","Front Desk","Billing","Manager","Administrator"}
        row = 1
        column = 2
        width = medium
    )
    Specialty
    (
        type = text
        displayname = "Specialty"
        row = 1
        column = 1
        width = medium
    )
    unique Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Active
    (
        type = checkbox
        displayname = "Active"
        initial value = true
        row = 1
        column = 2
        width = medium
    )
    Available_For_Appointments
    (
        type = checkbox
        displayname = "Available For Appointments"
        initial value = true
        row = 1
        column = 1
        width = medium
    )
    Standard_Consultation_Fee
    (
        type = decimal
        displayname = "Standard Consultation Fee"
        decimalplace = 2
        initial value = 0
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
