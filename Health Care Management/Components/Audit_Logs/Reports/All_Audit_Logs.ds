default list All_Audit_Logs
{
    displayName = "All Audit Logs"
    show all rows from Audit_Logs
    (
        Audit_Number
        Event_Time
        Entity_Type
        Entity_Record_ID
        Action_Type
        Performed_By
        Sensitivity
        Summary
    )
    filters
    (
        Entity_Type
        Action_Type
        Sensitivity
    )
    sort by
    (
        Event_Time descending
    )
}
