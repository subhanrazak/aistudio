list High_Sensitivity_Audits
{
    displayName = "High Sensitivity Audits"
    show all rows from Audit_Logs [Sensitivity == "High"]
    (
        Audit_Number
        Event_Time
        Entity_Type
        Entity_Record_ID
        Action_Type
        Performed_By
        Summary
    )
    filters
    (
        Entity_Type
        Action_Type
    )
    sort by
    (
        Event_Time descending
    )
}
