form Audit_Logs
{
    displayname = "Audit Logs"
    Audit_Event
    (
        type = section
        displayname = "Audit Event"
        row = 1
        column = 0
    )
    Audit_Number
    (
        type = autonumber
        displayname = "Audit Number"
        start index = 90001
        row = 1
        column = 1
        width = medium
    )
    must have Event_Time
    (
        type = datetime
        displayname = "Event Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 1
        width = medium
    )
    must have Entity_Type
    (
        type = picklist
        displayname = "Entity Type"
        values = {"Patient","Staff","Appointment","Consultation","Prescription","Invoice","Insurance Claim","Payment","System"}
        row = 1
        column = 2
        width = medium
    )
    Entity_Record_ID
    (
        type = number
        displayname = "Entity Record ID"
        row = 1
        column = 1
        width = medium
    )
    must have Action_Type
    (
        type = picklist
        displayname = "Action Type"
        values = {"Created","Updated","Status Changed","Payment Posted","Claim Updated","Validation Blocked","System Event"}
        row = 1
        column = 2
        width = medium
    )
    Summary
    (
        type = textarea
        displayname = "Summary"
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Performed_By
    (
        type = text
        displayname = "Performed By"
        row = 1
        column = 2
        width = medium
    )
    must have Sensitivity
    (
        type = picklist
        displayname = "Sensitivity"
        values = {"Low","Medium","High"}
        initial value = "Medium"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
