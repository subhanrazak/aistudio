kanban Appointment_Status_Board
{
    displayName = "Appointment Status Board"
    show all rows from Appointments
    (
        Appointment_Number
        Patient
        Provider
        Appointment_Date
        Appointment_Time
        Visit_Type
        Appointment_Status
    )
    filters
    (
        Provider
        Visit_Type
        Appointment_Date
    )
    sort by
    (
        Appointment_Date descending
        Appointment_Time descending
    )
    options
    (
        display field = Appointment_Status
        othercolumn = "Other"
        filter type = manual
        sort order = custom
        record count = enable
    )
}
