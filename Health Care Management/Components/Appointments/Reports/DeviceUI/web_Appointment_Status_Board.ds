report Appointment_Status_Board
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Appointment_Number
                    Patient
                    Provider
                    Appointment_Date
                    Appointment_Time
                    Visit_Type
                    Appointment_Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Appointment_Number
                    Patient
                    Provider
                    Appointment_Date
                    Appointment_Time
                    Visit_Type
                    Appointment_Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
