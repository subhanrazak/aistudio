list Today_Appointments
{
    displayName = "Today Appointments"
    show all rows from Appointments [Appointment_Date == zoho.currentdate]
    (
        Appointment_Number
        Patient
        Provider
        Appointment_Time
        Visit_Type
        Appointment_Status
    )
    filters
    (
        Appointment_Status
        Provider
        Visit_Type
    )
    sort by
    (
        Appointment_Time ascending
    )
}
