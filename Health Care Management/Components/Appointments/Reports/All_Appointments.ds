default list All_Appointments
{
    displayName = "All Appointments"
    show all rows from Appointments
    (
        Appointment_Number
        Patient
        Provider
        Appointment_Date
        Appointment_Time
        Visit_Type
        Appointment_Status
    )
    filters
    (
        Appointment_Status
        Provider
        Visit_Type
        Appointment_Date
    )
    sort by
    (
        Appointment_Date descending
        Appointment_Time descending
    )
}
