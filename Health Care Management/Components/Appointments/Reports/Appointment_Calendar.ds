calendar Appointment_Calendar
{
    displayName = "Appointment Calendar"
    show all rows from Appointments
    (
        Appointment_Number
        Patient
        Provider
        Appointment_Date
        Appointment_Time
        Appointment_Status
    )
    filters
    (
        Appointment_Status
        Provider
        Appointment_Date
    )
    options
    (
        display type = month
        week start day = monday
        display field = Patient
        start date = Appointment_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
