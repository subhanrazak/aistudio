form Appointments
{
    displayname = "Appointments"
    Appointment_Details
    (
        type = section
        displayname = "Appointment Details"
        row = 1
        column = 0
    )
    Appointment_Number
    (
        type = autonumber
        displayname = "Appointment Number"
        start index = 20001
        row = 1
        column = 1
        width = medium
    )
    must have Patient
    (
        type = picklist
        displayname = "Patient"
        values = Patients.ID
        displayformat = [Patient_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Provider
    (
        type = picklist
        displayname = "Provider"
        values = Staff_Members[Active == true && Available_For_Appointments == true].ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Appointment_Date
    (
        type = date
        displayname = "Appointment Date"
        row = 1
        column = 1
        width = medium
    )
    must have Appointment_Time
    (
        type = time
        displayname = "Appointment Time"
        row = 1
        column = 2
        width = medium
    )
    must have Visit_Type
    (
        type = picklist
        displayname = "Visit Type"
        values = {"New Visit","Follow-up","Procedure","Teleconsultation"}
        initial value = "New Visit"
        row = 1
        column = 1
        width = medium
    )
    must have Appointment_Status
    (
        type = picklist
        displayname = "Appointment Status"
        values = {"Requested","Confirmed","Checked In","Completed","Cancelled","No Show"}
        initial value = "Requested"
        row = 1
        column = 2
        width = medium
    )
    Reason_for_Visit
    (
        type = textarea
        displayname = "Reason for Visit"
        isephi = true
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Followup_Reason
    (
        type = textarea
        displayname = "Follow-up Reason"
        isephi = true
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Cancellation_Reason
    (
        type = textarea
        displayname = "Cancellation Reason"
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Internal_Notes
    (
        type = textarea
        displayname = "Internal Notes"
        private = true
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
