default list All_Invoices
{
    displayName = "All Invoices"
    show all rows from Invoices
    (
        Invoice_Number
        Patient
        Invoice_Date
        Billing_Mode
        Total_Amount
        Amount_Paid
        Balance_Due
        Invoice_Status
        Insurance_Related
    )
    filters
    (
        Invoice_Status
        Billing_Mode
        Insurance_Related
    )
    sort by
    (
        Invoice_Date descending
    )
}
