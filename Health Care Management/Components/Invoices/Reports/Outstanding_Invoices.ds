list Outstanding_Invoices
{
    displayName = "Outstanding Invoices"
    show all rows from Invoices [Balance_Due > 0 && Invoice_Status != "Cancelled"]
    (
        Invoice_Number
        Patient
        Invoice_Date
        Billing_Mode
        Total_Amount
        Amount_Paid
        Balance_Due
        Invoice_Status
    )
    filters
    (
        Invoice_Status
        Billing_Mode
    )
    sort by
    (
        Invoice_Date ascending
    )
}
