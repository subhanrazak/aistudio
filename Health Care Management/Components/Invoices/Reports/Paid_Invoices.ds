list Paid_Invoices
{
    displayName = "Paid Invoices"
    show all rows from Invoices [Invoice_Status == "Paid"]
    (
        Invoice_Number
        Patient
        Invoice_Date
        Billing_Mode
        Total_Amount
        Amount_Paid
        Invoice_Status
    )
    filters
    (
        Billing_Mode
        Invoice_Status
    )
    sort by
    (
        Invoice_Date descending
    )
}
