default list All_Insurance_Providers
{
    displayName = "All Insurance Providers"
    show all rows from Insurance_Providers
    (
        Provider_Code
        Provider_Name
        Contact_Email
        Contact_Phone
        Claims_Portal_URL
        Status
    )
    filters
    (
        Status
        Provider_Name
    )
    sort by
    (
        Provider_Name ascending
    )
}
