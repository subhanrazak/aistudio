form Insurance_Providers
{
    displayname = "Insurance Providers"
    Provider_Information
    (
        type = section
        displayname = "Provider Information"
        row = 1
        column = 0
    )
    Provider_Code
    (
        type = autonumber
        displayname = "Provider Code"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have unique Provider_Name
    (
        type = text
        displayname = "Provider Name"
        row = 1
        column = 1
        width = medium
    )
    Contact_Email
    (
        type = email
        displayname = "Contact Email"
        row = 1
        column = 2
        width = medium
    )
    Contact_Phone
    (
        type = phonenumber
        displayname = "Contact Phone"
        row = 1
        column = 1
        width = medium
    )
    Claims_Portal_URL
    (
        type = url
        displayname = "Claims Portal URL"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive"}
        initial value = "Active"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
