list Patient_Prescription_History
{
    displayName = "Patient Prescription History"
    show all rows from Prescriptions
    (
        Prescription_Number
        Patient
        Consultation
        Provider
        Prescription_Date
        Medication_Details
        Status
    )
    filters
    (
        Patient
        Provider
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Patient ascending
    )
    sort by
    (
        Prescription_Date descending
    )
}
