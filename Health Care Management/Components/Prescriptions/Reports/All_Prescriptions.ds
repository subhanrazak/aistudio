default list All_Prescriptions
{
    displayName = "All Prescriptions"
    show all rows from Prescriptions
    (
        Prescription_Number
        Patient
        Consultation
        Provider
        Prescription_Date
        Medication_Details
        Duration_Days
        Refill_Allowed
        Refill_Until
        Status
    )
    filters
    (
        Provider
        Status
        Refill_Allowed
    )
    sort by
    (
        Prescription_Date descending
    )
}
