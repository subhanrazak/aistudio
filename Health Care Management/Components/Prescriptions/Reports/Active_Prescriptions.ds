list Active_Prescriptions
{
    displayName = "Active Prescriptions"
    show all rows from Prescriptions [Status == "Issued"]
    (
        Prescription_Number
        Patient
        Provider
        Prescription_Date
        Medication_Details
        Dosage_Instructions
        Refill_Until
        Status
    )
    filters
    (
        Provider
        Refill_Until
        Status
    )
    sort by
    (
        Prescription_Date descending
    )
}
