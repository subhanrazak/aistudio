report Patient_Prescription_History
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Prescription_Number
                    Patient
                    Consultation
                    Provider
                    Prescription_Date
                    Medication_Details
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Prescription_Number
                    Patient
                    Consultation
                    Provider
                    Prescription_Date
                    Medication_Details
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
