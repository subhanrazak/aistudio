form Prescriptions
{
    displayname = "Prescriptions"
    Prescription_Details
    (
        type = section
        displayname = "Prescription Details"
        row = 1
        column = 0
    )
    Prescription_Number
    (
        type = autonumber
        displayname = "Prescription Number"
        start index = 40001
        row = 1
        column = 1
        width = medium
    )
    must have Patient
    (
        type = picklist
        displayname = "Patient"
        values = Patients.ID
        displayformat = [Patient_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Consultation
    (
        type = picklist
        displayname = "Consultation"
        values = Consultations.ID
        displayformat = [Consultation_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Provider
    (
        type = picklist
        displayname = "Provider"
        values = Staff_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Prescription_Date
    (
        type = date
        displayname = "Prescription Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    must have Medication_Details
    (
        type = textarea
        displayname = "Medication Details"
        isephi = true
        isencrypted = true
        height = 140px
        row = 1
        column = 1
        width = medium
    )
    Dosage_Instructions
    (
        type = textarea
        displayname = "Dosage Instructions"
        isephi = true
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Duration_Days
    (
        type = number
        displayname = "Duration Days"
        row = 1
        column = 1
        width = medium
    )
    Pharmacy_Notes
    (
        type = textarea
        displayname = "Pharmacy Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Refill_Allowed
    (
        type = checkbox
        displayname = "Refill Allowed"
        initial value = false
        row = 1
        column = 1
        width = medium
    )
    Refill_Until
    (
        type = date
        displayname = "Refill Until"
        row = 1
        column = 2
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Draft","Issued","Cancelled","Completed"}
        initial value = "Draft"
        row = 1
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
