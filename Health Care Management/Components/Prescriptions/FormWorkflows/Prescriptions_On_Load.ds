Prescriptions_On_Load as "Prescriptions On Load"
{
    type = form
    form = Prescriptions
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Refill_Allowed == true)
                {
                    show Refill_Until;
                    enable Refill_Until;
                }
                else
                {
                    hide Refill_Until;
                    disable Refill_Until;
                }
            )
        }
    }
}
