Refill_Allowed_On_User_Input as "Refill Allowed On User Input"
{
    type = form
    form = Prescriptions
    record event = on add or edit

    on user input of Refill_Allowed
    {
        actions
        {
            custom deluge script
            (
                if (input.Refill_Allowed == true)
                {
                    show Refill_Until;
                    enable Refill_Until;
                }
                else
                {
                    input.Refill_Until = null;
                    hide Refill_Until;
                    disable Refill_Until;
                }
            )
        }
    }
}
