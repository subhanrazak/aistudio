list Patient_Insurance_Status
{
    displayName = "Patient Insurance Status"
    show all rows from Patients
    (
        Patient_Number
        Patient_Name
        Has_Insurance
        Insurance_Provider
        Policy_Number
        Policy_Holder_Name
        Insurance_Validity_Date
        Status
    )
    filters
    (
        Has_Insurance
        Insurance_Provider
        Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Has_Insurance descending
    )
    sort by
    (
        Patient_Name ascending
    )
}
