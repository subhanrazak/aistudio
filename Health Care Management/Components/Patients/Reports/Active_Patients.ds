list Active_Patients
{
    displayName = "Active Patients"
    show all rows from Patients [Status == "Active"]
    (
        Patient_Number
        Patient_Name
        Phone
        Email
        Blood_Group
        Consent_on_File
        Has_Insurance
        Status
    )
    filters
    (
        Consent_on_File
        Has_Insurance
        Status
    )
    sort by
    (
        Patient_Name ascending
    )
}
