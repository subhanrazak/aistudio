report Active_Patients
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Patient_Number
                    Patient_Name
                    Phone
                    Email
                    Blood_Group
                    Consent_on_File
                    Has_Insurance
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Patient_Number
                    Patient_Name
                    Phone
                    Email
                    Blood_Group
                    Consent_on_File
                    Has_Insurance
                    Status
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
