default list All_Patients
{
    displayName = "All Patients"
    show all rows from Patients
    (
        Patient_Number
        Patient_Name
        Date_of_Birth
        Gender
        Phone
        Email
        Blood_Group
        Has_Insurance
        Insurance_Provider
        Status
    )
    filters
    (
        Status
        Gender
        Has_Insurance
        Insurance_Provider
    )
    sort by
    (
        Patient_Name ascending
    )
}
