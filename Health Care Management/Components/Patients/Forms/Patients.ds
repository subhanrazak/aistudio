form Patients
{
    displayname = "Patients"
    Patient_Information
    (
        type = section
        displayname = "Patient Information"
        row = 1
        column = 0
    )
    Patient_Number
    (
        type = autonumber
        displayname = "Patient Number"
        start index = 10001
        row = 1
        column = 1
        width = medium
    )
    must have Patient_Name
    (
        type = text
        displayname = "Patient Name"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Date_of_Birth
    (
        type = date
        displayname = "Date of Birth"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Gender
    (
        type = picklist
        displayname = "Gender"
        values = {"Female","Male","Non-binary","Prefer not to say","Other"}
        row = 1
        column = 1
        width = medium
    )
    Phone
    (
        type = phonenumber
        displayname = "Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Email
    (
        type = email
        displayname = "Email"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Address
    (
        type = textarea
        displayname = "Address"
        personal data = true
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    Emergency_Contact_Name
    (
        type = text
        displayname = "Emergency Contact Name"
        personal data = true
        row = 1
        column = 1
        width = medium
    )
    Emergency_Contact_Phone
    (
        type = phonenumber
        displayname = "Emergency Contact Phone"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    Clinical_Information
    (
        type = section
        displayname = "Clinical Information"
        visibility = true
        row = 2
        column = 1
    )
    Blood_Group
    (
        type = picklist
        displayname = "Blood Group"
        values = {"A+","A-","B+","B-","AB+","AB-","O+","O-","Unknown"}
        row = 2
        column = 1
        width = medium
    )
    Allergies
    (
        type = textarea
        displayname = "Allergies"
        isephi = true
        isencrypted = true
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    Chronic_Conditions
    (
        type = textarea
        displayname = "Chronic Conditions"
        isephi = true
        isencrypted = true
        height = 100px
        row = 2
        column = 1
        width = medium
    )
    Clinical_Risk_Flags
    (
        type = textarea
        displayname = "Clinical Risk Flags"
        isephi = true
        isencrypted = true
        height = 100px
        row = 2
        column = 2
        width = medium
    )
    Consent_on_File
    (
        type = checkbox
        displayname = "Consent on File"
        initial value = false
        row = 2
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Active","Inactive","Deceased","Archived"}
        initial value = "Active"
        row = 2
        column = 2
        width = medium
    )
    Insurance_Information
    (
        type = section
        displayname = "Insurance Information"
        visibility = true
        row = 3
        column = 1
    )
    Has_Insurance
    (
        type = checkbox
        displayname = "Has Insurance"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Insurance_Provider
    (
        type = picklist
        displayname = "Insurance Provider"
        values = Insurance_Providers.ID
        displayformat = [Provider_Name]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Policy_Number
    (
        type = text
        displayname = "Policy Number"
        personal data = true
        isencrypted = true
        row = 3
        column = 1
        width = medium
    )
    Policy_Holder_Name
    (
        type = text
        displayname = "Policy Holder Name"
        personal data = true
        row = 3
        column = 2
        width = medium
    )
    Insurance_Validity_Date
    (
        type = date
        displayname = "Insurance Validity Date"
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
