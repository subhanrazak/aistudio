Patients_On_Load as "Patients On Load"
{
    type = form
    form = Patients
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Has_Insurance == true)
                {
                    show Insurance_Provider;
                    show Policy_Number;
                    show Policy_Holder_Name;
                    show Insurance_Validity_Date;
                    enable Insurance_Provider;
                    enable Policy_Number;
                    enable Policy_Holder_Name;
                    enable Insurance_Validity_Date;
                }
                else
                {
                    hide Insurance_Provider;
                    hide Policy_Number;
                    hide Policy_Holder_Name;
                    hide Insurance_Validity_Date;
                    disable Insurance_Provider;
                    disable Policy_Number;
                    disable Policy_Holder_Name;
                    disable Insurance_Validity_Date;
                }
            )
        }
    }
}
