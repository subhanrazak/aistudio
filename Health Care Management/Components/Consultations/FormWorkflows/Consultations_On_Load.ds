Consultations_On_Load as "Consultations On Load"
{
    type = form
    form = Consultations
    record event = on add or edit

    on load
    {
        actions
        {
            custom deluge script
            (
                if (input.Requires_Follow_Up == true || input.Visit_Outcome == "Follow-up Required")
                {
                    show Follow_Up_Date;
                    enable Follow_Up_Date;
                }
                else
                {
                    hide Follow_Up_Date;
                    disable Follow_Up_Date;
                }
                if (input.Visit_Outcome == "Referred")
                {
                    show Referral_Notes;
                    enable Referral_Notes;
                }
                else
                {
                    hide Referral_Notes;
                    disable Referral_Notes;
                }
            )
        }
    }
}
