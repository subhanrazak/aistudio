form Consultations
{
    displayname = "Consultations"
    Consultation_Details
    (
        type = section
        displayname = "Consultation Details"
        row = 1
        column = 0
    )
    Consultation_Number
    (
        type = autonumber
        displayname = "Consultation Number"
        start index = 30001
        row = 1
        column = 1
        width = medium
    )
    must have Patient
    (
        type = picklist
        displayname = "Patient"
        values = Patients.ID
        displayformat = [Patient_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Appointment
    (
        type = picklist
        displayname = "Appointment"
        values = Appointments.ID
        displayformat = [Appointment_Number]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    must have Provider
    (
        type = picklist
        displayname = "Provider"
        values = Staff_Members.ID
        displayformat = [Full_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Consultation_DateTime
    (
        type = datetime
        displayname = "Consultation Date/Time"
        initial value = "${zoho.currenttime}"
        row = 1
        column = 2
        width = medium
    )
    Symptoms
    (
        type = textarea
        displayname = "Symptoms"
        isephi = true
        isencrypted = true
        height = 120px
        row = 1
        column = 1
        width = medium
    )
    Vitals
    (
        type = section
        displayname = "Vitals"
        visibility = true
        row = 2
        column = 1
    )
    Vital_Temperature
    (
        type = decimal
        displayname = "Temperature"
        decimalplace = 1
        row = 2
        column = 1
        width = medium
    )
    Vital_Pulse
    (
        type = number
        displayname = "Pulse"
        row = 2
        column = 2
        width = medium
    )
    Blood_Pressure
    (
        type = text
        displayname = "Blood Pressure"
        row = 2
        column = 1
        width = medium
    )
    Weight
    (
        type = decimal
        displayname = "Weight"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Clinical_Notes
    (
        type = section
        displayname = "Clinical Notes"
        visibility = true
        row = 3
        column = 1
    )
    Diagnosis
    (
        type = textarea
        displayname = "Diagnosis"
        isephi = true
        isencrypted = true
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Treatment_Plan
    (
        type = textarea
        displayname = "Treatment Plan"
        isephi = true
        isencrypted = true
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    must have Visit_Outcome
    (
        type = picklist
        displayname = "Visit Outcome"
        values = {"Treated","Referred","Admitted","Follow-up Required","Observation"}
        initial value = "Treated"
        row = 3
        column = 1
        width = medium
    )
    Requires_Follow_Up
    (
        type = checkbox
        displayname = "Requires Follow Up"
        initial value = false
        row = 3
        column = 2
        width = medium
    )
    Follow_Up_Date
    (
        type = date
        displayname = "Follow Up Date"
        row = 3
        column = 1
        width = medium
    )
    Referral_Notes
    (
        type = textarea
        displayname = "Referral Notes"
        isephi = true
        height = 100px
        row = 3
        column = 2
        width = medium
    )
    Internal_Admin_Notes
    (
        type = textarea
        displayname = "Internal Admin Notes"
        private = true
        height = 100px
        row = 3
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
