list Recent_Consultations
{
    displayName = "Recent Consultations"
    show all rows from Consultations
    (
        Consultation_Number
        Patient
        Provider
        Consultation_DateTime
        Diagnosis
        Visit_Outcome
    )
    filters
    (
        Provider
        Visit_Outcome
    )
    sort by
    (
        Consultation_DateTime descending
    )
}
