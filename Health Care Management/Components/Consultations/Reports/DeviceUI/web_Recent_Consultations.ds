report Recent_Consultations
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Consultation_Number
                    Patient
                    Provider
                    Consultation_DateTime
                    Diagnosis
                    Visit_Outcome
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Consultation_Number
                    Patient
                    Provider
                    Consultation_DateTime
                    Diagnosis
                    Visit_Outcome
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
