report All_Consultations
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Consultation_Number
                    Patient
                    Appointment
                    Provider
                    Consultation_DateTime
                    Visit_Outcome
                    Requires_Follow_Up
                    Follow_Up_Date
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
            record ( Edit  Duplicate  Delete )
        )
        action
        (
            on click ( View Record )
            on right click ( Edit  Delete  Duplicate  View Record )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Consultation_Number
                    Patient
                    Appointment
                    Provider
                    Consultation_DateTime
                    Visit_Outcome
                    Requires_Follow_Up
                    Follow_Up_Date
                )
            )
        )
        menu
        (
            header ( Edit  Duplicate  Delete )
        )
    )
}
