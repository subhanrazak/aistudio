calendar Follow_Up_Calendar
{
    displayName = "Follow Up Calendar"
    show all rows from Consultations [Requires_Follow_Up == true && Follow_Up_Date is not null]
    (
        Consultation_Number
        Patient
        Provider
        Follow_Up_Date
        Visit_Outcome
    )
    filters
    (
        Provider
        Visit_Outcome
        Follow_Up_Date
    )
    options
    (
        display type = month
        week start day = monday
        display field = Patient
        start date = Follow_Up_Date
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
