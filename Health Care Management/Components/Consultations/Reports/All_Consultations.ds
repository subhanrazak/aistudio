default list All_Consultations
{
    displayName = "All Consultations"
    show all rows from Consultations
    (
        Consultation_Number
        Patient
        Appointment
        Provider
        Consultation_DateTime
        Visit_Outcome
        Requires_Follow_Up
        Follow_Up_Date
    )
    filters
    (
        Provider
        Visit_Outcome
        Requires_Follow_Up
    )
    sort by
    (
        Consultation_DateTime descending
    )
}
