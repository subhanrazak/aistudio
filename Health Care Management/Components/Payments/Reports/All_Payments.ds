default list All_Payments
{
    displayName = "All Payments"
    show all rows from Payments
    (
        Payment_Number
        Invoice
        Payment_Date
        Payment_Method
        Paid_By
        Amount
        Payment_Status
        Reference_Number
    )
    filters
    (
        Payment_Status
        Payment_Method
    )
    sort by
    (
        Payment_Date descending
    )
}
