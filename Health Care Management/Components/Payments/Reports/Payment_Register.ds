list Payment_Register
{
    displayName = "Payment Register"
    show all rows from Payments
    (
        Payment_Number
        Invoice
        Payment_Date
        Payment_Method
        Amount
        Payment_Status
    )
    filters
    (
        Payment_Method
        Payment_Status
    )
    group by
    (
        properties
        (
            display record count = true
        )
        Payment_Method ascending
    )
    sort by
    (
        Payment_Date descending
    )
}
