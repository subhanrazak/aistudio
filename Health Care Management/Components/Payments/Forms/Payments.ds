form Payments
{
    displayname = "Payments"
    Payment_Details
    (
        type = section
        displayname = "Payment Details"
        row = 1
        column = 0
    )
    Payment_Number
    (
        type = autonumber
        displayname = "Payment Number"
        start index = 80001
        row = 1
        column = 1
        width = medium
    )
    must have Invoice
    (
        type = picklist
        displayname = "Invoice"
        values = Invoices.ID
        displayformat = [Invoice_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Payment_Date
    (
        type = date
        displayname = "Payment Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    must have Payment_Method
    (
        type = picklist
        displayname = "Payment Method"
        values = {"Cash","Card","Bank Transfer","UPI","Insurance Payout","Other"}
        row = 1
        column = 1
        width = medium
    )
    Paid_By
    (
        type = text
        displayname = "Paid By"
        row = 1
        column = 2
        width = medium
    )
    must have Amount
    (
        type = decimal
        displayname = "Amount"
        decimalplace = 2
        row = 1
        column = 1
        width = medium
    )
    Reference_Number
    (
        type = text
        displayname = "Reference Number"
        row = 1
        column = 2
        width = medium
    )
    must have Payment_Status
    (
        type = picklist
        displayname = "Payment Status"
        values = {"Received","Pending","Failed","Refunded"}
        initial value = "Received"
        row = 1
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        displayname = "Notes"
        height = 100px
        row = 1
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
