		    (
		        type = phonenumber
		        displayname = "Emergency Contact Phone"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Clinical_Information
		    (
		        type = section
		        displayname = "Clinical Information"
		        visibility = true
		        row = 2
		        column = 1
		    )
