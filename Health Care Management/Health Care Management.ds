		    (
		        type = picklist
		        displayname = "Blood Group"
		        values = {"A+","A-","B+","B-","AB+","AB-","O+","O-","Unknown"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Allergies
		    (
		        type = textarea
		        displayname = "Allergies"
		        isephi = true
		        isencrypted = true
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Chronic_Conditions
		    (
		        type = textarea
		        displayname = "Chronic Conditions"
		        isephi = true
		        isencrypted = true
		        height = 100px
		        row = 2
		        column = 1
		        width = medium
		    )
		    Clinical_Risk_Flags
		    (
		        type = textarea
		        displayname = "Clinical Risk Flags"
		        isephi = true
		        isencrypted = true
		        height = 100px
		        row = 2
		        column = 2
		        width = medium
		    )
		    Consent_on_File
		    (
		        type = checkbox
		        displayname = "Consent on File"
		        initial value = false
		        row = 2
		        column = 1
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive","Deceased","Archived"}
		        initial value = "Active"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Insurance_Information
		    (
		        type = section
		        displayname = "Insurance Information"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Has_Insurance
		    (
		        type = checkbox
		        displayname = "Has Insurance"
		        initial value = false
		        row = 3
		        column = 1
		        width = medium
		    )
		    Insurance_Provider
		    (
		        type = picklist
		        displayname = "Insurance Provider"
		        values = Insurance_Providers.ID
		        displayformat = [Provider_Name]
		        searchable = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Policy_Number
		    (
		        type = text
		        displayname = "Policy Number"
		        personal data = true
		        isencrypted = true
		        row = 3
		        column = 1
		        width = medium
		    )
		    Policy_Holder_Name
		    (
		        type = text
		        displayname = "Policy Holder Name"
		        personal data = true
		        row = 3
		        column = 2
		        width = medium
		    )
		    Insurance_Validity_Date
		    (
		        type = date
		        displayname = "Insurance Validity Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Payments
		{
		    displayname = "Payments"
		    Payment_Details
		    (
		        type = section
		        displayname = "Payment Details"
		        row = 1
		        column = 0
		    )
		    Payment_Number
		    (
		        type = autonumber
		        displayname = "Payment Number"
		        start index = 80001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice
		    (
		        type = picklist
		        displayname = "Invoice"
		        values = Invoices.ID
		        displayformat = [Invoice_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Payment_Date
		    (
		        type = date
		        displayname = "Payment Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Payment_Method
		    (
		        type = picklist
		        displayname = "Payment Method"
		        values = {"Cash","Card","Bank Transfer","UPI","Insurance Payout","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Paid_By
		    (
		        type = text
		        displayname = "Paid By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Amount
		    (
		        type = decimal
		        displayname = "Amount"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Reference_Number
		    (
		        type = text
		        displayname = "Reference Number"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Payment_Status
		    (
		        type = picklist
		        displayname = "Payment Status"
		        values = {"Received","Pending","Failed","Refunded"}
		        initial value = "Received"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

