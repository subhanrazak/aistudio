		        Invoice
		        Payment_Date
		        Payment_Method
		        Paid_By
		        Amount
		        Payment_Status
		        Reference_Number
		    )
		    filters
		    (
		        Payment_Status
		        Payment_Method
		    )
		    sort by
		    (
		        Payment_Date descending
		    )
		}

		list Payment_Register
		{
		    displayName = "Payment Register"
		    show all rows from Payments
		    (
		        Payment_Number
		        Invoice
		        Payment_Date
		        Payment_Method
		        Amount
		        Payment_Status
		    )
		    filters
		    (
		        Payment_Method
		        Payment_Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Payment_Method ascending
		    )
		    sort by
		    (
		        Payment_Date descending
		    )
		}

		list Received_Payments
		{
		    displayName = "Received Payments"
		    show all rows from Payments [Payment_Status == "Received"]
		    (
		        Payment_Number
		        Invoice
		        Payment_Date
		        Payment_Method
		        Paid_By
		        Amount
		        Reference_Number
		    )
		    filters
		    (
		        Payment_Method
		    )
		    sort by
		    (
		        Payment_Date descending
		    )
		}

		list Active_Prescriptions
		{
		    displayName = "Active Prescriptions"
		    show all rows from Prescriptions [Status == "Issued"]
		    (
		        Prescription_Number
		        Patient
		        Provider
		        Prescription_Date
		        Medication_Details
		        Dosage_Instructions
		        Refill_Until
		        Status
		    )
		    filters
		    (
		        Provider
		        Refill_Until
		        Status
		    )
		    sort by
		    (
		        Prescription_Date descending
		    )
		}

		default list All_Prescriptions
		{
		    displayName = "All Prescriptions"
		    show all rows from Prescriptions
		    (
		        Prescription_Number
		        Patient
		        Consultation
		        Provider
		        Prescription_Date
		        Medication_Details
		        Duration_Days
		        Refill_Allowed
		        Refill_Until
		        Status
		    )
		    filters
		    (
		        Provider
		        Status
		        Refill_Allowed
		    )
		    sort by
		    (
		        Prescription_Date descending
		    )
		}

		list Patient_Prescription_History
		{
		    displayName = "Patient Prescription History"
		    show all rows from Prescriptions
		    (
		        Prescription_Number
		        Patient
		        Consultation
		        Provider
		        Prescription_Date
		        Medication_Details
		        Status
		    )
		    filters
		    (
		        Patient
		        Provider
		        Status
		    )
		    group by
		    (
		        properties
		        (
		            display record count = true
		        )
		        Patient ascending
		    )
		    sort by
		    (
		        Prescription_Date descending
		    )
		}

		list Active_Doctors
		{
		    displayName = "Active Doctors"
		    show all rows from Staff_Members [Role == "Doctor" && Active == true]
		    (
		        Staff_Code
		        Full_Name
		        Specialty
		        Email
		        Phone
		        Standard_Consultation_Fee
		    )
		    sort by
		    (
		        Full_Name ascending
		    )
		}

		default list Staff_Directory
		{
		    displayName = "Staff Directory"
		    show all rows from Staff_Members
		    (
		        Staff_Code
		        Full_Name
		        Role
		        Specialty
		        Email
		        Phone
		        Active
		        Available_For_Appointments
		        Standard_Consultation_Fee
		    )
		    filters
		    (
		        Role
		        Active
		        Available_For_Appointments
		    )
		    sort by
		    (
		        Full_Name ascending
		    )
		}
	}

	pages
	{
		page Clinic_Dashboard
		{
					displayname = "Clinic Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Clinic_KPI_Cards' elementName='Clinic_KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage Clinic_KPI_Cards()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nactivePatients = Patients[Status == &quot;Active&quot;].count();\ntodayAppointments = Appointments[Appointment_Date == zoho.currentdate].count();\ncheckedInAppointments = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Checked In&quot;].count();\nopenInsuranceClaims = Insurance_Claims[Claim_Status != &quot;Approved&quot; &amp;&amp; Claim_Status != &quot;Denied&quot; &amp;&amp; Claim_Status != &quot;Closed&quot;].count();\noutstandingInvoices = Invoices[Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Cancelled&quot;];\noutstandingInvoiceBalance = 0;\nif(outstandingInvoices.count() &gt; 0)\n{\n\t\toutstandingInvoiceBalance = ifnull(outstandingInvoices.sum(Balance_Due),0);\n}\nreceivedPaymentsThisMonth = 0;\ncurrentMonth = zoho.currentdate.getMonth();\ncurrentYear = zoho.currentdate.getYear();\nfor each paymentRecord in Payments[Payment_Status == &quot;Received&quot;]\n{\n\t\tif(paymentRecord.Payment_Date != null &amp;&amp; paymentRecord.Payment_Date.getMonth() == currentMonth &amp;&amp; paymentRecord.Payment_Date.getYear() == currentYear)\n\t\t{\n\t\t\t\treceivedPaymentsThisMonth = receivedPaymentsThisMonth + ifnull(paymentRecord.Amount,0);\n\t\t}\n}\n%&gt;\n&lt;style&gt;\n/* zcs-global.css essentials included once for Clinic_Dashboard */\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t\t--zcs-page-bg-color: #F3F3F4;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-black-color: #000000;\n\t\t--zcs-thead-color: #F9FAFE;\n\t\t--zcs-tr-h-color: #F9FAFE;\n}\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-6 { gap: 0.375rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-12 { padding: 0.75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-8 { padding-left: 0.5rem; padding-right: 0.5rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-12 { padding-left: 0.75rem; padding-right: 0.75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-6 { padding-top: 0.375rem; padding-bottom: 0.375rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-10 { padding-top: 0.625rem; padding-bottom: 0.625rem; }\n.zcs-py-12 { padding-top: 0.75rem; padding-bottom: 0.75rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: 0.25rem; }\n.zcs-mt-5 { margin-top: 0.3125rem; }\n.zcs-mt-8 { margin-top: 0.5rem; }\n.zcs-mt-10 { margin-top: 0.625rem; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-rounded-xl { border-radius: 0.75rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-col-common { flex: 1 1 0; min-width: 0; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-12 { flex: 0 0 100%; max-width: 100%; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-15 { font-size: 0.9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; }\na { text-decoration: none; }\n\n/* badge-badge-with-icon */\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #a06309; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n\n/* progress-bar-range-bar-with-texts */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color); overflow: hidden; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs_brand_color); }\n\n/* table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs_tertiary_border_color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs_tertiary_border_color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs_tertiary_border_color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-table-wrapper table tbody tr td .zcs-green { color: #179e6c; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-table-wrapper table tbody tr td .zcs-red { color: #fe455d; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-table-wrapper table tbody tr td .zcs-yellow { color: #a06309; }\n.zcs-table-wrapper table tbody tr td.zcs-l_blue, .zcs-table-wrapper table tbody tr td .zcs-l_blue { color: #1094c5; }\n\n/* timeline-simple-timeline */\n.zcs-timeline-wrapper ul { list-style: none; }\n.zcs-tl-indicator { width: 60px; left: 16.6667%; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }\n\n/* Clinic dashboard */\n.clinic-dashboard-shell { width: 100%; box-sizing: border-box; font-family: inherit; color: var(--zcs-primary-text-color); }\n.clinic-dashboard-header { min-height: 96px; padding: 22px 24px; margin-bottom: 16px; overflow: hidden; position: relative; background: linear-gradient(120deg, var(--zcs_brand_color), color-mix(in srgb, var(--zcs_brand_color) 70%, #1328CD)); color: var(--zcs_brand_foreground_color); }\n.clinic-dashboard-header:after { content: &apos;&apos;; position: absolute; width: 280px; height: 280px; right: -80px; top: -112px; border-radius: 50%; border: 34px solid rgba(255,255,255,0.12); }\n.clinic-header-title { position: relative; z-index: 1; font-size: 24px; line-height: 1.2; font-weight: 700; margin: 0; color: var(--zcs_brand_foreground_color); }\n.clinic-header-subtitle { position: relative; z-index: 1; margin: 6px 0 0; color: rgba(255,255,255,0.86); font-size: 14px; }\n.clinic-header-meta { position: relative; z-index: 1; color: rgba(255,255,255,0.9); font-size: 13px; text-align: right; }\n.clinic-kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(150px, 1fr)); gap: 14px; }\n.clinic-kpi-card { display: flex; flex-direction: column; gap: 12px; padding: 18px; min-height: 132px; transition: border-color .15s ease, transform .15s ease; }\n.clinic-kpi-card:hover { border-color: var(--zcs_brand_color); transform: translateY(-1px); }\n.clinic-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n.clinic-kpi-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs_component_hover_color); color: var(--zcs_brand_color); font-size: 20px; }\n.clinic-kpi-value { font-size: 28px; font-weight: 700; line-height: 1; color: var(--zcs-primary-text-color); word-break: break-word; }\n.clinic-kpi-label { font-size: 13px; color: var(--zcs-secondary-text-color); line-height: 1.35; }\n.clinic-card { padding: 18px; }\n.clinic-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 14px; }\n.clinic-section-title h3 { margin: 0; font-size: 18px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }\n.clinic-section-title span, .clinic-muted { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.clinic-link { color: var(--zcs_brand_color); font-weight: 600; font-size: 13px; }\n.clinic-status-grid { display: grid; grid-template-columns: repeat(3, minmax(135px, 1fr)); gap: 12px; }\n.clinic-status-card { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; padding: 14px; background: var(--zcs-white-color); }\n.clinic-status-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }\n.clinic-status-label { color: var(--zcs-secondary-text-color); font-size: 13px; }\n.clinic-status-count { color: var(--zcs-primary-text-color); font-size: 22px; font-weight: 700; }\n.clinic-status-card .zcs-progress-bar-indicator { background: var(--clinic-accent, var(--zcs_brand_color)); }\n.clinic-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(190px, 1fr)); gap: 12px; }\n.clinic-summary-tile { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 12px; padding: 14px; background: #fff; }\n.clinic-summary-label { font-size: 13px; color: var(--zcs-secondary-text-color); margin: 0 0 6px; }\n.clinic-summary-value { font-size: 24px; line-height: 1.1; font-weight: 700; color: var(--zcs-primary-text-color); margin: 0; }\n.clinic-summary-foot { font-size: 12px; color: var(--zcs-teritiary-text-color); margin-top: 8px; }\n.clinic-activity-layout { display: grid; grid-template-columns: repeat(3, minmax(210px, 1fr)); gap: 14px; }\n.clinic-activity-column { min-height: 100%; }\n.clinic-mini-title { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; font-size: 15px; font-weight: 700; color: var(--zcs-primary-text-color); }\n.clinic-feed-list { display: flex; flex-direction: column; gap: 12px; }\n.clinic-feed-item { border: 1px solid var(--zcs_tertiary_border_color); border-radius: 10px; padding: 12px; background: #fff; }\n.clinic-feed-primary { font-size: 14px; font-weight: 600; color: var(--zcs-primary-text-color); margin: 0 0 4px; }\n.clinic-feed-secondary { font-size: 12px; color: var(--zcs-secondary-text-color); margin: 0 0 8px; }\n.clinic-empty { display: flex; align-items: center; justify-content: center; min-height: 86px; color: var(--zcs-secondary-text-color); border: 1px dashed var(--zcs_tertiary_border_color); border-radius: 10px; background: #fff; font-size: 13px; }\n.clinic-open-work-grid { display: grid; grid-template-columns: repeat(3, minmax(240px, 1fr)); gap: 14px; }\n.clinic-table-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 10px; }\n.clinic-table-title h4 { margin: 0; font-size: 15px; line-height: 1.25; font-weight: 700; color: var(--zcs-primary-text-color); }\n.clinic-compact-table .zcs-table-wrapper { max-height: 340px; }\n.clinic-compact-table td, .clinic-compact-table th { vertical-align: top; }\n.clinic-money { white-space: nowrap; }\n@media (max-width: 1280px) {\n\t\t.clinic-kpi-grid { grid-template-columns: repeat(3, minmax(170px, 1fr)); }\n\t\t.clinic-open-work-grid, .clinic-activity-layout { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {\n\t\t.clinic-dashboard-header { flex-direction: column; align-items: flex-start; }\n\t\t.clinic-header-meta { text-align: left; }\n\t\t.clinic-kpi-grid, .clinic-status-grid, .clinic-summary-grid { grid-template-columns: 1fr; }\n\t\t.zcs-col-sm-12 { flex: 0 0 100%; max-width: 100%; }\n\t\t.zcs-tl-li { flex-direction: column; }\n\t\t.zcs-tl-indicator { left: 0; }\n\t\t.zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; }\n}\n&lt;/style&gt;\n&lt;div class=&quot;clinic-dashboard-shell&quot;&gt;\n\t\t&lt;div class=&quot;clinic-dashboard-header zcs-card zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h1 class=&quot;clinic-header-title&quot;&gt;Clinic Dashboard&lt;/h1&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-header-subtitle&quot;&gt;Operational view for patient flow, billing work, insurance, and follow-up activity.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-header-meta&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt; &lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;Signed in as &lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;clinic-kpi-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Active_Patients&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;Open&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value&quot;&gt;&lt;%=activePatients%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Total active patients&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Today_Appointments&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-check-59&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;Today&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value&quot;&gt;&lt;%=todayAppointments%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Today appointments&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Today_Appointments?Appointment_Status=Checked%20In&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;Flow&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value&quot;&gt;&lt;%=checkedInAppointments%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Checked-in appointments&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Open_Insurance_Claims&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;Work&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value&quot;&gt;&lt;%=openInsuranceClaims%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Open insurance claims&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Outstanding_Invoices&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;AR&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value clinic-money&quot;&gt;$&lt;%=outstandingInvoiceBalance%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Outstanding invoice balance&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-kpi-card zcs-card&quot; href=&quot;#Report:Received_Payments&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-top&quot;&gt;&lt;span class=&quot;clinic-kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;clinic-link&quot;&gt;Month&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-value clinic-money&quot;&gt;$&lt;%=receivedPaymentsThisMonth%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-kpi-label&quot;&gt;Received payments this month&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Appointment_Status_Summary' elementName='Appointment_Status_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Appointment_Status_Summary()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nrequestedCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Requested&quot;].count();\nconfirmedCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Confirmed&quot;].count();\ncheckedInCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Checked In&quot;].count();\ncompletedCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Completed&quot;].count();\ncancelledCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;Cancelled&quot;].count();\nnoShowCount = Appointments[Appointment_Date == zoho.currentdate &amp;&amp; Appointment_Status == &quot;No Show&quot;].count();\nstatusTotal = requestedCount + confirmedCount + checkedInCount + completedCount + cancelledCount + noShowCount;\nrequestedPct = if(statusTotal &gt; 0,(requestedCount * 100) / statusTotal,0);\nconfirmedPct = if(statusTotal &gt; 0,(confirmedCount * 100) / statusTotal,0);\ncheckedInPct = if(statusTotal &gt; 0,(checkedInCount * 100) / statusTotal,0);\ncompletedPct = if(statusTotal &gt; 0,(completedCount * 100) / statusTotal,0);\ncancelledPct = if(statusTotal &gt; 0,(cancelledCount * 100) / statusTotal,0);\nnoShowPct = if(statusTotal &gt; 0,(noShowCount * 100) / statusTotal,0);\n%&gt;\n&lt;div class=&quot;clinic-dashboard-shell clinic-card zcs-card&quot;&gt;\n\t\t&lt;div class=&quot;clinic-section-title&quot;&gt;\n\t\t\t\t&lt;h3&gt;&lt;i class=&quot;zc-li-outline ui-2-time-clock&quot;&gt;&lt;/i&gt; Appointment status today&lt;/h3&gt;\n\t\t\t\t&lt;a class=&quot;clinic-link&quot; href=&quot;#Report:Today_Appointments&quot;&gt;View appointments&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;clinic-status-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;Requested&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=requestedCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=requestedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=requestedPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;Confirmed&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=confirmedCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=confirmedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=confirmedPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#F4660C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;Checked In&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=checkedInCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=checkedInPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=checkedInPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#179E6C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;Completed&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=completedCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=completedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=completedPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;Cancelled&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=cancelledCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=cancelledPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=cancelledPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-status-card&quot; style=&quot;--clinic-accent:#a06309;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-status-head&quot;&gt;&lt;span class=&quot;clinic-status-label&quot;&gt;No Show&lt;/span&gt;&lt;span class=&quot;clinic-status-count&quot;&gt;&lt;%=noShowCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=noShowPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;p class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-12 zcs-font-medium zcs-lh-body zcs-m-0&quot;&gt;&lt;span class=&quot;zcs-color-secondary&quot;&gt;Share&lt;/span&gt;&lt;span class=&quot;zcs-color-primary&quot;&gt;&lt;%=noShowPct%&gt;%&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='50%'>\n\t\t\t\t<dsp id='Billing_Claims_Summary' elementName='Billing_Claims_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage Billing_Claims_Summary()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\noutstandingInvoiceRecords = Invoices[Balance_Due &gt; 0 &amp;&amp; Invoice_Status != &quot;Cancelled&quot;];\noutstandingInvoiceCount = outstandingInvoiceRecords.count();\noutstandingBalance = 0;\nif(outstandingInvoiceCount &gt; 0)\n{\n\t\toutstandingBalance = ifnull(outstandingInvoiceRecords.sum(Balance_Due),0);\n}\nopenClaimRecords = Insurance_Claims[Claim_Status != &quot;Approved&quot; &amp;&amp; Claim_Status != &quot;Denied&quot; &amp;&amp; Claim_Status != &quot;Closed&quot;];\nopenClaimCount = openClaimRecords.count();\nopenClaimAmount = 0;\nif(openClaimCount &gt; 0)\n{\n\t\topenClaimAmount = ifnull(openClaimRecords.sum(Claim_Amount),0);\n}\napprovedClaimCount = Insurance_Claims[Claim_Status == &quot;Approved&quot; || Claim_Status == &quot;Partially Approved&quot;].count();\ndeniedClaimCount = Insurance_Claims[Claim_Status == &quot;Denied&quot;].count();\ninsuranceInvoiceCount = Invoices[Insurance_Related == true].count();\nsubmittedClaimCount = Insurance_Claims[Claim_Status == &quot;Submitted&quot;].count();\nreviewClaimCount = Insurance_Claims[Claim_Status == &quot;Under Review&quot;].count();\n%&gt;\n&lt;div class=&quot;clinic-dashboard-shell clinic-card zcs-card&quot;&gt;\n\t\t&lt;div class=&quot;clinic-section-title&quot;&gt;\n\t\t\t\t&lt;h3&gt;&lt;i class=&quot;zc-li-outline business-money-time&quot;&gt;&lt;/i&gt; Billing and claims&lt;/h3&gt;\n\t\t\t\t&lt;a class=&quot;clinic-link&quot; href=&quot;#Report:Outstanding_Invoices&quot;&gt;View invoices&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;clinic-summary-grid&quot;&gt;\n\t\t\t\t&lt;a class=&quot;clinic-summary-tile&quot; href=&quot;#Report:Outstanding_Invoices&quot;&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-label&quot;&gt;Outstanding invoices&lt;/p&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-value&quot;&gt;&lt;%=outstandingInvoiceCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-summary-foot clinic-money&quot;&gt;Balance due: $&lt;%=outstandingBalance%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-summary-tile&quot; href=&quot;#Report:Open_Insurance_Claims&quot;&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-label&quot;&gt;Open claims&lt;/p&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-value&quot;&gt;&lt;%=openClaimCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-summary-foot clinic-money&quot;&gt;Claim amount: $&lt;%=openClaimAmount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-summary-tile&quot; href=&quot;#Report:All_Insurance_Claims?Claim_Status=Approved&quot;&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-label&quot;&gt;Approved or partial claims&lt;/p&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-value&quot;&gt;&lt;%=approvedClaimCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-summary-foot&quot;&gt;Submitted: &lt;%=submittedClaimCount%&gt; / Under review: &lt;%=reviewClaimCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;clinic-summary-tile&quot; href=&quot;#Report:All_Insurance_Claims?Claim_Status=Denied&quot;&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-label&quot;&gt;Denied claims&lt;/p&gt;\n\t\t\t\t\t\t&lt;p class=&quot;clinic-summary-value&quot;&gt;&lt;%=deniedClaimCount%&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-summary-foot&quot;&gt;Insurance-related invoices: &lt;%=insuranceInvoiceCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Followup_Activity_Feed' elementName='Followup_Activity_Feed'>\n\t\t\t\t\t<![CDATA[htmlpage Followup_Activity_Feed()\n\t\t\t\t\t\tcontent\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\nupcomingFollowups = Consultations[Requires_Follow_Up == true &amp;&amp; Follow_Up_Date &gt;= zoho.currentdate];\nrecentConsultations = Consultations[ID != 0];\nrecentPrescriptions = Prescriptions[ID != 0];\n%&gt;\n&lt;div class=&quot;clinic-dashboard-shell clinic-card zcs-card&quot;&gt;\n\t\t&lt;div class=&quot;clinic-section-title&quot;&gt;\n\t\t\t\t&lt;h3&gt;&lt;i class=&quot;zc-li-outline ui-2-notification-69&quot;&gt;&lt;/i&gt; Follow-up and activity feed&lt;/h3&gt;\n\t\t\t\t&lt;span&gt;Upcoming follow-ups, latest clinical activity, and prescription work&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;clinic-activity-layout&quot;&gt;\n\t\t\t\t&lt;div class=&quot;clinic-activity-column&quot;&gt;\n\t\t\t\t\t\t&lt;h4 class=&quot;clinic-mini-title&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-grid-58&quot;&gt;&lt;/i&gt; Upcoming follow-ups&lt;/h4&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tfollowupShown = 0;\n\t\t\t\t\t\t\t\tfor each followRecord in upcomingFollowups\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(followupShown &lt; 5)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tfollowNumber = ifnull(followRecord.Consultation_Number,&quot;Consultation&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tfollowDate = ifnull(followRecord.Follow_Up_Date,&quot;No date&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tfollowOutcome = ifnull(followRecord.Visit_Outcome,&quot;Follow-up&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-item&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-primary&quot;&gt;&lt;%=followNumber%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-secondary&quot;&gt;Follow-up date: &lt;%=followDate%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=followOutcome%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tfollowupShown = followupShown + 1;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(followupShown == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;clinic-empty&quot;&gt;No upcoming follow-ups&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-activity-column&quot;&gt;\n\t\t\t\t\t\t&lt;h4 class=&quot;clinic-mini-title&quot;&gt;&lt;i class=&quot;zc-li-outline health-stethoscope&quot;&gt;&lt;/i&gt; Recent consultations&lt;/h4&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tconsultShown = 0;\n\t\t\t\t\t\t\t\tfor each consultRecord in recentConsultations\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(consultShown &lt; 5)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tconsultNumber = ifnull(consultRecord.Consultation_Number,&quot;Consultation&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tconsultDate = ifnull(consultRecord.Consultation_DateTime,&quot;No date&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tconsultStatus = ifnull(consultRecord.Visit_Outcome,&quot;Recorded&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tconsultBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tconsultIcon = &quot;loader-dots-06&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(consultStatus == &quot;Treated&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(consultStatus == &quot;Referred&quot; || consultStatus == &quot;Admitted&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultBadgeClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultIcon = &quot;arrows-1-share-66&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(consultStatus == &quot;Follow-up Required&quot; || consultStatus == &quot;Observation&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tconsultIcon = &quot;ui-2-time&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-item&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-primary&quot;&gt;&lt;%=consultNumber%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-secondary&quot;&gt;Consulted: &lt;%=consultDate%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=consultBadgeClass%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=consultIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=consultStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tconsultShown = consultShown + 1;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(consultShown == 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t%&gt;&lt;div class=&quot;clinic-empty&quot;&gt;No recent consultations&lt;/div&gt;&lt;%\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-activity-column&quot;&gt;\n\t\t\t\t\t\t&lt;h4 class=&quot;clinic-mini-title&quot;&gt;&lt;i class=&quot;zc-li-outline health-pills&quot;&gt;&lt;/i&gt; Recent prescriptions&lt;/h4&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\tprescriptionShown = 0;\n\t\t\t\t\t\t\t\tfor each prescriptionRecord in recentPrescriptions\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif(prescriptionShown &lt; 5)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tprescriptionNumber = ifnull(prescriptionRecord.Prescription_Number,&quot;Prescription&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tprescriptionDate = ifnull(prescriptionRecord.Prescription_Date,&quot;No date&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tprescriptionStatus = ifnull(prescriptionRecord.Status,&quot;Draft&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\tprescriptionBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tprescriptionIcon = &quot;loader-dots-06&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\tif(prescriptionStatus == &quot;Issued&quot; || prescriptionStatus == &quot;Completed&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(prescriptionStatus == &quot;Cancelled&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(prescriptionStatus == &quot;Draft&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionBadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tprescriptionIcon = &quot;files-single-folded-content&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;clinic-feed-item&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-primary&quot;&gt;&lt;%=prescriptionNumber%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;clinic-feed-secondary&quot;&gt;Prescription date: &lt;%=prescriptionDate%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=prescriptionBadgeClass%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline &lt;%=prescriptionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=prescriptionStatus%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\