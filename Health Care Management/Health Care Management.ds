	reports
	{
		default list All_Appointments
		{
		    displayName = "All Appointments"
		    show all rows from Appointments
		    (
		        Appointment_Number
		        Patient
		        Provider
		        Appointment_Date
		        Appointment_Time
		        Visit_Type
		        Appointment_Status
		    )
		    filters
		    (
		        Appointment_Status
		        Provider
		        Visit_Type
		        Appointment_Date
		    )
		    sort by
		    (
		        Appointment_Date descending
		        Appointment_Time descending
		    )
		}

		calendar Appointment_Calendar
		{
		    displayName = "Appointment Calendar"
		    show all rows from Appointments
		    (
		        Appointment_Number
		        Patient
		        Provider
		        Appointment_Date
		        Appointment_Time
		        Appointment_Status
		    )
		    filters
		    (
		        Appointment_Status
		        Provider
		        Appointment_Date
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Patient
		        start date = Appointment_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		kanban Appointment_Status_Board
		{
		    displayName = "Appointment Status Board"
		    show all rows from Appointments
		    (
		        Appointment_Number
		        Patient
		        Provider
		        Appointment_Date
		        Appointment_Time
		        Visit_Type
		        Appointment_Status
		    )
		    filters
		    (
		        Provider
		        Visit_Type
		        Appointment_Date
		    )
		    sort by
		    (
		        Appointment_Date descending
		        Appointment_Time descending
		    )
		    options
		    (
		        display field = Appointment_Status
		        othercolumn = "Other"
		        filter type = manual
		        sort order = custom
		        record count = enable
		    )
		}

		list Today_Appointments
		{
		    displayName = "Today Appointments"
		    show all rows from Appointments [Appointment_Date == zoho.currentdate]
		    (
		        Appointment_Number
		        Patient
		        Provider
		        Appointment_Time
		        Visit_Type
		        Appointment_Status
		    )
		    filters
		    (
		        Appointment_Status
		        Provider
		        Visit_Type
		    )
		    sort by
		    (
		        Appointment_Time ascending
		    )
		}

		default list All_Audit_Logs
		{
		    displayName = "All Audit Logs"
		    show all rows from Audit_Logs
		    (
		        Audit_Number
		        Event_Time
		        Entity_Type
		        Entity_Record_ID
		        Action_Type
		        Performed_By
		        Sensitivity
		        Summary
		    )
		    filters
		    (
		        Entity_Type
		        Action_Type
		        Sensitivity
		    )
		    sort by
		    (
		        Event_Time descending
		    )
		}

		list High_Sensitivity_Audits
		{
		    displayName = "High Sensitivity Audits"
		    show all rows from Audit_Logs [Sensitivity == "High"]
		    (
		        Audit_Number
		        Event_Time
		        Entity_Type
		        Entity_Record_ID
		        Action_Type
		        Performed_By
		        Summary
		    )
		    filters
		    (
		        Entity_Type
		        Action_Type
		    )
		    sort by
		    (
		        Event_Time descending
		    )
		}

		default list All_Consultations
		{
		    displayName = "All Consultations"
		    show all rows from Consultations
		    (
		        Consultation_Number
		        Patient
		        Appointment
		        Provider
		        Consultation_DateTime
		        Visit_Outcome
		        Requires_Follow_Up
		        Follow_Up_Date
		    )
		    filters
		    (
		        Provider
		        Visit_Outcome
		        Requires_Follow_Up
		    )
		    sort by
		    (
		        Consultation_DateTime descending
		    )
		}

		calendar Follow_Up_Calendar
		{
		    displayName = "Follow Up Calendar"
		    show all rows from Consultations [Requires_Follow_Up == true && Follow_Up_Date is not null]
		    (
		        Consultation_Number
		        Patient
		        Provider
		        Follow_Up_Date
		        Visit_Outcome
		    )
		    filters
		    (
		        Provider
		        Visit_Outcome
		        Follow_Up_Date
		    )
		    options
		    (
		        display type = month
		        week start day = monday
		        display field = Patient
		        start date = Follow_Up_Date
		        default date
		        (
		            day = Today
		            month = Currentmonth
		            year = Currentyear
		        )
		    )
		}

		list Recent_Consultations
		{
		    displayName = "Recent Consultations"
		    show all rows from Consultations
		    (
		        Consultation_Number
		        Patient
		        Provider
		        Consultation_DateTime
		        Diagnosis
		        Visit_Outcome
		    )
		    filters
		    (
		        Provider
		        Visit_Outcome
		    )
		    sort by
		    (
		        Consultation_DateTime descending
		    )
		}

		default list All_Insurance_Claims
		{
		    displayName = "All Insurance Claims"
		    show all rows from Insurance_Claims
		    (
		        Claim_Number
		        Patient
		        Insurance_Provider
		        Invoice
		        Claim_Date
		        Claim_Amount
		        Approved_Amount
		        Copay_Amount
		        Claim_Status
		        Claim_Reference_Number
