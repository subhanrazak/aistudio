		blueprint
		{
			Claim_Review_Process as "Claim Review Process"
			{
			    type = blueprint
			    form = Insurance_Claims
			
			    start
			    {
			        start stage = "Draft"
			    }
			
			    stages
			    {
			        "Draft" { }
			        "Submitted" { }
			        "Under Review" { }
			        "Approved" { }
			        "Partially Approved" { }
			        "Denied" { }
			        "Closed" { }
			    }
			
			    transitions
			    {
			        Submit_Claim as "Submit Claim"
			        {
			            type = normal
			            from stage = "Draft"
			            to stage = "Submitted"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Staff","Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Submitted";
			                    if (Submission_Date == null)
			                    {
			                        Submission_Date = zoho.currentdate;
			                    }
			                    )
			                }
			            }
			        }
			        Start_Review as "Start Review"
			        {
			            type = normal
			            from stage = "Submitted"
			            to stage = "Under Review"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Staff","Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Under Review";
			                    if (Submission_Date == null)
			                    {
			                        Submission_Date = zoho.currentdate;
			                    }
			                    )
			                }
			            }
			        }
			        Approve_Claim as "Approve"
			        {
			            type = normal
			            from stage = "Under Review"
			            to stage = "Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Approved";
			                    if (Approval_Date == null)
			                    {
			                        Approval_Date = zoho.currentdate;
			                    }
			                    )
			                }
			            }
			        }
			        Partially_Approve_Claim as "Partially Approve"
			        {
			            type = normal
			            from stage = "Under Review"
			            to stage = "Partially Approved"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Partially Approved";
			                    if (Approval_Date == null)
			                    {
			                        Approval_Date = zoho.currentdate;
			                    }
			                    )
			                }
			            }
			        }
			        Deny_Claim as "Deny"
			        {
			            type = normal
			            from stage = "Under Review"
			            to stage = "Denied"
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Denied";
			                    )
			                }
			            }
			        }
			        Close_Claim as "Close"
			        {
			            type = common
			            from stage = "Approved"
			            to stage = "Closed"
			            common stages = {"Partially Approved","Denied"}
			            before
			            {
			                transition owner
			                (
			                    permissions = {"Staff","Administrator"}
			                )
			            }
			            after
			            {
			                actions
			                {
			                    custom deluge script
			                    (
			                    Claim_Status = "Closed";
			                    )
			                }
			            }
			        }
			    }
			}
		}
	}

	share_settings
	{
	"Administrator"
	{
	    name        = "Administrator"
	    type        = Users_Permissions
	    permissions = { Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true }
	    description = "Built-in administrator profile reference for unrestricted application administration and blueprint transition ownership."
	}
	"Staff"
	{
	    name        = "Staff"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:true }
	    description = "Clinic staff profile for day-to-day health care management without delete rights or direct audit-log access."
	
	    ModulePermissions
	    {
	        Insurance_Providers
	        {
	            enabled          = Viewall,Tab,View,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Insurance_Providers={"View"}
	                Active_Insurance_Providers={"View"}
	            }
	        }
	        Staff_Members
	        {
	            enabled          = Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                Staff_Directory={"View"}
	                Active_Doctors={"View"}
	            }
	            FieldPermissions
	            {
	                Staff_Code{visibility:true,readonly:true}
	                Full_Name{visibility:true,readonly:true}
	                Role{visibility:true,readonly:true}
	                Specialty{visibility:true,readonly:true}
	                Email{visibility:true,readonly:false}
	                Phone{visibility:true,readonly:false}
	                Active{visibility:true,readonly:false}
	                Available_For_Appointments{visibility:true,readonly:false}
	                Standard_Consultation_Fee{visibility:true,readonly:true}
	            }
	        }
	        Patients
	        {
	            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Patients={"View"}
	                Active_Patients={"View"}
	                Patient_Insurance_Status={"View"}
	            }
	        }
	        Appointments
	        {
	            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                All_Appointments={"View"}
	                Appointment_Calendar={"View"}
	                Today_Appointments={"View"}
	                Appointment_Status_Board={"View"}
	            }
	            FieldPermissions
	            {
	                Appointment_Number{visibility:true,readonly:true}
	                Patient{visibility:true,readonly:false}
	                Provider{visibility:true,readonly:false}
	                Appointment_Date{visibility:true,readonly:false}
	                Appointment_Time{visibility:true,readonly:false}
	                Visit_Type{visibility:true,readonly:false}
	                Appointment_Status{visibility:true,readonly:false}
	                Reason_for_Visit{visibility:true,readonly:false}
	                Followup_Reason{visibility:true,readonly:false}
	                Cancellation_Reason{visibility:true,readonly:false}
	                Internal_Notes{visibility:false}
	            }
	        }
	        Consultations
	        {
	            enabled          = Create,Viewall,Modifyall,Tab,View,Edit,Search
	            allFieldsVisible = false
	            ReportPermissions
	            {
	                All_Consultations={"View"}
	                Recent_Consultations={"View"}
	                Follow_Up_Calendar={"View"}
	            }
	            FieldPermissions
	            {
