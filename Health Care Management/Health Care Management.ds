	menu
	{
	    space Clinic_Workspace
	    {
	        displayname = "Health Care Management"
	        icon = "health-hospital-34"
	
	        section Dashboard_Section
	        {
	            displayname = "Dashboard"
	            icon = "business-chart"
	
	            page Clinic_Dashboard
	            {
	                icon = "health-pulse-chart"
	            }
	        }
	
	        section Patient_Care_Section
	        {
	            displayname = "Patient Care"
	            icon = "health-doctor"
	
	            form Patients
	            {
	                icon = "users-single-body"
	            }
	            report All_Patients
	            {
	                icon = "health-notebook"
	            }
	            report Active_Patients
	            {
	                icon = "users-multiple-19"
	            }
	            report Patient_Insurance_Status
	            {
	                icon = "business-safe"
	            }
	            form Appointments
	            {
	                icon = "health-pulse-phone"
	            }
	            report All_Appointments
	            {
	                icon = "business-agenda"
	            }
	            report Appointment_Calendar
	            {
	                icon = "business-agenda"
	            }
	            report Today_Appointments
	            {
	                icon = "health-pulse-watch"
	            }
	            report Appointment_Status_Board
	            {
	                icon = "business-board-30"
	            }
	            form Consultations
	            {
	                icon = "health-doctor"
	            }
	            report All_Consultations
	            {
	                icon = "health-notebook"
	            }
	            report Recent_Consultations
	            {
	                icon = "files-time"
	            }
	            report Follow_Up_Calendar
	            {
	                icon = "health-pulse"
	            }
	            form Prescriptions
	            {
	                icon = "health-pill-container-44"
	            }
	            report All_Prescriptions
	            {
	                icon = "health-pill-42"
	            }
	            report Active_Prescriptions
	            {
	                icon = "health-pill-container-47"
	            }
	            report Patient_Prescription_History
	            {
	                icon = "files-notebook"
	            }
	        }
	
	        section Billing_Insurance_Section
	        {
	            displayname = "Billing & Insurance"
	            icon = "business-wallet-44"
	
	            form Invoices
	            {
	                icon = "business-cheque"
	            }
	            report All_Invoices
	            {
	                icon = "files-money"
	            }
	            report Outstanding_Invoices
	            {
	                icon = "business-money-time"
	            }
	            report Paid_Invoices
	            {
	                icon = "business-money-13"
	            }
	            form Payments
	            {
	                icon = "business-payment"
	            }
	            report All_Payments
	            {
	                icon = "business-wallet-43"
	            }
	            report Received_Payments
	            {
	                icon = "business-money-coins"
	            }
	            report Payment_Register
	            {
	                icon = "business-calculator"
	            }
	            form Insurance_Claims
	            {
	                icon = "business-safe"
	            }
	            report All_Insurance_Claims
	            {
	                icon = "files-paper"
	            }
	            report Open_Insurance_Claims
	            {
	                icon = "files-folder-time"
	            }
	            report Claim_Status_Board
	            {
	                icon = "business-board-29"
	            }
	            form Insurance_Providers
	            {
	                icon = "business-building"
	            }
	            report All_Insurance_Providers
	            {
	                icon = "business-contacts"
	            }
	            report Active_Insurance_Providers
	            {
	                icon = "business-badge"
	            }
	        }
	
	        section Administration_Section
	        {
	            displayname = "Administration"
	            icon = "business-briefcase-24"
	
	            form Staff_Members
	            {
	                icon = "users-badge-13"
	            }
	            report Staff_Directory
	            {
	                icon = "users-multiple-11"
	            }
	            report Active_Doctors
	            {
	                icon = "health-doctor"
	            }
	            form Audit_Logs
	            {
	                icon = "files-locked"
	            }
	            report All_Audit_Logs
	            {
	                icon = "files-search"
	            }
	            report High_Sensitivity_Audits
	            {
	                icon = "files-no-access"
	            }
	        }
	
	        section SharedAnalytics_Section
	        {
	            type = shared_user_report_section
	            displayname = "Reports"
	            icon = "business-chart-bar-33"
	        }
	
	        designcomponent designcomponent1
	        {
	            type = separator
	            separator = "line"
	        }
	    }
	
	    preference
	    {
	        icon
	        {
	            style = outline
	            show = {space,section,component}
	        }
	    }
	}
	customize
	{
	    layout
	    {
	        theme = "theme_2"
	        variant = "variant_2"
	    }
	
	    font = "lato"
	
	    color options
	    {
	        color = "11"
	    }
	
	    logo
	    {
	        preference = "app_icon"
	        placement = "left"
	    }
	
	    custom css
	    {
	        content = ".zc-app-header{background:#0f766e;} .zc-page-title{color:#0f172a;}"
	    }
	}
	}
}
