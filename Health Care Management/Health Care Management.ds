application "Health-Care-Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Appointments
		{
		    displayname = "Appointments"
		    Appointment_Details
		    (
		        type = section
		        displayname = "Appointment Details"
		        row = 1
		        column = 0
		    )
		    Appointment_Number
		    (
		        type = autonumber
		        displayname = "Appointment Number"
		        start index = 20001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Patient
		    (
		        type = picklist
		        displayname = "Patient"
		        values = Patients.ID
		        displayformat = [Patient_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Provider
		    (
		        type = picklist
		        displayname = "Provider"
		        values = Staff_Members[Active == true && Available_For_Appointments == true].ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Appointment_Date
		    (
		        type = date
		        displayname = "Appointment Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Appointment_Time
		    (
		        type = time
		        displayname = "Appointment Time"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Visit_Type
		    (
		        type = picklist
		        displayname = "Visit Type"
		        values = {"New Visit","Follow-up","Procedure","Teleconsultation"}
		        initial value = "New Visit"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Appointment_Status
		    (
		        type = picklist
		        displayname = "Appointment Status"
		        values = {"Requested","Confirmed","Checked In","Completed","Cancelled","No Show"}
		        initial value = "Requested"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Reason_for_Visit
		    (
		        type = textarea
		        displayname = "Reason for Visit"
		        isephi = true
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Followup_Reason
		    (
		        type = textarea
		        displayname = "Follow-up Reason"
		        isephi = true
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Cancellation_Reason
		    (
		        type = textarea
		        displayname = "Cancellation Reason"
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Internal_Notes
		    (
		        type = textarea
		        displayname = "Internal Notes"
		        private = true
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Audit_Logs
		{
		    displayname = "Audit Logs"
		    Audit_Event
		    (
		        type = section
		        displayname = "Audit Event"
		        row = 1
		        column = 0
		    )
		    Audit_Number
		    (
		        type = autonumber
		        displayname = "Audit Number"
		        start index = 90001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Event_Time
		    (
		        type = datetime
		        displayname = "Event Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Entity_Type
		    (
		        type = picklist
		        displayname = "Entity Type"
		        values = {"Patient","Staff","Appointment","Consultation","Prescription","Invoice","Insurance Claim","Payment","System"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Entity_Record_ID
		    (
		        type = number
		        displayname = "Entity Record ID"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Action_Type
		    (
		        type = picklist
		        displayname = "Action Type"
		        values = {"Created","Updated","Status Changed","Payment Posted","Claim Updated","Validation Blocked","System Event"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Summary
		    (
		        type = textarea
		        displayname = "Summary"
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Performed_By
		    (
		        type = text
		        displayname = "Performed By"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Sensitivity
		    (
		        type = picklist
		        displayname = "Sensitivity"
		        values = {"Low","Medium","High"}
		        initial value = "Medium"
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Consultations
		{
		    displayname = "Consultations"
		    Consultation_Details
		    (
		        type = section
		        displayname = "Consultation Details"
		        row = 1
		        column = 0
		    )
		    Consultation_Number
		    (
		        type = autonumber
		        displayname = "Consultation Number"
		        start index = 30001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Patient
		    (
		        type = picklist
		        displayname = "Patient"
		        values = Patients.ID
		        displayformat = [Patient_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Appointment
		    (
		        type = picklist
		        displayname = "Appointment"
		        values = Appointments.ID
		        displayformat = [Appointment_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Provider
		    (
		        type = picklist
		        displayname = "Provider"
		        values = Staff_Members.ID
		        displayformat = [Full_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Consultation_DateTime
		    (
		        type = datetime
		        displayname = "Consultation Date/Time"
		        initial value = "${zoho.currenttime}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Symptoms
		    (
		        type = textarea
		        displayname = "Symptoms"
		        isephi = true
		        isencrypted = true
		        height = 120px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Vitals
		    (
		        type = section
		        displayname = "Vitals"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Vital_Temperature
		    (
		        type = decimal
		        displayname = "Temperature"
		        decimalplace = 1
		        row = 2
		        column = 1
		        width = medium
		    )
		    Vital_Pulse
		    (
		        type = number
		        displayname = "Pulse"
		        row = 2
		        column = 2
		        width = medium
		    )
		    Blood_Pressure
		    (
		        type = text
		        displayname = "Blood Pressure"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Weight
		    (
		        type = decimal
		        displayname = "Weight"
		        decimalplace = 2
		        row = 2
		        column = 2
		        width = medium
		    )
		    Clinical_Notes
		    (
		        type = section
		        displayname = "Clinical Notes"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Diagnosis
		    (
		        type = textarea
		        displayname = "Diagnosis"
		        isephi = true
		        isencrypted = true
		        height = 120px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Treatment_Plan
		    (
		        type = textarea
		        displayname = "Treatment Plan"
		        isephi = true
		        isencrypted = true
		        height = 120px
		        row = 3
		        column = 2
		        width = medium
		    )
		    must have Visit_Outcome
		    (
		        type = picklist
		        displayname = "Visit Outcome"
		        values = {"Treated","Referred","Admitted","Follow-up Required","Observation"}
		        initial value = "Treated"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Requires_Follow_Up
		    (
		        type = checkbox
		        displayname = "Requires Follow Up"
		        initial value = false
		        row = 3
		        column = 2
		        width = medium
		    )
		    Follow_Up_Date
		    (
		        type = date
		        displayname = "Follow Up Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Referral_Notes
		    (
		        type = textarea
		        displayname = "Referral Notes"
		        isephi = true
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    Internal_Admin_Notes
		    (
		        type = textarea
		        displayname = "Internal Admin Notes"
		        private = true
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Insurance_Claims
		{
		    displayname = "Insurance Claims"
		    Claim_Details
		    (
		        type = section
		        displayname = "Claim Details"
		        row = 1
		        column = 0
		    )
		    Claim_Number
		    (
		        type = autonumber
		        displayname = "Claim Number"
		        start index = 70001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Patient
		    (
		        type = picklist
		        displayname = "Patient"
		        values = Patients.ID
		        displayformat = [Patient_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Insurance_Provider
		    (
		        type = picklist
		        displayname = "Insurance Provider"
		        values = Insurance_Providers.ID
		        displayformat = [Provider_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Invoice
		    (
		        type = picklist
		        displayname = "Invoice"
		        values = Invoices.ID
		        displayformat = [Invoice_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Claim_Date
		    (
		        type = date
		        displayname = "Claim Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Claim_Amount
		    (
		        type = decimal
		        displayname = "Claim Amount"
		        decimalplace = 2
		        row = 1
		        column = 1
		        width = medium
		    )
		    Approved_Amount
		    (
		        type = decimal
		        displayname = "Approved Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 2
		        width = medium
		    )
		    Copay_Amount
		    (
		        type = decimal
		        displayname = "Copay Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Claim_Status
		    (
		        type = picklist
		        displayname = "Claim Status"
		        values = {"Draft","Submitted","Under Review","Approved","Partially Approved","Denied","Closed"}
		        initial value = "Draft"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Claim_Reference_Number
		    (
		        type = text
		        displayname = "Claim Reference Number"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Submission_Date
		    (
		        type = date
		        displayname = "Submission Date"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Approval_Date
		    (
		        type = date
		        displayname = "Approval Date"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Denial_Reason
		    (
		        type = textarea
		        displayname = "Denial Reason"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Internal_Notes
		    (
		        type = textarea
		        displayname = "Internal Notes"
		        private = true
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		    blueprint components
		    {
		        stages = {"Draft","Submitted","Under Review","Approved","Partially Approved","Denied","Closed"}
		    }
		}

		form Insurance_Providers
		{
		    displayname = "Insurance Providers"
		    Provider_Information
		    (
		        type = section
		        displayname = "Provider Information"
		        row = 1
		        column = 0
		    )
		    Provider_Code
		    (
		        type = autonumber
		        displayname = "Provider Code"
		        start index = 1001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have unique Provider_Name
		    (
		        type = text
		        displayname = "Provider Name"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Contact_Email
		    (
		        type = email
		        displayname = "Contact Email"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Contact_Phone
		    (
		        type = phonenumber
		        displayname = "Contact Phone"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Claims_Portal_URL
		    (
		        type = url
		        displayname = "Claims Portal URL"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Status
		    (
		        type = picklist
		        displayname = "Status"
		        values = {"Active","Inactive"}
		        initial value = "Active"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Invoices
		{
		    displayname = "Invoices"
		    Invoice_Details
		    (
		        type = section
		        displayname = "Invoice Details"
		        row = 1
		        column = 0
		    )
		    Invoice_Number
		    (
		        type = autonumber
		        displayname = "Invoice Number"
		        start index = 60001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Patient
		    (
		        type = picklist
		        displayname = "Patient"
		        values = Patients.ID
		        displayformat = [Patient_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Appointment
		    (
		        type = picklist
		        displayname = "Appointment"
		        values = Appointments.ID
		        displayformat = [Appointment_Number]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Consultation
		    (
		        type = picklist
		        displayname = "Consultation"
		        values = Consultations.ID
		        displayformat = [Consultation_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Invoice_Date
		    (
		        type = date
		        displayname = "Invoice Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    must have Billing_Mode
		    (
		        type = picklist
		        displayname = "Billing Mode"
		        values = {"Self Pay","Insurance","Mixed"}
		        initial value = "Self Pay"
		        row = 1
		        column = 1
		        width = medium
		    )
		    Service_Description
		    (
		        type = textarea
		        displayname = "Service Description"
		        height = 100px
		        row = 1
		        column = 2
		        width = medium
		    )
		    Charges
		    (
		        type = section
		        displayname = "Charges"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Consultation_Fee
		    (
		        type = decimal
		        displayname = "Consultation Fee"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Procedure_Fee
		    (
		        type = decimal
		        displayname = "Procedure Fee"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Lab_Fee
		    (
		        type = decimal
		        displayname = "Lab Fee"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Pharmacy_Fee
		    (
		        type = decimal
		        displayname = "Pharmacy Fee"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Other_Charges
		    (
		        type = decimal
		        displayname = "Other Charges"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Discount
		    (
		        type = decimal
		        displayname = "Discount"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 2
		        width = medium
		    )
		    Tax_Amount
		    (
		        type = decimal
		        displayname = "Tax Amount"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Total_Amount
		    (
		        type = formula
		        displayname = "Total Amount"
		        value = Consultation_Fee + Procedure_Fee + Lab_Fee + Pharmacy_Fee + Other_Charges - Discount + Tax_Amount
		        visibility = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    Amount_Paid
		    (
		        type = decimal
		        displayname = "Amount Paid"
		        decimalplace = 2
		        initial value = 0
		        row = 2
		        column = 1
		        width = medium
		    )
		    Balance_Due
		    (
		        type = formula
		        displayname = "Balance Due"
		        value = Consultation_Fee + Procedure_Fee + Lab_Fee + Pharmacy_Fee + Other_Charges - Discount + Tax_Amount - Amount_Paid
		        visibility = true
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Invoice_Status
		    (
		        type = picklist
		        displayname = "Invoice Status"
		        values = {"Draft","Submitted","Partially Paid","Paid","Cancelled"}
		        initial value = "Draft"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Insurance_Billing
		    (
		        type = section
		        displayname = "Insurance Billing"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Insurance_Related
		    (
		        type = checkbox
		        displayname = "Insurance Related"
		        initial value = false
		        row = 3
		        column = 1
		        width = medium
		    )
		    Claim_Reference
		    (
		        type = text
		        displayname = "Claim Reference"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Claim_Status_Note
		    (
		        type = textarea
		        displayname = "Claim Status Note"
		        height = 100px
		        row = 3
		        column = 1
		        width = medium
		    )
		    Notes
		    (
		        type = textarea
		        displayname = "Notes"
		        height = 100px
		        row = 3
		        column = 2
		        width = medium
		    )
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Patients
		{
		    displayname = "Patients"
		    Patient_Information
		    (
		        type = section
		        displayname = "Patient Information"
		        row = 1
		        column = 0
		    )
		    Patient_Number
		    (
		        type = autonumber
		        displayname = "Patient Number"
		        start index = 10001
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Patient_Name
		    (
		        type = text
		        displayname = "Patient Name"
		        personal data = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Date_of_Birth
		    (
		        type = date
		        displayname = "Date of Birth"
		        personal data = true
		        row = 1
		        column = 2
		        width = medium
		    )
		    Gender
		    (
		        type = picklist
		        displayname = "Gender"
		        values = {"Female","Male","Non-binary","Prefer not to say","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Phone
		    (
		        type = phonenumber
		        displayname = "Phone"
		        personal data = true
