cs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Appointment&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Time&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tappointmentRows = 0;\n\t\t\t\t\t\t\t\t\t\t\t\tfor each appointmentRecord in todayAppointmentRecords\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(appointmentRows &lt; 8)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tappointmentNo = ifnull(appointmentRecord.Appointment_Number,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tappointmentTime = ifnull(appointmentRecord.Appointment_Time,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tappointmentStatus = ifnull(appointmentRecord.Appointment_Status,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-l_blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(appointmentStatus == &quot;Completed&quot; || appointmentStatus == &quot;Checked In&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-green&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(appointmentStatus == &quot;Cancelled&quot; || appointmentStatus == &quot;No Show&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-red&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(appointmentStatus == &quot;Requested&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstatusClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appointmentNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=appointmentTime%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=statusClass%&gt;&quot;&gt;&lt;%=appointmentStatus%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tappointmentRows = appointmentRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(appointmentRows == 0)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;No appointments today&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-compact-table&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-table-title&quot;&gt;&lt;h4&gt;Open insurance claims&lt;/h4&gt;&lt;a class=&quot;clinic-link&quot; href=&quot;#Report:Open_Insurance_Claims&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Claim&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tclaimRows = 0;\n\t\t\t\t\t\t\t\t\t\t\t\tfor each claimRecord in openClaimRecords\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(claimRows &lt; 8)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimNo = ifnull(claimRecord.Claim_Number,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimAmount = ifnull(claimRecord.Claim_Amount,0);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimStatus = ifnull(claimRecord.Claim_Status,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimClass = &quot;zcs-l_blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(claimStatus == &quot;Draft&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(claimStatus == &quot;Under Review&quot; || claimStatus == &quot;Submitted&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimClass = &quot;zcs-l_blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=claimNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary clinic-money&quot;&gt;$&lt;%=claimAmount%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=claimClass%&gt;&quot;&gt;&lt;%=claimStatus%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclaimRows = claimRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(claimRows == 0)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;No open claims&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;clinic-compact-table&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;clinic-table-title&quot;&gt;&lt;h4&gt;Outstanding invoices&lt;/h4&gt;&lt;a class=&quot;clinic-link&quot; href=&quot;#Report:Outstanding_Invoices&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Balance&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\tinvoiceRows = 0;\n\t\t\t\t\t\t\t\t\t\t\t\tfor each invoiceRecord in outstandingInvoiceRecords\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(invoiceRows &lt; 8)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceNo = ifnull(invoiceRecord.Invoice_Number,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceBalance = ifnull(invoiceRecord.Balance_Due,0);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceStatus = ifnull(invoiceRecord.Invoice_Status,&quot;-&quot;);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(invoiceStatus == &quot;Partially Paid&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceClass = &quot;zcs-l_blue&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif(invoiceStatus == &quot;Submitted&quot;)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=invoiceNo%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary clinic-money&quot;&gt;$&lt;%=invoiceBalance%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body &lt;%=invoiceClass%&gt;&quot;&gt;&lt;%=invoiceStatus%&gt;&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tinvoiceRows = invoiceRows + 1;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\tif(invoiceRows == 0)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t%&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;No outstanding invoices&lt;/td&gt;&lt;/tr&gt;&lt;%\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Appointment_Status_On_User_Input as "Appointment Status On User Input"
			{
			    type = form
			    form = Appointments
			    record event = on add or edit
			
			    on user input of Appointment_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Appointment_Status == "Cancelled")
			                {
			                    show Cancellation_Reason;
			                    enable Cancellation_Reason;
			                }
			                else
			                {
			                    input.Cancellation_Reason = "";
			                    hide Cancellation_Reason;
			                    disable Cancellation_Reason;
			                }
			            )
			        }
			    }
			}

			Appointments_On_Load as "Appointments On Load"
			{
			    type = form
			    form = Appointments
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Visit_Type == "Follow-up")
			                {
			                    show Followup_Reason;
			                    enable Followup_Reason;
			                }
			                else
			                {
			                    hide Followup_Reason;
			                    disable Followup_Reason;
			                }
			                if (input.Appointment_Status == "Cancelled")
			                {
			                    show Cancellation_Reason;
			                    enable Cancellation_Reason;
			                }
			                else
			                {
			                    hide Cancellation_Reason;
			                    disable Cancellation_Reason;
			                }
			            )
			        }
			    }
			}

			Appointments_On_Success as "Appointments On Success"
			{
			    type = form
			    form = Appointments
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                auditSummary = "Appointment " + input.Appointment_Number + " saved with status " + ifnull(input.Appointment_Status, "Unknown") + ".";
			                auditId = insert into Audit_Logs
			                [
			                    Event_Time = zoho.currenttime
			                    Entity_Type = "Appointment"
			                    Entity_Record_ID = input.ID
			                    Action_Type = "Status Changed"
			                    Summary = auditSummary
			                    Performed_By = zoho.loginuser
			                    Sensitivity = "Medium"
			                ];
			            )
			        }
			    }
			}

			Appointments_On_Validate as "Appointments On Validate"
			{
			    type = form
			    form = Appointments
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Appointment_Date != null && input.Appointment_Date < zoho.currentdate && input.Appointment_Status in {"Requested","Confirmed","Checked In"})
			                {
			                    alert "Active appointments cannot be scheduled in the past.";
			                    cancel submit;
			                }
			                if (input.Visit_Type == "Follow-up" && input.Followup_Reason in {""," ","null"})
			                {
			                    alert "Follow-up reason is required for follow-up visits.";
			                    cancel submit;
			                }
			                if (input.Appointment_Status == "Cancelled" && input.Cancellation_Reason in {""," ","null"})
			                {
			                    alert "Cancellation reason is required for cancelled appointments.";
			                    cancel submit;
			                }
			                if (input.Provider != null && input.Appointment_Date != null && input.Appointment_Time != null)
			                {
			                    duplicates = Appointments[Provider == input.Provider && Appointment_Date == input.Appointment_Date && Appointment_Time == input.Appointment_Time && Appointment_Status not in {"Cancelled","No Show","Completed"} && ID != input.ID];
			                    if (duplicates.count() > 0)
			                    {
			                        alert "This provider already has an active appointment at the selected date and time.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Visit_Type_On_User_Input as "Visit Type On User Input"
			{
			    type = form
			    form = Appointments
			    record event = on add or edit
			
			    on user input of Visit_Type
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Visit_Type == "Follow-up")
			                {
			                    show Followup_Reason;
			                    enable Followup_Reason;
			                }
			                else
			                {
			                    input.Followup_Reason = "";
			                    hide Followup_Reason;
			                    disable Followup_Reason;
			                }
			            )
			        }
			    }
			}

			Consultations_On_Load as "Consultations On Load"
			{
			    type = form
			    form = Consultations
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Requires_Follow_Up == true || input.Visit_Outcome == "Follow-up Required")
			                {
			                    show Follow_Up_Date;
			                    enable Follow_Up_Date;
			                }
			                else
			                {
			                    hide Follow_Up_Date;
			                    disable Follow_Up_Date;
			                }
			                if (input.Visit_Outcome == "Referred")
			                {
			                    show Referral_Notes;
			                    enable Referral_Notes;
			                }
			                else
			                {
			                    hide Referral_Notes;
			                    disable Referral_Notes;
			                }
			            )
			        }
			    }
			}

			Consultations_On_Success as "Consultations On Success"
			{
			    type = form
			    form = Consultations
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Appointment != null)
			                {
			                    appt = Appointments[ID == input.Appointment];
			                    if (appt.count() > 0 && appt.Appointment_Status not in {"Cancelled","No Show"})
			                    {
			                        appt.Appointment_Status = "Completed";
			                    }
			                }
			                auditSummary = "Consultation " + input.Consultation_Number + " saved with outcome " + ifnull(input.Visit_Outcome, "Unknown") + ".";
			                auditId = insert into Audit_Logs
			                [
			                    Event_Time = zoho.currenttime
			                    Entity_Type = "Consultation"
			                    Entity_Record_ID = input.ID
			                    Action_Type = "Updated"
			                    Summary = auditSummary
			                    Performed_By = zoho.loginuser
			                    Sensitivity = "High"
			                ];
			            )
			        }
			    }
			}

			Consultations_On_Validate as "Consultations On Validate"
			{
			    type = form
			    form = Consultations
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Symptoms in {""," ","null"})
			                {
			                    alert "Symptoms are required for a consultation.";
			                    cancel submit;
			                }
			                if (input.Diagnosis in {""," ","null"})
			                {
			                    alert "Diagnosis is required for a consultation.";
			                    cancel submit;
			                }
			                if ((input.Requires_Follow_Up == true || input.Visit_Outcome == "Follow-up Required") && (input.Follow_Up_Date == null || input.Follow_Up_Date <= zoho.currentdate))
			                {
			                    alert "A future follow-up date is required.";
			                    cancel submit;
			                }
			                if (input.Visit_Outcome == "Referred" && input.Referral_Notes in {""," ","null"})
			                {
			                    alert "Referral notes are required when the patient is referred.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Requires_Follow_Up_On_User_Input as "Requires Follow Up On User Input"
			{
			    type = form
			    form = Consultations
			    record event = on add or edit
			
			    on user input of Requires_Follow_Up
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Requires_Follow_Up == true)
			                {
			                    show Follow_Up_Date;
			                    enable Follow_Up_Date;
			                }
			                else
			                {
			                    input.Follow_Up_Date = null;
			                    hide Follow_Up_Date;
			                    disable Follow_Up_Date;
			                }
			            )
			        }
			    }
			}

			Visit_Outcome_On_User_Input as "Visit Outcome On User Input"
			{
			    type = form
			    form = Consultations
			    record event = on add or edit
			
			    on user input of Visit_Outcome
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Visit_Outcome == "Follow-up Required")
			                {
			                    input.Requires_Follow_Up = true;
			                    show Follow_Up_Date;
			                    enable Follow_Up_Date;
			                }
			                if (input.Visit_Outcome == "Referred")
			                {
			                    show Referral_Notes;
			                    enable Referral_Notes;
			                }
			                else
			                {
			                    input.Referral_Notes = "";
			                    hide Referral_Notes;
			                    disable Referral_Notes;
			                }
			            )
			        }
			    }
			}

			Claim_Status_On_User_Input as "Claim Status On User Input"
			{
			    type = form
			    form = Insurance_Claims
			    record event = on add or edit
			
			    on user input of Claim_Status
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Claim_Status == "Denied")
			                {
			                    show Denial_Reason;
			                    enable Denial_Reason;
			                }
			                else
			                {
			                    input.Denial_Reason = "";
			                    hide Denial_Reason;
			                    disable Denial_Reason;
			                }
			                if (input.Claim_Status in {"Approved","Partially Approved"})
			                {
			                    show Approved_Amount;
			                    show Copay_Amount;
			                    show Approval_Date;
			                    enable Approved_Amount;
			                    enable Copay_Amount;
			                    enable Approval_Date;
			                }
			                else
			                {
			                    input.Approval_Date = null;
			                    hide Approved_Amount;
			                    hide Copay_Amount;
			                    hide Approval_Date;
			                    disable Approved_Amount;
			                    disable Copay_Amount;
			                    disable Approval_Date;
			                }
			                if (input.Claim_Status in {"Submitted","Under Review","Approved","Partially Approved","Denied","Closed"})
			                {
			                    show Submission_Date;
			                    enable Submission_Date;
			                }
			                else
			                {
			                    input.Submission_Date = null;
			                    hide Submission_Date;
			                    disable Submission_Date;
			                }
			            )
			        }
			    }
			}

			Insurance_Claims_On_Load as "Insurance Claims On Load"
			{
			    type = form
			    form = Insurance_Claims
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Claim_Status == "Denied")
			                {
			                    show Denial_Reason;
			                    enable Denial_Reason;
			                }
			                else
			                {
			                    hide Denial_Reason;
			                    disable Denial_Reason;
			                }
			                if (input.Claim_Status in {"Approved","Partially Approved"})
			                {
			                    show Approved_Amount;
			                    show Copay_Amount;
			                    show Approval_Date;
			                    enable Approved_Amount;
			                    enable Copay_Amount;
			                    enable Approval_Date;
			                }
			                else
			                {
			                    hide Approved_Amount;
			                    hide Copay_Amount;
			                    hide Approval_Date;
			                    disable Approved_Amount;
			                    disable Copay_Amount;
			                    disable Approval_Date;
			                }
			                if (input.Claim_Status in {"Submitted","Under Review","Approved","Partially Approved","Denied","Closed"})
			                {
			                    show Submission_Date;
			                    enable Submission_Date;
			                }
			                else
			                {
			                    hide Submission_Date;
			                    disable Submission_Date;
			                }
			            )
			        }
			    }
			}

			Insurance_Claims_On_Success as "Insurance Claims On Success"
			{
			    type = form
			    form = Insurance_Claims
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Invoice != null)
			                {
			                    inv = Invoices[ID == input.Invoice];
			                    if (inv.count() > 0)
			                    {
			                        inv.Insurance_Related = true;
			                        inv.Claim_Reference = ifnull(input.Claim_Reference_Number, input.Claim_Number.toString());
			                        inv.Claim_Status_Note = "Claim status: " + ifnull(input.Claim_Status, "Unknown");
			                    }
			                }
			                auditSummary = "Insurance claim " + input.Claim_Number + " saved with status " + ifnull(input.Claim_Status, "Unknown") + ".";
			                auditId = insert into Audit_Logs
			                [
			                    Event_Time = zoho.currenttime
			                    Entity_Type = "Insurance Claim"
			                    Entity_Record_ID = input.ID
			                    Action_Type = "Claim Updated"
			                    Summary = auditSummary
			                    Performed_By = zoho.loginuser
			                    Sensitivity = "Medium"
			                ];
			            )
			        }
			    }
			}

			Insurance_Claims_On_Validate as "Insurance Claims On Validate"
			{
			    type = form
			    form = Insurance_Claims
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Claim_Amount,0) < 0 || ifnull(input.Approved_Amount,0) < 0 || ifnull(input.Copay_Amount,0) < 0)
			                {
			                    alert "Claim, approved, and copay amounts cannot be negative.";
			                    cancel submit;
			                }
			                if (ifnull(input.Approved_Amount,0) > ifnull(input.Claim_Amount,0))
			                {
			                    alert "Approved amount cannot be greater than claim amount.";
			                    cancel submit;
			                }
			                if (input.Claim_Status in {"Submitted","Under Review","Approved","Partially Approved","Denied","Closed"} && input.Submission_Date == null)
			                {
			                    alert "Submission date is required once a claim has been submitted.";
			                    cancel submit;
			                }
			                if (input.Claim_Status in {"Approved","Partially Approved"} && (input.Approval_Date == null || ifnull(input.Approved_Amount,0) <= 0))
			                {
			                    alert "Approval date and approved amount are required for approved claims.";
			                    cancel submit;
			                }
			                if (input.Claim_Status == "Denied" && input.Denial_Reason in {""," ","null"})
			                {
			                    alert "Denial reason is required for denied claims.";
			                    cancel submit;
			                }
			            )
			        }
			    }
			}

			Billing_Mode_On_User_Input as "Billing Mode On User Input"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on user input of Billing_Mode
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Billing_Mode in {"Insurance","Mixed"})
			                {
			                    input.Insurance_Related = true;
			                    show Claim_Reference;
			                    show Claim_Status_Note;
			                    enable Claim_Reference;
			                    enable Claim_Status_Note;
			                }
			                else
			                {
			                    input.Insurance_Related = false;
			                    input.Claim_Reference = "";
			                    input.Claim_Status_Note = "";
			                    hide Claim_Reference;
			                    hide Claim_Status_Note;
			                    disable Claim_Reference;
			                    disable Claim_Status_Note;
			                }
			            )
			        }
			    }
			}

