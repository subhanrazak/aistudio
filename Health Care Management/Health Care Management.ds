			Patients_On_Success as "Patients On Success"
			{
			    type = form
			    form = Patients
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                auditSummary = "Patient record saved for " + ifnull(input.Patient_Name, "Unnamed patient") + ". Insurance: " + if(input.Has_Insurance == true, "Yes", "No") + ".";
			                auditId = insert into Audit_Logs
			                [
			                    Event_Time = zoho.currenttime
			                    Entity_Type = "Patient"
			                    Entity_Record_ID = input.ID
			                    Action_Type = "Updated"
			                    Summary = auditSummary
			                    Performed_By = zoho.loginuser
			                    Sensitivity = "High"
			                ];
			            )
			        }
			    }
			}

			Patients_On_Validate as "Patients On Validate"
			{
			    type = form
			    form = Patients
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Date_of_Birth != null && input.Date_of_Birth > zoho.currentdate)
			                {
			                    alert "Date of birth cannot be in the future.";
			                    cancel submit;
			                }
			                if (input.Has_Insurance == true)
			                {
			                    if (input.Insurance_Provider == null || input.Policy_Number in {""," ","null"} || input.Policy_Holder_Name in {""," ","null"} || input.Insurance_Validity_Date == null)
			                    {
			                        alert "Insurance provider, policy number, policy holder name, and validity date are required when insurance is enabled.";
			                        cancel submit;
			                    }
			                    if (input.Insurance_Validity_Date != null && input.Insurance_Validity_Date < zoho.currentdate)
			                    {
			                        alert "Insurance validity date cannot be expired.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

			Payments_On_Success as "Payments On Success"
			{
			    type = form
			    form = Payments
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Invoice != null)
			                {
			                    inv = Invoices[ID == input.Invoice];
			                    if (inv.count() > 0)
			                    {
			                        if (input.Payment_Status == "Received")
			                        {
			                            inv.Amount_Paid = ifnull(inv.Amount_Paid,0) + ifnull(input.Amount,0);
			                            if (ifnull(inv.Amount_Paid,0) >= ifnull(inv.Total_Amount,0) && ifnull(inv.Total_Amount,0) > 0)
			                            {
			                                inv.Invoice_Status = "Paid";
			                            }
			                            else if (ifnull(inv.Amount_Paid,0) > 0)
			                            {
			                                inv.Invoice_Status = "Partially Paid";
			                            }
			                        }
			                        else if (input.Payment_Status == "Refunded")
			                        {
			                            refundAmount = ifnull(input.Amount,0);
			                            currentPaid = ifnull(inv.Amount_Paid,0);
			                            inv.Amount_Paid = if(currentPaid - refundAmount < 0, 0, currentPaid - refundAmount);
			                            if (ifnull(inv.Amount_Paid,0) == 0 && inv.Invoice_Status != "Cancelled")
			                            {
			                                inv.Invoice_Status = "Submitted";
			                            }
			                            else if (ifnull(inv.Amount_Paid,0) < ifnull(inv.Total_Amount,0) && inv.Invoice_Status != "Cancelled")
			                            {
			                                inv.Invoice_Status = "Partially Paid";
			                            }
			                        }
			                    }
			                }
			                auditSummary = "Payment " + input.Payment_Number + " saved with status " + ifnull(input.Payment_Status, "Unknown") + ".";
			                auditId = insert into Audit_Logs
			                [
			                    Event_Time = zoho.currenttime
			                    Entity_Type = "Payment"
			                    Entity_Record_ID = input.ID
			                    Action_Type = if(input.Payment_Status == "Refunded", "Payment Posted", "Payment Posted")
			                    Summary = auditSummary
			                    Performed_By = zoho.loginuser
			                    Sensitivity = "Medium"
			                ];
			            )
			        }
			    }
			}

			Payments_On_Validate as "Payments On Validate"
			{
			    type = form
			    form = Payments
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (ifnull(input.Amount,0) <= 0)
			                {
			                    alert "Payment amount must be greater than zero.";
			                    cancel submit;
			                }
			                if (input.Payment_Method in {"Card","Bank Transfer","UPI","Insurance Payout"} && input.Reference_Number in {""," ","null"})
			                {
			                    alert "Reference number is required for the selected payment method.";
			                    cancel submit;
			                }
			                if (input.Invoice != null && input.Payment_Status == "Received")
			                {
			                    inv = Invoices[ID == input.Invoice];
			                    if (inv.count() > 0 && input.Payment_Method != "Insurance Payout" && ifnull(input.Amount,0) > ifnull(inv.Balance_Due,0))
			                    {
			                        alert "Received payment cannot exceed the invoice balance due.";
			                        cancel submit;
			                    }
			                }
			            )
			        }
			    }
			}

