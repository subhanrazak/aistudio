			Invoices_On_Load as "Invoices On Load"
			{
			    type = form
			    form = Invoices
			    record event = on add or edit
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if (input.Billing_Mode in {"Insurance","Mixed"} || input.Insurance_Related == true)
			                {
			                    show Claim_Reference;
			                    show Claim_Status_Note;
			                    enable Claim_Reference;
			                    enable Claim_Status_Note;
			                }
			                else
			                {
