            }
            report Patient_Prescription_History
            {
                icon = "files-notebook"
            }
        }

        section Billing_Insurance_Section
        {
            displayname = "Billing & Insurance"
            icon = "business-wallet-44"

            form Invoices
            {
                icon = "business-cheque"
            }
            report All_Invoices
            {
                icon = "files-money"
            }
            report Outstanding_Invoices
            {
                icon = "business-money-time"
            }
            report Paid_Invoices
            {
                icon = "business-money-13"
            }
            form Payments
            {
                icon = "business-payment"
            }
            report All_Payments
            {
                icon = "business-wallet-43"
