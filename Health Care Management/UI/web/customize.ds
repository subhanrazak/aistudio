customize
{
    layout
    {
        theme = "theme_2"
        variant = "variant_2"
    }

    font = "lato"

    color options
    {
        color = "11"
    }

    logo
    {
        preference = "app_icon"
        placement = "left"
    }

    custom css
    {
        content = ".zc-app-header{background:#0f766e;} .zc-page-title{color:#0f172a;}"
    }
}
