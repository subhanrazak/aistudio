		        on edit = "Edit Daily Report"
		    }
		
		    Report_Identity
		    (
		        type = section
		        displayname = "Report Identity"
		        row = 1
		        column = 0
		    )
		    must have Batch
		    (
		        type = picklist
		        displayname = "Batch"
		        values = Batch_Operations.ID
		        displayformat = [Batch_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Report_Date
		    (
		        type = date
		        displayname = "Report Date"
		        initial value = "${zoho.currentdate}"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Trainer
		    (
		        type = picklist
		        displayname = "Trainer"
