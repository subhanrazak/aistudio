	pages
	{
		page CEO_Dashboard
		{
					displayname = "CEO Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='kpi_cards' elementName='KPI_Cards'>\n\t\t\t\t\t<![CDATA[htmlpage kpi_cards()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\t\ttotalAcademies = Centre_Master.count();\n\t\tactiveAcademies = Centre_Master[Current_Status == &quot;Active&quot;].count();\n\t\tactiveBatches = Batch_Operations[Batch_Stage == &quot;Active&quot;].count();\n\t\tunfundedBatches = Batch_Operations[Funding_Confirmed == &quot;No&quot; || Funding_Confirmed == &quot;To Confirm&quot;].count();\n%&gt;\n&lt;style&gt;\n.kpi-grid {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: 16px;\n\t\tpadding: 16px 0;\n}\n.kpi-card {\n\t\tflex: 1 1 180px;\n\t\tbackground: #fff;\n\t\tborder-radius: 10px;\n\t\tpadding: 20px 24px;\n\t\tbox-shadow: 0 2px 8px rgba(0,0,0,0.08);\n\t\tborder-left: 4px solid #1a6b5a;\n\t\tmin-width: 160px;\n}\n.kpi-card.warning { border-left-color: #e07b00; }\n.kpi-card.danger  { border-left-color: #CC0000; }\n.kpi-card.success { border-left-color: #16AD78; }\n.kpi-label {\n\t\tfont-size: 12px;\n\t\tcolor: #6b7280;\n\t\tfont-weight: 600;\n\t\tletter-spacing: 0.5px;\n\t\ttext-transform: uppercase;\n\t\tmargin-bottom: 8px;\n}\n.kpi-value {\n\t\tfont-size: 32px;\n\t\tfont-weight: 700;\n\t\tcolor: #111827;\n\t\tline-height: 1.2;\n}\n.kpi-icon {\n\t\tfont-size: 20px;\n\t\tmargin-bottom: 8px;\n}\n&lt;/style&gt;\n&lt;div class=&quot;kpi-grid&quot;&gt;\n\t\t&lt;div class=&quot;kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Total Academies&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%= totalAcademies %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;kpi-card success&quot;&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Active Academies&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%= activeAcademies %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;kpi-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Active Batches&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%= activeBatches %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;kpi-card warning&quot;&gt;\n\t\t\t\t&lt;div class=&quot;kpi-label&quot;&gt;Unfunded / TBD Batches&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;kpi-value&quot;&gt;&lt;%= unfundedBatches %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='financial_summary' elementName='Financial_Summary'>\n\t\t\t\t\t<![CDATA[htmlpage financial_summary()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\t\ttotalRevenue = Academy_PL.sum(Total_Revenue);\n\t\ttotalCost = Academy_PL.sum(Total_Cost);\n\t\tnetSurplusDeficit = Academy_PL.sum(Net_Surplus_Deficit);\n\t\ttotalFundingGap = Academy_PL.sum(Funding_Gap);\n\n\t\tsurplusClass = &quot;success&quot;;\n\t\tif(netSurplusDeficit &lt; 0)\n\t\t{\n\t\t\t\tsurplusClass = &quot;danger&quot;;\n\t\t}\n%&gt;\n&lt;style&gt;\n.fin-grid {\n\t\tdisplay: flex;\n\t\tflex-wrap: wrap;\n\t\tgap: 16px;\n\t\tpadding: 8px 0 16px;\n}\n.fin-card {\n\t\tflex: 1 1 180px;\n\t\tbackground: #fff;\n\t\tborder-radius: 10px;\n\t\tpadding: 20px 24px;\n\t\tbox-shadow: 0 2px 8px rgba(0,0,0,0.08);\n\t\tborder-left: 4px solid #3b82f6;\n\t\tmin-width: 160px;\n}\n.fin-card.danger  { border-left-color: #CC0000; }\n.fin-card.success { border-left-color: #16AD78; }\n.fin-card.warning { border-left-color: #e07b00; }\n.fin-label {\n\t\tfont-size: 12px;\n\t\tcolor: #6b7280;\n\t\tfont-weight: 600;\n\t\tletter-spacing: 0.5px;\n\t\ttext-transform: uppercase;\n\t\tmargin-bottom: 8px;\n}\n.fin-value {\n\t\tfont-size: 24px;\n\t\tfont-weight: 700;\n\t\tcolor: #111827;\n\t\tline-height: 1.2;\n}\n.fin-currency {\n\t\tfont-size: 14px;\n\t\tcolor: #9ca3af;\n\t\tfont-weight: 500;\n\t\tmargin-bottom: 4px;\n}\n&lt;/style&gt;\n&lt;div class=&quot;fin-grid&quot;&gt;\n\t\t&lt;div class=&quot;fin-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fin-currency&quot;&gt;INR&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-label&quot;&gt;Total Revenue&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-value&quot;&gt;&lt;%= totalRevenue %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;fin-card warning&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fin-currency&quot;&gt;INR&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-label&quot;&gt;Total Cost&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-value&quot;&gt;&lt;%= totalCost %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;fin-card &lt;%= surplusClass %&gt;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fin-currency&quot;&gt;INR&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-label&quot;&gt;Net Surplus / Deficit&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-value&quot;&gt;&lt;%= netSurplusDeficit %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;fin-card danger&quot;&gt;\n\t\t\t\t&lt;div class=&quot;fin-currency&quot;&gt;INR&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-label&quot;&gt;Total Funding Gap&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;fin-value&quot;&gt;&lt;%= totalFundingGap %&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='35%'>\n\t\t\t\t<dsp id='rag_status' elementName='RAG_Status'>\n\t\t\t\t\t<![CDATA[htmlpage rag_status()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;%\n\t\tcentreGreen = Centre_Master[RAG == &quot;Green&quot;].count();\n\t\tcentreAmber = Centre_Master[RAG == &quot;Amber&quot;].count();\n\t\tcentreRed = Centre_Master[RAG == &quot;Red&quot;].count();\n\n\t\tbatchGreen = Batch_Operations[Risk_Flag == &quot;Green&quot;].count();\n\t\tbatchAmber = Batch_Operations[Risk_Flag == &quot;Amber&quot;].count();\n\t\tbatchRed = Batch_Operations[Risk_Flag == &quot;Red&quot;].count();\n%&gt;\n&lt;style&gt;\n.rag-section {\n\t\tbackground: #fff;\n\t\tborder-radius: 10px;\n\t\tpadding: 20px 24px;\n\t\tbox-shadow: 0 2px 8px rgba(0,0,0,0.08);\n\t\tmargin-bottom: 8px;\n}\n.rag-section-title {\n\t\tfont-size: 13px;\n\t\tfont-weight: 700;\n\t\tcolor: #374151;\n\t\tmargin-bottom: 16px;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.5px;\n}\n.rag-row {\n\t\tdisplay: flex;\n\t\tgap: 12px;\n\t\talign-items: center;\n}\n.rag-badge {\n\t\tdisplay: inline-flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tpadding: 10px 18px;\n\t\tborder-radius: 8px;\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tmin-width: 80px;\n\t\tjustify-content: center;\n}\n.rag-green { background: #D4EDDA; color: #155724; }\n.rag-amber { background: #FFF3CD; color: #856404; }\n.rag-red   { background: #FFE0E0; color: #CC0000; }\n.rag-count { font-size: 20px; font-weight: 800; }\n.rag-label { font-size: 11px; font-weight: 600; }\n.rag-divider { height: 1px; background: #f3f4f6; margin: 16px 0; }\n&lt;/style&gt;\n&lt;div class=&quot;rag-section&quot;&gt;\n\t\t&lt;div class=&quot;rag-section-title&quot;&gt;Centre RAG Status&lt;/div&gt;\n\t\t&lt;div class=&quot;rag-row&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-green&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-solid ui-1-check-circle-08&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= centreGreen %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Green&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-amber&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-alert-circle&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= centreAmber %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Amber&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-red&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-solid ui-1-alert-circle&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= centreRed %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Red&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;rag-divider&quot;&gt;&lt;/div&gt;\n\t\t&lt;div class=&quot;rag-section-title&quot;&gt;Batch Risk Flags&lt;/div&gt;\n\t\t&lt;div class=&quot;rag-row&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-green&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-solid ui-1-check-circle-08&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= batchGreen %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Green&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-amber&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-alert-circle&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= batchAmber %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Amber&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;rag-badge rag-red&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zc-li-solid ui-1-alert-circle&quot; style=&quot;font-size:16px;&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-count&quot;&gt;&lt;%= batchRed %&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;rag-label&quot;&gt;Red&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t\t<column width='65%'>\n\t\t\t\t<report elementName='Open_CEO_Actions_Embed'\n\t\t\t\ttitle='Open CEO Action Items'\n\t\t\t\ttitleColor='#1a1a2e'\n\t\t\t\tappLinkName='thisapp'\n\t\t\t\tlinkName='Open_CEO_Actions'\n\t\t\t\tiszreport='false'\n\t\t\t\tzc_Footer='true'\n\t\t\t\tzc_AddRec='true'\n\t\t\t\tzc_EditRec='true'\n\t\t\t\tzc_DelRec='false'\n\t\t\t\tzc_DuplRec='false'\n\t\t\t\tzc_Print='false'\n\t\t\t\tzc_Export='false'\n\t\t\t\tzc_Search='true'\n\t\t\t\tzc_EditBulkRec='false'\n\t\t\t\tzc_BulkDelete='false'\n\t\t\t\tzc_BulkDuplicate='false'\n\t\t\t\theightType='custom'\n\t\t\t\theightValue='400' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Academy_Monthly_Update_On_Success as "Academy Monthly Update - Update Metadata"
			{
			    type = form
			    form = Academy_Monthly_Update
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Updated_By = zoho.loginuserid;
			                input.Update_Date = zoho.currentdate;
			            )
			        }
			    }
			}

			Academy_PL_On_Success as "Academy P&L - Update Metadata"
			{
			    type = form
			    form = Academy_PL
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // No auto metadata fields on Academy_PL; Finance Validation Status defaults to Pending on add
			                // This workflow is a placeholder for future automation (e.g. IPG reconciliation alerts)
			            )
			        }
			    }
			}

			Batch_Operations_On_Success as "Batch Operations - RAG Escalation Notification"
			{
			    type = form
			    form = Batch_Operations
			    record event = on edit
			
			    on success
			    {
			        actions ( Risk_Flag == "Red" )
			        {
			            success message "Risk flag is RED. Review linked centre TM and Trainer assignments and escalate immediately.";
			        }
			        actions ( Risk_Flag == "Amber" )
			        {
			            success message "Risk flag is AMBER. T&D Office review is required.";
			        }
			    }
			}

			Batch_Operations_On_Validate as "Batch Operations - Funding Gate Validation"
			{
			    type = form
			    form = Batch_Operations
			    record event = on add or edit
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Start_Date != null && input.Funding_Confirmed != "Yes")
			                {
			                    alert "Batch Start Date cannot be set unless Funding Confirmed is 'Yes'. Please confirm funding before setting a start date.";
			                }
			            )
			        }
			    }
			}

			Centre_Master_On_Success as "Centre Master - Update Metadata"
			{
			    type = form
			    form = Centre_Master
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Updated_By = zoho.loginuserid;
			                input.Last_Updated = zoho.currentdate;
			            )
			        }
			    }
			}

			Learner_Lifecycle_DB_On_Success as "Learner Lifecycle DB - Update Metadata"
			{
			    type = form
			    form = Learner_Lifecycle_DB
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Updated_By = zoho.loginuserid;
			            )
			        }
			    }
			}

			Program_Utilization_On_Success as "Program Utilization - Update Metadata"
			{
			    type = form
			    form = Program_Utilization
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Updated_By = zoho.loginuserid;
			            )
			        }
			    }
			}

			TD_Revenue_Pipeline_On_Success as "T&D Revenue Pipeline - Update Metadata"
			{
			    type = form
			    form = TD_Revenue_Pipeline
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Updated_By = zoho.loginuserid;
			                input.Last_Updated = zoho.currentdate;
			            )
			        }
			    }
			}

			Trainer_Daily_Report_On_Load as "Trainer Daily Report - Auto-fill Trainer"
			{
			    type = form
			    form = Trainer_Daily_Report
			    record event = on add
			
			    on load
			    {
			        actions
			        {
			            custom deluge script
			            (
			                input.Trainer = zoho.loginuserid;
			            )
			        }
			    }
			}
		}
	}

	share_settings
	{
	"CEO_Office"
	{
	    name        = "CEO_Office"
	    type        = Users_Permissions
	    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
	    description = "CEO Office - read-only access to all modules; full create/edit access to CEO Action Box only"
	
	    ModulePermissions
	    {
	        Centre_Master
	        {
	            enabled          = View,Viewall,Search,Tab,Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Centres={"View"}
	                Centres_By_Status={"View"}
	                Active_Centres={"View"}
	            }
	        }
	
