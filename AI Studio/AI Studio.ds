		    Remarks
		    (
		        type = textarea
		        displayname = "Remarks"
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    SP_Review
		    (
		        type = section
		        displayname = "SP Review"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    SP_Team_Remark
		    (
		        type = textarea
		        displayname = "SP Team Remark"
		        row = 3
		        column = 1
		        width = medium
		    )
		    Recovery_Required
		    (
		        type = checkbox
		        displayname = "Recovery Required?"
		        row = 3
		        column = 2
		        width = medium
		    )
		    Deviation
		    (
		        type = formula
		        displayname = "Deviation (Planned vs Actual)"
		        value = if(Planned_Topic != Actual_Activity_Done && Planned_Topic != "" && Actual_Activity_Done != "", "Deviation Noted", "On Track")
		        visibility = true
		        row = 3
		        column = 1
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}
	}

	reports
	{
		default list All_Monthly_Updates
		{
		    displayName = "All Monthly Updates"
		    show all rows from Academy_Monthly_Update
		    (
		        Report_Month as "Month"
		        Centre
		        TM
		        Trainer
		        Learners_Mobilised as "Mobilised"
		        (
		            display = total
		        )
		        Learners_Enrolled as "Enrolled"
		        (
		            display = total
		        )
		        Training_Completed as "Trained"
		        (
		            display = total
		        )
		        Certified
		        (
		            display = total
		        )
		        Placed
		        (
		            display = total
		        )
		        Revenue_Collected_This_Month as "Revenue"
		        (
		            display = total
		        )
		        Cost_Incurred_This_Month as "Cost"
		        (
		            display = total
		        )
		        CEO_Escalation_Required as "CEO Escalation?"
		    )
		    filters
		    (
		        Centre
		        CEO_Escalation_Required
		    )
		    sort by
		    (
		        Report_Month descending
		    )
		    conditional formatting
		    (
		        "CEO Escalation"
		        {
		            condition = (CEO_Escalation_Required == true)
		            fields = [Report_Month, Centre, CEO_Escalation_Required]
		            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
		        }
		    )
		}

		list CEO_Escalations
		{
		    displayName = "CEO Escalations"
		    show all rows from Academy_Monthly_Update [CEO_Escalation_Required == true]
		    (
		        Report_Month as "Month"
		        Centre
		        TM
		        Trainer
		        Key_Issues_Risks as "Key Issues / Risks"
		        Next_Month_Plan as "Next Month Plan"
		    )
		    sort by
		    (
		        Report_Month descending
		    )
		}

		list Updates_By_Centre
		{
		    displayName = "Updates by Centre"
		    show all rows from Academy_Monthly_Update
		    (
		        Centre
		        Report_Month as "Month"
		        Learners_Mobilised as "Mobilised"
		        (
		            display = total
		        )
		        Learners_Enrolled as "Enrolled"
		        (
		            display = total
		        )
		        Certified
		        (
		            display = total
		        )
		        Placed
		        (
		            display = total
		        )
		        Revenue_Collected_This_Month as "Revenue"
		        (
		            display = total
		        )
		    )
		    group by
		    (
		        Centre ascending
		    )
		    sort by
		    (
		        Report_Month descending
		    )
		}

		list Academy_PL_By_Centre
		{
		    displayName = "P&L by Centre"
		    show all rows from Academy_PL
		    (
		        Centre
		        Reporting_Month as "Reporting Month"
		        Total_Revenue as "Total Revenue"
		        (
		            display = total
		        )
		        Total_Cost as "Total Cost"
		        (
		            display = total
		        )
		        Net_Surplus_Deficit as "Net Surplus/Deficit"
		        (
		            display = total
		        )
		        Funding_Gap as "Funding Gap"
		        (
		            display = total
		        )
		    )
		    group by
		    (
		        Centre ascending
		    )
		    sort by
		    (
		        Reporting_Month descending
		    )
		}

		default list All_Academy_PL
		{
		    displayName = "All Academy P&L"
		    show all rows from Academy_PL
		    (
		        Centre
		        Reporting_Month as "Reporting Month"
		        Current_Candidate_Count as "Candidates"
		        Total_Revenue as "Total Revenue"
		        (
		            display = total
		        )
		        Total_Cost as "Total Cost"
		        (
		            display = total
		        )
		        Net_Surplus_Deficit as "Net Surplus/Deficit"
		        (
		            display = total
		        )
		        Cost_Recovery_Percent as "Cost Recovery %"
		        Funding_Gap as "Funding Gap"
		        (
		            display = total
		        )
		        Finance_Validation_Status as "Validation"
		    )
		    filters
		    (
		        Centre
		        Finance_Validation_Status
		    )
		    sort by
		    (
		        Reporting_Month descending
		    )
		    conditional formatting
		    (
		        "Deficit"
		        {
		            condition = (Net_Surplus_Deficit < 0)
		            fields = [Net_Surplus_Deficit, Funding_Gap]
		            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
		        }
		        "Surplus"
		        {
		            condition = (Net_Surplus_Deficit >= 0)
		            fields = [Net_Surplus_Deficit]
		            format = "background-color:#D4EDDA;color:#155724"
		        }
		    )
		}

		list Pending_Validation
		{
		    displayName = "Pending Finance Validation"
		    show all rows from Academy_PL [Finance_Validation_Status == "Pending"]
