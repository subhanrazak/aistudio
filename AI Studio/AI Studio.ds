application "AI-Studio"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Academy_Monthly_Update
		{
		    title
		    {
		        displayname = "Academy Monthly Update"
		        on add = "Add Monthly Update"
		        on edit = "Edit Monthly Update"
		    }
		
		    Report_Period
		    (
		        type = section
		        displayname = "Report Period"
		        row = 1
		        column = 0
		    )
		    must have Report_Month
		    (
		        type = date
		        displayname = "Report Month"
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Centre
		    (
		        type = picklist
		        displayname = "Centre"
		        values = Centre_Master.ID
		        displayformat = [Centre_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Team_Section
		    (
		        type = section
		        displayname = "Team"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    TM
		    (
		        type = picklist
		        displayname = "TM"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 1
		        width = medium
		    )
		    Trainer
		    (
		        type = picklist
		        displayname = "Trainer"
		        module = users
		        displayformat = [name]
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Program_Status_Section
		    (
		        type = section
		        displayname = "Program Status"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Programs_Conducted_This_Month
		    (
		        type = checkboxes
		        displayname = "Programs Conducted This Month"
		        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    STT_Batch_Status
		    (
		        type = picklist
		        displayname = "STT Batch Status"
		        values = {"On Track","Delayed","Completed","Not Started","On Hold"}
		        row = 3
		        column = 2
		        width = medium
		    )
		    RPL_PMC_Status
		    (
		        type = textarea
		        displayname = "RPL/PMC/Upskilling/Workshop Status"
		        row = 3
		        column = 1
		        width = medium
		    )
		
		    Learner_Rollup_Section
		    (
		        type = section
		        displayname = "Learner Rollup"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Learners_Mobilised
		    (
		        type = number
		        displayname = "Learners Mobilised (This Month)"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Learners_Enrolled
		    (
		        type = number
		        displayname = "Learners Enrolled (This Month)"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Training_Completed
		    (
		        type = number
		        displayname = "Training Completed"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Assessment_Completed
		    (
		        type = number
		        displayname = "Assessment Completed"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Certified
		    (
		        type = number
		        displayname = "Certified"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Placed
		    (
		        type = number
		        displayname = "Placed"
		        row = 4
		        column = 2
		        width = medium
		    )
		    Apprenticeship_Started
		    (
		        type = number
		        displayname = "Apprenticeship Started"
		        row = 4
		        column = 1
		        width = medium
		    )
		    Dropouts
		    (
		        type = number
		        displayname = "Dropouts"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    Financials_Rollup_Section
		    (
		        type = section
		        displayname = "Financials Rollup"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Revenue_Collected_This_Month
		    (
		        type = INR
		        displayname = "Revenue Collected This Month"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		    Cost_Incurred_This_Month
		    (
		        type = INR
		        displayname = "Cost Incurred This Month"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 2
		        width = medium
		    )
		    Funding_Received_via_IPG
		    (
		        type = INR
		        displayname = "Funding Received via IP&G"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    Issues_Plans_Section
		    (
		        type = section
		        displayname = "Issues, Risks & Plans"
		        visibility = true
		        row = 6
		        column = 1
		    )
		    Key_Issues_Risks
		    (
		        type = textarea
		        displayname = "Key Issues / Risks"
		        row = 6
		        column = 1
		        width = medium
		    )
		    CEO_Escalation_Required
		    (
		        type = checkbox
		        displayname = "CEO Escalation Required?"
		        row = 6
		        column = 2
		        width = medium
		    )
		    Next_Month_Plan
		    (
		        type = textarea
		        displayname = "Next Month Plan"
		        row = 6
		        column = 1
		        width = medium
		    )
		
		    Metadata_Section
		    (
		        type = section
		        displayname = "Metadata"
		        visibility = true
		        row = 7
		        column = 1
		    )
		    Updated_By
		    (
		        type = picklist
		        displayname = "Updated By"
		        module = users
		        displayformat = [name]
		        row = 7
		        column = 1
		        width = medium
		    )
		    Update_Date
		    (
		        type = datetime
		        displayname = "Update Date"
		        row = 7
		        column = 2
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Academy_PL
		{
		    title
		    {
		        displayname = "Academy P&L"
		        on add = "Add Academy P&L Record"
		        on edit = "Edit Academy P&L Record"
		    }
		
		    Centre_Period
		    (
		        type = section
		        displayname = "Centre & Period"
		        row = 1
		        column = 0
		    )
		    must have Centre
		    (
		        type = picklist
		        displayname = "Centre"
		        values = Centre_Master.ID
		        displayformat = [Centre_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Reporting_Month
		    (
		        type = date
		        displayname = "Reporting Month"
		        row = 1
		        column = 2
		        width = medium
		    )
		    Current_Candidate_Count
		    (
		        type = number
		        displayname = "Current Candidate Count"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    Student_Paid_Revenue
		    (
		        type = section
		        displayname = "Student Paid Revenue"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Installment_1
		    (
		        type = INR
		        displayname = "Installment 1"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Installment_2
		    (
		        type = INR
		        displayname = "Installment 2"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Installment_3
		    (
		        type = INR
		        displayname = "Installment 3"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Installment_4
		    (
		        type = INR
		        displayname = "Installment 4"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Installment_5
		    (
		        type = INR
		        displayname = "Installment 5"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Installment_6
		    (
		        type = INR
		        displayname = "Installment 6"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Installment_7
		    (
		        type = INR
		        displayname = "Installment 7"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		
		    Other_Revenue_Section
		    (
		        type = section
		        displayname = "Other Revenue"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Skill_Academy_Partner_Revenue
		    (
		        type = INR
		        displayname = "Skill Academy Partner Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 1
		        width = medium
		    )
		    School_Workshop_Revenue
		    (
		        type = INR
		        displayname = "School Workshop Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 2
		        width = medium
		    )
		    College_Workshop_Revenue
		    (
		        type = INR
		        displayname = "College Workshop Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 1
		        width = medium
		    )
		    Workshop_RPL_Other_Revenue
		    (
		        type = INR
		        displayname = "Workshop/RPL/Upskilling/Other Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 2
		        width = medium
		    )
		    IPG_Funding_Support_Received
		    (
		        type = INR
		        displayname = "IP&G Funding Support Received"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 1
		        width = medium
		    )
		    CSR_Govt_Industry_Funding
		    (
		        type = INR
		        displayname = "CSR/Govt/Industry Funding"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 2
		        width = medium
		    )
		    Marketing_Collaboration_Revenue
		    (
		        type = INR
		        displayname = "Marketing Collaboration Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 1
		        width = medium
		    )
		    Other_Revenue
		    (
		        type = INR
		        displayname = "Other Revenue"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 3
		        column = 2
		        width = medium
		    )
		    Total_Revenue
		    (
		        type = formula
		        displayname = "Total Revenue"
		        value = Installment_1 + Installment_2 + Installment_3 + Installment_4 + Installment_5 + Installment_6 + Installment_7 + Skill_Academy_Partner_Revenue + School_Workshop_Revenue + College_Workshop_Revenue + Workshop_RPL_Other_Revenue + IPG_Funding_Support_Received + CSR_Govt_Industry_Funding + Marketing_Collaboration_Revenue + Other_Revenue
		        visibility = true
		        row = 3
		        column = 1
		    )
		
		    Costs_Section
		    (
		        type = section
		        displayname = "Costs"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Trainer_Cost
		    (
		        type = INR
		        displayname = "Trainer Cost"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 1
		        width = medium
		    )
		    TM_Cost_Allocation
		    (
		        type = INR
		        displayname = "TM Cost Allocation"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 2
		        width = medium
		    )
		    HQ_Cost_Allocation
		    (
		        type = INR
		        displayname = "HQ Cost Allocation"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 1
		        width = medium
		    )
		    Mobilisation_Cost
		    (
		        type = INR
		        displayname = "Mobilisation Cost"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 2
		        width = medium
		    )
		    Assessment_Cost
		    (
		        type = INR
		        displayname = "Assessment Cost"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 1
		        width = medium
		    )
		    Consumables_Material
		    (
		        type = INR
		        displayname = "Consumables / Material"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 2
		        width = medium
		    )
		    Travel_Local_Coordination
		    (
		        type = INR
		        displayname = "Travel / Local Coordination"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 1
		        width = medium
		    )
		    Infra_Branding_Setup
		    (
		        type = INR
		        displayname = "Infra / Branding / Setup"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 2
		        width = medium
		    )
		    Other_Cost
		    (
		        type = INR
		        displayname = "Other Cost"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 4
		        column = 1
		        width = medium
		    )
		    Total_Cost
		    (
		        type = formula
		        displayname = "Total Cost"
		        value = Trainer_Cost + TM_Cost_Allocation + HQ_Cost_Allocation + Mobilisation_Cost + Assessment_Cost + Consumables_Material + Travel_Local_Coordination + Infra_Branding_Setup + Other_Cost
		        visibility = true
		        row = 4
		        column = 2
		    )
		
		    PL_Summary_Section
		    (
		        type = section
		        displayname = "P&L Summary"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Net_Surplus_Deficit
		    (
		        type = INR
		        displayname = "Net Surplus / Deficit"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		    Cost_Recovery_Percent
		    (
		        type = decimal
		        displayname = "Cost Recovery %"
		        decimalplace = 1
		        row = 5
		        column = 2
		        width = medium
		    )
		    Funding_Gap
		    (
		        type = INR
		        displayname = "Funding Gap"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 5
		        column = 1
		        width = medium
		    )
		    Finance_Validation_Status
		    (
		        type = picklist
		        displayname = "Finance Validation Status"
		        values = {"Pending","Validated"}
		        initial value = "Pending"
		        row = 5
		        column = 2
		        width = medium
		    )
		    Notes_Assumptions
		    (
		        type = textarea
		        displayname = "Notes / Assumptions"
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Batch_Operations
		{
		    title
		    {
		        displayname = "Batch Operations"
		        on add = "Add Batch"
		        on edit = "Edit Batch"
		    }
		
		    record owner = Added_User
		
		    Batch_Identity
		    (
		        type = section
		        displayname = "Batch Identity"
		        row = 1
		        column = 0
		    )
		    Batch_ID
		    (
		        type = autonumber
		        displayname = "Batch ID"
		        start index = 1
		        row = 1
		        column = 1
		    )
		    must have Centre
		    (
		        type = picklist
		        displayname = "Centre"
		        values = Centre_Master.ID
		        displayformat = [Centre_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Program
		    (
		        type = picklist
		        displayname = "Program"
		        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
		        row = 1
		        column = 2
		        width = medium
		    )
		    Program_Category
		    (
		        type = picklist
		        displayname = "Program Category"
		        values = {"Core Skills","Upskilling","Assessment","Workshop","Competition"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Scheme
		    (
		        type = text
		        displayname = "Scheme"
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Funding_Details
		    (
		        type = section
		        displayname = "Funding Details"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    must have Funding_Mode
		    (
		        type = picklist
		        displayname = "Funding Mode"
		        values = {"Student Paid/MSMP","FOC-to confirm","Industry Partner Funded","CSR Funded","Govt Funded"}
		        row = 2
		        column = 1
		        width = medium
		    )
		    Funding_Source
		    (
		        type = text
		        displayname = "Funding Source"
		        row = 2
		        column = 2
		        width = medium
		    )
		    must have Funding_Confirmed
		    (
		        type = picklist
		        displayname = "Funding Confirmed"
		        values = {"Yes","No","To Confirm","Historical"}
		        initial value = "To Confirm"
		        row = 2
		        column = 1
		        width = medium
		    )
		    Funding_Commercial_Notes
		    (
		        type = textarea
		        displayname = "Funding / Commercial Notes"
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Batch_Lifecycle
		    (
		        type = section
		        displayname = "Batch Lifecycle"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Batch_Stage
		    (
		        type = picklist
		        displayname = "Batch Stage"
		        values = {"Track M","Track D","Planning","Active","Completed","On Hold"}
		        row = 3
		        column = 1
		        width = medium
		    )
		    Lifecycle_Tag
		    (
		        type = picklist
		        displayname = "Lifecycle Tag"
		        values = {"Planned","Pipeline","Mobilization","Enrolled","Training","Assessment","Certified","Placed","Alumni","On Hold"}
		        row = 3
		        column = 2
		        width = medium
		    )
		    Start_Date
		    (
		        type = date
		        displayname = "Start Date"
		        row = 3
		        column = 1
		        width = medium
		    )
		    End_Date
		    (
		        type = date
		        displayname = "End Date"
		        row = 3
		        column = 2
		        width = medium
		    )
		
		    Outcomes_Status
		    (
		        type = section
		        displayname = "Outcomes & Status"
		        visibility = true
		        row = 4
		        column = 1
		    )
		    Assessment_Status
		    (
		        type = picklist
		        displayname = "Assessment Status"
		        values = {"Not Started","Scheduled","Completed","Pending Results"}
		        row = 4
		        column = 1
		        width = medium
		    )
		    Certification_Status
		    (
		        type = picklist
		        displayname = "Certification Status"
		        values = {"Not Applied","Applied","Issued","Pending"}
		        row = 4
		        column = 2
		        width = medium
		    )
		    Placement_Status
		    (
		        type = picklist
		        displayname = "Placement Status"
		        values = {"Not Started","In Progress","Partially Placed","Fully Placed"}
		        row = 4
		        column = 1
		        width = medium
		    )
		    Apprenticeship_Status
		    (
		        type = picklist
		        displayname = "Apprenticeship Status"
		        values = {"Not Applicable","In Progress","Completed"}
		        row = 4
		        column = 2
		        width = medium
		    )
		    Risk_Flag
		    (
		        type = picklist
		        displayname = "Risk Flag"
		        values = {"Green","Amber","Red"}
		        initial value = "Green"
		        row = 4
		        column = 1
		        width = medium
		    )
		    CEO_Action_Required
		    (
		        type = checkbox
		        displayname = "CEO Action Required?"
		        row = 4
		        column = 2
		        width = medium
		    )
		
		    Next_Steps
		    (
		        type = section
		        displayname = "Next Steps"
		        visibility = true
		        row = 5
		        column = 1
		    )
		    Next_Step
		    (
		        type = textarea
		        displayname = "Next Step"
		        row = 5
		        column = 1
		        width = medium
		    )
		
		    Rollup_Section
		    (
		        type = section
		        displayname = "Learner Rollup"
		        visibility = true
		        row = 6
		        column = 1
		    )
		    Candidates_Count
		    (
		        type = number
		        displayname = "Candidates Count"
		        row = 6
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

		form Batch_Wise_Expense
		{
		    title
		    {
		        displayname = "Batch Wise Expense"
		        on add = "Add Batch Expense"
		        on edit = "Edit Batch Expense"
		    }
		
		    Batch_Reference
		    (
		        type = section
		        displayname = "Batch Reference"
		        row = 1
		        column = 0
		    )
		    must have Batch
		    (
		        type = picklist
		        displayname = "Batch"
		        values = Batch_Operations.ID
		        displayformat = [Batch_ID]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Centre
		    (
		        type = picklist
		        displayname = "Centre"
		        values = Centre_Master.ID
		        displayformat = [Centre_Name]
		        searchable = true
		        row = 1
		        column = 2
		        width = medium
		    )
		
		    Expense_Items
		    (
		        type = section
		        displayname = "Expense Items"
		        visibility = true
		        row = 2
		        column = 1
		    )
		    Mobilisation_Expense
		    (
		        type = INR
		        displayname = "Mobilisation Expense"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Trainer_Conveyance_Cost
		    (
		        type = INR
		        displayname = "Trainer / Centre Head Conveyance Cost"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Industry_Visit
		    (
		        type = INR
		        displayname = "Industry Visit"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Raw_Material_Consumables
		    (
		        type = INR
		        displayname = "Raw Material & Consumables"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		    Activities_Refreshments_Others
		    (
		        type = INR
		        displayname = "Activities / Refreshments / Others"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 1
		        width = medium
		    )
		    Insurance_Medical
		    (
		        type = INR
		        displayname = "Insurance / Medical for Candidates"
		        format = commadotindian
		        decimalplace = 2
		        maxchar = 16
		        row = 2
		        column = 2
		        width = medium
		    )
		
		    Total_Section
		    (
		        type = section
		        displayname = "Total"
		        visibility = true
		        row = 3
		        column = 1
		    )
		    Total_Expense_for_Batch
		    (
		        type = formula
		        displayname = "Total Expense for Batch"
		        value = Mobilisation_Expense + Trainer_Conveyance_Cost + Industry_Visit + Raw_Material_Consumables + Activities_Refreshments_Others + Insurance_Medical
		        visibility = true
		        row = 3
		        column = 1
		    )
		
		    actions
		    {
		        on add
		        {
		            Submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            Reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            Update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            Cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		}

