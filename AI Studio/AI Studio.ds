		default list All_CEO_Actions
		{
		    displayName = "All CEO Actions"
		    show all rows from CEO_Action_Box
		    (
		        Priority
		        Status
		        Department
		        Issue_Decision_Required as "Issue / Decision Required"
		        Linked_Centre as "Centre"
		        Linked_Batch as "Batch"
		        Owner
		        Due_Date as "Due Date"
		        CEO_Decision_Intervention as "CEO Decision"
		    )
		    filters
		    (
		        Priority
		        Status
		        Department
		        Owner
		    )
		    sort by
		    (
		        Priority ascending
		        Due_Date ascending
		    )
		    conditional formatting
		    (
		        "High Priority Open"
		        {
		            condition = (Priority == "High" && Status != "Closed")
		            fields = [Priority, Status, Due_Date]
		            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
		        }
		        "Medium Priority Open"
		        {
		            condition = (Priority == "Medium" && Status == "Open")
		            fields = [Priority, Status]
		            format = "background-color:#FFF3CD;color:#856404"
		        }
		        "Closed"
		        {
		            condition = (Status == "Closed")
		            fields = [Priority, Status]
		            format = "background-color:#D4EDDA;color:#155724"
		        }
		    )
		}

