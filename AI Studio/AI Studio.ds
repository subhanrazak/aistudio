	                CEO_Escalations={"View"}
	                Updates_By_Centre={"View"}
	            }
	        }
	
	        CEO_Action_Box
	        {
	            enabled          = Create,View,Viewall,Edit,Modifyall,Search,Tab,Export
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_CEO_Actions={"View","Edit","Delete"}
	                Open_CEO_Actions={"View","Edit"}
	                CEO_Actions_By_Status={"View","Edit","Delete"}
	            }
	        }
	
	        CEO_Dashboard
	        {
	            enabled = tab
	        }
	    }
