"TM"
{
    name        = "TM"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Territory Manager - create/edit Batch Operations, Academy Monthly Update, T&D Revenue Pipeline, Learner DB (mobilisation/enrolment fields); read-only on Centre Master, Program Utilization"

    ModulePermissions
    {
        Centre_Master
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Centres={"View"}
                Centres_By_Status={"View"}
                Active_Centres={"View"}
            }
        }

        Batch_Operations
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View","Edit"}
                Active_Batches={"View","Edit"}
                Batches_By_Centre={"View","Edit"}
                CEO_Action_Batches={"View"}
            }
        }

        Program_Utilization
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
