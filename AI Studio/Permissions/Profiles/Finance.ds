"Finance"
{
    name        = "Finance"
    type        = Users_Permissions
    permissions = { Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false }
    description = "Finance team - create/edit Academy P&L and Batch Wise Expense; read-only on Centre Master and Batch Operations"

    ModulePermissions
    {
        Centre_Master
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Centres={"View"}
                Active_Centres={"View"}
            }
        }

        Batch_Operations
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batches={"View"}
                Active_Batches={"View"}
                Batches_By_Centre={"View"}
            }
        }

        Academy_PL
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import,Export
            allFieldsVisible = true
            ReportPermissions
            {
                All_Academy_PL={"View","Edit","Delete"}
                Academy_PL_By_Centre={"View","Edit"}
                Pending_Validation={"View","Edit","Delete"}
            }
        }

        Batch_Wise_Expense
        {
            enabled          = Create,View,Viewall,Edit,Modifyall,Delete,Search,Tab,Import
            allFieldsVisible = true
            ReportPermissions
            {
                All_Batch_Expenses={"View","Edit","Delete"}
                Expenses_By_Batch={"View","Edit"}
            }
        }

        IPG_Funding_Support
        {
            enabled          = View,Viewall,Search,Tab
            allFieldsVisible = true
            ReportPermissions
            {
                All_IPG_Funding={"View"}
                Pending_Funding={"View"}
                Funding_By_Centre={"View"}
            }
        }
    }
}
