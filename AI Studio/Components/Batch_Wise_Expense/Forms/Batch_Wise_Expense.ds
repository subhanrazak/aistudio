form Batch_Wise_Expense
{
    title
    {
        displayname = "Batch Wise Expense"
        on add = "Add Batch Expense"
        on edit = "Edit Batch Expense"
    }

    Batch_Reference
    (
        type = section
        displayname = "Batch Reference"
        row = 1
        column = 0
    )
    must have Batch
    (
        type = picklist
        displayname = "Batch"
        values = Batch_Operations.ID
        displayformat = [Batch_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )

    Expense_Items
    (
        type = section
        displayname = "Expense Items"
        visibility = true
        row = 2
        column = 1
    )
    Mobilisation_Expense
    (
        type = INR
        displayname = "Mobilisation Expense"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Trainer_Conveyance_Cost
    (
        type = INR
        displayname = "Trainer / Centre Head Conveyance Cost"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Industry_Visit
    (
        type = INR
        displayname = "Industry Visit"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Raw_Material_Consumables
    (
        type = INR
        displayname = "Raw Material & Consumables"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )
    Activities_Refreshments_Others
    (
        type = INR
        displayname = "Activities / Refreshments / Others"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 1
        width = medium
    )
    Insurance_Medical
    (
        type = INR
        displayname = "Insurance / Medical for Candidates"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 2
        column = 2
        width = medium
    )

    Total_Section
    (
        type = section
        displayname = "Total"
        visibility = true
        row = 3
        column = 1
    )
    Total_Expense_for_Batch
    (
        type = formula
        displayname = "Total Expense for Batch"
        value = Mobilisation_Expense + Trainer_Conveyance_Cost + Industry_Visit + Raw_Material_Consumables + Activities_Refreshments_Others + Insurance_Medical
        visibility = true
        row = 3
        column = 1
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
