list Expenses_By_Batch
{
    displayName = "Expenses by Batch"
    show all rows from Batch_Wise_Expense
    (
        Batch
        Total_Expense_for_Batch as "Total Expense"
        (
            display = total
        )
        Mobilisation_Expense as "Mobilisation"
        (
            display = total
        )
        Trainer_Conveyance_Cost as "Conveyance"
        (
            display = total
        )
        Industry_Visit as "Industry Visit"
        (
            display = total
        )
        Raw_Material_Consumables as "Raw Material"
        (
            display = total
        )
    )
    group by
    (
        Batch ascending
    )
    sort by
    (
        Total_Expense_for_Batch descending
    )
}
