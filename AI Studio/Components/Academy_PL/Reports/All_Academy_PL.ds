default list All_Academy_PL
{
    displayName = "All Academy P&L"
    show all rows from Academy_PL
    (
        Centre
        Reporting_Month as "Reporting Month"
        Current_Candidate_Count as "Candidates"
        Total_Revenue as "Total Revenue"
        (
            display = total
        )
        Total_Cost as "Total Cost"
        (
            display = total
        )
        Net_Surplus_Deficit as "Net Surplus/Deficit"
        (
            display = total
        )
        Cost_Recovery_Percent as "Cost Recovery %"
        Funding_Gap as "Funding Gap"
        (
            display = total
        )
        Finance_Validation_Status as "Validation"
    )
    filters
    (
        Centre
        Finance_Validation_Status
    )
    sort by
    (
        Reporting_Month descending
    )
    conditional formatting
    (
        "Deficit"
        {
            condition = (Net_Surplus_Deficit < 0)
            fields = [Net_Surplus_Deficit, Funding_Gap]
            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
        }
        "Surplus"
        {
            condition = (Net_Surplus_Deficit >= 0)
            fields = [Net_Surplus_Deficit]
            format = "background-color:#D4EDDA;color:#155724"
        }
    )
}
