form Trainer_Daily_Report
{
    title
    {
        displayname = "Trainer Daily Report"
        on add = "Add Daily Report"
        on edit = "Edit Daily Report"
    }

    Report_Identity
    (
        type = section
        displayname = "Report Identity"
        row = 1
        column = 0
    )
    must have Batch
    (
        type = picklist
        displayname = "Batch"
        values = Batch_Operations.ID
        displayformat = [Batch_ID]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Report_Date
    (
        type = date
        displayname = "Report Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Trainer
    (
        type = picklist
        displayname = "Trainer"
        module = users
        displayformat = [name]
        row = 1
        column = 1
        width = medium
    )

    Activity_Details
    (
        type = section
        displayname = "Activity Details"
        visibility = true
        row = 2
        column = 1
    )
    Candidates_Present
    (
        type = number
        displayname = "Candidates Present"
        row = 2
        column = 1
        width = medium
    )
    Planned_Topic
    (
        type = text
        displayname = "Planned Topic (Task as per Plan)"
        row = 2
        column = 2
        width = medium
    )
    Actual_Activity_Done
    (
        type = text
        displayname = "Actual Activity Done"
        row = 2
        column = 1
        width = medium
    )
    Completion_Percent
    (
        type = decimal
        displayname = "Completion %"
        decimalplace = 1
        row = 2
        column = 2
        width = medium
    )
    Remarks
    (
        type = textarea
        displayname = "Remarks"
        row = 2
        column = 1
        width = medium
    )

    SP_Review
    (
        type = section
        displayname = "SP Review"
        visibility = true
        row = 3
        column = 1
    )
    SP_Team_Remark
    (
        type = textarea
        displayname = "SP Team Remark"
        row = 3
        column = 1
        width = medium
    )
    Recovery_Required
    (
        type = checkbox
        displayname = "Recovery Required?"
        row = 3
        column = 2
        width = medium
    )
    Deviation
    (
        type = formula
        displayname = "Deviation (Planned vs Actual)"
        value = if(Planned_Topic != Actual_Activity_Done && Planned_Topic != "" && Actual_Activity_Done != "", "Deviation Noted", "On Track")
        visibility = true
        row = 3
        column = 1
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
