Centre_Master_On_Success as "Centre Master - Update Metadata"
{
    type = form
    form = Centre_Master
    record event = on add or edit

    on success
    {
        actions
        {
            custom deluge script
            (
                input.Updated_By = zoho.loginuserid;
                input.Last_Updated = zoho.currentdate;
            )
        }
    }
}
