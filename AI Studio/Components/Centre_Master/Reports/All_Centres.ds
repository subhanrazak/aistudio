default list All_Centres
{
    displayName = "All Centres"
    show all rows from Centre_Master
    (
        Centre_Name as "Centre Name"
        Centre_Type as "Type"
        Location
        Current_Status as "Status"
        RAG as "RAG"
        Lifecycle_Summary as "Lifecycle"
        Annual_STT_Batch_Capacity as "Annual Capacity"
        Current_Candidate_Count as "Candidates"
        (
            display = total
        )
    )
    filters
    (
        Current_Status
        RAG
        Centre_Type
        Lifecycle_Summary
    )
    sort by
    (
        Centre_Name ascending
    )
    conditional formatting
    (
        "Red RAG"
        {
            condition = (RAG == "Red")
            fields = [Centre_Name, RAG]
            format = "background-color:#FFE0E0;color:#CC0000;font-weight:bold"
        }
        "Amber RAG"
        {
            condition = (RAG == "Amber")
            fields = [Centre_Name, RAG]
            format = "background-color:#FFF3CD;color:#856404"
        }
        "Green RAG"
        {
            condition = (RAG == "Green")
            fields = [Centre_Name, RAG]
            format = "background-color:#D4EDDA;color:#155724"
        }
    )
}
