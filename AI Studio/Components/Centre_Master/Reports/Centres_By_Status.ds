list Centres_By_Status
{
    displayName = "Centres by Status"
    show all rows from Centre_Master
    (
        Centre_Name as "Centre Name"
        Centre_Type as "Type"
        Location
        Current_Status as "Status"
        Lifecycle_Summary as "Lifecycle"
        RAG as "RAG"
        Current_Batch_Start_Date as "Current Batch Start"
        Next_Batch_Tentative_Date as "Next Batch Date"
    )
    group by
    (
        Current_Status ascending
    )
    sort by
    (
        Centre_Name ascending
    )
}
