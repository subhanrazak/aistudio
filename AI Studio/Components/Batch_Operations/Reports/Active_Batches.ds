list Active_Batches
{
    displayName = "Active Batches"
    show all rows from Batch_Operations [Batch_Stage == "Active"]
    (
        Batch_ID as "Batch ID"
        Centre
        Program
        Funding_Mode as "Funding Mode"
        Start_Date as "Start Date"
        End_Date as "End Date"
        Candidates_Count as "Candidates"
        (
            display = total
        )
        Assessment_Status as "Assessment"
        Risk_Flag as "Risk"
    )
    sort by
    (
        Start_Date ascending
    )
}
