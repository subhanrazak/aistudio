list Batches_By_Centre
{
    displayName = "Batches by Centre"
    show all rows from Batch_Operations
    (
        Centre
        Batch_ID as "Batch ID"
        Program
        Batch_Stage as "Stage"
        Funding_Confirmed as "Funding Confirmed"
        Start_Date as "Start Date"
        End_Date as "End Date"
        Risk_Flag as "Risk"
        Candidates_Count as "Candidates"
        (
            display = total
        )
    )
    group by
    (
        Centre ascending
    )
    sort by
    (
        Start_Date descending
    )
}
