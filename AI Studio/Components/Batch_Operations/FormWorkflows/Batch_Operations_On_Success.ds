Batch_Operations_On_Success as "Batch Operations - RAG Escalation Notification"
{
    type = form
    form = Batch_Operations
    record event = on edit

    on success
    {
        actions ( Risk_Flag == "Red" )
        {
            success message "Risk flag is RED. Review linked centre TM and Trainer assignments and escalate immediately.";
        }
        actions ( Risk_Flag == "Amber" )
        {
            success message "Risk flag is AMBER. T&D Office review is required.";
        }
    }
}
