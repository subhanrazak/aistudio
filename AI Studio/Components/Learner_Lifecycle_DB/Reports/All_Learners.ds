default list All_Learners
{
    displayName = "All Learners"
    show all rows from Learner_Lifecycle_DB
    (
        Learner_Name as "Learner Name"
        Centre
        Batch
        Program
        Learner_Stage as "Stage"
        Attendance_Percent as "Attendance %"
        Assessment_Status as "Assessment"
        Certification_Status as "Certification"
        Placement_Status as "Placement"
        RAG as "RAG"
    )
    filters
    (
        Centre
        Batch
        Program
        Learner_Stage
        Assessment_Status
        Placement_Status
        RAG
    )
    sort by
    (
        Learner_Name ascending
    )
    conditional formatting
    (
        "Red RAG"
        {
            condition = (RAG == "Red")
            fields = [Learner_Name, RAG]
            format = "background-color:#FFE0E0;color:#CC0000"
        }
        "Amber RAG"
        {
            condition = (RAG == "Amber")
            fields = [Learner_Name, RAG]
            format = "background-color:#FFF3CD;color:#856404"
        }
    )
}
