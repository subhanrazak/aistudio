list Learners_By_Batch
{
    displayName = "Learners by Batch"
    show all rows from Learner_Lifecycle_DB
    (
        Batch
        Learner_Name as "Learner Name"
        Gender
        Learner_Stage as "Stage"
        Attendance_Percent as "Attendance %"
        Certification_Status as "Certification"
        Placement_Status as "Placement"
    )
    group by
    (
        Batch ascending
    )
    sort by
    (
        Learner_Name ascending
    )
}
