list Funding_By_Centre
{
    displayName = "Funding by Centre"
    show all rows from IPG_Funding_Support
    (
        Centre
        Funding_Source_Partner as "Source / Partner"
        Funding_Type as "Type"
        Amount_Committed as "Committed"
        (
            display = total
        )
        Amount_Received as "Received"
        (
            display = total
        )
        Balance_Pending as "Balance"
        (
            display = total
        )
        Funding_Status as "Status"
    )
    group by
    (
        Centre ascending
    )
    sort by
    (
        Amount_Committed descending
    )
}
