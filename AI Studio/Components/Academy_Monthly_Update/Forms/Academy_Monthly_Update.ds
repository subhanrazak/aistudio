form Academy_Monthly_Update
{
    title
    {
        displayname = "Academy Monthly Update"
        on add = "Add Monthly Update"
        on edit = "Edit Monthly Update"
    }

    Report_Period
    (
        type = section
        displayname = "Report Period"
        row = 1
        column = 0
    )
    must have Report_Month
    (
        type = date
        displayname = "Report Month"
        row = 1
        column = 1
        width = medium
    )
    must have Centre
    (
        type = picklist
        displayname = "Centre"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )

    Team_Section
    (
        type = section
        displayname = "Team"
        visibility = true
        row = 2
        column = 1
    )
    TM
    (
        type = picklist
        displayname = "TM"
        module = users
        displayformat = [name]
        row = 2
        column = 1
        width = medium
    )
    Trainer
    (
        type = picklist
        displayname = "Trainer"
        module = users
        displayformat = [name]
        row = 2
        column = 2
        width = medium
    )

    Program_Status_Section
    (
        type = section
        displayname = "Program Status"
        visibility = true
        row = 3
        column = 1
    )
    Programs_Conducted_This_Month
    (
        type = checkboxes
        displayname = "Programs Conducted This Month"
        values = {"STT Core","RPL","PMC","Upskilling","Workshop","TOT-A","WSC","India Skills"}
        row = 3
        column = 1
        width = medium
    )
    STT_Batch_Status
    (
        type = picklist
        displayname = "STT Batch Status"
        values = {"On Track","Delayed","Completed","Not Started","On Hold"}
        row = 3
        column = 2
        width = medium
    )
    RPL_PMC_Status
    (
        type = textarea
        displayname = "RPL/PMC/Upskilling/Workshop Status"
        row = 3
        column = 1
        width = medium
    )

    Learner_Rollup_Section
    (
        type = section
        displayname = "Learner Rollup"
        visibility = true
        row = 4
        column = 1
    )
    Learners_Mobilised
    (
        type = number
        displayname = "Learners Mobilised (This Month)"
        row = 4
        column = 1
        width = medium
    )
    Learners_Enrolled
    (
        type = number
        displayname = "Learners Enrolled (This Month)"
        row = 4
        column = 2
        width = medium
    )
    Training_Completed
    (
        type = number
        displayname = "Training Completed"
        row = 4
        column = 1
        width = medium
    )
    Assessment_Completed
    (
        type = number
        displayname = "Assessment Completed"
        row = 4
        column = 2
        width = medium
    )
    Certified
    (
        type = number
        displayname = "Certified"
        row = 4
        column = 1
        width = medium
    )
    Placed
    (
        type = number
        displayname = "Placed"
        row = 4
        column = 2
        width = medium
    )
    Apprenticeship_Started
    (
        type = number
        displayname = "Apprenticeship Started"
        row = 4
        column = 1
        width = medium
    )
    Dropouts
    (
        type = number
        displayname = "Dropouts"
        row = 4
        column = 2
        width = medium
    )

    Financials_Rollup_Section
    (
        type = section
        displayname = "Financials Rollup"
        visibility = true
        row = 5
        column = 1
    )
    Revenue_Collected_This_Month
    (
        type = INR
        displayname = "Revenue Collected This Month"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 5
        column = 1
        width = medium
    )
    Cost_Incurred_This_Month
    (
        type = INR
        displayname = "Cost Incurred This Month"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 5
        column = 2
        width = medium
    )
    Funding_Received_via_IPG
    (
        type = INR
        displayname = "Funding Received via IP&G"
        format = commadotindian
        decimalplace = 2
        maxchar = 16
        row = 5
        column = 1
        width = medium
    )

    Issues_Plans_Section
    (
        type = section
        displayname = "Issues, Risks & Plans"
        visibility = true
        row = 6
        column = 1
    )
    Key_Issues_Risks
    (
        type = textarea
        displayname = "Key Issues / Risks"
        row = 6
        column = 1
        width = medium
    )
    CEO_Escalation_Required
    (
        type = checkbox
        displayname = "CEO Escalation Required?"
        row = 6
        column = 2
        width = medium
    )
    Next_Month_Plan
    (
        type = textarea
        displayname = "Next Month Plan"
        row = 6
        column = 1
        width = medium
    )

    Metadata_Section
    (
        type = section
        displayname = "Metadata"
        visibility = true
        row = 7
        column = 1
    )
    Updated_By
    (
        type = picklist
        displayname = "Updated By"
        module = users
        displayformat = [name]
        row = 7
        column = 1
        width = medium
    )
    Update_Date
    (
        type = datetime
        displayname = "Update Date"
        row = 7
        column = 2
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
