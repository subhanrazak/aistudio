Academy_Monthly_Update_On_Success as "Academy Monthly Update - Update Metadata"
{
    type = form
    form = Academy_Monthly_Update
    record event = on add or edit

    on success
    {
        actions
        {
            custom deluge script
            (
                input.Updated_By = zoho.loginuserid;
                input.Update_Date = zoho.currentdate;
            )
        }
    }
}
