list Pipeline_By_Stage
{
    displayName = "Pipeline by Stage"
    show all rows from TD_Revenue_Pipeline
    (
        Stage
        Revenue_Type as "Type"
        Partner_Institution as "Partner"
        Expected_Revenue as "Exp. Revenue"
        (
            display = total
        )
        Expected_Net as "Exp. Net"
        (
            display = total
        )
        Probability_Percent as "Probability %"
        Expected_Closure_Date as "Closure Date"
        Owner_TM as "Owner TM"
    )
    group by
    (
        Stage ascending
    )
    sort by
    (
        Expected_Revenue descending
    )
}
