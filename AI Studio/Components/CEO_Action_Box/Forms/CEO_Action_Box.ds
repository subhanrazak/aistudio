form CEO_Action_Box
{
    title
    {
        displayname = "CEO Action Box"
        on add = "Add CEO Action Item"
        on edit = "Edit CEO Action Item"
    }

    Issue_Details
    (
        type = section
        displayname = "Issue Details"
        row = 1
        column = 0
    )
    must have Priority
    (
        type = picklist
        displayname = "Priority"
        values = {"High","Medium","Low"}
        initial value = "Medium"
        row = 1
        column = 1
        width = medium
    )
    must have Status
    (
        type = picklist
        displayname = "Status"
        values = {"Open","In Progress","Closed"}
        initial value = "Open"
        row = 1
        column = 2
        width = medium
    )
    must have Issue_Decision_Required
    (
        type = textarea
        displayname = "Issue / Decision Required"
        row = 1
        column = 1
        width = medium
    )
    Department
    (
        type = picklist
        displayname = "Department"
        values = {"Training & Delivery/Systems","Industry Partnerships & Growth","Finance","CEO Office"}
        row = 1
        column = 2
        width = medium
    )

    Linked_Records
    (
        type = section
        displayname = "Linked Records"
        visibility = true
        row = 2
        column = 1
    )
    Linked_Centre
    (
        type = picklist
        displayname = "Linked Centre (Optional)"
        values = Centre_Master.ID
        displayformat = [Centre_Name]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Linked_Batch
    (
        type = picklist
        displayname = "Linked Batch (Optional)"
        values = Batch_Operations.ID
        displayformat = [Batch_ID]
        searchable = true
        row = 2
        column = 2
        width = medium
    )

    Ownership_Resolution
    (
        type = section
        displayname = "Ownership & Resolution"
        visibility = true
        row = 3
        column = 1
    )
    Owner
    (
        type = picklist
        displayname = "Owner"
        module = users
        displayformat = [name]
        row = 3
        column = 1
        width = medium
    )
    Due_Date
    (
        type = date
        displayname = "Due Date"
        row = 3
        column = 2
        width = medium
    )
    CEO_Decision_Intervention
    (
        type = textarea
        displayname = "CEO Decision / Intervention"
        row = 3
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
