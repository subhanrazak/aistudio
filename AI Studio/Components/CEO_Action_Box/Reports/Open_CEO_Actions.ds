list Open_CEO_Actions
{
    displayName = "Open CEO Actions"
    show all rows from CEO_Action_Box [Status == "Open" || Status == "In Progress"]
    (
        Priority
        Department
        Issue_Decision_Required as "Issue / Decision Required"
        Owner
        Due_Date as "Due Date"
        Status
    )
    sort by
    (
        Priority ascending
        Due_Date ascending
    )
}
