list CEO_Actions_By_Status
{
    displayName = "CEO Actions by Status"
    show all rows from CEO_Action_Box
    (
        Status
        Priority
        Department
        Issue_Decision_Required as "Issue / Decision Required"
        Owner
        Due_Date as "Due Date"
    )
    group by
    (
        Status ascending
    )
    sort by
    (
        Priority ascending
    )
}
