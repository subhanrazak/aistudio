<page linkname = "CEO_Dashboard" displayname = "CEO Dashboard"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='kpi_cards' elementName='KPI_Cards'>
          <![CDATA[htmlpage kpi_cards()
             content
             <%{%>
                 <file name:KPI_Cards.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='100%'>
        <dsp id='financial_summary' elementName='Financial_Summary'>
          <![CDATA[htmlpage financial_summary()
             content
             <%{%>
                 <file name:Financial_Summary.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
    </row>
    <row>
      <column width='35%'>
        <dsp id='rag_status' elementName='RAG_Status'>
          <![CDATA[htmlpage rag_status()
             content
             <%{%>
                 <file name:RAG_Status.dshtml/>
             <%}%>
         ]]>
        </dsp>
      </column>
      <column width='65%'>
        <file name:Open_Actions.ds/>
      </column>
    </row>
  </layout>
</zml>
</content>
