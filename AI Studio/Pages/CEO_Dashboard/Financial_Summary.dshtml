<%
    totalRevenue = Academy_PL.sum(Total_Revenue);
    totalCost = Academy_PL.sum(Total_Cost);
    netSurplusDeficit = Academy_PL.sum(Net_Surplus_Deficit);
    totalFundingGap = Academy_PL.sum(Funding_Gap);

    surplusClass = "success";
    if(netSurplusDeficit < 0)
    {
        surplusClass = "danger";
    }
%>
<style>
.fin-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 8px 0 16px;
}
.fin-card {
    flex: 1 1 180px;
    background: #fff;
    border-radius: 10px;
    padding: 20px 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border-left: 4px solid #3b82f6;
    min-width: 160px;
}
.fin-card.danger  { border-left-color: #CC0000; }
.fin-card.success { border-left-color: #16AD78; }
.fin-card.warning { border-left-color: #e07b00; }
.fin-label {
    font-size: 12px;
    color: #6b7280;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
}
.fin-value {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
}
.fin-currency {
    font-size: 14px;
    color: #9ca3af;
    font-weight: 500;
    margin-bottom: 4px;
}
</style>
<div class="fin-grid">
    <div class="fin-card">
        <div class="fin-currency">INR</div>
        <div class="fin-label">Total Revenue</div>
        <div class="fin-value"><%= totalRevenue %></div>
    </div>
    <div class="fin-card warning">
        <div class="fin-currency">INR</div>
        <div class="fin-label">Total Cost</div>
        <div class="fin-value"><%= totalCost %></div>
    </div>
    <div class="fin-card <%= surplusClass %>">
        <div class="fin-currency">INR</div>
        <div class="fin-label">Net Surplus / Deficit</div>
        <div class="fin-value"><%= netSurplusDeficit %></div>
    </div>
    <div class="fin-card danger">
        <div class="fin-currency">INR</div>
        <div class="fin-label">Total Funding Gap</div>
        <div class="fin-value"><%= totalFundingGap %></div>
    </div>
</div>
