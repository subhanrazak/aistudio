<%
    centreGreen = Centre_Master[RAG == "Green"].count();
    centreAmber = Centre_Master[RAG == "Amber"].count();
    centreRed = Centre_Master[RAG == "Red"].count();

    batchGreen = Batch_Operations[Risk_Flag == "Green"].count();
    batchAmber = Batch_Operations[Risk_Flag == "Amber"].count();
    batchRed = Batch_Operations[Risk_Flag == "Red"].count();
%>
<style>
.rag-section {
    background: #fff;
    border-radius: 10px;
    padding: 20px 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    margin-bottom: 8px;
}
.rag-section-title {
    font-size: 13px;
    font-weight: 700;
    color: #374151;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.rag-row {
    display: flex;
    gap: 12px;
    align-items: center;
}
.rag-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    min-width: 80px;
    justify-content: center;
}
.rag-green { background: #D4EDDA; color: #155724; }
.rag-amber { background: #FFF3CD; color: #856404; }
.rag-red   { background: #FFE0E0; color: #CC0000; }
.rag-count { font-size: 20px; font-weight: 800; }
.rag-label { font-size: 11px; font-weight: 600; }
.rag-divider { height: 1px; background: #f3f4f6; margin: 16px 0; }
</style>
<div class="rag-section">
    <div class="rag-section-title">Centre RAG Status</div>
    <div class="rag-row">
        <div class="rag-badge rag-green">
            <i class="zc-li-solid ui-1-check-circle-08" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= centreGreen %></div>
                <div class="rag-label">Green</div>
            </div>
        </div>
        <div class="rag-badge rag-amber">
            <i class="zc-li-outline ui-1-alert-circle" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= centreAmber %></div>
                <div class="rag-label">Amber</div>
            </div>
        </div>
        <div class="rag-badge rag-red">
            <i class="zc-li-solid ui-1-alert-circle" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= centreRed %></div>
                <div class="rag-label">Red</div>
            </div>
        </div>
    </div>
    <div class="rag-divider"></div>
    <div class="rag-section-title">Batch Risk Flags</div>
    <div class="rag-row">
        <div class="rag-badge rag-green">
            <i class="zc-li-solid ui-1-check-circle-08" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= batchGreen %></div>
                <div class="rag-label">Green</div>
            </div>
        </div>
        <div class="rag-badge rag-amber">
            <i class="zc-li-outline ui-1-alert-circle" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= batchAmber %></div>
                <div class="rag-label">Amber</div>
            </div>
        </div>
        <div class="rag-badge rag-red">
            <i class="zc-li-solid ui-1-alert-circle" style="font-size:16px;"></i>
            <div>
                <div class="rag-count"><%= batchRed %></div>
                <div class="rag-label">Red</div>
            </div>
        </div>
    </div>
</div>
