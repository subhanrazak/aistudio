<%
    totalAcademies = Centre_Master.count();
    activeAcademies = Centre_Master[Current_Status == "Active"].count();
    activeBatches = Batch_Operations[Batch_Stage == "Active"].count();
    unfundedBatches = Batch_Operations[Funding_Confirmed == "No" || Funding_Confirmed == "To Confirm"].count();
%>
<style>
.kpi-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 0;
}
.kpi-card {
    flex: 1 1 180px;
    background: #fff;
    border-radius: 10px;
    padding: 20px 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border-left: 4px solid #1a6b5a;
    min-width: 160px;
}
.kpi-card.warning { border-left-color: #e07b00; }
.kpi-card.danger  { border-left-color: #CC0000; }
.kpi-card.success { border-left-color: #16AD78; }
.kpi-label {
    font-size: 12px;
    color: #6b7280;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
}
.kpi-value {
    font-size: 32px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
}
.kpi-icon {
    font-size: 20px;
    margin-bottom: 8px;
}
</style>
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-label">Total Academies</div>
        <div class="kpi-value"><%= totalAcademies %></div>
    </div>
    <div class="kpi-card success">
        <div class="kpi-label">Active Academies</div>
        <div class="kpi-value"><%= activeAcademies %></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Active Batches</div>
        <div class="kpi-value"><%= activeBatches %></div>
    </div>
    <div class="kpi-card warning">
        <div class="kpi-label">Unfunded / TBD Batches</div>
        <div class="kpi-value"><%= unfundedBatches %></div>
    </div>
</div>
