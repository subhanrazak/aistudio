map Styles.Color_Codes()
{

                 	color_map = Map();
                 	color_map.put("zc-cis-white","#FFFFFF");
                 	color_map.put("zc-cis-bg-color","rgb(18 19 43 / 5%)");
                 	color_map.put("zc-cis-border-color","#EBEFEF");
                 	color_map.put("zc-cis-primary-text-color","#222326");
                 	color_map.put("zc-cis-secondary-text-color","#7a8481");
                 	color_map.put("zc-cis-box-shadow","0 2px 9px 0 #d8d8d880");
                 	color_map.put("zc-cis-more-option-hover-bg","#EAECF0");
                 	// 	Table colors
                 	color_map.put("zc-cis-table-header-bg","#F9FAFE");
                 	color_map.put("zc-cis-table-header-text-color","#3E4650");
                 	color_map.put("zc-cis-table-list-hover","#F9FAFE");
                 	// 	tooptip colors
                 	color_map.put("zc-cis-tooltip-bg","#0C1621");
                 	// Banner colors
                 	color_map.put("zc-cis-banner-bg","#F0F5FF");
                 	// 	(Conditional formate, Delete, Active, Inactive)
                 	color_map.put("zc-cis-red","#FE455D");
                 	color_map.put("zc-cis-bg_red","#FDE3E6");
                 	color_map.put("zc-cis-green","#179E6C");
                 	color_map.put("zc-cis-bg_green","#E4FCF3");
                 	// More Options
                 	color_map.put("zc-cis-more-icon-hover","#EAECF0");
                 	color_map.put("zc-cis-more-option-red-txt","#E71F43");
                 	color_map.put("zc-cis-more-option-red-bg","#E71F431A");
                 	// 	Star Colors
                 	color_map.put("zc-cis-star-color","#FDCC0D");
                 	return color_map;
                 
}