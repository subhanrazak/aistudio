string Styles_Popup.Notes_Field()
{

                 	color_codes = thisapp.Styles.Color_Codes();
                 	override_style = ".form-group .zc-subform-header { display: none; } .zcpopup.compact .form-outer-wrapper form.form-table,.form-group.zc-addnote-fld { width:100%;min-width: 100%; }.zcpopup.compact .popupbox-wrapper .popupbox .popupboxOuter .popupConentContainer .form-outer-wrapper { padding: 0px; } .zcpopup.compact .popupbox-wrapper .popupbox .zc-form-fullheight .row form .formContainer { max-height: calc(90vh - 142px); overflow: auto; }";
                 	common_style = ".zc-cis-notes-field>*:not(:last-child) { margin-bottom: 25px; } .zc-cis-field-group>*:not(:first-child) { margin-top: 16px; } .zc-cis-notes-field .zc-cis-bold-txt { font-weight: 600; }";
                 	label_style = ".zc-cis-field-group .zc-cis-label .zc-cis-label-txt { font-size: 14px; font-weight: 400; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-cis-primary-text-color") + "; text-align: left; display: block; } .zc-cis-field-group .zc-cis-label.zc-cis-label-with-count .zc-cis-label-txt { padding: 2px 0px; } .zc-cis-field-group .zc-cis-count { padding: 0px 8px; margin: 0px 8px; background-color: " + color_codes.get("zc-cis-table-header-bg") + "; border-radius: 4px; font-size: 14px; font-weight: 400; line-height: 25px; letter-spacing: 0.1px; color: " + color_codes.get("zc-cis-primary-text-color") + "; text-align: center; } .zc-cis-field-group .zc-cis-label .zc-cis-value-txt { font-size: 14px; font-weight: 600; line-height: 1.5; letter-spacing: 0.1px; color: " + color_codes.get("zc-cis-secondary-text-color") + "; text-align: left; display: block; margin: 0px 6px; }";
                 	banner_style = ".zc-cis-notes-field .zc-cis-banner.zc-cis-banner-with-border { padding: 8px 16px; }";
                 	list_style = ".zc-cis-list-wrapper ul { font-size: 0px; padding: 0px; margin: 0px; } .zc-cis-field-group .zc-cis-list-wrapper { margin-top: 6px; }";
                 	rtl_txt = ".zc-rtl-wrapper .zc-cis-field-group .zc-cis-label .zc-cis-label-txt, .zc-rtl-wrapper .zc-cis-field-group .zc-cis-label .zc-cis-value-txt { text-align: right; }";
                 	style_txt = "<style>" + override_style + common_style + label_style + thisapp.Styles.Note_Text() + banner_style + list_style + thisapp.Styles_Popup.Key_Value_View() + rtl_txt + "</style>";
                 	return style_txt;
                 
}