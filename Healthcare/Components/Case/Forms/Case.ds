form Case
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Patient
			(
				type = picklist	
				values  = Patient.ID
    			bidirectional = Cases
    			displayformat = [Patient_ID + " - " + Patient_Name.first_name + Patient_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case_Type
			(
				type = picklist
				displayname = "Case Type"
				maxchar = 100
				values = {"Inpatient","Outpatient","Emergency","Day-Surgery"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Admission_Date
			(
    			type = date
				displayname = "Admission Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Discharge_Date
			(
    			type = date
				displayname = "Discharge Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Attending_Physician
			(
    			type = text
				displayname = "Attending Physician"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case_Status
			(
				type = picklist
				displayname = "Case Status"
				maxchar = 100
				values = {"Open","Discharged","Billed","Closed"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			unique Case_ID
			(
    			type = text
				displayname = "Case ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}