Validation_Script_on_Dele5 as "Validation Script on Delete"
{

				type =  form
				form = Case

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											disputeRecCount = Dispute_Intake[Case == input.ID].count();
										if(disputeRecCount > 0)
										{
											alert disputeRecCount + " dispute record(s) are linked to this case.";
											cancel delete;
										}
										delete from Charge[Case == input.ID];
						)
					}
				}

			
}