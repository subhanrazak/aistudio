Field_Script_Permission_S as "Field Script - Permission Set"
{

				type =  form
				form = Role

				record event = on add or edit

				on user input of Permission_Set
				{
					actions 
					{
						custom deluge script
						(
											if(Permission_Set == "Approver" || Permission_Set == "Investigator")
										{
											show Approval_Limit_From;
											show Approval_Limit_To;
										}
										else
										{
											hide Approval_Limit_From;
											hide Approval_Limit_To;
											input.Approval_Limit_From = "";
											input.Approval_Limit_To = "";
										}
						)
					}
				}

			
}