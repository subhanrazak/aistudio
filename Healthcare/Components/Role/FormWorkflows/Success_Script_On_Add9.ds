Success_Script_On_Add9 as "Success Script On Add"
{

				type =  form
				form = Role

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Permission_Set.equalsIgnoreCase("Administrator"))
										{
											for each  eachDispute in Dispute_Intake[ID != null]
											{
												adminRoleList = List();
												adminRoleList = eachDispute.Admin_Role;
												adminRoleList.add(input.ID);
												eachDispute.Admin_Role=adminRoleList;
											}
										}
						)
					}
				}

			
}