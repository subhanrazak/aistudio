default list Roles
{

			displayName = "Roles"
			show all rows from Role  [Is_Deleted == false]  
			(
				Role
				Permission_Set as "Permission Set"
				Approval_Limit_From as "Approval Limit From"
				Approval_Limit_To as "Approval Limit To"
			)
			group by
			(
				Permission_Set ascending
			)
			custom actions
			(
				"Delete Role"
				(
	  			workflow = Delete_Role_Roles
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "Are you sure you want to delete this role?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}