Field_Rules3 as "Field Rules"
{

				type =  form
				form = Investigation_Resolution_Resubmit

				record event = on add

				field rules
				{
					actions 
					{
						hide Investigation_Resolution,Patient_Contact_Date,Patient_Contact_Summary;
						disable Dispute;
					}
					actions  (Patient_Contacted == "Yes")
					{
						show Patient_Contact_Date,Patient_Contact_Summary;
					}
				}

			
}