Load_Script3 as "Load Script"
{

				type =  form
				form = Investigation_Resolution_Resubmit

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Investigation_Resolution != null)
										{
											resolutionRec = Investigation_Resolution[ID == input.Investigation_Resolution];
											input.Dispute = resolutionRec.Dispute;
											input.Findings = resolutionRec.Findings;
											input.Charge_Verified = resolutionRec.Charge_Verified;
											input.Internal_Notes = resolutionRec.Internal_Notes;
											input.Patient_Contacted = resolutionRec.Patient_Contacted;
											if(resolutionRec.Patient_Contacted.endsWithIgnoreCase("Yes"))
											{
												input.Patient_Contact_Date = resolutionRec.Patient_Contact_Date;
												input.Patient_Contact_Summary = resolutionRec.Patient_Contact_Summary;
											}
											input.Resolution_Type = resolutionRec.Resolution_Type;
											input.Adjustment_Amount = resolutionRec.Adjustment_Amount;
											input.Resolution_Rationale = resolutionRec.Resolution_Rationale;
											input.Root_Cause = resolutionRec.Root_Cause;
											input.Root_Cause_Detail = resolutionRec.Root_Cause_Detail;
										}
						)
					}
				}

			
}