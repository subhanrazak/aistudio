Success_Script3 as "Success Script"
{

				type =  form
				form = Investigation_Resolution_Resubmit
				button = Resubmit
				on click
				{
					actions 
					{
					on click
					(
						if(input.Adjustment_Amount < 0)
										{
											alert "Please enter a valid Adjustment Amount.";
										}
										else
										{
											if(input.Patient_Contacted == "No")
											{
												input.Patient_Contact_Date = null;
												input.Patient_Contact_Summary = "";
											}
											update Investigation_Resolution[ID == input.Investigation_Resolution]
											[
												Resubmitted_After_Rework=true
												Findings=input.Findings
												Charge_Verified=input.Charge_Verified
												Internal_Notes=input.Internal_Notes
												Patient_Contacted=input.Patient_Contacted
												Patient_Contact_Date=input.Patient_Contact_Date
												Patient_Contact_Summary=input.Patient_Contact_Summary
												Resolution_Type=input.Resolution_Type
												Adjustment_Amount=input.Adjustment_Amount
												Resolution_Rationale=input.Resolution_Rationale
												Root_Cause=input.Root_Cause
												Root_Cause_Detail=input.Root_Cause_Detail
											];
										}
					)
					}
				}
			
}