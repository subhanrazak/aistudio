form Investigation_Resolution_Resubmit
{

			displayname = "Investigation Resolution"
			store data in zc = false
			success message = "Data Added Successfully!"
			Investigation_Notes
			(
				type = section
				displayname = "Investigation Notes"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Investigation_Resolution
			(
				type = picklist	
				displayname = "Investigation Resolution"
				values  = Investigation_Resolution.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Dispute
			(
				type = picklist	
				values  = Dispute_Intake.ID
    			displayformat = [Dispute_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Findings
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Charge_Verified
			(
				type = picklist
				displayname = "Charge Verified"
				maxchar = 100
				values = {"Charge Confirmed Correct","Charge Error Identified","Partially Verified","Unable to Verify","Requires Additional Documentation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internal_Notes
			(
    			type = textarea
				displayname = "Internal Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Contacted
			(
				type = radiobuttons
				displayname = "Patient Contacted"
				maxchar = 100
				values = {"Yes","No"}
				initial value = "No"
				layout = 2
	 			row = 1
	 			column = 2   
				width = medium
			)
			Patient_Contact_Date
			(
    			type = date
				displayname = "Patient Contact Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Patient_Contact_Summary
			(
    			type = textarea
				displayname = "Patient Contact Summary"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Resolution_Decision
			(
				type = section
				displayname = "Resolution Decision"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Resolution_Type
			(
				type = picklist
				displayname = "Resolution Type"
				maxchar = 100
				values = {"Full Adjustment","Partial Adjustment","Denied","Payment Plan","Write-Off"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Adjustment_Amount
			(
				displayname = "Adjustment Amount"
				type = INR
				format = commadotindian
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Resolution_Rationale
			(
    			type = textarea
				displayname = "Resolution Rationale"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Root_Cause
			(
				type = picklist	
				displayname = "Root Cause"
				values  = Root_Cause.ID
    			displayformat = [Root_Cause]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Root_Cause_Detail
			(
    			type = textarea
				displayname = "Root Cause Detail"
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				Resubmit
				(
   					type = submit
   					displayname = "Resubmit"
				)
			}
		
}