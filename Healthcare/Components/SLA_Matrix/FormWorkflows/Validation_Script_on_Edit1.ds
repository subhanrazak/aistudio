Validation_Script_on_Edit1 as "Validation Script on Edit"
{

				type =  form
				form = SLA_Matrix

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											isErrorOccurred = false;
										if(SLA_Matrix[Priority == input.Priority && ID != input.ID].count() > 0)
										{
											isErrorOccurred = true;
											alert(Priority,"This priority has already been added");
										}
										if(input.Investigation_and_Resolution_SLA_days <= 0)
										{
											isErrorOccurred = true;
											alert(Investigation_and_Resolution_SLA_days,"Day value must be greater than 0.");
										}
										if(input.Resolution_Approval_SLA_days <= 0)
										{
											isErrorOccurred = true;
											alert(Resolution_Approval_SLA_days,"Day value must be greater than 0.");
										}
										if(isErrorOccurred)
										{
											cancel submit;
										}
						)
					}
				}

			
}