Validation_Script_on_Dele2 as "Validation Script on Delete"
{

				type =  form
				form = SLA_Matrix

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											categoryRecCount = Dispute_Category[Priority == input.ID].count();
										if(categoryRecCount > 0)
										{
											alert categoryRecCount + " record(s) are linked to this SLA Matrix. Before deleting this SLA Matrix, kindly ensure that the associated Dispute Category(s) are updated.";
											cancel delete;
										}
						)
					}
				}

			
}