form Insurance_Payer
{

			displayname = "Insurance Payer"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Payer_Name
			(
    			type = text
				displayname = "Payer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Coverage_Type
			(
				type = picklist
				displayname = "Coverage Type"
				maxchar = 100
				values = {"Commercial","Medicare","Medicaid","Self-Pay"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Plan_Group
			(
    			type = text
				displayname = "Plan / Group"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contract_Terms
			(
    			type = textarea
				displayname = "Contract Terms"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			unique Payer_ID
			(
    			type = text
				displayname = "Payer ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}