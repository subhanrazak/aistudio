Success_Script_On_Add1 as "Success Script On Add"
{

				type =  form
				form = Insurance_Payer

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.Payer_ID = idConfig.Insurance_Payer_ID + " " + input.Auto_Number;
						)
					}
				}

			
}