Field_Rules_On_Always9 as "Field Rules On Always"
{

				type =  form
				form = Communication_Log

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden,Mark_Dispute_as_Closed,Follow_Up_Date;
					}
					actions  (Follow_Up_Required == true)
					{
						show Follow_Up_Date;
					}
				}

			
}