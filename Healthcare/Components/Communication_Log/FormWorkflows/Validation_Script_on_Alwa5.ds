Validation_Script_on_Alwa5 as "Validation Script on Always"
{

				type =  form
				form = Communication_Log

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											isErrorOccurred = false;
										if(Time > zoho.currenttime)
										{
											isErrorOccurred = true;
											alert(Time,"Date cannot be in the future.");
										}
										if(Time < input.Dispute.Added_Time)
										{
											isErrorOccurred = true;
											alert(Time,"Date must be on or after the dispute creation date.");
										}
										if(isErrorOccurred)
										{
											cancel submit;
										}
						)
					}
				}

			
}