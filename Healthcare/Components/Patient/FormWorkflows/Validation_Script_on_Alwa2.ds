Validation_Script_on_Alwa2 as "Validation Script on Always"
{

				type =  form
				form = Patient

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											isErrorOccurred = false;
										if(Date_of_Birth > zoho.currentdate)
										{
											isErrorOccurred = true;
											alert(Date_of_Birth,"Birth Date cannot be in the future.");
										}
										if(Insurance_Payer != null && Policy_Number == null)
										{
											isErrorOccurred = true;
											alert(Policy_Number,"Policy Number is required.");
										}
										if(isErrorOccurred)
										{
											cancel submit;
										}
						)
					}
				}

			
}