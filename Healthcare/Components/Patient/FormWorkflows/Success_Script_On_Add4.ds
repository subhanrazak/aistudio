Success_Script_On_Add4 as "Success Script On Add"
{

				type =  form
				form = Patient

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.Patient_ID = idConfig.Patient_ID + " " + input.Auto_Number;
						)
					}
				}

			
}