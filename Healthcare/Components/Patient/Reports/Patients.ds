default list Patients
{

			displayName = "Patients"
			show all rows from Patient    
			(
				Date_of_Birth as "Date of Birth"
				Gender
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Email
				Insurance_Payer as "Insurance Payer"
				Policy_Number as "Policy Number"
				Patient_ID as "Patient ID"
				Patient_Name  as "Patient Name"
			)
			custom actions
			(
				"Grant Dispute Agent"
				(
	  			workflow = Grant_Dispute_Agent_Patie
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "Are you sure you want to grant dispute agent access?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				"Revoke Dispute Agent"
				(
	  			workflow = Revoke_Dispute_Agent_Pati
				show action in view header = true
				show action in edit record menu = true
				condition = (Dispute_agent_access_granted == true)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to revoke dispute agent access?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}