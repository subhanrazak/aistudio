Load_Script2 as "Load Script"
{

				type =  form
				form = Confirmation

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Action_field == "Approve")
										{
											input.Confirmation_Text = "Are you sure you want to approve this resolution decision";
										}
										else if(Action_field == "Reject")
										{
											input.Confirmation_Text = "Are you sure you want to reject this resolution decision?";
										}
										else
										{
											//Return_for_Rework
											input.Confirmation_Text = "Are you sure you want to return this resolution decision for rework?";
										}
						)
					}
				}

			
}