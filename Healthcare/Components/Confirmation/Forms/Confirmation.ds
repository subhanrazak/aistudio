form Confirmation
{

			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Confirmation_Text
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			Investigation_Resolution
			(
				type = picklist	
				displayname = "Investigation Resolution"
				values  = Investigation_Resolution.ID
    			displayformat = [Resolution_ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Action_field
			(
				type = picklist
				displayname = "Action"
				maxchar = 100
				values = {"Approve","Reject","Return_for_Rework"}
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}