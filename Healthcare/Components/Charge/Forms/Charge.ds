form Charge
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Case
			(
				type = picklist	
				values  = Case.ID
    			displayformat = [Case_ID + " - " + Admission_Date]
				advanced field search = true
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Service_Date
			(
    			type = date
				displayname = "Service Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Service_Description
			(
    			type = text
				displayname = "Service Description"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CPT_Procedure_Code
			(
    			type = text
				displayname = "CPT / Procedure Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Insurance_Paid
			(
				displayname = "Insurance Paid"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Paid
			(
				displayname = "Patient Paid"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Charge_Status
			(
				type = picklist
				displayname = "Charge Status"
				maxchar = 100
				values = {"Billed","Paid","Adjusted","Disputed"}
				initial value = "Billed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			unique Charge_ID
			(
    			type = text
				displayname = "Charge ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}