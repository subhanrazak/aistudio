list Investigation_Overdues
{

			displayName = "Overdues"
			show all rows from Dispute_Intake  [Closed_By_User.ID == thisapp.getLoginUserRecId() || Investigation_Resolution.Created_By == thisapp.getLoginUserRecId() || Investigation_Resolution.Approver == thisapp.getLoginUserRecId() || Admin_Role.ID == thisapp.getLoginUserRoleId() && Investigation_Due_Date > zoho.currentdate && Status == "Assigned" || Status == "Under Investigation" || Status == "Returned for Rework"]  
			(
				Patient
				Category
				Sub_Category as "Sub-Category"
				Dispute_Source as "Dispute Source"
				Disputed_Amount as "Disputed Amount"
				Reason_for_Dispute as "Reason for Dispute"
				Supporting_Documents as "Supporting Documents"
				Total_Billed_Amount as "Total Billed Amount"
				Insurance_Payer as "Insurance Payer"
				Assigned_To as "Assigned To"
				Created_By_User as "Created By User"
				Closed_By_User as "Closed By User"
				Status
				Dispute_ID as "Dispute ID"
				Auto_Number as "Auto Number"
				Approver
				Patient_Share as "Patient Share"
				Email
				Case
				Created_By_Type as "Created By Type"
				Investigation_Due_Date as "Investigation Due Date"
				Priority
				Ask_Zia as "Ask Zia"
				Zia_Classification_Status as "Zia Classification Status"
				Zia_Category as "Zia Category"
				Zia_Sub_Category as "Zia Sub-Category"
				Zia_Classification_Response as "Zia Classification Response"
				Accept_Zia_s_Suggestion as "Accept Zia's Suggestion"
				Investigation_Start_Time as "Investigation Start Time"
				Assigned_Role as "Assigned Role"
				Admin_Role as "Admin Role"
				Investigation_Resolution as "Investigation Resolution"
				AI_Dispute_Summary as "Dispute Summary"
				Patient.Added_Time as "Added Time"
			)
			conditional formatting
			(
				"Medium"
				{
				condition = (Priority == "Medium")
				fields = [Priority]
				format = "color:#ffc107;"
				}
				"Low"
				{
				condition = (Priority == "Low")
				fields = [Priority]
				format = "color:#4caf50;"
				}
				"Critical"
				{
				condition = (Priority == "Critical")
				fields = [Priority]
				format = "color:#f44336;"
				}
				"High"
				{
				condition = (Priority == "High")
				fields = [Priority]
				format = "color:#ff7043;"
				}
				"Unassigned"
				{
				condition = (Status == "Unassigned")
				fields = [Status]
				format = "color:#9e9e9e;background-color:#ffffff;"
				}
				"Assigned"
				{
				condition = (Status == "Assigned")
				fields = [Status]
				format = "color:#2196f3;"
				}
				"Under Investigation"
				{
				condition = (Status == "Under Investigation")
				fields = [Status]
				format = "color:#009688;"
				}
				"Pending Approval"
				{
				condition = (Status == "Pending Approval")
				fields = [Status]
				format = "color:#ffc107;"
				}
				"Approved"
				{
				condition = (Status == "Approved")
				fields = [Status]
				format = "color:#4caf50;"
				}
				"Rejected"
				{
				condition = (Status == "Rejected")
				fields = [Status]
				format = "color:#f44336;"
				}
				"Returned for Rework"
				{
				condition = (Status == "Returned for Rework")
				fields = [Status]
				format = "color:#ff7043;"
				}
				"Resolution Communicated"
				{
				condition = (Status == "Resolution Communicated")
				fields = [Status]
				format = "color:#7e57c2;"
				}
				"Closed"
				{
				condition = (Status == "Closed")
				fields = [Status]
				format = "color:#616161;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 2"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n\n		width = '100%'\n		hAlign = 'left'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n\n		hAlign = 'left'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '29'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Dispute_ID'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '15px'\n	marginTop = '8px'\n	padding = '0px'\n	color = '#522363'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'AI_Dispute_Summary'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '0px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '33%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Disputed_Amount'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '34%'\n		hAlign = 'center'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Category'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '0px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '33%'\n		hAlign = 'right'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Investigation_Due_Date'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		
}