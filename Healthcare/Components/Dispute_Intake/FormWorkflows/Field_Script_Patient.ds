Field_Script_Patient as "Field Script - Patient"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				on user input of Patient
				{
					actions 
					{
						custom deluge script
						(
											clear Case;
										if(input.Patient != null)
										{
											input.Patient_Name.first_name = input.Patient.Patient_Name.first_name;
											input.Patient_Name.last_name = input.Patient.Patient_Name.last_name;
											input.Insurance_Payer = input.Patient.Insurance_Payer;
											input.Case:ui.add(input.Patient.Cases);
										}
										else
										{
											input.Patient_Name.first_name = "";
											input.Patient_Name.last_name = "";
											input.Insurance_Payer = null;
											input.Total_Billed_Amount = null;
											input.Patient_Share = null;
										}
						)
					}
				}

			
}