Field_Script_Category1 as "Field Script - Category"
{

				type =  form
				form = Dispute_Intake

				record event = on edit

				on user input of Category
				{
					actions 
					{
						custom deluge script
						(
											if(input.Category != null)
										{
											currentSubCategory = input.Sub_Category;
											clear Sub_Category;
											input.Sub_Category:ui.add(input.Category.Sub_Category);
											input.Sub_Category = currentSubCategory;
										}
										else
										{
											clear Sub_Category;
										}
						)
					}
				}

			
}