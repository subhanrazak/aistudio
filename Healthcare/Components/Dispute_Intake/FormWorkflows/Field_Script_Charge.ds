Field_Script_Charge as "Field Script - Charge"
{

				type =  form
				form = Dispute_Intake

				record event = on add or edit

				on user input of Disputed_Charge_Line.Charge
				{
					actions 
					{
						custom deluge script
						(
											if(row.Charge != null)
										{
											row.CPT_Code=row.Charge.CPT_Procedure_Code;
											row.Billed_Line_Amount=row.Charge.Amount;
										}
										else
										{
											row.CPT_Code="";
											row.Billed_Line_Amount=null;
										}
						)
					}
				}

			
}