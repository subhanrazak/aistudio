Delete_Row_Disputed_Charg as "Delete Row - Disputed Charge Line"
{

				type =  form
				form = Dispute_Intake

				record event = on edit

				on delete row of Disputed_Charge_Line
				{
					actions 
					{
						custom deluge script
						(
											if(row.Charge != null)
										{
											chargeRec = Charge[ID == row.Charge];
											if(chargeRec.Charge_Status == "Disputed")
											{
												chargeRec.Charge_Status="Paid";
											}
										}
						)
					}
				}

			
}