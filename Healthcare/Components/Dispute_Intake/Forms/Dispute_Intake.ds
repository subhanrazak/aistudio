form Dispute_Intake
{

			displayname = "Dispute Intake"
			success message = "Data Added Successfully!"
			Case_Information
			(
				type = section
				displayname = "Case Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Patient
			(
				type = picklist	
				values  = Patient.ID
    			displayformat = [Patient_ID + " - " + Patient_Name.first_name + Patient_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Name
			(
    			type = name
				displayname = "Patient Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Insurance_Payer
			(
				type = picklist	
				displayname = "Insurance Payer"
				values  = Insurance_Payer.ID
    			displayformat = [Payer_ID + " - " + Payer_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Case
			(
				type = picklist	
				values  = Case.ID
    			displayformat = [Case_ID + " - " + Admission_Date]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Total_Billed_Amount
			(
				displayname = "Total Billed Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			Patient_Share
			(
				displayname = "Patient Share"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 2   
				width = medium
			)
			Dispute_Details
			(
				type = section
				displayname = "Dispute Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Disputed_Amount
			(
				displayname = "Disputed Amount"
				type = INR
				format = commadotindian
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Reason_for_Dispute
			(
    			type = textarea
				displayname = "Reason for Dispute"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Dispute_Source
			(
				type = picklist
				displayname = "Dispute Source"
				maxchar = 100
				values = {"Patient Call","Patient Letter","Email","Patient Portal","Internal Audit","Chat Agent"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Supporting_Documents
			(
    			type = upload file
				displayname = "Supporting Documents"
    			file count = 10
				browse = local_drive
	 			row = 2
	 			column = 2   
				width = medium
			)
			Classification
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Ask_Zia
			(
    			type = checkbox
				displayname = "Ask Zia"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Zia_Result
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 3
	 			column = 1   
				width = medium
			)
			Accept_Zia_s_Suggestion
			(
    			type = checkbox
				displayname = "Accept Zia's Suggestion"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Zia_Classification_Response
			(
    			type = textarea
				displayname = "Zia Classification Response"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Zia_Category
			(
    			type = text
				displayname = "Zia Category"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Zia_Sub_Category
			(
    			type = text
				displayname = "Zia Sub-Category"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Zia_Classification_Status
			(
    			type = text
				displayname = "Zia Classification Status"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Dispute_Category.ID
    			displayformat = [Category]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Sub_Category
			(
				type = picklist	
				displayname = "Sub-Category"
				values  = Dispute_Subcategory.ID
    			displayformat = [Sub_Category]
				sortorder = ascending
	 			row = 4
	 			column = 2   
				width = medium
			)
			must have Disputed_Charge_Line
			(
				type = grid
				displayname = "Disputed Charge Line"
				values  = Disputed_Charge_Line.ID
    			bidirectional = Dispute
	 			row = 5
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
	 			row = 6
	 			column = 0   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"Critical","High","Medium","Low"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			Investigation_Due_Date
			(
    			type = date
				displayname = "Investigation Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Investigation_Start_Time
			(
    			type = datetime
				displayname = "Investigation Start Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Assigned_Role
			(
				type = picklist	
				displayname = "Assigned Role"
				values  = Role.ID
    			displayformat = [Role]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Assigned_To
			(
				type = picklist	
				displayname = "Assigned To"
				values  = User[Is_Deleted == false].ID
    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Admin_Role
			(
				type = list	
				displayname = "Admin Role"
				values  = Role.ID
    			displayformat = [Role]
				sortorder = ascending
				height = 60px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Approver
			(
				type = picklist	
				values  = User[Is_Deleted == false].ID
    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_Type
			(
				type = picklist
				displayname = "Created By Type"
				maxchar = 100
				values = {"User","Patient"}
				initial value = "User"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Created_By_User
			(
				type = picklist	
				displayname = "Created By User"
				values  = User[Is_Deleted == false].ID
    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Closed_By_User
			(
				type = picklist	
				displayname = "Closed By User"
				values  = User[Is_Deleted == false].ID
    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Unassigned","Assigned","Under Investigation","Pending Approval","Approved","Rejected","Returned for Rework","Resolution Communicated","Closed"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			unique Dispute_ID
			(
    			type = text
				displayname = "Dispute ID"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 6
	 			column = 1   
				width = medium
			)
			Investigation_Resolution
			(
				type = picklist	
				displayname = "Investigation Resolution"
				values  = Investigation_Resolution.ID
    			bidirectional = Dispute
    			displayformat = [Resolution_ID]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			AI_Brief_Response
			(
    			type = textarea
				displayname = "AI Brief Response"
				height = 100px
	 			row = 6
	 			column = 1   
				width = medium
			)
			AI_Brief_Status
			(
    			type = text
				displayname = "AI Brief Status"
	 			row = 6
	 			column = 1   
				width = medium
			)
			AI_Dispute_Summary
			(
    			type = text
				displayname = "AI Dispute Summary"
	 			row = 6
	 			column = 1   
				width = medium
			)
			AI_Email_Draft_Response
			(
    			type = textarea
				displayname = "AI Email Draft Response"
				height = 100px
	 			row = 6
	 			column = 1   
				width = medium
			)
			AI_Email_Draft_Status
			(
    			type = text
				displayname = "AI Email Draft Status"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Communication_Log
			(
				type = grid
				displayname = "Communication Log"
				values  = Communication_Log.ID
    			bidirectional = Dispute
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Unassigned Dispute","Under Investigation","Pending Approval","Assigned Dispute","Approved Resolution","Rejected Resolution","Returned for Rework","Resolution Communicated","Closed","Reassigned"}
			}
		print template
			{
				Dispute_Record_Backup
				{
							displayname = "Dispute Record Backup"
