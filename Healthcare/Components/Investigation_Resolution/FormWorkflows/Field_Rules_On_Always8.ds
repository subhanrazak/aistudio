Field_Rules_On_Always8 as "Field Rules On Always"
{

				type =  form
				form = Investigation_Resolution

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden;
						hide Patient_Contact_Date,Patient_Contact_Summary;
					}
					actions  (Patient_Contacted == "Yes")
					{
						show Patient_Contact_Date,Patient_Contact_Summary;
					}
				}

			
}