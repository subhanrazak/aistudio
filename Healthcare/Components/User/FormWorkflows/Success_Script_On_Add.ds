Success_Script_On_Add as "Success Script On Add"
{

				type =  form
				form = User

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											idConfig = ID_Configuration[ID != 0];
										input.User_ID = idConfig.User_ID + " " + input.Auto_Number;
						)
					}
				}

			
}