default list Users
{

			displayName = "Users"
			show all rows from User  [Is_Deleted == false]  
			(
				Name 
				Email
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Role
				Reporting_To as "Reporting To"
				User_ID as "User ID"
			)
			custom actions
			(
				"Delete User"
				(
	  			workflow = Delete_User_Users
				show action in view header = true
				show action in edit record menu = true
				condition = (Email != zoho.adminuserid)
				confirmation before execution
				(
					message for individual record = "Are you sure you want to delete this user?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}