Load_Script_On_Always as "Load Script On Always"
{

				type =  form
				form = ID_Configuration

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.helpText = thisapp.Styles_Popup.Notes_Field() + "<div class='zc-cis-notes-field'> <div class='zc-cis-notes-wrapper'> <p><span> Samples:</span>  Dispute ID -, Resolution ID -, Patient ID -</p> </div> </div>";
						)
					}
				}

			
}