default summary ID_Configurations
{

			displayName = "ID Configurations"
			show all rows from ID_Configuration    
			(
				User_ID as "User ID"
				Patient_ID as "Patient ID"
				Case_ID as "Case ID"
				Insurance_Payer_ID as "Insurance Payer ID"
				Charge_ID as "Charge ID"
				Dispute_ID as "Dispute ID"
				Resolution_ID as "Resolution ID"
			)
			options
			(
				display rows = 10
				display records per row = 1
			)
		
}