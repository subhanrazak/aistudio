Load_Script as "Load Script"
{

				type =  form
				form = Alert_Message

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.plain = thisapp.Styles_Popup.Inactive_Popup() + "<div class='zc-asm-popup-content zc-asm-inactive-popup'> <div class='zc-asm-icon-wrapper'> <i class='zc-li-outline ui-1-circle-remove'></i> </div> <p>" + input.Popup_Message + "</p> </div>";
						)
					}
				}

			
}