			                 	return style_text;
			                 
			}

			map Styles.Color_Codes()
			{
			
			                 	color_map = Map();
			                 	color_map.put("zc-cis-white","#FFFFFF");
			                 	color_map.put("zc-cis-bg-color","rgb(18 19 43 / 5%)");
			                 	color_map.put("zc-cis-border-color","#EBEFEF");
			                 	color_map.put("zc-cis-primary-text-color","#222326");
			                 	color_map.put("zc-cis-secondary-text-color","#7a8481");
			                 	color_map.put("zc-cis-box-shadow","0 2px 9px 0 #d8d8d880");
			                 	color_map.put("zc-cis-more-option-hover-bg","#EAECF0");
			                 	// 	Table colors
			                 	color_map.put("zc-cis-table-header-bg","#F9FAFE");
			                 	color_map.put("zc-cis-table-header-text-color","#3E4650");
			                 	color_map.put("zc-cis-table-list-hover","#F9FAFE");
			                 	// 	tooptip colors
			                 	color_map.put("zc-cis-tooltip-bg","#0C1621");
			                 	// Banner colors
			                 	color_map.put("zc-cis-banner-bg","#F0F5FF");
			                 	// 	(Conditional formate, Delete, Active, Inactive)
			                 	color_map.put("zc-cis-red","#FE455D");
			                 	color_map.put("zc-cis-bg_red","#FDE3E6");
			                 	color_map.put("zc-cis-green","#179E6C");
			                 	color_map.put("zc-cis-bg_green","#E4FCF3");
			                 	// More Options
			                 	color_map.put("zc-cis-more-icon-hover","#EAECF0");
			                 	color_map.put("zc-cis-more-option-red-txt","#E71F43");
			                 	color_map.put("zc-cis-more-option-red-bg","#E71F431A");
			                 	// 	Star Colors
			                 	color_map.put("zc-cis-star-color","#FDCC0D");
			                 	return color_map;
			                 
			}

			string Styles_Popup.Inactive_Popup()
			{
			
			                 	color_codes = thisapp.Styles.Color_Codes();
			                 	common_style = thisapp.Styles_Popup.Popup();
			                 	override_style = "/* Btn styles */ .zc-footer-wrapper .form-action .zc-live-primary-btn { border: 1px solid " + color_codes.get("zc-asm-red") + "; background-color: " + color_codes.get("zc-asm-red") + "; color: " + color_codes.get("zc-asm-white") + " }";
			                 	popup_style = ".zc-asm-popup-content.zc-asm-inactive-popup .zc-asm-icon-wrapper { background-color: " + color_codes.get("zc-asm-bg_red") + "; color: " + color_codes.get("zc-asm-red") + ";}";
			                 	style_txt = "<style>" + common_style + override_style + popup_style + "</style>";
			                 	return style_txt;
			                 
			}

			void Insert_System_Data()
			{
			
			                 	configCount = ID_Configuration[ID != null].count();
			                 	if(configCount == 0)
			                 	{
			                 		insert into ID_Configuration
			                 		[
			                 			Added_User=zoho.loginuser
			                 			Case_ID="Case ID -"
			                 			Charge_ID="Charge ID -"
			                 			Dispute_ID="Dispute ID -"
			                 			Insurance_Payer_ID="Payer ID -"
			                 			Patient_ID="Patient ID -"
			                 			Resolution_ID="Resolution ID -"
			                 			User_ID="User ID -"
			                 		]
			                 	}
			                 	roleRec = Role[Role.equalsIgnoreCase("System Administrator")];
			                 	if(roleRec.count() == 0)
			                 	{
			                 		roleRecID = insert into Role
			                 		[
			                 			Added_User=zoho.loginuser
			                 			Permission_Set="Administrator"
			                 			Role="System Administrator"
			                 		];
			                 	}
			                 	else
			                 	{
			                 		roleRecID = roleRec.ID;
			                 	}
			                 	adminRecCount = User[Email == zoho.adminuserid].count();
			                 	if(adminRecCount == 0)
			                 	{
			                 		userRecID = insert into User
			                 		[
			                 			Name.first_name="Admin"
			                 			Name.last_name=zoho.adminuser
			                 			Email=zoho.adminuserid
			                 			Role=roleRecID
			                 			Added_User=zoho.adminuser
			                 		];
			                 		userRec = User[ID == userRecID];
			                 		userRec.User_ID="User ID -" + userRec.Auto_Number;
			                 	}
			                 
			}

			string Styles_Popup.Key_Value_View()
			{
			
			                 	color_codes = thisapp.Styles.Color_Codes();
			                 	style_txt = "/* Key Value */ .zc-asm-keyvalue-view table tbody tr td { font-size: 14px; line-height: 21px; letter-spacing: 0.1px; text-align: left; padding: 10px 10px 10px 0px; } .zc-asm-keyvalue-view table tbody tr td:nth-child(odd) { width: 175px; font-weight: 400; color: " + color_codes.get("zc-asm-secondary-text-color") + "; } .zc-asm-keyvalue-view table tbody tr td:nth-child(even) { font-weight: 500; color: " + color_codes.get("zc-asm-primary-text-color") + "; } .zc-asm-keyvalue-view table tbody tr td:nth-child(3) { width: 225px; padding-left: 50px; } /* With BG */ .zc-asm-keyvalue-view.zc-asm-with-bg { padding: 6px; background-color: #FBFCFF; border-radius: 8px; border: 1px solid" + color_codes.get("zc-asm-border-color") + "; } .zc-asm-keyvalue-view.zc-asm-with-bg table tbody tr td { padding: 10px; border-radius: 8px; } .zc-asm-keyvalue-view.zc-asm-with-bg table tbody tr td.zc-asm-blue { color: #2A6FFC; } .zc-asm-keyvalue-view.zc-asm-with-bg table tbody tr td.zc-asm-green { color: #179E6C; } .zc-asm-keyvalue-view.zc-asm-with-bg table tbody tr td.zc-asm-yellow { color: #A06309; }";
			                 	rtl_txt = ".zc-rtl-wrapper .zc-asm-keyvalue-view table tbody tr td { text-align: right; padding: 10px 0px 10px 10px; } .zc-rtl-wrapper .zc-asm-keyvalue-view table tbody tr td:nth-child(3) { padding-left: 10px; padding-right: 50px; }";
			                 	style_txt = style_txt + rtl_txt;
			                 	return style_txt;
			                 
			}

