			Validation_Script_on_Edit as "Validation Script on Edit"
			{
			
							type =  form
							form = ID_Configuration
			
							record event = on edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.User_ID != old.User_ID)
													{
														for each  eachUserRec in User[ID != null]
														{
															eachUserRec.User_ID=input.User_ID + " " + eachUserRec.Auto_Number;
														}
													}
													if(input.Patient_ID != old.Patient_ID)
													{
														for each  eachPatientRec in Patient[ID != null]
														{
															eachPatientRec.Patient_ID=input.Patient_ID + " " + eachPatientRec.Auto_Number;
														}
													}
													if(input.Case_ID != old.Case_ID)
													{
														for each  eachCaseRec in Case[ID != null]
														{
															eachCaseRec.Case_ID=input.Case_ID + " " + eachCaseRec.Auto_Number;
														}
													}
													if(input.Charge_ID != old.Charge_ID)
													{
														for each  eachChargeRec in Charge[ID != null]
														{
															eachChargeRec.Charge_ID=input.Charge_ID + " " + eachChargeRec.Auto_Number;
														}
													}
													if(input.Insurance_Payer_ID != old.Insurance_Payer_ID)
													{
														for each  eachInsuranceRec in Insurance_Payer[ID != null]
														{
															eachInsuranceRec.Payer_ID=input.Insurance_Payer_ID + " " + eachInsuranceRec.Auto_Number;
														}
													}
													if(input.Dispute_ID != old.Dispute_ID)
													{
														for each  eachDisputeRec in Dispute_Intake[ID != null]
														{
															eachDisputeRec.Dispute_ID=input.Dispute_ID + " " + eachDisputeRec.Auto_Number;
														}
													}
													if(input.Resolution_ID != old.Resolution_ID)
													{
														for each  eachResolutionRec in Investigation_Resolution[ID != null]
														{
															eachResolutionRec.Resolution_ID=input.Resolution_ID + " " + eachResolutionRec.Auto_Number;
														}
													}
									)
								}
							}
			
						
			}

