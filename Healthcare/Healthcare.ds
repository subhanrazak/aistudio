application "Healthcare"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Add_Organization
		{
		
					displayname = "Add Organization"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Organization_Name
					(
		    			type = text
						displayname = "Organization Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Logo
					(
		    			type = image
						source  = file
						aspect ratio = original
						camera = primary
						show gallery = true
						switch camera = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					unique Registration_License_No
					(
		    			type = text
						displayname = "Registration / License No"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Phone_Number
					(
		    			type = phonenumber
						displayname = "Phone"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have unique Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Address
					(
		    			type = address
		     			capture_coordinates = true
		     			adjust_using_map = false
		     			address_line_1
		     			(
			     			  type = address_line_1
			     			  displayname = "Address Line 1"
		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Address Line 2"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City / District"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Website_Address
					(
		    			type = url
						displayname = "Website Address"
						enable  linkname
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				properties
				{
					total entries
					{
						allowed count = 1
					}
				}
				
		}

		form Alert_Message
		{
		
					displayname = "Alert Message"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					plain
					(
		    			type = plaintext
						value = "Add your Note here ..."
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Popup_Message
					(
		    			type = text
						displayname = "Popup Message"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		}

		form Assign_Dispute
		{
		
					displayname = "Assign Dispute"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Assigned_To
					(
						type = picklist	
						displayname = "Assigned To"
						values  = User.ID
		    			displayformat = [" " + User_ID + " " + Name.first_name + " " + Name.last_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden
					(
						type = section
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					Dispute
					(
						type = picklist	
						values  = Dispute_Intake.ID
		    			displayformat = [Dispute_ID]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
					Investigation_Resolution
					(
						type = picklist	
						displayname = "Investigation Resolution"
						values  = Investigation_Resolution.ID
		    			displayformat = [ID]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
					Action_field
					(
						type = picklist
						displayname = "Action"
						maxchar = 100
						values = {"Assign_Dispute","Reassign"}
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		}

		form Case
		{
		
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Patient
					(
						type = picklist	
						values  = Patient.ID
		    			bidirectional = Cases
		    			displayformat = [Patient_ID + " - " + Patient_Name.first_name + Patient_Name.last_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Case_Type
					(
						type = picklist
						displayname = "Case Type"
						maxchar = 100
						values = {"Inpatient","Outpatient","Emergency","Day-Surgery"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Admission_Date
					(
		    			type = date
						displayname = "Admission Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Discharge_Date
					(
		    			type = date
						displayname = "Discharge Date"
						alloweddays = 0,1,2,3,4,5,6
