			Load_Script_On_Add2 as "Load Script On Add"
			{
			
							type =  form
							form = Communication_Log
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Dispute != null)
													{
														disable Dispute;
														loginUserRecId = thisapp.getLoginUserRecId();
														if(Dispute.Status.equalsIgnoreCase("Approved") || Dispute.Status.equalsIgnoreCase("Rejected") && (Dispute.Created_By_Type.equalsIgnoreCase("User") && input.Dispute.Created_By_User == loginUserRecId) || (Dispute.Created_By_Type.equalsIgnoreCase("Patient") && input.Dispute.Assigned_To == loginUserRecId) || input.Dispute.Admin_Role == thisapp.getLoginUserRoleId())
														{
															show Mark_Dispute_as_Closed;
														}
													}
									)
								}
							}
			
						
			}

			Success_Script_On_Add7 as "Success Script On Add"
			{
			
							type =  form
							form = Communication_Log
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														input.Logged_By = thisapp.getLoginUserRecId();
													if(Mark_Dispute_as_Closed)
													{
														thisapp.blueprint.changeStage("Dispute_Intake","Dispute_Resolution_Workfl","Closed",input.Dispute);
														update Dispute_Intake[ID == input.Dispute]
														[
															Status="Closed"
															Closed_By_User=input.Logged_By
														];
														resolutionRec = Investigation_Resolution[Dispute == input.Dispute];
														statusVal = "Paid";
														if(resolutionRec.Resolution_Type.equalsIgnoreCase("Full Adjustment") || resolutionRec.Resolution_Type.equalsIgnoreCase("Partial Adjustment"))
														{
															statusVal = "Adjusted";
														}
														for each  disputedChargeLineRec in Disputed_Charge_Line[Dispute == input.Dispute]
														{
															chargeRec = Charge[ID == disputedChargeLineRec.Charge];
															chargeRec.Charge_Status=statusVal;
														}
													}
									)
								}
							}
			
						
			}

			Validation_Script_on_Alwa5 as "Validation Script on Always"
			{
			
							type =  form
							form = Communication_Log
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														isErrorOccurred = false;
													if(Time > zoho.currenttime)
													{
														isErrorOccurred = true;
														alert(Time,"Date cannot be in the future.");
													}
													if(Time < input.Dispute.Added_Time)
													{
														isErrorOccurred = true;
														alert(Time,"Date must be on or after the dispute creation date.");
													}
													if(isErrorOccurred)
													{
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Validation_Script_on_Dele8 as "Validation Script on Delete"
			{
			
							type =  form
							form = Communication_Log
			
							record event = on delete
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(Dispute.Status.equalsIgnoreCase("Closed"))
													{
														alert "Communication logs cannot be deleted after the dispute is closed.";
														cancel delete;
													}
													else if(input.Added_User != zoho.loginuser || input.Dispute.Admin_Role != thisapp.getLoginUserRoleId())
													{
														alert "You don't have permission to delete this communication log.";
														cancel delete;
													}
									)
								}
							}
			
						
			}

