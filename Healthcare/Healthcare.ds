_color); } .zcs-color-primary { color: var(--zcs_primary_text_color); } .zcs-color-secondary { color: var(--zcs_secondary_text_color); } .zcs-color-tertiary { color: var(--zcs_tertiary_text_color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-black { color: var(--zcs-black-color); } .zcs-overflow-hidden { overflow: hidden; } .zcs-overflow-auto { overflow: auto; } .zcs-overflow-ellipsis { display: -webkit-box; -webkit-line-clamp: var(--zcs-line-clamp-count); -webkit-box-orient: vertical; overflow: hidden; } #splash-screen { display: none !important; }.zcs-card { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; } .zcs-list-none { list-style-type: none; } .zcs-overflow-auto { overflow: auto; } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #b8770d; } .zcs-color-d_green { color: #007943; } .zcs-color-blue { color: #09598E; } .zcs-color-l_blue { color: #1094C5; } .zcs-color-d_blue { color: #1328CD; } /* Divider Lines */ .zcs-line { width: 100%; height: 100%; border: 1px solid #EBEFEF; } .zcs-line-l { width: 1px; height: 100%; background-color: #EBEFEF; } .zcs-line-r { width: 1px; height: 100%; background-color: #EBEFEF; } .zcs-line-t { width: 100%; height: 1px; background-color: #EBEFEF; } .zcs-line-b { width: 100%; height: 1px; background-color: #EBEFEF; } .zcs-font-40 { font-size: 40px; }a { text-decoration: none; }";
