			Load_Script_On_Add3 as "Load Script On Add"
			{
			
							type =  form
							form = Resolution_Email
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														// input.Message = "<p>Dear James Carter,<\/p><p>We acknowledge your dispute regarding Balance Billing (Dispute ID - 8) and sincerely appreciate your patience and attention to this matter.<\/p><p>After a thorough review, we have determined that a partial adjustment is appropriate to address your concern.<\/p><p><b>Resolution:<\/b> A credit of $6,000.00 will be applied to your account, reducing the total balance.<\/p><p><b>Adjustment Details:<\/b> The original disputed amount of $8,000.00 will be adjusted by $6,000.00, leaving a remaining balance of $2,000.00.<\/p><p>We regret that an error in our billing process contributed to this situation and apologize for the inconvenience and frustration this has caused.<\/p><p>To move forward, we kindly ask that you confirm receipt of this resolution by replying to this email or contacting our billing team directly.<\/p><p>If you have any further questions or need clarification, please reach out to us at [Hospital Name] at [Contact Number] or via email at billing@hospitalname.org.<\/p><p>We value your trust and are committed to ensuring all billing processes are clear, fair, and respectful.<\/p><p>Thank you for your understanding and cooperation.<\/p>";
													if(Dispute_Intake != null)
													{
														input.Email = input.Dispute_Intake.Email;
														respData = input.Dispute_Intake.AI_Email_Draft_Response.toMap();
														input.Subject_field = respData.get("emailSubject");
														input.Message = respData.get("emailContent");
													}
									)
								}
							}
			
						
			}

