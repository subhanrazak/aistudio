					)
					Zia_Result
					(
		    			type = plaintext
						value = "Add your Note here ..."
			 			row = 3
			 			column = 1   
						width = medium
					)
					Accept_Zia_s_Suggestion
					(
		    			type = checkbox
						displayname = "Accept Zia's Suggestion"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					Zia_Classification_Response
					(
		    			type = textarea
						displayname = "Zia Classification Response"
						height = 100px
			 			row = 3
			 			column = 1   
						width = medium
					)
					Zia_Category
					(
		    			type = text
						displayname = "Zia Category"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Zia_Sub_Category
					(
		    			type = text
						displayname = "Zia Sub-Category"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Zia_Classification_Status
					(
		    			type = text
						displayname = "Zia Classification Status"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Section
					(
						type = section
			 			row = 4
			 			column = 0   
						width = medium
					)
					must have Category
					(
						type = picklist	
						values  = Dispute_Category.ID
		    			displayformat = [Category]
						sortorder = ascending
			 			row = 4
			 			column = 1   
						width = medium
					)
					must have Sub_Category
					(
						type = picklist	
						displayname = "Sub-Category"
						values  = Dispute_Subcategory.ID
		    			displayformat = [Sub_Category]
						sortorder = ascending
			 			row = 4
			 			column = 2   
						width = medium
					)
					must have Disputed_Charge_Line
					(
						type = grid
						displayname = "Disputed Charge Line"
						values  = Disputed_Charge_Line.ID
		    			bidirectional = Dispute
			 			row = 5
			 			column = 1   
						width = medium
					)
					Hidden
					(
						type = section
			 			row = 6
			 			column = 0   
						width = medium
					)
					Priority
					(
						type = picklist
						maxchar = 100
						values = {"Critical","High","Medium","Low"}
			 			row = 6
			 			column = 1   
						width = medium
					)
					Investigation_Due_Date
					(
		    			type = date
						displayname = "Investigation Due Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 6
			 			column = 1   
						width = medium
					)
					Investigation_Start_Time
					(
		    			type = datetime
						displayname = "Investigation Start Time"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 6
			 			column = 1   
						width = medium
					)
					Assigned_Role
					(
						type = picklist	
						displayname = "Assigned Role"
						values  = Role.ID
		    			displayformat = [Role]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					Assigned_To
					(
						type = picklist	
						displayname = "Assigned To"
						values  = User[Is_Deleted == false].ID
		    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					Admin_Role
					(
						type = list	
						displayname = "Admin Role"
						values  = Role.ID
		    			displayformat = [Role]
						sortorder = ascending
						height = 60px
			 			row = 6
			 			column = 1   
						width = medium
					)
					Approver
					(
						type = picklist	
						values  = User[Is_Deleted == false].ID
		    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					Created_By_Type
					(
						type = picklist
						displayname = "Created By Type"
						maxchar = 100
						values = {"User","Patient"}
						initial value = "User"
			 			row = 6
			 			column = 1   
						width = medium
					)
					Created_By_User
					(
						type = picklist	
						displayname = "Created By User"
						values  = User[Is_Deleted == false].ID
		    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					Closed_By_User
					(
						type = picklist	
						displayname = "Closed By User"
						values  = User[Is_Deleted == false].ID
		    			displayformat = [User_ID + " - " + Name.first_name + Name.last_name]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Unassigned","Assigned","Under Investigation","Pending Approval","Approved","Rejected","Returned for Rework","Resolution Communicated","Closed"}
			 			row = 6
			 			column = 1   
						width = medium
					)
					unique Dispute_ID
					(
		    			type = text
						displayname = "Dispute ID"
			 			row = 6
			 			column = 1   
						width = medium
					)
					Auto_Number
					(
		    			type = autonumber
						displayname = "Auto Number"
						start index = 1
			 			row = 6
			 			column = 1   
						width = medium
					)
					Investigation_Resolution
					(
						type = picklist	
						displayname = "Investigation Resolution"
						values  = Investigation_Resolution.ID
		    			bidirectional = Dispute
		    			displayformat = [Resolution_ID]
						sortorder = ascending
			 			row = 6
			 			column = 1   
						width = medium
					)
					AI_Brief_Response
					(
		    			type = textarea
						displayname = "AI Brief Response"
						height = 100px
			 			row = 6
			 			column = 1   
						width = medium
					)
					AI_Brief_Status
					(
		    			type = text
						displayname = "AI Brief Status"
			 			row = 6
			 			column = 1   
						width = medium
					)
					AI_Dispute_Summary
					(
		    			type = text
						displayname = "AI Dispute Summary"
			 			row = 6
			 			column = 1   
						width = medium
					)
					AI_Email_Draft_Response
					(
		    			type = textarea
						displayname = "AI Email Draft Response"
						height = 100px
			 			row = 6
			 			column = 1   
						width = medium
					)
					AI_Email_Draft_Status
					(
		    			type = text
						displayname = "AI Email Draft Status"
			 			row = 6
			 			column = 1   
						width = medium
					)
					Communication_Log
					(
						type = grid
						displayname = "Communication Log"
						values  = Communication_Log.ID
		    			bidirectional = Dispute
			 			row = 7
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
