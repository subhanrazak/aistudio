			 			column = 1   
						width = medium
					)
					Department
					(
		    			type = text
			 			row = 1
			 			column = 1   
						width = medium
					)
					Attending_Physician
					(
		    			type = text
						displayname = "Attending Physician"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Case_Status
					(
						type = picklist
						displayname = "Case Status"
						maxchar = 100
						values = {"Open","Discharged","Billed","Closed"}
						initial value = "Open"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden
					(
						type = section
			 			row = 2
			 			column = 0   
						width = medium
					)
					unique Case_ID
					(
		    			type = text
						displayname = "Case ID"
			 			row = 2
			 			column = 1   
						width = medium
					)
					Auto_Number
					(
		    			type = autonumber
						displayname = "Auto Number"
						start index = 1
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

