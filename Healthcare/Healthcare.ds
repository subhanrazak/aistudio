						Dispute_Source as "Dispute Source"
						Reason_for_Dispute as "Reason for Dispute"
						Supporting_Documents as "Supporting Documents"
						Sub_Category as "Sub-Category"
					)
					conditional formatting
					(
						"Unassigned"
						{
						condition = (Status == "Unassigned")
						fields = [Status]
						format = "color:#9e9e9e;background-color:#ffffff;"
						}
						"Assigned"
						{
						condition = (Status == "Assigned")
						fields = [Status]
						format = "color:#2196f3;"
						}
						"Under Investigation"
						{
						condition = (Status == "Under Investigation")
						fields = [Status]
						format = "color:#009688;"
						}
						"Pending Approval"
						{
						condition = (Status == "Pending Approval")
						fields = [Status]
						format = "color:#ffc107;"
						}
						"Approved"
						{
						condition = (Status == "Approved")
						fields = [Status]
						format = "color:#4caf50;"
						}
						"Rejected"
						{
						condition = (Status == "Rejected")
						fields = [Status]
						format = "color:#f44336;"
						}
						"Returned for Rework"
						{
						condition = (Status == "Returned for Rework")
						fields = [Status]
						format = "color:#ff7043;"
						}
						"Resolution Communicated"
						{
						condition = (Status == "Resolution Communicated")
						fields = [Status]
						format = "color:#7e57c2;"
						}
						"Closed"
						{
						condition = (Status == "Closed")
						fields = [Status]
						format = "color:#616161;"
						}
					)
					customlayouts
					(
						template
			 			(
			 	  			displayname="Custom Layout 1"
			 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n\n		width = '100%'\n		hAlign = 'left'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n\n		hAlign = 'left'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '27'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Dispute_ID'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '15px'\n	marginTop = '8px'\n	padding = '0px'\n	color = '#522363'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'AI_Dispute_Summary'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '0px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '33%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Disputed_Amount'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '10px'\n	pad