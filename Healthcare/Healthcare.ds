					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Root_Cause
					(
		    			type = text
						displayname = "Root Cause"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form SLA_Matrix
		{
		
					displayname = "SLA Matrix"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Priority
					(
						type = picklist
						maxchar = 100
						values = {"Critical","High","Medium","Low"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Investigation_and_Resolution_SLA_days
					(
						type = number
						displayname = "Investigation and Resolution SLA (days)"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Resolution_Approval_SLA_days
					(
						type = number
						displayname = "Resolution Approval SLA (days)"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Update_Patient_Email
		{
		
					displayname = "Update Patient Email"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Patient
					(
						type = picklist	
						values  = Patient.ID
		    			displayformat = [Patient_ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		}

		form User
		{
		
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Name
					(
		    			type = name
		     			prefix
		     			(
			     			 type = prefix
			     			 displayname ="Prefix"
			     			 visibility = false
			     			 value = {"Mr.","Mrs.","Ms."}
		     			) 
		     			first_name
		     			(
			     			 type = first_name
			     			 displayname ="First Name"
		     			) 
		     			last_name
		     			(
			     			 type = last_name
			     			 displayname ="Last Name"
		     			) 
		     			suffix
		     			(
			     			 type = suffix
			     			 displayname ="Suffix"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have unique Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Phone_Number
					(
		    			type = phonenumber
						displayname = "Phone"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Role
					(
						type = picklist	
						values  = Role[Is_Deleted == false].ID
		    			displayformat = [Role]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Reporting_To
					(
						type = picklist	
						displayname = "Reporting To"
						values  = User[Is_Deleted == false].ID
		    			displayformat = [" " + User_ID + " " + Name.first_name + " -" + Name.last_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Hidden
					(
						type = section
			 			row = 2
			 			column = 0   
						width = medium
					)
					unique User_ID
					(
		    			type = text
						displayname = "User ID"
			 			row = 2
			 			column = 1   
						width = medium
					)
					Auto_Number
					(
		    			type = autonumber
						displayname = "Auto Number"
						start index = 1
			 			row = 2
			 			column = 1   
						width = medium
					)
					Is_Deleted
					(
		    			type = checkbox
						initial value = false
			 			row = 2
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}
	}

	reports
	{
		default summary Organization
		{
		
					displayName = "Organization"
					show all rows from Add_Organization    
					(
						Organization_Name as "Organization Name"
						Logo
						Registration_License_No as "Registration / License No"
						Phone_Number as "Phone"
						(
							displayformat = plainnumber 
						)
						Email
						Address 
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Website_Address as "Website Address"
					)
					options
					(
						display rows = 10
						display records per row = 1
					)
				
		}

		default list Cases
		{
		
					displayName = "Cases"
					show all rows from Case    
					(
						Patient
						Case_Type as "Case Type"
						Attending_Physician as "Attending Physician"
						Case_Status as "Case Status"
						Case_ID as "Case ID"
						Department
						Admission_Date as "Admission Date"
						Discharge_Date as "Discharge Date"
					)
					group by
					(
						Patient ascending
					)
				
		}

		default list Charges
		{
		
					displayName = "Charges"
					show all rows from Charge    
					(
						Service_Date as "Service Date"
						Service_Description as "Service Description"
						CPT_Procedure_Code as "CPT / Procedure Code"
						Amount
						Charge_Status as "Charge Status"
						Charge_ID as "Charge ID"
						Insurance_Paid as "Insurance Paid"
						Patient_Paid as "Patient Paid"
						Case
					)
					group by
					(
						Case ascending
					)
				
		}

		list All_Communication_Logs
		{
		
					displayName = "All Communication Logs"
					show all rows from Communication_Log    
					(
						Time
						Channel
						Contact_Person  as "Contact Person"
						Summary
						Follow_Up_Required as "Follow-Up Required"
						Follow_Up_Date as "Follow-Up Date"
						Logged_By as "Logged By"
						Dispute
					)
					group by
					(
						Dispute ascending
					)
				
		}

		default list My_Communication_Logs
		{
		
					displayName = "My Communication Logs"
					show all rows from Communication_Log  [Logged_By.ID == thisapp.getLoginUserRecId()]  
					(
						Time
						Channel
						Contact_Person  as "Contact Person"
						Summary
						Follow_Up_Required as "Follow-Up Required"
						Follow_Up_Date as "Follow-Up Date"
						Logged_By as "Logged By"
						Dispute
					)
					group by
					(
						Dispute ascending
					)
				
		}

		default summary Dispute_Categories
		{
		
					displayName = "Dispute Categories"
					show all rows from Dispute_Category    
					(
						Category
						Sub_Category as "Sub-Category"
						Priority
						(
							view = SLA_Matrices
						)
						Default_Role as "Default Role"
						(
							view = Roles
						)
					)
					options
					(
						display rows = 10
						display records per row = 2
					)
					conditional formatting
					(
						"Critical"
						{
						condition = (Priority.Priority == "Critical")
						fields = [Priority]
						format = "color:#e64d3b;"
						}
						"High"
						{
						condition = (Priority.Priority == "High")
						fields = [Priority]
						format = "color:#e77f06;"
						}
						"Medium"
						{
						condition = (Priority.Priority == "Medium")
						fields = [Priority]
						format = "color:#f1c50e;"
						}
						"Low"
						{
						condition = (Priority.Priority == "Low")
						fields = [Priority]
						format = "color:#398ef3;"
						}
					)
				
		}

		list All_Disputes
		{
		
					displayName = "All Disputes"
					template = All_Dispute_Details
					show all rows from Dispute_Intake    
					(
						Patient
						Category
						Sub_Category as "Sub-Category"
						Dispute_Source as "Dispute Source"
						Disputed_Amount as "Disputed Amount"
						Reason_for_Dispute as "Reason for Dispute"
						Supporting_Documents as "Supporting Documents"
						Total_Billed_Amount as "Total Billed Amount"
						Insurance_Payer as "Insurance Payer"
						Assigned_To as "Assigned To"
						Created_By_User as "Created By User"
						Closed_By_User as "Closed By User"
						Status
						Dispute_ID as "Dispute ID"
						Auto_Number as "Auto Number"
						Approver
						Patient_Share as "Patient Share"
						Email
						Case
						Created_By_Type as "Created By Type"
						Investigation_Due_Date as "Investigation Due Date"
						Priority
						Ask_Zia as "Ask Zia"
						Zia_Classification_Status as "Zia Classification Status"
						Zia_Category as "Zia Category"
						Zia_Sub_Category as "Zia Sub-Category"
						Zia_Classification_Response as "Zia Classification Response"
						Accept_Zia_s_Suggestion as "Accept Zia's Suggestion"
						Investigation_Start_Time as "Investigation Start Time"
						Assigned_Role as "Assigned Role"
						Admin_Role as "Admin Role"
						Investigation_Resolution as "Investigation Resolution"
						AI_Dispute_Summary as "Dispute Summary"
						Patient.Added_Time as "Added Time"
					)
					group by
					(
						Status ascending
					)
					custom actions
					(
						"AI Dispute Briefing"
						(
			  			workflow = AI_Dispute_Briefing_All_D
						show action in view header = true
						show action in edit record menu = true
						)
					)
					conditional formatting
					(
						"Medium"
						{
						condition = (Priority == "Medium")
						fields = [Priority]
						format = "color:#ffc107;"
						}
						"Low"
						{
						condition = (Priority == "Low")
						fields = [Priority]
						format = "color:#4caf50;"
						}
						"Critical"
						{
						condition = (Priority == "Critical")
						fields = [Priority]
						format = "color:#f44336;"
						}
						"High"
						{
						condition = (Priority == "High")
						fields = [Priority]
						format = "color:#ff7043;"
						}
						"Unassigned"
						{
						condition = (Status == "Unassigned")
						fields = [Status]
						format = "color:#9e9e9e;background-color:#ffffff;"
						}
						"Assigned"
						{
						condition = (Status == "Assigned")
						fields = [Status]
						format = "color:#2196f3;"
						}
						"Under Investigation"
						{
						condition = (Status == "Under Investigation")
						fields = [Status]
						format = "color:#009688;"
						}
						"Pending Approval"
						{
						condition = (Status == "Pending Approval")
						fields = [Status]
						format = "color:#ffc107;"
						}
						"Approved"
						{
						condition = (Status == "Approved")
						fields = [Status]
						format = "color:#4caf50;"
						}
						"Rejected"
						{
						condition = (Status == "Rejected")
						fields = [Status]
						format = "color:#f44336;"
						}
						"Returned for Rework"
						{
						condition = (Status == "Returned for Rework")
						fields = [Status]
						format = "color:#ff7043;"
						}
						"Resolution Communicated"
						{
						condition = (Status == "Resolution Communicated")
						fields = [Status]
						format = "color:#7e57c2;"
						}
						"Closed"
						{
						condition = (Status == "Closed")
						fields = [Status]
						format = "color:#616161;"
						}
					)
					customlayouts
					(
						template
			 			(
			 	  			displayname="Custom Layout 2"
			 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n		width = '100%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n\n		width = '100%'\n		hAlign = 'left'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n\n		hAlign = 'left'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '20px'\n	bold = 'true' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '27'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Dispute_ID'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '15px'\n	marginTop = '8px'\n	padding = '0px'\n	color = '#522363'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'AI_Dispute_Summary'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		paddingTop = '0px'\n	paddingLeft = '0px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '33%'\n		hAlign = 'left'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Disputed_Amount'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '10px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '34%'\n		hAlign = 'center'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Category'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		paddingTop = '0px'\n	paddingLeft = '10px'\n	paddingRight = '0px'\n	paddingBottom = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '33%'\n		hAlign = 'right'\n		vAlign = 'top'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#4C4C4C'\n	size = '15px'\n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Priority'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
			    		)
					)
				
		}

		list All_Resolution_Decisions
		{
		
					displayName = "All Resolution Decisions"
					show all rows from Dispute_Intake    
					(
						Investigation_Resolution.Dispute
						Investigation_Resolution.Resolution_ID as "Resolution ID"
						Investigation_Resolution.Resolution_Type as "Resolution Type"
						Investigation_Resolution.Adjustment_Amount as "Adjustment Amount"
						Investigation_Resolution.Root_Cause as "Root Cause"
						Investigation_Resolution.Created_By as "Created By"
						Investigation_Resolution.Approver
						Investigation_Resolution.Resolution_Approval_Due_Date as "Approval Due Date"
						Disputed_Amount as "Disputed Amount"
						Dispute_ID as "Dispute ID"
						AI_Dispute_Summary as "Dispute Summary"
						Patient.Added_Time as "Added Time"
						Investigation_Resolution.Root_Cause_Detail as "Root Cause Detail"
						Investigation_Resolution.Resolution_Rationale as "Resolution Rationale"
						Investigation_Resolution.Approval_Status as "Approval Status"
						Investigation_Resolution.Approver_Comments as "Approver Comments"
					)
					conditional formatting
					(
						"Pending Approval"
						{
						condition = (Investigation_Resolution.Approval_Status == "Pending")
						fields = [Investigation_Resolution.Approval_Status]
						format = "color:#ffc107;"
						}
						"Approved"
						{
						condition = (Investigation_Resolution.Approval_Status == "Approved")
						fields = [Investigation_Resolution.Approval_Status]
						format = "color:#4caf50;"
						}
						"Rejected"
						{
						condition = (Investigation_Resolution.Approval_Status == "Rejected")
						fields = [Investigation_Resolution.Approval_Status]
						format = "color:#f44336;"
						}
						"Returned"
						{
						condition = (Investigation_Resolution.Approval_Status == "Returned")
						fields = [Investigation_Resolution.Approval_Status]
						format = "color:#ff7043;"
						}
					)
				
		}

		list Approved_Resolutions
		{
		
					displayName = "Approved Resolutions"
					show all rows from Dispute_Intake  [Created_By_User.ID == thisapp.getLoginUserRecId() || Investigation_Resolution.Created_By == thisapp.getLoginUserRecId() || Investigation_Resolution.Approver == thisapp.getLoginUserRecId() || Admin_Role.ID == thisapp.getLoginUserRoleId() && Status == "Approved"]  
					(
						Investigation_Resolution.Dispute
						Investigation_Resolution.Resolution_ID as "Resolution ID"
						Investigation_Resolution.Resolution_Type as "Resolution Type"
						Investigation_Resolution.Adjustment_Amount as "Adjustment Amount"
						Investigation_Resolution.Root_Cause as "Root Cause"
						Investigation_Resolution.Created_By as "Created By"
						Investigation_Resolution.Approver
						Investigation_Resolution.Resolution_Approval_Due_Date as "Approval Due Date"
						Disputed_Amount as "Disputed Amount"
						Dispute_ID as "Dispute ID"
						AI_Dispute_Summary as "Dispute Summary"
						Patient.Added_Time as "Added Time"
						Investigation_Resolution.Root_Cause_Detail as "Root Cause Detail"
						Investigation_Resolution.Resolution_Rationale as "Resolution Rationale"
						Investigation_Resolution.Approval_Status as "Approval Status"
						Investigation_Resolution.Approver_Comments as "Approver Comments"
						custom action "AI Email"
						(
			  			workflow = AI_Email_Rejected_Resolut
						show action in view header = true
						show action in edit record menu = true
						column header = "AI Email"
						condition = (AI_Email_Draft_Status == "Generated")
						)
					)
					conditional formatting
					(
						"Rejected"
						{
						condition = (Investigation_Resolution.Approval_Status == "Rejected")
						fields = [Investigation_Resolution.Approval_Status]
						format = "color:#f44336;"
						}
					)
					customlayouts
					(
						template
			 			(
			 	  			displayname="Custom Layout 1"
