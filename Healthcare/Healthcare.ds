			                 	style_txt = "<style>" + thisapp.Styles.Base_Styles() + " .zcs-zia-img { width: 28px; height: 28px; } .zcs-ai-generated-wrapper { border: 1px solid transparent; background: linear-gradient(120.46deg, #EBF9FF 2.08%, #FFF8FF 95.48%) padding-box, linear-gradient(240.82deg, rgba(228, 37, 39, 0.5) 1.74%, rgba(249, 178, 29, 0.5) 34.79%, rgba(8, 153, 73, 0.5) 67.84%, rgba(34, 109, 180, 0.5) 98.95%) border-box; } .zcs-ai-generated-text { background: linear-gradient(92.86deg, rgba(228, 37, 39, 0.9) 0.83%, #C44CE6 54.25%, #2A90D5 99.15%); background-clip: text; color: transparent; } .zcs-zia-content { background: linear-gradient(97.09deg, #FFF8FF 0.33%, #EBF9FF 98.51%) padding-box, linear-gradient(180deg, rgba(228, 37, 39, 0.6) 0%, rgba(249, 178, 29, 0.6) 33%, rgba(8, 153, 73, 0.6) 66%, rgba(34, 109, 180, 0.6) 100%) border-box; border: 1px solid transparent; } .zcs-zia-border { height: 1px; background: linear-gradient(90deg, rgba(228, 37, 39, 0.5) 0%, rgba(249, 178, 29, 0.5) 34.13%, rgba(8, 153, 73, 0.5) 70.19%, rgba(34, 109, 180, 0.5) 100%); } </style>";
			                 	return style_txt;
			                 
			}
		}
