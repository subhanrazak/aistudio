			map aiFeature.classifyDisputeCategory(string reasonInput)
			{
			
			                 	reasonText = ifnull(reasonInput,"").trim();
			                 	categoriesRec = Dispute_Category[ID != 0];
			                 	if(reasonText.length() < 10 || categoriesRec.count() == 0)
			                 	{
			                 		return "{\"matchedCategoryID\":\"0\",\"matchedSubCategoryID\":\"0\",\"status\":\"Skipped - insufficient data\",\"suggestedCategory\":\"\",\"suggestedSub\":\"\"}";
			                 	}
			                 	subCategoryList = List();
			                 	subCategoryList = categoriesRec.Sub_Category.getall();
			                 	subCategoryMap = Map();
			                 	subCategoryNameMap = Map();
			                 	for each  eachSubCategory in Dispute_Subcategory[ID in subCategoryList]
			                 	{
			                 		subCategoryMap.put(eachSubCategory.ID,eachSubCategory.Sub_Category);
			                 		subCategoryNameMap.put(eachSubCategory.Sub_Category.trim().toLowerCase(),eachSubCategory.ID);
			                 	}
			                 	allowedPairs = List();
			                 	idMap = Map();
			                 	categoryNameMap = Map();
			                 	for each  eachCategory in categoriesRec
			                 	{
			                 		categoryNameMap.put(eachCategory.Category.trim().toLowerCase(),eachCategory.ID);
			                 		for each  eachSub in eachCategory.Sub_Category
			                 		{
			                 			pair = eachCategory.Category + " > " + subCategoryMap.get(eachSub);
			                 			allowedPairs.add(pair);
			                 			idMap.put(pair.toLowerCase(),eachCategory.ID + "|" + eachSub);
			                 		}
			                 	}
			                 	allowedList = allowedPairs.toString("\n");
			                 	promptText = "Classify the dispute reason into a Category and Sub-Category. ";
			                 	promptText = promptText + "First try to match ONE line from the list exactly (Category and Sub-Category are a fixed pair - never mix across lines). If a line fits, copy it exactly and set \"matched\":true. ";
			                 	promptText = promptText + "If no line fits, propose a concise new Category and Sub-Category suited to the reason and set \"matched\":false. ";
			                 	promptText = promptText + "ALWAYS return a real, non-empty category and sub_category - never return empty strings and never return the word \"Unknown\". ";
			                 	promptText = promptText + "Reply ONLY as JSON: {\"matched\":true,\"category\":\"...\",\"sub_category\":\"...\"}\n\n";
			                 	promptText = promptText + "LIST:\n" + allowedList + "\n\n";
			                 	promptText = promptText + "REASON:\n" + reasonText;
			                 	matchedCategoryID = "0";
			                 	matchedSubCategoryID = "0";
			                 	statusText = "No matching category";
			                 	suggestedCategory = "";
			                 	suggestedSubCategory = "";
			                 	try 
			                 	{
			                 		ziaResponse = zia
			                 		[
			                 			message:promptText
			                 			context:"You are a precise text classifier. Output ONLY valid JSON. Prefer values from the list; only propose new ones when nothing fits."
			                 			parameters:{"temperature":0.1}
			                 		];
			                 		//ziaResponse --> {"matched":true,"category":"Charge Error","sub_category":"Duplicate"}
			                 		if(ziaResponse.status == true)
			                 		{
			                 			ziaResponseData = ziaResponse.data;
			                 			ziaResponseJson = ziaResponseData.replaceAll("```json","").replaceAll("```","").trim();
			                 			try 
			                 			{
			                 				resultMap = ziaResponseJson.toMap();
			                 				classifiedCategory = ifnull(resultMap.get("category"),"").trim();
			                 				classifiedSubCategory = ifnull(resultMap.get("sub_category"),"").trim();
			                 				matchedKey = (classifiedCategory + " > " + classifiedSubCategory).toLowerCase();
			                 				if(idMap.containKey(matchedKey))
			                 				{
			                 					combined = idMap.get(matchedKey);
			                 					matchedCategoryID = combined.getPrefix("|");
			                 					matchedSubCategoryID = combined.getSuffix("|");
			                 					suggestedCategory = classifiedCategory;
			                 					suggestedSubCategory = classifiedSubCategory;
			                 					statusText = "Classified";
			                 				}
			                 				else if(categoryNameMap.containKey(classifiedCategory.toLowerCase()))
			                 				{
			                 					matchedCategoryID = categoryNameMap.get(classifiedCategory.toLowerCase()).toString();
			                 					if(subCategoryNameMap.containKey(classifiedSubCategory.toLowerCase()))
			                 					{
			                 						matchedSubCategoryID = subCategoryNameMap.get(classifiedSubCategory.toLowerCase()).toString();
			                 					}
			                 					suggestedCategory = classifiedCategory;
			                 					suggestedSubCategory = classifiedSubCategory;
			                 					statusText = "Partial";
			                 				}
			                 				else if(classifiedCategory != "" && classifiedSubCategory != "")
			                 				{
			                 					suggestedCategory = classifiedCategory;
			                 					suggestedSubCategory = classifiedSubCategory;
			                 					statusText = "Suggested";
			                 				}
			                 				else
			                 				{
			                 					statusText = "Empty content returned";
			                 				}
			                 			}			catch (jsonError)
			                 			{
			                 				statusText = "Invalid JSON returned";
			                 			}
			                 		}
			                 		else
			                 		{
			                 			statusText = "Zia failed: " + ziaResponse.error;
			                 		}
			                 	}	catch (ziaError)
			                 	{
			                 		statusText = "Zia exception: " + ziaError;
			                 	}
			                 	result = Map();
			                 	result.put("matchedCategoryID",matchedCategoryID);
			                 	result.put("matchedSubCategoryID",matchedSubCategoryID);
			                 	result.put("status",statusText);
			                 	result.put("suggestedCategory",suggestedCategory);
			                 	result.put("suggestedSubCategory",suggestedSubCategory);
			                 	return result;
			                 
			}

			void aiFeature.generateAIDisputeBrief(int recID)
			{
			
			                 	disputeRecord = Dispute_Intake[ID == recID];
			                 	contentText = "Dispute ID: " + disputeRecord.Dispute_ID + "\n";
			                 	contentText = contentText + "Patient: " + disputeRecord.Patient_Name + "\n";
			                 	contentText = contentText + "Insurance Payer: " + disputeRecord.Insurance_Payer.Payer_ID + "-" + disputeRecord.Insurance_Payer.Payer_Name + "\n";
			                 	contentText = contentText + "Total Billed Amount: " + disputeRecord.Total_Billed_Amount + "\n";
			                 	contentText = contentText + "Disputed Amount: " + disputeRecord.Disputed_Amount + "\n";
			                 	contentText = contentText + "Category: " + disputeRecord.Category.Category + "\n";
			                 	contentText = contentText + "Sub-Category: " + disputeRecord.Sub_Category.Sub_Category + "\n";
			                 	contentText = contentText + "Reason for Dispute: " + disputeRecord.Reason_for_Dispute + "\n";
			                 	contentText = contentText + "\nDisputed Charge Lines:\n";
			                 	for each  eachCharge in disputeRecord.Disputed_Charge_Line
			                 	{
			                 		contentText = contentText + "- Charge: " + eachCharge.Charge.Charge_ID + ", CPT Code: " + eachCharge.CPT_Code + ", Service Date: " + eachCharge.Charge.Service_Date + ", Billed Amount: " + eachCharge.Billed_Line_Amount + ", Disputed Amount: " + eachCharge.Disputed_Line_Amount + ", Reason: " + ifnull(eachCharge.Line_Reason,"") + "\n";
			                 	}
			                 	if(contentText.length() < 80)
			                 	{
			                 		disputeRecord.AI_Brief_Response="";
			                 		disputeRecord.AI_Brief_Status="Skipped - insufficient data";
			                 		return;
			                 	}
			                 	promptText = "Read the billing dispute details below and return ONLY valid JSON with no markdown, no code fences, no preamble. Use exactly this structure: {\"summary\":\"one sentence under 15 words — patient name, dispute category, sub-category and payer only\",\"overview\":\"two to three lines summarising the dispute for a billing analyst — include patient, payer, disputed amount, category and reason\",\"risk_indicator\":\"one sentence on the financial exposure and severity — must start with High, Medium or Low exposure\",\"pattern_flag\":\"one sentence identifying if this matches a known billing dispute pattern — reference the category and sub-category\",\"resolution_likelihood\":\"one sentence assessing the likelihood of resolving in the patient favour based on the evidence provided\"}. Rules: every key must always be present and never empty — if a field cannot be determined from the available data, return a short neutral statement for that field instead of leaving it blank. summary must be under 15 words and must not repeat information already in overview. Keep all other values concise and factual. Only use facts present in the record. Do not assume or invent information.\n\nDISPUTE DETAILS:\n" + contentText;
			                 	briefSaved = false;
			                 	try 
			                 	{
			                 		briefResponse = zia
			                 		[
			                 			message:promptText
			                 			context:"You are a healthcare billing dispute analyst assistant. Output ONLY valid JSON with no extra text. Only use facts present in the dispute record."
			                 			parameters:{"temperature":0.1}
			                 		];
			                 		if(briefResponse.status == true)
			                 		{
			                 			aiJson = briefResponse.data;
			                 			aiJson = aiJson.replaceAll("```json","").replaceAll("```","").trim();
			                 			try 
			                 			{
			                 				testMap = aiJson.toMap();
			                 				summaryVal = testMap.get("summary");
			                 				overviewVal = testMap.get("overview");
			                 				riskVal = testMap.get("risk_indicator");
			                 				patternVal = testMap.get("pattern_flag");
			                 				resolutionVal = testMap.get("resolution_likelihood");
			                 				if(overviewVal != null && overviewVal != "")
			                 				{
			                 					rebuilt = Map();
			                 					rebuilt.put("summary",summaryVal);
			                 					rebuilt.put("overview",overviewVal);
			                 					rebuilt.put("risk_indicator",riskVal);
			                 					rebuilt.put("pattern_flag",patternVal);
			                 					rebuilt.put("resolution_likelihood",resolutionVal);
			                 					disputeRecord.AI_Brief_Response=rebuilt.toString();
			                 					disputeRecord.AI_Brief_Status="Generated";
			                 					disputeRecord.AI_Dispute_Summary=summaryVal;
			                 					briefSaved = true;
			                 				}
			                 				else
			                 				{
			                 					disputeRecord.AI_Brief_Status="Empty content returned";
			                 				}
			                 			}			catch (jsonError)
			                 			{
			                 				disputeRecord.AI_Brief_Status="Invalid JSON returned";
			                 			}
			                 		}
			                 		else
			                 		{
			                 			disputeRecord.AI_Brief_Status="Zia failed: " + briefResponse.error;
			                 		}
			                 	}	catch (ziaError)
			                 	{
			                 		disputeRecord.AI_Brief_Status="Zia exception: " + ziaError;
			                 	}
			                 	if(briefSaved == false)
			                 	{
			                 		disputeRecord.AI_Brief_Response="";
			                 		payerPart = "";
			                 		if(disputeRecord.Insurance_Payer != null)
			                 		{
			                 			payerPart = " against " + disputeRecord.Insurance_Payer.Payer_Name;
			                 		}
			                 		disputeRecord.AI_Dispute_Summary=disputeRecord.Patient_Name + " disputes" + disputeRecord.Category.Category + " (" + disputeRecord.Sub_Category.Sub_Category + ")" + payerPart + ".";
			                 	}
			                 
			}

			void aiFeature.generateResolutionEmailDraft(int disputeId)
			{
			
			                 	disputeRec = Dispute_Intake[ID == disputeId];
			                 	resolutionRec = Investigation_Resolution[Dispute == disputeId];
			                 	emailSubject = "";
			                 	emailContent = "";
			                 	statusText = "No content generated";
			                 	promptText = "Generate a formal and empathetic patient billing dispute resolution email using the dispute details provided. Patient Name: " + disputeRec.Patient_Name + ". Dispute ID: " + disputeRec.Dispute_ID + ". Dispute Category: " + disputeRec.Category.Category + ". Disputed Amount: $" + disputeRec.Disputed_Amount + ". Resolution Type: " + resolutionRec.Resolution_Type + ". Adjustment Amount: $" + resolutionRec.Adjustment_Amount + ". Resolution Rationale: " + resolutionRec.Resolution_Rationale + ". Root Cause: " + resolutionRec.Root_Cause.Root_Cause + ". Instructions: 1. Subject line must reference Dispute ID " + disputeRec.Dispute_ID + " and summarise the resolution in plain language. 2. Format the email body as clean HTML using only <p>, <br>, <b> tags — no divs, no styles, no classes. 3. Follow this structure exactly: Greeting → Dispute acknowledgement → Resolution decision → Adjustment details → Apology if root cause is a hospital error → Next steps → Closing. 4. Each section must be a separate <p> tag. 5. Keep the email under 300 words — concise and clear. 6. Use plain language — no medical or billing jargon. 7. Use only generic references — our billing team, our hospital, our support team, contact us via email — never use bracketed placeholders like [Hospital Name] or [Contact Number]. 8. Tone must be professional, empathetic and clear throughout. 9. Do not mention any timeframes, day counts, or statement cycles — do not use next statement, business days, as soon as possible, shortly, or in due course — state only that the adjustment will be processed and the patient will be notified once complete. 10. Never make promises about outcomes, timelines, or future billing cycles. Reply ONLY as JSON: {\"subject\":\"...\",\"content\":\"...\"}";
			                 	try 
			                 	{
			                 		ziaResponse = zia
			                 		[
			                 			message:promptText
			                 			context:"You are a professional healthcare billing communication specialist. Output ONLY valid JSON with subject and content keys. Never return empty values."
			                 			parameters:{"temperature":0.2}
			                 		];
			                 		if(ziaResponse.status == true)
			                 		{
			                 			ziaResponseData = ziaResponse.data;
			                 			ziaResponseJson = ziaResponseData.replaceAll("```json","").replaceAll("```","").trim();
			                 			try 
			                 			{
			                 				resultMap = ziaResponseJson.toMap();
			                 				emailSubject = ifnull(resultMap.get("subject"),"").trim();
			                 				emailContent = ifnull(resultMap.get("content"),"").trim();
			                 				if(emailSubject != "" && emailContent != "")
			                 				{
			                 					statusText = "Generated";
			                 				}
			                 				else
			                 				{
			                 					statusText = "Empty content returned";
			                 				}
			                 			}			catch (jsonError)
			                 			{
			                 				statusText = "Invalid JSON returned";
			                 			}
			                 		}
			                 		else
			                 		{
			                 			statusText = "Zia failed: " + ziaResponse.error;
			                 		}
			                 	}	catch (ziaError)
			                 	{
			                 		statusText = "Zia exception: " + ziaError;
			                 	}
			                 	result = Map();
			                 	result.put("emailSubject",emailSubject);
			                 	result.put("emailContent",emailContent);
			                 	disputeRec.AI_Email_Draft_Response=result.toString();
			                 	disputeRec.AI_Email_Draft_Status=statusText;
			                 
			}

			string getAppUrl()
			{
			
			                 	domain = zoho.domain;
			                 	domainDC = domain.substring(domain.indexOf("zoho."),domain.length()).replaceAll("zoho.","");
			                 	appUrl = "https://creatorapp.zoho." + domainDC + zoho.appuri;
			                 	return appUrl;
			                 
			}

