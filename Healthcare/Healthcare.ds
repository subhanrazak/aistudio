		schedule
		{
			Investigation_Warning as "Investigation Warning"
			{
			
							type =  schedule
							form = Dispute_Intake[Status == "Assigned" || Status == "Under Investigation" || Status == "Returned for Rework"]
								status = inactive
							start = before 1 days from Investigation_Due_Date at "00:00:00"
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									subjectMsg = "Reminder — Investigation Due Tomorrow for Dispute " + input.Dispute_ID;
													reportLink = thisapp.getAppUrl() + "record-summary/My_Assigned_Disputes/" + input.ID;
													bodyMsgContent = "<p>Hi <b>" + input.Assigned_To.Name + "</b>,</p><p>This is a reminder that your investigation SLA for the dispute below is due tomorrow. Please ensure your investigation is completed and submitted for approval before the deadline.</p><p><b>Dispute ID</b> : " + input.Dispute_ID + "<br><b>Patient Name</b> : " + input.Patient_Name + "<br><b>Disputed Amount</b> : " + input.Disputed_Amount + "<br><b>Priority</b> : " + input.Priority + "<br><b>Current Status</b> : " + input.Status + "<br><b>Due Date</b> : " + input.Investigation_Due_Date + "</p><p>Failure to meet this deadline will result in an SLA breach.</p><p><a href='" + reportLink + "'>Click here to view the Dispute</a></p>";
													sendmail
													[
														from :zoho.adminuserid
														to :input.Assigned_To.Email
														subject :subjectMsg
														message :bodyMsgContent
													]
								)
								}
							}
						
			}

			Resolution_Approval_Warni as "Resolution Approval Warning"
			{
			
							type =  schedule
							form = Investigation_Resolution[Dispute.Status != "Closed"]
							start = before 1 days from Resolution_Approval_Due_Date at "00:00:00"
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									subjectMsg = "Reminder — Approval Due Tomorrow for Dispute " + input.Dispute.Dispute_ID;
													reportLink = thisapp.getAppUrl() + "record-summary/Pending_Approval/" + input.ID;
													bodyMsgContent = "<p>Hi <b>" + input.Approver.Name + "</b>,</p> <p>This is a reminder that your approval SLA for the dispute below is due tomorrow. Please review and take action before the deadline.</p> <p> <b>Dispute ID</b> : " + input.Dispute.Dispute_ID + "<br> <b>Patient Name</b> : " + input.Dispute.Patient_Name + "<br> <b>Disputed Amount</b> : " + input.Dispute.Disputed_Amount + "<br> <b>Priority</b> : " + input.Dispute.Priority + "<br> <b>Current Status</b> : " + input.Approval_Status + "<br> <b>Due Date</b> : " + input.Resolution_Approval_Due_Date + " </p> <p>Failure to act before the deadline will result in an SLA breach.</p><p><a href='" + reportLink + "'>Click here to view the Resolution</a></p>";
													sendmail
													[
														from :zoho.adminuserid
														to :input.Approver.Email
														subject :subjectMsg
														message :bodyMsgContent
													]
								)
								}
							}
						
			}
		}

		functions
		{
			AI_Dispute_Briefing_All_D as "AI Dispute Briefing - All_Disputes"
			{
			
							type =  functions
							form = Dispute_Intake
							execution type = for each record	
							on start
							{
								actions 
								{
									thisapp.aiFeature.openAIDisputeBriefing(ID);
								}
							}
						
			}

			AI_Email_Approved_Resolut as "AI Email - Approved_Resolutions"
			{
			
							type =  functions
							form = Dispute_Intake
							execution type = for each record	
							on start
							{
								actions 
								{
									thisapp.aiFeature.openAIResolutionEmail(ID);
								}
							}
						
			}

			AI_Email_Rejected_Resolut as "AI Email - Rejected_Resolutions"
			{
			
							type =  functions
							form = Dispute_Intake
							execution type = for each record	
							on start
							{
								actions 
								{
									thisapp.aiFeature.openAIResolutionEmail(ID);
								}
							}
						
			}

			Grant_Dispute_Agent_Patie as "Grant Dispute Agent - Patients"
			{
			
							type =  functions
							form = Patient
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Email != null)
													{
														try 
														{
															thisapp.permissions.assignUserInProfile(input.Email,"Agent_User",true);
															for each  eachPatient in Patient[Email.equalsIgnoreCase(input.Email)]
															{
																eachPatient.Dispute_agent_access_granted=true;
															}
														}	catch (err)
														{
															if(err.message == "User Limit Reached")
															{
																alertMessage = "User limit reached. Please contact the application owner to purchase additional user licenses.";
																openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + alertMessage,"popup window");
															}
															else
															{
																openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + err.message,"popup window");
															}
														}
													}
													else
													{
														openUrl("#Form:Update_Patient_Email?zc_Header=false&Patient=" + input.Email,"popup window");
													}
								)
								}
							}
						
			}

			Revoke_Dispute_Agent_Pati as "Revoke Dispute Agent - Patients"
			{
			
							type =  functions
							form = Patient
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									try 
													{
														thisapp.permissions.deleteUser(input.Email);
														for each  eachPatient in Patient[Email.equalsIgnoreCase(input.Email)]
														{
															eachPatient.Dispute_agent_access_granted=false;
														}
													}catch (err)
													{
														openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + err.message,"popup window");
													}
								)
								}
							}
						
			}

			Delete_Role_Roles as "Delete Role - Roles"
			{
			
							type =  functions
							form = Role
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									usersRecCount = User[Role == input.ID && !Is_Deleted].count();
													disputeCategoryRecCount = Dispute_Category[Default_Role == input.ID].count();
													if(usersRecCount > 0)
													{
														alertMessage = usersRecCount + " user(s) are linked to this Role. Before deleting this Role, kindly ensure that the associated user(s) are updated.";
														openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + alertMessage,"popup window");
													}
													else if(disputeCategoryRecCount > 0)
													{
														alertMessage = disputeCategoryRecCount + " category(s) are linked to this Role. Before deleting this Role, kindly ensure that the associated category(s) are updated.";
														openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + alertMessage,"popup window");
													}
													else
													{
														deletedUsersRecCount = User[Role == input.ID && Is_Deleted].count();
														disputeRecCount = Dispute_Intake[Status.equalsIgnoreCase("Closed") && Assigned_Role == input.ID].count();
														resolutionRecCount = Investigation_Resolution[Dispute.Status.equalsIgnoreCase("Closed") && Approver_Role == input.ID].count();
														if(deletedUsersRecCount > 0 || disputeRecCount > 0 || resolutionRecCount > 0)
														{
															//mark as deleted
															input.Is_Deleted = true;
														}
														else
														{
															//delete
															delete from Role[ID == input.ID];
														}
													}
								)
								}
							}
						
			}

			Delete_User_Users as "Delete User - Users"
			{
			
							type =  functions
							form = User
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									usersRecCount = User[Reporting_To == input.ID && !Is_Deleted].count();
													disputeRecCount = Dispute_Intake[!Status.equalsIgnoreCase("Closed") && Assigned_To == input.ID || Approver == input.ID].count();
													if(usersRecCount > 0)
													{
														alertMessage = usersRecCount + " user(s) report to this User. Before deleting this User, kindly reassign the associated user(s).";
														openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + alertMessage,"popup window");
													}
													else if(disputeRecCount > 0)
													{
														alertMessage = disputeRecCount + " active dispute(s) are assigned to this User. Before deleting this User, kindly reassign the associated dispute(s).";
														openUrl("#Form:Alert_Message?zc_Header=false&Popup_Message=" + alertMessage,"popup window");
													}
													else
													{
														disputeRecCount = Dispute_Intake[Created_By_User == input.ID || Closed_By_User == input.ID || (Status.equalsIgnoreCase("Closed") && Assigned_To == input.ID || Approver == input.ID)].count();
														resolutionRecCount = Investigation_Resolution[Dispute.Status.equalsIgnoreCase("Closed") && Approver_Role == input.ID].count();
														if(disputeRecCount > 0 || resolutionRecCount > 0)
														{
															//mark as deleted
															input.Is_Deleted = true;
														}
														else
														{
															//delete
															delete from User[ID == input.ID];
														}
													}
								)
								}
							}
						
			}
		}

		blueprint
		{
			Dispute_Resolution_Workfl as "Dispute Resolution Workflow"
			{
			
			        			type = Blueprint
			        			form = Dispute_Intake
			        			start
			        			{
			            			start stage = "Unassigned Dispute"
			            			chart data
			            			{
			                			from port : B
			                			to port   : T3
			                			position  : "8 -34"
			                			path      : [35.849999999999994,2.8400000000000034,35.849999999999994,12.840000000000003,35.849999999999994,34.92,35.98446807861329,34.92,35.98446807861329,57,35.98446807861329,67]
			            			}
			        			}
			        			stages
			        			{
			           			"Unassigned Dispute"
			           			{
			               			chart data
			               			{
			                   			position : "-47.22305247085299 67"
			               			}
			           			}
			           			"Under Investigation"
			           			{
			               			chart data
			               			{
			                   			position : "-47.55782312925169 306.4626984126984"
			               			}
			           			}
			           			"Pending Approval"
			           			{
			               			chart data
			               			{
			                   			position : "-36.69461815247166 533.9727891156463"
			               			}
			           			}
			           			"Assigned Dispute"
			           			{
			               			chart data
			               			{
			                   			position : "190.29939201417994 180.21417892139192"
			               			}
			           			}
			           			"Approved Resolution"
			           			{
			               			chart data
			               			{
			                   			position : "-179.46350880481066 735.6739456280566"
			               			}
			           			}
			           			"Rejected Resolution"
			           			{
			               			chart data
			               			{
			                   			position : "79.53073685280299 732.4161563745017"
			               			}
			           			}
			           			"Returned for Rework"
			           			{
			               			chart data
			               			{
			                   			position : "319.9837303160822 446.3804960062503"
			               			}
			           			}
			           			"Resolution Communicated"
			           			{
			               			chart data
			               			{
			                   			position : "-195.29790304163322 914.3287621209821"
			               			}
			           			}
			           			"Closed"
			           			{
			               			chart data
			               			{
			                   			position : "173.71719776915472 913.8400590771123"
			               			}
			           			}
			           			"Reassigned"
			           			{
			               			chart data
			               			{
			                   			position : "-344.4605674002232 538"
			               			}
			           			}
			        			}
			        			transitions
			        			{
			    				Approve as "Approve"
			    				{
			         				type = normal
			         				from stage = "Pending Approval"
			         				to stage = "Approved Resolution"
			         				before
			         				{
			            				transition criteria = (Status == "Pending Approval" && Approver.ID == thisapp.getLoginUserRecId() || Admin_Role.ID == thisapp.getLoginUserRoleId())
			         				}
			         				during
			         				{
			            				action = open_form
			            				form = Confirmation
			            				set values
			            				(
			                   				Investigation_Resolution = input.Investigation_Resolution
			                   				Action_field = Blueprint.Transition
			            				)
			         				}
			         				after
			         				{
										actions 
										{
										update Investigation_Resolution[ID == input.Investigation_Resolution]
										[
											Approval_Time = "zoho.currenttime"
											Approval_Status = "Approved"
										]
										update Dispute_Intake[ID == input.ID]
										[
											Status = "Approved"
										]
											custom deluge script
											(
																		thisapp.aiFeature.openAIResolutionEmail(input.ID);
																	subjectMsg = "Dispute " + input.Dispute_ID + " — Resolution Approved";
																	reportLink = thisapp.getAppUrl() + "record-summary/Approved_Resolutions/" + input.ID;
																	bodyMsgContent = "<p>Hi <b>" + input.Assigned_To.Name + "</b>,</p> <p>The resolution for dispute <b>" + input.Dispute_ID + "</b> has been reviewed and approved by <b>" + input.Approver.Name + "</b>.</p> <p> <b>Dispute ID</b> : " + input.Dispute_ID + "<br> <b>Patient Name</b> : " + input.Patient_Name + "<br> <b>Disputed Amount</b> : " + input.Disputed_Amount + " </p> <p> <b>Resolution Type</b> : " + input.Investigation_Resolution.Resolution_Type + "<br> <b>Adjustment Amount</b> : " + input.Investigation_Resolution.Adjustment_Amount + " </p> <p>Please ensure the resolution is communicated to the patient before closing this dispute.</p> <p><a href='" + reportLink + "'>Click here to view the Resolution</a></p>";
																	sendmail
																	[
																		from :zoho.adminuserid
																		to :input.Assigned_To.Email
																		subject :subjectMsg
																		message :bodyMsgContent
																	]
											)
										}
			         				}
			         				chart data
			         				{
			             				from port : B3
			             				to port   : T3
			             				path      : [39.49540819533446,585.5806189108679,39.49540819533446,595.5806189108679,39.49540819533446,660.6272822694623,-92.97998727878188,660.6272822694623,-92.97998727878188,725.6739456280566,-92.97998727878188,735.6739456280566]
			        				}
			  				}
			    				Assign_Dispute as "Assign Dispute"
			    				{
			         				type = normal
			         				from stage = "Unassigned Dispute"
			         				to stage = "Assigned Dispute"
			         				before
			         				{
			            				transition criteria = (Status == "Unassigned" && Admin_Role.ID == thisapp.getLoginUserRoleId())
			         				}
			         				during
			         				{
			            				action = open_form
			            				form = Assign_Dispute
			            				set values
			            				(
			                   				Dispute = input.ID
			                   				Action_field = Blueprint.Transition
			            				)
			         				}
			         				after
			         				{
										actions 
										{
										update Dispute_Intake[ID == input.ID]
										[
											Status = "Assigned"
										]
											custom deluge script
											(
																		subjectMsg = "New Dispute Assigned to You — " + input.Dispute_ID;
																	reportLink = thisapp.getAppUrl() + "record-summary/My_Assigned_Disputes/" + input.ID;
																	bodyMsgContent = "<p>Hi <b>" + input.Assigned_To.Name + "</b>,</p> <p>A dispute has been assigned to you. Please review the details below and begin your investigation.</p> <p> <b>Dispute ID</b> : " + input.Dispute_ID + "<br> <b>Patient Name</b> : " + input.Patient_Name + "<br> <b>Disputed Amount</b> : " + input.Disputed_Amount + "<br> <b>Category</b> : " + input.Category.Category + " / " + input.Sub_Category.Sub_Category + "<br> <b>Priority</b> : " + input.Priority + "<br> <b>Due Date</b> : " + input.Investigation_Due_Date + " </p><p><a href='" + reportLink + "'>Click here to view the Dispute</a></p>";
																	sendmail
																	[
																		from :zoho.adminuserid
																		to :input.Assigned_To.Email
																		subject :subjectMsg
																		message :bodyMsgContent
																	]
											)
										}
			         				}
			         				chart data
			         				{
			             				from port : R1
			             				to port   : T3
			             				path      : [119.19198862807957,92.80391489761081,129.19198862807957,92.80391489761081,265.81742129167355,92.80391489761081,265.81742129167355,131.50904690950136,265.81742129167355,170.21417892139192,265.81742129167355,180.21417892139192]
			        				}
			  				}
			    				Close_Dispute as "Close Dispute"
			    				{
			         				type = normal
			         				from stage = "Resolution Communicated"
			         				to stage = "Closed"
			         				before
			         				{
			            				transition criteria = (Created_By_Type == "User" && Status == "Resolution Communicated" && Admin_Role.ID == thisapp.getLoginUserRoleId() || Created_By_User.ID == thisapp.getLoginUserRecId())
			            				confirmation before execution
			            				(
			                				message = "Are you sure you want to close this dispute?"
			                				confirm button text = "Yes"
			                				cancel button text = "No"
			            				)
			         				}
			         				after
			         				{
										actions 
										{
											custom deluge script
											(
																		loginUserRecId = thisapp.getLoginUserRecId();
																	update Dispute_Intake[ID == input.ID]
																	[
																		Status="Closed"
																		Closed_By_User=loginUserRecId
																	];
																	if(Investigation_Resolution.Resolution_Type.equalsIgnoreCase("Full Adjustment") || Investigation_Resolution.Resolution_Type.equalsIgnoreCase("Partial Adjustment"))
																	{
																		for each  disputedChargeLineRec in input.Disputed_Charge_Line
																		{
																			chargeRec = Charge[ID == disputedChargeLineRec.Charge];
																			chargeRec.Charge_Status="Adjusted";
																		}
																	}
											)
										}
			         				}
			         				chart data
			         				{
			             				from port : R1
			             				to port   : L1
			             				path      : [10.702098994799343,940.1326770185929,20.702098994799343,940.1326770185929,92.20964838197703,940.1326770185929,92.20964838197703,939.643973974723,163.71719776915472,939.643973974723,173.71719776915472,939.643973974723]
			        				}
			  				}
			    				Communicate_Resolution as "Communicate Resolution"
			    				{
			         				type = common
			         				from stage = "Approved Resolution"
			         				to stage = "Resolution Communicated"
			         				common stages = {"Rejected Resolution"}
			         				before
			         				{
			            				transition criteria = (Status == "Approved" || Status == "Rejected" && (Created_By_Type == "User" && Created_By_User.ID == thisapp.getLoginUserRecId()) || (Created_By_Type == "Patient" && Assigned_To.ID == thisapp.getLoginUserRecId()) || Admin_Role.ID == thisapp.getLoginUserRoleId())
			         				}
			         				during
			         				{
			            				action = open_form
			            				form = Communication_Log
			            				set values
			            				(
			                   				Dispute = input.ID
			            				)
			         				}
			         				after
			         				{
										actions 
										{
										update Dispute_Intake[ID == input.ID]
										[
											Status = "Resolution Communicated"
										]
										}
			         				}
			         				chart data
			         				{
			             				from port : B3
			             				to port   : T3
			             				path      : [-92.97998727878188,787.2817754232782,-92.97998727878188,797.2817754232782,-92.97998727878188,850.8052687721301,-92.29790202341694,850.8052687721301,-92.29790202341694,904.3287621209821,-92.29790202341694,914.3287621209821]
			        				}
