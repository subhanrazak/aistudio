		}

		form Dispute_Subcategory
		{
		
					displayname = "Dispute Subcategory"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Sub_Category
					(
		    			type = text
						displayname = "Sub-Category"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Is_Zia_Added
					(
		    			type = checkbox
						displayname = "Is Zia Added"
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Disputed_Charge_Line
		{
		
					displayname = "Disputed Charge Line"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Dispute
					(
						type = picklist	
						values  = Dispute_Intake.ID
		    			bidirectional = Disputed_Charge_Line
		    			displayformat = [Dispute_ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Charge
					(
						type = picklist	
						values  = Charge.ID
		    			displayformat = [Charge_ID + " - " + Service_Date]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					CPT_Code
					(
		    			type = text
						displayname = "CPT Code"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Billed_Line_Amount
					(
						displayname = "Billed Line Amount"
						type = INR
						format = commadotindian
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Disputed_Line_Amount
					(
						displayname = "Disputed Line Amount"
						type = INR
						format = commadotindian
			 			row = 1
			 			column = 1   
						width = medium
					)
					Line_Reason
					(
						type = picklist
						displayname = "Line Reason"
						maxchar = 100
						values = {"Duplicate","Wrong amount","Service not received","Coding"}
						others option = true
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form ID_Configuration
		{
		
					displayname = "ID Configuration"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					helpText
					(
		    			type = plaintext
						value = "Add your Note here ..."
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have User_ID
					(
		    			type = text
						displayname = "User ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Patient_ID
					(
		    			type = text
						displayname = "Patient ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Case_ID
					(
		    			type = text
						displayname = "Case ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Charge_ID
					(
		    			type = text
						displayname = "Charge ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Insurance_Payer_ID
					(
		    			type = text
						displayname = "Insurance Payer ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Dispute_ID
					(
		    			type = text
						displayname = "Dispute ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Resolution_ID
					(
		    			type = text
						displayname = "Resolution ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
