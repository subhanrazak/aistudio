		list My_Pending_Approval
		{
		
					displayName = "My Pending Approval"
					show all rows from Dispute_Intake  [Status == "Pending Approval" && Investigation_Resolution.Approval_Status == "Pending" && Investigation_Resolution.Approver == thisapp.getLoginUserRecId()]  
					(
						Investigation_Resolution.Dispute
						Investigation_Resolution.Resolution_ID as "Resolution ID"
						Investigation_Resolution.Resolution_Type as "Resolution Type"
						Investigation_Resolution.Adjustment_Amount as "Adjustment Amount"
						Investigation_Resolution.Root_Cause as "Root Cause"
						Investigation_Resolution.Created_By as "Created By"
						Investigation_Resolution.Approver
						Investigation_Resolution.Resolution_Approval_Due_Date as "Approval Due Date"
