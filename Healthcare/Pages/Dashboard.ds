<page linkname = "Dashboard" parameters = "float avgResolutionTime, int openDisputes, int pendingApprovals, int slaBreaches, int totalDisputes" displayname = "Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<file name:Executive_KPI_Summary.ds/>
			</column>
		</row>
		<row>
			<column width='50%'>
				<dsp id='Effectiveness_Score_ZCS' elementName='Effectiveness Score' bgColor=\"transparent\" title='Effectiveness Score' titleSize='18px' boldTitle='true' titleColor='#222326'>
          <![CDATA[htmlpage Effectiveness_Score_ZCS()
content
			<%{%>
            <file name:Effectiveness_Score.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
			<column width='50%'>
				<dsp id='Analyst_Workload_ZCS' elementName='Analyst Workload' bgColor=\"transparent\" title='Analyst Workload' titleSize='18px' boldTitle='true' titleColor='#222326'>
          <![CDATA[htmlpage Analyst_Workload_ZCS()
content
			<%{%>
            <file name:Analyst_Workload.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='32%'>
				<dsp id='Dispute_Categories_ZCS' elementName='Dispute Categories' bgColor=\"transparent\" title='Dispute Categories' titleSize='18px' boldTitle='true' titleColor='#222326'>
          <![CDATA[htmlpage Dispute_Categories_ZCS()
content
			<%{%>
            <file name:Dispute_Categories.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
			<column width='34%'>
				<chart elementName='SLA_Priority_Distribution_Chart' title='SLA Priority Distribution' titleSize='18px' boldTitle='true' titleColor='#222326' type='Donut' xtitle='Priority' bgColor='#FFFFFF' theme='theme1' legendPos='center.bottom' heightType='custom' heightValue='320px' appLinkName='thisapp' formLinkName='Dispute_Intake' xfield='Priority' yfields='count:Dispute_ID' showDataLabel='true' underlyingReport='All_Disputes' /> </column>
			<column width='34%'>
				<dsp id='SLA_Breached_by_Category_ZCS' elementName='SLA Breached by Category' bgColor=\"transparent\" title='SLA Breached by Category' titleSize='18px' boldTitle='true' titleColor='#222326'>
          <![CDATA[htmlpage SLA_Breached_by_Category_ZCS()
content
			<%{%>
            <file name:SLA_Breached_by_Category.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:Pending_Approval_Queue.ds/> </column>
		</row>
	</layout>
</zml>
</content>
<script>
input.totalDisputes = Dispute_Intake[ID != 0].count();
				input.openDisputes = Dispute_Intake[Status != "Closed"].count();
				input.slaBreaches = Dispute_Intake[Investigation_Due_Date != null && Investigation_Due_Date < zoho.currentdate && Status != "Closed"].count();
				input.pendingApprovals = Dispute_Intake[Status == "Pending Approval"].count();
				input.avgResolutionTime = Investigation_Resolution[Approval_Status == "Approved"].avg(Resolution_Days);
				if(input.avgResolutionTime == null)
				{
					input.avgResolutionTime = 0;
				}
</script>