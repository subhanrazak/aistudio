schedule_offboarding_daily_reminder as "Offboarding Daily Reminder"
{

				type =  schedule
				start = "2025-01-01 09:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						pendingItems = Offboarding_Checklist[Status == "Pending"];
										if(pendingItems.count() > 0)
										{
											tokenMap = Map();
											tokenMap.put("pending_count",pendingItems.count());
											thisapp.Send_Configured_Notification("OFFBOARDING_DAILY_REMINDER",tokenMap,"Pending offboarding checklist items","There are {{pending_count}} pending offboarding checklist items.");
										}
					)
					}
				}
			
}