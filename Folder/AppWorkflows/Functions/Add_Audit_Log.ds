void Add_Audit_Log(string event_key, string module_name, string form_name, int record_id, string action, string old_status, string new_status, string details, bool success, string error_message)
{

                 	auditDetails = ifnull(details,"");
                 	auditError = ifnull(error_message,"");
                 	auditActor = zoho.loginuserid;
                 	if(auditActor == null || auditActor == "")
                 	{
                 		auditActor = zoho.loginuser;
                 	}
                 	insert into Audit_Log
                 	[
                 		Event_Key=event_key
                 		Module_Name=module_name
                 		Form_Name=form_name
                 		Record_ID=record_id
                 		Action=action
                 		Actor_Email=auditActor
                 		Actor_Profile=""
                 		Old_Status=old_status
                 		New_Status=new_status
                 		Details=auditDetails
                 		Success=success
                 		Error_Message=auditError
                 		Added_User=zoho.loginuser
                 	]
                 
}