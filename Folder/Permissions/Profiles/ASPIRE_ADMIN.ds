"ASPIRE_ADMIN"
{

				name = "ASPIRE_ADMIN"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false}
				description = "ASPIRE administration access for member and ID card processing.\n"
				ModulePermissions
				{
					ID_Card_Request
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							HR_ID_Card_Management={"View","Edit"}
							ID_Card_Status_Kanban={"View","Edit"}
							My_ID_Card_Requests={"View"}
						}
					}
					Member_Master
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Member_Master_List={"View","Edit"}
						}
					}
					Employee_Master
					{
						enabled= Create,Tab,View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							My_Profile={"View"}
							Employee_Directory={"View"}
						}
					}
					ASPIRE_Admin_Dashboard
					{
						enabled = tab
					}
					Employee_Home
					{
						enabled = tab
					}
					ID_Card_Home
					{
						enabled = tab
					}
					ID_Card_Layout
					{
						enabled = tab
					}
				}
			
}