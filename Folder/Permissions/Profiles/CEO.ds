"CEO"
{

				name = "CEO"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:false, PIIAccess:true, ePHIAccess:false}
				description = "Executive access for CEO dashboards plus job and travel approval visibility.\n"
				ModulePermissions
				{
					Job_Request
					{
						enabled= Create,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Job_Request_List={"View"}
							Job_Request_Kanban={"View"}
							Pending_CEO_Job_Requests={"View","Edit"}
						}
					}
					Travel_Request
					{
						enabled= Create,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							HR_All_Travel={"View","Edit"}
							Travel_Status_Kanban={"View"}
							My_Travel_Requests={"View"}
						}
					}
					Employee_Master
					{
						enabled= View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Employee_Directory={"View"}
						}
					}
					Approval_Remarks
					{
						enabled= Create,Tab,View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Approval_Remarks_List={"View"}
							Approval_Action_Kanban={"View"}
						}
					}
					CEO_Dashboard
					{
						enabled = tab
					}
				}
			
}