"IT_ADMIN"
{

				name = "IT_ADMIN"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:false, PIIAccess:false, ePHIAccess:false}
				description = "IT administration access for offboarding checklist and asset recovery.\n"
				ModulePermissions
				{
					Resignation_Request
					{
						enabled= Create,Viewall,Export,Tab,View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							HR_Offboarding_Dashboard={"View"}
							Resignation_Status_Kanban={"View"}
						}
					}
					Employee_Master
					{
						enabled= View,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Employee_Directory={"View"}
						}
					}
					Employee_Asset_Recovery
					{
						enabled= Create,Viewall,Modifyall,Export,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Asset_Sync_Failed={"View"}
							Asset_Recovery_Kanban={"View","Edit"}
							IT_Asset_Recovery_Dashboard={"View","Edit"}
						}
					}
					Offboarding_Checklist
					{
						enabled= Create,Viewall,Modifyall,Export,Tab,View,Edit,Search 
						allFieldsVisible= true 
						ReportPermissions
						{
							Offboarding_Checklist_Kanban={"View","Edit"}
							My_Offboarding_Checklist_Items={"View"}
							Offboarding_Checklist_View={"View","Edit"}
						}
					}
					IT_Admin_Dashboard
					{
						enabled = tab
					}
					Offboarding_Home
					{
						enabled = tab
					}
				}
			
}