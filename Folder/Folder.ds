=&quot;embed-grid&quot;&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Add Notification Config&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel-body form-embed&quot;&gt;&lt;div zc-component=&quot;form&quot; zc-linkname=&quot;Notification_Config&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Notification Config List&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel-body report-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Notification_Config_List&quot; zc-height=&quot;520px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section id=&quot;settings-logs&quot; class=&quot;settings-section&quot;&gt;\n\t\t\t&lt;div class=&quot;section-heading&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;section-title&quot;&gt;Admin logs&lt;/h2&gt;&lt;p class=&quot;section-subtitle&quot;&gt;Approval remarks and audit log lists are embedded read-oriented sections for review and traceability.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;article class=&quot;settings-master-card&quot;&gt;&lt;div class=&quot;master-card-header&quot;&gt;&lt;div class=&quot;master-title-wrap&quot;&gt;&lt;div class=&quot;master-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;master-copy&quot;&gt;&lt;h3 class=&quot;master-title&quot;&gt;Approval Remarks&lt;/h3&gt;&lt;p class=&quot;master-desc&quot;&gt;Review module actions, actor details, status changes, and remarks.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;master-actions&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline arrows-4-restore&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14&quot;&gt;&lt;%=approvalRemarksCount%&gt; records&lt;/span&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Report:Approval_Remarks_List&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;embed-grid report-only&quot;&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Approval Remarks List&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel-body logs-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Approval_Remarks_List&quot; zc-height=&quot;650px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;\n\n\t\t\t&lt;article class=&quot;settings-master-card&quot;&gt;&lt;div class=&quot;master-card-header&quot;&gt;&lt;div class=&quot;master-title-wrap&quot;&gt;&lt;div class=&quot;master-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-4-restore zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;master-copy&quot;&gt;&lt;h3 class=&quot;master-title&quot;&gt;Audit Log&lt;/h3&gt;&lt;p class=&quot;master-desc&quot;&gt;Review event time, event key, actor, action, old and new status, and success state.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;master-actions&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline arrows-4-restore&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14&quot;&gt;&lt;%=auditLogCount%&gt; records&lt;/span&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Report:Audit_Log_List&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;embed-grid report-only&quot;&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Audit Log List&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel-body logs-embed&quot;&gt;&lt;div zc-component=&quot;report&quot; zc-linkname=&quot;Audit_Log_List&quot; zc-height=&quot;650px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/article&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\n&lt;script&gt;\n(function(){\n\tvar tabs = document.querySelectorAll(&apos;.settings-horizontal-tabhead .zcs-horizontal-tabitem&apos;);\n\tvar links = document.querySelectorAll(&apos;.settings-horizontal-tabhead .zcs-horizontal-tablink&apos;);\n\tfunction activate(hash){\n\t\tif(!hash){hash = &apos;#settings-core&apos;;}\n\t\ttabs.forEach(function(tab){tab.classList.remove(&apos;zcs-horizontal-tabactive&apos;);});\n\t\tlinks.forEach(function(link){\n\t\t\tif(link.getAttribute(&apos;href&apos;) === hash &amp;&amp; link.parentElement){\n\t\t\t\tlink.parentElement.classList.add(&apos;zcs-horizontal-tabactive&apos;);\n\t\t\t}\n\t\t});\n\t}\n\tlinks.forEach(function(link){\n\t\tlink.addEventListener(&apos;click&apos;,function(){activate(link.getAttribute(&apos;href&apos;));});\n\t});\n\twindow.addEventListener(&apos;hashchange&apos;,function(){activate(window.location.hash);});\n\tactivate(window.location.hash);\n})();\n&lt;/script&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Training_Announcement_Home(string Section)
		{
					displayname = "Training Announcement Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Training_Announcement_Home_Snippet' elementName='Training_Announcement_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Training_Announcement_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tsection = ifnull(input.Section,&quot;Requests&quot;);\n\tif(section == &quot;&quot;)\n\t{\n\t\tsection = &quot;Requests&quot;;\n\t}\n\tif(section != &quot;Requests&quot; &amp;&amp; section != &quot;MyRequests&quot; &amp;&amp; section != &quot;Programmes&quot; &amp;&amp; section != &quot;Schedule&quot; &amp;&amp; section != &quot;Completions&quot; &amp;&amp; section != &quot;Announcements&quot; &amp;&amp; section != &quot;MyAcks&quot; &amp;&amp; section != &quot;PendingAcks&quot; &amp;&amp; section != &quot;Kanbans&quot;)\n\t{\n\t\tsection = &quot;Requests&quot;;\n\t}\n\ttargetUrl = &quot;#Report:Training_Request_List?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\tif(section == &quot;MyRequests&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:My_Training_Requests?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Programmes&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Training_Programme_List?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Schedule&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:My_Training_Schedule?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Completions&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Training_Completion_List?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Announcements&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Announcement_List?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;MyAcks&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:My_Announcement_Acknowledgements?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;PendingAcks&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Pending_Announcement_Acknowledgements?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Kanbans&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Training_Request_Kanban?zc_LoadIn=embed-trainingAnnouncementFrame&amp;zc_Header=true&quot;;\n\t}\n\topenUrl(targetUrl,&quot;same window&quot;);\n\ttodayDisplay = zoho.currentdate.toString(&quot;dd-MMM-yyyy&quot;);\n\ttrainingRequestsTotal = Training_Request[ID != 0].count();\n\tmyTrainingRequestsTotal = Training_Request[Raised_By == zoho.loginuserid || Raised_By == zoho.loginuser].count();\n\tprogrammeTotal = Training_Programme[ID != 0].count();\n\tmyScheduleTotal = Training_Programme[Assigned_Employees.Official_Email == zoho.loginuser || Assigned_Employees.Official_Email == loginEmail].count();\n\tcompletionTotal = Training_Completion[ID != 0].count();\n\tannouncementTotal = Announcement[ID != 0].count();\n\tactiveAnnouncementTotal = Announcement[Is_Active == true].count();\n\tmyAckTotal = Announcement_Acknowledgement[Employee.Official_Email == zoho.loginuser || Employee.Official_Email == loginEmail].count();\n\tpendingAckTotal = Announcement_Acknowledgement[Acknowledged == false].count();\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet subset for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#FFFFFF;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-14{padding:.875rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-8{padding-left:.5rem;padding-right:.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-0{padding-top:0;padding-bottom:0}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-18{margin-top:1.125rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component: header-heading-with-actions and button-primary-button */\n.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}\n/* ZCS component: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tabicon{width:16px;height:16px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabbody{overflow:auto}\n/* ZCS component: badge-filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ZCS component: quick-actions-icon-with-text */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:underline}.zcs-quick-action-item.zcs-card:hover .zcs-quick-action-text{text-decoration:none}\n/* ZCS component: table-simple-table */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr:first-child:hover td{border-color:var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}\n/* Training and Announcement Home layout */\n.tah-page{min-height:100%;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.tah-content{padding:24px 30px}.tah-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:18px;color:var(--zcs_brand_foreground_color);position:relative;overflow:hidden}.tah-hero:after{content:&quot;&quot;;position:absolute;right:-56px;top:-70px;width:240px;height:240px;border-radius:50%;border:44px solid rgba(255,255,255,.14)}.tah-hero-inner{position:relative;z-index:1}.tah-hero-icon{width:58px;height:58px;border-radius:16px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);color:var(--zcs_brand_foreground_color)}.tah-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.tah-kpi{background:#fff;border:1px solid #e7e7ee;border-radius:14px;padding:16px;box-sizing:border-box}.tah-kpi-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.tah-shell{display:grid;grid-template-columns:330px minmax(0,1fr);gap:18px;align-items:start;margin-top:18px}.tah-sidebar{position:sticky;top:16px}.tah-card-link{border:1px solid #ececf3;border-radius:12px;background:#fff;color:var(--zcs-primary-text-color);transition:.2s ease}.tah-card-link:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.tah-tabbar{background:#fff;border:1px solid #e7e7ee;border-radius:14px 14px 0 0}.tah-frame-wrap{background:#fff;border:1px solid #e7e7ee;border-top:0;border-radius:0 0 14px 14px;min-height:640px;overflow:hidden}.tah-frame{width:100%;min-height:640px;height:calc(100vh - 240px);overflow:auto}.tah-directory{margin-top:18px}.tah-section-title{letter-spacing:.08em}.tah-report-link{color:var(--zcs_brand_color);font-weight:500}.tah-report-link:hover{text-decoration:underline}.tah-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.tah-muted-panel{background:#F9FAFE;border:1px dashed #dfe2ee;border-radius:12px}.tah-mobile-actions{flex-wrap:wrap}.tah-quick-actions-wrapper{border-radius:14px}.tah-kanban-grid{display:grid;grid-template-columns:1fr;gap:10px}\n@media (max-width:1180px){.tah-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.tah-shell{grid-template-columns:1fr}.tah-sidebar{position:static}.tah-action-grid{grid-template-columns:1fr}}\n@media (max-width:700px){.tah-content{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.tah-mobile-actions{width:100%}.tah-mobile-actions .zcs-button{width:100%;justify-content:center}.tah-kpi-grid{grid-template-columns:1fr}.tah-hero-inner{flex-direction:column;align-items:flex-start}.tah-frame{height:650px}.tah-horizontal-tablink{padding-left:.75rem;padding-right:.75rem}}\n&lt;/style&gt;\n\n&lt;div class=&apos;tah-page&apos;&gt;\n\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Training Announcement Home&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;A unified workspace for training requests, programmes, schedules, completions, announcements, acknowledgements, and Kanban views.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 tah-mobile-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Training_Request?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Raise Training Request&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Training_Programme?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-calendar-date&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Create Programme&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Form:Announcement?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-3-megaphone&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Publish Announcement&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;tah-content&apos;&gt;\n\t\t&lt;div class=&apos;tah-hero zcs-p-24 zcs-box-border&apos;&gt;\n\t\t\t&lt;div class=&apos;tah-hero-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;tah-hero-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-font-24 zcs-font-bold zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline education-paper-diploma&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-uppercase&apos;&gt;Workspace date&lt;/span&gt;\n\t\t\t\t\t\t&lt;h4 class=&apos;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-white zcs-m-0&apos;&gt;&lt;%=todayDisplay%&gt;&lt;/h4&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14&apos;&gt;Use the tabs to load each training and announcement report in place.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline users-single-01 zcs-font-20&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-font-15 zcs-font-medium&apos;&gt;&lt;%=loginEmail%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&apos;tah-kpi-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;tah-kpi zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;tah-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;Requests&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Training Requests&lt;/span&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=trainingRequestsTotal%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;tah-kpi zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;div class=&apos;tah-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-calendar-date&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Training Programmes&lt;/span&gt;\n\t\t\t\t&lt;strong class=&apos;zcs-font-30 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=programmeTotal%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;tah-kpi zcs-flex zcs-direction-column zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;div class=&apos;tah-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-out