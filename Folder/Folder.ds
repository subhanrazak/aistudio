quick-actions-icon-with-text */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs_brand_color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:underline}.zcs-quick-action-item.zcs-card:hover .zcs-quick-action-text{text-decoration:none}\n/* ZCS component: table-simple-table */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr:first-child:hover td{border-color:var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}\n/* Attendance and Leave Home layout */\n.alh-page{min-height:100%;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.alh-hero{background:linear-gradient(135deg,var(--zcs_brand_color),var(--zcs_brand_dark_color));border-radius:18px;color:var(--zcs_brand_foreground_color);position:relative;overflow:hidden}.alh-hero:after{content:&quot;&quot;;position:absolute;right:-60px;top:-80px;width:260px;height:260px;border-radius:50%;border:48px solid rgba(255,255,255,.14)}.alh-hero-inner{position:relative;z-index:1}.alh-avatar{width:54px;height:54px;border-radius:16px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);color:var(--zcs_brand_foreground_color)}.alh-content{padding:24px 30px}.alh-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:18px}.alh-kpi{background:#fff;border:1px solid #e7e7ee;border-radius:14px;padding:16px;box-sizing:border-box}.alh-kpi-icon{width:38px;height:38px;border-radius:12px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.alh-shell{display:grid;grid-template-columns:320px minmax(0,1fr);gap:18px;align-items:start;margin-top:18px}.alh-sidebar{position:sticky;top:16px}.alh-card-link{border:1px solid #ececf3;border-radius:12px;background:#fff;color:var(--zcs-primary-text-color);transition:.2s ease}.alh-card-link:hover{border-color:var(--zcs_brand_color);background:var(--zcs_component_hover_color);color:var(--zcs_brand_color)}.alh-card-icon{width:34px;height:34px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.alh-tabbar{background:#fff;border:1px solid #e7e7ee;border-radius:14px 14px 0 0}.alh-frame-wrap{background:#fff;border:1px solid #e7e7ee;border-top:0;border-radius:0 0 14px 14px;min-height:620px;overflow:hidden}.alh-frame{width:100%;min-height:620px;height:calc(100vh - 240px);overflow:auto}.alh-section-title{letter-spacing:.08em}.alh-directory{margin-top:18px}.alh-report-link{color:var(--zcs_brand_color);font-weight:500}.alh-report-link:hover{text-decoration:underline}.alh-action-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.alh-muted-panel{background:#F9FAFE;border:1px dashed #dfe2ee;border-radius:12px}.alh-mobile-actions{flex-wrap:wrap}.alh-quick-actions-wrapper{border-radius:14px}\n@media (m