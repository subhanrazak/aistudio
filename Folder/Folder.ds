					must have Employee
					(
						type = picklist	
						values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
		    			displayformat = [Full_Name]
			 			row = 1
			 			column = 2   
						width = medium
					)
					Acknowledged
					(
		    			type = checkbox
						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Signature
					(
		    			type = signature
			 			row = 1
			 			column = 2   
						width = medium
						personal data = true
					)
					Acknowledged_Date
					(
		    			type = datetime
						displayname = "Acknowledged Date"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Application_Offer_Document
		{
		
					displayname = "Application Offer Document"
