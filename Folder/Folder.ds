le class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Area&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Component&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Open in workspace&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-8 zcs-box-border&apos; colspan=&apos;3&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Portal&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Employee_Attendance_Portal&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Page:Employee_Attendance_Portal?zc_LoadIn=embed-attendanceHomeFrame&apos;&gt;Open page&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Employee&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;My_Attendance&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:My_Attendance?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Employee&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;My_Leave_Balance&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:My_Leave_Balance?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Employee&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;My_Time_Off_Requests&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:My_Time_Off_Requests?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Employee&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;My_Regularisation_Requests&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:My_Regularisation_Requests?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Manager&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Pending_Time_Off_Requests_Manager&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Pending_Time_Off_Requests_Manager?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Manager&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Pending_Regularisation_Manager&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Pending_Regularisation_Manager?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Manager&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Team_Attendance&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Team_Attendance?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;HR&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;HR_All_Time_Off_Requests&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:HR_All_Time_Off_Requests?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;HR&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;HR_Regularisation_Queue&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:HR_Regularisation_Queue?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;HR&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Comp_Off_Awards_List&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Comp_Off_Awards_List?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Child rows&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Comp_Off_Awards_Used_List&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Comp_Off_Awards_Used_List?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Attendance_Status_Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Attendance_Status_Kanban?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Time_Off_Status_Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Time_Off_Status_Kanban?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&apos;&gt;Regularisation_Status_Kanban&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&apos;&gt;&lt;a class=&apos;alh-report-link&apos; href=&apos;#Report:Regularisation_Status_Kanban?zc_LoadIn=embed-attendanceHomeFrame&amp;amp;zc_Header=true&apos;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/main&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page CEO_Dashboard
		{
					displayname = "CEO Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='CEO_Dashboard_Snippet' elementName='CEO_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage CEO_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;CEO&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tcurrentYear = todayDate.getYear();\n\tuserName = ifnull(zoho.loginuser,&quot;CEO&quot;);\n\tuserRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(userRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(userRows.Full_Name,userName);\n\t}\n\tpendingJobCount = 0;\n\tpendingJobPositions = 0;\n\tpendingTravelCount = 0;\n\tpendingTravelCost = 0;\n\ttotalHeadcount = 0;\n\tapprovedJobsThisYear = 0;\n\tapprovedPositionsThisYear = 0;\n\tfilledPositionsThisYear = 0;\n\topenPositionsThisYear = 0;\n\tfillRatePct = 0;\n\tmaxDepartmentCount = 1;\n\tif(isAllowed == true)\n\t{\n\t\tpendingJobRows = Job_Request[Status == &quot;Pending_CEO&quot;] sort by Job_Title asc;\n\t\tpendingJobCount = pendingJobRows.count();\n\t\tfor each  jobSeed in pendingJobRows\n\t\t{\n\t\t\tpendingJobPositions = pendingJobPositions + ifnull(jobSeed.Number_Of_Positions,0);\n\t\t}\n\t\tpendingTravelRows = Travel_Request[Status == &quot;Pending_CEO&quot;] sort by Travel_From_Date asc;\n\t\tpendingTravelCount = pendingTravelRows.count();\n\t\tfor each  travelSeed in pendingTravelRows\n\t\t{\n\t\t\ttravelCostSeed = ifnull(travelSeed.Total_Estimated_Cost,0);\n\t\t\tif(travelCostSeed == 0)\n\t\t\t{\n\t\t\t\ttravelCostSeed = ifnull(travelSeed.Booking_Amount,0);\n\t\t\t}\n\t\t\tpendingTravelCost = pendingTravelCost + travelCostSeed;\n\t\t}\n\t\tactiveEmployeeRows = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;];\n\t\ttotalHeadcount = activeEmployeeRows.count();\n\t\tdepartmentRows = Department_Config[Is_Active == true] sort by Department_Name asc;\n\t\tfor each  deptSeed in departmentRows\n\t\t{\n\t\t\tdeptCountSeed = Employee_Master[Department == deptSeed.ID &amp;&amp; Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;].count();\n\t\t\tif(deptCountSeed &gt; maxDepartmentCount)\n\t\t\t{\n\t\t\t\tmaxDepartmentCount = deptCountSeed;\n\t\t\t}\n\t\t}\n\t\tapprovedYearRows = Job_Request[Status == &quot;Approved&quot; &amp;&amp; Approved_Date != null] sort by Approved_Date desc;\n\t\tfor each  recruitJobSeed in approvedYearRows\n\t\t{\n\t\t\tif(recruitJobSeed.Approved_Date.getYear() == currentYear)\n\t\t\t{\n\t\t\t\tapprovedJobsThisYear = approvedJobsThisYear + 1;\n\t\t\t\tapprovedPositionsThisYear = approvedPositionsThisYear + ifnull(recruitJobSeed.Number_Of_Positions,0);\n\t\t\t\tfilledForJob = Job_Application[Job_Request == recruitJobSeed.ID &amp;&amp; Status == &quot;Joined&quot;].count();\n\t\t\t\tfilledPositionsThisYear = filledPositionsThisYear + filledForJob;\n\t\t\t}\n\t\t}\n\t\topenPositionsThisYear = approvedPositionsThisYear - filledPositionsThisYear;\n\t\tif(openPositionsThisYear &lt; 0)\n\t\t{\n\t\t\topenPositionsThisYear = 0;\n\t\t}\n\t\tif(approvedPositionsThisYear &gt; 0)\n\t\t{\n\t\t\tfillRatePct = (filledPositionsThisYear * 100) / approvedPositionsThisYear;\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for CEO_Dashboard (utility subset used by this page) ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-w-full { width: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions */\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: progress-bar-range-bar-with-text */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F7); overflow: hidden; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n/* ZCS component CSS: button-primary-button and button-primary-outline-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }\n.ceodash-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }\n.ceo-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1C1C40); }\n.ceo-hero:after { content: &quot;&quot;; position: absolute; right: -80px; top: -110px; width: 310px; height: 310px; border-radius: 50%; border: 42px solid rgba(255,255,255,.12); }\n.ceo-hero:before { content: &quot;&quot;; position: absolute; right: 170px; bottom: -88px; width: 190px; height: 190px; border-radius: 50%; border: 28px solid rgba(255,255,255,.10); }\n.ceo-hero-content { position: relative; z-index: 1; }\n.ceo-dash-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.ceo-kpi { grid-column: span 3; } .ceo-card-4 { grid-column: span 4; } .ceo-card-5 { grid-column: span 5; } .ceo-card-6 { grid-column: span 6; } .ceo-card-7 { grid-column: span 7; } .ceo-card-8 { grid-column: span 8; } .ceo-card-12 { grid-column: span 12; }\n.ceo-mini-stat { border: 1px solid var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; padding: 12px; }\n.ceo-bar-row { display: grid; grid-template-columns: 148px 1fr 60px; gap: 10px; align-items: center; }\n.ceo-segment { border-radius: 999px; background: #EEF2F7; height: 10px; overflow: hidden; }\n.ceo-segment span { display: block; height: 100%; background: var(--zcs-theme-brand-color); border-radius: inherit; }\n.ceo-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }\n.ceo-note { border-left: 4px solid #FAAE13; background: #FFF9EA; border-radius: 10px; }\n.ceo-actions { flex-wrap: wrap; }\n@media (max-width: 1100px) { .ceo-kpi, .ceo-card-4, .ceo-card-5, .ceo-card-6, .ceo-card-7, .ceo-card-8 { grid-column: span 6; } }\n@media (max-width: 700px) { .ceodash-page { padding: 14px; } .ceo-kpi, .ceo-card-4, .ceo-card-5, .ceo-card-6, .ceo-card-7, .ceo-card-8, .ceo-card-12 { grid-column: span 12; } .ceo-bar-row { grid-template-columns: 1fr; } .zcs-page-header { padding: 14px; align-items: flex-start; flex-direction: column; } }\n&lt;/style&gt;\n&lt;div class=&quot;ceodash-page zcs-flex zcs-direction-column zcs-gap-20&quot;&gt;\n&lt;%\n\tif(isAllowed == false)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center ceo-nodata&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-8&quot;&gt;Access restricted&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;CEO Dashboard is available to CEO and Administrator profiles.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ceo-hero&quot;&gt;\n\t\t&lt;div class=&quot;ceo-hero-content zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-20&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium zcs-lh-body&quot;&gt;Executive HR command center&lt;/span&gt;\n\t\t\t\t&lt;h3 class=&quot;zcs-font-30 zcs-font-semibold zcs-lh-heading zcs-m-0&quot;&gt;Hello &lt;%=userName%&gt;&lt;/h3&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-lh-body zcs-m-0&quot;&gt;Live approval queues, organisation headcount, and &lt;%=currentYear%&gt; recruitment position fulfilment.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-6 zcs-text-right&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-medium&quot;&gt;Updated&lt;/span&gt;\n\t\t\t\t&lt;strong class=&quot;zcs-font-18 zcs-lh-heading&quot;&gt;&lt;%=todayDisplay%&gt;&lt;/strong&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;i class=&quot;zcs-color-theme zcs-font-22 zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;CEO approvals and HR summary&lt;/h5&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 ceo-actions&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Pending_CEO_Job_Requests?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Job approvals&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_All_Travel?Status=Pending_CEO&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline transport_air-baloon&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Travel queue&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;ceo-dash-grid&quot;&gt;\n\t\t&lt;div class=&quot;ceo-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending job requests&lt;/span&gt;\n\t\t\t&lt;strong class=&quot;zcs-font-30 zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=pendingJobCount%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=pendingJobPositions%&gt; positions awaiting CEO decision&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ceo-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending travel approvals&lt;/span&gt;\n\t\t\t&lt;strong class=&quot;zcs-font-30 zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=pendingTravelCount%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Estimated INR &lt;%=pendingTravelCost%&gt;&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ceo-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Current headcount&lt;/span&gt;\n\t\t\t&lt;strong class=&quot;zcs-font-30 zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=totalHeadcount%&gt;&lt;/strong&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Active and probation employees&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ceo-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=currentYear%&gt; recruitment fill rate&lt;/span&gt;\n\t\t\t&lt;strong class=&quot;zcs-font-30 zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=fillRatePct%&gt;%&lt;/strong&gt;\n\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=fillRatePct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0&quot;&gt;&lt;strong class=&quot;zcs-color-theme&quot;&gt;&lt;%=filledPositionsThisYear%&gt;&lt;/strong&gt; filled of &lt;%=approvedPositionsThisYear%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ceo-card-7 zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending Job Request approvals&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Open the approval report for CEO approve and reject actions.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Pending_CEO_Job_Requests?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingJobCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center ceo-nodata&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-8&quot;&gt;No pending job approvals&lt;/h5&gt;&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Recruitment requests requiring CEO action will appear here.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Job title&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Department&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Positions&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\tshownJobs = 0;\n\t\t\tfor each  jobItem in pendingJobRows\n\t\t\t{\n\t\t\t\tif(shownJobs &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tjobReportUrl = &quot;#Report:Pending_CEO_Job_Requests?ID=&quot; + jobItem.ID + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;;\n\t\t\t\t\tdeptName = ifnull(jobItem.Department.Department_Name,&quot;-&quot;);\n\t\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=jobItem.Job_Title%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;&lt;%=deptName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(jobItem.Number_Of_Positions,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;zcs-color-theme&quot; href=&quot;&lt;%=jobReportUrl%&gt;&quot;&gt;Open action report&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\t\tshownJobs = shownJobs + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ceo-note zcs-p-12 zcs-box-border zcs-font-13 zcs-color-secondary&quot;&gt;Approval_Remarks is reachable from this page. The current Approval_Remarks form has Travel links but no linked Job_Request field, so Job_Request decisions use the existing Pending_CEO_Job_Requests report actions.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ceo-card-5 zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending Travel Request approvals&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Approve or reject via Approval_Remarks.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_All_Travel?Status=Pending_CEO&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingTravelCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center ceo-nodata&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-8&quot;&gt;No pending travel approvals&lt;/h5&gt;&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Manager-approved travel requests will appear here for CEO review.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n&lt;%\n\t\t\tshownTravel = 0;\n\t\t\tfor each  tripItem in pendingTravelRows\n\t\t\t{\n\t\t\t\tif(shownTravel &lt; 5)\n\t\t\t\t{\n\t\t\t\t\ttravelApproveUrl = &quot;#Form:Approval_Remarks?Module=Travel&amp;amp;Action=Approved&amp;amp;Linked_Travel_Request=&quot; + tripItem.ID + &quot;&amp;amp;Previous_Status=&quot; + tripItem.Status + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;;\n\t\t\t\t\ttravelRejectUrl = &quot;#Form:Approval_Remarks?Module=Travel&amp;amp;Action=Rejected&amp;amp;Linked_Travel_Request=&quot; + tripItem.ID + &quot;&amp;amp;Previous_Status=&quot; + tripItem.Status + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;;\n\t\t\t\t\ttravelDateText = &quot;-&quot;;\n\t\t\t\t\tif(tripItem.Travel_From_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\ttravelDateText = tripItem.Travel_From_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\temployeeName = ifnull(tripItem.Employee.Full_Name,&quot;-&quot;);\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;ceo-mini-stat zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;strong class=&quot;zcs-font-15 zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=tripItem.Destination%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary zcs-ellipsis&quot;&gt;&lt;%=employeeName%&gt; \u00B7 &lt;%=travelDateText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Pending CEO&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 ceo-actions&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=travelApproveUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Approve&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=travelRejectUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;span&gt;Reject&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t\tshownTravel = shownTravel + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ceo-card-6 zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Headcount by department&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Active and probation employees.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:All_Employees?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open employees&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(totalHeadcount == 0 || departmentRows.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center ceo-nodata&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mb-8&quot;&gt;No headcount data&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n&lt;%\n\t\t\tfor each  deptItem in departmentRows\n\t\t\t{\n\t\t\t\tdeptCount = Employee_Master[Department == deptItem.ID &amp;&amp; Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;].count();\n\t\t\t\tdeptPct = 0;\n\t\t\t\tif(maxDepartmentCount &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tdeptPct = (deptCount * 100) / maxDepartmentCount;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;ceo-bar-row&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=deptItem.Department_Name%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;ceo-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=deptPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;strong class=&quot;zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=deptCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ceo-card-6 zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Recruitment summary for &lt;%=currentYear%&gt;&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;Open versus filled approved positions.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Job_Request_List?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open jobs&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-row zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ceo-mini-stat zcs-flex zcs-direction-column zcs-gap-4&quot; style=&quot;flex:1; min-width:150px;&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Approved jobs&lt;/span&gt;&lt;strong class=&quot;zcs-font-24 zcs-color-primary&quot;&gt;&lt;%=approvedJobsThisYear%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ceo-mini-stat zcs-flex zcs-direction-column zcs-gap-4&quot; style=&quot;flex:1; min-width:150px;&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Approved positions&lt;/span&gt;&lt;strong class=&quot;zcs-font-24 zcs-color-primary&quot;&gt;&lt;%=approvedPositionsThisYear%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ceo-mini-stat zcs-flex zcs-direction-column zcs-gap-4&quot; style=&quot;flex:1; min-width:150px;&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Filled positions&lt;/span&gt;&lt;strong class=&quot;zcs-font-24 zcs-color-green&quot;&gt;&lt;%=filledPositionsThisYear%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;ceo-mini-stat zcs-flex zcs-direction-column zcs-gap-4&quot; style=&quot;flex:1; min-width:150px;&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Open positions&lt;/span&gt;&lt;strong class=&quot;zcs-font-24 zcs-color-yellow&quot;&gt;&lt;%=openPositionsThisYear%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=fillRatePct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0&quot;&gt;&lt;strong class=&quot;zcs-color-theme&quot;&gt;&lt;%=fillRatePct%&gt;%&lt;/strong&gt; position fill rate&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 ceo-actions&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Active_Job_Applications?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span&gt;Applications&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Approval_Remarks_List?Module=Travel&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-paper&quot;&gt;&lt;/i&gt;&lt;span&gt;Approval remarks&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Pending_Job_Approvals_Report' title='Pending CEO Job Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Pending_CEO_Job_Requests' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Pending_Travel_Approvals_Report' title='Pending CEO Travel Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_All_Travel' criteriaString='Status == &quot;Pending_CEO&quot;' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Candidate_Detail(int candidate_id)
		{
					displayname = "Candidate Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Candidate_Detail_Snippet' elementName='Candidate_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Candidate_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tcandidateRows = Candidate[ID == input.candidate_id];\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for this page */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-stretch{align-items:stretch}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n\n/* ZCS component CSS: button-primary-button / header-heading-with-actions */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}\n\n/* ZCS component CSS: card-user-detail-card */\n.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg{background-color:#F9FAFE}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#FF7E52}.zcs-labelvalue-wrapper .zcs-labelvalue-color-red{color:#FE455D}\n\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n\n/* Candidate Detail custom layout */\n.candidate-detail-page{min-height:100%;background:var(--zcs-page-bg-color,#F3F3F4);color:var(--zcs-primary-text-color);font-family:inherit}.candidate-detail-content{padding:24px 30px}.candidate-grid{display:grid;grid-template-columns:minmax(280px,360px) 1fr;gap:20px;align-items:start}.candidate-profile-card{position:sticky;top:16px}.candidate-avatar-initial{color:var(--zcs_brand_foreground_color);font-size:30px;font-weight:700}.metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.metric-card{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:16px}.metric-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.application-card{background:#fff;border:1px solid #e7e7ee;border-radius:14px;overflow:hidden;box-shadow:0 2px 10px rgba(18,19,43,.04)}.application-card+.application-card{margin-top:16px}.application-head{background:linear-gradient(90deg,var(--zcs_brand_light_color),#fff);border-bottom:1px solid #ececf3}.detail-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.detail-item{background:#F9FAFE;border:1px solid #eef0f6;border-radius:10px;padding:12px}.feedback-card{border:1px solid #eaecf4;border-radius:12px;background:#fcfcff}.feedback-timeline{width:34px;display:flex;justify-content:center}.feedback-dot{width:12px;height:12px;border-radius:50%;background:var(--zcs_brand_color);margin-top:6px}.notes-box{white-space:pre-wrap;color:var(--zcs-primary-text-color)}.related-card{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px}.related-link{border:1px solid #ececf3;border-radius:10px;color:var(--zcs-primary-text-color);background:#fff}.related-link:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.empty-state{min-height:260px;background:#fff;border:1px solid #e7e7ee;border-radius:14px}.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.zcs-page-header .zcs-button{white-space:nowrap}.quick-actions{flex-wrap:wrap}.mobile-only-break{display:none}\n@media (max-width:1100px){.candidate-grid{grid-template-columns:1fr}.candidate-profile-card{position:static}.detail-list{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-row{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media (max-width:700px){.candidate-detail-content{padding:16px}.zcs-page-header{padding:16px}.detail-list,.metric-row{grid-template-columns:1fr}.application-head{align-items:flex-start;flex-direction:column}.quick-actions{width:100%}.zcs-page-header .quick-actions .zcs-button{width:100%;justify-content:center}.mobile-only-break{display:block}}\n&lt;/style&gt;\n\n&lt;div class=&quot;candidate-detail-page&quot;&gt;\n&lt;%\n\tif(candidateRows.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Candidate 360-degree View&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No candidate was found for the supplied page parameter.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Candidate_List?zc_LoadIn=dialog&amp;zc_Header=true&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Candidate List&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;candidate-detail-content&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-40&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Candidate not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Open this page with a valid candidate_id to view candidate details, applications, and interview feedback.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tcand = candidateRows;\n\t\tcandidateName = ifnull(cand.Candidate_Name,&quot;Candidate&quot;);\n\t\tcandidateInitial = candidateName.left(1);\n\t\tcandidateEmail = ifnull(cand.Email,&quot;-&quot;);\n\t\tcandidatePhone = ifnull(cand.Phone,&quot;-&quot;);\n\t\tcandidateSource = ifnull(cand.Source,&quot;-&quot;);\n\t\treferredBy = ifnull(cand.Referred_By,&quot;-&quot;);\n\t\tagencyName = ifnull(cand.Agency,&quot;-&quot;);\n\t\tpoolStatus = &quot;No&quot;;\n\t\tpoolBadge = &quot;zcs-badge-grey&quot;;\n\t\tif(ifnull(cand.Is_In_Pool,false) == true)\n\t\t{\n\t\t\tpoolStatus = &quot;In Talent Pool&quot;;\n\t\t\tpoolBadge = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\tpoolNotes = ifnull(cand.Pool_Notes,&quot;-&quot;);\n\t\tapplications = Job_Application[Candidate == cand.ID] sort by Application_Date desc;\n\t\tapplicationCount = applications.count();\n\t\tfeedbackCount = 0;\n\t\tselectedCount = 0;\n\t\tactiveCount = 0;\n\t\tlatestStatus = &quot;-&quot;;\n\t\tfirstAppSeen = false;\n\t\tfor each  appCountRow in applications\n\t\t{\n\t\t\tif(firstAppSeen == false)\n\t\t\t{\n\t\t\t\tlatestStatus = ifnull(appCountRow.Status,&quot;-&quot;);\n\t\t\t\tfirstAppSeen = true;\n\t\t\t}\n\t\t\tif(appCountRow.Status == &quot;Selected&quot;)\n\t\t\t{\n\t\t\t\tselectedCount = selectedCount + 1;\n\t\t\t}\n\t\t\tif(appCountRow.Status == &quot;Active&quot; || appCountRow.Status == &quot;On_Hold&quot;)\n\t\t\t{\n\t\t\t\tactiveCount = activeCount + 1;\n\t\t\t}\n\t\t\tfeedbackCount = feedbackCount + Interview_Feedback[Job_Application == appCountRow.ID].count();\n\t\t}\n\t\tactiveApplicationsUrl = &quot;#Report:Active_Job_Applications?Candidate=&quot; + cand.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\thistoryUrl = &quot;#Report:Job_Application_History?Candidate=&quot; + cand.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\tfeedbackUrl = &quot;#Report:Interview_Feedback_List?zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\tcandidateListUrl = &quot;#Report:Candidate_List?ID=&quot; + cand.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:48px;--zcs-avatar-radius:12px&apos;&gt;\n\t\t\t\t&lt;span class=&apos;candidate-avatar-initial&apos;&gt;&lt;%=candidateInitial%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=candidateName%&gt;&lt;/h5&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary zcs-ellipsis&apos;&gt;Candidate 360-degree view with applications and feedback history&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=activeApplicationsUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Active Applications&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=historyUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Application History&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;candidate-detail-content&apos;&gt;\n\t\t&lt;div class=&apos;candidate-grid&apos;&gt;\n\t\t\t&lt;aside class=&apos;candidate-profile-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:75px;--zcs-avatar-radius:14px&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;candidate-avatar-initial&apos;&gt;&lt;%=candidateInitial%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-col-common zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=candidateName%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=candidateEmail%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=candidatePhone%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper&apos;&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;zcs-row zcs-gap-16 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Source&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=candidateSource%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Referred By&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=referredBy%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Agency&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=agencyName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Talent Pool&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=poolBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=poolStatus%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Pool Notes&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=poolNotes%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;related-card zcs-mt-16&apos;&gt;\n\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Related reports&lt;/h6&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-10 zcs-mt-12&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=activeApplicationsUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;span&gt;Active Job Applications&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=historyUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span&gt;Job Application History&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=feedbackUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline education-paper&apos;&gt;&lt;/i&gt;&lt;span&gt;Interview Feedback List&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=candidateListUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;&lt;span&gt;Candidate List&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\n\t\t\t&lt;main class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;metric-row&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;metric-card zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04 zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=applicationCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Applications&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;metric-card zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline education-paper zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=feedbackCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Feedback entries&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;metric-card zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-20&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-24 zcs-font-bold zcs-color-primary&apos;&gt;&lt;%=selectedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Selected outcomes&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;section class=&apos;zcs-flex zcs-direction-column zcs-gap-12&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Applications and feedback history&lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Rows are fetched live from Job_Application, descending by Application_Date.&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;Latest status: &lt;%=latestStatus%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(applicationCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline files-single-copy-04 zcs-font-40&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No applications yet&lt;/h5&gt;\n\t\t\t\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;This candidate has no Job_Application rows. Use the related reports to review all active applications.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tfor each  app in applications\n\t\t\t{\n\t\t\t\tjobTitle = &quot;-&quot;;\n\t\t\t\tjobDepartment = &quot;-&quot;;\n\t\t\t\tjobRows = Job_Request[ID == app.Job_Request];\n\t\t\t\tif(jobRows.count() &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tjobTitle = ifnull(jobRows.Job_Title,&quot;-&quot;);\n\t\t\t\t\tjobDepartment = ifnull(jobRows.Department,&quot;-&quot;);\n\t\t\t\t}\n\t\t\t\tappDate = &quot;-&quot;;\n\t\t\t\tif(app.Application_Date != null)\n\t\t\t\t{\n\t\t\t\t\tappDate = app.Application_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\tofferDate = &quot;-&quot;;\n\t\t\t\tif(app.Offer_Accepted_Date != null)\n\t\t\t\t{\n\t\t\t\t\tofferDate = app.Offer_Accepted_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\tappStatus = ifnull(app.Status,&quot;-&quot;);\n\t\t\t\tappStatusLabel = appStatus.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\t\t\tappBadge = &quot;zcs-badge-theme&quot;;\n\t\t\t\tif(appStatus == &quot;Selected&quot;)\n\t\t\t\t{\n\t\t\t\t\tappBadge = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatus == &quot;Rejected&quot;)\n\t\t\t\t{\n\t\t\t\t\tappBadge = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatus == &quot;On_Hold&quot;)\n\t\t\t\t{\n\t\t\t\t\tappBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t}\n\t\t\t\telse if(appStatus == &quot;Active&quot;)\n\t\t\t\t{\n\t\t\t\t\tappBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t}\n\t\t\t\tappFeedbackUrl = &quot;#Report:Interview_Feedback_List?Job_Application=&quot; + app.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t\tapplicationReportUrl = &quot;#Report:Job_Application_History?ID=&quot; + app.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t\tfeedbackRows = Interview_Feedback[Job_Application == app.ID] sort by Feedback_Date desc;\n\t\t\t\t%&gt;\n&lt;article class=&apos;application-card&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;application-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-18 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0 zcs-ellipsis&apos;&gt;&lt;%=jobTitle%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary zcs-ellipsis&apos;&gt;Application &lt;%=app.ID%&gt; \u00B7 &lt;%=jobDepartment%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10 quick-actions&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=appBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=appStatusLabel%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=applicationReportUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open row&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-p-18 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;detail-list&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;detail-item&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold&apos;&gt;Application Date&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=appDate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;detail-item&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold&apos;&gt;Current Round&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(app.Current_Round,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;detail-item&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold&apos;&gt;Source&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(app.Source_Of_Application,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;detail-item&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold&apos;&gt;Offer Accepted&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=offerDate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mt-20&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Interview feedback&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;%=feedbackRows.count()%&gt; feedback row(s) for this application&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=appFeedbackUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline education-paper&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Feedback report&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\tif(feedbackRows.count() == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div class=&apos;feedback-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-mt-12 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-20 zcs-color-tertiary&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No Interview_Feedback rows have been recorded for this application.&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tfor each  fb in feedbackRows\n\t\t\t\t\t{\n\t\t\t\t\t\tfbDate = &quot;-&quot;;\n\t\t\t\t\t\tif(fb.Feedback_Date != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfbDate = fb.Feedback_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t}\n\t\t\t\t\t\trecommendation = ifnull(fb.Recommendation,&quot;-&quot;);\n\t\t\t\t\t\trecommendationLabel = recommendation.replaceAll(&quot;_&quot;,&quot; &quot;);\n\t\t\t\t\t\trecommendationBadge = &quot;zcs-badge-theme&quot;;\n\t\t\t\t\t\tif(recommendation == &quot;Select&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trecommendationBadge = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(recommendation == &quot;Reject&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trecommendationBadge = &quot;zcs-badge-red&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(recommendation == &quot;On_Hold&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trecommendationBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(recommendation == &quot;Next_Round&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\trecommendationBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfeedbackNotes = ifnull(fb.Feedback_Notes,&quot;-&quot;);\n\t\t\t\t\t\t%&gt;\n&lt;div class=&apos;feedback-card zcs-flex zcs-align-items-start zcs-gap-12 zcs-p-16 zcs-mt-12 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;feedback-timeline zcs-no-shrink&apos;&gt;&lt;span class=&apos;feedback-dot&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-col-common&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Round &lt;%=ifnull(fb.Round_Number,&quot;-&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Panel member: &lt;%=ifnull(fb.Panel_Member,&quot;-&quot;)%&gt; \u00B7 &lt;%=fbDate%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=recommendationBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=recommendationLabel%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;notes-box zcs-font-14 zcs-lh-body zcs-mt-12&apos;&gt;&lt;%=feedbackNotes%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\t\t\t&lt;/main&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Convert_To_Employee(string convert_submit, string date_of_birth, string date_of_joining, string department, string designation, string employment_type, string gender, int job_application_id, string primary_manager, string probation_end_date, string tenure_date)
		{
					displayname = "Convert To Employee"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Convert_To_Employee_Snippet' elementName='Convert_To_Employee_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Convert_To_Employee_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tjobApplicationParam = input.job_application_id;\n\tappRows = Job_Application[ID == jobApplicationParam];\n\tsubmitted = ifnull(input.convert_submit,&quot;&quot;);\n\tconversionMessage = &quot;&quot;;\n\tconversionSuccess = false;\n\tnewEmployeeId = null;\n\tnewEmployeeUrl = &quot;&quot;;\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#FFFFFF;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-stretch{align-items:stretch}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mt-24{margin-top:1.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS: button-primary-button / button-primary-outline-button / header-heading-with-actions */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}\n/* ZCS component CSS: card-profile-card */\n.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ZCS component CSS: stepper-in-progress */\n.zcs-stepper-status{width:32px;height:32px;background-color:var(--zcs_brand_color);border:4px solid var(--zcs-white-color)}.zcs-stepper-count{border:1px solid var(--zcs_tertiary_border_color);display:none}.zcs-stepper-icon.zcs-stepper-failed{display:none}.zcs-stepper-level{display:none;background-color:var(--zcs_brand_color)}.zcs-stepper:not(:last-child):before{content:&apos;&apos;;width:100%;height:1px;border-top:1px solid var(--zcs_brand_color);box-sizing:border-box;position:absolute;top:calc((32px - 1px)/2);left:50%}.zcs-stepper-active .zcs-stepper-status{border:1px solid var(--zcs_brand_color);outline:4px solid var(--zcs-white-color);background-color:var(--zcs-white-color)}.zcs-stepper-active .zcs-stepper-count{display:flex;border-width:0;color:var(--zcs_brand_color)}.zcs-stepper-active .zcs-stepper-icon{display:none}.zcs-stepper-active .zcs-stepper-text{font-weight:500;color:var(--zcs_brand_color)}.zcs-stepper.zcs-stepper-active:before,.zcs-stepper.zcs-stepper-active~.zcs-stepper:before{border-color:var(--zcs_tertiary_border_color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-status{background-color:var(--zcs-white-color)}.zcs-stepper-active~.zcs-stepper .zcs-stepper-count{display:flex}.zcs-stepper-active~.zcs-stepper .zcs-stepper-icon{display:none}.zcs-stepper-active~.zcs-stepper .zcs-stepper-text{color:var(--zcs_tertiary_text_color)}\n/* ZCS component CSS: no-data-no-data-with-button uses button CSS above */\n.convert-page{min-height:100%;background:var(--zcs-page-bg-color,#F3F3F4);color:var(--zcs-primary-text-color);font-family:inherit}.convert-content{padding:24px 30px}.quick-actions{flex-wrap:wrap}.candidate-avatar-initial{color:var(--zcs_brand_foreground_color);font-size:28px;font-weight:700}.convert-grid{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:20px;align-items:start}.profile-card{position:sticky;top:16px}.summary-list{display:grid;grid-template-columns:1fr;gap:12px}.summary-item{background:#F9FAFE;border:1px solid #eef0f6;border-radius:10px;padding:12px}.form-card{background:#fff;border:1px solid #e7e7ee;border-radius:14px;box-shadow:0 2px 10px rgba(18,19,43,.04);overflow:hidden}.form-head{background:linear-gradient(90deg,var(--zcs_brand_light_color),#fff);border-bottom:1px solid #ececf3}.input-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field-block{display:flex;flex-direction:column;gap:7px}.field-block label{font-size:13px;color:var(--zcs-teritiary-text-color)}.field-block input,.field-block select{height:40px;border:1px solid var(--zcs-border-color,#d8dbe6);border-radius:8px;background:#fff;color:var(--zcs-primary-text-color);font:inherit;padding:0 12px;box-sizing:border-box}.field-block input:focus,.field-block select:focus{outline:2px solid var(--zcs_brand_color);outline-offset:1px}.field-help{font-size:12px;color:var(--zcs-secondary-text-color)}.required-mark{color:#FE455D}.conversion-banner{border-radius:12px;padding:14px 16px;border:1px solid}.conversion-banner.success{background:#E4FCF3;border-color:#179E6C;color:#0F704D}.conversion-banner.error{background:#FDE3E6;border-color:#FE455D;color:#A60E25}.conversion-banner.info{background:#E8EFFF;border-color:#2A6FFC;color:#19499E}.stepper-wrap{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px}.empty-state{min-height:290px;background:#fff;border:1px solid #e7e7ee;border-radius:14px}.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.submit-row{border-top:1px solid #ececf3;background:#fcfcff}.disabled-note{background:#FCF4E6;border:1px solid #FAAE13;color:#7E5608;border-radius:10px;padding:12px}.related-link{border:1px solid #ececf3;border-radius:10px;color:var(--zcs-primary-text-color);background:#fff}.related-link:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.hidden-field{display:none!important}\n@media (max-width:1100px){.convert-grid{grid-template-columns:1fr}.profile-card{position:static}.input-grid{grid-template-columns:1fr}.zcs-stepper-wrapper ul{flex-direction:column;gap:24px}.zcs-stepper-wrapper ul .zcs-stepper{flex-direction:row;gap:16px}.zcs-stepper:not(:last-child):before{width:1px;height:100%;border-left:1px solid var(--zcs_brand_color);border-top:0;left:calc((32px - 1px)/2)}}\n@media (max-width:700px){.convert-content{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.quick-actions{width:100%}.zcs-page-header .quick-actions .zcs-button{width:100%;justify-content:center}.submit-row{align-items:stretch;flex-direction:column}.submit-row .zcs-button,.submit-row button{width:100%}}\n&lt;/style&gt;\n\n&lt;div class=&quot;convert-page&quot;&gt;\n&lt;%\n\tif(appRows.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Convert Candidate to Employee&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No job application was found for the supplied page parameter.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Active_Job_Applications?zc_LoadIn=dialog&amp;zc_Header=true&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Active Applications&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;convert-content&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-40&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Application not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Open this page with a valid job_application_id to start employee conversion.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tapp = appRows;\n\t\tcandidateRows = Candidate[ID == app.Candidate];\n\t\tif(candidateRows.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Convert Candidate to Employee&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;The selected job application does not have a reachable candidate.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;convert-content&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline users-single-01 zcs-font-40&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Candidate missing&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Review the job application and candidate records before converting.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tcand = candidateRows;\n\t\t\tjobRows = Job_Request[ID == app.Job_Request];\n\t\t\tcandidateName = ifnull(cand.Candidate_Name,&quot;Candidate&quot;);\n\t\t\tcandidateInitial = candidateName.left(1);\n\t\t\tcandidateEmail = ifnull(cand.Email,&quot;&quot;);\n\t\t\tcandidatePhone = ifnull(cand.Phone,&quot;-&quot;);\n\t\t\tjobTitle = &quot;-&quot;;\n\t\t\tjobDepartmentId = null;\n\t\t\tjobDepartmentName = &quot;-&quot;;\n\t\t\tif(jobRows.count() &gt; 0)\n\t\t\t{\n\t\t\t\tjobTitle = ifnull(jobRows.Job_Title,&quot;-&quot;);\n\t\t\t\tjobDepartmentId = jobRows.Department;\n\t\t\t\tjobDepartmentName = ifnull(jobRows.Department,&quot;-&quot;);\n\t\t\t}\n\t\t\texistingEmployees = Employee_Master[Official_Email == candidateEmail];\n\t\t\texistingEmployeeFound = existingEmployees.count() &gt; 0;\n\t\t\talreadyJoined = app.Status == &quot;Joined&quot;;\n\t\t\tcanConvert = app.Status == &quot;Offer_Accepted&quot; &amp;&amp; existingEmployeeFound == false;\n\t\t\ttodayString = zoho.currentdate.toString(&quot;yyyy-MM-dd&quot;);\n\t\t\tdefaultDoj = todayString;\n\t\t\tdefaultTenure = todayString;\n\t\t\tdefaultProbation = zoho.currentdate.addDay(90).toString(&quot;yyyy-MM-dd&quot;);\n\t\t\tstatusBadge = &quot;zcs-badge-blue&quot;;\n\t\t\tif(app.Status == &quot;Offer_Accepted&quot;)\n\t\t\t{\n\t\t\t\tstatusBadge = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(app.Status == &quot;Joined&quot;)\n\t\t\t{\n\t\t\t\tstatusBadge = &quot;zcs-badge-theme&quot;;\n\t\t\t}\n\t\t\telse if(app.Status == &quot;Rejected&quot;)\n\t\t\t{\n\t\t\t\tstatusBadge = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(app.Status == &quot;On_Hold&quot;)\n\t\t\t{\n\t\t\t\tstatusBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\tsubmitted = ifnull(input.convert_submit,&quot;&quot;);\n\t\t\tif(submitted == &quot;1&quot;)\n\t\t\t{\n\t\t\t\temploymentType = ifnull(input.employment_type,&quot;&quot;);\n\t\t\t\tdojRaw = ifnull(input.date_of_joining,&quot;&quot;);\n\t\t\t\tdepartmentRaw = ifnull(input.department,&quot;&quot;);\n\t\t\t\tdesignationRaw = ifnull(input.designation,&quot;&quot;);\n\t\t\t\tmanagerRaw = ifnull(input.primary_manager,&quot;&quot;);\n\t\t\t\tprobationRaw = ifnull(input.probation_end_date,&quot;&quot;);\n\t\t\t\tdobRaw = ifnull(input.date_of_birth,&quot;&quot;);\n\t\t\t\tgenderRaw = ifnull(input.gender,&quot;&quot;);\n\t\t\t\ttenureRaw = ifnull(input.tenure_date,&quot;&quot;);\n\t\t\t\tif(tenureRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\ttenureRaw = dojRaw;\n\t\t\t\t}\n\t\t\t\tvalidationMessage = &quot;&quot;;\n\t\t\t\tif(canConvert == false)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;This application is not eligible for conversion. It must be Offer_Accepted and must not already have an employee with the candidate email. &quot;;\n\t\t\t\t}\n\t\t\t\tif(employmentType == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Employment type is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(dojRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Date of joining is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(departmentRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Department is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(designationRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Designation is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(probationRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Probation end date is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(dobRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Date of birth is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(genderRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Gender is required. &quot;;\n\t\t\t\t}\n\t\t\t\tif(tenureRaw == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Tenure date is required. &quot;;\n\t\t\t\t}\n\t\t\t\tdepartmentId = null;\n\t\t\t\tif(departmentRaw != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tif(departmentRaw.isNumber())\n\t\t\t\t\t{\n\t\t\t\t\t\tdepartmentId = departmentRaw.toNumber();\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;Selected department value is invalid. &quot;;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdeptRows = Department_Config[ID == departmentId];\n\t\t\t\tif(departmentRaw != &quot;&quot; &amp;&amp; deptRows.count() == 0)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;Selected department is not available. &quot;;\n\t\t\t\t}\n\t\t\t\tmanagerId = null;\n\t\t\t\tif(managerRaw != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tif(managerRaw.isNumber())\n\t\t\t\t\t{\n\t\t\t\t\t\tmanagerId = managerRaw.toNumber();\n\t\t\t\t\t\tmanagerRows = Employee_Master[ID == managerId];\n\t\t\t\t\t\tif(managerRows.count() == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;Selected primary manager is not available. &quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tmanagerId = managerRows.ID;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;Selected primary manager value is invalid. &quot;;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdojValue = null;\n\t\t\t\tprobationValue = null;\n\t\t\t\tdobValue = null;\n\t\t\t\ttenureValue = null;\n\t\t\t\ttry \n\t\t\t\t{\n\t\t\t\t\tif(dojRaw != &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tdojValue = dojRaw.toDate(&quot;yyyy-MM-dd&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tif(probationRaw != &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tprobationValue = probationRaw.toDate(&quot;yyyy-MM-dd&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tif(dobRaw != &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tdobValue = dobRaw.toDate(&quot;yyyy-MM-dd&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tif(tenureRaw != &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\ttenureValue = tenureRaw.toDate(&quot;yyyy-MM-dd&quot;);\n\t\t\t\t\t}\n\t\t\t\t}\t\t\t\tcatch (dateErr)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;One or more date values are invalid. &quot;;\n\t\t\t\t}\n\t\t\t\tnoticeRows = Notice_Period_Config[Employment_Type == employmentType &amp;&amp; Is_Active == true] sort by Effective_From desc;\n\t\t\t\tif(noticeRows.count() == 0 &amp;&amp; employmentType != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tvalidationMessage = validationMessage + &quot;No active notice period configuration exists for &quot; + employmentType + &quot;. &quot;;\n\t\t\t\t}\n\t\t\t\tif(validationMessage == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tinsertError = &quot;&quot;;\n\t\t\t\t\ttry \n\t\t\t\t\t{\n\t\t\t\t\t\tinsertedEmployeeId = insert into Employee_Master\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\tFull_Name=candidateName\n\t\t\t\t\t\t\tDate_Of_Birth=dobValue\n\t\t\t\t\t\t\tGender=genderRaw\n\t\t\t\t\t\t\tOfficial_Email=candidateEmail\n\t\t\t\t\t\t\tPhone=cand.Phone\n\t\t\t\t\t\t\tDepartment=deptRows.ID\n\t\t\t\t\t\t\tDesignation=designationRaw\n\t\t\t\t\t\t\tEmployment_Type=employmentType\n\t\t\t\t\t\t\tDate_Of_Joining=dojValue\n\t\t\t\t\t\t\tTenure_Date=tenureValue\n\t\t\t\t\t\t\tPrimary_Manager=managerId\n\t\t\t\t\t\t\tNotice_Period_Days=noticeRows.ID\n\t\t\t\t\t\t\tEmployment_Status=&quot;Probation&quot;\n\t\t\t\t\t\t\tProbation_End_Date=probationValue\n\t\t\t\t\t\t\tAdded_User=zoho.loginuser\n\t\t\t\t\t\t];\n\t\t\t\t\t\tnewEmployeeId = insertedEmployeeId;\n\t\t\t\t\t\tapp.Status=&quot;Joined&quot;;\n\t\t\t\t\t\ttokenMap = Map();\n\t\t\t\t\t\ttokenMap.put(&quot;employee&quot;,candidateName);\n\t\t\t\t\t\ttokenMap.put(&quot;candidate&quot;,candidateName);\n\t\t\t\t\t\ttokenMap.put(&quot;email&quot;,candidateEmail);\n\t\t\t\t\t\ttokenMap.put(&quot;job_title&quot;,jobTitle);\n\t\t\t\t\t\ttokenMap.put(&quot;designation&quot;,designationRaw);\n\t\t\t\t\t\ttokenMap.put(&quot;department&quot;,deptRows.Department_Name);\n\t\t\t\t\t\ttokenMap.put(&quot;date_of_joining&quot;,dojRaw);\n\t\t\t\t\t\tthisapp.Send_Configured_Notification(&quot;EMPLOYEE_WELCOME&quot;,tokenMap,&quot;Welcome to IITB&quot;,&quot;Welcome {{employee}}. Your employee record has been created for {{designation}} in {{department}}.&quot;);\n\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;CANDIDATE_CONVERTED_TO_EMPLOYEE&quot;,&quot;Recruitment&quot;,&quot;Job_Application&quot;,app.ID,&quot;Convert To Employee&quot;,&quot;Offer_Accepted&quot;,&quot;Joined&quot;,&quot;Created Employee_Master record from accepted candidate. Employee ID: &quot; + insertedEmployeeId,true,&quot;&quot;);\n\t\t\t\t\t\tconversionSuccess = true;\n\t\t\t\t\t\tconversionMessage = &quot;Employee record created and job application marked Joined.&quot;;\n\t\t\t\t\t\tnewEmployeeUrl = &quot;#Report:All_Employees?ID=&quot; + insertedEmployeeId + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t\t\t\tcanConvert = false;\n\t\t\t\t\t\talreadyJoined = true;\n\t\t\t\t\t\texistingEmployeeFound = true;\n\t\t\t\t\t}\t\t\t\t\tcatch (e)\n\t\t\t\t\t{\n\t\t\t\t\t\tinsertError = e.toString();\n\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;CANDIDATE_CONVERTED_TO_EMPLOYEE&quot;,&quot;Recruitment&quot;,&quot;Job_Application&quot;,app.ID,&quot;Convert To Employee&quot;,&quot;Offer_Accepted&quot;,&quot;&quot;,&quot;Employee conversion failed for &quot; + candidateName,false,insertError);\n\t\t\t\t\t\tconversionMessage = &quot;Conversion failed: &quot; + insertError;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tconversionMessage = validationMessage;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(existingEmployeeFound == true &amp;&amp; newEmployeeId == null)\n\t\t\t{\n\t\t\t\tnewEmployeeId = existingEmployees.ID;\n\t\t\t\tnewEmployeeUrl = &quot;#Report:All_Employees?ID=&quot; + existingEmployees.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\t}\n\t\t\tcandidateDetailUrl = &quot;#Page:Candidate_Detail?candidate_id=&quot; + cand.ID;\n\t\t\tapplicationUrl = &quot;#Report:Active_Job_Applications?ID=&quot; + app.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\temployeeDirectoryUrl = &quot;#Report:Employee_Directory?zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\tselectedEmploymentType = ifnull(input.employment_type,&quot;Full_Time&quot;);\n\t\t\tselectedDepartment = ifnull(ifnull(input.department,jobDepartmentId),&quot;&quot;).toString();\n\t\t\tselectedDesignation = ifnull(input.designation,if(jobTitle != &quot;-&quot;,jobTitle,&quot;&quot;));\n\t\t\tselectedManager = ifnull(input.primary_manager,&quot;&quot;).toString();\n\t\t\tselectedDoj = ifnull(input.date_of_joining,defaultDoj);\n\t\t\tselectedProbation = ifnull(input.probation_end_date,defaultProbation);\n\t\t\tselectedDob = ifnull(input.date_of_birth,&quot;&quot;);\n\t\t\tselectedGender = ifnull(input.gender,&quot;&quot;);\n\t\t\tselectedTenure = ifnull(input.tenure_date,defaultTenure);\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:48px;--zcs-avatar-radius:12px&apos;&gt;\n\t\t\t\t&lt;span class=&apos;candidate-avatar-initial&apos;&gt;&lt;%=candidateInitial%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Convert &lt;%=candidateName%&gt;&lt;/h5&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary zcs-ellipsis&apos;&gt;Create Employee_Master from accepted candidate and close the recruitment application&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=candidateDetailUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Candidate Detail&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=applicationUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Application&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;convert-content&apos;&gt;\n\t\t&lt;div class=&apos;stepper-wrap zcs-mb-0&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-stepper-wrapper&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-stepper-count zcs-col-common zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-box-border&apos;&gt;1&lt;/h6&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-failed zcs-font-18 zcs-color-white zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-stepper-level zcs-rounded-half&apos; style=&apos;width:0%;height:0%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Offer Accepted&lt;/span&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-stepper &lt;%=if(conversionSuccess == true || alreadyJoined == true,&quot;&quot;,&quot;zcs-stepper-active&quot;)%&gt; zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-stepper-count zcs-col-common zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-box-border&apos;&gt;2&lt;/h6&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-failed zcs-font-18 zcs-color-white zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-stepper-level zcs-rounded-half&apos; style=&apos;width:0%;height:0%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;HR Details&lt;/span&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-stepper &lt;%=if(conversionSuccess == true || alreadyJoined == true,&quot;zcs-stepper-active&quot;,&quot;&quot;)%&gt; zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border&apos;&gt;&lt;h6 class=&apos;zcs-stepper-count zcs-col-common zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-box-border&apos;&gt;3&lt;/h6&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small&apos;&gt;&lt;/i&gt;&lt;i class=&apos;zcs-stepper-icon zcs-stepper-failed zcs-font-18 zcs-color-white zc-li-outline ui-1-circle-remove&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-stepper-level zcs-rounded-half&apos; style=&apos;width:0%;height:0%;&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;Joined&lt;/span&gt;\n\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t\tif(conversionMessage != &quot;&quot;)\n\t\t\t{\n\t\t\t\tbannerClass = if(conversionSuccess == true,&quot;success&quot;,&quot;error&quot;);\n\t\t\t\t%&gt;\n&lt;div class=&apos;conversion-banner &lt;%=bannerClass%&gt; zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=if(conversionSuccess == true,&quot;ui-1-check-circle-08&quot;,&quot;ui-1-circle-remove&quot;)%&gt; zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=conversionMessage%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(alreadyJoined == true &amp;&amp; conversionSuccess == false)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&apos;conversion-banner info zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-check-circle-08 zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;This application is already marked Joined.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(existingEmployeeFound == true &amp;&amp; conversionSuccess == false)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&apos;disabled-note zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;An employee record already exists for this candidate email. Review the existing employee instead of creating a duplicate.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(app.Status != &quot;Offer_Accepted&quot; &amp;&amp; alreadyJoined == false)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&apos;disabled-note zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;Only Offer_Accepted applications can be converted. Current status is &lt;%=app.Status%&gt;.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&apos;convert-grid zcs-mt-20&apos;&gt;\n\t\t\t&lt;aside class=&apos;profile-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:75px;--zcs-avatar-radius:14px&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;candidate-avatar-initial&apos;&gt;&lt;%=candidateInitial%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-col-common zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=candidateName%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=candidateEmail%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=candidatePhone%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;summary-list&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Application Status&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-mt-6&apos;&gt;&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=app.Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Job Title&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=jobTitle%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Job Department&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=jobDepartmentName%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Source&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(cand.Source,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-18 zcs-box-border zcs-mt-16&apos;&gt;\n\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Follow-up links&lt;/h6&gt;\n\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=employeeDirectoryUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline users-wm&apos;&gt;&lt;/i&gt;&lt;span&gt;Employee Directory&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;#Report:All_Employees?zc_LoadIn=dialog&amp;zc_Header=true&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline business-contact-85&apos;&gt;&lt;/i&gt;&lt;span&gt;All Employees&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\t\tif(newEmployeeUrl != &quot;&quot;)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=newEmployeeUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;New Employee&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\n\t\t\t&lt;section class=&apos;form-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;form-head zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Employee details&lt;/h6&gt;\n\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-mt-6 zcs-mx-0 zcs-mb-0&apos;&gt;Submit creates Employee_Master, seeds leave balances through the Employee_Master workflow, marks the job application Joined, sends a configured welcome notification, and writes an audit log.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;form method=&apos;GET&apos; action=&apos;#Page:Convert_To_Employee&apos;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;job_application_id&apos; value=&apos;&lt;%=app.ID%&gt;&apos; /&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;convert_submit&apos; value=&apos;1&apos; /&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;input-grid&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Employment Type &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select name=&apos;employment_type&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Full_Time&apos; &lt;%=if(selectedEmploymentType == &quot;Full_Time&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Full_Time&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Contractor&apos; &lt;%=if(selectedEmploymentType == &quot;Contractor&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Contractor&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Intern&apos; &lt;%=if(selectedEmploymentType == &quot;Intern&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Intern&lt;/option&gt;\n\t\t\t\t\t\t\t\t&lt;/select&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Date of Joining &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;date&apos; name=&apos;date_of_joining&apos; value=&apos;&lt;%=selectedDoj%&gt;&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt; /&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Department &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select name=&apos;department&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;&apos;&gt;Select department&lt;/option&gt;\n&lt;%\n\t\t\tfor each  dept in Department_Config[Is_Active == true] sort by Department_Name asc\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;option value=&apos;&lt;%=dept.ID%&gt;&apos; &lt;%=if(selectedDepartment == dept.ID.toString(),&quot;selected&quot;,&quot;&quot;)%&gt;&gt;&lt;%=dept.Department_Name%&gt;&lt;/option&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/select&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Designation &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;text&apos; name=&apos;designation&apos; value=&apos;&lt;%=selectedDesignation%&gt;&apos; placeholder=&apos;Enter designation&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt; /&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Primary Manager&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select name=&apos;primary_manager&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;&apos;&gt;No primary manager&lt;/option&gt;\n&lt;%\n\t\t\tfor each  mgr in Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;] sort by Full_Name asc\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;option value=&apos;&lt;%=mgr.ID%&gt;&apos; &lt;%=if(selectedManager == mgr.ID.toString(),&quot;selected&quot;,&quot;&quot;)%&gt;&gt;&lt;%=mgr.Full_Name%&gt;&lt;/option&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/select&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Probation End Date &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;date&apos; name=&apos;probation_end_date&apos; value=&apos;&lt;%=selectedProbation%&gt;&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt; /&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Date of Birth &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;date&apos; name=&apos;date_of_birth&apos; value=&apos;&lt;%=selectedDob%&gt;&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt; /&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Gender &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;select name=&apos;gender&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt;&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;&apos;&gt;Select gender&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Male&apos; &lt;%=if(selectedGender == &quot;Male&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Male&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Female&apos; &lt;%=if(selectedGender == &quot;Female&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Female&lt;/option&gt;\n\t\t\t\t\t\t\t\t\t&lt;option value=&apos;Other&apos; &lt;%=if(selectedGender == &quot;Other&quot;,&quot;selected&quot;,&quot;&quot;)%&gt;&gt;Other&lt;/option&gt;\n\t\t\t\t\t\t\t\t&lt;/select&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Tenure Date &lt;span class=&apos;required-mark&apos;&gt;*&lt;/span&gt;&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;date&apos; name=&apos;tenure_date&apos; value=&apos;&lt;%=selectedTenure%&gt;&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt; /&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;field-help&apos;&gt;Use date of joining unless HR needs a different tenure anchor.&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;field-block&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label&gt;Official Email&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input type=&apos;email&apos; value=&apos;&lt;%=candidateEmail%&gt;&apos; disabled /&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;field-help&apos;&gt;Copied from Candidate.Email and checked for duplicate employees.&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;submit-row zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Employment status will be set to Probation.&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=candidateDetailUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-left&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Back to Candidate&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos; &lt;%=if(canConvert == true,&quot;&quot;,&quot;disabled&quot;)%&gt;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Create Employee&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Employee_Attendance_Portal(string attendance_action)
		{
					displayname = "Employee Attendance Portal"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Employee_Attendance_Portal_Snippet' elementName='Employee_Attendance_Portal_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Employee_Attendance_Portal_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\ttodayDate = zoho.currentdate;\n\tnowTime = zoho.currenttime;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tactionParam = ifnull(input.attendance_action,&quot;&quot;);\n\tactionMessage = &quot;&quot;;\n\tactionClass = &quot;info&quot;;\n\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\temployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\thasEmployee = employeeRows.count() &gt; 0;\n\temployeeName = &quot;Employee&quot;;\n\temployeeInitial = &quot;E&quot;;\n\temployeeEmail = loginEmail;\n\temployeeDepartment = &quot;-&quot;;\n\temployeeDesignation = &quot;-&quot;;\n\thasLog = false;\n\tstatusText = &quot;Not_Marked&quot;;\n\tsourceText = &quot;-&quot;;\n\tloginDisplay = &quot;-&quot;;\n\tlogoutDisplay = &quot;-&quot;;\n\thoursDisplay = &quot;0&quot;;\n\tstatusBadge = &quot;zcs-badge-grey&quot;;\n\tcanLogin = false;\n\tcanLogout = false;\n\tportalNote = &quot;&quot;;\n\tmyAttendanceUrl = &quot;#Report:My_Attendance?zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\tmyLeaveBalanceUrl = &quot;#Report:My_Leave_Balance?zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\tapplyLeaveUrl = &quot;#Form:Time_Off_Request?zc_LoadIn=dialog&quot;;\n\tregulariseUrl = &quot;#Form:Regularisation_Request?zc_LoadIn=dialog&quot;;\n\tloginUrl = &quot;#Page:Employee_Attendance_Portal?attendance_action=login&quot;;\n\tlogoutUrl = &quot;#Page:Employee_Attendance_Portal?attendance_action=logout&quot;;\n\tif(hasEmployee == true)\n\t{\n\t\temp = employeeRows;\n\t\temployeeName = ifnull(emp.Full_Name,&quot;Employee&quot;);\n\t\tif(employeeName != &quot;&quot;)\n\t\t{\n\t\t\temployeeInitial = employeeName.left(1);\n\t\t}\n\t\temployeeEmail = ifnull(emp.Official_Email,loginEmail);\n\t\temployeeDepartment = ifnull(emp.Department,&quot;-&quot;);\n\t\temployeeDesignation = ifnull(emp.Designation,&quot;-&quot;);\n\t\tif(actionParam != &quot;&quot;)\n\t\t{\n\t\t\tauditRecordId = 0;\n\t\t\ttry \n\t\t\t{\n\t\t\t\tactionRows = Attendance_Log[Employee == emp.ID &amp;&amp; Attendance_Date == todayDate];\n\t\t\t\tif(actionParam == &quot;login&quot;)\n\t\t\t\t{\n\t\t\t\t\tif(actionRows.count() == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tinsertedLogId = insert into Attendance_Log\n\t\t\t\t\t\t[\n\t\t\t\t\t\t\tEmployee=emp.ID\n\t\t\t\t\t\t\tAttendance_Date=todayDate\n\t\t\t\t\t\t\tLogin_Time=nowTime\n\t\t\t\t\t\t\tWorking_Hours=0\n\t\t\t\t\t\t\tAttendance_Status=&quot;Present&quot;\n\t\t\t\t\t\t\tSource=&quot;Manual&quot;\n\t\t\t\t\t\t\tAdded_User=zoho.loginuser\n\t\t\t\t\t\t];\n\t\t\t\t\t\tauditRecordId = insertedLogId;\n\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;ATTENDANCE_PORTAL_LOGIN&quot;,&quot;Attendance_Leave&quot;,&quot;Attendance_Log&quot;,insertedLogId,&quot;Log In&quot;,&quot;&quot;,&quot;Present&quot;,&quot;Manual portal login at &quot; + nowTime.toString(&quot;dd-MMM-yyyy hh:mm a&quot;),true,&quot;&quot;);\n\t\t\t\t\t\tactionMessage = &quot;Log in recorded successfully.&quot;;\n\t\t\t\t\t\tactionClass = &quot;success&quot;;\n\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tactionLog = actionRows;\n\t\t\t\t\t\tauditRecordId = actionLog.ID;\n\t\t\t\t\t\tif(actionLog.Logout_Time != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tactionMessage = &quot;Attendance is already closed for today.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;info&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(actionLog.Login_Time == null &amp;&amp; ifnull(actionLog.Attendance_Status,&quot;Not_Marked&quot;) == &quot;Not_Marked&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\toldStatus = ifnull(actionLog.Attendance_Status,&quot;&quot;);\n\t\t\t\t\t\t\tactionLog.Login_Time=nowTime;\n\t\t\t\t\t\t\tactionLog.Working_Hours=0;\n\t\t\t\t\t\t\tactionLog.Source=&quot;Manual&quot;;\n\t\t\t\t\t\t\tactionLog.Attendance_Status=&quot;Present&quot;;\n\t\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;ATTENDANCE_PORTAL_LOGIN&quot;,&quot;Attendance_Leave&quot;,&quot;Attendance_Log&quot;,actionLog.ID,&quot;Log In&quot;,oldStatus,&quot;Present&quot;,&quot;Manual portal login at &quot; + nowTime.toString(&quot;dd-MMM-yyyy hh:mm a&quot;),true,&quot;&quot;);\n\t\t\t\t\t\t\tactionMessage = &quot;Log in recorded successfully.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;success&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(actionLog.Login_Time != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tactionMessage = &quot;Log in is already recorded. Use Log Out when your work day is complete.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;info&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tactionMessage = &quot;Today&apos;s attendance is not Not_Marked, so manual log in is unavailable from this portal.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;error&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if(actionParam == &quot;logout&quot;)\n\t\t\t\t{\n\t\t\t\t\tif(actionRows.count() == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tactionMessage = &quot;Log in first before recording log out.&quot;;\n\t\t\t\t\t\tactionClass = &quot;error&quot;;\n\t\t\t\t\t\tactionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tactionLog = actionRows;\n\t\t\t\t\t\tauditRecordId = actionLog.ID;\n\t\t\t\t\t\tif(actionLog.Login_Time == null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tactionMessage = &quot;Log in first before recording log out.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;error&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if(actionLog.Logout_Time != null)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tactionMessage = &quot;Log out is already recorded for today.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;info&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\toldStatus = ifnull(actionLog.Attendance_Status,&quot;&quot;);\n\t\t\t\t\t\t\tcalculatedHours = (nowTime.toLong() - actionLog.Login_Time.toLong()) / 3600000;\n\t\t\t\t\t\t\tif(calculatedHours == null || calculatedHours &lt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tcalculatedHours = 0;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tactionLog.Logout_Time=nowTime;\n\t\t\t\t\t\t\tactionLog.Working_Hours=calculatedHours;\n\t\t\t\t\t\t\tactionLog.Source=&quot;Manual&quot;;\n\t\t\t\t\t\t\tif(actionLog.Attendance_Status == null || actionLog.Attendance_Status == &quot;Not_Marked&quot;)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tactionLog.Attendance_Status=&quot;Present&quot;;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;ATTENDANCE_PORTAL_LOGOUT&quot;,&quot;Attendance_Leave&quot;,&quot;Attendance_Log&quot;,actionLog.ID,&quot;Log Out&quot;,oldStatus,actionLog.Attendance_Status,&quot;Manual portal logout at &quot; + nowTime.toString(&quot;dd-MMM-yyyy hh:mm a&quot;) + &quot;; working hours: &quot; + calculatedHours,true,&quot;&quot;);\n\t\t\t\t\t\t\tactionMessage = &quot;Log out recorded successfully.&quot;;\n\t\t\t\t\t\t\tactionClass = &quot;success&quot;;\n\t\t\t\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tactionMessage = &quot;Unknown attendance action.&quot;;\n\t\t\t\t\tactionClass = &quot;error&quot;;\n\t\t\t\t\tactionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t}\n\t\t\t}\t\t\tcatch (actionErr)\n\t\t\t{\n\t\t\t\tactionErrorText = actionErr.toString();\n\t\t\t\tactionMessage = &quot;Attendance action failed. Please try again or contact HR.&quot;;\n\t\t\t\tactionClass = &quot;error&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\ttry \n\t\t\t\t{\n\t\t\t\t\tthisapp.Add_Audit_Log(&quot;ATTENDANCE_PORTAL_ACTION_FAILED&quot;,&quot;Attendance_Leave&quot;,&quot;Attendance_Log&quot;,auditRecordId,&quot;Portal Action&quot;,&quot;&quot;,&quot;&quot;,&quot;Employee attendance portal action failed for &quot; + employeeEmail,false,actionErrorText);\n\t\t\t\t}\t\t\t\tcatch (auditErr)\n\t\t\t\t{\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tattendanceRows = Attendance_Log[Employee == emp.ID &amp;&amp; Attendance_Date == todayDate];\n\t\thasLog = attendanceRows.count() &gt; 0;\n\t\tif(hasLog == true)\n\t\t{\n\t\t\ttodayLog = attendanceRows;\n\t\t\tstatusText = ifnull(todayLog.Attendance_Status,&quot;Not_Marked&quot;);\n\t\t\tsourceText = ifnull(todayLog.Source,&quot;-&quot;);\n\t\t\tif(todayLog.Login_Time != null)\n\t\t\t{\n\t\t\t\tloginDisplay = todayLog.Login_Time.toString(&quot;dd-MMM-yyyy hh:mm a&quot;);\n\t\t\t}\n\t\t\tif(todayLog.Logout_Time != null)\n\t\t\t{\n\t\t\t\tlogoutDisplay = todayLog.Logout_Time.toString(&quot;dd-MMM-yyyy hh:mm a&quot;);\n\t\t\t}\n\t\t\thoursValue = ifnull(todayLog.Working_Hours,0);\n\t\t\thoursDisplay = &quot;&quot; + hoursValue;\n\t\t\tif(todayLog.Login_Time != null &amp;&amp; todayLog.Logout_Time == null)\n\t\t\t{\n\t\t\t\tcanLogout = true;\n\t\t\t}\n\t\t\telse if(todayLog.Login_Time == null &amp;&amp; statusText == &quot;Not_Marked&quot;)\n\t\t\t{\n\t\t\t\tcanLogin = true;\n\t\t\t}\n\t\t\telse if(todayLog.Logout_Time != null)\n\t\t\t{\n\t\t\t\tportalNote = &quot;Attendance is closed for today.&quot;;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tportalNote = &quot;Manual portal action is unavailable while today&apos;s status is &quot; + statusText + &quot;.&quot;;\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tcanLogin = true;\n\t\t\tsourceText = &quot;Manual&quot;;\n\t\t\tportalNote = &quot;No attendance row exists yet for today. Use Log In to create one.&quot;;\n\t\t}\n\t\tif(statusText == &quot;Present&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(statusText == &quot;Absent&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(statusText == &quot;Half_Day&quot; || statusText == &quot;WFH&quot; || statusText == &quot;On_Duty&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\telse if(statusText == &quot;Holiday&quot; || statusText == &quot;Leave&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-blue&quot;;\n\t\t}\n\t\tbalances = Leave_Balance[Employee == emp.ID] sort by Leave_Type asc;\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#FFFFFF;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-p-25{padding:1.5625rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-15{padding-left:.9375rem;padding-right:.9375rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mb-0{margin-bottom:0}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-col-3{flex:0 0 25%;max-width:25%}.zcs-col-4{flex:0 0 33.333%;max-width:33.333%}.zcs-col-6{flex:0 0 50%;max-width:50%}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS: button-primary-button / header-heading-with-actions */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* ZCS component CSS: card-avatar-with-key-value / label-value-key-value-with-icon */\n.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg{background-color:#F9FAFE}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#FF7E52}.zcs-labelvalue-wrapper .zcs-labelvalue-color-red{color:#FE455D}\n/* ZCS component CSS: table-simple-table */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs_tertiary_border_color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr:first-child:hover td{border-color:var(--zcs_tertiary_border_color)}.zcs-table-wrapper table tbody tr td.zcs-green,.zcs-table-wrapper table tbody tr td .zcs-green{color:#179e6c}.zcs-table-wrapper table tbody tr td.zcs-red,.zcs-table-wrapper table tbody tr td .zcs-red{color:#fe455d}.zcs-table-wrapper table tbody tr td.zcs-yellow,.zcs-table-wrapper table tbody tr td .zcs-yellow{color:#b8770d}.zcs-table-wrapper table tbody tr td.zcs-blue,.zcs-table-wrapper table tbody tr td .zcs-blue{color:#09598e}\n/* Employee Attendance Portal custom layout */\n.attendance-page{min-height:100%;background:var(--zcs-page-bg-color,#F3F3F4);color:var(--zcs-primary-text-color);font-family:inherit}.attendance-content{padding:24px 30px}.quick-actions{flex-wrap:wrap}.employee-initial{color:var(--zcs_brand_foreground_color);font-size:28px;font-weight:700}.portal-grid{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:20px;align-items:start}.profile-card{position:sticky;top:16px}.status-panel{background:#fff;border:1px solid #e7e7ee;border-radius:14px;box-shadow:0 2px 10px rgba(18,19,43,.04);overflow:hidden}.status-head{background:linear-gradient(90deg,var(--zcs_brand_light_color),#fff);border-bottom:1px solid #ececf3}.kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.kpi-card{background:#F9FAFE;border:1px solid #eef0f6;border-radius:12px;padding:14px}.kpi-icon{width:34px;height:34px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.action-panel{border-top:1px solid #ececf3;background:#fcfcff}.portal-note{background:#FCF4E6;border:1px solid #FAAE13;color:#7E5608;border-radius:10px;padding:12px}.action-banner{border-radius:12px;padding:14px 16px;border:1px solid;margin-bottom:16px}.action-banner.success{background:#E4FCF3;border-color:#179E6C;color:#0F704D}.action-banner.error{background:#FDE3E6;border-color:#FE455D;color:#A60E25}.action-banner.info{background:#E8EFFF;border-color:#2A6FFC;color:#19499E}.leave-section{margin-top:20px}.empty-state{min-height:260px;background:#fff;border:1px solid #e7e7ee;border-radius:14px}.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.related-link{border:1px solid #ececf3;border-radius:10px;color:var(--zcs-primary-text-color);background:#fff}.related-link:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.mobile-stack{display:flex}.source-pill{background:#F9FAFE;border:1px solid #eef0f6;border-radius:999px;padding:4px 10px}\n@media (max-width:1100px){.portal-grid{grid-template-columns:1fr}.profile-card{position:static}.kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (max-width:700px){.attendance-content{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.quick-actions{width:100%}.quick-actions .zcs-button{width:100%;justify-content:center}.kpi-grid{grid-template-columns:1fr}.action-panel{align-items:stretch;flex-direction:column}.action-panel .zcs-button{width:100%;justify-content:center}.mobile-stack{flex-direction:column}.zcs-col-xs-12{flex:0 0 100%;max-width:100%}}\n&lt;/style&gt;\n\n&lt;div class=&quot;attendance-page&quot;&gt;\n&lt;%\n\tif(hasEmployee == false)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Employee Attendance Portal&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;No Employee_Master record is linked to the signed-in email.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Employee_Directory?zc_LoadIn=dialog&amp;zc_Header=true&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline users-single-01&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Employee Directory&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;attendance-content&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-40&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Employee profile not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Ask HR to map Employee_Master.Official_Email to &lt;%=loginEmail%&gt;.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:48px;--zcs-avatar-radius:12px&apos;&gt;\n\t\t\t\t&lt;span class=&apos;employee-initial&apos;&gt;&lt;%=employeeInitial%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Attendance for &lt;%=employeeName%&gt;&lt;/h5&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary zcs-ellipsis&apos;&gt;Live status for &lt;%=todayDisplay%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=myAttendanceUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;My Attendance&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=myLeaveBalanceUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline design-todo&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Leave Balance Report&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;attendance-content&apos;&gt;\n&lt;%\n\t\tif(actionMessage != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;action-banner &lt;%=actionClass%&gt; zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=actionIcon%&gt; zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=actionMessage%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;portal-grid&apos;&gt;\n\t\t\t&lt;div class=&apos;profile-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size:42px;--zcs-avatar-radius:50%&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;employee-initial zcs-font-22&apos;&gt;&lt;%=employeeInitial%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-common zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-16 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis&apos;&gt;&lt;%=employeeName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis&apos;&gt;&lt;%=employeeEmail%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;ul class=&apos;zcs-row zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-align-items-center zcs-text-center zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Department&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=employeeDepartment%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-align-items-center zcs-text-center zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Designation&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=employeeDesignation%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-align-items-center zcs-text-center zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Source&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=sourceText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t\t&lt;li class=&apos;zcs-flex zcs-direction-column zcs-align-items-center zcs-text-center zcs-gap-8 zcs-col-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary&apos;&gt;Date&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=todayDisplay%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-gap-10 zcs-px-12 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=applyLeaveUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-simple-add zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Apply Leave&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-gap-10 zcs-px-12 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=regulariseUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-edit-72 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Regularise Attendance&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-20&apos;&gt;\n\t\t\t\t&lt;div class=&apos;status-panel&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;status-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border mobile-stack&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary zcs-uppercase&apos;&gt;Today&apos;s Attendance&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=statusText%&gt;&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadge%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=statusText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;source-pill zcs-inline-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-2-time zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-primary&apos;&gt;Source: &lt;%=sourceText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&apos;zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;kpi-grid&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;kpi-card zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Login Time&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=loginDisplay%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;kpi-card zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Logout Time&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=logoutDisplay%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;kpi-card zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-todo&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Working Hours&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=hoursDisplay%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;kpi-card zcs-flex zcs-direction-column zcs-gap-8&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Attendance Row&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;strong class=&apos;zcs-font-15 zcs-font-semibold zcs-color-primary&apos;&gt;&lt;%=if(hasLog == true,&quot;Available&quot;,&quot;Will be created&quot;)%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&apos;action-panel zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium zcs-color-primary&apos;&gt;Manual attendance action&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Actions update Attendance_Log live and write Audit_Log through Add_Audit_Log.&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(canLogin == true)\n\t\t{\n\t\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-20 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;&lt;%=loginUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Log In&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse if(canLogout == true)\n\t\t{\n\t\t\t%&gt;\n&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-20 zcs-py-10 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body&apos; href=&apos;&lt;%=logoutUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Log Out&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;portal-note zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=portalNote%&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&apos;leave-section status-panel&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;status-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-p-20 zcs-box-border mobile-stack&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-6&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-tertiary zcs-uppercase&apos;&gt;Leave Balances&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Current balance by leave type&lt;/h5&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=myLeaveBalanceUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Open Report&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-p-20 zcs-box-border&apos;&gt;\n&lt;%\n\t\tif(balances.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No leave balance rows found&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;thead class=&apos;zcs-sticky&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Leave Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Balance Days&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Used Days&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Credited Days&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Last Credited&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Comp Off Expiry&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr class=&apos;zcs-tspace&apos;&gt;&lt;th class=&apos;zcs-p-2 zcs-box-border&apos; colspan=&apos;6&apos;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  bal in balances\n\t\t\t{\n\t\t\t\tleaveTypeName = ifnull(bal.Leave_Type,&quot;-&quot;);\n\t\t\t\tbalanceDays = ifnull(bal.Balance_Days,0);\n\t\t\t\tusedDays = ifnull(bal.Used_Days,0);\n\t\t\t\tcreditedDays = ifnull(bal.Credited_Days,0);\n\t\t\t\tlastCredited = &quot;-&quot;;\n\t\t\t\tif(bal.Last_Credited_Date != null)\n\t\t\t\t{\n\t\t\t\t\tlastCredited = bal.Last_Credited_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\tcompExpiry = &quot;-&quot;;\n\t\t\t\tif(bal.Comp_Off_Expiry_Date != null)\n\t\t\t\t{\n\t\t\t\t\tcompExpiry = bal.Comp_Off_Expiry_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\tbalanceClass = &quot;zcs-green&quot;;\n\t\t\t\tif(balanceDays &lt;= 0)\n\t\t\t\t{\n\t\t\t\t\tbalanceClass = &quot;zcs-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(balanceDays &lt; 2)\n\t\t\t\t{\n\t\t\t\t\tbalanceClass = &quot;zcs-yellow&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=leaveTypeName%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body &lt;%=balanceClass%&gt;&apos;&gt;&lt;%=balanceDays%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=usedDays%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=creditedDays%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=lastCredited%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=compExpiry%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;%\n\tif(actionParam != &quot;&quot;)\n\t{\n\t\t%&gt;\n&lt;script&gt;\n(function(){\n\tif(window.history &amp;&amp; window.location &amp;&amp; window.location.hash &amp;&amp; window.location.hash.indexOf(&apos;attendance_action=&apos;) !== -1){\n\t\twindow.history.replaceState(null, &apos;&apos;, &apos;#Page:Employee_Attendance_Portal&apos;);\n\t}\n})();\n&lt;/script&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Employee_Dashboard
		{
					displayname = "Employee Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Employee_Dashboard_Snippet' elementName='Employee_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Employee_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisMemberProfile = loginRole == &quot;MEMBER&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tmonthLabel = todayDate.toString(&quot;MMM yyyy&quot;);\n\temployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\thasEmployee = employeeRows.count() &gt; 0;\n\temployeeName = ifnull(zoho.loginuser,&quot;Employee&quot;);\n\temployeeEmail = loginEmail;\n\temployeeDepartment = &quot;-&quot;;\n\temployeeDesignation = &quot;-&quot;;\n\temployeeStatus = &quot;-&quot;;\n\temployeeInitial = &quot;E&quot;;\n\ttotalLeaveBalance = 0;\n\tleaveTypeCount = 0;\n\tmonthAttendanceCount = 0;\n\tpresentCount = 0;\n\twfhCount = 0;\n\tleaveCount = 0;\n\tabsentCount = 0;\n\thalfDayCount = 0;\n\tnotMarkedCount = 0;\n\tpendingLeaveCount = 0;\n\tpendingRegularisationCount = 0;\n\tpendingTravelCount = 0;\n\tpendingReimbursementCount = 0;\n\tpendingGiftCount = 0;\n\tpendingTotalCount = 0;\n\tupcomingTravelCount = 0;\n\tpendingAnnouncementCount = 0;\n\tupcomingTrainingCount = 0;\n\tif(hasEmployee == true &amp;&amp; isMemberProfile == false)\n\t{\n\t\temp = employeeRows;\n\t\temployeeName = ifnull(emp.Full_Name,employeeName);\n\t\tif(employeeName != &quot;&quot;)\n\t\t{\n\t\t\temployeeInitial = employeeName.left(1).toUpperCase();\n\t\t}\n\t\temployeeEmail = ifnull(emp.Official_Email,loginEmail);\n\t\temployeeDepartment = ifnull(emp.Department.Department_Name,&quot;-&quot;);\n\t\temployeeDesignation = ifnull(emp.Designation,&quot;-&quot;);\n\t\temployeeStatus = ifnull(emp.Employment_Status,&quot;-&quot;);\n\t\tleaveBalanceRows = Leave_Balance[Employee == emp.ID] sort by Leave_Type asc;\n\t\tleaveTypeCount = leaveBalanceRows.count();\n\t\tfor each  leaveBalSeed in leaveBalanceRows\n\t\t{\n\t\t\ttotalLeaveBalance = totalLeaveBalance + ifnull(leaveBalSeed.Balance_Days,0);\n\t\t}\n\t\tcurrentMonth = todayDate.getMonth();\n\t\tcurrentYear = todayDate.getYear();\n\t\tattendanceRows = Attendance_Log[Employee == emp.ID];\n\t\tfor each  attendanceSeed in attendanceRows\n\t\t{\n\t\t\tif(attendanceSeed.Attendance_Date != null &amp;&amp; attendanceSeed.Attendance_Date.getMonth() == currentMonth &amp;&amp; attendanceSeed.Attendance_Date.getYear() == currentYear)\n\t\t\t{\n\t\t\t\tmonthAttendanceCount = monthAttendanceCount + 1;\n\t\t\t\tattendanceStatus = ifnull(attendanceSeed.Attendance_Status,&quot;Not_Marked&quot;);\n\t\t\t\tif(attendanceStatus == &quot;Present&quot;)\n\t\t\t\t{\n\t\t\t\t\tpresentCount = presentCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(attendanceStatus == &quot;WFH&quot; || attendanceStatus == &quot;On_Duty&quot;)\n\t\t\t\t{\n\t\t\t\t\twfhCount = wfhCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(attendanceStatus == &quot;Leave&quot;)\n\t\t\t\t{\n\t\t\t\t\tleaveCount = leaveCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(attendanceStatus == &quot;Absent&quot;)\n\t\t\t\t{\n\t\t\t\t\tabsentCount = absentCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(attendanceStatus == &quot;Half_Day&quot;)\n\t\t\t\t{\n\t\t\t\t\thalfDayCount = halfDayCount + 1;\n\t\t\t\t}\n\t\t\t\telse if(attendanceStatus == &quot;Not_Marked&quot;)\n\t\t\t\t{\n\t\t\t\t\tnotMarkedCount = notMarkedCount + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tpendingLeaveRows = Time_Off_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;];\n\t\tpendingRegularisationRows = Regularisation_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;];\n\t\tpendingTravelRows = Travel_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_CEO&quot; || Status == &quot;Pending_HR&quot;];\n\t\tpendingReimbursementRows = Reimbursement_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot; || Status == &quot;Pending_Finance&quot;];\n\t\tpendingGiftRows = Gift_Registration[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot; || Status == &quot;Pending_Finance&quot;];\n\t\tpendingLeaveCount = pendingLeaveRows.count();\n\t\tpendingRegularisationCount = pendingRegularisationRows.count();\n\t\tpendingTravelCount = pendingTravelRows.count();\n\t\tpendingReimbursementCount = pendingReimbursementRows.count();\n\t\tpendingGiftCount = pendingGiftRows.count();\n\t\tpendingTotalCount = pendingLeaveCount + pendingRegularisationCount + pendingTravelCount + pendingReimbursementCount + pendingGiftCount;\n\t\tupcomingTravelRows = Travel_Request[Employee == emp.ID &amp;&amp; Travel_From_Date &gt;= todayDate &amp;&amp; Status != &quot;Rejected&quot; &amp;&amp; Status != &quot;Processed&quot;] sort by Travel_From_Date asc;\n\t\tupcomingTravelCount = upcomingTravelRows.count();\n\t\tpendingAnnouncementRows = Announcement_Acknowledgement[Employee == emp.ID &amp;&amp; Acknowledged == false];\n\t\tpendingAnnouncementCount = pendingAnnouncementRows.count();\n\t\tupcomingTrainingRows = Training_Programme[Assigned_Employees.Official_Email == employeeEmail || Assigned_Employees.Official_Email == zoho.loginuser &amp;&amp; Training_Date &gt;= todayDate &amp;&amp; Status == &quot;Scheduled&quot;] sort by Training_Date asc;\n\t\tupcomingTrainingCount = upcomingTrainingRows.count();\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for Employee_Dashboard (utility subset used by this page) ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; }\n.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-cursor-pointer { cursor: pointer; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, #2A6FFC); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color, #2A6FFC); } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color, #2A6FFC); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }\n/* ZCS component CSS: table-simple-table */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }\n/* Employee dashboard */\n.ed-page { min-height: 100%; background: var(--zcs-page-bg-color, #F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }\n.ed-header { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); }\n.ed-header:after { content: &quot;&quot;; position: absolute; width: 280px; height: 280px; right: -80px; top: -120px; border-radius: 50%; border: 36px solid rgba(255,255,255,.13); }\n.ed-header .zcs-color-primary, .ed-header .zcs-color-secondary, .ed-header .zcs-color-tertiary { color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.ed-header-inner { position: relative; z-index: 1; }\n.ed-avatar { width: 54px; height: 54px; border-radius: 16px; background: rgba(255,255,255,.18); color: var(--zcs_brand_foreground_color, #FFFFFF); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; }\n.ed-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; padding: 18px 0 0; }\n.ed-kpi { grid-column: span 4; min-height: 148px; position: relative; overflow: hidden; box-shadow: 0 8px 22px rgba(15,23,42,.06); }\n.ed-kpi:after { content: &quot;&quot;; position: absolute; width: 90px; height: 90px; right: -28px; bottom: -32px; border-radius: 50%; background: var(--zcs_brand_light_color, #E8EFFF); opacity: .75; }\n.ed-kpi-icon { width: 42px; height: 42px; border-radius: 12px; color: var(--zcs_brand_color, #2A6FFC); background: var(--zcs_brand_light_color, #E8EFFF); }\n.ed-kpi-value { font-size: 30px; font-weight: 700; line-height: 1; }\n.ed-section { grid-column: span 6; box-shadow: 0 8px 22px rgba(15,23,42,.06); }\n.ed-section-header { border-bottom: 1px solid var(--zcs-border-color); }\n.ed-progress { height: 7px; background: #EDF1F7; border-radius: 999px; overflow: hidden; }\n.ed-progress span { height: 100%; display: block; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }\n.ed-mini-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }\n.ed-mini-list li { border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 10px 12px; box-sizing: border-box; background: #FFFFFF; }\n.ed-empty { border: 1px dashed var(--zcs-border-color); background: #FFFFFF; border-radius: 12px; padding: 20px; text-align: center; }\n.ed-denied { max-width: 720px; margin: 0 auto; padding: 36px 20px; }\n@media (max-width: 1120px) { .ed-kpi { grid-column: span 6; } .ed-section { grid-column: span 12; } }\n@media (max-width: 700px) { .ed-header { border-radius: 0 0 16px 16px; } .ed-header-inner { flex-direction: column; align-items: flex-start; } .ed-kpi { grid-column: span 12; } .ed-grid { padding-left: 12px; padding-right: 12px; } }\n&lt;/style&gt;\n&lt;%\n\tif(isMemberProfile == true)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ed-page ed-denied&quot;&gt;\n\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Employee dashboard is for internal employee profiles.&lt;/h5&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;Your current profile is MEMBER. Please contact HR if you need internal employee access.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse if(hasEmployee == false)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ed-page ed-denied&quot;&gt;\n\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;No matching employee profile found.&lt;/h5&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;This page uses Employee Master where Official Email matches the logged-in user. Please ask HR to verify your profile.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ed-page zcs-px-20 zcs-py-16 zcs-box-border&quot;&gt;\n\t&lt;div class=&quot;ed-header zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;ed-header-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-16 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-avatar zcs-no-shrink&quot;&gt;&lt;%=employeeInitial%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Hello &lt;%=employeeName%&gt;&lt;/h4&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary zcs-ellipsis&quot;&gt;&lt;%=employeeDesignation%&gt; \u00B7 &lt;%=employeeDepartment%&gt; \u00B7 &lt;%=todayDisplay%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=employeeStatus%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Page:Employee_Attendance_Portal&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Attendance Portal&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;ed-grid&quot;&gt;\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;Live&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=totalLeaveBalance%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=leaveTypeCount%&gt; leave types with available balance&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=monthLabel%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=monthAttendanceCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=presentCount%&gt; present \u00B7 &lt;%=wfhCount%&gt; WFH/on duty \u00B7 &lt;%=leaveCount%&gt; leave&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;Pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=pendingTotalCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Leave &lt;%=pendingLeaveCount%&gt; \u00B7 Regularisation &lt;%=pendingRegularisationCount%&gt; \u00B7 Travel &lt;%=pendingTravelCount%&gt; \u00B7 Claims &lt;%=pendingReimbursementCount%&gt; \u00B7 Gifts &lt;%=pendingGiftCount%&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin-copy zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Upcoming&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=upcomingTravelCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Future travel requests not rejected or processed&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Acknowledgement&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=pendingAnnouncementCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Announcements awaiting your acknowledgement&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Training&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;ed-kpi-value zcs-color-primary&quot;&gt;&lt;%=upcomingTrainingCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Scheduled programmes assigned to you&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Reliable Creator forms&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-quick-actions-wrapper zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Time_Off_Request?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Apply leave&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Reimbursement_Request?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Submit reimbursement&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Gift_Registration?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Register gift&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Form:Regularisation_Request?zc_LoadIn=dialog&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Request attendance regularisation&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&apos;&gt;&lt;a class=&apos;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&apos; href=&apos;#Page:Employee_Attendance_Portal&apos;&gt;&lt;i class=&apos;zcs-quick-action-icon zcs-font-medium zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-quick-action-text&apos;&gt;Open attendance portal&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Leave balance snapshot&lt;/h5&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:My_Leave_Balance?zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(leaveTypeCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ed-empty&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No leave balance rows are available yet.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;\n\t\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Leave type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Balance&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Used&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Utilisation&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  leaveBal in leaveBalanceRows\n\t\t\t{\n\t\t\t\tbalanceDays = ifnull(leaveBal.Balance_Days,0);\n\t\t\t\tusedDays = ifnull(leaveBal.Used_Days,0);\n\t\t\t\tbarWidth = usedDays * 10;\n\t\t\t\tif(barWidth &gt; 100)\n\t\t\t\t{\n\t\t\t\t\tbarWidth = 100;\n\t\t\t\t}\n\t\t\t\tleaveTypeName = ifnull(leaveBal.Leave_Type.Leave_Type_Name,&quot;Leave&quot;);\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=leaveTypeName%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;&lt;%=balanceDays%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&apos;&gt;&lt;%=usedDays%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left&apos;&gt;&lt;div class=&apos;ed-progress&apos;&gt;&lt;span style=&apos;width:&lt;%=barWidth%&gt;%&apos;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Upcoming travel&lt;/h5&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:My_Travel_Requests?zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(upcomingTravelCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ed-empty&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin-copy zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No upcoming travel requests.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownTravel = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;ed-mini-list&quot;&gt;\n&lt;%\n\t\t\tfor each  travelItem in upcomingTravelRows\n\t\t\t{\n\t\t\t\tif(shownTravel &lt; 3)\n\t\t\t\t{\n\t\t\t\t\ttravelStatus = ifnull(travelItem.Status,&quot;-&quot;);\n\t\t\t\t\ttravelBadge = &quot;zcs-badge-blue&quot;;\n\t\t\t\t\tif(travelStatus == &quot;Approved&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\ttravelBadge = &quot;zcs-badge-green&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(travelStatus == &quot;Pending_Manager&quot; || travelStatus == &quot;Pending_CEO&quot; || travelStatus == &quot;Pending_HR&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\ttravelBadge = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t\t}\n\t\t\t\t\ttravelDate = &quot;-&quot;;\n\t\t\t\t\tif(travelItem.Travel_From_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\ttravelDate = travelItem.Travel_From_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tshownTravel = shownTravel + 1;\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=ifnull(travelItem.Destination,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=travelDate%&gt; \u00B7 &lt;%=ifnull(travelItem.Travel_Type,&quot;Travel&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=travelBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=travelStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Announcements to acknowledge&lt;/h5&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:My_Announcement_Acknowledgements?zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(pendingAnnouncementCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ed-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No pending announcement acknowledgements.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownAnnouncement = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;ed-mini-list&quot;&gt;\n&lt;%\n\t\t\tfor each  ackItem in pendingAnnouncementRows\n\t\t\t{\n\t\t\t\tif(shownAnnouncement &lt; 3)\n\t\t\t\t{\n\t\t\t\t\tdeadlineText = &quot;No deadline&quot;;\n\t\t\t\t\tif(ackItem.Announcement.Acknowledgement_Deadline != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tdeadlineText = &quot;Due &quot; + ackItem.Announcement.Acknowledgement_Deadline.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tshownAnnouncement = shownAnnouncement + 1;\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=ifnull(ackItem.Announcement.Title,&quot;Announcement&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=deadlineText%&gt;&lt;/span&gt;&lt;/div&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:My_Announcement_Acknowledgements?ID=&lt;%=ackItem.ID%&gt;&amp;amp;zc_LoadIn=dialog&quot;&gt;Acknowledge&lt;/a&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;ed-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Upcoming training&lt;/h5&gt;\n\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:My_Training_Schedule?zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(upcomingTrainingCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;ed-empty&quot;&gt;&lt;i class=&quot;zc-li-outline business-chart-bar-32 zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No scheduled training programmes assigned to you.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownTraining = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;ed-mini-list&quot;&gt;\n&lt;%\n\t\t\tfor each  trainingItem in upcomingTrainingRows\n\t\t\t{\n\t\t\t\tif(shownTraining &lt; 3)\n\t\t\t\t{\n\t\t\t\t\ttrainingDate = &quot;-&quot;;\n\t\t\t\t\tif(trainingItem.Training_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\ttrainingDate = trainingItem.Training_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tshownTraining = shownTraining + 1;\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=ifnull(trainingItem.Programme_Name,&quot;Training programme&quot;)%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=trainingDate%&gt; \u00B7 &lt;%=ifnull(trainingItem.Training_Mode,&quot;-&quot;)%&gt; \u00B7 Trainer: &lt;%=ifnull(trainingItem.Trainer_Name,&quot;-&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;&lt;%=ifnull(trainingItem.Status,&quot;Scheduled&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Leave_Balance_Report' title='My Leave Balances' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Leave_Balance' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='280' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Attendance_Report' title='My Attendance' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Attendance' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='320' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Time_Off_Requests_Report' title='My Time Off Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Time_Off_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='320' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Regularisation_Requests_Report' title='My Regularisation Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Regularisation_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='300' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Travel_Requests_Report' title='My Travel Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Travel_Requests' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Reimbursements_Report' title='My Reimbursements' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Reimbursements' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Gift_Registrations_Report' title='My Gift Registrations' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Gift_Registrations' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='300' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Announcement_Acknowledgements_Report' title='My Announcement Acknowledgements' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Announcement_Acknowledgements' iszreport='false' zc_AddRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='300' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Training_Schedule_Report' title='My Training Schedule' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='My_Training_Schedule' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='300' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Employee_Home
		{
					displayname = "Employee Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Employee_Home_Snippet' elementName='Employee_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Employee_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || isAdmin;\n\tisASPIRE = loginRole == &quot;ASPIRE_ADMIN&quot; || isAdmin;\n\tuserName = ifnull(zoho.loginuser,&quot;Employee&quot;);\n\tuserDesignation = &quot;Employee workspace&quot;;\n\tuserDepartment = &quot;&quot;;\n\tcurrentEmployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(currentEmployeeRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(currentEmployeeRows.Full_Name,userName);\n\t\tuserDesignation = ifnull(currentEmployeeRows.Designation,userDesignation);\n\t\tif(currentEmployeeRows.Department != null)\n\t\t{\n\t\t\tuserDepartment = ifnull(currentEmployeeRows.Department.Department_Name,&quot;&quot;);\n\t\t}\n\t}\n\tactiveEmployees = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;].count();\n\ttotalEmployees = Employee_Master.count();\n\tactiveMembers = Member_Master[Is_Active == true].count();\n\tactiveDepartments = Department_Config[Is_Active == true].count();\n\topenUrl(&quot;#Page:Org_Chart?zc_LoadIn=embed-ehorgchart&quot;,&quot;same window&quot;);\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css utility subset included once for Employee_Home ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions and button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n/* Employee Home layout */\n.eh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.eh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }\n.eh-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.eh-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.eh-hero-content { position: relative; z-index: 1; }\n.eh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.eh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.eh-kpi { grid-column: span 3; min-height: 120px; }\n.eh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.eh-workspace { grid-column: span 9; }\n.eh-actions { grid-column: span 3; }\n.eh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.eh-tabs-shell { overflow: hidden; }\n.eh-tab-input { display: none; }\n.eh-tabbar { overflow-x: auto; }\n.eh-tabbar label { cursor: pointer; }\n.eh-panel { display: none; padding: 18px; }\n#eh-tab-profile:checked ~ .eh-tabbar label[for=&apos;eh-tab-profile&apos;], #eh-tab-directory:checked ~ .eh-tabbar label[for=&apos;eh-tab-directory&apos;], #eh-tab-org:checked ~ .eh-tabbar label[for=&apos;eh-tab-org&apos;], #eh-tab-all:checked ~ .eh-tabbar label[for=&apos;eh-tab-all&apos;], #eh-tab-members:checked ~ .eh-tabbar label[for=&apos;eh-tab-members&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#eh-tab-profile:checked ~ .eh-panels .eh-panel-profile, #eh-tab-directory:checked ~ .eh-panels .eh-panel-directory, #eh-tab-org:checked ~ .eh-panels .eh-panel-org, #eh-tab-all:checked ~ .eh-panels .eh-panel-all, #eh-tab-members:checked ~ .eh-panels .eh-panel-members { display: block; }\n.eh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); }\n.eh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.eh-report-frame, .eh-page-frame { min-height: 620px; }\n.eh-page-frame { width: 100%; }\n.eh-access-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n@media (max-width: 1100px) { .eh-kpi { grid-column: span 6; } .eh-workspace, .eh-actions { grid-column: span 12; } }\n@media (max-width: 680px) { .eh-page { padding: 14px; } .eh-kpi { grid-column: span 12; } .eh-hero { padding: 18px; } .eh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .eh-panel { padding: 12px; } .eh-report-frame, .eh-page-frame { min-height: 520px; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;eh-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Employee Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Employee/member data and organization structure workspace&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Org_Chart?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Org Chart&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Employee_Directory?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline users-wm&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Directory&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;eh-hero zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;eh-hero-content zcs-flex zcs-align-items-center zcs-justif