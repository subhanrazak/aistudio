			Reimbursement_Line_Items_On_Validate as "Reimbursement Line Items - On Validate"
			{
			
							type =  form
							form = Reimbursement_Line_Items
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Amount <= 0)
													{
														alert "Amount must be greater than zero.";
														cancel submit;
													}
													if(input.Expense_Date > zoho.currentdate)
													{
														alert "Expense date cannot be in the future.";
														cancel submit;
													}
													parentRequests = Reimbursement_Request[ID == input.Reimbursement_Request];
													if(parentRequests.count() > 0)
													{
														if(parentRequests.Status != "Draft" && parentRequests.Status != "Pending_Manager" && parentRequests.Status != "Pending_HR")
														{
															alert "Reimbursement line items can be edited only before finance processing.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Amount_Claimed_On_User_Input as "Amount Claimed - On User Input"
			{
			
							type =  form
							form = Reimbursement_Request
			
							record event = on add or edit
			
							on user input of Amount_Claimed
							{
								actions 
								{
									custom deluge script
									(
														if(input.Reimbursement_Type != null)
													{
														typeRows = Reimbursement_Type_Config[ID == input.Reimbursement_Type];
														if(typeRows.count() > 0)
														{
															if(ifnull(input.Amount_Claimed,0) <= ifnull(typeRows.Limit_Amount,0) || ifnull(typeRows.Limit_Amount,0) == 0)
															{
																input.within_limit = true;
															}
															else
															{
																input.within_limit = false;
															}
														}
													}
									)
								}
							}
			
						
			}

			Reimbursement_Request_On_Load as "Reimbursement Request - On Load"
			{
			
							type =  form
							form = Reimbursement_Request
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Category;
													disable within_limit;
													disable Processed_Date;
													hide Linked_Travel_Request;
													hide Insurance_Sub_Type;
													if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Source == "Travel_Module")
													{
														show Linked_Travel_Request;
														hide Expense_Date;
														hide Supporting_Bills;
													}
													else
													{
														hide Linked_Travel_Request;
														show Expense_Date;
														show Supporting_Bills;
													}
													if(input.Reimbursement_Type != null)
													{
														typeRows = Reimbursement_Type_Config[ID == input.Reimbursement_Type];
														if(typeRows.count() > 0)
														{
															input.Category = typeRows.Category;
															if(ifnull(input.Amount_Claimed,0) <= ifnull(typeRows.Limit_Amount,0) || ifnull(typeRows.Limit_Amount,0) == 0)
															{
																input.within_limit = true;
															}
															else
															{
																input.within_limit = false;
															}
														}
													}
													if(input.Category == "Health_Insurance")
													{
														show Insurance_Sub_Type;
													}
									)
								}
							}
			
						
			}

			Reimbursement_Request_On_Success as "Reimbursement Request - On Success"
			{
			
							type =  form
							form = Reimbursement_Request
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														oldStatus = "";
													if(input.ID != null)
													{
														if(input.Status == "Draft")
														{
															if(input.Source == "Direct")
															{
																if(input.Category == "Health_Insurance")
																{
																	input.Status = "Pending_HR";
																}
																else
																{
																	input.Status = "Pending_Manager";
																}
															}
														}
														if(input.Status == "Processed" && input.Processed_Date == null)
														{
															input.Processed_Date = zoho.currentdate;
														}
														try 
														{
															tokenMap = Map();
															tokenMap.put("employee",input.Employee.toString());
															tokenMap.put("status",input.Status);
															tokenMap.put("amount",input.Amount_Claimed.toString());
															thisapp.Send_Configured_Notification("REIMBURSEMENT_STATUS",tokenMap,"Reimbursement status updated","A reimbursement request is now " + input.Status + ".");
														}	catch (notifyErr)
														{
														}
														try 
														{
															thisapp.Add_Audit_Log("REIMBURSEMENT_SAVE","Reimbursement","Reimbursement_Request",input.ID,"Save",oldStatus,input.Status,"Reimbursement request saved",true,"");
														}	catch (auditErr)
														{
														}
													}
									)
								}
							}
			
						
			}

			Reimbursement_Request_On_Validate as "Reimbursement Request - On Validate"
			{
			
							type =  form
							form = Reimbursement_Request
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Reimbursement_Type != null)
													{
														typeRows = Reimbursement_Type_Config[ID == input.Reimbursement_Type];
														if(typeRows.count() > 0)
														{
															input.Category = typeRows.Category;
															if(ifnull(input.Amount_Claimed,0) <= ifnull(typeRows.Limit_Amount,0) || ifnull(typeRows.Limit_Amount,0) == 0)
															{
																input.within_limit = true;
															}
															else
															{
																input.within_limit = false;
															}
														}
													}
													if(ifnull(input.Amount_Claimed,0) <= 0)
													{
														alert "Amount claimed must be greater than zero.";
														cancel submit;
													}
													if(input.Source == "Direct")
													{
														if(input.Expense_Date == null)
														{
															alert "Expense date is required for direct reimbursements.";
															cancel submit;
														}
														if(input.Expense_Date > zoho.currentdate)
														{
															alert "Expense date cannot be in the future.";
															cancel submit;
														}
														if(input.Supporting_Bills == null)
														{
															alert "Supporting bills are required for direct reimbursements.";
															cancel submit;
														}
													}
													if(input.Source == "Travel_Module")
													{
														if(input.Linked_Travel_Request == null)
														{
															alert "Linked travel request is required for travel reimbursements.";
															cancel submit;
														}
														if(input.ID != null)
														{
															itemRows = Reimbursement_Line_Items[Reimbursement_Request == input.ID];
															if(input.Status != "Draft" && itemRows.count() == 0)
															{
																alert "At least one reimbursement line item is required before travel reimbursement submission.";
																cancel submit;
															}
														}
													}
													if(input.Category == "Health_Insurance" && input.Insurance_Sub_Type == null)
													{
														alert "Insurance sub type is required for health insurance reimbursements.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

