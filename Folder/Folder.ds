			Attendance_Log_On_Success as "Attendance Log - On Success"
			{
			
							type =  form
							form = Attendance_Log
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Attendance_Status == "Not_Marked" && input.Login_Time != null)
													{
														input.Attendance_Status = "Present";
													}
													thisapp.Add_Audit_Log("ATTENDANCE_LOG_SAVED","Attendance_Leave","Attendance_Log",input.ID,"Saved","",input.Attendance_Status,"Attendance log saved from " + input.Source + ".",true,"");
									)
								}
							}
			
						
			}

			Attendance_Log_On_Validate as "Attendance Log - On Validate"
			{
			
							type =  form
							form = Attendance_Log
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														duplicateLogs = Attendance_Log[Employee == input.Employee && Attendance_Date == input.Attendance_Date && ID != input.ID];
													if(duplicateLogs.count() > 0)
													{
														alert "Attendance is already recorded for this employee and date.";
														cancel submit;
													}
													if(input.Login_Time != null && input.Logout_Time != null && input.Logout_Time < input.Login_Time)
													{
														alert "Logout time cannot be earlier than login time.";
														cancel submit;
													}
													if(input.Login_Time != null && input.Logout_Time != null)
													{
														input.Working_Hours = (input.Logout_Time.toLong() - input.Login_Time.toLong()) / 3600000;
													}
													if(input.Working_Hours == null || input.Working_Hours < 0)
													{
														input.Working_Hours = 0;
													}
									)
								}
							}
			
						
			}

			Candidate_On_Load as "Candidate - On Load"
			{
			
							type =  form
							form = Candidate
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Source == "Referral")
													{
														show Referred_By;
														hide Agency;
													}
													else if(input.Source == "Agency")
													{
														hide Referred_By;
														show Agency;
													}
													else
													{
														hide Referred_By;
														hide Agency;
													}
													if(input.Is_In_Pool == true)
													{
														show Pool_Notes;
													}
													else
													{
														hide Pool_Notes;
													}
									)
								}
							}
			
						
			}

			Candidate_On_Validate as "Candidate - On Validate"
			{
			
							type =  form
							form = Candidate
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Source == "Referral" && input.Referred_By == null)
													{
														alert "Referred By is required when Source is Referral.";
														cancel submit;
													}
													if(input.Source == "Agency" && input.Agency == null)
													{
														alert "Agency is required when Source is Agency.";
														cancel submit;
													}
													if(input.Source != "Referral")
													{
														input.Referred_By = null;
													}
													if(input.Source != "Agency")
													{
														input.Agency = null;
													}
									)
								}
							}
			
						
			}

