			Gift_Registration_On_Load as "Gift Registration - On Load"
			{
			
							type =  form
							form = Gift_Registration
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Final_Decision;
													if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Status == "Pending_Finance")
													{
														show Final_Decision;
													}
													if(input.Status == "Approved_Retain" || input.Status == "Approved_Return" || input.Status == "Rejected")
													{
														disable Gift_Name;
														disable Gift_Description;
														disable Received_From;
														disable Received_Date;
														disable Vendor_Details;
														disable Estimated_Value;
														disable Final_Decision;
													}
									)
								}
							}
			
						
			}

			Gift_Registration_On_Success as "Gift Registration - On Success"
			{
			
							type =  form
							form = Gift_Registration
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Status == "Pending_Manager")
													{
														try 
														{
															tokenMap = Map();
															tokenMap.put("gift_name",input.Gift_Name);
															tokenMap.put("employee",input.Employee.toString());
															tokenMap.put("status",input.Status);
															thisapp.Send_Configured_Notification("GIFT_SUBMITTED",tokenMap,"Gift registration submitted","A gift registration has been submitted and is pending manager review.");
														}	catch (notifyErr)
														{
														}
													}
													try 
													{
														thisapp.Add_Audit_Log("GIFT_REGISTRATION_SAVE","Gift_Registration","Gift_Registration",input.ID,"Save","",input.Status,"Gift registration saved",true,"");
													}catch (auditErr)
													{
													}
									)
								}
							}
			
						
			}

			Gift_Registration_On_Validate as "Gift Registration - On Validate"
			{
			
							type =  form
							form = Gift_Registration
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Received_Date > zoho.currentdate)
													{
														alert "Received date cannot be in the future.";
														cancel submit;
													}
													if(ifnull(input.Estimated_Value,0) < 0)
													{
														alert "Estimated value cannot be negative.";
														cancel submit;
													}
													if(input.Status == "Pending_Finance" && input.Final_Decision == null)
													{
														alert "Final decision is required while the gift is pending finance review.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

