ard_Management&quot; zc-height=&quot;650px&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;idh-panel idh-panel-kanban&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;idh-embed-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;ID Card Status Kanban&lt;/h5&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Status-board tracking across Submitted, Card_Generated, Received, and Deactivated states&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Report:ID_Card_Status_Kanban?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;ID_Card_Status_Kanban&quot; zc-height=&quot;650px&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\tif(isASPIRE)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;idh-panel idh-panel-members&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;idh-embed-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;Member Master List&lt;/h5&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;ASPIRE/admin reference list for managed member records only&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Report:Member_Master_List?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Member_Master_List&quot; zc-height=&quot;650px&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&quot;idh-panel idh-panel-print&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;idh-embed-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;ID Card Layout link pattern&lt;/h5&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Open ID_Card_Layout with id_card_request_id for generated or received cards&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Page:ID_Card_Layout?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline design-print&quot;&gt;&lt;/i&gt;&lt;span&gt;Pattern&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Navigation pattern&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Use #Page:ID_Card_Layout?id_card_request_id=&amp;lt;ID_Card_Request.ID&amp;gt;&amp;amp;zc_LoadIn=dialog to preview or print a card.&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Recipient&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Extension ID&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Action&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tif(isPrivileged)\n\t{\n\t\tprintRows = ID_Card_Request[Status == &quot;Card_Generated&quot; || Status == &quot;Received&quot;];\n\t}\n\telse\n\t{\n\t\tprintRows = ID_Card_Request[Employee_Requester.Official_Email == loginEmail || Employee_Requester.Official_Email == zoho.loginuser &amp;&amp; Status == &quot;Card_Generated&quot; || Status == &quot;Received&quot;];\n\t}\n\tprintIndex = 0;\n\tfor each  cardRec in printRows\n\t{\n\t\tif(printIndex &lt; 6)\n\t\t{\n\t\t\tlayoutUrl = &quot;#Page:ID_Card_Layout?id_card_request_id=&quot; + cardRec.ID + &quot;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=false&quot;;\n\t\t\tstatusBadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(cardRec.Status == &quot;Received&quot;)\n\t\t\t{\n\t\t\t\tstatusBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\tprintIndex = printIndex + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(cardRec.Recipient_Name,&quot;ID card request&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(cardRec.Extension_ID_Number,&quot;Pending&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadgeClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=cardRec.Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;a class=&quot;zcs-button zcs-secondary-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-12 zcs-py-6 zcs-rounded-md zcs-box-border zcs-font-13&quot; href=&quot;&lt;%=layoutUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline design-print&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Layout&lt;/span&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(printIndex == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-24 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;No print-ready cards are available for this profile.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;idh-side zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;idh-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;idh-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;&lt;%=requestFormUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span&gt;New employee request&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;idh-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;idh-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_ID_Card_Requests?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-font-medium zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span&gt;Open my requests&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n&lt;%\n\tif(isPrivileged)\n\t{\n\t\t%&gt;\n&lt;li class=&quot;idh-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;idh-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:HR_ID_Card_Management?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-font-medium zc-li-outline ui-1-settings-gear-64&quot;&gt;&lt;/i&gt;&lt;span&gt;Manage ID cards&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;idh-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;idh-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:ID_Card_Status_Kanban?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-font-medium zc-li-outline design-bullet-list-67&quot;&gt;&lt;/i&gt;&lt;span&gt;Open status kanban&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n&lt;%\n\t}\n\tif(isASPIRE)\n\t{\n\t\t%&gt;\n&lt;li class=&quot;idh-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;idh-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Member_Master_List?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-font-medium zc-li-outline users-circle-10&quot;&gt;&lt;/i&gt;&lt;span&gt;Open member master&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Access notes&lt;/h5&gt;\n\t\t\t\t&lt;div class=&quot;idh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock zcs-font-18 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-15 zcs-color-primary zcs-font-medium&quot;&gt;No member self-service&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;This page intentionally exposes employee request flow and admin-managed member references only. Active MEMBER login UI is not surfaced here.&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\tif(isASPIRE)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;idh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Active member records&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-24 zcs-font-bold zcs-color-primary&quot;&gt;&lt;%=activeMembersCount%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Member_Master_List is visible for ASPIRE/admin review.&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page ID_Card_Layout(int id_card_request_id)
		{
					displayname = "ID Card Layout"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ID_Card_Print_Snippet' elementName='ID_Card_Print_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage ID_Card_Print_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tidCardRequestRows = ID_Card_Request[ID == input.id_card_request_id];\n\trequestFound = idCardRequestRows.count() &gt; 0;\n\t%&gt;\n&lt;style&gt;\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895);\n\t--zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--idc-card-width: 86mm;\n\t--idc-card-height: 54mm;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\na { text-decoration: none; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-w-full { width: 100%; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-text-center { text-align: center; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n.zcs-list-none { list-style-type: none; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }\n.zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, #2A6FFC); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, #2A6FFC); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, #F3F7FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color, #F3F7FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #a06309; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }\n.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }\n\n.idc-page {\n\tmin-height: 100%;\n\tbackground: #F6F7FB;\n\tcolor: var(--zcs-primary-text-color);\n\tpadding: 24px;\n\tbox-sizing: border-box;\n\tfont-family: Arial, Helvetica, sans-serif;\n}\n.idc-shell {\n\tmax-width: 1180px;\n\tmargin: 0 auto;\n}\n.idc-toolbar {\n\tmargin-bottom: 18px;\n\talign-items: flex-start;\n}\n.idc-title-block h1 {\n\tmargin: 0;\n\tfont-size: 24px;\n\tline-height: 1.2;\n\tcolor: var(--zcs-primary-text-color);\n}\n.idc-title-block p {\n\tmargin: 6px 0 0 0;\n\tcolor: var(--zcs-secondary-text-color);\n\tfont-size: 14px;\n}\n.idc-actions {\n\tflex-wrap: wrap;\n\tjustify-content: flex-end;\n}\n.idc-content-grid {\n\tdisplay: grid;\n\tgrid-template-columns: minmax(0, 1fr) 340px;\n\tgap: 18px;\n\talign-items: start;\n}\n.idc-print-sheet {\n\tbackground: #FFFFFF;\n\tborder: 1px solid var(--zcs-border-color);\n\tborder-radius: 16px;\n\tpadding: 28px;\n\tbox-shadow: 0 16px 50px rgba(15, 23, 42, 0.08);\n}\n.idc-card-stack {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 24px;\n\talign-items: center;\n\tjustify-content: center;\n}\n.idc-card {\n\twidth: var(--idc-card-width);\n\theight: var(--idc-card-height);\n\tborder-radius: 4.2mm;\n\toverflow: hidden;\n\tposition: relative;\n\tbackground: #FFFFFF;\n\tcolor: #152035;\n\tborder: .28mm solid #D8DEE9;\n\tbox-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);\n\tbox-sizing: border-box;\n\tpage-break-inside: avoid;\n}\n.idc-front {\n\tdisplay: grid;\n\tgrid-template-rows: 12.5mm 1fr 8mm;\n}\n.idc-header-band {\n\tbackground: linear-gradient(135deg, var(--zcs_brand_color, #1C5FB8), #12345E);\n\tcolor: #FFFFFF;\n\tpadding: 2.2mm 4mm;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n}\n.idc-org {\n\tfont-size: 3.4mm;\n\tline-height: 1.15;\n\tfont-weight: 700;\n\tletter-spacing: .15mm;\n}\n.idc-card-kind {\n\tfont-size: 2.45mm;\n\tline-height: 1;\n\tborder: .25mm solid rgba(255,255,255,.72);\n\tborder-radius: 99px;\n\tpadding: 1.1mm 1.8mm;\n\twhite-space: nowrap;\n}\n.idc-front-body {\n\tdisplay: grid;\n\tgrid-template-columns: 24mm 1fr;\n\tgap: 3mm;\n\tpadding: 4mm;\n\talign-items: center;\n}\n.idc-photo-box {\n\twidth: 23mm;\n\theight: 28mm;\n\tborder-radius: 3mm;\n\tbackground: #EEF2F7;\n\tborder: .25mm solid #D8DEE9;\n\toverflow: hidden;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n}\n.idc-photo-box img {\n\twidth: 100%;\n\theight: 100%;\n\tobject-fit: cover;\n}\n.idc-photo-placeholder {\n\tcolor: #8A94A6;\n\tfont-size: 9mm;\n}\n.idc-person {\n\tmin-width: 0;\n}\n.idc-person-name {\n\tmargin: 0 0 1.8mm 0;\n\tfont-size: 5.1mm;\n\tline-height: 1.06;\n\tfont-weight: 800;\n\tcolor: #111827;\n\tword-break: break-word;\n}\n.idc-person-role {\n\tmargin: 0 0 2.4mm 0;\n\tfont-size: 3.05mm;\n\tcolor: #334155;\n\tfont-weight: 600;\n\tline-height: 1.18;\n}\n.idc-meta-line {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 1.6mm;\n\tfont-size: 2.55mm;\n\tline-height: 1.2;\n\tcolor: #475569;\n\tmargin-top: 1.4mm;\n}\n.idc-meta-label {\n\tcolor: #64748B;\n\tmin-width: 15mm;\n}\n.idc-meta-value {\n\tcolor: #1F2937;\n\tfont-weight: 700;\n\tmin-width: 0;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n\twhite-space: nowrap;\n}\n.idc-footer-band {\n\tbackground: #F8FAFC;\n\tborder-top: .25mm solid #E2E8F0;\n\tpadding: 1.8mm 4mm;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tfont-size: 2.5mm;\n\tcolor: #334155;\n}\n.idc-back {\n\tdisplay: grid;\n\tgrid-template-rows: 9mm 1fr 8mm;\n}\n.idc-back-header {\n\tpadding: 2.2mm 4mm;\n\tborder-bottom: .25mm solid #E2E8F0;\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: center;\n\tfont-size: 2.7mm;\n\tfont-weight: 700;\n\tcolor: #0F172A;\n}\n.idc-back-body {\n\tpadding: 3.3mm 4mm 2.8mm 4mm;\n}\n.idc-valid-box {\n\tdisplay: grid;\n\tgrid-template-columns: 1fr 1fr;\n\tgap: 2.2mm;\n\tmargin-bottom: 3mm;\n}\n.idc-mini-label {\n\tdisplay: block;\n\tfont-size: 2.15mm;\n\tcolor: #64748B;\n\ttext-transform: uppercase;\n\tletter-spacing: .16mm;\n\tmargin-bottom: .8mm;\n}\n.idc-mini-value {\n\tdisplay: block;\n\tfont-size: 2.8mm;\n\tcolor: #111827;\n\tfont-weight: 700;\n}\n.idc-barcode-panel {\n\tborder: .25mm solid #CBD5E1;\n\tborder-radius: 2.2mm;\n\tpadding: 1.8mm;\n\tbackground: #FFFFFF;\n}\n.idc-barcode-svg {\n\twidth: 100%;\n\theight: 12.5mm;\n\tdisplay: block;\n}\n.idc-barcode-fallback {\n\theight: 12.5mm;\n\tborder-radius: 1mm;\n\tbackground: repeating-linear-gradient(90deg, #111827 0 1.1mm, #FFFFFF 1.1mm 1.8mm, #111827 1.8mm 2.15mm, #FFFFFF 2.15mm 3mm);\n}\n.idc-barcode-text {\n\tmargin-top: 1.1mm;\n\ttext-align: center;\n\tfont-size: 2.55mm;\n\tletter-spacing: .25mm;\n\tfont-weight: 700;\n\tcolor: #111827;\n}\n.idc-back-footer {\n\tpadding: 1.8mm 4mm;\n\tborder-top: .25mm solid #E2E8F0;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tcolor: #475569;\n\tfont-size: 2.25mm;\n}\n.idc-context-panel {\n\tpadding: 20px;\n}\n.idc-context-panel h2 {\n\tmargin: 0 0 14px 0;\n\tfont-size: 18px;\n\tcolor: var(--zcs-primary-text-color);\n}\n.idc-kv-list {\n\tlist-style: none;\n\tpadding: 0;\n\tmargin: 0;\n\tdisplay: grid;\n\tgap: 12px;\n}\n.idc-kv-list li {\n\tdisplay: grid;\n\tgap: 3px;\n}\n.idc-kv-list label {\n\tcolor: var(--zcs-teritiary-text-color);\n}\n.idc-kv-list span {\n\tcolor: var(--zcs-primary-text-color);\n}\n.idc-note {\n\tmargin: 16px 0 0 0;\n\tpadding: 12px;\n\tborder: 1px dashed var(--zcs-border-color);\n\tborder-radius: 10px;\n\tcolor: var(--zcs-secondary-text-color);\n\tfont-size: 13px;\n\tbackground: #FBFCFF;\n}\n.idc-nodata-wrap {\n\tmin-height: 360px;\n\tbackground: #FFFFFF;\n\tborder: 1px solid var(--zcs-border-color);\n\tborder-radius: 16px;\n}\n@media (max-width: 980px) {\n\t.idc-content-grid { grid-template-columns: 1fr; }\n\t.idc-actions { justify-content: flex-start; }\n}\n@media print {\n\t@page { size: A4 portrait; margin: 12mm; }\n\thtml, body { background: #FFFFFF !important; }\n\t.idc-page { padding: 0 !important; background: #FFFFFF !important; }\n\t.idc-toolbar, .idc-context-panel { display: none !important; }\n\t.idc-shell, .idc-content-grid, .idc-print-sheet { max-width: none !important; margin: 0 !important; display: block !important; }\n\t.idc-print-sheet { border: 0 !important; box-shadow: none !important; padding: 0 !important; }\n\t.idc-card-stack { justify-content: flex-start !important; align-items: flex-start !important; gap: 10mm !important; }\n\t.idc-card { box-shadow: none !important; break-inside: avoid; page-break-inside: avoid; }\n\t.zc-pb-tile-card, .zc-pb-tile-container { box-shadow: none !important; border: 0 !important; }\n}\n&lt;/style&gt;\n&lt;div class=&quot;idc-page&quot;&gt;\n\t&lt;div class=&quot;idc-shell&quot;&gt;\n&lt;%\n\tif(!requestFound)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;idc-nodata-wrap zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No ID card request found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;Check the page parameter id_card_request_id and open this page again.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\treq = idCardRequestRows;\n\t\trequestIdText = req.ID.toString();\n\t\trequesterType = ifnull(req.Requester_Type,&quot;Not set&quot;);\n\t\trecipientName = ifnull(req.Recipient_Name,&quot;Unnamed recipient&quot;);\n\t\tdesignationText = ifnull(req.Recipient_Designation,&quot;Designation not set&quot;);\n\t\textensionText = ifnull(req.Extension_ID_Number,&quot;&quot;);\n\t\tif(extensionText == &quot;&quot;)\n\t\t{\n\t\t\textensionDisplay = &quot;Pending&quot;;\n\t\t\tbarcodeValue = &quot;&quot;;\n\t\t}\n\t\telse\n\t\t{\n\t\t\textensionDisplay = extensionText;\n\t\t\tbarcodeValue = extensionText;\n\t\t}\n\t\trequestTypeText = ifnull(req.Request_Type,&quot;Not set&quot;);\n\t\tstatusRaw = ifnull(req.Status,&quot;Submitted&quot;);\n\t\tstatusDisplay = statusRaw;\n\t\tstatusBadge = &quot;zcs-badge-blue&quot;;\n\t\tif(statusRaw == &quot;Submitted&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\telse if(statusRaw == &quot;Extension_ID_Updated&quot;)\n\t\t{\n\t\t\tstatusDisplay = &quot;Extension ID Updated&quot;;\n\t\t\tstatusBadge = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(statusRaw == &quot;Card_Generated&quot;)\n\t\t{\n\t\t\tstatusDisplay = &quot;Card Generated&quot;;\n\t\t\tstatusBadge = &quot;zcs-badge-blue&quot;;\n\t\t}\n\t\telse if(statusRaw == &quot;Received&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(statusRaw == &quot;Deactivated&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\tvalidFromText = &quot;Not set&quot;;\n\t\tif(req.Valid_From != null)\n\t\t{\n\t\t\tvalidFromText = req.Valid_From.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\tvalidUptoText = &quot;Not set&quot;;\n\t\tif(req.Valid_Upto != null)\n\t\t{\n\t\t\tvalidUptoText = req.Valid_Upto.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\treceivedDateText = &quot;Not received&quot;;\n\t\tif(req.Received_Date != null)\n\t\t{\n\t\t\treceivedDateText = req.Received_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t}\n\t\tsourceLabel = &quot;Source record&quot;;\n\t\tsourceCode = &quot;Not available&quot;;\n\t\tsourceEmail = &quot;Not available&quot;;\n\t\tsourceMeta = &quot;Not available&quot;;\n\t\tsourceUrl = &quot;&quot;;\n\t\tphotoUrl = ifnull(req.Recipient_Photo,&quot;&quot;);\n\t\tif(requesterType == &quot;Employee&quot;)\n\t\t{\n\t\t\temployeeRows = Employee_Master[ID == req.Employee_Requester];\n\t\t\tsourceLabel = &quot;Employee Master&quot;;\n\t\t\tsourceUrl = &quot;#Report:All_Employees?ID=&quot; + req.Employee_Requester + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\tif(employeeRows.count() &gt; 0)\n\t\t\t{\n\t\t\t\trecipientName = ifnull(req.Recipient_Name,ifnull(employeeRows.Full_Name,recipientName));\n\t\t\t\tdesignationText = ifnull(req.Recipient_Designation,ifnull(employeeRows.Designation,designationText));\n\t\t\t\tsourceCode = ifnull(employeeRows.Employee_ID,&quot;Not available&quot;);\n\t\t\t\tsourceEmail = ifnull(employeeRows.Official_Email,&quot;Not available&quot;);\n\t\t\t\tsourceMeta = ifnull(employeeRows.Department.Department_Name,&quot;Department not set&quot;);\n\t\t\t\tif(photoUrl == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tphotoUrl = ifnull(employeeRows.Profile_Photo,&quot;&quot;);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\telse if(requesterType == &quot;Member&quot;)\n\t\t{\n\t\t\tmemberRows = Member_Master[ID == req.Member_Requester];\n\t\t\tsourceLabel = &quot;Member Master&quot;;\n\t\t\tsourceUrl = &quot;#Report:Member_Master_List?ID=&quot; + req.Member_Requester + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t\tif(memberRows.count() &gt; 0)\n\t\t\t{\n\t\t\t\trecipientName = ifnull(req.Recipient_Name,ifnull(memberRows.Member_Name,recipientName));\n\t\t\t\tdesignationText = ifnull(req.Recipient_Designation,ifnull(memberRows.Member_Type,designationText));\n\t\t\t\tsourceCode = ifnull(memberRows.Member_ID,&quot;Not available&quot;);\n\t\t\t\tsourceEmail = ifnull(memberRows.Member_Email,&quot;Not available&quot;);\n\t\t\t\tsourceMeta = ifnull(memberRows.Organization,&quot;Organization not set&quot;);\n\t\t\t}\n\t\t}\n\t\trequestUrl = &quot;#Report:HR_ID_Card_Management?ID=&quot; + requestIdText + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\t%&gt;\n&lt;div class=&quot;idc-toolbar zcs-flex zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;idc-title-block&quot;&gt;\n\t\t\t\t&lt;h1&gt;ID Card Layout&lt;/h1&gt;\n\t\t\t\t&lt;p&gt;Printable ID card for request &lt;strong&gt;#&lt;%=requestIdText%&gt;&lt;/strong&gt;. Data is fetched live from ID_Card_Request and the linked &lt;%=sourceLabel%&gt; record.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;idc-actions zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#&quot; onclick=&quot;window.print(); return false;&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Print&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#&quot; onclick=&quot;window.print(); return false;&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Save as PDF&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=requestUrl%&gt;&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Request&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;idc-content-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;idc-print-sheet&quot; aria-label=&quot;Printable ID card sheet&quot;&gt;\n\t\t\t\t&lt;div class=&quot;idc-card-stack&quot;&gt;\n\t\t\t\t\t&lt;article class=&quot;idc-card idc-front&quot; aria-label=&quot;ID card front&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-header-band&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-org&quot;&gt;IITB HR&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-card-kind&quot;&gt;&lt;%=requesterType%&gt; ID&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-front-body&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-photo-box&quot;&gt;\n&lt;%\n\t\tif(photoUrl != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;img src=&quot;&lt;%=photoUrl%&gt;&quot; alt=&quot;Recipient photo&quot; onerror=&quot;this.style.display=&apos;none&apos;; this.parentNode.classList.add(&apos;idc-photo-missing&apos;);&quot; /&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;span class=&quot;idc-photo-placeholder&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-person&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;idc-person-name&quot;&gt;&lt;%=recipientName%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;idc-person-role&quot;&gt;&lt;%=designationText%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;idc-meta-line&quot;&gt;&lt;span class=&quot;idc-meta-label&quot;&gt;Ext ID&lt;/span&gt;&lt;span class=&quot;idc-meta-value&quot;&gt;&lt;%=extensionDisplay%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;idc-meta-line&quot;&gt;&lt;span class=&quot;idc-meta-label&quot;&gt;Type&lt;/span&gt;&lt;span class=&quot;idc-meta-value&quot;&gt;&lt;%=requesterType%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;idc-meta-line&quot;&gt;&lt;span class=&quot;idc-meta-label&quot;&gt;Source&lt;/span&gt;&lt;span class=&quot;idc-meta-value&quot;&gt;&lt;%=sourceCode%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-footer-band&quot;&gt;\n\t\t\t\t\t\t\t&lt;span&gt;Valid: &lt;%=validFromText%&gt; to &lt;%=validUptoText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span&gt;#&lt;%=requestIdText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t&lt;article class=&quot;idc-card idc-back&quot; aria-label=&quot;ID card back&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-back-header&quot;&gt;\n\t\t\t\t\t\t\t&lt;span&gt;Extension Barcode&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span&gt;&lt;%=requestTypeText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-back-body&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-valid-box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;idc-mini-label&quot;&gt;Valid From&lt;/span&gt;&lt;span class=&quot;idc-mini-value&quot;&gt;&lt;%=validFromText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span class=&quot;idc-mini-label&quot;&gt;Valid Upto&lt;/span&gt;&lt;span class=&quot;idc-mini-value&quot;&gt;&lt;%=validUptoText%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;idc-barcode-panel&quot;&gt;\n&lt;%\n\t\tif(barcodeValue != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;svg class=&quot;idc-barcode-svg&quot; data-code=&quot;&lt;%=barcodeValue%&gt;&quot; role=&quot;img&quot; aria-label=&quot;Extension barcode&quot;&gt;&lt;/svg&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;idc-barcode-text&quot;&gt;&lt;%=barcodeValue%&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;idc-barcode-fallback&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;idc-barcode-text&quot;&gt;Extension ID pending&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;idc-back-footer&quot;&gt;\n\t\t\t\t\t\t\t&lt;span&gt;&lt;%=requesterType%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span&gt;Received: &lt;%=receivedDateText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t\t&lt;aside class=&quot;idc-context-panel zcs-card zcs-box-border&quot; aria-label=&quot;Request context&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;h2&gt;Request Context&lt;/h2&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadge%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=statusDisplay%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-labelvalue-wrapper&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;idc-kv-list zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Recipient&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=recipientName%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Designation&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=designationText%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Requester Type&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=requesterType%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Extension ID Number&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=extensionDisplay%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Valid Dates&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=validFromText%&gt; to &lt;%=validUptoText%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=sourceLabel%&gt;&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=sourceCode%&gt; \u00B7 &lt;%=sourceEmail%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li&gt;&lt;label class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;Source Details&lt;/label&gt;&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-lh-body&quot;&gt;&lt;%=sourceMeta%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-8 zcs-row&quot; style=&quot;margin-top:16px;&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=requestUrl%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Request Report&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\tif(sourceUrl != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=sourceUrl%&gt;&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-email-85&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Source Record&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;idc-note&quot;&gt;For PDF output, choose Print or Save as PDF and use the browser print dialog. The page includes print CSS for a clean card-only output.&lt;/p&gt;\n\t\t\t&lt;/aside&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;script&gt;\n(function () {\n\tvar patterns = [&quot;212222&quot;,&quot;222122&quot;,&quot;222221&quot;,&quot;121223&quot;,&quot;121322&quot;,&quot;131222&quot;,&quot;122213&quot;,&quot;122312&quot;,&quot;132212&quot;,&quot;221213&quot;,&quot;221312&quot;,&quot;231212&quot;,&quot;112232&quot;,&quot;122132&quot;,&quot;122231&quot;,&quot;113222&quot;,&quot;123122&quot;,&quot;123221&quot;,&quot;223211&quot;,&quot;221132&quot;,&quot;221231&quot;,&quot;213212&quot;,&quot;223112&quot;,&quot;312131&quot;,&quot;311222&quot;,&quot;321122&quot;,&quot;321221&quot;,&quot;312212&quot;,&quot;322112&quot;,&quot;322211&quot;,&quot;212123&quot;,&quot;212321&quot;,&quot;232121&quot;,&quot;111323&quot;,&quot;131123&quot;,&quot;131321&quot;,&quot;112313&quot;,&quot;132113&quot;,&quot;132311&quot;,&quot;211313&quot;,&quot;231113&quot;,&quot;231311&quot;,&quot;112133&quot;,&quot;112331&quot;,&quot;132131&quot;,&quot;113123&quot;,&quot;113321&quot;,&quot;133121&quot;,&quot;313121&quot;,&quot;211331&quot;,&quot;231131&quot;,&quot;213113&quot;,&quot;213311&quot;,&quot;213131&quot;,&quot;311123&quot;,&quot;311321&quot;,&quot;331121&quot;,&quot;312113&quot;,&quot;312311&quot;,&quot;332111&quot;,&quot;314111&quot;,&quot;221411&quot;,&quot;431111&quot;,&quot;111224&quot;,&quot;111422&quot;,&quot;121124&quot;,&quot;121421&quot;,&quot;141122&quot;,&quot;141221&quot;,&quot;112214&quot;,&quot;112412&quot;,&quot;122114&quot;,&quot;122411&quot;,&quot;142112&quot;,&quot;142211&quot;,&quot;241211&quot;,&quot;221114&quot;,&quot;413111&quot;,&quot;241112&quot;,&quot;134111&quot;,&quot;111242&quot;,&quot;121142&quot;,&quot;121241&quot;,&quot;114212&quot;,&quot;124112&quot;,&quot;124211&quot;,&quot;411212&quot;,&quot;421112&quot;,&quot;421211&quot;,&quot;212141&quot;,&quot;214121&quot;,&quot;412121&quot;,&quot;111143&quot;,&quot;111341&quot;,&quot;131141&quot;,&quot;114113&quot;,&quot;114311&quot;,&quot;411113&quot;,&quot;411311&quot;,&quot;113141&quot;,&quot;114131&quot;,&quot;311141&quot;,&quot;411131&quot;,&quot;211412&quot;,&quot;211214&quot;,&quot;211232&quot;,&quot;2331112&quot;];\n\tfunction cleanCode(value) {\n\t\tvalue = String(value || &quot;&quot;);\n\t\tvar result = &quot;&quot;;\n\t\tfor (var i = 0; i &lt; value.length; i++) {\n\t\t\tvar c = value.charCodeAt(i);\n\t\t\tif (c &gt;= 32 &amp;&amp; c &lt;= 126) {\n\t\t\t\tresult += value.charAt(i);\n\t\t\t}\n\t\t}\n\t\treturn result;\n\t}\n\tfunction code128B(value) {\n\t\tvalue = cleanCode(value);\n\t\tif (!value) { return null; }\n\t\tvar codes = [104];\n\t\tvar checksum = 104;\n\t\tfor (var i = 0; i &lt; value.length; i++) {\n\t\t\tvar code = value.charCodeAt(i) - 32;\n\t\t\tcodes.push(code);\n\t\t\tchecksum += code * (i + 1);\n\t\t}\n\t\tcodes.push(checksum % 103);\n\t\tcodes.push(106);\n\t\treturn codes;\n\t}\n\tfunction draw(svg) {\n\t\tvar data = code128B(svg.getAttribute(&quot;data-code&quot;));\n\t\tif (!data) { return; }\n\t\tvar module = 2;\n\t\tvar height = 44;\n\t\tvar x = 0;\n\t\tvar rects = [];\n\t\tfor (var i = 0; i &lt; data.length; i++) {\n\t\t\tvar pattern = patterns[data[i]];\n\t\t\tvar bar = true;\n\t\t\tfor (var j = 0; j &lt; pattern.length; j++) {\n\t\t\t\tvar width = parseInt(pattern.charAt(j), 10) * module;\n\t\t\t\tif (bar) {\n\t\t\t\t\trects.push(&quot;&lt;rect x=&apos;&quot; + x + &quot;&apos;y=&apos;0&apos;width=&apos;&quot; + width + &quot;&apos;height=&apos;&quot; + height + &quot;&apos;fill=&apos;#111827&apos;&gt;&lt;/rect&gt;&quot;);\n\t\t\t\t}\n\t\t\t\tx += width;\n\t\t\t\tbar = !bar;\n\t\t\t}\n\t\t}\n\t\tsvg.setAttribute(&quot;viewBox&quot;, &quot;0 0 &quot; + x + &quot;&quot; + height);\n\t\tsvg.setAttribute(&quot;preserveAspectRatio&quot;, &quot;none&quot;);\n\t\tsvg.innerHTML = rects.join(&quot;&quot;);\n\t}\n\tvar nodes = document.querySelectorAll(&quot;.idc-barcode-svg[data-code]&quot;);\n\tfor (var n = 0; n &lt; nodes.length; n++) {\n\t\tdraw(nodes[n]);\n\t}\n}());\n&lt;/script&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page IT_Admin_Dashboard
		{
					displayname = "IT Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='IT_Admin_Dashboard_Snippet' elementName='IT_Admin_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage IT_Admin_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;IT_ADMIN&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\tlwdEndDate = todayDate.addDay(30);\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tlwdEndDisplay = lwdEndDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tuserRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tuserName = ifnull(zoho.loginuser,&quot;IT Admin&quot;);\n\tuserSubText = ifnull(loginRole,&quot;IT_ADMIN&quot;);\n\tuserInitial = &quot;I&quot;;\n\tif(userRows.count() &gt; 0)\n\t{\n\t\tuserEmp = userRows;\n\t\tuserName = ifnull(userEmp.Full_Name,userName);\n\t\tuserSubText = ifnull(userEmp.Designation,userSubText);\n\t}\n\tif(userName != null &amp;&amp; userName != &quot;&quot;)\n\t{\n\t\tuserInitial = userName.left(1).toUpperCase();\n\t}\n\tallChecklistRows = Offboarding_Checklist[Status == &quot;Pending&quot;] sort by Completed_Date descending;\n\tpendingChecklistCount = 0;\n\tfor each  checklistSeed in allChecklistRows\n\t{\n\t\tincludeChecklist = false;\n\t\tdeptNameSeed = ifnull(checklistSeed.Responsible_Department.Department_Name,&quot;&quot;);\n\t\titemNameSeed = ifnull(checklistSeed.Checklist_Item.Checklist_Item,&quot;&quot;);\n\t\tpersonEmailSeed = ifnull(checklistSeed.Responsible_Person.Official_Email,&quot;&quot;);\n\t\tif(personEmailSeed == loginEmail || personEmailSeed == zoho.loginuser)\n\t\t{\n\t\t\tincludeChecklist = true;\n\t\t}\n\t\tif(deptNameSeed == &quot;IT&quot; || deptNameSeed == &quot;Information Technology&quot; || deptNameSeed == &quot;IT Department&quot; || deptNameSeed == &quot;Technology&quot; || itemNameSeed.contains(&quot;IT&quot;) || itemNameSeed.contains(&quot;Laptop&quot;) || itemNameSeed.contains(&quot;Asset&quot;) || itemNameSeed.contains(&quot;Access&quot;))\n\t\t{\n\t\t\tincludeChecklist = true;\n\t\t}\n\t\tif(includeChecklist == true)\n\t\t{\n\t\t\tpendingChecklistCount = pendingChecklistCount + 1;\n\t\t}\n\t}\n\tpendingAssetRows = Employee_Asset_Recovery[Recovery_Status == &quot;Pending&quot;] sort by Assigned_Date asc;\n\tpendingAssetCount = pendingAssetRows.count();\n\trecoveredAssetCount = Employee_Asset_Recovery[Recovery_Status == &quot;Recovered&quot;].count();\n\tnotFoundAssetCount = Employee_Asset_Recovery[Recovery_Status == &quot;Not_Found&quot;].count();\n\tsyncFailedRows = Employee_Asset_Recovery[External_Sync_Status == &quot;Sync_Failed&quot;] sort by Recovery_Date descending;\n\tsyncFailedCount = syncFailedRows.count();\n\tpendingSyncCount = Employee_Asset_Recovery[External_Sync_Status == &quot;Pending_Sync&quot;].count();\n\tsyncedCount = Employee_Asset_Recovery[External_Sync_Status == &quot;Synced&quot;].count();\n\tupcomingResignationRows = Resignation_Request[Status == &quot;Approved&quot; &amp;&amp; Effective_LWD &gt;= todayDate &amp;&amp; Effective_LWD &lt;= lwdEndDate] sort by Effective_LWD asc;\n\tupcomingLwdCount = upcomingResignationRows.count();\n\t%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for IT_Admin_Dashboard */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-relative { position: relative; } .zcs-sticky { position: sticky; }\n.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mx-0 { margin-left: 0; margin-right: 0; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-red { color: #FE455D; } .zcs-color-green { color: #179E6C; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-overflow-auto { overflow: auto; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n/* ZCS component CSS: header-heading-with-actions, button-primary-button */\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; } .zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, #2A6FFC); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, #2A6FFC); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, #F2F6FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: badge-badge-with-icon */\n.zcs-badge { width: auto; } .zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; } .zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color, #F2F6FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); } .zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; } .zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; } .zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #b8770d; } .zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; } .zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; } .zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }\n/* ZCS component CSS: table-simple-table */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }\n/* IT Admin dashboard */\n.itd-page { min-height: 100%; background: var(--zcs-page-bg-color, #F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }\n.itd-shell { padding: 22px; box-sizing: border-box; }\n.itd-hero { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); margin-bottom: 16px; }\n.itd-hero:after { content: &quot;&quot;; position: absolute; width: 300px; height: 300px; right: -90px; top: -125px; border-radius: 50%; border: 38px solid rgba(255,255,255,.13); }\n.itd-hero-inner { position: relative; z-index: 1; }\n.itd-avatar { width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,.20); border: 1px solid rgba(255,255,255,.35); color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.itd-hero .itd-muted, .itd-hero .zcs-color-secondary, .itd-hero .zcs-color-tertiary { color: rgba(255,255,255,.84); }\n.itd-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }\n.itd-two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin-bottom: 16px; }\n.itd-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; box-shadow: 0 8px 24px rgba(15,23,42,.05); }\n.itd-kpi { min-height: 128px; }\n.itd-kpi-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--zcs_component_hover_color, #F2F6FF); color: var(--zcs_brand_color, #2A6FFC); }\n.itd-kpi-icon.itd-warn { background: #FCF4E6; color: #b8770d; }\n.itd-kpi-icon.itd-danger { background: #FDE3E6; color: #FE455D; }\n.itd-kpi-icon.itd-ok { background: #E4FCF3; color: #179E6C; }\n.itd-section-header { border-bottom: 1px solid var(--zcs-border-color); }\n.itd-mini-list { list-style: none; margin: 0; padding: 0; }\n.itd-mini-list li { padding: 12px 16px; border-top: 1px solid var(--zcs-border-color); }\n.itd-mini-list li:first-child { border-top: 0; }\n.itd-asset-name { max-width: 250px; }\n.itd-progress { height: 8px; width: 100%; border-radius: 999px; background: #EEF2F7; overflow: hidden; }\n.itd-progress span { display: block; height: 100%; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }\n.itd-link-card:hover { border-color: var(--zcs_brand_color, #2A6FFC); box-shadow: 0 10px 28px rgba(15,23,42,.08); }\n.itd-retry-placeholder { border-top: 1px dashed var(--zcs-border-color); background: #FBFCFF; }\n.itd-access-denied { min-height: 360px; }\n@media (max-width: 1180px) { .itd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .itd-two-col { grid-template-columns: 1fr; } }\n@media (max-width: 640px) { .itd-shell { padding: 14px; } .itd-grid { grid-template-columns: 1fr; } .itd-hero .zcs-flex.zcs-justify-space-between { align-items: flex-start; flex-direction: column; } .zcs-page-header { padding: 14px; } }\n&lt;/style&gt;\n&lt;%\n\tif(isAllowed == false)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;itd-page itd-shell&quot;&gt;\n\t&lt;div class=&quot;itd-card itd-access-denied zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-lock&quot; style=&quot;font-size:40px;color:#FE455D;&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-8&quot;&gt;Access restricted&lt;/h5&gt;\n\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;This dashboard is available to IT_ADMIN and Administrator profiles.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;itd-page&quot;&gt;\n\t&lt;div class=&quot;itd-shell&quot;&gt;\n\t\t&lt;div class=&quot;itd-hero zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;itd-hero-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-16 zcs-col-common zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-font-22 zcs-font-semibold&quot;&gt;&lt;%=userInitial%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-white zcs-m-0&quot;&gt;IT offboarding command center&lt;/h5&gt;\n\t\t\t\t\t\t&lt;span class=&quot;itd-muted zcs-font-14 zcs-font-normal zcs-lh-body zcs-ellipsis&quot;&gt;Hello &lt;%=userName%&gt;. Live queues as of &lt;%=todayDisplay%&gt;.&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-list-bullet&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Checklist view&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline tech-laptop&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Asset recovery&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;itd-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-list-bullet zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Pending&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=pendingChecklistCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;IT checklist items&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline tech-laptop zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-settings-gear-64&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Recovery&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=pendingAssetCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Assets pending recovery&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-kpi-icon itd-danger zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Sync failed&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=syncFailedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Assets needing retry&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-kpi-icon itd-warn zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-57 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-notification-69&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;30 days&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary&quot;&gt;&lt;%=upcomingLwdCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Upcoming LWD through &lt;%=lwdEndDisplay%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;itd-two-col&quot;&gt;\n\t\t\t&lt;div class=&quot;itd-card zcs-box-border zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;div class=&quot;itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending IT checklist items&lt;/h5&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Assigned IT tasks and asset/access related checklist rows&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingChecklistCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border&quot; style=&quot;min-height:180px;&quot;&gt;&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No pending IT checklist items&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;ul class=&quot;itd-mini-list&quot;&gt;\n&lt;%\n\t\t\tshownChecklist = 0;\n\t\t\tfor each  checklistItem in allChecklistRows\n\t\t\t{\n\t\t\t\tincludeChecklistRow = false;\n\t\t\t\tdeptName = ifnull(checklistItem.Responsible_Department.Department_Name,&quot;&quot;);\n\t\t\t\titemName = ifnull(checklistItem.Checklist_Item.Checklist_Item,&quot;Checklist item&quot;);\n\t\t\t\tpersonEmail = ifnull(checklistItem.Responsible_Person.Official_Email,&quot;&quot;);\n\t\t\t\tif(personEmail == loginEmail || personEmail == zoho.loginuser || deptName == &quot;IT&quot; || deptName == &quot;Information Technology&quot; || deptName == &quot;IT Department&quot; || deptName == &quot;Technology&quot; || itemName.contains(&quot;IT&quot;) || itemName.contains(&quot;Laptop&quot;) || itemName.contains(&quot;Asset&quot;) || itemName.contains(&quot;Access&quot;))\n\t\t\t\t{\n\t\t\t\t\tincludeChecklistRow = true;\n\t\t\t\t}\n\t\t\t\tif(includeChecklistRow == true &amp;&amp; shownChecklist &lt; 5)\n\t\t\t\t{\n\t\t\t\t\tshownChecklist = shownChecklist + 1;\n\t\t\t\t\trespPerson = ifnull(checklistItem.Responsible_Person.Full_Name,&quot;Unassigned&quot;);\n\t\t\t\t\treqLabel = ifnull(checklistItem.Resignation_Request.Employee.Full_Name,&quot;Resignation request&quot;);\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=itemName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&quot;&gt;&lt;%=reqLabel%&gt; \u00B7 &lt;%=deptName%&gt; \u00B7 &lt;%=respPerson%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Pending&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;itd-card zcs-box-border zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;div class=&quot;itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending asset recovery&lt;/h5&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Assets awaiting recovered or not found status&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Asset&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Employee&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Assigned&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;4&quot;&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tif(pendingAssetCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot; colspan=&quot;4&quot;&gt;No pending asset recovery rows&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownPendingAsset = 0;\n\t\t\tfor each  assetItem in pendingAssetRows\n\t\t\t{\n\t\t\t\tif(shownPendingAsset &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tshownPendingAsset = shownPendingAsset + 1;\n\t\t\t\t\tassignedText = &quot;-&quot;;\n\t\t\t\t\tif(assetItem.Assigned_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tassignedText = assetItem.Assigned_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tassetEmployee = ifnull(assetItem.Employee.Full_Name,&quot;-&quot;);\n\t\t\t\t\tassetName = ifnull(assetItem.Asset_Name,&quot;Asset&quot;);\n\t\t\t\t\tassetId = ifnull(assetItem.Asset_ID,&quot;-&quot;);\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;div class=&quot;itd-asset-name zcs-ellipsis&quot;&gt;&lt;%=assetName%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-ellipsis&quot;&gt;&lt;%=assetId%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=assetEmployee%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;&lt;%=assignedText%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&quot;&gt;Pending&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;itd-two-col&quot;&gt;\n\t\t\t&lt;div class=&quot;itd-card zcs-box-border zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;div class=&quot;itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Sync failed assets&lt;/h5&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;External PUT integration is a safe placeholder; retries are tracked manually for now&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Asset_Sync_Failed?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open failed list&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(syncFailedCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border&quot; style=&quot;min-height:180px;&quot;&gt;&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No sync failures&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;ul class=&quot;itd-mini-list&quot;&gt;\n&lt;%\n\t\t\tshownFailed = 0;\n\t\t\tfor each  failedAsset in syncFailedRows\n\t\t\t{\n\t\t\t\tif(shownFailed &lt; 5)\n\t\t\t\t{\n\t\t\t\t\tshownFailed = shownFailed + 1;\n\t\t\t\t\tfailedDateText = &quot;No recovery date&quot;;\n\t\t\t\t\tif(failedAsset.Recovery_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tfailedDateText = failedAsset.Recovery_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n&lt;li&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=ifnull(failedAsset.Asset_Name,&quot;Asset&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&quot;&gt;&lt;%=ifnull(failedAsset.Employee.Full_Name,&quot;-&quot;)%&gt; \u00B7 &lt;%=ifnull(failedAsset.Asset_ID,&quot;-&quot;)%&gt; \u00B7 &lt;%=failedDateText%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Sync failed&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;itd-retry-placeholder zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-py-8 zcs-px-12 zcs-box-border zcs-rounded-md&quot; style=&quot;margin-top:10px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Retry action placeholder pending real asset API.&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Asset_Sync_Failed?ID=&lt;%=failedAsset.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Review&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;itd-card zcs-box-border zcs-overflow-auto&quot;&gt;\n\t\t\t\t&lt;div class=&quot;itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Upcoming LWD within 30 days&lt;/h5&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;Approved exits from &lt;%=todayDisplay%&gt; to &lt;%=lwdEndDisplay%&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_Offboarding_Dashboard?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Open offboarding&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(upcomingLwdCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border&quot; style=&quot;min-height:180px;&quot;&gt;&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No upcoming LWD in the next 30 days&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;ul class=&quot;itd-mini-list&quot;&gt;\n&lt;%\n\t\t\tshownLwd = 0;\n\t\t\tfor each  resignItem in upcomingResignationRows\n\t\t\t{\n\t\t\t\tif(shownLwd &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tshownLwd = shownLwd + 1;\n\t\t\t\t\tlwdText = &quot;-&quot;;\n\t\t\t\t\tif(resignItem.Effective_LWD != null)\n\t\t\t\t\t{\n\t\t\t\t\t\tlwdText = resignItem.Effective_LWD.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\tempName = ifnull(resignItem.Employee.Full_Name,&quot;Employee&quot;);\n\t\t\t\t\tempDept = ifnull(resignItem.Employee.Department.Department_Name,&quot;-&quot;);\n\t\t\t\t\tassetRowsForExit = Employee_Asset_Recovery[Resignation_Request == resignItem.ID];\n\t\t\t\t\tpendingForExit = Employee_Asset_Recovery[Resignation_Request == resignItem.ID &amp;&amp; Recovery_Status == &quot;Pending&quot;].count();\n\t\t\t\t\ttotalForExit = assetRowsForExit.count();\n\t\t\t\t\tprogressPct = 0;\n\t\t\t\t\tif(totalForExit &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tprogressPct = ((totalForExit - pendingForExit) * 100) / totalForExit;\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n&lt;li&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=empName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&quot;&gt;&lt;%=empDept%&gt; \u00B7 Effective LWD &lt;%=lwdText%&gt; \u00B7 &lt;%=pendingForExit%&gt; pending assets&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard?Resignation_Request=&lt;%=resignItem.ID%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;Assets&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;itd-progress&quot; style=&quot;margin-top:10px;&quot;&gt;&lt;span style=&quot;width:&lt;%=progressPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;itd-card zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot; style=&quot;flex-wrap:wrap;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;itd-kpi-icon itd-ok zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Asset sync status summary&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary&quot;&gt;&lt;%=syncedCount%&gt; synced \u00B7 &lt;%=pendingSyncCount%&gt; pending sync \u00B7 &lt;%=recoveredAssetCount%&gt; recovered \u00B7 &lt;%=notFoundAssetCount%&gt; not found&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-list-bullet&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Offboarding checklist&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline tech-laptop&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;IT assets&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Manager_Dashboard
		{
					displayname = "Manager Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Manager_Dashboard_Snippet' elementName='Manager_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Manager_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;MANAGER&quot; || loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;CEO&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tmanagerRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\thasManagerRecord = managerRows.count() &gt; 0;\n\tmanagerName = ifnull(zoho.loginuser,&quot;Manager&quot;);\n\tmanagerEmail = loginEmail;\n\tmanagerDepartment = &quot;-&quot;;\n\tmanagerInitial = &quot;M&quot;;\n\tteamScope = &quot;Direct reports&quot;;\n\tif(hasManagerRecord == true)\n\t{\n\t\tmanagerEmp = managerRows;\n\t\tmanagerName = ifnull(managerEmp.Full_Name,managerName);\n\t\tmanagerEmail = ifnull(managerEmp.Official_Email,loginEmail);\n\t\tmanagerDepartment = ifnull(managerEmp.Department.Department_Name,&quot;-&quot;);\n\t\tif(managerName != null &amp;&amp; managerName != &quot;&quot;)\n\t\t{\n\t\t\tmanagerInitial = managerName.left(1).toUpperCase();\n\t\t}\n\t\tteamRows = Employee_Master[Primary_Manager == managerEmp.ID || Secondary_Manager == managerEmp.ID &amp;&amp; Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;] sort by Full_Name asc;\n\t\tif(loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;CEO&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot; &amp;&amp; teamRows.count() == 0)\n\t\t{\n\t\t\tteamRows = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;] sort by Full_Name asc;\n\t\t\tteamScope = &quot;Organisation view&quot;;\n\t\t}\n\t}\n\telse\n\t{\n\t\tteamRows = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;] sort by Full_Name asc;\n\t\tteamScope = &quot;Organisation view&quot;;\n\t}\n\tteamCount = teamRows.count();\n\tleavePendingCount = 0;\n\tregularisationPendingCount = 0;\n\ttravelPendingCount = 0;\n\treimbursementPendingCount = 0;\n\tgiftPendingCount = 0;\n\ttotalPendingApprovals = 0;\n\tpresentCount = 0;\n\twfhCount = 0;\n\tleaveTodayCount = 0;\n\tabsentCount = 0;\n\thalfDayCount = 0;\n\tnotMarkedCount = 0;\n\tnoLogCount = 0;\n\tactiveApprovedLeaveCount = 0;\n\tannouncementCount = 0;\n\tackDoneCount = 0;\n\tackPendingCount = 0;\n\tappraisalDraftCount = 0;\n\tappraisalSubmittedCount = 0;\n\tappraisalManagerReviewedCount = 0;\n\tappraisalHrApprovedCount = 0;\n\ttrainingRequestCount = 0;\n\thighUrgencyTrainingCount = 0;\n\tfor each  teamEmpSeed in teamRows\n\t{\n\t\tleavePendingCount = leavePendingCount + Time_Off_Request[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;].count();\n\t\tregularisationPendingCount = regularisationPendingCount + Regularisation_Request[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;].count();\n\t\ttravelPendingCount = travelPendingCount + Travel_Request[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_CEO&quot; || Status == &quot;Pending_HR&quot;].count();\n\t\treimbursementPendingCount = reimbursementPendingCount + Reimbursement_Request[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot; || Status == &quot;Pending_Finance&quot;].count();\n\t\tgiftPendingCount = giftPendingCount + Gift_Registration[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot; || Status == &quot;Pending_Finance&quot;].count();\n\t\tattendanceTodayRows = Attendance_Log[Employee == teamEmpSeed.ID &amp;&amp; Attendance_Date == todayDate];\n\t\tif(attendanceTodayRows.count() == 0)\n\t\t{\n\t\t\tnoLogCount = noLogCount + 1;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tattendanceToday = attendanceTodayRows;\n\t\t\ttodayStatus = ifnull(attendanceToday.Attendance_Status,&quot;Not_Marked&quot;);\n\t\t\tif(todayStatus == &quot;Present&quot;)\n\t\t\t{\n\t\t\t\tpresentCount = presentCount + 1;\n\t\t\t}\n\t\t\telse if(todayStatus == &quot;WFH&quot; || todayStatus == &quot;On_Duty&quot;)\n\t\t\t{\n\t\t\t\twfhCount = wfhCount + 1;\n\t\t\t}\n\t\t\telse if(todayStatus == &quot;Leave&quot;)\n\t\t\t{\n\t\t\t\tleaveTodayCount = leaveTodayCount + 1;\n\t\t\t}\n\t\t\telse if(todayStatus == &quot;Absent&quot;)\n\t\t\t{\n\t\t\t\tabsentCount = absentCount + 1;\n\t\t\t}\n\t\t\telse if(todayStatus == &quot;Half_Day&quot;)\n\t\t\t{\n\t\t\t\thalfDayCount = halfDayCount + 1;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tnotMarkedCount = notMarkedCount + 1;\n\t\t\t}\n\t\t}\n\t\tactiveApprovedLeaveCount = activeApprovedLeaveCount + Time_Off_Request[Employee == teamEmpSeed.ID &amp;&amp; Status == &quot;Approved&quot; &amp;&amp; To_Date &gt;= todayDate].count();\n\t\tappraisalRows = Appraisal_Form[Employee == teamEmpSeed.ID];\n\t\tfor each  appraisalSeed in appraisalRows\n\t\t{\n\t\t\tappraisalStatus = ifnull(appraisalSeed.Status,&quot;Draft&quot;);\n\t\t\tif(appraisalStatus == &quot;Draft&quot;)\n\t\t\t{\n\t\t\t\tappraisalDraftCount = appraisalDraftCount + 1;\n\t\t\t}\n\t\t\telse if(appraisalStatus == &quot;Submitted&quot;)\n\t\t\t{\n\t\t\t\tappraisalSubmittedCount = appraisalSubmittedCount + 1;\n\t\t\t}\n\t\t\telse if(appraisalStatus == &quot;Manager_Reviewed&quot;)\n\t\t\t{\n\t\t\t\tappraisalManagerReviewedCount = appraisalManagerReviewedCount + 1;\n\t\t\t}\n\t\t\telse if(appraisalStatus == &quot;HR_Approved&quot;)\n\t\t\t{\n\t\t\t\tappraisalHrApprovedCount = appraisalHrApprovedCount + 1;\n\t\t\t}\n\t\t}\n\t}\n\ttotalPendingApprovals = leavePendingCount + regularisationPendingCount + travelPendingCount + reimbursementPendingCount + giftPendingCount;\n\tif(loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;CEO&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;)\n\t{\n\t\ttrainingRows = Training_Request[ID != 0] sort by Urgency asc;\n\t}\n\telse\n\t{\n\t\ttrainingRows = Training_Request[Raised_By == loginEmail || Raised_By == zoho.loginuser] sort by Urgency asc;\n\t}\n\ttrainingRequestCount = trainingRows.count();\n\tfor each  trainingSeed in trainingRows\n\t{\n\t\tif(ifnull(trainingSeed.Urgency,&quot;&quot;) == &quot;High&quot;)\n\t\t{\n\t\t\thighUrgencyTrainingCount = highUrgencyTrainingCount + 1;\n\t\t}\n\t}\n\tannouncementRows = Announcement[Created_By == loginEmail || Created_By == zoho.loginuser] sort by Published_Date desc;\n\tannouncementCount = announcementRows.count();\n\tfor each  annSeed in announcementRows\n\t{\n\t\tannAckRows = Announcement_Acknowledgement[Announcement == annSeed.ID];\n\t\tfor each  annAckSeed in annAckRows\n\t\t{\n\t\t\tif(annAckSeed.Acknowledged == true)\n\t\t\t{\n\t\t\t\tackDoneCount = ackDoneCount + 1;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tackPendingCount = ackPendingCount + 1;\n\t\t\t}\n\t\t}\n\t}\n\tpresentPct = 0;\n\tif(teamCount &gt; 0)\n\t{\n\t\tpresentPct = ((presentCount + wfhCount + halfDayCount) * 100) / teamCount;\n\t\tif(presentPct &gt; 100)\n\t\t{\n\t\t\tpresentPct = 100;\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility subset included once for Manager_Dashboard */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-page-bg-color: #F3F3F4; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-sticky { position: sticky; }\n.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-6 { padding-left: .375rem; padding-right: .375rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-0 { padding-top: 0; padding-bottom: 0; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-cursor-pointer { cursor: pointer; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, #2A6FFC); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: table-simple-table */\n:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-count */\n.zcs-horizontal-tabhead { box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 1px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabcount { min-width: 20px; background-color: var(--zcs-page-bg-color); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs_brand_color, #2A6FFC); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount, .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tabcount { background-color: var(--zcs_component_hover_color, #E8EFFF); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs_brand_color, #2A6FFC); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs_brand_color, #2A6FFC); }\n/* Manager dashboard */\n.md-page { min-height: 100%; background: var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: inherit; }\n.md-header { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); }\n.md-header:after { content: &quot;&quot;; position: absolute; width: 330px; height: 330px; right: -92px; top: -150px; border-radius: 50%; border: 42px solid rgba(255,255,255,.13); }\n.md-header .zcs-color-primary, .md-header .zcs-color-secondary, .md-header .zcs-color-tertiary { color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.md-header-inner { position: relative; z-index: 1; }\n.md-avatar { width: 58px; height: 58px; border-radius: 16px; background: rgba(255,255,255,.18); color: var(--zcs_brand_foreground_color, #FFFFFF); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; }\n.md-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; padding: 18px 0 0; }\n.md-kpi { grid-column: span 3; min-height: 148px; position: relative; overflow: hidden; box-shadow: 0 8px 22px rgba(15,23,42,.06); }\n.md-kpi:after { content: &quot;&quot;; position: absolute; width: 90px; height: 90px; right: -28px; bottom: -32px; border-radius: 50%; background: var(--zcs_brand_light_color, #E8EFFF); opacity: .75; }\n.md-kpi-icon { width: 42px; height: 42px; border-radius: 12px; color: var(--zcs_brand_color, #2A6FFC); background: var(--zcs_brand_light_color, #E8EFFF); }\n.md-kpi-value { font-size: 31px; font-weight: 700; line-height: 1; }\n.md-section { grid-column: span 6; box-shadow: 0 8px 22px rgba(15,23,42,.06); overflow: hidden; }\n.md-section-wide { grid-column: span 12; }\n.md-section-header { border-bottom: 1px solid var(--zcs-border-color); }\n.md-progress { height: 8px; background: #EDF1F7; border-radius: 999px; overflow: hidden; }\n.md-progress span { height: 100%; display: block; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }\n.md-empty { border: 1px dashed var(--zcs-border-color); background: #FFFFFF; border-radius: 12px; padding: 20px; text-align: center; }\n.md-denied { max-width: 760px; margin: 0 auto; padding: 36px 20px; }\n.md-report-band { margin-top: 18px; }\n@media (max-width: 1200px) { .md-kpi { grid-column: span 6; } .md-section { grid-column: span 12; } }\n@media (max-width: 700px) { .md-header { border-radius: 0 0 16px 16px; } .md-header-inner { flex-direction: column; align-items: flex-start; } .md-kpi { grid-column: span 12; } .md-page { padding-left: 12px; padding-right: 12px; } }\n&lt;/style&gt;\n&lt;%\n\tif(isAllowed == false)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;md-page md-denied&quot;&gt;\n\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12&apos;&gt;\n\t\t\t&lt;i class=&apos;zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Manager dashboard access is restricted.&lt;/h5&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-m-0&apos;&gt;This page is intended for MANAGER, HR_ADMIN, CEO, and Administrator profiles.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;md-page zcs-px-20 zcs-py-16 zcs-box-border&quot;&gt;\n\t&lt;div class=&quot;md-header zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;md-header-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-16 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;div class=&quot;md-avatar zcs-no-shrink&quot;&gt;&lt;%=managerInitial%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Manager Dashboard&lt;/h4&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary zcs-ellipsis&quot;&gt;Hello &lt;%=managerName%&gt; | &lt;%=managerDepartment%&gt; | &lt;%=todayDisplay%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=teamScope%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:Team_Attendance?zc_LoadIn=dialog&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Team Attendance&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full zcs-card md-report-band&apos;&gt;\n\t\t&lt;ul class=&apos;zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&apos;&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem zcs-horizontal-tabactive&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#Report:Pending_Time_Off_Requests_Manager?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Leave&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=leavePendingCount%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#Report:Pending_Regularisation_Manager?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Regularisation&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=regularisationPendingCount%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#Report:HR_All_Travel?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Travel&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=travelPendingCount%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#Report:HR_Reimbursement_Queue?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Reimbursement&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=reimbursementPendingCount%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#Report:HR_Gift_Registry?zc_LoadIn=dialog&apos;&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Gifts&lt;/span&gt;&lt;span class=&apos;zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center&apos;&gt;&lt;%=giftPendingCount%&gt;&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;md-grid&quot;&gt;\n\t\t&lt;div class=&quot;md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-12&apos;&gt;Open&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;md-kpi-value zcs-color-primary&quot;&gt;&lt;%=totalPendingApprovals%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Team approval items across leave, regularisation, travel, reimbursements, and gifts&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-wm zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;&lt;%=teamScope%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;md-kpi-value zcs-color-primary&quot;&gt;&lt;%=teamCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Employees in current dashboard scope&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Today&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;md-kpi-value zcs-color-primary&quot;&gt;&lt;%=presentCount + wfhCount + halfDayCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Present, WFH, on duty, or half-day today&lt;/div&gt;\n\t\t\t&lt;div class=&apos;md-progress&apos;&gt;&lt;span style=&apos;width:&lt;%=presentPct%&gt;%&apos;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline education-hat zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Training&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;md-kpi-value zcs-color-primary&quot;&gt;&lt;%=trainingRequestCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=highUrgencyTrainingCount%&gt; high urgency training requests&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;md-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Attendance today&lt;/h5&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Team_Attendance?zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green&apos;&gt;Present&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=presentCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue&apos;&gt;WFH or On Duty&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=wfhCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow&apos;&gt;Leave or Half Day&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=leaveTodayCount + halfDayCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red&apos;&gt;Absent, Not Marked, or No Log&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=absentCount + notMarkedCount + noLogCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;md-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Approved team leave&lt;/h5&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_All_Time_Off_Requests?Status=Approved&amp;amp;zc_LoadIn=dialog&quot;&gt;Open report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(activeApprovedLeaveCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;md-empty&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No active or upcoming approved leave in this team scope.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownLeave = 0;\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Employee&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Leave type&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Dates&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  leaveTeamEmp in teamRows\n\t\t\t{\n\t\t\t\tif(shownLeave &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tteamLeaveRows = Time_Off_Request[Employee == leaveTeamEmp.ID &amp;&amp; Status == &quot;Approved&quot; &amp;&amp; To_Date &gt;= todayDate] sort by From_Date asc;\n\t\t\t\t\tfor each  leaveItem in teamLeaveRows\n\t\t\t\t\t{\n\t\t\t\t\t\tif(shownLeave &lt; 6)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfromText = &quot;-&quot;;\n\t\t\t\t\t\t\ttoText = &quot;-&quot;;\n\t\t\t\t\t\t\tif(leaveItem.From_Date != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tfromText = leaveItem.From_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(leaveItem.To_Date != null)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\ttoText = leaveItem.To_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tshownLeave = shownLeave + 1;\n\t\t\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(leaveTeamEmp.Full_Name,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14&apos;&gt;&lt;%=ifnull(leaveItem.Leave_Type.Leave_Type_Name,&quot;Leave&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14&apos;&gt;&lt;%=fromText%&gt; to &lt;%=toText%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;md-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Announcement acknowledgement&lt;/h5&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Announcement_Acknowledgement_Status?zc_LoadIn=dialog&quot;&gt;Open status&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-12 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13&apos;&gt;&lt;%=announcementCount%&gt; published&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13&apos;&gt;&lt;%=ackDoneCount%&gt; acknowledged&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13&apos;&gt;&lt;%=ackPendingCount%&gt; pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(announcementCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;md-empty&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No announcements created by you yet.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownAnn = 0;\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Announcement&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Pending&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Done&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  annItem in announcementRows\n\t\t\t{\n\t\t\t\tif(shownAnn &lt; 5)\n\t\t\t\t{\n\t\t\t\t\tpendingForAnn = Announcement_Acknowledgement[Announcement == annItem.ID &amp;&amp; Acknowledged == false].count();\n\t\t\t\t\tdoneForAnn = Announcement_Acknowledgement[Announcement == annItem.ID &amp;&amp; Acknowledged == true].count();\n\t\t\t\t\tshownAnn = shownAnn + 1;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(annItem.Title,&quot;Announcement&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-yellow&apos;&gt;&lt;%=pendingForAnn%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-green&apos;&gt;&lt;%=doneForAnn%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;md-section zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Team appraisal status&lt;/h5&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Manager_Appraisal_Queue?zc_LoadIn=dialog&quot;&gt;Open queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Stage&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Count&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14&apos;&gt;Draft&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=appraisalDraftCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-yellow&apos;&gt;Submitted&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=appraisalSubmittedCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-l_blue&apos;&gt;Manager reviewed&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=appraisalManagerReviewedCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-green&apos;&gt;HR approved&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&apos;&gt;&lt;%=appraisalHrApprovedCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;md-section md-section-wide zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Training requests&lt;/h5&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Form:Training_Request?zc_LoadIn=dialog&quot;&gt;Raise request&lt;/a&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Training_Request_List?zc_LoadIn=dialog&quot;&gt;Open list&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-p-16 zcs-box-border&quot;&gt;\n&lt;%\n\t\tif(trainingRequestCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;md-empty&quot;&gt;&lt;i class=&quot;zc-li-outline education-hat zcs-font-24 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;No training requests in the current view.&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownTraining = 0;\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-table-wrapper zcs-rounded-sm zcs-box-border&apos;&gt;&lt;table class=&apos;zcs-w-full&apos;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Topic&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Raised by&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Urgency&lt;/th&gt;&lt;th class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&apos;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  trainingItem in trainingRows\n\t\t\t{\n\t\t\t\tif(shownTraining &lt; 8)\n\t\t\t\t{\n\t\t\t\t\turgencyClass = &quot;zcs-l_blue&quot;;\n\t\t\t\t\tif(trainingItem.Urgency == &quot;High&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\turgencyClass = &quot;zcs-red&quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(trainingItem.Urgency == &quot;Medium&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\turgencyClass = &quot;zcs-yellow&quot;;\n\t\t\t\t\t}\n\t\t\t\t\tshownTraining = shownTraining + 1;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary&apos;&gt;&lt;%=ifnull(trainingItem.Training_Topic,&quot;Training&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14&apos;&gt;&lt;%=ifnull(trainingItem.Raised_By,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 &lt;%=urgencyClass%&gt;&apos;&gt;&lt;%=ifnull(trainingItem.Urgency,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;td class=&apos;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14&apos;&gt;&lt;%=ifnull(trainingItem.Status,&quot;-&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Team_Attendance_Report' title='Team Attendance Report' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Team_Attendance' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Approved_Team_Leave_Report' title='Approved Leave List' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_All_Time_Off_Requests' criteriaString='Status == &quot;Approved&quot;' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Announcement_Acknowledgement_Status_Report' title='Announcement Acknowledgement Status' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Announcement_Acknowledgement_Status' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Manager_Appraisal_Queue_Report' title='Manager Appraisal Queue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Manager_Appraisal_Queue' iszreport='false' zc_AddRec='false' zc_EditRec='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Training_Request_List_Report' title='Training Request List' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Training_Request_List' iszreport='false' zc_Print='false' zc_Export='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Offboarding_Home
		{
					displayname = "Offboarding Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Offboarding_Home_Snippet' elementName='Offboarding_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Offboarding_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = ifnull(zoho.loginuserid,zoho.loginuser);\n\temployeeRows = Employee_Master[Official_Email == loginEmail];\n\temployeeName = &quot;Employee&quot;;\n\temployeeInitial = &quot;E&quot;;\n\temployeeMeta = loginEmail;\n\tmyResignationCount = 0;\n\tif(employeeRows.count() &gt; 0)\n\t{\n\t\temp = employeeRows;\n\t\temployeeName = ifnull(emp.Full_Name,&quot;Employee&quot;);\n\t\tif(employeeName != &quot;&quot;)\n\t\t{\n\t\t\temployeeInitial = employeeName.left(1);\n\t\t}\n\t\temployeeMeta = ifnull(emp.Designation,&quot;Employee&quot;);\n\t\tmyResignationCount = Resignation_Request[Employee == emp.ID].count();\n\t}\n\ttotalResignations = Resignation_Request.count();\n\tpendingManager = Resignation_Request[Status == &quot;Pending_Manager&quot;].count();\n\tpendingHR = Resignation_Request[Status == &quot;Pending_HR&quot;].count();\n\tapprovedResignations = Resignation_Request[Status == &quot;Approved&quot;].count();\n\trejectedResignations = Resignation_Request[Status == &quot;Rejected&quot;].count();\n\texitInterviewCount = Exit_Interview.count();\n\tconfidentialExitCount = Exit_Interview[Is_Confidential == true].count();\n\tchecklistPending = Offboarding_Checklist[Status == &quot;Pending&quot;].count();\n\tchecklistCompleted = Offboarding_Checklist[Status == &quot;Completed&quot;].count();\n\tchecklistWaived = Offboarding_Checklist[Status == &quot;Waived&quot;].count();\n\tassetPending = Employee_Asset_Recovery[Recovery_Status == &quot;Pending&quot;].count();\n\tassetRecovered = Employee_Asset_Recovery[Recovery_Status == &quot;Recovered&quot;].count();\n\tassetNotFound = Employee_Asset_Recovery[Recovery_Status == &quot;Not_Found&quot;].count();\n\tsyncFailed = Employee_Asset_Recovery[External_Sync_Status == &quot;Sync_Failed&quot;].count();\n\tsyncPending = Employee_Asset_Recovery[External_Sync_Status == &quot;Pending_Sync&quot;].count();\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global utility stylesheet included once for Offboarding_Home ===== */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color,#2A6FFC);--zcs-light-bg-color:var(--zcs_brand_light_color,#E8EFFF);--zcs-page-bg-color:#F5F7FB;--zcs-white-color:#FFFFFF;--zcs-primary-text-color:var(--zcs_primary_text_color,#1A1A1A);--zcs-secondary-text-color:var(--zcs_secondary_text_color,#55576B);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color,#77798C);--zcs-border-color:var(--zcs_tertiary_border_color,#E6E8F0);--zcs-brand-foreground:var(--zcs_brand_foreground_color,#FFFFFF)}\na{text-decoration:none}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-18{gap:1.125rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-2{padding:.125rem}.zcs-p-8{padding:.5rem}.zcs-p-10{padding:.625rem}.zcs-p-12{padding:.75rem}.zcs-p-14{padding:.875rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-24{padding-left:1.5rem;padding-right:1.5rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0%;min-width:0}.zcs-no-shrink{flex-shrink:0}.zcs-box-border{box-sizing:border-box}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-left{text-align:left}.zcs-text-center{text-align:center}.zcs-text-right{text-align:right}.zcs-overflow-auto{overflow:auto}.zcs-relative{position:relative}.zcs-sticky{position:sticky}.zcs-cursor-pointer{cursor:pointer}.zcs-font-11{font-size:.6875rem}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-30{font-size:1.875rem}.zcs-font-36{font-size:2.25rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-green{color:#179E6C}.zcs-color-red{color:#FE455D}.zcs-color-yellow{color:#B8770D}.zcs-color-blue{color:#2A6FFC}.zcs-card{background-color:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px;box-shadow:0 8px 24px rgba(18,19,43,.04)}\n/* ZCS component CSS: header-heading-with-actions and button-primary-button */\n.zcs-page-header{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:16px;box-shadow:0 8px 24px rgba(18,19,43,.04)}.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs-theme-brand-color);color:var(--zcs-brand-foreground)}.zcs-primary-outline-button{border:1px solid var(--zcs-theme-brand-color);background-color:var(--zcs-white-color);color:var(--zcs-theme-brand-color)}.zcs-secondary-button{border:1px solid var(--zcs-border-color);background-color:#F6F7FA;color:var(--zcs-primary-text-color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color,#1652BB)}.zcs-primary-outline-button:hover,.zcs-secondary-button:hover{background-color:var(--zcs_component_hover_color,#F2F7FF)}.zcs-button-icon{width:16px;max-height:16px}\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tabicon{width:16px;height:16px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs-theme-brand-color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive{border-bottom-color:var(--zcs-theme-brand-color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs-theme-brand-color)}\n/* ZCS component CSS: badge-badge-with-icon */\n.zcs-badge{width:auto}.zcs-badge-filled,.zcs-badge-filled-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color,#F2F7FF);border-color:var(--zcs-theme-brand-color);color:var(--zcs-theme-brand-color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-red{background-color:#FDE3E6;border-color:#FE455D;color:#FE455D}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#B8770D}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#E8E8E8;border-color:#242424;color:#242424}\n/* ZCS component CSS: quick-actions-card-type-quick-actions */\n.zcs-quick-action-item{list-style-type:none}.zcs-quick-action-item.zcs-card:hover{border-color:var(--zcs-theme-brand-color)}.zcs-quick-action-item:hover .zcs-quick-action-link{color:var(--zcs-theme-brand-color)}.zcs-quick-action-item:hover .zcs-quick-action-text{text-decoration:underline}.zcs-quick-action-item.zcs-card:hover .zcs-quick-action-text{text-decoration:none}\n/* ZCS component CSS: table-simple-table */\n:root{--zcs-thead-color:#F9FAFE;--zcs-tr-h-color:#F9FAFE}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);background-color:var(--zcs-white-color);overflow:auto}.zcs-table-wrapper table{line-height:normal;border-collapse:collapse}.zcs-table-wrapper table thead{top:0}.zcs-table-wrapper table thead tr th{background-color:var(--zcs-thead-color);box-shadow:0 -1px 0 0 var(--zcs-border-color) inset;white-space:nowrap}.zcs-table-wrapper table thead tr.zcs-tspace th{background-color:var(--zcs-white-color);box-shadow:none}.zcs-table-wrapper table tbody tr td{border-top:1px solid var(--zcs-border-color)}.zcs-table-wrapper table tbody tr:first-child td{border-color:transparent}.zcs-table-wrapper table tbody tr:hover td{background-color:var(--zcs-tr-h-color)}.zcs-table-wrapper table tbody tr:first-child:hover td{border-color:var(--zcs-border-color)}.zcs-table-wrapper table tbody tr td.zcs-green{color:#179E6C}.zcs-table-wrapper table tbody tr td.zcs-yellow{color:#B8770D}.zcs-table-wrapper table tbody tr td.zcs-blue{color:#09598E}.zcs-table-wrapper table tbody tr td.zcs-red{color:#FE455D}\n/* Offboarding Home layout */\n.obh-page{min-height:100%;background:var(--zcs-page-bg-color);padding:22px;box-sizing:border-box;font-family:Lato,Arial,sans-serif;color:var(--zcs-primary-text-color)}.obh-hero{position:relative;overflow:hidden;color:#fff;border-radius:18px;padding:24px;background:linear-gradient(135deg,var(--zcs-theme-brand-color),#334155)}.obh-hero:after{content:&quot;&quot;;position:absolute;right:-90px;top:-100px;width:300px;height:300px;border-radius:50%;border:42px solid rgba(255,255,255,.13)}.obh-hero:before{content:&quot;&quot;;position:absolute;right:210px;bottom:-90px;width:180px;height:180px;border-radius:50%;border:26px solid rgba(255,255,255,.10)}.obh-hero-content{position:relative;z-index:1}.obh-hero .zcs-primary-outline-button{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.72);color:#fff}.obh-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px}.obh-kpi{grid-column:span 3;min-height:118px}.obh-kpi-icon{width:42px;height:42px;border-radius:12px;background:var(--zcs-light-bg-color);color:var(--zcs-theme-brand-color)}.obh-kpi-value{font-size:30px;font-weight:700;line-height:1.1}.obh-workspace{grid-column:span 9;overflow:hidden}.obh-actions{grid-column:span 3}.obh-tab-input{display:none}.obh-tabbar{overflow-x:auto}.obh-tabbar label{cursor:pointer;border-bottom:2px solid transparent}.obh-panel{display:none;padding:18px}.obh-panels{background:#fff}.obh-tab-input#obh-tab-overview:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-overview&apos;],.obh-tab-input#obh-tab-my:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-my&apos;],.obh-tab-input#obh-tab-hr:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-hr&apos;],.obh-tab-input#obh-tab-exit:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-exit&apos;],.obh-tab-input#obh-tab-checklist:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-checklist&apos;],.obh-tab-input#obh-tab-assets:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-assets&apos;],.obh-tab-input#obh-tab-kanban:checked~.zcs-horizontal-tabpanel label[for=&apos;obh-tab-kanban&apos;]{color:var(--zcs-theme-brand-color);border-bottom-color:var(--zcs-theme-brand-color)}.obh-tab-input#obh-tab-overview:checked~.obh-panels .obh-panel-overview,.obh-tab-input#obh-tab-my:checked~.obh-panels .obh-panel-my,.obh-tab-input#obh-tab-hr:checked~.obh-panels .obh-panel-hr,.obh-tab-input#obh-tab-exit:checked~.obh-panels .obh-panel-exit,.obh-tab-input#obh-tab-checklist:checked~.obh-panels .obh-panel-checklist,.obh-tab-input#obh-tab-assets:checked~.obh-panels .obh-panel-assets,.obh-tab-input#obh-tab-kanban:checked~.obh-panels .obh-panel-kanban{display:block}.obh-embed-card{border:1px solid var(--zcs-border-color);border-radius:14px;overflow:hidden;background:#fff;margin-bottom:18px}.obh-embed-header{border-bottom:1px solid var(--zcs-border-color);background:#FAFBFF}.obh-report-frame{min-height:620px;width:100%}.obh-report-frame.tall{min-height:700px}.obh-mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.obh-flow-card{border:1px solid var(--zcs-border-color);border-radius:14px;background:#fff;padding:18px}.obh-status-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.obh-status-item{background:#fff;border:1px solid var(--zcs-border-color);border-radius:12px;padding:14px}.obh-note{border:1px dashed var(--zcs-border-color);background:#FAFBFF;border-radius:12px}.obh-directory-link{color:var(--zcs-theme-brand-color);font-weight:500}.obh-directory-link:hover{text-decoration:underline}.obh-avatar{width:54px;height:54px;border-radius:16px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);color:#fff}.obh-kanban-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.obh-kanban-grid .obh-embed-card{margin-bottom:0}@media(max-width:1180px){.obh-kpi{grid-column:span 6}.obh-workspace,.obh-actions{grid-column:span 12}.obh-kanban-grid{grid-template-columns:1fr}}@media(max-width:760px){.obh-page{padding:14px}.obh-hero{padding:18px}.obh-hero-content,.zcs-page-header{flex-direction:column;align-items:flex-start}.zcs-page-header{padding:16px}.obh-kpi{grid-column:span 12}.obh-panel{padding:12px}.obh-mini-grid,.obh-status-strip{grid-template-columns:1fr}.obh-report-frame{min-height:520px}}\n&lt;/style&gt;\n\n&lt;div class=&quot;obh-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Offboarding Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Workspace for resignations, exit interviews, checklist ownership, asset recovery, sync failures, and status boards.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Resignation_Request?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Submit Resignation&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Offboarding_Dashboard&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;HR Dashboard&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;obh-hero&quot;&gt;\n\t\t&lt;div class=&quot;obh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;obh-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-font-24 zcs-font-bold zcs-no-shrink&quot;&gt;&lt;%=employeeInitial%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold&quot;&gt;IITB HR Offboarding&lt;/span&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Coordinate a clean exit from resignation through checklist and asset closure&lt;/h3&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-15&quot;&gt;Signed in as &lt;%=employeeName%&gt; - &lt;%=employeeMeta%&gt;. Use the tabs below to work across every offboarding queue and board.&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-no-shrink&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Asset Recovery&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;obh-grid&quot;&gt;\n\t\t&lt;article class=&quot;obh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;obh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-4-restore zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Pending approvals&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;obh-kpi-value zcs-color-primary&quot;&gt;&lt;%=pendingManager + pendingHR%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=pendingManager%&gt; manager and &lt;%=pendingHR%&gt; HR resignation requests&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;obh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;obh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-05 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Approved exits&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;obh-kpi-value zcs-color-primary&quot;&gt;&lt;%=approvedResignations%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=exitInterviewCount%&gt; exit interview rows, &lt;%=confidentialExitCount%&gt; confidential&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;obh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;obh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-todo zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Checklist pending&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;obh-kpi-value zcs-color-primary&quot;&gt;&lt;%=checklistPending%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=checklistCompleted%&gt; completed and &lt;%=checklistWaived%&gt; waived tasks&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;obh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;obh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Asset exceptions&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;obh-kpi-value zcs-color-primary&quot;&gt;&lt;%=assetPending + syncFailed%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=assetPending%&gt; pending recovery and &lt;%=syncFailed%&gt; failed sync rows&lt;/span&gt;\n\t\t&lt;/article&gt;\n\n\t\t&lt;section class=&quot;obh-workspace zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;obh-tabs-shell&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-overview&quot; checked&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-my&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-hr&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-exit&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-checklist&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-assets&quot;&gt;\n\t\t\t\t&lt;input class=&quot;obh-tab-input&quot; type=&quot;radio&quot; name=&quot;obh-tabs&quot; id=&quot;obh-tab-kanban&quot;&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-horizontal-tabhead obh-tabbar zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-overview&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-dashboard-level&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Overview&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-my&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;My Requests&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-hr&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;HR Dashboard&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-exit&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Exit Interviews&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-checklist&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-todo&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Checklist&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-assets&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Assets&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;obh-tab-kanban&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Kanbans&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;obh-panels&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-overview&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-status-strip zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Total resignations&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-primary&quot;&gt;&lt;%=totalResignations%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Approved&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-green&quot;&gt;&lt;%=approvedResignations%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Rejected&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-red&quot;&gt;&lt;%=rejectedResignations%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;My resignation rows&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-blue&quot;&gt;&lt;%=myResignationCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-mini-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-flow-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-4-restore zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Resignation flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Employees submit requests, managers and HR approve through Approval_Remarks, and the approved row drives exit interviews, checklist creation, and deactivation checks.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Form:Resignation_Request?zc_LoadIn=dialog&quot;&gt;Submit Resignation&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:My_Resignation_Requests&quot;&gt;My Requests&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-flow-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-edit-72 zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Exit interview flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;HR records confidential feedback against approved resignation requests and reviews categories using list and Kanban views.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Form:Exit_Interview?zc_LoadIn=dialog&quot;&gt;Add Interview&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Exit_Interview_List&quot;&gt;Interview List&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-flow-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline design-todo zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Checklist flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Responsible departments update Pending, Completed, and Waived tasks. HR uses completion status to decide deactivation readiness.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Offboarding_Checklist_View&quot;&gt;Checklist View&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Offboarding_Checklist_Kanban&quot;&gt;Checklist Kanban&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-flow-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Asset recovery flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;IT manually adds recovery rows, marks recovered or not found, and monitors safe external sync status until the real integration is enabled.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Form:Employee_Asset_Recovery?zc_LoadIn=dialog&quot;&gt;Add Asset Row&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Asset_Sync_Failed&quot;&gt;Sync Failures&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-my&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;My Resignation Requests&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employee-facing resignation history and current approval status.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_Resignation_Requests&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-hr&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR Offboarding Dashboard&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;HR queue for resignation approvals, effective last working day, and offboarding readiness.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;HR_Offboarding_Dashboard&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-exit&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Exit Interview List&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Confidential interview feedback by resignation request, category, rejoin response, and HR owner.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Exit_Interview_List&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-checklist&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Offboarding Checklist View&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Department task ownership, responsible person, status, completion date, and notes.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Offboarding_Checklist_View&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-assets&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;IT Asset Recovery Dashboard&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;IT work queue for asset details, recovery status, condition, recovery date, and sync state.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;IT_Asset_Recovery_Dashboard&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Asset Sync Failed&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Exception queue for rows where the future external asset sync is marked failed.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Asset_Sync_Failed&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;obh-panel obh-panel-kanban&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;obh-kanban-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Resignation Status Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pipeline grouped by resignation status.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;obh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Resignation_Status_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;obh-embed-card&quot;&gt;&lt;div class=&quot;obh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Exit Interview Category Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Interview feedback grouped by exit reason category.&lt;/span&gt;&lt;/div&gt