&gt;&lt;div class=&quot;rh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Interview_Feedback_List&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-children&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Interview Round Config Rows&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Child rows linked to approved job requests.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Interview_Round_Config_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Application Offer Document Rows&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Child rows linked to job applications and offer acceptance document collection.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Application_Offer_Document_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-kanban&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-mini-grid zcs-mb-8&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Candidate Detail launcher&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Enter a Candidate record ID to open Candidate_Detail with its required candidate_id parameter.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;input class=&quot;rh-tool-input&quot; type=&quot;number&quot; id=&quot;rh-candidate-id&quot; placeholder=&quot;Candidate ID&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Page:Candidate_Detail&quot; onclick=&quot;return rhOpenParamPage(&apos;Candidate_Detail&apos;,&apos;candidate_id&apos;,&apos;rh-candidate-id&apos;);&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Candidate Detail&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Convert to Employee launcher&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Enter a Job_Application record ID to open Convert_To_Employee with its required job_application_id parameter.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;input class=&quot;rh-tool-input&quot; type=&quot;number&quot; id=&quot;rh-application-id&quot; placeholder=&quot;Job Application ID&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Page:Convert_To_Employee&quot; onclick=&quot;return rhOpenParamPage(&apos;Convert_To_Employee&apos;,&apos;job_application_id&apos;,&apos;rh-application-id&apos;);&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Conversion Page&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Job Request Kanban&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Job_Request_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Candidate Source Kanban&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Candidate_Source_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Job Application Kanban&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Job_Application_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Interview Recommendation Kanban&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Interview_Recommendation_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;rh-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Job_Request?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Raise job request&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Candidate?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-add-29&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add candidate&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Job_Application?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Create application&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Interview_Feedback?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add feedback&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Job_Request_Kanban&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open request Kanban&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&quot;rh-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold zcs-color-primary&quot;&gt;Conversion flow&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Use Active_Job_Applications actions for the primary conversion path. The Kanban and Tools tab also provides direct parameter launchers for Candidate_Detail and Convert_To_Employee.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(!isHR)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;rh-access-note zcs-p-14 zcs-font-13&quot;&gt;Some HR-only records and conversion actions may be restricted by profile permissions.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/aside&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Reimbursement_Home
		{
					displayname = "Reimbursement Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Reimbursement_Home_Snippet' elementName='Reimbursement_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Reimbursement_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;HR&quot; || isAdmin;\n\tisFinance = loginRole == &quot;FINANCE_ADMIN&quot; || loginRole == &quot;Finance&quot; || isAdmin;\n\tmyReimbursementCount = Reimbursement_Request[Employee.Official_Email == zoho.loginuser || Employee.Official_Email == zoho.loginuserid].count();\n\ttotalReimbursements = Reimbursement_Request.count();\n\tdraftCount = Reimbursement_Request[Status == &quot;Draft&quot;].count();\n\tpendingHRCount = Reimbursement_Request[Status == &quot;Pending_HR&quot;].count();\n\tpendingFinanceCount = Reimbursement_Request[Status == &quot;Pending_Finance&quot;].count();\n\tprocessedCount = Reimbursement_Request[Status == &quot;Processed&quot;].count();\n\thealthInsuranceCount = Reimbursement_Request[Category == &quot;Health_Insurance&quot;].count();\n\tlineItemCount = Reimbursement_Line_Items.count();\n\ttotalClaimed = 0;\n\ttotalProcessed = 0;\n\tfor each  reimbursementRec in Reimbursement_Request[ID != 0]\n\t{\n\t\ttotalClaimed = totalClaimed + ifnull(reimbursementRec.Amount_Claimed,0);\n\t\tif(reimbursementRec.Status == &quot;Processed&quot;)\n\t\t{\n\t\t\ttotalProcessed = totalProcessed + ifnull(reimbursementRec.Amount_Claimed,0);\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global utility stylesheet included once for Reimbursement_Home ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-14 { gap: .875rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mb-12 { margin-bottom: .75rem; } .zcs-mb-16 { margin-bottom: 1rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-36 { font-size: 2.25rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions and button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: quick-actions-card-type-quick-actions and badge-filled-badge */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* Reimbursement Home layout */\n.rh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.rh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #0F766E); }\n.rh-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.rh-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.rh-hero-content { position: relative; z-index: 1; }\n.rh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.rh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.rh-kpi { grid-column: span 3; min-height: 118px; }\n.rh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.rh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.rh-workspace { grid-column: span 9; overflow: hidden; }\n.rh-actions { grid-column: span 3; }\n.rh-tab-input { display: none; }\n.rh-tabbar { overflow-x: auto; }\n.rh-tabbar label { cursor: pointer; border-bottom: 2px solid transparent; }\n.rh-panel { display: none; padding: 18px; }\n#rh-tab-overview:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-overview&apos;], #rh-tab-new:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-new&apos;], #rh-tab-my:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-my&apos;], #rh-tab-lines:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-lines&apos;], #rh-tab-hr:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-hr&apos;], #rh-tab-finance:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-finance&apos;], #rh-tab-kanban:checked ~ .zcs-horizontal-tabpanel label[for=&apos;rh-tab-kanban&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#rh-tab-overview:checked ~ .rh-panels .rh-panel-overview, #rh-tab-new:checked ~ .rh-panels .rh-panel-new, #rh-tab-my:checked ~ .rh-panels .rh-panel-my, #rh-tab-lines:checked ~ .rh-panels .rh-panel-lines, #rh-tab-hr:checked ~ .rh-panels .rh-panel-hr, #rh-tab-finance:checked ~ .rh-panels .rh-panel-finance, #rh-tab-kanban:checked ~ .rh-panels .rh-panel-kanban { display: block; }\n.rh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); margin-bottom: 18px; }\n.rh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.rh-report-frame { min-height: 640px; width: 100%; }\n.rh-report-frame.tall { min-height: 720px; }\n.rh-form-frame { min-height: 760px; width: 100%; }\n.rh-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }\n.rh-tool-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FFFFFF; padding: 18px; }\n.rh-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n.rh-access-note { border: 1px solid #FAAE13; background: #FCF4E6; color: #7E5608; border-radius: 12px; }\n.rh-status-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.rh-status-item { background: #FFFFFF; border: 1px solid var(--zcs-border-color); border-radius: 12px; padding: 14px; }\n@media (max-width: 1180px) { .rh-kpi { grid-column: span 6; } .rh-workspace, .rh-actions { grid-column: span 12; } }\n@media (max-width: 760px) { .rh-page { padding: 14px; } .rh-hero { padding: 18px; } .rh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .rh-kpi { grid-column: span 12; } .rh-panel { padding: 12px; } .rh-mini-grid, .rh-status-strip { grid-template-columns: 1fr; } .rh-report-frame { min-height: 540px; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;rh-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Reimbursement Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Workspace for employee reimbursement submission, line item bills, HR review, finance processing, and status tracking&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Reimbursement_Request?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Create Reimbursement&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_Reimbursements&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;My Reimbursements&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;rh-hero&quot;&gt;\n\t\t&lt;div class=&quot;rh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold&quot;&gt;IITB HR Reimbursements&lt;/span&gt;\n\t\t\t\t&lt;h3 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Submit expenses, attach bills, route HR checks, and complete finance processing&lt;/h3&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-15&quot;&gt;Use the tabs below to start the Reimbursement_Request create flow, review request queues, inspect reimbursement line items, and monitor the Kanban board.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-no-shrink&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Finance Queue&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;rh-grid&quot;&gt;\n\t\t&lt;article class=&quot;rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;My Claims&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;rh-kpi-value zcs-color-primary&quot;&gt;&lt;%=myReimbursementCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Logged-in employee reimbursements&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Review Queue&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;rh-kpi-value zcs-color-primary&quot;&gt;&lt;%=pendingHRCount + pendingFinanceCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=pendingHRCount%&gt; HR, &lt;%=pendingFinanceCount%&gt; finance&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Line Items&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;rh-kpi-value zcs-color-primary&quot;&gt;&lt;%=lineItemCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Expense bill rows linked to requests&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Processed&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;rh-kpi-value zcs-color-primary&quot;&gt;&lt;%=processedCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;INR &lt;%=totalProcessed%&gt; processed from INR &lt;%=totalClaimed%&gt; claimed&lt;/span&gt;\n\t\t&lt;/article&gt;\n\n\t\t&lt;section class=&quot;rh-workspace zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;rh-tabs-shell&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-overview&quot; checked&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-new&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-my&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-lines&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-hr&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-finance&quot;&gt;\n\t\t\t\t&lt;input class=&quot;rh-tab-input&quot; type=&quot;radio&quot; name=&quot;rh-tabs&quot; id=&quot;rh-tab-kanban&quot;&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-horizontal-tabhead rh-tabbar zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-overview&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-dashboard-level&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Overview&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-new&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;New Request&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-my&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;My Reimbursements&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-lines&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Line Items&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-hr&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline users-single-05&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;HR Queue&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-finance&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-bank&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Finance Queue&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;rh-tab-kanban&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Kanban&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;rh-panels&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-overview&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-status-strip zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;All reimbursements&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-primary&quot;&gt;&lt;%=totalReimbursements%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Draft requests&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-orange&quot;&gt;&lt;%=draftCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Health insurance cases&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-blue&quot;&gt;&lt;%=healthInsuranceCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Total claimed&lt;/span&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold zcs-color-primary&quot;&gt;INR &lt;%=totalClaimed%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-mini-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Employee create flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Employees create a Reimbursement_Request, provide reimbursement type, amount, expense date, description, and supporting bills. Line item rows can be reviewed from the Line Items tab.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Form:Reimbursement_Request?zc_LoadIn=dialog&quot;&gt;Create Request&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:My_Reimbursements&quot;&gt;My Reimbursements&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-05 zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR review flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;HR works Pending_HR records and health insurance reimbursements, validates within-limit status and insurance subtype, and sends approved claims onward for finance processing.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:HR_Reimbursement_Queue&quot;&gt;Open HR Queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline business-bank zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Finance processing flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Finance reviews Pending_Finance and Processed reimbursements, records the processed date, and uses the report filters to separate active processing from completed payouts.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;Open Finance Queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;rh-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline design-app zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Status monitoring&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Reimbursement_Status_Kanban shows the pipeline across draft, HR, manager, finance, processed, and rejected states for quick triage.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Reimbursement_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Kanban&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-new&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Reimbursement Request Create Flow&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Inline Reimbursement_Request form for employees. Use the dialog button when a larger popup workflow is preferred.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-form-frame&quot; zc-component=&quot;form&quot; zc-linkname=&quot;Reimbursement_Request&quot; zc-height=&quot;760px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-my&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;My Reimbursements&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employee-facing reimbursement history, status, expense date, amount claimed, and processed date.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_Reimbursements&quot; zc-height=&quot;720px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-lines&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Reimbursement Line Items List&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Expense type, expense date, amount, uploaded bill, and notes for child line item rows.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Reimbursement_Line_Items_List&quot; zc-height=&quot;640px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-hr&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR Reimbursement Queue&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending HR and health insurance reimbursement review queue.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;HR_Reimbursement_Queue&quot; zc-height=&quot;720px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\tif(!isHR)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;rh-access-note zcs-p-14 zcs-font-13&quot;&gt;HR queue visibility depends on the logged-in user&apos;s profile permissions.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-finance&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Finance Reimbursement Queue&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending finance and processed reimbursement records with processed date filters.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Finance_Reimbursement_Queue&quot; zc-height=&quot;720px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\tif(!isFinance)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;rh-access-note zcs-p-14 zcs-font-13&quot;&gt;Finance queue visibility depends on the logged-in user&apos;s profile permissions.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;rh-panel rh-panel-kanban&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;rh-embed-card&quot;&gt;&lt;div class=&quot;rh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Reimbursement Status Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Status board for reimbursement triage across employee, HR, and finance stages.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;rh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Reimbursement_Status_Kanban&quot; zc-height=&quot;640px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;rh-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Reimbursement_Request?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Create reimbursement request&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_Reimbursements&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open my reimbursements&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Reimbursement_Line_Items_List&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Review line items&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:HR_Reimbursement_Queue&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-05&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open HR queue&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-bank&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open finance queue&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Reimbursement_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open status Kanban&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&quot;rh-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold zcs-color-primary&quot;&gt;Current pipeline&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=pendingHRCount%&gt; HR reviews and &lt;%=pendingFinanceCount%&gt; finance reviews are waiting. &lt;%=processedCount%&gt; reimbursements are processed.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-row zcs-align-items-center zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;HR &lt;%=pendingHRCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Finance &lt;%=pendingFinanceCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Processed &lt;%=processedCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Settings_Home
		{
					displayname = "Settings Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Settings_Workspace' elementName='Settings_Workspace' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Settings_Workspace()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tdepartmentCount = Department_Config[ID != 0].count();\n\tnoticePeriodCount = Notice_Period_Config[ID != 0].count();\n\tholidayCount = Holiday_Master[ID != 0].count();\n\tleaveTypeCount = Leave_Type_Config[ID != 0].count();\n\tshiftCount = Shift_Config[ID != 0].count();\n\treimbursementTypeCount = Reimbursement_Type_Config[ID != 0].count();\n\toffboardingChecklistCount = Offboarding_Checklist_Config[ID != 0].count();\n\tofferDocumentCount = Offer_Document_Config[ID != 0].count();\n\tnotificationConfigCount = Notification_Config[ID != 0].count();\n\tapprovalRemarksCount = Approval_Remarks[ID != 0].count();\n\tauditLogCount = Audit_Log[ID != 0].count();\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color);\n\t--zcs-page-bg-color: #F3F3F4;\n\t--zcs-primary-text-color: var(--zcs_primary_text_color);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);\n\t--zcs-border-color: var(--zcs_tertiary_border_color);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-0{margin-top:0}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}a{text-decoration:none}\n\n/* ZCS component CSS: Horizontal Tab With Icon */\n.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none;background:var(--zcs-white-color);position:sticky;top:0;z-index:5}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tabicon{width:16px;height:16px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabbody{overflow:visible}\n\n/* ZCS component CSS: Heading with Actions and Primary Outline Button */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color);border-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:linear-gradient(135deg,var(--zcs-white-color),var(--zcs_component_hover_color));border:1px solid var(--zcs_tertiary_border_color);border-radius:14px}\n\n/* ZCS component CSS: Badge with Icon */\n.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9A6505}\n\n/* Settings Home layout */\n.settings-home{min-height:100%;background:var(--zcs-page-bg-color);padding:24px;box-sizing:border-box;color:var(--zcs-primary-text-color)}\n.settings-shell{max-width:1440px;margin:0 auto}.settings-intro{max-width:760px}.settings-summary{display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:14px;margin:18px 0}.settings-summary-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;padding:16px;box-sizing:border-box}.settings-summary-card .summary-value{font-size:24px;font-weight:700;line-height:1.1;color:var(--zcs_brand_color)}.settings-summary-card .summary-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:4px}.settings-nav-wrap{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-bottom:18px;overflow:hidden}.settings-section{scroll-margin-top:76px;margin-top:20px}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.section-title{font-size:20px;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.section-subtitle{font-size:14px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.settings-master-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;margin-bottom:18px;overflow:hidden;box-shadow:0 1px 3px rgba(20,20,50,.05)}.master-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:linear-gradient(180deg,var(--zcs-white-color),rgba(248,248,252,.9))}.master-title-wrap{display:flex;align-items:flex-start;gap:12px;min-width:0}.master-icon{width:40px;height:40px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;flex-shrink:0}.master-copy{min-width:0}.master-title{font-size:17px;font-weight:700;line-height:1.25;margin:0;color:var(--zcs-primary-text-color)}.master-desc{font-size:13px;color:var(--zcs-secondary-text-color);margin:5px 0 0}.master-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.embed-grid{display:grid;grid-template-columns:minmax(320px,34%) minmax(0,1fr);gap:16px;padding:18px 20px 20px}.embed-grid.report-only{grid-template-columns:1fr}.embed-panel{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:var(--zcs-white-color);overflow:hidden}.embed-panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:var(--zcs_component_hover_color)}.embed-panel-title h4{margin:0;font-size:14px;font-weight:700;color:var(--zcs-primary-text-color)}.embed-panel-body{padding:0;min-height:360px}.report-embed{min-height:520px}.form-embed{min-height:360px}.logs-embed{min-height:650px}.settings-note{background:var(--zcs-white-color);border:1px dashed var(--zcs_brand_color);border-radius:12px;padding:14px 16px;color:var(--zcs-secondary-text-color);font-size:14px;margin-bottom:18px}.settings-note i{color:var(--zcs_brand_color)}\n@media (max-width:1100px){.settings-summary{grid-template-columns:repeat(2,minmax(160px,1fr))}.embed-grid{grid-template-columns:1fr}.master-card-header{flex-direction:column}.master-actions{justify-content:flex-start}}\n@media (max-width:640px){.settings-home{padding:14px}.settings-summary{grid-template-columns:1fr}.zcs-page-header{padding:16px}.master-card-header{padding:16px}.embed-grid{padding:14px}.settings-horizontal-tabhead{padding-left:8px;padding-right:8px}}\n&lt;/style&gt;\n\n&lt;div class=&quot;settings-home&quot;&gt;\n\t&lt;div class=&quot;settings-shell&quot;&gt;\n\t\t&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border zcs-mb-16&apos;&gt;\n\t\t\t&lt;div class=&apos;settings-intro zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-font-24 zcs-color-theme zc-li-outline ui-1-settings-gear-63&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;h1 class=&apos;zcs-font-24 zcs-font-bold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Settings Home&lt;/h1&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0&apos;&gt;Page-first workspace for configuration masters, workflow settings, approval remarks, and audit logs.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t&lt;i class=&apos;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;Embedded reports&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;settings-summary&quot;&gt;\n\t\t\t&lt;div class=&quot;settings-summary-card&quot;&gt;&lt;div class=&quot;summary-value&quot;&gt;11&lt;/div&gt;&lt;div class=&quot;summary-label&quot;&gt;Report workspaces&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;settings-summary-card&quot;&gt;&lt;div class=&quot;summary-value&quot;&gt;9&lt;/div&gt;&lt;div class=&quot;summary-label&quot;&gt;Quick-entry master forms&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;settings-summary-card&quot;&gt;&lt;div class=&quot;summary-value&quot;&gt;&lt;%=approvalRemarksCount%&gt;&lt;/div&gt;&lt;div class=&quot;summary-label&quot;&gt;Approval remark records&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;settings-summary-card&quot;&gt;&lt;div class=&quot;summary-value&quot;&gt;&lt;%=auditLogCount%&gt;&lt;/div&gt;&lt;div class=&quot;summary-label&quot;&gt;Audit log records&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;settings-nav-wrap&quot;&gt;\n\t\t\t&lt;div class=&apos;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full&apos;&gt;\n\t\t\t\t&lt;ul class=&apos;zcs-horizontal-tabhead settings-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem zcs-horizontal-tabactive&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#settings-core&apos;&gt;&lt;i class=&apos;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-settings-gear-63&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Core masters&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#settings-time&apos;&gt;&lt;i class=&apos;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-2-time&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Time and leave&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#settings-workflow&apos;&gt;&lt;i class=&apos;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-edit-72&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Workflow config&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&apos;zcs-horizontal-tabitem&apos;&gt;&lt;a class=&apos;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&apos; href=&apos;#settings-logs&apos;&gt;&lt;i class=&apos;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline arrows-4-restore&apos;&gt;&lt;/i&gt;&lt;span class=&apos;zcs-horizontal-tabtext zcs-font-15&apos;&gt;Admin logs&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;settings-note zcs-flex zcs-align-items-start zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-18&quot;&gt;&lt;/i&gt;&lt;span&gt;Each master below keeps the add form and report together so admins can maintain data without leaving this page. Use the full-report and full-form links only when a wider view is needed.&lt;/span&gt;&lt;/div&gt;\n\n\t\t&lt;section id=&quot;settings-core&quot; class=&quot;settings-section&quot;&gt;\n\t\t\t&lt;div class=&quot;section-heading&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;section-title&quot;&gt;Core masters&lt;/h2&gt;&lt;p class=&quot;section-subtitle&quot;&gt;Department and employment-policy records used across HR operations.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\n\t\t\t&lt;article class=&quot;settings-master-card&quot;&gt;\n\t\t\t\t&lt;div class=&quot;master-card-header&quot;&gt;&lt;div class=&quot;master-title-wrap&quot;&gt;&lt;div class=&quot;master-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-63 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;master-copy&quot;&gt;&lt;h3 class=&quot;master-title&quot;&gt;Departments&lt;/h3&gt;&lt;p class=&quot;master-desc&quot;&gt;Maintain department names, department heads, and active status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;master-actions&quot;&gt;&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-14&quot;&gt;&lt;%=departmentCount%&gt; records&lt;/span&gt;&lt;/div&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Report:Department_List&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Full report&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14&quot; href=&quot;#Form:Department_Config&quot; target=&quot;_blank&quot;&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open form&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;embed-grid&quot;&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Add Department&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel-body form-embed&quot;&gt;&lt;div zc-component=&quot;form&quot; zc-linkname=&quot;Department_Config&quot; zc-height=&quot;360px&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;embed-panel&quot;&gt;&lt;div class=&quot;embed-panel-title&quot;&gt;&lt;h4&gt;Department List&lt;/h4&gt