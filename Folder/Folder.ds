							}
						
			}

			Move_Candidate_To_Pool as "Move Candidate To Pool"
			{
			
							type =  functions
							form = Job_Application
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									candidateRows = Candidate[ID == input.Candidate];
													if(candidateRows.count() > 0)
													{
														candidateRows.Is_In_Pool=true;
														candidateRows.Pool_Notes="Moved from job application " + input.ID + " with status " + input.Status;
														thisapp.Add_Audit_Log("CANDIDATE_MOVED_TO_POOL","Recruitment","Job_Application",input.ID,"Move to Pool",input.Status,input.Status,"Candidate moved to talent pool.",true,"");
													}
								)
								}
							}
						
			}

			Place_Application_On_Hold as "Place Application On Hold"
			{
			
							type =  functions
							form = Job_Application
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Status == "Active")
													{
														input.Status = "On_Hold";
														thisapp.Add_Audit_Log("JOB_APPLICATION_ON_HOLD","Recruitment","Job_Application",input.ID,"On Hold","Active","On_Hold","Application placed on hold.",true,"");
													}
													else
													{
														info "Only active applications can be placed on hold.";
													}
								)
								}
							}
						
			}

			Resume_Job_Application as "Resume Job Application"
			{
			
							type =  functions
							form = Job_Application
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Status == "On_Hold")
													{
														input.Status = "Active";
														thisapp.Add_Audit_Log("JOB_APPLICATION_RESUMED","Recruitment","Job_Application",input.ID,"Resume","On_Hold","Active","Application resumed.",true,"");
													}
													else
													{
														info "Only on-hold applications can be resumed.";
													}
								)
								}
							}
						
			}

			View_Interview_Feedback as "View Interview Feedback"
			{
			
							type =  functions
							form = Job_Application
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									openUrl("#Report:Interview_Feedback_List?Job_Application=" + input.ID,"same window");
								)
								}
							}
						
			}

			Approve_Job_Request as "Approve Job Request"
			{
			
							type =  functions
							form = Job_Request
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Status != "Pending_CEO")
													{
														info "Only pending CEO job requests can be approved.";
													}
													else
													{
														input.Status = "Approved";
														input.Approved_Date = zoho.currentdate;
														tokenMap = Map();
														tokenMap.put("job_title",input.Job_Title);
														tokenMap.put("status",input.Status);
														tokenMap.put("department",input.Department);
														tokenMap.put("positions",input.Number_Of_Positions);
														thisapp.Add_Audit_Log("JOB_REQUEST_APPROVED","Recruitment","Job_Request",input.ID,"Approved","Pending_CEO","Approved","CEO approved the job request.",true,"");
														thisapp.Send_Configured_Notification("JOB_REQUEST_APPROVED",tokenMap,"Job request approved","Job request {{job_title}} has been approved.");
													}
								)
								}
							}
						
			}

			Reject_Job_Request as "Reject Job Request"
			{
			
							type =  functions
							form = Job_Request
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Status != "Pending_CEO")
													{
														info "Only pending CEO job requests can be rejected.";
													}
													else if(ifnull(input.CEO_Comments,"") == "")
													{
														info "Enter CEO comments on the job request before rejecting it.";
													}
													else
													{
														input.Status = "Rejected";
														tokenMap = Map();
														tokenMap.put("job_title",input.Job_Title);
														tokenMap.put("status",input.Status);
														tokenMap.put("department",input.Department);
														tokenMap.put("positions",input.Number_Of_Positions);
														tokenMap.put("comments",ifnull(input.CEO_Comments,""));
														thisapp.Add_Audit_Log("JOB_REQUEST_REJECTED","Recruitment","Job_Request",input.ID,"Rejected","Pending_CEO","Rejected",ifnull(input.CEO_Comments,""),true,"");
														thisapp.Send_Configured_Notification("JOB_REQUEST_REJECTED",tokenMap,"Job request rejected","Job request {{job_title}} has been rejected. Comments: {{comments}}");
													}
								)
								}
							}
						
			}
		}
	}

	functions
	{
		Deluge
		{
			void Add_Audit_Log(string event_key, string module_name, string form_name, int record_id, string action, string old_status, string new_status, string details, bool success, string error_message)
			{
			
			                 	auditDetails = ifnull(details,"");
			                 	auditError = ifnull(error_message,"");
			                 	auditActor = zoho.loginuserid;
			                 	if(auditActor == null || auditActor == "")
			                 	{
			                 		auditActor = zoho.loginuser;
			                 	}
			                 	insert into Audit_Log
			                 	[
			                 		Event_Key=event_key
			                 		Module_Name=module_name
			                 		Form_Name=form_name
			                 		Record_ID=record_id
			                 		Action=action
			                 		Actor_Email=auditActor
			                 		Actor_Profile=""
			                 		Old_Status=old_status
			                 		New_Status=new_status
			                 		Details=auditDetails
			                 		Success=success
			                 		Error_Message=auditError
			                 		Added_User=zoho.loginuser
			                 	]
			                 
			}

			void Send_Configured_Notification(string event_key, map token_map, string fallback_subject, string fallback_body)
			{
			
			                 	templateRecords = Notification_Config[Event_Key == event_key && Is_Active == true];
			                 	if(templateRecords.count() > 0)
			                 	{
			                 		templateRecord = templateRecords;
			                 		mailSubject = ifnull(templateRecord.Subject_Template,fallback_subject);
			                 		mailBody = ifnull(templateRecord.Body_Template,fallback_body);
			                 		if(token_map != null)
			                 		{
			                 			tokenKeys = token_map.keys();
			                 			for each  tokenName in tokenKeys
			                 			{
			                 				tokenValue = ifnull(token_map.get(tokenName),"");
			                 				mailSubject = mailSubject.replaceAll("{{" + tokenName + "}}",tokenValue,true);
			                 				mailBody = mailBody.replaceAll("{{" + tokenName + "}}",tokenValue,true);
			                 			}
			                 		}
			                 		sendmail
			                 		[
			                 			from :zoho.adminuserid
			                 			to :templateRecord.Recipient_Emails
			                 			subject :mailSubject
			                 			message :mailBody
			                 		]
			                 	}
			                 	else
			                 	{
			                 		adminTemplate = Notification_Config[Event_Key == "ADMIN_ALERT_TEMPLATE_MISSING" && Is_Active == true];
			                 		if(adminTemplate.count() > 0)
			                 		{
			                 			alertSubject = "Notification template missing: " + event_key;
			                 			alertBody = "Notification configuration is missing or inactive for event key: " + event_key + ". Please update Notification Config.";
			                 			sendmail
			                 			[
			                 				from :zoho.adminuserid
			                 				to :adminTemplate.Recipient_Emails
			                 				subject :alertSubject
			                 				message :alertBody
			                 			]
			                 		}
			                 		thisapp.Add_Audit_Log(event_key,"Notification","Notification_Config",0,"Template Missing","","","Notification template missing or inactive",false,"Missing Notification_Config");
			                 	}
			                 
			}
		}
	}

