cs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Form:Member_Master?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add member&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer&quot; href=&quot;#Report:Member_Master_List?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-circle-10&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open members&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;eh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock zcs-font-18 zcs-color-tertiary&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-font-15 zcs-color-primary zcs-font-medium&quot;&gt;Employee access&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;HR/admin and ASPIRE/admin quick actions are hidden for this profile.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;div class=&quot;eh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Access routing&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;All_Employees is surfaced for HR/admin. Member_Master_List is surfaced for ASPIRE/admin. My_Profile, Employee_Directory, and Org_Chart are available from the main workspace.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Finance_Dashboard
		{
					displayname = "Finance Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Finance_Dashboard_Snippet' elementName='Finance_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Finance_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;FINANCE&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tmonthLabel = todayDate.toString(&quot;MMM yyyy&quot;);\n\tcurrentMonth = todayDate.getMonth();\n\tcurrentYear = todayDate.getYear();\n\tuserName = ifnull(zoho.loginuser,&quot;Finance&quot;);\n\tuserRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(userRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(userRows.Full_Name,userName);\n\t}\n\tpendingFinanceReimbursementCount = 0;\n\tpendingFinanceReimbursementAmount = 0;\n\tbillsPendingTravelCount = 0;\n\tbillsPendingTravelAmount = 0;\n\tpendingGiftDecisionCount = 0;\n\tpendingGiftDecisionAmount = 0;\n\tprocessedMonthCount = 0;\n\tprocessedMonthAmount = 0;\n\tprocessedTravelLinkedCount = 0;\n\ttravelSpendMonth = 0;\n\ttravelSpendMonthCount = 0;\n\tmaxTypeAmount = 1;\n\tif(isAllowed == true)\n\t{\n\t\tpendingFinanceReimbursementRows = Reimbursement_Request[Status == &quot;Pending_Finance&quot;] sort by Expense_Date desc;\n\t\tpendingFinanceReimbursementCount = pendingFinanceReimbursementRows.count();\n\t\tfor each  reimbursementSeed in pendingFinanceReimbursementRows\n\t\t{\n\t\t\tpendingFinanceReimbursementAmount = pendingFinanceReimbursementAmount + ifnull(reimbursementSeed.Amount_Claimed,0);\n\t\t}\n\t\tbillsPendingTravelRows = Travel_Request[Status == &quot;Bills_Pending&quot;] sort by Travel_Completed_Date asc;\n\t\tbillsPendingTravelCount = billsPendingTravelRows.count();\n\t\tfor each  travelBillSeed in billsPendingTravelRows\n\t\t{\n\t\t\tbillAmount = ifnull(travelBillSeed.Total_Actual_Cost,0);\n\t\t\tif(billAmount == 0)\n\t\t\t{\n\t\t\t\tbillAmount = ifnull(travelBillSeed.Booking_Amount,0);\n\t\t\t}\n\t\t\tbillsPendingTravelAmount = billsPendingTravelAmount + billAmount;\n\t\t}\n\t\tpendingGiftDecisionRows = Gift_Registration[Status == &quot;Pending_Finance&quot;] sort by Received_Date desc;\n\t\tpendingGiftDecisionCount = pendingGiftDecisionRows.count();\n\t\tfor each  giftSeed in pendingGiftDecisionRows\n\t\t{\n\t\t\tpendingGiftDecisionAmount = pendingGiftDecisionAmount + ifnull(giftSeed.Estimated_Value,0);\n\t\t}\n\t\tprocessedRows = Reimbursement_Request[Status == &quot;Processed&quot; &amp;&amp; Processed_Date != null] sort by Processed_Date desc;\n\t\tfor each  processedSeed in processedRows\n\t\t{\n\t\t\tif(processedSeed.Processed_Date.getMonth() == currentMonth &amp;&amp; processedSeed.Processed_Date.getYear() == currentYear)\n\t\t\t{\n\t\t\t\tprocessedMonthCount = processedMonthCount + 1;\n\t\t\t\tprocessedMonthAmount = processedMonthAmount + ifnull(processedSeed.Amount_Claimed,0);\n\t\t\t\tif(processedSeed.Source == &quot;Travel_Module&quot;)\n\t\t\t\t{\n\t\t\t\t\tprocessedTravelLinkedCount = processedTravelLinkedCount + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\ttravelSpendRows = Travel_Request[Status != &quot;Rejected&quot;];\n\t\tfor each  travelSpendSeed in travelSpendRows\n\t\t{\n\t\t\ttravelMonthDate = null;\n\t\t\tif(travelSpendSeed.Bills_Upload_Date != null)\n\t\t\t{\n\t\t\t\ttravelMonthDate = travelSpendSeed.Bills_Upload_Date;\n\t\t\t}\n\t\t\telse if(travelSpendSeed.Travel_Completed_Date != null)\n\t\t\t{\n\t\t\t\ttravelMonthDate = travelSpendSeed.Travel_Completed_Date;\n\t\t\t}\n\t\t\tif(travelMonthDate != null &amp;&amp; travelMonthDate.getMonth() == currentMonth &amp;&amp; travelMonthDate.getYear() == currentYear)\n\t\t\t{\n\t\t\t\ttravelMonthAmount = ifnull(travelSpendSeed.Total_Actual_Cost,0);\n\t\t\t\tif(travelMonthAmount == 0)\n\t\t\t\t{\n\t\t\t\t\ttravelMonthAmount = ifnull(travelSpendSeed.Booking_Amount,0);\n\t\t\t\t}\n\t\t\t\ttravelSpendMonth = travelSpendMonth + travelMonthAmount;\n\t\t\t\ttravelSpendMonthCount = travelSpendMonthCount + 1;\n\t\t\t}\n\t\t}\n\t\treimbursementTypeRows = Reimbursement_Type_Config[Is_Active == true] sort by Type_Name asc;\n\t\tfor each  typeSeed in reimbursementTypeRows\n\t\t{\n\t\t\ttypeSeedAmount = 0;\n\t\t\tfor each  processedTypeSeed in processedRows\n\t\t\t{\n\t\t\t\tif(processedTypeSeed.Processed_Date != null &amp;&amp; processedTypeSeed.Processed_Date.getMonth() == currentMonth &amp;&amp; processedTypeSeed.Processed_Date.getYear() == currentYear &amp;&amp; processedTypeSeed.Reimbursement_Type == typeSeed.ID)\n\t\t\t\t{\n\t\t\t\t\ttypeSeedAmount = typeSeedAmount + ifnull(processedTypeSeed.Amount_Claimed,0);\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(typeSeedAmount &gt; maxTypeAmount)\n\t\t\t{\n\t\t\t\tmaxTypeAmount = typeSeedAmount;\n\t\t\t}\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for Finance_Dashboard (utility subset used by this page) ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: layout-dashboard panel tiles */\n.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs-border-color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: all .2s ease; } .zcs-panel-icon-wrapper { width: 42px; height: 42px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #FDF5F3; color: #F4660C; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #F6F6FB; color: #5C66FF; } .zcs-panel:hover { border-color: var(--zcs-theme-brand-color); background-image: linear-gradient(rgb(253 253 255 / 10%), #F7F9FF); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n/* ZCS component CSS: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: card-fleets-performance-metrics progress bars */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F7); overflow: hidden; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }\n.finance-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }\n.finance-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #09598E); }\n.finance-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -125px; width: 340px; height: 340px; border-radius: 50%; border: 42px solid rgba(255,255,255,.13); }\n.finance-hero:before { content: &quot;&quot;; position: absolute; right: 180px; bottom: -100px; width: 210px; height: 210px; border-radius: 50%; border: 30px solid rgba(255,255,255,.10); }\n.finance-hero-content { position: relative; z-index: 1; }\n.finance-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.finance-kpi { grid-column: span 3; } .finance-card-4 { grid-column: span 4; } .finance-card-5 { grid-column: span 5; } .finance-card-6 { grid-column: span 6; } .finance-card-7 { grid-column: span 7; } .finance-card-8 { grid-column: span 8; } .finance-card-12 { grid-column: span 12; }\n.finance-mini-stat { border: 1px solid var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; padding: 12px; }\n.finance-list { list-style: none; margin: 0; padding: 0; } .finance-list li { border-top: 1px solid var(--zcs-border-color); padding: 12px 0; } .finance-list li:first-child { border-top: 0; padding-top: 0; }\n.finance-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }\n.finance-bar-row { display: grid; grid-template-columns: minmax(130px, 1fr) 2fr 105px; gap: 10px; align-items: center; }\n.finance-status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; } .finance-status-dot.green { background: #179E6C; } .finance-status-dot.yellow { background: #FAAE13; } .finance-status-dot.red { background: #FE455D; } .finance-status-dot.blue { background: #2A6FFC; } .finance-status-dot.orange { background: #F4660C; }\n@media (max-width: 1100px) { .finance-kpi, .finance-card-4, .finance-card-5, .finance-card-6, .finance-card-7, .finance-card-8 { grid-column: span 6; } }\n@media (max-width: 700px) { .finance-page { padding: 14px; } .finance-kpi, .finance-card-4, .finance-card-5, .finance-card-6, .finance-card-7, .finance-card-8, .finance-card-12 { grid-column: span 12; } .finance-bar-row { grid-template-columns: 1fr; } .finance-hero-content { align-items: flex-start; flex-direction: column; } }\n&lt;/style&gt;\n&lt;%\n\tif(isAllowed == true)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;finance-page zcs-flex zcs-direction-column zcs-gap-20&quot;&gt;\n\t&lt;div class=&quot;finance-hero&quot;&gt;\n\t\t&lt;div class=&quot;finance-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-badge zcs-badge-filled zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 zcs-font-medium zcs-lh-body&quot;&gt;Live finance operations&lt;/div&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10&quot;&gt;Finance Dashboard&lt;/h2&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-15 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-10&quot;&gt;Hello &lt;%=userName%&gt;. Finance queues and spend summary as of &lt;%=todayDisplay%&gt;.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-2-payment&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Reimbursement queue&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-gift&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Gift queue&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-panel-wrapper&quot;&gt;\n\t\t&lt;ul class=&quot;finance-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t&lt;li class=&quot;finance-kpi&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Report:Finance_Reimbursement_Queue&quot; class=&quot;zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline business-2-payment&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=pendingFinanceReimbursementCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Pending finance reimbursements&lt;/p&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;INR &lt;%=pendingFinanceReimbursementAmount%&gt; awaiting processing&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;finance-kpi&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Report:HR_All_Travel&quot; class=&quot;zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline transport-airplane&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=billsPendingTravelCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Travel bills pending&lt;/p&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;INR &lt;%=billsPendingTravelAmount%&gt; estimated exposure&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;finance-kpi&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Report:HR_Gift_Registry&quot; class=&quot;zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline shopping-gift&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=pendingGiftDecisionCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Gift decisions pending&lt;/p&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;INR &lt;%=pendingGiftDecisionAmount%&gt; estimated value&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;finance-kpi&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Report:Finance_Reimbursement_Queue&quot; class=&quot;zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=processedMonthCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Processed reimbursements&lt;/p&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;INR &lt;%=processedMonthAmount%&gt; in &lt;%=monthLabel%&gt;&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;finance-grid&quot;&gt;\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-8&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending finance reimbursements&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;Live queue total: INR &lt;%=pendingFinanceReimbursementAmount%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Open queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingFinanceReimbursementCount &gt; 0)\n\t\t{\n\t\t\tshownFinanceReimbursements = 0;\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12&quot;&gt;\n\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Employee&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Source&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\t\tfor each  reimbursementItem in pendingFinanceReimbursementRows\n\t\t\t{\n\t\t\t\tif(shownFinanceReimbursements &lt; 6)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;a class=&quot;zcs-color-theme&quot; href=&quot;#Report:Finance_Reimbursement_Queue?ID=&lt;%=reimbursementItem.ID%&gt;&quot;&gt;&lt;%=ifnull(reimbursementItem.Employee.Full_Name,&quot;Employee&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(reimbursementItem.Expense_Date,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary&quot;&gt;&lt;%=ifnull(reimbursementItem.Reimbursement_Type.Type_Name,&quot;Unspecified&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary&quot;&gt;INR &lt;%=ifnull(reimbursementItem.Amount_Claimed,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=ifnull(reimbursementItem.Source,&quot;Direct&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\t\tshownFinanceReimbursements = shownFinanceReimbursements + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12&quot;&gt;&lt;div class=&quot;zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No pending finance reimbursements&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-4&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;This month&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;&lt;%=monthLabel%&gt; processed and travel spend&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;finance-mini-stat&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Processed reimbursement amount&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-m-0 zcs-color-primary&quot;&gt;INR &lt;%=processedMonthAmount%&gt;&lt;/h4&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;&lt;%=processedMonthCount%&gt; records, &lt;%=processedTravelLinkedCount%&gt; travel-linked&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;finance-mini-stat&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Travel spend posted&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-m-0 zcs-color-primary&quot;&gt;INR &lt;%=travelSpendMonth%&gt;&lt;/h4&gt;&lt;p class=&quot;zcs-font-13 zcs-color-secondary zcs-m-0&quot;&gt;&lt;%=travelSpendMonthCount%&gt; travel records in &lt;%=monthLabel%&gt;&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Reimbursement_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Reimbursement kanban&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Bills pending travel list&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;Trips completed and waiting for bill upload&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_All_Travel&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Travel queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(billsPendingTravelCount &gt; 0)\n\t\t{\n\t\t\tshownBills = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;finance-list zcs-mt-12&quot;&gt;\n&lt;%\n\t\t\tfor each  billItem in billsPendingTravelRows\n\t\t\t{\n\t\t\t\tif(shownBills &lt; 5)\n\t\t\t\t{\n\t\t\t\t\tbillCost = ifnull(billItem.Total_Actual_Cost,0);\n\t\t\t\t\tif(billCost == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tbillCost = ifnull(billItem.Booking_Amount,0);\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;a class=&quot;zcs-font-14 zcs-font-semibold zcs-color-theme&quot; href=&quot;#Report:HR_All_Travel?ID=&lt;%=billItem.ID%&gt;&quot;&gt;&lt;%=ifnull(billItem.Destination,&quot;Travel request&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(billItem.Employee.Full_Name,&quot;Employee&quot;)%&gt; | completed &lt;%=ifnull(billItem.Travel_Completed_Date,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-text-right&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Bills pending&lt;/span&gt;&lt;/span&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;INR &lt;%=billCost%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownBills = shownBills + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12&quot;&gt;&lt;div class=&quot;zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No travel bills pending&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending finance gift decisions&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;Retain or return decisions awaiting finance&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Gift registry&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingGiftDecisionCount &gt; 0)\n\t\t{\n\t\t\tshownGifts = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;finance-list zcs-mt-12&quot;&gt;\n&lt;%\n\t\t\tfor each  giftItem in pendingGiftDecisionRows\n\t\t\t{\n\t\t\t\tif(shownGifts &lt; 5)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;&lt;a class=&quot;zcs-font-14 zcs-font-semibold zcs-color-theme&quot; href=&quot;#Report:HR_Gift_Registry?ID=&lt;%=giftItem.ID%&gt;&quot;&gt;&lt;%=ifnull(giftItem.Gift_Name,&quot;Gift declaration&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(giftItem.Employee.Full_Name,&quot;Employee&quot;)%&gt; | from &lt;%=ifnull(giftItem.Received_From,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-text-right&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Pending finance&lt;/span&gt;&lt;/span&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;INR &lt;%=ifnull(giftItem.Estimated_Value,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownGifts = shownGifts + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12&quot;&gt;&lt;div class=&quot;zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No finance gift decisions pending&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-7&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;\n\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Reimbursement by type&lt;/h3&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;Processed amounts in &lt;%=monthLabel%&gt;&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;View processed&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(reimbursementTypeRows.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12&quot;&gt;\n&lt;%\n\t\t\tfor each  typeItem in reimbursementTypeRows\n\t\t\t{\n\t\t\t\ttypeAmount = 0;\n\t\t\t\ttypeCount = 0;\n\t\t\t\tfor each  processedTypeItem in processedRows\n\t\t\t\t{\n\t\t\t\t\tif(processedTypeItem.Processed_Date != null &amp;&amp; processedTypeItem.Processed_Date.getMonth() == currentMonth &amp;&amp; processedTypeItem.Processed_Date.getYear() == currentYear &amp;&amp; processedTypeItem.Reimbursement_Type == typeItem.ID)\n\t\t\t\t\t{\n\t\t\t\t\t\ttypeAmount = typeAmount + ifnull(processedTypeItem.Amount_Claimed,0);\n\t\t\t\t\t\ttypeCount = typeCount + 1;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\ttypePct = 0;\n\t\t\t\tif(maxTypeAmount &gt; 0)\n\t\t\t\t{\n\t\t\t\t\ttypePct = (typeAmount * 100) / maxTypeAmount;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;finance-bar-row&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;span class=&quot;finance-status-dot blue&quot;&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(typeItem.Type_Name,&quot;Type&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=typePct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-text-right&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;INR &lt;%=typeAmount%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-font-11 zcs-color-tertiary&quot;&gt;&lt;%=typeCount%&gt; records&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12&quot;&gt;&lt;div class=&quot;zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No reimbursement types configured&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border finance-card-5&quot;&gt;\n\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Queue links&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4&quot;&gt;Open the underlying reports to process finance actions and review status boards.&lt;/p&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10 zcs-mt-12&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Finance_Reimbursement_Queue&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline business-2-payment&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Finance reimbursement queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_All_Travel&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline transport-airplane&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Travel bills and spend report&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-gift&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Gift finance decisions&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Travel_Selected_Options_List&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-archive-paper&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Travel selected options&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot; href=&quot;#Report:Travel_Status_Kanban&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Travel kanban&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot; href=&quot;#Report:Gift_Status_Kanban&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Gift kanban&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;finance-page&quot;&gt;\n\t&lt;div class=&quot;zcs-card zcs-p-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&quot;&gt;Restricted&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;h3 class=&quot;zcs-font-18 zcs-color-primary&quot;&gt;Finance dashboard&lt;/h3&gt;\n\t\t&lt;p class=&quot;zcs-color-tertiary&quot;&gt;This finance operational dashboard is available to FINANCE and Administrator users.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Gift_Home
		{
					displayname = "Gift Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Gift_Home_Snippet' elementName='Gift_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Gift_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;HR&quot; || isAdmin;\n\tisFinance = loginRole == &quot;FINANCE&quot; || loginRole == &quot;FINANCE_ADMIN&quot; || loginRole == &quot;Finance&quot; || isAdmin;\n\tmyGiftCount = Gift_Registration[Employee.Official_Email == zoho.loginuser || Employee.Official_Email == zoho.loginuserid].count();\n\ttotalGiftCount = Gift_Registration.count();\n\tpendingManagerCount = Gift_Registration[Status == &quot;Pending_Manager&quot;].count();\n\tpendingHRCount = Gift_Registration[Status == &quot;Pending_HR&quot;].count();\n\tpendingFinanceCount = Gift_Registration[Status == &quot;Pending_Finance&quot;].count();\n\tapprovedRetainCount = Gift_Registration[Status == &quot;Approved_Retain&quot;].count();\n\tapprovedReturnCount = Gift_Registration[Status == &quot;Approved_Return&quot;].count();\n\trejectedCount = Gift_Registration[Status == &quot;Rejected&quot;].count();\n\topenReviewCount = pendingManagerCount + pendingHRCount + pendingFinanceCount;\n\tretainedReturnCount = approvedRetainCount + approvedReturnCount;\n\ttotalDeclaredValue = 0;\n\tfinanceQueueValue = 0;\n\tfor each  giftRec in Gift_Registration[ID != 0]\n\t{\n\t\ttotalDeclaredValue = totalDeclaredValue + ifnull(giftRec.Estimated_Value,0);\n\t\tif(giftRec.Status == &quot;Pending_Finance&quot;)\n\t\t{\n\t\t\tfinanceQueueValue = financeQueueValue + ifnull(giftRec.Estimated_Value,0);\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global utility stylesheet included once for Gift_Home ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-14 { gap: .875rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mb-12 { margin-bottom: .75rem; } .zcs-mb-16 { margin-bottom: 1rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-36 { font-size: 2.25rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions and button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: quick-actions-card-type-quick-actions and badge-filled-badge */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* Gift Home layout */\n.gh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.gh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #7C3AED); }\n.gh-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.gh-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.gh-hero-content { position: relative; z-index: 1; }\n.gh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.gh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.gh-kpi { grid-column: span 3; min-height: 118px; }\n.gh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.gh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.gh-workspace { grid-column: span 9; overflow: hidden; }\n.gh-actions { grid-column: span 3; }\n.gh-tab-input { display: none; }\n.gh-tabbar { overflow-x: auto; }\n.gh-tabbar label { cursor: pointer; border-bottom: 2px solid transparent; }\n.gh-panel { display: none; padding: 18px; }\n#gh-tab-overview:checked ~ .zcs-horizontal-tabpanel label[for=&apos;gh-tab-overview&apos;], #gh-tab-new:checked ~ .zcs-horizontal-tabpanel label[for=&apos;gh-tab-new&apos;], #gh-tab-my:checked ~ .zcs-horizontal-tabpanel label[for=&apos;gh-tab-my&apos;], #gh-tab-hr:checked ~ .zcs-horizontal-tabpanel label[for=&apos;gh-tab-hr&apos;], #gh-tab-kanban:checked ~ .zcs-horizontal-tabpanel label[for=&apos;gh-tab-kanban&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#gh-tab-overview:checked ~ .gh-panels .gh-panel-overview, #gh-tab-new:checked ~ .gh-panels .gh-panel-new, #gh-tab-my:checked ~ .gh-panels .gh-panel-my, #gh-tab-hr:checked ~ .gh-panels .gh-panel-hr, #gh-tab-kanban:checked ~ .gh-panels .gh-panel-kanban { display: block; }\n.gh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); margin-bottom: 18px; }\n.gh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.gh-report-frame { min-height: 640px; width: 100%; }\n.gh-report-frame.tall { min-height: 720px; }\n.gh-form-frame { min-height: 760px; width: 100%; }\n.gh-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }\n.gh-tool-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FFFFFF; padding: 18px; }\n.gh-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n.gh-access-note { border: 1px solid #FAAE13; background: #FCF4E6; color: #7E5608; border-radius: 12px; }\n.gh-status-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.gh-status-item { background: #FFFFFF; border: 1px solid var(--zcs-border-color); border-radius: 12px; padding: 14px; }\n@media (max-width: 1180px) { .gh-kpi { grid-column: span 6; } .gh-workspace, .gh-actions { grid-column: span 12; } }\n@media (max-width: 760px) { .gh-page { padding: 14px; } .gh-hero { padding: 18px; } .gh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .gh-kpi { grid-column: span 12; } .gh-panel { padding: 12px; } .gh-mini-grid, .gh-status-strip { grid-template-columns: 1fr; } .gh-report-frame { min-height: 540px; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;gh-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Gift Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Gift declaration workspace for employees, HR review, finance retain or return decisions, and status tracking&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Gift_Registration?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Declare Gift&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_Gift_Registrations&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;My Declarations&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;gh-hero&quot;&gt;\n\t\t&lt;div class=&quot;gh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-font-medium&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zc-li-outline business-tie-01 zcs-font-18&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span&gt;Gift Registry Workspace&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Declare, review, and close every gift decision from one page&lt;/h2&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-15 zcs-lh-body zcs-m-0&quot;&gt;Employees can file a declaration while HR and finance teams track pending reviews, retain or return outcomes, and kanban status movement.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10 zcs-no-shrink&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open HR Registry&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Gift_Status_Kanban&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline design-2-dashboard-level&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open Kanban&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;gh-grid&quot;&gt;\n\t\t&lt;div class=&quot;gh-kpi zcs-card zcs-p-18 zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;span class=&quot;gh-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Mine&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;gh-kpi-value&quot;&gt;&lt;%=myGiftCount%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;My gift declarations&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;gh-kpi zcs-card zcs-p-18 zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;span class=&quot;gh-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-4-restore zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Review&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;gh-kpi-value&quot;&gt;&lt;%=openReviewCount%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Open manager, HR, and finance reviews&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;gh-kpi zcs-card zcs-p-18 zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;span class=&quot;gh-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Finance&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;gh-kpi-value&quot;&gt;&lt;%=pendingFinanceCount%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Pending finance decisions&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;gh-kpi zcs-card zcs-p-18 zcs-flex zcs-direction-column zcs-gap-14 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;span class=&quot;gh-kpi-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;Closed&lt;/span&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div&gt;&lt;div class=&quot;gh-kpi-value&quot;&gt;&lt;%=retainedReturnCount%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Approved retain or return outcomes&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;gh-grid&quot;&gt;\n\t\t&lt;div class=&quot;gh-workspace zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;input class=&quot;gh-tab-input&quot; type=&quot;radio&quot; name=&quot;gh-tabs&quot; id=&quot;gh-tab-overview&quot; checked&gt;\n\t\t\t&lt;input class=&quot;gh-tab-input&quot; type=&quot;radio&quot; name=&quot;gh-tabs&quot; id=&quot;gh-tab-new&quot;&gt;\n\t\t\t&lt;input class=&quot;gh-tab-input&quot; type=&quot;radio&quot; name=&quot;gh-tabs&quot; id=&quot;gh-tab-my&quot;&gt;\n\t\t\t&lt;input class=&quot;gh-tab-input&quot; type=&quot;radio&quot; name=&quot;gh-tabs&quot; id=&quot;gh-tab-hr&quot;&gt;\n\t\t\t&lt;input class=&quot;gh-tab-input&quot; type=&quot;radio&quot; name=&quot;gh-tabs&quot; id=&quot;gh-tab-kanban&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full&quot;&gt;\n\t\t\t\t&lt;ul class=&quot;gh-tabbar zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;gh-tab-overview&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zc-li-outline design-2-dashboard-level&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Overview&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;gh-tab-new&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Declare Gift&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;gh-tab-my&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;My Gifts&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;gh-tab-hr&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;HR and Finance Registry&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;gh-tab-kanban&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zc-li-outline design-bullet-list-68&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Status Kanban&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;gh-panels&quot;&gt;\n\t\t\t\t&lt;div class=&quot;gh-panel gh-panel-overview&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;gh-status-strip zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;gh-status-item&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending Manager&lt;/div&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-mt-4&quot;&gt;&lt;%=pendingManagerCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;gh-status-item&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Pending HR&lt;/div&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-mt-4&quot;&gt;&lt;%=pendingHRCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;gh-status-item&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Approved Retain&lt;/div&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-mt-4&quot;&gt;&lt;%=approvedRetainCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;gh-status-item&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Approved Return&lt;/div&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-mt-4&quot;&gt;&lt;%=approvedReturnCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;gh-mini-grid&quot;&gt;\n\t\t\t\t\t\t&lt;article class=&quot;gh-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20 zcs-color-green&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Registry coverage&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Total declarations: &lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=totalGiftCount%&gt;&lt;/strong&gt;. Total declared estimated value: &lt;strong class=&quot;zcs-color-primary&quot;&gt;INR &lt;%=totalDeclaredValue%&gt;&lt;/strong&gt;.&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Review Registry&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t\t&lt;article class=&quot;gh-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-20 zcs-color-yellow&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Finance queue&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Pending finance items: &lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=pendingFinanceCount%&gt;&lt;/strong&gt;. Queue value: &lt;strong class=&quot;zcs-color-primary&quot;&gt;INR &lt;%=financeQueueValue%&gt;&lt;/strong&gt;. Rejected declarations: &lt;strong class=&quot;zcs-color-primary&quot;&gt;&lt;%=rejectedCount%&gt;&lt;/strong&gt;.&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Gift_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline design-bullet-list-68&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Track Status&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/article&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;gh-panel gh-panel-new&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;gh-embed-card&quot;&gt;&lt;div class=&quot;gh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Gift Registration Create Flow&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employee declaration form embedded for reliable submission.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;gh-form-frame&quot; zc-component=&quot;form&quot; zc-linkname=&quot;Gift_Registration&quot; zc-height=&quot;760px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;gh-panel gh-panel-my&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;gh-embed-card&quot;&gt;&lt;div class=&quot;gh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;My Gift Registrations&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employee-facing declaration history and current approval state.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;gh-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_Gift_Registrations&quot; zc-height=&quot;640px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;gh-panel gh-panel-hr&quot;&gt;\n&lt;%\n\tif(isHR || isFinance)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;gh-embed-card&quot;&gt;&lt;div class=&quot;gh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR Gift Registry&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;HR and finance review workspace for all gift declarations.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;gh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;HR_Gift_Registry&quot; zc-height=&quot;720px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;gh-access-note zcs-p-18 zcs-flex zcs-align-items-start zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-22&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;h4 class=&quot;zcs-font-16 zcs-font-semibold zcs-m-0&quot;&gt;Restricted review queue&lt;/h4&gt;&lt;p class=&quot;zcs-font-14 zcs-mt-4 zcs-mb-0&quot;&gt;HR and finance registry access is permission controlled. Use My Gifts for employee declarations.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;gh-panel gh-panel-kanban&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;gh-embed-card&quot;&gt;&lt;div class=&quot;gh-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Gift Status Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Kanban view grouped by Pending Manager, Pending HR, Pending Finance, Approved, and Rejected statuses.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;gh-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Gift_Status_Kanban&quot; zc-height=&quot;720px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;aside class=&quot;gh-actions zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Gift_Registration?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Declare a gift&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_Gift_Registrations&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;View my declarations&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:HR_Gift_Registry&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open HR registry&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Gift_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zc-li-outline design-bullet-list-68&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Track kanban status&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;gh-note zcs-p-16 zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-20 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Routing guide&lt;/h5&gt;&lt;/div&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;New declarations start in Pending Manager. Manager approval moves to Pending HR; HR approval moves to Pending Finance; finance closes the case as Approved Retain or Approved Return.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page HR_Admin_Dashboard
		{
					displayname = "HR Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='HR_Admin_Dashboard_Snippet' elementName='HR_Admin_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage HR_Admin_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;HR_ADMIN&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tsoonDate = todayDate.addDay(30);\n\tsevenDayDate = todayDate.addDay(7);\n\tuserName = ifnull(zoho.loginuser,&quot;HR Admin&quot;);\n\thrRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(hrRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(hrRows.Full_Name,userName);\n\t}\n\tif(isAllowed == true)\n\t{\n\t\tactiveEmployeeRows = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;];\n\t\ttotalHeadcount = activeEmployeeRows.count();\n\t\tactiveHeadcount = Employee_Master[Employment_Status == &quot;Active&quot;].count();\n\t\tprobationHeadcount = Employee_Master[Employment_Status == &quot;Probation&quot;].count();\n\t\tinactiveHeadcount = Employee_Master[Employment_Status == &quot;Inactive&quot;].count();\n\t\tfullTimeCount = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot; &amp;&amp; Employment_Type == &quot;Full_Time&quot;].count();\n\t\tcontractorCount = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot; &amp;&amp; Employment_Type == &quot;Contractor&quot;].count();\n\t\tinternCount = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot; &amp;&amp; Employment_Type == &quot;Intern&quot;].count();\n\t\tfullTimePct = 0;\n\t\tcontractorPct = 0;\n\t\tinternPct = 0;\n\t\tif(totalHeadcount &gt; 0)\n\t\t{\n\t\t\tfullTimePct = (fullTimeCount * 100) / totalHeadcount;\n\t\t\tcontractorPct = (contractorCount * 100) / totalHeadcount;\n\t\t\tinternPct = (internCount * 100) / totalHeadcount;\n\t\t}\n\t\tdepartmentRows = Department_Config[Is_Active == true] sort by Department_Name asc;\n\t\tmaxDepartmentCount = 1;\n\t\tfor each  deptSeed in departmentRows\n\t\t{\n\t\t\tdeptSeedCount = Employee_Master[Department == deptSeed.ID &amp;&amp; Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;].count();\n\t\t\tif(deptSeedCount &gt; maxDepartmentCount)\n\t\t\t{\n\t\t\t\tmaxDepartmentCount = deptSeedCount;\n\t\t\t}\n\t\t}\n\t\tapprovedJobRows = Job_Request[Status == &quot;Approved&quot;];\n\t\tapprovedJobCount = approvedJobRows.count();\n\t\tapprovedPositionCount = 0;\n\t\tlinkedinPendingCount = 0;\n\t\tfor each  jobSeed in approvedJobRows\n\t\t{\n\t\t\tapprovedPositionCount = approvedPositionCount + ifnull(jobSeed.Number_Of_Positions,0);\n\t\t\tif(ifnull(jobSeed.Linkedin_Posted,false) == false)\n\t\t\t{\n\t\t\t\tlinkedinPendingCount = linkedinPendingCount + 1;\n\t\t\t}\n\t\t}\n\t\tapplicationActiveCount = Job_Application[Status == &quot;Active&quot;].count();\n\t\tapplicationOnHoldCount = Job_Application[Status == &quot;On_Hold&quot;].count();\n\t\tapplicationSelectedCount = Job_Application[Status == &quot;Selected&quot;].count();\n\t\tapplicationRejectedCount = Job_Application[Status == &quot;Rejected&quot;].count();\n\t\tapplicationOfferAcceptedCount = Job_Application[Status == &quot;Offer_Accepted&quot;].count();\n\t\tapplicationJoinedCount = Job_Application[Status == &quot;Joined&quot;].count();\n\t\trecruitmentTotal = applicationActiveCount + applicationOnHoldCount + applicationSelectedCount + applicationRejectedCount + applicationOfferAcceptedCount + applicationJoinedCount;\n\t\tactiveAppPct = 0;\n\t\tholdAppPct = 0;\n\t\tselectedAppPct = 0;\n\t\tofferAppPct = 0;\n\t\tjoinedAppPct = 0;\n\t\trejectedAppPct = 0;\n\t\tif(recruitmentTotal &gt; 0)\n\t\t{\n\t\t\tactiveAppPct = (applicationActiveCount * 100) / recruitmentTotal;\n\t\t\tholdAppPct = (applicationOnHoldCount * 100) / recruitmentTotal;\n\t\t\tselectedAppPct = (applicationSelectedCount * 100) / recruitmentTotal;\n\t\t\tofferAppPct = (applicationOfferAcceptedCount * 100) / recruitmentTotal;\n\t\t\tjoinedAppPct = (applicationJoinedCount * 100) / recruitmentTotal;\n\t\t\trejectedAppPct = (applicationRejectedCount * 100) / recruitmentTotal;\n\t\t}\n\t\ttodayAttendanceRows = Attendance_Log[Attendance_Date == todayDate];\n\t\tattendanceMarkedCount = todayAttendanceRows.count();\n\t\tpresentTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Present&quot;].count();\n\t\twfhTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;WFH&quot; || Attendance_Status == &quot;On_Duty&quot;].count();\n\t\tleaveTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Leave&quot;].count();\n\t\tabsentTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Absent&quot;].count();\n\t\thalfDayTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Half_Day&quot;].count();\n\t\tnotMarkedTodayCount = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Not_Marked&quot;].count();\n\t\tnoAttendanceLogCount = totalHeadcount - attendanceMarkedCount;\n\t\tif(noAttendanceLogCount &lt; 0)\n\t\t{\n\t\t\tnoAttendanceLogCount = 0;\n\t\t}\n\t\tattendanceCompletionPct = 0;\n\t\tif(totalHeadcount &gt; 0)\n\t\t{\n\t\t\tattendanceCompletionPct = (attendanceMarkedCount * 100) / totalHeadcount;\n\t\t}\n\t\tappraisalDraftCount = Appraisal_Form[Status == &quot;Draft&quot;].count();\n\t\tappraisalSubmittedCount = Appraisal_Form[Status == &quot;Submitted&quot;].count();\n\t\tappraisalManagerReviewedCount = Appraisal_Form[Status == &quot;Manager_Reviewed&quot;].count();\n\t\tappraisalHrApprovedCount = Appraisal_Form[Status == &quot;HR_Approved&quot;].count();\n\t\tappraisalTotal = appraisalDraftCount + appraisalSubmittedCount + appraisalManagerReviewedCount + appraisalHrApprovedCount;\n\t\tappraisalCompletionPct = 0;\n\t\tif(appraisalTotal &gt; 0)\n\t\t{\n\t\t\tappraisalCompletionPct = (appraisalHrApprovedCount * 100) / appraisalTotal;\n\t\t}\n\t\tappraisalDraftPct = 0;\n\t\tappraisalSubmittedPct = 0;\n\t\tappraisalManagerReviewedPct = 0;\n\t\tappraisalHrApprovedPct = 0;\n\t\tif(appraisalTotal &gt; 0)\n\t\t{\n\t\t\tappraisalDraftPct = (appraisalDraftCount * 100) / appraisalTotal;\n\t\t\tappraisalSubmittedPct = (appraisalSubmittedCount * 100) / appraisalTotal;\n\t\t\tappraisalManagerReviewedPct = (appraisalManagerReviewedCount * 100) / appraisalTotal;\n\t\t\tappraisalHrApprovedPct = (appraisalHrApprovedCount * 100) / appraisalTotal;\n\t\t}\n\t\tresignationApprovedRows = Resignation_Request[Status == &quot;Approved&quot; &amp;&amp; Effective_LWD != null];\n\t\toffboardingOverdueCount = 0;\n\t\toffboardingNextSevenCount = 0;\n\t\toffboardingNextThirtyCount = 0;\n\t\toffboardingFutureCount = 0;\n\t\tfor each  resignationSeed in resignationApprovedRows\n\t\t{\n\t\t\tif(resignationSeed.Effective_LWD &lt; todayDate)\n\t\t\t{\n\t\t\t\toffboardingOverdueCount = offboardingOverdueCount + 1;\n\t\t\t}\n\t\t\telse if(resignationSeed.Effective_LWD &lt;= sevenDayDate)\n\t\t\t{\n\t\t\t\toffboardingNextSevenCount = offboardingNextSevenCount + 1;\n\t\t\t}\n\t\t\telse if(resignationSeed.Effective_LWD &lt;= soonDate)\n\t\t\t{\n\t\t\t\toffboardingNextThirtyCount = offboardingNextThirtyCount + 1;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\toffboardingFutureCount = offboardingFutureCount + 1;\n\t\t\t}\n\t\t}\n\t\tpendingHROffboardingCount = Resignation_Request[Status == &quot;Pending_HR&quot;].count();\n\t\tprobationAlertRows = Employee_Master[Employment_Status == &quot;Probation&quot; &amp;&amp; Probation_End_Date != null &amp;&amp; Probation_End_Date &lt;= soonDate] sort by Probation_End_Date asc;\n\t\tprobationAlertCount = probationAlertRows.count();\n\t\texpiredCardRows = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto != null &amp;&amp; Valid_Upto &lt; todayDate] sort by Valid_Upto asc;\n\t\texpiringCardRows = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto != null &amp;&amp; Valid_Upto &gt;= todayDate &amp;&amp; Valid_Upto &lt;= soonDate] sort by Valid_Upto asc;\n\t\texpiredCardCount = expiredCardRows.count();\n\t\texpiringCardCount = expiringCardRows.count();\n\t\tidCardAlertCount = expiredCardCount + expiringCardCount;\n\t\tpendingHRReimbursementRows = Reimbursement_Request[Status == &quot;Pending_HR&quot;] sort by Expense_Date desc;\n\t\tpendingHRReimbursementCount = pendingHRReimbursementRows.count();\n\t\tpendingHRReimbursementAmount = 0;\n\t\tfor each  reimbursementSeed in pendingHRReimbursementRows\n\t\t{\n\t\t\tpendingHRReimbursementAmount = pendingHRReimbursementAmount + ifnull(reimbursementSeed.Amount_Claimed,0);\n\t\t}\n\t\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for HR_Admin_Dashboard (utility subset used by this page) ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-m-0 { margin: 0; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-w-full { width: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: layout-dashboard panel tiles */\n.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs-border-color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: all .2s ease; } .zcs-panel-icon-wrapper { width: 42px; height: 42px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #FDF5F3; color: #F4660C; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #F6F6FB; color: #5C66FF; } .zcs-panel:hover { border-color: var(--zcs-theme-brand-color); background-image: linear-gradient(rgb(253 253 255 / 10%), #F7F9FF); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: progress-bar-range-bar-with-text */\n.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F7); overflow: hidden; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n/* ZCS component CSS: button-primary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }\n.hrdash-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }\n.hr-dash-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }\n.hr-dash-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -120px; width: 320px; height: 320px; border-radius: 50%; border: 42px solid rgba(255,255,255,.12); }\n.hr-dash-hero:before { content: &quot;&quot;; position: absolute; right: 160px; bottom: -90px; width: 190px; height: 190px; border-radius: 50%; border: 28px solid rgba(255,255,255,.10); }\n.hr-dash-hero-content { position: relative; z-index: 1; }\n.hr-dash-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.hr-kpi { grid-column: span 3; } .hr-card-4 { grid-column: span 4; } .hr-card-5 { grid-column: span 5; } .hr-card-6 { grid-column: span 6; } .hr-card-7 { grid-column: span 7; } .hr-card-8 { grid-column: span 8; } .hr-card-12 { grid-column: span 12; }\n.hr-mini-stat { border: 1px solid var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; padding: 12px; }\n.hr-bar-row { display: grid; grid-template-columns: 132px 1fr 52px; gap: 10px; align-items: center; }\n.hr-segment { border-radius: 999px; background: #EEF2F7; height: 10px; overflow: hidden; }\n.hr-segment span { display: block; height: 100%; background: var(--zcs-theme-brand-color); border-radius: inherit; }\n.hr-status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }\n.hr-status-dot.green { background: #179E6C; } .hr-status-dot.yellow { background: #FAAE13; } .hr-status-dot.red { background: #FE455D; } .hr-status-dot.blue { background: #2A6FFC; } .hr-status-dot.orange { background: #F4660C; } .hr-status-dot.grey { background: #8B90A0; }\n.hr-list { list-style: none; margin: 0; padding: 0; } .hr-list li { border-top: 1px solid var(--zcs-border-color); padding: 12px 0; } .hr-list li:first-child { border-top: 0; padding-top: 0; }\n.hr-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }\n@media (max-width: 1100px) { .hr-kpi, .hr-card-4, .hr-card-5, .hr-card-6, .hr-card-7, .hr-card-8 { grid-column: span 6; } }\n@media (max-width: 700px) { .hrdash-page { padding: 14px; } .hr-kpi, .hr-card-4, .hr-card-5, .hr-card-6, .hr-card-7, .hr-card-8, .hr-card-12 { grid-column: span 12; } .hr-bar-row { grid-template-columns: 1fr; } }\n&lt;/style&gt;\n&lt;div class=&quot;hrdash-page zcs-flex zcs-direction-column zcs-gap-20&quot;&gt;\n\t&lt;div class=&quot;hr-dash-hero&quot;&gt;\n\t\t&lt;div class=&quot;hr-dash-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-badge zcs-badge-filled zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 zcs-font-medium zcs-lh-body&quot;&gt;Live HR operations&lt;/div&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10&quot;&gt;HR Admin Dashboard&lt;/h2&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-15 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-10&quot;&gt;Hello &lt;%=userName%&gt;. Operational snapshot as of &lt;%=todayDisplay%&gt;.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:All_Employees&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline users-single-02&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Employee list&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_Reimbursement_Queue&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;HR queue&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-panel-wrapper&quot;&gt;\n\t\t&lt;ul class=&quot;hr-dash-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t&lt;li class=&quot;hr-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline users-single-02&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=totalHeadcount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Active and probation headcount&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;hr-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=approvedJobCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Open approved job requests&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;hr-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=attendanceMarkedCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Attendance records today&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;hr-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=probationAlertCount + idCardAlertCount + pendingHRReimbursementCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;HR attention items&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;hr-dash-grid&quot;&gt;\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-7&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8&quot;&gt;\n\t\t\t\t&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Headcount by department&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-lh-body zcs-m-0&quot;&gt;Active and probation employees only&lt;/p&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12&quot;&gt;&lt;%=activeHeadcount%&gt; Active&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n&lt;%\n\t\tif(departmentRows.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;hr-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No department data&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tfor each  deptItem in departmentRows\n\t\t\t{\n\t\t\t\tdeptCount = Employee_Master[Department == deptItem.ID &amp;&amp; Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;].count();\n\t\t\t\tdeptPct = 0;\n\t\t\t\tif(maxDepartmentCount &gt; 0)\n\t\t\t\t{\n\t\t\t\t\tdeptPct = (deptCount * 100) / maxDepartmentCount;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;hr-bar-row&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-primary zcs-lh-body&quot;&gt;&lt;%=deptItem.Department_Name%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=deptPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;strong class=&quot;zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=deptCount%&gt;&lt;/strong&gt;\n\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-5&quot;&gt;\n\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Employment type mix&lt;/h3&gt;\n\t\t\t&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-lh-body zcs-m-0 zcs-mb-8&quot;&gt;Total includes Active and Probation statuses&lt;/p&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-mb-6&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;Full time&lt;/span&gt;&lt;strong&gt;&lt;%=fullTimeCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=fullTimePct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-mb-6&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;Contractor&lt;/span&gt;&lt;strong&gt;&lt;%=contractorCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=contractorPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-mb-6&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;Intern&lt;/span&gt;&lt;strong&gt;&lt;%=internCount%&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=internPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-8 zcs-row&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-badge-grey zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&quot;&gt;Inactive: &lt;%=inactiveHeadcount%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&quot;&gt;Probation: &lt;%=probationHeadcount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-4&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Approved job requests&lt;/h3&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Job_Request_List&quot;&gt;View report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Open approved requests&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;&lt;%=approvedJobCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Approved positions&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;&lt;%=approvedPositionCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;LinkedIn post pending&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-font-semibold zcs-m-0 zcs-color-primary&quot;&gt;&lt;%=linkedinPendingCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-8&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Recruitment pipeline&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-lh-body zcs-m-0&quot;&gt;Applications across lifecycle stages&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:Job_Application_History&quot;&gt;History&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot blue&quot;&gt;&lt;/i&gt; Active&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=activeAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationActiveCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot yellow&quot;&gt;&lt;/i&gt; On hold&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=holdAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationOnHoldCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot orange&quot;&gt;&lt;/i&gt; Selected&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=selectedAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationSelectedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot green&quot;&gt;&lt;/i&gt; Offer accepted&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=offerAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationOfferAcceptedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot green&quot;&gt;&lt;/i&gt; Joined&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=joinedAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationJoinedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot red&quot;&gt;&lt;/i&gt; Rejected&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=rejectedAppPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=applicationRejectedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Attendance today&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-lh-body zcs-m-0&quot;&gt;&lt;%=todayDisplay%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-badge-theme zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&quot;&gt;&lt;%=attendanceCompletionPct%&gt;% marked&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Count&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;i class=&quot;hr-status-dot green&quot;&gt;&lt;/i&gt; Present&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=presentTodayCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;i class=&quot;hr-status-dot blue&quot;&gt;&lt;/i&gt; WFH or On Duty&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=wfhTodayCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;i class=&quot;hr-status-dot yellow&quot;&gt;&lt;/i&gt; Leave or Half Day&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=leaveTodayCount + halfDayTodayCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;i class=&quot;hr-status-dot red&quot;&gt;&lt;/i&gt; Absent&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=absentTodayCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8&quot;&gt;&lt;i class=&quot;hr-status-dot grey&quot;&gt;&lt;/i&gt; Not marked or no log&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right&quot;&gt;&lt;%=notMarkedTodayCount + noAttendanceLogCount%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Appraisal pipeline&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-lh-body zcs-m-0&quot;&gt;HR sign-off completion: &lt;%=appraisalCompletionPct%&gt;%&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_All_Appraisals&quot;&gt;View all&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot grey&quot;&gt;&lt;/i&gt; Draft&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=appraisalDraftPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=appraisalDraftCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot blue&quot;&gt;&lt;/i&gt; Submitted&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=appraisalSubmittedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=appraisalSubmittedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot yellow&quot;&gt;&lt;/i&gt; Manager reviewed&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=appraisalManagerReviewedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=appraisalManagerReviewedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-bar-row&quot;&gt;&lt;span&gt;&lt;i class=&quot;hr-status-dot green&quot;&gt;&lt;/i&gt; HR approved&lt;/span&gt;&lt;div class=&quot;hr-segment&quot;&gt;&lt;span style=&quot;width:&lt;%=appraisalHrApprovedPct%&gt;%;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;strong class=&quot;zcs-text-right&quot;&gt;&lt;%=appraisalHrApprovedCount%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Offboarding by effective LWD&lt;/h3&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_Offboarding_Dashboard&quot;&gt;Dashboard report&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-row zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 130px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Overdue&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-red&quot;&gt;&lt;%=offboardingOverdueCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 130px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Next 7 days&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-yellow&quot;&gt;&lt;%=offboardingNextSevenCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 130px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Next 30 days&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-blue&quot;&gt;&lt;%=offboardingNextThirtyCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 130px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Pending HR approval&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-primary&quot;&gt;&lt;%=pendingHROffboardingCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Pending HR reimbursements&lt;/h3&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_Reimbursement_Queue&quot;&gt;Open queue&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-row zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 180px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Requests awaiting HR&lt;/span&gt;&lt;h4 class=&quot;zcs-font-28 zcs-m-0 zcs-color-primary&quot;&gt;&lt;%=pendingHRReimbursementCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 180px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Amount claimed&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-primary&quot;&gt;INR &lt;%=pendingHRReimbursementAmount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(pendingHRReimbursementCount &gt; 0)\n\t\t{\n\t\t\tshownReimbursements = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;hr-list zcs-mt-10&quot;&gt;\n&lt;%\n\t\t\tfor each  reimbursementItem in pendingHRReimbursementRows\n\t\t\t{\n\t\t\t\tif(shownReimbursements &lt; 4)\n\t\t\t\t{\n\t\t\t\t\temployeeText = &quot;-&quot;;\n\t\t\t\t\tif(reimbursementItem.Employee != null)\n\t\t\t\t\t{\n\t\t\t\t\t\temployeeText = ifnull(reimbursementItem.Employee.Full_Name,&quot;-&quot;);\n\t\t\t\t\t}\n\t\t\t\t\texpenseDateText = &quot;-&quot;;\n\t\t\t\t\tif(reimbursementItem.Expense_Date != null)\n\t\t\t\t\t{\n\t\t\t\t\t\texpenseDateText = reimbursementItem.Expense_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div&gt;&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=employeeText%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(reimbursementItem.Category,&quot;-&quot;)%&gt; | &lt;%=expenseDateText%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-14 zcs-font-semibold&quot;&gt;INR &lt;%=ifnull(reimbursementItem.Amount_Claimed,0)%&gt;&lt;/span&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownReimbursements = shownReimbursements + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Probation alerts&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0&quot;&gt;Ending on or before &lt;%=soonDate.toString(&quot;dd-MMM-yyyy&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-font-12&quot;&gt;&lt;%=probationAlertCount%&gt; alerts&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\tif(probationAlertCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;hr-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No probation alerts&lt;/h5&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownProbation = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;hr-list&quot;&gt;\n&lt;%\n\t\t\tfor each  probationItem in probationAlertRows\n\t\t\t{\n\t\t\t\tif(shownProbation &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tprobationDateText = probationItem.Probation_End_Date.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div&gt;&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=probationItem.Full_Name%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(probationItem.Department.Department_Name,&quot;-&quot;)%&gt; | &lt;%=ifnull(probationItem.Designation,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-yellow&quot;&gt;&lt;%=probationDateText%&gt;&lt;/span&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownProbation = shownProbation + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\n\t\t&lt;section class=&quot;zcs-card zcs-p-20 zcs-box-border hr-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center zcs-mb-8&quot;&gt;&lt;div&gt;&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;ID card expiry alerts&lt;/h3&gt;&lt;p class=&quot;zcs-font-13 zcs-color-tertiary zcs-m-0&quot;&gt;Expired or expiring in 30 days&lt;/p&gt;&lt;/div&gt;&lt;a class=&quot;zcs-font-13 zcs-color-theme&quot; href=&quot;#Report:HR_ID_Card_Management&quot;&gt;Manage cards&lt;/a&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-row zcs-gap-12 zcs-mb-8&quot;&gt;&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 150px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Expired&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-red&quot;&gt;&lt;%=expiredCardCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;div class=&quot;hr-mini-stat&quot; style=&quot;flex:1 1 150px;&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Expiring soon&lt;/span&gt;&lt;h4 class=&quot;zcs-font-24 zcs-m-0 zcs-color-yellow&quot;&gt;&lt;%=expiringCardCount%&gt;&lt;/h4&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\tif(idCardAlertCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;hr-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;No ID card expiry alerts&lt;/h5&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tshownCards = 0;\n\t\t\t%&gt;\n&lt;ul class=&quot;hr-list&quot;&gt;\n&lt;%\n\t\t\tfor each  cardItem in expiredCardRows\n\t\t\t{\n\t\t\t\tif(shownCards &lt; 3)\n\t\t\t\t{\n\t\t\t\t\tcardDateText = cardItem.Valid_Upto.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div&gt;&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cardItem.Recipient_Name,&quot;-&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(cardItem.Requester_Type,&quot;-&quot;)%&gt; | &lt;%=ifnull(cardItem.Extension_ID_Number,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-red&quot;&gt;&lt;%=cardDateText%&gt;&lt;/span&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownCards = shownCards + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor each  cardSoonItem in expiringCardRows\n\t\t\t{\n\t\t\t\tif(shownCards &lt; 6)\n\t\t\t\t{\n\t\t\t\t\tcardSoonDateText = cardSoonItem.Valid_Upto.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;div&gt;&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(cardSoonItem.Recipient_Name,&quot;-&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(cardSoonItem.Requester_Type,&quot;-&quot;)%&gt; | &lt;%=ifnull(cardSoonItem.Extension_ID_Number,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-yellow&quot;&gt;&lt;%=cardSoonDateText%&gt;&lt;/span&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t\tshownCards = shownCards + 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t%&gt;\n&lt;/ul&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/section&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-white-color: #FFFFFF; }\n.hrdash-page { padding: 22px; background: #F5F7FB; font-family: Lato, Arial, sans-serif; }\n.zcs-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; padding: 24px; text-align: center; }\n.zcs-font-18 { font-size: 1.125rem; } .zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n&lt;/style&gt;\n&lt;div class=&quot;hrdash-page&quot;&gt;\n\t&lt;div class=&quot;zcs-card&quot;&gt;\n\t\t&lt;i class=&quot;zc-li-outline ui-1-lock&quot; style=&quot;font-size:28px;color:var(--zcs-theme-brand-color);&quot;&gt;&lt;/i&gt;\n\t\t&lt;h3 class=&quot;zcs-font-18 zcs-color-primary&quot;&gt;Restricted dashboard&lt;/h3&gt;\n\t\t&lt;p class=&quot;zcs-color-tertiary&quot;&gt;This HR operational dashboard is available to HR_ADMIN and Administrator users.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Headcount_Directory_Report' title='Headcount Directory' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='All_Employees' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Approved_Job_Requests_Report' title='Open Approved Job Requests' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Job_Request_List' criteriaString='Status == &quot;Approved&quot;' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='340' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Recruitment_Pipeline_Report' title='Recruitment Pipeline History' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Job_Application_History' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Attendance_Today_Report' title='Attendance Today' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='Attendance_Log_Admin' criteriaString='Attendance_Date == zoho.currentdate' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Appraisal_Pipeline_Report' title='Appraisal Pipeline' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_All_Appraisals' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Offboarding_Pipeline_Report' title='Offboarding Pipeline by Effective LWD' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_Offboarding_Dashboard' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='ID_Card_Management_Report' title='ID Card Management and Expiry Queue' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_ID_Card_Management' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='380' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='Pending_HR_Reimbursements_Report' title='Pending HR Reimbursements' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_Reimbursement_Queue' criteriaString='Status == &quot;Pending_HR&quot;' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='360' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page ID_Card_Home
		{
					displayname = "ID Card Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ID_Card_Home_Snippet' elementName='ID_Card_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage ID_Card_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || isAdmin;\n\tisASPIRE = loginRole == &quot;ASPIRE_ADMIN&quot; || isAdmin;\n\tisPrivileged = isHR || isASPIRE;\n\tuserName = ifnull(zoho.loginuser,&quot;Employee&quot;);\n\tuserSubtitle = &quot;Internal employee workspace&quot;;\n\temployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(employeeRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(employeeRows.Full_Name,userName);\n\t\tuserSubtitle = ifnull(employeeRows.Designation,&quot;Internal employee workspace&quot;);\n\t}\n\ttodayDate = zoho.currentdate;\n\tsoonDate = todayDate.addDay(30);\n\tmyRequestsCount = ID_Card_Request[Employee_Requester.Official_Email == loginEmail || Employee_Requester.Official_Email == zoho.loginuser].count();\n\tsubmittedCount = ID_Card_Request[Status == &quot;Submitted&quot;].count();\n\tgeneratedCount = ID_Card_Request[Status == &quot;Card_Generated&quot;].count();\n\tactiveCardsCount = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto &gt;= todayDate].count();\n\texpiringCount = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto != null &amp;&amp; Valid_Upto &lt;= soonDate &amp;&amp; Valid_Upto &gt;= todayDate].count();\n\tactiveMembersCount = Member_Master[Is_Active == true].count();\n\trequestFormUrl = &quot;#Form:ID_Card_Request?zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;Requester_Type=Employee&amp;amp;Request_Type=New&quot;;\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css utility subset included once for ID_Card_Home ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-sticky { position: sticky; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #b8770d; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions, button-primary-button, button-secondary-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0px; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n/* ID Card Home layout */\n.idh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.idh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }\n.idh-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.idh-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.idh-hero-content { position: relative; z-index: 1; }\n.idh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.idh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.idh-kpi { grid-column: span 3; min-height: 120px; }\n.idh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.idh-workspace { grid-column: span 9; }\n.idh-side { grid-column: span 3; }\n.idh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.idh-tabs-shell { overflow: hidden; }\n.idh-tab-input { display: none; }\n.idh-tabbar { overflow-x: auto; }\n.idh-tabbar label { cursor: pointer; }\n.idh-panel { display: none; padding: 18px; }\n#idh-tab-my:checked ~ .idh-tabbar label[for=&apos;idh-tab-my&apos;], #idh-tab-manage:checked ~ .idh-tabbar label[for=&apos;idh-tab-manage&apos;], #idh-tab-kanban:checked ~ .idh-tabbar label[for=&apos;idh-tab-kanban&apos;], #idh-tab-members:checked ~ .idh-tabbar label[for=&apos;idh-tab-members&apos;], #idh-tab-print:checked ~ .idh-tabbar label[for=&apos;idh-tab-print&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#idh-tab-my:checked ~ .idh-panels .idh-panel-my, #idh-tab-manage:checked ~ .idh-panels .idh-panel-manage, #idh-tab-kanban:checked ~ .idh-panels .idh-panel-kanban, #idh-tab-members:checked ~ .idh-panels .idh-panel-members, #idh-tab-print:checked ~ .idh-panels .idh-panel-print { display: block; }\n.idh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); }\n.idh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.idh-report-frame { min-height: 650px; }\n.idh-access-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n.idh-print-card { border: 1px solid var(--zcs-border-color); border-radius: 12px; background: #FFFFFF; }\n.idh-quick-action-item { list-style-type: none; }\n.idh-quick-action-item.zcs-card:hover { border-color: var(--zcs-theme-brand-color); }\n.idh-quick-action-item:hover .idh-quick-action-link { color: var(--zcs-theme-brand-color); }\n@media (max-width: 1100px) { .idh-kpi { grid-column: span 6; } .idh-workspace, .idh-side { grid-column: span 12; } }\n@media (max-width: 680px) { .idh-page { padding: 14px; } .idh-kpi { grid-column: span 12; } .idh-hero { padding: 18px; } .idh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .idh-panel { padding: 12px; } .idh-report-frame { min-height: 540px; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;idh-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;ID Card Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Internal employee ID card requests and ASPIRE/admin review workspace&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_ID_Card_Requests?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;My Requests&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=requestFormUrl%&gt;&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Request ID Card&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;idh-hero zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;idh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;Signed in as &lt;%=userName%&gt;&lt;/span&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;ID card workspace&lt;/h2&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-15&quot;&gt;&lt;%=userSubtitle%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Employee flow&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\tif(isHR)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;HR review&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t}\n\tif(isASPIRE)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;ASPIRE admin&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;div class=&quot;idh-grid&quot;&gt;\n\t\t&lt;div class=&quot;idh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;idh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;My requests&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;idh-kpi-value zcs-color-primary&quot;&gt;&lt;%=myRequestsCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Requests tied to your employee record&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;idh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;idh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-4-restore zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Submitted&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;idh-kpi-value zcs-color-primary&quot;&gt;&lt;%=submittedCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Awaiting extension ID update or card generation&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;idh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;idh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-print zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Print ready&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;idh-kpi-value zcs-color-primary&quot;&gt;&lt;%=generatedCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Cards generated and ready for ID_Card_Layout&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;idh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12&quot;&gt;&lt;div class=&quot;idh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-13 zcs-color-tertiary&quot;&gt;Active cards&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;idh-kpi-value zcs-color-primary&quot;&gt;&lt;%=activeCardsCount%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=expiringCount%&gt; expiring within 30 days&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;idh-workspace idh-tabs-shell zcs-card