	pages
	{
		page ASPIRE_Admin_Dashboard
		{
					displayname = "ASPIRE Admin Dashboard"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ASPIRE_Admin_Dashboard_Snippet' elementName='ASPIRE_Admin_Dashboard_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage ASPIRE_Admin_Dashboard_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAllowed = loginRole == &quot;ASPIRE_ADMIN&quot; || loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\tsoonDate = todayDate.addDay(30);\n\tcurrentMonthToken = todayDate.toString(&quot;yyyy-MM&quot;);\n\tuserName = ifnull(zoho.loginuser,&quot;ASPIRE Admin&quot;);\n\temployeeUserRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(employeeUserRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(employeeUserRows.Full_Name,userName);\n\t}\n\tif(isAllowed == true)\n\t{\n\t\tsubmittedNewRows = ID_Card_Request[Status == &quot;Submitted&quot; &amp;&amp; Request_Type == &quot;New&quot;] sort by ID desc;\n\t\textensionPendingRows = ID_Card_Request[Status == &quot;Submitted&quot; &amp;&amp; Extension_ID_Number == null || Extension_ID_Number == &quot;&quot;] sort by ID desc;\n\t\treadyToProcessRows = ID_Card_Request[Status == &quot;Extension_ID_Updated&quot;] sort by ID desc;\n\t\tcardGeneratedRows = ID_Card_Request[Status == &quot;Card_Generated&quot;] sort by ID desc;\n\t\texpiringSoonRows = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto != null &amp;&amp; Valid_Upto &gt;= todayDate &amp;&amp; Valid_Upto &lt;= soonDate] sort by Valid_Upto asc;\n\t\texpiredRows = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Valid_Upto != null &amp;&amp; Valid_Upto &lt; todayDate] sort by Valid_Upto asc;\n\t\tsubmittedNewCount = submittedNewRows.count();\n\t\textensionPendingCount = extensionPendingRows.count();\n\t\treadyToProcessCount = readyToProcessRows.count();\n\t\tcardGeneratedCount = cardGeneratedRows.count();\n\t\texpiringSoonCount = expiringSoonRows.count();\n\t\texpiredCount = expiredRows.count();\n\t\tissuedThisMonthCount = 0;\n\t\tissuedThisMonthRows = ID_Card_Request[Status == &quot;Received&quot; &amp;&amp; Received_Date != null] sort by Received_Date desc;\n\t\tfor each  issuedSeed in issuedThisMonthRows\n\t\t{\n\t\t\tif(issuedSeed.Received_Date.toString(&quot;yyyy-MM&quot;) == currentMonthToken)\n\t\t\t{\n\t\t\t\tissuedThisMonthCount = issuedThisMonthCount + 1;\n\t\t\t}\n\t\t}\n\t\ttotalOpenQueue = submittedNewCount + readyToProcessCount + cardGeneratedCount;\n\t\texpiringWindowLabel = todayDisplay + &quot; to &quot; + soonDate.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css included once for ASPIRE_Admin_Dashboard (utility subset used by this page) ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-6 { margin-top: .375rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: layout-dashboard panel tiles */\n.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs-border-color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: all .2s ease; } .zcs-panel-icon-wrapper { width: 42px; height: 42px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #FDF5F3; color: #F4660C; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #F6F6FB; color: #5C66FF; } .zcs-panel:hover { border-color: var(--zcs-theme-brand-color); background-image: linear-gradient(rgb(253 253 255 / 10%), #F7F9FF); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n/* ZCS component CSS: button-primary-button and header-heading-with-actions button area */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }\n.aspire-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }\n.aspire-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }\n.aspire-hero:after { content: &quot;&quot;; position: absolute; right: -88px; top: -112px; width: 312px; height: 312px; border-radius: 50%; border: 42px solid rgba(255,255,255,.12); }\n.aspire-hero:before { content: &quot;&quot;; position: absolute; right: 170px; bottom: -88px; width: 190px; height: 190px; border-radius: 50%; border: 28px solid rgba(255,255,255,.10); }\n.aspire-hero-content { position: relative; z-index: 1; }\n.aspire-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.aspire-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.aspire-kpi { grid-column: span 2; } .aspire-card-4 { grid-column: span 4; } .aspire-card-5 { grid-column: span 5; } .aspire-card-6 { grid-column: span 6; } .aspire-card-7 { grid-column: span 7; } .aspire-card-12 { grid-column: span 12; }\n.aspire-list { list-style: none; margin: 0; padding: 0; } .aspire-list li { border-top: 1px solid var(--zcs-border-color); padding: 12px 0; } .aspire-list li:first-child { border-top: 0; padding-top: 0; }\n.aspire-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }\n.aspire-action-link { color: var(--zcs-theme-brand-color); font-weight: 600; }\n.aspire-status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; } .aspire-status-dot.green { background: #179E6C; } .aspire-status-dot.yellow { background: #FAAE13; } .aspire-status-dot.red { background: #FE455D; } .aspire-status-dot.blue { background: #2A6FFC; } .aspire-status-dot.orange { background: #F4660C; }\n@media (max-width: 1180px) { .aspire-kpi { grid-column: span 4; } .aspire-card-4, .aspire-card-5, .aspire-card-6, .aspire-card-7 { grid-column: span 12; } }\n@media (max-width: 760px) { .aspire-page { padding: 14px; } .aspire-hero-content { flex-direction: column; align-items: flex-start; } .aspire-hero .zcs-flex.zcs-gap-10 { flex-wrap: wrap; } .aspire-kpi, .aspire-card-4, .aspire-card-5, .aspire-card-6, .aspire-card-7, .aspire-card-12 { grid-column: span 12; } }\n&lt;/style&gt;\n&lt;div class=&quot;aspire-page zcs-flex zcs-direction-column zcs-gap-20&quot;&gt;\n\t&lt;div class=&quot;aspire-hero&quot;&gt;\n\t\t&lt;div class=&quot;aspire-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-badge zcs-badge-filled zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 zcs-font-medium zcs-lh-body&quot;&gt;Live ID card operations&lt;/div&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10&quot;&gt;ASPIRE Admin Dashboard&lt;/h2&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-15 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-10&quot;&gt;Hello &lt;%=userName%&gt;. Request and expiry queues as of &lt;%=todayDisplay%&gt;.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_ID_Card_Management&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;HR ID card management&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:ID_Card_Request?zc_LoadIn=dialog&amp;amp;zc_Header=true&quot;&gt;\n\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;New request&lt;/span&gt;\n\t\t\t\t&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;zcs-panel-wrapper&quot;&gt;\n\t\t&lt;ul class=&quot;aspire-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=submittedNewCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Submitted new requests&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=extensionPendingCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Extension ID pending&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=readyToProcessCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Extension_ID_Updated ready&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=issuedThisMonthCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Cards issued this month&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=expiringSoonCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Expiring in 30 days&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t\t&lt;li class=&quot;aspire-kpi&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;div class=&quot;zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg&quot;&gt;&lt;i class=&quot;zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;h4 class=&quot;zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=expiredCount%&gt;&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0&quot;&gt;Expired received cards&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/li&gt;\n\t\t&lt;/ul&gt;\n\t&lt;/div&gt;\n\n\t&lt;ul class=&quot;aspire-grid zcs-p-0 zcs-m-0&quot;&gt;\n\t\t&lt;li class=&quot;aspire-card-4&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Processing flow&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6&quot;&gt;Open queue count: &lt;%=totalOpenQueue%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:HR_ID_Card_Management&quot;&gt;\n\t\t\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open queue&lt;/span&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&quot;aspire-list&quot;&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;span class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;aspire-status-dot yellow&quot;&gt;&lt;/span&gt;Submitted&lt;/span&gt;&lt;strong class=&quot;zcs-font-16 zcs-color-primary&quot;&gt;&lt;%=submittedNewCount%&gt;&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;span class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;aspire-status-dot blue&quot;&gt;&lt;/span&gt;Extension_ID_Updated&lt;/span&gt;&lt;strong class=&quot;zcs-font-16 zcs-color-primary&quot;&gt;&lt;%=readyToProcessCount%&gt;&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;span class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;aspire-status-dot green&quot;&gt;&lt;/span&gt;Card_Generated awaiting receipt&lt;/span&gt;&lt;strong class=&quot;zcs-font-16 zcs-color-primary&quot;&gt;&lt;%=cardGeneratedCount%&gt;&lt;/strong&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;&lt;span class=&quot;zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;aspire-status-dot orange&quot;&gt;&lt;/span&gt;Expiring window&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=expiringWindowLabel%&gt;&lt;/span&gt;&lt;/li&gt;\n\t\t\t\t&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/li&gt;\n\n\t\t&lt;li class=&quot;aspire-card-8&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Submitted new requests&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6&quot;&gt;Update the extension ID, then move requests through card generation and receipt.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;&lt;%=submittedNewCount%&gt; pending&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Recipient&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Requester&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tsubmittedShown = 0;\n\t\tfor each  submittedRow in submittedNewRows\n\t\t{\n\t\t\tif(submittedShown &lt; 6)\n\t\t\t{\n\t\t\t\tsubmittedRecipient = ifnull(submittedRow.Recipient_Name,&quot;Not specified&quot;);\n\t\t\t\tif(submittedRecipient == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tsubmittedRecipient = &quot;Not specified&quot;;\n\t\t\t\t}\n\t\t\t\tsubmittedRequester = &quot;-&quot;;\n\t\t\t\tif(submittedRow.Requester_Type == &quot;Employee&quot; &amp;&amp; submittedRow.Employee_Requester != null)\n\t\t\t\t{\n\t\t\t\t\tsubmittedRequester = ifnull(submittedRow.Employee_Requester.Full_Name,&quot;-&quot;);\n\t\t\t\t}\n\t\t\t\telse if(submittedRow.Requester_Type == &quot;Member&quot; &amp;&amp; submittedRow.Member_Requester != null)\n\t\t\t\t{\n\t\t\t\t\tsubmittedRequester = ifnull(submittedRow.Member_Requester.Member_Name,&quot;-&quot;);\n\t\t\t\t}\n\t\t\t\tlayoutUrl = &quot;#Page:ID_Card_Layout?id_card_request_id=&quot; + submittedRow.ID;\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=submittedRecipient%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=submittedRow.Requester_Type%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=submittedRequester%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14&quot;&gt;&lt;a class=&quot;aspire-action-link&quot; href=&quot;&lt;%=layoutUrl%&gt;&quot;&gt;Open layout&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\tsubmittedShown = submittedShown + 1;\n\t\t\t}\n\t\t}\n\t\tif(submittedShown == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot;&gt;No submitted new requests.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/li&gt;\n\n\t\t&lt;li class=&quot;aspire-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Extension ID pending&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6&quot;&gt;Submitted records without an extension ID number.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;&lt;%=extensionPendingCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;ul class=&quot;aspire-list&quot;&gt;\n&lt;%\n\t\tpendingShown = 0;\n\t\tfor each  pendingRow in extensionPendingRows\n\t\t{\n\t\t\tif(pendingShown &lt; 6)\n\t\t\t{\n\t\t\t\tpendingRecipient = ifnull(pendingRow.Recipient_Name,&quot;Not specified&quot;);\n\t\t\t\tif(pendingRecipient == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tpendingRecipient = &quot;Not specified&quot;;\n\t\t\t\t}\n\t\t\t\tpendingLayoutUrl = &quot;#Page:ID_Card_Layout?id_card_request_id=&quot; + pendingRow.ID;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-col-common zcs-flex zcs-direction-column zcs-gap-4&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;&lt;%=pendingRecipient%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-font-normal zcs-color-tertiary&quot;&gt;&lt;%=pendingRow.Requester_Type%&gt; request, &lt;%=pendingRow.Request_Type%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;aspire-action-link zcs-font-13&quot; href=&quot;#Report:HR_ID_Card_Management&quot;&gt;Manage&lt;/a&gt;\n\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t\t\tpendingShown = pendingShown + 1;\n\t\t\t}\n\t\t}\n\t\tif(pendingShown == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;li&gt;&lt;div class=&quot;aspire-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-16 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-font-14 zcs-color-tertiary&quot;&gt;No extension ID pending records.&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/li&gt;\n\n\t\t&lt;li class=&quot;aspire-card-6&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Extension_ID_Updated ready to process&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6&quot;&gt;Ready for card generation or downstream processing.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;&lt;%=readyToProcessCount%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Recipient&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Extension ID&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Printable layout&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\treadyShown = 0;\n\t\tfor each  readyRow in readyToProcessRows\n\t\t{\n\t\t\tif(readyShown &lt; 6)\n\t\t\t{\n\t\t\t\treadyRecipient = ifnull(readyRow.Recipient_Name,&quot;Not specified&quot;);\n\t\t\t\tif(readyRecipient == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\treadyRecipient = &quot;Not specified&quot;;\n\t\t\t\t}\n\t\t\t\treadyExtension = ifnull(readyRow.Extension_ID_Number,&quot;-&quot;);\n\t\t\t\treadyLayoutUrl = &quot;#Page:ID_Card_Layout?id_card_request_id=&quot; + readyRow.ID;\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=readyRecipient%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=readyExtension%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;a class=&quot;aspire-action-link&quot; href=&quot;&lt;%=readyLayoutUrl%&gt;&quot;&gt;Open ID_Card_Layout&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\treadyShown = readyShown + 1;\n\t\t\t}\n\t\t}\n\t\tif(readyShown == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;3&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot;&gt;No Extension_ID_Updated records are waiting.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/li&gt;\n\n\t\t&lt;li class=&quot;aspire-card-12&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Expiring soon list&lt;/h3&gt;\n\t\t\t\t\t\t&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6&quot;&gt;Received ID cards expiring within the next 30 days.&lt;/p&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;&lt;%=expiringSoonCount%&gt; expiring&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Recipient&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Extension ID&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Valid upto&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Requester type&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\texpiringShown = 0;\n\t\tfor each  expiringRow in expiringSoonRows\n\t\t{\n\t\t\tif(expiringShown &lt; 10)\n\t\t\t{\n\t\t\t\texpiringRecipient = ifnull(expiringRow.Recipient_Name,&quot;Not specified&quot;);\n\t\t\t\tif(expiringRecipient == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\texpiringRecipient = &quot;Not specified&quot;;\n\t\t\t\t}\n\t\t\t\texpiringExtension = ifnull(expiringRow.Extension_ID_Number,&quot;-&quot;);\n\t\t\t\texpiringDate = &quot;-&quot;;\n\t\t\t\tif(expiringRow.Valid_Upto != null)\n\t\t\t\t{\n\t\t\t\t\texpiringDate = expiringRow.Valid_Upto.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\t\t}\n\t\t\t\texpiringLayoutUrl = &quot;#Page:ID_Card_Layout?id_card_request_id=&quot; + expiringRow.ID;\n\t\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=expiringRecipient%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=expiringExtension%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-red&quot;&gt;&lt;%=expiringDate%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=expiringRow.Requester_Type%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;a class=&quot;aspire-action-link&quot; href=&quot;&lt;%=expiringLayoutUrl%&gt;&quot;&gt;Review layout&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t\t\texpiringShown = expiringShown + 1;\n\t\t\t}\n\t\t}\n\t\tif(expiringShown == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary&quot;&gt;No received ID cards are expiring within 30 days.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/li&gt;\n\t&lt;/ul&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;style&gt;\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-white-color: #FFFFFF; }\n.aspire-denied { min-height: 360px; display: flex; align-items: center; justify-content: center; background: #F5F7FB; padding: 24px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }\n.aspire-denied-card { max-width: 560px; width: 100%; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; padding: 28px; text-align: center; box-shadow: 0 8px 24px rgba(18,19,43,.05); }\n.aspire-denied-icon { color: var(--zcs-theme-brand-color); font-size: 34px; }\n&lt;/style&gt;\n&lt;div class=&quot;aspire-denied&quot;&gt;\n\t&lt;div class=&quot;aspire-denied-card&quot;&gt;\n\t\t&lt;i class=&quot;aspire-denied-icon zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt;\n\t\t&lt;h3&gt;Access restricted&lt;/h3&gt;\n\t\t&lt;p&gt;This dashboard is available to ASPIRE_ADMIN and Administrator profiles.&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<report elementName='HR_ID_Card_Management_Report' title='HR ID Card Management' boldTitle='true' titleColor='#222326' appLinkName='thisapp' linkName='HR_ID_Card_Management' iszreport='false' zc_AddRec='false' zc_Print='false' zc_DelRec='false' zc_DuplRec='false' zc_EditBulkRec='false' zc_BulkDelete='false' zc_BulkDuplicate='false' heightType='custom' heightValue='420' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Attendance_Leave_Home(string Section)
		{
					displayname = "Attendance and Leave Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Attendance_Leave_Home_Snippet' elementName='Attendance_Leave_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Attendance_Leave_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tsection = ifnull(input.Section,&quot;Portal&quot;);\n\tif(section == &quot;&quot;)\n\t{\n\t\tsection = &quot;Portal&quot;;\n\t}\n\tif(section != &quot;Portal&quot; &amp;&amp; section != &quot;My&quot; &amp;&amp; section != &quot;Manager&quot; &amp;&amp; section != &quot;HR&quot; &amp;&amp; section != &quot;ChildRows&quot; &amp;&amp; section != &quot;Kanbans&quot;)\n\t{\n\t\tsection = &quot;Portal&quot;;\n\t}\n\ttargetUrl = &quot;#Page:Employee_Attendance_Portal?zc_LoadIn=embed-attendanceHomeFrame&quot;;\n\tif(section == &quot;My&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:My_Time_Off_Requests?zc_LoadIn=embed-attendanceHomeFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Manager&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Pending_Time_Off_Requests_Manager?zc_LoadIn=embed-attendanceHomeFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;HR&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:HR_All_Time_Off_Requests?zc_LoadIn=embed-attendanceHomeFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;ChildRows&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Comp_Off_Awards_Used_List?zc_LoadIn=embed-attendanceHomeFrame&amp;zc_Header=true&quot;;\n\t}\n\telse if(section == &quot;Kanbans&quot;)\n\t{\n\t\ttargetUrl = &quot;#Report:Time_Off_Status_Kanban?zc_LoadIn=embed-attendanceHomeFrame&amp;zc_Header=true&quot;;\n\t}\n\topenUrl(targetUrl,&quot;same window&quot;);\n\ttodayDate = zoho.currentdate;\n\ttodayDisplay = todayDate.toString(&quot;dd-MMM-yyyy&quot;);\n\temployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\thasEmployee = employeeRows.count() &gt; 0;\n\temployeeName = &quot;Employee&quot;;\n\temployeeInitial = &quot;E&quot;;\n\temployeeMeta = loginEmail;\n\tmyOpenTimeOff = 0;\n\tmyOpenRegularisation = 0;\n\tmyBalanceRows = 0;\n\tif(hasEmployee == true)\n\t{\n\t\temp = employeeRows;\n\t\temployeeName = ifnull(emp.Full_Name,&quot;Employee&quot;);\n\t\tif(employeeName != &quot;&quot;)\n\t\t{\n\t\t\temployeeInitial = employeeName.left(1);\n\t\t}\n\t\temployeeMeta = ifnull(emp.Designation,&quot;Employee&quot;) + &quot; \u00B7 &quot; + ifnull(emp.Department,&quot;-&quot;);\n\t\tmyOpenTimeOff = Time_Off_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;].count();\n\t\tmyOpenRegularisation = Regularisation_Request[Employee == emp.ID &amp;&amp; Status == &quot;Pending_Manager&quot; || Status == &quot;Pending_HR&quot;].count();\n\t\tmyBalanceRows = Leave_Balance[Employee == emp.ID].count();\n\t}\n\tpresentToday = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Present&quot;].count();\n\tnotMarkedToday = Attendance_Log[Attendance_Date == todayDate &amp;&amp; Attendance_Status == &quot;Not_Marked&quot;].count();\n\tmanagerLeaveQueue = Time_Off_Request[Status == &quot;Pending_Manager&quot;].count();\n\tmanagerRegularisationQueue = Regularisation_Request[Status == &quot;Pending_Manager&quot;].count();\n\thrLeaveQueue = Time_Off_Request[Status == &quot;Pending_HR&quot;].count();\n\thrRegularisationQueue = Regularisation_Request[Status == &quot;Pending_HR&quot;].count();\n\tcompOffAwardsCount = Comp_Off_Award[ID != 0].count();\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility sheet subset for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-page-bg-color:#F3F3F4;--zcs-white-color:#FFFFFF;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}\n.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-center{align-items:center}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-14{padding-left:.875rem;padding-right:.875rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-14{padding-top:.875rem;padding-bottom:.875rem}.zcs-py-20{padding-top:1.25rem;padding-bottom:1.25rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.81