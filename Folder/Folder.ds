			Appraisal_Basic_Questions_On_Validate as "Appraisal Basic Questions - On Validate"
			{
			
							type =  form
							form = Appraisal_Basic_Questions
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(ifnull(input.Question_Order,0) <= 0)
													{
														alert "Question order must be greater than zero.";
														cancel submit;
													}
													duplicateQuestions = Appraisal_Basic_Questions[Appraisal_Config == input.Appraisal_Config && Question_Order == input.Question_Order && ID != input.ID];
													if(duplicateQuestions.count() > 0)
													{
														alert "Question order must be unique within the appraisal cycle.";
														cancel submit;
													}
													parentCycles = Appraisal_Config[ID == input.Appraisal_Config];
													if(parentCycles.count() > 0 && parentCycles.Is_Active == true)
													{
														alert "Questions can be changed only while the appraisal cycle is inactive.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Appraisal_Config_On_Success as "Appraisal Config - On Success"
			{
			
							type =  form
							form = Appraisal_Config
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Is_Active == true)
													{
														tokenMap = Map();
														tokenMap.put("appraisal_year",input.Appraisal_Year);
														tokenMap.put("window_start",input.Window_Start);
														tokenMap.put("window_end",input.Window_End);
														thisapp.Add_Audit_Log("APPRAISAL_CONFIG_ACTIVE","Performance","Appraisal_Config",input.ID,"Activated","","Active","Appraisal cycle activated.",true,"");
														thisapp.Send_Configured_Notification("APPRAISAL_CONFIG_ACTIVE",tokenMap,"Appraisal cycle active","Appraisal cycle {{appraisal_year}} is active from {{window_start}} to {{window_end}}.");
													}
													else
													{
														thisapp.Add_Audit_Log("APPRAISAL_CONFIG_SAVED","Performance","Appraisal_Config",input.ID,"Saved","","Inactive","Appraisal configuration saved.",true,"");
													}
									)
								}
							}
			
						
			}

			Appraisal_Config_On_Validate as "Appraisal Config - On Validate"
			{
			
							type =  form
							form = Appraisal_Config
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Window_Start >= input.Window_End)
													{
														alert "Window start must be before window end.";
														cancel submit;
													}
													if(input.Window_End > input.Manager_Scoring_Start)
													{
														alert "Window end must be on or before manager scoring start.";
														cancel submit;
													}
													if(input.Manager_Scoring_Start >= input.Manager_Scoring_End)
													{
														alert "Manager scoring start must be before manager scoring end.";
														cancel submit;
													}
													if(input.Is_Active == true)
													{
														activeCycles = Appraisal_Config[Is_Active == true && ID != input.ID];
														if(activeCycles.count() > 0)
														{
															alert "Only one appraisal cycle can be active at a time.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Appraisal_Form_On_Load as "Appraisal Form - On Load"
			{
			
							type =  form
							form = Appraisal_Form
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Appraisal_Config;
													disable Manager;
													hide HR_Signoff;
													hide HR_Comments;
													if(input.Status == null || input.Status == "")
													{
														input.Status = "Draft";
													}
													if(input.Appraisal_Config == null)
													{
														activeCycles = Appraisal_Config[Is_Active == true];
														if(activeCycles.count() > 0)
														{
															input.Appraisal_Config = activeCycles.ID;
														}
													}
													if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Employee != null)
													{
														selectedEmployees = Employee_Master[ID == input.Employee];
														if(selectedEmployees.count() > 0 && selectedEmployees.Primary_Manager != null)
														{
															managerEmployees = Employee_Master[ID == selectedEmployees.Primary_Manager];
															if(managerEmployees.count() > 0)
															{
																input.Manager = managerEmployees.Official_Email;
															}
														}
													}
													if(input.Status == "HR_Approved")
													{
														show HR_Signoff;
														show HR_Comments;
														disable Employee;
														disable Status;
														disable HR_Signoff;
														disable HR_Comments;
													}
													else if(input.Status == "Manager_Reviewed")
													{
														show HR_Signoff;
														show HR_Comments;
													}
													else if(input.Status == "Submitted")
													{
														disable Employee;
													}
									)
								}
							}
			
						
			}

			Appraisal_Form_On_Success as "Appraisal Form - On Success"
			{
			
							type =  form
							form = Appraisal_Form
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														formRows = Appraisal_Form[ID == input.ID];
													oldStatus = "";
													if(formRows.count() > 0)
													{
														oldStatus = formRows.Status;
													}
													if(input.HR_Signoff == true && input.Status == "Manager_Reviewed")
													{
														formRows.Status="HR_Approved";
													}
													if(input.ID != null)
													{
														objectiveCount = Appraisal_Objectives[Appraisal_Form == input.ID].count();
														if(objectiveCount == 0)
														{
															kpiRows = KPI_KRA[Employee == input.Employee && Appraisal_Config == input.Appraisal_Config] range from 1 to 200;
															for each  kpiRec in kpiRows
															{
																insertedObjectiveId = insert into Appraisal_Objectives
																[
																	Appraisal_Form=input.ID
																	KPI_KRA=kpiRec.ID
																	Objective_Text=kpiRec.Objective
																	Added_User=zoho.loginuser
																];
															}
														}
														questionCount = Appraisal_Question_Response[Appraisal_Form == input.ID].count();
														if(questionCount == 0)
														{
															questionRows = Appraisal_Basic_Questions[Appraisal_Config == input.Appraisal_Config] sort by Question_Order range from 1 to 200;
															for each  questionRec in questionRows
															{
																insertedQuestionResponseId = insert into Appraisal_Question_Response
																[
																	Appraisal_Form=input.ID
																	Question=questionRec.ID
																	Added_User=zoho.loginuser
																];
															}
														}
													}
													statusForNotification = input.Status;
													if(input.HR_Signoff == true && input.Status == "Manager_Reviewed")
													{
														statusForNotification = "HR_Approved";
													}
													tokenMap = Map();
													tokenMap.put("employee",input.Employee);
													tokenMap.put("status",statusForNotification);
													tokenMap.put("manager",ifnull(input.Manager,""));
													if(statusForNotification == "Submitted")
													{
														thisapp.Send_Configured_Notification("APPRAISAL_SUBMITTED",tokenMap,"Appraisal submitted","An appraisal form has been submitted for manager review.");
													}
													else if(statusForNotification == "Manager_Reviewed")
													{
														thisapp.Send_Configured_Notification("APPRAISAL_MANAGER_REVIEWED",tokenMap,"Appraisal manager review completed","An appraisal form has completed manager review and is ready for HR signoff.");
													}
													else if(statusForNotification == "HR_Approved")
													{
														thisapp.Send_Configured_Notification("APPRAISAL_HR_APPROVED",tokenMap,"Appraisal HR approved","An appraisal form has been approved by HR.");
													}
													thisapp.Add_Audit_Log("APPRAISAL_FORM_UPDATED","Performance","Appraisal_Form",input.ID,"Save",oldStatus,statusForNotification,"Appraisal form saved.",true,"");
									)
								}
							}
			
						
			}

			Appraisal_Form_On_Validate as "Appraisal Form - On Validate"
			{
			
							type =  form
							form = Appraisal_Form
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Appraisal_Config == null)
													{
														alert "An active appraisal cycle is required.";
														cancel submit;
													}
													activeCycles = Appraisal_Config[ID == input.Appraisal_Config];
													if(activeCycles.count() == 0)
													{
														alert "Selected appraisal cycle could not be found.";
														cancel submit;
													}
													if(activeCycles.count() > 0)
													{
														if(input.ID == null && zoho.currentdate < activeCycles.Window_Start || zoho.currentdate > activeCycles.Window_End)
														{
															alert "Appraisal forms can only be created during the active appraisal window.";
															cancel submit;
														}
														if(input.Status == "Manager_Reviewed" && zoho.currentdate < activeCycles.Manager_Scoring_Start || zoho.currentdate > activeCycles.Manager_Scoring_End)
														{
															alert "Manager review can only be completed during the manager scoring window.";
															cancel submit;
														}
													}
													duplicateForms = Appraisal_Form[Employee == input.Employee && Appraisal_Config == input.Appraisal_Config && ID != input.ID];
													if(duplicateForms.count() > 0)
													{
														alert "An appraisal form already exists for this employee and cycle.";
														cancel submit;
													}
													if(input.Status == "Submitted")
													{
														objectiveRows = Appraisal_Objectives[Appraisal_Form == input.ID];
														if(objectiveRows.count() == 0)
														{
															alert "At least one appraisal objective is required before submission.";
															cancel submit;
														}
														incompleteObjectives = Appraisal_Objectives[Appraisal_Form == input.ID && Self_Score == null];
														if(incompleteObjectives.count() > 0)
														{
															alert "Self scores are required for all objectives before submission.";
															cancel submit;
														}
														skillRows = Appraisal_Skills[Appraisal_Form == input.ID];
														incompleteSkills = Appraisal_Skills[Appraisal_Form == input.ID && Self_Score == null];
														if(skillRows.count() > 0 && incompleteSkills.count() > 0)
														{
															alert "Self scores are required for all skills before submission.";
															cancel submit;
														}
														questionRows = Appraisal_Question_Response[Appraisal_Form == input.ID];
														incompleteQuestions = Appraisal_Question_Response[Appraisal_Form == input.ID && Response == ""];
														if(questionRows.count() > 0 && incompleteQuestions.count() > 0)
														{
															alert "Responses are required for all appraisal questions before submission.";
															cancel submit;
														}
													}
													if(input.Status == "Manager_Reviewed")
													{
														unscoredObjectives = Appraisal_Objectives[Appraisal_Form == input.ID && Manager_Score == null];
														if(unscoredObjectives.count() > 0)
														{
															alert "Manager scores are required for all objectives before manager review completion.";
															cancel submit;
														}
														unscoredSkills = Appraisal_Skills[Appraisal_Form == input.ID && Manager_Score == null];
														if(unscoredSkills.count() > 0)
														{
															alert "Manager scores are required for all skills before manager review completion.";
															cancel submit;
														}
														unscoredQuestions = Appraisal_Question_Response[Appraisal_Form == input.ID && Manager_Score == null];
														if(unscoredQuestions.count() > 0)
														{
															alert "Manager scores are required for all question responses before manager review completion.";
															cancel submit;
														}
													}
													if(input.HR_Signoff == true && input.Status != "Manager_Reviewed" && input.Status != "HR_Approved")
													{
														alert "HR signoff is allowed only after manager review.";
														cancel submit;
													}
													if(input.Status == "HR_Approved" && input.HR_Signoff != true)
													{
														alert "HR signoff is required before HR approval.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

