ignation_Request?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Submit resignation request&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_Resignation_Requests&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-01&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open my resignation requests&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:HR_Offboarding_Dashboard&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-briefcase-24&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open HR offboarding dashboard&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Exit_Interview?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add exit interview&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Offboarding_Checklist_View&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline design-todo&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open checklist view&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Employee_Asset_Recovery?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline business-money-coins&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add asset recovery row&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Asset_Sync_Failed&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open sync failures&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&quot;obh-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold zcs-color-primary&quot;&gt;Asset sync note&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;External asset integration is a safe stub in this build. Use Asset_Sync_Failed to monitor rows that require IT review.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline loader-dots-06&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=syncPending%&gt; pending sync&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=assetRecovered%&gt; recovered assets&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;&lt;%=assetNotFound%&gt; not found assets&lt;/span&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/aside&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;zcs-card zcs-p-16 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mb-12&quot;&gt;\n\t\t\t&lt;div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-uppercase zcs-color-tertiary&quot;&gt;Reachability map&lt;/span&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mt-4 zcs-mb-8&quot;&gt;All offboarding views and boards&lt;/h5&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&quot;&gt;All linked&lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Area&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Component&lt;/th&gt;\n\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Open&lt;/th&gt;\n\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t&lt;tr class=&quot;zcs-tspace&quot;&gt;&lt;th class=&quot;zcs-p-8 zcs-box-border&quot; colspan=&quot;3&quot;&gt;&lt;/th&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/thead&gt;\n\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Employee&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;My_Resignation_Requests&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:My_Resignation_Requests&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;HR&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;HR_Offboarding_Dashboard&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:HR_Offboarding_Dashboard&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Exit interview&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Exit_Interview_List&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Exit_Interview_List&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Checklist&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Offboarding_Checklist_View&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Offboarding_Checklist_View&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;IT assets&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;IT_Asset_Recovery_Dashboard&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:IT_Asset_Recovery_Dashboard&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;IT exceptions&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Asset_Sync_Failed&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Asset_Sync_Failed&quot;&gt;Open report&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Resignation_Status_Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Resignation_Status_Kanban&quot;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Exit_Interview_Category_Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Exit_Interview_Category_Kanban&quot;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Offboarding_Checklist_Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Offboarding_Checklist_Kanban&quot;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Asset_Recovery_Kanban&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;obh-directory-link&quot; href=&quot;#Report:Asset_Recovery_Kanban&quot;&gt;Open Kanban&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t&lt;/tbody&gt;\n\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Org_Chart
		{
					displayname = "Organisation Chart"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Org_Chart_Snippet' elementName='Org_Chart_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Org_Chart_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tloginEmailAlt = zoho.loginuser;\n\tcurrentEmployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == loginEmailAlt];\n\tcurrentEmpId = &quot;&quot;;\n\tcurrentEmpName = ifnull(zoho.loginuser,&quot;Logged-in user&quot;);\n\tif(currentEmployeeRows.count() &gt; 0)\n\t{\n\t\tcurrentEmpId = currentEmployeeRows.ID.toString();\n\t\tcurrentEmpName = ifnull(currentEmployeeRows.Full_Name,currentEmpName);\n\t}\n\tactiveEmployees = Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;];\n\temployeeCount = activeEmployees.count();\n\tactiveCount = 0;\n\tprobationCount = 0;\n\tdeptOptions = list();\n\tfor each  empSeed in activeEmployees\n\t{\n\t\tif(empSeed.Employment_Status == &quot;Active&quot;)\n\t\t{\n\t\t\tactiveCount = activeCount + 1;\n\t\t}\n\t\telse if(empSeed.Employment_Status == &quot;Probation&quot;)\n\t\t{\n\t\t\tprobationCount = probationCount + 1;\n\t\t}\n\t\tdeptNameSeed = ifnull(empSeed.Department.Department_Name,&quot;Unassigned&quot;);\n\t\tif(!deptOptions.contains(deptNameSeed))\n\t\t{\n\t\t\tdeptOptions.add(deptNameSeed);\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global.css essentials for this page ===== */\n:root {\n\t--zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC);\n\t--zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF);\n\t--zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A);\n\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563);\n\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895);\n\t--zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE);\n\t--zcs-white-color: #FFFFFF;\n\t--zcs-black-color: #000000;\n\t--oc-line-color: var(--zcs_tertiary_border_color, #DDE2EA);\n\t--oc-card-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);\n\tfont-size: 16px;\n\tline-height: 1.5;\n}\na { text-decoration: none; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-row-nowrap { flex-wrap: nowrap; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-align-items-center { align-items: center; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-2 { gap: 0.125rem; }\n.zcs-gap-4 { gap: 0.25rem; }\n.zcs-gap-8 { gap: 0.5rem; }\n.zcs-gap-10 { gap: 0.625rem; }\n.zcs-gap-12 { gap: 0.75rem; }\n.zcs-gap-15 { gap: 0.9375rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-p-8 { padding: 0.5rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-10 { padding-left: 0.625rem; padding-right: 0.625rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: 0.125rem; padding-bottom: 0.125rem; }\n.zcs-py-8 { padding-top: 0.5rem; padding-bottom: 0.5rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-rounded-sm { border-radius: 0.25rem; }\n.zcs-rounded-md { border-radius: 0.375rem; }\n.zcs-rounded-lg { border-radius: 0.5rem; }\n.zcs-font-11 { font-size: 0.6875rem; }\n.zcs-font-12 { font-size: 0.75rem; }\n.zcs-font-13 { font-size: 0.8125rem; }\n.zcs-font-14 { font-size: 0.875rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-cursor-pointer { cursor: pointer; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n\n/* ZCS component CSS: card-user-info avatar */\n.zcs-avatar { width: var(--zcs-avatar-size); height: var(--zcs-avatar-size); background-color: var(--zcs_brand_color, #2A6FFC); border-radius: var(--zcs-avatar-radius); overflow: hidden; color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.zcs-avatar .zcs-avatar-img { border-radius: inherit; object-fit: cover; display: block; }\n\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, #2A6FFC); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n\n/* ZCS component CSS: button-primary-outline-button-no-icon */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; cursor: pointer; font-family: inherit; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, #2A6FFC); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, #2A6FFC); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, #F2F6FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); }\n.zcs-primary-outline-button:focus { outline: 2px solid var(--zcs_brand_color, #2A6FFC); outline-offset: 2px; }\n\n/* Org chart page */\n.oc-page { min-height: 100%; background: var(--zcs-page-bg-color, #F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }\n.oc-header { background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); border-radius: 0 0 18px 18px; position: sticky; top: 0; z-index: 8; box-shadow: 0 8px 22px rgba(15, 23, 42, 0.13); }\n.oc-header .zcs-color-primary,\n.oc-header .zcs-color-secondary,\n.oc-header .zcs-color-tertiary { color: var(--zcs_brand_foreground_color, #FFFFFF); }\n.oc-header-subtitle { opacity: 0.86; }\n.oc-header-icon { width: 42px; height: 42px; border-radius: 12px; background: rgba(255,255,255,0.18); }\n.oc-shell { padding: 22px 30px 30px; box-sizing: border-box; }\n.oc-toolbar { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: var(--oc-card-shadow); padding: 16px; display: grid; grid-template-columns: minmax(240px, 1fr) 240px auto; gap: 12px; align-items: center; margin-bottom: 18px; }\n.oc-input-wrap { position: relative; }\n.oc-input-wrap i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--zcs-teritiary-text-color); }\n.oc-input,\n.oc-select { width: 100%; height: 40px; border: 1px solid var(--zcs-border-color); border-radius: 10px; background: var(--zcs-white-color); color: var(--zcs-primary-text-color); box-sizing: border-box; font: inherit; font-size: 14px; }\n.oc-input { padding: 0 12px 0 38px; }\n.oc-select { padding: 0 12px; }\n.oc-input:focus,\n.oc-select:focus { border-color: var(--zcs_brand_color, #2A6FFC); outline: 2px solid rgba(42, 111, 252, 0.16); outline-offset: 0; }\n.oc-toolbar-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }\n.oc-summary-row { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }\n.oc-source { display: none; }\n.oc-chart-scroll { overflow: auto; background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0.66)); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: var(--oc-card-shadow); padding: 26px; min-height: 420px; }\n.oc-tree { display: flex; align-items: flex-start; gap: 28px; min-width: max-content; }\n.oc-tree-node { display: flex; flex-direction: column; align-items: center; position: relative; }\n.oc-children { display: flex; align-items: flex-start; gap: 20px; padding-top: 34px; position: relative; }\n.oc-children:before { content: &quot;&quot;; position: absolute; top: 16px; left: 28px; right: 28px; border-top: 2px solid var(--oc-line-color); }\n.oc-child-branch { position: relative; }\n.oc-child-branch:before { content: &quot;&quot;; position: absolute; top: -18px; left: 50%; height: 18px; border-left: 2px solid var(--oc-line-color); }\n.oc-card-source,\n.oc-employee-card { width: 300px; min-height: 164px; position: relative; transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; }\n.oc-employee-card { box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06); }\n.oc-employee-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10); border-color: var(--zcs_brand_color, #2A6FFC); }\n.oc-employee-card.is-current-user { border: 2px solid var(--zcs_brand_color, #2A6FFC); box-shadow: 0 0 0 4px var(--zcs_brand_light_color, #E8EFFF), 0 12px 28px rgba(15, 23, 42, 0.10); }\n.oc-employee-card.is-secondary-target { outline: 2px dashed var(--zcs_brand_color, #2A6FFC); outline-offset: 4px; }\n.oc-path-only { opacity: 0.72; }\n.oc-card-topline { display: flex; gap: 12px; align-items: flex-start; }\n.oc-emp-name { display: block; max-width: 176px; }\n.oc-meta { display: grid; gap: 7px; margin-top: 12px; }\n.oc-meta-line { display: flex; align-items: center; gap: 8px; min-width: 0; }\n.oc-meta-line i { color: var(--zcs-teritiary-text-color); width: 16px; text-align: center; }\n.oc-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; flex-wrap: wrap; }\n.oc-secondary-cue { border: 1px dashed var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); background: var(--zcs_brand_light_color, #E8EFFF); border-radius: 999px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 5px; max-width: 100%; cursor: default; }\n.oc-secondary-cue span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.oc-node-toggle { position: absolute; top: 10px; right: 10px; min-width: 0; min-height: 28px; padding: 4px 8px; border-radius: 999px; font-size: 12px; z-index: 2; }\n.oc-node-toggle[hidden] { display: none; }\n.oc-profile-link { color: var(--zcs_brand_color, #2A6FFC); display: inline-flex; align-items: center; gap: 5px; font-size: 13px; }\n.oc-profile-link:hover { text-decoration: underline; }\n.oc-initials { font-weight: 700; font-size: 16px; letter-spacing: 0.02em; }\n.oc-empty { width: 100%; min-width: 520px; padding: 48px 20px; text-align: center; color: var(--zcs-secondary-text-color); }\n.oc-empty i { font-size: 34px; color: var(--zcs-teritiary-text-color); display: block; margin-bottom: 10px; }\n.oc-count-note { color: rgba(255,255,255,0.82); }\n@media (max-width: 992px) {\n\t.oc-header { position: static; border-radius: 0 0 14px 14px; }\n\t.oc-shell { padding: 16px; }\n\t.oc-toolbar { grid-template-columns: 1fr; }\n\t.oc-toolbar-actions { justify-content: flex-start; }\n\t.oc-summary-row { justify-content: flex-start; }\n\t.oc-chart-scroll { padding: 18px; }\n}\n@media (max-width: 576px) {\n\t.oc-header { padding: 16px; }\n\t.oc-card-source,\n\t.oc-employee-card { width: 270px; }\n\t.oc-empty { min-width: 270px; }\n}\n&lt;/style&gt;\n\n&lt;div id=&quot;org-chart-page&quot; class=&quot;oc-page&quot;&gt;\n\t&lt;div class=&apos;zcs-page-header oc-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;div class=&apos;oc-header-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline business-chart-bar-32 zcs-font-22&apos;&gt;&lt;/i&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-2 zcs-ellipsis&apos;&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Organisation Chart&lt;/h5&gt;\n\t\t\t\t&lt;span class=&apos;oc-header-subtitle zcs-font-13 zcs-lh-body zcs-ellipsis&apos;&gt;Active and probation employees. Current user: &lt;%=currentEmpName%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;oc-summary-row&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=employeeCount%&gt; employees&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=activeCount%&gt; active&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&apos;&gt;\n\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=probationCount%&gt; probation&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;oc-shell&quot;&gt;\n\t\t&lt;div class=&quot;oc-toolbar&quot; aria-label=&quot;Organisation chart controls&quot;&gt;\n\t\t\t&lt;div class=&quot;oc-input-wrap&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;input id=&quot;oc-search&quot; class=&quot;oc-input&quot; type=&quot;search&quot; placeholder=&quot;Search by name, designation, department, or manager&quot; aria-label=&quot;Search organisation chart&quot;&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;select id=&quot;oc-department&quot; class=&quot;oc-select&quot; aria-label=&quot;Filter by department&quot;&gt;\n\t\t\t\t&lt;option value=&quot;&quot;&gt;All departments&lt;/option&gt;\n&lt;%\n\tfor each  deptName in deptOptions\n\t{\n\t\tdeptKey = encodeURL(deptName);\n\t\t%&gt;\n&lt;option value=&quot;&lt;%=deptKey%&gt;&quot;&gt;&lt;%=deptName%&gt;&lt;/option&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/select&gt;\n\t\t\t&lt;div class=&quot;oc-toolbar-actions&quot;&gt;\n\t\t\t\t&lt;button type=&quot;button&quot; id=&quot;oc-expand-all&quot; class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Expand all&lt;/span&gt;\n\t\t\t\t&lt;/button&gt;\n\t\t\t\t&lt;button type=&quot;button&quot; id=&quot;oc-collapse-all&quot; class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Collapse all&lt;/span&gt;\n\t\t\t\t&lt;/button&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div class=&quot;oc-chart-scroll&quot; aria-live=&quot;polite&quot;&gt;\n\t\t\t&lt;div id=&quot;oc-tree&quot; class=&quot;oc-tree&quot;&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;div id=&quot;oc-source&quot; class=&quot;oc-source&quot;&gt;\n&lt;%\n\tfor each  emp in Employee_Master[Employment_Status == &quot;Active&quot; || Employment_Status == &quot;Probation&quot;] sort by Full_Name asc\n\t{\n\t\tempId = emp.ID.toString();\n\t\tempName = ifnull(emp.Full_Name,&quot;Unnamed Employee&quot;);\n\t\tdesignation = ifnull(emp.Designation,&quot;Designation not set&quot;);\n\t\tdeptName = ifnull(emp.Department.Department_Name,&quot;Unassigned&quot;);\n\t\tdeptKey = encodeURL(deptName);\n\t\tstatusName = ifnull(emp.Employment_Status,&quot;Active&quot;);\n\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\tif(statusName == &quot;Active&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(statusName == &quot;Probation&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\tprimaryManagerId = &quot;&quot;;\n\t\tprimaryManagerName = &quot;&quot;;\n\t\tif(emp.Primary_Manager != null)\n\t\t{\n\t\t\tprimaryManagerId = emp.Primary_Manager.ID.toString();\n\t\t\tprimaryManagerName = ifnull(emp.Primary_Manager.Full_Name,&quot;&quot;);\n\t\t}\n\t\tsecondaryManagerId = &quot;&quot;;\n\t\tsecondaryManagerName = &quot;&quot;;\n\t\tif(emp.Secondary_Manager != null)\n\t\t{\n\t\t\tsecondaryManagerId = emp.Secondary_Manager.ID.toString();\n\t\t\tsecondaryManagerName = ifnull(emp.Secondary_Manager.Full_Name,&quot;&quot;);\n\t\t}\n\t\theadRows = Department_Config[Is_Active == true &amp;&amp; Department_Head == emp.ID];\n\t\tisDepartmentHead = false;\n\t\tif(headRows.count() &gt; 0)\n\t\t{\n\t\t\tisDepartmentHead = true;\n\t\t}\n\t\tcurrentClass = &quot;&quot;;\n\t\tif(currentEmpId != &quot;&quot; &amp;&amp; empId == currentEmpId)\n\t\t{\n\t\t\tcurrentClass = &quot; is-current-user&quot;;\n\t\t}\n\t\tprofilePhoto = ifnull(emp.Profile_Photo,&quot;&quot;);\n\t\t%&gt;\n&lt;div class=&quot;oc-card-source oc-employee-card zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border&lt;%=currentClass%&gt;&quot;\n\t\t\t\t\t\t data-id=&quot;&lt;%=empId%&gt;&quot;\n\t\t\t\t\t\t data-manager-id=&quot;&lt;%=primaryManagerId%&gt;&quot;\n\t\t\t\t\t\t data-secondary-id=&quot;&lt;%=secondaryManagerId%&gt;&quot;\n\t\t\t\t\t\t data-department-key=&quot;&lt;%=deptKey%&gt;&quot;\n\t\t\t\t\t\t data-search=&quot;&lt;%=encodeURL(empName + &quot;&quot; + designation + &quot;&quot; + deptName + &quot;&quot; + primaryManagerName + &quot;&quot; + secondaryManagerName)%&gt;&quot;&gt;\n\t\t\t\t\t&lt;button type=&quot;button&quot; class=&quot;oc-node-toggle zcs-button zcs-primary-outline-button&quot; aria-label=&quot;Toggle reporting line&quot; hidden&gt;Toggle&lt;/button&gt;\n\t\t\t\t\t&lt;div class=&apos;oc-card-topline&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos; style=&apos;--zcs-avatar-size: 50px; --zcs-avatar-radius: 12px&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;oc-initials&quot; aria-hidden=&quot;true&quot;&gt;&lt;/span&gt;\n&lt;%\n\t\tif(profilePhoto != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;img class=&apos;zcs-avatar-img zcs-wh-full&apos; src=&apos;&lt;%=profilePhoto%&gt;&apos; alt=&apos;&lt;%=empName%&gt;&apos; onerror=&quot;this.style.display=&apos;none&apos;;&quot; /&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-col-common zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;oc-emp-name zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis&apos;&gt;&lt;%=empName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=designation%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-8 zcs-row&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=statusName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(isDepartmentHead)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;Department Head&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(currentClass != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-11&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body&apos;&gt;You&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;oc-meta&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;oc-meta-line&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline design-app&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-primary zcs-ellipsis&quot;&gt;&lt;%=deptName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\tif(primaryManagerName != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;oc-meta-line&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary zcs-ellipsis&quot;&gt;Reports to &lt;%=primaryManagerName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;oc-card-footer&quot;&gt;\n&lt;%\n\t\tif(secondaryManagerId != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;span class=&quot;oc-secondary-cue zcs-font-12&quot; data-secondary-id=&quot;&lt;%=secondaryManagerId%&gt;&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t&lt;span&gt;Secondary: &lt;%=secondaryManagerName%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;/span&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;span&gt;&lt;/span&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;a class=&quot;oc-profile-link&quot; href=&quot;#Report:Employee_Directory?ID=&lt;%=empId%&gt;&amp;amp;zc_LoadIn=dialog&amp;amp;zc_Header=true&amp;amp;zc_Footer=false&amp;amp;zc_Search=false&amp;amp;zc_AddRec=false&amp;amp;zc_EditRec=false&amp;amp;zc_DelRec=false&amp;amp;zc_DuplRec=false&amp;amp;zc_Print=false&amp;amp;zc_Export=false&quot; aria-label=&quot;Open internal profile for &lt;%=empName%&gt;&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-edit-72&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span&gt;Profile&lt;/span&gt;\n\t\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\n&lt;script&gt;\n(function() {\n\tvar page = document.getElementById(&apos;org-chart-page&apos;);\n\tif (!page) { return; }\n\tvar source = page.querySelector(&apos;#oc-source&apos;);\n\tvar tree = page.querySelector(&apos;#oc-tree&apos;);\n\tvar searchInput = page.querySelector(&apos;#oc-search&apos;);\n\tvar deptSelect = page.querySelector(&apos;#oc-department&apos;);\n\tvar expandAllBtn = page.querySelector(&apos;#oc-expand-all&apos;);\n\tvar collapseAllBtn = page.querySelector(&apos;#oc-collapse-all&apos;);\n\tvar cards = Array.prototype.slice.call(source.children).map(function(card) {\n\t\tvar nameEl = card.querySelector(&apos;.oc-emp-name&apos;);\n\t\tvar name = nameEl ? nameEl.textContent.trim() : &apos;&apos;;\n\t\tvar encodedSearch = card.getAttribute(&apos;data-search&apos;) || &apos;&apos;;\n\t\tvar searchText = &apos;&apos;;\n\t\ttry {\n\t\t\tsearchText = decodeURIComponent(encodedSearch.replace(/+/g, &apos;%20&apos;)).toLowerCase();\n\t\t} catch (err) {\n\t\t\tsearchText = card.textContent.toLowerCase();\n\t\t}\n\t\treturn {\n\t\t\tid: card.getAttribute(&apos;data-id&apos;),\n\t\t\tmanagerId: card.getAttribute(&apos;data-manager-id&apos;) || &apos;&apos;,\n\t\t\tsecondaryId: card.getAttribute(&apos;data-secondary-id&apos;) || &apos;&apos;,\n\t\t\tdeptKey: card.getAttribute(&apos;data-department-key&apos;) || &apos;&apos;,\n\t\t\tname: name,\n\t\t\tsearchText: searchText,\n\t\t\tcard: card,\n\t\t\tchildren: [],\n\t\t\texpanded: true\n\t\t};\n\t});\n\tvar byId = {};\n\tcards.forEach(function(item) { byId[item.id] = item; });\n\tvar roots = [];\n\tcards.forEach(function(item) {\n\t\tif (item.managerId &amp;&amp; byId[item.managerId] &amp;&amp; item.managerId !== item.id) {\n\t\t\tbyId[item.managerId].children.push(item);\n\t\t} else {\n\t\t\troots.push(item);\n\t\t}\n\t});\n\n\tfunction setInitials(card) {\n\t\tvar nameEl = card.querySelector(&apos;.oc-emp-name&apos;);\n\t\tvar initialsEl = card.querySelector(&apos;.oc-initials&apos;);\n\t\tif (!nameEl || !initialsEl) { return; }\n\t\tvar parts = nameEl.textContent.trim().split(/s+/).filter(Boolean);\n\t\tvar initials = &apos;&apos;;\n\t\tif (parts.length &gt; 0) { initials += parts[0].charAt(0); }\n\t\tif (parts.length &gt; 1) { initials += parts[parts.length - 1].charAt(0); }\n\t\tinitialsEl.textContent = (initials || &apos;U&apos;).toUpperCase();\n\t}\n\n\tfunction matchesSelf(item, query, deptKey) {\n\t\tvar deptOk = !deptKey || item.deptKey === deptKey;\n\t\tvar searchOk = !query || item.searchText.indexOf(query) !== -1;\n\t\treturn deptOk &amp;&amp; searchOk;\n\t}\n\n\tfunction visibleModel(item, query, deptKey) {\n\t\tvar childModels = item.children.map(function(child) {\n\t\t\treturn visibleModel(child, query, deptKey);\n\t\t}).filter(Boolean);\n\t\tvar selfMatch = matchesSelf(item, query, deptKey);\n\t\tif (selfMatch || childModels.length &gt; 0) {\n\t\t\treturn { item: item, selfMatch: selfMatch, children: childModels };\n\t\t}\n\t\treturn null;\n\t}\n\n\tfunction renderNode(model, filtering) {\n\t\tvar item = model.item;\n\t\tvar branch = document.createElement(&apos;div&apos;);\n\t\tbranch.className = &apos;oc-tree-node&apos;;\n\t\tvar card = item.card.cloneNode(true);\n\t\tcard.classList.remove(&apos;oc-card-source&apos;);\n\t\tcard.classList.add(&apos;oc-employee-card&apos;);\n\t\tif (!model.selfMatch) {\n\t\t\tcard.classList.add(&apos;oc-path-only&apos;);\n\t\t}\n\t\tsetInitials(card);\n\t\tvar toggle = card.querySelector(&apos;.oc-node-toggle&apos;);\n\t\tif (toggle &amp;&amp; item.children.length &gt; 0) {\n\t\t\ttoggle.hidden = false;\n\t\t\ttoggle.textContent = item.expanded || filtering ? &apos;Collapse&apos; : &apos;Expand&apos;;\n\t\t\ttoggle.addEventListener(&apos;click&apos;, function(event) {\n\t\t\t\tevent.preventDefault();\n\t\t\t\tevent.stopPropagation();\n\t\t\t\titem.expanded = !item.expanded;\n\t\t\t\trender();\n\t\t\t});\n\t\t}\n\t\tbranch.appendChild(card);\n\t\tif (model.children.length &gt; 0 &amp;&amp; (item.expanded || filtering)) {\n\t\t\tvar childrenWrap = document.createElement(&apos;div&apos;);\n\t\t\tchildrenWrap.className = &apos;oc-children&apos;;\n\t\t\tmodel.children.forEach(function(childModel) {\n\t\t\t\tvar childBranch = document.createElement(&apos;div&apos;);\n\t\t\t\tchildBranch.className = &apos;oc-child-branch&apos;;\n\t\t\t\tchildBranch.appendChild(renderNode(childModel, filtering));\n\t\t\t\tchildrenWrap.appendChild(childBranch);\n\t\t\t});\n\t\t\tbranch.appendChild(childrenWrap);\n\t\t}\n\t\treturn branch;\n\t}\n\n\tfunction renderEmpty(message) {\n\t\ttree.innerHTML = &apos;&apos;;\n\t\tvar empty = document.createElement(&apos;div&apos;);\n\t\tempty.className = &apos;oc-empty&apos;;\n\t\tempty.innerHTML = &apos;&lt;i class=&quot;zc-li-outline ui-1-zoom&quot;&gt;&lt;/i&gt;&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-color-primary&quot;&gt;&apos; + message + &apos;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Try a different search term or department filter.&lt;/div&gt;&apos;;\n\t\ttree.appendChild(empty);\n\t}\n\n\tfunction render() {\n\t\tvar query = (searchInput.value || &apos;&apos;).trim().toLowerCase();\n\t\tvar deptKey = deptSelect.value || &apos;&apos;;\n\t\tvar filtering = !!query || !!deptKey;\n\t\tvar models = roots.map(function(root) {\n\t\t\treturn visibleModel(root, query, deptKey);\n\t\t}).filter(Boolean);\n\t\ttree.innerHTML = &apos;&apos;;\n\t\tif (cards.length === 0) {\n\t\t\trenderEmpty(&apos;No active or probation employees are available.&apos;);\n\t\t\treturn;\n\t\t}\n\t\tif (models.length === 0) {\n\t\t\trenderEmpty(&apos;No employees match your current filters.&apos;);\n\t\t\treturn;\n\t\t}\n\t\tmodels.forEach(function(model) {\n\t\t\ttree.appendChild(renderNode(model, filtering));\n\t\t});\n\t}\n\n\tfunction setExpanded(value) {\n\t\tcards.forEach(function(item) { item.expanded = value; });\n\t\trender();\n\t}\n\n\tsearchInput.addEventListener(&apos;input&apos;, render);\n\tdeptSelect.addEventListener(&apos;change&apos;, render);\n\texpandAllBtn.addEventListener(&apos;click&apos;, function() { setExpanded(true); });\n\tcollapseAllBtn.addEventListener(&apos;click&apos;, function() { setExpanded(false); });\n\n\tpage.addEventListener(&apos;mouseover&apos;, function(event) {\n\t\tvar cue = event.target.closest(&apos;.oc-secondary-cue&apos;);\n\t\tif (!cue) { return; }\n\t\tvar secondaryId = cue.getAttribute(&apos;data-secondary-id&apos;);\n\t\tif (!secondaryId) { return; }\n\t\tpage.querySelectorAll(&apos;.oc-employee-card[data-id=&quot;&apos; + secondaryId + &apos;&quot;]&apos;).forEach(function(card) {\n\t\t\tcard.classList.add(&apos;is-secondary-target&apos;);\n\t\t});\n\t});\n\tpage.addEventListener(&apos;mouseout&apos;, function(event) {\n\t\tif (!event.target.closest(&apos;.oc-secondary-cue&apos;)) { return; }\n\t\tpage.querySelectorAll(&apos;.oc-employee-card.is-secondary-target&apos;).forEach(function(card) {\n\t\t\tcard.classList.remove(&apos;is-secondary-target&apos;);\n\t\t});\n\t});\n\n\trender();\n})();\n&lt;/script&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Performance_Home
		{
					displayname = "Performance Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Performance_Home_Snippet' elementName='Performance_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Performance_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || isAdmin;\n\tisManager = loginRole == &quot;MANAGER&quot; || isHR || loginRole == &quot;CEO&quot; || isAdmin;\n\tuserName = ifnull(zoho.loginuser,&quot;Performance user&quot;);\n\tuserSubtitle = &quot;Performance workspace&quot;;\n\tcurrentEmployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];\n\tif(currentEmployeeRows.count() &gt; 0)\n\t{\n\t\tuserName = ifnull(currentEmployeeRows.Full_Name,userName);\n\t\tuserSubtitle = ifnull(currentEmployeeRows.Designation,userSubtitle);\n\t}\n\tactiveCycles = Appraisal_Config[Is_Active == true].count();\n\ttotalCycles = Appraisal_Config.count();\n\tkpiCount = KPI_KRA.count();\n\tlockedKpiCount = KPI_KRA[Is_Locked == true].count();\n\tmyAppraisalCount = Appraisal_Form[Employee.Official_Email == loginEmail || Employee.Official_Email == zoho.loginuser].count();\n\tmanagerQueueCount = Appraisal_Form[Manager == zoho.loginuserid || Manager == zoho.loginuser].count();\n\tdraftCount = Appraisal_Form[Status == &quot;Draft&quot;].count();\n\tsubmittedCount = Appraisal_Form[Status == &quot;Submitted&quot;].count();\n\tmanagerReviewedCount = Appraisal_Form[Status == &quot;Manager_Reviewed&quot;].count();\n\thrApprovedCount = Appraisal_Form[Status == &quot;HR_Approved&quot;].count();\n\thrPendingCount = Appraisal_Form[Status == &quot;Manager_Reviewed&quot; &amp;&amp; HR_Signoff == false].count();\n\tobjectiveRows = Appraisal_Objectives.count();\n\tskillRows = Appraisal_Skills.count();\n\tresponseRows = Appraisal_Question_Response.count();\n\tquestionRows = Appraisal_Basic_Questions.count();\n\t%&gt;\n&lt;style&gt;\n/* ZCS global utility subset included once for Performance_Home */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-8 { padding-left: .5rem; padding-right: .5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-sticky { position: sticky; } .zcs-relative { position: relative; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-yellow { color: #b8770d; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: button-primary-button and button-primary-outline-button */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n/* ZCS component CSS: table-simple-table */\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.ph-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.ph-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n.ph-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }\n.ph-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.ph-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.ph-hero-content { position: relative; z-index: 1; }\n.ph-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.ph-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.ph-kpi { grid-column: span 3; min-height: 120px; }\n.ph-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.ph-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.ph-workspace { grid-column: span 9; overflow: hidden; }\n.ph-actions { grid-column: span 3; }\n.ph-tab-input { display: none; }\n.ph-tabbar { overflow-x: auto; }\n.ph-tabbar label { cursor: pointer; }\n.ph-panel { display: none; padding: 18px; }\n#ph-tab-my:checked ~ .ph-tabbar label[for=&apos;ph-tab-my&apos;], #ph-tab-manager:checked ~ .ph-tabbar label[for=&apos;ph-tab-manager&apos;], #ph-tab-hr:checked ~ .ph-tabbar label[for=&apos;ph-tab-hr&apos;], #ph-tab-config:checked ~ .ph-tabbar label[for=&apos;ph-tab-config&apos;], #ph-tab-children:checked ~ .ph-tabbar label[for=&apos;ph-tab-children&apos;], #ph-tab-kanban:checked ~ .ph-tabbar label[for=&apos;ph-tab-kanban&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#ph-tab-my:checked ~ .ph-panels .ph-panel-my, #ph-tab-manager:checked ~ .ph-panels .ph-panel-manager, #ph-tab-hr:checked ~ .ph-panels .ph-panel-hr, #ph-tab-config:checked ~ .ph-panels .ph-panel-config, #ph-tab-children:checked ~ .ph-panels .ph-panel-children, #ph-tab-kanban:checked ~ .ph-panels .ph-panel-kanban { display: block; }\n.ph-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); }\n.ph-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.ph-report-frame { min-height: 620px; }\n.ph-report-frame-short { min-height: 430px; }\n.ph-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n.ph-access-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n.ph-action-list { list-style: none; }\n.ph-action-item { list-style-type: none; } .ph-action-item:hover { border-color: var(--zcs-theme-brand-color); } .ph-action-item:hover .ph-action-link { color: var(--zcs-theme-brand-color); }\n@media (max-width: 1100px) { .ph-kpi { grid-column: span 6; } .ph-workspace, .ph-actions { grid-column: span 12; } .ph-two-col { grid-template-columns: 1fr; } }\n@media (max-width: 680px) { .ph-page { padding: 14px; } .ph-kpi { grid-column: span 12; } .ph-hero { padding: 18px; } .ph-hero-content, .ph-header { flex-direction: column; align-items: flex-start; } .ph-header { padding: 16px; } .ph-panel { padding: 12px; } .ph-report-frame { min-height: 520px; } }\n&lt;/style&gt;\n\n&lt;div class=&quot;ph-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;ph-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Performance Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Appraisal cycles, KPIs, self-appraisal, scoring, and HR sign-off workspace&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:Appraisal_Status_Kanban?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline business-chart-bar-32&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Status Kanban&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Appraisal_Form?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Start Appraisal&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;ph-hero zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;ph-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-medium&quot;&gt;Signed in as &lt;%=userName%&gt;&lt;/span&gt;\n\t\t\t\t&lt;h2 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Performance cycle command center&lt;/h2&gt