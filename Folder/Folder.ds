			ID_Card_Request_On_Load as "ID Card Request - On Load"
			{
			
							type =  form
							form = ID_Card_Request
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Raised_By;
													disable Valid_From;
													disable Received_Date;
													hide Employee_Requester;
													hide Member_Requester;
													hide Barcode_Display;
													if(input.Raised_By == null)
													{
														input.Raised_By = zoho.loginuserid;
													}
													if(input.Requester_Type == "Employee")
													{
														show Employee_Requester;
													}
													else if(input.Requester_Type == "Member")
													{
														show Member_Requester;
													}
													if(input.Extension_ID_Number != null && input.Extension_ID_Number != "")
													{
														show Barcode_Display;
													}
													if(input.Status == "Received" || input.Status == "Deactivated")
													{
														disable Requester_Type;
														disable Employee_Requester;
														disable Member_Requester;
														disable Recipient_Name;
														disable Recipient_Designation;
														disable Request_Type;
														disable Extension_ID_Number;
														disable Status;
													}
									)
								}
							}
			
						
			}

			ID_Card_Request_On_Success as "ID Card Request - On Success"
			{
			
							type =  form
							form = ID_Card_Request
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Request_Type == "Renewal" && input.Status == "Submitted")
													{
														input.Status = "Extension_ID_Updated";
													}
													if(input.Status == "Received")
													{
														if(input.Received_Date == null)
														{
															input.Received_Date = zoho.currentdate;
														}
														if(input.Valid_From == null)
														{
															input.Valid_From = zoho.currentdate;
														}
														if(input.Valid_Upto == null)
														{
															input.Valid_Upto = zoho.currentdate.addYear(3);
														}
													}
													try 
													{
														tokenMap = Map();
														tokenMap.put("recipient_name",input.Recipient_Name);
														tokenMap.put("status",input.Status);
														thisapp.Send_Configured_Notification("ID_CARD_STATUS",tokenMap,"ID card request update","ID card request for {{recipient_name}} is now {{status}}.");
													}catch (notifyErr)
													{
													}
													try 
													{
														thisapp.Add_Audit_Log("ID_CARD_SAVE","ID_Card","ID_Card_Request",input.ID,"Save","",input.Status,"ID card request saved",true,"");
													}catch (auditErr)
													{
													}
									)
								}
							}
			
						
			}

			ID_Card_Request_On_Validate as "ID Card Request - On Validate"
			{
			
							type =  form
							form = ID_Card_Request
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Raised_By == null)
													{
														input.Raised_By = zoho.loginuserid;
													}
													if(input.Requester_Type == "Employee")
													{
														if(input.Employee_Requester == null)
														{
															alert "Employee requester is required for employee ID card requests.";
															cancel submit;
														}
														employeeRows = Employee_Master[ID == input.Employee_Requester];
														if(employeeRows.count() > 0)
														{
															input.Recipient_Name = employeeRows.Full_Name;
															input.Recipient_Designation = employeeRows.Designation;
														}
													}
													if(input.Requester_Type == "Member")
													{
														if(input.Member_Requester == null)
														{
															alert "Member requester is required for member ID card requests.";
															cancel submit;
														}
														memberRows = Member_Master[ID == input.Member_Requester];
														if(memberRows.count() > 0)
														{
															input.Recipient_Name = memberRows.Member_Name;
															input.Recipient_Designation = memberRows.Member_Type;
														}
													}
													if(input.Request_Type == "Renewal" && input.Extension_ID_Number == null || input.Extension_ID_Number == "")
													{
														alert "Extension ID is mandatory for renewal requests.";
														cancel submit;
													}
													if(input.Status == "Received")
													{
														if(input.Received_Date == null)
														{
															input.Received_Date = zoho.currentdate;
														}
														if(input.Valid_From == null)
														{
															input.Valid_From = zoho.currentdate;
														}
														if(input.Valid_Upto == null)
														{
															input.Valid_Upto = zoho.currentdate.addYear(3);
														}
													}
									)
								}
							}
			
						
			}

