			Training_Request_On_Validate as "Training Request - On Validate"
			{
			
							type =  form
							form = Training_Request
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Raised_By == null)
													{
														input.Raised_By = zoho.loginuserid;
													}
													managerAllowed = false;
													managerEmployees = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
													if(managerEmployees.count() > 0)
													{
														directReports = Employee_Master[Primary_Manager == managerEmployees.ID || Secondary_Manager == managerEmployees.ID && Employment_Status == "Active" || Employment_Status == "Probation"];
														if(directReports.count() > 0)
														{
															managerAllowed = true;
														}
													}
													if(zoho.loginuser == zoho.adminuserid)
													{
														managerAllowed = true;
													}
													if(input.ID == null && managerAllowed == false)
													{
														alert "Only Managers can raise training requests.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Travel_HR_Recommendations_On_Load as "Travel HR Recommendations - On Load"
			{
			
							type =  form
							form = Travel_HR_Recommendations
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Recommendation_Type;
													hide Departure_Time;
													hide Arrival_Time;
													hide Check_In_Date;
													hide Check_Out_Date;
													if(input.Travel_Requirement != null)
													{
														requirementRows = Travel_Requirements[ID == input.Travel_Requirement];
														if(requirementRows.count() > 0)
														{
															input.Recommendation_Type = requirementRows.Requirement_Type;
															if(requirementRows.Requirement_Type == "Hotel")
															{
																show Check_In_Date;
																show Check_Out_Date;
															}
															else
															{
																show Departure_Time;
																show Arrival_Time;
															}
														}
													}
									)
								}
							}
			
						
			}

			Travel_HR_Recommendations_On_Success as "Travel HR Recommendations - On Success"
			{
			
							type =  form
							form = Travel_HR_Recommendations
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														tokenMap = Map();
													tokenMap.put("travel_request",input.Travel_Request);
													tokenMap.put("recommendation_type",input.Recommendation_Type);
													tokenMap.put("vendor",input.Vendor_Or_Operator);
													tokenMap.put("estimated_cost",input.Estimated_Cost);
													thisapp.Send_Configured_Notification("TRAVEL_OPTIONS_READY",tokenMap,"Travel options ready","Travel options are ready for review.");
													thisapp.Add_Audit_Log("TRAVEL_RECOMMENDATION_SAVED","Travel","Travel_HR_Recommendations",input.ID,"Save","",if(input.Is_Selected == true,"Selected","Proposed"),"Travel recommendation saved.",true,"");
									)
								}
							}
			
						
			}

			Travel_HR_Recommendations_On_Validate as "Travel HR Recommendations - On Validate"
			{
			
							type =  form
							form = Travel_HR_Recommendations
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Estimated_Cost < 0)
													{
														alert "Estimated cost cannot be negative.";
														cancel submit;
													}
													if(input.Departure_Time != null && input.Arrival_Time != null && input.Arrival_Time < input.Departure_Time)
													{
														alert "Arrival time cannot be before departure time.";
														cancel submit;
													}
													if(input.Check_In_Date != null && input.Check_Out_Date != null && input.Check_Out_Date < input.Check_In_Date)
													{
														alert "Check-out date cannot be before check-in date.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Travel_Requirement_On_User_Input as "Travel HR Recommendations Requirement - On User Input"
			{
			
							type =  form
							form = Travel_HR_Recommendations
			
							record event = on add or edit
			
							on user input of Travel_Requirement
							{
								actions 
								{
									custom deluge script
									(
														hide Departure_Time;
													hide Arrival_Time;
													hide Check_In_Date;
													hide Check_Out_Date;
													input.Recommendation_Type = "";
													if(input.Travel_Requirement != null)
													{
														requirementRows = Travel_Requirements[ID == input.Travel_Requirement];
														if(requirementRows.count() > 0)
														{
															input.Recommendation_Type = requirementRows.Requirement_Type;
															input.Travel_Request = requirementRows.Travel_Request;
															if(requirementRows.Requirement_Type == "Hotel")
															{
																show Check_In_Date;
																show Check_Out_Date;
															}
															else
															{
																show Departure_Time;
																show Arrival_Time;
															}
														}
													}
									)
								}
							}
			
						
			}

			Travel_Request_On_Load as "Travel Request - On Load"
			{
			
							type =  form
							form = Travel_Request
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.Status == null || input.Status == "")
													{
														input.Status = "Pending_Manager";
													}
													disable Employee;
													disable Status;
													disable Booking_Amount;
													disable Bills_Upload_Date;
													disable Linked_Reimbursement;
													disable Total_Estimated_Cost;
													disable Total_Actual_Cost;
													hide Bills_Uploaded;
													hide Bills_Upload_Date;
													if(input.Status == "Bills_Pending")
													{
														show Bills_Uploaded;
														show Bills_Upload_Date;
													}
													else if(input.Status == "Bills_Uploaded" || input.Status == "Processed")
													{
														show Bills_Uploaded;
														show Bills_Upload_Date;
														disable Bills_Uploaded;
													}
									)
								}
							}
			
						
			}

			Travel_Request_On_Success as "Travel Request - On Success"
			{
			
							type =  form
							form = Travel_Request
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														travelRows = Travel_Request[ID == input.ID];
													statusForAudit = input.Status;
													if(input.Travel_Completed_Date != null && input.Status == "Approved")
													{
														travelRows.Status="Bills_Pending";
														statusForAudit = "Bills_Pending";
													}
													if(input.Bills_Uploaded != null && input.Status == "Bills_Pending")
													{
														travelRows.Status="Bills_Uploaded";
														travelRows.Bills_Upload_Date=zoho.currentdate;
														statusForAudit = "Bills_Uploaded";
													}
													tokenMap = Map();
													tokenMap.put("employee",input.Employee);
													tokenMap.put("destination",input.Destination);
													tokenMap.put("status",statusForAudit);
													if(statusForAudit == "Pending_Manager")
													{
														thisapp.Send_Configured_Notification("TRAVEL_REQUEST_SUBMITTED",tokenMap,"Travel request submitted","A travel request for {{destination}} has been submitted for manager approval.");
													}
													else if(statusForAudit == "Bills_Pending")
													{
														thisapp.Send_Configured_Notification("TRAVEL_BILLS_PENDING",tokenMap,"Travel bills pending","Please upload travel bills for {{destination}}.");
													}
													else if(statusForAudit == "Bills_Uploaded")
													{
														thisapp.Send_Configured_Notification("TRAVEL_BILLS_UPLOADED",tokenMap,"Travel bills uploaded","Travel bills have been uploaded for {{destination}}.");
													}
													thisapp.Add_Audit_Log("TRAVEL_REQUEST_UPDATED","Travel","Travel_Request",input.ID,"Save","",statusForAudit,"Travel request saved.",true,"");
									)
								}
							}
			
						
			}

			Travel_Request_On_Validate as "Travel Request - On Validate"
			{
			
							type =  form
							form = Travel_Request
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Travel_From_Date > input.Travel_To_Date)
													{
														alert "Travel from date cannot be after travel to date.";
														cancel submit;
													}
													if(input.Employee == null)
													{
														employeeRows = Employee_Master[Official_Email == zoho.loginuserid || Official_Email == zoho.loginuser];
														if(employeeRows.count() > 0)
														{
															input.Employee = employeeRows.ID;
														}
													}
													if(input.ID != null)
													{
														requirementRows = Travel_Requirements[Travel_Request == input.ID];
														if(input.Status != "Pending_Manager" && requirementRows.count() == 0)
														{
															alert "At least one travel requirement is required before submission progresses.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}

			Travel_Requirements_On_Validate as "Travel Requirements - On Validate"
			{
			
							type =  form
							form = Travel_Requirements
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														parentRequests = Travel_Request[ID == input.Travel_Request];
													if(parentRequests.count() == 0)
													{
														alert "Parent travel request is required.";
														cancel submit;
													}
													if(parentRequests.count() > 0 && parentRequests.Status != "Pending_Manager")
													{
														alert "Travel requirements can be changed only while the travel request is pending manager review.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Recommendation_On_User_Input as "Travel Selected Options Recommendation - On User Input"
			{
			
							type =  form
							form = Travel_Selected_Options
			
							record event = on add or edit
			
							on user input of Recommendation
							{
								actions 
								{
									custom deluge script
									(
														if(input.Recommendation != null)
													{
														recommendationRows = Travel_HR_Recommendations[ID == input.Recommendation];
														if(recommendationRows.count() > 0)
														{
															input.Travel_Request = recommendationRows.Travel_Request;
															input.Recommendation_Type = recommendationRows.Recommendation_Type;
															input.Vendor_Or_Operator = recommendationRows.Vendor_Or_Operator;
															input.Estimated_Cost = recommendationRows.Estimated_Cost;
														}
													}
									)
								}
							}
			
						
			}

			Travel_Selected_Options_On_Delete as "Travel Selected Options - On Delete"
			{
			
							type =  form
							form = Travel_Selected_Options
			
							record event = on delete
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														estimatedTotal = 0;
													actualTotal = 0;
													optionRows = Travel_Selected_Options[Travel_Request == input.Travel_Request && ID != input.ID];
													for each  optionRec in optionRows
													{
														estimatedTotal = estimatedTotal + ifnull(optionRec.Estimated_Cost,0);
														actualTotal = actualTotal + ifnull(optionRec.Actual_Cost,0);
													}
													parentRequests = Travel_Request[ID == input.Travel_Request];
													if(parentRequests.count() > 0)
													{
														parentRequests.Total_Estimated_Cost=estimatedTotal;
														parentRequests.Total_Actual_Cost=actualTotal;
													}
									)
								}
							}
			
						
			}

			Travel_Selected_Options_On_Load as "Travel Selected Options - On Load"
			{
			
							type =  form
							form = Travel_Selected_Options
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Recommendation_Type;
													disable Vendor_Or_Operator;
													disable Estimated_Cost;
													disable Booking_Uploaded_Date;
									)
								}
							}
			
						
			}

			Travel_Selected_Options_On_Success as "Travel Selected Options - On Success"
			{
			
							type =  form
							form = Travel_Selected_Options
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Booking_Document != null && input.Booking_Uploaded_Date == null)
													{
														selectedRows = Travel_Selected_Options[ID == input.ID];
														if(selectedRows.count() > 0)
														{
															selectedRows.Booking_Uploaded_Date=zoho.currentdate;
														}
													}
													estimatedTotal = 0;
													actualTotal = 0;
													optionRows = Travel_Selected_Options[Travel_Request == input.Travel_Request];
													for each  optionRec in optionRows
													{
														estimatedTotal = estimatedTotal + ifnull(optionRec.Estimated_Cost,0);
														actualTotal = actualTotal + ifnull(optionRec.Actual_Cost,0);
													}
													parentRequests = Travel_Request[ID == input.Travel_Request];
													if(parentRequests.count() > 0)
													{
														parentRequests.Total_Estimated_Cost=estimatedTotal;
														parentRequests.Total_Actual_Cost=actualTotal;
													}
													thisapp.Add_Audit_Log("TRAVEL_SELECTED_OPTION_SAVED","Travel","Travel_Selected_Options",input.ID,"Save","","","Selected travel option saved and totals recalculated.",true,"");
									)
								}
							}
			
						
			}

			Travel_Selected_Options_On_Validate as "Travel Selected Options - On Validate"
			{
			
							type =  form
							form = Travel_Selected_Options
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Actual_Cost < 0)
													{
														alert "Actual cost cannot be negative.";
														cancel submit;
													}
													parentRequests = Travel_Request[ID == input.Travel_Request];
													if(parentRequests.count() > 0)
													{
														if(parentRequests.Status != "Pending_HR" && parentRequests.Status != "Approved" && parentRequests.Status != "Bills_Pending")
														{
															alert "Selected travel options can be changed only during HR booking or bill processing stages.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}
		}

		schedule
		{
			schedule_announcement_reminder as "Announcement Reminder"
			{
			
							type =  schedule
							start = "2025-01-01 09:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									pendingRows = Announcement_Acknowledgement[Acknowledged == false];
													if(pendingRows.count() > 0)
													{
														tokenMap = Map();
														tokenMap.put("pending_count",pendingRows.count());
														thisapp.Send_Configured_Notification("ANNOUNCEMENT_ACK_REMINDER",tokenMap,"Pending announcement acknowledgements","There are {{pending_count}} pending announcement acknowledgements.");
													}
								)
								}
							}
						
			}

			schedule_appraisal_reminders as "Appraisal Reminders"
			{
			
							type =  schedule
							start = "2025-01-01 09:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									activeCycles = Appraisal_Config[Is_Active == true && Window_Start <= zoho.currentdate && Manager_Scoring_End >= zoho.currentdate];
													reminderCount = activeCycles.count();
													thisapp.Add_Audit_Log("APPRAISAL_REMINDER","Performance","Appraisal_Config",0,"Reminder","","","Reminder audit only. Active appraisal cycles in window: " + reminderCount + ".",true,"");
								)
								}
							}
						
			}

			schedule_comp_off_expiry as "Comp Off Expiry"
			{
			
							type =  schedule
							start = "2025-01-01 07:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									expiredCount = 0;
													for each  balanceRec in Leave_Balance[Comp_Off_Expiry_Date != null && Comp_Off_Expiry_Date < zoho.currentdate && Balance_Days > 0]
													{
														leaveTypeRows = Leave_Type_Config[ID == balanceRec.Leave_Type];
														if(leaveTypeRows.count() > 0 && leaveTypeRows.Leave_Type_Name == "Comp_Off")
														{
															oldBalance = ifnull(balanceRec.Balance_Days,0);
															balanceRec.Balance_Days=0;
															balanceRec.Comp_Off_Expiry_Date=null;
															expiredCount = expiredCount + 1;
															thisapp.Add_Audit_Log("COMP_OFF_EXPIRED","Attendance_Leave","Leave_Balance",balanceRec.ID,"Expire",oldBalance,"0","Expired comp-off balance.",true,"");
														}
													}
													thisapp.Add_Audit_Log("COMP_OFF_EXPIRY_SUMMARY","Attendance_Leave","Leave_Balance",0,"Expiry Summary","","","Comp-off expiry changed " + expiredCount + " balances.",true,"");
								)
								}
							}
						
			}

			schedule_daily_attendance_fetch as "Daily Attendance Fetch"
			{
			
							type =  schedule
							start = "2025-01-01 23:59:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									// TODO: Integrate biometric attendance API when credentials, endpoint, and mapping are confirmed.
													// TODO: Upsert only biometric punches and never overwrite Manual or Regularised rows.
													// IMPORTANT: This stub intentionally does not mark Not_Marked rows as Absent.
													thisapp.Add_Audit_Log("ATTENDANCE_FETCH_STUB","Attendance","Attendance_Log",0,"Fetch Stub","","","Biometric fetch is a TODO stub; no attendance rows were changed.",true,"");
								)
								}
							}
						
			}

			schedule_daily_attendance_prefill as "Daily Attendance Prefill"
			{
			
							type =  schedule
							start = "2025-01-01 06:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									createdCount = 0;
													for each  employeeRec in Employee_Master[Employment_Status in {"Active","Probation"}]
													{
														existingAttendance = Attendance_Log[Employee == employeeRec.ID && Attendance_Date == zoho.currentdate];
														if(existingAttendance.count() == 0)
														{
															insertedAttendanceId = insert into Attendance_Log
															[
																Employee=employeeRec.ID
																Attendance_Date=zoho.currentdate
																Attendance_Status="Not_Marked"
																Source="System"
																Added_User=zoho.loginuser
															];
															createdCount = createdCount + 1;
														}
													}
													thisapp.Add_Audit_Log("ATTENDANCE_PREFILL","Attendance","Attendance_Log",0,"Prefill","","Not_Marked","Daily attendance prefill created " + createdCount + " rows.",true,"");
								)
								}
							}
						
			}

			schedule_employee_deactivation as "Employee Deactivation"
			{
			
							type =  schedule
							start = "2025-01-01 23:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									deactivatedCount = 0;
													blockedCount = 0;
													for each  resignationRec in Resignation_Request[Status == "Approved" && Effective_LWD <= zoho.currentdate]
													{
														pendingChecklist = Offboarding_Checklist[Resignation_Request == resignationRec.ID && Status == "Pending"];
														pendingAssets = Employee_Asset_Recovery[Resignation_Request == resignationRec.ID && Recovery_Status == "Pending"];
														employeeRows = Employee_Master[ID == resignationRec.Employee];
														if(employeeRows.count() > 0)
														{
															if(pendingChecklist.count() == 0 && pendingAssets.count() == 0)
															{
																if(employeeRows.Employment_Status != "Inactive")
																{
																	employeeRows.Employment_Status="Inactive";
																	deactivatedCount = deactivatedCount + 1;
																}
															}
															else
															{
																blockedCount = blockedCount + 1;
															}
														}
													}
													if(deactivatedCount > 0)
													{
														thisapp.Add_Audit_Log("EMPLOYEE_DEACTIVATION","Offboarding","Employee_Master",0,"Deactivate","Active","Inactive","Deactivated " + deactivatedCount + " employees after completed offboarding.",true,"");
													}
													if(blockedCount > 0)
													{
														tokenMap = Map();
														tokenMap.put("blocked_count",blockedCount);
														thisapp.Send_Configured_Notification("OFFBOARDING_DEACTIVATION_BLOCKED",tokenMap,"Offboarding deactivation blocked","{{blocked_count}} employee deactivations are blocked by pending checklist or asset items.");
													}
								)
								}
							}
						
			}

			schedule_id_card_deactivation as "ID Card Deactivation"
			{
			
							type =  schedule
							start = "2025-01-01 00:01:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									deactivatedCount = 0;
													for each  cardRec in ID_Card_Request[Status == "Received" && Valid_Upto < zoho.currentdate]
													{
														cardRec.Status="Deactivated";
														deactivatedCount = deactivatedCount + 1;
													}
													if(deactivatedCount > 0)
													{
														thisapp.Add_Audit_Log("ID_CARD_DEACTIVATION","ID_Card","ID_Card_Request",0,"Deactivate","Received","Deactivated","Deactivated " + deactivatedCount + " expired ID cards.",true,"");
													}
								)
								}
							}
						
			}

			schedule_id_card_renewal_reminder as "ID Card Renewal Reminder"
			{
			
							type =  schedule
							start = "2025-01-01 09:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									soonDate = zoho.currentdate.addDay(30);
													expiringCards = ID_Card_Request[Status == "Received" && Valid_Upto <= soonDate && Valid_Upto >= zoho.currentdate];
													if(expiringCards.count() > 0)
													{
														tokenMap = Map();
														tokenMap.put("expiring_count",expiringCards.count());
														thisapp.Send_Configured_Notification("ID_CARD_RENEWAL_REMINDER",tokenMap,"ID cards expiring soon","{{expiring_count}} ID cards expire within the next 30 days.");
													}
								)
								}
							}
						
			}

			schedule_lock_kpi_on_window_open as "Lock KPI On Window Open"
			{
			
							type =  schedule
							start = "2025-01-01 00:01:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									lockedCount = 0;
													activeCycles = Appraisal_Config[Is_Active == true && Window_Start <= zoho.currentdate];
													for each  cycleRec in activeCycles
													{
														for each  kpiRec in KPI_KRA[Appraisal_Config == cycleRec.ID && Is_Locked == false]
														{
															kpiRec.Is_Locked=true;
															lockedCount = lockedCount + 1;
														}
													}
													thisapp.Add_Audit_Log("KPI_LOCKED","Performance","KPI_KRA",0,"Lock","Unlocked","Locked","KPI/KRA lock schedule locked " + lockedCount + " records.",true,"");
								)
								}
							}
						
			}

			schedule_monthly_leave_credit as "Monthly Leave Credit"
			{
			
							type =  schedule
							start = "2025-01-01 06:00:00"
							frequency = monthly
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									creditedCount = 0;
													for each  leaveTypeRec in Leave_Type_Config[Is_Active == true && Credit_Frequency == "Monthly"]
													{
														for each  employeeRec in Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"]
														{
															shouldCredit = true;
															if(leaveTypeRec.Credit_After_15th == true && employeeRec.Date_Of_Joining != null)
															{
																if(employeeRec.Date_Of_Joining.getMonth() == zoho.currentdate.getMonth() && employeeRec.Date_Of_Joining.getYear() == zoho.currentdate.getYear() && employeeRec.Date_Of_Joining.getDay() > 15)
																{
																	shouldCredit = false;
																}
															}
															if(shouldCredit == true)
															{
																balanceRows = Leave_Balance[Employee == employeeRec.ID && Leave_Type == leaveTypeRec.ID];
																creditQty = ifnull(leaveTypeRec.Credit_Quantity,0);
																maxAllowed = ifnull(leaveTypeRec.Max_Balance,0);
																if(balanceRows.count() == 0)
																{
																	startingBalance = creditQty;
																	if(maxAllowed > 0 && startingBalance > maxAllowed)
																	{
																		startingBalance = maxAllowed;
																	}
																	insertedBalanceId = insert into Leave_Balance
																	[
																		Employee=employeeRec.ID
																		Leave_Type=leaveTypeRec.ID
																		Balance_Days=startingBalance
																		Used_Days=0
																		Credited_Days=creditQty
																		Last_Credited_Date=zoho.currentdate
																		Added_User=zoho.loginuser
																	];
																	creditedCount = creditedCount + 1;
																}
																else
																{
																	for each  balanceRec in balanceRows
																	{
																		oldBalance = ifnull(balanceRec.Balance_Days,0);
																		newBalance = oldBalance + creditQty;
																		if(maxAllowed > 0 && newBalance > maxAllowed)
																		{
																			newBalance = maxAllowed;
																		}
																		if(newBalance != oldBalance || balanceRec.Last_Credited_Date != zoho.currentdate)
																		{
																			balanceRec.Balance_Days=newBalance;
																			balanceRec.Credited_Days=ifnull(balanceRec.Credited_Days,0) + creditQty;
																			balanceRec.Last_Credited_Date=zoho.currentdate;
																			creditedCount = creditedCount + 1;
																		}
																	}
																}
															}
														}
													}
													thisapp.Add_Audit_Log("LEAVE_MONTHLY_CREDIT","Attendance_Leave","Leave_Balance",0,"Monthly Credit","","","Monthly leave credit changed " + creditedCount + " balances.",true,"");
								)
								}
							}
						
			}

			schedule_next_day_attendance_notify as "Next Day Attendance Notify"
			{
			
							type =  schedule
							start = "2025-01-01 08:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									previousAttendanceDate = zoho.currentdate.addDay(-1);
													pendingCount = Attendance_Log[Attendance_Date == previousAttendanceDate && Attendance_Status == "Not_Marked"].count();
													thisapp.Add_Audit_Log("ATTENDANCE_NEXT_DAY_REMINDER","Attendance","Attendance_Log",0,"Reminder","","Not_Marked","Reminder audit only. Pending previous-day attendance rows: " + pendingCount + ".",true,"");
								)
								}
							}
						
			}

			schedule_offboarding_checklist_trigger as "Offboarding Checklist Trigger"
			{
			
							type =  schedule
							start = "2025-01-01 07:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									createdCount = 0;
													triggerDate = zoho.currentdate.addDay(7);
													for each  resignationRec in Resignation_Request[Status == "Approved" && Effective_LWD == triggerDate]
													{
														existingTasks = Offboarding_Checklist[Resignation_Request == resignationRec.ID];
														if(existingTasks.count() == 0)
														{
															employeeRows = Employee_Master[ID == resignationRec.Employee];
															for each  configRec in Offboarding_Checklist_Config[Is_Active == true]
															{
																insertedChecklistId = insert into Offboarding_Checklist
																[
																	Resignation_Request=resignationRec.ID
																	Checklist_Item=configRec.ID
																	Responsible_Department=configRec.Responsible_Department
																	Status="Pending"
																	Added_User=zoho.loginuser
																];
																createdCount = createdCount + 1;
															}
														}
													}
													if(createdCount > 0)
													{
														thisapp.Add_Audit_Log("OFFBOARDING_CHECKLIST_TRIGGER","Offboarding","Offboarding_Checklist",0,"Create","","Pending","Created " + createdCount + " offboarding checklist rows.",true,"");
													}
								)
								}
							}
						
			}

			schedule_offboarding_daily_reminder as "Offboarding Daily Reminder"
			{
			
							type =  schedule
							start = "2025-01-01 09:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									pendingItems = Offboarding_Checklist[Status == "Pending"];
													if(pendingItems.count() > 0)
													{
														tokenMap = Map();
														tokenMap.put("pending_count",pendingItems.count());
														thisapp.Send_Configured_Notification("OFFBOARDING_DAILY_REMINDER",tokenMap,"Pending offboarding checklist items","There are {{pending_count}} pending offboarding checklist items.");
													}
								)
								}
							}
						
			}

			schedule_regularisation_reminder as "Regularisation Reminder"
			{
			
							type =  schedule
							start = "2025-01-01 09:00:00"
							frequency = daily
							time zone = "Asia/Kolkata"
							on start
							{
								actions 
								{
								on load
								(
									reminderDay = zoho.currentdate.getDay();
													if(reminderDay == 13 || reminderDay == 28)
													{
														pendingCount = Attendance_Log[Attendance_Date < zoho.currentdate && Attendance_Status == "Not_Marked"].count();
														thisapp.Add_Audit_Log("ATTENDANCE_REGULARISATION_REMINDER","Attendance","Attendance_Log",0,"Reminder","","Not_Marked","Regularisation reminder audit only. Pending rows: " + pendingCount + ".",true,"");
													}
								)
								}
							}
						
			}

