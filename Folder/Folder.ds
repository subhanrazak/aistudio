iv&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Travel_Home
		{
					displayname = "Travel Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Travel_Home_Snippet' elementName='Travel_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Travel_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginRole = ifnull(thisapp.permissions.loginUserProfile(),&quot;&quot;);\n\tisAdmin = loginRole == &quot;Administrator&quot; || loginRole == &quot;Admin&quot;;\n\tisHR = loginRole == &quot;HR_ADMIN&quot; || isAdmin;\n\tloginEmail = ifnull(zoho.loginuserid,zoho.loginuser);\n\temployeeRows = Employee_Master[Official_Email == loginEmail];\n\tmyTravelCount = 0;\n\tif(employeeRows.count() &gt; 0)\n\t{\n\t\tmyTravelCount = Travel_Request[Employee == employeeRows.ID].count();\n\t}\n\ttotalTravel = Travel_Request.count();\n\tpendingManagerTravel = Travel_Request[Status == &quot;Pending_Manager&quot;].count();\n\tpendingCEOTravel = Travel_Request[Status == &quot;Pending_CEO&quot;].count();\n\tpendingHRTravel = Travel_Request[Status == &quot;Pending_HR&quot;].count();\n\tapprovedTravel = Travel_Request[Status == &quot;Approved&quot; || Status == &quot;Bills_Pending&quot;].count();\n\tbillsPendingTravel = Travel_Request[Status == &quot;Bills_Pending&quot;].count();\n\tbillsUploadedTravel = Travel_Request[Status == &quot;Bills_Uploaded&quot;].count();\n\trequirementCount = Travel_Requirements.count();\n\trecommendationCount = Travel_HR_Recommendations.count();\n\tselectedRecommendationCount = Travel_HR_Recommendations[Is_Selected == true].count();\n\tselectedOptionCount = Travel_Selected_Options.count();\n\testimatedTotal = 0;\n\tactualTotal = 0;\n\tfor each  travelRec in Travel_Request[ID != 0]\n\t{\n\t\testimatedTotal = estimatedTotal + ifnull(travelRec.Total_Estimated_Cost,0);\n\t\tactualTotal = actualTotal + ifnull(travelRec.Total_Actual_Cost,0);\n\t}\n\t%&gt;\n&lt;style&gt;\n/* ===== zcs-global utility stylesheet included once for Travel_Home ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }\na { text-decoration: none; }\n.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-14 { gap: .875rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mb-12 { margin-bottom: .75rem; } .zcs-mb-16 { margin-bottom: 1rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }\n.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-36 { font-size: 2.25rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }\n/* ZCS component CSS: header-heading-with-actions and buttons */\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }\n/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */\n.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }\n/* ZCS component CSS: quick actions and workspace cards */\n.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n/* Travel Home layout */\n.th-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }\n.th-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #0F766E); }\n.th-hero:after { content: &quot;&quot;; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }\n.th-hero:before { content: &quot;&quot;; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }\n.th-hero-content { position: relative; z-index: 1; }\n.th-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }\n.th-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.th-kpi { grid-column: span 3; min-height: 118px; }\n.th-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }\n.th-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }\n.th-workspace { grid-column: span 9; overflow: hidden; }\n.th-actions { grid-column: span 3; }\n.th-tab-input { display: none; }\n.th-tabbar { overflow-x: auto; }\n.th-tabbar label { cursor: pointer; border-bottom: 2px solid transparent; }\n.th-panel { display: none; padding: 18px; }\n#th-tab-overview:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-overview&apos;], #th-tab-my:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-my&apos;], #th-tab-hr:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-hr&apos;], #th-tab-children:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-children&apos;], #th-tab-selection:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-selection&apos;], #th-tab-kanban:checked ~ .zcs-horizontal-tabpanel label[for=&apos;th-tab-kanban&apos;] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }\n#th-tab-overview:checked ~ .th-panels .th-panel-overview, #th-tab-my:checked ~ .th-panels .th-panel-my, #th-tab-hr:checked ~ .th-panels .th-panel-hr, #th-tab-children:checked ~ .th-panels .th-panel-children, #th-tab-selection:checked ~ .th-panels .th-panel-selection, #th-tab-kanban:checked ~ .th-panels .th-panel-kanban { display: block; }\n.th-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); margin-bottom: 18px; }\n.th-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }\n.th-report-frame { min-height: 620px; width: 100%; }\n.th-report-frame.tall { min-height: 700px; }\n.th-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }\n.th-tool-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FFFFFF; padding: 18px; }\n.th-tool-input { width: 100%; height: 40px; border: 1px solid var(--zcs-border-color); border-radius: 8px; box-sizing: border-box; padding: 0 12px; color: var(--zcs-primary-text-color); background: #FFFFFF; font: inherit; }\n.th-tool-input:focus { outline: 2px solid var(--zcs-theme-brand-color); outline-offset: 1px; }\n.th-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }\n.th-access-note { border: 1px solid #FAAE13; background: #FCF4E6; color: #7E5608; border-radius: 12px; }\n.th-status-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.th-status-item { background: #FFFFFF; border: 1px solid var(--zcs-border-color); border-radius: 12px; padding: 14px; }\n@media (max-width: 1180px) { .th-kpi { grid-column: span 6; } .th-workspace, .th-actions { grid-column: span 12; } }\n@media (max-width: 760px) { .th-page { padding: 14px; } .th-hero { padding: 18px; } .th-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .th-kpi { grid-column: span 12; } .th-panel { padding: 12px; } .th-mini-grid, .th-status-strip { grid-template-columns: 1fr; } .th-report-frame { min-height: 520px; } }\n&lt;/style&gt;\n\n&lt;script&gt;\nfunction thOpenParamPage(pageName, paramName, inputId) {\n\tvar inputEl = document.getElementById(inputId);\n\tvar value = inputEl ? inputEl.value : &quot;&quot;;\n\tif (value &amp;&amp; value.trim() !== &quot;&quot;) {\n\t\twindow.location.hash = &quot;#Page:&quot; + pageName + &quot;?&quot; + paramName + &quot;=&quot; + encodeURIComponent(value.trim());\n\t}\n\telse {\n\t\twindow.location.hash = &quot;#Page:&quot; + pageName;\n\t}\n\treturn false;\n}\n&lt;/script&gt;\n\n&lt;div class=&quot;th-page zcs-flex zcs-direction-column zcs-gap-18&quot;&gt;\n\t&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Travel Home&lt;/h5&gt;\n\t\t\t&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;Travel workspace for employee requests, HR recommendations, option selections, booking rows, bills, and status boards&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row&quot;&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Form:Travel_Request?zc_LoadIn=dialog&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Raise Travel Request&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Report:My_Travel_Requests&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline transport-road&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;My Requests&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;section class=&quot;th-hero&quot;&gt;\n\t\t&lt;div class=&quot;th-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-8&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold&quot;&gt;IITB HR Travel&lt;/span&gt;\n\t\t\t\t&lt;h3 class=&quot;zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0&quot;&gt;Manage travel approvals, HR options, selections, booking documents, and bills&lt;/h3&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-15&quot;&gt;Use the tabs below to review request queues, add requirement and recommendation rows, open the employee selection page, and monitor travel Kanban boards.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-no-shrink&quot; href=&quot;#Report:HR_All_Travel&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;zcs-button-text&quot;&gt;Open HR Travel Queue&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/section&gt;\n\n\t&lt;section class=&quot;th-grid&quot;&gt;\n\t\t&lt;article class=&quot;th-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;th-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline transport-road zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;My Trips&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;th-kpi-value zcs-color-primary&quot;&gt;&lt;%=myTravelCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Logged-in employee travel requests&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;th-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;th-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Pending Reviews&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;th-kpi-value zcs-color-primary&quot;&gt;&lt;%=pendingManagerTravel + pendingCEOTravel + pendingHRTravel%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=pendingManagerTravel%&gt; manager, &lt;%=pendingCEOTravel%&gt; CEO, &lt;%=pendingHRTravel%&gt; HR&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;th-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;th-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-single-copy-04 zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Options&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;th-kpi-value zcs-color-primary&quot;&gt;&lt;%=recommendationCount%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=selectedRecommendationCount%&gt; selected recommendations, &lt;%=selectedOptionCount%&gt; selected option rows&lt;/span&gt;\n\t\t&lt;/article&gt;\n\t\t&lt;article class=&quot;th-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;th-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-22&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Bills&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;th-kpi-value zcs-color-primary&quot;&gt;&lt;%=billsPendingTravel%&gt;&lt;/div&gt;\n\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=billsUploadedTravel%&gt; bill uploads submitted, INR &lt;%=actualTotal%&gt; actual total&lt;/span&gt;\n\t\t&lt;/article&gt;\n\n\t\t&lt;section class=&quot;th-workspace zcs-card zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;th-tabs-shell&quot;&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-overview&quot; checked&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-my&quot;&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-hr&quot;&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-children&quot;&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-selection&quot;&gt;\n\t\t\t\t&lt;input class=&quot;th-tab-input&quot; type=&quot;radio&quot; name=&quot;th-tabs&quot; id=&quot;th-tab-kanban&quot;&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full&quot;&gt;\n\t\t\t\t\t&lt;ul class=&quot;zcs-horizontal-tabhead th-tabbar zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-overview&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-dashboard-level&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Overview&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-my&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline transport-road&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;My Requests&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-hr&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline users-single-05&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;HR Travel&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-children&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Requirements and Options&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-selection&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Selection Page&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t\t&lt;li class=&quot;zcs-horizontal-tabitem&quot;&gt;&lt;label for=&quot;th-tab-kanban&quot; class=&quot;zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary&quot;&gt;&lt;i class=&quot;zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-horizontal-tabtext zcs-font-15&quot;&gt;Kanban&lt;/span&gt;&lt;/label&gt;&lt;/li&gt;\n\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;th-panels&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-overview&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-status-strip zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;All travel&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-primary&quot;&gt;&lt;%=totalTravel%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Approved and bills pending&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-green&quot;&gt;&lt;%=approvedTravel%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Requirement rows&lt;/span&gt;&lt;div class=&quot;zcs-font-24 zcs-font-bold zcs-color-blue&quot;&gt;&lt;%=requirementCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-status-item&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Estimated total&lt;/span&gt;&lt;div class=&quot;zcs-font-20 zcs-font-bold zcs-color-primary&quot;&gt;INR &lt;%=estimatedTotal%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-mini-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline transport-road zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Employee request flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Employees raise travel requests, monitor approval status, review HR recommendations, confirm one option per requirement, and upload bills when status reaches Bills_Pending.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Form:Travel_Request?zc_LoadIn=dialog&quot;&gt;Raise Request&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:My_Travel_Requests&quot;&gt;My Requests&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-05 zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR booking flow&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;HR reviews approved travel, adds requirement recommendations, monitors employee selections, fills selected option actuals and booking documents, and marks completion for bills.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-gap-10 zcs-row&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:HR_All_Travel&quot;&gt;HR All Travel&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:Travel_HR_Recommendations_List&quot;&gt;Recommendations&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Selection page pattern&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Travel_Selection_Page opens with a travel_request_id parameter and handles option selection, selected-option row creation, totals, notification, and audit logging.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;label class=&quot;zcs-font-13 zcs-color-secondary&quot; for=&quot;th-overview-travel-id&quot;&gt;Travel Request ID&lt;/label&gt;\n\t\t\t\t\t\t\t\t&lt;input class=&quot;th-tool-input&quot; type=&quot;number&quot; id=&quot;th-overview-travel-id&quot; placeholder=&quot;Travel Request ID&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Page:Travel_Selection_Page&quot; onclick=&quot;return thOpenParamPage(&apos;Travel_Selection_Page&apos;,&apos;travel_request_id&apos;,&apos;th-overview-travel-id&apos;);&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Selection Page&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-22 zcs-color-theme&quot;&gt;&lt;/i&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Bills and reimbursement handoff&lt;/h4&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;When travel is completed, bills are uploaded from My_Travel_Requests and finance can continue through the linked reimbursement flow.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Report:My_Travel_Requests&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Bills Queue&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-my&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;My Travel Requests&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employee-facing travel status, bills upload, and read-only history after submission.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;My_Travel_Requests&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-hr&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;HR All Travel&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;HR queue for approvals, booking completion, bills status, estimated totals, and actual totals.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame tall&quot; zc-component=&quot;report&quot; zc-linkname=&quot;HR_All_Travel&quot; zc-height=&quot;700px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-children&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Travel Requirements List&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Child rows for flights, trains, hotel, car rental, and other trip requirements.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_Requirements_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Travel HR Recommendations List&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;HR-proposed options per requirement with vendor, timing, cost, and selection status.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_HR_Recommendations_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Travel Selected Options List&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Confirmed selected options, actual cost, booking reference, and booking document rows.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_Selected_Options_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-selection&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-mini-grid zcs-mb-16&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Open Travel Selection Page&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;Enter a Travel_Request record ID. The page parameter must be travel_request_id.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;input class=&quot;th-tool-input&quot; type=&quot;number&quot; id=&quot;th-travel-id&quot; placeholder=&quot;Travel Request ID&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14&quot; href=&quot;#Page:Travel_Selection_Page&quot; onclick=&quot;return thOpenParamPage(&apos;Travel_Selection_Page&apos;,&apos;travel_request_id&apos;,&apos;th-travel-id&apos;);&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-right&quot;&gt;&lt;/i&gt;&lt;span&gt;Open Selection Page&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;th-tool-card zcs-flex zcs-direction-column zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Selection readiness checklist&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-m-0&quot;&gt;The request should have at least one Travel_Requirements row, HR should add Travel_HR_Recommendations rows, and the employee should select one option per requirement.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;th-note zcs-p-14 zcs-font-13 zcs-color-secondary&quot;&gt;Use the Requirements and Options tab to verify child rows before sending the employee to the selection page.&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Selected Options Reference&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;After confirmation, selected option rows appear here for HR booking follow-up.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_Selected_Options_List&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t&lt;div class=&quot;th-panel th-panel-kanban&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Travel Status Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Request pipeline across manager, CEO, HR, approved, bills, processed, and rejected statuses.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_Status_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;th-embed-card&quot;&gt;&lt;div class=&quot;th-embed-header zcs-px-20 zcs-py-12&quot;&gt;&lt;h4 class=&quot;zcs-font-18 zcs-font-semibold zcs-m-0&quot;&gt;Travel Recommendation Kanban&lt;/h4&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;HR recommendation board grouped by selection state.&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;th-report-frame&quot; zc-component=&quot;report&quot; zc-linkname=&quot;Travel_Recommendation_Kanban&quot; zc-height=&quot;620px&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;aside class=&quot;th-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Quick actions&lt;/h5&gt;\n\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0&quot;&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Travel_Request?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Raise travel request&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:My_Travel_Requests&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline transport-road&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open my travel requests&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:HR_All_Travel&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-05&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open HR all travel&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Travel_HR_Recommendations?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline files-single-copy-04&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add HR recommendation&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Form:Travel_Selected_Options?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Add selected option&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t&lt;li class=&quot;zcs-quick-action-item&quot;&gt;&lt;a class=&quot;zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary&quot; href=&quot;#Report:Travel_Status_Kanban&quot;&gt;&lt;i class=&quot;zcs-quick-action-icon zcs-font-medium zc-li-outline design-app&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-quick-action-text&quot;&gt;Open travel Kanban&lt;/span&gt;&lt;/a&gt;&lt;/li&gt;\n\t\t\t&lt;/ul&gt;\n\t\t\t&lt;div class=&quot;th-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-font-semibold zcs-color-primary&quot;&gt;Bills workflow&lt;/span&gt;\n\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Employees upload bills from My_Travel_Requests when a trip moves to Bills_Pending. HR and finance can monitor progress from HR_All_Travel.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\tif(!isHR)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;th-access-note zcs-p-14 zcs-font-13&quot;&gt;Some HR recommendation, booking, and all-travel records may be restricted by profile permissions.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/aside&gt;\n\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Travel_Selection_Page(string confirm_selection, string selections, int travel_request_id)
		{
					displayname = "Travel Selection Page"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Travel_Selection_Page_Snippet' elementName='Travel_Selection_Page_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Travel_Selection_Page_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tloginEmail = zoho.loginuserid;\n\tif(loginEmail == null || loginEmail == &quot;&quot;)\n\t{\n\t\tloginEmail = zoho.loginuser;\n\t}\n\trequestIdParam = input.travel_request_id;\n\ttripRows = Travel_Request[ID == requestIdParam];\n\tsubmitted = ifnull(input.confirm_selection,&quot;&quot;);\n\tselectedParam = ifnull(input.selections,&quot;&quot;);\n\tselectedMap = Map();\n\tif(selectedParam != &quot;&quot;)\n\t{\n\t\tselectedPairs = selectedParam.toList(&quot;,&quot;);\n\t\tfor each  selectedPair in selectedPairs\n\t\t{\n\t\t\tselectedTokens = selectedPair.toList(&quot;:&quot;);\n\t\t\tif(selectedTokens.size() == 2)\n\t\t\t{\n\t\t\t\tselectedMap.put(selectedTokens.get(0),selectedTokens.get(1));\n\t\t\t}\n\t\t}\n\t}\n\tconfirmMessage = &quot;&quot;;\n\tconfirmSuccess = false;\n\tconfirmClass = &quot;info&quot;;\n\tconfirmIcon = &quot;ui-1-alert-circle-i&quot;;\n\t%&gt;\n&lt;style&gt;\n/* zcs-global utility stylesheet included once for this page */\n:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-teritiary-text-color:var(--zcs_tertiary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color);--zcs-page-bg-color:#F3F3F4}.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-14{gap:.875rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-5{padding-top:.3125rem;padding-bottom:.3125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-6{margin-top:.375rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-14{margin-top:.875rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mt-24{margin-top:1.5rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-relative{position:relative}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}\n/* ZCS component CSS: button-primary-button / button-primary-outline-button */\n.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:0}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-button[disabled],button.zcs-button:disabled{opacity:.55;cursor:not-allowed}\n/* ZCS component CSS: badge-filled-badge */\n.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}\n/* Page-specific layout using ZCS classes */\n.travel-selection-page{min-height:100%;background:var(--zcs-page-bg-color);color:var(--zcs-primary-text-color);font-family:inherit}.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}.quick-actions{flex-wrap:wrap}.travel-content{padding:24px 30px}.travel-layout{display:grid;grid-template-columns:minmax(270px,360px) 1fr;gap:20px;align-items:start}.trip-card{position:sticky;top:16px}.summary-list{display:grid;grid-template-columns:1fr;gap:12px}.summary-item{background:#F9FAFE;border:1px solid #eef0f6;border-radius:10px;padding:12px}.requirement-card{background:#fff;border:1px solid #e7e7ee;border-radius:14px;box-shadow:0 2px 10px rgba(18,19,43,.04);overflow:hidden}.requirement-head{background:linear-gradient(90deg,var(--zcs_brand_light_color),#fff);border-bottom:1px solid #ececf3}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.radio-wrap input[type=&apos;radio&apos;]{position:absolute;opacity:0;pointer-events:none}.option-card{display:block;height:100%;border:1px solid #e3e6ef;border-radius:12px;background:#fff;cursor:pointer;transition:border-color .16s ease,box-shadow .16s ease,transform .16s ease;overflow:hidden}.option-card:hover{border-color:var(--zcs_brand_color);box-shadow:0 8px 20px rgba(18,19,43,.08);transform:translateY(-1px)}.radio-wrap input[type=&apos;radio&apos;]:checked+.option-card{border:2px solid var(--zcs_brand_color);box-shadow:0 0 0 3px var(--zcs_brand_light_color)}.radio-wrap input[type=&apos;radio&apos;]:disabled+.option-card{opacity:.65;cursor:not-allowed;transform:none}.option-top{border-bottom:1px solid #eef0f6}.option-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.meta-cell{background:#F9FAFE;border:1px solid #eef0f6;border-radius:9px;padding:10px}.radio-dot{width:22px;height:22px;border-radius:50%;border:2px solid var(--zcs_tertiary_border_color);background:#fff}.radio-wrap input[type=&apos;radio&apos;]:checked+.option-card .radio-dot{border-color:var(--zcs_brand_color);background:radial-gradient(circle at center,var(--zcs_brand_color) 0 42%,transparent 46%)}.confirm-banner{border-radius:12px;padding:14px 16px;border:1px solid}.confirm-banner.success{background:#E4FCF3;border-color:#179E6C;color:#0F704D}.confirm-banner.error{background:#FDE3E6;border-color:#FE455D;color:#A60E25}.confirm-banner.info{background:#E8EFFF;border-color:#2A6FFC;color:#19499E}.empty-state{min-height:320px;background:#fff;border:1px solid #e7e7ee;border-radius:14px}.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.submit-panel{background:#fff;border:1px solid #e7e7ee;border-radius:14px;position:sticky;bottom:16px;box-shadow:0 6px 18px rgba(18,19,43,.08)}.related-link{border:1px solid #ececf3;border-radius:10px;color:var(--zcs-primary-text-color);background:#fff}.related-link:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.warning-note{background:#FCF4E6;border:1px solid #FAAE13;color:#7E5608;border-radius:10px;padding:12px}.selected-pill{background:var(--zcs_brand_light_color);color:var(--zcs_brand_color);border-radius:999px;padding:4px 10px}.cost-text{color:#179E6C}.subtle-line{height:1px;background:#ececf3;width:100%}\n@media (max-width:1100px){.travel-layout{grid-template-columns:1fr}.trip-card{position:static}.option-grid{grid-template-columns:1fr}.submit-panel{position:static}}\n@media (max-width:700px){.travel-content{padding:16px}.zcs-page-header{padding:16px;align-items:flex-start;flex-direction:column}.quick-actions{width:100%}.zcs-page-header .quick-actions .zcs-button,.submit-panel .zcs-button{width:100%;justify-content:center}.submit-panel{align-items:stretch;flex-direction:column}.option-meta{grid-template-columns:1fr}}\n&lt;/style&gt;\n\n&lt;div class=&quot;travel-selection-page&quot;&gt;\n&lt;%\n\tif(tripRows.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Select Travel Options&lt;/h5&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;#Report:My_Travel_Requests?zc_LoadIn=dialog&amp;zc_Header=true&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline transport-road&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;My Travel Requests&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div class=&apos;travel-content&apos;&gt;\n\t\t&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-circle-remove zcs-font-40&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;Travel request not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;Open this page with a valid travel_request_id to review HR-proposed options.&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\ttrip = tripRows;\n\t\temployeeName = &quot;-&quot;;\n\t\temployeeEmail = &quot;&quot;;\n\t\temployeeDepartment = &quot;-&quot;;\n\t\temployeeRows = Employee_Master[ID == trip.Employee];\n\t\tif(employeeRows.count() &gt; 0)\n\t\t{\n\t\t\temployeeName = ifnull(employeeRows.Full_Name,&quot;-&quot;);\n\t\t\temployeeEmail = ifnull(employeeRows.Official_Email,&quot;&quot;);\n\t\t\temployeeDepartment = ifnull(employeeRows.Department,&quot;-&quot;);\n\t\t}\n\t\trequirements = Travel_Requirements[Travel_Request == trip.ID] sort by Requirement_Type asc;\n\t\trecommendations = Travel_HR_Recommendations[Travel_Request == trip.ID] sort by Estimated_Cost asc;\n\t\tselectedOptions = Travel_Selected_Options[Travel_Request == trip.ID];\n\t\trequirementCount = requirements.count();\n\t\trecommendationCount = recommendations.count();\n\t\tselectedOptionCount = selectedOptions.count();\n\t\tisOwner = employeeEmail == loginEmail || employeeEmail == zoho.loginuser;\n\t\tisClosed = trip.Status == &quot;Rejected&quot; || trip.Status == &quot;Processed&quot; || trip.Status == &quot;Bills_Uploaded&quot;;\n\t\tcanConfirm = isOwner == true &amp;&amp; isClosed == false &amp;&amp; requirementCount &gt; 0 &amp;&amp; recommendationCount &gt; 0;\n\t\tstatusBadge = &quot;zcs-badge-blue&quot;;\n\t\tif(trip.Status == &quot;Approved&quot; || trip.Status == &quot;Bills_Pending&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(trip.Status == &quot;Rejected&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(trip.Status == &quot;Processed&quot; || trip.Status == &quot;Bills_Uploaded&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t\telse if(trip.Status == &quot;Pending_HR&quot; || trip.Status == &quot;Pending_CEO&quot; || trip.Status == &quot;Pending_Manager&quot;)\n\t\t{\n\t\t\tstatusBadge = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\ttravelReportUrl = &quot;#Report:My_Travel_Requests?ID=&quot; + trip.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\trequirementsUrl = &quot;#Report:Travel_Requirements_List?Travel_Request=&quot; + trip.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\trecommendationsUrl = &quot;#Report:Travel_HR_Recommendations_List?Travel_Request=&quot; + trip.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\tselectedUrl = &quot;#Report:Travel_Selected_Options_List?Travel_Request=&quot; + trip.ID + &quot;&amp;zc_LoadIn=dialog&amp;zc_Header=true&quot;;\n\t\tif(submitted == &quot;1&quot;)\n\t\t{\n\t\t\tif(canConfirm == false)\n\t\t\t{\n\t\t\t\tconfirmMessage = &quot;Selections cannot be confirmed for this request. Check request ownership, status, requirements, and available recommendations.&quot;;\n\t\t\t\tconfirmClass = &quot;error&quot;;\n\t\t\t\tconfirmIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tvalidationMessage = &quot;&quot;;\n\t\t\t\tselectionCount = 0;\n\t\t\t\tfor each  reqCheck in requirements\n\t\t\t\t{\n\t\t\t\t\tselectedValueCheck = ifnull(selectedMap.get(reqCheck.ID.toString()),&quot;&quot;);\n\t\t\t\t\treqRecsCheck = Travel_HR_Recommendations[Travel_Request == trip.ID &amp;&amp; Travel_Requirement == reqCheck.ID];\n\t\t\t\t\tif(reqRecsCheck.count() == 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;No HR recommendation exists for &quot; + reqCheck.Requirement_Type + &quot;. &quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(selectedValueCheck == &quot;&quot;)\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;Select one option for &quot; + reqCheck.Requirement_Type + &quot;. &quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse if(selectedValueCheck.isNumber() == false)\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;The selected option for &quot; + reqCheck.Requirement_Type + &quot; is invalid. &quot;;\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tselectedIdCheck = selectedValueCheck.toNumber();\n\t\t\t\t\t\tselectedRecCheck = Travel_HR_Recommendations[ID == selectedIdCheck &amp;&amp; Travel_Request == trip.ID &amp;&amp; Travel_Requirement == reqCheck.ID];\n\t\t\t\t\t\tif(selectedRecCheck.count() == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tvalidationMessage = validationMessage + &quot;The selected option for &quot; + reqCheck.Requirement_Type + &quot; is no longer available. &quot;;\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tselectionCount = selectionCount + 1;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(validationMessage != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tconfirmMessage = validationMessage;\n\t\t\t\t\tconfirmClass = &quot;error&quot;;\n\t\t\t\t\tconfirmIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\ttry \n\t\t\t\t\t{\n\t\t\t\t\t\tfor each  clearRec in Travel_HR_Recommendations[Travel_Request == trip.ID]\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tclearRec.Is_Selected=false;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor each  reqSave in requirements\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tselectedValueSave = ifnull(selectedMap.get(reqSave.ID.toString()),&quot;&quot;);\n\t\t\t\t\t\t\tselectedIdSave = selectedValueSave.toNumber();\n\t\t\t\t\t\t\tselectedRecRows = Travel_HR_Recommendations[ID == selectedIdSave &amp;&amp; Travel_Request == trip.ID &amp;&amp; Travel_Requirement == reqSave.ID];\n\t\t\t\t\t\t\tif(selectedRecRows.count() &gt; 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tselectedRec = selectedRecRows;\n\t\t\t\t\t\t\t\tselectedRec.Is_Selected=true;\n\t\t\t\t\t\t\t\texistingOptionRows = Travel_Selected_Options[Travel_Request == trip.ID &amp;&amp; Recommendation.Travel_Requirement == reqSave.ID];\n\t\t\t\t\t\t\t\tif(existingOptionRows.count() &gt; 0)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\texistingOptionRows.Recommendation=selectedRec.ID;\n\t\t\t\t\t\t\t\t\texistingOptionRows.Recommendation_Type=selectedRec.Recommendation_Type;\n\t\t\t\t\t\t\t\t\texistingOptionRows.Vendor_Or_Operator=selectedRec.Vendor_Or_Operator;\n\t\t\t\t\t\t\t\t\texistingOptionRows.Estimated_Cost=selectedRec.Estimated_Cost;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tinsert into Travel_Selected_Options\n\t\t\t\t\t\t\t\t\t[\n\t\t\t\t\t\t\t\t\t\tTravel_Request=trip.ID\n\t\t\t\t\t\t\t\t\t\tRecommendation=selectedRec.ID\n\t\t\t\t\t\t\t\t\t\tRecommendation_Type=selectedRec.Recommendation_Type\n\t\t\t\t\t\t\t\t\t\tVendor_Or_Operator=selectedRec.Vendor_Or_Operator\n\t\t\t\t\t\t\t\t\t\tEstimated_Cost=selectedRec.Estimated_Cost\n\t\t\t\t\t\t\t\t\t\tAdded_User=zoho.loginuser\n\t\t\t\t\t\t\t\t\t]\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\testimatedTotal = 0;\n\t\t\t\t\t\tactualTotal = 0;\n\t\t\t\t\t\trefreshedOptions = Travel_Selected_Options[Travel_Request == trip.ID];\n\t\t\t\t\t\tfor each  optionRec in refreshedOptions\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\testimatedTotal = estimatedTotal + ifnull(optionRec.Estimated_Cost,0);\n\t\t\t\t\t\t\tactualTotal = actualTotal + ifnull(optionRec.Actual_Cost,0);\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttrip.Total_Estimated_Cost=estimatedTotal;\n\t\t\t\t\t\ttrip.Total_Actual_Cost=actualTotal;\n\t\t\t\t\t\ttokenMap = Map();\n\t\t\t\t\t\ttokenMap.put(&quot;travel_request&quot;,trip.ID);\n\t\t\t\t\t\ttokenMap.put(&quot;destination&quot;,ifnull(trip.Destination,&quot;&quot;));\n\t\t\t\t\t\ttokenMap.put(&quot;employee&quot;,employeeName);\n\t\t\t\t\t\ttokenMap.put(&quot;employee_email&quot;,employeeEmail);\n\t\t\t\t\t\ttokenMap.put(&quot;selected_count&quot;,selectionCount);\n\t\t\t\t\t\ttokenMap.put(&quot;total_estimated_cost&quot;,estimatedTotal);\n\t\t\t\t\t\tthisapp.Send_Configured_Notification(&quot;TRAVEL_OPTIONS_SELECTED&quot;,tokenMap,&quot;Travel options selected&quot;,&quot;{{employee}} selected {{selected_count}} travel options for {{destination}}. Total estimated cost: {{total_estimated_cost}}.&quot;);\n\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;TRAVEL_OPTIONS_SELECTED&quot;,&quot;Travel&quot;,&quot;Travel_Request&quot;,trip.ID,&quot;Select Options&quot;,&quot;&quot;,&quot;Selected&quot;,&quot;Employee selected &quot; + selectionCount + &quot; HR-proposed travel options. Total estimated cost: &quot; + estimatedTotal,true,&quot;&quot;);\n\t\t\t\t\t\tconfirmMessage = &quot;Travel options confirmed. HR has been notified and estimated totals were recalculated.&quot;;\n\t\t\t\t\t\tconfirmSuccess = true;\n\t\t\t\t\t\tconfirmClass = &quot;success&quot;;\n\t\t\t\t\t\tconfirmIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\t\t\tselectedOptionCount = refreshedOptions.count();\n\t\t\t\t\t\tselectedOptions = refreshedOptions;\n\t\t\t\t\t}\t\t\t\t\tcatch (e)\n\t\t\t\t\t{\n\t\t\t\t\t\terrMsg = e.toString();\n\t\t\t\t\t\tthisapp.Add_Audit_Log(&quot;TRAVEL_OPTIONS_SELECTED&quot;,&quot;Travel&quot;,&quot;Travel_Request&quot;,trip.ID,&quot;Select Options&quot;,&quot;&quot;,&quot;&quot;,&quot;Travel option confirmation failed.&quot;,false,errMsg);\n\t\t\t\t\t\tconfirmMessage = &quot;Confirmation failed: &quot; + errMsg;\n\t\t\t\t\t\tconfirmClass = &quot;error&quot;;\n\t\t\t\t\t\tconfirmIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&apos;&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t&lt;h5 class=&apos;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;Select Travel Options&lt;/h5&gt;\n\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary&apos;&gt;Choose one HR-proposed option for each requirement before confirming.&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-12 quick-actions&apos;&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=travelReportUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline transport-road&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Travel Request&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;a class=&apos;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; href=&apos;&lt;%=recommendationsUrl%&gt;&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline files-single-copy-04&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Recommendations&lt;/span&gt;\n\t\t\t&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&apos;travel-content&apos;&gt;\n&lt;%\n\t\tif(confirmMessage != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;confirm-banner &lt;%=confirmClass%&gt; zcs-flex zcs-align-items-center zcs-gap-10 zcs-mb-0&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline &lt;%=confirmIcon%&gt; zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;&lt;%=confirmMessage%&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(isOwner == false)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;warning-note zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;This request belongs to &lt;%=employeeName%&gt;. You can review the options, but only the request employee can confirm selections.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(isClosed == true)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;warning-note zcs-flex zcs-align-items-center zcs-gap-10 zcs-mt-16&apos;&gt;\n\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;This request is in &lt;%=trip.Status%&gt; status, so option confirmation is locked.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;travel-layout zcs-mt-20&apos;&gt;\n\t\t\t&lt;aside class=&apos;trip-card&apos;&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-gap-16&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-no-shrink&apos;&gt;&lt;i class=&apos;zc-li-outline transport-air-baloon zcs-font-28&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-col-common zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=ifnull(trip.Destination,&quot;-&quot;)%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=employeeName%&gt; \u00B7 &lt;%=employeeDepartment%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusBadge%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=trip.Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&apos;summary-list&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Travel Type&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(trip.Travel_Type,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Travel Dates&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(trip.Travel_From_Date,&quot;-&quot;)%&gt; to &lt;%=ifnull(trip.Travel_To_Date,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Purpose&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(trip.Purpose,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Requirements&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=requirementCount%&gt; requirement(s), &lt;%=recommendationCount%&gt; recommendation(s)&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Selected Options&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=selectedOptionCount%&gt; selected row(s)&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&apos;summary-item&apos;&gt;\n\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-13 zcs-color-tertiary&apos;&gt;Estimated Total&lt;/label&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-body cost-text zcs-mt-4&apos;&gt;INR &lt;%=ifnull(trip.Total_Estimated_Cost,0)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&apos;zcs-card zcs-flex zcs-direction-column zcs-gap-10 zcs-p-18 zcs-box-border zcs-mt-16&apos;&gt;\n\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;Related records&lt;/h6&gt;\n\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=requirementsUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline design-bullet-list-67&apos;&gt;&lt;/i&gt;&lt;span&gt;Requirements&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&apos;related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border&apos; href=&apos;&lt;%=selectedUrl%&gt;&apos;&gt;\n\t\t\t\t\t\t&lt;span class=&apos;zcs-flex zcs-align-items-center zcs-gap-8&apos;&gt;&lt;i class=&apos;zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;&lt;span&gt;Selected Options&lt;/span&gt;&lt;/span&gt;&lt;i class=&apos;zc-li-outline arrows-1-tail-right&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/aside&gt;\n\n\t\t\t&lt;section&gt;\n\t\t\t\t&lt;form method=&apos;GET&apos; action=&apos;#Page:Travel_Selection_Page&apos; onsubmit=&quot;var picked=[];var radios=this.querySelectorAll(&apos;input[type=radio]:checked&apos;);for(var i=0;i&lt;radios.length;i++){var req=radios[i].getAttribute(&apos;data-req&apos;);var val=radios[i].value;if(req&amp;&amp;val){picked.push(req+&apos;:&apos;+val);}}this.querySelector(&apos;input[name=selections]&apos;).value=picked.join(&apos;,&apos;);&quot;&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;travel_request_id&apos; value=&apos;&lt;%=trip.ID%&gt;&apos; /&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;confirm_selection&apos; value=&apos;1&apos; /&gt;\n\t\t\t\t\t&lt;input type=&apos;hidden&apos; name=&apos;selections&apos; value=&apos;&lt;%=selectedParam%&gt;&apos; /&gt;\n&lt;%\n\t\tif(requirementCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&apos;zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-nodata-content zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center&apos;&gt;&lt;i class=&apos;zc-li-outline design-bullet-list-67 zcs-font-40&apos;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h5 class=&apos;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&apos;&gt;No requirements available&lt;/h5&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0&apos;&gt;HR recommendations can be selected only after travel requirements exist.&lt;/p&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tfor each  req in requirements\n\t\t\t{\n\t\t\t\treqRecs = Travel_HR_Recommendations[Travel_Request == trip.ID &amp;&amp; Travel_Requirement == req.ID] sort by Estimated_Cost asc;\n\t\t\t\tcurrentChoice = ifnull(selectedMap.get(req.ID.toString()),&quot;&quot;);\n\t\t\t\tif(currentChoice == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\tselectedRecRows = Travel_HR_Recommendations[Travel_Request == trip.ID &amp;&amp; Travel_Requirement == req.ID &amp;&amp; Is_Selected == true];\n\t\t\t\t\tif(selectedRecRows.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tcurrentChoice = selectedRecRows.ID;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(currentChoice == &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\texistingSelectedRows = Travel_Selected_Options[Travel_Request == trip.ID &amp;&amp; Recommendation.Travel_Requirement == req.ID];\n\t\t\t\t\tif(existingSelectedRows.count() &gt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tcurrentChoice = existingSelectedRows.Recommendation;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tcurrentChoiceText = ifnull(currentChoice,&quot;&quot;).toString();\n\t\t\t\t%&gt;\n&lt;div class=&apos;requirement-card zcs-mb-0&apos; style=&apos;margin-bottom:18px;&apos;&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;requirement-head zcs-p-20 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0&apos;&gt;&lt;%=req.Requirement_Type%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&apos;zcs-font-14 zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&apos;&gt;Preferred: &lt;%=ifnull(req.Preferred_Date,&quot;-&quot;)%&gt; &lt;%=ifnull(req.Preferred_Time,&quot;&quot;)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(reqRecs.count() &gt; 0,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-yellow&quot;)%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=reqRecs.count()%&gt; option(s)&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\tif(ifnull(req.Additional_Notes,&quot;&quot;) != &quot;&quot;)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div class=&apos;zcs-font-14 zcs-color-secondary zcs-mt-10&apos;&gt;&lt;i class=&apos;zc-li-outline files-notes zcs-color-theme&apos;&gt;&lt;/i&gt; &lt;%=req.Additional_Notes%&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&apos;zcs-p-20 zcs-box-border&apos;&gt;\n&lt;%\n\t\t\t\tif(reqRecs.count() == 0)\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div class=&apos;warning-note zcs-flex zcs-align-items-center zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&apos;zc-li-outline ui-1-alert-circle-i zcs-font-18&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-medium&apos;&gt;HR has not added recommendations for this requirement yet.&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div class=&apos;option-grid&apos;&gt;\n&lt;%\n\t\t\t\t\tfor each  rec in reqRecs\n\t\t\t\t\t{\n\t\t\t\t\t\trecIdText = rec.ID.toString();\n\t\t\t\t\t\tcheckedText = if(currentChoiceText == recIdText,&quot;checked&quot;,&quot;&quot;);\n\t\t\t\t\t\tdisabledText = if(canConfirm == true,&quot;&quot;,&quot;disabled&quot;);\n\t\t\t\t\t\tselectedBadgeClass = if(rec.Is_Selected == true || currentChoiceText == recIdText,&quot;zcs-badge-green&quot;,&quot;zcs-badge-blue&quot;);\n\t\t\t\t\t\t%&gt;\n&lt;div class=&apos;radio-wrap zcs-relative&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;input id=&apos;rec_&lt;%=rec.ID%&gt;&apos; type=&apos;radio&apos; name=&apos;req_&lt;%=req.ID%&gt;&apos; data-req=&apos;&lt;%=req.ID%&gt;&apos; value=&apos;&lt;%=rec.ID%&gt;&apos; &lt;%=checkedText%&gt; &lt;%=disabledText%&gt; required /&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;option-card&apos; for=&apos;rec_&lt;%=rec.ID%&gt;&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;option-top zcs-p-16 zcs-box-border zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;h6 class=&apos;zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&apos;&gt;&lt;%=ifnull(rec.Vendor_Or_Operator,&quot;-&quot;)%&gt;&lt;/h6&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary zcs-ellipsis&apos;&gt;&lt;%=ifnull(rec.Recommendation_Type,req.Requirement_Type)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;radio-dot zcs-no-shrink&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-10&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=selectedBadgeClass%&gt;&apos;&gt;&lt;span class=&apos;zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body&apos;&gt;&lt;%=if(rec.Is_Selected == true || currentChoiceText == recIdText,&quot;Selected&quot;,&quot;Available&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-18 zcs-font-bold cost-text&apos;&gt;INR &lt;%=ifnull(rec.Estimated_Cost,0)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;option-meta&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;meta-cell&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Departure&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(rec.Departure_Time,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;meta-cell&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Arrival&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(rec.Arrival_Time,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;meta-cell&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Check In&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(rec.Check_In_Date,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;meta-cell&apos;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;label class=&apos;zcs-font-12 zcs-color-tertiary&apos;&gt;Check Out&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&apos;zcs-font-13 zcs-font-medium zcs-color-primary zcs-mt-4&apos;&gt;&lt;%=ifnull(rec.Check_Out_Date,&quot;-&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t\t\tif(ifnull(rec.Notes,&quot;&quot;) != &quot;&quot;)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t%&gt;\n&lt;div class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;&lt;i class=&apos;zc-li-outline files-notes zcs-color-theme&apos;&gt;&lt;/i&gt; &lt;%=rec.Notes%&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t\t\t}\n\t\t\t\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/label&gt;\n\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t\t\t}\n\t\t\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\t%&gt;\n&lt;div class=&apos;submit-panel zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border&apos;&gt;\n\t\t\t\t\t\t&lt;div class=&apos;zcs-flex zcs-direction-column zcs-gap-4&apos;&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-14 zcs-font-semibold zcs-color-primary&apos;&gt;Confirm selections&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-font-13 zcs-color-secondary&apos;&gt;Confirmation updates selected recommendations, creates or updates selected-option rows, recalculates totals, notifies HR, and writes an audit log.&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;button class=&apos;zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&apos; type=&apos;submit&apos; &lt;%=if(canConfirm == true &amp;&amp; requirementCount &gt; 0,&quot;&quot;,&quot;disabled&quot;)%&gt; onclick=&quot;return confirm(&apos;Confirm the selected travel options for this request?&apos;);&quot;&gt;\n\t\t\t\t\t\t\t&lt;i class=&apos;zcs-button-icon zc-li-outline ui-1-check-circle-08&apos;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t&lt;span class=&apos;zcs-button-text&apos;&gt;Confirm Options&lt;/span&gt;\n\t\t\t\t\t\t&lt;/button&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/form&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Add_Update_User1 as "Add / Update User"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														info thisapp.permissions.assignUserInProfile(input.User_Email,input.Profile);
													info input.User_Email;
													info input.Profile;
									)
								}
							}
			
						
			}

			Delete_Users as "Delete Users"
			{
			
							type =  form
							form = Add_Users
			
							record event = on delete
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														thisapp.permissions.deleteUser(input.User_Email);
													info "deleted:" + input.User_Email;
									)
								}
							}
			
						
			}

			Disable_email as "Disable email"
			{
			
							type =  form
							form = Add_Users
			
							record event = on edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable User_Email;
													existingProfile = input.Profile;
													clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
													input.Profile = existingProfile;
									)
								}
							}
			
						
			}

			Populate_profiles_on_load as "Populate profiles on load"
			{
			
							type =  form
							form = Add_Users
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														clear Profile;
													userProfiles = thisapp.permissions.PROFILES().toList();
													index = 0;
													for each  elemnt in userProfiles
													{
														if(elemnt == "Administrator")
														{
															userProfiles.remove(index);
														}
														index = index + 1;
													}
													input.Profile:ui.append(userProfiles);
									)
								}
							}
			
						
			}

			Agency_Master_On_Validate as "Agency Master - On Validate"
			{
			
							type =  form
							form = Agency_Master
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														duplicateAgencies = Agency_Master[Agency_Name == input.Agency_Name && ID != input.ID];
													if(duplicateAgencies.count() > 0)
													{
														alert "Agency already exists.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Announcement_On_Load as "Announcement - On Load"
