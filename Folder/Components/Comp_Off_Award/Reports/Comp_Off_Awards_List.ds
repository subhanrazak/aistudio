default list Comp_Off_Awards_List
{

			displayName = "Comp Off Awards List"
			show all rows from Comp_Off_Award    
			(
				Employees
				Work_Date as "Work Date"
				Awarded_Days as "Awarded Days"
				Balance
				Expiry_Date as "Expiry Date"
				Awarded_By as "Awarded By"
				Reason
			)
			filters
			(
				Employees
				Expiry_Date
			)
			sort by
			(
				Work_Date descending
			)
		
}