form Comp_Off_Award
{

			displayname = "Comp Off Award"
			Award_Details
			(
				type = section
				displayname = "Award Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employees
			(
				type = checkboxes	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Work_Date
			(
    			type = date
				displayname = "Work Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Awarded_Days
			(
				type = decimal
				displayname = "Awarded Days"
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expiry_Date
			(
    			type = date
				displayname = "Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Awarded_By
			(
    			type = picklist
				displayname = "Awarded By"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reason_Details
			(
				type = section
				displayname = "Reason Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Reason
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Balance
			(
				type = decimal
				initial value = 0
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}