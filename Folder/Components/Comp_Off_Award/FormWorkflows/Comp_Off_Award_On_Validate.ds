Comp_Off_Award_On_Validate as "Comp Off Award - On Validate"
{

				type =  form
				form = Comp_Off_Award

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Awarded_Days == null || input.Awarded_Days < 0.5 || input.Awarded_Days > 2)
										{
											alert "Awarded days must be between 0.5 and 2.";
											cancel submit;
										}
										if(input.Balance == null || input.Balance < 0)
										{
											input.Balance = 0;
										}
										if(input.Awarded_By == null)
										{
											input.Awarded_By = zoho.loginuserid;
										}
						)
					}
				}

			
}