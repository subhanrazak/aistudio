Comp_Off_Award_On_Load as "Comp Off Award - On Load"
{

				type =  form
				form = Comp_Off_Award

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Expiry_Date;
										disable Awarded_By;
										disable Balance;
										if(input.Awarded_By == null)
										{
											input.Awarded_By = zoho.loginuserid;
										}
										if(input.Balance == null)
										{
											input.Balance = 0;
										}
						)
					}
				}

			
}