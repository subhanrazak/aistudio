form Notice_Period_Config
{

			displayname = "Notice Period Config"
			Notice_Period_Details
			(
				type = section
				displayname = "Notice Period Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employment_Type
			(
				type = picklist
				displayname = "Employment Type"
				values = {"Full_Time","Contractor","Intern"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Notice_Period_Days
			(
				type = number
				displayname = "Notice Period Days"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Effective_From
			(
    			type = date
				displayname = "Effective From"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}