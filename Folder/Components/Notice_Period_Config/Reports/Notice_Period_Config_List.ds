default list Notice_Period_Config_List
{

			displayName = "Notice Period Config List"
			show all rows from Notice_Period_Config    
			(
				Employment_Type as "Employment Type"
				Notice_Period_Days as "Notice Period Days"
				Effective_From as "Effective From"
				Is_Active as "Is Active"
			)
			filters
			(
				Employment_Type
				Is_Active
			)
			sort by
			(
				Employment_Type ascending
			)
		
}