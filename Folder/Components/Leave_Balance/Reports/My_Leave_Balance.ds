list My_Leave_Balance
{

			displayName = "My Leave Balance"
			show all rows from Leave_Balance    
			(
				Employee
				Leave_Type as "Leave Type"
				Balance_Days as "Balance Days"
				Used_Days as "Used Days"
				Credited_Days as "Credited Days"
				Last_Credited_Date as "Last Credited Date"
				Comp_Off_Expiry_Date as "Comp Off Expiry Date"
			)
			filters
			(
				Leave_Type
				Last_Credited_Date
				Comp_Off_Expiry_Date
			)
			sort by
			(
				Leave_Type ascending
			)
		
}