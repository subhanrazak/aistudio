form Leave_Balance
{

			displayname = "Leave Balance"
			Balance_Details
			(
				type = section
				displayname = "Balance Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Leave_Type
			(
				type = picklist	
				displayname = "Leave Type"
				values  = Leave_Type_Config[Is_Active == true].ID
    			displayformat = [Leave_Type_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Balance_Days
			(
				type = decimal
				displayname = "Balance Days"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Used_Days
			(
				type = decimal
				displayname = "Used Days"
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			Credit_Details
			(
				type = section
				displayname = "Credit Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Credited_Days
			(
				type = decimal
				displayname = "Credited Days"
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			Last_Credited_Date
			(
    			type = date
				displayname = "Last Credited Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Comp_Off_Expiry_Date
			(
    			type = date
				displayname = "Comp Off Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}