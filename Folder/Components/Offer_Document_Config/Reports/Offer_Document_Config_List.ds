default list Offer_Document_Config_List
{

			displayName = "Offer Document Config List"
			show all rows from Offer_Document_Config    
			(
				Document_Name as "Document Name"
				Is_Mandatory as "Is Mandatory"
				Display_Order as "Display Order"
				Is_Active as "Is Active"
			)
			filters
			(
				Is_Active
			)
			sort by
			(
				Display_Order ascending
			)
		
}