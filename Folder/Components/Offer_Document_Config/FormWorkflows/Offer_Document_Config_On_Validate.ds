Offer_Document_Config_On_Validate as "Offer Document Config - On Validate"
{

				type =  form
				form = Offer_Document_Config

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Display_Order,0) <= 0)
										{
											alert "Display order must be greater than zero.";
											cancel submit;
										}
						)
					}
				}

			
}