Announcement_Acknowledgement_On_Validate as "Announcement Acknowledgement - On Validate"
{

				type =  form
				form = Announcement_Acknowledgement

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Acknowledged == true && input.Signature == null)
										{
											alert "Signature is required to acknowledge this announcement.";
											cancel submit;
										}
						)
					}
				}

			
}