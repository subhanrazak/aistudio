Announcement_Acknowledgement_On_Load as "Announcement Acknowledgement - On Load"
{

				type =  form
				form = Announcement_Acknowledgement

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Announcement;
										disable Employee;
										disable Acknowledged_Date;
										if(input.Acknowledged == true)
										{
											disable Acknowledged;
											disable Signature;
										}
						)
					}
				}

			
}