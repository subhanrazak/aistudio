default list Announcement_Acknowledgement_Status
{

			displayName = "Announcement Acknowledgement Status"
			show all rows from Announcement_Acknowledgement    
			(
				Announcement
				Employee
				Acknowledged
				Acknowledged_Date as "Acknowledged Date"
			)
			filters
			(
				Announcement
				Employee
				Acknowledged
				Acknowledged_Date
			)
			sort by
			(
				Announcement ascending
			)
		
}