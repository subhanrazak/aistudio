list Announcement_Ack_Kanban
{

			displayName = "Announcement Acknowledgement Board"
			show all rows from Announcement_Acknowledgement    
			(
				Announcement
				Employee
				Acknowledged
				Acknowledged_Date as "Acknowledged Date"
			)
			filters
			(
				Announcement
				Employee
				Acknowledged
			)
			sort by
			(
				Announcement ascending
			)
		
}