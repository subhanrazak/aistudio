list My_Announcement_Acknowledgements
{

			displayName = "My Announcement Acknowledgements"
			show all rows from Announcement_Acknowledgement  [Employee.Official_Email == zoho.loginuser]  
			(
				Announcement
				Employee
				Acknowledged
				Acknowledged_Date as "Acknowledged Date"
			)
			filters
			(
				Announcement
				Acknowledged
				Acknowledged_Date
			)
			sort by
			(
				Acknowledged_Date descending
			)
		
}