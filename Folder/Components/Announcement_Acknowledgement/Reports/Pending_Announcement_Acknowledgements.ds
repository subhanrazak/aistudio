list Pending_Announcement_Acknowledgements
{

			displayName = "Pending Announcement Acknowledgements"
			show all rows from Announcement_Acknowledgement  [Acknowledged == false]  
			(
				Announcement
				Employee
				Acknowledged
				Acknowledged_Date as "Acknowledged Date"
			)
			filters
			(
				Announcement
				Employee
				Acknowledged
			)
			sort by
			(
				Announcement ascending
			)
		
}