Offboarding_Checklist_Status_On_User_Input as "Offboarding Checklist - Status On User Input"
{

				type =  form
				form = Offboarding_Checklist

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Completed")
										{
											input.Completed_Date = zoho.currentdate;
										}
										else
										{
											input.Completed_Date = null;
										}
						)
					}
				}

			
}