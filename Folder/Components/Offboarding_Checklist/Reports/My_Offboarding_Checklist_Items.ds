list My_Offboarding_Checklist_Items
{

			displayName = "My Offboarding Checklist Items"
			show all rows from Offboarding_Checklist  [Responsible_Person.Official_Email == zoho.loginuser]  
			(
				Resignation_Request as "Resignation Request"
				Checklist_Item as "Checklist Item"
				Responsible_Department as "Responsible Department"
				Responsible_Person as "Responsible Person"
				Status
				Completed_Date as "Completed Date"
				Notes
			)
			filters
			(
				Resignation_Request
				Status
				Completed_Date
			)
			sort by
			(
				Completed_Date descending
			)
		
}