list Offboarding_Checklist_View
{

			displayName = "Offboarding Checklist View"
			show all rows from Offboarding_Checklist    
			(
				Resignation_Request as "Resignation Request"
				Checklist_Item as "Checklist Item"
				Responsible_Department as "Responsible Department"
				Responsible_Person as "Responsible Person"
				Status
				Completed_Date as "Completed Date"
			)
			filters
			(
				Resignation_Request
				Responsible_Department
				Responsible_Person
				Status
			)
			sort by
			(
				Completed_Date descending
			)
		
}