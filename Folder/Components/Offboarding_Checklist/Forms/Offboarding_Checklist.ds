form Offboarding_Checklist
{

			displayname = "Offboarding Checklist"
			Checklist_Details
			(
				type = section
				displayname = "Checklist Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Resignation_Request
			(
				type = picklist	
				displayname = "Resignation Request"
				values  = Resignation_Request.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Checklist_Item
			(
				type = picklist	
				displayname = "Checklist Item"
				values  = Offboarding_Checklist_Config.ID
    			displayformat = [Checklist_Item]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Responsible_Department
			(
				type = picklist	
				displayname = "Responsible Department"
				values  = Department_Config.ID
    			displayformat = [Department_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Responsible_Person
			(
				type = picklist	
				displayname = "Responsible Person"
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Pending","Completed","Waived"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completed_Date
			(
    			type = date
				displayname = "Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}