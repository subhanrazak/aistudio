kanban Holiday_Type_Kanban
{

			displayName = "Holiday Type Kanban"
			show all rows from Holiday_Master    
			(
				Holiday_Name as "Holiday Name"
				Holiday_Date as "Holiday Date"
				Holiday_Type as "Holiday Type"
				Year
				Is_Active as "Is Active"
			)
			filters
			(
				Year
				Holiday_Type
				Is_Active
			)
			sort by
			(
				Holiday_Date ascending
			)
			options
			(
	 			display field = Holiday_Type
				sort order  = ascending
				record count  = enable
	 		)
		
}