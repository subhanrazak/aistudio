form Holiday_Master
{

			displayname = "Holiday Master"
			Holiday_Details
			(
				type = section
				displayname = "Holiday Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Holiday_Name
			(
    			type = text
				displayname = "Holiday Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Holiday_Date
			(
    			type = date
				displayname = "Holiday Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Holiday_Type
			(
				type = picklist
				displayname = "Holiday Type"
				values = {"Public_Holiday","Restricted_Holiday"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year
			(
				type = number
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}