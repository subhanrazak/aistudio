default list HR_All_Time_Off_Requests
{

			displayName = "HR All Time Off Requests"
			show all rows from Time_Off_Request    
			(
				Employee
				Leave_Type as "Leave Type"
				From_Date as "From Date"
				To_Date as "To Date"
				Number_Of_Days as "Number Of Days"
				Is_Half_Day as "Is Half Day"
				Supporting_Document as "Supporting Document"
				Baby_Birth_Date as "Baby Birth Date"
				Status
				Applied_By as "Applied By"
			)
			filters
			(
				Employee
				Leave_Type
				From_Date
				Status
			)
			sort by
			(
				From_Date descending
			)
		
}