list Pending_Time_Off_Requests_Manager
{

			displayName = "Pending Time Off Requests Manager"
			show all rows from Time_Off_Request  [Status == "Pending_Manager"]  
			(
				Employee
				Leave_Type as "Leave Type"
				From_Date as "From Date"
				To_Date as "To Date"
				Number_Of_Days as "Number Of Days"
				Reason
				Status
			)
			filters
			(
				Employee
				Leave_Type
				From_Date
				Status
			)
			sort by
			(
				From_Date ascending
			)
		
}