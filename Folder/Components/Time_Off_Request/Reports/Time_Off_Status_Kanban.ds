kanban Time_Off_Status_Kanban
{

			displayName = "Time Off Status Kanban"
			show all rows from Time_Off_Request    
			(
				Employee
				Leave_Type as "Leave Type"
				From_Date as "From Date"
				To_Date as "To Date"
				Number_Of_Days as "Number Of Days"
				Status
			)
			filters
			(
				Employee
				Leave_Type
				From_Date
				Status
			)
			sort by
			(
				From_Date ascending
			)
			options
			(
	 			display field = Status
				sort order  = ascending
				record count  = enable
	 		)
		
}