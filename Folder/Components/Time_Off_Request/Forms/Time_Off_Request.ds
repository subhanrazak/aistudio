form Time_Off_Request
{

			displayname = "Time Off Request"
			Request_Details
			(
				type = section
				displayname = "Request Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Leave_Type
			(
				type = picklist	
				displayname = "Leave Type"
				values  = Leave_Type_Config[Is_Active == true].ID
    			displayformat = [Leave_Type_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have From_Date
			(
    			type = date
				displayname = "From Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have To_Date
			(
    			type = date
				displayname = "To Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Number_Of_Days
			(
				type = decimal
				displayname = "Number Of Days"
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Half_Day
			(
    			type = checkbox
				displayname = "Is Half Day"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
			Half_Day_Session
			(
				type = picklist
				displayname = "Half Day Session"
				values = {"Morning","Afternoon"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Details
			(
				type = section
				displayname = "Additional Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Reason
			(
    			type = textarea
				height = 140px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Supporting_Document
			(
    			type = upload file
				displayname = "Supporting Document"
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Baby_Birth_Date
			(
    			type = date
				displayname = "Baby Birth Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
				isencrypted = true
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Pending_Manager","Pending_HR","Approved","Rejected","Cancelled"}
				initial value = "Pending_Manager"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Applied_By
			(
    			type = picklist
				displayname = "Applied By"
				module = users
				displayformat = [name]
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}