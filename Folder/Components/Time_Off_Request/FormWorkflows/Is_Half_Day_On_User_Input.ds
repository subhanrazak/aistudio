Is_Half_Day_On_User_Input as "Is Half Day - On User Input"
{

				type =  form
				form = Time_Off_Request

				record event = on add or edit

				on user input of Is_Half_Day
				{
					actions 
					{
						custom deluge script
						(
											if(input.Is_Half_Day == true)
										{
											show Half_Day_Session;
											input.To_Date = input.From_Date;
											input.Number_Of_Days = 0.5;
										}
										else
										{
											hide Half_Day_Session;
											input.Half_Day_Session = "";
										}
						)
					}
				}

			
}