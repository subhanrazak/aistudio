kanban Appraisal_Status_Kanban
{

			displayName = "Appraisal Status Kanban"
			show all rows from Appraisal_Form    
			(
				Employee
				Appraisal_Config as "Appraisal Config"
				Manager
				Status
				HR_Signoff as "HR Signoff"
			)
			filters
			(
				Appraisal_Config
				Status
			)
			sort by
			(
				Appraisal_Config descending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}