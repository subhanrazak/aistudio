default list HR_All_Appraisals
{

			displayName = "HR All Appraisals"
			show all rows from Appraisal_Form    
			(
				Employee
				Appraisal_Config as "Appraisal Config"
				Manager
				Status
				HR_Signoff as "HR Signoff"
				HR_Comments as "HR Comments"
			)
			filters
			(
				Employee
				Appraisal_Config
				Status
			)
			sort by
			(
				Appraisal_Config descending
				Employee ascending
			)
		
}