list My_Appraisal
{

			displayName = "My Appraisal"
			show all rows from Appraisal_Form  [Employee.Official_Email == zoho.loginuser]  
			(
				Employee
				Appraisal_Config as "Appraisal Config"
				Manager
				Status
				HR_Signoff as "HR Signoff"
			)
			filters
			(
				Appraisal_Config
				Status
			)
			sort by
			(
				Appraisal_Config descending
			)
		
}