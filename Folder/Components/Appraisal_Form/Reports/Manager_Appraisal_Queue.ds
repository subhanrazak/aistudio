list Manager_Appraisal_Queue
{

			displayName = "Manager Appraisal Queue"
			show all rows from Appraisal_Form  [Manager == zoho.loginuserid || Manager == zoho.loginuser]  
			(
				Employee
				Appraisal_Config as "Appraisal Config"
				Manager
				Status
				HR_Signoff as "HR Signoff"
			)
			filters
			(
				Appraisal_Config
				Status
			)
			sort by
			(
				Appraisal_Config descending
				Employee ascending
			)
		
}