form Appraisal_Form
{

			displayname = "Appraisal Form"
			Appraisal_Details
			(
				type = section
				displayname = "Appraisal Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Appraisal_Config
			(
				type = picklist	
				displayname = "Appraisal Config"
				values  = Appraisal_Config[Is_Active == true].ID
    			displayformat = [Appraisal_Year]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Manager
			(
    			type = picklist
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Draft","Submitted","Manager_Reviewed","HR_Approved"}
				initial value = "Draft"
	 			row = 1
	 			column = 2   
				width = medium
			)
			HR_Signoff
			(
    			type = checkbox
				displayname = "HR Signoff"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			HR_Comments
			(
    			type = textarea
				displayname = "HR Comments"
				height = 140px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}