form Candidate
{

			Candidate_Details
			(
				type = section
				displayname = "Candidate Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Candidate_Name
			(
    			type = text
				displayname = "Candidate Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
				isencrypted = true
			)
			must have unique Email
			(
    			type = email
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Resume
			(
    			type = upload file
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Sourcing_Details
			(
				type = section
				displayname = "Sourcing Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Source
			(
				type = picklist
				values = {"Manual","LinkedIn","Referral","Consultant","Agency"}
				initial value = "Manual"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Referred_By
			(
				type = picklist	
				displayname = "Referred By"
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Agency
			(
				type = picklist	
				values  = Agency_Master[Is_Active == true].ID
    			displayformat = [Agency_Name]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Talent_Pool
			(
				type = section
				displayname = "Talent Pool"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Is_In_Pool
			(
    			type = checkbox
				displayname = "Is In Pool"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Pool_Notes
			(
    			type = textarea
				displayname = "Pool Notes"
				height = 120px
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}