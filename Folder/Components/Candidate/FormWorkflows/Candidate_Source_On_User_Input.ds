Candidate_Source_On_User_Input as "Candidate Source - On User Input"
{

				type =  form
				form = Candidate

				record event = on add or edit

				on user input of Source
				{
					actions 
					{
						custom deluge script
						(
											if(input.Source == "Referral")
										{
											show Referred_By;
											hide Agency;
											input.Agency = null;
										}
										else if(input.Source == "Agency")
										{
											hide Referred_By;
											show Agency;
											input.Referred_By = null;
										}
										else
										{
											hide Referred_By;
											hide Agency;
											input.Referred_By = null;
											input.Agency = null;
										}
						)
					}
				}

			
}