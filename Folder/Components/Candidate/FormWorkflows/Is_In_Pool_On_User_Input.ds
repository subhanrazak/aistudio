Is_In_Pool_On_User_Input as "Candidate Pool - On User Input"
{

				type =  form
				form = Candidate

				record event = on add or edit

				on user input of Is_In_Pool
				{
					actions 
					{
						custom deluge script
						(
											if(input.Is_In_Pool == true)
										{
											show Pool_Notes;
										}
										else
										{
											hide Pool_Notes;
											input.Pool_Notes = "";
										}
						)
					}
				}

			
}