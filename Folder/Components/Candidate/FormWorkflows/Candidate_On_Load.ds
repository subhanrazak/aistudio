Candidate_On_Load as "Candidate - On Load"
{

				type =  form
				form = Candidate

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Source == "Referral")
										{
											show Referred_By;
											hide Agency;
										}
										else if(input.Source == "Agency")
										{
											hide Referred_By;
											show Agency;
										}
										else
										{
											hide Referred_By;
											hide Agency;
										}
										if(input.Is_In_Pool == true)
										{
											show Pool_Notes;
										}
										else
										{
											hide Pool_Notes;
										}
						)
					}
				}

			
}