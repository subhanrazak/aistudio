list Candidate_Pool
{

			displayName = "Candidate Pool"
			show all rows from Candidate  [Is_In_Pool == true]  
			(
				Candidate_Name as "Candidate Name"
				Email
				Phone
				Source
				Pool_Notes as "Pool Notes"
				custom action "Assign to Job"
				(
	  			workflow = Assign_Candidate_To_Job
				column header = "Assign to Job"
				success message = "Opening job application form"
				condition = (Is_In_Pool == true)
				)
			)
			filters
			(
				Source
				Is_In_Pool
			)
			sort by
			(
				Candidate_Name ascending
			)
		
}