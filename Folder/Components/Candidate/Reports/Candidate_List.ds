default list Candidate_List
{

			displayName = "Candidate List"
			show all rows from Candidate    
			(
				Candidate_Name as "Candidate Name"
				Email
				Phone
				Source
				Referred_By as "Referred By"
				Agency
				Is_In_Pool as "Is In Pool"
			)
			filters
			(
				Source
				Is_In_Pool
				Referred_By
				Agency
			)
			sort by
			(
				Candidate_Name ascending
			)
		
}