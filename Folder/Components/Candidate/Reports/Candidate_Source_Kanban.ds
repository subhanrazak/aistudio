kanban Candidate_Source_Kanban
{

			displayName = "Candidate Source Kanban"
			show all rows from Candidate    
			(
				Candidate_Name as "Candidate Name"
				Email
				Phone
				Source
				Is_In_Pool as "Is In Pool"
			)
			filters
			(
				Source
				Is_In_Pool
			)
			sort by
			(
				Candidate_Name ascending
			)
			options
			(
	 			display field = Source
				sort order  = ascending
				record count  = enable
	 		)
		
}