form Appraisal_Question_Response
{

			displayname = "Appraisal Question Response"
			Response_Details
			(
				type = section
				displayname = "Response Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Appraisal_Form
			(
				type = picklist	
				displayname = "Appraisal Form"
				values  = Appraisal_Form.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Question
			(
				type = picklist	
				values  = Appraisal_Basic_Questions.ID
    			displayformat = [Question_Text]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Response
			(
    			type = textarea
				height = 140px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Manager_Assessment
			(
				type = section
				displayname = "Manager Assessment"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Manager_Score
			(
				type = number
				displayname = "Manager Score"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Manager_Comment
			(
    			type = textarea
				displayname = "Manager Comment"
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}