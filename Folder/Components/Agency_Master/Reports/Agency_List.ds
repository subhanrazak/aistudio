default list Agency_List
{

			displayName = "Agency List"
			show all rows from Agency_Master    
			(
				Agency_Name as "Agency Name"
				Contact_Person as "Contact Person"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
				Is_Active as "Is Active"
			)
			filters
			(
				Is_Active
			)
			sort by
			(
				Agency_Name ascending
			)
		
}