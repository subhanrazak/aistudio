Agency_Master_On_Validate as "Agency Master - On Validate"
{

				type =  form
				form = Agency_Master

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											duplicateAgencies = Agency_Master[Agency_Name == input.Agency_Name && ID != input.ID];
										if(duplicateAgencies.count() > 0)
										{
											alert "Agency already exists.";
											cancel submit;
										}
						)
					}
				}

			
}