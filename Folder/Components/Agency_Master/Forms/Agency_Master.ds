form Agency_Master
{

			displayname = "Agency Master"
			Agency_Details
			(
				type = section
				displayname = "Agency Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Agency_Name
			(
    			type = text
				displayname = "Agency Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Person
			(
    			type = text
				displayname = "Contact Person"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}