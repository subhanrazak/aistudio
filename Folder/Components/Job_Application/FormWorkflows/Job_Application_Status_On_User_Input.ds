Job_Application_Status_On_User_Input as "Job Application Status - On User Input"
{

				type =  form
				form = Job_Application

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Offer_Accepted")
										{
											show Offer_Documents;
											show Offer_Accepted_Date;
											if(input.Offer_Accepted_Date == null)
											{
												input.Offer_Accepted_Date = zoho.currentdate;
											}
										}
										else
										{
											hide Offer_Documents;
											hide Offer_Accepted_Date;
											input.Offer_Accepted_Date = null;
										}
						)
					}
				}

			
}