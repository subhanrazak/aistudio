Job_Application_On_Validate as "Job Application - On Validate"
{

				type =  form
				form = Job_Application

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Current_Round,0) < 1)
										{
											alert "Current round must be at least 1.";
											cancel submit;
										}
										duplicateApplications = Job_Application[Candidate == input.Candidate && Job_Request == input.Job_Request && Status in {"Active","On_Hold","Selected","Offer_Accepted"} && ID != input.ID];
										if(duplicateApplications.count() > 0)
										{
											alert "This candidate already has an active application for the selected job request.";
											cancel submit;
										}
						)
					}
				}

			
}