form Job_Application
{

			displayname = "Job Application"
			Application_Details
			(
				type = section
				displayname = "Application Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Candidate
			(
				type = picklist	
				values  = Candidate.ID
    			displayformat = [Candidate_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Job_Request
			(
				type = picklist	
				displayname = "Job Request"
				values  = Job_Request[Status == "Approved"].ID
    			displayformat = [Job_Title]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Application_Date
			(
    			type = date
				displayname = "Application Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Of_Application
			(
    			type = text
				displayname = "Source Of Application"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Current_Round
			(
				type = number
				displayname = "Current Round"
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Active","On_Hold","Selected","Rejected","Offer_Accepted","Joined"}
				initial value = "Active"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Offer_Accepted_Date
			(
    			type = date
				displayname = "Offer Accepted Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Offer_Documents
			(
    			type = upload file
				displayname = "Offer Documents"
    			file count = 10
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}