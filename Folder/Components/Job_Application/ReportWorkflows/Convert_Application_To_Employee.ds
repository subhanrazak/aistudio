Convert_Application_To_Employee as "Convert Application To Employee"
{

				type =  functions
				form = Job_Application
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Convert_To_Employee?job_application_id=" + input.ID,"same window");
					)
					}
				}
			
}