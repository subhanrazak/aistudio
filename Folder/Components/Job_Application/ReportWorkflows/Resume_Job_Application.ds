Resume_Job_Application as "Resume Job Application"
{

				type =  functions
				form = Job_Application
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Status == "On_Hold")
										{
											input.Status = "Active";
											thisapp.Add_Audit_Log("JOB_APPLICATION_RESUMED","Recruitment","Job_Application",input.ID,"Resume","On_Hold","Active","Application resumed.",true,"");
										}
										else
										{
											info "Only on-hold applications can be resumed.";
										}
					)
					}
				}
			
}