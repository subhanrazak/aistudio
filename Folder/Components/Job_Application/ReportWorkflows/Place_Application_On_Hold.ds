Place_Application_On_Hold as "Place Application On Hold"
{

				type =  functions
				form = Job_Application
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(input.Status == "Active")
										{
											input.Status = "On_Hold";
											thisapp.Add_Audit_Log("JOB_APPLICATION_ON_HOLD","Recruitment","Job_Application",input.ID,"On Hold","Active","On_Hold","Application placed on hold.",true,"");
										}
										else
										{
											info "Only active applications can be placed on hold.";
										}
					)
					}
				}
			
}