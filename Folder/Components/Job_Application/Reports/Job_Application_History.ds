list Job_Application_History
{

			displayName = "Job Application History"
			show all rows from Job_Application    
			(
				Candidate
				Job_Request as "Job Request"
				Application_Date as "Application Date"
				Source_Of_Application as "Source Of Application"
				Current_Round as "Current Round"
				Status
				Offer_Accepted_Date as "Offer Accepted Date"
			)
			filters
			(
				Candidate
				Job_Request
				Status
				Application_Date
			)
			sort by
			(
				Application_Date descending
			)
		
}