Member_Master_On_Validate as "Member Master - On Validate"
{

				type =  form
				form = Member_Master

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											duplicateMembers = Member_Master[Member_Email == input.Member_Email && ID != input.ID];
										if(duplicateMembers.count() > 0)
										{
											alert "Member email already exists.";
											cancel submit;
										}
						)
					}
				}

			
}