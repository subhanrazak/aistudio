default list Member_Master_List
{

			displayName = "Member Master List"
			show all rows from Member_Master    
			(
				Member_ID as "Member ID"
				Member_Name as "Member Name"
				Member_Email as "Member Email"
				Member_Phone as "Member Phone"
				Organization
				Member_Type as "Member Type"
				Is_Active as "Is Active"
			)
			filters
			(
				Member_Type
				Is_Active
			)
			sort by
			(
				Member_Name ascending
			)
		
}