form Member_Master
{

			displayname = "Member Master"
			Member_Details
			(
				type = section
				displayname = "Member Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Member_ID
			(
    			type = autonumber
				displayname = "Member ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_Name
			(
    			type = text
				displayname = "Member Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
				isencrypted = true
			)
			must have unique Member_Email
			(
    			type = email
				displayname = "Member Email"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Member_Phone
			(
    			type = phonenumber
				displayname = "Member Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Organization
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Member_Type
			(
				type = picklist
				displayname = "Member Type"
				values = {"External","Third_Party","Contractor","Visitor"}
				initial value = "External"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}