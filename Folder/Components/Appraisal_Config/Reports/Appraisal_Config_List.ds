default list Appraisal_Config_List
{

			displayName = "Appraisal Config List"
			show all rows from Appraisal_Config    
			(
				Appraisal_Year as "Appraisal Year"
				Window_Start as "Window Start"
				Window_End as "Window End"
				Manager_Scoring_Start as "Manager Scoring Start"
				Manager_Scoring_End as "Manager Scoring End"
				Is_Active as "Is Active"
			)
			filters
			(
				Appraisal_Year
				Is_Active
			)
			sort by
			(
				Appraisal_Year descending
			)
		
}