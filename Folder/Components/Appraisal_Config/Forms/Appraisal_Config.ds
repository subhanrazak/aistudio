form Appraisal_Config
{

			displayname = "Appraisal Config"
			Cycle_Details
			(
				type = section
				displayname = "Cycle Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Appraisal_Year
			(
    			type = text
				displayname = "Appraisal Year"
				maxchar = 20
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Window_Start
			(
    			type = date
				displayname = "Window Start"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Window_End
			(
    			type = date
				displayname = "Window End"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Scoring_Details
			(
				type = section
				displayname = "Scoring Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Manager_Scoring_Start
			(
    			type = date
				displayname = "Manager Scoring Start"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Manager_Scoring_End
			(
    			type = date
				displayname = "Manager Scoring End"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}