default list Appraisal_Basic_Questions_List
{

			displayName = "Appraisal Basic Questions List"
			show all rows from Appraisal_Basic_Questions    
			(
				Appraisal_Config as "Appraisal Config"
				Question_Order as "Question Order"
				Question_Text as "Question Text"
			)
			filters
			(
				Appraisal_Config
			)
			sort by
			(
				Question_Order ascending
			)
		
}