form Appraisal_Basic_Questions
{

			displayname = "Appraisal Basic Questions"
			Question_Details
			(
				type = section
				displayname = "Question Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Appraisal_Config
			(
				type = picklist	
				displayname = "Appraisal Config"
				values  = Appraisal_Config.ID
    			displayformat = [Appraisal_Year]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Question_Order
			(
				type = number
				displayname = "Question Order"
				initial value = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Question_Text
			(
    			type = textarea
				displayname = "Question Text"
				height = 140px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}