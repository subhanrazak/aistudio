form Offboarding_Checklist_Config
{

			displayname = "Offboarding Checklist Config"
			Checklist_Details
			(
				type = section
				displayname = "Checklist Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Checklist_Item
			(
    			type = text
				displayname = "Checklist Item"
				maxchar = 200
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Responsible_Department
			(
				type = picklist	
				displayname = "Responsible Department"
				values  = Department_Config.ID
    			displayformat = [Department_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Display_Order
			(
				type = number
				displayname = "Display Order"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}