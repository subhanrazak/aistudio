default list Offboarding_Checklist_Config_List
{

			displayName = "Offboarding Checklist Config List"
			show all rows from Offboarding_Checklist_Config    
			(
				Checklist_Item as "Checklist Item"
				Responsible_Department as "Responsible Department"
				Is_Active as "Is Active"
				Display_Order as "Display Order"
			)
			filters
			(
				Responsible_Department
				Is_Active
			)
			sort by
			(
				Display_Order ascending
			)
		
}