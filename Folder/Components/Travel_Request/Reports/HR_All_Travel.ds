default list HR_All_Travel
{

			displayName = "HR All Travel"
			show all rows from Travel_Request    
			(
				Employee
				Travel_Type as "Travel Type"
				Destination
				Travel_From_Date as "Travel From Date"
				Travel_To_Date as "Travel To Date"
				Status
				Travel_Completed_Date as "Travel Completed Date"
				Bills_Upload_Date as "Bills Upload Date"
				Total_Estimated_Cost as "Total Estimated Cost"
				Total_Actual_Cost as "Total Actual Cost"
			)
			filters
			(
				Employee
				Travel_Type
				Status
				Travel_From_Date
			)
			sort by
			(
				Travel_From_Date descending
			)
		
}