form Travel_Request
{

			displayname = "Travel Request"
			Travel_Details
			(
				type = section
				displayname = "Travel Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Travel_Type
			(
				type = picklist
				displayname = "Travel Type"
				values = {"Domestic","International"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Destination
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Purpose
			(
    			type = textarea
				height = 140px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Travel_From_Date
			(
    			type = date
				displayname = "Travel From Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Travel_To_Date
			(
    			type = date
				displayname = "Travel To Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Pending_Manager","Pending_CEO","Pending_HR","Approved","Rejected","Bills_Pending","Bills_Uploaded","Processed"}
				initial value = "Pending_Manager"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cost_And_Bills
			(
				type = section
				displayname = "Cost And Bills"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Booking_Amount
			(
				displayname = "Booking Amount"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 2
	 			column = 1   
				width = medium
			)
			Travel_Completed_Date
			(
    			type = date
				displayname = "Travel Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Bills_Uploaded
			(
    			type = upload file
				displayname = "Bills Uploaded"
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Bills_Upload_Date
			(
    			type = date
				displayname = "Bills Upload Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Linked_Reimbursement
			(
				type = picklist	
				displayname = "Linked Reimbursement"
				values  = Reimbursement_Request.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Total_Estimated_Cost
			(
				displayname = "Total Estimated Cost"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 2
	 			column = 2   
				width = medium
			)
			Total_Actual_Cost
			(
				displayname = "Total Actual Cost"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}