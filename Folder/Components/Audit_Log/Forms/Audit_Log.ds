form Audit_Log
{

			displayname = "Audit Log"
			Audit_Details
			(
				type = section
				displayname = "Audit Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Audit_ID
			(
    			type = autonumber
				displayname = "Audit ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Key
			(
    			type = text
				displayname = "Event Key"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Module_Name
			(
    			type = text
				displayname = "Module Name"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Form_Name
			(
    			type = text
				displayname = "Form Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Record_ID
			(
				type = number
				displayname = "Record ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Action
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Time
			(
    			type = datetime
				displayname = "Event Time"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Actor_Email
			(
    			type = email
				displayname = "Actor Email"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Actor_Profile
			(
    			type = text
				displayname = "Actor Profile"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status_Change
			(
				type = section
				displayname = "Status Change"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Old_Status
			(
    			type = text
				displayname = "Old Status"
				maxchar = 100
	 			row = 2
	 			column = 1   
				width = medium
			)
			New_Status
			(
    			type = text
				displayname = "New Status"
				maxchar = 100
	 			row = 2
	 			column = 2   
				width = medium
			)
			Success
			(
    			type = checkbox
				initial value = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Details
			(
    			type = textarea
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Error_Message
			(
    			type = textarea
				displayname = "Error Message"
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}