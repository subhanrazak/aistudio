default list Application_Offer_Document_List
{

			displayName = "Application Offer Document List"
			show all rows from Application_Offer_Document    
			(
				Job_Application as "Job Application"
				Document_Type as "Document Type"
				Is_Uploaded as "Is Uploaded"
				Uploaded_File as "Uploaded File"
			)
			filters
			(
				Job_Application
				Is_Uploaded
				Document_Type
			)
			sort by
			(
				Document_Type ascending
			)
		
}