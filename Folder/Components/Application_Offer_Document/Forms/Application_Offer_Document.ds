form Application_Offer_Document
{

			displayname = "Application Offer Document"
			Offer_Document_Details
			(
				type = section
				displayname = "Offer Document Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Job_Application
			(
				type = picklist	
				displayname = "Job Application"
				values  = Job_Application.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Document_Type
			(
				type = picklist	
				displayname = "Document Type"
				values  = Offer_Document_Config[Is_Active == true].ID
    			displayformat = [Document_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Uploaded_File
			(
    			type = upload file
				displayname = "Uploaded File"
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Is_Uploaded
			(
    			type = checkbox
				displayname = "Is Uploaded"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}