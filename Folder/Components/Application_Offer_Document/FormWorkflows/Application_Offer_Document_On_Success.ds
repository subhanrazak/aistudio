Application_Offer_Document_On_Success as "Application Offer Document - On Success"
{

				type =  form
				form = Application_Offer_Document

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Uploaded_File != null && input.Is_Uploaded != true)
										{
											input.Is_Uploaded = true;
										}
										if(input.Uploaded_File != null)
										{
											thisapp.Add_Audit_Log("APPLICATION_OFFER_DOCUMENT_UPLOADED","Recruitment","Application_Offer_Document",input.ID,"Uploaded","","Uploaded","Offer document uploaded for job application.",true,"");
										}
						)
					}
				}

			
}