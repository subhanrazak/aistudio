Appraisal_Objectives_On_Load as "Appraisal Objectives - On Load"
{

				type =  form
				form = Appraisal_Objectives

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable KPI_KRA;
										disable Objective_Text;
						)
					}
				}

			
}