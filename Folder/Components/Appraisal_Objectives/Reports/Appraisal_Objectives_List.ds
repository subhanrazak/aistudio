default list Appraisal_Objectives_List
{

			displayName = "Appraisal Objectives List"
			show all rows from Appraisal_Objectives    
			(
				Appraisal_Form as "Appraisal Form"
				KPI_KRA as "KPI KRA"
				Objective_Text as "Objective Text"
				Self_Score as "Self Score"
				Manager_Score as "Manager Score"
			)
			filters
			(
				Appraisal_Form
			)
			sort by
			(
				Appraisal_Form ascending
			)
		
}