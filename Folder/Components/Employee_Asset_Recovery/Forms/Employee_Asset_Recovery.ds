form Employee_Asset_Recovery
{

			displayname = "Employee Asset Recovery"
			Asset_Details
			(
				type = section
				displayname = "Asset Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Resignation_Request
			(
				type = picklist	
				displayname = "Resignation Request"
				values  = Resignation_Request.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee
			(
				type = picklist	
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Asset_ID
			(
    			type = text
				displayname = "Asset ID"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Asset_Name
			(
    			type = text
				displayname = "Asset Name"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Asset_Type
			(
    			type = text
				displayname = "Asset Type"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Serial_Number
			(
    			type = text
				displayname = "Serial Number"
				maxchar = 120
	 			row = 1
	 			column = 2   
				width = medium
			)
			Assigned_Date
			(
    			type = date
				displayname = "Assigned Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recovery_Details
			(
				type = section
				displayname = "Recovery Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Recovery_Status
			(
				type = picklist
				displayname = "Recovery Status"
				values = {"Pending","Recovered","Not_Found"}
				initial value = "Pending"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Asset_Condition
			(
				type = picklist
				displayname = "Asset Condition"
				values = {"Good","Damaged","Missing","Obsolete"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Recovery_Date
			(
    			type = date
				displayname = "Recovery Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Recovery_Notes
			(
    			type = textarea
				displayname = "Recovery Notes"
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
			External_Sync_Status
			(
				type = picklist
				displayname = "External Sync Status"
				values = {"Pending_Sync","Synced","Sync_Failed"}
				initial value = "Pending_Sync"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}