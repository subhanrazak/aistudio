list Asset_Sync_Failed
{

			displayName = "Asset Sync Failed"
			show all rows from Employee_Asset_Recovery  [External_Sync_Status == "Sync_Failed"]  
			(
				Resignation_Request as "Resignation Request"
				Employee
				Asset_ID as "Asset ID"
				Asset_Name as "Asset Name"
				Asset_Type as "Asset Type"
				Serial_Number as "Serial Number"
				Recovery_Status as "Recovery Status"
				Recovery_Date as "Recovery Date"
				External_Sync_Status as "External Sync Status"
			)
			filters
			(
				Employee
				Recovery_Status
				External_Sync_Status
			)
			sort by
			(
				Recovery_Date descending
			)
		
}