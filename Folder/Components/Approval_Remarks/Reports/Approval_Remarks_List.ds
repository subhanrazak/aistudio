default list Approval_Remarks_List
{

			displayName = "Approval Remarks List"
			show all rows from Approval_Remarks    
			(
				Remarks_ID as "Remarks ID"
				Module
				Action
				Action_By as "Action By"
				Action_Date as "Action Date"
				Actor_Profile as "Actor Profile"
				Previous_Status as "Previous Status"
				New_Status as "New Status"
				Remarks
			)
			filters
			(
				Module
				Action
				Action_By
			)
			sort by
			(
				Action_Date descending
			)
		
}