Approval_Remarks_On_Load as "Approval Remarks - On Load"
{

				type =  form
				form = Approval_Remarks

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Action_By = zoho.loginuserid;
										input.Action_Date = zoho.currenttime;
										input.Actor_Profile = "";
										hide Linked_Job_Application;
										hide Linked_Time_Off_Request;
										hide Linked_Regularisation_Request;
										hide Linked_Travel_Request;
										hide Linked_Reimbursement_Request;
										hide Linked_Gift_Registration;
										hide Linked_Resignation_Request;
										if(input.Module == "Recruitment")
										{
											show Linked_Job_Application;
										}
										else if(input.Module == "Attendance_Leave")
										{
											show Linked_Time_Off_Request;
											show Linked_Regularisation_Request;
										}
										else if(input.Module == "Travel")
										{
											show Linked_Travel_Request;
										}
										else if(input.Module == "Reimbursement")
										{
											show Linked_Reimbursement_Request;
										}
										else if(input.Module == "Gift_Registration")
										{
											show Linked_Gift_Registration;
										}
										else if(input.Module == "Offboarding")
										{
											show Linked_Resignation_Request;
										}
						)
					}
				}

			
}