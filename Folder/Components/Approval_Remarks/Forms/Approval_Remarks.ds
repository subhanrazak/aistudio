form Approval_Remarks
{

			displayname = "Approval Remarks"
			Approval_Details
			(
				type = section
				displayname = "Approval Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Remarks_ID
			(
    			type = autonumber
				displayname = "Remarks ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Module
			(
				type = picklist
				values = {"Recruitment","Attendance_Leave","Performance","Travel","Reimbursement","Gift_Registration","Offboarding","ID_Card"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Action
			(
				type = picklist
				values = {"Approved","Rejected","On_Hold","Returned","Escalated","Override_Deactivation","Submitted"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Action_By
			(
    			type = text
				displayname = "Action By"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Action_Date
			(
    			type = datetime
				displayname = "Action Date"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Actor_Profile
			(
    			type = text
				displayname = "Actor Profile"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Previous_Status
			(
    			type = text
				displayname = "Previous Status"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			New_Status
			(
    			type = text
				displayname = "New Status"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Linked_Records
			(
				type = section
				displayname = "Linked Records"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Linked_Job_Application
			(
				type = picklist	
				displayname = "Linked Job Application"
				values  = Job_Application.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Time_Off_Request
			(
				type = picklist	
				displayname = "Linked Time Off Request"
				values  = Time_Off_Request.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Linked_Regularisation_Request
			(
				type = picklist	
				displayname = "Linked Regularisation Request"
				values  = Regularisation_Request.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Travel_Request
			(
				type = picklist	
				displayname = "Linked Travel Request"
				values  = Travel_Request.ID
    			displayformat = [Destination]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Linked_Reimbursement_Request
			(
				type = picklist	
				displayname = "Linked Reimbursement Request"
				values  = Reimbursement_Request.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Gift_Registration
			(
				type = picklist	
				displayname = "Linked Gift Registration"
				values  = Gift_Registration.ID
    			displayformat = [Gift_Name]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Linked_Resignation_Request
			(
				type = picklist	
				displayname = "Linked Resignation Request"
				values  = Resignation_Request.ID
    			displayformat = [Status]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Remarks_Details
			(
				type = section
				displayname = "Remarks Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 120px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}