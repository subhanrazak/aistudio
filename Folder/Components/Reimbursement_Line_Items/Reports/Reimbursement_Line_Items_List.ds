default list Reimbursement_Line_Items_List
{

			displayName = "Reimbursement Line Items List"
			show all rows from Reimbursement_Line_Items    
			(
				Reimbursement_Request as "Reimbursement Request"
				Expense_Type as "Expense Type"
				Expense_Date as "Expense Date"
				Amount
				Bill_Upload as "Bill Upload"
				Notes
			)
			filters
			(
				Reimbursement_Request
				Expense_Type
			)
			sort by
			(
				Reimbursement_Request ascending
				Expense_Date ascending
			)
		
}