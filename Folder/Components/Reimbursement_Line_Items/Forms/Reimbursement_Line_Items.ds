form Reimbursement_Line_Items
{

			displayname = "Reimbursement Line Items"
			Expense_Details
			(
				type = section
				displayname = "Expense Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Reimbursement_Request
			(
				type = picklist	
				displayname = "Reimbursement Request"
				values  = Reimbursement_Request.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Expense_Type
			(
    			type = text
				displayname = "Expense Type"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Expense_Date
			(
    			type = date
				displayname = "Expense Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				type = INR
				format = commadotindian
				maxchar = 14
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Bill_Upload
			(
    			type = upload file
				displayname = "Bill Upload"
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Notes
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}