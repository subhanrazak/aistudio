form KPI_KRA
{

			displayname = "KPI KRA"
			Objective_Details
			(
				type = section
				displayname = "Objective Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Manager
			(
    			type = picklist
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Appraisal_Config
			(
				type = picklist	
				displayname = "Appraisal Config"
				values  = Appraisal_Config[Is_Active == true].ID
    			displayformat = [Appraisal_Year]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Objective
			(
    			type = textarea
				height = 140px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Time_Period
			(
    			type = text
				displayname = "Time Period"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Measurement_Details
			(
				type = section
				displayname = "Measurement Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Weightage
			(
				type = decimal
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			Target_Value
			(
    			type = text
				displayname = "Target Value"
				maxchar = 100
	 			row = 2
	 			column = 2   
				width = medium
			)
			Is_Locked
			(
    			type = checkbox
				displayname = "Is Locked"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}