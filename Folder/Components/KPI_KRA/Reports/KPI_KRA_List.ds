default list KPI_KRA_List
{

			displayName = "KPI KRA List"
			show all rows from KPI_KRA    
			(
				Employee
				Manager
				Appraisal_Config as "Appraisal Config"
				Objective
				Time_Period as "Time Period"
				Weightage
				Target_Value as "Target Value"
				Is_Locked as "Is Locked"
			)
			filters
			(
				Employee
				Appraisal_Config
				Is_Locked
			)
			sort by
			(
				Employee ascending
			)
		
}