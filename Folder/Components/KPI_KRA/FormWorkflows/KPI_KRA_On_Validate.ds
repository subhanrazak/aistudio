KPI_KRA_On_Validate as "KPI KRA - On Validate"
{

				type =  form
				form = KPI_KRA

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Appraisal_Config == null)
										{
											alert "An active appraisal cycle is required before KPI/KRA can be defined.";
											cancel submit;
										}
										if(input.Weightage != null && input.Weightage < 0 || input.Weightage > 100)
										{
											alert "Weightage must be between 0 and 100.";
											cancel submit;
										}
						)
					}
				}

			
}