default list Leave_Type_Config_List
{

			displayName = "Leave Type Config List"
			show all rows from Leave_Type_Config    
			(
				Leave_Type_Name as "Leave Type Name"
				Credit_Frequency as "Credit Frequency"
				Credit_Quantity as "Credit Quantity"
				Is_Continuous as "Is Continuous"
				Include_Weekends as "Include Weekends"
				Document_Required as "Document Required"
				Validity_Days as "Validity Days"
				Is_Active as "Is Active"
			)
			filters
			(
				Credit_Frequency
				Is_Active
			)
			sort by
			(
				Leave_Type_Name ascending
			)
		
}