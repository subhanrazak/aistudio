form Leave_Type_Config
{

			displayname = "Leave Type Config"
			Leave_Type_Details
			(
				type = section
				displayname = "Leave Type Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Leave_Type_Name
			(
    			type = text
				displayname = "Leave Type Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Credit_Frequency
			(
				type = picklist
				displayname = "Credit Frequency"
				values = {"Monthly","Annual","Manual","On_Event"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Credit_Quantity
			(
				type = decimal
				displayname = "Credit Quantity"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Max_Balance
			(
				type = decimal
				displayname = "Max Balance"
				initial value = 0
	 			row = 1
	 			column = 2   
				width = medium
			)
			Validity_Days
			(
				type = number
				displayname = "Validity Days"
				initial value = 90
	 			row = 1
	 			column = 1   
				width = medium
			)
			Leave_Rules
			(
				type = section
				displayname = "Leave Rules"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Credit_After_15th
			(
    			type = checkbox
				displayname = "Credit After 15th"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Is_Continuous
			(
    			type = checkbox
				displayname = "Is Continuous"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Include_Weekends
			(
    			type = checkbox
				displayname = "Include Weekends"
				initial value = false
	 			row = 2
	 			column = 1   
				width = medium
			)
			Document_Required
			(
    			type = checkbox
				displayname = "Document Required"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}