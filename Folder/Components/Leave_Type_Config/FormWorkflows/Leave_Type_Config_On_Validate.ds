Leave_Type_Config_On_Validate as "Leave Type Config - On Validate"
{

				type =  form
				form = Leave_Type_Config

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Credit_Quantity,-1) < 0)
										{
											alert "Credit quantity cannot be negative.";
											cancel submit;
										}
										if(ifnull(input.Max_Balance,-1) < 0)
										{
											alert "Max balance cannot be negative.";
											cancel submit;
										}
										if(ifnull(input.Validity_Days,-1) < 0)
										{
											alert "Validity days cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}