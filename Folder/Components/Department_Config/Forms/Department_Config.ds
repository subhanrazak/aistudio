form Department_Config
{

			displayname = "Department Config"
			Department_Details
			(
				type = section
				displayname = "Department Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Department_Name
			(
    			type = text
				displayname = "Department Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Head
			(
				type = picklist	
				displayname = "Department Head"
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}