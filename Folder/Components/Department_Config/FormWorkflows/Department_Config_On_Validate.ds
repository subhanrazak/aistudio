Department_Config_On_Validate as "Department Config - On Validate"
{

				type =  form
				form = Department_Config

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											duplicateDepartments = Department_Config[Department_Name == input.Department_Name && ID != input.ID];
										if(duplicateDepartments.count() > 0)
										{
											alert "Department already exists.";
											cancel submit;
										}
						)
					}
				}

			
}