form Interview_Feedback
{

			displayname = "Interview Feedback"
			Interview_Details
			(
				type = section
				displayname = "Interview Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Job_Application
			(
				type = picklist	
				displayname = "Job Application"
				values  = Job_Application.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Candidate
			(
    			type = text
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
				isencrypted = true
			)
			Job_Request
			(
    			type = text
				displayname = "Job Request"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Round_Number
			(
				type = number
				displayname = "Round Number"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Panel_Member
			(
    			type = picklist
				displayname = "Panel Member"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Feedback_Details
			(
				type = section
				displayname = "Feedback Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Feedback_Notes
			(
    			type = textarea
				displayname = "Feedback Notes"
				height = 160px
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Recommendation
			(
				type = picklist
				values = {"Next_Round","On_Hold","Candidate_Pool","Reject","Select"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Feedback_Date
			(
    			type = date
				displayname = "Feedback Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}