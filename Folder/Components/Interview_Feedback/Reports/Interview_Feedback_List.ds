default list Interview_Feedback_List
{

			displayName = "Interview Feedback List"
			show all rows from Interview_Feedback    
			(
				Job_Application as "Job Application"
				Candidate
				Job_Request as "Job Request"
				Round_Number as "Round Number"
				Panel_Member as "Panel Member"
				Recommendation
				Feedback_Date as "Feedback Date"
			)
			filters
			(
				Job_Application
				Recommendation
				Feedback_Date
				Panel_Member
			)
			sort by
			(
				Feedback_Date descending
			)
		
}