kanban Interview_Recommendation_Kanban
{

			displayName = "Interview Recommendation Kanban"
			show all rows from Interview_Feedback    
			(
				Job_Application as "Job Application"
				Candidate
				Job_Request as "Job Request"
				Round_Number as "Round Number"
				Panel_Member as "Panel Member"
				Recommendation
				Feedback_Date as "Feedback Date"
			)
			filters
			(
				Recommendation
				Feedback_Date
				Panel_Member
			)
			sort by
			(
				Feedback_Date descending
			)
			options
			(
	 			display field = Recommendation
				sort order  = ascending
				record count  = enable
	 		)
		
}