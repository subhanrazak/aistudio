default list Interview_Round_Config_List
{

			displayName = "Interview Round Config List"
			show all rows from Interview_Round_Config    
			(
				Job_Request as "Job Request"
				Round_Number as "Round Number"
				Round_Name as "Round Name"
				Panel_Members as "Panel Members"
			)
			filters
			(
				Job_Request
			)
			sort by
			(
				Round_Number ascending
			)
		
}