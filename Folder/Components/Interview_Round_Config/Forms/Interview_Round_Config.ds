form Interview_Round_Config
{

			displayname = "Interview Round Config"
			Interview_Round_Details
			(
				type = section
				displayname = "Interview Round Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Job_Request
			(
				type = picklist	
				displayname = "Job Request"
				values  = Job_Request.ID
    			displayformat = [Job_Title]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Round_Number
			(
				type = number
				displayname = "Round Number"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Round_Name
			(
    			type = text
				displayname = "Round Name"
				maxchar = 120
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Panel_Members
			(
				type = checkboxes	
				displayname = "Panel Members"
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}