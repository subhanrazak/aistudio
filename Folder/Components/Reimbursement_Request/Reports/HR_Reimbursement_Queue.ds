list HR_Reimbursement_Queue
{

			displayName = "HR Reimbursement Queue"
			show all rows from Reimbursement_Request  [Status == "Pending_HR" || Category == "Health_Insurance"]  
			(
				Employee
				Reimbursement_Type as "Reimbursement Type"
				Category
				Source
				Amount_Claimed as "Amount Claimed"
				Expense_Date as "Expense Date"
				Insurance_Sub_Type as "Insurance Sub Type"
				within_limit as "Within Limit"
				Status
			)
			filters
			(
				Reimbursement_Type
				Category
				Source
				Status
				Expense_Date
			)
			sort by
			(
				Expense_Date descending
			)
		
}