list Finance_Reimbursement_Queue
{

			displayName = "Finance Reimbursement Queue"
			show all rows from Reimbursement_Request  [Status == "Pending_Finance" || Status == "Processed"]  
			(
				Employee
				Reimbursement_Type as "Reimbursement Type"
				Category
				Source
				Linked_Travel_Request as "Linked Travel Request"
				Amount_Claimed as "Amount Claimed"
				within_limit as "Within Limit"
				Status
				Processed_Date as "Processed Date"
			)
			filters
			(
				Reimbursement_Type
				Category
				Source
				Status
				Processed_Date
			)
			sort by
			(
				Processed_Date descending
			)
		
}