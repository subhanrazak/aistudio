kanban Reimbursement_Status_Kanban
{

			displayName = "Reimbursement Status Kanban"
			show all rows from Reimbursement_Request    
			(
				Employee
				Reimbursement_Type as "Reimbursement Type"
				Category
				Source
				Amount_Claimed as "Amount Claimed"
				Expense_Date as "Expense Date"
				Status
				Processed_Date as "Processed Date"
			)
			filters
			(
				Employee
				Reimbursement_Type
				Category
				Source
				Status
			)
			sort by
			(
				Expense_Date descending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}