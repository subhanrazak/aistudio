list My_Reimbursements
{

			displayName = "My Reimbursements"
			show all rows from Reimbursement_Request  [Employee.Official_Email == zoho.loginuser]  
			(
				Employee
				Reimbursement_Type as "Reimbursement Type"
				Category
				Source
				Linked_Travel_Request as "Linked Travel Request"
				Amount_Claimed as "Amount Claimed"
				Expense_Date as "Expense Date"
				Status
				Processed_Date as "Processed Date"
			)
			filters
			(
				Reimbursement_Type
				Category
				Source
				Status
				Expense_Date
			)
			sort by
			(
				Expense_Date descending
			)
		
}