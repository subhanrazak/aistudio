Reimbursement_Request_Source_On_User_Input as "Reimbursement Request - Source On User Input"
{

				type =  form
				form = Reimbursement_Request

				record event = on add or edit

				on user input of Source
				{
					actions 
					{
						custom deluge script
						(
											if(input.Source == "Travel_Module")
										{
											show Linked_Travel_Request;
											hide Expense_Date;
											hide Supporting_Bills;
										}
										else
										{
											hide Linked_Travel_Request;
											show Expense_Date;
											show Supporting_Bills;
										}
						)
					}
				}

			
}