form Comp_Off_Awards_Used
{

			displayname = "Comp Off Awards Used"
			Usage_Details
			(
				type = section
				displayname = "Usage Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Time_Off_Request
			(
				type = picklist	
				displayname = "Time Off Request"
				values  = Time_Off_Request.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Comp_Off_Award
			(
				type = picklist	
				displayname = "Comp Off Award"
				values  = Comp_Off_Award.ID
    			displayformat = [Work_Date]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Days_Consumed
			(
				type = decimal
				displayname = "Days Consumed"
				initial value = 0.5
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}