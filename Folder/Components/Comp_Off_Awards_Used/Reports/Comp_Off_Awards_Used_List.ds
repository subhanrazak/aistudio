default list Comp_Off_Awards_Used_List
{

			displayName = "Comp Off Awards Used List"
			show all rows from Comp_Off_Awards_Used    
			(
				Time_Off_Request as "Time Off Request"
				Comp_Off_Award as "Comp Off Award"
				Days_Consumed as "Days Consumed"
			)
			filters
			(
				Time_Off_Request
			)
			sort by
			(
				Time_Off_Request ascending
			)
		
}