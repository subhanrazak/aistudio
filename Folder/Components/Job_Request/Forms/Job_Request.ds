form Job_Request
{

			displayname = "Job Request"
			Job_Details
			(
				type = section
				displayname = "Job Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Job_Title
			(
    			type = text
				displayname = "Job Title"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Department_Config.ID
    			displayformat = [Department_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Number_Of_Positions
			(
				type = number
				displayname = "Number Of Positions"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requested_By
			(
    			type = picklist
				displayname = "Requested By"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Job_Description
			(
    			type = textarea
				displayname = "Job Description"
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Details
			(
				type = section
				displayname = "Approval Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Draft","Pending_CEO","Approved","Rejected","Closed"}
				initial value = "Draft"
	 			row = 2
	 			column = 1   
				width = medium
			)
			CEO_Comments
			(
    			type = textarea
				displayname = "CEO Comments"
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Approved_Date
			(
    			type = date
				displayname = "Approved Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linkedin_Posted
			(
    			type = checkbox
				displayname = "Post to LinkedIn"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}