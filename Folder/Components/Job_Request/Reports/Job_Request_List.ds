default list Job_Request_List
{

			displayName = "Job Request List"
			show all rows from Job_Request    
			(
				Job_Title as "Job Title"
				Department
				Number_Of_Positions as "Number Of Positions"
				Requested_By as "Requested By"
				Status
				Approved_Date as "Approved Date"
				Linkedin_Posted as "LinkedIn Posted"
			)
			filters
			(
				Department
				Status
				Linkedin_Posted
				"Open Requests"  :  Status != "Closed"
			)
			sort by
			(
				Job_Title ascending
			)
		
}