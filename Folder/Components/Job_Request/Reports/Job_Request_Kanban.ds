kanban Job_Request_Kanban
{

			displayName = "Job Request Kanban"
			show all rows from Job_Request    
			(
				Job_Title as "Job Title"
				Department
				Number_Of_Positions as "Number Of Positions"
				Requested_By as "Requested By"
				Status
				Approved_Date as "Approved Date"
			)
			filters
			(
				Department
				Status
			)
			sort by
			(
				Job_Title ascending
			)
			options
			(
	 			display field = Status
				sort order  = ascending
				record count  = enable
	 		)
		
}