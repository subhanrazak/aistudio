kanban Training_Completion_Kanban
{

			displayName = "Training Completion Kanban"
			show all rows from Training_Completion    
			(
				Training_Programme as "Training Programme"
				Employee
				Completion_Date as "Completion Date"
				Status
			)
			filters
			(
				Training_Programme
				Status
				Completion_Date
			)
			sort by
			(
				Completion_Date descending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}