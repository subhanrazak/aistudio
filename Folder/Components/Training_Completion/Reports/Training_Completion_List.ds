default list Training_Completion_List
{

			displayName = "Training Completion List"
			show all rows from Training_Completion    
			(
				Training_Programme as "Training Programme"
				Employee
				Employee_Record as "Employee Record"
				Completion_Date as "Completion Date"
				Certificate_Upload as "Certificate Upload"
				Status
			)
			filters
			(
				Training_Programme
				Status
				Completion_Date
			)
			sort by
			(
				Completion_Date descending
			)
		
}