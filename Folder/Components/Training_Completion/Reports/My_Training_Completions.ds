list My_Training_Completions
{

			displayName = "My Training Completions"
			show all rows from Training_Completion  [Employee == zoho.loginuserid || Employee == zoho.loginuser]  
			(
				Training_Programme as "Training Programme"
				Employee
				Completion_Date as "Completion Date"
				Certificate_Upload as "Certificate Upload"
				Status
			)
			filters
			(
				Training_Programme
				Status
				Completion_Date
			)
			sort by
			(
				Completion_Date descending
			)
		
}