form Training_Completion
{

			displayname = "Training Completion"
			Completion_Details
			(
				type = section
				displayname = "Completion Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Training_Programme
			(
				type = picklist	
				displayname = "Training Programme"
				values  = Training_Programme.ID
    			displayformat = [Programme_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee
			(
    			type = picklist
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Employee_Record
			(
				type = picklist	
				displayname = "Employee Record"
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Completion_Date
			(
    			type = date
				displayname = "Completion Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Certificate_Upload
			(
    			type = upload file
				displayname = "Certificate Upload"
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Status
			(
				type = picklist
				values = {"Pending","Completed"}
				initial value = "Completed"
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}