form Attendance_Log
{

			displayname = "Attendance Log"
			Attendance_Details
			(
				type = section
				displayname = "Attendance Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Attendance_Date
			(
    			type = date
				displayname = "Attendance Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Login_Time
			(
    			type = datetime
				displayname = "Login Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Logout_Time
			(
    			type = datetime
				displayname = "Logout Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Working_Hours
			(
				type = decimal
				displayname = "Working Hours"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Attendance_Status
			(
				type = picklist
				displayname = "Attendance Status"
				values = {"Not_Marked","Present","Absent","Half_Day","WFH","On_Duty","Holiday","Leave"}
				initial value = "Not_Marked"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Source
			(
				type = picklist
				values = {"System","Biometric","Manual","Regularised"}
				initial value = "System"
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}