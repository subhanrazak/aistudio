list My_Attendance
{

			displayName = "My Attendance"
			show all rows from Attendance_Log    
			(
				Employee
				Attendance_Date as "Attendance Date"
				Login_Time as "Login Time"
				Logout_Time as "Logout Time"
				Working_Hours as "Working Hours"
				Attendance_Status as "Attendance Status"
				Source
			)
			filters
			(
				Attendance_Date
				Attendance_Status
				Source
			)
			sort by
			(
				Attendance_Date descending
			)
		
}