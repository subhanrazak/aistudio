kanban Attendance_Status_Kanban
{

			displayName = "Attendance Status Kanban"
			show all rows from Attendance_Log    
			(
				Employee
				Attendance_Date as "Attendance Date"
				Login_Time as "Login Time"
				Logout_Time as "Logout Time"
				Working_Hours as "Working Hours"
				Attendance_Status as "Attendance Status"
				Source
			)
			filters
			(
				Employee
				Attendance_Date
				Attendance_Status
				Source
			)
			sort by
			(
				Attendance_Date descending
			)
			options
			(
	 			display field = Attendance_Status
				sort order  = ascending
				record count  = enable
	 		)
		
}