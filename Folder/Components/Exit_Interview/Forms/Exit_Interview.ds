form Exit_Interview
{

			displayname = "Exit Interview"
			Interview_Details
			(
				type = section
				displayname = "Interview Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Resignation_Request
			(
				type = picklist	
				displayname = "Resignation Request"
				values  = Resignation_Request[Status == "Approved"].ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee
			(
				type = picklist	
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Interview_Date
			(
    			type = date
				displayname = "Interview Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Conducted_By
			(
    			type = picklist
				displayname = "Conducted By"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Exit_Reason_Category
			(
				type = picklist
				displayname = "Exit Reason Category"
				values = {"Better_Opportunity","Higher_Education","Personal_Reasons","Relocation","Health","Compensation","Work_Environment","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Would_Rejoin
			(
				type = picklist
				displayname = "Would Rejoin"
				values = {"Yes","No","Maybe"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Feedback_Details
			(
				type = section
				displayname = "Feedback Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Feedback_On_Manager
			(
    			type = textarea
				displayname = "Feedback On Manager"
				height = 140px
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Feedback_On_Company
			(
    			type = textarea
				displayname = "Feedback On Company"
				height = 140px
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Feedback_On_Culture
			(
    			type = textarea
				displayname = "Feedback On Culture"
				height = 140px
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Suggestions
			(
    			type = textarea
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Additional_Notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 120px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Is_Confidential
			(
    			type = checkbox
				displayname = "Is Confidential"
				initial value = true
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}