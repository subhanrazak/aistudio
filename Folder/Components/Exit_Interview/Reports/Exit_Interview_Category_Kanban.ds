kanban Exit_Interview_Category_Kanban
{

			displayName = "Exit Interview Category Kanban"
			show all rows from Exit_Interview    
			(
				Resignation_Request as "Resignation Request"
				Employee
				Interview_Date as "Interview Date"
				Conducted_By as "Conducted By"
				Exit_Reason_Category as "Exit Reason Category"
				Would_Rejoin as "Would Rejoin"
				Is_Confidential as "Is Confidential"
			)
			filters
			(
				Employee
				Interview_Date
				Exit_Reason_Category
				Would_Rejoin
			)
			sort by
			(
				Interview_Date descending
			)
			options
			(
	 			display field = Exit_Reason_Category
				sort order  = custom
				record count  = enable
	 		)
		
}