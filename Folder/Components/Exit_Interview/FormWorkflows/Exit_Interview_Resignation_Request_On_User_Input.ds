Exit_Interview_Resignation_Request_On_User_Input as "Exit Interview - Resignation Request On User Input"
{

				type =  form
				form = Exit_Interview

				record event = on add or edit

				on user input of Resignation_Request
				{
					actions 
					{
						custom deluge script
						(
											input.Employee = null;
										if(input.Resignation_Request != null)
										{
											resignationRows = Resignation_Request[ID == input.Resignation_Request];
											if(resignationRows.count() > 0)
											{
												input.Employee = resignationRows.Employee;
											}
										}
						)
					}
				}

			
}