Exit_Interview_On_Success as "Exit Interview - On Success"
{

				type =  form
				form = Exit_Interview

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											thisapp.Add_Audit_Log("EXIT_INTERVIEW_SAVE","Offboarding","Exit_Interview",input.ID,"Save","","","Exit interview saved",true,"");
										}catch (auditErr)
										{
										}
						)
					}
				}

			
}