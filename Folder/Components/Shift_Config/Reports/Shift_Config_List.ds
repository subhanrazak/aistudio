default list Shift_Config_List
{

			displayName = "Shift Config List"
			show all rows from Shift_Config    
			(
				Shift_Name as "Shift Name"
				Start_Time as "Start Time"
				End_Time as "End Time"
				Applicable_Days as "Applicable Days"
				Is_Active as "Is Active"
			)
			filters
			(
				Is_Active
			)
			sort by
			(
				Shift_Name ascending
			)
		
}