form Shift_Config
{

			displayname = "Shift Config"
			Shift_Details
			(
				type = section
				displayname = "Shift Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Shift_Name
			(
    			type = text
				displayname = "Shift Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Start_Time
			(
    			type = time
				displayname = "Start Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have End_Time
			(
    			type = time
				displayname = "End Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Applicable_Days
			(
				type = checkboxes	
				displayname = "Applicable Days"
				values = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"}
				layout = 2
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}