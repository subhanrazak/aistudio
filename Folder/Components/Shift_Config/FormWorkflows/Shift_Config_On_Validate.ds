Shift_Config_On_Validate as "Shift Config - On Validate"
{

				type =  form
				form = Shift_Config

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Start_Time == input.End_Time)
										{
											alert "Start time and end time cannot be the same.";
											cancel submit;
										}
										if(input.Applicable_Days == null || input.Applicable_Days.size() == 0)
										{
											alert "Select at least one applicable day.";
											cancel submit;
										}
						)
					}
				}

			
}