form Travel_HR_Recommendations
{

			displayname = "Travel HR Recommendations"
			Recommendation_Details
			(
				type = section
				displayname = "Recommendation Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Travel_Request
			(
				type = picklist	
				displayname = "Travel Request"
				values  = Travel_Request.ID
    			displayformat = [Destination]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Travel_Requirement
			(
				type = picklist	
				displayname = "Travel Requirement"
				values  = Travel_Requirements.ID
    			displayformat = [Requirement_Type]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Recommendation_Type
			(
    			type = text
				displayname = "Recommendation Type"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor_Or_Operator
			(
    			type = text
				displayname = "Vendor Or Operator"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Departure_Time
			(
    			type = datetime
				displayname = "Departure Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Arrival_Time
			(
    			type = datetime
				displayname = "Arrival Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Check_In_Date
			(
    			type = date
				displayname = "Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Check_Out_Date
			(
    			type = date
				displayname = "Check Out Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Estimated_Cost
			(
				displayname = "Estimated Cost"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Selected
			(
    			type = checkbox
				displayname = "Is Selected"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}