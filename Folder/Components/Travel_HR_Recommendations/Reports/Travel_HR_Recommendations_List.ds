default list Travel_HR_Recommendations_List
{

			displayName = "Travel HR Recommendations List"
			show all rows from Travel_HR_Recommendations    
			(
				Travel_Request as "Travel Request"
				Travel_Requirement as "Travel Requirement"
				Recommendation_Type as "Recommendation Type"
				Vendor_Or_Operator as "Vendor Or Operator"
				Departure_Time as "Departure Time"
				Arrival_Time as "Arrival Time"
				Check_In_Date as "Check In Date"
				Check_Out_Date as "Check Out Date"
				Estimated_Cost as "Estimated Cost"
				Is_Selected as "Is Selected"
			)
			filters
			(
				Travel_Request
				Travel_Requirement
				Recommendation_Type
				Is_Selected
			)
			sort by
			(
				Travel_Request ascending
			)
		
}