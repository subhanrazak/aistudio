Travel_HR_Recommendations_On_Validate as "Travel HR Recommendations - On Validate"
{

				type =  form
				form = Travel_HR_Recommendations

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Estimated_Cost < 0)
										{
											alert "Estimated cost cannot be negative.";
											cancel submit;
										}
										if(input.Departure_Time != null && input.Arrival_Time != null && input.Arrival_Time < input.Departure_Time)
										{
											alert "Arrival time cannot be before departure time.";
											cancel submit;
										}
										if(input.Check_In_Date != null && input.Check_Out_Date != null && input.Check_Out_Date < input.Check_In_Date)
										{
											alert "Check-out date cannot be before check-in date.";
											cancel submit;
										}
						)
					}
				}

			
}