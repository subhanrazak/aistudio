Extension_ID_Number_On_User_Input as "Extension ID Number - On User Input"
{

				type =  form
				form = ID_Card_Request

				record event = on add or edit

				on user input of Extension_ID_Number
				{
					actions 
					{
						custom deluge script
						(
											hide Barcode_Display;
										if(input.Extension_ID_Number != null && input.Extension_ID_Number != "")
										{
											show Barcode_Display;
											if(input.Status == "Submitted")
											{
												input.Status = "Extension_ID_Updated";
											}
										}
						)
					}
				}

			
}