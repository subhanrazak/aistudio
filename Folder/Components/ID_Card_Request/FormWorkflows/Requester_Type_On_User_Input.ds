Requester_Type_On_User_Input as "Requester Type - On User Input"
{

				type =  form
				form = ID_Card_Request

				record event = on add or edit

				on user input of Requester_Type
				{
					actions 
					{
						custom deluge script
						(
											hide Employee_Requester;
										hide Member_Requester;
										input.Employee_Requester = null;
										input.Member_Requester = null;
										if(input.Requester_Type == "Employee")
										{
											show Employee_Requester;
										}
										else if(input.Requester_Type == "Member")
										{
											show Member_Requester;
										}
						)
					}
				}

			
}