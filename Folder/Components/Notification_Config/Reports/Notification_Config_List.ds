default list Notification_Config_List
{

			displayName = "Notification Config List"
			show all rows from Notification_Config    
			(
				Event_Key as "Event Key"
				Module_Name as "Module Name"
				Recipient_Emails as "Recipient Emails"
				Subject_Template as "Subject Template"
				Is_Active as "Is Active"
			)
			filters
			(
				Module_Name
				Is_Active
			)
			sort by
			(
				Event_Key ascending
			)
		
}