form Notification_Config
{

			displayname = "Notification Config"
			Template_Details
			(
				type = section
				displayname = "Template Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Event_Key
			(
    			type = text
				displayname = "Event Key"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Module_Name
			(
				type = picklist
				displayname = "Module Name"
				values = {"Settings","Employee","Recruitment","Attendance_Leave","Performance","Training_Announcement","Travel","Reimbursement","Gift_Registration","Offboarding","ID_Card","Users"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email_Content
			(
				type = section
				displayname = "Email Content"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Recipient_Emails
			(
    			type = textarea
				displayname = "Recipient Emails"
				height = 80px
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Subject_Template
			(
    			type = text
				displayname = "Subject Template"
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have Body_Template
			(
    			type = textarea
				displayname = "Body Template"
				height = 160px
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}