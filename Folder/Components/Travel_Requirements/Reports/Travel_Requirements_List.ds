default list Travel_Requirements_List
{

			displayName = "Travel Requirements List"
			show all rows from Travel_Requirements    
			(
				Travel_Request as "Travel Request"
				Requirement_Type as "Requirement Type"
				Preferred_Date as "Preferred Date"
				Preferred_Time as "Preferred Time"
				Additional_Notes as "Additional Notes"
			)
			filters
			(
				Travel_Request
				Requirement_Type
			)
			sort by
			(
				Travel_Request ascending
				Preferred_Date ascending
			)
		
}