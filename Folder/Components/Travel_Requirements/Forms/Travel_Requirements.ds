form Travel_Requirements
{

			displayname = "Travel Requirements"
			Requirement_Details
			(
				type = section
				displayname = "Requirement Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Travel_Request
			(
				type = picklist	
				displayname = "Travel Request"
				values  = Travel_Request.ID
    			displayformat = [Destination]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Requirement_Type
			(
				type = picklist
				displayname = "Requirement Type"
				values = {"Onward_Flight","Return_Flight","Onward_Train","Return_Train","Onward_Bus","Return_Bus","Hotel","Car_Rental","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Preferred_Date
			(
    			type = date
				displayname = "Preferred Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Time
			(
    			type = time
				displayname = "Preferred Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 2   
				width = medium
			)
			Additional_Notes
			(
    			type = text
				displayname = "Additional Notes"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}