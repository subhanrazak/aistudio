form Resignation_Request
{

			displayname = "Resignation Request"
			Resignation_Details
			(
				type = section
				displayname = "Resignation Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Resignation_Date
			(
    			type = date
				displayname = "Resignation Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Reason
			(
    			type = textarea
				height = 140px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Working_Day
			(
    			type = date
				displayname = "Last Working Day"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_LWD
			(
    			type = date
				displayname = "Effective LWD"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Exit_Type
			(
				type = picklist
				displayname = "Exit Type"
				values = {"Voluntary","Involuntary"}
				initial value = "Voluntary"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Processing_Details
			(
				type = section
				displayname = "Processing Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Pending_Manager","Pending_HR","Approved","Rejected"}
				initial value = "Pending_Manager"
	 			row = 2
	 			column = 1   
				width = medium
			)
			HR_Modified_LWD
			(
    			type = date
				displayname = "HR Modified LWD"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			LWD_Modification_File
			(
    			type = upload file
				displayname = "LWD Modification File"
				browse = local_drive, google_docs, zoho_docs
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}