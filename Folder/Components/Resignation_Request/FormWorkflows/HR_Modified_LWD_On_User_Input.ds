HR_Modified_LWD_On_User_Input as "HR Modified LWD - On User Input"
{

				type =  form
				form = Resignation_Request

				record event = on add or edit

				on user input of HR_Modified_LWD
				{
					actions 
					{
						custom deluge script
						(
											if(input.HR_Modified_LWD != null)
										{
											input.Effective_LWD = input.HR_Modified_LWD;
										}
										else
										{
											input.Effective_LWD = input.Last_Working_Day;
										}
						)
					}
				}

			
}