list My_Resignation_Requests
{

			displayName = "My Resignation Requests"
			show all rows from Resignation_Request  [Employee.Official_Email == zoho.loginuser]  
			(
				Employee
				Resignation_Date as "Resignation Date"
				Last_Working_Day as "Last Working Day"
				Effective_LWD as "Effective LWD"
				Exit_Type as "Exit Type"
				Status
			)
			filters
			(
				Status
				Resignation_Date
				Effective_LWD
			)
			sort by
			(
				Resignation_Date descending
			)
		
}