kanban Resignation_Status_Kanban
{

			displayName = "Resignation Status Kanban"
			show all rows from Resignation_Request    
			(
				Employee
				Resignation_Date as "Resignation Date"
				Last_Working_Day as "Last Working Day"
				Effective_LWD as "Effective LWD"
				Exit_Type as "Exit Type"
				Status
			)
			filters
			(
				Employee
				Exit_Type
				Status
				Effective_LWD
			)
			sort by
			(
				Effective_LWD ascending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}