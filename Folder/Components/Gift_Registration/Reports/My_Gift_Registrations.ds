list My_Gift_Registrations
{

			displayName = "My Gift Registrations"
			show all rows from Gift_Registration  [Employee.Official_Email == zoho.loginuser]  
			(
				Employee
				Gift_Name as "Gift Name"
				Received_From as "Received From"
				Received_Date as "Received Date"
				Estimated_Value as "Estimated Value"
				Status
				Final_Decision as "Final Decision"
			)
			filters
			(
				Status
				Received_Date
			)
			sort by
			(
				Received_Date descending
			)
		
}