kanban Gift_Status_Kanban
{

			displayName = "Gift Status Kanban"
			show all rows from Gift_Registration    
			(
				Employee
				Gift_Name as "Gift Name"
				Received_From as "Received From"
				Received_Date as "Received Date"
				Estimated_Value as "Estimated Value"
				Status
				Final_Decision as "Final Decision"
			)
			filters
			(
				Employee
				Status
				Received_Date
			)
			sort by
			(
				Received_Date descending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}