Gift_Registration_Status_On_User_Input as "Gift Registration - Status On User Input"
{

				type =  form
				form = Gift_Registration

				record event = on add or edit

				on user input of Status
				{
					actions 
					{
						custom deluge script
						(
											hide Final_Decision;
										if(input.Status == "Pending_Finance")
										{
											show Final_Decision;
										}
						)
					}
				}

			
}