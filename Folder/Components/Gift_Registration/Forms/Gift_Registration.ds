form Gift_Registration
{

			displayname = "Gift Registration"
			Gift_Details
			(
				type = section
				displayname = "Gift Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee
			(
				type = picklist	
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Gift_Name
			(
    			type = text
				displayname = "Gift Name"
				maxchar = 200
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Gift_Description
			(
    			type = textarea
				displayname = "Gift Description"
				height = 140px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Received_From
			(
    			type = text
				displayname = "Received From"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Received_Date
			(
    			type = date
				displayname = "Received Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor_Details
			(
    			type = textarea
				displayname = "Vendor Details"
				height = 120px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Estimated_Value
			(
				displayname = "Estimated Value"
				type = INR
				format = commadotindian
				maxchar = 14
	 			row = 1
	 			column = 1   
				width = medium
			)
			Processing_Details
			(
				type = section
				displayname = "Processing Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Pending_Manager","Pending_HR","Pending_Finance","Approved_Retain","Approved_Return","Rejected"}
				initial value = "Pending_Manager"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Final_Decision
			(
				type = picklist
				displayname = "Final Decision"
				values = {"Retain","Return"}
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}