kanban Training_Programme_Kanban
{

			displayName = "Training Programme Kanban"
			show all rows from Training_Programme    
			(
				Programme_Name as "Programme Name"
				Trainer_Name as "Trainer Name"
				Training_Date as "Training Date"
				Training_Mode as "Training Mode"
				Status
			)
			filters
			(
				Training_Mode
				Status
				Training_Date
			)
			sort by
			(
				Training_Date ascending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}