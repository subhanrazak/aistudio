default list Training_Programme_List
{

			displayName = "Training Programme List"
			show all rows from Training_Programme    
			(
				Programme_Name as "Programme Name"
				Trainer_Name as "Trainer Name"
				Training_Date as "Training Date"
				Training_End_Date as "Training End Date"
				Training_Mode as "Training Mode"
				Status
			)
			filters
			(
				Training_Mode
				Status
				Training_Date
			)
			sort by
			(
				Training_Date descending
			)
		
}