list My_Training_Schedule
{

			displayName = "My Training Schedule"
			show all rows from Training_Programme  [Assigned_Employees.Official_Email == zoho.loginuser]  
			(
				Programme_Name as "Programme Name"
				Trainer_Name as "Trainer Name"
				Training_Date as "Training Date"
				Training_End_Date as "Training End Date"
				Training_Mode as "Training Mode"
				Venue_Or_Link as "Venue Or Link"
				Status
			)
			filters
			(
				Training_Mode
				Status
				Training_Date
			)
			sort by
			(
				Training_Date ascending
			)
		
}