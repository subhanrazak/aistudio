form Training_Programme
{

			displayname = "Training Programme"
			Programme_Details
			(
				type = section
				displayname = "Programme Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Programme_Name
			(
    			type = text
				displayname = "Programme Name"
				maxchar = 200
	 			row = 1
	 			column = 1   
				width = medium
			)
			Linked_Training_Request
			(
				type = list	
				displayname = "Linked Training Request"
				values  = Training_Request.ID
    			displayformat = [Training_Topic]
				height = 120px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Trainer_Name
			(
    			type = text
				displayname = "Trainer Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Training_Date
			(
    			type = date
				displayname = "Training Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Training_End_Date
			(
    			type = date
				displayname = "Training End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Training_Mode
			(
				type = picklist
				displayname = "Training Mode"
				values = {"Online","Offline","Hybrid"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Venue_Or_Link
			(
    			type = text
				displayname = "Venue Or Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Assigned_Employees
			(
				type = list	
				displayname = "Assigned Employees"
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
				height = 150px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Scheduled","Completed","Cancelled"}
				initial value = "Scheduled"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}