Training_Programme_On_Load as "Training Programme - On Load"
{

				type =  form
				form = Training_Programme

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == null || input.Status == "")
										{
											input.Status = "Scheduled";
										}
						)
					}
				}

			
}