Training_Programme_On_Validate as "Training Programme - On Validate"
{

				type =  form
				form = Training_Programme

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Training_End_Date != null && input.Training_End_Date < input.Training_Date)
										{
											alert "Training end date cannot be before training date.";
											cancel submit;
										}
										if(input.Status == "Completed" && input.Training_Date > zoho.currentdate)
										{
											alert "Future training programmes cannot be marked completed.";
											cancel submit;
										}
						)
					}
				}

			
}