kanban Employee_Status_Kanban
{

			displayName = "Employee Status Kanban"
			show all rows from Employee_Master    
			(
				Full_Name as "Full Name"
				Department
				Designation
				Employment_Type as "Employment Type"
				Employment_Status as "Employment Status"
				Date_Of_Joining as "Date Of Joining"
			)
			filters
			(
				Department
				Employment_Type
				Employment_Status
			)
			sort by
			(
				Full_Name ascending
			)
			options
			(
	 			display field = Employment_Status
				sort order  = ascending
				record count  = enable
	 		)
		
}