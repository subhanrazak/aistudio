default list All_Employees
{

			displayName = "All Employees"
			show all rows from Employee_Master    
			(
				Employee_ID as "Employee ID"
				Full_Name as "Full Name"
				Department
				Designation
				Employment_Type as "Employment Type"
				Employment_Status as "Employment Status"
				Date_Of_Joining as "Date Of Joining"
				Primary_Manager as "Primary Manager"
				Official_Email as "Official Email"
			)
			filters
			(
				Employment_Status
				Department
				Employment_Type
			)
			sort by
			(
				Full_Name ascending
			)
		
}