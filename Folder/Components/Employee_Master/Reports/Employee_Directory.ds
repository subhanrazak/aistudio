list Employee_Directory
{

			displayName = "Employee Directory"
			show all rows from Employee_Master  [Employment_Status == "Active" || Employment_Status == "Probation"]  
			(
				Full_Name as "Full Name"
				Designation
				Department
				Official_Email as "Official Email"
				Primary_Manager as "Primary Manager"
				Employment_Status as "Employment Status"
			)
			filters
			(
				Department
				Employment_Status
			)
			sort by
			(
				Full_Name ascending
			)
		
}