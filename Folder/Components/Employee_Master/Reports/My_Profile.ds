list My_Profile
{

			displayName = "My Profile"
			show all rows from Employee_Master  [Official_Email == zoho.loginuser]  
			(
				Employee_ID as "Employee ID"
				Full_Name as "Full Name"
				Date_Of_Birth as "Date Of Birth"
				Gender
				Department
				Designation
				Employment_Type as "Employment Type"
				Date_Of_Joining as "Date Of Joining"
				Tenure_Date as "Tenure Date"
				Primary_Manager as "Primary Manager"
				Secondary_Manager as "Secondary Manager"
				Official_Email as "Official Email"
				Phone
				Employment_Status as "Employment Status"
			)
			sort by
			(
				Full_Name ascending
			)
		
}