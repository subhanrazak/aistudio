form Employee_Master
{

			displayname = "Employee Master"
			Personal_Information
			(
				type = section
				displayname = "Personal Information"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee_ID
			(
    			type = autonumber
				displayname = "Employee ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Full_Name
			(
    			type = text
				displayname = "Full Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
				isencrypted = true
			)
			must have Date_Of_Birth
			(
    			type = date
				displayname = "Date Of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
				isencrypted = true
			)
			must have Gender
			(
				type = picklist
				values = {"Male","Female","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Profile_Photo
			(
    			type = image
				displayname = "Profile Photo"
				source  = file
				aspect ratio = original
				camera = primary
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have unique Official_Email
			(
    			type = email
				displayname = "Official Email"
				maxchar = 100
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone
			(
    			type = phonenumber
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Employment_Details
			(
				type = section
				displayname = "Employment Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Department_Config.ID
    			displayformat = [Department_Name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Designation
			(
    			type = text
				maxchar = 150
	 			row = 3
	 			column = 2   
				width = medium
			)
			must have Employment_Type
			(
				type = picklist
				displayname = "Employment Type"
				values = {"Full_Time","Contractor","Intern"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Date_Of_Joining
			(
    			type = date
				displayname = "Date Of Joining"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			must have Tenure_Date
			(
    			type = date
				displayname = "Tenure Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Primary_Manager
			(
				type = picklist	
				displayname = "Primary Manager"
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Secondary_Manager
			(
				type = picklist	
				displayname = "Secondary Manager"
				values  = Employee_Master.ID
    			displayformat = [Full_Name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Notice_Period_Days
			(
				type = picklist	
				displayname = "Notice Period Days"
				values  = Notice_Period_Config.ID
    			displayformat = [Notice_Period_Days]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Status_Details
			(
				type = section
				displayname = "Status Details"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Employment_Status
			(
				type = picklist
				displayname = "Employment Status"
				values = {"Active","Probation","Inactive"}
				initial value = "Active"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Probation_End_Date
			(
    			type = date
				displayname = "Probation End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}