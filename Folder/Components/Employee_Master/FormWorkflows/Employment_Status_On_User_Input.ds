Employment_Status_On_User_Input as "Employment Status - On User Input"
{

				type =  form
				form = Employee_Master

				record event = on add or edit

				on user input of Employment_Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employment_Status == "Probation")
										{
											show Probation_End_Date;
										}
										else
										{
											input.Probation_End_Date = null;
											hide Probation_End_Date;
										}
						)
					}
				}

			
}