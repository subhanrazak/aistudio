Employee_Master_On_Load as "Employee Master - On Load"
{

				type =  form
				form = Employee_Master

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Secondary_Manager;
										if(input.Employment_Status == "Probation")
										{
											show Probation_End_Date;
										}
										else
										{
											hide Probation_End_Date;
										}
						)
					}
				}

			
}