default list Reimbursement_Type_Config_List
{

			displayName = "Reimbursement Type Config List"
			show all rows from Reimbursement_Type_Config    
			(
				Type_Name as "Type Name"
				Category
				Limit_Amount as "Limit Amount"
				Is_Active as "Is Active"
			)
			filters
			(
				Category
				Is_Active
			)
			sort by
			(
				Type_Name ascending
			)
		
}