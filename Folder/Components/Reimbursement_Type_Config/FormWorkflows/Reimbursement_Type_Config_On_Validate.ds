Reimbursement_Type_Config_On_Validate as "Reimbursement Type Config - On Validate"
{

				type =  form
				form = Reimbursement_Type_Config

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(ifnull(input.Limit_Amount,-1) < 0)
										{
											alert "Limit amount cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}