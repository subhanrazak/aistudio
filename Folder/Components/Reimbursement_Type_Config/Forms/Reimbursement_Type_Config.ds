form Reimbursement_Type_Config
{

			displayname = "Reimbursement Type Config"
			Reimbursement_Type_Details
			(
				type = section
				displayname = "Reimbursement Type Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Type_Name
			(
    			type = text
				displayname = "Type Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				values = {"General","Health_Insurance"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Limit_Amount
			(
				displayname = "Limit Amount"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}