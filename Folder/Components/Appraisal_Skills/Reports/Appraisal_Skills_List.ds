default list Appraisal_Skills_List
{

			displayName = "Appraisal Skills List"
			show all rows from Appraisal_Skills    
			(
				Appraisal_Form as "Appraisal Form"
				Skill_Name as "Skill Name"
				Self_Score as "Self Score"
				Manager_Score as "Manager Score"
			)
			filters
			(
				Appraisal_Form
			)
			sort by
			(
				Skill_Name ascending
			)
		
}