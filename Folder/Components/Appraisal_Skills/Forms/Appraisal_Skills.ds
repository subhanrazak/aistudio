form Appraisal_Skills
{

			displayname = "Appraisal Skills"
			Skill_Details
			(
				type = section
				displayname = "Skill Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Appraisal_Form
			(
				type = picklist	
				displayname = "Appraisal Form"
				values  = Appraisal_Form.ID
    			displayformat = [Status]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Skill_Name
			(
    			type = text
				displayname = "Skill Name"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Skill_Description
			(
    			type = textarea
				displayname = "Skill Description"
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Self_Assessment
			(
				type = section
				displayname = "Self Assessment"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Self_Score
			(
				type = number
				displayname = "Self Score"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Self_Comment
			(
    			type = textarea
				displayname = "Self Comment"
				height = 120px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Manager_Assessment
			(
				type = section
				displayname = "Manager Assessment"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Manager_Score
			(
				type = number
				displayname = "Manager Score"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Manager_Comment
			(
    			type = textarea
				displayname = "Manager Comment"
				height = 120px
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}