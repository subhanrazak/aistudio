Training_Request_On_Load as "Training Request - On Load"
{

				type =  form
				form = Training_Request

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Raised_By == null)
										{
											input.Raised_By = zoho.loginuserid;
										}
										if(input.Status == null || input.Status == "")
										{
											input.Status = "Submitted";
										}
										disable Raised_By;
										disable Status;
						)
					}
				}

			
}