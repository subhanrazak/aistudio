list My_Training_Requests
{

			displayName = "My Training Requests"
			show all rows from Training_Request  [Raised_By == zoho.loginuserid || Raised_By == zoho.loginuser]  
			(
				Raised_By as "Raised By"
				Training_Topic as "Training Topic"
				Urgency
				Status
			)
			filters
			(
				Urgency
				Status
			)
			sort by
			(
				Training_Topic ascending
			)
		
}