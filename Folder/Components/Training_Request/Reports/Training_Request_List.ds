default list Training_Request_List
{

			displayName = "Training Request List"
			show all rows from Training_Request    
			(
				Raised_By as "Raised By"
				Training_Topic as "Training Topic"
				Urgency
				Status
			)
			filters
			(
				Urgency
				Status
			)
			sort by
			(
				Urgency ascending
				Training_Topic ascending
			)
		
}