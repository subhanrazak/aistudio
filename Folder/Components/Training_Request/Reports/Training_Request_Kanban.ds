kanban Training_Request_Kanban
{

			displayName = "Training Request Kanban"
			show all rows from Training_Request    
			(
				Raised_By as "Raised By"
				Training_Topic as "Training Topic"
				Urgency
				Status
			)
			filters
			(
				Urgency
				Status
			)
			sort by
			(
				Urgency ascending
			)
			options
			(
	 			display field = Status
				sort order  = custom
				record count  = enable
	 		)
		
}