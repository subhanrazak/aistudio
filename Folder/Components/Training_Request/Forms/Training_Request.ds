form Training_Request
{

			displayname = "Training Request"
			Request_Details
			(
				type = section
				displayname = "Request Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Raised_By
			(
    			type = picklist
				displayname = "Raised By"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Training_Topic
			(
    			type = text
				displayname = "Training Topic"
				maxchar = 200
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Training_Description
			(
    			type = textarea
				displayname = "Training Description"
				height = 160px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Employees
			(
				type = list	
				displayname = "Target Employees"
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
				height = 120px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Urgency
			(
				type = picklist
				values = {"High","Medium","Low"}
				initial value = "Medium"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Submitted","Under_Review","Programme_Created","Closed"}
				initial value = "Submitted"
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}