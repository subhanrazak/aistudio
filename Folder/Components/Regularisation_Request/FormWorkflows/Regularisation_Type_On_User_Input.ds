Regularisation_Type_On_User_Input as "Regularisation Type - On User Input"
{

				type =  form
				form = Regularisation_Request

				record event = on add or edit

				on user input of Regularisation_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Regularisation_Type == "Leave")
										{
											show Leave_Type;
										}
										else
										{
											hide Leave_Type;
											input.Leave_Type = null;
										}
						)
					}
				}

			
}