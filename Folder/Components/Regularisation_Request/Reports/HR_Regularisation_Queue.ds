default list HR_Regularisation_Queue
{

			displayName = "HR Regularisation Queue"
			show all rows from Regularisation_Request    
			(
				Employee
				Regularisation_Date as "Regularisation Date"
				Regularisation_Type as "Regularisation Type"
				Leave_Type as "Leave Type"
				Supporting_Document as "Supporting Document"
				Reason
				Status
			)
			filters
			(
				Employee
				Regularisation_Date
				Regularisation_Type
				Status
			)
			sort by
			(
				Regularisation_Date descending
			)
		
}