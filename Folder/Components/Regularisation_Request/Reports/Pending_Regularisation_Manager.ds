list Pending_Regularisation_Manager
{

			displayName = "Pending Regularisation Manager"
			show all rows from Regularisation_Request  [Status == "Pending_Manager"]  
			(
				Employee
				Regularisation_Date as "Regularisation Date"
				Regularisation_Type as "Regularisation Type"
				Leave_Type as "Leave Type"
				Reason
				Status
			)
			filters
			(
				Employee
				Regularisation_Date
				Regularisation_Type
				Status
			)
			sort by
			(
				Regularisation_Date ascending
			)
		
}