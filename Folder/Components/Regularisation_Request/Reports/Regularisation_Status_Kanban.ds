kanban Regularisation_Status_Kanban
{

			displayName = "Regularisation Status Kanban"
			show all rows from Regularisation_Request    
			(
				Employee
				Regularisation_Date as "Regularisation Date"
				Regularisation_Type as "Regularisation Type"
				Leave_Type as "Leave Type"
				Status
			)
			filters
			(
				Employee
				Regularisation_Date
				Regularisation_Type
				Status
			)
			sort by
			(
				Regularisation_Date ascending
			)
			options
			(
	 			display field = Status
				sort order  = ascending
				record count  = enable
	 		)
		
}