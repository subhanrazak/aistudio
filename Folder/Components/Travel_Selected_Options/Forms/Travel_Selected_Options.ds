form Travel_Selected_Options
{

			displayname = "Travel Selected Options"
			Selection_Details
			(
				type = section
				displayname = "Selection Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Travel_Request
			(
				type = picklist	
				displayname = "Travel Request"
				values  = Travel_Request.ID
    			displayformat = [Destination]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Recommendation
			(
				type = picklist	
				values  = Travel_HR_Recommendations.ID
    			displayformat = [Vendor_Or_Operator]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Recommendation_Type
			(
    			type = text
				displayname = "Recommendation Type"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vendor_Or_Operator
			(
    			type = text
				displayname = "Vendor Or Operator"
				maxchar = 150
	 			row = 1
	 			column = 2   
				width = medium
			)
			Estimated_Cost
			(
				displayname = "Estimated Cost"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Cost
			(
				displayname = "Actual Cost"
				type = INR
				format = commadotindian
				initial value = 0
				maxchar = 14
	 			row = 1
	 			column = 2   
				width = medium
			)
			Booking_Reference
			(
    			type = text
				displayname = "Booking Reference"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_Document
			(
    			type = upload file
				displayname = "Booking Document"
				browse = local_drive, google_docs, zoho_docs
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Booking_Uploaded_Date
			(
    			type = date
				displayname = "Booking Uploaded Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}