Recommendation_On_User_Input as "Travel Selected Options Recommendation - On User Input"
{

				type =  form
				form = Travel_Selected_Options

				record event = on add or edit

				on user input of Recommendation
				{
					actions 
					{
						custom deluge script
						(
											if(input.Recommendation != null)
										{
											recommendationRows = Travel_HR_Recommendations[ID == input.Recommendation];
											if(recommendationRows.count() > 0)
											{
												input.Travel_Request = recommendationRows.Travel_Request;
												input.Recommendation_Type = recommendationRows.Recommendation_Type;
												input.Vendor_Or_Operator = recommendationRows.Vendor_Or_Operator;
												input.Estimated_Cost = recommendationRows.Estimated_Cost;
											}
										}
						)
					}
				}

			
}