Travel_Selected_Options_On_Load as "Travel Selected Options - On Load"
{

				type =  form
				form = Travel_Selected_Options

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Recommendation_Type;
										disable Vendor_Or_Operator;
										disable Estimated_Cost;
										disable Booking_Uploaded_Date;
						)
					}
				}

			
}