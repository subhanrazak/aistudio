default list Travel_Selected_Options_List
{

			displayName = "Travel Selected Options List"
			show all rows from Travel_Selected_Options    
			(
				Travel_Request as "Travel Request"
				Recommendation_Type as "Recommendation Type"
				Vendor_Or_Operator as "Vendor Or Operator"
				Estimated_Cost as "Estimated Cost"
				Actual_Cost as "Actual Cost"
				Booking_Reference as "Booking Reference"
				Booking_Uploaded_Date as "Booking Uploaded Date"
			)
			filters
			(
				Travel_Request
			)
			sort by
			(
				Travel_Request ascending
			)
		
}