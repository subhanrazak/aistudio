form Announcement
{

			Announcement_Details
			(
				type = section
				displayname = "Announcement Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Title
			(
    			type = text
				maxchar = 200
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Content
			(
    			type = richtext
				height = 220px
				toolbar = enable
				[
					style, font-color, alignment, link, bullets-and-numbering, 
					font-size : {2, 3, 4, 5},
					font-family : {"Arimo", "Lato", "Poppins"}
				]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Created_By
			(
    			type = picklist
				displayname = "Created By"
				module = users
				displayformat = [name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Target_Employees
			(
				type = list	
				displayname = "Target Employees"
				values  = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].ID
    			displayformat = [Full_Name]
				height = 150px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Published_Date
			(
    			type = datetime
				displayname = "Published Date"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Acknowledgement_Deadline
			(
    			type = date
				displayname = "Acknowledgement Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}