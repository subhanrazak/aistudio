Announcement_On_Validate as "Announcement - On Validate"
{

				type =  form
				form = Announcement

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Acknowledgement_Deadline != null && input.Acknowledgement_Deadline < zoho.currentdate)
										{
											alert "Acknowledgement deadline cannot be in the past.";
											cancel submit;
										}
						)
					}
				}

			
}