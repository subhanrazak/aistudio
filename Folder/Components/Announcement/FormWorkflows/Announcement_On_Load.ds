Announcement_On_Load as "Announcement - On Load"
{

				type =  form
				form = Announcement

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Created_By == null)
										{
											input.Created_By = zoho.loginuserid;
										}
										if(input.Published_Date == null)
										{
											input.Published_Date = zoho.currenttime;
										}
										disable Created_By;
										disable Published_Date;
						)
					}
				}

			
}