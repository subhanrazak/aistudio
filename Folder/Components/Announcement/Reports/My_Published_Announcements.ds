list My_Published_Announcements
{

			displayName = "My Published Announcements"
			show all rows from Announcement  [Created_By == zoho.loginuserid || Created_By == zoho.loginuser]  
			(
				Title
				Created_By as "Created By"
				Published_Date as "Published Date"
				Acknowledgement_Deadline as "Acknowledgement Deadline"
				Is_Active as "Is Active"
			)
			filters
			(
				Published_Date
				Acknowledgement_Deadline
				Is_Active
			)
			sort by
			(
				Published_Date descending
			)
		
}