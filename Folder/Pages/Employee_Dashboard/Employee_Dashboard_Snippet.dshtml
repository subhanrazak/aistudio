<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isMemberProfile = loginRole == "MEMBER";
	todayDate = zoho.currentdate;
	todayDisplay = todayDate.toString("dd-MMM-yyyy");
	monthLabel = todayDate.toString("MMM yyyy");
	employeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	hasEmployee = employeeRows.count() > 0;
	employeeName = ifnull(zoho.loginuser,"Employee");
	employeeEmail = loginEmail;
	employeeDepartment = "-";
	employeeDesignation = "-";
	employeeStatus = "-";
	employeeInitial = "E";
	totalLeaveBalance = 0;
	leaveTypeCount = 0;
	monthAttendanceCount = 0;
	presentCount = 0;
	wfhCount = 0;
	leaveCount = 0;
	absentCount = 0;
	halfDayCount = 0;
	notMarkedCount = 0;
	pendingLeaveCount = 0;
	pendingRegularisationCount = 0;
	pendingTravelCount = 0;
	pendingReimbursementCount = 0;
	pendingGiftCount = 0;
	pendingTotalCount = 0;
	upcomingTravelCount = 0;
	pendingAnnouncementCount = 0;
	upcomingTrainingCount = 0;
	if(hasEmployee == true && isMemberProfile == false)
	{
		emp = employeeRows;
		employeeName = ifnull(emp.Full_Name,employeeName);
		if(employeeName != "")
		{
			employeeInitial = employeeName.left(1).toUpperCase();
		}
		employeeEmail = ifnull(emp.Official_Email,loginEmail);
		employeeDepartment = ifnull(emp.Department.Department_Name,"-");
		employeeDesignation = ifnull(emp.Designation,"-");
		employeeStatus = ifnull(emp.Employment_Status,"-");
		leaveBalanceRows = Leave_Balance[Employee == emp.ID] sort by Leave_Type asc;
		leaveTypeCount = leaveBalanceRows.count();
		for each  leaveBalSeed in leaveBalanceRows
		{
			totalLeaveBalance = totalLeaveBalance + ifnull(leaveBalSeed.Balance_Days,0);
		}
		currentMonth = todayDate.getMonth();
		currentYear = todayDate.getYear();
		attendanceRows = Attendance_Log[Employee == emp.ID];
		for each  attendanceSeed in attendanceRows
		{
			if(attendanceSeed.Attendance_Date != null && attendanceSeed.Attendance_Date.getMonth() == currentMonth && attendanceSeed.Attendance_Date.getYear() == currentYear)
			{
				monthAttendanceCount = monthAttendanceCount + 1;
				attendanceStatus = ifnull(attendanceSeed.Attendance_Status,"Not_Marked");
				if(attendanceStatus == "Present")
				{
					presentCount = presentCount + 1;
				}
				else if(attendanceStatus == "WFH" || attendanceStatus == "On_Duty")
				{
					wfhCount = wfhCount + 1;
				}
				else if(attendanceStatus == "Leave")
				{
					leaveCount = leaveCount + 1;
				}
				else if(attendanceStatus == "Absent")
				{
					absentCount = absentCount + 1;
				}
				else if(attendanceStatus == "Half_Day")
				{
					halfDayCount = halfDayCount + 1;
				}
				else if(attendanceStatus == "Not_Marked")
				{
					notMarkedCount = notMarkedCount + 1;
				}
			}
		}
		pendingLeaveRows = Time_Off_Request[Employee == emp.ID && Status == "Pending_Manager" || Status == "Pending_HR"];
		pendingRegularisationRows = Regularisation_Request[Employee == emp.ID && Status == "Pending_Manager" || Status == "Pending_HR"];
		pendingTravelRows = Travel_Request[Employee == emp.ID && Status == "Pending_Manager" || Status == "Pending_CEO" || Status == "Pending_HR"];
		pendingReimbursementRows = Reimbursement_Request[Employee == emp.ID && Status == "Pending_Manager" || Status == "Pending_HR" || Status == "Pending_Finance"];
		pendingGiftRows = Gift_Registration[Employee == emp.ID && Status == "Pending_Manager" || Status == "Pending_HR" || Status == "Pending_Finance"];
		pendingLeaveCount = pendingLeaveRows.count();
		pendingRegularisationCount = pendingRegularisationRows.count();
		pendingTravelCount = pendingTravelRows.count();
		pendingReimbursementCount = pendingReimbursementRows.count();
		pendingGiftCount = pendingGiftRows.count();
		pendingTotalCount = pendingLeaveCount + pendingRegularisationCount + pendingTravelCount + pendingReimbursementCount + pendingGiftCount;
		upcomingTravelRows = Travel_Request[Employee == emp.ID && Travel_From_Date >= todayDate && Status != "Rejected" && Status != "Processed"] sort by Travel_From_Date asc;
		upcomingTravelCount = upcomingTravelRows.count();
		pendingAnnouncementRows = Announcement_Acknowledgement[Employee == emp.ID && Acknowledged == false];
		pendingAnnouncementCount = pendingAnnouncementRows.count();
		upcomingTrainingRows = Training_Programme[Assigned_Employees.Official_Email == employeeEmail || Assigned_Employees.Official_Email == zoho.loginuser && Training_Date >= todayDate && Status == "Scheduled"] sort by Training_Date asc;
		upcomingTrainingCount = upcomingTrainingRows.count();
	}
	%>
<style>
/* ===== zcs-global.css included once for Employee_Dashboard (utility subset used by this page) ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; }
.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-cursor-pointer { cursor: pointer; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, #2A6FFC); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
/* ZCS component CSS: button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-button-icon { width: 16px; max-height: 16px; }
/* ZCS component CSS: quick-actions-card-type-quick-actions */
.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs_brand_color, #2A6FFC); } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs_brand_color, #2A6FFC); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: none; }
/* ZCS component CSS: table-simple-table */
:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }
/* Employee dashboard */
.ed-page { min-height: 100%; background: var(--zcs-page-bg-color, #F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }
.ed-header { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); }
.ed-header:after { content: ""; position: absolute; width: 280px; height: 280px; right: -80px; top: -120px; border-radius: 50%; border: 36px solid rgba(255,255,255,.13); }
.ed-header .zcs-color-primary, .ed-header .zcs-color-secondary, .ed-header .zcs-color-tertiary { color: var(--zcs_brand_foreground_color, #FFFFFF); }
.ed-header-inner { position: relative; z-index: 1; }
.ed-avatar { width: 54px; height: 54px; border-radius: 16px; background: rgba(255,255,255,.18); color: var(--zcs_brand_foreground_color, #FFFFFF); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; }
.ed-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; padding: 18px 0 0; }
.ed-kpi { grid-column: span 4; min-height: 148px; position: relative; overflow: hidden; box-shadow: 0 8px 22px rgba(15,23,42,.06); }
.ed-kpi:after { content: ""; position: absolute; width: 90px; height: 90px; right: -28px; bottom: -32px; border-radius: 50%; background: var(--zcs_brand_light_color, #E8EFFF); opacity: .75; }
.ed-kpi-icon { width: 42px; height: 42px; border-radius: 12px; color: var(--zcs_brand_color, #2A6FFC); background: var(--zcs_brand_light_color, #E8EFFF); }
.ed-kpi-value { font-size: 30px; font-weight: 700; line-height: 1; }
.ed-section { grid-column: span 6; box-shadow: 0 8px 22px rgba(15,23,42,.06); }
.ed-section-header { border-bottom: 1px solid var(--zcs-border-color); }
.ed-progress { height: 7px; background: #EDF1F7; border-radius: 999px; overflow: hidden; }
.ed-progress span { height: 100%; display: block; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }
.ed-mini-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.ed-mini-list li { border: 1px solid var(--zcs-border-color); border-radius: 10px; padding: 10px 12px; box-sizing: border-box; background: #FFFFFF; }
.ed-empty { border: 1px dashed var(--zcs-border-color); background: #FFFFFF; border-radius: 12px; padding: 20px; text-align: center; }
.ed-denied { max-width: 720px; margin: 0 auto; padding: 36px 20px; }
@media (max-width: 1120px) { .ed-kpi { grid-column: span 6; } .ed-section { grid-column: span 12; } }
@media (max-width: 700px) { .ed-header { border-radius: 0 0 16px 16px; } .ed-header-inner { flex-direction: column; align-items: flex-start; } .ed-kpi { grid-column: span 12; } .ed-grid { padding-left: 12px; padding-right: 12px; } }
</style>
<%
	if(isMemberProfile == true)
	{
		%>
<div class="ed-page ed-denied">
	<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
			<i class='zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme'></i>
			<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Employee dashboard is for internal employee profiles.</h5>
		</div>
		<p class='zcs-font-14 zcs-color-secondary zcs-m-0'>Your current profile is MEMBER. Please contact HR if you need internal employee access.</p>
	</div>
</div>
<%
	}
	else if(hasEmployee == false)
	{
		%>
<div class="ed-page ed-denied">
	<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
			<i class='zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme'></i>
			<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>No matching employee profile found.</h5>
		</div>
		<p class='zcs-font-14 zcs-color-secondary zcs-m-0'>This page uses Employee Master where Official Email matches the logged-in user. Please ask HR to verify your profile.</p>
	</div>
</div>
<%
	}
	else
	{
		%>
<div class="ed-page zcs-px-20 zcs-py-16 zcs-box-border">
	<div class="ed-header zcs-px-30 zcs-py-24 zcs-box-border">
		<div class="ed-header-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
			<div class="zcs-flex zcs-align-items-center zcs-gap-16 zcs-ellipsis">
				<div class="ed-avatar zcs-no-shrink"><%=employeeInitial%></div>
				<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
					<h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Hello <%=employeeName%></h4>
					<div class="zcs-font-14 zcs-color-secondary zcs-ellipsis"><%=employeeDesignation%> \u00B7 <%=employeeDepartment%> \u00B7 <%=todayDisplay%></div>
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-8">
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
					<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=employeeStatus%></span>
				</div>
				<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Page:Employee_Attendance_Portal'>
					<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
					<span class='zcs-button-text'>Attendance Portal</span>
				</a>
			</div>
		</div>
	</div>

	<div class="ed-grid">
		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc zcs-font-22"></i></div>
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><span class='zcs-badge-text zcs-font-12'>Live</span></div>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=totalLeaveBalance%></div>
			<div class="zcs-font-14 zcs-color-secondary"><%=leaveTypeCount%> leave types with available balance</div>
		</div>

		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary"><%=monthLabel%></span>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=monthAttendanceCount%></div>
			<div class="zcs-font-14 zcs-color-secondary"><%=presentCount%> present \u00B7 <%=wfhCount%> WFH/on duty \u00B7 <%=leaveCount%> leave</div>
		</div>

		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert zcs-font-22"></i></div>
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><span class='zcs-badge-text zcs-font-12'>Pending</span></div>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=pendingTotalCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Leave <%=pendingLeaveCount%> \u00B7 Regularisation <%=pendingRegularisationCount%> \u00B7 Travel <%=pendingTravelCount%> \u00B7 Claims <%=pendingReimbursementCount%> \u00B7 Gifts <%=pendingGiftCount%></div>
		</div>

		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline location-pin-copy zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Upcoming</span>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=upcomingTravelCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Future travel requests not rejected or processed</div>
		</div>

		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Acknowledgement</span>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=pendingAnnouncementCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Announcements awaiting your acknowledgement</div>
		</div>

		<div class="ed-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="ed-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-chart-bar-32 zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Training</span>
			</div>
			<div class="ed-kpi-value zcs-color-primary"><%=upcomingTrainingCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Scheduled programmes assigned to you</div>
		</div>

		<div class="ed-section zcs-card zcs-box-border">
			<div class="ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quick actions</h5>
				<span class="zcs-font-13 zcs-color-tertiary">Reliable Creator forms</span>
			</div>
			<div class='zcs-quick-actions-wrapper zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border'>
				<ul class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0'>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:Time_Off_Request?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add'></i><span class='zcs-quick-action-text'>Apply leave</span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:Reimbursement_Request?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc'></i><span class='zcs-quick-action-text'>Submit reimbursement</span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:Gift_Registration?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add'></i><span class='zcs-quick-action-text'>Register gift</span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Form:Regularisation_Request?zc_LoadIn=dialog'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline ui-2-time'></i><span class='zcs-quick-action-text'>Request attendance regularisation</span></a></li>
					<li class='zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border'><a class='zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer' href='#Page:Employee_Attendance_Portal'><i class='zcs-quick-action-icon zcs-font-medium zc-li-outline arrows-1-tail-right'></i><span class='zcs-quick-action-text'>Open attendance portal</span></a></li>
				</ul>
			</div>
		</div>

		<div class="ed-section zcs-card zcs-box-border">
			<div class="ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Leave balance snapshot</h5>
				<a class="zcs-font-13 zcs-color-theme" href="#Report:My_Leave_Balance?zc_LoadIn=dialog">Open report</a>
			</div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(leaveTypeCount == 0)
		{
			%>
<div class="ed-empty"><i class="zc-li-outline files-2-doc zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No leave balance rows are available yet.</div></div>
<%
		}
		else
		{
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'>
						<table class='zcs-w-full'>
							<thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Leave type</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Balance</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Used</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Utilisation</th></tr></thead>
							<tbody>
<%
			for each  leaveBal in leaveBalanceRows
			{
				balanceDays = ifnull(leaveBal.Balance_Days,0);
				usedDays = ifnull(leaveBal.Used_Days,0);
				barWidth = usedDays * 10;
				if(barWidth > 100)
				{
					barWidth = 100;
				}
				leaveTypeName = ifnull(leaveBal.Leave_Type.Leave_Type_Name,"Leave");
				%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=leaveTypeName%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-green'><%=balanceDays%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=usedDays%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left'><div class='ed-progress'><span style='width:<%=barWidth%>%'></span></div></td></tr>
<%
			}
			%>
</tbody>
						</table>
					</div>
<%
		}
		%>
</div>
		</div>

		<div class="ed-section zcs-card zcs-box-border">
			<div class="ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Upcoming travel</h5>
				<a class="zcs-font-13 zcs-color-theme" href="#Report:My_Travel_Requests?zc_LoadIn=dialog">Open report</a>
			</div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(upcomingTravelCount == 0)
		{
			%>
<div class="ed-empty"><i class="zc-li-outline location-pin-copy zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No upcoming travel requests.</div></div>
<%
		}
		else
		{
			shownTravel = 0;
			%>
<ul class="ed-mini-list">
<%
			for each  travelItem in upcomingTravelRows
			{
				if(shownTravel < 3)
				{
					travelStatus = ifnull(travelItem.Status,"-");
					travelBadge = "zcs-badge-blue";
					if(travelStatus == "Approved")
					{
						travelBadge = "zcs-badge-green";
					}
					else if(travelStatus == "Pending_Manager" || travelStatus == "Pending_CEO" || travelStatus == "Pending_HR")
					{
						travelBadge = "zcs-badge-yellow";
					}
					travelDate = "-";
					if(travelItem.Travel_From_Date != null)
					{
						travelDate = travelItem.Travel_From_Date.toString("dd-MMM-yyyy");
					}
					shownTravel = shownTravel + 1;
					%>
<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis"><span class="zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis"><%=ifnull(travelItem.Destination,"-")%></span><span class="zcs-font-13 zcs-color-secondary"><%=travelDate%> \u00B7 <%=ifnull(travelItem.Travel_Type,"Travel")%></span></div><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=travelBadge%>'><span class='zcs-badge-text zcs-font-12'><%=travelStatus%></span></div></li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>
		</div>

		<div class="ed-section zcs-card zcs-box-border">
			<div class="ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Announcements to acknowledge</h5>
				<a class="zcs-font-13 zcs-color-theme" href="#Report:My_Announcement_Acknowledgements?zc_LoadIn=dialog">Open report</a>
			</div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(pendingAnnouncementCount == 0)
		{
			%>
<div class="ed-empty"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No pending announcement acknowledgements.</div></div>
<%
		}
		else
		{
			shownAnnouncement = 0;
			%>
<ul class="ed-mini-list">
<%
			for each  ackItem in pendingAnnouncementRows
			{
				if(shownAnnouncement < 3)
				{
					deadlineText = "No deadline";
					if(ackItem.Announcement.Acknowledgement_Deadline != null)
					{
						deadlineText = "Due " + ackItem.Announcement.Acknowledgement_Deadline.toString("dd-MMM-yyyy");
					}
					shownAnnouncement = shownAnnouncement + 1;
					%>
<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis"><span class="zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis"><%=ifnull(ackItem.Announcement.Title,"Announcement")%></span><span class="zcs-font-13 zcs-color-secondary"><%=deadlineText%></span></div><a class="zcs-font-13 zcs-color-theme" href="#Report:My_Announcement_Acknowledgements?ID=<%=ackItem.ID%>&amp;zc_LoadIn=dialog">Acknowledge</a></li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>
		</div>

		<div class="ed-section zcs-card zcs-box-border">
			<div class="ed-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border">
				<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Upcoming training</h5>
				<a class="zcs-font-13 zcs-color-theme" href="#Report:My_Training_Schedule?zc_LoadIn=dialog">Open report</a>
			</div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(upcomingTrainingCount == 0)
		{
			%>
<div class="ed-empty"><i class="zc-li-outline business-chart-bar-32 zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No scheduled training programmes assigned to you.</div></div>
<%
		}
		else
		{
			shownTraining = 0;
			%>
<ul class="ed-mini-list">
<%
			for each  trainingItem in upcomingTrainingRows
			{
				if(shownTraining < 3)
				{
					trainingDate = "-";
					if(trainingItem.Training_Date != null)
					{
						trainingDate = trainingItem.Training_Date.toString("dd-MMM-yyyy");
					}
					shownTraining = shownTraining + 1;
					%>
<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis"><span class="zcs-font-15 zcs-font-medium zcs-color-primary zcs-ellipsis"><%=ifnull(trainingItem.Programme_Name,"Training programme")%></span><span class="zcs-font-13 zcs-color-secondary"><%=trainingDate%> \u00B7 <%=ifnull(trainingItem.Training_Mode,"-")%> \u00B7 Trainer: <%=ifnull(trainingItem.Trainer_Name,"-")%></span></div><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'><span class='zcs-badge-text zcs-font-12'><%=ifnull(trainingItem.Status,"Scheduled")%></span></div></li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>
		</div>
	</div>
</div>
<%
	}
%>