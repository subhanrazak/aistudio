<%
	departmentCount = Department_Config[ID != 0].count();
	noticePeriodCount = Notice_Period_Config[ID != 0].count();
	holidayCount = Holiday_Master[ID != 0].count();
	leaveTypeCount = Leave_Type_Config[ID != 0].count();
	shiftCount = Shift_Config[ID != 0].count();
	reimbursementTypeCount = Reimbursement_Type_Config[ID != 0].count();
	offboardingChecklistCount = Offboarding_Checklist_Config[ID != 0].count();
	offerDocumentCount = Offer_Document_Config[ID != 0].count();
	notificationConfigCount = Notification_Config[ID != 0].count();
	approvalRemarksCount = Approval_Remarks[ID != 0].count();
	auditLogCount = Audit_Log[ID != 0].count();
	%>
<style>
/* ===== zcs-global.css ===== */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-light-bg-color: var(--zcs_brand_light_color);
	--zcs-page-bg-color: #F3F3F4;
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-border-color: var(--zcs_tertiary_border_color);
	--zcs-white-color: #FFFFFF;
	--zcs-black-color: #000000;
	font-size: 16px;
	line-height: 1.5;
}
.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-p-8{padding:.5rem}.zcs-p-16{padding:1rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-12{padding-left:.75rem;padding-right:.75rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-12{padding-top:.75rem;padding-bottom:.75rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-0{margin-top:0}.zcs-mb-4{margin-bottom:.25rem}.zcs-mb-8{margin-bottom:.5rem}.zcs-mb-12{margin-bottom:.75rem}.zcs-mb-16{margin-bottom:1rem}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-box-border{box-sizing:border-box}.zcs-w-full{width:100%}.zcs-wh-full{width:100%;height:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-overflow-auto{overflow:auto}a{text-decoration:none}

/* ZCS component CSS: Horizontal Tab With Icon */
.zcs-horizontal-tabhead{box-shadow:0 -1px 0 0 var(--zcs_tertiary_border_color) inset;overflow-x:auto;overflow-y:hidden;-ms-overflow-style:none;scrollbar-width:none;background:var(--zcs-white-color);position:sticky;top:0;z-index:5}.zcs-horizontal-tabhead::-webkit-scrollbar{display:none}.zcs-horizontal-tabitem{list-style-type:none;border-bottom:2px solid transparent;letter-spacing:.1px}.zcs-horizontal-tabicon{width:16px;height:16px}.zcs-horizontal-tabtext{text-wrap:nowrap}.zcs-horizontal-tabitem:hover .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive{border-bottom-color:var(--zcs_brand_color)}.zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink{color:var(--zcs_brand_color)}.zcs-horizontal-tabbody{overflow:visible}

/* ZCS component CSS: Heading with Actions and Primary Outline Button */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);border:1px solid var(--zcs_brand_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color);border-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:linear-gradient(135deg,var(--zcs-white-color),var(--zcs_component_hover_color));border:1px solid var(--zcs_tertiary_border_color);border-radius:14px}

/* ZCS component CSS: Badge with Icon */
.zcs-badge{width:auto}.zcs-badge-filled-outline,.zcs-badge-outline{border:1px solid}.zcs-badge-filled-outline.zcs-badge-theme{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-badge-filled-outline.zcs-badge-green{background-color:#E4FCF3;border-color:#179E6C;color:#179E6C}.zcs-badge-filled-outline.zcs-badge-blue{background-color:#E8EFFF;border-color:#2A6FFC;color:#2A6FFC}.zcs-badge-filled-outline.zcs-badge-grey{background-color:#e8e8e8;border-color:#242424;color:#242424}.zcs-badge-filled-outline.zcs-badge-yellow{background-color:#FCF4E6;border-color:#FAAE13;color:#9A6505}

/* Settings Home layout */
.settings-home{min-height:100%;background:var(--zcs-page-bg-color);padding:24px;box-sizing:border-box;color:var(--zcs-primary-text-color)}
.settings-shell{max-width:1440px;margin:0 auto}.settings-intro{max-width:760px}.settings-summary{display:grid;grid-template-columns:repeat(4,minmax(160px,1fr));gap:14px;margin:18px 0}.settings-summary-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;padding:16px;box-sizing:border-box}.settings-summary-card .summary-value{font-size:24px;font-weight:700;line-height:1.1;color:var(--zcs_brand_color)}.settings-summary-card .summary-label{font-size:13px;color:var(--zcs_secondary_text_color);margin-top:4px}.settings-nav-wrap{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;margin-bottom:18px;overflow:hidden}.settings-section{scroll-margin-top:76px;margin-top:20px}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.section-title{font-size:20px;font-weight:700;margin:0;color:var(--zcs-primary-text-color)}.section-subtitle{font-size:14px;color:var(--zcs-secondary-text-color);margin:4px 0 0}.settings-master-card{background:var(--zcs-white-color);border:1px solid var(--zcs_tertiary_border_color);border-radius:14px;margin-bottom:18px;overflow:hidden;box-shadow:0 1px 3px rgba(20,20,50,.05)}.master-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:linear-gradient(180deg,var(--zcs-white-color),rgba(248,248,252,.9))}.master-title-wrap{display:flex;align-items:flex-start;gap:12px;min-width:0}.master-icon{width:40px;height:40px;border-radius:12px;background:var(--zcs_component_hover_color);color:var(--zcs_brand_color);display:flex;align-items:center;justify-content:center;flex-shrink:0}.master-copy{min-width:0}.master-title{font-size:17px;font-weight:700;line-height:1.25;margin:0;color:var(--zcs-primary-text-color)}.master-desc{font-size:13px;color:var(--zcs-secondary-text-color);margin:5px 0 0}.master-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.embed-grid{display:grid;grid-template-columns:minmax(320px,34%) minmax(0,1fr);gap:16px;padding:18px 20px 20px}.embed-grid.report-only{grid-template-columns:1fr}.embed-panel{border:1px solid var(--zcs_tertiary_border_color);border-radius:12px;background:var(--zcs-white-color);overflow:hidden}.embed-panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid var(--zcs_tertiary_border_color);background:var(--zcs_component_hover_color)}.embed-panel-title h4{margin:0;font-size:14px;font-weight:700;color:var(--zcs-primary-text-color)}.embed-panel-body{padding:0;min-height:360px}.report-embed{min-height:520px}.form-embed{min-height:360px}.logs-embed{min-height:650px}.settings-note{background:var(--zcs-white-color);border:1px dashed var(--zcs_brand_color);border-radius:12px;padding:14px 16px;color:var(--zcs-secondary-text-color);font-size:14px;margin-bottom:18px}.settings-note i{color:var(--zcs_brand_color)}
@media (max-width:1100px){.settings-summary{grid-template-columns:repeat(2,minmax(160px,1fr))}.embed-grid{grid-template-columns:1fr}.master-card-header{flex-direction:column}.master-actions{justify-content:flex-start}}
@media (max-width:640px){.settings-home{padding:14px}.settings-summary{grid-template-columns:1fr}.zcs-page-header{padding:16px}.master-card-header{padding:16px}.embed-grid{padding:14px}.settings-horizontal-tabhead{padding-left:8px;padding-right:8px}}
</style>

<div class="settings-home">
	<div class="settings-shell">
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border zcs-mb-16'>
			<div class='settings-intro zcs-flex zcs-direction-column zcs-gap-4'>
				<div class='zcs-flex zcs-align-items-center zcs-gap-10'>
					<i class='zcs-font-24 zcs-color-theme zc-li-outline ui-1-settings-gear-63'></i>
					<h1 class='zcs-font-24 zcs-font-bold zcs-lh-heading zcs-color-primary zcs-m-0'>Settings Home</h1>
				</div>
				<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'>Page-first workspace for configuration masters, workflow settings, approval remarks, and audit logs.</p>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
					<i class='zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
					<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>Embedded reports</span>
				</div>
			</div>
		</div>

		<div class="settings-summary">
			<div class="settings-summary-card"><div class="summary-value">11</div><div class="summary-label">Report workspaces</div></div>
			<div class="settings-summary-card"><div class="summary-value">9</div><div class="summary-label">Quick-entry master forms</div></div>
			<div class="settings-summary-card"><div class="summary-value"><%=approvalRemarksCount%></div><div class="summary-label">Approval remark records</div></div>
			<div class="settings-summary-card"><div class="summary-value"><%=auditLogCount%></div><div class="summary-label">Audit log records</div></div>
		</div>

		<div class="settings-nav-wrap">
			<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full'>
				<ul class='zcs-horizontal-tabhead settings-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
					<li class='zcs-horizontal-tabitem zcs-horizontal-tabactive'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#settings-core'><i class='zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-settings-gear-63'></i><span class='zcs-horizontal-tabtext zcs-font-15'>Core masters</span></a></li>
					<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#settings-time'><i class='zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-2-time'></i><span class='zcs-horizontal-tabtext zcs-font-15'>Time and leave</span></a></li>
					<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#settings-workflow'><i class='zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-edit-72'></i><span class='zcs-horizontal-tabtext zcs-font-15'>Workflow config</span></a></li>
					<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#settings-logs'><i class='zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline arrows-4-restore'></i><span class='zcs-horizontal-tabtext zcs-font-15'>Admin logs</span></a></li>
				</ul>
			</div>
		</div>

		<div class="settings-note zcs-flex zcs-align-items-start zcs-gap-8"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-18"></i><span>Each master below keeps the add form and report together so admins can maintain data without leaving this page. Use the full-report and full-form links only when a wider view is needed.</span></div>

		<section id="settings-core" class="settings-section">
			<div class="section-heading"><div><h2 class="section-title">Core masters</h2><p class="section-subtitle">Department and employment-policy records used across HR operations.</p></div></div>

			<article class="settings-master-card">
				<div class="master-card-header"><div class="master-title-wrap"><div class="master-icon"><i class="zc-li-outline ui-1-settings-gear-63 zcs-font-22"></i></div><div class="master-copy"><h3 class="master-title">Departments</h3><p class="master-desc">Maintain department names, department heads, and active status.</p></div></div><div class="master-actions"><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-badge-text zcs-font-14"><%=departmentCount%> records</span></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Department_List" target="_blank"><span class="zcs-button-text">Full report</span></a><a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Department_Config" target="_blank"><span class="zcs-button-text">Open form</span></a></div></div>
				<div class="embed-grid"><div class="embed-panel"><div class="embed-panel-title"><h4>Add Department</h4></div><div class="embed-panel-body form-embed"><div zc-component="form" zc-linkname="Department_Config" zc-height="360px"></div></div></div><div class="embed-panel"><div class="embed-panel-title"><h4>Department List</h4></div><div class="embed-panel-body report-embed"><div zc-component="report" zc-linkname="Department_List" zc-height="520px"></div></div></div></div>
			</article>

			<article class="settings-master-card">
				<div class="master-card-header"><div class="master-title-wrap"><div class="master-icon"><i class="zc-li-outline ui-2-time zcs-font-22"></i></div><div class="master-copy"><h3 class="master-title">Notice Period Configuration</h3><p class="master-desc">Maintain notice-period days by employment type and effective date.</p></div></div><div class="master-actions"><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-badge-text zcs-font-14"><%=noticePeriodCount%> records</span></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Notice_Period_Config_List" target="_blank"><span class="zcs-button-text">Full report</span></a><a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Notice_Period_Config" target="_blank"><span class="zcs-button-text">Open form</span></a></div></div>
				<div class="embed-grid"><div class="embed-panel"><div class="embed-panel-title"><h4>Add Notice Period</h4></div><div class="embed-panel-body form-embed"><div zc-component="form" zc-linkname="Notice_Period_Config" zc-height="360px"></div></div></div><div class="embed-panel"><div class="embed-panel-title"><h4>Notice Period Config List</h4></div><div class="embed-panel-body report-embed"><div zc-component="report" zc-linkname="Notice_Period_Config_List" zc-height="520px"></div></div></div></div>
			</article>
		</section>

		<section id="settings-time" class="settings-section">
			<div class="section-heading"><div><h2 class="section-title">Time and leave</h2><p class="section-subtitle">Holiday, leave type, and shift policies used by attendance and time-off flows.</p></div></div>

			<article class="settings-master-card"><div class="master-card-header"><div class="master-title-wrap"><div class="master-icon"><i class="zc-li-outline ui-2-calendar-date zcs-font-22"></i></div><div class="master-copy"><h3 class="master-title">Holiday Master</h3><p class="master-desc">Maintain holidays by date, type, year, and active status.</p></div></div><div class="master-actions"><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-badge-text zcs-font-14"><%=holidayCount%> records</span></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Holiday_List" target="_blank"><span class="zcs-button-text">Full report</span></a><a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Holiday_Master" target="_blank"><span class="zcs-button-text">Open form</span></a></div></div><div class="embed-grid"><div class="embed-panel"><div class="embed-panel-title"><h4>Add Holiday</h4></div><div class="embed-panel-body form-embed"><div zc-component="form" zc-linkname="Holiday_Master" zc-height="360px"></div></div></div><div class="embed-panel"><div class="embed-panel-title"><h4>Holiday List</h4></div><div class="embed-panel-body report-embed"><div zc-component="report" zc-linkname="Holiday_List" zc-height="520px"></div></div></div></div></article>

			<article class="settings-master-card"><div class="master-card-header"><div class="master-title-wrap"><div class="master-icon"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-22"></i></div><div class="master-copy"><h3 class="master-title">Leave Type Configuration</h3><p class="master-desc">Maintain credit frequency, quantity, weekend rules, document needs, and validity days.</p></div></div><div class="master-actions"><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zc-li-outline loader-dots-06"></i><span class="zcs-badge-text zcs-font-14"><%=leaveTypeCount%> records</span></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Leave_Type_Config_List" target="_blank"><span class="zcs-button-text">Full report</span></a><a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Leave_Type_Config" target="_blank"><span class="zcs-button-text">Open form</span></a></div></div><div class="embed-grid"><div class="embed-panel"><div class="embed-panel-title"><h4>Add Leave Type</h4></div><div class="embed-panel-body form-embed"><div zc-component="form" zc-linkname="Leave_Type_Config" zc-height="360px"></div></div></div><div class="embed-panel"><div class="embed-panel-title"><h4>Leave Type Config List</h4></div><div class="embed-panel-body report-embed"><div zc-component="report" zc-linkname="Leave_Type_Config_List" zc-height="520px"></div></div></div></div></article>

