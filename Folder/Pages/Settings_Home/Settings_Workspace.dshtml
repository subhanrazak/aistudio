			<article class="settings-master-card"><div class="master-card-header"><div class="master-title-wrap"><div class="master-icon"><i class="zc-li-outline arrows-4-restore zcs-font-22"></i></div><div class="master-copy"><h3 class="master-title">Audit Log</h3><p class="master-desc">Review event time, event key, actor, action, old and new status, and success state.</p></div></div><div class="master-actions"><div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey"><i class="zcs-badge-icon zc-li-outline arrows-4-restore"></i><span class="zcs-badge-text zcs-font-14"><%=auditLogCount%> records</span></div><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Audit_Log_List" target="_blank"><span class="zcs-button-text">Full report</span></a></div></div><div class="embed-grid report-only"><div class="embed-panel"><div class="embed-panel-title"><h4>Audit Log List</h4></div><div class="embed-panel-body logs-embed"><div zc-component="report" zc-linkname="Audit_Log_List" zc-height="650px"></div></div></div></div></article>
		</section>
	</div>
</div>

<script>
(function(){
	var tabs = document.querySelectorAll('.settings-horizontal-tabhead .zcs-horizontal-tabitem');
	var links = document.querySelectorAll('.settings-horizontal-tabhead .zcs-horizontal-tablink');
	function activate(hash){
		if(!hash){hash = '#settings-core';}
		tabs.forEach(function(tab){tab.classList.remove('zcs-horizontal-tabactive');});
		links.forEach(function(link){
			if(link.getAttribute('href') === hash && link.parentElement){
				link.parentElement.classList.add('zcs-horizontal-tabactive');
			}
		});
	}
	links.forEach(function(link){
		link.addEventListener('click',function(){activate(link.getAttribute('href'));});
	});
	window.addEventListener('hashchange',function(){activate(window.location.hash);});
	activate(window.location.hash);
})();
</script>