<%
	candidateRows = Candidate[ID == input.candidate_id];
	%>
<style>
/* zcs-global utility subset included once for this page */
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color);
	--zcs-white-color: #FFFFFF;
	--zcs-primary-text-color: var(--zcs_primary_text_color);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color);
	--zcs-border-color: var(--zcs_tertiary_border_color);
}
.zcs-row{display:flex;flex-wrap:wrap}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-align-items-start{align-items:flex-start}.zcs-align-items-stretch{align-items:stretch}.zcs-justify-center{justify-content:center}.zcs-justify-space-between{justify-content:space-between}.zcs-gap-4{gap:.25rem}.zcs-gap-6{gap:.375rem}.zcs-gap-8{gap:.5rem}.zcs-gap-10{gap:.625rem}.zcs-gap-12{gap:.75rem}.zcs-gap-16{gap:1rem}.zcs-gap-20{gap:1.25rem}.zcs-gap-24{gap:1.5rem}.zcs-p-0{padding:0}.zcs-p-8{padding:.5rem}.zcs-p-12{padding:.75rem}.zcs-p-16{padding:1rem}.zcs-p-18{padding:1.125rem}.zcs-p-20{padding:1.25rem}.zcs-p-24{padding:1.5rem}.zcs-px-10{padding-left:.625rem;padding-right:.625rem}.zcs-px-16{padding-left:1rem;padding-right:1rem}.zcs-px-20{padding-left:1.25rem;padding-right:1.25rem}.zcs-px-30{padding-left:1.875rem;padding-right:1.875rem}.zcs-py-2{padding-top:.125rem;padding-bottom:.125rem}.zcs-py-6{padding-top:.375rem;padding-bottom:.375rem}.zcs-py-8{padding-top:.5rem;padding-bottom:.5rem}.zcs-py-10{padding-top:.625rem;padding-bottom:.625rem}.zcs-py-16{padding-top:1rem;padding-bottom:1rem}.zcs-py-24{padding-top:1.5rem;padding-bottom:1.5rem}.zcs-m-0{margin:0}.zcs-mt-4{margin-top:.25rem}.zcs-mt-8{margin-top:.5rem}.zcs-mt-10{margin-top:.625rem}.zcs-mt-12{margin-top:.75rem}.zcs-mt-16{margin-top:1rem}.zcs-mt-20{margin-top:1.25rem}.zcs-mx-0{margin-left:0;margin-right:0}.zcs-mb-0{margin-bottom:0}.zcs-col-12{flex:0 0 100%;max-width:100%}.zcs-col-common{flex:1 1 0}.zcs-no-shrink{flex-shrink:0}.zcs-w-full{width:100%}.zcs-h-full{height:100%}.zcs-wh-full{width:100%;height:100%}.zcs-font-12{font-size:.75rem}.zcs-font-13{font-size:.8125rem}.zcs-font-14{font-size:.875rem}.zcs-font-15{font-size:.9375rem}.zcs-font-16{font-size:1rem}.zcs-font-18{font-size:1.125rem}.zcs-font-20{font-size:1.25rem}.zcs-font-22{font-size:1.375rem}.zcs-font-24{font-size:1.5rem}.zcs-font-28{font-size:1.75rem}.zcs-font-40{font-size:2.5rem}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-font-bold{font-weight:700}.zcs-lh-body{line-height:1.5}.zcs-lh-heading{line-height:1.25}.zcs-uppercase{text-transform:uppercase}.zcs-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.zcs-rounded-sm{border-radius:.25rem}.zcs-rounded-md{border-radius:.375rem}.zcs-rounded-lg{border-radius:.5rem}.zcs-rounded-xl{border-radius:.75rem}.zcs-rounded-2xl{border-radius:1rem}.zcs-rounded-half{border-radius:50%}.zcs-text-center{text-align:center}.zcs-box-border{box-sizing:border-box}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-color-tertiary{color:var(--zcs-teritiary-text-color)}.zcs-color-white{color:var(--zcs-white-color)}.zcs-color-theme{color:var(--zcs-theme-brand-color)}.zcs-card{background-color:var(--zcs-white-color);border:1px solid #e7e7ee;border-radius:12px}a{text-decoration:none}

/* ZCS component CSS: button-primary-button / header-heading-with-actions */
.zcs-button{width:auto;min-width:5rem;min-height:36px}.zcs-primary-button{background-color:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color)}.zcs-primary-outline-button{border:1px solid var(--zcs_brand_color);background-color:var(--zcs-white-color);color:var(--zcs_brand_color)}.zcs-secondary-button{border:1px solid var(--zcs_primary_border_color);background-color:var(--zcs_light_grey_color);color:var(--zcs_primary_text_color)}.zcs-primary-button.zcs-button:hover{background-color:var(--zcs_brand_dark_color)}.zcs-primary-outline-button:hover{background-color:var(--zcs_component_hover_color);border-color:var(--zcs_brand_color);color:var(--zcs_brand_color)}.zcs-button-icon{width:16px;max-height:16px}.zcs-page-header{background:#fff;border-bottom:1px solid #ececf3}

/* ZCS component CSS: card-user-detail-card */
.zcs-avatar{width:var(--zcs-avatar-size);height:var(--zcs-avatar-size);background-color:var(--zcs_brand_color);border-radius:var(--zcs-avatar-radius)}.zcs-avatar .zcs-avatar-img{border-radius:inherit;object-fit:cover}.zcs-labelvalue-wrapper.zcs-labelvalue-with-bg{background-color:#F9FAFE}.zcs-labelvalue-wrapper .zcs-labelvalue-color-green{color:#179e6c}.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue{color:#2a6ffc}.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange{color:#FF7E52}.zcs-labelvalue-wrapper .zcs-labelvalue-color-red{color:#FE455D}

/* ZCS component CSS: badge-filled-badge */
.zcs-badge{width:auto}.zcs-badge-filled{border:1px solid transparent}.zcs-badge-filled.zcs-badge-theme{background-color:var(--zcs_brand_color);border-color:var(--zcs_brand_color);color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-green{background-color:#179E6C;border-color:#179E6C;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-red{background-color:#FE455D;border-color:#FE455D;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-grey{background-color:#242424;border-color:#242424;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-yellow{background-color:#FAAE13;border-color:#FAAE13;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-blue{background-color:#2A6FFC;border-color:#2A6FFC;color:var(--zcs-white-color)}.zcs-badge-filled.zcs-badge-orange{background-color:#F4660C;border-color:#F4660C;color:var(--zcs-white-color)}

/* Candidate Detail custom layout */
.candidate-detail-page{min-height:100%;background:var(--zcs-page-bg-color,#F3F3F4);color:var(--zcs-primary-text-color);font-family:inherit}.candidate-detail-content{padding:24px 30px}.candidate-grid{display:grid;grid-template-columns:minmax(280px,360px) 1fr;gap:20px;align-items:start}.candidate-profile-card{position:sticky;top:16px}.candidate-avatar-initial{color:var(--zcs_brand_foreground_color);font-size:30px;font-weight:700}.metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.metric-card{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:16px}.metric-icon{width:38px;height:38px;border-radius:10px;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.application-card{background:#fff;border:1px solid #e7e7ee;border-radius:14px;overflow:hidden;box-shadow:0 2px 10px rgba(18,19,43,.04)}.application-card+.application-card{margin-top:16px}.application-head{background:linear-gradient(90deg,var(--zcs_brand_light_color),#fff);border-bottom:1px solid #ececf3}.detail-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.detail-item{background:#F9FAFE;border:1px solid #eef0f6;border-radius:10px;padding:12px}.feedback-card{border:1px solid #eaecf4;border-radius:12px;background:#fcfcff}.feedback-timeline{width:34px;display:flex;justify-content:center}.feedback-dot{width:12px;height:12px;border-radius:50%;background:var(--zcs_brand_color);margin-top:6px}.notes-box{white-space:pre-wrap;color:var(--zcs-primary-text-color)}.related-card{background:#fff;border:1px solid #e7e7ee;border-radius:12px;padding:18px}.related-link{border:1px solid #ececf3;border-radius:10px;color:var(--zcs-primary-text-color);background:#fff}.related-link:hover{border-color:var(--zcs_brand_color);color:var(--zcs_brand_color);background:var(--zcs_component_hover_color)}.empty-state{min-height:260px;background:#fff;border:1px solid #e7e7ee;border-radius:14px}.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--zcs_brand_light_color);color:var(--zcs_brand_color)}.zcs-page-header .zcs-button{white-space:nowrap}.quick-actions{flex-wrap:wrap}.mobile-only-break{display:none}
@media (max-width:1100px){.candidate-grid{grid-template-columns:1fr}.candidate-profile-card{position:static}.detail-list{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-row{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:700px){.candidate-detail-content{padding:16px}.zcs-page-header{padding:16px}.detail-list,.metric-row{grid-template-columns:1fr}.application-head{align-items:flex-start;flex-direction:column}.quick-actions{width:100%}.zcs-page-header .quick-actions .zcs-button{width:100%;justify-content:center}.mobile-only-break{display:block}}
</style>

<div class="candidate-detail-page">
<%
	if(candidateRows.count() == 0)
	{
		%>
<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis'>
			<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'>Candidate 360-degree View</h5>
			<span class='zcs-font-14 zcs-color-secondary'>No candidate was found for the supplied page parameter.</span>
		</div>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12 quick-actions'>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:Candidate_List?zc_LoadIn=dialog&zc_Header=true'>
				<i class='zcs-button-icon zc-li-outline users-single-01'></i>
				<span class='zcs-button-text'>Candidate List</span>
			</a>
		</div>
	</div>
	<div class='candidate-detail-content'>
		<div class='zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
			<div class='zcs-nodata-content zcs-p-20 zcs-box-border'>
				<div class='empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'>
					<i class='zc-li-outline ui-1-circle-remove zcs-font-40'></i>
				</div>
				<h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>Candidate not found</h5>
				<p class='zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0'>Open this page with a valid candidate_id to view candidate details, applications, and interview feedback.</p>
			</div>
		</div>
	</div>
<%
	}
	else
	{
		cand = candidateRows;
		candidateName = ifnull(cand.Candidate_Name,"Candidate");
		candidateInitial = candidateName.left(1);
		candidateEmail = ifnull(cand.Email,"-");
		candidatePhone = ifnull(cand.Phone,"-");
		candidateSource = ifnull(cand.Source,"-");
		referredBy = ifnull(cand.Referred_By,"-");
		agencyName = ifnull(cand.Agency,"-");
		poolStatus = "No";
		poolBadge = "zcs-badge-grey";
		if(ifnull(cand.Is_In_Pool,false) == true)
		{
			poolStatus = "In Talent Pool";
			poolBadge = "zcs-badge-green";
		}
		poolNotes = ifnull(cand.Pool_Notes,"-");
		applications = Job_Application[Candidate == cand.ID] sort by Application_Date desc;
		applicationCount = applications.count();
		feedbackCount = 0;
		selectedCount = 0;
		activeCount = 0;
		latestStatus = "-";
		firstAppSeen = false;
		for each  appCountRow in applications
		{
			if(firstAppSeen == false)
			{
				latestStatus = ifnull(appCountRow.Status,"-");
				firstAppSeen = true;
			}
			if(appCountRow.Status == "Selected")
			{
				selectedCount = selectedCount + 1;
			}
			if(appCountRow.Status == "Active" || appCountRow.Status == "On_Hold")
			{
				activeCount = activeCount + 1;
			}
			feedbackCount = feedbackCount + Interview_Feedback[Job_Application == appCountRow.ID].count();
		}
		activeApplicationsUrl = "#Report:Active_Job_Applications?Candidate=" + cand.ID + "&zc_LoadIn=dialog&zc_Header=true";
		historyUrl = "#Report:Job_Application_History?Candidate=" + cand.ID + "&zc_LoadIn=dialog&zc_Header=true";
		feedbackUrl = "#Report:Interview_Feedback_List?zc_LoadIn=dialog&zc_Header=true";
		candidateListUrl = "#Report:Candidate_List?ID=" + cand.ID + "&zc_LoadIn=dialog&zc_Header=true";
		%>
<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12 zcs-ellipsis'>
			<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink' style='--zcs-avatar-size:48px;--zcs-avatar-radius:12px'>
				<span class='candidate-avatar-initial'><%=candidateInitial%></span>
			</div>
			<div class='zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis'>
				<h5 class='zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'><%=candidateName%></h5>
				<span class='zcs-font-14 zcs-color-secondary zcs-ellipsis'>Candidate 360-degree view with applications and feedback history</span>
			</div>
		</div>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12 quick-actions'>
			<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=activeApplicationsUrl%>'>
				<i class='zcs-button-icon zc-li-outline files-single-copy-04'></i>
				<span class='zcs-button-text'>Active Applications</span>
			</a>
			<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=historyUrl%>'>
				<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
				<span class='zcs-button-text'>Application History</span>
			</a>
		</div>
	</div>

	<div class='candidate-detail-content'>
		<div class='candidate-grid'>
			<aside class='candidate-profile-card'>
				<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border'>
					<div class='zcs-flex zcs-align-items-center zcs-gap-16'>
						<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink' style='--zcs-avatar-size:75px;--zcs-avatar-radius:14px'>
							<span class='candidate-avatar-initial'><%=candidateInitial%></span>
						</div>
						<div class='zcs-flex zcs-direction-column zcs-gap-4 zcs-col-common zcs-ellipsis'>
							<h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'><%=candidateName%></h6>
							<span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis'><%=candidateEmail%></span>
							<span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis'><%=candidatePhone%></span>
						</div>
					</div>
					<div class='zcs-labelvalue-wrapper'>
						<ul class='zcs-row zcs-gap-16 zcs-p-0 zcs-m-0'>
							<li class='zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12'>
								<label class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Source</label>
								<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=candidateSource%></span>
							</li>
							<li class='zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12'>
								<label class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Referred By</label>
								<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=referredBy%></span>
							</li>
							<li class='zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12'>
								<label class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Agency</label>
								<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=agencyName%></span>
							</li>
							<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
								<label class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Talent Pool</label>
								<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=poolBadge%>'>
									<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=poolStatus%></span>
								</div>
							</li>
							<li class='zcs-flex zcs-direction-column zcs-gap-6 zcs-col-12'>
								<label class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Pool Notes</label>
								<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=poolNotes%></span>
							</li>
						</ul>
					</div>
				</div>

				<div class='related-card zcs-mt-16'>
					<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Related reports</h6>
					<div class='zcs-flex zcs-direction-column zcs-gap-10 zcs-mt-12'>
						<a class='related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border' href='<%=activeApplicationsUrl%>'>
							<span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline files-single-copy-04'></i><span>Active Job Applications</span></span>
							<i class='zc-li-outline arrows-1-tail-right'></i>
						</a>
						<a class='related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border' href='<%=historyUrl%>'>
							<span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline ui-2-time'></i><span>Job Application History</span></span>
							<i class='zc-li-outline arrows-1-tail-right'></i>
						</a>
						<a class='related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border' href='<%=feedbackUrl%>'>
							<span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline education-paper'></i><span>Interview Feedback List</span></span>
							<i class='zc-li-outline arrows-1-tail-right'></i>
						</a>
						<a class='related-link zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-16 zcs-py-10 zcs-box-border' href='<%=candidateListUrl%>'>
							<span class='zcs-flex zcs-align-items-center zcs-gap-8'><i class='zc-li-outline users-single-01'></i><span>Candidate List</span></span>
							<i class='zc-li-outline arrows-1-tail-right'></i>
						</a>
					</div>
				</div>
			</aside>

			<main class='zcs-flex zcs-direction-column zcs-gap-20'>
				<div class='metric-row'>
					<div class='metric-card zcs-flex zcs-align-items-center zcs-gap-12'>
						<div class='metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline files-single-copy-04 zcs-font-20'></i></div>
						<div>
							<div class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=applicationCount%></div>
							<div class='zcs-font-13 zcs-color-secondary'>Applications</div>
						</div>
					</div>
					<div class='metric-card zcs-flex zcs-align-items-center zcs-gap-12'>
						<div class='metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline education-paper zcs-font-20'></i></div>
						<div>
							<div class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=feedbackCount%></div>
							<div class='zcs-font-13 zcs-color-secondary'>Feedback entries</div>
						</div>
					</div>
					<div class='metric-card zcs-flex zcs-align-items-center zcs-gap-12'>
						<div class='metric-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'><i class='zc-li-outline ui-1-check-circle-08 zcs-font-20'></i></div>
						<div>
							<div class='zcs-font-24 zcs-font-bold zcs-color-primary'><%=selectedCount%></div>
							<div class='zcs-font-13 zcs-color-secondary'>Selected outcomes</div>
						</div>
					</div>
				</div>

				<section class='zcs-flex zcs-direction-column zcs-gap-12'>
					<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
						<div>
							<h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Applications and feedback history</h6>
							<span class='zcs-font-14 zcs-color-secondary'>Rows are fetched live from Job_Application, descending by Application_Date.</span>
						</div>
						<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue'>
							<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>Latest status: <%=latestStatus%></span>
						</div>
					</div>
<%
		if(applicationCount == 0)
		{
			%>
<div class='zcs-nodata-wrapper empty-state zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center'>
						<div class='zcs-nodata-content zcs-p-20 zcs-box-border'>
							<div class='empty-icon zcs-inline-flex zcs-align-items-center zcs-justify-center'>
								<i class='zc-li-outline files-single-copy-04 zcs-font-40'></i>
							</div>
							<h5 class='zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0'>No applications yet</h5>
							<p class='zcs-nodata-desc zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-mt-12 zcs-mx-0 zcs-mb-0'>This candidate has no Job_Application rows. Use the related reports to review all active applications.</p>
						</div>
					</div>
<%
		}
		else
		{
			for each  app in applications
			{
				jobTitle = "-";
				jobDepartment = "-";
				jobRows = Job_Request[ID == app.Job_Request];
				if(jobRows.count() > 0)
				{
					jobTitle = ifnull(jobRows.Job_Title,"-");
					jobDepartment = ifnull(jobRows.Department,"-");
				}
				appDate = "-";
				if(app.Application_Date != null)
				{
					appDate = app.Application_Date.toString("dd-MMM-yyyy");
				}
				offerDate = "-";
				if(app.Offer_Accepted_Date != null)
				{
					offerDate = app.Offer_Accepted_Date.toString("dd-MMM-yyyy");
				}
				appStatus = ifnull(app.Status,"-");
				appStatusLabel = appStatus.replaceAll("_"," ");
				appBadge = "zcs-badge-theme";
				if(appStatus == "Selected")
				{
					appBadge = "zcs-badge-green";
				}
				else if(appStatus == "Rejected")
				{
					appBadge = "zcs-badge-red";
				}
				else if(appStatus == "On_Hold")
				{
					appBadge = "zcs-badge-yellow";
				}
				else if(appStatus == "Active")
				{
					appBadge = "zcs-badge-blue";
				}
				appFeedbackUrl = "#Report:Interview_Feedback_List?Job_Application=" + app.ID + "&zc_LoadIn=dialog&zc_Header=true";
				applicationReportUrl = "#Report:Job_Application_History?ID=" + app.ID + "&zc_LoadIn=dialog&zc_Header=true";
				feedbackRows = Interview_Feedback[Job_Application == app.ID] sort by Feedback_Date desc;
				%>
<article class='application-card'>
						<div class='application-head zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16 zcs-p-18 zcs-box-border'>
							<div class='zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis'>
								<h6 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0 zcs-ellipsis'><%=jobTitle%></h6>
								<span class='zcs-font-14 zcs-color-secondary zcs-ellipsis'>Application <%=app.ID%> \u00B7 <%=jobDepartment%></span>
							</div>
							<div class='zcs-flex zcs-align-items-center zcs-gap-10 quick-actions'>
								<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=appBadge%>'>
									<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=appStatusLabel%></span>
								</div>
								<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=applicationReportUrl%>'>
									<i class='zcs-button-icon zc-li-outline arrows-1-tail-right'></i>
									<span class='zcs-button-text'>Open row</span>
								</a>
							</div>
						</div>
						<div class='zcs-p-18 zcs-box-border'>
							<div class='detail-list'>
								<div class='detail-item'>
									<label class='zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold'>Application Date</label>
									<div class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4'><%=appDate%></div>
								</div>
								<div class='detail-item'>
									<label class='zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold'>Current Round</label>
									<div class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4'><%=ifnull(app.Current_Round,"-")%></div>
								</div>
								<div class='detail-item'>
									<label class='zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold'>Source</label>
									<div class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4'><%=ifnull(app.Source_Of_Application,"-")%></div>
								</div>
								<div class='detail-item'>
									<label class='zcs-font-12 zcs-uppercase zcs-color-tertiary zcs-font-semibold'>Offer Accepted</label>
									<div class='zcs-font-14 zcs-font-medium zcs-color-primary zcs-mt-4'><%=offerDate%></div>
								</div>
							</div>

							<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-mt-20'>
								<div>
									<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Interview feedback</h6>
									<span class='zcs-font-13 zcs-color-secondary'><%=feedbackRows.count()%> feedback row(s) for this application</span>
								</div>
								<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='<%=appFeedbackUrl%>'>
									<i class='zcs-button-icon zc-li-outline education-paper'></i>
									<span class='zcs-button-text'>Feedback report</span>
								</a>
							</div>
<%
				if(feedbackRows.count() == 0)
				{
					%>
<div class='feedback-card zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-16 zcs-mt-12 zcs-box-border'>
								<i class='zc-li-outline ui-1-alert-circle-i zcs-font-20 zcs-color-tertiary'></i>
								<span class='zcs-font-14 zcs-color-secondary'>No Interview_Feedback rows have been recorded for this application.</span>
							</div>
<%
				}
				else
				{
					for each  fb in feedbackRows
					{
						fbDate = "-";
						if(fb.Feedback_Date != null)
						{
							fbDate = fb.Feedback_Date.toString("dd-MMM-yyyy");
						}
						recommendation = ifnull(fb.Recommendation,"-");
						recommendationLabel = recommendation.replaceAll("_"," ");
						recommendationBadge = "zcs-badge-theme";
						if(recommendation == "Select")
						{
							recommendationBadge = "zcs-badge-green";
						}
						else if(recommendation == "Reject")
						{
							recommendationBadge = "zcs-badge-red";
						}
						else if(recommendation == "On_Hold")
						{
							recommendationBadge = "zcs-badge-yellow";
						}
						else if(recommendation == "Next_Round")
						{
							recommendationBadge = "zcs-badge-blue";
						}
						feedbackNotes = ifnull(fb.Feedback_Notes,"-");
						%>
<div class='feedback-card zcs-flex zcs-align-items-start zcs-gap-12 zcs-p-16 zcs-mt-12 zcs-box-border'>
								<div class='feedback-timeline zcs-no-shrink'><span class='feedback-dot'></span></div>
								<div class='zcs-col-common'>
									<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12'>
										<div class='zcs-flex zcs-direction-column zcs-gap-4'>
											<span class='zcs-font-14 zcs-font-semibold zcs-color-primary'>Round <%=ifnull(fb.Round_Number,"-")%></span>
											<span class='zcs-font-13 zcs-color-secondary'>Panel member: <%=ifnull(fb.Panel_Member,"-")%> \u00B7 <%=fbDate%></span>
										</div>
										<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=recommendationBadge%>'>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=recommendationLabel%></span>
										</div>
									</div>
									<div class='notes-box zcs-font-14 zcs-lh-body zcs-mt-12'><%=feedbackNotes%></div>
								</div>
							</div>
<%
					}
				}
				%>
</div>
					</article>
<%
			}
		}
		%>
</section>
			</main>
		</div>
	</div>
<%
	}
	%>
</div>