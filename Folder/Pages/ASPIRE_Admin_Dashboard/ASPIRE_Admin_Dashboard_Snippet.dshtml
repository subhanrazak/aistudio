<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAllowed = loginRole == "ASPIRE_ADMIN" || loginRole == "Administrator" || loginRole == "Admin";
	todayDate = zoho.currentdate;
	todayDisplay = todayDate.toString("dd-MMM-yyyy");
	soonDate = todayDate.addDay(30);
	currentMonthToken = todayDate.toString("yyyy-MM");
	userName = ifnull(zoho.loginuser,"ASPIRE Admin");
	employeeUserRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	if(employeeUserRows.count() > 0)
	{
		userName = ifnull(employeeUserRows.Full_Name,userName);
	}
	if(isAllowed == true)
	{
		submittedNewRows = ID_Card_Request[Status == "Submitted" && Request_Type == "New"] sort by ID desc;
		extensionPendingRows = ID_Card_Request[Status == "Submitted" && Extension_ID_Number == null || Extension_ID_Number == ""] sort by ID desc;
		readyToProcessRows = ID_Card_Request[Status == "Extension_ID_Updated"] sort by ID desc;
		cardGeneratedRows = ID_Card_Request[Status == "Card_Generated"] sort by ID desc;
		expiringSoonRows = ID_Card_Request[Status == "Received" && Valid_Upto != null && Valid_Upto >= todayDate && Valid_Upto <= soonDate] sort by Valid_Upto asc;
		expiredRows = ID_Card_Request[Status == "Received" && Valid_Upto != null && Valid_Upto < todayDate] sort by Valid_Upto asc;
		submittedNewCount = submittedNewRows.count();
		extensionPendingCount = extensionPendingRows.count();
		readyToProcessCount = readyToProcessRows.count();
		cardGeneratedCount = cardGeneratedRows.count();
		expiringSoonCount = expiringSoonRows.count();
		expiredCount = expiredRows.count();
		issuedThisMonthCount = 0;
		issuedThisMonthRows = ID_Card_Request[Status == "Received" && Received_Date != null] sort by Received_Date desc;
		for each  issuedSeed in issuedThisMonthRows
		{
			if(issuedSeed.Received_Date.toString("yyyy-MM") == currentMonthToken)
			{
				issuedThisMonthCount = issuedThisMonthCount + 1;
			}
		}
		totalOpenQueue = submittedNewCount + readyToProcessCount + cardGeneratedCount;
		expiringWindowLabel = todayDisplay + " to " + soonDate.toString("dd-MMM-yyyy");
		%>
<style>
/* ===== zcs-global.css included once for ASPIRE_Admin_Dashboard (utility subset used by this page) ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-6 { margin-top: .375rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }
/* ZCS component CSS: layout-dashboard panel tiles */
.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs-border-color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: all .2s ease; } .zcs-panel-icon-wrapper { width: 42px; height: 42px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #FDF5F3; color: #F4660C; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #F6F6FB; color: #5C66FF; } .zcs-panel:hover { border-color: var(--zcs-theme-brand-color); background-image: linear-gradient(rgb(253 253 255 / 10%), #F7F9FF); }
/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
/* ZCS component CSS: table-simple-table */
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
/* ZCS component CSS: button-primary-button and header-heading-with-actions button area */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }
.aspire-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }
.aspire-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }
.aspire-hero:after { content: ""; position: absolute; right: -88px; top: -112px; width: 312px; height: 312px; border-radius: 50%; border: 42px solid rgba(255,255,255,.12); }
.aspire-hero:before { content: ""; position: absolute; right: 170px; bottom: -88px; width: 190px; height: 190px; border-radius: 50%; border: 28px solid rgba(255,255,255,.10); }
.aspire-hero-content { position: relative; z-index: 1; }
.aspire-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }
.aspire-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.aspire-kpi { grid-column: span 2; } .aspire-card-4 { grid-column: span 4; } .aspire-card-5 { grid-column: span 5; } .aspire-card-6 { grid-column: span 6; } .aspire-card-7 { grid-column: span 7; } .aspire-card-12 { grid-column: span 12; }
.aspire-list { list-style: none; margin: 0; padding: 0; } .aspire-list li { border-top: 1px solid var(--zcs-border-color); padding: 12px 0; } .aspire-list li:first-child { border-top: 0; padding-top: 0; }
.aspire-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }
.aspire-action-link { color: var(--zcs-theme-brand-color); font-weight: 600; }
.aspire-status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; } .aspire-status-dot.green { background: #179E6C; } .aspire-status-dot.yellow { background: #FAAE13; } .aspire-status-dot.red { background: #FE455D; } .aspire-status-dot.blue { background: #2A6FFC; } .aspire-status-dot.orange { background: #F4660C; }
@media (max-width: 1180px) { .aspire-kpi { grid-column: span 4; } .aspire-card-4, .aspire-card-5, .aspire-card-6, .aspire-card-7 { grid-column: span 12; } }
@media (max-width: 760px) { .aspire-page { padding: 14px; } .aspire-hero-content { flex-direction: column; align-items: flex-start; } .aspire-hero .zcs-flex.zcs-gap-10 { flex-wrap: wrap; } .aspire-kpi, .aspire-card-4, .aspire-card-5, .aspire-card-6, .aspire-card-7, .aspire-card-12 { grid-column: span 12; } }
</style>
<div class="aspire-page zcs-flex zcs-direction-column zcs-gap-20">
	<div class="aspire-hero">
		<div class="aspire-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
			<div>
				<div class="zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-badge zcs-badge-filled zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 zcs-font-medium zcs-lh-body">Live ID card operations</div>
				<h2 class="zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10">ASPIRE Admin Dashboard</h2>
				<p class="zcs-font-15 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-10">Hello <%=userName%>. Request and expiry queues as of <%=todayDisplay%>.</p>
			</div>
			<div class="zcs-flex zcs-gap-10">
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_ID_Card_Management">
					<i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i>
					<span class="zcs-button-text">HR ID card management</span>
				</a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:ID_Card_Request?zc_LoadIn=dialog&amp;zc_Header=true">
					<i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
					<span class="zcs-button-text">New request</span>
				</a>
			</div>
		</div>
	</div>

	<div class="zcs-panel-wrapper">
		<ul class="aspire-grid zcs-p-0 zcs-m-0">
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-1-simple-add"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=submittedNewCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Submitted new requests</p>
				</div>
			</li>
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=extensionPendingCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Extension ID pending</p>
				</div>
			</li>
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline loader-dots-06"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=readyToProcessCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Extension_ID_Updated ready</p>
				</div>
			</li>
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=issuedThisMonthCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Cards issued this month</p>
				</div>
			</li>
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=expiringSoonCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Expiring in 30 days</p>
				</div>
			</li>
			<li class="aspire-kpi">
				<div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-2-time"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=expiredCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Expired received cards</p>
				</div>
			</li>
		</ul>
	</div>

	<ul class="aspire-grid zcs-p-0 zcs-m-0">
		<li class="aspire-card-4">
			<div class="zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div>
						<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Processing flow</h3>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6">Open queue count: <%=totalOpenQueue%></p>
					</div>
					<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_ID_Card_Management">
						<i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i>
						<span class="zcs-button-text">Open queue</span>
					</a>
				</div>
				<ul class="aspire-list">
					<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><span class="zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary"><span class="aspire-status-dot yellow"></span>Submitted</span><strong class="zcs-font-16 zcs-color-primary"><%=submittedNewCount%></strong></li>
					<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><span class="zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary"><span class="aspire-status-dot blue"></span>Extension_ID_Updated</span><strong class="zcs-font-16 zcs-color-primary"><%=readyToProcessCount%></strong></li>
					<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><span class="zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary"><span class="aspire-status-dot green"></span>Card_Generated awaiting receipt</span><strong class="zcs-font-16 zcs-color-primary"><%=cardGeneratedCount%></strong></li>
					<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12"><span class="zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-14 zcs-color-primary"><span class="aspire-status-dot orange"></span>Expiring window</span><span class="zcs-font-13 zcs-color-secondary"><%=expiringWindowLabel%></span></li>
				</ul>
			</div>
		</li>

		<li class="aspire-card-8">
			<div class="zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div>
						<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Submitted new requests</h3>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6">Update the extension ID, then move requests through card generation and receipt.</p>
					</div>
					<div class="zcs-badge zcs-badge-filled zcs-badge-yellow zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><span class="zcs-font-13 zcs-font-medium"><%=submittedNewCount%> pending</span></div>
				</div>
				<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Recipient</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Requester</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Action</th></tr></thead>
						<tbody>
<%
		submittedShown = 0;
		for each  submittedRow in submittedNewRows
		{
			if(submittedShown < 6)
			{
				submittedRecipient = ifnull(submittedRow.Recipient_Name,"Not specified");
				if(submittedRecipient == "")
				{
					submittedRecipient = "Not specified";
				}
				submittedRequester = "-";
				if(submittedRow.Requester_Type == "Employee" && submittedRow.Employee_Requester != null)
				{
					submittedRequester = ifnull(submittedRow.Employee_Requester.Full_Name,"-");
				}
				else if(submittedRow.Requester_Type == "Member" && submittedRow.Member_Requester != null)
				{
					submittedRequester = ifnull(submittedRow.Member_Requester.Member_Name,"-");
				}
				layoutUrl = "#Page:ID_Card_Layout?id_card_request_id=" + submittedRow.ID;
				%>
<tr>
								<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-primary"><%=submittedRecipient%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary"><%=submittedRow.Requester_Type%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-color-secondary"><%=submittedRequester%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14"><a class="aspire-action-link" href="<%=layoutUrl%>">Open layout</a></td>
							</tr>
<%
				submittedShown = submittedShown + 1;
			}
		}
		if(submittedShown == 0)
		{
			%>
<tr><td colspan="4" class="zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary">No submitted new requests.</td></tr>
<%
		}
		%>
</tbody>
					</table>
				</div>
			</div>
		</li>

		<li class="aspire-card-6">
			<div class="zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div>
						<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Extension ID pending</h3>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6">Submitted records without an extension ID number.</p>
					</div>
					<div class="zcs-badge zcs-badge-filled zcs-badge-orange zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><span class="zcs-font-13 zcs-font-medium"><%=extensionPendingCount%></span></div>
				</div>
				<ul class="aspire-list">
<%
		pendingShown = 0;
		for each  pendingRow in extensionPendingRows
		{
			if(pendingShown < 6)
			{
				pendingRecipient = ifnull(pendingRow.Recipient_Name,"Not specified");
				if(pendingRecipient == "")
				{
					pendingRecipient = "Not specified";
				}
				pendingLayoutUrl = "#Page:ID_Card_Layout?id_card_request_id=" + pendingRow.ID;
				%>
<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
						<div class="zcs-col-common zcs-flex zcs-direction-column zcs-gap-4">
							<span class="zcs-font-14 zcs-font-medium zcs-color-primary"><%=pendingRecipient%></span>
							<span class="zcs-font-12 zcs-font-normal zcs-color-tertiary"><%=pendingRow.Requester_Type%> request, <%=pendingRow.Request_Type%></span>
						</div>
						<a class="aspire-action-link zcs-font-13" href="#Report:HR_ID_Card_Management">Manage</a>
					</li>
<%
				pendingShown = pendingShown + 1;
			}
		}
		if(pendingShown == 0)
		{
			%>
<li><div class="aspire-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-16 zcs-box-border"><span class="zcs-font-14 zcs-color-tertiary">No extension ID pending records.</span></div></li>
<%
		}
		%>
</ul>
			</div>
		</li>

		<li class="aspire-card-6">
			<div class="zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div>
						<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Extension_ID_Updated ready to process</h3>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6">Ready for card generation or downstream processing.</p>
					</div>
					<div class="zcs-badge zcs-badge-filled zcs-badge-blue zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><span class="zcs-font-13 zcs-font-medium"><%=readyToProcessCount%></span></div>
				</div>
				<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Recipient</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Extension ID</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Printable layout</th></tr></thead>
						<tbody>
<%
		readyShown = 0;
		for each  readyRow in readyToProcessRows
		{
			if(readyShown < 6)
			{
				readyRecipient = ifnull(readyRow.Recipient_Name,"Not specified");
				if(readyRecipient == "")
				{
					readyRecipient = "Not specified";
				}
				readyExtension = ifnull(readyRow.Extension_ID_Number,"-");
				readyLayoutUrl = "#Page:ID_Card_Layout?id_card_request_id=" + readyRow.ID;
				%>
<tr>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary"><%=readyRecipient%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=readyExtension%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><a class="aspire-action-link" href="<%=readyLayoutUrl%>">Open ID_Card_Layout</a></td>
							</tr>
<%
				readyShown = readyShown + 1;
			}
		}
		if(readyShown == 0)
		{
			%>
<tr><td colspan="3" class="zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary">No Extension_ID_Updated records are waiting.</td></tr>
<%
		}
		%>
</tbody>
					</table>
				</div>
			</div>
		</li>

		<li class="aspire-card-12">
			<div class="zcs-card zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div>
						<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Expiring soon list</h3>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-mt-6">Received ID cards expiring within the next 30 days.</p>
					</div>
					<div class="zcs-badge zcs-badge-filled zcs-badge-red zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border"><span class="zcs-font-13 zcs-font-medium"><%=expiringSoonCount%> expiring</span></div>
				</div>
				<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Recipient</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Extension ID</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Valid upto</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Requester type</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary">Action</th></tr></thead>
						<tbody>
<%
		expiringShown = 0;
		for each  expiringRow in expiringSoonRows
		{
			if(expiringShown < 10)
			{
				expiringRecipient = ifnull(expiringRow.Recipient_Name,"Not specified");
				if(expiringRecipient == "")
				{
					expiringRecipient = "Not specified";
				}
				expiringExtension = ifnull(expiringRow.Extension_ID_Number,"-");
				expiringDate = "-";
				if(expiringRow.Valid_Upto != null)
				{
					expiringDate = expiringRow.Valid_Upto.toString("dd-MMM-yyyy");
				}
				expiringLayoutUrl = "#Page:ID_Card_Layout?id_card_request_id=" + expiringRow.ID;
				%>
<tr>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-primary"><%=expiringRecipient%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=expiringExtension%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-red"><%=expiringDate%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-font-14 zcs-color-secondary"><%=expiringRow.Requester_Type%></td>
								<td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><a class="aspire-action-link" href="<%=expiringLayoutUrl%>">Review layout</a></td>
							</tr>
<%
				expiringShown = expiringShown + 1;
			}
		}
		if(expiringShown == 0)
		{
			%>
<tr><td colspan="5" class="zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-color-tertiary">No received ID cards are expiring within 30 days.</td></tr>
<%
		}
		%>
</tbody>
					</table>
				</div>
			</div>
		</li>
	</ul>
</div>
<%
	}
	else
	{
		%>
<style>
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-white-color: #FFFFFF; }
.aspire-denied { min-height: 360px; display: flex; align-items: center; justify-content: center; background: #F5F7FB; padding: 24px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }
.aspire-denied-card { max-width: 560px; width: 100%; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; padding: 28px; text-align: center; box-shadow: 0 8px 24px rgba(18,19,43,.05); }
.aspire-denied-icon { color: var(--zcs-theme-brand-color); font-size: 34px; }
</style>
<div class="aspire-denied">
	<div class="aspire-denied-card">
		<i class="aspire-denied-icon zc-li-outline ui-1-lock"></i>
		<h3>Access restricted</h3>
		<p>This dashboard is available to ASPIRE_ADMIN and Administrator profiles.</p>
	</div>
</div>
<%
	}
%>