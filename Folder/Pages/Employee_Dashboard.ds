<page linkname = "Employee_Dashboard" displayname = "Employee Dashboard"/>
<content>
<zml>
	<layout>
		<row>
			<column width='100%'>
				<dsp id='Employee_Dashboard_Snippet' elementName='Employee_Dashboard_Snippet' bgColor=\"\">
          <![CDATA[htmlpage Employee_Dashboard_Snippet()
content
			<%{%>
            <file name:Employee_Dashboard_Snippet.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
		<row>
			<column width='100%'>
				<file name:Leave_Balance_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Attendance_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Time_Off_Requests_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Regularisation_Requests_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Travel_Requests_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Reimbursements_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Gift_Registrations_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Announcement_Acknowledgements_Report.ds/> </column>
		</row>
		<row>
			<column width='100%'>
				<file name:Training_Schedule_Report.ds/> </column>
		</row>
	</layout>
</zml>
</content>