<%
	idCardRequestRows = ID_Card_Request[ID == input.id_card_request_id];
	requestFound = idCardRequestRows.count() > 0;
	%>
<style>
:root {
	--zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC);
	--zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF);
	--zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A);
	--zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563);
	--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895);
	--zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE);
	--zcs-white-color: #FFFFFF;
	--zcs-black-color: #000000;
	--idc-card-width: 86mm;
	--idc-card-height: 54mm;
	font-size: 16px;
	line-height: 1.5;
}
a { text-decoration: none; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-direction-column { flex-direction: column; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-box-border { box-sizing: border-box; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-w-full { width: 100%; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-text-center { text-align: center; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
.zcs-list-none { list-style-type: none; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; }
.zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, #2A6FFC); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, #2A6FFC); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, #F3F7FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; }
.zcs-badge-filled-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color, #F3F7FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #a06309; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-green { color: #179e6c; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-blue { color: #2a6ffc; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-orange { color: #FF7E52; }
.zcs-labelvalue-wrapper .zcs-labelvalue-color-red { color: #FE455D; }

.idc-page {
	min-height: 100%;
	background: #F6F7FB;
	color: var(--zcs-primary-text-color);
	padding: 24px;
	box-sizing: border-box;
	font-family: Arial, Helvetica, sans-serif;
}
.idc-shell {
	max-width: 1180px;
	margin: 0 auto;
}
.idc-toolbar {
	margin-bottom: 18px;
	align-items: flex-start;
}
.idc-title-block h1 {
	margin: 0;
	font-size: 24px;
	line-height: 1.2;
	color: var(--zcs-primary-text-color);
}
.idc-title-block p {
	margin: 6px 0 0 0;
	color: var(--zcs-secondary-text-color);
	font-size: 14px;
}
.idc-actions {
	flex-wrap: wrap;
	justify-content: flex-end;
}
.idc-content-grid {
	display: grid;
	grid-template-columns: minmax(0, 1fr) 340px;
	gap: 18px;
	align-items: start;
}
.idc-print-sheet {
	background: #FFFFFF;
	border: 1px solid var(--zcs-border-color);
	border-radius: 16px;
	padding: 28px;
	box-shadow: 0 16px 50px rgba(15, 23, 42, 0.08);
}
.idc-card-stack {
	display: flex;
	flex-wrap: wrap;
	gap: 24px;
	align-items: center;
	justify-content: center;
}
.idc-card {
	width: var(--idc-card-width);
	height: var(--idc-card-height);
	border-radius: 4.2mm;
	overflow: hidden;
	position: relative;
	background: #FFFFFF;
	color: #152035;
	border: .28mm solid #D8DEE9;
	box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
	box-sizing: border-box;
	page-break-inside: avoid;
}
.idc-front {
	display: grid;
	grid-template-rows: 12.5mm 1fr 8mm;
}
.idc-header-band {
	background: linear-gradient(135deg, var(--zcs_brand_color, #1C5FB8), #12345E);
	color: #FFFFFF;
	padding: 2.2mm 4mm;
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.idc-org {
	font-size: 3.4mm;
	line-height: 1.15;
	font-weight: 700;
	letter-spacing: .15mm;
}
.idc-card-kind {
	font-size: 2.45mm;
	line-height: 1;
	border: .25mm solid rgba(255,255,255,.72);
	border-radius: 99px;
	padding: 1.1mm 1.8mm;
	white-space: nowrap;
}
.idc-front-body {
	display: grid;
	grid-template-columns: 24mm 1fr;
	gap: 3mm;
	padding: 4mm;
	align-items: center;
}
.idc-photo-box {
	width: 23mm;
	height: 28mm;
	border-radius: 3mm;
	background: #EEF2F7;
	border: .25mm solid #D8DEE9;
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: center;
}
.idc-photo-box img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}
.idc-photo-placeholder {
	color: #8A94A6;
	font-size: 9mm;
}
.idc-person {
	min-width: 0;
}
.idc-person-name {
	margin: 0 0 1.8mm 0;
	font-size: 5.1mm;
	line-height: 1.06;
	font-weight: 800;
	color: #111827;
	word-break: break-word;
}
.idc-person-role {
	margin: 0 0 2.4mm 0;
	font-size: 3.05mm;
	color: #334155;
	font-weight: 600;
	line-height: 1.18;
}
.idc-meta-line {
	display: flex;
	align-items: center;
	gap: 1.6mm;
	font-size: 2.55mm;
	line-height: 1.2;
	color: #475569;
	margin-top: 1.4mm;
}
.idc-meta-label {
	color: #64748B;
	min-width: 15mm;
}
.idc-meta-value {
	color: #1F2937;
	font-weight: 700;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.idc-footer-band {
	background: #F8FAFC;
	border-top: .25mm solid #E2E8F0;
	padding: 1.8mm 4mm;
	display: flex;
	align-items: center;
	justify-content: space-between;
	font-size: 2.5mm;
	color: #334155;
}
.idc-back {
	display: grid;
	grid-template-rows: 9mm 1fr 8mm;
}
.idc-back-header {
	padding: 2.2mm 4mm;
	border-bottom: .25mm solid #E2E8F0;
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: 2.7mm;
	font-weight: 700;
	color: #0F172A;
}
.idc-back-body {
	padding: 3.3mm 4mm 2.8mm 4mm;
}
.idc-valid-box {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 2.2mm;
	margin-bottom: 3mm;
}
.idc-mini-label {
	display: block;
	font-size: 2.15mm;
	color: #64748B;
	text-transform: uppercase;
	letter-spacing: .16mm;
	margin-bottom: .8mm;
}
.idc-mini-value {
	display: block;
	font-size: 2.8mm;
	color: #111827;
	font-weight: 700;
}
.idc-barcode-panel {
	border: .25mm solid #CBD5E1;
	border-radius: 2.2mm;
	padding: 1.8mm;
	background: #FFFFFF;
}
.idc-barcode-svg {
	width: 100%;
	height: 12.5mm;
	display: block;
}
.idc-barcode-fallback {
	height: 12.5mm;
	border-radius: 1mm;
	background: repeating-linear-gradient(90deg, #111827 0 1.1mm, #FFFFFF 1.1mm 1.8mm, #111827 1.8mm 2.15mm, #FFFFFF 2.15mm 3mm);
}
.idc-barcode-text {
	margin-top: 1.1mm;
	text-align: center;
	font-size: 2.55mm;
	letter-spacing: .25mm;
	font-weight: 700;
	color: #111827;
}
.idc-back-footer {
	padding: 1.8mm 4mm;
	border-top: .25mm solid #E2E8F0;
	display: flex;
	align-items: center;
	justify-content: space-between;
	color: #475569;
	font-size: 2.25mm;
}
.idc-context-panel {
	padding: 20px;
}
.idc-context-panel h2 {
	margin: 0 0 14px 0;
	font-size: 18px;
	color: var(--zcs-primary-text-color);
}
.idc-kv-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: grid;
	gap: 12px;
}
.idc-kv-list li {
	display: grid;
	gap: 3px;
}
.idc-kv-list label {
	color: var(--zcs-teritiary-text-color);
}
.idc-kv-list span {
	color: var(--zcs-primary-text-color);
}
.idc-note {
	margin: 16px 0 0 0;
	padding: 12px;
	border: 1px dashed var(--zcs-border-color);
	border-radius: 10px;
	color: var(--zcs-secondary-text-color);
	font-size: 13px;
	background: #FBFCFF;
}
.idc-nodata-wrap {
	min-height: 360px;
	background: #FFFFFF;
	border: 1px solid var(--zcs-border-color);
	border-radius: 16px;
}
@media (max-width: 980px) {
	.idc-content-grid { grid-template-columns: 1fr; }
	.idc-actions { justify-content: flex-start; }
}
@media print {
	@page { size: A4 portrait; margin: 12mm; }
	html, body { background: #FFFFFF !important; }
	.idc-page { padding: 0 !important; background: #FFFFFF !important; }
	.idc-toolbar, .idc-context-panel { display: none !important; }
	.idc-shell, .idc-content-grid, .idc-print-sheet { max-width: none !important; margin: 0 !important; display: block !important; }
	.idc-print-sheet { border: 0 !important; box-shadow: none !important; padding: 0 !important; }
	.idc-card-stack { justify-content: flex-start !important; align-items: flex-start !important; gap: 10mm !important; }
	.idc-card { box-shadow: none !important; break-inside: avoid; page-break-inside: avoid; }
	.zc-pb-tile-card, .zc-pb-tile-container { box-shadow: none !important; border: 0 !important; }
}
</style>
<div class="idc-page">
	<div class="idc-shell">
<%
	if(!requestFound)
	{
		%>
<div class="idc-nodata-wrap zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No ID card request found</h5>
				<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0">Check the page parameter id_card_request_id and open this page again.</p>
			</div>
		</div>
<%
	}
	else
	{
		req = idCardRequestRows;
		requestIdText = req.ID.toString();
		requesterType = ifnull(req.Requester_Type,"Not set");
		recipientName = ifnull(req.Recipient_Name,"Unnamed recipient");
		designationText = ifnull(req.Recipient_Designation,"Designation not set");
		extensionText = ifnull(req.Extension_ID_Number,"");
		if(extensionText == "")
		{
			extensionDisplay = "Pending";
			barcodeValue = "";
		}
		else
		{
			extensionDisplay = extensionText;
			barcodeValue = extensionText;
		}
		requestTypeText = ifnull(req.Request_Type,"Not set");
		statusRaw = ifnull(req.Status,"Submitted");
		statusDisplay = statusRaw;
		statusBadge = "zcs-badge-blue";
		if(statusRaw == "Submitted")
		{
			statusBadge = "zcs-badge-yellow";
		}
		else if(statusRaw == "Extension_ID_Updated")
		{
			statusDisplay = "Extension ID Updated";
			statusBadge = "zcs-badge-orange";
		}
		else if(statusRaw == "Card_Generated")
		{
			statusDisplay = "Card Generated";
			statusBadge = "zcs-badge-blue";
		}
		else if(statusRaw == "Received")
		{
			statusBadge = "zcs-badge-green";
		}
		else if(statusRaw == "Deactivated")
		{
			statusBadge = "zcs-badge-red";
		}
		validFromText = "Not set";
		if(req.Valid_From != null)
		{
			validFromText = req.Valid_From.toString("dd-MMM-yyyy");
		}
		validUptoText = "Not set";
		if(req.Valid_Upto != null)
		{
			validUptoText = req.Valid_Upto.toString("dd-MMM-yyyy");
		}
		receivedDateText = "Not received";
		if(req.Received_Date != null)
		{
			receivedDateText = req.Received_Date.toString("dd-MMM-yyyy");
		}
		sourceLabel = "Source record";
		sourceCode = "Not available";
		sourceEmail = "Not available";
		sourceMeta = "Not available";
		sourceUrl = "";
		photoUrl = ifnull(req.Recipient_Photo,"");
		if(requesterType == "Employee")
		{
			employeeRows = Employee_Master[ID == req.Employee_Requester];
			sourceLabel = "Employee Master";
			sourceUrl = "#Report:All_Employees?ID=" + req.Employee_Requester + "&zc_LoadIn=dialog&zc_Header=true";
			if(employeeRows.count() > 0)
			{
				recipientName = ifnull(req.Recipient_Name,ifnull(employeeRows.Full_Name,recipientName));
				designationText = ifnull(req.Recipient_Designation,ifnull(employeeRows.Designation,designationText));
				sourceCode = ifnull(employeeRows.Employee_ID,"Not available");
				sourceEmail = ifnull(employeeRows.Official_Email,"Not available");
				sourceMeta = ifnull(employeeRows.Department.Department_Name,"Department not set");
				if(photoUrl == "")
				{
					photoUrl = ifnull(employeeRows.Profile_Photo,"");
				}
			}
		}
		else if(requesterType == "Member")
		{
			memberRows = Member_Master[ID == req.Member_Requester];
			sourceLabel = "Member Master";
			sourceUrl = "#Report:Member_Master_List?ID=" + req.Member_Requester + "&zc_LoadIn=dialog&zc_Header=true";
			if(memberRows.count() > 0)
			{
				recipientName = ifnull(req.Recipient_Name,ifnull(memberRows.Member_Name,recipientName));
				designationText = ifnull(req.Recipient_Designation,ifnull(memberRows.Member_Type,designationText));
				sourceCode = ifnull(memberRows.Member_ID,"Not available");
				sourceEmail = ifnull(memberRows.Member_Email,"Not available");
				sourceMeta = ifnull(memberRows.Organization,"Organization not set");
			}
		}
		requestUrl = "#Report:HR_ID_Card_Management?ID=" + requestIdText + "&zc_LoadIn=dialog&zc_Header=true";
		%>
<div class="idc-toolbar zcs-flex zcs-justify-space-between zcs-gap-16">
			<div class="idc-title-block">
				<h1>ID Card Layout</h1>
				<p>Printable ID card for request <strong>#<%=requestIdText%></strong>. Data is fetched live from ID_Card_Request and the linked <%=sourceLabel%> record.</p>
			</div>
			<div class="idc-actions zcs-flex zcs-align-items-center zcs-gap-8">
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#" onclick="window.print(); return false;">
					<i class="zcs-button-icon zc-li-outline ui-1-check-circle-08"></i>
					<span class="zcs-button-text">Print</span>
				</a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#" onclick="window.print(); return false;">
					<i class="zcs-button-icon zc-li-outline ui-1-edit-72"></i>
					<span class="zcs-button-text">Save as PDF</span>
				</a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=requestUrl%>">
					<i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
					<span class="zcs-button-text">Open Request</span>
				</a>
			</div>
		</div>
		<div class="idc-content-grid">
			<section class="idc-print-sheet" aria-label="Printable ID card sheet">
				<div class="idc-card-stack">
					<article class="idc-card idc-front" aria-label="ID card front">
						<div class="idc-header-band">
							<div class="idc-org">IITB HR</div>
							<div class="idc-card-kind"><%=requesterType%> ID</div>
						</div>
						<div class="idc-front-body">
							<div class="idc-photo-box">
<%
		if(photoUrl != "")
		{
			%>
<img src="<%=photoUrl%>" alt="Recipient photo" onerror="this.style.display='none'; this.parentNode.classList.add('idc-photo-missing');" />
<%
		}
		else
		{
			%>
<span class="idc-photo-placeholder"><i class="zc-li-outline users-single-01"></i></span>
<%
		}
		%>
</div>
							<div class="idc-person">
								<h2 class="idc-person-name"><%=recipientName%></h2>
								<p class="idc-person-role"><%=designationText%></p>
								<div class="idc-meta-line"><span class="idc-meta-label">Ext ID</span><span class="idc-meta-value"><%=extensionDisplay%></span></div>
								<div class="idc-meta-line"><span class="idc-meta-label">Type</span><span class="idc-meta-value"><%=requesterType%></span></div>
								<div class="idc-meta-line"><span class="idc-meta-label">Source</span><span class="idc-meta-value"><%=sourceCode%></span></div>
							</div>
						</div>
						<div class="idc-footer-band">
							<span>Valid: <%=validFromText%> to <%=validUptoText%></span>
							<span>#<%=requestIdText%></span>
						</div>
					</article>
					<article class="idc-card idc-back" aria-label="ID card back">
						<div class="idc-back-header">
							<span>Extension Barcode</span>
							<span><%=requestTypeText%></span>
						</div>
						<div class="idc-back-body">
							<div class="idc-valid-box">
								<div><span class="idc-mini-label">Valid From</span><span class="idc-mini-value"><%=validFromText%></span></div>
								<div><span class="idc-mini-label">Valid Upto</span><span class="idc-mini-value"><%=validUptoText%></span></div>
							</div>
							<div class="idc-barcode-panel">
<%
		if(barcodeValue != "")
		{
			%>
<svg class="idc-barcode-svg" data-code="<%=barcodeValue%>" role="img" aria-label="Extension barcode"></svg>
								<div class="idc-barcode-text"><%=barcodeValue%></div>
<%
		}
		else
		{
			%>
<div class="idc-barcode-fallback" aria-hidden="true"></div>
								<div class="idc-barcode-text">Extension ID pending</div>
<%
		}
		%>
</div>
						</div>
						<div class="idc-back-footer">
							<span><%=requesterType%></span>
							<span>Received: <%=receivedDateText%></span>
						</div>
					</article>
				</div>
			</section>
			<aside class="idc-context-panel zcs-card zcs-box-border" aria-label="Request context">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<h2>Request Context</h2>
					<div class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusBadge%>">
						<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=statusDisplay%></span>
					</div>
				</div>
				<div class="zcs-labelvalue-wrapper">
					<ul class="idc-kv-list zcs-p-0 zcs-m-0">
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Recipient</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=recipientName%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Designation</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=designationText%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Requester Type</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=requesterType%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Extension ID Number</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=extensionDisplay%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Valid Dates</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=validFromText%> to <%=validUptoText%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body"><%=sourceLabel%></label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=sourceCode%> \u00B7 <%=sourceEmail%></span></li>
						<li><label class="zcs-font-14 zcs-font-normal zcs-lh-body">Source Details</label><span class="zcs-font-14 zcs-font-medium zcs-lh-body"><%=sourceMeta%></span></li>
					</ul>
				</div>
				<div class="zcs-flex zcs-gap-8 zcs-row" style="margin-top:16px;">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=requestUrl%>">
						<i class="zcs-button-icon zc-li-outline ui-1-edit-72"></i>
						<span class="zcs-button-text">Request Report</span>
					</a>
<%
		if(sourceUrl != "")
		{
			%>
<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=sourceUrl%>">
						<i class="zcs-button-icon zc-li-outline ui-1-email-85"></i>
						<span class="zcs-button-text">Source Record</span>
					</a>
<%
		}
		%>
</div>
				<p class="idc-note">For PDF output, choose Print or Save as PDF and use the browser print dialog. The page includes print CSS for a clean card-only output.</p>
			</aside>
		</div>
<%
	}
	%>
</div>
</div>
<script>
(function () {
	var patterns = ["212222","222122","222221","121223","121322","131222","122213","122312","132212","221213","221312","231212","112232","122132","122231","113222","123122","123221","223211","221132","221231","213212","223112","312131","311222","321122","321221","312212","322112","322211","212123","212321","232121","111323","131123","131321","112313","132113","132311","211313","231113","231311","112133","112331","132131","113123","113321","133121","313121","211331","231131","213113","213311","213131","311123","311321","331121","312113","312311","332111","314111","221411","431111","111224","111422","121124","121421","141122","141221","112214","112412","122114","122411","142112","142211","241211","221114","413111","241112","134111","111242","121142","121241","114212","124112","124211","411212","421112","421211","212141","214121","412121","111143","111341","131141","114113","114311","411113","411311","113141","114131","311141","411131","211412","211214","211232","2331112"];
	function cleanCode(value) {
		value = String(value || "");
		var result = "";
		for (var i = 0; i < value.length; i++) {
			var c = value.charCodeAt(i);
			if (c >= 32 && c <= 126) {
				result += value.charAt(i);
			}
		}
		return result;
	}
	function code128B(value) {
		value = cleanCode(value);
		if (!value) { return null; }
		var codes = [104];
		var checksum = 104;
		for (var i = 0; i < value.length; i++) {
			var code = value.charCodeAt(i) - 32;
			codes.push(code);
			checksum += code * (i + 1);
		}
		codes.push(checksum % 103);
		codes.push(106);
		return codes;
	}
	function draw(svg) {
		var data = code128B(svg.getAttribute("data-code"));
		if (!data) { return; }
		var module = 2;
		var height = 44;
		var x = 0;
		var rects = [];
		for (var i = 0; i < data.length; i++) {
			var pattern = patterns[data[i]];
			var bar = true;
			for (var j = 0; j < pattern.length; j++) {
				var width = parseInt(pattern.charAt(j), 10) * module;
				if (bar) {
					rects.push("<rect x='" + x + "'y='0'width='" + width + "'height='" + height + "'fill='#111827'></rect>");
				}
				x += width;
				bar = !bar;
			}
		}
		svg.setAttribute("viewBox", "0 0 " + x + "" + height);
		svg.setAttribute("preserveAspectRatio", "none");
		svg.innerHTML = rects.join("");
	}
	var nodes = document.querySelectorAll(".idc-barcode-svg[data-code]");
	for (var n = 0; n < nodes.length; n++) {
		draw(nodes[n]);
	}
}());
</script>