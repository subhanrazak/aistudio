<%
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAdmin = loginRole == "Administrator" || loginRole == "Admin";
	isHR = loginRole == "HR_ADMIN" || isAdmin;
	totalJobRequests = Job_Request.count();
	pendingCEORequests = Job_Request[Status == "Pending_CEO"].count();
	approvedRequests = Job_Request[Status == "Approved"].count();
	totalCandidates = Candidate.count();
	poolCandidates = Candidate[Is_In_Pool == true].count();
	activeApplications = Job_Application[Status == "Active" || Status == "On_Hold" || Status == "Selected" || Status == "Offer_Accepted"].count();
	selectedApplications = Job_Application[Status == "Selected" || Status == "Offer_Accepted"].count();
	feedbackCount = Interview_Feedback.count();
	%>
<style>
/* ===== zcs-global.css utility subset included once for Recruitment_Home ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-14 { gap: .875rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-36 { font-size: 2.25rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }
/* ZCS component CSS: header-heading-with-actions and buttons */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }
/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */
.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }
/* ZCS component CSS: quick-actions-icon-with-text */
.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }
/* Recruitment Home layout */
.rh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }
.rh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }
.rh-hero:after { content: ""; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }
.rh-hero:before { content: ""; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }
.rh-hero-content { position: relative; z-index: 1; }
.rh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }
.rh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.rh-kpi { grid-column: span 3; min-height: 118px; }
.rh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }
.rh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }
.rh-workspace { grid-column: span 9; overflow: hidden; }
.rh-actions { grid-column: span 3; }
.rh-tab-input { display: none; }
.rh-tabbar { overflow-x: auto; }
.rh-tabbar label { cursor: pointer; border-bottom: 2px solid transparent; }
.rh-panel { display: none; padding: 18px; }
#rh-tab-overview:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-overview'], #rh-tab-requests:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-requests'], #rh-tab-candidates:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-candidates'], #rh-tab-applications:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-applications'], #rh-tab-feedback:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-feedback'], #rh-tab-children:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-children'], #rh-tab-kanban:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-kanban'] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }
#rh-tab-overview:checked ~ .rh-panels .rh-panel-overview, #rh-tab-requests:checked ~ .rh-panels .rh-panel-requests, #rh-tab-candidates:checked ~ .rh-panels .rh-panel-candidates, #rh-tab-applications:checked ~ .rh-panels .rh-panel-applications, #rh-tab-feedback:checked ~ .rh-panels .rh-panel-feedback, #rh-tab-children:checked ~ .rh-panels .rh-panel-children, #rh-tab-kanban:checked ~ .rh-panels .rh-panel-kanban { display: block; }
.rh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); margin-bottom: 18px; }
.rh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }
.rh-report-frame { min-height: 620px; width: 100%; }
.rh-report-frame.tall { min-height: 700px; }
.rh-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.rh-tool-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FFFFFF; padding: 18px; }
.rh-tool-input { width: 100%; height: 40px; border: 1px solid var(--zcs-border-color); border-radius: 8px; box-sizing: border-box; padding: 0 12px; color: var(--zcs-primary-text-color); background: #FFFFFF; font: inherit; }
.rh-tool-input:focus { outline: 2px solid var(--zcs-theme-brand-color); outline-offset: 1px; }
.rh-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }
.rh-access-note { border: 1px solid #FAAE13; background: #FCF4E6; color: #7E5608; border-radius: 12px; }
@media (max-width: 1180px) { .rh-kpi { grid-column: span 6; } .rh-workspace, .rh-actions { grid-column: span 12; } }
@media (max-width: 700px) { .rh-page { padding: 14px; } .rh-hero { padding: 18px; } .rh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .rh-kpi { grid-column: span 12; } .rh-panel { padding: 12px; } .rh-mini-grid { grid-template-columns: 1fr; } .rh-report-frame { min-height: 520px; } }
</style>

<script>
function rhOpenParamPage(pageName, paramName, inputId) {
	var inputEl = document.getElementById(inputId);
	var value = inputEl ? inputEl.value : "";
	if (value && value.trim() !== "") {
		window.location.hash = "#Page:" + pageName + "?" + paramName + "=" + encodeURIComponent(value.trim());
	}
	else {
		window.location.hash = "#Page:" + pageName;
	}
	return false;
}
</script>

<div class="rh-page zcs-flex zcs-direction-column zcs-gap-18">
	<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border">
		<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
			<h5 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Recruitment Home</h5>
			<span class="zcs-font-14 zcs-color-secondary">Recruitment workspace for requests, candidates, applications, feedback, child rows, conversion, and Kanban views</span>
		</div>
		<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row">
			<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Job_Request?zc_LoadIn=dialog">
				<i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
				<span class="zcs-button-text">Raise Job Request</span>
			</a>
			<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Candidate?zc_LoadIn=dialog">
				<i class="zcs-button-icon zc-li-outline users-add-29"></i>
				<span class="zcs-button-text">Add Candidate</span>
			</a>
		</div>
	</div>

	<section class="rh-hero">
		<div class="rh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18">
			<div class="zcs-flex zcs-direction-column zcs-gap-8">
				<span class="zcs-font-13 zcs-font-semibold">IITB HR Recruitment</span>
				<h3 class="zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0">Track hiring from request approval to employee conversion</h3>
				<span class="zcs-font-15">Use the tabs below to review open requests, candidate lists, active applications, feedback history, child-row evidence, and status boards.</span>
			</div>
			<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-no-shrink" href="#Report:Active_Job_Applications">
				<i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i>
				<span class="zcs-button-text">Open Pipeline</span>
			</a>
		</div>
	</section>

	<section class="rh-grid">
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-single-copy-04 zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Requests</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=totalJobRequests%></div>
			<span class="zcs-font-13 zcs-color-secondary"><%=pendingCEORequests%> pending CEO review, <%=approvedRequests%> approved</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-mm zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Candidates</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=totalCandidates%></div>
			<span class="zcs-font-13 zcs-color-secondary"><%=poolCandidates%> currently in talent pool</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-briefcase-24 zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Applications</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=activeApplications%></div>
			<span class="zcs-font-13 zcs-color-secondary"><%=selectedApplications%> selected or offer accepted</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-edit-72 zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Feedback</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=feedbackCount%></div>
			<span class="zcs-font-13 zcs-color-secondary">Interview feedback rows recorded</span>
		</article>

		<section class="rh-workspace zcs-card zcs-box-border">
			<div class="rh-tabs-shell">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-overview" checked>
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-requests">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-candidates">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-applications">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-feedback">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-children">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-kanban">

				<div class="zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full">
					<ul class="zcs-horizontal-tabhead rh-tabbar zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border">
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-overview" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-dashboard-level"></i><span class="zcs-horizontal-tabtext zcs-font-15">Overview</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-requests" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline files-single-copy-04"></i><span class="zcs-horizontal-tabtext zcs-font-15">Requests</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-candidates" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline users-mm"></i><span class="zcs-horizontal-tabtext zcs-font-15">Candidates</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-applications" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-briefcase-24"></i><span class="zcs-horizontal-tabtext zcs-font-15">Applications</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-feedback" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-edit-72"></i><span class="zcs-horizontal-tabtext zcs-font-15">Feedback</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-children" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline files-2-doc"></i><span class="zcs-horizontal-tabtext zcs-font-15">Child Rows</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-kanban" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-app"></i><span class="zcs-horizontal-tabtext zcs-font-15">Kanban and Tools</span></label></li>
					</ul>
				</div>

				<div class="rh-panels">
					<div class="rh-panel rh-panel-overview">
						<div class="rh-mini-grid">
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline files-single-copy-04 zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Request queue</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Review all job requests and the CEO approval queue, then configure interview rounds after approval.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Job_Request_List">Job Requests</a><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Pending_CEO_Job_Requests">Pending CEO</a></div>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline users-mm zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Candidate pool</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Browse candidate records, pool status, source Kanban, and candidate 360-degree detail pages.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Candidate_List">Candidates</a><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Candidate_Pool">Pool</a></div>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline business-briefcase-24 zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Applications and conversion</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Use active applications for lifecycle actions, feedback links, pool moves, hold/resume, and conversion to employee.</p>
								<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Active_Job_Applications">Active Applications</a>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline ui-1-edit-72 zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Feedback and evidence</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Review feedback recommendations, interview-round rows, and offer-document rows from one workspace.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Interview_Feedback_List">Feedback</a><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Application_Offer_Document_List">Offer Docs</a></div>
							</div>
						</div>
					</div>

					<div class="rh-panel rh-panel-requests">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Job Request List</h4><span class="zcs-font-13 zcs-color-secondary">All hiring requests and HR request tracking.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="Job_Request_List" zc-height="700px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Pending CEO Job Requests</h4><span class="zcs-font-13 zcs-color-secondary">CEO queue with Approval_Remarks actions.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Pending_CEO_Job_Requests" zc-height="620px"></div></div>
					</div>

					<div class="rh-panel rh-panel-candidates">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Candidate List</h4><span class="zcs-font-13 zcs-color-secondary">All candidate profiles and source metadata.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="Candidate_List" zc-height="700px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Candidate Pool</h4><span class="zcs-font-13 zcs-color-secondary">Reusable candidate pool with assignment actions.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Candidate_Pool" zc-height="620px"></div></div>
					</div>

					<div class="rh-panel rh-panel-applications">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Active Job Applications</h4><span class="zcs-font-13 zcs-color-secondary">Application lifecycle actions include feedback, hold/resume, pool moves, and conversion.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="Active_Job_Applications" zc-height="700px"></div></div>
					</div>

					<div class="rh-panel rh-panel-feedback">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Interview Feedback List</h4><span class="zcs-font-13 zcs-color-secondary">Feedback, recommendation, panel member, and round history.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="Interview_Feedback_List" zc-height="700px"></div></div>
					</div>

					<div class="rh-panel rh-panel-children">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Interview Round Config Rows</h4><span class="zcs-font-13 zcs-color-secondary">Child rows linked to approved job requests.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Interview_Round_Config_List" zc-height="620px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Application Offer Document Rows</h4><span class="zcs-font-13 zcs-color-secondary">Child rows linked to job applications and offer acceptance document collection.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Application_Offer_Document_List" zc-height="620px"></div></div>
					</div>

					<div class="rh-panel rh-panel-kanban">
						<div class="rh-mini-grid zcs-mb-8">
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-10">
								<h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Candidate Detail launcher</h4>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Enter a Candidate record ID to open Candidate_Detail with its required candidate_id parameter.</p>
								<input class="rh-tool-input" type="number" id="rh-candidate-id" placeholder="Candidate ID">
								<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Page:Candidate_Detail" onclick="return rhOpenParamPage('Candidate_Detail','candidate_id','rh-candidate-id');"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open Candidate Detail</span></a>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-10">
								<h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Convert to Employee launcher</h4>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Enter a Job_Application record ID to open Convert_To_Employee with its required job_application_id parameter.</p>
								<input class="rh-tool-input" type="number" id="rh-application-id" placeholder="Job Application ID">
								<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Page:Convert_To_Employee" onclick="return rhOpenParamPage('Convert_To_Employee','job_application_id','rh-application-id');"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open Conversion Page</span></a>
							</div>
						</div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Job Request Kanban</h4></div><div class="rh-report-frame" zc-component="report" zc-linkname="Job_Request_Kanban" zc-height="620px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Candidate Source Kanban</h4></div><div class="rh-report-frame" zc-component="report" zc-linkname="Candidate_Source_Kanban" zc-height="620px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Job Application Kanban</h4></div><div class="rh-report-frame" zc-component="report" zc-linkname="Job_Application_Kanban" zc-height="620px"></div></div>
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Interview Recommendation Kanban</h4></div><div class="rh-report-frame" zc-component="report" zc-linkname="Interview_Recommendation_Kanban" zc-height="620px"></div></div>
					</div>
				</div>
			</div>
		</section>

		<aside class="rh-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
			<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quick actions</h5>
			<ul class="zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0">
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Job_Request?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-quick-action-text">Raise job request</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Candidate?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline users-add-29"></i><span class="zcs-quick-action-text">Add candidate</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Job_Application?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline business-briefcase-24"></i><span class="zcs-quick-action-text">Create application</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Interview_Feedback?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-edit-72"></i><span class="zcs-quick-action-text">Add feedback</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Job_Request_Kanban"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline design-app"></i><span class="zcs-quick-action-text">Open request Kanban</span></a></li>
			</ul>
			<div class="rh-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6">
				<span class="zcs-font-13 zcs-font-semibold zcs-color-primary">Conversion flow</span>
				<span class="zcs-font-13 zcs-color-secondary">Use Active_Job_Applications actions for the primary conversion path. The Kanban and Tools tab also provides direct parameter launchers for Candidate_Detail and Convert_To_Employee.</span>
			</div>
<%
	if(!isHR)
	{
		%>
<div class="rh-access-note zcs-p-14 zcs-font-13">Some HR-only records and conversion actions may be restricted by profile permissions.</div>
<%
	}
	%>
</aside>
	</section>
</div>