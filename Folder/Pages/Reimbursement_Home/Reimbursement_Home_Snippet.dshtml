<%
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAdmin = loginRole == "Administrator" || loginRole == "Admin";
	isHR = loginRole == "HR_ADMIN" || loginRole == "HR" || isAdmin;
	isFinance = loginRole == "FINANCE_ADMIN" || loginRole == "Finance" || isAdmin;
	myReimbursementCount = Reimbursement_Request[Employee.Official_Email == zoho.loginuser || Employee.Official_Email == zoho.loginuserid].count();
	totalReimbursements = Reimbursement_Request.count();
	draftCount = Reimbursement_Request[Status == "Draft"].count();
	pendingHRCount = Reimbursement_Request[Status == "Pending_HR"].count();
	pendingFinanceCount = Reimbursement_Request[Status == "Pending_Finance"].count();
	processedCount = Reimbursement_Request[Status == "Processed"].count();
	healthInsuranceCount = Reimbursement_Request[Category == "Health_Insurance"].count();
	lineItemCount = Reimbursement_Line_Items.count();
	totalClaimed = 0;
	totalProcessed = 0;
	for each  reimbursementRec in Reimbursement_Request[ID != 0]
	{
		totalClaimed = totalClaimed + ifnull(reimbursementRec.Amount_Claimed,0);
		if(reimbursementRec.Status == "Processed")
		{
			totalProcessed = totalProcessed + ifnull(reimbursementRec.Amount_Claimed,0);
		}
	}
	%>
<style>
/* ===== zcs-global utility stylesheet included once for Reimbursement_Home ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-14 { gap: .875rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mt-16 { margin-top: 1rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mb-12 { margin-bottom: .75rem; } .zcs-mb-16 { margin-bottom: 1rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-rounded-half { border-radius: 50%; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-36 { font-size: 2.25rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; } .zcs-color-red { color: #FE455D; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }
/* ZCS component CSS: header-heading-with-actions and button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }
/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */
.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }
/* ZCS component CSS: quick-actions-card-type-quick-actions and badge-filled-badge */
.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
/* Reimbursement Home layout */
.rh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }
.rh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #0F766E); }
.rh-hero:after { content: ""; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }
.rh-hero:before { content: ""; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }
.rh-hero-content { position: relative; z-index: 1; }
.rh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }
.rh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.rh-kpi { grid-column: span 3; min-height: 118px; }
.rh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }
.rh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }
.rh-workspace { grid-column: span 9; overflow: hidden; }
.rh-actions { grid-column: span 3; }
.rh-tab-input { display: none; }
.rh-tabbar { overflow-x: auto; }
.rh-tabbar label { cursor: pointer; border-bottom: 2px solid transparent; }
.rh-panel { display: none; padding: 18px; }
#rh-tab-overview:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-overview'], #rh-tab-new:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-new'], #rh-tab-my:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-my'], #rh-tab-lines:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-lines'], #rh-tab-hr:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-hr'], #rh-tab-finance:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-finance'], #rh-tab-kanban:checked ~ .zcs-horizontal-tabpanel label[for='rh-tab-kanban'] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }
#rh-tab-overview:checked ~ .rh-panels .rh-panel-overview, #rh-tab-new:checked ~ .rh-panels .rh-panel-new, #rh-tab-my:checked ~ .rh-panels .rh-panel-my, #rh-tab-lines:checked ~ .rh-panels .rh-panel-lines, #rh-tab-hr:checked ~ .rh-panels .rh-panel-hr, #rh-tab-finance:checked ~ .rh-panels .rh-panel-finance, #rh-tab-kanban:checked ~ .rh-panels .rh-panel-kanban { display: block; }
.rh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); margin-bottom: 18px; }
.rh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }
.rh-report-frame { min-height: 640px; width: 100%; }
.rh-report-frame.tall { min-height: 720px; }
.rh-form-frame { min-height: 760px; width: 100%; }
.rh-mini-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.rh-tool-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FFFFFF; padding: 18px; }
.rh-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }
.rh-access-note { border: 1px solid #FAAE13; background: #FCF4E6; color: #7E5608; border-radius: 12px; }
.rh-status-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.rh-status-item { background: #FFFFFF; border: 1px solid var(--zcs-border-color); border-radius: 12px; padding: 14px; }
@media (max-width: 1180px) { .rh-kpi { grid-column: span 6; } .rh-workspace, .rh-actions { grid-column: span 12; } }
@media (max-width: 760px) { .rh-page { padding: 14px; } .rh-hero { padding: 18px; } .rh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .rh-kpi { grid-column: span 12; } .rh-panel { padding: 12px; } .rh-mini-grid, .rh-status-strip { grid-template-columns: 1fr; } .rh-report-frame { min-height: 540px; } }
</style>

<div class="rh-page zcs-flex zcs-direction-column zcs-gap-18">
	<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border">
		<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
			<h5 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Reimbursement Home</h5>
			<span class="zcs-font-14 zcs-color-secondary">Workspace for employee reimbursement submission, line item bills, HR review, finance processing, and status tracking</span>
		</div>
		<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row">
			<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Form:Reimbursement_Request?zc_LoadIn=dialog">
				<i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
				<span class="zcs-button-text">Create Reimbursement</span>
			</a>
			<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:My_Reimbursements">
				<i class="zcs-button-icon zc-li-outline business-money-coins"></i>
				<span class="zcs-button-text">My Reimbursements</span>
			</a>
		</div>
	</div>

	<section class="rh-hero">
		<div class="rh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-18">
			<div class="zcs-flex zcs-direction-column zcs-gap-8">
				<span class="zcs-font-13 zcs-font-semibold">IITB HR Reimbursements</span>
				<h3 class="zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0">Submit expenses, attach bills, route HR checks, and complete finance processing</h3>
				<span class="zcs-font-15">Use the tabs below to start the Reimbursement_Request create flow, review request queues, inspect reimbursement line items, and monitor the Kanban board.</span>
			</div>
			<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-no-shrink" href="#Report:Finance_Reimbursement_Queue">
				<i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i>
				<span class="zcs-button-text">Open Finance Queue</span>
			</a>
		</div>
	</section>

	<section class="rh-grid">
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-money-coins zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">My Claims</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=myReimbursementCount%></div>
			<span class="zcs-font-13 zcs-color-secondary">Logged-in employee reimbursements</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-time zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Review Queue</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=pendingHRCount + pendingFinanceCount%></div>
			<span class="zcs-font-13 zcs-color-secondary"><%=pendingHRCount%> HR, <%=pendingFinanceCount%> finance</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Line Items</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=lineItemCount%></div>
			<span class="zcs-font-13 zcs-color-secondary">Expense bill rows linked to requests</span>
		</article>
		<article class="rh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-14">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
				<div class="rh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-22"></i></div>
				<span class="zcs-font-12 zcs-color-secondary">Processed</span>
			</div>
			<div class="rh-kpi-value zcs-color-primary"><%=processedCount%></div>
			<span class="zcs-font-13 zcs-color-secondary">INR <%=totalProcessed%> processed from INR <%=totalClaimed%> claimed</span>
		</article>

		<section class="rh-workspace zcs-card zcs-box-border">
			<div class="rh-tabs-shell">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-overview" checked>
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-new">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-my">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-lines">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-hr">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-finance">
				<input class="rh-tab-input" type="radio" name="rh-tabs" id="rh-tab-kanban">

				<div class="zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full">
					<ul class="zcs-horizontal-tabhead rh-tabbar zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border">
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-overview" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-dashboard-level"></i><span class="zcs-horizontal-tabtext zcs-font-15">Overview</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-new" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-horizontal-tabtext zcs-font-15">New Request</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-my" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-money-coins"></i><span class="zcs-horizontal-tabtext zcs-font-15">My Reimbursements</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-lines" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline files-2-doc"></i><span class="zcs-horizontal-tabtext zcs-font-15">Line Items</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-hr" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline users-single-05"></i><span class="zcs-horizontal-tabtext zcs-font-15">HR Queue</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-finance" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline business-bank"></i><span class="zcs-horizontal-tabtext zcs-font-15">Finance Queue</span></label></li>
						<li class="zcs-horizontal-tabitem"><label for="rh-tab-kanban" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zcs-font-medium zc-li-outline design-app"></i><span class="zcs-horizontal-tabtext zcs-font-15">Kanban</span></label></li>
					</ul>
				</div>

				<div class="rh-panels">
					<div class="rh-panel rh-panel-overview">
						<div class="rh-status-strip zcs-mb-16">
							<div class="rh-status-item"><span class="zcs-font-12 zcs-color-secondary">All reimbursements</span><div class="zcs-font-24 zcs-font-bold zcs-color-primary"><%=totalReimbursements%></div></div>
							<div class="rh-status-item"><span class="zcs-font-12 zcs-color-secondary">Draft requests</span><div class="zcs-font-24 zcs-font-bold zcs-color-orange"><%=draftCount%></div></div>
							<div class="rh-status-item"><span class="zcs-font-12 zcs-color-secondary">Health insurance cases</span><div class="zcs-font-24 zcs-font-bold zcs-color-blue"><%=healthInsuranceCount%></div></div>
							<div class="rh-status-item"><span class="zcs-font-12 zcs-color-secondary">Total claimed</span><div class="zcs-font-20 zcs-font-bold zcs-color-primary">INR <%=totalClaimed%></div></div>
						</div>
						<div class="rh-mini-grid">
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline ui-1-simple-add zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Employee create flow</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Employees create a Reimbursement_Request, provide reimbursement type, amount, expense date, description, and supporting bills. Line item rows can be reviewed from the Line Items tab.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Form:Reimbursement_Request?zc_LoadIn=dialog">Create Request</a><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:My_Reimbursements">My Reimbursements</a></div>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline users-single-05 zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">HR review flow</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">HR works Pending_HR records and health insurance reimbursements, validates within-limit status and insurance subtype, and sends approved claims onward for finance processing.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:HR_Reimbursement_Queue">Open HR Queue</a></div>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline business-bank zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Finance processing flow</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Finance reviews Pending_Finance and Processed reimbursements, records the processed date, and uses the report filters to separate active processing from completed payouts.</p>
								<div class="zcs-flex zcs-gap-10 zcs-row"><a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Finance_Reimbursement_Queue">Open Finance Queue</a></div>
							</div>
							<div class="rh-tool-card zcs-flex zcs-direction-column zcs-gap-12">
								<div class="zcs-flex zcs-align-items-center zcs-gap-10"><i class="zc-li-outline design-app zcs-font-22 zcs-color-theme"></i><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Status monitoring</h4></div>
								<p class="zcs-font-14 zcs-color-secondary zcs-m-0">Reimbursement_Status_Kanban shows the pipeline across draft, HR, manager, finance, processed, and rejected states for quick triage.</p>
								<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-font-14" href="#Report:Reimbursement_Status_Kanban"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open Kanban</span></a>
							</div>
						</div>
					</div>

					<div class="rh-panel rh-panel-new">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Reimbursement Request Create Flow</h4><span class="zcs-font-13 zcs-color-secondary">Inline Reimbursement_Request form for employees. Use the dialog button when a larger popup workflow is preferred.</span></div><div class="rh-form-frame" zc-component="form" zc-linkname="Reimbursement_Request" zc-height="760px"></div></div>
					</div>

					<div class="rh-panel rh-panel-my">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">My Reimbursements</h4><span class="zcs-font-13 zcs-color-secondary">Employee-facing reimbursement history, status, expense date, amount claimed, and processed date.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="My_Reimbursements" zc-height="720px"></div></div>
					</div>

					<div class="rh-panel rh-panel-lines">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Reimbursement Line Items List</h4><span class="zcs-font-13 zcs-color-secondary">Expense type, expense date, amount, uploaded bill, and notes for child line item rows.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Reimbursement_Line_Items_List" zc-height="640px"></div></div>
					</div>

					<div class="rh-panel rh-panel-hr">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">HR Reimbursement Queue</h4><span class="zcs-font-13 zcs-color-secondary">Pending HR and health insurance reimbursement review queue.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="HR_Reimbursement_Queue" zc-height="720px"></div></div>
<%
	if(!isHR)
	{
		%>
<div class="rh-access-note zcs-p-14 zcs-font-13">HR queue visibility depends on the logged-in user's profile permissions.</div>
<%
	}
	%>
</div>

					<div class="rh-panel rh-panel-finance">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Finance Reimbursement Queue</h4><span class="zcs-font-13 zcs-color-secondary">Pending finance and processed reimbursement records with processed date filters.</span></div><div class="rh-report-frame tall" zc-component="report" zc-linkname="Finance_Reimbursement_Queue" zc-height="720px"></div></div>
<%
	if(!isFinance)
	{
		%>
<div class="rh-access-note zcs-p-14 zcs-font-13">Finance queue visibility depends on the logged-in user's profile permissions.</div>
<%
	}
	%>
</div>

					<div class="rh-panel rh-panel-kanban">
						<div class="rh-embed-card"><div class="rh-embed-header zcs-px-20 zcs-py-12"><h4 class="zcs-font-18 zcs-font-semibold zcs-m-0">Reimbursement Status Kanban</h4><span class="zcs-font-13 zcs-color-secondary">Status board for reimbursement triage across employee, HR, and finance stages.</span></div><div class="rh-report-frame" zc-component="report" zc-linkname="Reimbursement_Status_Kanban" zc-height="640px"></div></div>
					</div>
				</div>
			</div>
		</section>

		<aside class="rh-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
			<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quick actions</h5>
			<ul class="zcs-flex zcs-direction-column zcs-gap-16 zcs-p-0 zcs-m-0">
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Form:Reimbursement_Request?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-quick-action-text">Create reimbursement request</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:My_Reimbursements"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline business-money-coins"></i><span class="zcs-quick-action-text">Open my reimbursements</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Reimbursement_Line_Items_List"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc"></i><span class="zcs-quick-action-text">Review line items</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:HR_Reimbursement_Queue"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline users-single-05"></i><span class="zcs-quick-action-text">Open HR queue</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Finance_Reimbursement_Queue"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline business-bank"></i><span class="zcs-quick-action-text">Open finance queue</span></a></li>
				<li class="zcs-quick-action-item"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary" href="#Report:Reimbursement_Status_Kanban"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline design-app"></i><span class="zcs-quick-action-text">Open status Kanban</span></a></li>
			</ul>
			<div class="rh-note zcs-p-14 zcs-flex zcs-direction-column zcs-gap-6">
				<span class="zcs-font-13 zcs-font-semibold zcs-color-primary">Current pipeline</span>
				<span class="zcs-font-13 zcs-color-secondary"><%=pendingHRCount%> HR reviews and <%=pendingFinanceCount%> finance reviews are waiting. <%=processedCount%> reimbursements are processed.</span>
			</div>
			<div class="zcs-row zcs-align-items-center zcs-gap-8">
				<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">HR <%=pendingHRCount%></span></div>
				<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Finance <%=pendingFinanceCount%></span></div>
				<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Processed <%=processedCount%></span></div>
			</div>
		</aside>
	</section>
</div>