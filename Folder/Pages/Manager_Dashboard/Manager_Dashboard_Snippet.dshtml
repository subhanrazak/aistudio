<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAllowed = loginRole == "MANAGER" || loginRole == "HR_ADMIN" || loginRole == "CEO" || loginRole == "Administrator" || loginRole == "Admin";
	todayDate = zoho.currentdate;
	todayDisplay = todayDate.toString("dd-MMM-yyyy");
	managerRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	hasManagerRecord = managerRows.count() > 0;
	managerName = ifnull(zoho.loginuser,"Manager");
	managerEmail = loginEmail;
	managerDepartment = "-";
	managerInitial = "M";
	teamScope = "Direct reports";
	if(hasManagerRecord == true)
	{
		managerEmp = managerRows;
		managerName = ifnull(managerEmp.Full_Name,managerName);
		managerEmail = ifnull(managerEmp.Official_Email,loginEmail);
		managerDepartment = ifnull(managerEmp.Department.Department_Name,"-");
		if(managerName != null && managerName != "")
		{
			managerInitial = managerName.left(1).toUpperCase();
		}
		teamRows = Employee_Master[Primary_Manager == managerEmp.ID || Secondary_Manager == managerEmp.ID && Employment_Status == "Active" || Employment_Status == "Probation"] sort by Full_Name asc;
		if(loginRole == "HR_ADMIN" || loginRole == "CEO" || loginRole == "Administrator" || loginRole == "Admin" && teamRows.count() == 0)
		{
			teamRows = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"] sort by Full_Name asc;
			teamScope = "Organisation view";
		}
	}
	else
	{
		teamRows = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"] sort by Full_Name asc;
		teamScope = "Organisation view";
	}
	teamCount = teamRows.count();
	leavePendingCount = 0;
	regularisationPendingCount = 0;
	travelPendingCount = 0;
	reimbursementPendingCount = 0;
	giftPendingCount = 0;
	totalPendingApprovals = 0;
	presentCount = 0;
	wfhCount = 0;
	leaveTodayCount = 0;
	absentCount = 0;
	halfDayCount = 0;
	notMarkedCount = 0;
	noLogCount = 0;
	activeApprovedLeaveCount = 0;
	announcementCount = 0;
	ackDoneCount = 0;
	ackPendingCount = 0;
	appraisalDraftCount = 0;
	appraisalSubmittedCount = 0;
	appraisalManagerReviewedCount = 0;
	appraisalHrApprovedCount = 0;
	trainingRequestCount = 0;
	highUrgencyTrainingCount = 0;
	for each  teamEmpSeed in teamRows
	{
		leavePendingCount = leavePendingCount + Time_Off_Request[Employee == teamEmpSeed.ID && Status == "Pending_Manager" || Status == "Pending_HR"].count();
		regularisationPendingCount = regularisationPendingCount + Regularisation_Request[Employee == teamEmpSeed.ID && Status == "Pending_Manager" || Status == "Pending_HR"].count();
		travelPendingCount = travelPendingCount + Travel_Request[Employee == teamEmpSeed.ID && Status == "Pending_Manager" || Status == "Pending_CEO" || Status == "Pending_HR"].count();
		reimbursementPendingCount = reimbursementPendingCount + Reimbursement_Request[Employee == teamEmpSeed.ID && Status == "Pending_Manager" || Status == "Pending_HR" || Status == "Pending_Finance"].count();
		giftPendingCount = giftPendingCount + Gift_Registration[Employee == teamEmpSeed.ID && Status == "Pending_Manager" || Status == "Pending_HR" || Status == "Pending_Finance"].count();
		attendanceTodayRows = Attendance_Log[Employee == teamEmpSeed.ID && Attendance_Date == todayDate];
		if(attendanceTodayRows.count() == 0)
		{
			noLogCount = noLogCount + 1;
		}
		else
		{
			attendanceToday = attendanceTodayRows;
			todayStatus = ifnull(attendanceToday.Attendance_Status,"Not_Marked");
			if(todayStatus == "Present")
			{
				presentCount = presentCount + 1;
			}
			else if(todayStatus == "WFH" || todayStatus == "On_Duty")
			{
				wfhCount = wfhCount + 1;
			}
			else if(todayStatus == "Leave")
			{
				leaveTodayCount = leaveTodayCount + 1;
			}
			else if(todayStatus == "Absent")
			{
				absentCount = absentCount + 1;
			}
			else if(todayStatus == "Half_Day")
			{
				halfDayCount = halfDayCount + 1;
			}
			else
			{
				notMarkedCount = notMarkedCount + 1;
			}
		}
		activeApprovedLeaveCount = activeApprovedLeaveCount + Time_Off_Request[Employee == teamEmpSeed.ID && Status == "Approved" && To_Date >= todayDate].count();
		appraisalRows = Appraisal_Form[Employee == teamEmpSeed.ID];
		for each  appraisalSeed in appraisalRows
		{
			appraisalStatus = ifnull(appraisalSeed.Status,"Draft");
			if(appraisalStatus == "Draft")
			{
				appraisalDraftCount = appraisalDraftCount + 1;
			}
			else if(appraisalStatus == "Submitted")
			{
				appraisalSubmittedCount = appraisalSubmittedCount + 1;
			}
			else if(appraisalStatus == "Manager_Reviewed")
			{
				appraisalManagerReviewedCount = appraisalManagerReviewedCount + 1;
			}
			else if(appraisalStatus == "HR_Approved")
			{
				appraisalHrApprovedCount = appraisalHrApprovedCount + 1;
			}
		}
	}
	totalPendingApprovals = leavePendingCount + regularisationPendingCount + travelPendingCount + reimbursementPendingCount + giftPendingCount;
	if(loginRole == "HR_ADMIN" || loginRole == "CEO" || loginRole == "Administrator" || loginRole == "Admin")
	{
		trainingRows = Training_Request[ID != 0] sort by Urgency asc;
	}
	else
	{
		trainingRows = Training_Request[Raised_By == loginEmail || Raised_By == zoho.loginuser] sort by Urgency asc;
	}
	trainingRequestCount = trainingRows.count();
	for each  trainingSeed in trainingRows
	{
		if(ifnull(trainingSeed.Urgency,"") == "High")
		{
			highUrgencyTrainingCount = highUrgencyTrainingCount + 1;
		}
	}
	announcementRows = Announcement[Created_By == loginEmail || Created_By == zoho.loginuser] sort by Published_Date desc;
	announcementCount = announcementRows.count();
	for each  annSeed in announcementRows
	{
		annAckRows = Announcement_Acknowledgement[Announcement == annSeed.ID];
		for each  annAckSeed in annAckRows
		{
			if(annAckSeed.Acknowledged == true)
			{
				ackDoneCount = ackDoneCount + 1;
			}
			else
			{
				ackPendingCount = ackPendingCount + 1;
			}
		}
	}
	presentPct = 0;
	if(teamCount > 0)
	{
		presentPct = ((presentCount + wfhCount + halfDayCount) * 100) / teamCount;
		if(presentPct > 100)
		{
			presentPct = 100;
		}
	}
	%>
<style>
/* zcs-global utility subset included once for Manager_Dashboard */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-page-bg-color: #F3F3F4; --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-sticky { position: sticky; }
.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-6 { padding-left: .375rem; padding-right: .375rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-0 { padding-top: 0; padding-bottom: 0; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-cursor-pointer { cursor: pointer; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, #2A6FFC); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
/* ZCS component CSS: button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-button-icon { width: 16px; max-height: 16px; }
/* ZCS component CSS: table-simple-table */
:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }
/* ZCS component CSS: horizontal-tab-horizontal-tab-with-count */
.zcs-horizontal-tabhead { box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 1px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabcount { min-width: 20px; background-color: var(--zcs-page-bg-color); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs_brand_color, #2A6FFC); } .zcs-horizontal-tabitem:hover .zcs-horizontal-tabcount, .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tabcount { background-color: var(--zcs_component_hover_color, #E8EFFF); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs_brand_color, #2A6FFC); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs_brand_color, #2A6FFC); }
/* Manager dashboard */
.md-page { min-height: 100%; background: var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: inherit; }
.md-header { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); }
.md-header:after { content: ""; position: absolute; width: 330px; height: 330px; right: -92px; top: -150px; border-radius: 50%; border: 42px solid rgba(255,255,255,.13); }
.md-header .zcs-color-primary, .md-header .zcs-color-secondary, .md-header .zcs-color-tertiary { color: var(--zcs_brand_foreground_color, #FFFFFF); }
.md-header-inner { position: relative; z-index: 1; }
.md-avatar { width: 58px; height: 58px; border-radius: 16px; background: rgba(255,255,255,.18); color: var(--zcs_brand_foreground_color, #FFFFFF); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; }
.md-grid { display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: 16px; padding: 18px 0 0; }
.md-kpi { grid-column: span 3; min-height: 148px; position: relative; overflow: hidden; box-shadow: 0 8px 22px rgba(15,23,42,.06); }
.md-kpi:after { content: ""; position: absolute; width: 90px; height: 90px; right: -28px; bottom: -32px; border-radius: 50%; background: var(--zcs_brand_light_color, #E8EFFF); opacity: .75; }
.md-kpi-icon { width: 42px; height: 42px; border-radius: 12px; color: var(--zcs_brand_color, #2A6FFC); background: var(--zcs_brand_light_color, #E8EFFF); }
.md-kpi-value { font-size: 31px; font-weight: 700; line-height: 1; }
.md-section { grid-column: span 6; box-shadow: 0 8px 22px rgba(15,23,42,.06); overflow: hidden; }
.md-section-wide { grid-column: span 12; }
.md-section-header { border-bottom: 1px solid var(--zcs-border-color); }
.md-progress { height: 8px; background: #EDF1F7; border-radius: 999px; overflow: hidden; }
.md-progress span { height: 100%; display: block; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }
.md-empty { border: 1px dashed var(--zcs-border-color); background: #FFFFFF; border-radius: 12px; padding: 20px; text-align: center; }
.md-denied { max-width: 760px; margin: 0 auto; padding: 36px 20px; }
.md-report-band { margin-top: 18px; }
@media (max-width: 1200px) { .md-kpi { grid-column: span 6; } .md-section { grid-column: span 12; } }
@media (max-width: 700px) { .md-header { border-radius: 0 0 16px 16px; } .md-header-inner { flex-direction: column; align-items: flex-start; } .md-kpi { grid-column: span 12; } .md-page { padding-left: 12px; padding-right: 12px; } }
</style>
<%
	if(isAllowed == false)
	{
		%>
<div class="md-page md-denied">
	<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-20 zcs-box-border'>
		<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
			<i class='zc-li-outline ui-3-alert zcs-font-28 zcs-color-theme'></i>
			<h5 class='zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Manager dashboard access is restricted.</h5>
		</div>
		<p class='zcs-font-14 zcs-color-secondary zcs-m-0'>This page is intended for MANAGER, HR_ADMIN, CEO, and Administrator profiles.</p>
	</div>
</div>
<%
	}
	else
	{
		%>
<div class="md-page zcs-px-20 zcs-py-16 zcs-box-border">
	<div class="md-header zcs-px-30 zcs-py-24 zcs-box-border">
		<div class="md-header-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
			<div class="zcs-flex zcs-align-items-center zcs-gap-16 zcs-ellipsis">
				<div class="md-avatar zcs-no-shrink"><%=managerInitial%></div>
				<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
					<h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Manager Dashboard</h4>
					<div class="zcs-font-14 zcs-color-secondary zcs-ellipsis">Hello <%=managerName%> | <%=managerDepartment%> | <%=todayDisplay%></div>
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-8">
				<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'>
					<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=teamScope%></span>
				</div>
				<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' href='#Report:Team_Attendance?zc_LoadIn=dialog'>
					<i class='zcs-button-icon zc-li-outline ui-2-time'></i>
					<span class='zcs-button-text'>Team Attendance</span>
				</a>
			</div>
		</div>
	</div>

	<div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-w-full zcs-card md-report-band'>
		<ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
			<li class='zcs-horizontal-tabitem zcs-horizontal-tabactive'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:Pending_Time_Off_Requests_Manager?zc_LoadIn=dialog'><span class='zcs-horizontal-tabtext zcs-font-15'>Leave</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=leavePendingCount%></span></a></li>
			<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:Pending_Regularisation_Manager?zc_LoadIn=dialog'><span class='zcs-horizontal-tabtext zcs-font-15'>Regularisation</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=regularisationPendingCount%></span></a></li>
			<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:HR_All_Travel?zc_LoadIn=dialog'><span class='zcs-horizontal-tabtext zcs-font-15'>Travel</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=travelPendingCount%></span></a></li>
			<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:HR_Reimbursement_Queue?zc_LoadIn=dialog'><span class='zcs-horizontal-tabtext zcs-font-15'>Reimbursement</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=reimbursementPendingCount%></span></a></li>
			<li class='zcs-horizontal-tabitem'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary' href='#Report:HR_Gift_Registry?zc_LoadIn=dialog'><span class='zcs-horizontal-tabtext zcs-font-15'>Gifts</span><span class='zcs-horizontal-tabcount zcs-rounded-sm zcs-px-6 zcs-py-2 zcs-box-border zcs-font-12 zcs-text-center'><%=giftPendingCount%></span></a></li>
		</ul>
	</div>

	<div class="md-grid">
		<div class="md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12"><div class="md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert zcs-font-22"></i></div><div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><span class='zcs-badge-text zcs-font-12'>Open</span></div></div>
			<div class="md-kpi-value zcs-color-primary"><%=totalPendingApprovals%></div>
			<div class="zcs-font-14 zcs-color-secondary">Team approval items across leave, regularisation, travel, reimbursements, and gifts</div>
		</div>
		<div class="md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12"><div class="md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-wm zcs-font-22"></i></div><span class="zcs-font-13 zcs-color-tertiary"><%=teamScope%></span></div>
			<div class="md-kpi-value zcs-color-primary"><%=teamCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Employees in current dashboard scope</div>
		</div>
		<div class="md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12"><div class="md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-22"></i></div><span class="zcs-font-13 zcs-color-tertiary">Today</span></div>
			<div class="md-kpi-value zcs-color-primary"><%=presentCount + wfhCount + halfDayCount%></div>
			<div class="zcs-font-14 zcs-color-secondary">Present, WFH, on duty, or half-day today</div>
			<div class='md-progress'><span style='width:<%=presentPct%>%'></span></div>
		</div>
		<div class="md-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12"><div class="md-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline education-hat zcs-font-22"></i></div><span class="zcs-font-13 zcs-color-tertiary">Training</span></div>
			<div class="md-kpi-value zcs-color-primary"><%=trainingRequestCount%></div>
			<div class="zcs-font-14 zcs-color-secondary"><%=highUrgencyTrainingCount%> high urgency training requests</div>
		</div>

		<div class="md-section zcs-card zcs-box-border">
			<div class="md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border"><h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Attendance today</h5><a class="zcs-font-13 zcs-color-theme" href="#Report:Team_Attendance?zc_LoadIn=dialog">Open report</a></div>
			<div class="zcs-p-16 zcs-box-border">
				<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'>
					<table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Count</th></tr></thead><tbody>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-green'>Present</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=presentCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-l_blue'>WFH or On Duty</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=wfhCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow'>Leave or Half Day</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=leaveTodayCount + halfDayCount%></td></tr>
						<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-red'>Absent, Not Marked, or No Log</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=absentCount + notMarkedCount + noLogCount%></td></tr>
					</tbody></table>
				</div>
			</div>
		</div>

		<div class="md-section zcs-card zcs-box-border">
			<div class="md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border"><h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Approved team leave</h5><a class="zcs-font-13 zcs-color-theme" href="#Report:HR_All_Time_Off_Requests?Status=Approved&amp;zc_LoadIn=dialog">Open report</a></div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(activeApprovedLeaveCount == 0)
		{
			%>
<div class="md-empty"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No active or upcoming approved leave in this team scope.</div></div>
<%
		}
		else
		{
			shownLeave = 0;
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Employee</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Leave type</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Dates</th></tr></thead><tbody>
<%
			for each  leaveTeamEmp in teamRows
			{
				if(shownLeave < 6)
				{
					teamLeaveRows = Time_Off_Request[Employee == leaveTeamEmp.ID && Status == "Approved" && To_Date >= todayDate] sort by From_Date asc;
					for each  leaveItem in teamLeaveRows
					{
						if(shownLeave < 6)
						{
							fromText = "-";
							toText = "-";
							if(leaveItem.From_Date != null)
							{
								fromText = leaveItem.From_Date.toString("dd-MMM-yyyy");
							}
							if(leaveItem.To_Date != null)
							{
								toText = leaveItem.To_Date.toString("dd-MMM-yyyy");
							}
							shownLeave = shownLeave + 1;
							%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><%=ifnull(leaveTeamEmp.Full_Name,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14'><%=ifnull(leaveItem.Leave_Type.Leave_Type_Name,"Leave")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14'><%=fromText%> to <%=toText%></td></tr>
<%
						}
					}
				}
			}
			%>
</tbody></table></div>
<%
		}
		%>
</div>
		</div>

		<div class="md-section zcs-card zcs-box-border">
			<div class="md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border"><h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Announcement acknowledgement</h5><a class="zcs-font-13 zcs-color-theme" href="#Report:Announcement_Acknowledgement_Status?zc_LoadIn=dialog">Open status</a></div>
			<div class="zcs-p-16 zcs-box-border">
				<div class='zcs-flex zcs-align-items-center zcs-gap-12 zcs-p-12 zcs-box-border'>
					<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme'><span class='zcs-badge-text zcs-font-13'><%=announcementCount%> published</span></div>
					<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green'><span class='zcs-badge-text zcs-font-13'><%=ackDoneCount%> acknowledged</span></div>
					<div class='zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'><span class='zcs-badge-text zcs-font-13'><%=ackPendingCount%> pending</span></div>
				</div>
<%
		if(announcementCount == 0)
		{
			%>
<div class="md-empty"><i class="zc-li-outline files-2-doc zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No announcements created by you yet.</div></div>
<%
		}
		else
		{
			shownAnn = 0;
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Announcement</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Pending</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Done</th></tr></thead><tbody>
<%
			for each  annItem in announcementRows
			{
				if(shownAnn < 5)
				{
					pendingForAnn = Announcement_Acknowledgement[Announcement == annItem.ID && Acknowledged == false].count();
					doneForAnn = Announcement_Acknowledgement[Announcement == annItem.ID && Acknowledged == true].count();
					shownAnn = shownAnn + 1;
					%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><%=ifnull(annItem.Title,"Announcement")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-yellow'><%=pendingForAnn%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-green'><%=doneForAnn%></td></tr>
<%
				}
			}
			%>
</tbody></table></div>
<%
		}
		%>
</div>
		</div>

		<div class="md-section zcs-card zcs-box-border">
			<div class="md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border"><h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Team appraisal status</h5><a class="zcs-font-13 zcs-color-theme" href="#Report:Manager_Appraisal_Queue?zc_LoadIn=dialog">Open queue</a></div>
			<div class="zcs-p-16 zcs-box-border">
				<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Stage</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Count</th></tr></thead><tbody>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14'>Draft</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=appraisalDraftCount%></td></tr>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-yellow'>Submitted</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=appraisalSubmittedCount%></td></tr>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-l_blue'>Manager reviewed</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=appraisalManagerReviewedCount%></td></tr>
					<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-green'>HR approved</td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14'><%=appraisalHrApprovedCount%></td></tr>
				</tbody></table></div>
			</div>
		</div>

		<div class="md-section md-section-wide zcs-card zcs-box-border">
			<div class="md-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-24 zcs-py-16 zcs-box-border"><h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Training requests</h5><div class="zcs-flex zcs-align-items-center zcs-gap-8"><a class="zcs-font-13 zcs-color-theme" href="#Form:Training_Request?zc_LoadIn=dialog">Raise request</a><a class="zcs-font-13 zcs-color-theme" href="#Report:Training_Request_List?zc_LoadIn=dialog">Open list</a></div></div>
			<div class="zcs-p-16 zcs-box-border">
<%
		if(trainingRequestCount == 0)
		{
			%>
<div class="md-empty"><i class="zc-li-outline education-hat zcs-font-24 zcs-color-tertiary"></i><div class="zcs-font-14 zcs-color-secondary">No training requests in the current view.</div></div>
<%
		}
		else
		{
			shownTraining = 0;
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border'><table class='zcs-w-full'><thead><tr><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Topic</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Raised by</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Urgency</th><th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Status</th></tr></thead><tbody>
<%
			for each  trainingItem in trainingRows
			{
				if(shownTraining < 8)
				{
					urgencyClass = "zcs-l_blue";
					if(trainingItem.Urgency == "High")
					{
						urgencyClass = "zcs-red";
					}
					else if(trainingItem.Urgency == "Medium")
					{
						urgencyClass = "zcs-yellow";
					}
					shownTraining = shownTraining + 1;
					%>
<tr><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-color-primary'><%=ifnull(trainingItem.Training_Topic,"Training")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14'><%=ifnull(trainingItem.Raised_By,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 <%=urgencyClass%>'><%=ifnull(trainingItem.Urgency,"-")%></td><td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14'><%=ifnull(trainingItem.Status,"-")%></td></tr>
<%
				}
			}
			%>
</tbody></table></div>
<%
		}
		%>
</div>
		</div>
	</div>
</div>
<%
	}
%>