<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAdmin = loginRole == "Administrator" || loginRole == "Admin";
	isHR = loginRole == "HR_ADMIN" || isAdmin;
	isASPIRE = loginRole == "ASPIRE_ADMIN" || isAdmin;
	userName = ifnull(zoho.loginuser,"Employee");
	userDesignation = "Employee workspace";
	userDepartment = "";
	currentEmployeeRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	if(currentEmployeeRows.count() > 0)
	{
		userName = ifnull(currentEmployeeRows.Full_Name,userName);
		userDesignation = ifnull(currentEmployeeRows.Designation,userDesignation);
		if(currentEmployeeRows.Department != null)
		{
			userDepartment = ifnull(currentEmployeeRows.Department.Department_Name,"");
		}
	}
	activeEmployees = Employee_Master[Employment_Status == "Active" || Employment_Status == "Probation"].count();
	totalEmployees = Employee_Master.count();
	activeMembers = Member_Master[Is_Active == true].count();
	activeDepartments = Department_Config[Is_Active == true].count();
	openUrl("#Page:Org_Chart?zc_LoadIn=embed-ehorgchart","same window");
	%>
<style>
/* ===== zcs-global.css utility subset included once for Employee_Home ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-10 { padding: .625rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-mb-4 { margin-bottom: .25rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; } .zcs-relative { position: relative; } .zcs-absolute { position: absolute; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-blue { color: #2A6FFC; } .zcs-color-orange { color: #F4660C; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }
/* ZCS component CSS: header-heading-with-actions and button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-secondary-button { border: 1px solid var(--zcs-border-color); background-color: #F6F7FA; color: var(--zcs-primary-text-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #1652BB); } .zcs-primary-outline-button:hover, .zcs-secondary-button:hover { background-color: var(--zcs_component_hover_color, #F2F7FF); } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 8px 24px rgba(18,19,43,.04); }
/* ZCS component CSS: horizontal-tab-horizontal-tab-with-icon */
.zcs-horizontal-tabhead { box-shadow: 0px -1px 0px 0px var(--zcs-border-color) inset; overflow-x: auto; overflow-y: hidden; -ms-overflow-style: none; scrollbar-width: none; } .zcs-horizontal-tabhead::-webkit-scrollbar { display: none; } .zcs-horizontal-tabitem { list-style-type: none; border-bottom: 2px solid transparent; letter-spacing: .1px; } .zcs-horizontal-tabicon { width: 16px; height: 16px; } .zcs-horizontal-tabtext { text-wrap: nowrap; } .zcs-horizontal-tabitem:hover .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive { border-bottom-color: var(--zcs-theme-brand-color); } .zcs-horizontal-tabitem.zcs-horizontal-tabactive .zcs-horizontal-tablink { color: var(--zcs-theme-brand-color); }
/* ZCS component CSS: quick-actions-card-type-quick-actions */
.zcs-quick-action-item { list-style-type: none; } .zcs-quick-action-item.zcs-card:hover { border-color: var(--zcs-theme-brand-color); } .zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }
/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
/* Employee Home layout */
.eh-page { min-height: 100%; background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; color: var(--zcs-primary-text-color); }
.eh-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD); }
.eh-hero:after { content: ""; position: absolute; right: -90px; top: -110px; width: 300px; height: 300px; border-radius: 50%; border: 40px solid rgba(255,255,255,.13); }
.eh-hero:before { content: ""; position: absolute; right: 190px; bottom: -86px; width: 180px; height: 180px; border-radius: 50%; border: 26px solid rgba(255,255,255,.10); }
.eh-hero-content { position: relative; z-index: 1; }
.eh-hero .zcs-primary-outline-button { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.72); color: #FFFFFF; }
.eh-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.eh-kpi { grid-column: span 3; min-height: 120px; }
.eh-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--zcs-light-bg-color); color: var(--zcs-theme-brand-color); }
.eh-workspace { grid-column: span 9; }
.eh-actions { grid-column: span 3; }
.eh-kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }
.eh-tabs-shell { overflow: hidden; }
.eh-tab-input { display: none; }
.eh-tabbar { overflow-x: auto; }
.eh-tabbar label { cursor: pointer; }
.eh-panel { display: none; padding: 18px; }
#eh-tab-profile:checked ~ .eh-tabbar label[for='eh-tab-profile'], #eh-tab-directory:checked ~ .eh-tabbar label[for='eh-tab-directory'], #eh-tab-org:checked ~ .eh-tabbar label[for='eh-tab-org'], #eh-tab-all:checked ~ .eh-tabbar label[for='eh-tab-all'], #eh-tab-members:checked ~ .eh-tabbar label[for='eh-tab-members'] { color: var(--zcs-theme-brand-color); border-bottom-color: var(--zcs-theme-brand-color); }
#eh-tab-profile:checked ~ .eh-panels .eh-panel-profile, #eh-tab-directory:checked ~ .eh-panels .eh-panel-directory, #eh-tab-org:checked ~ .eh-panels .eh-panel-org, #eh-tab-all:checked ~ .eh-panels .eh-panel-all, #eh-tab-members:checked ~ .eh-panels .eh-panel-members { display: block; }
.eh-embed-card { border: 1px solid var(--zcs-border-color); border-radius: 14px; overflow: hidden; background: var(--zcs-white-color); }
.eh-embed-header { border-bottom: 1px solid var(--zcs-border-color); background: #FAFBFF; }
.eh-report-frame, .eh-page-frame { min-height: 620px; }
.eh-page-frame { width: 100%; }
.eh-access-note { border: 1px dashed var(--zcs-border-color); background: #FAFBFF; border-radius: 12px; }
@media (max-width: 1100px) { .eh-kpi { grid-column: span 6; } .eh-workspace, .eh-actions { grid-column: span 12; } }
@media (max-width: 680px) { .eh-page { padding: 14px; } .eh-kpi { grid-column: span 12; } .eh-hero { padding: 18px; } .eh-hero-content, .zcs-page-header { flex-direction: column; align-items: flex-start; } .zcs-page-header { padding: 16px; } .eh-panel { padding: 12px; } .eh-report-frame, .eh-page-frame { min-height: 520px; } }
</style>

<div class="eh-page zcs-flex zcs-direction-column zcs-gap-18">
	<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-30 zcs-py-24 zcs-box-border">
		<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
			<h5 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Employee Home</h5>
			<span class="zcs-font-14 zcs-color-secondary">Employee/member data and organization structure workspace</span>
		</div>
		<div class="zcs-flex zcs-align-items-center zcs-gap-12">
			<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Org_Chart?zc_LoadIn=dialog">
				<i class="zcs-button-icon zc-li-outline business-chart-bar-32"></i>
				<span class="zcs-button-text">Open Org Chart</span>
			</a>
			<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Employee_Directory?zc_LoadIn=dialog">
				<i class="zcs-button-icon zc-li-outline users-wm"></i>
				<span class="zcs-button-text">Directory</span>
			</a>
		</div>
	</div>

	<section class="eh-hero zcs-box-border">
		<div class="eh-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-20">
			<div class="zcs-flex zcs-direction-column zcs-gap-8">
				<span class="zcs-font-13 zcs-font-medium">Signed in as <%=userName%></span>
				<h2 class="zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0">Organization workspace</h2>
				<span class="zcs-font-15"><%=userDesignation%>
<%
	if(userDepartment != "")
	{
		%>
\u00B7 <%=userDepartment%>
<%
	}
	%>
</span>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-10">
				<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13">My Profile</span></div>
<%
	if(isHR)
	{
		%>
<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-13">HR access</span></div>
<%
	}
	if(isASPIRE)
	{
		%>
<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><span class="zcs-badge-text zcs-font-13">ASPIRE access</span></div>
<%
	}
	%>
</div>
		</div>
	</section>

	<div class="eh-grid">
		<div class="eh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="eh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-wm zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Active staff</span>
			</div>
			<div class="eh-kpi-value zcs-color-primary"><%=activeEmployees%></div>
			<div class="zcs-font-14 zcs-color-secondary">Active and probation employee records</div>
		</div>
		<div class="eh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="eh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline business-chart-bar-32 zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Departments</span>
			</div>
			<div class="eh-kpi-value zcs-color-primary"><%=activeDepartments%></div>
			<div class="zcs-font-14 zcs-color-secondary">Active department configuration rows</div>
		</div>
		<div class="eh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="eh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">All records</span>
			</div>
			<div class="eh-kpi-value zcs-color-primary"><%=totalEmployees%></div>
			<div class="zcs-font-14 zcs-color-secondary">Complete Employee_Master population</div>
		</div>
		<div class="eh-kpi zcs-card zcs-p-18 zcs-box-border zcs-flex zcs-direction-column zcs-gap-12">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-start zcs-gap-12">
				<div class="eh-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-circle-10 zcs-font-22"></i></div>
				<span class="zcs-font-13 zcs-color-tertiary">Members</span>
			</div>
			<div class="eh-kpi-value zcs-color-primary"><%=activeMembers%></div>
			<div class="zcs-font-14 zcs-color-secondary">Active external member records</div>
		</div>

		<section class="eh-workspace eh-tabs-shell zcs-card zcs-box-border">
			<input class="eh-tab-input" type="radio" name="eh-tabs" id="eh-tab-profile" checked>
			<input class="eh-tab-input" type="radio" name="eh-tabs" id="eh-tab-directory">
			<input class="eh-tab-input" type="radio" name="eh-tabs" id="eh-tab-org">
<%
	if(isHR)
	{
		%>
<input class="eh-tab-input" type="radio" name="eh-tabs" id="eh-tab-all">
<%
	}
	if(isASPIRE)
	{
		%>
<input class="eh-tab-input" type="radio" name="eh-tabs" id="eh-tab-members">
<%
	}
	%>
<ul class="eh-tabbar zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border">
				<li class="zcs-horizontal-tabitem"><label for="eh-tab-profile" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zc-li-outline users-single-01"></i><span class="zcs-horizontal-tabtext zcs-font-15">My Profile</span></label></li>
				<li class="zcs-horizontal-tabitem"><label for="eh-tab-directory" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zc-li-outline users-wm"></i><span class="zcs-horizontal-tabtext zcs-font-15">Employee Directory</span></label></li>
				<li class="zcs-horizontal-tabitem"><label for="eh-tab-org" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zc-li-outline business-chart-bar-32"></i><span class="zcs-horizontal-tabtext zcs-font-15">Org Chart</span></label></li>
<%
	if(isHR)
	{
		%>
<li class="zcs-horizontal-tabitem"><label for="eh-tab-all" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zc-li-outline files-2-doc"></i><span class="zcs-horizontal-tabtext zcs-font-15">All Employees</span></label></li>
<%
	}
	if(isASPIRE)
	{
		%>
<li class="zcs-horizontal-tabitem"><label for="eh-tab-members" class="zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-tertiary"><i class="zcs-horizontal-tabicon zcs-font-16 zc-li-outline users-circle-10"></i><span class="zcs-horizontal-tabtext zcs-font-15">Members</span></label></li>
<%
	}
	%>
</ul>

			<div class="eh-panels">
				<div class="eh-panel eh-panel-profile">
					<div class="eh-embed-card">
						<div class="eh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border">
							<div><h5 class="zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary">My Profile</h5><span class="zcs-font-13 zcs-color-secondary">Read-only profile view filtered to your official email</span></div>
							<a class="zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:My_Profile?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open</span></a>
						</div>
						<div class="eh-report-frame" zc-component="report" zc-linkname="My_Profile" zc-height="620px"></div>
					</div>
				</div>

				<div class="eh-panel eh-panel-directory">
					<div class="eh-embed-card">
						<div class="eh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border">
							<div><h5 class="zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary">Employee Directory</h5><span class="zcs-font-13 zcs-color-secondary">Active/probation staff directory for organization lookup</span></div>
							<a class="zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Report:Employee_Directory?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open</span></a>
						</div>
						<div class="eh-report-frame" zc-component="report" zc-linkname="Employee_Directory" zc-height="620px"></div>
					</div>
				</div>

				<div class="eh-panel eh-panel-org">
					<div class="eh-embed-card">
						<div class="eh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border">
							<div><h5 class="zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary">Organisation Chart</h5><span class="zcs-font-13 zcs-color-secondary">Embedded Org_Chart page showing reporting structure</span></div>
							<a class="zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Page:Org_Chart?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span>Open</span></a>
						</div>
						<div class="eh-page-frame" elName="zc-component" name="ehorgchart" pageLinkName=""></div>
					</div>
				</div>
<%
	if(isHR)
	{
		%>
<div class="eh-panel eh-panel-all">
					<div class="eh-embed-card">
						<div class="eh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border">
							<div><h5 class="zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary">All Employees</h5><span class="zcs-font-13 zcs-color-secondary">HR/admin employee master list with full staff population</span></div>
							<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Employee_Master?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span>Add Employee</span></a>
						</div>
						<div class="eh-report-frame" zc-component="report" zc-linkname="All_Employees" zc-height="620px"></div>
					</div>
				</div>
<%
	}
	if(isASPIRE)
	{
		%>
<div class="eh-panel eh-panel-members">
					<div class="eh-embed-card">
						<div class="eh-embed-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-20 zcs-py-16 zcs-box-border">
							<div><h5 class="zcs-font-18 zcs-font-semibold zcs-m-0 zcs-color-primary">Member Master List</h5><span class="zcs-font-13 zcs-color-secondary">ASPIRE/admin managed external member records</span></div>
							<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14" href="#Form:Member_Master?zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i><span>Add Member</span></a>
						</div>
						<div class="eh-report-frame" zc-component="report" zc-linkname="Member_Master_List" zc-height="620px"></div>
					</div>
				</div>
<%
	}
	%>
</div>
		</section>

		<aside class="eh-actions zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
			<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Quick actions</h5>
<%
	if(isHR || isASPIRE)
	{
		%>
<ul class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-0 zcs-m-0">
<%
		if(isHR)
		{
			%>
<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Employee_Master?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-quick-action-text">Add employee</span></a></li>
				<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Report:All_Employees?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline files-2-doc"></i><span class="zcs-quick-action-text">Open all employees</span></a></li>
<%
		}
		if(isHR || isASPIRE)
		{
			%>
<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Form:Member_Master?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline ui-1-simple-add"></i><span class="zcs-quick-action-text">Add member</span></a></li>
				<li class="zcs-quick-action-item zcs-card zcs-px-12 zcs-py-8 zcs-box-border"><a class="zcs-quick-action-link zcs-flex zcs-align-items-center zcs-gap-8 zcs-font-15 zcs-font-normal zcs-lh-body zcs-color-primary zcs-cursor-pointer" href="#Report:Member_Master_List?zc_LoadIn=dialog"><i class="zcs-quick-action-icon zcs-font-medium zc-li-outline users-circle-10"></i><span class="zcs-quick-action-text">Open members</span></a></li>
<%
		}
		%>
</ul>
<%
	}
	else
	{
		%>
<div class="eh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8">
				<div class="zcs-flex zcs-align-items-center zcs-gap-8"><i class="zc-li-outline ui-1-lock zcs-font-18 zcs-color-tertiary"></i><span class="zcs-font-15 zcs-color-primary zcs-font-medium">Employee access</span></div>
				<span class="zcs-font-14 zcs-color-secondary">HR/admin and ASPIRE/admin quick actions are hidden for this profile.</span>
			</div>
<%
	}
	%>
<div class="eh-access-note zcs-p-16 zcs-box-border zcs-flex zcs-direction-column zcs-gap-8">
				<span class="zcs-font-13 zcs-color-tertiary">Access routing</span>
				<span class="zcs-font-14 zcs-color-secondary">All_Employees is surfaced for HR/admin. Member_Master_List is surfaced for ASPIRE/admin. My_Profile, Employee_Directory, and Org_Chart are available from the main workspace.</span>
			</div>
		</aside>
	</div>
</div>