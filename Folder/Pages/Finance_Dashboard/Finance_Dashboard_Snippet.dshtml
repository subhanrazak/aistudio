<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAllowed = loginRole == "FINANCE" || loginRole == "Administrator" || loginRole == "Admin";
	todayDate = zoho.currentdate;
	todayDisplay = todayDate.toString("dd-MMM-yyyy");
	monthLabel = todayDate.toString("MMM yyyy");
	currentMonth = todayDate.getMonth();
	currentYear = todayDate.getYear();
	userName = ifnull(zoho.loginuser,"Finance");
	userRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	if(userRows.count() > 0)
	{
		userName = ifnull(userRows.Full_Name,userName);
	}
	pendingFinanceReimbursementCount = 0;
	pendingFinanceReimbursementAmount = 0;
	billsPendingTravelCount = 0;
	billsPendingTravelAmount = 0;
	pendingGiftDecisionCount = 0;
	pendingGiftDecisionAmount = 0;
	processedMonthCount = 0;
	processedMonthAmount = 0;
	processedTravelLinkedCount = 0;
	travelSpendMonth = 0;
	travelSpendMonthCount = 0;
	maxTypeAmount = 1;
	if(isAllowed == true)
	{
		pendingFinanceReimbursementRows = Reimbursement_Request[Status == "Pending_Finance"] sort by Expense_Date desc;
		pendingFinanceReimbursementCount = pendingFinanceReimbursementRows.count();
		for each  reimbursementSeed in pendingFinanceReimbursementRows
		{
			pendingFinanceReimbursementAmount = pendingFinanceReimbursementAmount + ifnull(reimbursementSeed.Amount_Claimed,0);
		}
		billsPendingTravelRows = Travel_Request[Status == "Bills_Pending"] sort by Travel_Completed_Date asc;
		billsPendingTravelCount = billsPendingTravelRows.count();
		for each  travelBillSeed in billsPendingTravelRows
		{
			billAmount = ifnull(travelBillSeed.Total_Actual_Cost,0);
			if(billAmount == 0)
			{
				billAmount = ifnull(travelBillSeed.Booking_Amount,0);
			}
			billsPendingTravelAmount = billsPendingTravelAmount + billAmount;
		}
		pendingGiftDecisionRows = Gift_Registration[Status == "Pending_Finance"] sort by Received_Date desc;
		pendingGiftDecisionCount = pendingGiftDecisionRows.count();
		for each  giftSeed in pendingGiftDecisionRows
		{
			pendingGiftDecisionAmount = pendingGiftDecisionAmount + ifnull(giftSeed.Estimated_Value,0);
		}
		processedRows = Reimbursement_Request[Status == "Processed" && Processed_Date != null] sort by Processed_Date desc;
		for each  processedSeed in processedRows
		{
			if(processedSeed.Processed_Date.getMonth() == currentMonth && processedSeed.Processed_Date.getYear() == currentYear)
			{
				processedMonthCount = processedMonthCount + 1;
				processedMonthAmount = processedMonthAmount + ifnull(processedSeed.Amount_Claimed,0);
				if(processedSeed.Source == "Travel_Module")
				{
					processedTravelLinkedCount = processedTravelLinkedCount + 1;
				}
			}
		}
		travelSpendRows = Travel_Request[Status != "Rejected"];
		for each  travelSpendSeed in travelSpendRows
		{
			travelMonthDate = null;
			if(travelSpendSeed.Bills_Upload_Date != null)
			{
				travelMonthDate = travelSpendSeed.Bills_Upload_Date;
			}
			else if(travelSpendSeed.Travel_Completed_Date != null)
			{
				travelMonthDate = travelSpendSeed.Travel_Completed_Date;
			}
			if(travelMonthDate != null && travelMonthDate.getMonth() == currentMonth && travelMonthDate.getYear() == currentYear)
			{
				travelMonthAmount = ifnull(travelSpendSeed.Total_Actual_Cost,0);
				if(travelMonthAmount == 0)
				{
					travelMonthAmount = ifnull(travelSpendSeed.Booking_Amount,0);
				}
				travelSpendMonth = travelSpendMonth + travelMonthAmount;
				travelSpendMonthCount = travelSpendMonthCount + 1;
			}
		}
		reimbursementTypeRows = Reimbursement_Type_Config[Is_Active == true] sort by Type_Name asc;
		for each  typeSeed in reimbursementTypeRows
		{
			typeSeedAmount = 0;
			for each  processedTypeSeed in processedRows
			{
				if(processedTypeSeed.Processed_Date != null && processedTypeSeed.Processed_Date.getMonth() == currentMonth && processedTypeSeed.Processed_Date.getYear() == currentYear && processedTypeSeed.Reimbursement_Type == typeSeed.ID)
				{
					typeSeedAmount = typeSeedAmount + ifnull(processedTypeSeed.Amount_Claimed,0);
				}
			}
			if(typeSeedAmount > maxTypeAmount)
			{
				maxTypeAmount = typeSeedAmount;
			}
		}
	}
	%>
<style>
/* ===== zcs-global.css included once for Finance_Dashboard (utility subset used by this page) ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #55576B); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #77798C); --zcs-border-color: var(--zcs_tertiary_border_color, #E6E8F0); --zcs-page-bg-color: #F5F7FB; --zcs-white-color: #FFFFFF; --zcs-brand-foreground: var(--zcs_brand_foreground_color, #FFFFFF); }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-space-between { justify-content: space-between; } .zcs-justify-center { justify-content: center; } .zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-18 { gap: 1.125rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-14 { padding: .875rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-18 { padding: 1.125rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-p-24 { padding: 1.5rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-m-0 { margin: 0; } .zcs-mb-6 { margin-bottom: .375rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mt-4 { margin-top: .25rem; } .zcs-mt-8 { margin-top: .5rem; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mt-12 { margin-top: .75rem; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-2xl { border-radius: 1rem; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-overflow-auto { overflow: auto; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-20 { font-size: 1.25rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-30 { font-size: 1.875rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-green { color: #179E6C; } .zcs-color-red { color: #FE455D; } .zcs-color-yellow { color: #B8770D; } .zcs-color-blue { color: #2A6FFC; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; box-shadow: 0 8px 24px rgba(18, 19, 43, .04); }
/* ZCS component CSS: layout-dashboard panel tiles */
.zcs-panel-wrapper ul li { list-style-type: none; } .zcs-panel { border: 1px solid var(--zcs-border-color); box-shadow: 0 2px 8px 0 #F2F2F6; background-color: var(--zcs-white-color); transition: all .2s ease; } .zcs-panel-icon-wrapper { width: 42px; height: 42px; } .zcs-panel-icon { width: 24px; height: 24px; line-height: 24px; } .zcs-panel.zcs-panel-green .zcs-panel-icon-wrapper { background-color: #E4FCF3; color: #179E6C; } .zcs-panel.zcs-panel-yellow .zcs-panel-icon-wrapper { background-color: #FCF4E6; color: #B8770D; } .zcs-panel.zcs-panel-red .zcs-panel-icon-wrapper { background-color: #FDE3E6; color: #FE455D; } .zcs-panel.zcs-panel-d_blue .zcs-panel-icon-wrapper { background-color: #EAF2FF; color: #1652BB; } .zcs-panel.zcs-panel-blue .zcs-panel-icon-wrapper { background-color: #F2F9FF; color: #2A8BCC; } .zcs-panel.zcs-panel-orange .zcs-panel-icon-wrapper { background-color: #FDF5F3; color: #F4660C; } .zcs-panel.zcs-panel-violet .zcs-panel-icon-wrapper { background-color: #F6F6FB; color: #5C66FF; } .zcs-panel:hover { border-color: var(--zcs-theme-brand-color); background-image: linear-gradient(rgb(253 253 255 / 10%), #F7F9FF); }
/* ZCS component CSS: badge-filled-badge */
.zcs-badge { width: auto; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
/* ZCS component CSS: table-simple-table */
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 100%; } .zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; } .zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
/* ZCS component CSS: button-primary-button */
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs-brand-foreground); } .zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); } .zcs-button:hover { filter: brightness(.98); } .zcs-button-icon { width: 16px; max-height: 16px; }
/* ZCS component CSS: card-fleets-performance-metrics progress bars */
.zcs-progress-bar { height: 8px; background-color: var(--zcs_component_hover_color, #EEF2F7); overflow: hidden; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }
.finance-page { background: var(--zcs-page-bg-color); padding: 22px; box-sizing: border-box; font-family: Lato, Arial, sans-serif; }
.finance-hero { position: relative; overflow: hidden; color: var(--zcs-white-color); border-radius: 18px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #09598E); }
.finance-hero:after { content: ""; position: absolute; right: -90px; top: -125px; width: 340px; height: 340px; border-radius: 50%; border: 42px solid rgba(255,255,255,.13); }
.finance-hero:before { content: ""; position: absolute; right: 180px; bottom: -100px; width: 210px; height: 210px; border-radius: 50%; border: 30px solid rgba(255,255,255,.10); }
.finance-hero-content { position: relative; z-index: 1; }
.finance-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.finance-kpi { grid-column: span 3; } .finance-card-4 { grid-column: span 4; } .finance-card-5 { grid-column: span 5; } .finance-card-6 { grid-column: span 6; } .finance-card-7 { grid-column: span 7; } .finance-card-8 { grid-column: span 8; } .finance-card-12 { grid-column: span 12; }
.finance-mini-stat { border: 1px solid var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; padding: 12px; }
.finance-list { list-style: none; margin: 0; padding: 0; } .finance-list li { border-top: 1px solid var(--zcs-border-color); padding: 12px 0; } .finance-list li:first-child { border-top: 0; padding-top: 0; }
.finance-nodata { min-height: 92px; border: 1px dashed var(--zcs-border-color); border-radius: 12px; background: #FAFBFF; }
.finance-bar-row { display: grid; grid-template-columns: minmax(130px, 1fr) 2fr 105px; gap: 10px; align-items: center; }
.finance-status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; } .finance-status-dot.green { background: #179E6C; } .finance-status-dot.yellow { background: #FAAE13; } .finance-status-dot.red { background: #FE455D; } .finance-status-dot.blue { background: #2A6FFC; } .finance-status-dot.orange { background: #F4660C; }
@media (max-width: 1100px) { .finance-kpi, .finance-card-4, .finance-card-5, .finance-card-6, .finance-card-7, .finance-card-8 { grid-column: span 6; } }
@media (max-width: 700px) { .finance-page { padding: 14px; } .finance-kpi, .finance-card-4, .finance-card-5, .finance-card-6, .finance-card-7, .finance-card-8, .finance-card-12 { grid-column: span 12; } .finance-bar-row { grid-template-columns: 1fr; } .finance-hero-content { align-items: flex-start; flex-direction: column; } }
</style>
<%
	if(isAllowed == true)
	{
		%>
<div class="finance-page zcs-flex zcs-direction-column zcs-gap-20">
	<div class="finance-hero">
		<div class="finance-hero-content zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
			<div>
				<div class="zcs-inline-flex zcs-align-items-center zcs-gap-8 zcs-badge zcs-badge-filled zcs-badge-theme zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-font-12 zcs-font-medium zcs-lh-body">Live finance operations</div>
				<h2 class="zcs-font-30 zcs-font-bold zcs-lh-heading zcs-m-0 zcs-mt-10">Finance Dashboard</h2>
				<p class="zcs-font-15 zcs-font-normal zcs-lh-body zcs-m-0 zcs-mt-10">Hello <%=userName%>. Finance queues and spend summary as of <%=todayDisplay%>.</p>
			</div>
			<div class="zcs-flex zcs-gap-10">
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Finance_Reimbursement_Queue">
					<i class="zcs-button-icon zc-li-outline business-2-payment"></i>
					<span class="zcs-button-text">Reimbursement queue</span>
				</a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_Gift_Registry">
					<i class="zcs-button-icon zc-li-outline shopping-gift"></i>
					<span class="zcs-button-text">Gift queue</span>
				</a>
			</div>
		</div>
	</div>

	<div class="zcs-panel-wrapper">
		<ul class="finance-grid zcs-p-0 zcs-m-0">
			<li class="finance-kpi">
				<a href="#Report:Finance_Reimbursement_Queue" class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline business-2-payment"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=pendingFinanceReimbursementCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Pending finance reimbursements</p>
					<span class="zcs-font-13 zcs-color-secondary">INR <%=pendingFinanceReimbursementAmount%> awaiting processing</span>
				</a>
			</li>
			<li class="finance-kpi">
				<a href="#Report:HR_All_Travel" class="zcs-panel zcs-panel-d_blue zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline transport-airplane"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=billsPendingTravelCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Travel bills pending</p>
					<span class="zcs-font-13 zcs-color-secondary">INR <%=billsPendingTravelAmount%> estimated exposure</span>
				</a>
			</li>
			<li class="finance-kpi">
				<a href="#Report:HR_Gift_Registry" class="zcs-panel zcs-panel-orange zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline shopping-gift"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=pendingGiftDecisionCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Gift decisions pending</p>
					<span class="zcs-font-13 zcs-color-secondary">INR <%=pendingGiftDecisionAmount%> estimated value</span>
				</a>
			</li>
			<li class="finance-kpi">
				<a href="#Report:Finance_Reimbursement_Queue" class="zcs-panel zcs-panel-green zcs-wh-full zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border">
					<div class="zcs-flex zcs-align-items-center zcs-gap-10"><div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-lg"><i class="zcs-panel-icon zcs-font-24 zc-li-outline ui-1-check-circle-08"></i></div><h4 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=processedMonthCount%></h4></div>
					<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">Processed reimbursements</p>
					<span class="zcs-font-13 zcs-color-secondary">INR <%=processedMonthAmount%> in <%=monthLabel%></span>
				</a>
			</li>
		</ul>
	</div>

	<div class="finance-grid">
		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-8">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8">
				<div>
					<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Pending finance reimbursements</h3>
					<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4">Live queue total: INR <%=pendingFinanceReimbursementAmount%></p>
				</div>
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Finance_Reimbursement_Queue"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">Open queue</span></a>
			</div>
<%
		if(pendingFinanceReimbursementCount > 0)
		{
			shownFinanceReimbursements = 0;
			%>
<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-12">
				<table class="zcs-w-full">
					<thead><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Employee</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Type</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Amount</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Source</th></tr></thead>
					<tbody>
<%
			for each  reimbursementItem in pendingFinanceReimbursementRows
			{
				if(shownFinanceReimbursements < 6)
				{
					%>
<tr>
							<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><a class="zcs-color-theme" href="#Report:Finance_Reimbursement_Queue?ID=<%=reimbursementItem.ID%>"><%=ifnull(reimbursementItem.Employee.Full_Name,"Employee")%></a><div class="zcs-font-12 zcs-color-tertiary"><%=ifnull(reimbursementItem.Expense_Date,"-")%></div></td>
							<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=ifnull(reimbursementItem.Reimbursement_Type.Type_Name,"Unspecified")%></td>
							<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary">INR <%=ifnull(reimbursementItem.Amount_Claimed,0)%></td>
							<td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body"><%=ifnull(reimbursementItem.Source,"Direct")%></span></span></td>
						</tr>
<%
					shownFinanceReimbursements = shownFinanceReimbursements + 1;
				}
			}
			%>
</tbody>
				</table>
			</div>
<%
		}
		else
		{
			%>
<div class="finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12"><div class="zcs-p-20 zcs-box-border"><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0">No pending finance reimbursements</h5></div></div>
<%
		}
		%>
</section>

		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-4">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8">
				<div>
					<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">This month</h3>
					<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4"><%=monthLabel%> processed and travel spend</p>
				</div>
			</div>
			<div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12">
				<div class="finance-mini-stat"><span class="zcs-font-12 zcs-color-tertiary">Processed reimbursement amount</span><h4 class="zcs-font-28 zcs-m-0 zcs-color-primary">INR <%=processedMonthAmount%></h4><p class="zcs-font-13 zcs-color-secondary zcs-m-0"><%=processedMonthCount%> records, <%=processedTravelLinkedCount%> travel-linked</p></div>
				<div class="finance-mini-stat"><span class="zcs-font-12 zcs-color-tertiary">Travel spend posted</span><h4 class="zcs-font-28 zcs-m-0 zcs-color-primary">INR <%=travelSpendMonth%></h4><p class="zcs-font-13 zcs-color-secondary zcs-m-0"><%=travelSpendMonthCount%> travel records in <%=monthLabel%></p></div>
				<div class="zcs-flex zcs-gap-10">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Reimbursement_Status_Kanban"><i class="zcs-button-icon zc-li-outline design-app"></i><span class="zcs-button-text">Reimbursement kanban</span></a>
				</div>
			</div>
		</section>

		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-6">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8">
				<div>
					<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Bills pending travel list</h3>
					<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4">Trips completed and waiting for bill upload</p>
				</div>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_All_Travel"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">Travel queue</span></a>
			</div>
<%
		if(billsPendingTravelCount > 0)
		{
			shownBills = 0;
			%>
<ul class="finance-list zcs-mt-12">
<%
			for each  billItem in billsPendingTravelRows
			{
				if(shownBills < 5)
				{
					billCost = ifnull(billItem.Total_Actual_Cost,0);
					if(billCost == 0)
					{
						billCost = ifnull(billItem.Booking_Amount,0);
					}
					%>
<li class="zcs-flex zcs-justify-space-between zcs-gap-12">
					<div><a class="zcs-font-14 zcs-font-semibold zcs-color-theme" href="#Report:HR_All_Travel?ID=<%=billItem.ID%>"><%=ifnull(billItem.Destination,"Travel request")%></a><div class="zcs-font-12 zcs-color-tertiary"><%=ifnull(billItem.Employee.Full_Name,"Employee")%> | completed <%=ifnull(billItem.Travel_Completed_Date,"-")%></div></div>
					<div class="zcs-text-right"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Bills pending</span></span><div class="zcs-font-13 zcs-color-primary zcs-mt-4">INR <%=billCost%></div></div>
				</li>
<%
					shownBills = shownBills + 1;
				}
			}
			%>
</ul>
<%
		}
		else
		{
			%>
<div class="finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12"><div class="zcs-p-20 zcs-box-border"><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0">No travel bills pending</h5></div></div>
<%
		}
		%>
</section>

		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-6">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8">
				<div>
					<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Pending finance gift decisions</h3>
					<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4">Retain or return decisions awaiting finance</p>
				</div>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_Gift_Registry"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">Gift registry</span></a>
			</div>
<%
		if(pendingGiftDecisionCount > 0)
		{
			shownGifts = 0;
			%>
<ul class="finance-list zcs-mt-12">
<%
			for each  giftItem in pendingGiftDecisionRows
			{
				if(shownGifts < 5)
				{
					%>
<li class="zcs-flex zcs-justify-space-between zcs-gap-12">
					<div><a class="zcs-font-14 zcs-font-semibold zcs-color-theme" href="#Report:HR_Gift_Registry?ID=<%=giftItem.ID%>"><%=ifnull(giftItem.Gift_Name,"Gift declaration")%></a><div class="zcs-font-12 zcs-color-tertiary"><%=ifnull(giftItem.Employee.Full_Name,"Employee")%> | from <%=ifnull(giftItem.Received_From,"-")%></div></div>
					<div class="zcs-text-right"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Pending finance</span></span><div class="zcs-font-13 zcs-color-primary zcs-mt-4">INR <%=ifnull(giftItem.Estimated_Value,0)%></div></div>
				</li>
<%
					shownGifts = shownGifts + 1;
				}
			}
			%>
</ul>
<%
		}
		else
		{
			%>
<div class="finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12"><div class="zcs-p-20 zcs-box-border"><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0">No finance gift decisions pending</h5></div></div>
<%
		}
		%>
</section>

		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-7">
			<div class="zcs-flex zcs-justify-space-between zcs-align-items-center zcs-gap-12 zcs-mb-8">
				<div>
					<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Reimbursement by type</h3>
					<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4">Processed amounts in <%=monthLabel%></p>
				</div>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Finance_Reimbursement_Queue"><i class="zcs-button-icon zc-li-outline arrows-1-tail-right"></i><span class="zcs-button-text">View processed</span></a>
			</div>
<%
		if(reimbursementTypeRows.count() > 0)
		{
			%>
<div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-mt-12">
<%
			for each  typeItem in reimbursementTypeRows
			{
				typeAmount = 0;
				typeCount = 0;
				for each  processedTypeItem in processedRows
				{
					if(processedTypeItem.Processed_Date != null && processedTypeItem.Processed_Date.getMonth() == currentMonth && processedTypeItem.Processed_Date.getYear() == currentYear && processedTypeItem.Reimbursement_Type == typeItem.ID)
					{
						typeAmount = typeAmount + ifnull(processedTypeItem.Amount_Claimed,0);
						typeCount = typeCount + 1;
					}
				}
				typePct = 0;
				if(maxTypeAmount > 0)
				{
					typePct = (typeAmount * 100) / maxTypeAmount;
				}
				%>
<div class="finance-bar-row">
					<div class="zcs-flex zcs-align-items-center zcs-gap-8"><span class="finance-status-dot blue"></span><span class="zcs-font-14 zcs-color-primary"><%=ifnull(typeItem.Type_Name,"Type")%></span></div>
					<div class="zcs-progress-bar zcs-rounded-sm"><div class="zcs-progress-bar-indicator" style="width:<%=typePct%>%;"></div></div>
					<div class="zcs-text-right"><span class="zcs-font-13 zcs-color-primary">INR <%=typeAmount%></span><div class="zcs-font-11 zcs-color-tertiary"><%=typeCount%> records</div></div>
				</div>
<%
			}
			%>
</div>
<%
		}
		else
		{
			%>
<div class="finance-nodata zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-mt-12"><div class="zcs-p-20 zcs-box-border"><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0">No reimbursement types configured</h5></div></div>
<%
		}
		%>
</section>

		<section class="zcs-card zcs-p-20 zcs-box-border finance-card-5">
			<h3 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Queue links</h3>
			<p class="zcs-font-13 zcs-color-tertiary zcs-m-0 zcs-mt-4">Open the underlying reports to process finance actions and review status boards.</p>
			<div class="zcs-flex zcs-direction-column zcs-gap-10 zcs-mt-12">
				<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Finance_Reimbursement_Queue"><i class="zcs-button-icon zc-li-outline business-2-payment"></i><span class="zcs-button-text">Finance reimbursement queue</span></a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_All_Travel"><i class="zcs-button-icon zc-li-outline transport-airplane"></i><span class="zcs-button-text">Travel bills and spend report</span></a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:HR_Gift_Registry"><i class="zcs-button-icon zc-li-outline shopping-gift"></i><span class="zcs-button-text">Gift finance decisions</span></a>
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Travel_Selected_Options_List"><i class="zcs-button-icon zc-li-outline files-archive-paper"></i><span class="zcs-button-text">Travel selected options</span></a>
				<div class="zcs-flex zcs-gap-10">
					<a class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue" href="#Report:Travel_Status_Kanban"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Travel kanban</span></a>
					<a class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange" href="#Report:Gift_Status_Kanban"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Gift kanban</span></a>
				</div>
			</div>
		</section>
	</div>
</div>
<%
	}
	else
	{
		%>
<div class="finance-page">
	<div class="zcs-card zcs-p-24 zcs-box-border">
		<div class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body">Restricted</span></div>
		<h3 class="zcs-font-18 zcs-color-primary">Finance dashboard</h3>
		<p class="zcs-color-tertiary">This finance operational dashboard is available to FINANCE and Administrator users.</p>
	</div>
</div>
<%
	}
%>