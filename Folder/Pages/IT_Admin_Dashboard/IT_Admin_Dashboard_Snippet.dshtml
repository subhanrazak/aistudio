<%
	loginEmail = zoho.loginuserid;
	if(loginEmail == null || loginEmail == "")
	{
		loginEmail = zoho.loginuser;
	}
	loginRole = ifnull(thisapp.permissions.loginUserProfile(),"");
	isAllowed = loginRole == "IT_ADMIN" || loginRole == "Administrator" || loginRole == "Admin";
	todayDate = zoho.currentdate;
	lwdEndDate = todayDate.addDay(30);
	todayDisplay = todayDate.toString("dd-MMM-yyyy");
	lwdEndDisplay = lwdEndDate.toString("dd-MMM-yyyy");
	userRows = Employee_Master[Official_Email == loginEmail || Official_Email == zoho.loginuser];
	userName = ifnull(zoho.loginuser,"IT Admin");
	userSubText = ifnull(loginRole,"IT_ADMIN");
	userInitial = "I";
	if(userRows.count() > 0)
	{
		userEmp = userRows;
		userName = ifnull(userEmp.Full_Name,userName);
		userSubText = ifnull(userEmp.Designation,userSubText);
	}
	if(userName != null && userName != "")
	{
		userInitial = userName.left(1).toUpperCase();
	}
	allChecklistRows = Offboarding_Checklist[Status == "Pending"] sort by Completed_Date descending;
	pendingChecklistCount = 0;
	for each  checklistSeed in allChecklistRows
	{
		includeChecklist = false;
		deptNameSeed = ifnull(checklistSeed.Responsible_Department.Department_Name,"");
		itemNameSeed = ifnull(checklistSeed.Checklist_Item.Checklist_Item,"");
		personEmailSeed = ifnull(checklistSeed.Responsible_Person.Official_Email,"");
		if(personEmailSeed == loginEmail || personEmailSeed == zoho.loginuser)
		{
			includeChecklist = true;
		}
		if(deptNameSeed == "IT" || deptNameSeed == "Information Technology" || deptNameSeed == "IT Department" || deptNameSeed == "Technology" || itemNameSeed.contains("IT") || itemNameSeed.contains("Laptop") || itemNameSeed.contains("Asset") || itemNameSeed.contains("Access"))
		{
			includeChecklist = true;
		}
		if(includeChecklist == true)
		{
			pendingChecklistCount = pendingChecklistCount + 1;
		}
	}
	pendingAssetRows = Employee_Asset_Recovery[Recovery_Status == "Pending"] sort by Assigned_Date asc;
	pendingAssetCount = pendingAssetRows.count();
	recoveredAssetCount = Employee_Asset_Recovery[Recovery_Status == "Recovered"].count();
	notFoundAssetCount = Employee_Asset_Recovery[Recovery_Status == "Not_Found"].count();
	syncFailedRows = Employee_Asset_Recovery[External_Sync_Status == "Sync_Failed"] sort by Recovery_Date descending;
	syncFailedCount = syncFailedRows.count();
	pendingSyncCount = Employee_Asset_Recovery[External_Sync_Status == "Pending_Sync"].count();
	syncedCount = Employee_Asset_Recovery[External_Sync_Status == "Synced"].count();
	upcomingResignationRows = Resignation_Request[Status == "Approved" && Effective_LWD >= todayDate && Effective_LWD <= lwdEndDate] sort by Effective_LWD asc;
	upcomingLwdCount = upcomingResignationRows.count();
	%>
<style>
/* ZCS global utility subset included once for IT_Admin_Dashboard */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, #2A6FFC); --zcs-light-bg-color: var(--zcs_brand_light_color, #E8EFFF); --zcs-primary-text-color: var(--zcs_primary_text_color, #1A1A1A); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4B5563); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #878895); --zcs-border-color: var(--zcs_tertiary_border_color, #E7E7EE); --zcs-white-color: #FFFFFF; --zcs-black-color: #000000; font-size: 16px; line-height: 1.5; }
a { text-decoration: none; }
.zcs-flex { display: flex; } .zcs-inline-flex { display: inline-flex; } .zcs-row { display: flex; flex-wrap: wrap; } .zcs-direction-column { flex-direction: column; } .zcs-align-items-center { align-items: center; } .zcs-align-items-start { align-items: flex-start; } .zcs-justify-center { justify-content: center; } .zcs-justify-space-between { justify-content: space-between; } .zcs-col-common { flex: 1 1 0%; min-width: 0; } .zcs-no-shrink { flex-shrink: 0; } .zcs-relative { position: relative; } .zcs-sticky { position: sticky; }
.zcs-gap-4 { gap: .25rem; } .zcs-gap-6 { gap: .375rem; } .zcs-gap-8 { gap: .5rem; } .zcs-gap-10 { gap: .625rem; } .zcs-gap-12 { gap: .75rem; } .zcs-gap-16 { gap: 1rem; } .zcs-gap-20 { gap: 1.25rem; } .zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; } .zcs-p-8 { padding: .5rem; } .zcs-p-12 { padding: .75rem; } .zcs-p-16 { padding: 1rem; } .zcs-p-20 { padding: 1.25rem; } .zcs-px-10 { padding-left: .625rem; padding-right: .625rem; } .zcs-px-12 { padding-left: .75rem; padding-right: .75rem; } .zcs-px-16 { padding-left: 1rem; padding-right: 1rem; } .zcs-px-20 { padding-left: 1.25rem; padding-right: 1.25rem; } .zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; } .zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; } .zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; } .zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; } .zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; } .zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; } .zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; } .zcs-mt-10 { margin-top: .625rem; } .zcs-mb-8 { margin-bottom: .5rem; } .zcs-mx-0 { margin-left: 0; margin-right: 0; } .zcs-w-full { width: 100%; } .zcs-wh-full { width: 100%; height: 100%; } .zcs-box-border { box-sizing: border-box; } .zcs-rounded-sm { border-radius: .25rem; } .zcs-rounded-md { border-radius: .375rem; } .zcs-rounded-lg { border-radius: .5rem; } .zcs-rounded-xl { border-radius: .75rem; } .zcs-rounded-half { border-radius: 50%; }
.zcs-font-11 { font-size: .6875rem; } .zcs-font-12 { font-size: .75rem; } .zcs-font-13 { font-size: .8125rem; } .zcs-font-14 { font-size: .875rem; } .zcs-font-15 { font-size: .9375rem; } .zcs-font-16 { font-size: 1rem; } .zcs-font-18 { font-size: 1.125rem; } .zcs-font-22 { font-size: 1.375rem; } .zcs-font-24 { font-size: 1.5rem; } .zcs-font-28 { font-size: 1.75rem; } .zcs-font-normal { font-weight: 400; } .zcs-font-medium { font-weight: 500; } .zcs-font-semibold { font-weight: 600; } .zcs-font-bold { font-weight: 700; } .zcs-lh-body { line-height: 1.5; } .zcs-lh-heading { line-height: 1.25; }
.zcs-color-primary { color: var(--zcs-primary-text-color); } .zcs-color-secondary { color: var(--zcs-secondary-text-color); } .zcs-color-tertiary { color: var(--zcs-teritiary-text-color); } .zcs-color-theme { color: var(--zcs-theme-brand-color); } .zcs-color-white { color: var(--zcs-white-color); } .zcs-color-red { color: #FE455D; } .zcs-color-green { color: #179E6C; } .zcs-text-left { text-align: left; } .zcs-text-right { text-align: right; } .zcs-text-center { text-align: center; } .zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .zcs-overflow-auto { overflow: auto; } .zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
/* ZCS component CSS: header-heading-with-actions, button-primary-button */
.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; } .zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-primary-button { background-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_foreground_color, #FFFFFF); } .zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, #2A6FFC); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, #2A6FFC); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); } .zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, #F2F6FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); } .zcs-button-icon { width: 16px; max-height: 16px; }
/* ZCS component CSS: badge-badge-with-icon */
.zcs-badge { width: auto; } .zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; } .zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs_component_hover_color, #F2F6FF); border-color: var(--zcs_brand_color, #2A6FFC); color: var(--zcs_brand_color, #2A6FFC); } .zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; } .zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; } .zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #b8770d; } .zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; } .zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; } .zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; }
/* ZCS component CSS: table-simple-table */
:root { --zcs-thead-color: #F9FAFE; --zcs-tr-h-color: #F9FAFE; } .zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; } .zcs-table-wrapper table { line-height: normal; border-collapse: collapse; } .zcs-table-wrapper table thead { top: 0; } .zcs-table-wrapper table thead tr th { background-color: var(--zcs-thead-color); box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; } .zcs-table-wrapper table thead tr.zcs-tspace th { background-color: var(--zcs-white-color); box-shadow: none; } .zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); } .zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; } .zcs-table-wrapper table tbody tr:hover td { background-color: var(--zcs-tr-h-color); } .zcs-table-wrapper table tbody tr td.zcs-green { color: #179e6c; } .zcs-table-wrapper table tbody tr td.zcs-yellow { color: #b8770d; } .zcs-table-wrapper table tbody tr td.zcs-l_blue { color: #1094c5; } .zcs-table-wrapper table tbody tr td.zcs-red { color: #fe455d; }
/* IT Admin dashboard */
.itd-page { min-height: 100%; background: var(--zcs-page-bg-color, #F3F3F4); color: var(--zcs-primary-text-color); font-family: inherit; }
.itd-shell { padding: 22px; box-sizing: border-box; }
.itd-hero { position: relative; overflow: hidden; border-radius: 18px; background: linear-gradient(135deg, var(--zcs_brand_color, #2A6FFC), var(--zcs_brand_dark_color, #174EA6)); color: var(--zcs_brand_foreground_color, #FFFFFF); box-shadow: 0 14px 34px rgba(15,23,42,.14); margin-bottom: 16px; }
.itd-hero:after { content: ""; position: absolute; width: 300px; height: 300px; right: -90px; top: -125px; border-radius: 50%; border: 38px solid rgba(255,255,255,.13); }
.itd-hero-inner { position: relative; z-index: 1; }
.itd-avatar { width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,.20); border: 1px solid rgba(255,255,255,.35); color: var(--zcs_brand_foreground_color, #FFFFFF); }
.itd-hero .itd-muted, .itd-hero .zcs-color-secondary, .itd-hero .zcs-color-tertiary { color: rgba(255,255,255,.84); }
.itd-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
.itd-two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin-bottom: 16px; }
.itd-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 14px; box-shadow: 0 8px 24px rgba(15,23,42,.05); }
.itd-kpi { min-height: 128px; }
.itd-kpi-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--zcs_component_hover_color, #F2F6FF); color: var(--zcs_brand_color, #2A6FFC); }
.itd-kpi-icon.itd-warn { background: #FCF4E6; color: #b8770d; }
.itd-kpi-icon.itd-danger { background: #FDE3E6; color: #FE455D; }
.itd-kpi-icon.itd-ok { background: #E4FCF3; color: #179E6C; }
.itd-section-header { border-bottom: 1px solid var(--zcs-border-color); }
.itd-mini-list { list-style: none; margin: 0; padding: 0; }
.itd-mini-list li { padding: 12px 16px; border-top: 1px solid var(--zcs-border-color); }
.itd-mini-list li:first-child { border-top: 0; }
.itd-asset-name { max-width: 250px; }
.itd-progress { height: 8px; width: 100%; border-radius: 999px; background: #EEF2F7; overflow: hidden; }
.itd-progress span { display: block; height: 100%; border-radius: inherit; background: var(--zcs_brand_color, #2A6FFC); }
.itd-link-card:hover { border-color: var(--zcs_brand_color, #2A6FFC); box-shadow: 0 10px 28px rgba(15,23,42,.08); }
.itd-retry-placeholder { border-top: 1px dashed var(--zcs-border-color); background: #FBFCFF; }
.itd-access-denied { min-height: 360px; }
@media (max-width: 1180px) { .itd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .itd-two-col { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .itd-shell { padding: 14px; } .itd-grid { grid-template-columns: 1fr; } .itd-hero .zcs-flex.zcs-justify-space-between { align-items: flex-start; flex-direction: column; } .zcs-page-header { padding: 14px; } }
</style>
<%
	if(isAllowed == false)
	{
		%>
<div class="itd-page itd-shell">
	<div class="itd-card itd-access-denied zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border">
		<div>
			<i class="zc-li-outline ui-1-lock" style="font-size:40px;color:#FE455D;"></i>
			<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-8">Access restricted</h5>
			<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0">This dashboard is available to IT_ADMIN and Administrator profiles.</p>
		</div>
	</div>
</div>
<%
	}
	else
	{
		%>
<div class="itd-page">
	<div class="itd-shell">
		<div class="itd-hero zcs-px-30 zcs-py-24 zcs-box-border">
			<div class="itd-hero-inner zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
				<div class="zcs-flex zcs-align-items-center zcs-gap-16 zcs-col-common zcs-ellipsis">
					<div class="itd-avatar zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-font-22 zcs-font-semibold"><%=userInitial%></div>
					<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
						<h5 class="zcs-font-24 zcs-font-semibold zcs-lh-heading zcs-color-white zcs-m-0">IT offboarding command center</h5>
						<span class="itd-muted zcs-font-14 zcs-font-normal zcs-lh-body zcs-ellipsis">Hello <%=userName%>. Live queues as of <%=todayDisplay%>.</span>
					</div>
				</div>
				<div class="zcs-flex zcs-align-items-center zcs-gap-10">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;zc_Header=true">
						<i class="zcs-button-icon zc-li-outline files-list-bullet"></i><span class="zcs-button-text">Checklist view</span>
					</a>
					<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;zc_Header=true">
						<i class="zcs-button-icon zc-li-outline tech-laptop"></i><span class="zcs-button-text">Asset recovery</span>
					</a>
				</div>
			</div>
		</div>

		<div class="itd-grid">
			<div class="itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div class="itd-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-list-bullet zcs-font-22"></i></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Pending</span></span>
				</div>
				<div>
					<div class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary"><%=pendingChecklistCount%></div>
					<div class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary">IT checklist items</div>
				</div>
			</div>
			<div class="itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div class="itd-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline tech-laptop zcs-font-22"></i></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-settings-gear-64"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Recovery</span></span>
				</div>
				<div>
					<div class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary"><%=pendingAssetCount%></div>
					<div class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary">Assets pending recovery</div>
				</div>
			</div>
			<div class="itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div class="itd-kpi-icon itd-danger zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline arrows-1-refresh-69 zcs-font-22"></i></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Sync failed</span></span>
				</div>
				<div>
					<div class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary"><%=syncFailedCount%></div>
					<div class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary">Assets needing retry</div>
				</div>
			</div>
			<div class="itd-card itd-kpi zcs-p-20 zcs-box-border zcs-flex zcs-direction-column zcs-justify-space-between zcs-gap-12">
				<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
					<div class="itd-kpi-icon itd-warn zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-57 zcs-font-22"></i></div>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-notification-69"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">30 days</span></span>
				</div>
				<div>
					<div class="zcs-font-28 zcs-font-semibold zcs-lh-heading zcs-color-primary"><%=upcomingLwdCount%></div>
					<div class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary">Upcoming LWD through <%=lwdEndDisplay%></div>
				</div>
			</div>
		</div>

		<div class="itd-two-col">
			<div class="itd-card zcs-box-border zcs-overflow-auto">
				<div class="itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border">
					<div>
						<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Pending IT checklist items</h5>
						<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary">Assigned IT tasks and asset/access related checklist rows</span>
					</div>
					<a class="zcs-font-13 zcs-color-theme" href="#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;zc_Header=true">Open report</a>
				</div>
<%
		if(pendingChecklistCount == 0)
		{
			%>
<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border" style="min-height:180px;"><div><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No pending IT checklist items</h5></div></div>
<%
		}
		else
		{
			%>
<ul class="itd-mini-list">
<%
			shownChecklist = 0;
			for each  checklistItem in allChecklistRows
			{
				includeChecklistRow = false;
				deptName = ifnull(checklistItem.Responsible_Department.Department_Name,"");
				itemName = ifnull(checklistItem.Checklist_Item.Checklist_Item,"Checklist item");
				personEmail = ifnull(checklistItem.Responsible_Person.Official_Email,"");
				if(personEmail == loginEmail || personEmail == zoho.loginuser || deptName == "IT" || deptName == "Information Technology" || deptName == "IT Department" || deptName == "Technology" || itemName.contains("IT") || itemName.contains("Laptop") || itemName.contains("Asset") || itemName.contains("Access"))
				{
					includeChecklistRow = true;
				}
				if(includeChecklistRow == true && shownChecklist < 5)
				{
					shownChecklist = shownChecklist + 1;
					respPerson = ifnull(checklistItem.Responsible_Person.Full_Name,"Unassigned");
					reqLabel = ifnull(checklistItem.Resignation_Request.Employee.Full_Name,"Resignation request");
					%>
<li class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
								<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
									<span class="zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis"><%=itemName%></span>
									<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis"><%=reqLabel%> \u00B7 <%=deptName%> \u00B7 <%=respPerson%></span>
								</div>
								<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Pending</span></span>
							</li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>

			<div class="itd-card zcs-box-border zcs-overflow-auto">
				<div class="itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border">
					<div>
						<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Pending asset recovery</h5>
						<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary">Assets awaiting recovered or not found status</span>
					</div>
					<a class="zcs-font-13 zcs-color-theme" href="#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;zc_Header=true">Open report</a>
				</div>
				<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
					<table class="zcs-w-full">
						<thead class="zcs-sticky"><tr><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Asset</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Employee</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Assigned</th><th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Status</th></tr><tr class="zcs-tspace"><th class="zcs-p-8 zcs-box-border" colspan="4"></th></tr></thead>
						<tbody>
<%
		if(pendingAssetCount == 0)
		{
			%>
<tr><td class="zcs-px-16 zcs-py-16 zcs-box-border zcs-text-center zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary" colspan="4">No pending asset recovery rows</td></tr>
<%
		}
		else
		{
			shownPendingAsset = 0;
			for each  assetItem in pendingAssetRows
			{
				if(shownPendingAsset < 6)
				{
					shownPendingAsset = shownPendingAsset + 1;
					assignedText = "-";
					if(assetItem.Assigned_Date != null)
					{
						assignedText = assetItem.Assigned_Date.toString("dd-MMM-yyyy");
					}
					assetEmployee = ifnull(assetItem.Employee.Full_Name,"-");
					assetName = ifnull(assetItem.Asset_Name,"Asset");
					assetId = ifnull(assetItem.Asset_ID,"-");
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><div class="itd-asset-name zcs-ellipsis"><%=assetName%></div><div class="zcs-font-12 zcs-color-tertiary zcs-ellipsis"><%=assetId%></div></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=assetEmployee%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary"><%=assignedText%></td><td class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-yellow">Pending</td></tr>
<%
				}
			}
		}
		%>
</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="itd-two-col">
			<div class="itd-card zcs-box-border zcs-overflow-auto">
				<div class="itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border">
					<div>
						<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Sync failed assets</h5>
						<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary">External PUT integration is a safe placeholder; retries are tracked manually for now</span>
					</div>
					<a class="zcs-font-13 zcs-color-theme" href="#Report:Asset_Sync_Failed?zc_LoadIn=dialog&amp;zc_Header=true">Open failed list</a>
				</div>
<%
		if(syncFailedCount == 0)
		{
			%>
<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border" style="min-height:180px;"><div><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No sync failures</h5></div></div>
<%
		}
		else
		{
			%>
<ul class="itd-mini-list">
<%
			shownFailed = 0;
			for each  failedAsset in syncFailedRows
			{
				if(shownFailed < 5)
				{
					shownFailed = shownFailed + 1;
					failedDateText = "No recovery date";
					if(failedAsset.Recovery_Date != null)
					{
						failedDateText = failedAsset.Recovery_Date.toString("dd-MMM-yyyy");
					}
					%>
<li>
								<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
									<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
										<span class="zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis"><%=ifnull(failedAsset.Asset_Name,"Asset")%></span>
										<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis"><%=ifnull(failedAsset.Employee.Full_Name,"-")%> \u00B7 <%=ifnull(failedAsset.Asset_ID,"-")%> \u00B7 <%=failedDateText%></span>
									</div>
									<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-1-circle-remove"></i><span class="zcs-badge-text zcs-font-13 zcs-font-normal zcs-lh-body">Sync failed</span></span>
								</div>
								<div class="itd-retry-placeholder zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-py-8 zcs-px-12 zcs-box-border zcs-rounded-md" style="margin-top:10px;">
									<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary">Retry action placeholder pending real asset API.</span>
									<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Asset_Sync_Failed?ID=<%=failedAsset.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-button-icon zc-li-outline ui-1-eye-17"></i><span class="zcs-button-text">Review</span></a>
								</div>
							</li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>

			<div class="itd-card zcs-box-border zcs-overflow-auto">
				<div class="itd-section-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12 zcs-px-16 zcs-py-16 zcs-box-border">
					<div>
						<h5 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0">Upcoming LWD within 30 days</h5>
						<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary">Approved exits from <%=todayDisplay%> to <%=lwdEndDisplay%></span>
					</div>
					<a class="zcs-font-13 zcs-color-theme" href="#Report:HR_Offboarding_Dashboard?zc_LoadIn=dialog&amp;zc_Header=true">Open offboarding</a>
				</div>
<%
		if(upcomingLwdCount == 0)
		{
			%>
<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center zcs-p-20 zcs-box-border" style="min-height:180px;"><div><h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">No upcoming LWD in the next 30 days</h5></div></div>
<%
		}
		else
		{
			%>
<ul class="itd-mini-list">
<%
			shownLwd = 0;
			for each  resignItem in upcomingResignationRows
			{
				if(shownLwd < 6)
				{
					shownLwd = shownLwd + 1;
					lwdText = "-";
					if(resignItem.Effective_LWD != null)
					{
						lwdText = resignItem.Effective_LWD.toString("dd-MMM-yyyy");
					}
					empName = ifnull(resignItem.Employee.Full_Name,"Employee");
					empDept = ifnull(resignItem.Employee.Department.Department_Name,"-");
					assetRowsForExit = Employee_Asset_Recovery[Resignation_Request == resignItem.ID];
					pendingForExit = Employee_Asset_Recovery[Resignation_Request == resignItem.ID && Recovery_Status == "Pending"].count();
					totalForExit = assetRowsForExit.count();
					progressPct = 0;
					if(totalForExit > 0)
					{
						progressPct = ((totalForExit - pendingForExit) * 100) / totalForExit;
					}
					%>
<li>
								<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-12">
									<div class="zcs-flex zcs-direction-column zcs-gap-4 zcs-ellipsis">
										<span class="zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis"><%=empName%></span>
										<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-ellipsis"><%=empDept%> \u00B7 Effective LWD <%=lwdText%> \u00B7 <%=pendingForExit%> pending assets</span>
									</div>
									<a class="zcs-font-13 zcs-color-theme" href="#Report:IT_Asset_Recovery_Dashboard?Resignation_Request=<%=resignItem.ID%>&amp;zc_LoadIn=dialog&amp;zc_Header=true">Assets</a>
								</div>
								<div class="itd-progress" style="margin-top:10px;"><span style="width:<%=progressPct%>%;"></span></div>
							</li>
<%
				}
			}
			%>
</ul>
<%
		}
		%>
</div>
		</div>

		<div class="itd-card zcs-p-16 zcs-box-border">
			<div class="zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16" style="flex-wrap:wrap;">
				<div class="zcs-flex zcs-align-items-center zcs-gap-12">
					<div class="itd-kpi-icon itd-ok zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-22"></i></div>
					<div class="zcs-flex zcs-direction-column zcs-gap-4">
						<span class="zcs-font-15 zcs-font-medium zcs-lh-body zcs-color-primary">Asset sync status summary</span>
						<span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary"><%=syncedCount%> synced \u00B7 <%=pendingSyncCount%> pending sync \u00B7 <%=recoveredAssetCount%> recovered \u00B7 <%=notFoundAssetCount%> not found</span>
					</div>
				</div>
				<div class="zcs-flex zcs-align-items-center zcs-gap-10">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:Offboarding_Checklist_View?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-button-icon zc-li-outline files-list-bullet"></i><span class="zcs-button-text">Offboarding checklist</span></a>
					<a class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Report:IT_Asset_Recovery_Dashboard?zc_LoadIn=dialog&amp;zc_Header=true"><i class="zcs-button-icon zc-li-outline tech-laptop"></i><span class="zcs-button-text">IT assets</span></a>
				</div>
			</div>
		</div>
	</div>
</div>
<%
	}
%>