<%
	permit_rec = Permit_Records[ID == input.Permit_ID];
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
a { text-decoration: none; }
.permit-detail-page, .permit-detail-page * { box-sizing: border-box; }
.permit-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zc-font-family, "Poppins", "Zoho Puvi", Arial, sans-serif); padding: 24px; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-gap-32 { gap: 2rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-5 { margin-top: .3125rem; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-30 { font-size: 1.875rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-rounded-half { border-radius: 50%; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-white { color: #fff; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }
.zcs-green { color: #179e6c; }
.zcs-red { color: #fe455d; }
.zcs-yellow { color: #b8770d; }
.zcs-l_blue { color: #1094c5; }
.zcs-blue { color: #09598e; }
.zcs-d_blue { color: #1328cd; }
.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }
.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }
.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }
.zcs-fw-button { width: 100%; }
.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }
.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }
.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; white-space: nowrap; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0px; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }
.zcs-tl-icon { width: 35px; height: 35px; background-color: #F5F4FA; color: #4B4274; }
.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }
.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: ''; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }
.zcs-tl-li-active .zcs-tl-icon { background-color: #E8EFFF; color: #2A6FFC; }
.zcs-tl-li-complete .zcs-tl-icon { background-color: #E4FCF3; color: #179E6C; }
.permit-shell { max-width: 1440px; margin: 0 auto; }
.permit-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }
.permit-hero:after { content: ''; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }
.permit-hero-main, .permit-hero-side { position: relative; z-index: 1; }
.permit-hero-main { min-width: 280px; flex: 1 1 640px; }
.permit-hero-side { flex: 0 1 360px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }
.permit-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }
.permit-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }
.permit-hero-subtitle { color: rgba(255,255,255,.78); max-width: 820px; margin: 8px 0 0; }
.permit-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.permit-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }
.permit-action-ready { background: #179E6C; }
.permit-action-progress { background: #2A6FFC; }
.permit-action-prep { background: #F4660C; }
.permit-action-reject { background: #FE455D; }
.permit-action-neutral { background: #242424; }
.permit-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
.permit-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }
.permit-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
.permit-card-body { padding: 18px 20px; }
.permit-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }
.permit-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }
.permit-span-12 { grid-column: span 12; }
.permit-span-8 { grid-column: span 8; }
.permit-span-6 { grid-column: span 6; }
.permit-span-4 { grid-column: span 4; }
.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }
.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }
.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }
.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }
.link-list { display: flex; flex-direction: column; gap: 10px; }
.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }
.detail-link:hover, .row-link:hover { text-decoration: underline; }
.effect-list { display: grid; gap: 10px; }
.effect { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }
.effect i { margin-top: 2px; }
.effect-ok { background: var(--zcs-success-soft); border-color: #BEEBD7; color: #176B4B; }
.effect-warn { background: var(--zcs-warning-soft); border-color: #FFE0A3; color: #8A5A00; }
.effect-danger { background: var(--zcs-danger-soft); border-color: #FFC3CC; color: #8B1B2B; }
.document-box { border: 1px dashed var(--zcs-border-color); border-radius: 16px; padding: 18px; background: #FBFCFF; word-break: break-word; }
.document-link { display: inline-flex; align-items: center; gap: 8px; color: var(--zcs-theme-brand-color); font-weight: 650; }
.document-link:hover { text-decoration: underline; }
.notes-box { white-space: pre-wrap; word-break: break-word; padding: 16px; border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; }
.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }
.comment-text { white-space: pre-wrap; word-break: break-word; }
.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }
.mobile-stack { display: none; }
@media (max-width: 1100px) { .permit-span-8, .permit-span-6, .permit-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 768px) { .permit-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .permit-hero { padding: 18px; } .permit-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .permit-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .link-row { flex-direction: column; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }
</style>
<div class="permit-detail-page">
	<div class="permit-shell">
<%
	if(permit_rec.count() == 0)
	{
		%>
<div class="zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center" style="min-height:60vh;">
				<div class="zcs-nodata-content zcs-p-20 zcs-box-border permit-card">
					<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Permit not found</h5>
					<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">No Permit_Records record matched Permit_ID <%=input.Permit_ID%>.</p>
				</div>
			</div>
<%
	}
	else
	{
		order_rec = Customer_Orders[ID == permit_rec.Customer_Order];
		installRecords = Installation_Schedules[Customer_Order == permit_rec.Customer_Order] sort by Forecast_Date asc;
		installCount = installRecords.count();
		blockedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order && Permit_Clearance_Status == "Blocked"].count();
		clearedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order && Permit_Clearance_Status == "Approved" || Permit_Clearance_Status == "Not Required"].count();
		submittedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order && Permit_Clearance_Status == "Submitted"].count();
		permitIsClear = false;
		if(permit_rec.Permit_Status == "Approved" || permit_rec.Permit_Status == "Not Required")
		{
			permitIsClear = true;
		}
		permitExpiredByDate = false;
		if(permit_rec.Expiry_Date != null && permit_rec.Expiry_Date < zoho.currentdate && permit_rec.Permit_Status == "Approved")
		{
			permitExpiredByDate = true;
		}
		statusClass = "zcs-badge-blue";
		if(permit_rec.Permit_Status == "Approved" || permit_rec.Permit_Status == "Not Required")
		{
			statusClass = "zcs-badge-green";
		}
		else if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired")
		{
			statusClass = "zcs-badge-red";
		}
		else if(permit_rec.Permit_Status == "Required" || permit_rec.Permit_Status == "Preparing")
		{
			statusClass = "zcs-badge-yellow";
		}
		returnUrl = "%23Page%3APermit_Detail%3FPermit_ID%3D" + permit_rec.ID;
		%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
				<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
					<a href="#Page:Office_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left"></i></a>
					<div class="zcs-ellipsis">
						<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Permit Detail</h5>
						<div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=permit_rec.Permit_Code%> - <%=ifnull(permit_rec.Authority_Name,"Authority pending")%></div>
					</div>
				</div>
				<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
					<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Office_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Office Home</span></a>
<%
		if(order_rec.count() > 0)
		{
			orderUrl = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="<%=orderUrl%>"><i class="zcs-button-icon zc-li-outline files-single"></i><span class="zcs-button-text">Order</span></a>
<%
		}
		%>
</div>
			</div>

			<section class="permit-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
				<div class="permit-hero-main">
					<div class="permit-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Authority, dates, documents, order clearance, and audit history</div>
					<h1 class="permit-hero-title"><%=ifnull(permit_rec.Authority_Name,"Permit authority pending")%></h1>
					<p class="permit-hero-subtitle"><%=permit_rec.Permit_Code%> is currently <%=permit_rec.Permit_Status%>. This page shows the permit number, submitted/approved/expiry dates, document attachment, linked order, installation clearance effect, and comment-driven permit actions.</p>
					<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
						<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-13"><%=permit_rec.Permit_Status%></span></span>
						<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(permitIsClear == true,"zcs-badge-green",if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired","zcs-badge-red","zcs-badge-yellow"))%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline location-pin"></i><span class="zcs-badge-text zcs-font-13">Installation clearance: <%=if(permitIsClear == true,"Clear",if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired","Blocked","Pending"))%></span></span>
						<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(permitExpiredByDate == true,"zcs-badge-red","zcs-badge-blue")%>"><i class="zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time"></i><span class="zcs-badge-text zcs-font-13">Expiry: <%=ifnull(permit_rec.Expiry_Date,"Not set")%></span></span>
					</div>
					<div class="permit-action-group">
<%
		actionStatuses = {"Preparing","Submitted","Approved","Rejected","Expired","Not Required"};
		for each  actionStatus in actionStatuses
		{
			actionParam = actionStatus;
			if(actionStatus == "Not Required")
			{
				actionParam = "Not%20Required";
			}
			actionClass = "permit-action-progress";
			actionIcon = "loader-dots-06";
			if(actionStatus == "Preparing")
			{
				actionClass = "permit-action-prep";
				actionIcon = "design-todo";
			}
			else if(actionStatus == "Submitted")
			{
				actionClass = "permit-action-progress";
				actionIcon = "files-single-folded-content";
			}
			else if(actionStatus == "Approved")
			{
				actionClass = "permit-action-ready";
				actionIcon = "ui-1-check-circle-08";
			}
			else if(actionStatus == "Rejected")
			{
				actionClass = "permit-action-reject";
				actionIcon = "ui-1-simple-remove";
			}
			else if(actionStatus == "Expired")
			{
				actionClass = "permit-action-neutral";
				actionIcon = "ui-2-time";
			}
			else if(actionStatus == "Not Required")
			{
				actionClass = "permit-action-ready";
				actionIcon = "ui-1-check-circle-08";
			}
			actionHref = "#Form:Action_Comments?Target_Module=Permit_Records&Lookup_ID=" + permit_rec.ID + "&New_Status=" + actionParam + "&Return_Page=Permit_Detail&Return_URL=" + returnUrl + "&zc_LoadIn=dialog";
			%>
<a class="zcs-button zcs-primary-button permit-action <%=actionClass%> zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="<%=actionHref%>"><i class="zcs-button-icon zc-li-outline <%=actionIcon%>"></i><span><%=actionStatus%></span></a>
<%
		}
		%>
</div>
				</div>
				<div class="permit-hero-side">
					<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Linked order</div>
					<div class="zcs-font-16 zcs-font-semibold zcs-mt-4">
<%
		if(order_rec.count() > 0)
		{
			%>
<%=order_rec.Order_Code%>
<%
		}
		else
		{
			%>
Order not found
<%
		}
		%>
</div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Customer:
<%
		if(order_rec.count() > 0)
		{
			%>
<%=ifnull(order_rec.Customer_Name_Snapshot,order_rec.Customer.Customer_Name)%>
<%
		}
		else
		{
			%>
Not available
<%
		}
		%>
</div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Installation schedules: <%=installCount%></div>
					<div class="zcs-font-12 zcs-mt-8" style="color:rgba(255,255,255,.72);">Blocked by permit: <%=blockedInstallCount%></div>
				</div>
			</section>

			<div class="permit-grid">
				<section class="permit-card permit-span-8">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Permit summary</h2><p class="permit-card-note">Authority, permit number, required flag, status, and date controls.</p></div></div>
					<div class="permit-card-body">
						<div class="kv-grid">
							<div class="kv"><div class="kv-label">Permit code</div><div class="kv-value"><%=permit_rec.Permit_Code%></div></div>
							<div class="kv"><div class="kv-label">Status</div><div class="kv-value"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=statusClass%>"><span class="zcs-badge-text zcs-font-12"><%=permit_rec.Permit_Status%></span></span></div></div>
							<div class="kv"><div class="kv-label">Authority name</div><div class="kv-value"><%=ifnull(permit_rec.Authority_Name,"Pending")%></div></div>
							<div class="kv"><div class="kv-label">Permit number</div><div class="kv-value"><%=ifnull(permit_rec.Permit_Number,"Not assigned")%></div></div>
							<div class="kv"><div class="kv-label">Permit required</div><div class="kv-value"><%=if(permit_rec.Permit_Required == true,"Yes","No")%></div></div>
							<div class="kv"><div class="kv-label">Customer</div><div class="kv-value"><%=ifnull(permit_rec.Customer.Customer_Name,"Customer pending")%></div></div>
							<div class="kv"><div class="kv-label">Submitted date</div><div class="kv-value"><%=ifnull(permit_rec.Submitted_Date,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Approved date</div><div class="kv-value"><%=ifnull(permit_rec.Approved_Date,"Not set")%></div></div>
							<div class="kv"><div class="kv-label">Expiry date</div><div class="kv-value"><%=ifnull(permit_rec.Expiry_Date,"Not set")%>
<%
		if(permitExpiredByDate == true)
		{
			%>
<div class="zcs-font-12 zcs-red zcs-mt-4">Approved permit appears past its expiry date.</div>
<%
		}
		%>
</div></div>
							<div class="kv"><div class="kv-label">Order permit status</div><div class="kv-value">
<%
		if(order_rec.count() > 0)
		{
			%>
<%=order_rec.Permit_Status%>
<%
		}
		else
		{
			%>
Order not found
<%
		}
		%>
</div></div>
						</div>
					</div>
				</section>

				<section class="permit-card permit-span-4">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Permit document</h2><p class="permit-card-note">Attached authority submission or approval file.</p></div></div>
					<div class="permit-card-body">
						<div class="document-box">
							<div class="zcs-flex zcs-align-items-center zcs-gap-8"><i class="zc-li-outline files-archive-3d-content"></i><strong>Permit documents</strong></div>
							<div class="zcs-font-13 zcs-color-secondary zcs-mt-8">
<%
		docValue = ifnull(permit_rec.Permit_Documents,"");
		if(docValue != "")
		{
			%>
<a class="document-link" href="<%=docValue%>" target="_blank"><i class="zc-li-outline arrows-1-share-91"></i><span>Open permit document</span></a><div class="zcs-font-12 zcs-color-tertiary zcs-mt-8"><%=permit_rec.Permit_Documents%></div>
<%
		}
		else
		{
			%>
No permit documents are attached yet.
<%
		}
		%>
</div>
						</div>
						<div class="notes-box zcs-mt-12"><strong>Permit notes</strong><br><span class="zcs-font-13 zcs-color-secondary"><%=ifnull(permit_rec.Permit_Notes,"No permit notes captured.")%></span></div>
					</div>
				</section>

				<section class="permit-card permit-span-12">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Readiness impact</h2><p class="permit-card-note">How the current permit status affects linked installation scheduling.</p></div></div>
					<div class="permit-card-body">
						<div class="kpi-grid">
							<div class="kpi"><div class="kpi-icon"><i class="zc-li-outline files-folder-15"></i></div><div class="kpi-label">Permit clearance</div><div class="kpi-value"><%=if(permitIsClear == true,"Clear",if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired","Blocked","Pending"))%></div></div>
							<div class="kpi"><div class="kpi-icon"><i class="zc-li-outline location-pin"></i></div><div class="kpi-label">Linked schedules</div><div class="kpi-value"><%=installCount%></div></div>
							<div class="kpi"><div class="kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div class="kpi-label">Cleared schedules</div><div class="kpi-value"><%=clearedInstallCount%></div></div>
							<div class="kpi"><div class="kpi-icon"><i class="zc-li-outline ui-2-alert-circle"></i></div><div class="kpi-label">Blocked schedules</div><div class="kpi-value"><%=blockedInstallCount%></div></div>
						</div>
						<div class="effect-list zcs-mt-16">
<%
		if(permitIsClear == true)
		{
			%>
<div class="effect effect-ok"><i class="zc-li-outline ui-1-check-circle-08"></i><div><strong>Permit is clear for installation.</strong><div class="zcs-font-13 zcs-mt-4">Approved or Not Required permits allow Installation_Schedules.Permit_Clearance_Status to clear and can support Ready to Schedule when production is ready.</div></div></div>
<%
		}
		else if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired")
		{
			%>
<div class="effect effect-danger"><i class="zc-li-outline ui-2-alert-circle"></i><div><strong>Permit blocks installation readiness.</strong><div class="zcs-font-13 zcs-mt-4">Rejected or Expired permits should keep installation clearance blocked until a new action/comment updates the permit.</div></div></div>
<%
		}
		else
		{
			%>
<div class="effect effect-warn"><i class="zc-li-outline ui-2-time"></i><div><strong>Permit is pending.</strong><div class="zcs-font-13 zcs-mt-4">Required, Preparing, and Submitted permits hold installation clearance until the authority approves or the permit is marked Not Required.</div></div></div>
<%
		}
		if(permitExpiredByDate == true)
		{
			%>
<div class="effect effect-danger"><i class="zc-li-outline ui-2-alert-circle"></i><div><strong>Expiry date needs review.</strong><div class="zcs-font-13 zcs-mt-4">The permit status is Approved, but the expiry date is earlier than today.</div></div></div>
<%
		}
		%>
</div>
					</div>
				</section>

				<section class="permit-card permit-span-6">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Linked order</h2><p class="permit-card-note">Order-level context connected to this permit.</p></div></div>
					<div class="permit-card-body">
<%
		if(order_rec.count() == 0)
		{
			%>
<div class="empty-soft">No linked Customer_Orders record was found for this permit.</div>
<%
		}
		else
		{
			orderUrl2 = "#Page:Order_Detail?Order_ID=" + order_rec.ID;
			%>
<div class="kv-grid">
								<div class="kv"><div class="kv-label">Order</div><div class="kv-value"><a class="row-link" href="<%=orderUrl2%>"><%=order_rec.Order_Code%></a></div></div>
								<div class="kv"><div class="kv-label">Order status</div><div class="kv-value"><%=order_rec.Order_Status%></div></div>
								<div class="kv"><div class="kv-label">Customer</div><div class="kv-value"><%=ifnull(order_rec.Customer_Name_Snapshot,order_rec.Customer.Customer_Name)%></div></div>
								<div class="kv"><div class="kv-label">Area or city</div><div class="kv-value"><%=ifnull(order_rec.Area_or_City,"Pending")%></div></div>
								<div class="kv"><div class="kv-label">Invoice number</div><div class="kv-value"><%=ifnull(order_rec.Zoho_Books_Invoice_Number,"Not entered")%></div></div>
								<div class="kv"><div class="kv-label">Expected delivery</div><div class="kv-value"><%=ifnull(order_rec.Expected_Delivery_Date,"Not set")%></div></div>
								<div class="kv"><div class="kv-label">Requires permit</div><div class="kv-value"><%=if(order_rec.Requires_Permit == true,"Yes","No")%></div></div>
								<div class="kv"><div class="kv-label">Customer contact</div><div class="kv-value"><%=ifnull(order_rec.Customer_Phone,"No phone")%><br><%=ifnull(order_rec.Customer_Email,"No email")%></div></div>
							</div>
<%
		}
		%>
</div>
				</section>

				<section class="permit-card permit-span-6">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Installation clearance effect</h2><p class="permit-card-note">Linked Installation_Schedules records and permit clearance status.</p></div></div>
					<div class="permit-card-body">
						<div class="zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only">
							<table class="zcs-w-full">
								<thead class="zcs-sticky"><tr>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Installation</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Schedule</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Permit clearance</th>
									<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary">Effect</th>
								</tr></thead>
								<tbody>
<%
		installRows = 0;
		for each  inst in installRecords
		{
			installRows = installRows + 1;
			instUrl = "#Page:Installation_Detail?Installation_ID=" + inst.ID;
			installStatusClass = "zcs-badge-blue";
			if(inst.Permit_Clearance_Status == "Approved" || inst.Permit_Clearance_Status == "Not Required")
			{
				installStatusClass = "zcs-badge-green";
			}
			else if(inst.Permit_Clearance_Status == "Blocked")
			{
				installStatusClass = "zcs-badge-red";
			}
			else if(inst.Permit_Clearance_Status == "Required" || inst.Permit_Clearance_Status == "Submitted")
			{
				installStatusClass = "zcs-badge-yellow";
			}
			%>
<tr>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><a class="row-link" href="<%=instUrl%>"><%=inst.Installation_Code%></a><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(inst.Area_or_City,"Location pending")%></span></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=inst.Installation_Status%><br><span class="zcs-font-12 zcs-color-tertiary">Forecast <%=ifnull(inst.Forecast_Date,"Not set")%></span></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=installStatusClass%>"><span class="zcs-badge-text zcs-font-12"><%=inst.Permit_Clearance_Status%></span></span></td>
										<td class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><%=if(inst.Permit_Clearance_Status == "Approved" || inst.Permit_Clearance_Status == "Not Required","Clear to schedule when production is ready",if(inst.Permit_Clearance_Status == "Blocked","Installation blocked by permit","Awaiting permit clearance"))%></td>
									</tr>
<%
		}
		if(installRows == 0)
		{
			%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="4">No linked Installation_Schedules records were found for this permit order.</td></tr>
<%
		}
		%>
</tbody>
							</table>
						</div>
						<div class="mobile-stack">
<%
		mobileInstallRows = 0;
		for each  minst in installRecords
		{
			mobileInstallRows = mobileInstallRows + 1;
			minstUrl = "#Page:Installation_Detail?Installation_ID=" + minst.ID;
			%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><a class="row-link" href="<%=minstUrl%>"><strong><%=minst.Installation_Code%></strong></a><span class="zcs-font-12 zcs-color-tertiary"><%=minst.Permit_Clearance_Status%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-6"><%=minst.Installation_Status%> - <%=ifnull(minst.Area_or_City,"Location pending")%></div><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Forecast <%=ifnull(minst.Forecast_Date,"Not set")%></div></div>
<%
		}
		if(mobileInstallRows == 0)
		{
			%>
<div class="empty-soft">No linked Installation_Schedules records were found for this permit order.</div>
<%
		}
		%>
</div>
					</div>
				</section>

				<section class="permit-card permit-span-6">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Permit status timeline</h2><p class="permit-card-note">Current permit progress through the authority lifecycle.</p></div></div>
					<div class="permit-card-body">
						<div class="zcs-timeline-wrapper">
							<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		permitSteps = {"Required","Preparing","Submitted","Approved"};
		currentStepIndex = permitSteps.indexOf(permit_rec.Permit_Status);
		for each index stepIndex in permitSteps
		{
			stepStatus = permitSteps.get(stepIndex);
			tlClass = "";
			iconName = "ui-2-time";
			statusText = "Awaiting previous stage";
			if(currentStepIndex > stepIndex)
			{
				tlClass = "zcs-tl-li-complete";
				iconName = "ui-1-check-circle-08";
				statusText = "Completed or passed";
			}
			else if(currentStepIndex == stepIndex)
			{
				tlClass = "zcs-tl-li-active";
				iconName = "loader-dots-06";
				statusText = "Current permit stage";
			}
			if(permit_rec.Permit_Status == "Not Required")
			{
				statusText = "Skipped because permit is not required";
			}
			%>
<li class="zcs-tl-li <%=tlClass%> zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline <%=iconName%>"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Step <%=stepIndex + 1%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=stepStatus%></h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0"><%=statusText%></p></div></li>
<%
		}
		if(permit_rec.Permit_Status == "Rejected" || permit_rec.Permit_Status == "Expired" || permit_rec.Permit_Status == "Not Required")
		{
			exceptionIcon = "ui-2-alert-circle";
			exceptionStyle = "background:#FDE3E6;color:#FE455D;";
			if(permit_rec.Permit_Status == "Not Required")
			{
				exceptionIcon = "ui-1-check-circle-08";
				exceptionStyle = "background:#E4FCF3;color:#179E6C;";
			}
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><i class="zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline <%=exceptionIcon%>" style="<%=exceptionStyle%>"></i></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right">Outcome</span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=permit_rec.Permit_Status%></h6><p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0">See comment history for reason and next action.</p></div></li>
<%
		}
		%>
</ul>
						</div>
					</div>
				</section>

				<section class="permit-card permit-span-6">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Key dates and references</h2><p class="permit-card-note">Operational checkpoints needed by office and installation teams.</p></div></div>
					<div class="permit-card-body">
						<div class="link-list">
							<div class="link-row"><div><strong>Submitted to authority</strong><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Submission date captured on Permit_Records.</div></div><span class="zcs-font-14 zcs-color-primary"><%=ifnull(permit_rec.Submitted_Date,"Not set")%></span></div>
							<div class="link-row"><div><strong>Authority approval</strong><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Approval date drives installation clearance.</div></div><span class="zcs-font-14 zcs-color-primary"><%=ifnull(permit_rec.Approved_Date,"Not set")%></span></div>
							<div class="link-row"><div><strong>Expiry review</strong><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Expired permits should be moved to Expired through Action_Comments.</div></div><span class="zcs-font-14 zcs-color-primary"><%=ifnull(permit_rec.Expiry_Date,"Not set")%></span></div>
							<div class="link-row"><div><strong>Permit number</strong><div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Authority-issued reference.</div></div><span class="zcs-font-14 zcs-color-primary"><%=ifnull(permit_rec.Permit_Number,"Not assigned")%></span></div>
						</div>
					</div>
				</section>

				<section class="permit-card permit-span-12">
					<div class="permit-card-header"><div><h2 class="permit-card-title">Comment history</h2><p class="permit-card-note">Action_Comments audit trail for this permit, linked order, and linked installation schedules.</p></div></div>
					<div class="permit-card-body">
						<div class="zcs-timeline-wrapper">
							<ul class="zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0">
<%
		commentRows = 0;
		for each  comment in Action_Comments[Target_Module == "Permit_Records" && Lookup_ID == permit_rec.ID] sort by Action_Date desc
		{
			commentRows = commentRows + 1;
			%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=ifnull(comment.Action_Date,"No date")%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=comment.New_Status%></h6><span class="comment-module">Permit_Records</span><span class="zcs-font-13 zcs-color-secondary"><%=ifnull(comment.Submitted_By,"Unknown user")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=ifnull(comment.Comments,"No comment entered.")%></p></div></li>
<%
		}
		if(order_rec.count() > 0)
		{
			for each  orderComment in Action_Comments[Target_Module == "Customer_Orders" && Lookup_ID == order_rec.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=ifnull(orderComment.Action_Date,"No date")%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=orderComment.New_Status%></h6><span class="comment-module">Customer_Orders</span><span class="zcs-font-13 zcs-color-secondary"><%=ifnull(orderComment.Submitted_By,"Unknown user")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=ifnull(orderComment.Comments,"No comment entered.")%></p></div></li>
<%
			}
		}
		for each  installCommentTarget in installRecords
		{
			for each  instComment in Action_Comments[Target_Module == "Installation_Schedules" && Lookup_ID == installCommentTarget.ID] sort by Action_Date desc
			{
				commentRows = commentRows + 1;
				%>
<li class="zcs-tl-li zcs-row zcs-gap-0 zcs-relative"><div class="zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute"><span class="zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative"></span></div><span class="zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right"><%=ifnull(instComment.Action_Date,"No date")%></span><div class="zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border"><div class="zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8"><h6 class="zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=instComment.New_Status%></h6><span class="comment-module">Installation_Schedules</span><span class="zcs-font-13 zcs-color-secondary"><%=ifnull(instComment.Submitted_By,"Unknown user")%></span></div><p class="comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0"><%=ifnull(instComment.Comments,"No comment entered.")%></p></div></li>
<%
			}
		}
		if(commentRows == 0)
		{
			%>
<li><div class="empty-soft">No Action_Comments have been recorded for this permit or linked operational records.</div></li>
<%
		}
		%>
</ul>
						</div>
					</div>
				</section>
			</div>
<%
	}
	%>
</div>
</div>