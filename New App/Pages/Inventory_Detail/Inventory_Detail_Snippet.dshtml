<%
	rawType = ifnull(input.Item_Type,"");
	isMaterial = rawType == "Material" || rawType == "material" || rawType == "MATERIAL";
	isPowder = rawType == "Powder" || rawType == "powder" || rawType == "POWDER";
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
/* ===== zcs-global.css ===== */
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-danger-soft: #FFECEF; --zcs-warning-soft: #FFF6E3; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
a { text-decoration: none; color: inherit; }
.inventory-detail-page, .inventory-detail-page * { box-sizing: border-box; }
.inventory-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 24px; overflow: auto; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-row-wrap { flex-wrap: wrap; }
.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }
.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-gap-24 { gap: 1.5rem; }
.zcs-p-0 { padding: 0; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }
.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }
.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-mx-0 { margin-left: 0; margin-right: 0; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-22 { font-size: 1.375rem; }
.zcs-font-28 { font-size: 1.75rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-box-border { box-sizing: border-box; }
.zcs-w-full { width: 100%; }
.zcs-wh-full { width: 100%; height: 100%; }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-white { color: var(--zcs-white-color); }
.zcs-overflow-auto { overflow: auto; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; }
.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }
.zcs-page-header { background: rgba(255,255,255,.86); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 40px rgba(19,22,53,.06); margin-bottom: 18px; backdrop-filter: blur(8px); }
.zcs-back { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-theme-brand-color); background: var(--zcs-brand-soft); }
.zcs-back:hover { color: #131635; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }
.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-badge { width: auto; }
.zcs-badge-filled { border: 1px solid transparent; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }
.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }
.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }
.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }
.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }
.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }
.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #242424; color: #242424; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; border-radius: 12px; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }
.zcs-table-wrapper table thead { top: 0; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.zcs-table-wrapper .zcs-green { color: #179E6C; }
.zcs-table-wrapper .zcs-red { color: #FE455D; }
.zcs-table-wrapper .zcs-yellow { color: #B8770D; }
.zcs-table-wrapper .zcs-l_blue { color: #1094C5; }
.zcs-nodata-wrapper { min-height: 68vh; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; }
.inventory-hero { border-radius: 22px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1C3F8F); color: #fff; padding: 24px; box-shadow: 0 20px 50px rgba(42,111,252,.18); margin-bottom: 18px; }
.inventory-hero-main { flex: 1 1 420px; min-width: 0; }
.inventory-hero-side { flex: 0 0 300px; background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.22); border-radius: 18px; padding: 18px; }
.inventory-kicker { letter-spacing: .08em; opacity: .82; }
.inventory-hero-title { font-size: clamp(1.7rem, 4vw, 3rem); line-height: 1.05; margin: 8px 0 8px; }
.inventory-hero-subtitle { max-width: 820px; margin: 0; color: rgba(255,255,255,.84); }
.inventory-hero .zcs-badge { border-color: rgba(255,255,255,.35); }
.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }
.kpi-card { min-height: 126px; padding: 18px; border-radius: 16px; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); box-shadow: 0 12px 28px rgba(19,22,53,.05); }
.kpi-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); font-size: 20px; }
.kpi-value { font-size: 28px; font-weight: 700; line-height: 1.1; margin-top: 10px; word-break: break-word; }
.kpi-label { color: var(--zcs-secondary-text-color); font-size: 13px; margin-top: 4px; }
.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
.detail-span-12 { grid-column: span 12; }
.detail-span-8 { grid-column: span 8; }
.detail-span-6 { grid-column: span 6; }
.detail-span-4 { grid-column: span 4; }
.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 12px 28px rgba(19,22,53,.05); overflow: hidden; }
.detail-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #fff, #FBFCFF); }
.detail-card-title { margin: 0; font-size: 18px; line-height: 1.25; }
.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }
.detail-card-body { padding: 18px 20px; }
.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.kv-item { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 12px; }
.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.kv-value { color: var(--zcs-primary-text-color); font-weight: 600; margin-top: 4px; word-break: break-word; }
.alert-row { display: flex; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }
.alert-ok { background: #F5FFFA; border-color: #CFF4E4; }
.alert-ok i { color: #179E6C; }
.alert-warn { background: #FFF8EA; border-color: #F7DFA8; }
.alert-warn i { color: #B8770D; }
.alert-danger { background: #FFF1F3; border-color: #FAC4CD; }
.alert-danger i { color: #FE455D; }
.row-link { color: var(--zcs-theme-brand-color); font-weight: 600; }
.row-link:hover { text-decoration: underline; }
.mobile-stack { display: none; }
.mobile-record { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; margin-bottom: 10px; }
.empty-soft { border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 16px; color: var(--zcs-teritiary-text-color); background: #FBFCFF; }
.stock-ok { color: #179E6C; font-weight: 700; }
.stock-warn { color: #B8770D; font-weight: 700; }
.stock-danger { color: #FE455D; font-weight: 700; }
@media (max-width: 1180px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 768px) { .inventory-detail-page { padding: 12px; } .zcs-page-header { padding: 12px 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .inventory-hero { padding: 18px; border-radius: 18px; } .inventory-hero-side { flex-basis: auto; width: 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-table { display: none; } .mobile-stack { display: block; } .zcs-button { width: 100%; } }
</style>
<div class="inventory-detail-page">
<%
	if(!isMaterial && !isPowder)
	{
		%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
		<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
			<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Unsupported inventory item type</h5>
			<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">Use Item_Type as Material or Powder. Received: <%=rawType%>.</p>
			<a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12" href="#Page:Purchase_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span>Purchase Home</span></a>
		</div>
	</div>
<%
	}
	else if(isMaterial)
	{
		item_rec = Material_Master[ID == input.Item_ID];
		if(item_rec.count() == 0)
		{
			%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Material not found</h5>
				<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">Item_ID <%=input.Item_ID%> does not match an existing Material_Master record.</p>
				<a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12" href="#Page:Purchase_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span>Purchase Home</span></a>
			</div>
		</div>
<%
		}
		else
		{
			availableQty = ifnull(item_rec.Available_Quantity,0);
			reorderQty = ifnull(item_rec.Reorder_Level,0);
			unitName = ifnull(item_rec.Stock_Unit.Unit_Name,"Unit not set");
			vendorName = ifnull(item_rec.Default_Vendor.Vendor_Name,"Vendor not set");
			bomRows = Product_BOM_Items[Material == item_rec.ID];
			productionUsageRows = Production_Material_Usage[Material == item_rec.ID];
			serviceUsageRows = Service_Parts_Usage[Material == item_rec.ID];
			poRows = Purchase_Order_Lines[Material == item_rec.ID];
			productionConsumed = 0.0;
			for each  usageTotal in productionUsageRows
			{
				usageQty = ifnull(usageTotal.Actual_Quantity,0);
				if(usageQty == 0)
				{
					usageQty = ifnull(usageTotal.Estimated_Quantity,0);
				}
				productionConsumed = productionConsumed + usageQty;
			}
			serviceConsumed = 0.0;
			for each  serviceTotal in serviceUsageRows
			{
				serviceConsumed = serviceConsumed + ifnull(serviceTotal.Quantity_Used,0);
			}
			openPoCount = 0;
			openPoQty = 0.0;
			for each  poCountRow in poRows
			{
				poStatus = ifnull(poCountRow.Purchase_Order.PO_Status,"");
				if(poStatus != "Received" && poStatus != "Cancelled")
				{
					openPoCount = openPoCount + 1;
					pendingQty = ifnull(poCountRow.Quantity,0) - ifnull(poCountRow.Received_Quantity,0);
					if(pendingQty < 0)
					{
						pendingQty = 0;
					}
					openPoQty = openPoQty + pendingQty;
				}
			}
			stockBadgeClass = "zcs-badge-green";
			stockIcon = "ui-1-check-circle-08";
			stockLabel = "Healthy stock";
			stockMessage = "Available stock is above the reorder level.";
			alertClass = "alert-ok";
			if(item_rec.Active != true)
			{
				stockBadgeClass = "zcs-badge-grey";
				stockIcon = "ui-1-circle-remove";
				stockLabel = "Inactive item";
				stockMessage = "This material is inactive. Confirm before purchasing or issuing stock.";
				alertClass = "alert-warn";
			}
			else if(availableQty <= reorderQty)
			{
				stockBadgeClass = "zcs-badge-red";
				stockIcon = "ui-2-alert";
				stockLabel = "Reorder warning";
				stockMessage = "Current stock is at or below the reorder level.";
				alertClass = "alert-danger";
			}
			returnUrl = "%23Page%3AInventory_Detail%3FItem_Type%3DMaterial%26Item_ID%3D" + item_rec.ID;
			%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
			<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
				<a href="#Page:Purchase_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left"></i></a>
				<div class="zcs-ellipsis">
					<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Inventory Detail</h5>
					<div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Material - <%=item_rec.Material_Code%></div>
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Purchase_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Purchase Home</span></a>
			</div>
		</div>

		<section class="inventory-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
			<div class="inventory-hero-main">
				<div class="inventory-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Raw material stock item</div>
				<h1 class="inventory-hero-title"><%=item_rec.Material_Name%></h1>
				<p class="inventory-hero-subtitle"><%=ifnull(item_rec.Material_Category,"Uncategorized")%> material supplied by <%=vendorName%>. Consumption shown below includes production material usage and service parts usage.</p>
				<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
					<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=stockBadgeClass%>"><i class="zcs-badge-icon zc-li-outline <%=stockIcon%>"></i><span class="zcs-badge-text zcs-font-13"><%=stockLabel%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13">Unit: <%=unitName%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(openPoCount > 0,"zcs-badge-blue","zcs-badge-grey")%>"><span class="zcs-badge-text zcs-font-13">Open PO lines: <%=openPoCount%></span></span>
				</div>
			</div>
			<div class="inventory-hero-side">
				<div class="zcs-font-13 zcs-uppercase zcs-font-semibold">Current quantity</div>
				<div class="zcs-font-28 zcs-font-bold zcs-mt-8"><%=availableQty%></div>
				<div class="zcs-font-14 zcs-mt-4"><%=unitName%> available</div>
				<div class="zcs-font-13 zcs-mt-12">Reorder level: <strong><%=reorderQty%> <%=unitName%></strong></div>
			</div>
		</section>

		<section class="kpi-grid">
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline business-box"></i></span><div class="kpi-value"><%=availableQty%></div><div class="kpi-label">Available quantity</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline arrows-1-refresh-69"></i></span><div class="kpi-value"><%=reorderQty%></div><div class="kpi-label">Reorder level</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline e-commerce-shopping-cart-simple"></i></span><div class="kpi-value"><%=openPoQty%></div><div class="kpi-label">Pending open PO quantity</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline ui-2-time"></i></span><div class="kpi-value"><%=productionConsumed + serviceConsumed%></div><div class="kpi-label">Related consumed quantity</div></div>
		</section>

		<section class="detail-grid">
			<section class="detail-card detail-span-4">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Stock status</h2><p class="detail-card-note">Reorder and activity context</p></div></div>
				<div class="detail-card-body">
					<div class="alert-row <%=alertClass%>"><i class="zc-li-outline <%=stockIcon%> zcs-font-20"></i><div><strong><%=stockLabel%></strong><div class="zcs-font-14 zcs-color-secondary zcs-mt-4"><%=stockMessage%></div></div></div>
					<div class="kv-grid zcs-mt-16">
						<div class="kv-item"><div class="kv-label">Default vendor</div><div class="kv-value"><%=vendorName%></div></div>
						<div class="kv-item"><div class="kv-label">Last updated</div><div class="kv-value"><%=ifnull(item_rec.Last_Updated,"Not set")%></div></div>
						<div class="kv-item"><div class="kv-label">Active</div><div class="kv-value"><%=if(item_rec.Active == true,"Yes","No")%></div></div>
						<div class="kv-item"><div class="kv-label">Category</div><div class="kv-value"><%=ifnull(item_rec.Material_Category,"Not set")%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-8">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Product BOM context</h2><p class="detail-card-note">Products that use this material as a standard BOM item</p></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13"><%=bomRows.count()%> BOM rows</span></span></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table">
						<table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Product</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Qty per unit</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Unit</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Wastage %</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Active</th></tr></thead><tbody>
<%
			bomCount = 0;
			for each  bom in Product_BOM_Items[Material == item_rec.ID] sort by ID desc
			{
				if(bomCount < 10)
				{
					bomCount = bomCount + 1;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(bom.Product.Product_Name,"Product pending")%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(bom.Quantity_Per_Unit,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(bom.Unit.Unit_Name,unitName)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(bom.Wastage_Percent,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="<%=if(bom.Active == true,"zcs-green","zcs-yellow")%>"><%=if(bom.Active == true,"Yes","No")%></span></td></tr>
<%
				}
			}
			if(bomCount == 0)
			{
				%>
<tr><td colspan="5" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No Product_BOM_Items rows reference this material.</td></tr>
<%
			}
			%>
</tbody></table>
					</div>
					<div class="mobile-stack">
<%
			mobileBomCount = 0;
			for each  mbom in Product_BOM_Items[Material == item_rec.ID] sort by ID desc
			{
				if(mobileBomCount < 10)
				{
					mobileBomCount = mobileBomCount + 1;
					%>
<div class="mobile-record"><strong><%=ifnull(mbom.Product.Product_Name,"Product pending")%></strong><div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Qty: <%=ifnull(mbom.Quantity_Per_Unit,0)%> <%=ifnull(mbom.Unit.Unit_Name,unitName)%> | Wastage: <%=ifnull(mbom.Wastage_Percent,0)%>%</div></div>
<%
				}
			}
			if(mobileBomCount == 0)
			{
				%>
<div class="empty-soft">No Product_BOM_Items rows reference this material.</div>
<%
			}
			%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Production consumption</h2><p class="detail-card-note">Recent Production_Material_Usage rows with Production_Detail links</p></div></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Production</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Estimated</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Actual</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Stock posted</th></tr></thead><tbody>
<%
			prodRowsShown = 0;
			for each  pusage in Production_Material_Usage[Material == item_rec.ID] sort by ID desc
			{
				if(prodRowsShown < 8)
				{
					prodRowsShown = prodRowsShown + 1;
					prodHref = "#Page:Production_Detail?Production_ID=" + pusage.Production_Record.ID;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="row-link" href="<%=prodHref%>"><%=ifnull(pusage.Production_Record.Production_Code,"Production pending")%></a><div class="zcs-font-12 zcs-color-secondary"><%=ifnull(pusage.Production_Record.Product.Product_Name,"Product pending")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(pusage.Estimated_Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(pusage.Actual_Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="<%=if(pusage.Stock_Deducted == true,"zcs-green","zcs-yellow")%>"><%=if(pusage.Stock_Deducted == true,"Yes","Pending")%></span></td></tr>
<%
				}
			}
			if(prodRowsShown == 0)
			{
				%>
<tr><td colspan="4" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No production material usage has been recorded for this material.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobileProdRows = 0;
			for each  mpusage in Production_Material_Usage[Material == item_rec.ID] sort by ID desc
			{
				if(mobileProdRows < 8)
				{
					mobileProdRows = mobileProdRows + 1;
					mProdHref = "#Page:Production_Detail?Production_ID=" + mpusage.Production_Record.ID;
					%>
<div class="mobile-record"><a class="row-link" href="<%=mProdHref%>"><strong><%=ifnull(mpusage.Production_Record.Production_Code,"Production pending")%></strong></a><div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Estimated: <%=ifnull(mpusage.Estimated_Quantity,0)%> | Actual: <%=ifnull(mpusage.Actual_Quantity,0)%> | Posted: <%=if(mpusage.Stock_Deducted == true,"Yes","Pending")%></div></div>
<%
				}
			}
			if(mobileProdRows == 0)
			{
				%>
<div class="empty-soft">No production material usage has been recorded for this material.</div>
<%
			}
			%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-6">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Service consumption</h2><p class="detail-card-note">Recent Service_Parts_Usage rows with Service_Detail links</p></div></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Service</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Qty used</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Unit</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Stock posted</th></tr></thead><tbody>
<%
			serviceRowsShown = 0;
			for each  susage in Service_Parts_Usage[Material == item_rec.ID] sort by ID desc
			{
				if(serviceRowsShown < 8)
				{
					serviceRowsShown = serviceRowsShown + 1;
					svcHref = "#Page:Service_Detail?Service_ID=" + susage.Service_Request.ID;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="row-link" href="<%=svcHref%>"><%=ifnull(susage.Service_Request.Service_Code,"Service pending")%></a><div class="zcs-font-12 zcs-color-secondary"><%=ifnull(susage.Service_Request.Customer_Name,"Customer pending")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(susage.Quantity_Used,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(susage.Unit.Unit_Name,unitName)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="<%=if(susage.Stock_Deducted == true,"zcs-green","zcs-yellow")%>"><%=if(susage.Stock_Deducted == true,"Yes","Pending")%></span></td></tr>
<%
				}
			}
			if(serviceRowsShown == 0)
			{
				%>
<tr><td colspan="4" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No service parts usage has been recorded for this material.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobileSvcRows = 0;
			for each  msusage in Service_Parts_Usage[Material == item_rec.ID] sort by ID desc
			{
				if(mobileSvcRows < 8)
				{
					mobileSvcRows = mobileSvcRows + 1;
					mSvcHref = "#Page:Service_Detail?Service_ID=" + msusage.Service_Request.ID;
					%>
<div class="mobile-record"><a class="row-link" href="<%=mSvcHref%>"><strong><%=ifnull(msusage.Service_Request.Service_Code,"Service pending")%></strong></a><div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Qty used: <%=ifnull(msusage.Quantity_Used,0)%> <%=ifnull(msusage.Unit.Unit_Name,unitName)%> | Posted: <%=if(msusage.Stock_Deducted == true,"Yes","Pending")%></div></div>
<%
				}
			}
			if(mobileSvcRows == 0)
			{
				%>
<div class="empty-soft">No service parts usage has been recorded for this material.</div>
<%
			}
			%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-12">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Open purchase order lines</h2><p class="detail-card-note">Purchase_Order_Lines that can replenish this material, linked to Purchase_Order_Detail</p></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(openPoCount > 0,"zcs-badge-blue","zcs-badge-grey")%>"><span class="zcs-badge-text zcs-font-13"><%=openPoCount%> open</span></span></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">PO</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Vendor</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Status</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Ordered</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Received</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Expected</th></tr></thead><tbody>
<%
			poRowsShown = 0;
			for each  poLine in Purchase_Order_Lines[Material == item_rec.ID] sort by ID desc
			{
				poLineStatus = ifnull(poLine.Purchase_Order.PO_Status,"");
				if(poLineStatus != "Received" && poLineStatus != "Cancelled" && poRowsShown < 10)
				{
					poRowsShown = poRowsShown + 1;
					poHref = "#Page:Purchase_Order_Detail?PO_ID=" + poLine.Purchase_Order.ID;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="row-link" href="<%=poHref%>"><%=ifnull(poLine.Purchase_Order.PO_Number,"PO pending")%></a><div class="zcs-font-12 zcs-color-secondary">Line <%=ifnull(poLine.Line_Number,"-")%> | <%=ifnull(poLine.Line_Type,"-")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(poLine.Purchase_Order.Vendor.Vendor_Name,"Vendor pending")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="zcs-l_blue"><%=poLineStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(poLine.Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(poLine.Received_Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(poLine.Purchase_Order.Expected_Delivery_Date,"Not set")%></td></tr>
<%
				}
			}
			if(poRowsShown == 0)
			{
				%>
<tr><td colspan="6" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No open PO lines are currently linked to this material.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobilePoRows = 0;
			for each  mpoLine in Purchase_Order_Lines[Material == item_rec.ID] sort by ID desc
			{
				mPoStatus = ifnull(mpoLine.Purchase_Order.PO_Status,"");
				if(mPoStatus != "Received" && mPoStatus != "Cancelled" && mobilePoRows < 10)
				{
					mobilePoRows = mobilePoRows + 1;
					mPoHref = "#Page:Purchase_Order_Detail?PO_ID=" + mpoLine.Purchase_Order.ID;
					%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><a class="row-link" href="<%=mPoHref%>"><strong><%=ifnull(mpoLine.Purchase_Order.PO_Number,"PO pending")%></strong></a><span class="zcs-l_blue"><%=mPoStatus%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Vendor: <%=ifnull(mpoLine.Purchase_Order.Vendor.Vendor_Name,"Vendor pending")%> | Ordered: <%=ifnull(mpoLine.Quantity,0)%> | Received: <%=ifnull(mpoLine.Received_Quantity,0)%></div></div>
<%
				}
			}
			if(mobilePoRows == 0)
			{
				%>
<div class="empty-soft">No open PO lines are currently linked to this material.</div>
<%
			}
			%>
</div>
				</div>
			</section>
		</section>
<%
		}
	}
	else if(isPowder)
	{
		powder_rec = Powder_Coating_Inventory[ID == input.Item_ID];
		if(powder_rec.count() == 0)
		{
			%>
<div class="zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center">
			<div class="zcs-nodata-content zcs-p-20 zcs-box-border">
				<h5 class="zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0">Powder stock item not found</h5>
				<p class="zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0">Item_ID <%=input.Item_ID%> does not match an existing Powder_Coating_Inventory record.</p>
				<a class="zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12" href="#Page:Purchase_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span>Purchase Home</span></a>
			</div>
		</div>
<%
		}
		else
		{
			availableQty = ifnull(powder_rec.Available_Quantity,0);
			reorderQty = ifnull(powder_rec.Reorder_Level,0);
			unitName = ifnull(powder_rec.Stock_Unit.Unit_Name,"Unit not set");
			vendorName = ifnull(powder_rec.Vendor.Vendor_Name,"Vendor not set");
			productionRows = Production_Records[Powder == powder_rec.ID];
			defaultProducts = Product_Catalogue[Default_Powder == powder_rec.ID];
			poRows = Purchase_Order_Lines[Powder == powder_rec.ID];
			powderConsumed = 0.0;
			for each  prodTotal in productionRows
			{
				powderConsumed = powderConsumed + ifnull(prodTotal.Powder_Qty_Used,0);
			}
			openPoCount = 0;
			openPoQty = 0.0;
			for each  poCountRow in poRows
			{
				poStatus = ifnull(poCountRow.Purchase_Order.PO_Status,"");
				if(poStatus != "Received" && poStatus != "Cancelled")
				{
					openPoCount = openPoCount + 1;
					pendingQty = ifnull(poCountRow.Quantity,0) - ifnull(poCountRow.Received_Quantity,0);
					if(pendingQty < 0)
					{
						pendingQty = 0;
					}
					openPoQty = openPoQty + pendingQty;
				}
			}
			stockBadgeClass = "zcs-badge-green";
			stockIcon = "ui-1-check-circle-08";
			stockLabel = "Healthy stock";
			stockMessage = "Available powder stock is above the reorder level.";
			alertClass = "alert-ok";
			if(powder_rec.Active != true)
			{
				stockBadgeClass = "zcs-badge-grey";
				stockIcon = "ui-1-circle-remove";
				stockLabel = "Inactive item";
				stockMessage = "This powder is inactive. Confirm before purchasing or issuing stock.";
				alertClass = "alert-warn";
			}
			else if(availableQty <= reorderQty)
			{
				stockBadgeClass = "zcs-badge-red";
				stockIcon = "ui-2-alert";
				stockLabel = "Reorder warning";
				stockMessage = "Current powder stock is at or below the reorder level.";
				alertClass = "alert-danger";
			}
			returnUrl = "%23Page%3AInventory_Detail%3FItem_Type%3DPowder%26Item_ID%3D" + powder_rec.ID;
			%>
<div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
			<div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis">
				<a href="#Page:Purchase_Home" class="zcs-back"><i class="zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left"></i></a>
				<div class="zcs-ellipsis">
					<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0">Inventory Detail</h5>
					<div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Powder - <%=powder_rec.Powder_Code%></div>
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap">
				<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href="#Page:Purchase_Home"><i class="zcs-button-icon zc-li-outline arrows-1-tail-left"></i><span class="zcs-button-text">Purchase Home</span></a>
			</div>
		</div>

		<section class="inventory-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between">
			<div class="inventory-hero-main">
				<div class="inventory-kicker zcs-font-12 zcs-uppercase zcs-font-semibold">Powder coating stock item</div>
				<h1 class="inventory-hero-title"><%=powder_rec.Powder_Name%></h1>
				<p class="inventory-hero-subtitle"><%=ifnull(powder_rec.Colour_Family,"Colour family not set")%> powder supplied by <%=vendorName%>. Consumption shown below comes from related Production_Records powder usage.</p>
				<div class="zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16">
					<span class="zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=stockBadgeClass%>"><i class="zcs-badge-icon zc-li-outline <%=stockIcon%>"></i><span class="zcs-badge-text zcs-font-13"><%=stockLabel%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13">Unit: <%=unitName%></span></span>
					<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(openPoCount > 0,"zcs-badge-blue","zcs-badge-grey")%>"><span class="zcs-badge-text zcs-font-13">Open PO lines: <%=openPoCount%></span></span>
				</div>
			</div>
			<div class="inventory-hero-side">
				<div class="zcs-font-13 zcs-uppercase zcs-font-semibold">Current quantity</div>
				<div class="zcs-font-28 zcs-font-bold zcs-mt-8"><%=availableQty%></div>
				<div class="zcs-font-14 zcs-mt-4"><%=unitName%> available</div>
				<div class="zcs-font-13 zcs-mt-12">Reorder level: <strong><%=reorderQty%> <%=unitName%></strong></div>
			</div>
		</section>

		<section class="kpi-grid">
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline objects-color-palette"></i></span><div class="kpi-value"><%=availableQty%></div><div class="kpi-label">Available quantity</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline arrows-1-refresh-69"></i></span><div class="kpi-value"><%=reorderQty%></div><div class="kpi-label">Reorder level</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline e-commerce-shopping-cart-simple"></i></span><div class="kpi-value"><%=openPoQty%></div><div class="kpi-label">Pending open PO quantity</div></div>
			<div class="kpi-card"><span class="kpi-icon"><i class="zc-li-outline ui-2-time"></i></span><div class="kpi-value"><%=powderConsumed%></div><div class="kpi-label">Related powder consumed</div></div>
		</section>

		<section class="detail-grid">
			<section class="detail-card detail-span-4">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Stock status</h2><p class="detail-card-note">Reorder and vendor context</p></div></div>
				<div class="detail-card-body">
					<div class="alert-row <%=alertClass%>"><i class="zc-li-outline <%=stockIcon%> zcs-font-20"></i><div><strong><%=stockLabel%></strong><div class="zcs-font-14 zcs-color-secondary zcs-mt-4"><%=stockMessage%></div></div></div>
					<div class="kv-grid zcs-mt-16">
						<div class="kv-item"><div class="kv-label">Vendor</div><div class="kv-value"><%=vendorName%></div></div>
						<div class="kv-item"><div class="kv-label">Last updated</div><div class="kv-value"><%=ifnull(powder_rec.Last_Updated,"Not set")%></div></div>
						<div class="kv-item"><div class="kv-label">Active</div><div class="kv-value"><%=if(powder_rec.Active == true,"Yes","No")%></div></div>
						<div class="kv-item"><div class="kv-label">Colour family</div><div class="kv-value"><%=ifnull(powder_rec.Colour_Family,"Not set")%></div></div>
					</div>
				</div>
			</section>

			<section class="detail-card detail-span-8">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Product defaults</h2><p class="detail-card-note">Product_Catalogue records using this as the default powder</p></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme"><span class="zcs-badge-text zcs-font-13"><%=defaultProducts.count()%> products</span></span></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Product</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Category</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Manufacturing mode</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Active</th></tr></thead><tbody>
<%
			productRowsShown = 0;
			for each  productDefault in Product_Catalogue[Default_Powder == powder_rec.ID] sort by Product_Name asc
			{
				if(productRowsShown < 10)
				{
					productRowsShown = productRowsShown + 1;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><strong><%=productDefault.Product_Name%></strong><div class="zcs-font-12 zcs-color-secondary"><%=productDefault.Product_Code%></div></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(productDefault.Product_Category,"Not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(productDefault.Default_Manufacturing_Mode,"Not set")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="<%=if(productDefault.Active == true,"zcs-green","zcs-yellow")%>"><%=if(productDefault.Active == true,"Yes","No")%></span></td></tr>
<%
				}
			}
			if(productRowsShown == 0)
			{
				%>
<tr><td colspan="4" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No Product_Catalogue defaults reference this powder.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobileProductRows = 0;
			for each  mproductDefault in Product_Catalogue[Default_Powder == powder_rec.ID] sort by Product_Name asc
			{
				if(mobileProductRows < 10)
				{
					mobileProductRows = mobileProductRows + 1;
					%>
<div class="mobile-record"><strong><%=mproductDefault.Product_Name%></strong><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(mproductDefault.Product_Category,"Not set")%> | <%=ifnull(mproductDefault.Default_Manufacturing_Mode,"Not set")%></div></div>
<%
				}
			}
			if(mobileProductRows == 0)
			{
				%>
<div class="empty-soft">No Product_Catalogue defaults reference this powder.</div>
<%
			}
			%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-12">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Production powder usage</h2><p class="detail-card-note">Related Production_Records with Production_Detail links</p></div></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Production</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Product</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Status</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Powder used</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Posted</th></tr></thead><tbody>
<%
			prodRowsShown = 0;
			for each  prod in Production_Records[Powder == powder_rec.ID] sort by ID desc
			{
				if(prodRowsShown < 10)
				{
					prodRowsShown = prodRowsShown + 1;
					prodHref = "#Page:Production_Detail?Production_ID=" + prod.ID;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="row-link" href="<%=prodHref%>"><%=prod.Production_Code%></a><div class="zcs-font-12 zcs-color-secondary"><%=ifnull(prod.Customer_Order.Order_Code,"Order pending")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(prod.Product.Product_Name,ifnull(prod.Product_Description,"Product pending"))%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="zcs-l_blue"><%=ifnull(prod.Production_Status,"Not set")%></span></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(prod.Powder_Qty_Used,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="<%=if(prod.Powder_Consumption_Posted == true,"zcs-green","zcs-yellow")%>"><%=if(prod.Powder_Consumption_Posted == true,"Yes","Pending")%></span></td></tr>
<%
				}
			}
			if(prodRowsShown == 0)
			{
				%>
<tr><td colspan="5" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No Production_Records currently reference this powder.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobileProdRows = 0;
			for each  mprod in Production_Records[Powder == powder_rec.ID] sort by ID desc
			{
				if(mobileProdRows < 10)
				{
					mobileProdRows = mobileProdRows + 1;
					mProdHref = "#Page:Production_Detail?Production_ID=" + mprod.ID;
					%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><a class="row-link" href="<%=mProdHref%>"><strong><%=mprod.Production_Code%></strong></a><span class="zcs-l_blue"><%=ifnull(mprod.Production_Status,"Not set")%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-4"><%=ifnull(mprod.Product.Product_Name,ifnull(mprod.Product_Description,"Product pending"))%> | Powder used: <%=ifnull(mprod.Powder_Qty_Used,0)%> | Posted: <%=if(mprod.Powder_Consumption_Posted == true,"Yes","Pending")%></div></div>
<%
				}
			}
			if(mobileProdRows == 0)
			{
				%>
<div class="empty-soft">No Production_Records currently reference this powder.</div>
<%
			}
			%>
</div>
				</div>
			</section>

			<section class="detail-card detail-span-12">
				<div class="detail-card-header"><div><h2 class="detail-card-title">Open purchase order lines</h2><p class="detail-card-note">Purchase_Order_Lines that can replenish this powder, linked to Purchase_Order_Detail</p></div><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=if(openPoCount > 0,"zcs-badge-blue","zcs-badge-grey")%>"><span class="zcs-badge-text zcs-font-13"><%=openPoCount%> open</span></span></div>
				<div class="detail-card-body">
					<div class="zcs-table-wrapper desktop-table"><table class="zcs-w-full"><thead><tr><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">PO</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Vendor</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Status</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Ordered</th><th class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium">Received</th><th class="zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium">Expected</th></tr></thead><tbody>
<%
			poRowsShown = 0;
			for each  poLine in Purchase_Order_Lines[Powder == powder_rec.ID] sort by ID desc
			{
				poLineStatus = ifnull(poLine.Purchase_Order.PO_Status,"");
				if(poLineStatus != "Received" && poLineStatus != "Cancelled" && poRowsShown < 10)
				{
					poRowsShown = poRowsShown + 1;
					poHref = "#Page:Purchase_Order_Detail?PO_ID=" + poLine.Purchase_Order.ID;
					%>
<tr><td class="zcs-px-16 zcs-py-8 zcs-font-14"><a class="row-link" href="<%=poHref%>"><%=ifnull(poLine.Purchase_Order.PO_Number,"PO pending")%></a><div class="zcs-font-12 zcs-color-secondary">Line <%=ifnull(poLine.Line_Number,"-")%> | <%=ifnull(poLine.Line_Type,"-")%></div></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(poLine.Purchase_Order.Vendor.Vendor_Name,"Vendor pending")%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><span class="zcs-l_blue"><%=poLineStatus%></span></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(poLine.Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14"><%=ifnull(poLine.Received_Quantity,0)%></td><td class="zcs-px-16 zcs-py-8 zcs-font-14"><%=ifnull(poLine.Purchase_Order.Expected_Delivery_Date,"Not set")%></td></tr>
<%
				}
			}
			if(poRowsShown == 0)
			{
				%>
<tr><td colspan="6" class="zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary">No open PO lines are currently linked to this powder.</td></tr>
<%
			}
			%>
</tbody></table></div>
					<div class="mobile-stack">
<%
			mobilePoRows = 0;
			for each  mpoLine in Purchase_Order_Lines[Powder == powder_rec.ID] sort by ID desc
			{
				mPoStatus = ifnull(mpoLine.Purchase_Order.PO_Status,"");
				if(mPoStatus != "Received" && mPoStatus != "Cancelled" && mobilePoRows < 10)
				{
					mobilePoRows = mobilePoRows + 1;
					mPoHref = "#Page:Purchase_Order_Detail?PO_ID=" + mpoLine.Purchase_Order.ID;
					%>
<div class="mobile-record"><div class="zcs-flex zcs-justify-space-between zcs-gap-8"><a class="row-link" href="<%=mPoHref%>"><strong><%=ifnull(mpoLine.Purchase_Order.PO_Number,"PO pending")%></strong></a><span class="zcs-l_blue"><%=mPoStatus%></span></div><div class="zcs-font-13 zcs-color-secondary zcs-mt-4">Vendor: <%=ifnull(mpoLine.Purchase_Order.Vendor.Vendor_Name,"Vendor pending")%> | Ordered: <%=ifnull(mpoLine.Quantity,0)%> | Received: <%=ifnull(mpoLine.Received_Quantity,0)%></div></div>
<%
				}
			}
			if(mobilePoRows == 0)
			{
				%>
<div class="empty-soft">No open PO lines are currently linked to this powder.</div>
<%
			}
			%>
</div>
				</div>
			</section>
		</section>
<%
		}
	}
	%>
</div>