<%
	returnUrl = "%23Page%3AInstallation_Home";
	readyInstallations = Installation_Schedules[Installation_Status == "Ready to Schedule"];
	forecastInstallations = Installation_Schedules[Installation_Status == "Forecast" || Installation_Status == "Waiting for Production"];
	assignedInstallations = Installation_Schedules[Crew_Lead.Email == zoho.loginuser && Installation_Status != "Completed" && Installation_Status != "Cancelled"];
	scheduledInstallations = Installation_Schedules[Scheduled_Start != null && Installation_Status != "Completed" && Installation_Status != "Cancelled"];
	blockedInstallations = Installation_Schedules[Production_Readiness_Status == "Not Ready" || Production_Readiness_Status == "Partially Ready" || Permit_Clearance_Status == "Blocked" || Permit_Clearance_Status == "Required" || Permit_Clearance_Status == "Submitted" && Installation_Status != "Completed" && Installation_Status != "Cancelled"];
	readyCount = readyInstallations.count();
	forecastCount = forecastInstallations.count();
	assignedCount = assignedInstallations.count();
	scheduledCount = scheduledInstallations.count();
	blockedCount = blockedInstallations.count();
	%>
<style>
.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }
:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }
#splash-screen { display: none !important; }
a { text-decoration: none; }
.zcs-row { display: flex; flex-wrap: wrap; }
.zcs-flex { display: flex; }
.zcs-inline-flex { display: inline-flex; }
.zcs-direction-column { flex-direction: column; }
.zcs-col-common { flex: 1 1 0%; min-width: 0; }
.zcs-no-shrink { flex-shrink: 0; }
.zcs-align-items-center { align-items: center; }
.zcs-align-items-start { align-items: flex-start; }
.zcs-justify-center { justify-content: center; }
.zcs-justify-space-between { justify-content: space-between; }
.zcs-gap-4 { gap: .25rem; }
.zcs-gap-6 { gap: .375rem; }
.zcs-gap-8 { gap: .5rem; }
.zcs-gap-10 { gap: .625rem; }
.zcs-gap-12 { gap: .75rem; }
.zcs-gap-14 { gap: .875rem; }
.zcs-gap-16 { gap: 1rem; }
.zcs-gap-20 { gap: 1.25rem; }
.zcs-p-8 { padding: .5rem; }
.zcs-p-10 { padding: .625rem; }
.zcs-p-12 { padding: .75rem; }
.zcs-p-14 { padding: .875rem; }
.zcs-p-16 { padding: 1rem; }
.zcs-p-18 { padding: 1.125rem; }
.zcs-p-20 { padding: 1.25rem; }
.zcs-p-24 { padding: 1.5rem; }
.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }
.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }
.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }
.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }
.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }
.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }
.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }
.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }
.zcs-m-0 { margin: 0; }
.zcs-mt-4 { margin-top: .25rem; }
.zcs-mt-6 { margin-top: .375rem; }
.zcs-mt-8 { margin-top: .5rem; }
.zcs-mt-10 { margin-top: .625rem; }
.zcs-mt-12 { margin-top: .75rem; }
.zcs-mt-16 { margin-top: 1rem; }
.zcs-mb-0 { margin-bottom: 0; }
.zcs-font-11 { font-size: .6875rem; }
.zcs-font-12 { font-size: .75rem; }
.zcs-font-13 { font-size: .8125rem; }
.zcs-font-14 { font-size: .875rem; }
.zcs-font-15 { font-size: .9375rem; }
.zcs-font-16 { font-size: 1rem; }
.zcs-font-18 { font-size: 1.125rem; }
.zcs-font-20 { font-size: 1.25rem; }
.zcs-font-24 { font-size: 1.5rem; }
.zcs-font-normal { font-weight: 400; }
.zcs-font-medium { font-weight: 500; }
.zcs-font-semibold { font-weight: 600; }
.zcs-font-bold { font-weight: 700; }
.zcs-lh-body { line-height: 1.5; }
.zcs-lh-heading { line-height: 1.25; }
.zcs-uppercase { text-transform: uppercase; }
.zcs-text-left { text-align: left; }
.zcs-text-right { text-align: right; }
.zcs-text-center { text-align: center; }
.zcs-rounded-sm { border-radius: .25rem; }
.zcs-rounded-md { border-radius: .375rem; }
.zcs-rounded-lg { border-radius: .5rem; }
.zcs-rounded-xl { border-radius: .75rem; }
.zcs-rounded-2xl { border-radius: 1rem; }
.zcs-box-border { box-sizing: border-box; }
.zcs-relative { position: relative; }
.zcs-absolute { position: absolute; }
.zcs-sticky { position: sticky; }
.zcs-w-full { width: 100%; }
.zcs-color-theme { color: var(--zcs-theme-brand-color); }
.zcs-color-primary { color: var(--zcs-primary-text-color); }
.zcs-color-secondary { color: var(--zcs-secondary-text-color); }
.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }
.zcs-color-white { color: #fff; }
.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }
.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }
.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }
.zcs-badge { width: auto; }
.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }
.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }
.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }
.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }
.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }
.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }
.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }
.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }
.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }
.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }
.zcs-button-icon { width: 16px; max-height: 16px; }
.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }
.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 860px; }
.zcs-table-wrapper table thead { top: 0; z-index: 1; }
.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }
.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }
.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }
.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }
.install-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }
.install-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #14365F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }
.install-hero:after { content: ''; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }
.install-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
.install-eyebrow { letter-spacing: .08em; opacity: .78; }
.install-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }
.install-subtitle { max-width: 900px; color: rgba(255,255,255,.82); margin: 0; }
.install-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }
.install-kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
.install-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
.install-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }
.install-kpi-card:before { content: ''; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }
.install-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }
.install-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }
.install-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }
.install-kpi-link, .install-row-link, .install-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }
.install-section-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); gap: 16px; margin-top: 16px; }
.install-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
.install-panel { padding: 18px; }
.install-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.install-panel-title { margin: 0; font-size: 18px; }
.install-note { color: var(--zcs-teritiary-text-color); }
.install-action-group { display: flex; flex-wrap: wrap; gap: 6px; }
.install-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; line-height: 1.2; }
.install-action-ready { --action-color:#179E6C; border-color:#179E6C; color:#179E6C; }
.install-action-schedule { --action-color:#2A6FFC; border-color:#2A6FFC; color:#2A6FFC; }
.install-action-progress { --action-color:#1094C5; border-color:#1094C5; color:#1094C5; }
.install-action-inspect { --action-color:#B8770D; border-color:#B8770D; color:#B8770D; }
.install-action-hold { --action-color:#F4660C; border-color:#F4660C; color:#F4660C; }
.install-action-cancel { --action-color:#FE455D; border-color:#FE455D; color:#FE455D; }
.install-action:hover { background: color-mix(in srgb, var(--action-color, var(--zcs-theme-brand-color)) 10%, #fff); }
.install-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.install-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }
.install-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }
.install-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }
.install-card-list { display: grid; gap: 12px; }
.install-work-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }
.install-schedule-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.install-schedule-card { border-left: 4px solid var(--schedule-color, var(--zcs-theme-brand-color)); padding: 14px; border-radius: 14px; border-top: 1px solid var(--zcs-border-color); border-right: 1px solid var(--zcs-border-color); border-bottom: 1px solid var(--zcs-border-color); background: #fff; }
.install-group-header { margin-top: 14px; margin-bottom: 8px; padding: 8px 10px; border-radius: 12px; background: #F1F4FB; color: var(--zcs-secondary-text-color); }
.install-blocked-reason { color: #B8770D; }
.install-danger { color: #FE455D; }
.install-success { color: #179E6C; }
.install-muted-line { color: var(--zcs-teritiary-text-color); }
.install-mobile-cards { display: none; }
@media (max-width: 1240px) { .install-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .install-section-grid { grid-template-columns: 1fr; } .install-schedule-grid { grid-template-columns: 1fr; } }
@media (max-width: 900px) { .install-two-col { grid-template-columns: 1fr; } .install-hero-content { flex-direction: column; } .install-hero-meta { width: 100%; box-sizing: border-box; } }
@media (max-width: 640px) { .install-home-shell { padding: 12px; } .install-hero { padding: 18px; border-radius: 18px; } .install-kpi-grid { grid-template-columns: 1fr; } .install-panel { padding: 14px; } .install-quick-grid { grid-template-columns: 1fr; } .install-panel-header { align-items: flex-start; flex-direction: column; } .install-responsive-table { display: none; } .install-mobile-cards { display: grid; gap: 10px; } .install-action { flex: 1 1 auto; } }
</style>
<div class="install-home-shell">
		<section class="install-hero">
				<div class="install-hero-content">
						<div>
								<div class="install-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold">Installation planning workspace</div>
								<h1 class="install-title zcs-font-bold">Installation Home</h1>
								<p class="install-subtitle zcs-font-15">Schedule field work based on production readiness, permit clearance, location, estimated hours, and crew lead assignment.</p>
						</div>
						<div class="install-hero-meta">
								<div class="zcs-font-12 zcs-uppercase zcs-font-semibold" style="color:rgba(255,255,255,.72);">Signed in</div>
								<div class="zcs-font-16 zcs-font-semibold zcs-mt-4"><%=zoho.loginuser%></div>
								<div class="zcs-font-12 zcs-mt-4" style="color:rgba(255,255,255,.72);"><%=zoho.currentdate%></div>
						</div>
				</div>
		</section>

		<section class="install-kpi-grid">
				<div class="install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#EAFBF4;--kpi-color:#179E6C;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08 zcs-font-20"></i></div>
								<div class="install-kpi-value zcs-font-bold"><%=readyCount%></div>
								<div class="install-kpi-label zcs-font-13">Ready to schedule</div>
								<a class="install-kpi-link" href="#Report:Ready_To_Schedule_Installations">Open ready queue</a>
						</div>
				</div>
				<div class="install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline arrows-1-tail-right zcs-font-20"></i></div>
								<div class="install-kpi-value zcs-font-bold"><%=forecastCount%></div>
								<div class="install-kpi-label zcs-font-13">Forecast queue</div>
								<a class="install-kpi-link" href="#Report:All_Installation_Schedules">All schedules</a>
						</div>
				</div>
				<div class="install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#EAF7FF;--kpi-color:#1094C5;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline users-single-03 zcs-font-20"></i></div>
								<div class="install-kpi-value zcs-font-bold"><%=assignedCount%></div>
								<div class="install-kpi-label zcs-font-13">Assigned to me</div>
								<a class="install-kpi-link" href="#assigned-to-me">My assignments</a>
						</div>
				</div>
				<div class="install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#F0ECFF;--kpi-color:#7656D6;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-60 zcs-font-20"></i></div>
								<div class="install-kpi-value zcs-font-bold"><%=scheduledCount%></div>
								<div class="install-kpi-label zcs-font-13">Scheduled cards</div>
								<a class="install-kpi-link" href="#schedule-groups">Date/location/crew view</a>
						</div>
				</div>
				<div class="install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative" style="--kpi-soft:#FFF6E3;--kpi-color:#B8770D;">
						<div class="zcs-card-content zcs-col-common zcs-p-16 zcs-box-border">
								<div class="install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-3-alert zcs-font-20"></i></div>
								<div class="install-kpi-value zcs-font-bold"><%=blockedCount%></div>
								<div class="install-kpi-label zcs-font-13">Blocked items</div>
								<a class="install-kpi-link" href="#blocked-items">Review blockers</a>
						</div>
				</div>
		</section>

		<section class="install-section-grid">
				<div class="install-panel zcs-card">
						<div class="install-panel-header">
								<div>
										<h2 class="install-panel-title zcs-font-semibold">Ready-to-schedule installations</h2>
										<p class="install-note zcs-font-13 zcs-mt-4 zcs-mb-0">Production and permit gates are clear enough for scheduling decisions. Use Add Comments popup links for status changes.</p>
								</div>
								<a class="install-panel-link" href="#Report:Ready_To_Schedule_Installations">Full ready report</a>
						</div>
						<div class="install-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative">
								<table class="zcs-w-full">
										<thead class="zcs-sticky">
												<tr>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Installation</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Customer / Location</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Readiness</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Crew / Hours</th>
														<th class="zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary">Add Comments</th>
												</tr>
										</thead>
										<tbody>
<%
	readyRows = 0;
	for each  inst in Installation_Schedules[Installation_Status == "Ready to Schedule"] sort by Priority_Sequence asc
	{
		if(readyRows < 8)
		{
			readyRows = readyRows + 1;
			%>
<tr>
																		<td data-label="Installation" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary"><strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=inst.ID%>"><%=inst.Installation_Code%></a></strong><br><span class="zcs-font-12 zcs-color-tertiary">Order <%=ifnull(inst.Customer_Order.Order_Code,"Not linked")%> \u00B7 Seq <%=ifnull(inst.Priority_Sequence,"Not set")%></span></td>
																		<td data-label="Customer / Location" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(inst.Customer.Customer_Name,ifnull(inst.Customer_Name_Snapshot,"Customer pending"))%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(inst.Area_or_City,"Location pending")%></span></td>
																		<td data-label="Readiness" class="zcs-px-16 zcs-py-10 zcs-box-border"><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><i class="zcs-badge-icon zc-li-outline ui-1-check-circle-08"></i><span class="zcs-badge-text zcs-font-12"><%=ifnull(inst.Production_Readiness_Status,"Production pending")%></span></span><br><span class="zcs-font-12 zcs-color-tertiary">Permit: <%=ifnull(inst.Permit_Clearance_Status,"Permit pending")%></span></td>
																		<td data-label="Crew / Hours" class="zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14"><%=ifnull(inst.Crew_Lead.Employee_Name,"Crew unassigned")%><br><span class="zcs-font-12 zcs-color-tertiary"><%=ifnull(inst.Estimated_Hours,"Hours not set")%> estimated hours</span></td>
																		<td data-label="Add Comments" class="zcs-px-16 zcs-py-10 zcs-box-border">
																				<div class="install-action-group">
																						<a class="zcs-button zcs-primary-outline-button install-action install-action-schedule zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=inst.ID%>&New_Status=Scheduled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog"><i class="zcs-button-icon zc-li-outline ui-1-calendar-60"></i><span>Scheduled</span></a>
																						<a class="zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=inst.ID%>&New_Status=On%20Hold&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog"><span>On Hold</span></a>
																						<a class="zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=inst.ID%>&New_Status=Cancelled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog"><span>Cancelled</span></a>
																				</div>
																		</td>
																</tr>
<%
		}
	}
	if(readyRows == 0)
	{
		%>
<tr><td class="zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary" colspan="5">No installations are currently ready to schedule.</td></tr>
<%
	}
	%>
</tbody>
								</table>
						</div>
						<div class="install-mobile-cards">
<%
	readyMobileRows = 0;
	for each  rinst in Installation_Schedules[Installation_Status == "Ready to Schedule"] sort by Priority_Sequence asc
	{
		if(readyMobileRows < 6)
		{
			readyMobileRows = readyMobileRows + 1;
			%>
<div class="install-work-card">
														<div class="zcs-flex zcs-justify-space-between zcs-gap-10"><strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=rinst.ID%>"><%=rinst.Installation_Code%></a></strong><span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green"><span class="zcs-badge-text zcs-font-12"><%=rinst.Installation_Status%></span></span></div>
														<div class="zcs-font-13 zcs-mt-8"><%=ifnull(rinst.Customer.Customer_Name,ifnull(rinst.Customer_Name_Snapshot,"Customer pending"))%> \u00B7 <%=ifnull(rinst.Area_or_City,"Location pending")%></div>
														<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Crew: <%=ifnull(rinst.Crew_Lead.Employee_Name,"Unassigned")%> \u00B7 Hours: <%=ifnull(rinst.Estimated_Hours,"Not set")%></div>
														<div class="install-action-group zcs-mt-10"><a class="zcs-button zcs-primary-outline-button install-action install-action-schedule zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=rinst.ID%>&New_Status=Scheduled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Scheduled</a><a class="zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=rinst.ID%>&New_Status=On%20Hold&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">On Hold</a><a class="zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=rinst.ID%>&New_Status=Cancelled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Cancelled</a></div>
												</div>
<%
		}
	}
	if(readyMobileRows == 0)
	{
		%>
<div class="install-work-card zcs-font-14 zcs-color-tertiary">No installations are currently ready to schedule.</div>
<%
	}
	%>
</div>
				</div>

				<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border">
						<h2 class="install-panel-title zcs-font-semibold">Quick links</h2>
						<div class="install-quick-grid">
								<a class="install-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:All_Installation_Schedules"><span class="install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline files-2-doc"></i></span><span><strong>All schedules</strong><br><span class="zcs-font-12 zcs-color-tertiary">Operational installation list</span></span></a>
								<a class="install-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:Installation_Calendar"><span class="install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-calendar-60"></i></span><span><strong>Calendar</strong><br><span class="zcs-font-12 zcs-color-tertiary">Scheduled start and end</span></span></a>
								<a class="install-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:Installation_Status_Board"><span class="install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-2-grid-45"></i></span><span><strong>Status board</strong><br><span class="zcs-font-12 zcs-color-tertiary">Grouped by progress</span></span></a>
								<a class="install-quick-card zcs-flex zcs-align-items-center zcs-gap-10" href="#Report:Ready_To_Schedule_Installations"><span class="install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center"><i class="zc-li-outline ui-1-check-circle-08"></i></span><span><strong>Ready queue</strong><br><span class="zcs-font-12 zcs-color-tertiary">Ready to schedule report</span></span></a>
						</div>
						<div class="zcs-card zcs-p-14 zcs-box-border" style="background:#FBFCFF; box-shadow:none;">
								<h3 class="zcs-font-16 zcs-font-semibold zcs-m-0">Status popup actions</h3>
								<p class="install-note zcs-font-13 zcs-mt-6 zcs-mb-0">Each work card links to Add Comments for Ready to Schedule, Scheduled, In Progress, Installed, Inspection Required, Inspection Completed, Completed, On Hold, and Cancelled. No report action buttons are used.</p>
						</div>
				</div>
		</section>

		<section class="install-two-col">
				<div class="install-panel zcs-card">
						<div class="install-panel-header">
								<div>
										<h2 class="install-panel-title zcs-font-semibold">Forecast queue in order-placement sequence</h2>
										<p class="install-note zcs-font-13 zcs-mt-4 zcs-mb-0">Sorted by installation priority sequence, which follows the order placement sequence established during order creation.</p>
								</div>
								<a class="install-panel-link" href="#Report:All_Installation_Schedules">All forecast records</a>
						</div>
						<div class="install-card-list">
<%
	forecastRows = 0;
	for each  f in Installation_Schedules[Installation_Status == "Forecast" || Installation_Status == "Waiting for Production"] sort by Priority_Sequence asc
	{
		if(forecastRows < 8)
		{
			forecastRows = forecastRows + 1;
			%>
<div class="install-work-card">
														<div class="zcs-flex zcs-justify-space-between zcs-gap-10">
																<div><strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=f.ID%>"><%=f.Installation_Code%></a></strong><div class="zcs-font-12 zcs-color-tertiary">Order <%=ifnull(f.Customer_Order.Order_Code,"Not linked")%> \u00B7 Placed <%=ifnull(f.Customer_Order.Order_Placement_Date,"Date pending")%></div></div>
																<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey"><span class="zcs-badge-text zcs-font-12"><%=f.Installation_Status%></span></span>
														</div>
														<div class="zcs-font-13 zcs-mt-8"><%=ifnull(f.Customer.Customer_Name,ifnull(f.Customer_Name_Snapshot,"Customer pending"))%> \u00B7 <%=ifnull(f.Area_or_City,"Location pending")%></div>
														<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Forecast date: <%=ifnull(f.Forecast_Date,"Not set")%> \u00B7 Priority: <%=ifnull(f.Priority_Sequence,"Not set")%></div>
														<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Production: <%=ifnull(f.Production_Readiness_Status,"Pending")%> \u00B7 Permit: <%=ifnull(f.Permit_Clearance_Status,"Pending")%></div>
												</div>
<%
		}
	}
	if(forecastRows == 0)
	{
		%>
<div class="install-work-card zcs-font-14 zcs-color-tertiary">No forecast installations are waiting in the queue.</div>
<%
	}
	%>
</div>
				</div>

				<div id="assigned-to-me" class="install-panel zcs-card">
						<div class="install-panel-header">
								<div>
										<h2 class="install-panel-title zcs-font-semibold">Assigned to me</h2>
										<p class="install-note zcs-font-13 zcs-mt-4 zcs-mb-0">Filtered where Crew Lead user email equals the signed-in user.</p>
								</div>
								<a class="install-panel-link" href="#Report:All_Installation_Schedules">Open schedule report</a>
						</div>
						<div class="install-card-list">
<%
	assignedRows = 0;
	for each  mine in Installation_Schedules[Crew_Lead.Email == zoho.loginuser && Installation_Status != "Completed" && Installation_Status != "Cancelled"] sort by Scheduled_Start asc
	{
		if(assignedRows < 6)
		{
			assignedRows = assignedRows + 1;
			badgeClass = "zcs-badge-blue";
			if(mine.Installation_Status == "Ready to Schedule")
			{
				badgeClass = "zcs-badge-green";
			}
			else if(mine.Installation_Status == "On Hold")
			{
				badgeClass = "zcs-badge-orange";
			}
			else if(mine.Installation_Status == "Inspection Required")
			{
				badgeClass = "zcs-badge-yellow";
			}
			%>
<div class="install-work-card">
														<div class="zcs-flex zcs-justify-space-between zcs-gap-10">
																<strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=mine.ID%>"><%=mine.Installation_Code%></a></strong>
																<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border <%=badgeClass%>"><span class="zcs-badge-text zcs-font-12"><%=mine.Installation_Status%></span></span>
														</div>
														<div class="zcs-font-13 zcs-mt-8"><%=ifnull(mine.Customer.Customer_Name,ifnull(mine.Customer_Name_Snapshot,"Customer pending"))%> \u00B7 <%=ifnull(mine.Area_or_City,"Location pending")%></div>
														<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Scheduled: <%=ifnull(mine.Scheduled_Start,"Not scheduled")%> to <%=ifnull(mine.Scheduled_End,"End not set")%></div>
														<div class="install-action-group zcs-mt-10">
																<a class="zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Ready%20to%20Schedule&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Ready to Schedule</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=In%20Progress&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">In Progress</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Installed&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Installed</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-inspect zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Inspection%20Required&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Inspection Required</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-inspect zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Inspection%20Completed&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Inspection Completed</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Completed&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Completed</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=On%20Hold&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">On Hold</a>
																<a class="zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=mine.ID%>&New_Status=Cancelled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Cancelled</a>
														</div>
												</div>
<%
		}
	}
	if(assignedRows == 0)
	{
		%>
<div class="install-work-card zcs-font-14 zcs-color-tertiary">No active installation schedules are assigned to your user email.</div>
<%
	}
	%>
</div>
				</div>
		</section>

		<section id="schedule-groups" class="install-panel zcs-card zcs-mt-16">
				<div class="install-panel-header">
						<div>
								<h2 class="install-panel-title zcs-font-semibold">Schedule cards grouped by date, location, and crew lead</h2>
								<p class="install-note zcs-font-13 zcs-mt-4 zcs-mb-0">Upcoming scheduled work grouped by scheduled date, area or city, and crew lead for planner review.</p>
						</div>
						<a class="install-panel-link" href="#Report:Installation_Calendar">Open calendar</a>
				</div>
				<div class="install-schedule-grid">
<%
	scheduledRows = 0;
	lastGroup = "";
	for each  sch in Installation_Schedules[Scheduled_Start != null && Installation_Status != "Completed" && Installation_Status != "Cancelled"] sort by Scheduled_Start asc
	{
		if(scheduledRows < 12)
		{
			scheduledRows = scheduledRows + 1;
			schDate = sch.Scheduled_Start.toString("dd-MMM-yyyy");
			schLocation = ifnull(sch.Area_or_City,"Location pending");
			schCrew = ifnull(sch.Crew_Lead.Employee_Name,"Crew unassigned");
			groupKey = schDate + " | " + schLocation + " | " + schCrew;
			if(groupKey != lastGroup)
			{
				lastGroup = groupKey;
				%>
<div class="install-group-header zcs-font-13 zcs-font-semibold" style="grid-column:1/-1;"><i class="zc-li-outline ui-1-calendar-60"></i> <%=groupKey%></div>
<%
			}
			%>
<div class="install-schedule-card" style="--schedule-color:#2A6FFC;">
												<div class="zcs-flex zcs-justify-space-between zcs-gap-10">
														<strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=sch.ID%>"><%=sch.Installation_Code%></a></strong>
														<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue"><span class="zcs-badge-text zcs-font-12"><%=sch.Installation_Status%></span></span>
												</div>
												<div class="zcs-font-13 zcs-mt-8"><%=ifnull(sch.Customer.Customer_Name,ifnull(sch.Customer_Name_Snapshot,"Customer pending"))%></div>
												<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4"><%=sch.Scheduled_Start%> to <%=ifnull(sch.Scheduled_End,"End not set")%></div>
												<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Hours: <%=ifnull(sch.Estimated_Hours,"Not set")%> \u00B7 QC: <%=ifnull(sch.Internal_QC_Status,"Not set")%></div>
												<div class="install-action-group zcs-mt-10">
														<a class="zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=sch.ID%>&New_Status=In%20Progress&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">In Progress</a>
														<a class="zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=sch.ID%>&New_Status=Installed&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Installed</a>
														<a class="zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=sch.ID%>&New_Status=Completed&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Completed</a>
												</div>
										</div>
<%
		}
	}
	if(scheduledRows == 0)
	{
		%>
<div class="install-work-card zcs-font-14 zcs-color-tertiary" style="grid-column:1/-1;">No scheduled installation cards are available.</div>
<%
	}
	%>
</div>
		</section>

		<section id="blocked-items" class="install-panel zcs-card zcs-mt-16">
				<div class="install-panel-header">
						<div>
								<h2 class="install-panel-title zcs-font-semibold">Blocked by production or permit</h2>
								<p class="install-note zcs-font-13 zcs-mt-4 zcs-mb-0">Shows installations blocked by production readiness or permit clearance. Order amount fields are not shown.</p>
						</div>
						<a class="install-panel-link" href="#Report:All_Installation_Schedules">Review all schedules</a>
				</div>
				<div class="install-card-list">
<%
	blockedRows = 0;
	for each  b in Installation_Schedules[Production_Readiness_Status == "Not Ready" || Production_Readiness_Status == "Partially Ready" || Permit_Clearance_Status == "Blocked" || Permit_Clearance_Status == "Required" || Permit_Clearance_Status == "Submitted" && Installation_Status != "Completed" && Installation_Status != "Cancelled"] sort by Priority_Sequence asc
	{
		if(blockedRows < 10)
		{
			blockedRows = blockedRows + 1;
			%>
<div class="install-work-card">
												<div class="zcs-flex zcs-justify-space-between zcs-gap-10">
														<strong><a class="install-row-link" href="#Page:Installation_Detail?Installation_ID=<%=b.ID%>"><%=b.Installation_Code%></a></strong>
														<span class="zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow"><span class="zcs-badge-text zcs-font-12"><%=b.Installation_Status%></span></span>
												</div>
												<div class="zcs-font-13 zcs-mt-8"><%=ifnull(b.Customer.Customer_Name,ifnull(b.Customer_Name_Snapshot,"Customer pending"))%> \u00B7 <%=ifnull(b.Area_or_City,"Location pending")%></div>
												<div class="zcs-font-12 zcs-mt-6"><span class="install-blocked-reason">Production:</span> <%=ifnull(b.Production_Readiness_Status,"Pending")%> \u00B7 <span class="install-blocked-reason">Permit:</span> <%=ifnull(b.Permit_Clearance_Status,"Pending")%></div>
												<div class="zcs-font-12 zcs-color-tertiary zcs-mt-4">Forecast: <%=ifnull(b.Forecast_Date,"Not set")%> \u00B7 Crew: <%=ifnull(b.Crew_Lead.Employee_Name,"Unassigned")%></div>
												<div class="install-action-group zcs-mt-10">
														<a class="zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=b.ID%>&New_Status=Ready%20to%20Schedule&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Ready to Schedule</a>
														<a class="zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=b.ID%>&New_Status=On%20Hold&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">On Hold</a>
														<a class="zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border" href="#Form:Action_Comments?Target_Module=Installation_Schedules&Lookup_ID=<%=b.ID%>&New_Status=Cancelled&Return_Page=Installation_Home&Return_URL=<%=returnUrl%>&zc_LoadIn=dialog">Cancelled</a>
												</div>
										</div>
<%
		}
	}
	if(blockedRows == 0)
	{
		%>
<div class="install-work-card zcs-font-14 zcs-color-tertiary">No active installations are blocked by production or permit.</div>
<%
	}
	%>
</div>
		</section>
</div>