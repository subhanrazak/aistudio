	pages
	{
		page Admin_Home
		{
					displayname = "Admin Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Admin_Home_Snippet' elementName='Admin_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Admin_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tactiveOrders = Customer_Orders[Order_Status != &quot;Completed&quot; &amp;&amp; Order_Status != &quot;Cancelled&quot;];\n\tawaitingGreen = Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;];\n\tproductionQueued = Production_Records[Production_Status == &quot;Queued&quot;];\n\tmaterialShortages = Production_Records[Production_Status == &quot;Material Shortage&quot; || Material_Status == &quot;Shortage Identified&quot;];\n\tpendingPOApprovals = Purchase_Orders[PO_Status == &quot;Submitted for Approval&quot;];\n\topenPOs = Purchase_Orders[PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;];\n\treadyInstallations = Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;];\n\tactivePermits = Permit_Records[Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot; &amp;&amp; Permit_Status != &quot;Expired&quot;];\n\topenServices = Service_Requests[Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;];\n\tlowMaterials = Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tlowPowders = Powder_Coating_Inventory[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tactiveOrdersCount = activeOrders.count();\n\tawaitingGreenCount = awaitingGreen.count();\n\tproductionQueuedCount = productionQueued.count();\n\tmaterialShortagesCount = materialShortages.count();\n\tpendingPOApprovalsCount = pendingPOApprovals.count();\n\topenPOsCount = openPOs.count();\n\treadyInstallationsCount = readyInstallations.count();\n\tactivePermitsCount = activePermits.count();\n\topenServicesCount = openServices.count();\n\tlowMaterialsCount = lowMaterials.count();\n\tlowPowdersCount = lowPowders.count();\n\ttotalOrdersCount = Customer_Orders[ID != 0].count();\n\ttotalProductionCount = Production_Records[ID != 0].count();\n\ttotalInstallationsCount = Installation_Schedules[ID != 0].count();\n\ttotalServicesCount = Service_Requests[ID != 0].count();\n\tordersInProductionCount = Customer_Orders[Order_Status == &quot;In Production&quot; || Order_Status == &quot;Material Hold&quot;].count();\n\tordersReadyCount = Customer_Orders[Order_Status == &quot;Ready for Installation&quot; || Order_Status == &quot;Installation Scheduled&quot; || Order_Status == &quot;Installed&quot; || Order_Status == &quot;Inspection Required&quot;].count();\n\tordersCompletedCount = Customer_Orders[Order_Status == &quot;Completed&quot;].count();\n\tprodInMotionCount = Production_Records[Production_Status == &quot;Manufacturing&quot; || Production_Status == &quot;Powder Coating&quot; || Production_Status == &quot;Material Ordered&quot; || Production_Status == &quot;Material Received&quot;].count();\n\tprodReadyCount = Production_Records[Production_Status == &quot;Ready for Installation&quot; || Production_Status == &quot;Purchased and Received&quot;].count();\n\tinstallScheduledCount = Installation_Schedules[Installation_Status == &quot;Scheduled&quot; || Installation_Status == &quot;In Progress&quot;].count();\n\tserviceUrgentCount = Service_Requests[Priority == &quot;Urgent&quot; &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;].count();\n\torderReadyPct = 0;\n\tif(activeOrdersCount &gt; 0)\n\t{\n\t\torderReadyPct = (ordersReadyCount * 100) / activeOrdersCount;\n\t}\n\tif(orderReadyPct &gt; 100)\n\t{\n\t\torderReadyPct = 100;\n\t}\n\tprodReadyPct = 0;\n\tif(totalProductionCount &gt; 0)\n\t{\n\t\tprodReadyPct = (prodReadyCount * 100) / totalProductionCount;\n\t}\n\tif(prodReadyPct &gt; 100)\n\t{\n\t\tprodReadyPct = 100;\n\t}\n\tinstallScheduledPct = 0;\n\tif(totalInstallationsCount &gt; 0)\n\t{\n\t\tinstallScheduledPct = (installScheduledCount * 100) / totalInstallationsCount;\n\t}\n\tif(installScheduledPct &gt; 100)\n\t{\n\t\tinstallScheduledPct = 100;\n\t}\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root {\n\t\t--zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC));\n\t\t--zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF);\n\t\t--zcs-page-bg-color: #F7F8FC;\n\t\t--zcs-primary-text-color: var(--zcs_primary_text_color, #12132B);\n\t\t--zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668);\n\t\t--zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191);\n\t\t--zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0);\n\t\t--zcs-white-color: #FFFFFF;\n\t\t--zcs-brand-soft: rgba(42, 111, 252, 0.10);\n\t\t--zcs-warning-soft: #FFF6E3;\n\t\t--zcs-danger-soft: #FFECEF;\n\t\t--zcs-success-soft: #EAFBF4;\n\t\t--zcs-info-soft: #EAF7FF;\n\t\tfont-size: 16px;\n\t\tline-height: 1.5;\n}\n#splash-screen { display: none !important; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16, 24, 40, .05); }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 720px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-green { color: #179E6C; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-red { color: #FE455D; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-yellow { color: #B8770D; }\n.zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-blue { color: #2A6FFC; }\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-progress-bar { height: 8px; background-color: var(--zcs-brand-soft); overflow: hidden; }\n.zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: var(--zcs-theme-brand-color); }\n.zcs-tl-indicator { width: 24px; left: 0; top: 0; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs-theme-brand-color); border: 2px solid #fff; box-shadow: 0 2px 6px rgba(42,111,252,.28); }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; position: absolute; width: 1px; height: calc(100% + 28px); background-color: #E1E5EE; top: 10px; }\n.admin-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 30%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.admin-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1B2E5F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31, 54, 112, .18); }\n.admin-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.admin-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.admin-eyebrow { letter-spacing: .08em; opacity: .78; }\n.admin-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.admin-subtitle { max-width: 820px; color: rgba(255,255,255,.82); margin: 0; }\n.admin-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 210px; backdrop-filter: blur(10px); }\n.admin-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.admin-kpi-card { padding: 16px; min-height: 128px; position: relative; overflow: hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.admin-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.admin-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.admin-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.admin-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.admin-kpi-label { color: var(--zcs-secondary-text-color); min-height: 40px; }\n.admin-kpi-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.admin-section-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, .8fr); gap: 16px; margin-top: 16px; }\n.admin-panel { padding: 18px; }\n.admin-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.admin-panel-title { margin: 0; font-size: 18px; }\n.admin-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; text-decoration: none; font-weight: 600; white-space: nowrap; }\n.admin-status-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.admin-status-card { background: #F9FAFE; border: 1px solid var(--zcs-border-color); border-radius: 14px; padding: 14px; }\n.admin-status-value { font-size: 24px; line-height: 1.1; margin: 8px 0 8px; }\n.admin-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.admin-pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 4px 9px; background: #F5F7FB; color: var(--zcs-secondary-text-color); font-size: 12px; }\n.admin-row-link { color: var(--zcs-theme-brand-color); text-decoration: none; font-weight: 600; }\n.admin-empty { border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 18px; background: #FBFCFF; color: var(--zcs-teritiary-text-color); }\n.admin-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.admin-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }\n.admin-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }\n.admin-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.admin-audit-list { max-height: 470px; overflow: auto; padding-right: 4px; }\n.admin-audit-body { padding-left: 34px; }\n.admin-line-clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n.admin-badge-soft { border-radius: 999px; padding: 3px 9px; font-size: 12px; font-weight: 600; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.admin-mobile-card-list { display: none; }\n@media (max-width: 1240px) { .admin-kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .admin-section-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .admin-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .admin-two-col { grid-template-columns: 1fr; } .admin-status-grid { grid-template-columns: 1fr; } .admin-hero-content { flex-direction: column; } .admin-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .admin-home-shell { padding: 12px; } .admin-hero { padding: 18px; border-radius: 18px; } .admin-kpi-grid { grid-template-columns: 1fr; } .admin-kpi-card { min-height: auto; } .admin-panel { padding: 14px; } .admin-quick-grid { grid-template-columns: 1fr; } .admin-table-wrap { display: none; } .admin-mobile-card-list { display: grid; gap: 10px; } .admin-mobile-record { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #fff; } .admin-panel-header { align-items: flex-start; flex-direction: column; } }\n&lt;/style&gt;\n&lt;div class=&quot;admin-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;admin-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Administrator workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;admin-title zcs-font-bold&quot;&gt;Admin Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;admin-subtitle zcs-font-15&quot;&gt;Cross-business overview for orders, production, purchasing, inventory, permits, installation, and service. Data is fetched in this single dashboard snippet.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;admin-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=activeOrdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Active orders&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Active_Orders&quot;&gt;Open report&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=awaitingGreenCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Awaiting green light&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Orders_Awaiting_Green_Light&quot;&gt;Review orders&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-64 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=productionQueuedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Production queued&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Production_Priority_Planner&quot;&gt;Planner&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=materialShortagesCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Material shortages&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:All_Production_Records?Production_Status=Material%20Shortage&quot;&gt;Inspect&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#F4660C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=pendingPOApprovalsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;a