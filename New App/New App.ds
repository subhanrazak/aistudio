					(
		    			type = datetime
						displayname = "Action Date"
						initial value = "${zoho.currenttime}"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 2
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
