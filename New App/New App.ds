						Crew_Lead
						Installation_Status
						Production_Readiness_Status
						Permit_Clearance_Status
						Internal_QC_Status
						Priority_Sequence
					)
					filters
					(
						Area_or_City
						Crew_Lead
						Installation_Status
						Production_Readiness_Status
