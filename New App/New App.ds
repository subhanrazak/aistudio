						values = {"Low","Normal","High","Urgent"}
						initial value = "Normal"
			 			row = 3
			 			column = 2   
						width = medium
					)
					Service_Status
					(
						type = picklist
						displayname = "Service Status"
						maxchar = 100
						values = {"New","Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"}
						initial value = "New"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Scheduled_Start
					(
		    			type = datetime
						displayname = "Scheduled Start"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 3
			 			column = 2   
						width = medium
					)
					Scheduled_End
					(
		    			type = datetime
						displayname = "Scheduled End"
						timedisplayoptions = "hh:mm:ss"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 3
			 			column = 1   
						width = medium
					)
					Technician
					(
						type = picklist	
						values  = Add_Employee.ID
		    			displayformat = [Employee_Name.first_name]
			 			row = 3
			 			column = 2   
						width = medium
					)
					Technician_Notes
					(
		    			type = textarea
						displayname = "Technician Notes"
						height = 120px
			 			row = 3
			 			column = 1   
						width = medium
					)
					Parts_Usage_Section
					(
						type = section
						displayname = "Parts Usage"
			 			row = 4
			 			column = 0   
						width = medium
					)
					Parts_Usage
					(
						type = grid
						displayname = "Parts Usage"
						values  = Service_Parts_Usage.ID
			 			row = 4
			 			column = 1   
						width = medium
					)
					Completion_Details
					(
						type = section
						displayname = "Completion Details"
						visibility = true
			 			row = 5
			 			column = 0   
						width = medium
					)
					Linked_PO
					(
						type = picklist	
						displayname = "Linked PO"
						values  = Purchase_Orders.ID
		    			displayformat = [PO_Number]
			 			row = 5
			 			column = 1   
						width = medium
					)
					Completion_Date
					(
		    			type = date
						displayname = "Completion Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 5
			 			column = 2   
						width = medium
					)
					Service_Photos
					(
		    			type = upload file
						displayname = "Service Photos"
		    			file count = 10
						browse = local_drive
			 			row = 5
			 			column = 1   
						width = medium
					)
					Stock_Consumption_Posted
					(
		    			type = checkbox
						displayname = "Stock Consumption Posted"
						initial value = false
			 			row = 5
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							Submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							Reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							Update
							(
		   						type = submit
		   						displayname = "Update"
							)
							Cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

