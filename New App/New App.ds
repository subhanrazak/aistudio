			Customer_Orders_On_Success as "Customer Orders On Success"
			{
			
							type =  form
							form = Customer_Orders
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														products_summary = "";
													permit_needed = input.Requires_Permit;
													priority_base = ifnull(input.Order_Code,0);
													for each  line_row in input.Line_Items
													{
														if(line_row.Product != null)
														{
															products_summary = products_summary + line_row.Product.Product_Name + " x " + ifnull(line_row.Quantity,0).toString() + "\n";
														}
														if(line_row.Permit_Required == true)
														{
															permit_needed = true;
														}
														group_key = "";
														if(line_row.Product != null)
														{
															group_key = line_row.Product.Product_Name;
														}
														if(line_row.Colour != null && line_row.Colour != "")
														{
															group_key = group_key + " - " + line_row.Colour;
														}
														prod_id = insert into Production_Records
														[
															Customer_Order=input.ID
															Order_Line=line_row.ID
															Product=line_row.Product
															Product_Description=line_row.Product_Description
															Colour=line_row.Colour
															Quantity=line_row.Quantity
															Unit=line_row.Unit
															Dimensions=ifnull(line_row.Width,0).toString() + " x " + ifnull(line_row.Height,0).toString()
															Manufacturing_Mode=line_row.Manufacturing_Mode
															Production_Status="Awaiting Green Light"
															Priority_Sequence=priority_base * 100 + ifnull(line_row.Line_Number,0)
															Suggested_Group_Key=group_key
															Requires_Powder_Coating=line_row.Requires_Powder_Coating
															Powder=line_row.Powder
															Powder_Qty_Used=line_row.Estimated_Powder_Qty
															Powder_Coating_Status=if(line_row.Requires_Powder_Coating == true,"Pending","Not Required")
															Material_Status="Not Checked"
															Added_User=zoho.loginuser
														];
														bom_rows = Product_BOM_Items[Product == line_row.Product && Active == true];
														for each  bom in bom_rows
														{
															est_qty = ifnull(bom.Quantity_Per_Unit,0) * ifnull(line_row.Quantity,0);
															if(ifnull(bom.Wastage_Percent,0) > 0)
															{
																est_qty = est_qty + est_qty * ifnull(bom.Wastage_Percent,0) / 100;
															}
															insert into Production_Material_Usage
															[
																Production_Record=prod_id
																Material=bom.Material
																Estimated_Quantity=est_qty
																Actual_Quantity=est_qty
																Unit=bom.Unit
																Stock_Deducted=false
																Added_User=zoho.loginuser
															]
														}
													}
													insert into Installation_Schedules
													[
														Customer_Order=input.ID
														Customer=input.Customer
														Customer_Name_Snapshot=input.Customer_Name_Snapshot
														Installation_Address=input.Installation_Address
														Area_or_City=input.Area_or_City
														Products_Summary=products_summary
														Forecast_Date=input.Expected_Delivery_Date
														Estimated_Hours=0
														Installation_Status="Forecast"
														Production_Readiness_Status="Not Ready"
														Permit_Clearance_Status=if(permit_needed == true,"Required","Not Required")
														Priority_Sequence=priority_base
														Added_User=zoho.loginuser
													]
													if(permit_needed == true)
													{
														insert into Permit_Records
														[
															Customer_Order=input.ID
															Customer=input.Customer
															Permit_Required=true
															Permit_Status="Required"
															Added_User=zoho.loginuser
														]
													}
									)
								}
							}
			
						
			}

			Validate_Customer_Orders as "Validate Customer Orders"
			{
			
							type =  form
							form = Customer_Orders
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Invoice_Date == null)
													{
														alert "Invoice date is required.";
														cancel submit;
													}
													if(input.Line_Items == null || input.Line_Items.count() == 0)
													{
														alert "At least one invoice line item is required.";
														cancel submit;
													}
													if(ifnull(input.Subtotal,0) < 0 || ifnull(input.Discount_Total,0) < 0 || ifnull(input.Tax_Total,0) < 0 || ifnull(input.Total_Amount,0) < 0)
													{
														alert "Invoice amounts cannot be negative.";
														cancel submit;
													}
													if(input.Requires_Permit == true)
													{
														input.Permit_Status = "Required";
													}
													if(input.Requires_Permit == false && input.Permit_Status == null)
													{
														input.Permit_Status = "Not Required";
													}
									)
								}
							}
			
						
			}

			Installation_Schedules_On_Load as "Installation Schedules On Load"
			{
			
							type =  form
							form = Installation_Schedules
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Installation_Status == "Scheduled" || input.Installation_Status == "In Progress" || input.Installation_Status == "Installed" || input.Installation_Status == "Inspection Required" || input.Installation_Status == "Inspection Completed" || input.Installation_Status == "Completed")
													{
														show Scheduled_Start;
														show Scheduled_End;
														show Estimated_Hours;
														show Crew_Lead;
													}
													else
													{
														hide Scheduled_Start;
														hide Scheduled_End;
														hide Crew_Lead;
													}
													if(input.Installation_Status == "Inspection Required" || input.Installation_Status == "Inspection Completed")
													{
														show Internal_QC_Status;
														show Internal_QC_Date;
													}
													else
													{
														hide Internal_QC_Status;
														hide Internal_QC_Date;
													}
									)
								}
							}
			
						
			}

			Installation_Schedules_On_Success as "Installation Schedules On Success"
			{
			
							type =  form
							form = Installation_Schedules
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														order_rec = Customer_Orders[ID == input.Customer_Order];
													if(order_rec.count() > 0)
													{
														if(input.Installation_Status == "Scheduled")
														{
															order_rec.Order_Status="Installation Scheduled";
														}
														else if(input.Installation_Status == "Installed")
														{
															order_rec.Order_Status="Installed";
														}
														else if(input.Installation_Status == "Inspection Required")
														{
															order_rec.Order_Status="Inspection Required";
														}
														else if(input.Installation_Status == "Completed")
														{
															order_rec.Order_Status="Completed";
														}
													}
													if(input.Installation_Status == "Inspection Completed" && input.Internal_QC_Date == null)
													{
														input.Internal_QC_Date = zoho.currentdate;
													}
									)
								}
							}
			
						
			}

			Installation_Schedules_On_Validate as "Installation Schedules On Validate"
			{
			
							type =  form
							form = Installation_Schedules
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														scheduled_or_later = input.Installation_Status == "Scheduled" || input.Installation_Status == "In Progress" || input.Installation_Status == "Installed" || input.Installation_Status == "Inspection Required" || input.Installation_Status == "Inspection Completed" || input.Installation_Status == "Completed";
													if(scheduled_or_later && input.Scheduled_Start == null || input.Scheduled_End == null || input.Crew_Lead == null)
													{
														alert "Scheduled start, scheduled end, and crew lead are required once installation is scheduled.";
														cancel submit;
													}
													if(input.Scheduled_Start != null && input.Scheduled_End != null && input.Scheduled_End <= input.Scheduled_Start)
													{
														alert "Scheduled end must be after scheduled start.";
														cancel submit;
													}
													if(ifnull(input.Estimated_Hours,0) < 0 || ifnull(input.Priority_Sequence,0) < 0)
													{
														alert "Estimated hours and priority cannot be negative.";
														cancel submit;
													}
													if(input.Installation_Status == "Completed" && input.Internal_QC_Required == true && input.Internal_QC_Status != "Passed")
													{
														alert "Internal QC must be passed before completing this installation.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

