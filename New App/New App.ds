	reports
	{
		default list All_Action_Comments
		{
		
					displayName = "All Action Comments"
					show all rows from Action_Comments    
					(
						Action_Code
						Target_Module
						Lookup_ID
						New_Status
						Submitted_By
						Action_Date
					)
					filters
					(
						Target_Module
						New_Status
						Submitted_By
					)
					sort by
					(
						Action_Date descending
					)
				
		}

		default list All_Approval_Setups
		{
		
					displayName = "All Approval Setups"
					show all rows from Add_Approval_Setup    
					(
						Approval_Setup_For as "Approval Setup For"
						Level_Name as "Level Name"
						Approver_Type as "Approver Type"
						Approver_Role as "Approver Role"
						Approver_Email as "Approver Email"
						Sequence_Order as "Sequence Order"
						Previous_Sequence_Number as "Previous Sequence Number"
						Is_Last_Step as "Is Last Step"
						Status
					)
					filters
					(
						Approval_Setup_For
						Approver_Type
						Status
					)
					sort by
					(
						Sequence_Order ascending
					)
				
		}

		list Active_Field_Employees
		{
		
					displayName = "Active Field Employees"
					show all rows from Add_Employee  [Active == true && Role == "Production" || Role == "Installation" || Role == "Service"]  
					(
						Employee_ID as "Employee ID"
						Employee_Name  as "Employee Name"
						Role
						Email
						Phone as "Mobile Number"
						Active
					)
					filters
					(
						Role
						Active
					)
					sort by
					(
						Employee_ID ascending
					)
				
		}

		default list All_Employees
		{
		
					displayName = "All Employees"
					show all rows from Add_Employee    
					(
						Profile_Image as "Profile Image"
						(
					dimension = thumbnail
						)
						Employee_Name  as "Employee Name"
						Employee_ID as "Employee ID"
						Email
						Phone as "Mobile Number"
						Gender
						Role
						Reporting_Manager as "Reporting Manager"
						Active
					)
					filters
					(
						Role
						Active
					)
					sort by
					(
						Employee_ID ascending
					)
				
		}

		default list All_Preferences
		{
		
					displayName = "All Preferences"
					show all rows from Add_Preference    
					(
						Organization_Logo as "Organization Logo"
						Email_Notification as "Email Notification"
						App_Notification as "App Notification"
					)
				
		}

		default list All_Roles
		{
		
					displayName = "All Roles"
					show all rows from Add_Role    
					(
						Role
					)
					sort by
					(
						Role ascending
					)
				
		}

		default list All_Users
		{
		
					displayName = "All Users"
					show all rows from Add_Users    
					(
						User_Email as "User Email"
						Profile
					)
				
		}

		default list Approval_Setup_For_Report
		{
		
					displayName = "Approval Setup For Report"
					show all rows from Approval_Setup_For    
					(
						Approval_Setup_For as "Approval Setup For"
					)
					sort by
					(
						Approval_Setup_For ascending
					)
				
		}

		default list Create_Template_Report
		{
		
					displayName = "All Mail Templates"
					show all rows from Create_Template    
					(
						Email_For as "Email For"
						Title
						Template_Subject as "Template Subject"
						Active
					)
					filters
					(
						Email_For
						Active
					)
					sort by
					(
						Email_For ascending
						Title ascending
					)
				
		}

		default list All_Customers
		{
		
					displayName = "All Customers"
					show all rows from Customer_Master    
					(
						Customer_Code
						Customer_Name
						Contact_Person
						Phone
						Email
						Area_or_City
						GST_or_Tax_Number
						Active
					)
					filters
					(
						Area_or_City
						Active
					)
					sort by
					(
						Customer_Name ascending
					)
				
		}

		list Active_Orders
		{
		
					displayName = "Active Orders"
					show all rows from Customer_Orders  [Order_Status != "Completed" && Order_Status != "Cancelled"]  
					(
						Order_Code
						Zoho_Books_Invoice_Number
						Customer
						Area_or_City
						Invoice_Date
						Order_Placement_Date
						Expected_Delivery_Date
						Requires_Permit
						Permit_Status
						Order_Status
						Total_Amount
					)
					filters
					(
						Customer
						Area_or_City
						Requires_Permit
						Permit_Status
						Order_Status
					)
					sort by
					(
						Order_Placement_Date ascending
					)
				
		}

		default list All_Customer_Orders
		{
		
					displayName = "All Customer Orders"
					show all rows from Customer_Orders    
					(
						Order_Code
						Zoho_Books_Invoice_Number
						Customer
						Area_or_City
						Invoice_Date
						Order_Placement_Date
						Expected_Delivery_Date
						Requires_Permit
						Permit_Status
						Order_Status
						Total_Amount
					)
					filters
					(
						Customer
						Area_or_City
						Requires_Permit
						Permit_Status
						Order_Status
					)
					sort by
					(
						Order_Placement_Date ascending
					)
				
		}

		calendar Order_Delivery_Calendar
		{
		
					displayName = "Order Delivery Calendar"
					show all rows from Customer_Orders    
					(
						Order_Code
						Customer
						Expected_Delivery_Date
						Order_Status
						Area_or_City
					)
					filters
					(
						Customer
						Order_Status
						Area_or_City
					)
					options
					(
						week start day = monday
						display field = Order_Code
						start date = Expected_Delivery_Date
					)
				
		}

		list Orders_Awaiting_Green_Light
		{
		
					displayName = "Orders Awaiting Green Light"
					show all rows from Customer_Orders  [Order_Status == "Awaiting Green Light"]  
					(
						Order_Code
						Zoho_Books_Invoice_Number
						Customer
						Area_or_City
						Invoice_Date
						Order_Placement_Date
						Expected_Delivery_Date
						Requires_Permit
						Permit_Status
						Order_Status
						Total_Amount
					)
					filters
					(
						Customer
						Area_or_City
						Requires_Permit
						Permit_Status
						Order_Status
					)
					sort by
					(
						Order_Placement_Date ascending
					)
				
		}

		default list All_Installation_Schedules
		{
		
					displayName = "All Installation Schedules"
					show all rows from Installation_Schedules    
					(
						Installation_Code
						Customer_Order
						Customer
						Area_or_City
						Forecast_Date
						Scheduled_Start
						Scheduled_End
						Estimated_Hours
						Crew_Lead
						Installation_Status
						Production_Readiness_Status
						Permit_Clearance_Status
						Internal_QC_Status
						Priority_Sequence
					)
					filters
					(
						Area_or_City
						Crew_Lead
						Installation_Status
						Production_Readiness_Status
						Permit_Clearance_Status
					)
					sort by
					(
						Priority_Sequence ascending
					)
				
		}

		calendar Installation_Calendar
		{
		
					displayName = "Installation Calendar"
					show all rows from Installation_Schedules  [Scheduled_Start is not null]  
					(
						Installation_Code
						Customer_Order
						Area_or_City
						Scheduled_Start
						Scheduled_End
						Crew_Lead
						Installation_Status
					)
					filters
					(
						Area_or_City
						Crew_Lead
						Installation_Status
					)
					options
					(
						week start day = monday
						display field = Installation_Code
						start date = Scheduled_Start
						end date = Scheduled_End
					)
				
		}

		kanban Installation_Status_Board
		{
		
					displayName = "Installation Status Board"
					show all rows from Installation_Schedules    
					(
						Installation_Code
						Customer_Order
						Area_or_City
						Scheduled_Start
						Crew_Lead
						Installation_Status
						Production_Readiness_Status
						Permit_Clearance_Status
						Priority_Sequence
					)
					filters
					(
						Area_or_City
						Crew_Lead
						Installation_Status
						Production_Readiness_Status
						Permit_Clearance_Status
					)
					sort by
					(
						Priority_Sequence ascending
					)
					options
					(
			 			display field = Installation_Status
			 			emptycolumn = "No Status"
						sort order  = ascending
						record count  = enable
			 		)
				
		}

		list Ready_To_Schedule_Installations
		{
		
					displayName = "Ready To Schedule Installations"
