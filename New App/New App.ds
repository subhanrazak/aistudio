			Customer_On_User_Input as "Customer On User Input"
			{
			
							type =  form
							form = Service_Requests
			
							record event = on add or edit
			
							on user input of Customer
							{
								actions 
								{
									custom deluge script
									(
														if(input.Customer != null)
													{
														input.Customer_Name = input.Customer.Customer_Name;
														input.Phone = input.Customer.Phone;
														input.Email = input.Customer.Email;
														input.Service_Address.address_line_1 = input.Customer.Installation_Address.address_line_1;
														input.Service_Address.address_line_2 = input.Customer.Installation_Address.address_line_2;
														input.Service_Address.district_city = input.Customer.Installation_Address.district_city;
														input.Service_Address.state_province = input.Customer.Installation_Address.state_province;
														input.Service_Address.postal_Code = input.Customer.Installation_Address.postal_Code;
														input.Service_Address.country = input.Customer.Installation_Address.country;
														input.Service_Address.latitude = input.Customer.Installation_Address.latitude;
														input.Service_Address.longitude = input.Customer.Installation_Address.longitude;
													}
									)
								}
							}
			
						
			}

			Service_Requests_On_Load as "Service Requests On Load"
			{
			
							type =  form
							form = Service_Requests
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														schedule_stage = input.Service_Status == "Scheduled" || input.Service_Status == "In Progress" || input.Service_Status == "Parts Required" || input.Service_Status == "Repaired" || input.Service_Status == "Completed" || input.Service_Status == "Closed";
													parts_stage = input.Service_Status == "Parts Required" || input.Service_Status == "Repaired" || input.Service_Status == "Completed" || input.Service_Status == "Closed";
													completion_stage = input.Service_Status == "Completed" || input.Service_Status == "Closed";
													if(schedule_stage)
													{
														show Scheduled_Start;
														show Scheduled_End;
														show Technician;
													}
													else
													{
														hide Scheduled_Start;
														hide Scheduled_End;
														hide Technician;
													}
													if(parts_stage)
													{
														show Parts_Usage;
														show Linked_PO;
													}
													else
													{
														hide Parts_Usage;
														hide Linked_PO;
													}
													if(completion_stage)
													{
														show Completion_Date;
														show Service_Photos;
													}
													else
													{
														hide Completion_Date;
														hide Service_Photos;
													}
									)
								}
							}
			
						
			}

			Service_Requests_On_Success as "Service Requests On Success"
			{
			
							type =  form
							form = Service_Requests
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Service_Status == "Completed" || input.Service_Status == "Closed" && input.Completion_Date == null)
													{
														input.Completion_Date = zoho.currentdate;
													}
													if(input.Service_Status == "Completed" || input.Service_Status == "Closed" && input.Stock_Consumption_Posted == false)
													{
														for each  part_row in input.Parts_Usage
														{
															if(part_row.Material != null && ifnull(part_row.Quantity_Used,0) > 0 && part_row.Stock_Deducted == false)
															{
																mat_rec = Material_Master[ID == part_row.Material];
																if(mat_rec.count() > 0)
																{
																	mat_rec.Available_Quantity=ifnull(mat_rec.Available_Quantity,0) - ifnull(part_row.Quantity_Used,0);
																	mat_rec.Last_Updated=zoho.currentdate;
																	part_row.Stock_Deducted=true;
																}
															}
														}
														input.Stock_Consumption_Posted = true;
													}
									)
								}
							}
			
						
			}

			Service_Requests_On_Validate as "Service Requests On Validate"
			{
			
							type =  form
							form = Service_Requests
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														scheduled_or_active = input.Service_Status == "Scheduled" || input.Service_Status == "In Progress" || input.Service_Status == "Parts Required" || input.Service_Status == "Repaired" || input.Service_Status == "Completed" || input.Service_Status == "Closed";
													if(scheduled_or_active && input.Scheduled_Start == null || input.Technician == null)
													{
														alert "Scheduled start and technician are required once service is scheduled.";
														cancel submit;
													}
													if(input.Scheduled_Start != null && input.Scheduled_End != null && input.Scheduled_End <= input.Scheduled_Start)
													{
														alert "Scheduled end must be after scheduled start.";
														cancel submit;
													}
													if(input.Service_Status == "Completed" || input.Service_Status == "Closed" && input.Technician_Notes == null || input.Technician_Notes == "" || input.Completion_Date == null)
													{
														alert "Technician notes and completion date are required before completing or closing service.";
														cancel submit;
													}
													if(input.Service_Status == "Completed" || input.Service_Status == "Closed" && input.Stock_Consumption_Posted == false)
													{
														for each  part_row in input.Parts_Usage
														{
															if(part_row.Material != null && ifnull(part_row.Quantity_Used,0) > ifnull(part_row.Material.Available_Quantity,0) && part_row.Stock_Deducted == false)
															{
																alert "Insufficient stock for service part: " + part_row.Material.Material_Name;
																cancel submit;
															}
														}
													}
									)
								}
							}
			
						
			}

			Service_Status_On_User_Input as "Service Status On User Input"
			{
			
							type =  form
							form = Service_Requests
			
							record event = on add or edit
			
							on user input of Service_Status
							{
								actions 
								{
									custom deluge script
									(
														schedule_stage = input.Service_Status == "Scheduled" || input.Service_Status == "In Progress" || input.Service_Status == "Parts Required" || input.Service_Status == "Repaired" || input.Service_Status == "Completed" || input.Service_Status == "Closed";
													parts_stage = input.Service_Status == "Parts Required" || input.Service_Status == "Repaired" || input.Service_Status == "Completed" || input.Service_Status == "Closed";
													completion_stage = input.Service_Status == "Completed" || input.Service_Status == "Closed";
													if(schedule_stage)
													{
														show Scheduled_Start;
														show Scheduled_End;
														show Technician;
													}
													else
													{
														hide Scheduled_Start;
														hide Scheduled_End;
														hide Technician;
													}
													if(parts_stage)
													{
														show Parts_Usage;
														show Linked_PO;
													}
													else
													{
														hide Parts_Usage;
														hide Linked_PO;
													}
													if(completion_stage)
													{
														show Completion_Date;
														show Service_Photos;
													}
													else
													{
														hide Completion_Date;
														hide Service_Photos;
													}
									)
								}
							}
			
						
			}

			Set_Queue_Position_On_Load as "Set Queue Position On Load"
			{
			
							type =  form
							form = Set_Queue_Position
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Line_Item_ID;
													disable Queue_Type;
									)
								}
							}
			
						
			}

			Update_Queue_Position as "Update Queue Position"
			{
			
							type =  form
							form = Set_Queue_Position
							button = Submit_Queue
							on click
							{
								actions 
								{
								on click
								(
									if(input.Line_Item_ID == null)
													{
														alert "No order line was selected.";
													}
													else if(input.Queue_Number == null || input.Queue_Number < 0)
													{
														alert "Enter a valid queue number.";
													}
													else
													{
														line_rec = Order_Line_Items[ID == input.Line_Item_ID];
														if(line_rec.count() == 0)
														{
															alert "Selected order line was not found.";
														}
														else
														{
															if(input.Queue_Type == "Production")
															{
																line_rec.Production_Queue_No=input.Queue_Number;
															}
															else if(input.Queue_Type == "Installation")
															{
																line_rec.Installation_Queue_No=input.Queue_Number;
															}
															alert "Queue position updated.";
															openUrl("#Script:page.parent.refresh","same window");
														}
													}
								)
								}
							}
						
			}

			Validate_Staff_Master as "Validate Staff Master"
			{
			
							type =  form
							form = Staff_Master
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.User_Email != null && input.User_Email != "")
													{
														duplicate_staff = Staff_Master[User_Email == input.User_Email && Active == true && ID != input.ID];
														if(duplicate_staff.count() > 0)
														{
															alert "Another active staff member already uses this user email.";
															cancel submit;
														}
													}
									)
								}
							}
			
						
			}
		}

		functions
		{
			Open_Set_Installation_Queue_Position as "Open Set Installation Queue Position"
			{
			
							type =  functions
							form = Order_Line_Items
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									queue_no = ifnull(input.Installation_Queue_No,0);
													openUrl("#Form:Set_Queue_Position?Line_Item_ID=" + input.ID + "&Queue_Type=Installation&Queue_Number=" + queue_no + "&zc_LoadIn=dialog","same window");
								)
								}
							}
						
			}

			Open_Set_Production_Queue_Position as "Open Set Production Queue Position"
			{
			
							type =  functions
							form = Order_Line_Items
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									queue_no = ifnull(input.Production_Queue_No,0);
													openUrl("#Form:Set_Queue_Position?Line_Item_ID=" + input.ID + "&Queue_Type=Production&Queue_Number=" + queue_no + "&zc_LoadIn=dialog","same window");
								)
								}
							}
						
			}
		}
	}

