;&gt;&lt;%=activePermitsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Active permits&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Active_Permits&quot;&gt;Permit queue&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-chat-round-content zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=openServicesCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Open service requests&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;Service desk&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-box zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=lowMaterialsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Low raw material stock&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Low_Material_Stock&quot;&gt;Stock list&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;admin-kpi-card zcs-card&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-palette zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-value zcs-font-bold&quot;&gt;&lt;%=lowPowdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-kpi-label zcs-font-13&quot;&gt;Low powder stock&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;admin-kpi-link&quot; href=&quot;#Report:Low_Powder_Stock&quot;&gt;Powder list&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;admin-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Pipeline and readiness&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-panel-link&quot; href=&quot;#Report:All_Customer_Orders&quot;&gt;All customer orders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-status-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Orders ready path&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-badge-soft&quot;&gt;&lt;%=orderReadyPct%&gt;%&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-value zcs-font-bold&quot;&gt;&lt;%=ordersReadyCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=orderReadyPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;Ready, scheduled, installed, or in inspection out of active orders&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Production ready&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-badge-soft&quot;&gt;&lt;%=prodReadyPct%&gt;%&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-value zcs-font-bold&quot;&gt;&lt;%=prodReadyCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=prodReadyPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;Ready for installation or purchased and received&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-align-items-center&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Installations active&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-badge-soft&quot;&gt;&lt;%=installScheduledPct%&gt;%&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-status-value zcs-font-bold&quot;&gt;&lt;%=installScheduledCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-progress-bar zcs-rounded-sm&quot;&gt;&lt;div class=&quot;zcs-progress-bar-indicator&quot; style=&quot;width:&lt;%=installScheduledPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-12 zcs-font-medium zcs-lh-body zcs-color-secondary zcs-m-0&quot;&gt;Scheduled or in progress out of installation records&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-pill&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt; Total orders &lt;strong&gt;&lt;%=totalOrdersCount%&gt;&lt;/strong&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-64&quot;&gt;&lt;/i&gt; In production &lt;strong&gt;&lt;%=ordersInProductionCount%&gt;&lt;/strong&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt; Production in motion &lt;strong&gt;&lt;%=prodInMotionCount%&gt;&lt;/strong&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;admin-pill&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt; Urgent services &lt;strong&gt;&lt;%=serviceUrgentCount%&gt;&lt;/strong&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Quick links&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-quick-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Customer_Orders&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Orders&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;All orders and invoices&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Production_Status_Board&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-settings-gear-64&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Production board&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Status by production item&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Open_Purchase_Orders&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline e-commerce-shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Purchasing&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Open purchase orders&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Low_Material_Stock&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-box&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Raw stock&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Low material stock&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Low_Powder_Stock&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-palette&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Powder stock&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Low powder list&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Installation_Status_Board&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Installation&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Status board&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Active_Permits&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Permits&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Active permit queue&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;&lt;span class=&quot;admin-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-chat-round-content&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Service&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Open service requests&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;admin-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Attention queue&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-panel-link&quot; href=&quot;#Report:All_Production_Records&quot;&gt;All production records&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Reference&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Open&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tattentionRows = 0;\n\tfor each  ord in Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;] sort by Order_Placement_Date asc\n\t{\n\t\tif(attentionRows &lt; 4)\n\t\t{\n\t\t\tattentionRows = attentionRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Order&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ord.Order_Code%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(ord.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Awaiting Green Light&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;admin-row-link&quot; href=&quot;#Page:Order_Detail?Order_ID=&lt;%=ord.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tfor each  prod in Production_Records[Production_Status == &quot;Material Shortage&quot; || Material_Status == &quot;Shortage Identified&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(attentionRows &lt; 8)\n\t\t{\n\t\t\tattentionRows = attentionRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;Production&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=prod.Production_Code%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(prod.Product.Product_Name,&quot;Production item&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=prod.Production_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;admin-row-link&quot; href=&quot;#Page:Production_Detail?Production_ID=&lt;%=prod.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tfor each  po in Purchase_Orders[PO_Status == &quot;Submitted for Approval&quot;] sort by PO_Date asc\n\t{\n\t\tif(attentionRows &lt; 10)\n\t\t{\n\t\t\tattentionRows = attentionRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;PO&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=po.PO_Number%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(po.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Submitted for Approval&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;admin-row-link&quot; href=&quot;#Page:Purchase_Order_Detail?PO_ID=&lt;%=po.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(attentionRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No current high-priority attention items.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mobile-card-list&quot;&gt;\n&lt;%\n\tmobileRows = 0;\n\tfor each  mord in Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;] sort by Order_Placement_Date asc\n\t{\n\t\tif(mobileRows &lt; 3)\n\t\t{\n\t\t\tmobileRows = mobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;admin-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;Order &lt;%=mord.Order_Code%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-yellow zcs-font-12&quot;&gt;Awaiting&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(mord.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;a class=&quot;admin-row-link zcs-font-13&quot; href=&quot;#Page:Order_Detail?Order_ID=&lt;%=mord.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tfor each  mprod in Production_Records[Production_Status == &quot;Material Shortage&quot; || Material_Status == &quot;Shortage Identified&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(mobileRows &lt; 6)\n\t\t{\n\t\t\tmobileRows = mobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;admin-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;Production &lt;%=mprod.Production_Code%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-red zcs-font-12&quot;&gt;Shortage&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(mprod.Product.Product_Name,&quot;Production item&quot;)%&gt;&lt;/div&gt;&lt;a class=&quot;admin-row-link zcs-font-13&quot; href=&quot;#Page:Production_Detail?Production_ID=&lt;%=mprod.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(mobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;admin-empty&quot;&gt;No current high-priority attention items.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;admin-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Ready and blocked work&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-panel-link&quot; href=&quot;#Report:Ready_To_Schedule_Installations&quot;&gt;Ready installations&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\treadyRows = 0;\n\tfor each  inst in Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(readyRows &lt; 4)\n\t\t{\n\t\t\treadyRows = readyRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;admin-status-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=inst.Installation_Code%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-green zcs-font-12 zcs-font-semibold&quot;&gt;Ready to Schedule&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(inst.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt; - &lt;%=ifnull(inst.Area_or_City,&quot;Area pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Production: &lt;%=inst.Production_Readiness_Status%&gt; - Permit: &lt;%=inst.Permit_Clearance_Status%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-row-link zcs-font-13&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=inst.ID%&gt;&quot;&gt;Open installation detail&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(readyRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;admin-empty&quot;&gt;No installation records are currently ready to schedule.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;admin-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;admin-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Low stock watch&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-panel-link&quot; href=&quot;#Report:All_Materials&quot;&gt;All materials&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Item&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Available&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Reorder&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Open&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tstockRows = 0;\n\tfor each  mat in Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true] sort by Material_Name asc\n\t{\n\t\tif(stockRows &lt; 5)\n\t\t{\n\t\t\tstockRows = stockRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=mat.Material_Name%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Raw material&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-red&quot;&gt;&lt;%=mat.Available_Quantity%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14&quot;&gt;&lt;%=mat.Reorder_Level%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;admin-row-link&quot; href=&quot;#Page:Inventory_Detail?Item_Type=Material&amp;Item_ID=&lt;%=mat.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tfor each  pow in Powder_Coating_Inventory[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true] sort by Powder_Name asc\n\t{\n\t\tif(stockRows &lt; 10)\n\t\t{\n\t\t\tstockRows = stockRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=pow.Powder_Name%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Powder - &lt;%=pow.Colour_Family%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14 zcs-red&quot;&gt;&lt;%=pow.Available_Quantity%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right zcs-font-14&quot;&gt;&lt;%=pow.Reorder_Level%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-text-right&quot;&gt;&lt;a class=&quot;admin-row-link&quot; href=&quot;#Page:Inventory_Detail?Item_Type=Powder&amp;Item_ID=&lt;%=pow.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(stockRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No material or powder stock is below reorder level.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-mobile-card-list&quot;&gt;\n&lt;%\n\tstockMobileRows = 0;\n\tfor each  smat in Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true] sort by Material_Name asc\n\t{\n\t\tif(stockMobileRows &lt; 4)\n\t\t{\n\t\t\tstockMobileRows = stockMobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;admin-mobile-record&quot;&gt;&lt;strong&gt;&lt;%=smat.Material_Name%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Available &lt;%=smat.Available_Quantity%&gt; - Reorder &lt;%=smat.Reorder_Level%&gt;&lt;/div&gt;&lt;a class=&quot;admin-row-link zcs-font-13&quot; href=&quot;#Page:Inventory_Detail?Item_Type=Material&amp;Item_ID=&lt;%=smat.ID%&gt;&quot;&gt;Details&lt;/a&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(stockMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;admin-empty&quot;&gt;No low stock items.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;admin-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;admin-panel-title zcs-font-semibold&quot;&gt;Recent audit feed&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;admin-panel-link&quot; href=&quot;#Report:All_Action_Comments&quot;&gt;All comments&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;admin-audit-list zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-24 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\tauditRows = 0;\n\tfor each  note in Action_Comments[ID != 0] sort by Action_Date desc\n\t{\n\t\tif(auditRows &lt; 7)\n\t\t{\n\t\t\tauditRows = auditRows + 1;\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-relative&quot; style=&quot;list-style:none; min-height:72px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-4 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;admin-audit-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=note.Target_Module%&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=note.New_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=note.Action_Date%&gt; - &lt;%=note.Submitted_By%&gt; - Record &lt;%=note.Lookup_ID%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;admin-line-clamp zcs-font-13 zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=note.Comments%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/li&gt;\n&lt;%\n\t\t}\n\t}\n\tif(auditRows == 0)\n\t{\n\t\t%&gt;\n&lt;li class=&quot;admin-empty&quot; style=&quot;list-style:none;&quot;&gt;No Action Comments have been submitted yet.&lt;/li&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Installation_Detail(int Installation_ID)
		{
					displayname = "Installation Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Installation_Detail_Snippet' elementName='Installation_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Installation_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tinst_rec = Installation_Schedules[ID == input.Installation_ID];\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\na { text-decoration: none; }\n.install-detail-page, .install-detail-page * { box-sizing: border-box; }\n.install-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zc-font-family, &quot;Poppins&quot;, &quot;Zoho Puvi&quot;, Arial, sans-serif); padding: 24px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-5 { margin-top: .3125rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-green { color: #179e6c; }\n.zcs-red { color: #fe455d; }\n.zcs-yellow { color: #b8770d; }\n.zcs-l_blue { color: #1094c5; }\n.zcs-blue { color: #09598e; }\n.zcs-d_blue { color: #1328cd; }\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }\n.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }\n.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }\n.zcs-fw-button { width: 100%; }\n.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }\n.zcs-tl-icon { width: 35px; height: 35px; background-color: #F5F4FA; color: #4B4274; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }\n.zcs-tl-li-active .zcs-tl-icon { background-color: #E8EFFF; color: #2A6FFC; }\n.zcs-tl-li-complete .zcs-tl-icon { background-color: #E4FCF3; color: #179E6C; }\n.detail-shell { max-width: 1440px; margin: 0 auto; }\n.detail-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }\n.detail-hero:after { content: &apos;&apos;; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }\n.detail-hero-main, .detail-hero-side { position: relative; z-index: 1; }\n.detail-hero-main { min-width: 280px; flex: 1 1 620px; }\n.detail-hero-side { flex: 0 1 360px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }\n.detail-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }\n.detail-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }\n.detail-hero-subtitle { color: rgba(255,255,255,.78); max-width: 820px; margin: 8px 0 0; }\n.detail-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n.detail-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }\n.detail-action-ready { background: #179E6C; }\n.detail-action-progress { background: #2A6FFC; }\n.detail-action-inspection { background: #8200DB; }\n.detail-action-hold { background: #F4660C; }\n.detail-action-cancel { background: #FE455D; }\n.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }\n.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }\n.detail-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }\n.detail-card-body { padding: 18px 20px; }\n.detail-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }\n.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.detail-span-12 { grid-column: span 12; }\n.detail-span-8 { grid-column: span 8; }\n.detail-span-6 { grid-column: span 6; }\n.detail-span-4 { grid-column: span 4; }\n.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }\n.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }\n.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }\n.link-list { display: flex; flex-direction: column; gap: 10px; }\n.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }\n.detail-link:hover, .row-link:hover { text-decoration: underline; }\n.blocker-list { display: grid; gap: 10px; }\n.blocker { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }\n.blocker i { margin-top: 2px; }\n.blocker-ok { background: var(--zcs-success-soft); border-color: #BEEBD7; color: #176B4B; }\n.blocker-warn { background: var(--zcs-warning-soft); border-color: #FFE0A3; color: #8A5A00; }\n.blocker-danger { background: var(--zcs-danger-soft); border-color: #FFC3CC; color: #8B1B2B; }\n.products-summary { white-space: pre-wrap; word-break: break-word; padding: 16px; border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; }\n.photo-box { border: 1px dashed var(--zcs-border-color); border-radius: 16px; padding: 18px; background: #FBFCFF; word-break: break-word; }\n.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }\n.comment-text { white-space: pre-wrap; word-break: break-word; }\n.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }\n.mobile-stack { display: none; }\n@media (max-width: 1100px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 768px) { .install-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .detail-hero { padding: 18px; } .detail-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .link-row { flex-direction: column; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;install-detail-page&quot;&gt;\n\t&lt;div class=&quot;detail-shell&quot;&gt;\n&lt;%\n\tif(inst_rec.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot; style=&quot;min-height:60vh;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border detail-card&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Installation not found&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;No Installation_Schedules record matched Installation_ID &lt;%=input.Installation_ID%&gt;.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\torder_rec = Customer_Orders[ID == inst_rec.Customer_Order];\n\t\tproductionRecords = Production_Records[Customer_Order == inst_rec.Customer_Order];\n\t\tpermitRecords = Permit_Records[Customer_Order == inst_rec.Customer_Order];\n\t\tprodCount = productionRecords.count();\n\t\treadyCount = Production_Records[Customer_Order == inst_rec.Customer_Order &amp;&amp; Production_Status == &quot;Ready for Installation&quot; || Production_Status == &quot;Purchased and Received&quot;].count();\n\t\tblockedProdCount = prodCount - readyCount;\n\t\topenPermitCount = Permit_Records[Customer_Order == inst_rec.Customer_Order &amp;&amp; Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot;].count();\n\t\tscheduleSet = false;\n\t\tif(inst_rec.Scheduled_Start != null &amp;&amp; inst_rec.Scheduled_End != null &amp;&amp; inst_rec.Crew_Lead != null)\n\t\t{\n\t\t\tscheduleSet = true;\n\t\t}\n\t\tqcClear = true;\n\t\tif(inst_rec.Internal_QC_Required == true &amp;&amp; inst_rec.Internal_QC_Status != &quot;Passed&quot; &amp;&amp; inst_rec.Internal_QC_Status != &quot;Not Required&quot;)\n\t\t{\n\t\t\tqcClear = false;\n\t\t}\n\t\tblockerCount = 0;\n\t\tif(inst_rec.Production_Readiness_Status != &quot;Ready&quot;)\n\t\t{\n\t\t\tblockerCount = blockerCount + 1;\n\t\t}\n\t\tif(!(inst_rec.Permit_Clearance_Status == &quot;Approved&quot; || inst_rec.Permit_Clearance_Status == &quot;Not Required&quot;))\n\t\t{\n\t\t\tblockerCount = blockerCount + 1;\n\t\t}\n\t\tif(inst_rec.Installation_Status == &quot;Scheduled&quot; || inst_rec.Installation_Status == &quot;In Progress&quot; || inst_rec.Installation_Status == &quot;Installed&quot; || inst_rec.Installation_Status == &quot;Inspection Required&quot; || inst_rec.Installation_Status == &quot;Inspection Completed&quot; || inst_rec.Installation_Status == &quot;Completed&quot;)\n\t\t{\n\t\t\tif(scheduleSet == false)\n\t\t\t{\n\t\t\t\tblockerCount = blockerCount + 1;\n\t\t\t}\n\t\t}\n\t\tif(qcClear == false)\n\t\t{\n\t\t\tblockerCount = blockerCount + 1;\n\t\t}\n\t\tinstStatusClass = &quot;zcs-badge-blue&quot;;\n\t\tif(inst_rec.Installation_Status == &quot;Completed&quot; || inst_rec.Installation_Status == &quot;Installed&quot; || inst_rec.Installation_Status == &quot;Inspection Completed&quot;)\n\t\t{\n\t\t\tinstStatusClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(inst_rec.Installation_Status == &quot;Cancelled&quot;)\n\t\t{\n\t\t\tinstStatusClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(inst_rec.Installation_Status == &quot;On Hold&quot;)\n\t\t{\n\t\t\tinstStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(inst_rec.Installation_Status == &quot;Forecast&quot; || inst_rec.Installation_Status == &quot;Waiting for Production&quot; || inst_rec.Installation_Status == &quot;Ready to Schedule&quot;)\n\t\t{\n\t\t\tinstStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\treturnUrl = &quot;%23Page%3AInstallation_Detail%3FInstallation_ID%3D&quot; + inst_rec.ID;\n\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;a href=&quot;#Page:Installation_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Installation Detail&lt;/h5&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=inst_rec.Installation_Code%&gt; - &lt;%=ifnull(inst_rec.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Installation_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Installation Home&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\torderUrl = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=orderUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-single&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Order&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;section class=&quot;detail-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-hero-main&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Schedule, readiness, crew, QC, and completion&lt;/div&gt;\n\t\t\t\t\t&lt;h1 class=&quot;detail-hero-title&quot;&gt;&lt;%=ifnull(inst_rec.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&quot;detail-hero-subtitle&quot;&gt;&lt;%=inst_rec.Installation_Code%&gt; is currently &lt;%=inst_rec.Installation_Status%&gt;. Production readiness, permit clearance, schedule, crew lead, QC, photos, and comments are shown below.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=instStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=inst_rec.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(inst_rec.Production_Readiness_Status == &quot;Ready&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline design-2-ungroup&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Production: &lt;%=inst_rec.Production_Readiness_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(inst_rec.Permit_Clearance_Status == &quot;Approved&quot; || inst_rec.Permit_Clearance_Status == &quot;NotRequired&quot;,&quot;zcs-badge-green&quot;,&quot;zcs-badge-yellow&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Permit: &lt;%=inst_rec.Permit_Clearance_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-action-group&quot;&gt;\n&lt;%\n\t\tactionStatuses = {&quot;Ready to Schedule&quot;,&quot;Scheduled&quot;,&quot;In Progress&quot;,&quot;Installed&quot;,&quot;Inspection Required&quot;,&quot;Inspection Completed&quot;,&quot;Completed&quot;,&quot;On Hold&quot;,&quot;Cancelled&quot;};\n\t\tfor each  actionStatus in actionStatuses\n\t\t{\n\t\t\tactionParam = &quot;&quot;;\n\t\t\tactionClass = &quot;detail-action-progress&quot;;\n\t\t\tactionIcon = &quot;loader-dots-06&quot;;\n\t\t\tif(actionStatus == &quot;Ready to Schedule&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Ready%20to%20Schedule&quot;;\n\t\t\t\tactionClass = &quot;detail-action-ready&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Scheduled&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Scheduled&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-time&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;In Progress&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;In%20Progress&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Installed&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Installed&quot;;\n\t\t\t\tactionClass = &quot;detail-action-ready&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Inspection Required&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Inspection%20Required&quot;;\n\t\t\t\tactionClass = &quot;detail-action-inspection&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-alert-circle&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Inspection Completed&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Inspection%20Completed&quot;;\n\t\t\t\tactionClass = &quot;detail-action-inspection&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Completed&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Completed&quot;;\n\t\t\t\tactionClass = &quot;detail-action-ready&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;On Hold&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;On%20Hold&quot;;\n\t\t\t\tactionClass = &quot;detail-action-hold&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-time&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Cancelled&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Cancelled&quot;;\n\t\t\t\tactionClass = &quot;detail-action-cancel&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-simple-remove&quot;;\n\t\t\t}\n\t\t\tactionHref = &quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&quot; + inst_rec.ID + &quot;&amp;New_Status=&quot; + actionParam + &quot;&amp;Return_Page=Installation_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-button detail-action &lt;%=actionClass%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=actionHref%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline &lt;%=actionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=actionStatus%&gt;&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-hero-side&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Assigned crew lead&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=ifnull(inst_rec.Crew_Lead.Employee_Name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Scheduled start: &lt;%=ifnull(inst_rec.Scheduled_Start,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Estimated hours: &lt;%=ifnull(inst_rec.Estimated_Hours,0)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Open blockers: &lt;%=blockerCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;div class=&quot;detail-grid&quot;&gt;\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Customer and location&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Order, customer, and install-site snapshot for field teams.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Customer_Name_Snapshot,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Area or city&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Area_or_City,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Order&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\torderUrl2 = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=orderUrl2%&gt;&quot;&gt;&lt;%=order_rec.Order_Code%&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nOrder not found\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Forecast date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Forecast_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Phone&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(order_rec.Customer_Phone,&quot;Not entered&quot;)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNot available\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Email&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(order_rec.Customer_Email,&quot;Not entered&quot;)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNot available\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot; style=&quot;grid-column:1 / -1;&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Installation address&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Installation_Address.address_line_1,&quot;Not entered&quot;)%&gt; &lt;%=ifnull(inst_rec.Installation_Address.address_line_2,&quot;&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(inst_rec.Installation_Address.district_city,&quot;&quot;)%&gt; &lt;%=ifnull(inst_rec.Installation_Address.state_province,&quot;&quot;)%&gt; &lt;%=ifnull(inst_rec.Installation_Address.postal_Code,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Readiness summary&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Blocking status before dispatch or completion.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-grid&quot; style=&quot;grid-template-columns:1fr 1fr;&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline design-2-ungroup&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Production ready&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=readyCount%&gt;/&lt;%=prodCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Open permits&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=openPermitCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Blockers&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=blockerCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;QC&lt;/div&gt;&lt;div class=&quot;kpi-value zcs-font-18&quot;&gt;&lt;%=inst_rec.Internal_QC_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Products summary&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Copied from order lines when the schedule was created.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;products-summary&quot;&gt;&lt;%=ifnull(inst_rec.Products_Summary,&quot;No products summary has been captured.&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Readiness blockers&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Resolve these before field completion.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;blocker-list&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;blocker &lt;%=if(inst_rec.Production_Readiness_Status == &quot;Ready&quot;,&quot;blocker-ok&quot;,&quot;blocker-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline design-2-ungroup&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Production readiness: &lt;%=inst_rec.Production_Readiness_Status%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=blockedProdCount%&gt; linked production item(s) are not ready or received.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;blocker &lt;%=if(inst_rec.Permit_Clearance_Status == &quot;Approved&quot; || inst_rec.Permit_Clearance_Status == &quot;NotRequired&quot;,&quot;blocker-ok&quot;,&quot;blocker-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Permit clearance: &lt;%=inst_rec.Permit_Clearance_Status%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=openPermitCount%&gt; linked permit record(s) still require clearance.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;blocker &lt;%=if(scheduleSet == true,&quot;blocker-ok&quot;,&quot;blocker-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Schedule and crew&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Start, end, and crew lead are &lt;%=if(scheduleSet == true,&quot;assigned&quot;,&quot;not fully assigned&quot;)%&gt;.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;blocker &lt;%=if(qcClear == true,&quot;blocker-ok&quot;,&quot;blocker-danger&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Internal QC: &lt;%=inst_rec.Internal_QC_Status%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;QC required: &lt;%=if(inst_rec.Internal_QC_Required == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;. QC date: &lt;%=ifnull(inst_rec.Internal_QC_Date,&quot;Not set&quot;)%&gt;.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Schedule and crew lead&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Timing, estimated hours, and assigned lead.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Scheduled start&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Scheduled_Start,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Scheduled end&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Scheduled_End,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Estimated hours&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Estimated_Hours,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Priority sequence&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Crew lead&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Crew_Lead.Employee_Name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Crew email&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Crew_Lead.Email,&quot;Not entered&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Internal QC and completion&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Quality gate, field notes, and completion photo attachment status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;QC required&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(inst_rec.Internal_QC_Required == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;QC status&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=inst_rec.Internal_QC_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;QC date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Internal_QC_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Field notes&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(inst_rec.Field_Notes,&quot;No field notes captured.&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;photo-box zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;strong&gt;Completion photos&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-8&quot;&gt;\n&lt;%\n\t\tphotoValue = ifnull(inst_rec.Completion_Photos,&quot;&quot;);\n\t\tif(photoValue != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;%=inst_rec.Completion_Photos%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNo completion photos are attached yet.\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Linked production records&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Products, production readiness, material, and powder state for this installation.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only&quot;&gt;\n\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Production&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Qty&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Production status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Material&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Powder&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tprodRows = 0;\n\t\tfor each  prod in Production_Records[Customer_Order == inst_rec.Customer_Order] sort by Priority_Sequence asc\n\t\t{\n\t\t\tprodRows = prodRows + 1;\n\t\t\tprodStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(prod.Production_Status == &quot;Ready for Installation&quot; || prod.Production_Status == &quot;Purchased and Received&quot;)\n\t\t\t{\n\t\t\t\tprodStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(prod.Production_Status == &quot;Cancelled&quot;)\n\t\t\t{\n\t\t\t\tprodStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(prod.Production_Status == &quot;Material Shortage&quot; || prod.Production_Status == &quot;On Hold&quot;)\n\t\t\t{\n\t\t\t\tprodStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\tprodUrl = &quot;#Page:Production_Detail?Production_ID=&quot; + prod.ID;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=prodUrl%&gt;&quot;&gt;&lt;%=prod.Production_Code%&gt;&lt;/a&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(prod.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(prod.Colour,&quot;Colour not set&quot;)%&gt; - &lt;%=ifnull(prod.Dimensions,&quot;No dimensions&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=ifnull(prod.Quantity,0)%&gt; &lt;%=ifnull(prod.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=prodStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=prod.Production_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(prod.Material_Status,&quot;Not checked&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(prod.Powder_Coating_Status,&quot;Not required&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\tif(prodRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No linked Production_Records were found for this installation order.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\tmobileProdRows = 0;\n\t\tfor each  mprod in Production_Records[Customer_Order == inst_rec.Customer_Order] sort by Priority_Sequence asc\n\t\t{\n\t\t\tmobileProdRows = mobileProdRows + 1;\n\t\t\tmprodUrl = &quot;#Page:Production_Detail?Production_ID=&quot; + mprod.ID;\n\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mprodUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=mprod.Production_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=mprod.Production_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-6&quot;&gt;&lt;%=ifnull(mprod.Product.Product_Name,&quot;Product pending&quot;)%&gt; - &lt;%=ifnull(mprod.Colour,&quot;Colour not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;Qty &lt;%=ifnull(mprod.Quantity,0)%&gt; &lt;%=ifnull(mprod.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Material &lt;%=ifnull(mprod.Material_Status,&quot;Not checked&quot;)%&gt; - Powder &lt;%=ifnull(mprod.Powder_Coating_Status,&quot;Not required&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(mobileProdRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Production_Records were found for this installation order.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Permit clearance&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Order-level permits affecting the installation schedule.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n&lt;%\n\t\tif(permitRecords.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Permit_Records were found. Installation permit clearance is &lt;%=inst_rec.Permit_Clearance_Status%&gt;.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;link-list&quot;&gt;\n&lt;%\n\t\t\tfor each  permit in permitRecords\n\t\t\t{\n\t\t\t\tpermitUrl = &quot;#Page:Permit_Detail?Permit_ID=&quot; + permit.ID;\n\t\t\t\tpermitStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(permit.Permit_Status == &quot;Approved&quot; || permit.Permit_Status == &quot;Not Required&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(permit.Permit_Status == &quot;Rejected&quot; || permit.Permit_Status == &quot;Expired&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(permit.Permit_Status == &quot;Required&quot; || permit.Permit_Status == &quot;Preparing&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=permitUrl%&gt;&quot;&gt;&lt;%=permit.Permit_Code%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(permit.Authority_Name,&quot;Authority pending&quot;)%&gt; - &lt;%=ifnull(permit.Permit_Number,&quot;No number&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Submitted &lt;%=ifnull(permit.Submitted_Date,&quot;Not set&quot;)%&gt; - Approved &lt;%=ifnull(permit.Approved_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=permitStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=permit.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Status timeline&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Current progress through the installation lifecycle.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tstepStatuses = {&quot;Forecast&quot;,&quot;Waiting for Production&quot;,&quot;Ready to Schedule&quot;,&quot;Scheduled&quot;,&quot;In Progress&quot;,&quot;Installed&quot;,&quot;Inspection Required&quot;,&quot;Inspection Completed&quot;,&quot;Completed&quot;};\n\t\tcurrentStepIndex = stepStatuses.indexOf(inst_rec.Installation_Status);\n\t\tfor each index stepIndex in stepStatuses\n\t\t{\n\t\t\tstepStatus = stepStatuses.get(stepIndex);\n\t\t\ttlClass = &quot;&quot;;\n\t\t\ticonName = &quot;ui-2-time&quot;;\n\t\t\tif(currentStepIndex &gt; stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-complete&quot;;\n\t\t\t\ticonName = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(currentStepIndex == stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-active&quot;;\n\t\t\t\ticonName = &quot;loader-dots-06&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li &lt;%=tlClass%&gt; zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline &lt;%=iconName%&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step &lt;%=stepIndex + 1%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=stepStatus%&gt;&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=if(currentStepIndex &gt; stepIndex,&quot;Completed or passed&quot;,if(currentStepIndex == stepIndex,&quot;Current stage&quot;,&quot;Awaiting previous stage&quot;))%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(inst_rec.Installation_Status == &quot;On Hold&quot; || inst_rec.Installation_Status == &quot;Cancelled&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline ui-2-alert-circle&quot; style=&quot;background:#FDE3E6;color:#FE455D;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Exception&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=inst_rec.Installation_Status%&gt;&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;See comment history for reason and next action.&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Comment history&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Action_Comments audit trail for this installation and linked order, production, and permit records.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tcommentRows = 0;\n\t\tfor each  comment in Action_Comments[Target_Module == &quot;Installation_Schedules&quot; &amp;&amp; Lookup_ID == inst_rec.ID] sort by Action_Date desc\n\t\t{\n\t\t\tcommentRows = commentRows + 1;\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=comment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=comment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Installation &lt;%=inst_rec.Installation_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(comment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=comment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\tfor each  orderComment in Action_Comments[Target_Module == &quot;Customer_Orders&quot; &amp;&amp; Lookup_ID == order_rec.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=orderComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=orderComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Order &lt;%=order_rec.Order_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(orderComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=orderComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  prodCommentTarget in productionRecords\n\t\t{\n\t\t\tfor each  prodComment in Action_Comments[Target_Module == &quot;Production_Records&quot; &amp;&amp; Lookup_ID == prodCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=prodComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=prodComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Production &lt;%=prodCommentTarget.Production_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(prodComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=prodComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  permitCommentTarget in permitRecords\n\t\t{\n\t\t\tfor each  permitComment in Action_Comments[Target_Module == &quot;Permit_Records&quot; &amp;&amp; Lookup_ID == permitCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=permitComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=permitComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Permit &lt;%=permitCommentTarget.Permit_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(permitComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=permitComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tif(commentRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;li&gt;&lt;div class=&quot;empty-soft&quot;&gt;No Action_Comments have been recorded for this installation or linked operational records.&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Installation_Home
		{
					displayname = "Installation Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Installation_Home_Snippet' elementName='Installation_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Installation_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\treturnUrl = &quot;%23Page%3AInstallation_Home&quot;;\n\treadyInstallations = Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;];\n\tforecastInstallations = Installation_Schedules[Installation_Status == &quot;Forecast&quot; || Installation_Status == &quot;Waiting for Production&quot;];\n\tassignedInstallations = Installation_Schedules[Crew_Lead.Email == zoho.loginuser &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;];\n\tscheduledInstallations = Installation_Schedules[Scheduled_Start != null &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;];\n\tblockedInstallations = Installation_Schedules[Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot; || Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot; &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;];\n\treadyCount = readyInstallations.count();\n\tforecastCount = forecastInstallations.count();\n\tassignedCount = assignedInstallations.count();\n\tscheduledCount = scheduledInstallations.count();\n\tblockedCount = blockedInstallations.count();\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\na { text-decoration: none; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-14 { gap: .875rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-14 { padding: .875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-18 { padding: 1.125rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 860px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.install-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.install-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #14365F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.install-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.install-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.install-eyebrow { letter-spacing: .08em; opacity: .78; }\n.install-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.install-subtitle { max-width: 900px; color: rgba(255,255,255,.82); margin: 0; }\n.install-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }\n.install-kpi-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.install-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.install-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.install-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.install-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.install-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.install-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }\n.install-kpi-link, .install-row-link, .install-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.install-section-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); gap: 16px; margin-top: 16px; }\n.install-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.install-panel { padding: 18px; }\n.install-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.install-panel-title { margin: 0; font-size: 18px; }\n.install-note { color: var(--zcs-teritiary-text-color); }\n.install-action-group { display: flex; flex-wrap: wrap; gap: 6px; }\n.install-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; line-height: 1.2; }\n.install-action-ready { --action-color:#179E6C; border-color:#179E6C; color:#179E6C; }\n.install-action-schedule { --action-color:#2A6FFC; border-color:#2A6FFC; color:#2A6FFC; }\n.install-action-progress { --action-color:#1094C5; border-color:#1094C5; color:#1094C5; }\n.install-action-inspect { --action-color:#B8770D; border-color:#B8770D; color:#B8770D; }\n.install-action-hold { --action-color:#F4660C; border-color:#F4660C; color:#F4660C; }\n.install-action-cancel { --action-color:#FE455D; border-color:#FE455D; color:#FE455D; }\n.install-action:hover { background: color-mix(in srgb, var(--action-color, var(--zcs-theme-brand-color)) 10%, #fff); }\n.install-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.install-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }\n.install-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }\n.install-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.install-card-list { display: grid; gap: 12px; }\n.install-work-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.install-schedule-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.install-schedule-card { border-left: 4px solid var(--schedule-color, var(--zcs-theme-brand-color)); padding: 14px; border-radius: 14px; border-top: 1px solid var(--zcs-border-color); border-right: 1px solid var(--zcs-border-color); border-bottom: 1px solid var(--zcs-border-color); background: #fff; }\n.install-group-header { margin-top: 14px; margin-bottom: 8px; padding: 8px 10px; border-radius: 12px; background: #F1F4FB; color: var(--zcs-secondary-text-color); }\n.install-blocked-reason { color: #B8770D; }\n.install-danger { color: #FE455D; }\n.install-success { color: #179E6C; }\n.install-muted-line { color: var(--zcs-teritiary-text-color); }\n.install-mobile-cards { display: none; }\n@media (max-width: 1240px) { .install-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .install-section-grid { grid-template-columns: 1fr; } .install-schedule-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .install-two-col { grid-template-columns: 1fr; } .install-hero-content { flex-direction: column; } .install-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .install-home-shell { padding: 12px; } .install-hero { padding: 18px; border-radius: 18px; } .install-kpi-grid { grid-template-columns: 1fr; } .install-panel { padding: 14px; } .install-quick-grid { grid-template-columns: 1fr; } .install-panel-header { align-items: flex-start; flex-direction: column; } .install-responsive-table { display: none; } .install-mobile-cards { display: grid; gap: 10px; } .install-action { flex: 1 1 auto; } }\n&lt;/style&gt;\n&lt;div class=&quot;install-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;install-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Installation planning workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;install-title zcs-font-bold&quot;&gt;Installation Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;install-subtitle zcs-font-15&quot;&gt;Schedule field work based on production readiness, permit clearance, location, estimated hours, and crew lead assignment.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;install-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAFBF4;--kpi-color:#179E6C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-value zcs-font-bold&quot;&gt;&lt;%=readyCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-label zcs-font-13&quot;&gt;Ready to schedule&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-kpi-link&quot; href=&quot;#Report:Ready_To_Schedule_Installations&quot;&gt;Open ready queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-value zcs-font-bold&quot;&gt;&lt;%=forecastCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-label zcs-font-13&quot;&gt;Forecast queue&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-kpi-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;All schedules&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-03 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-value zcs-font-bold&quot;&gt;&lt;%=assignedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-label zcs-font-13&quot;&gt;Assigned to me&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-kpi-link&quot; href=&quot;#assigned-to-me&quot;&gt;My assignments&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F0ECFF;--kpi-color:#7656D6;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-value zcs-font-bold&quot;&gt;&lt;%=scheduledCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-label zcs-font-13&quot;&gt;Scheduled cards&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-kpi-link&quot; href=&quot;#schedule-groups&quot;&gt;Date/location/crew view&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-value zcs-font-bold&quot;&gt;&lt;%=blockedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;install-kpi-label zcs-font-13&quot;&gt;Blocked items&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-kpi-link&quot; href=&quot;#blocked-items&quot;&gt;Review blockers&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;install-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Ready-to-schedule installations&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Production and permit gates are clear enough for scheduling decisions. Use Add Comments popup links for status changes.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-panel-link&quot; href=&quot;#Report:Ready_To_Schedule_Installations&quot;&gt;Full ready report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Installation&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer / Location&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Readiness&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Crew / Hours&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Add Comments&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\treadyRows = 0;\n\tfor each  inst in Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(readyRows &lt; 8)\n\t\t{\n\t\t\treadyRows = readyRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Installation&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=inst.ID%&gt;&quot;&gt;&lt;%=inst.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Order &lt;%=ifnull(inst.Customer_Order.Order_Code,&quot;Not linked&quot;)%&gt; \u00B7 Seq &lt;%=ifnull(inst.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / Location&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(inst.Customer.Customer_Name,ifnull(inst.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(inst.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Readiness&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=ifnull(inst.Production_Readiness_Status,&quot;Production pending&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Permit: &lt;%=ifnull(inst.Permit_Clearance_Status,&quot;Permit pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Crew / Hours&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(inst.Crew_Lead.Employee_Name,&quot;Crew unassigned&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(inst.Estimated_Hours,&quot;Hours not set&quot;)%&gt; estimated hours&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Add Comments&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;install-action-group&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-schedule zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=inst.ID%&gt;&amp;New_Status=Scheduled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;span&gt;Scheduled&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=inst.ID%&gt;&amp;New_Status=On%20Hold&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;&lt;span&gt;On Hold&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=inst.ID%&gt;&amp;New_Status=Cancelled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;&lt;span&gt;Cancelled&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(readyRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No installations are currently ready to schedule.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-mobile-cards&quot;&gt;\n&lt;%\n\treadyMobileRows = 0;\n\tfor each  rinst in Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(readyMobileRows &lt; 6)\n\t\t{\n\t\t\treadyMobileRows = readyMobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;install-work-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10&quot;&gt;&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=rinst.ID%&gt;&quot;&gt;&lt;%=rinst.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=rinst.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;&lt;%=ifnull(rinst.Customer.Customer_Name,ifnull(rinst.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt; \u00B7 &lt;%=ifnull(rinst.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Crew: &lt;%=ifnull(rinst.Crew_Lead.Employee_Name,&quot;Unassigned&quot;)%&gt; \u00B7 Hours: &lt;%=ifnull(rinst.Estimated_Hours,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;install-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-schedule zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=rinst.ID%&gt;&amp;New_Status=Scheduled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Scheduled&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=rinst.ID%&gt;&amp;New_Status=On%20Hold&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;On Hold&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=rinst.ID%&gt;&amp;New_Status=Cancelled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(readyMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;install-work-card zcs-font-14 zcs-color-tertiary&quot;&gt;No installations are currently ready to schedule.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Quick links&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-quick-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;&lt;span class=&quot;install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;All schedules&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Operational installation list&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Installation_Calendar&quot;&gt;&lt;span class=&quot;install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Calendar&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Scheduled start and end&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Installation_Status_Board&quot;&gt;&lt;span class=&quot;install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-grid-45&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Status board&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Grouped by progress&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Ready_To_Schedule_Installations&quot;&gt;&lt;span class=&quot;install-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Ready queue&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Ready to schedule report&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card zcs-p-14 zcs-box-border&quot; style=&quot;background:#FBFCFF; box-shadow:none;&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&quot;zcs-font-16 zcs-font-semibold zcs-m-0&quot;&gt;Status popup actions&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-6 zcs-mb-0&quot;&gt;Each work card links to Add Comments for Ready to Schedule, Scheduled, In Progress, Installed, Inspection Required, Inspection Completed, Completed, On Hold, and Cancelled. No report action buttons are used.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;install-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Forecast queue in order-placement sequence&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Sorted by installation priority sequence, which follows the order placement sequence established during order creation.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;All forecast records&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-card-list&quot;&gt;\n&lt;%\n\tforecastRows = 0;\n\tfor each  f in Installation_Schedules[Installation_Status == &quot;Forecast&quot; || Installation_Status == &quot;Waiting for Production&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(forecastRows &lt; 8)\n\t\t{\n\t\t\tforecastRows = forecastRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;install-work-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=f.ID%&gt;&quot;&gt;&lt;%=f.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Order &lt;%=ifnull(f.Customer_Order.Order_Code,&quot;Not linked&quot;)%&gt; \u00B7 Placed &lt;%=ifnull(f.Customer_Order.Order_Placement_Date,&quot;Date pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=f.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;&lt;%=ifnull(f.Customer.Customer_Name,ifnull(f.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt; \u00B7 &lt;%=ifnull(f.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Forecast date: &lt;%=ifnull(f.Forecast_Date,&quot;Not set&quot;)%&gt; \u00B7 Priority: &lt;%=ifnull(f.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Production: &lt;%=ifnull(f.Production_Readiness_Status,&quot;Pending&quot;)%&gt; \u00B7 Permit: &lt;%=ifnull(f.Permit_Clearance_Status,&quot;Pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(forecastRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;install-work-card zcs-font-14 zcs-color-tertiary&quot;&gt;No forecast installations are waiting in the queue.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div id=&quot;assigned-to-me&quot; class=&quot;install-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Assigned to me&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Filtered where Crew Lead user email equals the signed-in user.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;install-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;Open schedule report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;install-card-list&quot;&gt;\n&lt;%\n\tassignedRows = 0;\n\tfor each  mine in Installation_Schedules[Crew_Lead.Email == zoho.loginuser &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Scheduled_Start asc\n\t{\n\t\tif(assignedRows &lt; 6)\n\t\t{\n\t\t\tassignedRows = assignedRows + 1;\n\t\t\tbadgeClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(mine.Installation_Status == &quot;Ready to Schedule&quot;)\n\t\t\t{\n\t\t\t\tbadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(mine.Installation_Status == &quot;On Hold&quot;)\n\t\t\t{\n\t\t\t\tbadgeClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(mine.Installation_Status == &quot;Inspection Required&quot;)\n\t\t\t{\n\t\t\t\tbadgeClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&quot;install-work-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=mine.ID%&gt;&quot;&gt;&lt;%=mine.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=badgeClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=mine.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;&lt;%=ifnull(mine.Customer.Customer_Name,ifnull(mine.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt; \u00B7 &lt;%=ifnull(mine.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Scheduled: &lt;%=ifnull(mine.Scheduled_Start,&quot;Not scheduled&quot;)%&gt; to &lt;%=ifnull(mine.Scheduled_End,&quot;End not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;install-action-group zcs-mt-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Ready%20to%20Schedule&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Ready to Schedule&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=In%20Progress&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;In Progress&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Installed&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Installed&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-inspect zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Inspection%20Required&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Inspection Required&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-inspect zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Inspection%20Completed&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Inspection Completed&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Completed&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Completed&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=On%20Hold&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;On Hold&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=mine.ID%&gt;&amp;New_Status=Cancelled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Cancelled&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(assignedRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;install-work-card zcs-font-14 zcs-color-tertiary&quot;&gt;No active installation schedules are assigned to your user email.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section id=&quot;schedule-groups&quot; class=&quot;install-panel zcs-card zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-panel-header&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Schedule cards grouped by date, location, and crew lead&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Upcoming scheduled work grouped by scheduled date, area or city, and crew lead for planner review.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;install-panel-link&quot; href=&quot;#Report:Installation_Calendar&quot;&gt;Open calendar&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-schedule-grid&quot;&gt;\n&lt;%\n\tscheduledRows = 0;\n\tlastGroup = &quot;&quot;;\n\tfor each  sch in Installation_Schedules[Scheduled_Start != null &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Scheduled_Start asc\n\t{\n\t\tif(scheduledRows &lt; 12)\n\t\t{\n\t\t\tscheduledRows = scheduledRows + 1;\n\t\t\tschDate = sch.Scheduled_Start.toString(&quot;dd-MMM-yyyy&quot;);\n\t\t\tschLocation = ifnull(sch.Area_or_City,&quot;Location pending&quot;);\n\t\t\tschCrew = ifnull(sch.Crew_Lead.Employee_Name,&quot;Crew unassigned&quot;);\n\t\t\tgroupKey = schDate + &quot; | &quot; + schLocation + &quot; | &quot; + schCrew;\n\t\t\tif(groupKey != lastGroup)\n\t\t\t{\n\t\t\t\tlastGroup = groupKey;\n\t\t\t\t%&gt;\n&lt;div class=&quot;install-group-header zcs-font-13 zcs-font-semibold&quot; style=&quot;grid-column:1/-1;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt; &lt;%=groupKey%&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&quot;install-schedule-card&quot; style=&quot;--schedule-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=sch.ID%&gt;&quot;&gt;&lt;%=sch.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=sch.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;&lt;%=ifnull(sch.Customer.Customer_Name,ifnull(sch.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=sch.Scheduled_Start%&gt; to &lt;%=ifnull(sch.Scheduled_End,&quot;End not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Hours: &lt;%=ifnull(sch.Estimated_Hours,&quot;Not set&quot;)%&gt; \u00B7 QC: &lt;%=ifnull(sch.Internal_QC_Status,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;install-action-group zcs-mt-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=sch.ID%&gt;&amp;New_Status=In%20Progress&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;In Progress&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=sch.ID%&gt;&amp;New_Status=Installed&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Installed&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=sch.ID%&gt;&amp;New_Status=Completed&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Completed&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(scheduledRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;install-work-card zcs-font-14 zcs-color-tertiary&quot; style=&quot;grid-column:1/-1;&quot;&gt;No scheduled installation cards are available.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section id=&quot;blocked-items&quot; class=&quot;install-panel zcs-card zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;install-panel-header&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;install-panel-title zcs-font-semibold&quot;&gt;Blocked by production or permit&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;install-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Shows installations blocked by production readiness or permit clearance. Order amount fields are not shown.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;install-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;Review all schedules&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;install-card-list&quot;&gt;\n&lt;%\n\tblockedRows = 0;\n\tfor each  b in Installation_Schedules[Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot; || Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot; &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(blockedRows &lt; 10)\n\t\t{\n\t\t\tblockedRows = blockedRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;install-work-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;a class=&quot;install-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=b.ID%&gt;&quot;&gt;&lt;%=b.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=b.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;&lt;%=ifnull(b.Customer.Customer_Name,ifnull(b.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt; \u00B7 &lt;%=ifnull(b.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-6&quot;&gt;&lt;span class=&quot;install-blocked-reason&quot;&gt;Production:&lt;/span&gt; &lt;%=ifnull(b.Production_Readiness_Status,&quot;Pending&quot;)%&gt; \u00B7 &lt;span class=&quot;install-blocked-reason&quot;&gt;Permit:&lt;/span&gt; &lt;%=ifnull(b.Permit_Clearance_Status,&quot;Pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Forecast: &lt;%=ifnull(b.Forecast_Date,&quot;Not set&quot;)%&gt; \u00B7 Crew: &lt;%=ifnull(b.Crew_Lead.Employee_Name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;install-action-group zcs-mt-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-ready zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=b.ID%&gt;&amp;New_Status=Ready%20to%20Schedule&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Ready to Schedule&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=b.ID%&gt;&amp;New_Status=On%20Hold&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;On Hold&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button install-action install-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-box-border&quot; href=&quot;#Form:Action_Comments?Target_Module=Installation_Schedules&amp;Lookup_ID=&lt;%=b.ID%&gt;&amp;New_Status=Cancelled&amp;Return_Page=Installation_Home&amp;Return_URL=&lt;%=returnUrl%&gt;&amp;zc_LoadIn=dialog&quot;&gt;Cancelled&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(blockedRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;install-work-card zcs-font-14 zcs-color-tertiary&quot;&gt;No active installations are blocked by production or permit.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Inventory_Detail(int Item_ID, string Item_Type)
		{
					displayname = "Inventory Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Inventory_Detail_Snippet' elementName='Inventory_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Inventory_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\trawType = ifnull(input.Item_Type,&quot;&quot;);\n\tisMaterial = rawType == &quot;Material&quot; || rawType == &quot;material&quot; || rawType == &quot;MATERIAL&quot;;\n\tisPowder = rawType == &quot;Powder&quot; || rawType == &quot;powder&quot; || rawType == &quot;POWDER&quot;;\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-danger-soft: #FFECEF; --zcs-warning-soft: #FFF6E3; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\na { text-decoration: none; color: inherit; }\n.inventory-detail-page, .inventory-detail-page * { box-sizing: border-box; }\n.inventory-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 24px; overflow: auto; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-16 { padding-top: 1rem; padding-bottom: 1rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-overflow-auto { overflow: auto; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-page-header { background: rgba(255,255,255,.86); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 40px rgba(19,22,53,.06); margin-bottom: 18px; backdrop-filter: blur(8px); }\n.zcs-back { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-theme-brand-color); background: var(--zcs-brand-soft); }\n.zcs-back:hover { color: #131635; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #242424; color: #242424; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; border-radius: 12px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-table-wrapper .zcs-green { color: #179E6C; }\n.zcs-table-wrapper .zcs-red { color: #FE455D; }\n.zcs-table-wrapper .zcs-yellow { color: #B8770D; }\n.zcs-table-wrapper .zcs-l_blue { color: #1094C5; }\n.zcs-nodata-wrapper { min-height: 68vh; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; }\n.inventory-hero { border-radius: 22px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1C3F8F); color: #fff; padding: 24px; box-shadow: 0 20px 50px rgba(42,111,252,.18); margin-bottom: 18px; }\n.inventory-hero-main { flex: 1 1 420px; min-width: 0; }\n.inventory-hero-side { flex: 0 0 300px; background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.22); border-radius: 18px; padding: 18px; }\n.inventory-kicker { letter-spacing: .08em; opacity: .82; }\n.inventory-hero-title { font-size: clamp(1.7rem, 4vw, 3rem); line-height: 1.05; margin: 8px 0 8px; }\n.inventory-hero-subtitle { max-width: 820px; margin: 0; color: rgba(255,255,255,.84); }\n.inventory-hero .zcs-badge { border-color: rgba(255,255,255,.35); }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }\n.kpi-card { min-height: 126px; padding: 18px; border-radius: 16px; background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); box-shadow: 0 12px 28px rgba(19,22,53,.05); }\n.kpi-icon { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); font-size: 20px; }\n.kpi-value { font-size: 28px; font-weight: 700; line-height: 1.1; margin-top: 10px; word-break: break-word; }\n.kpi-label { color: var(--zcs-secondary-text-color); font-size: 13px; margin-top: 4px; }\n.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }\n.detail-span-12 { grid-column: span 12; }\n.detail-span-8 { grid-column: span 8; }\n.detail-span-6 { grid-column: span 6; }\n.detail-span-4 { grid-column: span 4; }\n.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 12px 28px rgba(19,22,53,.05); overflow: hidden; }\n.detail-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #fff, #FBFCFF); }\n.detail-card-title { margin: 0; font-size: 18px; line-height: 1.25; }\n.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.detail-card-body { padding: 18px 20px; }\n.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.kv-item { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 12px; }\n.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }\n.kv-value { color: var(--zcs-primary-text-color); font-weight: 600; margin-top: 4px; word-break: break-word; }\n.alert-row { display: flex; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }\n.alert-ok { background: #F5FFFA; border-color: #CFF4E4; }\n.alert-ok i { color: #179E6C; }\n.alert-warn { background: #FFF8EA; border-color: #F7DFA8; }\n.alert-warn i { color: #B8770D; }\n.alert-danger { background: #FFF1F3; border-color: #FAC4CD; }\n.alert-danger i { color: #FE455D; }\n.row-link { color: var(--zcs-theme-brand-color); font-weight: 600; }\n.row-link:hover { text-decoration: underline; }\n.mobile-stack { display: none; }\n.mobile-record { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; margin-bottom: 10px; }\n.empty-soft { border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 16px; color: var(--zcs-teritiary-text-color); background: #FBFCFF; }\n.stock-ok { color: #179E6C; font-weight: 700; }\n.stock-warn { color: #B8770D; font-weight: 700; }\n.stock-danger { color: #FE455D; font-weight: 700; }\n@media (max-width: 1180px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 768px) { .inventory-detail-page { padding: 12px; } .zcs-page-header { padding: 12px 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .inventory-hero { padding: 18px; border-radius: 18px; } .inventory-hero-side { flex-basis: auto; width: 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-table { display: none; } .mobile-stack { display: block; } .zcs-button { width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;inventory-detail-page&quot;&gt;\n&lt;%\n\tif(!isMaterial &amp;&amp; !isPowder)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Unsupported inventory item type&lt;/h5&gt;\n\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;Use Item_Type as Material or Powder. Received: &lt;%=rawType%&gt;.&lt;/p&gt;\n\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12&quot; href=&quot;#Page:Purchase_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span&gt;Purchase Home&lt;/span&gt;&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;%\n\t}\n\telse if(isMaterial)\n\t{\n\t\titem_rec = Material_Master[ID == input.Item_ID];\n\t\tif(item_rec.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Material not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;Item_ID &lt;%=input.Item_ID%&gt; does not match an existing Material_Master record.&lt;/p&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12&quot; href=&quot;#Page:Purchase_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span&gt;Purchase Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tavailableQty = ifnull(item_rec.Available_Quantity,0);\n\t\t\treorderQty = ifnull(item_rec.Reorder_Level,0);\n\t\t\tunitName = ifnull(item_rec.Stock_Unit.Unit_Name,&quot;Unit not set&quot;);\n\t\t\tvendorName = ifnull(item_rec.Default_Vendor.Vendor_Name,&quot;Vendor not set&quot;);\n\t\t\tbomRows = Product_BOM_Items[Material == item_rec.ID];\n\t\t\tproductionUsageRows = Production_Material_Usage[Material == item_rec.ID];\n\t\t\tserviceUsageRows = Service_Parts_Usage[Material == item_rec.ID];\n\t\t\tpoRows = Purchase_Order_Lines[Material == item_rec.ID];\n\t\t\tproductionConsumed = 0.0;\n\t\t\tfor each  usageTotal in productionUsageRows\n\t\t\t{\n\t\t\t\tusageQty = ifnull(usageTotal.Actual_Quantity,0);\n\t\t\t\tif(usageQty == 0)\n\t\t\t\t{\n\t\t\t\t\tusageQty = ifnull(usageTotal.Estimated_Quantity,0);\n\t\t\t\t}\n\t\t\t\tproductionConsumed = productionConsumed + usageQty;\n\t\t\t}\n\t\t\tserviceConsumed = 0.0;\n\t\t\tfor each  serviceTotal in serviceUsageRows\n\t\t\t{\n\t\t\t\tserviceConsumed = serviceConsumed + ifnull(serviceTotal.Quantity_Used,0);\n\t\t\t}\n\t\t\topenPoCount = 0;\n\t\t\topenPoQty = 0.0;\n\t\t\tfor each  poCountRow in poRows\n\t\t\t{\n\t\t\t\tpoStatus = ifnull(poCountRow.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(poStatus != &quot;Received&quot; &amp;&amp; poStatus != &quot;Cancelled&quot;)\n\t\t\t\t{\n\t\t\t\t\topenPoCount = openPoCount + 1;\n\t\t\t\t\tpendingQty = ifnull(poCountRow.Quantity,0) - ifnull(poCountRow.Received_Quantity,0);\n\t\t\t\t\tif(pendingQty &lt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tpendingQty = 0;\n\t\t\t\t\t}\n\t\t\t\t\topenPoQty = openPoQty + pendingQty;\n\t\t\t\t}\n\t\t\t}\n\t\t\tstockBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\tstockIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\tstockLabel = &quot;Healthy stock&quot;;\n\t\t\tstockMessage = &quot;Available stock is above the reorder level.&quot;;\n\t\t\talertClass = &quot;alert-ok&quot;;\n\t\t\tif(item_rec.Active != true)\n\t\t\t{\n\t\t\t\tstockBadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\tstockIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\tstockLabel = &quot;Inactive item&quot;;\n\t\t\t\tstockMessage = &quot;This material is inactive. Confirm before purchasing or issuing stock.&quot;;\n\t\t\t\talertClass = &quot;alert-warn&quot;;\n\t\t\t}\n\t\t\telse if(availableQty &lt;= reorderQty)\n\t\t\t{\n\t\t\t\tstockBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tstockIcon = &quot;ui-2-alert&quot;;\n\t\t\t\tstockLabel = &quot;Reorder warning&quot;;\n\t\t\t\tstockMessage = &quot;Current stock is at or below the reorder level.&quot;;\n\t\t\t\talertClass = &quot;alert-danger&quot;;\n\t\t\t}\n\t\t\treturnUrl = &quot;%23Page%3AInventory_Detail%3FItem_Type%3DMaterial%26Item_ID%3D&quot; + item_rec.ID;\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:Purchase_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Inventory Detail&lt;/h5&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Material - &lt;%=item_rec.Material_Code%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Purchase_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Purchase Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;inventory-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t&lt;div class=&quot;inventory-hero-main&quot;&gt;\n\t\t\t\t&lt;div class=&quot;inventory-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Raw material stock item&lt;/div&gt;\n\t\t\t\t&lt;h1 class=&quot;inventory-hero-title&quot;&gt;&lt;%=item_rec.Material_Name%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;inventory-hero-subtitle&quot;&gt;&lt;%=ifnull(item_rec.Material_Category,&quot;Uncategorized&quot;)%&gt; material supplied by &lt;%=vendorName%&gt;. Consumption shown below includes production material usage and service parts usage.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=stockBadgeClass%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline &lt;%=stockIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=stockLabel%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Unit: &lt;%=unitName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(openPoCount &gt; 0,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-grey&quot;)%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Open PO lines: &lt;%=openPoCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;inventory-hero-side&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-uppercase zcs-font-semibold&quot;&gt;Current quantity&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-bold zcs-mt-8&quot;&gt;&lt;%=availableQty%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-mt-4&quot;&gt;&lt;%=unitName%&gt; available&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-12&quot;&gt;Reorder level: &lt;strong&gt;&lt;%=reorderQty%&gt; &lt;%=unitName%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline business-box&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=availableQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Available quantity&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=reorderQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Reorder level&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline e-commerce-shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=openPoQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Pending open PO quantity&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=productionConsumed + serviceConsumed%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Related consumed quantity&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;detail-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Stock status&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Reorder and activity context&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=alertClass%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=stockIcon%&gt; zcs-font-20&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=stockLabel%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=stockMessage%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Default vendor&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=vendorName%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Last updated&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(item_rec.Last_Updated,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Active&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(item_rec.Active == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Category&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(item_rec.Material_Category,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Product BOM context&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Products that use this material as a standard BOM item&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=bomRows.count()%&gt; BOM rows&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Product&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Qty per unit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Unit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Wastage %&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Active&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tbomCount = 0;\n\t\t\tfor each  bom in Product_BOM_Items[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(bomCount &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tbomCount = bomCount + 1;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(bom.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(bom.Quantity_Per_Unit,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(bom.Unit.Unit_Name,unitName)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(bom.Wastage_Percent,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=if(bom.Active == true,&quot;zcs-green&quot;,&quot;zcs-yellow&quot;)%&gt;&quot;&gt;&lt;%=if(bom.Active == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(bomCount == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No Product_BOM_Items rows reference this material.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobileBomCount = 0;\n\t\t\tfor each  mbom in Product_BOM_Items[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(mobileBomCount &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tmobileBomCount = mobileBomCount + 1;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mbom.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Qty: &lt;%=ifnull(mbom.Quantity_Per_Unit,0)%&gt; &lt;%=ifnull(mbom.Unit.Unit_Name,unitName)%&gt; | Wastage: &lt;%=ifnull(mbom.Wastage_Percent,0)%&gt;%&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobileBomCount == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No Product_BOM_Items rows reference this material.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Production consumption&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Recent Production_Material_Usage rows with Production_Detail links&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Production&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Estimated&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Actual&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Stock posted&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tprodRowsShown = 0;\n\t\t\tfor each  pusage in Production_Material_Usage[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(prodRowsShown &lt; 8)\n\t\t\t\t{\n\t\t\t\t\tprodRowsShown = prodRowsShown + 1;\n\t\t\t\t\tprodHref = &quot;#Page:Production_Detail?Production_ID=&quot; + pusage.Production_Record.ID;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=prodHref%&gt;&quot;&gt;&lt;%=ifnull(pusage.Production_Record.Production_Code,&quot;Production pending&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;&lt;%=ifnull(pusage.Production_Record.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(pusage.Estimated_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(pusage.Actual_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=if(pusage.Stock_Deducted == true,&quot;zcs-green&quot;,&quot;zcs-yellow&quot;)%&gt;&quot;&gt;&lt;%=if(pusage.Stock_Deducted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prodRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No production material usage has been recorded for this material.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobileProdRows = 0;\n\t\t\tfor each  mpusage in Production_Material_Usage[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(mobileProdRows &lt; 8)\n\t\t\t\t{\n\t\t\t\t\tmobileProdRows = mobileProdRows + 1;\n\t\t\t\t\tmProdHref = &quot;#Page:Production_Detail?Production_ID=&quot; + mpusage.Production_Record.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mProdHref%&gt;&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mpusage.Production_Record.Production_Code,&quot;Production pending&quot;)%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Estimated: &lt;%=ifnull(mpusage.Estimated_Quantity,0)%&gt; | Actual: &lt;%=ifnull(mpusage.Actual_Quantity,0)%&gt; | Posted: &lt;%=if(mpusage.Stock_Deducted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobileProdRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No production material usage has been recorded for this material.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Service consumption&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Recent Service_Parts_Usage rows with Service_Detail links&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Service&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Qty used&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Unit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Stock posted&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tserviceRowsShown = 0;\n\t\t\tfor each  susage in Service_Parts_Usage[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(serviceRowsShown &lt; 8)\n\t\t\t\t{\n\t\t\t\t\tserviceRowsShown = serviceRowsShown + 1;\n\t\t\t\t\tsvcHref = &quot;#Page:Service_Detail?Service_ID=&quot; + susage.Service_Request.ID;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=svcHref%&gt;&quot;&gt;&lt;%=ifnull(susage.Service_Request.Service_Code,&quot;Service pending&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;&lt;%=ifnull(susage.Service_Request.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(susage.Quantity_Used,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(susage.Unit.Unit_Name,unitName)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=if(susage.Stock_Deducted == true,&quot;zcs-green&quot;,&quot;zcs-yellow&quot;)%&gt;&quot;&gt;&lt;%=if(susage.Stock_Deducted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(serviceRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No service parts usage has been recorded for this material.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobileSvcRows = 0;\n\t\t\tfor each  msusage in Service_Parts_Usage[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(mobileSvcRows &lt; 8)\n\t\t\t\t{\n\t\t\t\t\tmobileSvcRows = mobileSvcRows + 1;\n\t\t\t\t\tmSvcHref = &quot;#Page:Service_Detail?Service_ID=&quot; + msusage.Service_Request.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mSvcHref%&gt;&quot;&gt;&lt;strong&gt;&lt;%=ifnull(msusage.Service_Request.Service_Code,&quot;Service pending&quot;)%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Qty used: &lt;%=ifnull(msusage.Quantity_Used,0)%&gt; &lt;%=ifnull(msusage.Unit.Unit_Name,unitName)%&gt; | Posted: &lt;%=if(msusage.Stock_Deducted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobileSvcRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No service parts usage has been recorded for this material.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Open purchase order lines&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Purchase_Order_Lines that can replenish this material, linked to Purchase_Order_Detail&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(openPoCount &gt; 0,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-grey&quot;)%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=openPoCount%&gt; open&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;PO&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Vendor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Ordered&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Received&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Expected&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tpoRowsShown = 0;\n\t\t\tfor each  poLine in Purchase_Order_Lines[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tpoLineStatus = ifnull(poLine.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(poLineStatus != &quot;Received&quot; &amp;&amp; poLineStatus != &quot;Cancelled&quot; &amp;&amp; poRowsShown &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tpoRowsShown = poRowsShown + 1;\n\t\t\t\t\tpoHref = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + poLine.Purchase_Order.ID;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=poHref%&gt;&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.PO_Number,&quot;PO pending&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Line &lt;%=ifnull(poLine.Line_Number,&quot;-&quot;)%&gt; | &lt;%=ifnull(poLine.Line_Type,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=poLineStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Received_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(poRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;6&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No open PO lines are currently linked to this material.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobilePoRows = 0;\n\t\t\tfor each  mpoLine in Purchase_Order_Lines[Material == item_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tmPoStatus = ifnull(mpoLine.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(mPoStatus != &quot;Received&quot; &amp;&amp; mPoStatus != &quot;Cancelled&quot; &amp;&amp; mobilePoRows &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tmobilePoRows = mobilePoRows + 1;\n\t\t\t\t\tmPoHref = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + mpoLine.Purchase_Order.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mPoHref%&gt;&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mpoLine.Purchase_Order.PO_Number,&quot;PO pending&quot;)%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=mPoStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Vendor: &lt;%=ifnull(mpoLine.Purchase_Order.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt; | Ordered: &lt;%=ifnull(mpoLine.Quantity,0)%&gt; | Received: &lt;%=ifnull(mpoLine.Received_Quantity,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobilePoRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No open PO lines are currently linked to this material.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/section&gt;\n&lt;%\n\t\t}\n\t}\n\telse if(isPowder)\n\t{\n\t\tpowder_rec = Powder_Coating_Inventory[ID == input.Item_ID];\n\t\tif(powder_rec.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Powder stock item not found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;Item_ID &lt;%=input.Item_ID%&gt; does not match an existing Powder_Coating_Inventory record.&lt;/p&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12&quot; href=&quot;#Page:Purchase_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span&gt;Purchase Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\tavailableQty = ifnull(powder_rec.Available_Quantity,0);\n\t\t\treorderQty = ifnull(powder_rec.Reorder_Level,0);\n\t\t\tunitName = ifnull(powder_rec.Stock_Unit.Unit_Name,&quot;Unit not set&quot;);\n\t\t\tvendorName = ifnull(powder_rec.Vendor.Vendor_Name,&quot;Vendor not set&quot;);\n\t\t\tproductionRows = Production_Records[Powder == powder_rec.ID];\n\t\t\tdefaultProducts = Product_Catalogue[Default_Powder == powder_rec.ID];\n\t\t\tpoRows = Purchase_Order_Lines[Powder == powder_rec.ID];\n\t\t\tpowderConsumed = 0.0;\n\t\t\tfor each  prodTotal in productionRows\n\t\t\t{\n\t\t\t\tpowderConsumed = powderConsumed + ifnull(prodTotal.Powder_Qty_Used,0);\n\t\t\t}\n\t\t\topenPoCount = 0;\n\t\t\topenPoQty = 0.0;\n\t\t\tfor each  poCountRow in poRows\n\t\t\t{\n\t\t\t\tpoStatus = ifnull(poCountRow.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(poStatus != &quot;Received&quot; &amp;&amp; poStatus != &quot;Cancelled&quot;)\n\t\t\t\t{\n\t\t\t\t\topenPoCount = openPoCount + 1;\n\t\t\t\t\tpendingQty = ifnull(poCountRow.Quantity,0) - ifnull(poCountRow.Received_Quantity,0);\n\t\t\t\t\tif(pendingQty &lt; 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tpendingQty = 0;\n\t\t\t\t\t}\n\t\t\t\t\topenPoQty = openPoQty + pendingQty;\n\t\t\t\t}\n\t\t\t}\n\t\t\tstockBadgeClass = &quot;zcs-badge-green&quot;;\n\t\t\tstockIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\tstockLabel = &quot;Healthy stock&quot;;\n\t\t\tstockMessage = &quot;Available powder stock is above the reorder level.&quot;;\n\t\t\talertClass = &quot;alert-ok&quot;;\n\t\t\tif(powder_rec.Active != true)\n\t\t\t{\n\t\t\t\tstockBadgeClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\tstockIcon = &quot;ui-1-circle-remove&quot;;\n\t\t\t\tstockLabel = &quot;Inactive item&quot;;\n\t\t\t\tstockMessage = &quot;This powder is inactive. Confirm before purchasing or issuing stock.&quot;;\n\t\t\t\talertClass = &quot;alert-warn&quot;;\n\t\t\t}\n\t\t\telse if(availableQty &lt;= reorderQty)\n\t\t\t{\n\t\t\t\tstockBadgeClass = &quot;zcs-badge-red&quot;;\n\t\t\t\tstockIcon = &quot;ui-2-alert&quot;;\n\t\t\t\tstockLabel = &quot;Reorder warning&quot;;\n\t\t\t\tstockMessage = &quot;Current powder stock is at or below the reorder level.&quot;;\n\t\t\t\talertClass = &quot;alert-danger&quot;;\n\t\t\t}\n\t\t\treturnUrl = &quot;%23Page%3AInventory_Detail%3FItem_Type%3DPowder%26Item_ID%3D&quot; + powder_rec.ID;\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:Purchase_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Inventory Detail&lt;/h5&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Powder - &lt;%=powder_rec.Powder_Code%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Purchase_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Purchase Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;inventory-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t&lt;div class=&quot;inventory-hero-main&quot;&gt;\n\t\t\t\t&lt;div class=&quot;inventory-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Powder coating stock item&lt;/div&gt;\n\t\t\t\t&lt;h1 class=&quot;inventory-hero-title&quot;&gt;&lt;%=powder_rec.Powder_Name%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;inventory-hero-subtitle&quot;&gt;&lt;%=ifnull(powder_rec.Colour_Family,&quot;Colour family not set&quot;)%&gt; powder supplied by &lt;%=vendorName%&gt;. Consumption shown below comes from related Production_Records powder usage.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=stockBadgeClass%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline &lt;%=stockIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=stockLabel%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Unit: &lt;%=unitName%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(openPoCount &gt; 0,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-grey&quot;)%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Open PO lines: &lt;%=openPoCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;inventory-hero-side&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-uppercase zcs-font-semibold&quot;&gt;Current quantity&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-28 zcs-font-bold zcs-mt-8&quot;&gt;&lt;%=availableQty%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-mt-4&quot;&gt;&lt;%=unitName%&gt; available&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-mt-12&quot;&gt;Reorder level: &lt;strong&gt;&lt;%=reorderQty%&gt; &lt;%=unitName%&gt;&lt;/strong&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;kpi-grid&quot;&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline objects-color-palette&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=availableQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Available quantity&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-refresh-69&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=reorderQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Reorder level&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline e-commerce-shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=openPoQty%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Pending open PO quantity&lt;/div&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;kpi-card&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=powderConsumed%&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Related powder consumed&lt;/div&gt;&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;detail-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Stock status&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Reorder and vendor context&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=alertClass%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline &lt;%=stockIcon%&gt; zcs-font-20&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;&lt;%=stockLabel%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=stockMessage%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Vendor&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=vendorName%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Last updated&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(powder_rec.Last_Updated,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Active&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(powder_rec.Active == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-item&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Colour family&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(powder_rec.Colour_Family,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Product defaults&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Product_Catalogue records using this as the default powder&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=defaultProducts.count()%&gt; products&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Product&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Category&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Manufacturing mode&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Active&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tproductRowsShown = 0;\n\t\t\tfor each  productDefault in Product_Catalogue[Default_Powder == powder_rec.ID] sort by Product_Name asc\n\t\t\t{\n\t\t\t\tif(productRowsShown &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tproductRowsShown = productRowsShown + 1;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;strong&gt;&lt;%=productDefault.Product_Name%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;&lt;%=productDefault.Product_Code%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(productDefault.Product_Category,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(productDefault.Default_Manufacturing_Mode,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=if(productDefault.Active == true,&quot;zcs-green&quot;,&quot;zcs-yellow&quot;)%&gt;&quot;&gt;&lt;%=if(productDefault.Active == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(productRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;4&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No Product_Catalogue defaults reference this powder.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobileProductRows = 0;\n\t\t\tfor each  mproductDefault in Product_Catalogue[Default_Powder == powder_rec.ID] sort by Product_Name asc\n\t\t\t{\n\t\t\t\tif(mobileProductRows &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tmobileProductRows = mobileProductRows + 1;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;strong&gt;&lt;%=mproductDefault.Product_Name%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(mproductDefault.Product_Category,&quot;Not set&quot;)%&gt; | &lt;%=ifnull(mproductDefault.Default_Manufacturing_Mode,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobileProductRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No Product_Catalogue defaults reference this powder.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Production powder usage&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Related Production_Records with Production_Detail links&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Production&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Product&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Powder used&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Posted&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tprodRowsShown = 0;\n\t\t\tfor each  prod in Production_Records[Powder == powder_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(prodRowsShown &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tprodRowsShown = prodRowsShown + 1;\n\t\t\t\t\tprodHref = &quot;#Page:Production_Detail?Production_ID=&quot; + prod.ID;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=prodHref%&gt;&quot;&gt;&lt;%=prod.Production_Code%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;&lt;%=ifnull(prod.Customer_Order.Order_Code,&quot;Order pending&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(prod.Product.Product_Name,ifnull(prod.Product_Description,&quot;Product pending&quot;))%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=ifnull(prod.Production_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(prod.Powder_Qty_Used,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=if(prod.Powder_Consumption_Posted == true,&quot;zcs-green&quot;,&quot;zcs-yellow&quot;)%&gt;&quot;&gt;&lt;%=if(prod.Powder_Consumption_Posted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(prodRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No Production_Records currently reference this powder.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobileProdRows = 0;\n\t\t\tfor each  mprod in Production_Records[Powder == powder_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tif(mobileProdRows &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tmobileProdRows = mobileProdRows + 1;\n\t\t\t\t\tmProdHref = &quot;#Page:Production_Detail?Production_ID=&quot; + mprod.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mProdHref%&gt;&quot;&gt;&lt;strong&gt;&lt;%=mprod.Production_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=ifnull(mprod.Production_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(mprod.Product.Product_Name,ifnull(mprod.Product_Description,&quot;Product pending&quot;))%&gt; | Powder used: &lt;%=ifnull(mprod.Powder_Qty_Used,0)%&gt; | Posted: &lt;%=if(mprod.Powder_Consumption_Posted == true,&quot;Yes&quot;,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobileProdRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No Production_Records currently reference this powder.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Open purchase order lines&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Purchase_Order_Lines that can replenish this powder, linked to Purchase_Order_Detail&lt;/p&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(openPoCount &gt; 0,&quot;zcs-badge-blue&quot;,&quot;zcs-badge-grey&quot;)%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=openPoCount%&gt; open&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper desktop-table&quot;&gt;&lt;table class=&quot;zcs-w-full&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;PO&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Vendor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Ordered&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14 zcs-font-medium&quot;&gt;Received&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-text-left zcs-font-14 zcs-font-medium&quot;&gt;Expected&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;\n&lt;%\n\t\t\tpoRowsShown = 0;\n\t\t\tfor each  poLine in Purchase_Order_Lines[Powder == powder_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tpoLineStatus = ifnull(poLine.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(poLineStatus != &quot;Received&quot; &amp;&amp; poLineStatus != &quot;Cancelled&quot; &amp;&amp; poRowsShown &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tpoRowsShown = poRowsShown + 1;\n\t\t\t\t\tpoHref = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + poLine.Purchase_Order.ID;\n\t\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=poHref%&gt;&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.PO_Number,&quot;PO pending&quot;)%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-secondary&quot;&gt;Line &lt;%=ifnull(poLine.Line_Number,&quot;-&quot;)%&gt; | &lt;%=ifnull(poLine.Line_Type,&quot;-&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=poLineStatus%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-text-right zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Received_Quantity,0)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-8 zcs-font-14&quot;&gt;&lt;%=ifnull(poLine.Purchase_Order.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(poRowsShown == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;6&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-font-14 zcs-color-tertiary&quot;&gt;No open PO lines are currently linked to this powder.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\t\tmobilePoRows = 0;\n\t\t\tfor each  mpoLine in Purchase_Order_Lines[Powder == powder_rec.ID] sort by ID desc\n\t\t\t{\n\t\t\t\tmPoStatus = ifnull(mpoLine.Purchase_Order.PO_Status,&quot;&quot;);\n\t\t\t\tif(mPoStatus != &quot;Received&quot; &amp;&amp; mPoStatus != &quot;Cancelled&quot; &amp;&amp; mobilePoRows &lt; 10)\n\t\t\t\t{\n\t\t\t\t\tmobilePoRows = mobilePoRows + 1;\n\t\t\t\t\tmPoHref = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + mpoLine.Purchase_Order.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=mPoHref%&gt;&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mpoLine.Purchase_Order.PO_Number,&quot;PO pending&quot;)%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;span class=&quot;zcs-l_blue&quot;&gt;&lt;%=mPoStatus%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;Vendor: &lt;%=ifnull(mpoLine.Purchase_Order.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt; | Ordered: &lt;%=ifnull(mpoLine.Quantity,0)%&gt; | Received: &lt;%=ifnull(mpoLine.Received_Quantity,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(mobilePoRows == 0)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No open PO lines are currently linked to this powder.&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/section&gt;\n&lt;%\n\t\t}\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Office_Home
		{
					displayname = "Office Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Office_Home_Snippet' elementName='Office_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Office_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tawaitingGreenOrders = Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot; || Order_Status == &quot;On Hold&quot;];\n\trecentOrders = Customer_Orders[ID != 0];\n\tactivePermits = Permit_Records[Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot; &amp;&amp; Permit_Status != &quot;Expired&quot;];\n\tblockedInstallations = Installation_Schedules[Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot; || Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot; &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;];\n\tactiveOrders = Customer_Orders[Order_Status != &quot;Completed&quot; &amp;&amp; Order_Status != &quot;Cancelled&quot;];\n\tawaitingGreenCount = awaitingGreenOrders.count();\n\trecentOrdersCount = recentOrders.count();\n\tactivePermitsCount = activePermits.count();\n\tblockedInstallationsCount = blockedInstallations.count();\n\tactiveOrdersCount = activeOrders.count();\n\tstatusAwaitingCount = Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;].count();\n\tstatusGreenCount = Customer_Orders[Order_Status == &quot;Green Light&quot;].count();\n\tstatusProductionCount = Customer_Orders[Order_Status == &quot;In Production&quot;].count();\n\tstatusMaterialHoldCount = Customer_Orders[Order_Status == &quot;Material Hold&quot;].count();\n\tstatusReadyCount = Customer_Orders[Order_Status == &quot;Ready for Installation&quot;].count();\n\tstatusScheduledCount = Customer_Orders[Order_Status == &quot;Installation Scheduled&quot;].count();\n\tstatusInstalledCount = Customer_Orders[Order_Status == &quot;Installed&quot;].count();\n\tstatusInspectionCount = Customer_Orders[Order_Status == &quot;Inspection Required&quot;].count();\n\tstatusOnHoldCount = Customer_Orders[Order_Status == &quot;On Hold&quot;].count();\n\tawaitingPct = 0;\n\tgreenPct = 0;\n\tproductionPct = 0;\n\tmaterialHoldPct = 0;\n\treadyPct = 0;\n\tscheduledPct = 0;\n\tinstalledPct = 0;\n\tinspectionPct = 0;\n\tonHoldPct = 0;\n\tif(activeOrdersCount &gt; 0)\n\t{\n\t\tawaitingPct = (statusAwaitingCount * 100) / activeOrdersCount;\n\t\tgreenPct = (statusGreenCount * 100) / activeOrdersCount;\n\t\tproductionPct = (statusProductionCount * 100) / activeOrdersCount;\n\t\tmaterialHoldPct = (statusMaterialHoldCount * 100) / activeOrdersCount;\n\t\treadyPct = (statusReadyCount * 100) / activeOrdersCount;\n\t\tscheduledPct = (statusScheduledCount * 100) / activeOrdersCount;\n\t\tinstalledPct = (statusInstalledCount * 100) / activeOrdersCount;\n\t\tinspectionPct = (statusInspectionCount * 100) / activeOrdersCount;\n\t\tonHoldPct = (statusOnHoldCount * 100) / activeOrdersCount;\n\t}\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-template-card-badge { top: 0; right: 0; background-color: var(--zcs-theme-brand-color); border-bottom-left-radius: 32px; }\n.zcs-template-card .zcs-card-footer { background-color: #4C4C4C; display: none; bottom: 0; }\n.zcs-template-card:hover .zcs-card-footer { display: flex; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: #fff; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; text-decoration: none; }\n.zcs-primary-button { background-color: var(--zcs-theme-brand-color); color: var(--zcs_brand_foreground_color, #fff); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #174EA6); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-table-wrapper table tbody tr td.zcs-green, .zcs-green { color: #179E6C; }\n.zcs-table-wrapper table tbody tr td.zcs-red, .zcs-red { color: #FE455D; }\n.zcs-table-wrapper table tbody tr td.zcs-yellow, .zcs-yellow { color: #B8770D; }\n.zcs-table-wrapper table tbody tr td.zcs-blue, .zcs-blue { color: #2A6FFC; }\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-nodata-wrapper { min-height: 94px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\na { text-decoration: none; }\n.office-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 32%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.office-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1B2E5F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.office-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.office-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.office-eyebrow { letter-spacing: .08em; opacity: .78; }\n.office-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.office-subtitle { max-width: 820px; color: rgba(255,255,255,.82); margin: 0; }\n.office-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 210px; backdrop-filter: blur(10px); }\n.office-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.office-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.office-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.office-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.office-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.office-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.office-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }\n.office-kpi-link, .office-row-link, .office-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.office-section-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .85fr); gap: 16px; margin-top: 16px; }\n.office-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.office-panel { padding: 18px; }\n.office-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.office-panel-title { margin: 0; font-size: 18px; }\n.office-status-row { display: grid; grid-template-columns: minmax(160px, .8fr) minmax(0, 1.4fr) 54px; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid #EEF1F7; }\n.office-status-row:last-child { border-bottom: none; }\n.office-progress { height: 8px; background: var(--zcs-brand-soft); overflow: hidden; border-radius: 99px; }\n.office-progress-fill { height: inherit; border-radius: inherit; background: var(--bar-color, var(--zcs-theme-brand-color)); min-width: 2px; }\n.office-action-group { display: flex; flex-wrap: wrap; gap: 6px; }\n.office-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; }\n.office-action-hold { background: #FAAE13; color: #fff; }\n.office-action-cancel { background: #FE455D; color: #fff; }\n.office-action-green { background: #179E6C; color: #fff; }\n.office-mobile-card-list { display: none; }\n.office-mobile-record { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #fff; }\n.office-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.office-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }\n.office-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }\n.office-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.office-note { color: var(--zcs-teritiary-text-color); }\n@media (max-width: 1240px) { .office-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .office-section-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .office-two-col { grid-template-columns: 1fr; } .office-hero-content { flex-direction: column; } .office-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .office-home-shell { padding: 12px; } .office-hero { padding: 18px; border-radius: 18px; } .office-kpi-grid { grid-template-columns: 1fr; } .office-panel { padding: 14px; } .office-quick-grid { grid-template-columns: 1fr; } .office-table-wrap { display: none; } .office-mobile-card-list { display: grid; gap: 10px; } .office-panel-header { align-items: flex-start; flex-direction: column; } .office-status-row { grid-template-columns: 1fr; gap: 6px; } }\n&lt;/style&gt;\n&lt;div class=&quot;office-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;office-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;office-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Office workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;office-title zcs-font-bold&quot;&gt;Office Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;office-subtitle zcs-font-15&quot;&gt;Invoice mirror follow-up, green-light decisions, permit monitoring, and customer/order readiness in one mobile-ready workspace.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;office-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-value zcs-font-bold&quot;&gt;&lt;%=awaitingGreenCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-label zcs-font-13&quot;&gt;Orders awaiting office decision&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-kpi-link&quot; href=&quot;#Report:Orders_Awaiting_Green_Light&quot;&gt;Review queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-value zcs-font-bold&quot;&gt;&lt;%=recentOrdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-label zcs-font-13&quot;&gt;Mirrored invoices/orders&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-kpi-link&quot; href=&quot;#Report:All_Customer_Orders&quot;&gt;Open orders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F0ECFF;--kpi-color:#7656D6;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-value zcs-font-bold&quot;&gt;&lt;%=activePermitsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-label zcs-font-13&quot;&gt;Active permits&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-kpi-link&quot; href=&quot;#Report:Active_Permits&quot;&gt;Permit queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;office-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-value zcs-font-bold&quot;&gt;&lt;%=blockedInstallationsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;office-kpi-label zcs-font-13&quot;&gt;Installations blocked&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-kpi-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;View schedules&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;office-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;office-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Orders awaiting green light&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;office-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Use Add Comments popup links to set Green Light, On Hold, or Cancelled.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-panel-link&quot; href=&quot;#Report:Orders_Awaiting_Green_Light&quot;&gt;Full queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Order&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Expected&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Add Comments&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tgreenRows = 0;\n\tfor each  ord in Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot; || Order_Status == &quot;On Hold&quot;] sort by Order_Placement_Date asc\n\t{\n\t\tif(greenRows &lt; 8)\n\t\t{\n\t\t\tgreenRows = greenRows + 1;\n\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\tif(ord.Order_Status == &quot;On Hold&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\treturnUrl = &quot;%23Page%3AOffice_Home&quot;;\n\t\t\tgreenUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + ord.ID + &quot;&amp;New_Status=Green%20Light&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tholdUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + ord.ID + &quot;&amp;New_Status=On%20Hold&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + ord.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ord.Order_Code%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ord.Zoho_Books_Invoice_Number%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ord.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(ord.Area_or_City,&quot;Area pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(ord.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=ifnull(ord.Total_Amount,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=ord.Order_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;div class=&quot;office-action-group&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=greenUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Green Light&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=holdUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;On Hold&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;span&gt;Cancelled&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(greenRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No orders are waiting for a green-light decision.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-mobile-card-list&quot;&gt;\n&lt;%\n\tgreenMobileRows = 0;\n\tfor each  mord in Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot; || Order_Status == &quot;On Hold&quot;] sort by Order_Placement_Date asc\n\t{\n\t\tif(greenMobileRows &lt; 8)\n\t\t{\n\t\t\tgreenMobileRows = greenMobileRows + 1;\n\t\t\treturnUrlM = &quot;%23Page%3AOffice_Home&quot;;\n\t\t\tgreenUrlM = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + mord.ID + &quot;&amp;New_Status=Green%20Light&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrlM + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tholdUrlM = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + mord.ID + &quot;&amp;New_Status=On%20Hold&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrlM + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelUrlM = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + mord.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Office_Home&amp;Return_URL=&quot; + returnUrlM + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;office-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=mord.Order_Code%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-yellow zcs-font-12&quot;&gt;&lt;%=mord.Order_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;&lt;%=ifnull(mord.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Amount: &lt;%=ifnull(mord.Total_Amount,0)%&gt; \u00B7 Expected: &lt;%=ifnull(mord.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;office-action-group zcs-mt-8&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=greenUrlM%&gt;&quot;&gt;Green Light&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=holdUrlM%&gt;&quot;&gt;On Hold&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-button office-action office-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelUrlM%&gt;&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(greenMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No orders are waiting for a green-light decision.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Customer and order quick links&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-quick-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Form:Customer_Master?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-03&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Add customer&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Create customer record&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Form:Customer_Orders?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Add mirrored order&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Manual invoice copy&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Customers&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Customers&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Search customer master&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Customer_Orders&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Orders and invoices&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;All mirrored orders&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Active_Permits&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Active permits&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Monitor permit status&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;&lt;span class=&quot;office-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Installations&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Readiness and blockers&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;office-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;office-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Recent invoices/orders&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-panel-link&quot; href=&quot;#Report:All_Customer_Orders&quot;&gt;All orders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Invoice&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Customer&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Date&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Amount&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\trecentRows = 0;\n\tfor each  recent in Customer_Orders[ID != 0] sort by Order_Placement_Date desc\n\t{\n\t\tif(recentRows &lt; 7)\n\t\t{\n\t\t\trecentRows = recentRows + 1;\n\t\t\trStatusClass = &quot;zcs-badge-theme&quot;;\n\t\t\tif(recent.Order_Status == &quot;Awaiting Green Light&quot; || recent.Order_Status == &quot;Material Hold&quot;)\n\t\t\t{\n\t\t\t\trStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\tif(recent.Order_Status == &quot;Ready for Installation&quot; || recent.Order_Status == &quot;Installed&quot; || recent.Order_Status == &quot;Completed&quot;)\n\t\t\t{\n\t\t\t\trStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\tif(recent.Order_Status == &quot;Cancelled&quot;)\n\t\t\t{\n\t\t\t\trStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=recent.Zoho_Books_Invoice_Number%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=recent.Order_Code%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(recent.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(recent.Invoice_Date,recent.Order_Placement_Date)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=ifnull(recent.Total_Amount,0)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=rStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=recent.Order_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(recentRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No mirrored orders have been added yet.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-mobile-card-list&quot;&gt;\n&lt;%\n\trecentMobileRows = 0;\n\tfor each  recentM in Customer_Orders[ID != 0] sort by Order_Placement_Date desc\n\t{\n\t\tif(recentMobileRows &lt; 7)\n\t\t{\n\t\t\trecentMobileRows = recentMobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;office-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=recentM.Zoho_Books_Invoice_Number%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=recentM.Order_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;&lt;%=ifnull(recentM.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Amount: &lt;%=ifnull(recentM.Total_Amount,0)%&gt; \u00B7 Date: &lt;%=ifnull(recentM.Invoice_Date,recentM.Order_Placement_Date)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(recentMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No mirrored orders have been added yet.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;office-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Active orders by status&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-panel-link&quot; href=&quot;#Report:Active_Orders&quot;&gt;Active report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Awaiting Green Light&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#FAAE13;width:&lt;%=awaitingPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusAwaitingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Green Light&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=greenPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusGreenCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;In Production&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#2A6FFC;width:&lt;%=productionPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusProductionCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Material Hold&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#F4660C;width:&lt;%=materialHoldPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusMaterialHoldCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Ready for Installation&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=readyPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusReadyCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Installation Scheduled&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#1094C5;width:&lt;%=scheduledPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusScheduledCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Installed&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=installedPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusInstalledCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;Inspection Required&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#7656D6;width:&lt;%=inspectionPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusInspectionCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-status-row&quot;&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary&quot;&gt;On Hold&lt;/div&gt;&lt;div class=&quot;office-progress&quot;&gt;&lt;div class=&quot;office-progress-fill&quot; style=&quot;--bar-color:#242424;width:&lt;%=onHoldPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=statusOnHoldCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;office-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;office-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Active permits&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-panel-link&quot; href=&quot;#Report:Active_Permits&quot;&gt;All active permits&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Permit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Order&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Authority&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Submitted&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tpermitRows = 0;\n\tfor each  permit in Permit_Records[Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot; &amp;&amp; Permit_Status != &quot;Expired&quot;] sort by Submitted_Date desc\n\t{\n\t\tif(permitRows &lt; 6)\n\t\t{\n\t\t\tpermitRows = permitRows + 1;\n\t\t\tpClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(permit.Permit_Status == &quot;Required&quot; || permit.Permit_Status == &quot;Preparing&quot;)\n\t\t\t{\n\t\t\t\tpClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\tif(permit.Permit_Status == &quot;Rejected&quot;)\n\t\t\t{\n\t\t\t\tpClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=permit.Permit_Code%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(permit.Permit_Number,&quot;Number pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=permit.Customer_Order.Order_Code%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=permit.Customer.Customer_Name%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit.Authority_Name,&quot;Authority pending&quot;)%&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=pClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=permit.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit.Submitted_Date,&quot;Not submitted&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(permitRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No active permits are blocking office readiness.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-mobile-card-list&quot;&gt;\n&lt;%\n\tpermitMobileRows = 0;\n\tfor each  permitM in Permit_Records[Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot; &amp;&amp; Permit_Status != &quot;Expired&quot;] sort by Submitted_Date desc\n\t{\n\t\tif(permitMobileRows &lt; 6)\n\t\t{\n\t\t\tpermitMobileRows = permitMobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;office-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=permitM.Permit_Code%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=permitM.Permit_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;&lt;%=permitM.Customer_Order.Order_Code%&gt; \u00B7 &lt;%=permitM.Customer.Customer_Name%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(permitM.Authority_Name,&quot;Authority pending&quot;)%&gt; \u00B7 Submitted: &lt;%=ifnull(permitM.Submitted_Date,&quot;Not submitted&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(permitMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No active permits are blocking office readiness.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;office-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;office-panel-title zcs-font-semibold&quot;&gt;Installations blocked by permit or production&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;office-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&quot;&gt;All schedules&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-table-wrap zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Install&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Customer&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Production&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Permit&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Forecast&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tblockRows = 0;\n\tfor each  inst in Installation_Schedules[Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot; || Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot; &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(blockRows &lt; 6)\n\t\t{\n\t\t\tblockRows = blockRows + 1;\n\t\t\tprodClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(inst.Production_Readiness_Status == &quot;Not Ready&quot;)\n\t\t\t{\n\t\t\t\tprodClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\tif(inst.Production_Readiness_Status == &quot;Partially Ready&quot;)\n\t\t\t{\n\t\t\t\tprodClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\tpermitClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(inst.Permit_Clearance_Status == &quot;Blocked&quot;)\n\t\t\t{\n\t\t\t\tpermitClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\tif(inst.Permit_Clearance_Status == &quot;Required&quot; || inst.Permit_Clearance_Status == &quot;Submitted&quot;)\n\t\t\t{\n\t\t\t\tpermitClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=inst.Installation_Code%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=inst.Customer_Order.Order_Code%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(inst.Customer_Name_Snapshot,inst.Customer.Customer_Name)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(inst.Area_or_City,&quot;Area pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=prodClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=inst.Production_Readiness_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=permitClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=inst.Permit_Clearance_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(inst.Forecast_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(blockRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No installations are currently blocked by permit or production readiness.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;office-mobile-card-list&quot;&gt;\n&lt;%\n\tblockMobileRows = 0;\n\tfor each  instM in Installation_Schedules[Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot; || Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot; &amp;&amp; Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(blockMobileRows &lt; 6)\n\t\t{\n\t\t\tblockMobileRows = blockMobileRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;office-mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=instM.Installation_Code%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=instM.Customer_Order.Order_Code%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-primary zcs-mt-4&quot;&gt;&lt;%=ifnull(instM.Customer_Name_Snapshot,instM.Customer.Customer_Name)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Production: &lt;%=instM.Production_Readiness_Status%&gt; \u00B7 Permit: &lt;%=instM.Permit_Clearance_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(blockMobileRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No installations are currently blocked by permit or production readiness.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Order_Detail(int Order_ID)
		{
					displayname = "Order Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Order_Detail_Snippet' elementName='Order_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Order_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\torder_rec = Customer_Orders[ID == input.Order_ID];\n\tcanViewFinancial = false;\n\tcurrentProfile = thisapp.permissions.loginUserProfile();\n\tif(currentProfile == &quot;Administrator&quot; || currentProfile == &quot;Office_Staff&quot; || currentProfile == &quot;Admin&quot;)\n\t{\n\t\tcanViewFinancial = true;\n\t}\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\n.order-detail-page, .order-detail-page * { box-sizing: border-box; }\n.order-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zc-font-family, &quot;Poppins&quot;, &quot;Zoho Puvi&quot;, Arial, sans-serif); padding: 24px; }\na { text-decoration: none; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-5 { margin-top: .3125rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mt-20 { margin-top: 1.25rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: var(--zcs-white-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-green { color: #179e6c; }\n.zcs-red { color: #fe455d; }\n.zcs-yellow { color: #b8770d; }\n.zcs-l_blue { color: #1094c5; }\n.zcs-blue { color: #09598e; }\n.zcs-d_blue { color: #1328cd; }\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }\n.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }\n.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }\n.zcs-fw-button { width: 100%; }\n.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }\n.detail-shell { max-width: 1440px; margin: 0 auto; }\n.detail-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }\n.detail-hero:after { content: &apos;&apos;; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }\n.detail-hero-main, .detail-hero-side { position: relative; z-index: 1; }\n.detail-hero-main { min-width: 280px; flex: 1 1 520px; }\n.detail-hero-side { flex: 0 1 320px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }\n.detail-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }\n.detail-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }\n.detail-hero-subtitle { color: rgba(255,255,255,.78); max-width: 740px; margin: 8px 0 0; }\n.detail-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n.detail-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }\n.detail-action-green { --zcs-button-color: #179E6C; background: #179E6C; }\n.detail-action-hold { --zcs-button-color: #F4660C; background: #F4660C; }\n.detail-action-cancel { --zcs-button-color: #FE455D; background: #FE455D; }\n.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }\n.detail-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }\n.detail-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }\n.detail-card-body { padding: 18px 20px; }\n.detail-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }\n.detail-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.detail-span-12 { grid-column: span 12; }\n.detail-span-8 { grid-column: span 8; }\n.detail-span-6 { grid-column: span 6; }\n.detail-span-4 { grid-column: span 4; }\n.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }\n.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }\n.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }\n.readiness-bar { height: 10px; border-radius: 999px; overflow: hidden; background: #E8ECF5; margin-top: 12px; }\n.readiness-fill { height: 100%; background: linear-gradient(90deg, #179E6C, var(--zcs-theme-brand-color)); border-radius: inherit; }\n.link-list { display: flex; flex-direction: column; gap: 10px; }\n.link-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }\n.detail-link:hover, .row-link:hover { text-decoration: underline; }\n.production-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.production-card { border: 1px solid var(--zcs-border-color); border-radius: 16px; padding: 14px; background: #FBFCFF; }\n.production-meta { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; margin-top: 12px; }\n.production-meta div { font-size: 12px; color: var(--zcs-secondary-text-color); }\n.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }\n.comment-text { white-space: pre-wrap; word-break: break-word; }\n.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }\n.finance-locked { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 14px; background: var(--zcs-warning-soft); color: #8A5A00; border: 1px solid #FFE0A3; }\n.mobile-stack { display: none; }\n@media (max-width: 1100px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .production-list { grid-template-columns: 1fr; } }\n@media (max-width: 768px) { .order-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .detail-hero { padding: 18px; } .detail-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid, .production-meta { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;order-detail-page&quot;&gt;\n\t\t&lt;div class=&quot;detail-shell&quot;&gt;\n&lt;%\n\tif(order_rec.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot; style=&quot;min-height:60vh;&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border detail-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Order not found&lt;/h5&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;No Customer_Orders record matched Order_ID &lt;%=input.Order_ID%&gt;.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tproductionRecords = Production_Records[Customer_Order == order_rec.ID];\n\t\tpermitRecords = Permit_Records[Customer_Order == order_rec.ID];\n\t\tinstallationRecords = Installation_Schedules[Customer_Order == order_rec.ID];\n\t\tprodCount = productionRecords.count();\n\t\treadyCount = Production_Records[Customer_Order == order_rec.ID &amp;&amp; Production_Status == &quot;Ready for Installation&quot; || Production_Status == &quot;Purchased and Received&quot;].count();\n\t\tshortageCount = Production_Records[Customer_Order == order_rec.ID &amp;&amp; Production_Status == &quot;Material Shortage&quot; || Material_Status == &quot;Shortage Identified&quot;].count();\n\t\treadinessPct = 0;\n\t\tif(prodCount &gt; 0)\n\t\t{\n\t\t\treadinessPct = (readyCount * 100) / prodCount;\n\t\t}\n\t\torderStatusClass = &quot;zcs-badge-blue&quot;;\n\t\tif(order_rec.Order_Status == &quot;Completed&quot; || order_rec.Order_Status == &quot;Installed&quot; || order_rec.Order_Status == &quot;Green Light&quot;)\n\t\t{\n\t\t\torderStatusClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(order_rec.Order_Status == &quot;Cancelled&quot;)\n\t\t{\n\t\t\torderStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t\telse if(order_rec.Order_Status == &quot;On Hold&quot; || order_rec.Order_Status == &quot;Material Hold&quot;)\n\t\t{\n\t\t\torderStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(order_rec.Order_Status == &quot;Awaiting Green Light&quot;)\n\t\t{\n\t\t\torderStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\treturnUrl = &quot;%23Page%3AOrder_Detail%3FOrder_ID%3D&quot; + order_rec.ID;\n\t\tgreenUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + order_rec.ID + &quot;&amp;New_Status=Green%20Light&amp;Return_Page=Order_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\tholdUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + order_rec.ID + &quot;&amp;New_Status=On%20Hold&amp;Return_Page=Order_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\tcancelUrl = &quot;#Form:Action_Comments?Target_Module=Customer_Orders&amp;Lookup_ID=&quot; + order_rec.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Order_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a href=&quot;#Page:Office_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Order Detail&lt;/h5&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=order_rec.Order_Code%&gt; - Invoice &lt;%=ifnull(order_rec.Zoho_Books_Invoice_Number,&quot;Not entered&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Office_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Office Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Admin_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-home-minimal&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Admin Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;section class=&quot;detail-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-hero-main&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Mirrored invoice and operations order&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h1 class=&quot;detail-hero-title&quot;&gt;&lt;%=ifnull(order_rec.Customer_Name_Snapshot,&quot;Customer pending&quot;)%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;detail-hero-subtitle&quot;&gt;Invoice &lt;%=ifnull(order_rec.Zoho_Books_Invoice_Number,&quot;Not entered&quot;)%&gt; is currently &lt;%=order_rec.Order_Status%&gt;. Production, permit, installation, purchasing, and approval comments are shown below.&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=orderStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=order_rec.Order_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Permit: &lt;%=order_rec.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-action-group&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button detail-action detail-action-green zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=greenUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Green Light&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button detail-action detail-action-hold zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=holdUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span&gt;On Hold&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-button detail-action detail-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;span&gt;Cancelled&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-hero-side&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Profile: &lt;%=currentProfile%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Financial totals: &lt;%=if(canViewFinancial == true,&quot;Visible&quot;,&quot;Restricted&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t&lt;div class=&quot;detail-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Invoice and customer details&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Customer snapshots and copied Zoho Books invoice context.&lt;/p&gt;&lt;/div&gt;\n&lt;%\n\t\tif(order_rec.Zoho_Books_Invoice_URL != null &amp;&amp; order_rec.Zoho_Books_Invoice_URL != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;a class=&quot;detail-link zcs-font-13&quot; href=&quot;&lt;%=order_rec.Zoho_Books_Invoice_URL%&gt;&quot; target=&quot;_blank&quot;&gt;Open Books invoice&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Customer_Name_Snapshot,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Area or city&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Area_or_City,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Phone&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Customer_Phone,&quot;Not entered&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Email&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Customer_Email,&quot;Not entered&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Invoice date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Invoice_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Expected delivery&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Billing address&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Billing_Address.address_line_1,&quot;Not entered&quot;)%&gt; &lt;%=ifnull(order_rec.Billing_Address.address_line_2,&quot;&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(order_rec.Billing_Address.district_city,&quot;&quot;)%&gt; &lt;%=ifnull(order_rec.Billing_Address.state_province,&quot;&quot;)%&gt; &lt;%=ifnull(order_rec.Billing_Address.postal_Code,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Installation address&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Installation_Address.address_line_1,&quot;Not entered&quot;)%&gt; &lt;%=ifnull(order_rec.Installation_Address.address_line_2,&quot;&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(order_rec.Installation_Address.district_city,&quot;&quot;)%&gt; &lt;%=ifnull(order_rec.Installation_Address.state_province,&quot;&quot;)%&gt; &lt;%=ifnull(order_rec.Installation_Address.postal_Code,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Financial totals&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Visible only to administrator and office profiles.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n&lt;%\n\t\tif(canViewFinancial == true)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;kv-grid&quot; style=&quot;grid-template-columns:1fr;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Subtotal&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Subtotal,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Discount&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Discount_Total,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Tax&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Tax_Total,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Shipping or adjustment&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Shipping_or_Adjustment,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot; style=&quot;background:var(--zcs-brand-soft);&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Total amount&lt;/div&gt;&lt;div class=&quot;kv-value zcs-font-24 zcs-font-bold&quot;&gt;&lt;%=ifnull(order_rec.Total_Amount,0)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;finance-locked&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt;&lt;span&gt;Financial invoice totals are hidden for this profile.&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Operational readiness&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Production, permit, installation, and purchase linkage at a glance.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kpi-grid&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline design-2-ungroup&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Production records&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=prodCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Ready or received&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=readyCount%&gt;&lt;/div&gt;&lt;div class=&quot;readiness-bar&quot;&gt;&lt;div class=&quot;readiness-fill&quot; style=&quot;width:&lt;%=readinessPct%&gt;%;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Material shortages&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=shortageCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Permits&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=permitRecords.count()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Line items&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Products copied from the mirrored invoice/order.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Line&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Product&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Size and colour&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Qty&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Mode&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Permit&lt;/th&gt;\n&lt;%\n\t\tif(canViewFinancial == true)\n\t\t{\n\t\t\t%&gt;\n&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Line total&lt;/th&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tlineRows = 0;\n\t\tfor each  line in order_rec.Line_Items\n\t\t{\n\t\t\tlineRows = lineRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(line.Line_Number,lineRows)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(line.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(line.Product_Description,&quot;No description&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(line.Width,0)%&gt; x &lt;%=ifnull(line.Height,0)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(line.Colour,&quot;Colour not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=ifnull(line.Quantity,0)%&gt; &lt;%=ifnull(line.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(line.Manufacturing_Mode,&quot;Pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Powder: &lt;%=if(line.Requires_Powder_Coating == true,&quot;Required&quot;,&quot;Not required&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=if(line.Permit_Required == true,&quot;Required&quot;,&quot;Not required&quot;)%&gt;&lt;/td&gt;\n&lt;%\n\t\t\tif(canViewFinancial == true)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=ifnull(line.Line_Total,0)%&gt;&lt;/td&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\tif(lineRows == 0)\n\t\t{\n\t\t\tcolCount = 6;\n\t\t\tif(canViewFinancial == true)\n\t\t\t{\n\t\t\t\tcolCount = 7;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;&lt;%=colCount%&gt;&quot;&gt;No line items are attached to this order.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\tmobileLineRows = 0;\n\t\tfor each  mline in order_rec.Line_Items\n\t\t{\n\t\t\tmobileLineRows = mobileLineRows + 1;\n\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mline.Product.Product_Name,&quot;Product pending&quot;)%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Line &lt;%=ifnull(mline.Line_Number,mobileLineRows)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-6&quot;&gt;&lt;%=ifnull(mline.Product_Description,&quot;No description&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-8&quot;&gt;Qty &lt;%=ifnull(mline.Quantity,0)%&gt; &lt;%=ifnull(mline.Unit.Unit_Name,&quot;&quot;)%&gt; - &lt;%=ifnull(mline.Colour,&quot;Colour not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Mode &lt;%=ifnull(mline.Manufacturing_Mode,&quot;Pending&quot;)%&gt; - Permit &lt;%=if(mline.Permit_Required == true,&quot;Required&quot;,&quot;Not required&quot;)%&gt;&lt;/div&gt;\n&lt;%\n\t\t\tif(canViewFinancial == true)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-mt-8&quot;&gt;Line total: &lt;%=ifnull(mline.Line_Total,0)%&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(mobileLineRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No line items are attached to this order.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Production readiness&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;&lt;%=readyCount%&gt; of &lt;%=prodCount%&gt; production records are ready or purchased and received.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n&lt;%\n\t\tif(prodCount == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Production_Records were found for this order.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;production-list&quot;&gt;\n&lt;%\n\t\t\tfor each  prod in Production_Records[Customer_Order == order_rec.ID] sort by Priority_Sequence asc\n\t\t\t{\n\t\t\t\tprodStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(prod.Production_Status == &quot;Ready for Installation&quot; || prod.Production_Status == &quot;Purchased and Received&quot;)\n\t\t\t\t{\n\t\t\t\t\tprodStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(prod.Production_Status == &quot;Cancelled&quot;)\n\t\t\t\t{\n\t\t\t\t\tprodStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t}\n\t\t\t\telse if(prod.Production_Status == &quot;Material Shortage&quot; || prod.Production_Status == &quot;On Hold&quot;)\n\t\t\t\t{\n\t\t\t\t\tprodStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t}\n\t\t\t\tprodDetailUrl = &quot;#Page:Production_Detail?Production_ID=&quot; + prod.ID;\n\t\t\t\t%&gt;\n&lt;div class=&quot;production-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=prodDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=prod.Production_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(prod.Product.Product_Name,&quot;Product pending&quot;)%&gt; - &lt;%=ifnull(prod.Colour,&quot;Colour not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=prodStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=prod.Production_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;production-meta&quot;&gt;&lt;div&gt;Qty: &lt;%=ifnull(prod.Quantity,0)%&gt; &lt;%=ifnull(prod.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div&gt;Priority: &lt;%=ifnull(prod.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div&gt;Mode: &lt;%=ifnull(prod.Manufacturing_Mode,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;div&gt;Material: &lt;%=ifnull(prod.Material_Status,&quot;Not checked&quot;)%&gt;&lt;/div&gt;&lt;div&gt;Powder: &lt;%=ifnull(prod.Powder_Coating_Status,&quot;Not required&quot;)%&gt;&lt;/div&gt;&lt;div&gt;Ready date: &lt;%=ifnull(prod.Ready_For_Installation_Date,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Permit status&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Order permit records and clearance.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n&lt;%\n\t\tif(permitRecords.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Permit_Records were found. Order permit status is &lt;%=order_rec.Permit_Status%&gt;.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;link-list&quot;&gt;\n&lt;%\n\t\t\tfor each  permit in permitRecords\n\t\t\t{\n\t\t\t\tpermitUrl = &quot;#Page:Permit_Detail?Permit_ID=&quot; + permit.ID;\n\t\t\t\tpermitStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(permit.Permit_Status == &quot;Approved&quot; || permit.Permit_Status == &quot;Not Required&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(permit.Permit_Status == &quot;Rejected&quot; || permit.Permit_Status == &quot;Expired&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(permit.Permit_Status == &quot;Required&quot; || permit.Permit_Status == &quot;Preparing&quot;)\n\t\t\t\t{\n\t\t\t\t\tpermitStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=permitUrl%&gt;&quot;&gt;&lt;%=permit.Permit_Code%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(permit.Authority_Name,&quot;Authority pending&quot;)%&gt; - &lt;%=ifnull(permit.Permit_Number,&quot;No number&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=permitStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=permit.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Installation schedule&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Readiness, schedule, crew lead, and QC status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n&lt;%\n\t\tif(installationRecords.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Installation_Schedules record was found for this order.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;link-list&quot;&gt;\n&lt;%\n\t\t\tfor each  inst in Installation_Schedules[Customer_Order == order_rec.ID] sort by Priority_Sequence asc\n\t\t\t{\n\t\t\t\tinstUrl = &quot;#Page:Installation_Detail?Installation_ID=&quot; + inst.ID;\n\t\t\t\tinstStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(inst.Installation_Status == &quot;Completed&quot; || inst.Installation_Status == &quot;Installed&quot; || inst.Installation_Status == &quot;Inspection Completed&quot;)\n\t\t\t\t{\n\t\t\t\t\tinstStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(inst.Installation_Status == &quot;Cancelled&quot;)\n\t\t\t\t{\n\t\t\t\t\tinstStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t}\n\t\t\t\telse if(inst.Installation_Status == &quot;On Hold&quot;)\n\t\t\t\t{\n\t\t\t\t\tinstStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=instUrl%&gt;&quot;&gt;&lt;%=inst.Installation_Code%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(inst.Area_or_City,&quot;Location pending&quot;)%&gt; - &lt;%=ifnull(inst.Crew_Lead.Employee_Name,&quot;Crew not assigned&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Forecast &lt;%=ifnull(inst.Forecast_Date,&quot;Not set&quot;)%&gt; - Scheduled &lt;%=ifnull(inst.Scheduled_Start,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Production &lt;%=inst.Production_Readiness_Status%&gt; - Permit &lt;%=inst.Permit_Clearance_Status%&gt; - QC &lt;%=inst.Internal_QC_Status%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=instStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=inst.Installation_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Purchase order links&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;POs linked to production records for this order.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;link-list&quot;&gt;\n&lt;%\n\t\tpoRows = 0;\n\t\tfor each  prodPO in productionRecords\n\t\t{\n\t\t\tif(prodPO.Linked_PO != null)\n\t\t\t{\n\t\t\t\tfor each  poFromLookup in Purchase_Orders[ID == prodPO.Linked_PO]\n\t\t\t\t{\n\t\t\t\t\tpoRows = poRows + 1;\n\t\t\t\t\tpoUrl = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + poFromLookup.ID;\n\t\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=poUrl%&gt;&quot;&gt;&lt;%=poFromLookup.PO_Number%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Linked from production &lt;%=prodPO.Production_Code%&gt; - Vendor &lt;%=ifnull(poFromLookup.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=poFromLookup.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor each  linkedPO in Purchase_Orders[Linked_Production == prodPO.ID]\n\t\t\t{\n\t\t\t\tpoRows = poRows + 1;\n\t\t\t\tlinkedPoUrl = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + linkedPO.ID;\n\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=linkedPoUrl%&gt;&quot;&gt;&lt;%=linkedPO.PO_Number%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Linked production &lt;%=prodPO.Production_Code%&gt; - Vendor &lt;%=ifnull(linkedPO.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=linkedPO.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tif(poRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Purchase_Orders were found from this order&apos;s production records.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Comment history&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Action_Comments audit trail for the order and linked production, permit, installation, and PO records.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tcommentRows = 0;\n\t\tfor each  comment in Action_Comments[Target_Module == &quot;Customer_Orders&quot; &amp;&amp; Lookup_ID == order_rec.ID] sort by Action_Date desc\n\t\t{\n\t\t\tcommentRows = commentRows + 1;\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=comment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=comment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Customer_Orders&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(comment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=comment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tfor each  prodCommentTarget in productionRecords\n\t\t{\n\t\t\tfor each  prodComment in Action_Comments[Target_Module == &quot;Production_Records&quot; &amp;&amp; Lookup_ID == prodCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=prodComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=prodComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Production &lt;%=prodCommentTarget.Production_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(prodComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=prodComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  permitCommentTarget in permitRecords\n\t\t{\n\t\t\tfor each  permitComment in Action_Comments[Target_Module == &quot;Permit_Records&quot; &amp;&amp; Lookup_ID == permitCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=permitComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=permitComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Permit &lt;%=permitCommentTarget.Permit_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(permitComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=permitComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  instCommentTarget in installationRecords\n\t\t{\n\t\t\tfor each  instComment in Action_Comments[Target_Module == &quot;Installation_Schedules&quot; &amp;&amp; Lookup_ID == instCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=instComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=instComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Installation &lt;%=instCommentTarget.Installation_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(instComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=instComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  prodForPOComments in productionRecords\n\t\t{\n\t\t\tif(prodForPOComments.Linked_PO != null)\n\t\t\t{\n\t\t\t\tfor each  linkedLookupPOCommentTarget in Purchase_Orders[ID == prodForPOComments.Linked_PO]\n\t\t\t\t{\n\t\t\t\t\tfor each  linkedLookupPOComment in Action_Comments[Target_Module == &quot;Purchase_Orders&quot; &amp;&amp; Lookup_ID == linkedLookupPOCommentTarget.ID] sort by Action_Date desc\n\t\t\t\t\t{\n\t\t\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=linkedLookupPOComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=linkedLookupPOComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;PO &lt;%=linkedLookupPOCommentTarget.PO_Number%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(linkedLookupPOComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=linkedLookupPOComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor each  poCommentTarget in Purchase_Orders[Linked_Production == prodForPOComments.ID]\n\t\t\t{\n\t\t\t\tfor each  poComment in Action_Comments[Target_Module == &quot;Purchase_Orders&quot; &amp;&amp; Lookup_ID == poCommentTarget.ID] sort by Action_Date desc\n\t\t\t\t{\n\t\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=poComment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=poComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;PO &lt;%=poCommentTarget.PO_Number%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(poComment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=poComment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif(commentRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;li&gt;&lt;div class=&quot;empty-soft&quot;&gt;No Action_Comments have been recorded for this order or its linked operational records.&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/section&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Permit_Detail(int Permit_ID)
		{
					displayname = "Permit Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Permit_Detail_Snippet' elementName='Permit_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Permit_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tpermit_rec = Permit_Records[ID == input.Permit_ID];\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\na { text-decoration: none; }\n.permit-detail-page, .permit-detail-page * { box-sizing: border-box; }\n.permit-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zc-font-family, &quot;Poppins&quot;, &quot;Zoho Puvi&quot;, Arial, sans-serif); padding: 24px; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-w-full { width: 100%; }\n.zcs-wh-full { width: 100%; height: 100%; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-24 { padding-left: 1.5rem; padding-right: 1.5rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-5 { margin-top: .3125rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-30 { font-size: 1.875rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-white { color: #fff; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 12px; }\n.zcs-green { color: #179e6c; }\n.zcs-red { color: #fe455d; }\n.zcs-yellow { color: #b8770d; }\n.zcs-l_blue { color: #1094c5; }\n.zcs-blue { color: #09598e; }\n.zcs-d_blue { color: #1328cd; }\n.zcs-page-header { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 18px 50px rgba(16,24,40,.08); }\n.zcs-back { width: 36px; height: 36px; border: 1px solid var(--zcs-border-color); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: var(--zcs-teritiary-text-color); }\n.zcs-back:hover { color: var(--zcs-primary-text-color); border-color: var(--zcs-theme-brand-color); }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; border: 0; transition: all .2s ease; }\n.zcs-fw-button { width: 100%; }\n.zcs-primary-button { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs_brand_foreground_color, #fff); }\n.zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color, var(--zcs-theme-brand-color)); background-color: var(--zcs-white-color); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color, #164fc7); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color, var(--zcs-brand-soft)); color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; white-space: nowrap; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #A06309; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: var(--zcs-white-color); overflow: auto; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0px; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-tl-indicator { width: 60px; left: 16.6666666667%; }\n.zcs-tl-icon { width: 35px; height: 35px; background-color: #F5F4FA; color: #4B4274; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs_brand_color, var(--zcs-theme-brand-color)); border: 1px solid var(--zcs-white-color); box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }\n.zcs-tl-li-active .zcs-tl-icon { background-color: #E8EFFF; color: #2A6FFC; }\n.zcs-tl-li-complete .zcs-tl-icon { background-color: #E4FCF3; color: #179E6C; }\n.permit-shell { max-width: 1440px; margin: 0 auto; }\n.permit-hero { margin-top: 18px; padding: 24px; border-radius: 22px; color: #fff; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1328CD 58%, #1c1c40); box-shadow: 0 22px 60px rgba(19,40,205,.18); overflow: hidden; position: relative; }\n.permit-hero:after { content: &apos;&apos;; position: absolute; width: 280px; height: 280px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); }\n.permit-hero-main, .permit-hero-side { position: relative; z-index: 1; }\n.permit-hero-main { min-width: 280px; flex: 1 1 640px; }\n.permit-hero-side { flex: 0 1 360px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 18px; padding: 16px; }\n.permit-kicker { color: rgba(255,255,255,.74); letter-spacing: .08em; }\n.permit-hero-title { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 8px 0 0; }\n.permit-hero-subtitle { color: rgba(255,255,255,.78); max-width: 820px; margin: 8px 0 0; }\n.permit-action-group { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n.permit-action { min-height: 34px; min-width: 0; padding: 7px 12px; border-radius: 999px; font-size: 13px; }\n.permit-action-ready { background: #179E6C; }\n.permit-action-progress { background: #2A6FFC; }\n.permit-action-prep { background: #F4660C; }\n.permit-action-reject { background: #FE455D; }\n.permit-action-neutral { background: #242424; }\n.permit-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }\n.permit-card { background: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 16px 44px rgba(16,24,40,.06); overflow: hidden; }\n.permit-card-header { padding: 18px 20px; border-bottom: 1px solid var(--zcs-border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }\n.permit-card-body { padding: 18px 20px; }\n.permit-card-title { margin: 0; font-size: 18px; font-weight: 650; line-height: 1.25; }\n.permit-card-note { margin: 4px 0 0; color: var(--zcs-secondary-text-color); font-size: 13px; }\n.permit-span-12 { grid-column: span 12; }\n.permit-span-8 { grid-column: span 8; }\n.permit-span-6 { grid-column: span 6; }\n.permit-span-4 { grid-column: span 4; }\n.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.kv { padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; min-width: 0; }\n.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kv-value { color: var(--zcs-primary-text-color); font-size: 14px; margin-top: 4px; word-break: break-word; }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.kpi { padding: 14px; border-radius: 16px; border: 1px solid var(--zcs-border-color); background: linear-gradient(180deg, #FFFFFF, #FBFCFF); }\n.kpi-icon { width: 36px; height: 36px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.kpi-label { margin-top: 10px; font-size: 12px; color: var(--zcs-teritiary-text-color); text-transform: uppercase; letter-spacing: .05em; font-weight: 650; }\n.kpi-value { margin-top: 4px; font-size: 22px; font-weight: 750; color: var(--zcs-primary-text-color); }\n.link-list { display: flex; flex-direction: column; gap: 10px; }\n.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.detail-link, .row-link { color: var(--zcs-theme-brand-color); font-weight: 650; }\n.detail-link:hover, .row-link:hover { text-decoration: underline; }\n.effect-list { display: grid; gap: 10px; }\n.effect { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }\n.effect i { margin-top: 2px; }\n.effect-ok { background: var(--zcs-success-soft); border-color: #BEEBD7; color: #176B4B; }\n.effect-warn { background: var(--zcs-warning-soft); border-color: #FFE0A3; color: #8A5A00; }\n.effect-danger { background: var(--zcs-danger-soft); border-color: #FFC3CC; color: #8B1B2B; }\n.document-box { border: 1px dashed var(--zcs-border-color); border-radius: 16px; padding: 18px; background: #FBFCFF; word-break: break-word; }\n.document-link { display: inline-flex; align-items: center; gap: 8px; color: var(--zcs-theme-brand-color); font-weight: 650; }\n.document-link:hover { text-decoration: underline; }\n.notes-box { white-space: pre-wrap; word-break: break-word; padding: 16px; border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; }\n.comment-module { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--zcs-teritiary-text-color); font-weight: 650; }\n.comment-text { white-space: pre-wrap; word-break: break-word; }\n.empty-soft { padding: 28px 18px; border: 1px dashed var(--zcs-border-color); border-radius: 16px; color: var(--zcs-teritiary-text-color); text-align: center; background: #FBFCFF; }\n.mobile-stack { display: none; }\n@media (max-width: 1100px) { .permit-span-8, .permit-span-6, .permit-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 768px) { .permit-detail-page { padding: 14px; } .zcs-page-header { padding: 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .zcs-page-header .zcs-button-text { display: none; } .permit-hero { padding: 18px; } .permit-hero-side { flex: 1 1 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .permit-card-header { flex-direction: column; } .desktop-only { display: none; } .mobile-stack { display: grid; gap: 10px; } .mobile-record { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; } .link-row { flex-direction: column; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0px; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; } .zcs-tl-li .zcs-flex.zcs-direction-column { padding-left: 60px; padding-right: 0; width: 100%; max-width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;permit-detail-page&quot;&gt;\n\t&lt;div class=&quot;permit-shell&quot;&gt;\n&lt;%\n\tif(permit_rec.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-wh-full zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot; style=&quot;min-height:60vh;&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border permit-card&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;Permit not found&lt;/h5&gt;\n\t\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;No Permit_Records record matched Permit_ID &lt;%=input.Permit_ID%&gt;.&lt;/p&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\torder_rec = Customer_Orders[ID == permit_rec.Customer_Order];\n\t\tinstallRecords = Installation_Schedules[Customer_Order == permit_rec.Customer_Order] sort by Forecast_Date asc;\n\t\tinstallCount = installRecords.count();\n\t\tblockedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order &amp;&amp; Permit_Clearance_Status == &quot;Blocked&quot;].count();\n\t\tclearedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order &amp;&amp; Permit_Clearance_Status == &quot;Approved&quot; || Permit_Clearance_Status == &quot;Not Required&quot;].count();\n\t\tsubmittedInstallCount = Installation_Schedules[Customer_Order == permit_rec.Customer_Order &amp;&amp; Permit_Clearance_Status == &quot;Submitted&quot;].count();\n\t\tpermitIsClear = false;\n\t\tif(permit_rec.Permit_Status == &quot;Approved&quot; || permit_rec.Permit_Status == &quot;Not Required&quot;)\n\t\t{\n\t\t\tpermitIsClear = true;\n\t\t}\n\t\tpermitExpiredByDate = false;\n\t\tif(permit_rec.Expiry_Date != null &amp;&amp; permit_rec.Expiry_Date &lt; zoho.currentdate &amp;&amp; permit_rec.Permit_Status == &quot;Approved&quot;)\n\t\t{\n\t\t\tpermitExpiredByDate = true;\n\t\t}\n\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\tif(permit_rec.Permit_Status == &quot;Approved&quot; || permit_rec.Permit_Status == &quot;Not Required&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(permit_rec.Permit_Status == &quot;Required&quot; || permit_rec.Permit_Status == &quot;Preparing&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\treturnUrl = &quot;%23Page%3APermit_Detail%3FPermit_ID%3D&quot; + permit_rec.ID;\n\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;a href=&quot;#Page:Office_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zcs-color-tertiary zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Permit Detail&lt;/h5&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=permit_rec.Permit_Code%&gt; - &lt;%=ifnull(permit_rec.Authority_Name,&quot;Authority pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Office_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Office Home&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\torderUrl = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=orderUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-single&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Order&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;section class=&quot;permit-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t\t&lt;div class=&quot;permit-hero-main&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Authority, dates, documents, order clearance, and audit history&lt;/div&gt;\n\t\t\t\t\t&lt;h1 class=&quot;permit-hero-title&quot;&gt;&lt;%=ifnull(permit_rec.Authority_Name,&quot;Permit authority pending&quot;)%&gt;&lt;/h1&gt;\n\t\t\t\t\t&lt;p class=&quot;permit-hero-subtitle&quot;&gt;&lt;%=permit_rec.Permit_Code%&gt; is currently &lt;%=permit_rec.Permit_Status%&gt;. This page shows the permit number, submitted/approved/expiry dates, document attachment, linked order, installation clearance effect, and comment-driven permit actions.&lt;/p&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=permit_rec.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(permitIsClear == true,&quot;zcs-badge-green&quot;,if(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot;,&quot;zcs-badge-red&quot;,&quot;zcs-badge-yellow&quot;))%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline location-pin&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Installation clearance: &lt;%=if(permitIsClear == true,&quot;Clear&quot;,if(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot;,&quot;Blocked&quot;,&quot;Pending&quot;))%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(permitExpiredByDate == true,&quot;zcs-badge-red&quot;,&quot;zcs-badge-blue&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zcs-no-shrink zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Expiry: &lt;%=ifnull(permit_rec.Expiry_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-action-group&quot;&gt;\n&lt;%\n\t\tactionStatuses = {&quot;Preparing&quot;,&quot;Submitted&quot;,&quot;Approved&quot;,&quot;Rejected&quot;,&quot;Expired&quot;,&quot;Not Required&quot;};\n\t\tfor each  actionStatus in actionStatuses\n\t\t{\n\t\t\tactionParam = actionStatus;\n\t\t\tif(actionStatus == &quot;Not Required&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Not%20Required&quot;;\n\t\t\t}\n\t\t\tactionClass = &quot;permit-action-progress&quot;;\n\t\t\tactionIcon = &quot;loader-dots-06&quot;;\n\t\t\tif(actionStatus == &quot;Preparing&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-prep&quot;;\n\t\t\t\tactionIcon = &quot;design-todo&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Submitted&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-progress&quot;;\n\t\t\t\tactionIcon = &quot;files-single-folded-content&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Approved&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-ready&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Rejected&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-reject&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-simple-remove&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Expired&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-neutral&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-time&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Not Required&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;permit-action-ready&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\tactionHref = &quot;#Form:Action_Comments?Target_Module=Permit_Records&amp;Lookup_ID=&quot; + permit_rec.ID + &quot;&amp;New_Status=&quot; + actionParam + &quot;&amp;Return_Page=Permit_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-button permit-action &lt;%=actionClass%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=actionHref%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline &lt;%=actionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=actionStatus%&gt;&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;permit-hero-side&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Linked order&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=order_rec.Order_Code%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nOrder not found\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Customer:\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(order_rec.Customer_Name_Snapshot,order_rec.Customer.Customer_Name)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNot available\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Installation schedules: &lt;%=installCount%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Blocked by permit: &lt;%=blockedInstallCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;div class=&quot;permit-grid&quot;&gt;\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-8&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Permit summary&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Authority, permit number, required flag, status, and date controls.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Permit code&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=permit_rec.Permit_Code%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Status&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=permit_rec.Permit_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Authority name&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Authority_Name,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Permit number&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Permit_Number,&quot;Not assigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Permit required&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(permit_rec.Permit_Required == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Customer.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Submitted date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Submitted_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Approved date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Approved_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Expiry date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(permit_rec.Expiry_Date,&quot;Not set&quot;)%&gt;\n&lt;%\n\t\tif(permitExpiredByDate == true)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;zcs-font-12 zcs-red zcs-mt-4&quot;&gt;Approved permit appears past its expiry date.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Order permit status&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=order_rec.Permit_Status%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nOrder not found\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-4&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Permit document&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Attached authority submission or approval file.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;document-box&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;strong&gt;Permit documents&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-8&quot;&gt;\n&lt;%\n\t\tdocValue = ifnull(permit_rec.Permit_Documents,&quot;&quot;);\n\t\tif(docValue != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;a class=&quot;document-link&quot; href=&quot;&lt;%=docValue%&gt;&quot; target=&quot;_blank&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-share-91&quot;&gt;&lt;/i&gt;&lt;span&gt;Open permit document&lt;/span&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-8&quot;&gt;&lt;%=permit_rec.Permit_Documents%&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNo permit documents are attached yet.\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;notes-box zcs-mt-12&quot;&gt;&lt;strong&gt;Permit notes&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=ifnull(permit_rec.Permit_Notes,&quot;No permit notes captured.&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Readiness impact&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;How the current permit status affects linked installation scheduling.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi-grid&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-folder-15&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Permit clearance&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=if(permitIsClear == true,&quot;Clear&quot;,if(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot;,&quot;Blocked&quot;,&quot;Pending&quot;))%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline location-pin&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Linked schedules&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=installCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Cleared schedules&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=clearedInstallCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;div class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;div class=&quot;kpi-label&quot;&gt;Blocked schedules&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=blockedInstallCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;effect-list zcs-mt-16&quot;&gt;\n&lt;%\n\t\tif(permitIsClear == true)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;effect effect-ok&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Permit is clear for installation.&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Approved or Not Required permits allow Installation_Schedules.Permit_Clearance_Status to clear and can support Ready to Schedule when production is ready.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;effect effect-danger&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Permit blocks installation readiness.&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Rejected or Expired permits should keep installation clearance blocked until a new action/comment updates the permit.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;effect effect-warn&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Permit is pending.&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Required, Preparing, and Submitted permits hold installation clearance until the authority approves or the permit is marked Not Required.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(permitExpiredByDate == true)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;effect effect-danger&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Expiry date needs review.&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;The permit status is Approved, but the expiry date is earlier than today.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Linked order&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Order-level context connected to this permit.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Customer_Orders record was found for this permit.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\torderUrl2 = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Order&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=orderUrl2%&gt;&quot;&gt;&lt;%=order_rec.Order_Code%&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Order status&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=order_rec.Order_Status%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Customer_Name_Snapshot,order_rec.Customer.Customer_Name)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Area or city&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Area_or_City,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Invoice number&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Zoho_Books_Invoice_Number,&quot;Not entered&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Expected delivery&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Requires permit&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(order_rec.Requires_Permit == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer contact&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(order_rec.Customer_Phone,&quot;No phone&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(order_rec.Customer_Email,&quot;No email&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Installation clearance effect&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Linked Installation_Schedules records and permit clearance status.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-only&quot;&gt;\n\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Installation&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Schedule&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Permit clearance&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Effect&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tinstallRows = 0;\n\t\tfor each  inst in installRecords\n\t\t{\n\t\t\tinstallRows = installRows + 1;\n\t\t\tinstUrl = &quot;#Page:Installation_Detail?Installation_ID=&quot; + inst.ID;\n\t\t\tinstallStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(inst.Permit_Clearance_Status == &quot;Approved&quot; || inst.Permit_Clearance_Status == &quot;Not Required&quot;)\n\t\t\t{\n\t\t\t\tinstallStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(inst.Permit_Clearance_Status == &quot;Blocked&quot;)\n\t\t\t{\n\t\t\t\tinstallStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(inst.Permit_Clearance_Status == &quot;Required&quot; || inst.Permit_Clearance_Status == &quot;Submitted&quot;)\n\t\t\t{\n\t\t\t\tinstallStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=instUrl%&gt;&quot;&gt;&lt;%=inst.Installation_Code%&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(inst.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=inst.Installation_Status%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Forecast &lt;%=ifnull(inst.Forecast_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=installStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=inst.Permit_Clearance_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=if(inst.Permit_Clearance_Status == &quot;Approved&quot; || inst.Permit_Clearance_Status == &quot;Not Required&quot;,&quot;Clear to schedule when production is ready&quot;,if(inst.Permit_Clearance_Status == &quot;Blocked&quot;,&quot;Installation blocked by permit&quot;,&quot;Awaiting permit clearance&quot;))%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\tif(installRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No linked Installation_Schedules records were found for this permit order.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;mobile-stack&quot;&gt;\n&lt;%\n\t\tmobileInstallRows = 0;\n\t\tfor each  minst in installRecords\n\t\t{\n\t\t\tmobileInstallRows = mobileInstallRows + 1;\n\t\t\tminstUrl = &quot;#Page:Installation_Detail?Installation_ID=&quot; + minst.ID;\n\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=minstUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=minst.Installation_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=minst.Permit_Clearance_Status%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-6&quot;&gt;&lt;%=minst.Installation_Status%&gt; - &lt;%=ifnull(minst.Area_or_City,&quot;Location pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Forecast &lt;%=ifnull(minst.Forecast_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(mobileInstallRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked Installation_Schedules records were found for this permit order.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Permit status timeline&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Current permit progress through the authority lifecycle.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tpermitSteps = {&quot;Required&quot;,&quot;Preparing&quot;,&quot;Submitted&quot;,&quot;Approved&quot;};\n\t\tcurrentStepIndex = permitSteps.indexOf(permit_rec.Permit_Status);\n\t\tfor each index stepIndex in permitSteps\n\t\t{\n\t\t\tstepStatus = permitSteps.get(stepIndex);\n\t\t\ttlClass = &quot;&quot;;\n\t\t\ticonName = &quot;ui-2-time&quot;;\n\t\t\tstatusText = &quot;Awaiting previous stage&quot;;\n\t\t\tif(currentStepIndex &gt; stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-complete&quot;;\n\t\t\t\ticonName = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\tstatusText = &quot;Completed or passed&quot;;\n\t\t\t}\n\t\t\telse if(currentStepIndex == stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-active&quot;;\n\t\t\t\ticonName = &quot;loader-dots-06&quot;;\n\t\t\t\tstatusText = &quot;Current permit stage&quot;;\n\t\t\t}\n\t\t\tif(permit_rec.Permit_Status == &quot;Not Required&quot;)\n\t\t\t{\n\t\t\t\tstatusText = &quot;Skipped because permit is not required&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li &lt;%=tlClass%&gt; zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline &lt;%=iconName%&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step &lt;%=stepIndex + 1%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=stepStatus%&gt;&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=statusText%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(permit_rec.Permit_Status == &quot;Rejected&quot; || permit_rec.Permit_Status == &quot;Expired&quot; || permit_rec.Permit_Status == &quot;Not Required&quot;)\n\t\t{\n\t\t\texceptionIcon = &quot;ui-2-alert-circle&quot;;\n\t\t\texceptionStyle = &quot;background:#FDE3E6;color:#FE455D;&quot;;\n\t\t\tif(permit_rec.Permit_Status == &quot;Not Required&quot;)\n\t\t\t{\n\t\t\t\texceptionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t\texceptionStyle = &quot;background:#E4FCF3;color:#179E6C;&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline &lt;%=exceptionIcon%&gt;&quot; style=&quot;&lt;%=exceptionStyle%&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Outcome&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=permit_rec.Permit_Status%&gt;&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;See comment history for reason and next action.&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-6&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Key dates and references&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Operational checkpoints needed by office and installation teams.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;link-list&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;strong&gt;Submitted to authority&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Submission date captured on Permit_Records.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit_rec.Submitted_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;strong&gt;Authority approval&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Approval date drives installation clearance.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit_rec.Approved_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;strong&gt;Expiry review&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Expired permits should be moved to Expired through Action_Comments.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit_rec.Expiry_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;strong&gt;Permit number&lt;/strong&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Authority-issued reference.&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(permit_rec.Permit_Number,&quot;Not assigned&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t&lt;section class=&quot;permit-card permit-span-12&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;permit-card-title&quot;&gt;Comment history&lt;/h2&gt;&lt;p class=&quot;permit-card-note&quot;&gt;Action_Comments audit trail for this permit, linked order, and linked installation schedules.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;permit-card-body&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tcommentRows = 0;\n\t\tfor each  comment in Action_Comments[Target_Module == &quot;Permit_Records&quot; &amp;&amp; Lookup_ID == permit_rec.ID] sort by Action_Date desc\n\t\t{\n\t\t\tcommentRows = commentRows + 1;\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=ifnull(comment.Action_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=comment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Permit_Records&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=ifnull(comment.Submitted_By,&quot;Unknown user&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=ifnull(comment.Comments,&quot;No comment entered.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\tfor each  orderComment in Action_Comments[Target_Module == &quot;Customer_Orders&quot; &amp;&amp; Lookup_ID == order_rec.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=ifnull(orderComment.Action_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=orderComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Customer_Orders&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=ifnull(orderComment.Submitted_By,&quot;Unknown user&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=ifnull(orderComment.Comments,&quot;No comment entered.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tfor each  installCommentTarget in installRecords\n\t\t{\n\t\t\tfor each  instComment in Action_Comments[Target_Module == &quot;Installation_Schedules&quot; &amp;&amp; Lookup_ID == installCommentTarget.ID] sort by Action_Date desc\n\t\t\t{\n\t\t\t\tcommentRows = commentRows + 1;\n\t\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=ifnull(instComment.Action_Date,&quot;No date&quot;)%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=instComment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Installation_Schedules&lt;/span&gt;&lt;span class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;&lt;%=ifnull(instComment.Submitted_By,&quot;Unknown user&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=ifnull(instComment.Comments,&quot;No comment entered.&quot;)%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tif(commentRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;li&gt;&lt;div class=&quot;empty-soft&quot;&gt;No Action_Comments have been recorded for this permit or linked operational records.&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/section&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Purchase_Home
		{
					displayname = "Purchase Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Purchase_Home_Snippet' elementName='Purchase_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Purchase_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tlowMaterials = Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tlowPowders = Powder_Coating_Inventory[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tpendingApprovals = Purchase_Orders[PO_Status == &quot;Submitted for Approval&quot;];\n\topenPOs = Purchase_Orders[PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;];\n\texpectedReceiving = Purchase_Orders[PO_Status == &quot;Approved&quot; || PO_Status == &quot;Ordered&quot; || PO_Status == &quot;Partially Received&quot; &amp;&amp; Expected_Delivery_Date != null];\n\trecentReceived = Purchase_Orders[PO_Status == &quot;Received&quot;];\n\tproductionNeeds = Production_Records[Production_Status == &quot;Material Shortage&quot; || Production_Status == &quot;Final Product Purchase&quot; || Material_Status == &quot;Shortage Identified&quot; || Material_Status == &quot;Requested&quot; || Manufacturing_Mode == &quot;Purchase Finished Product&quot; &amp;&amp; Production_Status != &quot;Purchased and Received&quot; &amp;&amp; Production_Status != &quot;Ready for Installation&quot; &amp;&amp; Production_Status != &quot;Cancelled&quot;];\n\tserviceNeeds = Service_Requests[Service_Status == &quot;Parts Required&quot;];\n\tlowMaterialsCount = lowMaterials.count();\n\tlowPowdersCount = lowPowders.count();\n\tpendingApprovalsCount = pendingApprovals.count();\n\topenPOsCount = openPOs.count();\n\texpectedReceivingCount = expectedReceiving.count();\n\trecentReceivedCount = recentReceived.count();\n\tproductionNeedsCount = productionNeeds.count();\n\tserviceNeedsCount = serviceNeeds.count();\n\tpurchaseNeedsCount = productionNeedsCount + serviceNeedsCount;\n\topenPOValue = openPOs.sum(Total_Amount);\n\tpendingPOValue = pendingApprovals.sum(Total_Amount);\n\treturnUrl = &quot;%23Page%3APurchase_Home&quot;;\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-14 { gap: .875rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-14 { padding: .875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-8 { padding-left: .5rem; padding-right: .5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\na { text-decoration: none; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 840px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-quick-action-item { list-style-type: none; }\n.zcs-quick-action-item:hover .zcs-quick-action-link { color: var(--zcs-theme-brand-color); }\n.zcs-quick-action-item:hover .zcs-quick-action-text { text-decoration: underline; }\n.zcs-nodata-wrapper { min-height: 94px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.purchase-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.purchase-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #1B2E5F); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.purchase-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.purchase-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.purchase-eyebrow { letter-spacing: .08em; opacity: .78; }\n.purchase-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.purchase-subtitle { max-width: 860px; color: rgba(255,255,255,.82); margin: 0; }\n.purchase-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }\n.purchase-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.purchase-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.purchase-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.purchase-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.purchase-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.purchase-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.purchase-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }\n.purchase-kpi-link, .purchase-row-link, .purchase-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.purchase-section-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .85fr); gap: 16px; margin-top: 16px; }\n.purchase-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.purchase-panel { padding: 18px; }\n.purchase-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.purchase-panel-title { margin: 0; font-size: 18px; }\n.purchase-note { color: var(--zcs-teritiary-text-color); }\n.purchase-action-group { display: flex; flex-wrap: wrap; gap: 6px; }\n.purchase-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; line-height: 1.2; }\n.purchase-action-submit { --action-color:#B8770D; border-color:#B8770D; color:#B8770D; }\n.purchase-action-approve { --action-color:#179E6C; border-color:#179E6C; color:#179E6C; }\n.purchase-action-order { --action-color:#2A6FFC; border-color:#2A6FFC; color:#2A6FFC; }\n.purchase-action-receive { --action-color:#1094C5; border-color:#1094C5; color:#1094C5; }\n.purchase-action-cancel { --action-color:#FE455D; border-color:#FE455D; color:#FE455D; }\n.purchase-action:hover { background: color-mix(in srgb, var(--action-color, var(--zcs-theme-brand-color)) 10%, #fff); }\n.purchase-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.purchase-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }\n.purchase-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }\n.purchase-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.purchase-stock-warning { color: #B8770D; }\n.purchase-stock-critical { color: #FE455D; }\n.purchase-money { font-variant-numeric: tabular-nums; }\n.purchase-linked-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n@media (max-width: 1240px) { .purchase-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .purchase-section-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .purchase-two-col { grid-template-columns: 1fr; } .purchase-hero-content { flex-direction: column; } .purchase-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .purchase-home-shell { padding: 12px; } .purchase-hero { padding: 18px; border-radius: 18px; } .purchase-kpi-grid { grid-template-columns: 1fr; } .purchase-panel { padding: 14px; } .purchase-quick-grid { grid-template-columns: 1fr; } .purchase-panel-header { align-items: flex-start; flex-direction: column; } .purchase-responsive-table table, .purchase-responsive-table thead, .purchase-responsive-table tbody, .purchase-responsive-table th, .purchase-responsive-table td, .purchase-responsive-table tr { display: block; min-width: 0; width: 100%; } .purchase-responsive-table thead { display: none; } .purchase-responsive-table tbody tr { border-top: 1px solid var(--zcs-border-color); padding: 10px 0; } .purchase-responsive-table tbody tr:first-child { border-top: none; } .purchase-responsive-table tbody tr td { border-top: none; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 8px; padding: 6px 12px; } .purchase-responsive-table tbody tr td:before { content: attr(data-label); color: var(--zcs-teritiary-text-color); font-size: 12px; font-weight: 600; } .purchase-responsive-table tbody tr td[colspan]:before { content: &apos;&apos;; display:none; } .purchase-action-group { margin-top: 4px; } }\n&lt;/style&gt;\n&lt;div class=&quot;purchase-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;purchase-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Purchase and stores workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;purchase-title zcs-font-bold&quot;&gt;Purchase Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-subtitle zcs-font-15&quot;&gt;Stock alerts, PO approvals, ordering, receiving, vendor access, and production or service-linked purchase needs in one mobile-ready view.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;purchase-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=lowMaterialsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Low raw material stock&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:Low_Material_Stock&quot;&gt;Open alert report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-palette zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=lowPowdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Low powder stock&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:Low_Powder_Stock&quot;&gt;Open powder alerts&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=pendingApprovalsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Pending PO approvals&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:Pending_PO_Approvals&quot;&gt;Approval queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAFBF4;--kpi-color:#179E6C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=openPOsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Open purchase orders&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:Open_Purchase_Orders&quot;&gt;Open PO report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F0ECFF;--kpi-color:#7656D6;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=expectedReceivingCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Expected receiving entries&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:PO_Receiving_Calendar&quot;&gt;Receiving calendar&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline arrows-1-tail-right zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold&quot;&gt;&lt;%=purchaseNeedsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Production/service purchase needs&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:All_Production_Records&quot;&gt;Review source work&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F8F0EB;--kpi-color:#F4660C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-money-coins zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold purchase-money&quot;&gt;&lt;%=ifnull(openPOValue,0)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Open PO total value&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:All_Purchase_Orders&quot;&gt;Financial PO list&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;purchase-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EEF1F7;--kpi-color:#5D6372;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-value zcs-font-bold purchase-money&quot;&gt;&lt;%=ifnull(pendingPOValue,0)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;purchase-kpi-label zcs-font-13&quot;&gt;Pending approval value&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-kpi-link&quot; href=&quot;#Report:Pending_PO_Approvals&quot;&gt;Approve with comments&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;purchase-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Pending PO approvals&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Use Add Comments popup links for approval decisions. Financial totals are visible for Purchase Stores users.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:Pending_PO_Approvals&quot;&gt;Full approval queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;PO&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Vendor&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Requested by&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Subtotal / Tax / Total&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Add Comments&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tpendingRows = 0;\n\tfor each  po in Purchase_Orders[PO_Status == &quot;Submitted for Approval&quot;] sort by PO_Date asc\n\t{\n\t\tif(pendingRows &lt; 8)\n\t\t{\n\t\t\tpendingRows = pendingRows + 1;\n\t\t\tapproveUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + po.ID + &quot;&amp;New_Status=Approved&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + po.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;PO&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=po.PO_Number%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(po.PO_Date,&quot;PO date pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Vendor&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(po.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Expected: &lt;%=ifnull(po.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Requested by&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;%=ifnull(po.Requested_By.Employee_Name,&quot;Not set&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Subtotal / Tax / Total&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right purchase-money&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Subtotal&lt;/span&gt; &lt;%=ifnull(po.Subtotal,0)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Tax&lt;/span&gt; &lt;%=ifnull(po.Tax_Total,0)%&gt;&lt;br&gt;&lt;strong&gt;&lt;%=ifnull(po.Total_Amount,0)%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=po.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Add Comments&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;div class=&quot;purchase-action-group&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-approve zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=approveUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span&gt;Approved&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-simple-remove&quot;&gt;&lt;/i&gt;&lt;span&gt;Cancelled&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(pendingRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No POs are currently submitted for approval.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Vendor quick links&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-quick-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Form:Vendor_Master?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-handshake&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Add vendor&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Create vendor master&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Vendors&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-03&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;All vendors&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Contacts and lead times&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Form:Purchase_Orders?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Create purchase order&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Header and lines&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Purchase_Order_Lines&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;PO lines&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Rates, tax, receipts&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Low_Material_Stock&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Material alerts&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Raw material reorder list&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:PO_Receiving_Calendar&quot;&gt;&lt;span class=&quot;purchase-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Receiving calendar&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Expected delivery dates&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;purchase-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Low raw material stock&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Available quantity is at or below reorder level.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:Low_Material_Stock&quot;&gt;All materials&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Material&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Available&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Reorder&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Vendor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tmatRows = 0;\n\tfor each  mat in Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true] sort by Available_Quantity asc\n\t{\n\t\tif(matRows &lt; 8)\n\t\t{\n\t\t\tmatRows = matRows + 1;\n\t\t\tshortage = ifnull(mat.Reorder_Level,0) - ifnull(mat.Available_Quantity,0);\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;Material&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=mat.Material_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(mat.Material_Category,&quot;Category pending&quot;)%&gt; \u00B7 &lt;%=ifnull(mat.Stock_Unit.Unit_Name,&quot;Unit pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Available&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-stock-critical&quot;&gt;&lt;%=ifnull(mat.Available_Quantity,0)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Reorder&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right&quot;&gt;&lt;%=ifnull(mat.Reorder_Level,0)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Need &lt;%=shortage%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Vendor&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(mat.Default_Vendor.Vendor_Name,&quot;Vendor not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Action&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Form:Purchase_Orders?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;span&gt;Create PO&lt;/span&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(matRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No low raw material stock alerts.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Low powder stock&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Powder coating inventory at or below reorder level.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:Low_Powder_Stock&quot;&gt;All powders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Powder&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Available&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Reorder&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Vendor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Action&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tpowderRows = 0;\n\tfor each  powder in Powder_Coating_Inventory[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true] sort by Available_Quantity asc\n\t{\n\t\tif(powderRows &lt; 8)\n\t\t{\n\t\t\tpowderRows = powderRows + 1;\n\t\t\tpowderNeed = ifnull(powder.Reorder_Level,0) - ifnull(powder.Available_Quantity,0);\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;Powder&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=powder.Powder_Name%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(powder.Colour_Family,&quot;Colour pending&quot;)%&gt; \u00B7 &lt;%=ifnull(powder.Stock_Unit.Unit_Name,&quot;Unit pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Available&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-stock-critical&quot;&gt;&lt;%=ifnull(powder.Available_Quantity,0)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Reorder&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right&quot;&gt;&lt;%=ifnull(powder.Reorder_Level,0)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Need &lt;%=powderNeed%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Vendor&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(powder.Vendor.Vendor_Name,&quot;Vendor not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Action&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Form:Purchase_Orders?zc_LoadIn=dialog&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;span&gt;Create PO&lt;/span&gt;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(powderRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No low powder stock alerts.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;purchase-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Open purchase orders&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Includes draft, approval, ordered, and partially received POs. Status changes are captured through Add Comments.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:Open_Purchase_Orders&quot;&gt;Open PO report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;PO&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Vendor / Link&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Expected&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Discount / Tax / Total&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Add Comments&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\topenRows = 0;\n\tfor each  opo in Purchase_Orders[PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;] sort by Expected_Delivery_Date asc\n\t{\n\t\tif(openRows &lt; 10)\n\t\t{\n\t\t\topenRows = openRows + 1;\n\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tif(opo.PO_Status == &quot;Submitted for Approval&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(opo.PO_Status == &quot;Approved&quot; || opo.PO_Status == &quot;Ordered&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t}\n\t\t\telse if(opo.PO_Status == &quot;Partially Received&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\tsubmitUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Submitted%20for%20Approval&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tapproveUrlO = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Approved&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\torderedUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Ordered&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tpartialUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Partially%20Received&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\treceivedUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Received&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelUrlO = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + opo.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;PO&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=opo.PO_Number%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(opo.PO_Date,&quot;PO date pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Vendor / Link&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(opo.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Production: &lt;%=ifnull(opo.Linked_Production.Production_Code,&quot;None&quot;)%&gt; \u00B7 Service: &lt;%=ifnull(opo.Linked_Service.Service_Code,&quot;None&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Expected&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(opo.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Discount / Tax / Total&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-money&quot;&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Discount&lt;/span&gt; &lt;%=ifnull(opo.Discount_Total,0)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Tax&lt;/span&gt; &lt;%=ifnull(opo.Tax_Total,0)%&gt;&lt;br&gt;&lt;strong&gt;&lt;%=ifnull(opo.Total_Amount,0)%&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=opo.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Add Comments&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;div class=&quot;purchase-action-group&quot;&gt;\n&lt;%\n\t\t\tif(opo.PO_Status == &quot;Draft&quot;)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-submit zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=submitUrl%&gt;&quot;&gt;Submitted for Approval&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(opo.PO_Status == &quot;Submitted for Approval&quot;)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-approve zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=approveUrlO%&gt;&quot;&gt;Approved&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(opo.PO_Status == &quot;Approved&quot;)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=orderedUrl%&gt;&quot;&gt;Ordered&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\tif(opo.PO_Status == &quot;Ordered&quot; || opo.PO_Status == &quot;Partially Received&quot;)\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=partialUrl%&gt;&quot;&gt;Partially Received&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=receivedUrl%&gt;&quot;&gt;Received&lt;/a&gt;\n&lt;%\n\t\t\t}\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-cancel zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelUrlO%&gt;&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(openRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No open purchase orders.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Expected receiving list&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Receiving calendar view plus near-term ordered or approved PO list.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:PO_Receiving_Calendar&quot;&gt;Calendar&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\trecvRows = 0;\n\tfor each  recv in Purchase_Orders[PO_Status == &quot;Approved&quot; || PO_Status == &quot;Ordered&quot; || PO_Status == &quot;Partially Received&quot; &amp;&amp; Expected_Delivery_Date != null] sort by Expected_Delivery_Date asc\n\t{\n\t\tif(recvRows &lt; 8)\n\t\t{\n\t\t\trecvRows = recvRows + 1;\n\t\t\trecvStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(recv.PO_Status == &quot;Partially Received&quot;)\n\t\t\t{\n\t\t\t\trecvStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\trecvPartialUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + recv.ID + &quot;&amp;New_Status=Partially%20Received&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\trecvReceivedUrl = &quot;#Form:Action_Comments?Target_Module=Purchase_Orders&amp;Lookup_ID=&quot; + recv.ID + &quot;&amp;New_Status=Received&amp;Return_Page=Purchase_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;purchase-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=recv.PO_Number%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(recv.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Expected: &lt;%=recv.Expected_Delivery_Date%&gt; \u00B7 Total: &lt;span class=&quot;purchase-money&quot;&gt;&lt;%=ifnull(recv.Total_Amount,0)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=recvStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=recv.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;purchase-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=recvPartialUrl%&gt;&quot;&gt;Partially Received&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-receive zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=recvReceivedUrl%&gt;&quot;&gt;Received&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(recvRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No expected receiving dates are pending.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;purchase-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Recently received POs&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Latest received purchase orders and stock posting reference.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:All_Purchase_Orders&quot;&gt;All purchase orders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;PO&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Vendor&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Expected date&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Total&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\treceivedRows = 0;\n\tfor each  rpo in Purchase_Orders[PO_Status == &quot;Received&quot;] sort by Expected_Delivery_Date desc\n\t{\n\t\tif(receivedRows &lt; 8)\n\t\t{\n\t\t\treceivedRows = receivedRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;PO&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=rpo.PO_Number%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(rpo.PO_Date,&quot;PO date pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Vendor&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(rpo.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Expected date&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(rpo.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Total&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right purchase-money&quot;&gt;&lt;%=ifnull(rpo.Total_Amount,0)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=rpo.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(receivedRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No POs have been marked received yet.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;purchase-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;purchase-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;purchase-panel-title zcs-font-semibold&quot;&gt;Production and service-linked purchase needs&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;purchase-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Create linked POs from shortage, final-product purchase, and service parts-required records.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;purchase-panel-link&quot; href=&quot;#Report:All_Purchase_Orders&quot;&gt;PO report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\tneedRows = 0;\n\tfor each  prod in Production_Records[Production_Status == &quot;Material Shortage&quot; || Production_Status == &quot;Final Product Purchase&quot; || Material_Status == &quot;Shortage Identified&quot; || Material_Status == &quot;Requested&quot; || Manufacturing_Mode == &quot;Purchase Finished Product&quot; &amp;&amp; Production_Status != &quot;Purchased and Received&quot; &amp;&amp; Production_Status != &quot;Ready for Installation&quot; &amp;&amp; Production_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(needRows &lt; 5)\n\t\t{\n\t\t\tneedRows = needRows + 1;\n\t\t\tcreateProdPOUrl = &quot;#Form:Purchase_Orders?Linked_Production=&quot; + prod.ID + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;purchase-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;strong&gt;Production &lt;%=prod.Production_Code%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(prod.Product.Product_Name,&quot;Product pending&quot;)%&gt; \u00B7 Qty &lt;%=ifnull(prod.Quantity,0)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Mode: &lt;%=ifnull(prod.Manufacturing_Mode,&quot;Not set&quot;)%&gt; \u00B7 Material: &lt;%=ifnull(prod.Material_Status,&quot;Not checked&quot;)%&gt; \u00B7 Linked PO: &lt;%=ifnull(prod.Linked_PO.PO_Number,&quot;None&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=prod.Production_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;purchase-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=createProdPOUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;span&gt;Create linked PO&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Report:All_Production_Records&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span&gt;Production report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tfor each  svc in Service_Requests[Service_Status == &quot;Parts Required&quot;] sort by Request_Date asc\n\t{\n\t\tif(needRows &lt; 8)\n\t\t{\n\t\t\tneedRows = needRows + 1;\n\t\t\tcreateSvcPOUrl = &quot;#Form:Purchase_Orders?Linked_Service=&quot; + svc.ID + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;purchase-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;strong&gt;Service &lt;%=svc.Service_Code%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(svc.Customer_Name,&quot;Customer pending&quot;)%&gt; \u00B7 &lt;%=ifnull(svc.Priority,&quot;Priority pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Request: &lt;%=ifnull(svc.Request_Date,&quot;Not set&quot;)%&gt; \u00B7 Linked PO: &lt;%=ifnull(svc.Linked_PO.PO_Number,&quot;None&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=svc.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;purchase-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action purchase-action-order zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=createSvcPOUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;span&gt;Create linked PO&lt;/span&gt;&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button purchase-action zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span&gt;Service report&lt;/span&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(needRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No production or service-linked purchase needs are waiting.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Service_Detail(int Service_ID)
		{
					displayname = "Service Detail"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Service_Detail_Snippet' elementName='Service_Detail_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Service_Detail_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tsvc_rec = Service_Requests[ID == input.Service_ID];\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n/* ===== zcs-global.css ===== */\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-danger-soft: #FFECEF; --zcs-warning-soft: #FFF6E3; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; --zcs-purple-soft: #F0ECFF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\na { text-decoration: none; }\n.service-detail-page, .service-detail-page * { box-sizing: border-box; }\n.service-detail-page { min-height: 100vh; width: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34rem), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 24px; overflow: auto; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-2 { flex: 0 0 16.6667%; max-width: 16.6667%; }\n.zcs-col-10 { flex: 0 0 83.3333%; max-width: 83.3333%; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-gap-24 { gap: 1.5rem; }\n.zcs-gap-32 { gap: 2rem; }\n.zcs-p-0 { padding: 0; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-px-30 { padding-left: 1.875rem; padding-right: 1.875rem; }\n.zcs-px-60 { padding-left: 3.75rem; padding-right: 3.75rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-py-24 { padding-top: 1.5rem; padding-bottom: 1.5rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-5 { margin-top: .3125rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-22 { font-size: 1.375rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-rounded-half { border-radius: 50%; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-h-full { height: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n/* ZCS Header, Button, Badge, Table, Timeline, No Data adaptations */\n.zcs-page-header { border: 1px solid var(--zcs-border-color); border-radius: 18px; background: rgba(255,255,255,.88); box-shadow: 0 12px 32px rgba(16,24,40,.06); margin-bottom: 16px; }\n.zcs-back { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.zcs-back:hover { background: var(--zcs-theme-brand-color); color: #fff; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-button { background-color: var(--zcs-theme-brand-color); border: 1px solid var(--zcs-theme-brand-color); color: #fff; }\n.zcs-primary-button:hover { filter: brightness(.96); color: #fff; }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; color: #fff; }\n.zcs-badge-filled-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #5D6372; border-color: #5D6372; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #EEF1F7; border-color: #5D6372; color: #5D6372; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 880px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-nodata-wrapper { min-height: 104px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.zcs-tl-indicator { width: 60px; left: 16.6667%; }\n.zcs-tl-dot { width: 12px; height: 12px; background-color: var(--zcs-theme-brand-color); border: 1px solid #fff; box-shadow: 0 2px 6px 0 #C4DEE4; }\n.zcs-tl-icon { width: 35px; height: 35px; background: #EEF1F7; color: #5D6372; }\n.zcs-tl-li:not(:last-child) .zcs-tl-indicator:before { content: &apos;&apos;; display: flex; position: absolute; width: 1px; height: calc(100% + 32px); background-color: #E1E1E1; top: 5px; }\n.zcs-tl-li-complete .zcs-tl-icon { background:#E4FCF3; color:#179E6C; }\n.zcs-tl-li-active .zcs-tl-icon { background:var(--zcs-brand-soft); color:var(--zcs-theme-brand-color); animation: pulse-dot 1.25s cubic-bezier(.455,.03,.515,.955) -.4s infinite; }\n@keyframes pulse-dot { 0% { transform: scale(.88); } 50% { transform: scale(1); } 100% { transform: scale(.88); } }\n.service-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #18335C); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.service-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.service-hero-main, .service-hero-side { position: relative; z-index: 1; }\n.service-hero-main { flex: 1 1 640px; min-width: 0; }\n.service-hero-side { flex: 0 0 270px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 18px; padding: 16px; backdrop-filter: blur(10px); }\n.service-kicker { letter-spacing: .08em; opacity: .78; }\n.service-hero-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 6px 0 8px; }\n.service-hero-subtitle { color: rgba(255,255,255,.82); margin: 0; max-width: 880px; }\n.service-action-group { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; }\n.service-action { min-width: auto; min-height: 31px; padding: 5px 10px; border-radius: 8px; font-size: 12px; line-height: 1.2; }\n.service-action-triage { --action-soft:#F0ECFF; border-color:#7656D6; color:#7656D6; }\n.service-action-scheduled { --action-soft:#E8EFFF; border-color:#2A6FFC; color:#2A6FFC; }\n.service-action-progress { --action-soft:#EAF7FF; border-color:#1094C5; color:#1094C5; }\n.service-action-parts { --action-soft:#FCF4E6; border-color:#B8770D; color:#B8770D; }\n.service-action-repaired { --action-soft:#E4FCF3; border-color:#179E6C; color:#179E6C; }\n.service-action-completed { --action-soft:#EAFBF4; border-color:#007943; color:#007943; }\n.service-action-closed { --action-soft:#EEF1F7; border-color:#5D6372; color:#5D6372; }\n.service-action-cancelled { --action-soft:#FDE3E6; border-color:#FE455D; color:#FE455D; }\n.service-action:hover { background: var(--action-soft, var(--zcs-brand-soft)); }\n.detail-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.detail-card { background: #fff; border: 1px solid var(--zcs-border-color); border-radius: 18px; box-shadow: 0 10px 30px rgba(16,24,40,.05); overflow: hidden; }\n.detail-span-12 { grid-column: span 12; }\n.detail-span-8 { grid-column: span 8; }\n.detail-span-6 { grid-column: span 6; }\n.detail-span-4 { grid-column: span 4; }\n.detail-card-header { padding: 18px 18px 0; display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }\n.detail-card-title { font-size: 18px; line-height: 1.25; margin: 0; }\n.detail-card-note { color: var(--zcs-teritiary-text-color); font-size: 13px; margin: 4px 0 0; }\n.detail-card-body { padding: 18px; }\n.kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.kv { border: 1px solid var(--zcs-border-color); border-radius: 14px; padding: 12px; background: #FBFCFF; min-width: 0; }\n.kv-label { color: var(--zcs-teritiary-text-color); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }\n.kv-value { margin-top: 4px; color: var(--zcs-primary-text-color); font-size: 14px; overflow-wrap: anywhere; }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.kpi { border: 1px solid var(--zcs-border-color); border-radius: 16px; background: #FBFCFF; padding: 14px; }\n.kpi-icon { width: 38px; height: 38px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.kpi-label { color: var(--zcs-teritiary-text-color); font-size: 12px; margin-top: 8px; }\n.kpi-value { font-size: 26px; font-weight: 700; line-height: 1.1; margin-top: 2px; }\n.row-link { color: var(--zcs-theme-brand-color); font-weight: 600; }\n.row-link:hover { text-decoration: underline; }\n.info-box, .photo-box { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; }\n.alert-list { display: flex; flex-direction: column; gap: 10px; }\n.alert-row { display: flex; gap: 10px; padding: 12px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #FBFCFF; }\n.alert-row i { margin-top: 2px; }\n.alert-ok { background: #F5FFFA; border-color: #CFF4E4; }\n.alert-ok i { color: #179E6C; }\n.alert-warn { background: #FFF8EA; border-color: #F7DFA8; }\n.alert-warn i { color: #B8770D; }\n.alert-danger { background: #FFF1F3; border-color: #FAC4CD; }\n.alert-danger i { color: #FE455D; }\n.stock-warning { color:#B8770D; font-weight:600; }\n.stock-danger { color:#FE455D; font-weight:600; }\n.stock-ok { color:#179E6C; font-weight:600; }\n.link-list { display: flex; flex-direction: column; gap: 12px; }\n.link-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; }\n.comment-module { display:inline-flex; align-items:center; padding: 2px 8px; border-radius: 999px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); font-size: 12px; font-weight: 600; }\n.comment-text { white-space: pre-wrap; }\n.mobile-stack { display: none; }\n.mobile-record { border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; padding: 14px; margin-bottom: 10px; }\n.empty-soft { border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 16px; color: var(--zcs-teritiary-text-color); background: #FBFCFF; }\n@media (max-width: 1180px) { .detail-span-8, .detail-span-6, .detail-span-4 { grid-column: span 12; } .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 768px) { .service-detail-page { padding: 12px; } .zcs-page-header { padding: 12px 14px; border-radius: 16px; align-items: flex-start; flex-direction: column; } .service-hero { padding: 18px; border-radius: 18px; } .service-hero-side { flex-basis: auto; width: 100%; } .kv-grid, .kpi-grid { grid-template-columns: 1fr; } .detail-card-header { flex-direction: column; } .desktop-table { display: none; } .mobile-stack { display: block; } .zcs-tl-li { flex-direction: column; } .zcs-tl-indicator { left: 0; } .zcs-tl-time { text-align: left; padding: 0 60px; margin-bottom: 12px; max-width: 100%; flex-basis: auto; } .zcs-tl-li .zcs-col-10 { max-width: 100%; flex-basis: auto; padding-left: 60px; padding-right: 0; } .link-row { flex-direction: column; } .service-action { flex: 1 1 auto; } }\n@media (max-width: 560px) { .service-action-group { flex-direction: column; } .service-action { width: 100%; } }\n&lt;/style&gt;\n&lt;div class=&quot;service-detail-page&quot;&gt;\n&lt;%\n\tif(svc_rec.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;\n\t\t\t\t&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No service request found&lt;/h5&gt;\n\t\t\t\t&lt;p class=&quot;zcs-font-14 zcs-color-secondary zcs-mt-8 zcs-mb-0&quot;&gt;Service_ID &lt;%=input.Service_ID%&gt; does not match an existing Service_Requests record.&lt;/p&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-mt-12&quot; href=&quot;#Page:Service_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span&gt;Service Home&lt;/span&gt;&lt;/a&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\tcustomer_rec = Customer_Master[ID == svc_rec.Customer];\n\t\torder_rec = Customer_Orders[ID == svc_rec.Related_Order];\n\t\tpartRecords = Service_Parts_Usage[Service_Request == svc_rec.ID];\n\t\tprimaryPo = Purchase_Orders[ID == svc_rec.Linked_PO];\n\t\tservicePOs = Purchase_Orders[Linked_Service == svc_rec.ID];\n\t\tactionComments = Action_Comments[Target_Module == &quot;Service_Requests&quot; &amp;&amp; Lookup_ID == svc_rec.ID];\n\t\tpartsCount = partRecords.count();\n\t\tshortageCount = 0;\n\t\treorderWarnCount = 0;\n\t\tunpostedCount = 0;\n\t\tfor each  stockUsage in partRecords\n\t\t{\n\t\t\tstockQty = ifnull(stockUsage.Material.Available_Quantity,0);\n\t\t\treorderQty = ifnull(stockUsage.Material.Reorder_Level,0);\n\t\t\tusedQty = ifnull(stockUsage.Quantity_Used,0);\n\t\t\tif(usedQty &gt; stockQty)\n\t\t\t{\n\t\t\t\tshortageCount = shortageCount + 1;\n\t\t\t}\n\t\t\tif(stockQty &lt;= reorderQty)\n\t\t\t{\n\t\t\t\treorderWarnCount = reorderWarnCount + 1;\n\t\t\t}\n\t\t\tif(stockUsage.Stock_Deducted != true)\n\t\t\t{\n\t\t\t\tunpostedCount = unpostedCount + 1;\n\t\t\t}\n\t\t}\n\t\tpoCount = servicePOs.count();\n\t\tif(primaryPo.count() &gt; 0)\n\t\t{\n\t\t\tpoCount = poCount + 1;\n\t\t}\n\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\tif(svc_rec.Service_Status == &quot;New&quot; || svc_rec.Service_Status == &quot;Triage&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(svc_rec.Service_Status == &quot;Scheduled&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t}\n\t\telse if(svc_rec.Service_Status == &quot;In Progress&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-theme&quot;;\n\t\t}\n\t\telse if(svc_rec.Service_Status == &quot;Parts Required&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t}\n\t\telse if(svc_rec.Service_Status == &quot;Repaired&quot; || svc_rec.Service_Status == &quot;Completed&quot; || svc_rec.Service_Status == &quot;Closed&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t}\n\t\telse if(svc_rec.Service_Status == &quot;Cancelled&quot;)\n\t\t{\n\t\t\tstatusClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\tpriorityClass = &quot;zcs-badge-blue&quot;;\n\t\tif(svc_rec.Priority == &quot;Urgent&quot;)\n\t\t{\n\t\t\tpriorityClass = &quot;zcs-badge-red&quot;;\n\t\t}\n\t\telse if(svc_rec.Priority == &quot;High&quot;)\n\t\t{\n\t\t\tpriorityClass = &quot;zcs-badge-orange&quot;;\n\t\t}\n\t\telse if(svc_rec.Priority == &quot;Low&quot;)\n\t\t{\n\t\t\tpriorityClass = &quot;zcs-badge-grey&quot;;\n\t\t}\n\t\tcompletionReady = false;\n\t\tif(svc_rec.Service_Status == &quot;Completed&quot; || svc_rec.Service_Status == &quot;Closed&quot;)\n\t\t{\n\t\t\tcompletionReady = true;\n\t\t}\n\t\treturnUrl = &quot;%23Page%3AService_Detail%3FService_ID%3D&quot; + svc_rec.ID;\n\t\t%&gt;\n&lt;div class=&quot;zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border&quot;&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-ellipsis&quot;&gt;\n\t\t\t\t&lt;a href=&quot;#Page:Service_Home&quot; class=&quot;zcs-back&quot;&gt;&lt;i class=&quot;zcs-back-icon zcs-font-22 zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;/a&gt;\n\t\t\t\t&lt;div class=&quot;zcs-ellipsis&quot;&gt;\n\t\t\t\t\t&lt;h5 class=&quot;zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0&quot;&gt;Service Detail&lt;/h5&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=svc_rec.Service_Code%&gt; - &lt;%=ifnull(svc_rec.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-12 zcs-row-wrap&quot;&gt;\n\t\t\t\t&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;#Page:Service_Home&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline arrows-1-tail-left&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Service Home&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\torderUrl = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body&quot; href=&quot;&lt;%=orderUrl%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline files-single&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-button-text&quot;&gt;Related order&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;section class=&quot;service-hero zcs-flex zcs-row-wrap zcs-gap-24 zcs-justify-space-between&quot;&gt;\n\t\t\t&lt;div class=&quot;service-hero-main&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-kicker zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Issue, schedule, technician, parts, PO, photos, and closure&lt;/div&gt;\n\t\t\t\t&lt;h1 class=&quot;service-hero-title&quot;&gt;&lt;%=ifnull(svc_rec.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/h1&gt;\n\t\t\t\t&lt;p class=&quot;service-hero-subtitle&quot;&gt;&lt;%=svc_rec.Service_Code%&gt; is currently &lt;%=svc_rec.Service_Status%&gt;. Use the Add Comments popup links below to record status changes and preserve the audit trail.&lt;/p&gt;\n\t\t\t\t&lt;div class=&quot;zcs-flex zcs-row-wrap zcs-gap-10 zcs-mt-16&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;&lt;%=svc_rec.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=priorityClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Priority: &lt;%=ifnull(svc_rec.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(shortageCount &gt; 0,&quot;zcs-badge-red&quot;,if(reorderWarnCount &gt; 0,&quot;zcs-badge-yellow&quot;,&quot;zcs-badge-green&quot;))%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline business-box&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Stock warnings: &lt;%=shortageCount + reorderWarnCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(completionReady == true,&quot;zcs-badge-green&quot;,&quot;zcs-badge-grey&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zcs-badge-icon zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-13&quot;&gt;Completion: &lt;%=if(completionReady == true,&quot;Reached&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-action-group&quot;&gt;\n&lt;%\n\t\tactionStatuses = {&quot;Triage&quot;,&quot;Scheduled&quot;,&quot;In Progress&quot;,&quot;Parts Required&quot;,&quot;Repaired&quot;,&quot;Completed&quot;,&quot;Closed&quot;,&quot;Cancelled&quot;};\n\t\tfor each  actionStatus in actionStatuses\n\t\t{\n\t\t\tactionParam = actionStatus;\n\t\t\tactionClass = &quot;service-action-progress&quot;;\n\t\t\tactionIcon = &quot;loader-dots-06&quot;;\n\t\t\tif(actionStatus == &quot;Triage&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-triage&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-alert-circle&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Scheduled&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-scheduled&quot;;\n\t\t\t\tactionIcon = &quot;ui-2-time&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;In Progress&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;In%20Progress&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Parts Required&quot;)\n\t\t\t{\n\t\t\t\tactionParam = &quot;Parts%20Required&quot;;\n\t\t\t\tactionClass = &quot;service-action-parts&quot;;\n\t\t\t\tactionIcon = &quot;shopping-tag&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Repaired&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-repaired&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Completed&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-completed&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Closed&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-closed&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-lock&quot;;\n\t\t\t}\n\t\t\telse if(actionStatus == &quot;Cancelled&quot;)\n\t\t\t{\n\t\t\t\tactionClass = &quot;service-action-cancelled&quot;;\n\t\t\t\tactionIcon = &quot;ui-1-simple-remove&quot;;\n\t\t\t}\n\t\t\tactionHref = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc_rec.ID + &quot;&amp;New_Status=&quot; + actionParam + &quot;&amp;Return_Page=Service_Detail&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action &lt;%=actionClass%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=actionHref%&gt;&quot;&gt;&lt;i class=&quot;zcs-button-icon zc-li-outline &lt;%=actionIcon%&gt;&quot;&gt;&lt;/i&gt;&lt;span&gt;&lt;%=actionStatus%&gt;&lt;/span&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;service-hero-side&quot;&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Technician&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=ifnull(svc_rec.Technician.Employee_Name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Scheduled start: &lt;%=ifnull(svc_rec.Scheduled_Start,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Scheduled end: &lt;%=ifnull(svc_rec.Scheduled_End,&quot;Not set&quot;)%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-8&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Linked POs: &lt;%=poCount%&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;div class=&quot;detail-grid&quot;&gt;\n\t\t\t&lt;section class=&quot;detail-card detail-span-8&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Issue details&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Problem description and product or shutter context.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Service code&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=svc_rec.Service_Code%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Request date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Request_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Product or shutter details&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Product_or_Shutter_Details,&quot;No product details captured.&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Related order&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(order_rec.count() &gt; 0)\n\t\t{\n\t\t\torderUrl2 = &quot;#Page:Order_Detail?Order_ID=&quot; + order_rec.ID;\n\t\t\t%&gt;\n&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=orderUrl2%&gt;&quot;&gt;&lt;%=order_rec.Order_Code%&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNo related order linked\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot; style=&quot;grid-column:1 / -1;&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Issue description&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Issue_Description,&quot;Issue description pending.&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-4&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Service KPIs&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Parts, stock, POs, and comments.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;kpi-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-tag&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Parts rows&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=partsCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Stock warnings&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=shortageCount + reorderWarnCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Linked POs&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=poCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kpi&quot;&gt;&lt;span class=&quot;kpi-icon&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;div class=&quot;kpi-label&quot;&gt;Comments&lt;/div&gt;&lt;div class=&quot;kpi-value&quot;&gt;&lt;%=actionComments.count()%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Contact and address&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Customer lookup plus request snapshot contact details.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Customer&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(customer_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=customer_rec.Customer_Name%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(svc_rec.Customer_Name,&quot;Customer pending&quot;)%&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Contact person&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(customer_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(customer_rec.Contact_Person,&quot;Not entered&quot;)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNot available\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Phone&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Phone,&quot;No phone&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Email&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Email,&quot;No email&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Preferred contact&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(customer_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(customer_rec.Preferred_Contact_Method,&quot;Not set&quot;)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNot available\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Area or city&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;\n&lt;%\n\t\tif(customer_rec.count() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(customer_rec.Area_or_City,&quot;Not set&quot;)%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;%=ifnull(svc_rec.Service_Address.district_city,&quot;Not set&quot;)%&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot; style=&quot;grid-column:1 / -1;&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Service address&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Service_Address.address_line_1,&quot;Not entered&quot;)%&gt; &lt;%=ifnull(svc_rec.Service_Address.address_line_2,&quot;&quot;)%&gt;&lt;br&gt;&lt;%=ifnull(svc_rec.Service_Address.district_city,&quot;&quot;)%&gt; &lt;%=ifnull(svc_rec.Service_Address.state_province,&quot;&quot;)%&gt; &lt;%=ifnull(svc_rec.Service_Address.postal_Code,&quot;&quot;)%&gt; &lt;%=ifnull(svc_rec.Service_Address.country,&quot;&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Schedule and technician&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Visit timing, assigned service staff, and technician notes.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Scheduled start&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Scheduled_Start,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Scheduled end&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Scheduled_End,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Technician&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Technician.Employee_Name,&quot;Unassigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Technician email&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Technician.Email,&quot;Not entered&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot; style=&quot;grid-column:1 / -1;&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Technician notes&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Technician_Notes,&quot;No technician notes captured yet.&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Parts usage and stock warnings&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Service_Parts_Usage rows, material stock, reorder status, and stock-posting state.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;alert-list zcs-mb-0&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=if(shortageCount &gt; 0,&quot;alert-danger&quot;,if(reorderWarnCount &gt; 0,&quot;alert-warn&quot;,&quot;alert-ok&quot;))%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-alert-circle&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Stock check&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=shortageCount%&gt; part row(s) exceed available stock and &lt;%=reorderWarnCount%&gt; row(s) are at or below reorder level. &lt;%=unpostedCount%&gt; row(s) are not yet stock-posted.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative desktop-table zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Part&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Used&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Available&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Reorder&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Warning&lt;/th&gt;\n\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Posted&lt;/th&gt;\n\t\t\t\t\t\t\t&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\t\tpartRows = 0;\n\t\tfor each  partUsage in partRecords\n\t\t{\n\t\t\tpartRows = partRows + 1;\n\t\t\tavailableQty = ifnull(partUsage.Material.Available_Quantity,0);\n\t\t\treorderLevel = ifnull(partUsage.Material.Reorder_Level,0);\n\t\t\tqtyUsed = ifnull(partUsage.Quantity_Used,0);\n\t\t\twarningText = &quot;Sufficient&quot;;\n\t\t\twarningClass = &quot;stock-ok&quot;;\n\t\t\tif(qtyUsed &gt; availableQty)\n\t\t\t{\n\t\t\t\twarningText = &quot;Insufficient stock&quot;;\n\t\t\t\twarningClass = &quot;stock-danger&quot;;\n\t\t\t}\n\t\t\telse if(availableQty &lt;= reorderLevel)\n\t\t\t{\n\t\t\t\twarningText = &quot;At or below reorder level&quot;;\n\t\t\t\twarningClass = &quot;stock-warning&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(partUsage.Material.Material_Name,&quot;Material pending&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(partUsage.Notes,&quot;No usage notes&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=qtyUsed%&gt; &lt;%=ifnull(partUsage.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=availableQty%&gt; &lt;%=ifnull(partUsage.Material.Stock_Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary zcs-text-right&quot;&gt;&lt;%=reorderLevel%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;&lt;%=warningClass%&gt;&quot;&gt;&lt;%=warningText%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t&lt;td class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=if(partUsage.Stock_Deducted == true,&quot;zcs-badge-green&quot;,&quot;zcs-badge-orange&quot;)%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=if(partUsage.Stock_Deducted == true,&quot;Posted&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\tif(partRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No Service_Parts_Usage rows are linked to this request.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;mobile-stack zcs-mt-12&quot;&gt;\n&lt;%\n\t\tmobilePartRows = 0;\n\t\tfor each  mobileUsage in partRecords\n\t\t{\n\t\t\tmobilePartRows = mobilePartRows + 1;\n\t\t\tmobileAvailable = ifnull(mobileUsage.Material.Available_Quantity,0);\n\t\t\tmobileReorder = ifnull(mobileUsage.Material.Reorder_Level,0);\n\t\t\tmobileUsed = ifnull(mobileUsage.Quantity_Used,0);\n\t\t\tmobileWarning = &quot;Sufficient&quot;;\n\t\t\tif(mobileUsed &gt; mobileAvailable)\n\t\t\t{\n\t\t\t\tmobileWarning = &quot;Insufficient stock&quot;;\n\t\t\t}\n\t\t\telse if(mobileAvailable &lt;= mobileReorder)\n\t\t\t{\n\t\t\t\tmobileWarning = &quot;At or below reorder level&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&quot;mobile-record&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-8&quot;&gt;&lt;strong&gt;&lt;%=ifnull(mobileUsage.Material.Material_Name,&quot;Material pending&quot;)%&gt;&lt;/strong&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=if(mobileUsage.Stock_Deducted == true,&quot;Posted&quot;,&quot;Pending&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-6&quot;&gt;Used &lt;%=mobileUsed%&gt; &lt;%=ifnull(mobileUsage.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Available &lt;%=mobileAvailable%&gt; - Reorder &lt;%=mobileReorder%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=mobileWarning%&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tif(mobilePartRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No Service_Parts_Usage rows are linked to this request.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Linked PO status&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Purchase orders linked from Service_Requests.Linked_PO or Purchase_Orders.Linked_Service.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;link-list&quot;&gt;\n&lt;%\n\t\tpoRowsShown = 0;\n\t\tif(primaryPo.count() &gt; 0)\n\t\t{\n\t\t\tpoRowsShown = poRowsShown + 1;\n\t\t\tpoDetailUrl = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + primaryPo.ID;\n\t\t\tpoStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(primaryPo.PO_Status == &quot;Received&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\telse if(primaryPo.PO_Status == &quot;Cancelled&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(primaryPo.PO_Status == &quot;Draft&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\telse if(primaryPo.PO_Status == &quot;Submitted for Approval&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(primaryPo.PO_Status == &quot;Partially Received&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=poDetailUrl%&gt;&quot;&gt;&lt;%=primaryPo.PO_Number%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(primaryPo.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt; - Expected &lt;%=ifnull(primaryPo.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Linked through Service_Requests.Linked_PO&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=poStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=primaryPo.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\tfor each  svcPo in servicePOs\n\t\t{\n\t\t\tif(primaryPo.count() == 0 || svcPo.ID != primaryPo.ID)\n\t\t\t{\n\t\t\t\tpoRowsShown = poRowsShown + 1;\n\t\t\t\tsvcPoDetailUrl = &quot;#Page:Purchase_Order_Detail?PO_ID=&quot; + svcPo.ID;\n\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t\tif(svcPo.PO_Status == &quot;Received&quot;)\n\t\t\t\t{\n\t\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t\t}\n\t\t\t\telse if(svcPo.PO_Status == &quot;Cancelled&quot;)\n\t\t\t\t{\n\t\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-red&quot;;\n\t\t\t\t}\n\t\t\t\telse if(svcPo.PO_Status == &quot;Draft&quot;)\n\t\t\t\t{\n\t\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t\t}\n\t\t\t\telse if(svcPo.PO_Status == &quot;Submitted for Approval&quot;)\n\t\t\t\t{\n\t\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t\t}\n\t\t\t\telse if(svcPo.PO_Status == &quot;Partially Received&quot;)\n\t\t\t\t{\n\t\t\t\t\tsvcPoStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t\t}\n\t\t\t\t%&gt;\n&lt;div class=&quot;link-row&quot;&gt;&lt;div&gt;&lt;a class=&quot;row-link&quot; href=&quot;&lt;%=svcPoDetailUrl%&gt;&quot;&gt;&lt;%=svcPo.PO_Number%&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(svcPo.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt; - Expected &lt;%=ifnull(svcPo.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Linked through Purchase_Orders.Linked_Service&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=svcPoStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=svcPo.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\tif(poRowsShown == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;empty-soft&quot;&gt;No linked purchase orders were found for this service request.&lt;/div&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Completion status and photos&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Closure readiness, stock-posting flag, completion date, and uploaded service photos.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;kv-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Completion date&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=ifnull(svc_rec.Completion_Date,&quot;Not set&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Stock consumption posted&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(svc_rec.Stock_Consumption_Posted == true,&quot;Yes&quot;,&quot;No&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Completion-ready status&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=if(completionReady == true,&quot;Completed or closed&quot;,&quot;Not completed&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;kv-label&quot;&gt;Unposted parts rows&lt;/div&gt;&lt;div class=&quot;kv-value&quot;&gt;&lt;%=unpostedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;photo-box zcs-mt-12&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-8&quot;&gt;&lt;i class=&quot;zc-li-outline files-archive-3d-content&quot;&gt;&lt;/i&gt;&lt;strong&gt;Service photos&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-8&quot;&gt;\n&lt;%\n\t\tphotoValue = ifnull(svc_rec.Service_Photos,&quot;&quot;);\n\t\tif(photoValue != &quot;&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;%=svc_rec.Service_Photos%&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\nNo service photos are attached yet.\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Status timeline&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Current progress through the service lifecycle.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tstepStatuses = {&quot;New&quot;,&quot;Triage&quot;,&quot;Scheduled&quot;,&quot;In Progress&quot;,&quot;Parts Required&quot;,&quot;Repaired&quot;,&quot;Completed&quot;,&quot;Closed&quot;};\n\t\tcurrentStepIndex = stepStatuses.indexOf(svc_rec.Service_Status);\n\t\tfor each index stepIndex in stepStatuses\n\t\t{\n\t\t\tstepStatus = stepStatuses.get(stepIndex);\n\t\t\ttlClass = &quot;&quot;;\n\t\t\ticonName = &quot;ui-2-time&quot;;\n\t\t\tif(currentStepIndex &gt; stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-complete&quot;;\n\t\t\t\ticonName = &quot;ui-1-check-circle-08&quot;;\n\t\t\t}\n\t\t\telse if(currentStepIndex == stepIndex)\n\t\t\t{\n\t\t\t\ttlClass = &quot;zcs-tl-li-active&quot;;\n\t\t\t\ticonName = &quot;loader-dots-06&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li &lt;%=tlClass%&gt; zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline &lt;%=iconName%&gt;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Step &lt;%=stepIndex + 1%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=stepStatus%&gt;&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=if(currentStepIndex &gt; stepIndex,&quot;Completed or passed&quot;,if(currentStepIndex == stepIndex,&quot;Current stage&quot;,&quot;Awaiting previous stage&quot;))%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(svc_rec.Service_Status == &quot;Cancelled&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;i class=&quot;zcs-tl-icon zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-16 zcs-relative zc-li-outline ui-2-alert-circle&quot; style=&quot;background:#FDE3E6;color:#FE455D;&quot;&gt;&lt;/i&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;Exception&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;Cancelled&lt;/h6&gt;&lt;p class=&quot;zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-mt-4 zcs-mx-0 zcs-mb-0&quot;&gt;See comment history for cancellation reason.&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-6&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Service readiness checks&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Operational flags that affect repair, completion, and closure.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;alert-list&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=if(svc_rec.Technician != null,&quot;alert-ok&quot;,&quot;alert-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-03&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Technician assignment&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=ifnull(svc_rec.Technician.Employee_Name,&quot;No technician assigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=if(svc_rec.Scheduled_Start != null,&quot;alert-ok&quot;,&quot;alert-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Schedule&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Start: &lt;%=ifnull(svc_rec.Scheduled_Start,&quot;Not set&quot;)%&gt;. End: &lt;%=ifnull(svc_rec.Scheduled_End,&quot;Not set&quot;)%&gt;.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=if(shortageCount == 0,&quot;alert-ok&quot;,&quot;alert-danger&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline business-box&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Parts stock&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;&lt;%=shortageCount%&gt; shortage warning(s). &lt;%=unpostedCount%&gt; usage row(s) awaiting stock posting.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;alert-row &lt;%=if(completionReady == true,&quot;alert-ok&quot;,&quot;alert-warn&quot;)%&gt;&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08&quot;&gt;&lt;/i&gt;&lt;div&gt;&lt;strong&gt;Closure&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-mt-4&quot;&gt;Completion date: &lt;%=ifnull(svc_rec.Completion_Date,&quot;Not set&quot;)%&gt;. Technician notes: &lt;%=if(ifnull(svc_rec.Technician_Notes,&quot;&quot;) != &quot;&quot;,&quot;Captured&quot;,&quot;Pending&quot;)%&gt;.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\n\t\t\t&lt;section class=&quot;detail-card detail-span-12&quot;&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-header&quot;&gt;&lt;div&gt;&lt;h2 class=&quot;detail-card-title&quot;&gt;Comment history&lt;/h2&gt;&lt;p class=&quot;detail-card-note&quot;&gt;Action_Comments audit trail for this service request.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;detail-card-body&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;zcs-timeline-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;ul class=&quot;zcs-flex zcs-direction-column zcs-gap-32 zcs-p-0 zcs-m-0&quot;&gt;\n&lt;%\n\t\tcommentRows = 0;\n\t\tfor each  comment in Action_Comments[Target_Module == &quot;Service_Requests&quot; &amp;&amp; Lookup_ID == svc_rec.ID] sort by Action_Date desc\n\t\t{\n\t\t\tcommentRows = commentRows + 1;\n\t\t\t%&gt;\n&lt;li class=&quot;zcs-tl-li zcs-row zcs-gap-0 zcs-relative&quot;&gt;&lt;div class=&quot;zcs-tl-indicator zcs-h-full zcs-flex zcs-justify-center zcs-absolute&quot;&gt;&lt;span class=&quot;zcs-tl-dot zcs-rounded-half zcs-mt-5 zcs-box-border zcs-relative&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span class=&quot;zcs-col-2 zcs-tl-time zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-text-right&quot;&gt;&lt;%=comment.Action_Date%&gt;&lt;/span&gt;&lt;div class=&quot;zcs-flex zcs-direction-column zcs-col-10 zcs-px-60 zcs-box-border&quot;&gt;&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-row-wrap zcs-gap-8&quot;&gt;&lt;h6 class=&quot;zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0&quot;&gt;&lt;%=comment.New_Status%&gt;&lt;/h6&gt;&lt;span class=&quot;comment-module&quot;&gt;Service &lt;%=svc_rec.Service_Code%&gt;&lt;/span&gt;&lt;span class=&quot;zcs-font-14 zcs-color-secondary&quot;&gt;&lt;%=ifnull(comment.Submitted_By,&quot;Unknown&quot;)%&gt;&lt;/span&gt;&lt;/div&gt;&lt;p class=&quot;comment-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-mt-8 zcs-mx-0 zcs-mb-0&quot;&gt;&lt;%=comment.Comments%&gt;&lt;/p&gt;&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\tif(commentRows == 0)\n\t\t{\n\t\t\t%&gt;\n&lt;li&gt;&lt;div class=&quot;empty-soft&quot;&gt;No Action_Comments have been recorded for this service request yet.&lt;/div&gt;&lt;/li&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/ul&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/section&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Service_Home
		{
					displayname = "Service Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Service_Home_Snippet' elementName='Service_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Service_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\topenServices = Service_Requests[Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;];\n\turgentServices = Service_Requests[Priority == &quot;Urgent&quot; &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;];\n\tassignedServices = Service_Requests[Technician.Email == zoho.loginuser &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;];\n\tupcomingVisits = Service_Requests[Scheduled_Start != null &amp;&amp; Scheduled_Start &gt;= zoho.currenttime &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;];\n\tpartsRequiredServices = Service_Requests[Service_Status == &quot;Parts Required&quot;];\n\tlinkedServicePOs = Purchase_Orders[Linked_Service != null &amp;&amp; PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;];\n\trecentCompletedServices = Service_Requests[Service_Status == &quot;Completed&quot; || Service_Status == &quot;Closed&quot; &amp;&amp; Completion_Date != null];\n\tclosureServices = Service_Requests[Service_Status == &quot;Repaired&quot; || Service_Status == &quot;Completed&quot;];\n\tpendingPartsUsage = Service_Parts_Usage[Stock_Deducted == false];\n\topenCount = openServices.count();\n\turgentCount = urgentServices.count();\n\tassignedCount = assignedServices.count();\n\tupcomingCount = upcomingVisits.count();\n\tpartsRequiredCount = partsRequiredServices.count();\n\tlinkedPOCount = linkedServicePOs.count();\n\trecentCompletedCount = recentCompletedServices.count();\n\tclosureCount = closureServices.count();\n\tpendingPartsUsageCount = pendingPartsUsage.count();\n\treturnUrl = &quot;%23Page%3AService_Home&quot;;\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-danger-soft: #FFECEF; --zcs-warning-soft: #FFF6E3; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; --zcs-purple-soft: #F0ECFF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-row-wrap { flex-wrap: wrap; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-no-shrink { flex-shrink: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-14 { gap: .875rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-14 { padding: .875rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-p-24 { padding: 1.5rem; }\n.zcs-px-8 { padding-left: .5rem; padding-right: .5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-6 { padding-top: .375rem; padding-bottom: .375rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-mx-0 { margin-left: 0; margin-right: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-absolute { position: absolute; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\na { text-decoration: none; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-badge { width: auto; }\n.zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-button { width: auto; min-width: 5rem; min-height: 36px; transition: all .18s ease; }\n.zcs-primary-outline-button { border: 1px solid var(--zcs-theme-brand-color); background-color: var(--zcs-white-color); color: var(--zcs-theme-brand-color); }\n.zcs-primary-outline-button:hover { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-button-icon { width: 16px; max-height: 16px; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 920px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\n.zcs-nodata-wrapper { min-height: 94px; border: 1px dashed var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.service-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.service-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #18335C); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.service-hero:after { content: &apos;&apos;; position: absolute; width: 330px; height: 330px; right: -90px; top: -120px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -70px 90px 0 rgba(255,255,255,.08); }\n.service-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.service-eyebrow { letter-spacing: .08em; opacity: .78; }\n.service-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.service-subtitle { max-width: 860px; color: rgba(255,255,255,.82); margin: 0; }\n.service-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }\n.service-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.service-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.service-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.service-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.service-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.service-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.service-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }\n.service-kpi-link, .service-row-link, .service-panel-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.service-section-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); gap: 16px; margin-top: 16px; }\n.service-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.service-panel { padding: 18px; }\n.service-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.service-panel-title { margin: 0; font-size: 18px; }\n.service-note { color: var(--zcs-teritiary-text-color); }\n.service-action-group { display: flex; flex-wrap: wrap; gap: 6px; }\n.service-action { min-width: auto; min-height: 30px; padding: 5px 9px; border-radius: 8px; font-size: 12px; line-height: 1.2; }\n.service-action-triage { --action-soft:#F0ECFF; border-color:#7656D6; color:#7656D6; }\n.service-action-scheduled { --action-soft:#E8EFFF; border-color:#2A6FFC; color:#2A6FFC; }\n.service-action-progress { --action-soft:#EAF7FF; border-color:#1094C5; color:#1094C5; }\n.service-action-parts { --action-soft:#FCF4E6; border-color:#B8770D; color:#B8770D; }\n.service-action-repaired { --action-soft:#E4FCF3; border-color:#179E6C; color:#179E6C; }\n.service-action-completed { --action-soft:#EAFBF4; border-color:#007943; color:#007943; }\n.service-action-closed { --action-soft:#EEF1F7; border-color:#5D6372; color:#5D6372; }\n.service-action-cancelled { --action-soft:#FDE3E6; border-color:#FE455D; color:#FE455D; }\n.service-action:hover { background: var(--action-soft, var(--zcs-brand-soft)); }\n.service-linked-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #FBFCFF; }\n.service-status-strip { width: 4px; border-radius: 8px; background: var(--strip-color, var(--zcs-theme-brand-color)); align-self: stretch; }\n.service-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.service-quick-card { padding: 14px; border-radius: 14px; border: 1px solid var(--zcs-border-color); background: #fff; text-decoration: none; color: var(--zcs-primary-text-color); transition: border-color .18s ease, background .18s ease; }\n.service-quick-card:hover { border-color: var(--zcs-theme-brand-color); background: #F9FBFF; }\n.service-quick-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-brand-soft); color: var(--zcs-theme-brand-color); }\n.service-muted-line { color: var(--zcs-teritiary-text-color); font-size: 12px; margin-top: 4px; }\n.service-issue { --zcs-line-clamp-count: 2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n@media (max-width: 1240px) { .service-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .service-section-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .service-two-col { grid-template-columns: 1fr; } .service-hero-content { flex-direction: column; } .service-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .service-home-shell { padding: 12px; } .service-hero { padding: 18px; border-radius: 18px; } .service-kpi-grid { grid-template-columns: 1fr; } .service-panel { padding: 14px; } .service-quick-grid { grid-template-columns: 1fr; } .service-panel-header { align-items: flex-start; flex-direction: column; } .service-responsive-table table, .service-responsive-table thead, .service-responsive-table tbody, .service-responsive-table th, .service-responsive-table td, .service-responsive-table tr { display: block; min-width: 0; width: 100%; } .service-responsive-table thead { display: none; } .service-responsive-table tbody tr { border-top: 1px solid var(--zcs-border-color); padding: 10px 0; } .service-responsive-table tbody tr:first-child { border-top: none; } .service-responsive-table tbody tr td { border-top: none; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 8px; padding: 6px 12px; } .service-responsive-table tbody tr td:before { content: attr(data-label); color: var(--zcs-teritiary-text-color); font-size: 12px; font-weight: 600; } .service-responsive-table tbody tr td[colspan]:before { content: &apos;&apos;; display:none; } .service-action-group { margin-top: 4px; } }\n&lt;/style&gt;\n&lt;div class=&quot;service-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;service-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Service team workspace&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;service-title zcs-font-bold&quot;&gt;Service Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;service-subtitle zcs-font-15&quot;&gt;Open requests, assigned work, upcoming visits, parts needs, linked POs, and closure follow-up in one focused mobile-ready view.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-list zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=openCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Open service requests&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;Open service report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=urgentCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Urgent open requests&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;Review urgent queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F0ECFF;--kpi-color:#7656D6;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline users-single-03 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=assignedCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Assigned to me&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;Assigned work list&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=upcomingCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Upcoming scheduled visits&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:Service_Calendar&quot;&gt;Service calendar&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-tag zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=partsRequiredCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Parts required requests&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:All_Service_Parts_Usage&quot;&gt;Parts usage rows&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAFBF4;--kpi-color:#179E6C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=closureCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Repair or completion closure tasks&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;Review closures&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EEF1F7;--kpi-color:#5D6372;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=linkedPOCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Open service-linked POs&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:Open_Purchase_Orders&quot;&gt;Linked PO list&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F8F0EB;--kpi-color:#F4660C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-value zcs-font-bold&quot;&gt;&lt;%=pendingPartsUsageCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;service-kpi-label zcs-font-13&quot;&gt;Parts usage not stock-posted&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-kpi-link&quot; href=&quot;#Report:All_Service_Parts_Usage&quot;&gt;Usage report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-panel zcs-card zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Open and urgent service focus&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Use Add Comments popup links for service status changes. Financial fields are intentionally excluded.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;Full open service list&lt;/a&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;service-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Service&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Customer / issue&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Priority&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Schedule / technician&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary&quot;&gt;Service actions&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\topenRows = 0;\n\tfor each  svc in Service_Requests[Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;] sort by Request_Date desc\n\t{\n\t\tif(openRows &lt; 10)\n\t\t{\n\t\t\topenRows = openRows + 1;\n\t\t\tserviceDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + svc.ID;\n\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tif(svc.Service_Status == &quot;Triage&quot; || svc.Service_Status == &quot;New&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Scheduled&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;In Progress&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-theme&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Parts Required&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Repaired&quot; || svc.Service_Status == &quot;Completed&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\tpriorityClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(svc.Priority == &quot;Urgent&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(svc.Priority == &quot;High&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(svc.Priority == &quot;Low&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\ttriageUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Triage&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tscheduledUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Scheduled&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tinProgressUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=In%20Progress&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tpartsRequiredUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Parts%20Required&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\trepairedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Repaired&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcompletedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Completed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tclosedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Closed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelledUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + svc.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Service&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=serviceDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=svc.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Requested: &lt;%=ifnull(svc.Request_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / issue&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-color-primary&quot;&gt;&lt;strong&gt;&lt;%=ifnull(svc.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(svc.Phone,&quot;No phone&quot;)%&gt;&lt;/span&gt;&lt;div class=&quot;service-issue zcs-font-12 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(svc.Issue_Description,&quot;Issue description pending&quot;)%&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Priority&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=priorityClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=ifnull(svc.Priority,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Schedule / technician&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(svc.Scheduled_Start,&quot;Schedule pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(svc.Technician.Employee_Name,&quot;Technician pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=statusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=svc.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Service actions&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;div class=&quot;service-action-group&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-triage zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=triageUrl%&gt;&quot;&gt;Triage&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-scheduled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=scheduledUrl%&gt;&quot;&gt;Scheduled&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=inProgressUrl%&gt;&quot;&gt;In Progress&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-parts zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=partsRequiredUrl%&gt;&quot;&gt;Parts Required&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-repaired zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=repairedUrl%&gt;&quot;&gt;Repaired&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-completed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=completedUrl%&gt;&quot;&gt;Completed&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-closed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=closedUrl%&gt;&quot;&gt;Closed&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-cancelled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelledUrl%&gt;&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(openRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;6&quot;&gt;No open service requests are waiting.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Assigned to me&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Filtered where Technician email equals the signed-in user.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;Open service requests&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Service&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Schedule&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Next actions&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tassignedRows = 0;\n\tfor each  mySvc in Service_Requests[Technician.Email == zoho.loginuser &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;] sort by Scheduled_Start asc\n\t{\n\t\tif(assignedRows &lt; 8)\n\t\t{\n\t\t\tassignedRows = assignedRows + 1;\n\t\t\tmyDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + mySvc.ID;\n\t\t\tmyProgressUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + mySvc.ID + &quot;&amp;New_Status=In%20Progress&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tmyPartsUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + mySvc.ID + &quot;&amp;New_Status=Parts%20Required&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tmyRepairedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + mySvc.ID + &quot;&amp;New_Status=Repaired&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tmyCompletedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + mySvc.ID + &quot;&amp;New_Status=Completed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tmyClosedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + mySvc.ID + &quot;&amp;New_Status=Closed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;Service&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=myDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=mySvc.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(mySvc.Priority,&quot;Priority pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Customer&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(mySvc.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(mySvc.Phone,&quot;No phone&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Schedule&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(mySvc.Scheduled_Start,&quot;Schedule pending&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=mySvc.Service_Status%&gt;&lt;/td&gt;&lt;td data-label=&quot;Next actions&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;div class=&quot;service-action-group&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=myProgressUrl%&gt;&quot;&gt;In Progress&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-parts zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=myPartsUrl%&gt;&quot;&gt;Parts Required&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-repaired zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=myRepairedUrl%&gt;&quot;&gt;Repaired&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-completed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=myCompletedUrl%&gt;&quot;&gt;Completed&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-closed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=myClosedUrl%&gt;&quot;&gt;Closed&lt;/a&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(assignedRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No open service requests are assigned to this login.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Upcoming service schedule&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Future scheduled visits by date, customer, area, and technician.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:Service_Calendar&quot;&gt;Calendar&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\tvisitRows = 0;\n\tfor each  visit in Service_Requests[Scheduled_Start != null &amp;&amp; Scheduled_Start &gt;= zoho.currenttime &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;] sort by Scheduled_Start asc\n\t{\n\t\tif(visitRows &lt; 8)\n\t\t{\n\t\t\tvisitRows = visitRows + 1;\n\t\t\tvisitDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + visit.ID;\n\t\t\tvisitStartUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + visit.ID + &quot;&amp;New_Status=In%20Progress&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tvisitCancelUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + visit.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;service-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-gap-12 zcs-align-items-start&quot;&gt;&lt;span class=&quot;service-status-strip&quot; style=&quot;--strip-color:#1094C5;&quot;&gt;&lt;/span&gt;&lt;div class=&quot;zcs-col-common&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=visitDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=visit.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(visit.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;&lt;%=ifnull(visit.Scheduled_Start,&quot;Start pending&quot;)%&gt; to &lt;%=ifnull(visit.Scheduled_End,&quot;End pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Technician: &lt;%=ifnull(visit.Technician.Employee_Name,&quot;Not assigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=visit.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;service-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-progress zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=visitStartUrl%&gt;&quot;&gt;In Progress&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-cancelled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=visitCancelUrl%&gt;&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(visitRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No upcoming service visits are scheduled.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Parts-required list&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Requests waiting for parts decisions or linked PO follow-up.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;Service report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\tpartsRows = 0;\n\tfor each  prSvc in Service_Requests[Service_Status == &quot;Parts Required&quot;] sort by Request_Date asc\n\t{\n\t\tif(partsRows &lt; 8)\n\t\t{\n\t\t\tpartsRows = partsRows + 1;\n\t\t\tprDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + prSvc.ID;\n\t\t\tprRepairedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + prSvc.ID + &quot;&amp;New_Status=Repaired&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tprCompletedUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + prSvc.ID + &quot;&amp;New_Status=Completed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;service-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=prDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=prSvc.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(prSvc.Customer_Name,&quot;Customer pending&quot;)%&gt; \u00B7 &lt;%=ifnull(prSvc.Priority,&quot;Priority pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Linked PO: &lt;%=ifnull(prSvc.Linked_PO.PO_Number,&quot;None&quot;)%&gt; \u00B7 Technician: &lt;%=ifnull(prSvc.Technician.Employee_Name,&quot;Not assigned&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=prSvc.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;service-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-repaired zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=prRepairedUrl%&gt;&quot;&gt;Repaired&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-completed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=prCompletedUrl%&gt;&quot;&gt;Completed&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-parts zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;#Report:All_Service_Parts_Usage&quot;&gt;Usage rows&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(partsRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No services are currently marked Parts Required.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Linked service PO list&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Open purchase orders linked to service requests. PO status and due dates only.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:Open_Purchase_Orders&quot;&gt;Open PO report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\tpoRows = 0;\n\tfor each  spo in Purchase_Orders[Linked_Service != null &amp;&amp; PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;] sort by Expected_Delivery_Date asc\n\t{\n\t\tif(poRows &lt; 8)\n\t\t{\n\t\t\tpoRows = poRows + 1;\n\t\t\tlinkedServiceUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + spo.Linked_Service.ID;\n\t\t\tpoStatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(spo.PO_Status == &quot;Submitted for Approval&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(spo.PO_Status == &quot;Partially Received&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\telse if(spo.PO_Status == &quot;Draft&quot;)\n\t\t\t{\n\t\t\t\tpoStatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;div class=&quot;service-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;strong&gt;&lt;%=spo.PO_Number%&gt;&lt;/strong&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(spo.Vendor.Vendor_Name,&quot;Vendor pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Expected: &lt;%=ifnull(spo.Expected_Delivery_Date,&quot;Not set&quot;)%&gt; \u00B7 Linked service: &lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=linkedServiceUrl%&gt;&quot;&gt;&lt;%=ifnull(spo.Linked_Service.Service_Code,&quot;Service pending&quot;)%&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=poStatusClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=spo.PO_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(poRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No open service-linked purchase orders.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-two-col&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Parts usage watch&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Usage rows not yet stock-posted for completion or closure follow-through.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:All_Service_Parts_Usage&quot;&gt;Usage report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Service&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Material&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Qty&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Stock posted&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tusageRows = 0;\n\tfor each  usage in Service_Parts_Usage[Stock_Deducted == false] sort by Service_Request asc\n\t{\n\t\tif(usageRows &lt; 8)\n\t\t{\n\t\t\tusageRows = usageRows + 1;\n\t\t\tusageDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + usage.Service_Request.ID;\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;Service&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=usageDetailUrl%&gt;&quot;&gt;&lt;%=ifnull(usage.Service_Request.Service_Code,&quot;Service pending&quot;)%&gt;&lt;/a&gt;&lt;/td&gt;&lt;td data-label=&quot;Material&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(usage.Material.Material_Name,&quot;Material pending&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(usage.Notes,&quot;No notes&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Qty&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14 zcs-text-right&quot;&gt;&lt;%=ifnull(usage.Quantity_Used,0)%&gt; &lt;%=ifnull(usage.Unit.Unit_Name,&quot;&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Stock posted&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Pending&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(usageRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;4&quot;&gt;No unposted service parts usage rows.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Closure tasks&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Repaired or completed work that still needs final closure comments.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;All service requests&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-direction-column zcs-gap-12&quot;&gt;\n&lt;%\n\tclosureRows = 0;\n\tfor each  closeSvc in Service_Requests[Service_Status == &quot;Repaired&quot; || Service_Status == &quot;Completed&quot;] sort by Completion_Date desc\n\t{\n\t\tif(closureRows &lt; 8)\n\t\t{\n\t\t\tclosureRows = closureRows + 1;\n\t\t\tclosureDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + closeSvc.ID;\n\t\t\tcloseUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + closeSvc.ID + &quot;&amp;New_Status=Closed&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\tcancelCloseUrl = &quot;#Form:Action_Comments?Target_Module=Service_Requests&amp;Lookup_ID=&quot; + closeSvc.ID + &quot;&amp;New_Status=Cancelled&amp;Return_Page=Service_Home&amp;Return_URL=&quot; + returnUrl + &quot;&amp;zc_LoadIn=dialog&quot;;\n\t\t\t%&gt;\n&lt;div class=&quot;service-linked-card&quot;&gt;&lt;div class=&quot;zcs-flex zcs-justify-space-between zcs-gap-10 zcs-align-items-start&quot;&gt;&lt;div&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=closureDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=closeSvc.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;div class=&quot;zcs-font-13 zcs-color-secondary zcs-mt-4&quot;&gt;&lt;%=ifnull(closeSvc.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-12 zcs-color-tertiary zcs-mt-4&quot;&gt;Completion date: &lt;%=ifnull(closeSvc.Completion_Date,&quot;Not set&quot;)%&gt; \u00B7 Technician notes: &lt;%=ifnull(closeSvc.Technician_Notes,&quot;Pending&quot;)%&gt;&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=closeSvc.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;service-action-group zcs-mt-10&quot;&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-closed zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=closeUrl%&gt;&quot;&gt;Closed&lt;/a&gt;&lt;a class=&quot;zcs-button zcs-primary-outline-button service-action service-action-cancelled zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-box-border&quot; href=&quot;&lt;%=cancelCloseUrl%&gt;&quot;&gt;Cancelled&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\tif(closureRows == 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;zcs-nodata-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-text-center&quot;&gt;&lt;div class=&quot;zcs-nodata-content zcs-p-20 zcs-box-border&quot;&gt;&lt;h5 class=&quot;zcs-nodata-header zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-mt-10 zcs-mx-0 zcs-mb-0&quot;&gt;No closure tasks are waiting.&lt;/h5&gt;&lt;/div&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;service-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;service-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Recently completed services&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;service-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Latest completed or closed service work for field reference.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-panel-link&quot; href=&quot;#Report:All_Service_Requests&quot;&gt;All service requests&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;&lt;tr&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Service&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Technician&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Completion&lt;/th&gt;&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tcompletedRows = 0;\n\tfor each  doneSvc in Service_Requests[Service_Status == &quot;Completed&quot; || Service_Status == &quot;Closed&quot; &amp;&amp; Completion_Date != null] sort by Completion_Date desc\n\t{\n\t\tif(completedRows &lt; 8)\n\t\t{\n\t\t\tcompletedRows = completedRows + 1;\n\t\t\tdoneDetailUrl = &quot;#Page:Service_Detail?Service_ID=&quot; + doneSvc.ID;\n\t\t\tdoneClass = &quot;zcs-badge-green&quot;;\n\t\t\tif(doneSvc.Service_Status == &quot;Closed&quot;)\n\t\t\t{\n\t\t\t\tdoneClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;&lt;td data-label=&quot;Service&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;a class=&quot;service-row-link&quot; href=&quot;&lt;%=doneDetailUrl%&gt;&quot;&gt;&lt;strong&gt;&lt;%=doneSvc.Service_Code%&gt;&lt;/strong&gt;&lt;/a&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;&lt;%=ifnull(doneSvc.Request_Date,&quot;Request date pending&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;&lt;td data-label=&quot;Customer&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(doneSvc.Customer_Name,&quot;Customer pending&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Technician&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(doneSvc.Technician.Employee_Name,&quot;Not assigned&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Completion&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(doneSvc.Completion_Date,&quot;Not set&quot;)%&gt;&lt;/td&gt;&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border &lt;%=doneClass%&gt;&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=doneSvc.Service_Status%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(completedRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot; colspan=&quot;5&quot;&gt;No completed service records are available yet.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;zcs-quick-actions-wrapper zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t&lt;h2 class=&quot;service-panel-title zcs-font-semibold&quot;&gt;Service quick links&lt;/h2&gt;\n\t\t\t\t\t\t&lt;div class=&quot;service-quick-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Form:Service_Requests?zc_LoadIn=dialog&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-simple-add&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Add service request&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Create or log a new request&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Open_Service_Requests&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-list&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Open service requests&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Filtered open list&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Service_Calendar&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Service calendar&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Visit schedule&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:Service_Status_Board&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-bullet-list-67&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Status board&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Kanban by service status&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Service_Parts_Usage&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-tag&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Parts usage&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Material consumption rows&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;service-quick-card zcs-flex zcs-align-items-center zcs-gap-10&quot; href=&quot;#Report:All_Materials&quot;&gt;&lt;span class=&quot;service-quick-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline business-box&quot;&gt;&lt;/i&gt;&lt;/span&gt;&lt;span&gt;&lt;strong&gt;Material stock&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;zcs-font-12 zcs-color-tertiary&quot;&gt;Check available service parts&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Viewer_Home
		{
					displayname = "Viewer Home"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='Viewer_Home_Snippet' elementName='Viewer_Home_Snippet' bgColor=\"\">\n\t\t\t\t\t<![CDATA[htmlpage Viewer_Home_Snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\treadonlyParams = &quot;?zc_AddRec=false&amp;amp;zc_EditRec=false&amp;amp;zc_DelRec=false&amp;amp;zc_DuplRec=false&amp;amp;zc_MoreAction=false&amp;amp;zc_RecSelect=false&quot;;\n\tallOrdersCount = Customer_Orders[ID != 0].count();\n\tactiveOrdersCount = Customer_Orders[Order_Status != &quot;Completed&quot; &amp;&amp; Order_Status != &quot;Cancelled&quot;].count();\n\tcompletedOrdersCount = Customer_Orders[Order_Status == &quot;Completed&quot;].count();\n\tcancelledOrdersCount = Customer_Orders[Order_Status == &quot;Cancelled&quot;].count();\n\tawaitingGreenCount = Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;].count();\n\treadyOrderCount = Customer_Orders[Order_Status == &quot;Ready for Installation&quot; || Order_Status == &quot;Installation Scheduled&quot; || Order_Status == &quot;Installed&quot; || Order_Status == &quot;Inspection Required&quot;].count();\n\torderAwaitingCount = Customer_Orders[Order_Status == &quot;Awaiting Green Light&quot;].count();\n\torderGreenCount = Customer_Orders[Order_Status == &quot;Green Light&quot;].count();\n\torderProductionCount = Customer_Orders[Order_Status == &quot;In Production&quot;].count();\n\torderMaterialHoldCount = Customer_Orders[Order_Status == &quot;Material Hold&quot;].count();\n\torderReadyInstallCount = Customer_Orders[Order_Status == &quot;Ready for Installation&quot;].count();\n\torderInstallScheduledCount = Customer_Orders[Order_Status == &quot;Installation Scheduled&quot;].count();\n\torderInstalledCount = Customer_Orders[Order_Status == &quot;Installed&quot;].count();\n\torderInspectionCount = Customer_Orders[Order_Status == &quot;Inspection Required&quot;].count();\n\torderOnHoldCount = Customer_Orders[Order_Status == &quot;On Hold&quot;].count();\n\tallProductionCount = Production_Records[ID != 0].count();\n\tproductionAwaitingCount = Production_Records[Production_Status == &quot;Awaiting Green Light&quot;].count();\n\tproductionQueuedCount = Production_Records[Production_Status == &quot;Queued&quot;].count();\n\tproductionShortageCount = Production_Records[Production_Status == &quot;Material Shortage&quot; || Material_Status == &quot;Shortage Identified&quot;].count();\n\tproductionOrderedCount = Production_Records[Production_Status == &quot;Material Ordered&quot; || Material_Status == &quot;Ordered&quot;].count();\n\tproductionManufacturingCount = Production_Records[Production_Status == &quot;Manufacturing&quot;].count();\n\tproductionPowderCount = Production_Records[Production_Status == &quot;Powder Coating&quot; || Powder_Coating_Status == &quot;In Progress&quot; || Powder_Coating_Status == &quot;Pending&quot;].count();\n\tproductionReadyCount = Production_Records[Production_Status == &quot;Ready for Installation&quot; || Production_Status == &quot;Purchased and Received&quot;].count();\n\tproductionFinalPurchaseCount = Production_Records[Production_Status == &quot;Final Product Purchase&quot;].count();\n\tallInstallCount = Installation_Schedules[ID != 0].count();\n\tinstallForecastCount = Installation_Schedules[Installation_Status == &quot;Forecast&quot;].count();\n\tinstallWaitingProductionCount = Installation_Schedules[Installation_Status == &quot;Waiting for Production&quot; || Production_Readiness_Status == &quot;Not Ready&quot; || Production_Readiness_Status == &quot;Partially Ready&quot;].count();\n\tinstallReadyCount = Installation_Schedules[Installation_Status == &quot;Ready to Schedule&quot;].count();\n\tinstallScheduledCount = Installation_Schedules[Installation_Status == &quot;Scheduled&quot;].count();\n\tinstallInProgressCount = Installation_Schedules[Installation_Status == &quot;In Progress&quot;].count();\n\tinstallInstalledCount = Installation_Schedules[Installation_Status == &quot;Installed&quot;].count();\n\tinstallInspectionCount = Installation_Schedules[Installation_Status == &quot;Inspection Required&quot; || Installation_Status == &quot;Inspection Completed&quot;].count();\n\tinstallCompletedCount = Installation_Schedules[Installation_Status == &quot;Completed&quot;].count();\n\tinstallBlockedPermitCount = Installation_Schedules[Permit_Clearance_Status == &quot;Blocked&quot; || Permit_Clearance_Status == &quot;Required&quot; || Permit_Clearance_Status == &quot;Submitted&quot;].count();\n\tallPermitCount = Permit_Records[ID != 0].count();\n\tpermitRequiredCount = Permit_Records[Permit_Status == &quot;Required&quot;].count();\n\tpermitPreparingCount = Permit_Records[Permit_Status == &quot;Preparing&quot;].count();\n\tpermitSubmittedCount = Permit_Records[Permit_Status == &quot;Submitted&quot;].count();\n\tpermitApprovedCount = Permit_Records[Permit_Status == &quot;Approved&quot;].count();\n\tpermitRejectedCount = Permit_Records[Permit_Status == &quot;Rejected&quot;].count();\n\tpermitExpiredCount = Permit_Records[Permit_Status == &quot;Expired&quot;].count();\n\tpermitActiveCount = Permit_Records[Permit_Status != &quot;Approved&quot; &amp;&amp; Permit_Status != &quot;Not Required&quot; &amp;&amp; Permit_Status != &quot;Expired&quot;].count();\n\tallServiceCount = Service_Requests[ID != 0].count();\n\tserviceOpenCount = Service_Requests[Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;].count();\n\tserviceNewCount = Service_Requests[Service_Status == &quot;New&quot;].count();\n\tserviceTriageCount = Service_Requests[Service_Status == &quot;Triage&quot;].count();\n\tserviceScheduledCount = Service_Requests[Service_Status == &quot;Scheduled&quot;].count();\n\tserviceInProgressCount = Service_Requests[Service_Status == &quot;In Progress&quot;].count();\n\tservicePartsCount = Service_Requests[Service_Status == &quot;Parts Required&quot;].count();\n\tserviceRepairedCount = Service_Requests[Service_Status == &quot;Repaired&quot;].count();\n\tserviceCompletedCount = Service_Requests[Service_Status == &quot;Completed&quot; || Service_Status == &quot;Closed&quot;].count();\n\tserviceUrgentCount = Service_Requests[Priority == &quot;Urgent&quot; &amp;&amp; Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;].count();\n\tlowMaterials = Material_Master[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tlowPowders = Powder_Coating_Inventory[Available_Quantity &lt;= Reorder_Level &amp;&amp; Active == true];\n\tlowMaterialsCount = lowMaterials.count();\n\tlowPowdersCount = lowPowders.count();\n\tlowStockTotal = lowMaterialsCount + lowPowdersCount;\n\topenPOCount = Purchase_Orders[PO_Status != &quot;Received&quot; &amp;&amp; PO_Status != &quot;Cancelled&quot;].count();\n\treadyInstallPct = 0;\n\tif(allInstallCount &gt; 0)\n\t{\n\t\treadyInstallPct = (installReadyCount * 100) / allInstallCount;\n\t}\n\tproductionReadyPct = 0;\n\tif(allProductionCount &gt; 0)\n\t{\n\t\tproductionReadyPct = (productionReadyCount * 100) / allProductionCount;\n\t}\n\torderActivePct = 0;\n\tif(allOrdersCount &gt; 0)\n\t{\n\t\torderActivePct = (activeOrdersCount * 100) / allOrdersCount;\n\t}\n\tserviceOpenPct = 0;\n\tif(allServiceCount &gt; 0)\n\t{\n\t\tserviceOpenPct = (serviceOpenCount * 100) / allServiceCount;\n\t}\n\t%&gt;\n&lt;style&gt;\n.zc-content-loader div { display: none !important; } .zc_live_adminbar .zc-container-wrapper { height: 100% !important; } div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1, .zc-pb-formreport-placeholder { height: 100% !important; } .Layout.elemContainment, .zc-pb-page-content-wrapper .elemContainment, .column-container .zc-pb-tile-container { padding: unset !important; } .zpcontent-wrapper div.zpelement-wrapper { height: 100% !important; } .zc-pb-tile-card::-webkit-scrollbar { display: none !important; }\n:root { --zcs-theme-brand-color: var(--zcs_brand_color, var(--theme_brand_color, #2A6FFC)); --zcs-light-bg-color: var(--zcs_brand_light_color, #ECF3FF); --zcs-page-bg-color: #F7F8FC; --zcs-primary-text-color: var(--zcs_primary_text_color, #12132B); --zcs-secondary-text-color: var(--zcs_secondary_text_color, #4E5668); --zcs-teritiary-text-color: var(--zcs_tertiary_text_color, #7A8191); --zcs-border-color: var(--zcs_tertiary_border_color, #E5E8F0); --zcs-white-color: #FFFFFF; --zcs-brand-soft: rgba(42,111,252,.10); --zcs-warning-soft: #FFF6E3; --zcs-danger-soft: #FFECEF; --zcs-success-soft: #EAFBF4; --zcs-info-soft: #EAF7FF; font-size: 16px; line-height: 1.5; }\n#splash-screen { display: none !important; }\n.zcs-row { display: flex; flex-wrap: wrap; }\n.zcs-flex { display: flex; }\n.zcs-inline-flex { display: inline-flex; }\n.zcs-direction-column { flex-direction: column; }\n.zcs-col-common { flex: 1 1 0%; min-width: 0; }\n.zcs-align-items-center { align-items: center; }\n.zcs-align-items-start { align-items: flex-start; }\n.zcs-justify-center { justify-content: center; }\n.zcs-justify-space-between { justify-content: space-between; }\n.zcs-gap-4 { gap: .25rem; }\n.zcs-gap-6 { gap: .375rem; }\n.zcs-gap-8 { gap: .5rem; }\n.zcs-gap-10 { gap: .625rem; }\n.zcs-gap-12 { gap: .75rem; }\n.zcs-gap-16 { gap: 1rem; }\n.zcs-gap-20 { gap: 1.25rem; }\n.zcs-p-8 { padding: .5rem; }\n.zcs-p-10 { padding: .625rem; }\n.zcs-p-12 { padding: .75rem; }\n.zcs-p-16 { padding: 1rem; }\n.zcs-p-20 { padding: 1.25rem; }\n.zcs-px-8 { padding-left: .5rem; padding-right: .5rem; }\n.zcs-px-10 { padding-left: .625rem; padding-right: .625rem; }\n.zcs-px-12 { padding-left: .75rem; padding-right: .75rem; }\n.zcs-px-16 { padding-left: 1rem; padding-right: 1rem; }\n.zcs-py-2 { padding-top: .125rem; padding-bottom: .125rem; }\n.zcs-py-4 { padding-top: .25rem; padding-bottom: .25rem; }\n.zcs-py-8 { padding-top: .5rem; padding-bottom: .5rem; }\n.zcs-py-10 { padding-top: .625rem; padding-bottom: .625rem; }\n.zcs-py-12 { padding-top: .75rem; padding-bottom: .75rem; }\n.zcs-m-0 { margin: 0; }\n.zcs-mt-4 { margin-top: .25rem; }\n.zcs-mt-6 { margin-top: .375rem; }\n.zcs-mt-8 { margin-top: .5rem; }\n.zcs-mt-10 { margin-top: .625rem; }\n.zcs-mt-12 { margin-top: .75rem; }\n.zcs-mt-16 { margin-top: 1rem; }\n.zcs-mb-0 { margin-bottom: 0; }\n.zcs-font-11 { font-size: .6875rem; }\n.zcs-font-12 { font-size: .75rem; }\n.zcs-font-13 { font-size: .8125rem; }\n.zcs-font-14 { font-size: .875rem; }\n.zcs-font-15 { font-size: .9375rem; }\n.zcs-font-16 { font-size: 1rem; }\n.zcs-font-18 { font-size: 1.125rem; }\n.zcs-font-20 { font-size: 1.25rem; }\n.zcs-font-24 { font-size: 1.5rem; }\n.zcs-font-28 { font-size: 1.75rem; }\n.zcs-font-normal { font-weight: 400; }\n.zcs-font-medium { font-weight: 500; }\n.zcs-font-semibold { font-weight: 600; }\n.zcs-font-bold { font-weight: 700; }\n.zcs-lh-body { line-height: 1.5; }\n.zcs-lh-heading { line-height: 1.25; }\n.zcs-uppercase { text-transform: uppercase; }\n.zcs-text-left { text-align: left; }\n.zcs-text-right { text-align: right; }\n.zcs-text-center { text-align: center; }\n.zcs-rounded-sm { border-radius: .25rem; }\n.zcs-rounded-md { border-radius: .375rem; }\n.zcs-rounded-lg { border-radius: .5rem; }\n.zcs-rounded-xl { border-radius: .75rem; }\n.zcs-rounded-2xl { border-radius: 1rem; }\n.zcs-box-border { box-sizing: border-box; }\n.zcs-relative { position: relative; }\n.zcs-sticky { position: sticky; }\n.zcs-w-full { width: 100%; }\n.zcs-color-theme { color: var(--zcs-theme-brand-color); }\n.zcs-color-primary { color: var(--zcs-primary-text-color); }\n.zcs-color-secondary { color: var(--zcs-secondary-text-color); }\n.zcs-color-tertiary { color: var(--zcs-teritiary-text-color); }\n.zcs-color-white { color: #fff; }\n.zcs-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zcs-card { background-color: var(--zcs-white-color); border: 1px solid var(--zcs-border-color); border-radius: 16px; box-shadow: 0 10px 30px rgba(16,24,40,.05); }\n.zcs-template-card { width: 260px; height: 250px; overflow: hidden; }\n.zcs-card-header { border-bottom: 1px solid var(--zcs-border-color); }\n.zcs-card-content { box-sizing: border-box; }\n.zcs-badge { width: auto; }\n.zcs-badge-filled { border: 1px solid transparent; }\n.zcs-badge-filled-outline { border: 1px solid; }\n.zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: #fff; }\n.zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: #fff; }\n.zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: #fff; }\n.zcs-badge-filled.zcs-badge-grey { background-color: #5D6372; border-color: #5D6372; color: #fff; }\n.zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: #fff; }\n.zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: #fff; }\n.zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: #fff; }\n.zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-brand-soft); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); }\n.zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; }\n.zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; }\n.zcs-badge-filled-outline.zcs-badge-grey { background-color: #E8E8E8; border-color: #5D6372; color: #5D6372; }\n.zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #B8770D; }\n.zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; }\n.zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; }\n.zcs-table-wrapper { border: 1px solid var(--zcs-border-color); background-color: #fff; overflow: auto; border-radius: 14px; }\n.zcs-table-wrapper table { line-height: normal; border-collapse: collapse; min-width: 760px; }\n.zcs-table-wrapper table thead { top: 0; z-index: 1; }\n.zcs-table-wrapper table thead tr th { background-color: #F9FAFE; box-shadow: 0 -1px 0 0 var(--zcs-border-color) inset; white-space: nowrap; }\n.zcs-table-wrapper table tbody tr td { border-top: 1px solid var(--zcs-border-color); vertical-align: top; }\n.zcs-table-wrapper table tbody tr:first-child td { border-color: transparent; }\n.zcs-table-wrapper table tbody tr:hover td { background-color: #F9FAFE; }\na { text-decoration: none; }\n.viewer-home-shell { min-height: 100%; background: radial-gradient(circle at top left, var(--zcs-light-bg-color), transparent 34%), var(--zcs-page-bg-color); color: var(--zcs-primary-text-color); font-family: var(--zcs_font_family, Poppins, ZohoPuvi, Arial, sans-serif); padding: 22px; box-sizing: border-box; overflow: auto; }\n.viewer-hero { border: 1px solid rgba(255,255,255,.55); border-radius: 24px; padding: 24px; background: linear-gradient(135deg, var(--zcs-theme-brand-color), #172B55); color: #fff; position: relative; overflow: hidden; box-shadow: 0 20px 45px rgba(31,54,112,.18); }\n.viewer-hero:after { content: &apos;&apos;; position: absolute; width: 340px; height: 340px; right: -92px; top: -128px; border-radius: 50%; background: rgba(255,255,255,.13); box-shadow: -74px 96px 0 rgba(255,255,255,.08); }\n.viewer-hero-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.viewer-eyebrow { letter-spacing: .08em; opacity: .78; }\n.viewer-title { font-size: clamp(24px, 3vw, 38px); line-height: 1.1; margin: 4px 0 8px; }\n.viewer-subtitle { max-width: 920px; color: rgba(255,255,255,.82); margin: 0; }\n.viewer-hero-meta { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 12px 14px; min-width: 230px; backdrop-filter: blur(10px); }\n.viewer-kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }\n.viewer-kpi-card.zcs-template-card { width: auto; height: auto; min-height: 142px; overflow: hidden; padding: 0; position: relative; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }\n.viewer-kpi-card:hover { transform: translateY(-2px); border-color: rgba(42,111,252,.25); box-shadow: 0 14px 34px rgba(16,24,40,.09); }\n.viewer-kpi-card:before { content: &apos;&apos;; position: absolute; width: 92px; height: 92px; border-radius: 50%; right: -30px; bottom: -35px; background: var(--kpi-soft, var(--zcs-brand-soft)); }\n.viewer-kpi-icon { width: 42px; height: 42px; border-radius: 14px; background: var(--kpi-soft, var(--zcs-brand-soft)); color: var(--kpi-color, var(--zcs-theme-brand-color)); }\n.viewer-kpi-value { font-size: 30px; line-height: 1; margin-top: 12px; }\n.viewer-kpi-label { color: var(--zcs-secondary-text-color); min-height: 38px; }\n.viewer-link, .viewer-panel-link, .viewer-row-link { color: var(--zcs-theme-brand-color); font-size: 13px; font-weight: 600; text-decoration: none; position: relative; z-index: 1; }\n.viewer-link:hover, .viewer-panel-link:hover, .viewer-row-link:hover { text-decoration: underline; }\n.viewer-section-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }\n.viewer-wide-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); gap: 16px; margin-top: 16px; }\n.viewer-panel { padding: 18px; }\n.viewer-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\n.viewer-panel-title { margin: 0; font-size: 18px; }\n.viewer-note { color: var(--zcs-teritiary-text-color); }\n.viewer-status-list { display: grid; gap: 9px; }\n.viewer-status-row { display: grid; grid-template-columns: minmax(150px, .85fr) minmax(0, 1.35fr) 54px; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid #EEF1F7; }\n.viewer-status-row:last-child { border-bottom: none; }\n.viewer-progress { height: 8px; background: #EEF2FA; overflow: hidden; border-radius: 99px; }\n.viewer-progress-fill { height: inherit; border-radius: inherit; background: var(--bar-color, var(--zcs-theme-brand-color)); min-width: 2px; }\n.viewer-chip-list { display: flex; flex-wrap: wrap; gap: 8px; }\n.viewer-readonly-banner { background: #FBFCFF; border: 1px dashed var(--zcs-border-color); border-radius: 14px; padding: 12px; }\n.viewer-low-stock-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n.viewer-stock-card { padding: 14px; border: 1px solid var(--zcs-border-color); border-radius: 14px; background: #fff; }\n.viewer-stock-icon { width: 34px; height: 34px; border-radius: 12px; background: var(--zcs-warning-soft); color: #B8770D; }\n.viewer-muted-line { color: var(--zcs-teritiary-text-color); font-size: 12px; margin-top: 4px; }\n@media (max-width: 1240px) { .viewer-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .viewer-wide-grid { grid-template-columns: 1fr; } }\n@media (max-width: 900px) { .viewer-section-grid { grid-template-columns: 1fr; } .viewer-hero-content { flex-direction: column; } .viewer-hero-meta { width: 100%; box-sizing: border-box; } }\n@media (max-width: 640px) { .viewer-home-shell { padding: 12px; } .viewer-hero { padding: 18px; border-radius: 18px; } .viewer-kpi-grid { grid-template-columns: 1fr; } .viewer-panel { padding: 14px; } .viewer-panel-header { align-items: flex-start; flex-direction: column; } .viewer-status-row { grid-template-columns: 1fr; gap: 6px; } .viewer-low-stock-grid { grid-template-columns: 1fr; } .viewer-responsive-table table, .viewer-responsive-table thead, .viewer-responsive-table tbody, .viewer-responsive-table th, .viewer-responsive-table td, .viewer-responsive-table tr { display: block; min-width: 0; width: 100%; } .viewer-responsive-table thead { display: none; } .viewer-responsive-table tbody tr { border-top: 1px solid var(--zcs-border-color); padding: 10px 0; } .viewer-responsive-table tbody tr:first-child { border-top: none; } .viewer-responsive-table tbody tr td { border-top: none; display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 8px; padding: 6px 12px; } .viewer-responsive-table tbody tr td:before { content: attr(data-label); color: var(--zcs-teritiary-text-color); font-size: 12px; font-weight: 600; } .viewer-responsive-table tbody tr td[colspan]:before { content: &apos;&apos;; display: none; } }\n&lt;/style&gt;\n&lt;div class=&quot;viewer-home-shell&quot;&gt;\n\t\t&lt;section class=&quot;viewer-hero&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-hero-content&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-eyebrow zcs-font-12 zcs-uppercase zcs-font-semibold&quot;&gt;Read-only operations view&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;viewer-title zcs-font-bold&quot;&gt;Viewer Home&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-subtitle zcs-font-15&quot;&gt;Operational counts, status summaries, production and installation readiness, permit visibility, service status, and stock alerts without action controls or financial values.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-hero-meta&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-uppercase zcs-font-semibold&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;Signed in&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-16 zcs-font-semibold zcs-mt-4&quot;&gt;&lt;%=zoho.loginuser%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-12 zcs-mt-4&quot; style=&quot;color:rgba(255,255,255,.72);&quot;&gt;&lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-kpi-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#ECF3FF;--kpi-color:#2A6FFC;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-doc zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=activeOrdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Active orders&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Active_Orders&lt;%=readonlyParams%&gt;&quot;&gt;Open read-only report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-2-time zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=awaitingGreenCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Awaiting green light&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Orders_Awaiting_Green_Light&lt;%=readonlyParams%&gt;&quot;&gt;View queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAFBF4;--kpi-color:#179E6C;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-check-circle-08 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=productionReadyCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Production ready or received&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Ready_For_Installation_Items&lt;%=readonlyParams%&gt;&quot;&gt;Ready items&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#F0ECFF;--kpi-color:#7656D6;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-calendar-60 zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=installReadyCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Ready-to-schedule installs&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Ready_To_Schedule_Installations&lt;%=readonlyParams%&gt;&quot;&gt;Installation queue&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EAF7FF;--kpi-color:#1094C5;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline files-2-paper zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=permitActiveCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Active permits&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Active_Permits&lt;%=readonlyParams%&gt;&quot;&gt;Permit report&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFECEF;--kpi-color:#FE455D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline ui-3-alert zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=serviceUrgentCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Urgent open service&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Open_Service_Requests&lt;%=readonlyParams%&gt;&quot;&gt;Service list&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#FFF6E3;--kpi-color:#B8770D;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-tag zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=lowStockTotal%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Low-stock raw material and powder items&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#low-stock-summary&quot;&gt;Review counts&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-kpi-card zcs-template-card zcs-card zcs-flex zcs-direction-column zcs-relative&quot; style=&quot;--kpi-soft:#EEF1F7;--kpi-color:#5D6372;&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;zcs-card-content zcs-col-common zcs-p-16 zcs-box-border&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-cart-simple zcs-font-20&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-value zcs-font-bold&quot;&gt;&lt;%=openPOCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-kpi-label zcs-font-13&quot;&gt;Open purchase orders without amounts&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link&quot; href=&quot;#Report:Open_Purchase_Orders&lt;%=readonlyParams%&gt;&quot;&gt;Read-only PO list&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-panel zcs-card zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Viewer access scope&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;This page is intentionally read-only. It surfaces report and detail navigation only; no popup status forms, edit links, delete links, or invoice/PO amounts are rendered.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-chip-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-eye-17&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Read-only&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-grey&quot;&gt;&lt;i class=&quot;zc-li-outline ui-1-lock&quot;&gt;&lt;/i&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;No action controls&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Order status summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Operational order stages only; invoice financial values are excluded.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Customer_Orders&lt;%=readonlyParams%&gt;&quot;&gt;All orders&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-status-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Awaiting green light&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#B8770D;width:&lt;%=if(activeOrdersCount &gt; 0,(orderAwaitingCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderAwaitingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Green light&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=if(activeOrdersCount &gt; 0,(orderGreenCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderGreenCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;In production&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#2A6FFC;width:&lt;%=if(activeOrdersCount &gt; 0,(orderProductionCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderProductionCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Material hold&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#FE455D;width:&lt;%=if(activeOrdersCount &gt; 0,(orderMaterialHoldCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderMaterialHoldCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Ready for installation&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=if(activeOrdersCount &gt; 0,(orderReadyInstallCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderReadyInstallCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Installation scheduled&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#7656D6;width:&lt;%=if(activeOrdersCount &gt; 0,(orderInstallScheduledCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderInstallScheduledCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Installed or inspection&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#1094C5;width:&lt;%=if(activeOrdersCount &gt; 0,((orderInstalledCount + orderInspectionCount) * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderInstalledCount + orderInspectionCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;On hold&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#F4660C;width:&lt;%=if(activeOrdersCount &gt; 0,(orderOnHoldCount * 100) / activeOrdersCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=orderOnHoldCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Production pipeline summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Queue, shortage, manufacturing, powder, purchase-finished-product, and readiness counts.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Production_Records&lt;%=readonlyParams%&gt;&quot;&gt;All production&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-status-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Awaiting green light&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#5D6372;width:&lt;%=if(allProductionCount &gt; 0,(productionAwaitingCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionAwaitingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Queued&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#2A6FFC;width:&lt;%=if(allProductionCount &gt; 0,(productionQueuedCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionQueuedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Material shortage&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#FE455D;width:&lt;%=if(allProductionCount &gt; 0,(productionShortageCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionShortageCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Material ordered&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#B8770D;width:&lt;%=if(allProductionCount &gt; 0,(productionOrderedCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionOrderedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Manufacturing&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#1094C5;width:&lt;%=if(allProductionCount &gt; 0,(productionManufacturingCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionManufacturingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Powder coating&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#7656D6;width:&lt;%=if(allProductionCount &gt; 0,(productionPowderCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionPowderCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Final product purchase&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#F4660C;width:&lt;%=if(allProductionCount &gt; 0,(productionFinalPurchaseCount * 100) / allProductionCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionFinalPurchaseCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Ready or received&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=productionReadyPct%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=productionReadyCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-section-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Installation schedule summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Forecast, blocked, ready, scheduled, field progress, QC, and completion counts.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&lt;%=readonlyParams%&gt;&quot;&gt;All schedules&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-chip-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Forecast: &lt;%=installForecastCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Waiting production: &lt;%=installWaitingProductionCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Ready to schedule: &lt;%=installReadyCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Scheduled: &lt;%=installScheduledCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;In progress: &lt;%=installInProgressCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Inspection: &lt;%=installInspectionCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Completed: &lt;%=installCompletedCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-red&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Permit blocked: &lt;%=installBlockedPermitCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Permit status summary&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Order-level permit visibility without document editing controls.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Permit_Records&lt;%=readonlyParams%&gt;&quot;&gt;All permits&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-status-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Required&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#B8770D;width:&lt;%=if(allPermitCount &gt; 0,(permitRequiredCount * 100) / allPermitCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=permitRequiredCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Preparing&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#F4660C;width:&lt;%=if(allPermitCount &gt; 0,(permitPreparingCount * 100) / allPermitCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=permitPreparingCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Submitted&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#2A6FFC;width:&lt;%=if(allPermitCount &gt; 0,(permitSubmittedCount * 100) / allPermitCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=permitSubmittedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Approved&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#179E6C;width:&lt;%=if(allPermitCount &gt; 0,(permitApprovedCount * 100) / allPermitCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=permitApprovedCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-status-row&quot;&gt;&lt;div class=&quot;zcs-font-14 zcs-font-medium&quot;&gt;Rejected or expired&lt;/div&gt;&lt;div class=&quot;viewer-progress&quot;&gt;&lt;div class=&quot;viewer-progress-fill&quot; style=&quot;--bar-color:#FE455D;width:&lt;%=if(allPermitCount &gt; 0,((permitRejectedCount + permitExpiredCount) * 100) / allPermitCount,0)%&gt;%&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;zcs-font-14 zcs-font-semibold zcs-text-right&quot;&gt;&lt;%=permitRejectedCount + permitExpiredCount%&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-wide-grid&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Service summary and current open requests&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Customer service visibility without closure or status action links.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Service_Requests&lt;%=readonlyParams%&gt;&quot;&gt;All services&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-chip-list zcs-mt-8&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Open: &lt;%=serviceOpenCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-orange&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;New/Triage: &lt;%=serviceNewCount + serviceTriageCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Scheduled: &lt;%=serviceScheduledCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;In progress: &lt;%=serviceInProgressCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Parts required: &lt;%=servicePartsCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-6 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Repaired/closed: &lt;%=serviceRepairedCount + serviceCompletedCount%&gt;&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Service&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer / issue&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Priority&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Schedule / technician&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\tserviceRows = 0;\n\tfor each  svc in Service_Requests[Service_Status != &quot;Closed&quot; &amp;&amp; Service_Status != &quot;Cancelled&quot;] sort by Request_Date desc\n\t{\n\t\tif(serviceRows &lt; 8)\n\t\t{\n\t\t\tserviceRows = serviceRows + 1;\n\t\t\tstatusClass = &quot;zcs-badge-grey&quot;;\n\t\t\tif(svc.Service_Status == &quot;New&quot; || svc.Service_Status == &quot;Triage&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Scheduled&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-blue&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;In Progress&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-theme&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Parts Required&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-yellow&quot;;\n\t\t\t}\n\t\t\telse if(svc.Service_Status == &quot;Repaired&quot; || svc.Service_Status == &quot;Completed&quot;)\n\t\t\t{\n\t\t\t\tstatusClass = &quot;zcs-badge-green&quot;;\n\t\t\t}\n\t\t\tpriorityClass = &quot;zcs-badge-blue&quot;;\n\t\t\tif(svc.Priority == &quot;Urgent&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-red&quot;;\n\t\t\t}\n\t\t\telse if(svc.Priority == &quot;High&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-orange&quot;;\n\t\t\t}\n\t\t\telse if(svc.Priority == &quot;Low&quot;)\n\t\t\t{\n\t\t\t\tpriorityClass = &quot;zcs-badge-grey&quot;;\n\t\t\t}\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Service&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;strong&gt;&lt;a class=&quot;viewer-row-link&quot; href=&quot;#Page:Service_Detail?Service_ID=&lt;%=svc.ID%&gt;&quot;&gt;&lt;%=svc.Service_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Requested &lt;%=ifnull(svc.Request_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / issue&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(svc.Customer.Customer_Name,ifnull(svc.Customer_Name,&quot;Customer pending&quot;))%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;&lt;%=ifnull(svc.Issue_Description,&quot;Issue not entered&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Priority&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled &lt;%=priorityClass%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=ifnull(svc.Priority,&quot;Normal&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Schedule / technician&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(svc.Scheduled_Start,&quot;Not scheduled&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;&lt;%=ifnull(svc.Technician.Employee_Name,&quot;Technician unassigned&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled &lt;%=statusClass%&gt; zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;&lt;%=ifnull(svc.Service_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(serviceRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot;&gt;No open service requests are currently visible.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;viewer-panel zcs-card&quot; id=&quot;low-stock-summary&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Low-stock counts&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Counts only; purchasing amounts are not displayed.&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-low-stock-grid&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-stock-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-stock-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline shopping-tag zcs-font-18&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-24 zcs-font-bold&quot;&gt;&lt;%=lowMaterialsCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Raw materials below reorder level&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link zcs-inline-flex zcs-mt-10&quot; href=&quot;#Report:Low_Material_Stock&lt;%=readonlyParams%&gt;&quot;&gt;Low material report&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-stock-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-center zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;viewer-stock-icon zcs-flex zcs-align-items-center zcs-justify-center&quot;&gt;&lt;i class=&quot;zc-li-outline design-paint-37 zcs-font-18&quot;&gt;&lt;/i&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-24 zcs-font-bold&quot;&gt;&lt;%=lowPowdersCount%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-secondary&quot;&gt;Powders below reorder level&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-link zcs-inline-flex zcs-mt-10&quot; href=&quot;#Report:Low_Powder_Stock&lt;%=readonlyParams%&gt;&quot;&gt;Low powder report&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-readonly-banner zcs-mt-16&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-flex zcs-align-items-start zcs-gap-10&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-lock zcs-font-18 zcs-color-tertiary&quot;&gt;&lt;/i&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-14 zcs-font-semibold&quot;&gt;Stock visibility only&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;zcs-font-13 zcs-color-tertiary zcs-mt-4&quot;&gt;Use Inventory Detail links from item-level reports only when that detail page is available. No receiving or stock-update controls are exposed here.&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n\n\t\t&lt;section class=&quot;viewer-panel zcs-card zcs-mt-16&quot;&gt;\n\t\t\t\t&lt;div class=&quot;viewer-panel-header&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;viewer-panel-title zcs-font-semibold&quot;&gt;Recent operational records&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;viewer-note zcs-font-13 zcs-mt-4 zcs-mb-0&quot;&gt;Read-only detail navigation is provided for operational context where detail pages exist.&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;viewer-chip-list&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Customer_Orders&lt;%=readonlyParams%&gt;&quot;&gt;Orders&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Production_Records&lt;%=readonlyParams%&gt;&quot;&gt;Production&lt;/a&gt;\n\t\t\t\t\t\t\t\t&lt;a class=&quot;viewer-panel-link&quot; href=&quot;#Report:All_Installation_Schedules&lt;%=readonlyParams%&gt;&quot;&gt;Installation&lt;/a&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;viewer-responsive-table zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative&quot;&gt;\n\t\t\t\t\t\t&lt;table class=&quot;zcs-w-full&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead class=&quot;zcs-sticky&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Type&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Record&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Customer / item&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Status&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th class=&quot;zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-color-primary&quot;&gt;Date / sequence&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n&lt;%\n\torderRows = 0;\n\tfor each  ord in Customer_Orders[Order_Status != &quot;Completed&quot; &amp;&amp; Order_Status != &quot;Cancelled&quot;] sort by Order_Placement_Date desc\n\t{\n\t\tif(orderRows &lt; 4)\n\t\t{\n\t\t\torderRows = orderRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Type&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Order&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Record&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;strong&gt;&lt;a class=&quot;viewer-row-link&quot; href=&quot;#Page:Order_Detail?Order_ID=&lt;%=ord.ID%&gt;&quot;&gt;&lt;%=ord.Order_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Invoice ref hidden from financial context&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / item&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(ord.Customer.Customer_Name,ifnull(ord.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;&lt;%=ifnull(ord.Area_or_City,&quot;Area not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(ord.Order_Status,&quot;Not set&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Permit: &lt;%=ifnull(ord.Permit_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Date / sequence&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(ord.Order_Placement_Date,&quot;Not set&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Expected: &lt;%=ifnull(ord.Expected_Delivery_Date,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tprodRows = 0;\n\tfor each  prod in Production_Records[Production_Status != &quot;Ready for Installation&quot; &amp;&amp; Production_Status != &quot;Purchased and Received&quot; &amp;&amp; Production_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(prodRows &lt; 4)\n\t\t{\n\t\t\tprodRows = prodRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Type&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-theme&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Production&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Record&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;strong&gt;&lt;a class=&quot;viewer-row-link&quot; href=&quot;#Page:Production_Detail?Production_ID=&lt;%=prod.ID%&gt;&quot;&gt;&lt;%=prod.Production_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Order &lt;%=ifnull(prod.Customer_Order.Order_Code,&quot;Not linked&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / item&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(prod.Product.Product_Name,ifnull(prod.Product_Description,&quot;Product pending&quot;))%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;&lt;%=ifnull(prod.Colour,&quot;Colour not set&quot;)%&gt; \u00B7 Qty &lt;%=ifnull(prod.Quantity,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(prod.Production_Status,&quot;Not set&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Material: &lt;%=ifnull(prod.Material_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Date / sequence&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;Priority &lt;%=ifnull(prod.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Group &lt;%=ifnull(prod.Manufacturing_Group.Group_Name,&quot;Not grouped&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tinstRows = 0;\n\tfor each  inst in Installation_Schedules[Installation_Status != &quot;Completed&quot; &amp;&amp; Installation_Status != &quot;Cancelled&quot;] sort by Priority_Sequence asc\n\t{\n\t\tif(instRows &lt; 4)\n\t\t{\n\t\t\tinstRows = instRows + 1;\n\t\t\t%&gt;\n&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Type&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;span class=&quot;zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-green&quot;&gt;&lt;span class=&quot;zcs-badge-text zcs-font-12&quot;&gt;Installation&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Record&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;strong&gt;&lt;a class=&quot;viewer-row-link&quot; href=&quot;#Page:Installation_Detail?Installation_ID=&lt;%=inst.ID%&gt;&quot;&gt;&lt;%=inst.Installation_Code%&gt;&lt;/a&gt;&lt;/strong&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Order &lt;%=ifnull(inst.Customer_Order.Order_Code,&quot;Not linked&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Customer / item&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(inst.Customer.Customer_Name,ifnull(inst.Customer_Name_Snapshot,&quot;Customer pending&quot;))%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;&lt;%=ifnull(inst.Area_or_City,&quot;Area not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Status&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(inst.Installation_Status,&quot;Not set&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Production &lt;%=ifnull(inst.Production_Readiness_Status,&quot;Not set&quot;)%&gt; \u00B7 Permit &lt;%=ifnull(inst.Permit_Clearance_Status,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;td data-label=&quot;Date / sequence&quot; class=&quot;zcs-px-16 zcs-py-10 zcs-box-border zcs-font-14&quot;&gt;&lt;%=ifnull(inst.Scheduled_Start,&quot;Not scheduled&quot;)%&gt;&lt;br&gt;&lt;span class=&quot;viewer-muted-line&quot;&gt;Priority &lt;%=ifnull(inst.Priority_Sequence,&quot;Not set&quot;)%&gt;&lt;/span&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n&lt;%\n\t\t}\n\t}\n\tif(orderRows + prodRows + instRows == 0)\n\t{\n\t\t%&gt;\n&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;zcs-px-16 zcs-py-12 zcs-box-border zcs-font-14 zcs-color-tertiary&quot;&gt;No active operational records are currently visible.&lt;/td&gt;&lt;/tr&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/section&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Action_Comments_On_Load as "Action Comments On Load"
			{
			
							type =  form
							form = Action_Comments
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Target_Module != null)
													{
														disable Target_Module;
														clear New_Status;
														if(input.Target_Module == "Customer_Orders")
														{
															input.New_Status:ui.add({"Green Light","On Hold","Cancelled"});
														}
														else if(input.Target_Module == "Production_Records")
														{
															input.New_Status:ui.add({"Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","On Hold","Cancelled"});
														}
														else if(input.Target_Module == "Purchase_Orders")
														{
															input.New_Status:ui.add({"Submitted for Approval","Approved","Ordered","Partially Received","Received","Cancelled"});
														}
														else if(input.Target_Module == "Installation_Schedules")
														{
															input.New_Status:ui.add({"Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"});
														}
														else if(input.Target_Module == "Permit_Records")
														{
															input.New_Status:ui.add({"Preparing","Submitted","Approved","Rejected","Expired","Not Required"});
														}
														else if(input.Target_Module == "Service_Requests")
														{
															input.New_Status:ui.add({"Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"});
														}
													}
													if(input.Lookup_ID != null)
													{
														disable Lookup_ID;
													}
									)
								}
							}
			
						
			}

			Action_Comments_On_Success as "Action Comments On Success"
			{
			
							type =  form
							form = Action_Comments
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Target_Module == "Customer_Orders")
													{
														order_rec = Customer_Orders[ID == input.Lookup_ID];
														if(order_rec.count() > 0)
														{
															if(input.New_Status == "Green Light")
															{
																order_rec.Order_Status="Green Light";
																order_rec.Admin_Green_Light_Date=zoho.currentdate;
															}
															else
															{
																order_rec.Order_Status=input.New_Status;
															}
														}
													}
													else if(input.Target_Module == "Production_Records")
													{
														prod_rec = Production_Records[ID == input.Lookup_ID];
														if(prod_rec.count() > 0)
														{
															prod_rec.Production_Status=input.New_Status;
															if(input.New_Status == "Material Shortage")
															{
																prod_rec.Material_Status="Shortage Identified";
															}
															if(input.New_Status == "Ready for Installation" || input.New_Status == "Purchased and Received")
															{
																prod_rec.Ready_For_Installation_Date=zoho.currentdate;
																ready_count = Production_Records[Customer_Order == prod_rec.Customer_Order && Production_Status == "Ready for Installation" || Production_Status == "Purchased and Received"].count();
																total_count = Production_Records[Customer_Order == prod_rec.Customer_Order && Production_Status != "Cancelled"].count();
																install_rec = Installation_Schedules[Customer_Order == prod_rec.Customer_Order];
																if(install_rec.count() > 0)
																{
																	if(total_count > 0 && ready_count == total_count)
																	{
																		install_rec.Production_Readiness_Status="Ready";
																		if(install_rec.Permit_Clearance_Status == "Approved" || install_rec.Permit_Clearance_Status == "Not Required")
																		{
																			install_rec.Installation_Status="Ready to Schedule";
																		}
																	}
																	else
																	{
																		install_rec.Production_Readiness_Status="Partially Ready";
																	}
																}
															}
														}
													}
													else if(input.Target_Module == "Purchase_Orders")
													{
														po_rec = Purchase_Orders[ID == input.Lookup_ID];
														if(po_rec.count() > 0)
														{
															po_rec.PO_Status=input.New_Status;
															if(input.New_Status == "Approved")
															{
																po_rec.Approved_Date=zoho.currentdate;
																staff_rec = Add_Employee[Email == zoho.loginuserid];
																if(staff_rec.count() > 0)
																{
																	po_rec.Approved_By=staff_rec.ID;
																}
															}
															if(input.New_Status == "Partially Received" || input.New_Status == "Received")
															{
																for each  line_rec in po_rec.Lines
																{
																	if(ifnull(line_rec.Received_Quantity,0) > 0 && line_rec.Stock_Posted == false)
																	{
																		if(line_rec.Line_Type == "Raw Material" || line_rec.Line_Type == "Service Part")
																		{
																			mat_rec = Material_Master[ID == line_rec.Material];
																			if(mat_rec.count() > 0)
																			{
																				mat_rec.Available_Quantity=ifnull(mat_rec.Available_Quantity,0) + ifnull(line_rec.Received_Quantity,0);
																				mat_rec.Last_Updated=zoho.currentdate;
																			}
																		}
																		else if(line_rec.Line_Type == "Powder")
																		{
																			powder_rec = Powder_Coating_Inventory[ID == line_rec.Powder];
																			if(powder_rec.count() > 0)
																			{
																				powder_rec.Available_Quantity=ifnull(powder_rec.Available_Quantity,0) + ifnull(line_rec.Received_Quantity,0);
																				powder_rec.Last_Updated=zoho.currentdate;
																			}
																		}
																		else if(line_rec.Line_Type == "Finished Product")
																		{
																			prod_po_rec = Production_Records[ID == line_rec.Linked_Production];
																			if(prod_po_rec.count() > 0 && ifnull(line_rec.Received_Quantity,0) >= ifnull(line_rec.Quantity,0))
																			{
																				prod_po_rec.Production_Status="Purchased and Received";
																				prod_po_rec.Ready_For_Installation_Date=zoho.currentdate;
																			}
																		}
																		line_rec.Stock_Posted=true;
																		if(line_rec.Received_Date == null)
																		{
																			line_rec.Received_Date=zoho.currentdate;
																		}
																	}
																}
															}
														}
													}
													else if(input.Target_Module == "Installation_Schedules")
													{
														inst_rec = Installation_Schedules[ID == input.Lookup_ID];
														if(inst_rec.count() > 0)
														{
															inst_rec.Installation_Status=input.New_Status;
															order_for_inst = Customer_Orders[ID == inst_rec.Customer_Order];
															if(order_for_inst.count() > 0)
															{
																if(input.New_Status == "Scheduled")
																{
																	order_for_inst.Order_Status="Installation Scheduled";
																}
																else if(input.New_Status == "Installed")
																{
																	order_for_inst.Order_Status="Installed";
																}
																else if(input.New_Status == "Inspection Required")
																{
																	order_for_inst.Order_Status="Inspection Required";
																}
																else if(input.New_Status == "Completed")
																{
																	order_for_inst.Order_Status="Completed";
																}
															}
														}
													}
													else if(input.Target_Module == "Permit_Records")
													{
														permit_rec = Permit_Records[ID == input.Lookup_ID];
														if(permit_rec.count() > 0)
														{
															permit_rec.Permit_Status=input.New_Status;
															order_for_permit = Customer_Orders[ID == permit_rec.Customer_Order];
															if(order_for_permit.count() > 0)
															{
																order_for_permit.Permit_Status=input.New_Status;
															}
															install_for_permit = Installation_Schedules[Customer_Order == permit_rec.Customer_Order];
															if(install_for_permit.count() > 0)
															{
																if(input.New_Status == "Approved")
																{
																	install_for_permit.Permit_Clearance_Status="Approved";
																}
																else if(input.New_Status == "Not Required")
																{
																	install_for_permit.Permit_Clearance_Status="Not Required";
																}
																else if(input.New_Status == "Submitted")
																{
																	install_for_permit.Permit_Clearance_Status="Submitted";
																}
																else if(input.New_Status == "Rejected" || input.New_Status == "Expired")
																{
																	install_for_permit.Permit_Clearance_Status="Blocked";
																}
																else
																{
																	install_for_permit.Permit_Clearance_Status="Required";
																}
															}
														}
													}
													else if(input.Target_Module == "Service_Requests")
													{
														service_rec = Service_Requests[ID == input.Lookup_ID];
														if(service_rec.count() > 0)
														{
															service_rec.Service_Status=input.New_Status;
															if(input.New_Status == "Completed" || input.New_Status == "Closed" && service_rec.Completion_Date == null)
															{
																service_rec.Completion_Date=zoho.currentdate;
															}
															if(input.New_Status == "Completed" || input.New_Status == "Closed" && service_rec.Stock_Consumption_Posted == false)
															{
																for each  part_row in service_rec.Parts_Usage
																{
																	if(part_row.Material != null && ifnull(part_row.Quantity_Used,0) > 0 && part_row.Stock_Deducted == false)
																	{
																		service_mat = Material_Master[ID == part_row.Material];
																		if(service_mat.count() > 0)
																		{
																			service_mat.Available_Quantity=ifnull(service_mat.Available_Quantity,0) - ifnull(part_row.Quantity_Used,0);
																			service_mat.Last_Updated=zoho.currentdate;
																			part_row.Stock_Deducted=true;
																		}
																	}
																}
																service_rec.Stock_Consumption_Posted=true;
															}
														}
													}
													if(input.Return_URL != null && input.Return_URL != "")
													{
														openURL(input.Return_URL,"same window");
													}
									)
								}
							}
			
						
			}

			Action_Comments_On_Validate as "Action Comments On Validate"
			{
			
							type =  form
							form = Action_Comments
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Comments == null || input.Comments.trim().length() < 3)
													{
														alert "Enter meaningful comments before applying this status change.";
														cancel submit;
													}
													valid_status = false;
													target_exists = false;
													if(input.Target_Module == "Customer_Orders")
													{
														valid_status = input.New_Status in {"Green Light","On Hold","Cancelled"};
														order_rec = Customer_Orders[ID == input.Lookup_ID];
														target_exists = order_rec.count() > 0;
														if(target_exists && input.New_Status == "Green Light" && order_rec.Order_Status != "Awaiting Green Light" && order_rec.Order_Status != "On Hold")
														{
															alert "Green Light is valid only from Awaiting Green Light or On Hold.";
															cancel submit;
														}
													}
													else if(input.Target_Module == "Production_Records")
													{
														valid_status = input.New_Status in {"Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","On Hold","Cancelled"};
														prod_rec = Production_Records[ID == input.Lookup_ID];
														target_exists = prod_rec.count() > 0;
													}
													else if(input.Target_Module == "Purchase_Orders")
													{
														valid_status = input.New_Status in {"Submitted for Approval","Approved","Ordered","Partially Received","Received","Cancelled"};
														po_rec = Purchase_Orders[ID == input.Lookup_ID];
														target_exists = po_rec.count() > 0;
														if(target_exists && input.New_Status == "Ordered" || input.New_Status == "Partially Received" || input.New_Status == "Received" && po_rec.PO_Status != "Approved" && po_rec.Approved_Date == null)
														{
															alert "Purchase orders must be Approved before ordering or receiving.";
															cancel submit;
														}
													}
													else if(input.Target_Module == "Installation_Schedules")
													{
														valid_status = input.New_Status in {"Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"};
														inst_rec = Installation_Schedules[ID == input.Lookup_ID];
														target_exists = inst_rec.count() > 0;
													}
													else if(input.Target_Module == "Permit_Records")
													{
														valid_status = input.New_Status in {"Preparing","Submitted","Approved","Rejected","Expired","Not Required"};
														permit_rec = Permit_Records[ID == input.Lookup_ID];
														target_exists = permit_rec.count() > 0;
													}
													else if(input.Target_Module == "Service_Requests")
													{
														valid_status = input.New_Status in {"Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"};
														service_rec = Service_Requests[ID == input.Lookup_ID];
														target_exists = service_rec.count() > 0;
													}
													if(valid_status == false)
													{
														alert "Selected status is not valid for the target module.";
														cancel submit;
													}
													if(target_exists == false)
													{
														alert "Target record was not found for the selected module and ID.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Target_Module_On_User_Input as "Target Module On User Input"
			{
			
							type =  form
							form = Action_Comments
			
							record event = on add or edit
			
							on user input of Target_Module
							{
								actions 
								{
									custom deluge script
									(
														clear New_Status;
													if(input.Target_Module == "Customer_Orders")
													{
														input.New_Status:ui.add({"Green Light","On Hold","Cancelled"});
													}
													else if(input.Target_Module == "Production_Records")
													{
														input.New_Status:ui.add({"Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","On Hold","Cancelled"});
													}
													else if(input.Target_Module == "Purchase_Orders")
													{
														input.New_Status:ui.add({"Submitted for Approval","Approved","Ordered","Partially Received","Received","Cancelled"});
													}
													else if(input.Target_Module == "Installation_Schedules")
													{
														input.New_Status:ui.add({"Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"});
													}
													else if(input.Target_Module == "Permit_Records")
													{
														input.New_Status:ui.add({"Preparing","Submitted","Approved","Rejected","Expired","Not Required"});
													}
													else if(input.Target_Module == "Service_Requests")
													{
														input.New_Status:ui.add({"Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"});
													}
									)
								}
							}
			
						
			}

			Add_Update_User1 as "Add / Update User"
