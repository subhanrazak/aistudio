form Add_Approval_Setup
{

			displayname = "Add Approval Setup"
			success message = "Approval Setup Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Approval_Setup_For
			(
				type = picklist	
				displayname = "Approval Setup For"
				values  = Approval_Setup_For.ID
    			displayformat = [Approval_Setup_For]
				allow new entries
				[
					displayname = "Add New"
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Level_Name
			(
    			type = text
				displayname = "Level Name"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approver_Type
			(
				type = picklist
				displayname = "Approver Type"
				maxchar = 100
				values = {"Role","User"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approver_Role
			(
				type = picklist	
				displayname = "Approver Role"
				values  = Add_Role.ID
    			displayformat = [Role]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approver_Email
			(
    			type = email
				displayname = "Approver Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Sequence_Order
			(
				type = number
				displayname = "Sequence Order"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Previous_Sequence_Number
			(
				type = number
				displayname = "Previous Sequence Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Last_Step
			(
    			type = checkbox
				displayname = "Is Last Step"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive","Deleted"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = plaintext
				value = "Approval setup is available for future use and is not tied to the current manufacturing flow."
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}