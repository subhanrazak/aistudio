form Add_Preference
{

			displayname = "Add Preference"
			success message = "Preference Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Organization_Logo
			(
    			type = image
				displayname = "Organization Logo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email_Notification
			(
    			type = checkbox
				displayname = "Email Notification"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			App_Notification
			(
    			type = checkbox
				displayname = "App Notification"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		properties
		{
			total entries
			{
				allowed count = 7
			}
		}
		
}