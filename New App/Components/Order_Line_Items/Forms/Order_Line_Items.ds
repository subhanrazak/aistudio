form Order_Line_Items
{

			displayname = "Order Line Items"
			Line_Details
			(
				type = section
				displayname = "Line Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Customer_Order
			(
				type = picklist	
				displayname = "Customer Order"
				values  = Customer_Orders.ID
    			displayformat = [Order_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Line_Number
			(
				type = number
				displayname = "Line Number"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Product
			(
				type = picklist	
				values  = Product_Catalogue.ID
    			displayformat = [Product_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Product_Description
			(
    			type = textarea
				displayname = "Product Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Colour
			(
    			type = text
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = decimal
	 			row = 1
	 			column = 2   
				width = medium
			)
			Unit
			(
				type = picklist	
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size_Details
			(
				type = section
				displayname = "Size Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Width
			(
				type = decimal
	 			row = 2
	 			column = 1   
				width = medium
			)
			Height
			(
				type = decimal
	 			row = 2
	 			column = 2   
				width = medium
			)
			Manufacturing_Mode
			(
				type = picklist
				displayname = "Manufacturing Mode"
				maxchar = 100
				values = {"Manufacture","Purchase Finished Product"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Permit_Required
			(
    			type = checkbox
				displayname = "Permit Required"
				initial value = false
	 			row = 2
	 			column = 2   
				width = medium
			)
			Powder_Details
			(
				type = section
				displayname = "Powder Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Requires_Powder_Coating
			(
    			type = checkbox
				displayname = "Requires Powder Coating"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Powder
			(
				type = picklist	
				values  = Powder_Coating_Inventory.ID
    			displayformat = [Powder_Name]
	 			row = 3
	 			column = 2   
				width = medium
			)
			Estimated_Powder_Qty
			(
				type = decimal
				displayname = "Estimated Powder Qty"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Estimated_Install_Hours
			(
				type = decimal
				displayname = "Estimated Install Hours"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Invoice_Line_Amounts
			(
				type = section
				displayname = "Invoice Line Amounts"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Unit_Rate
			(
				type = decimal
				displayname = "Unit Rate"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Line_Discount
			(
				type = decimal
				displayname = "Line Discount"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Line_Tax
			(
				type = decimal
				displayname = "Line Tax"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Line_Total
			(
				type = decimal
				displayname = "Line Total"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Line_Notes
			(
    			type = textarea
				displayname = "Line Notes"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Queue_Details
			(
				type = section
				displayname = "Queue Details"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Production_Queue_No
			(
				type = number
				displayname = "Production Queue No"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Installation_Queue_No
			(
				type = number
				displayname = "Installation Queue No"
	 			row = 5
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}