Open_Set_Installation_Queue_Position as "Open Set Installation Queue Position"
{

				type =  functions
				form = Order_Line_Items
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						queue_no = ifnull(input.Installation_Queue_No,0);
										openUrl("#Form:Set_Queue_Position?Line_Item_ID=" + input.ID + "&Queue_Type=Installation&Queue_Number=" + queue_no + "&zc_LoadIn=dialog","same window");
					)
					}
				}
			
}