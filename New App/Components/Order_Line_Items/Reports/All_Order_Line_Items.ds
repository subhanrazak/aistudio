default list All_Order_Line_Items
{

			displayName = "All Order Line Items"
			show all rows from Order_Line_Items    
			(
				Customer_Order
				Line_Number
				Product
				Product_Description
				Colour
				Quantity
				Unit
				Manufacturing_Mode
				Requires_Powder_Coating
				Permit_Required
				Unit_Rate
				Line_Total
			)
			filters
			(
				Customer_Order
				Product
				Manufacturing_Mode
				Requires_Powder_Coating
				Permit_Required
			)
			sort by
			(
				Line_Number ascending
			)
		
}