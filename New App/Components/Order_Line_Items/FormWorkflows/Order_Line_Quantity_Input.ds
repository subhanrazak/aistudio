Order_Line_Quantity_Input as "Order Line Quantity Input"
{

				type =  form
				form = Order_Line_Items

				record event = on add or edit

				on user input of Quantity
				{
					actions 
					{
						custom deluge script
						(
											input.Line_Total = ifnull(input.Quantity,0) * ifnull(input.Unit_Rate,0) - ifnull(input.Line_Discount,0) + ifnull(input.Line_Tax,0);
						)
					}
				}

			
}