Customer_Order_Subtotal_Input as "Customer Order Subtotal Input"
{

				type =  form
				form = Customer_Orders

				record event = on add or edit

				on user input of Subtotal
				{
					actions 
					{
						custom deluge script
						(
											input.Total_Amount = ifnull(input.Subtotal,0) - ifnull(input.Discount_Total,0) + ifnull(input.Tax_Total,0) + ifnull(input.Shipping_or_Adjustment,0);
						)
					}
				}

			
}