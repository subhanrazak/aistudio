list Low_Material_Stock
{

			displayName = "Low Material Stock"
			show all rows from Material_Master  [Available_Quantity <= Reorder_Level && Active == true]  
			(
				Material_Code
				Material_Name
				Material_Category
				Stock_Unit
				Default_Vendor
				Available_Quantity
				Reorder_Level
				Active
			)
			filters
			(
				Material_Category
				Default_Vendor
				Active
			)
			sort by
			(
				Material_Name ascending
			)
		
}