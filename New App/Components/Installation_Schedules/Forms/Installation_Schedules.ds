form Installation_Schedules
{

			displayname = "Installation Schedules"
			Installation_Details
			(
				type = section
				displayname = "Installation Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Installation_Code
			(
    			type = autonumber
				displayname = "Installation Code"
				start index = 2101
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Customer_Order
			(
				type = picklist	
				displayname = "Customer Order"
				values  = Customer_Orders.ID
    			displayformat = [Order_Code]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer
			(
				type = picklist	
				values  = Customer_Master.ID
    			displayformat = [Customer_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Customer_Name_Snapshot
			(
    			type = text
				displayname = "Customer Name Snapshot"
				maxchar = 150
	 			row = 1
	 			column = 1   
				width = medium
			)
			Area_or_City
			(
    			type = text
				displayname = "Area or City"
				maxchar = 100
	 			row = 1
	 			column = 2   
				width = medium
			)
			Products_Summary
			(
    			type = textarea
				displayname = "Products Summary"
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Installation_Address_Section
			(
				type = section
				displayname = "Installation Address"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Installation_Address
			(
    			type = address
				displayname = "Installation Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
     			) 
	 			row = 2
	 			column = 1   
				width = medium
			)
			Scheduling_Readiness
			(
				type = section
				displayname = "Scheduling Readiness"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Forecast_Date
			(
    			type = date
				displayname = "Forecast Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Scheduled_Start
			(
    			type = datetime
				displayname = "Scheduled Start"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Scheduled_End
			(
    			type = datetime
				displayname = "Scheduled End"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Estimated_Hours
			(
				type = decimal
				displayname = "Estimated Hours"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Crew_Lead
			(
				type = picklist	
				displayname = "Crew Lead"
				values  = Add_Employee.ID
    			displayformat = [Employee_Name.first_name]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Installation_Status
			(
				type = picklist
				displayname = "Installation Status"
				maxchar = 100
				values = {"Forecast","Waiting for Production","Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","On Hold","Cancelled"}
				initial value = "Forecast"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Production_Readiness_Status
			(
				type = picklist
				displayname = "Production Readiness Status"
				maxchar = 100
				values = {"Not Ready","Partially Ready","Ready"}
				initial value = "Not Ready"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Permit_Clearance_Status
			(
				type = picklist
				displayname = "Permit Clearance Status"
				maxchar = 100
				values = {"Not Required","Required","Submitted","Approved","Blocked"}
				initial value = "Required"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Priority_Sequence
			(
				type = number
				displayname = "Priority Sequence"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Quality_Completion
			(
				type = section
				displayname = "Quality Completion"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Internal_QC_Required
			(
    			type = checkbox
				displayname = "Internal QC Required"
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Internal_QC_Status
			(
				type = picklist
				displayname = "Internal QC Status"
				maxchar = 100
				values = {"Not Required","Pending","Passed","Failed"}
				initial value = "Not Required"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Internal_QC_Date
			(
    			type = date
				displayname = "Internal QC Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Field_Notes
			(
    			type = textarea
				displayname = "Field Notes"
				height = 120px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Completion_Photos
			(
    			type = upload file
				displayname = "Completion Photos"
    			file count = 10
				browse = local_drive
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}