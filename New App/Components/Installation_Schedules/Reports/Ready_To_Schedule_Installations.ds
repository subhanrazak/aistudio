list Ready_To_Schedule_Installations
{

			displayName = "Ready To Schedule Installations"
			show all rows from Installation_Schedules  [Installation_Status == "Ready to Schedule"]  
			(
				Installation_Code
				Customer_Order
				Customer
				Area_or_City
				Forecast_Date
				Scheduled_Start
				Scheduled_End
				Estimated_Hours
				Crew_Lead
				Installation_Status
				Production_Readiness_Status
				Permit_Clearance_Status
				Internal_QC_Status
				Priority_Sequence
			)
			filters
			(
				Area_or_City
				Crew_Lead
				Installation_Status
				Production_Readiness_Status
				Permit_Clearance_Status
			)
			sort by
			(
				Priority_Sequence ascending
			)
		
}