default list All_Production_Material_Usage
{

			displayName = "All Production Material Usage"
			show all rows from Production_Material_Usage    
			(
				Production_Record
				Material
				Estimated_Quantity
				Actual_Quantity
				Unit
				Stock_Deducted
			)
			filters
			(
				Production_Record
				Material
				Stock_Deducted
			)
		
}