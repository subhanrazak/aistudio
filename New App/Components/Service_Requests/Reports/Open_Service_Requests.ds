list Open_Service_Requests
{

			displayName = "Open Service Requests"
			show all rows from Service_Requests  [Service_Status != "Closed" && Service_Status != "Cancelled"]  
			(
				Service_Code
				Customer
				Customer_Name
				Phone
				Priority
				Service_Status
				Request_Date
				Scheduled_Start
				Scheduled_End
				Technician
				Completion_Date
			)
			filters
			(
				Priority
				Service_Status
				Technician
			)
			sort by
			(
				Request_Date descending
			)
		
}