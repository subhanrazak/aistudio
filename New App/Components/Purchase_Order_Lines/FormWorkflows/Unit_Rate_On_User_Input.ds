Unit_Rate_On_User_Input as "Unit Rate On User Input"
{

				type =  form
				form = Purchase_Order_Lines

				record event = on add or edit

				on user input of Unit_Rate
				{
					actions 
					{
						custom deluge script
						(
											input.Line_Total = ifnull(input.Quantity,0) * ifnull(input.Unit_Rate,0) - ifnull(input.Line_Discount,0) + ifnull(input.Line_Tax,0);
						)
					}
				}

			
}