Production_Manufacturing_Mode_Input as "Production Manufacturing Mode Input"
{

				type =  form
				form = Production_Records

				record event = on add or edit

				on user input of Manufacturing_Mode
				{
					actions 
					{
						custom deluge script
						(
											if(input.Manufacturing_Mode == "Purchase Finished Product")
										{
											show Linked_PO;
											hide Manufacturing_Group;
											hide Material_Status;
											hide Materials_Usage;
											hide Requires_Powder_Coating;
											hide Powder;
											hide Powder_Qty_Used;
											hide Powder_Coating_Status;
										}
										else
										{
											hide Linked_PO;
											show Manufacturing_Group;
											show Material_Status;
											show Materials_Usage;
											show Requires_Powder_Coating;
											if(input.Requires_Powder_Coating == true)
											{
												show Powder;
												show Powder_Qty_Used;
												show Powder_Coating_Status;
											}
											else
											{
												hide Powder;
												hide Powder_Qty_Used;
												hide Powder_Coating_Status;
												clear Powder;
											}
										}
						)
					}
				}

			
}