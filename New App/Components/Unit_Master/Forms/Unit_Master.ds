form Unit_Master
{

			displayname = "Unit Master"
			Unit_Details
			(
				type = section
				displayname = "Unit Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Unit_Code
			(
    			type = autonumber
				displayname = "Unit Code"
				start index = 1001
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Unit_Name
			(
    			type = text
				displayname = "Unit Name"
				maxchar = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Abbreviation
			(
    			type = text
				maxchar = 20
	 			row = 1
	 			column = 2   
				width = medium
			)
			Unit_Type
			(
				type = picklist
				displayname = "Unit Type"
				maxchar = 100
				values = {"Count","Length","Area","Weight","Volume","Time","Other"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}