default list All_Customers
{

			displayName = "All Customers"
			show all rows from Customer_Master    
			(
				Customer_Code
				Customer_Name
				Contact_Person
				Phone
				Email
				Area_or_City
				GST_or_Tax_Number
				Active
			)
			filters
			(
				Area_or_City
				Active
			)
			sort by
			(
				Customer_Name ascending
			)
		
}