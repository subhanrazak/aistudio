form Set_Queue_Position
{

			displayname = "Set Queue Position"
			store data in zc = false
			Queue_Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Line_Item_ID
			(
				type = number
				displayname = "Line Item ID"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Queue_Type
			(
				type = picklist
				displayname = "Queue Type"
				maxchar = 100
				values = {"Production","Installation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Queue_Number
			(
				type = number
				displayname = "Queue Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Helper_Text
			(
    			type = plaintext
				value = "Enter the exact queue number for this order line."
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit_Queue
				(
   					type = button
   					displayname = "Update Queue"
				)
				Reset
				(
   					type = reset
   					displayname = "Reset"
				)
			}
		
}