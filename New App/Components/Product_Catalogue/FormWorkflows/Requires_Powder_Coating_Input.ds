Requires_Powder_Coating_Input as "Requires Powder Coating Input"
{

				type =  form
				form = Product_Catalogue

				record event = on add or edit

				on user input of Requires_Powder_Coating
				{
					actions 
					{
						custom deluge script
						(
											if(input.Requires_Powder_Coating == true)
										{
											show Default_Powder;
										}
										else
										{
											hide Default_Powder;
											clear Default_Powder;
										}
						)
					}
				}

			
}