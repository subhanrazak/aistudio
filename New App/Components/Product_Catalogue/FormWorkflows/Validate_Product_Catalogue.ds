Validate_Product_Catalogue as "Validate Product Catalogue"
{

				type =  form
				form = Product_Catalogue

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Requires_Powder_Coating == true && input.Default_Powder == null)
										{
											alert "Default powder is required when powder coating is required.";
											cancel submit;
										}
										if(ifnull(input.Default_Install_Hours,0) < 0)
										{
											alert "Default install hours cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			
}