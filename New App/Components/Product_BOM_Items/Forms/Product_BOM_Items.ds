form Product_BOM_Items
{

			displayname = "Product BOM Items"
			BOM_Details
			(
				type = section
				displayname = "BOM Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			BOM_Code
			(
    			type = autonumber
				displayname = "BOM Code"
				start index = 1601
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product
			(
				type = picklist	
				values  = Product_Catalogue.ID
    			displayformat = [Product_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Material
			(
				type = picklist	
				values  = Material_Master.ID
    			displayformat = [Material_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Quantity_Per_Unit
			(
				type = decimal
				displayname = "Quantity Per Unit"
				decimalplace = 3
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit
			(
				type = picklist	
				values  = Unit_Master.ID
    			displayformat = [Unit_Name]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Wastage_Percent
			(
				type = decimal
				displayname = "Wastage Percent"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Active
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 120px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}