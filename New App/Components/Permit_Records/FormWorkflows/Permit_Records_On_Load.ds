Permit_Records_On_Load as "Permit Records On Load"
{

				type =  form
				form = Permit_Records

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Permit_Status == "Submitted" || input.Permit_Status == "Approved" || input.Permit_Status == "Rejected" || input.Permit_Status == "Expired")
										{
											show Submitted_Date;
										}
										else
										{
											hide Submitted_Date;
										}
										if(input.Permit_Status == "Approved" || input.Permit_Status == "Expired")
										{
											show Approved_Date;
											show Expiry_Date;
										}
										else
										{
											hide Approved_Date;
											hide Expiry_Date;
										}
						)
					}
				}

			
}