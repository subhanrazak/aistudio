calendar Permit_Expiry_Calendar
{

			displayName = "Permit Expiry Calendar"
			show all rows from Permit_Records  [Expiry_Date is not null]  
			(
				Permit_Code
				Customer_Order
				Customer
				Permit_Status
				Authority_Name
				Expiry_Date
			)
			filters
			(
				Permit_Status
				Authority_Name
			)
			options
			(
				week start day = monday
				display field = Permit_Code
				start date = Expiry_Date
			)
		
}