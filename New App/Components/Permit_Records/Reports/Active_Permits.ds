list Active_Permits
{

			displayName = "Active Permits"
			show all rows from Permit_Records  [Permit_Status != "Approved" && Permit_Status != "Not Required" && Permit_Status != "Expired"]  
			(
				Permit_Code
				Customer_Order
				Customer
				Permit_Required
				Permit_Status
				Authority_Name
				Permit_Number
				Submitted_Date
				Approved_Date
				Expiry_Date
			)
			filters
			(
				Permit_Status
				Authority_Name
			)
			sort by
			(
				Submitted_Date descending
			)
		
}