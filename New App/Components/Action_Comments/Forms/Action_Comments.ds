form Action_Comments
{

			displayname = "Add Comments"
			Action_Details
			(
				type = section
				displayname = "Action Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			Action_Code
			(
    			type = autonumber
				displayname = "Action Code"
				start index = 2401
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Target_Module
			(
				type = picklist
				displayname = "Target Module"
				maxchar = 100
				values = {"Customer_Orders","Production_Records","Purchase_Orders","Installation_Schedules","Permit_Records","Service_Requests"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Lookup_ID
			(
				type = number
				displayname = "Lookup ID"
				maxchar = 19
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have New_Status
			(
				type = picklist
				displayname = "New Status"
				maxchar = 100
				values = {"Green Light","On Hold","Cancelled","Queued","Material Shortage","Material Ordered","Material Received","Manufacturing","Powder Coating","Ready for Installation","Final Product Purchase","Purchased and Received","Submitted for Approval","Approved","Ordered","Partially Received","Received","Ready to Schedule","Scheduled","In Progress","Installed","Inspection Required","Inspection Completed","Completed","Preparing","Submitted","Rejected","Expired","Not Required","Triage","Parts Required","Repaired","Closed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Comments
			(
    			type = textarea
				height = 160px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Navigation_Audit
			(
				type = section
				displayname = "Navigation Audit"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Return_Page
			(
    			type = text
				displayname = "Return Page"
				maxchar = 100
	 			row = 2
	 			column = 1   
				width = medium
			)
			Return_URL
			(
    			type = text
				displayname = "Return URL"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Submitted_By
			(
    			type = email
				displayname = "Submitted By"
				initial value = "${zoho.loginuserid}"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Action_Date
			(
    			type = datetime
				displayname = "Action Date"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
					Reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					Update
					(
   						type = submit
   						displayname = "Update"
					)
					Cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}