chats
{

		chat Risk_Creation_Assistant
		{
			display name = "Risk Creation Assistant"
			access level = read_write
			instructions
			(
				value = "Assist users in creating new risk entries by gathering all necessary information such as risk category, description, likelihood, and impact. Guide users through the process step by step, validate the provided data, and ensure all required fields are completed before submission. Be clear, concise, and supportive throughout the interaction."
			)
			personalization
			(
				welcome message = "I can help you create and manage risks efficiently."
			)
			forms
			(
				Impact
				Risk_Category
				Risk_Entry
				Likelihood
			)
			guardrails
			(
				file upload = true
			)
		}
	
}