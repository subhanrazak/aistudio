Commitee_Type_Filter as "Commitee Type Filter"
{

				type =  form
				form = Filter_Form

				record event = on add

				on user input of Committee_Type
				{
					actions 
					{
						custom deluge script
						(
											if(input.Page == "Board_Page" && input.Tab == "committee")
										{
											parm_map = Map();
											parm_map.put("Committee_Type",ifnull(input.Committee_Type,""));
											parm_map.put("Search_Key",ifnull(input.Search_Key,""));
											returnURL = thisapp.Page_Filter.Committee_Page(parm_map);
											openUrl(returnURL,"same window");
										}
						)
					}
				}

			
}