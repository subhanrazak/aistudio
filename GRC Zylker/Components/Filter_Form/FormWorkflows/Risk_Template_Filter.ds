Risk_Template_Filter as "Risk Template Filter"
{

				type =  form
				form = Filter_Form

				record event = on add

				on user input of Risk_Template
				{
					actions 
					{
						custom deluge script
						(
											if(input.Page == "Risk_Assessment_Page" && input.Action_field == "overView")
										{
											parm_map = {"Risk_Template":input.Risk_Template,"Period":input.Period,"Search_Key":input.Search_Key,"Status":input.Status};
											returnURL = thisapp.Page_Filter.Risk_Assessment_Page(parm_map);
										}
										openUrl(returnURL,"same window");
						)
					}
				}

			
}