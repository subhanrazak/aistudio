field_workflow as "field workflow"
{

				type =  form
				form = Filter_Form

				record event = on add

				field rules
				{
					actions  (Clear == true)
					{
						hide Clear;
					}
					actions 
					{
						hide Action_field,Department,Page,rec_ID,Report,Role,Status,Search_Key,Tab,Type_field,Text,Strategic_Category,Risk_Level,Period,Risk_Template,Meeting_Status,Skill,Resource_Type,Meeting_Type,Action_Priority,Action_Status,Committee1,Committee_Type,Meeting_Priority,Quorum_Status,User_Status,Agenda_Status,Meeting_For,Meeting_Series;
					}
				}

			
}