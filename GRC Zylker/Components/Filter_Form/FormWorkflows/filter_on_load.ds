filter_on_load as "filter on load"
{

				type =  form
				form = Filter_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										input.Text = language.get("grc.filiterby.text");
										if(input.Search_Key != "")
										{
											input.Clear = false;
											show Clear;
										}
										if(input.Page == "Objective_Page")
										{
											if(input.Action_field == "overView")
											{
												typeList = {"Strategic","Operational","Financial","Compliance"};
												input.Type_field:ui.add(typeList);
												show Department;
												show Type_field;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Strategy_Page")
										{
											if(input.Action_field == "overView")
											{
												show Department;
												show Strategic_Category;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "User_Management")
										{
											if(input.Action_field == "overView")
											{
												statusList = {"Active","Inactive"};
												input.Status:ui.add(statusList);
												show Department;
												show Role;
												show Status;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Process_Page")
										{
											if(input.Action_field == "overView")
											{
												show Department;
												show Search_Key;
												show Text;
												show Risk_Level;
											}
										}
										else if(input.Page == "Controls_Page")
										{
											if(input.Action_field == "overView")
											{
												typeList = {"Preventive","Detective","Corrective","Manual","Automated","Hybrid"};
												input.Type_field:ui.add(typeList);
												statusList = {"Active","Inactive","Under Review"};
												input.Status:ui.add(statusList);
												show Department;
												show Search_Key;
												show Text;
												show Type_field;
												show Status;
											}
										}
										else if(input.Page == "Risk_Assessment_Page")
										{
											if(input.Action_field == "overView")
											{
												getPeriod = Risk_Assessment[ID != 0].distinct(Assessment_Period);
												input.Period:ui.add(getPeriod);
												show Period;
												show Search_Key;
												show Text;
												show Risk_Template;
											}
											else if(input.Action_field == "process")
											{
												show Search_Key;
												show Text;
												show Department;
												show Risk_Level;
											}
											else if(input.Action_field == "riskView")
											{
												statusList = {"Pending","Approved","Rejected"};
												input.Status:ui.add(statusList);
												show Search_Key;
												show Text;
												show Department;
												show Status;
											}
										}
										else if(input.Page == "Risk_Entries_Page")
										{
											if(input.Action_field == "overView")
											{
												riskLevel = {"Low","Medium","High","Critical"};
												input.Risk_Level:ui.add(riskLevel);
												show Search_Key;
												show Text;
												show Risk_Level;
											}
										}
										else if(input.Page == "Resources_Page")
										{
											if(input.Action_field == "overView")
											{
												show Department;
												show Skill;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Software_License_Resources")
										{
											if(input.Action_field == "overView")
											{
												typeList = {"Subscription","Named User","Concurrent User","Device License","Perpetual","Volume License"};
												input.Type_field:ui.add(typeList);
												statusList = {"Active","Pending Activation","Expiring Soon","Expired","Under Maintenance"};
												input.Status:ui.add(statusList);
												show Status;
												show Type_field;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Incident_Management_Page")
										{
											if(input.Action_field == "overView")
											{
												severityList = {"Critical","Major","Minor"};
												input.Risk_Level:ui.add(severityList);
												categoryList = {"Operational","Compliance","IT Security","Fraud","Safety","Financial"};
												input.Type_field:ui.add(categoryList);
												show Department;
												show Type_field;
												show Risk_Level;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Assessment_Plan_Page")
										{
											if(input.Action_field == "overView")
											{
												statusList = {"Not Started","In Progress","Completed","Overdue"};
												input.Status:ui.add(statusList);
												typeList = {"Annual Plan","Quarterly Plan","Monthly Plan","Multi-year Plan","Custom Period"};
												input.Type_field:ui.add(typeList);
												show Status;
												show Type_field;
												show Search_Key;
												show Text;
											}
										}
										else if(input.Page == "Meeting_Page")
										{
											show Search_Key;
											show Meeting_Status;
											show Text;
											show Meeting_Priority;
											show Meeting_Series;
											show Meeting_For;
										}
										else if(input.Page == "Agenda_Page")
										{
											show Search_Key;
											show Text;
											show Agenda_Status;
										}
										else if(input.Page == "Board_Page")
										{
											if(input.Tab == "committee")
											{
												show Search_Key;
												show Text;
												show Committee_Type;
											}
											else if(input.Tab = "member")
											{
												show Search_Key;
												show Text;
												show User_Status;
											}
										}
										else if(input.Page == "Quorum_Rule_Page")
										{
											show Search_Key;
											show Text;
											show Quorum_Status;
										}
										else if(input.Page == "Operational_Page")
										{
											show Search_Key;
											show Text;
											show Action_Priority;
											show Action_Status;
										}
										else if(input.Page == "Regulatory_Inventory")
										{
											show Search_Key;
											show Text;
											show Action_Priority;
											show Action_Status;
										}
						)
					}
				}

			
}