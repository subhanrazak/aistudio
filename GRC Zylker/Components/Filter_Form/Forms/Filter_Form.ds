form Filter_Form
{

			displayname = "Filter Form"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Clear
			(
    			type = checkbox
				initial value = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Search_Key
			(
    			type = text
				displayname = "Search"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Page
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Report
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tab
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			rec_ID
			(
				type = number
				displayname = "rec ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Text
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Planning","Active","On Hold","Completed","Not Started","In Progress"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Type_field
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Strategic","Operational","Financial","Compliance"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Strategic_Category
			(
				type = picklist	
				displayname = "Category"
				values  = Strategic_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Risk_Level
			(
				type = picklist
				displayname = "Risk Level"
				maxchar = 100
				values = {"Low","Medium","High","Very High"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Risk_Template
			(
				type = picklist
				displayname = "Risk Template"
				maxchar = 100
				values = {"ISO 31000 Framework","COSO ERM Framework","Custom Template","Industry-Specific"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Period
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Skill
			(
				type = picklist	
				values  = Skill.ID
    			displayformat = [Skill_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Resource_Type
			(
				type = picklist
				displayname = "Resource Type"
				maxchar = 100
				values = {"Internal Resource","External Resource"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Meeting_Type
			(
				type = picklist
				displayname = "Meeting Type"
				maxchar = 100
				values = {"Regular","Special / Extraordinary","Emergency","Recurring"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Committee_Type
			(
				type = picklist	
				displayname = "Committee Type"
				values  = Committee_Type.ID
    			displayformat = [Committee_Type]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			User_Status
			(
				type = picklist
				displayname = "User Status"
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Quorum_Status
			(
				type = picklist
				displayname = "Quorum Status"
				maxchar = 100
				values = {"Met","Not Met"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Committee1
			(
				type = picklist	
				displayname = "Committee"
				values  = Committee.ID
    			displayformat = [Committee_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Action_Priority
			(
				type = picklist
				displayname = "Action Priority"
				maxchar = 100
				values = {"Low","High","Medium"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Action_Status
			(
				type = picklist
				displayname = "Action Status"
				maxchar = 100
				values = {"Completed","Ongoing","Yet to start"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Agenda_Status
			(
				type = picklist
				displayname = "Agenda Status"
				maxchar = 100
				values = {"Save as draft","Send for review","Publish now"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Meeting_Series
			(
				type = picklist
				displayname = "Meeting Series"
				maxchar = 100
				values = {"One time meeting","Recurring meeting"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Meeting_For
			(
				type = picklist
				displayname = "Meeting For"
				maxchar = 100
				values = {"Board","Commitee"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Meeting_Priority
			(
				type = picklist
				displayname = "Meeting Priority"
				maxchar = 100
				values = {"High","Low","Medium"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
			Meeting_Status
			(
				type = picklist
				displayname = "Meeting Status"
				maxchar = 100
				values = {"Sheduled","Draft","Ongoing","Pending","Cancelled","Completed"}
	 			row = 1
	 			column = 2   
				width = 200px
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}