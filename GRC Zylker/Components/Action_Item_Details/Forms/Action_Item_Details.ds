form Action_Item_Details
{

			displayname = "Action Item Details"
			success message = "Action Item Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Action_Items
			(
    			type = text
				displayname = "Action Items"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Ongoing","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Tracker
			(
				type = picklist	
				displayname = "Action Tracker"
				values  = Action_Tracker.ID
    			bidirectional = Action_Items
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}