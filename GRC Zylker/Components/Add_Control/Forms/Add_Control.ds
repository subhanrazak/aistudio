form Add_Control
{

			displayname = "Add Control"
			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk
			(
				type = list	
				displayname = "Risk "
				values  = Risk_Entry.ID
    			displayformat = [Risk_ID + " - " + Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Control
			(
				type = list	
				displayname = "Controls"
				values  = Control[Approval_Status == "Approved"].ID
    			displayformat = [Control_ID_Code + " - " + Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Add
				(
   					type = submit
   					displayname = "Add"
				)
			}
		
}