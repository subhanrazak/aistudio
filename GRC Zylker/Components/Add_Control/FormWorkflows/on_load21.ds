on_load21 as "on load"
{

				type =  form
				form = Add_Control

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											clear Control;
										if(input.Risk.size() > 0)
										{
											hide Risk;
											controlList = Control[Approval_Status == "Approved"].ID.getAll();
											currentControl = Risk_Entry[ID == input.Risk].Link_Controls;
											controlList.removeAll(currentControl);
											input.Control:ui.add(controlList);
										}
										else
										{
											//getRisk = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment && Scope_Type == "Risk" && Approval_Status == "Approved"].Risks.getAll();
											getRisk = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment && Scope_Type == "Risk"].Risks.getAll();
											input.Risk:ui.add(getRisk);
										}
						)
					}
				}

			
}