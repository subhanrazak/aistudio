get_Controls as "get Controls"
{

				type =  form
				form = Add_Control

				record event = on add

				on user input of Risk
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk != null)
										{
											controlList = Control[Approval_Status == "Approved"].ID.getAll();
											currentControl = Risk_Entry[ID == input.Risk].Link_Controls;
											controlList.removeAll(currentControl);
											input.Control:ui.add(controlList);
										}
										else
										{
											clear Control;
										}
						)
					}
				}

			
}