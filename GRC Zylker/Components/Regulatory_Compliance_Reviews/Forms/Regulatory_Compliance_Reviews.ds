form Regulatory_Compliance_Reviews
{

			displayname = "Regulatory Compliance Reviews"
			success message = "Regulatory Compliance Review Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			bidirectional = Regulatory_Compliance_Reviews
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Regulation
			(
				type = picklist	
				values  = Regulation.ID
    			displayformat = [Regulation_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department1
			(
				type = picklist	
				displayname = "Department"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Frequency
			(
				type = picklist
				maxchar = 100
				values = {"Annual","Quarterly","Monthly"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Due
			(
    			type = date
				displayname = "Next Due"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Planned","Optional"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}