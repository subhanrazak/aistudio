on_success52 as "on success"
{

				type =  form
				form = Regulatory_Compliance_Reviews

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Compliance_Reviews",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Assessment_Plan.Plan_Name + " - " + input.Regulation.Regulation_Name);
						)
					}
				}

			
}