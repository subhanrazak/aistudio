on_delete37 as "on delete"
{

				type =  form
				form = Regulatory_Compliance_Reviews

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											plan_name = Assessment_Plan[ID == input.Assessment_Plan].Plan_Name;
										regulation_name = Regulation[ID == input.Regulation].Regulation_Name;
										thisapp.Log.Audit_Log("Regulatory_Compliance_Reviews",input.ID,"Update",User[Email == zoho.loginuserid].ID,plan_name + " - " + regulation_name);
						)
					}
				}

			
}