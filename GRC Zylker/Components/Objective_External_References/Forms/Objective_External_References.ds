form Objective_External_References
{

			displayname = "Objective External References"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Objective
			(
				type = picklist	
				values  = Objective.ID
    			bidirectional = External_References
    			displayformat = [Objective_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Link
			(
    			type = url
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}