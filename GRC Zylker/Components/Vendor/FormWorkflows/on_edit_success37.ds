on_edit_success37 as "on edit success"
{

				type =  form
				form = Vendor

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Vendor",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Vendor_Name);
						)
					}
				}

			
}