on_delete52 as "on delete"
{

				type =  form
				form = Vendor

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Vendor",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Vendor_Name);
						)
					}
				}

			
}