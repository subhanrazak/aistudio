on_delete39 as "on delete"
{

				type =  form
				form = Regulatory_Report

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Report",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Report_Name);
						)
					}
				}

			
}