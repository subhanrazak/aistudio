on_edit_success27 as "on edit success"
{

				type =  form
				form = Regulatory_Report

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Report",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Report_Name);
						)
					}
				}

			
}