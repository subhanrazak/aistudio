Url_Update as "Url Update"
{

				type =  form
				form = Vote

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.ID != null)
										{
											openUrl("#Page:Action_Page?meeting_id=" + input.Meeting + "&Agenda_Item=" + input.Agenda_Item + "&mode=resolution&zc_LoadIn=dialog","same window");
										}
						)
					}
				}

			
}