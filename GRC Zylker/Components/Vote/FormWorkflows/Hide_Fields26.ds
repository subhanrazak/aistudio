Hide_Fields26 as "Hide Fields"
{

				type =  form
				form = Vote

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											user = User[Email == zoho.loginuserid];
										input.Voter = user.ID;
										hide Hidden;
						)
					}
				}

			
}