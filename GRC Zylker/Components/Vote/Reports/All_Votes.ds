default list All_Votes
{

			displayName = "All Votes"
			show all rows from Vote    
			(
				Your_Vote as "Your Vote"
				Comments
				I_confirm_this_vote_is_final as "I confirm this vote is final"
				Agenda_Item as "Agenda Item"
				Meeting as "Meetings"
				Vote_Status as "Vote Status"
				Voter
				Resolution
			)
		
}