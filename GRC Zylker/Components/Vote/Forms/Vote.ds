form Vote
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Your_Vote
			(
				type = radiobuttons
				displayname = "Your Vote"
				maxchar = 100
				values = {"Approve","Reject"}
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			I_confirm_this_vote_is_final
			(
    			type = checkbox
				displayname = "I confirm this vote is final"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Voter
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Vote_Status
			(
				type = picklist
				displayname = "Vote Status"
				maxchar = 100
				values = {"Pass","Fail"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Resolution
			(
				type = picklist	
				values  = Add_Resolution.ID
    			bidirectional = Vote
    			displayformat = [Resolution]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Agenda_Item
			(
				type = picklist	
				displayname = "Agenda Item"
				values  = Agenda_Item.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Meeting
			(
				type = picklist	
				displayname = "Meetings"
				values  = Meeting.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}