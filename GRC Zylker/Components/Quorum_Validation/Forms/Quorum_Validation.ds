form Quorum_Validation
{

			displayname = "Quorum Validation"
			success message = "Quorum Validation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Valid","Invalid"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quorum_Rule
			(
				type = picklist	
				displayname = "Quorum Rules"
				values  = Quorum_Rule.ID
    			bidirectional = Validation
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meetings
			(
				type = picklist	
				values  = Meeting.ID
    			displayformat = [Meeting_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}