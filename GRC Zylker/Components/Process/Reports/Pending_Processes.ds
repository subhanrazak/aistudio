list Pending_Processes
{

			displayName = "Pending Processes"
			show all rows from Process  [Approval_Status == "Pending"]  
			(
				Process_ID as "Process ID"
				Process_Name as "Name"
				Process_Description as "Description"
				Process_Owner as "Owner"
				Linked_Departments as "Link Departments"
				Linked_Strategies as "Link Strategies"
				Process_Type as "Type"
				Process_Weightage as "Process Weightage "
				Frequency
				Complexity_Level as "Complexity Level"
				Associate_Risks as "Link Risks"
				Associate_Controls as "Link Controls"
				Process_Details as "Process Details"
				Weightage_Display as "Weightage"
				Objectives
				Strategies
				Risks_Display as "Risks"
				Controls_Display as "Controls"
				Risk_Level_Display as "Risk Level "
				S_No as "S.No"
				Approval_Status as "Approval Status"
				Comments
				Approved_By as "Approved By"
				custom action "Approve"
				(
	  			workflow = Approve3
				show action in edit record menu = true
				column header = "Approve"
				condition = (Approval_Status == "Pending")
				)
				custom action "Reject"
				(
	  			workflow = Reject3
				show action in edit record menu = true
				column header = "Reject"
				condition = (Approval_Status == "Pending")
				)
			)
			custom actions
			(
				"detailView"
				(
	  			workflow = detailView2
				)
				"Approve "
				(
	  			workflow = Approval1
				show action in view header = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
				"Reject "
				(
	  			workflow = Reject4
				show action in view header = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
			)
		
}