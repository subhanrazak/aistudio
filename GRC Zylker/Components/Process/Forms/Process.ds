form Process
{

			displayname = "Processes"
			success message = ""
			Basic_Process_Details
			(
				type = section
				displayname = "Basic Process Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Process_Name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process_ID
			(
    			type = text
				displayname = "Process ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process_Owner
			(
				type = picklist	
				displayname = "Owner"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Process_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Core Business Process","Support Process","Management Process","Regulatory Process"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Process_Description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Organizational_Links
			(
				type = section
				displayname = "Organizational Links"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Linked_Departments
			(
				type = list	
				displayname = "Link Departments"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Strategies
			(
				type = list	
				displayname = "Link Strategies"
				values  = Strategy.ID
    			displayformat = [Strategy_Title]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Objectives
			(
				type = list	
				displayname = "Link Objectives"
				values  = Objective.ID
    			bidirectional = Linked_Processes
    			displayformat = [Objective_Title]
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Process_Criticality
			(
				type = section
				displayname = "Process Criticality"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Process_Weightage
			(
				type = decimal
				displayname = "Process Weightage "
	 			row = 3
	 			column = 1   
				width = medium
			)
			Frequency
			(
				type = radiobuttons
				maxchar = 100
				values = {"Daily","Weekly","Monthly","Quarterly","Annually","Ad-hoc"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Process_Weightage1
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Complexity_Level
			(
				type = radiobuttons
				displayname = "Complexity Level"
				maxchar = 100
				values = {"Low","Medium","High","Very High"}
	 			row = 3
	 			column = 2   
				width = medium
			)
			Risk_Control_Association
			(
				type = section
				displayname = "Risk & Control Association"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Associate_Risks
			(
				type = list	
				displayname = "Link Risks"
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			bidirectional = Process
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Associate_Controls
			(
				type = list	
				displayname = "Link Controls"
				values  = Control[Approval_Status == "Approved"].ID
    			bidirectional = Associated_Process_Activity
    			displayformat = [Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Process_Details
			(
    			type = richtext
				displayname = "Process Details"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Weightage_Display
			(
    			type = richtext
				displayname = "Weightage"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Objectives
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Strategies
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Risks_Display
			(
    			type = richtext
				displayname = "Risks"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Controls_Display
			(
    			type = richtext
				displayname = "Controls"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Risk_Level_Display
			(
    			type = richtext
				displayname = "Risk Level "
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending","Approved","Rejected"}
				initial value = "Pending"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approved_By
			(
				type = picklist	
				displayname = "Approved By"
				values  = User.ID
    			displayformat = [" " + Employee_ID + "- " + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Last_Review_Date
			(
    			type = date
				displayname = "Last Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Next_Review_Date
			(
    			type = date
				displayname = "Next Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Process Information","Risk Control Association"}
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}