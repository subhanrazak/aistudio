on_load3 as "on load"
{

				type =  form
				form = Process

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											radio_button_style = ".flLeft[type=\"radio\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[type=\"radio\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }";
										process_type_style = ".flLeft[name=\"parentOf-Process_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { background: #F5F4F9;border: 1px solid #F5F4F9; }.flLeft[name=\"parentOf-Process_Type\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }";
										frequency_style = ".flLeft[name=\"parentOf-Frequency\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { background: #F5F4F9; border: 1px solid #F5F4F9;}.flLeft[name=\"parentOf-Frequency\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }";
										complexity_field_style = ".flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #DEFFEA; border: 1px solid #DEFFEA; } .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #FDF8DA;  border: 1px solid #FDF8DA;} .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #FFEED9; border: 1px solid #FFEED9;} .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text { background: #FFE3E3; border: 1px solid #FFE3E3; } .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #16a34a; } .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #fee685; } .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #fc8f01; } .flLeft[name=\"parentOf-Complexity_Level\"] .choice-table-row:nth-child(4) .choice-table-cell span input:checked ~ label  { border: 1px solid #fb2c36; }";
										input.style_txt = "<style>" + radio_button_style + process_type_style + frequency_style + complexity_field_style + "</style>";
										if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Process Information")
											{
												show Basic_Process_Details;
												show Organizational_Links;
												show Process_Criticality;
											}
											else if(input.Action_Field == "Risk Control Association")
											{
												show Risk_Control_Association;
											}
										}
						)
					}
				}

			
}