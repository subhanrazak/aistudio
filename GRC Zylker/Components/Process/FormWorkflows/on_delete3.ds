on_delete3 as "on delete"
{

				type =  form
				form = Process

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Process",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Process_ID + " - " + input.Process_Name);
						)
					}
				}

			
}