Progress_Bar as "Progress Bar"
{

				type =  form
				form = Process

				record event = on add or edit

				on user input of Process_Weightage
				{
					actions 
					{
						custom deluge script
						(
											if(input.Process_Weightage > 100)
										{
											input.Process_Weightage = 100;
										}
										if(input.Process_Weightage != null)
										{
											input.Process_Weightage1 = "<style>.zcs-progress-bar { height: 8px; background-color: #E2E7EF; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: #ef1617;</style><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6' style='width:100px;'><p class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-font-14 zcs-font-medium zcs-lh-body zcs-m-0'><span class='zcs-color-primary'>" + input.Process_Weightage + "%</span></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width: " + input.Process_Weightage + "%;'></div></div></div>";
										}
										else
										{
											input.Process_Weightage1 = "";
										}
						)
					}
				}

			
}