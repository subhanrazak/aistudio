get_Strategies as "get Strategies"
{

				type =  form
				form = Process

				record event = on add or edit

				on user input of Linked_Objectives
				{
					actions 
					{
						custom deluge script
						(
											if(input.Linked_Objectives.size() > 0)
										{
											currentStrategies = input.Linked_Strategies;
											strategyList = Strategy[Linked_Objectives == input.Linked_Objectives].ID.getAll();
											input.Linked_Strategies:ui.add(strategyList);
											input.Linked_Strategies = currentStrategies;
										}
										else
										{
											clear Linked_Strategies;
										}
						)
					}
				}

			
}