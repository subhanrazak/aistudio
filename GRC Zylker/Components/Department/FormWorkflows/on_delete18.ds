on_delete18 as "on delete"
{

				type =  form
				form = Department

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Department_Code + " - " + input.Department_Name);
						)
					}
				}

			
}