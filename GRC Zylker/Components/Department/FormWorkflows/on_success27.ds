on_success27 as "on success"
{

				type =  form
				form = Department

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Department_Code = thisapp.Get_ID("Department",input.ID);
										thisapp.Log.Audit_Log("Department",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Department_Code + " - " + input.Department_Name);
						)
					}
				}

			
}