on_edit_success13 as "on edit success"
{

				type =  form
				form = Department

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Department_Code + " - " + input.Department_Name);
						)
					}
				}

			
}