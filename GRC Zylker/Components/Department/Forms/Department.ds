form Department
{

			displayname = "Departments"
			success message = "Department Added Successfully"
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Department_Name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Corporate","Operations","Support","Specialized"}
				layout = 3
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parent_Entity
			(
				type = picklist	
				displayname = "Parent Entity"
				values  = Entity.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Code
			(
    			type = text
				displayname = "Department Code"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Parent_Department
			(
				type = picklist	
				displayname = "Parent Department"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Management_Contact
			(
				type = section
				displayname = "Management & Contact"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Department_Manager
			(
				type = picklist	
				displayname = "Manager"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Department_Details
			(
				type = section
				displayname = "Department Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Employee_Count
			(
				type = number
				displayname = "Employee Count"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Established_Date
			(
    			type = date
				displayname = "Established Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Department_Purpose
			(
    			type = textarea
				displayname = "Purpose"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Key_Functions
			(
    			type = textarea
				displayname = "Key Functions"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Budget_Annual
			(
				type = decimal
				displayname = "Budget (Annual)"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Cost_Center
			(
    			type = text
				displayname = "Cost Center"
	 			row = 3
	 			column = 2   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 3
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}