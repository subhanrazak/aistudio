form Alert
{

			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Ok
				(
   					type = submit
   					displayname = "Ok"
				)
			}
		
}