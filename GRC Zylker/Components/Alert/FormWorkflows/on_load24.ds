on_load24 as "on load"
{

				type =  form
				form = Alert

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Action_field == "noRisk")
										{
											alert_txt = language.get("grc.alert.riskAlert");
										}
										else if(input.Action_field == "pendingRisk")
										{
											alert_txt = language.get("grc.alert.pendingRiskAlert");
										}
										else if(input.Action_field == "noControl")
										{
											alert_txt = language.get("grc.alert.controlAlert");
										}
										else if(input.Action_field == "riskTreatment")
										{
											alert_txt = language.get("grc.alert.treatmentAlert");
										}
										else if(input.Action_field == "riskAppetite")
										{
											alert_txt = language.get("grc.alert.riskAppetiteAlert");
										}
										else if(input.Action_field == "sendForApproval")
										{
											alert_txt = language.get("grc.alert.sendForApproval");
										}
										else if(input.Action_field == "currentUser")
										{
											currentResource = Risk_Assessment[ID == input.Risk_Assessment].Current_Work_Sheet_User.Resource;
											alert_txt = language.get("grc.assessment.worksheetInProgress");
											alert_txt = alert_txt.replaceAll("\\{0\\}",currentResource);
										}
										input.Notes = "<style>.alert-div{'1px solid #FB2C36;border-radius:10px;padding:10px;'}</style><div class='alert-div'>" + alert_txt + "</div>";
						)
					}
				}

			
}