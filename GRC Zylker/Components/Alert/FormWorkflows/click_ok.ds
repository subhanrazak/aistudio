click_ok as "click ok"
{

				type =  form
				form = Alert
				button = Ok
				on click
				{
					actions 
					{
					on click
					(
						if(input.Action_field == "currentUser")
										{
											openUrl("#Page:Risk_Assessment_Page","same window");
										}
										else
										{
											openUrl("#Script:page.refresh","same window");
										}
					)
					}
				}
			
}