on_delete45 as "on delete"
{

				type =  form
				form = Risk_Category_Coverage

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											plan_name = Assessment_Plan[ID == input.Assessment_Plan].Plan_Name;
										risk_category_name = Risk_Category[ID == input.Risk_Category].Category_Name;
										thisapp.Log.Audit_Log("Risk_Category_Coverage",input.ID,"Update",User[Email == zoho.loginuserid].ID,plan_name + " - " + risk_category_name);
						)
					}
				}

			
}