on_success61 as "on success"
{

				type =  form
				form = Risk_Category_Coverage

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Category_Coverage",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Assessment_Plan.Plan_Name + " - " + input.Risk_Category.Category_Name);
						)
					}
				}

			
}