form Risk_Category_Coverage
{

			displayname = "Risk Category Coverage"
			success message = "Risk Category Coverage Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			bidirectional = Risk_Category_Coverage
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Risk_Category
			(
				type = picklist	
				displayname = "Risk Category"
				values  = Risk_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overall_Risk_Score
			(
				type = number
				displayname = "Overall Risk Score"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Affected_Departments
			(
				type = list	
				displayname = "Affected Departments"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Assessed
			(
    			type = text
				displayname = "Last Assessed"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Planned_Period
			(
				type = picklist
				displayname = "Planned Period"
				maxchar = 100
				values = {"Q1","Q2","Q3","Q4"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}