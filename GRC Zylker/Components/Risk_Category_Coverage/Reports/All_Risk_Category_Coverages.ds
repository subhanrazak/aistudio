default list All_Risk_Category_Coverages
{

			displayName = "All Risk Category Coverages"
			show all rows from Risk_Category_Coverage    
			(
				Risk_Category as "Risk Category"
				Planned_Period as "Planned Period"
				Date_field as "Date"
				Assessment_Plan as "Assessment Plan"
				Overall_Risk_Score as "Overall Risk Score"
				Affected_Departments as "Affected Departments"
				Last_Assessed as "Last Assessed"
			)
		
}