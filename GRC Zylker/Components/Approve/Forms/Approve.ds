form Approve
{

			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Controls
			(
				type = list	
				values  = Control.ID
    			displayformat = [Control_ID_Code]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Entries
			(
				type = list	
				displayname = "Risk Entries"
				values  = Risk_Entry.ID
    			displayformat = [Risk_ID]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Processes
			(
				type = list	
				values  = Process.ID
    			displayformat = [Process_ID]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment_Libraries
			(
				type = list	
				displayname = "Risk Assessment Libraries"
				values  = Risk_Assessment_Libraries.ID
    			displayformat = [ID]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Approve
				(
   					type = submit
   					displayname = "Approve"
				)
			}
		
}