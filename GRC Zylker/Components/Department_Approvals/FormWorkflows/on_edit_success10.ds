on_edit_success10 as "on edit success"
{

				type =  form
				form = Department_Approvals

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department_Approvals",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Risk_Assessment.Assessment_Title + " - " + input.Department.Department_Name);
						)
					}
				}

			
}