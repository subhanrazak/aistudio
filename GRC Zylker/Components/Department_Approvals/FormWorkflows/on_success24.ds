on_success24 as "on success"
{

				type =  form
				form = Department_Approvals

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department_Approvals",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Risk_Assessment.Assessment_Title + " - " + input.Department.Department_Name);
						)
					}
				}

			
}