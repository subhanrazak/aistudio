form Department_Approvals
{

			displayname = "Department Approvals"
			success message = "Department Approval Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			bidirectional = Department_Approvals
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Type_field
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Process","Risk"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Count
			(
				type = number
				displayname = "Total Count"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pending_Approval
			(
				type = number
				displayname = "Pending Approval"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rejected
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Approved","Rejected","Partial"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process_Details
			(
				type = grid
				displayname = "Process Details"
				values  = Department_Process_Approvals.ID
    			bidirectional = Department_Approvals
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}