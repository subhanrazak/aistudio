default list All_Department_Approvals
{

			displayName = "All Department Approvals"
			show all rows from Department_Approvals    
			(
				Department
				Total_Count as "Total Count"
				Pending_Approval as "Pending Approval"
				Approved
				Rejected
				Risk_Assessment as "Risk Assessment"
				Status
				Type_field as "Type"
			)
		
}