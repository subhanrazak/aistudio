Edit_Button as "Edit Button"
{

				type =  functions
				form = Agenda
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Agenda?recLinkID=" + input.ID + "&Action_Field=Edit&viewLinkName=My_Agenda&zc_NextUrl=#Script:page.reload","popup window");
					)
					}
				}
			
}