Agenda_DetailView as "Agenda-DetailView"
{

				type =  functions
				form = Agenda
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Agenda_Page?page_action=template_detail&recid=" + input.ID,"same window");
					)
					}
				}
			
}