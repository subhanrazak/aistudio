form Agenda
{

			success message = "Agenda Added Successfully"
			Agenda_Details
			(
				type = section
				displayname = "Agenda Details"
	 			row = 1
	 			column = 0   
				width = medium
			)
			unique Agenda_Title
			(
    			type = text
				displayname = "Agenda Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agenda_Type
			(
				type = picklist	
				displayname = "Agenda Type"
				values  = Agenda_Type.ID
    			displayformat = [Agenda_Type]
				allow new entries
				[
					displayname = "Add Type"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agenda_Owner
			(
				type = picklist	
				displayname = "Agenda Owner"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agenda_Items
			(
				type = grid
				displayname = "Agenda Items"
				values  = Agenda_Item_Details.ID
    			bidirectional = Agenda
	 			row = 2
	 			column = 1   
				width = medium
			)
			Basics_Notes
			(
				type = section
				displayname = "Basics"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Basic_Agenda_Items_Notes
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 3
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			User1
			(
				type = picklist	
				displayname = "User"
				values  = User.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Stepper_Status
			(
				type = picklist
				displayname = "Stepper Status"
				maxchar = 100
				values = {"Basic","Items","Review","Completed","Edit"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Duration_minutes
			(
				type = number
				displayname = "Duration (minutes)"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Items
			(
				type = number
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Continue
					(
   						type = submit
   						displayname = "Continue"
					)
				}
				on edit
				{
					Continue1
					(
   						type = submit
   						displayname = "Continue"
					)
				}
			}
		
}