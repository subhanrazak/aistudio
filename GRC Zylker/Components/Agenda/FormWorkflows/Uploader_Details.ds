Uploader_Details as "Uploader Details"
{

				type =  form
				form = Agenda

				record event = on add or edit

				on add row of Agenda_Items
				{
					actions 
					{
						custom deluge script
						(
											user = User[Email == zoho.loginuserid];
										row.Uploader=user.ID;
						)
					}
				}

			
}