CSS_Overright2 as "CSS Overright"
{

				type =  form
				form = Agenda

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											publish_CSS = ".zc-Publish_option.tempContDiv .choice-table-row { display: flex !important; flex-direction: row !important; gap: 12px !important; width: 100% !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell { flex: 1 !important; border: 1.5px solid #E5E7EB !important; border-radius: 12px !important; background: #FAFAFA !important; padding: 0 !important; box-sizing: border-box !important; overflow: hidden !important; cursor: pointer !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell span { display: flex !important; flex-direction: column !important; padding: 16px 20px !important; box-sizing: border-box !important; width: 100% !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell:has(input:checked) { border: 2px solid #e8453c !important; background: #fff5f5 !important; } " + "input[name='Publish_option'] { display: none !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell span label:not(.choice-label-text) { display: none !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell span label.choice-label-text { float: none !important; display: block !important; font-size: 15px !important; font-weight: 600 !important; color: #111827 !important; margin: 0 !important; cursor: pointer !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell:has(input:checked) label.choice-label-text { color: #e8453c !important; } " + ".zc-Publish_option.tempContDiv .choice-table-cell label.choice-label-text::after { content: 'Full meeting agenda'; font-size: 13px !important; font-weight: 400 !important; color: #6B7280 !important; display: block !important; margin-top: 4px !important; float: none !important; } " + "#zc-Publish_option-arialabel .zc-label-text { color: #e8453c !important; font-weight: 700 !important; } ";
										CSS_Overright = "<style>" + publish_CSS + "</style>";
						)
					}
				}

			
}