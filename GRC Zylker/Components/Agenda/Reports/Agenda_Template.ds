summary Agenda_Template
{

			displayName = "Agenda Template"
			show all rows from Agenda    
			(
				Agenda_Title as "Agenda Title"
				Agenda_Type as "Agenda Type"
				Agenda_Owner as "Agenda Owner"
				User1 as "User"
				Stepper_Status as "Stepper Status"
				Action_Field as "Action Field"
				Duration_minutes as "Duration (minutes)"
				Items
				Agenda_Items.Item_Title as "Agenda Items"
				Added_Time as "Date"
				ID
			)
			options
			(
				display rows = 10
				display records per row = 2
			)
			custom actions
			(
				"Detail view-Template"
				(
	  			workflow = Detail_view_Template
				show action in edit record menu = true
				)
				"Edit Button"
				(
	  			workflow = Edit_Button1
				show action in edit record menu = true
				)
			)
		
}