list All_Agenda
{

			displayName = "All Agenda"
			show all rows from Agenda    
			(
				Agenda_Title as "Agenda Title"
				Agenda_Type as "Agenda Type"
				Agenda_Owner as "Agenda Owner"
				Stepper_Status as "Stepper Status"
				Action_Field as "Action Field"
				Duration_minutes as "Duration (minutes)"
				Items
				ID
			)
			custom actions
			(
				"Agenda-DetailView"
				(
	  			workflow = Agenda_DetailView
				show action in edit record menu = true
				)
				"Agenda Edit"
				(
	  			workflow = Agenda_Edit
				show action in edit record menu = true
				)
			)
		
}