report Agenda_Template
{

				quickview
				(
					layout
					(
		 				type = -2
	     				recordsperrow = 2
						datablock1
						(
							layout type = -2
							fields
							(
								Agenda_Title as "Agenda Title"
								Agenda_Type as "Agenda Type"
								Agenda_Items.Item_Title as "Agenda Items"
								Duration_minutes as "Duration (minutes)"
								Items
								Added_Time as "Date"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							"Edit Button" as "Edit"
    					)
						)
    				action
    				(
						on click
						(
							"Detail view-Template"
    					)
						on right click
						(
							Edit   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Agenda_Title as "Agenda Title"
								Agenda_Type as "Agenda Type"
								Agenda_Owner as "Agenda Owner"
								User1 as "User"
								Stepper_Status as "Stepper Status"
								Action_Field as "Action Field"
								Duration_minutes as "Duration (minutes)"
								Items
								ID
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}