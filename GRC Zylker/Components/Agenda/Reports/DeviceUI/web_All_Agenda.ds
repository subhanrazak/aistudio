report All_Agenda
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Agenda_Title as "Agenda Title"
								Agenda_Type as "Agenda Type"
								Items
								Duration_minutes as "Duration (minutes)"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
							)
						record
						(
							"Agenda Edit" as " Edit"
    					)
						)
    				action
    				(
						on click
						(
							"Agenda-DetailView"
    					)
						on right click
						(
							Edit   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Agenda_Title as "Agenda Title"
								Agenda_Type as "Agenda Type"
								Agenda_Owner as "Agenda Owner"
								Stepper_Status as "Stepper Status"
								Action_Field as "Action Field"
								Duration_minutes as "Duration (minutes)"
								Items
								ID
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}