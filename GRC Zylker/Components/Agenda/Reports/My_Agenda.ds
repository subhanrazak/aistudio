list My_Agenda
{

			displayName = "My Agenda"
			show all rows from Agenda  [Added_User == zoho.loginuserid]  
			(
				Agenda_Title as "Agenda Title"
				Agenda_Type as "Agenda Type"
				Agenda_Owner as "Agenda Owner"
				User1 as "User"
				Stepper_Status as "Stepper Status"
				Action_Field as "Action Field"
				Duration_minutes as "Duration (minutes)"
				Items
				User1.Added_Time as "Added Time"
				ID
			)
			custom actions
			(
				"Edit Button"
				(
	  			workflow = Edit_Button
				show action in edit record menu = true
				)
				"Detail-MyAgenda"
				(
	  			workflow = Detail_MyAgenda
				)
			)
		
}