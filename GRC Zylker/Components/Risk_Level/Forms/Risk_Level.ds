form Risk_Level
{

			displayname = "Risk Levels"
			success message = "Risk Level Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Label
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have From
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have To
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Color_Code
			(
    			type = text
				displayname = "Color Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}