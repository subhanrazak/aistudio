on_delete26 as "on delete"
{

				type =  form
				form = Jurisdiction

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Jurisdiction",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Jurisdiction_Name);
						)
					}
				}

			
}