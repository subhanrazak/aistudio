form Add_Resolution
{

			displayname = "Add Resolution"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution_Description
			(
    			type = textarea
				displayname = "Resolution Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Vote_Start_Date
			(
    			type = date
				displayname = "Vote Start Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Vote_End_Date
			(
    			type = date
				displayname = "Vote End Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Start","Voted","Completed"}
				initial value = "Start"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Vote
			(
				type = picklist	
				values  = Vote.ID
    			bidirectional = Resolution
    			displayformat = [ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Resolution
			(
				type = picklist
				maxchar = 100
				values = {"Pass","Fail"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Meeting
			(
				type = picklist	
				displayname = "Meetings"
				values  = Meeting.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Agenda_Item
			(
				type = picklist	
				displayname = "Agenda Item"
				values  = Agenda_Item.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Action_Tracker
			(
				type = picklist	
				displayname = "Action Tracker"
				values  = Action_Tracker.ID
    			bidirectional = Resolution
    			displayformat = [ID]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}