Status_Update4 as "Status Update"
{

				type =  form
				form = Add_Resolution

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											agenda = Agenda_Item[ID == input.Agenda_Item];
										agenda.Status="Vote";
										if(input.ID != null)
										{
											openUrl("#Page:Action_Page?meeting_id=" + input.Meeting + "&Agenda_Item=" + input.Agenda_Item + "&mode=resolution&zc_LoadIn=dialog","same window");
										}
						)
					}
				}

			
}