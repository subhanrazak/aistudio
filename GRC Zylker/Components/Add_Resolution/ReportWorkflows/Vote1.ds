Vote1 as "Vote"
{

				type =  functions
				form = Add_Resolution
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						user = User[Email == zoho.loginuserid];
										meetingId = 0;
										agendaItemId = 0;
										if(input.Meeting != null)
										{
											meetingId = input.Meeting.toLong();
										}
										if(input.Agenda_Item != null)
										{
											agendaItemId = input.Agenda_Item.toLong();
										}
										openUrl("#Page:Action_Page?meeting_id=" + meetingId + "&Agenda_Item=" + agendaItemId + "&mode=vote&zc_LoadIn=dialog","popup window","width=1400px,height=600px");
					)
					}
				}
			
}