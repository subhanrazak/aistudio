default list Add_Resolution_Report
{

			displayName = "Add Resolution Report"
			show all rows from Add_Resolution    
			(
				Resolution_Description as "Resolution Description"
				Vote_Start_Date as "Vote Start Date"
				Vote_End_Date as "Vote End Date"
				Status
				Meeting as "Meetings"
				Agenda_Item as "Agenda Item"
				Resolution
				Vote
				Action_Tracker as "Action Tracker"
			)
		
}