list Pending_Controls
{

			displayName = "Pending Controls"
			show all rows from Control  [Approval_Status == "Pending"]  
			(
				Control_ID_Code as "Control ID / Code"
				Control_Name_Title as "Name / Title"
				Control_Description as "Description"
				Control_Owner as "Owner"
				Control_Reviewer_Approver as "Reviewer / Approver"
				Category
				Department
				Control_Type as "Type"
				Control_Status as "Status"
				Frequency
				Execution_Method as "Execution Method"
				Documentation_Source as "Documentation Source"
				Last_Tested_On as "Last Tested On"
				Next_Review_Due as "Next Review Due"
				Review_Cycle as "Review Cycle"
				Risk_Category as "Risk Category"
				Link_Risks as "Link Risks"
				Design_Effectiveness as "Design Effectiveness"
				Operating_Effectiveness as "Operating Effectiveness"
				Testing_Frequency as "Testing Frequency"
				Testing_Method as "Testing Method"
				Sample_Size as "Sample Size"
				Testing_Period as "Testing Period"
				Tester_Reviewer as "Tester/Reviewer"
				Expected_Evidence as "Expected Evidence"
				Upload_Testing_Evidence as "Upload Testing Evidence"
				Control_Details as "Control Details"
				Control_Owner.User_Display as "Owner"
				Control_Reviewer_Approver.User_Display as "Reviewer / Approver"
				Category_Display as "Category "
				Status_Display as "Status"
				S_No as "S.No"
				Approval_Status as "Approval Status"
				custom action "Approve"
				(
	  			workflow = Approve
				show action in view header = true
				show action in edit record menu = true
				column header = "Approve"
				condition = (Approval_Status == "Pending")
				)
				custom action "Reject"
				(
	  			workflow = Reject
				show action in view header = true
				show action in edit record menu = true
				column header = "Reject"
				condition = (Approval_Status == "Pending")
				)
			)
			custom actions
			(
				"detailView"
				(
	  			workflow = detailView3
				)
				"Approve "
				(
	  			workflow = Approval_Workflow
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
				"Reject "
				(
	  			workflow = Reject_Worklow
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
			)
		
}