form Control
{

			displayname = "Controls"
			success message = "Control Added Successfully"
			feature property = 32
			Control_Mapping
			(
				type = section
				displayname = "Control Mapping"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Control_Type1
			(
				type = radiobuttons
				displayname = "Control Type"
				maxchar = 100
				values = {"Existing Control","New Control"}
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Control
			(
				type = list	
				displayname = "Controls"
				values  = Control.ID
    			displayformat = [Control_ID_Code + " - " + Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
    			type = checkbox
				displayname = "Risk Assessment"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Basic_Control_Details
			(
				type = section
				displayname = "Basic Control Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Control_Name_Title
			(
    			type = text
				displayname = "Name / Title"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Control_ID_Code
			(
    			type = text
				displayname = "Control ID / Code"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Control_Description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Control_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Preventive","Detective","Corrective","Manual","Automated","Hybrid"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Control_Status
			(
				type = radiobuttons
				displayname = "Status"
				maxchar = 100
				values = {"Active","Inactive","Under Review"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Control_Category.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add Category"
				]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 4
	 			column = 2   
				width = medium
			)
			Ownership_Responsibility
			(
				type = section
				displayname = "Ownership & Responsibility"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Control_Owner
			(
				type = picklist	
				displayname = "Owner"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Control_Reviewer_Approver
			(
				type = picklist	
				displayname = "Reviewer / Approver"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 2   
				width = medium
			)
			Execution_Configuration
			(
				type = section
				displayname = "Execution Configuration"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Frequency
			(
				type = picklist
				maxchar = 100
				values = {"Daily","Weekly","Monthly","Quarterly","Annually","Event-driven"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			Execution_Method
			(
				type = picklist
				displayname = "Execution Method"
				maxchar = 100
				values = {"System-generated","Manual Review","Exception-based","Automated check"}
	 			row = 6
	 			column = 2   
				width = medium
			)
			Documentation_Source
			(
    			type = text
				displayname = "Documentation Source"
	 			row = 6
	 			column = 3   
				width = medium
			)
			Testing_Review_Schedule
			(
				type = section
				displayname = "Testing & Review Schedule"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Last_Tested_On
			(
    			type = date
				displayname = "Last Tested On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Next_Review_Due
			(
    			type = date
				displayname = "Next Review Due"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 2   
				width = medium
			)
			Review_Cycle
			(
				type = picklist
				displayname = "Review Cycle"
				maxchar = 100
				values = {"Monthly","Quarterly","Semi-annually","Annually","As needed"}
	 			row = 7
	 			column = 3   
				width = medium
			)
			Risk_Category_Mapping
			(
				type = section
				displayname = "Risk Category Mapping"
	 			row = 8
	 			column = 0   
				width = medium
			)
			Risk_Category
			(
				type = list	
				displayname = "Risk Category"
				values  = Risk_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
				height = 60px
	 			row = 8
	 			column = 1   
				width = medium
			)
			Linked_Objectives
			(
				type = list	
				displayname = "Link Objectives "
				values  = Objective.ID
    			bidirectional = Linked_Controls
    			displayformat = [Objective_Title]
				height = 60px
	 			row = 8
	 			column = 1   
				width = medium
			)
			Risk_Process_Associations
			(
				type = section
				displayname = "Risk & Process Associations"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Associated_Process_Activity
			(
				type = list	
				displayname = "Link Process"
				values  = Process[Approval_Status == "Approved"].ID
    			bidirectional = Associate_Controls
    			displayformat = [Process_Name]
				height = 60px
	 			row = 9
	 			column = 1   
				width = medium
			)
			Link_Risks
			(
				type = list	
				displayname = "Link Risks"
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			bidirectional = Link_Controls
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 9
	 			column = 1   
				width = medium
			)
			Link_Assessments
			(
				type = list	
				displayname = "Link Assessments"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_Title]
				sortorder = ascending
				height = 60px
	 			row = 9
	 			column = 1   
				width = medium
			)
			Control_Effectiveness_Assessment
			(
				type = section
				displayname = "Control Effectiveness Assessment"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Design_Effectiveness
			(
				type = radiobuttons
				displayname = "Design Effectiveness"
				maxchar = 100
				values = {"Highly Effective","Effective","Moderately Effective","Weak","Ineffective"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Operating_Effectiveness
			(
				type = radiobuttons
				displayname = "Operating Effectiveness"
				maxchar = 100
				values = {"Highly Effective","Effective","Moderately Effective","Weak","Ineffective"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Control_Testing_Configuration
			(
				type = section
				displayname = "Control Testing Configuration"
				visibility = true
	 			row = 11
	 			column = 0   
				width = medium
			)
			Testing_Frequency
			(
				type = picklist
				displayname = "Testing Frequency"
				maxchar = 100
				values = {"Monthly","Quarterly","Semi-annually","Annually","Ad-hoc"}
	 			row = 11
	 			column = 1   
				width = medium
			)
			Sample_Size
			(
				type = number
				displayname = "Sample Size"
	 			row = 11
	 			column = 1   
				width = medium
			)
			Tester_Reviewer
			(
				type = picklist	
				displayname = "Tester/Reviewer"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 11
	 			column = 1   
				width = medium
			)
			Upload_Testing_Evidence
			(
    			type = upload file
				displayname = "Upload Testing Evidence"
    			file count = 10
				browse = local_drive
	 			row = 11
	 			column = 1   
				width = medium
			)
			Testing_Method
			(
				type = picklist
				displayname = "Testing Method"
				maxchar = 100
				values = {"Inquiry","Observation","Inspection","Re-performance","Analytical"}
	 			row = 11
	 			column = 2   
				width = medium
			)
			Testing_Period
			(
				type = picklist
				displayname = "Testing Period"
				maxchar = 100
				values = {"Point in Time","Period of Time","Continuous"}
	 			row = 11
	 			column = 2   
				width = medium
			)
			Expected_Evidence
			(
    			type = textarea
				displayname = "Expected Evidence"
				height = 100px
	 			row = 11
	 			column = 2   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 12
	 			column = 0   
				width = medium
			)
			Control_Details
			(
    			type = richtext
				displayname = "Control Details"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 12
	 			column = 1   
				width = medium
			)
			Category_Display
			(
    			type = richtext
				displayname = "Category "
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 12
	 			column = 1   
				width = medium
			)
			Status_Display
			(
    			type = richtext
				displayname = "Status"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 12
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 12
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending","Approved","Rejected"}
				initial value = "Pending"
	 			row = 12
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 12
	 			column = 1   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Control Information","Risk Process Links","Effectiveness Testing"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 12
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		
}