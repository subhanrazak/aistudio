get_Control_Type as "get Control Type"
{

				type =  form
				form = Control

				record event = on add or edit

				on user input of Control_Type1
				{
					actions 
					{
						custom deluge script
						(
											if(input.Control_Type1 == "Existing Control")
										{
											show Control;
											hide Basic_Control_Details;
											hide Section;
											hide Section1;
											hide Ownership_Responsibility;
											hide Execution_Configuration;
											hide Testing_Review_Schedule;
											hide Risk_Category_Mapping;
											hide Risk_Process_Associations;
											hide Control_Effectiveness_Assessment;
											hide Control_Testing_Configuration;
										}
										else if(input.Control_Type1 == "New Control")
										{
											hide Control;
											show Basic_Control_Details;
											show Section;
											show Section1;
											show Ownership_Responsibility;
											show Execution_Configuration;
											show Testing_Review_Schedule;
											show Risk_Category_Mapping;
											show Control_Effectiveness_Assessment;
											show Control_Testing_Configuration;
											hide Department;
											hide Linked_Objectives;
										}
						)
					}
				}

			
}