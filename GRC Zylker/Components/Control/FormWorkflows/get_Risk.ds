get_Risk as "get Risk"
{

				type =  form
				form = Control

				record event = on add or edit

				on user input of Associated_Process_Activity
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment == false)
										{
											if(input.Associated_Process_Activity.size() > 0)
											{
												currentRisk = input.Link_Risks;
												riskList = Risk_Entry[Process == input.Associated_Process_Activity].ID.getAll();
												input.Link_Risks:ui.add(riskList);
												input.Link_Risks = currentRisk;
											}
											else
											{
												clear Link_Risks;
											}
										}
						)
					}
				}

			
}