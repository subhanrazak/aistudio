Get_Process1 as "Get Process"
{

				type =  form
				form = Control

				record event = on add or edit

				on user input of Linked_Objectives
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment == false)
										{
											if(input.Linked_Objectives.size() > 0)
											{
												currentProcess = input.Associated_Process_Activity;
												processList = Process[Linked_Objectives == input.Linked_Objectives].ID.getAll();
												input.Associated_Process_Activity:ui.add(processList);
												input.Associated_Process_Activity = currentProcess;
											}
											else
											{
												clear Associated_Process_Activity;
											}
										}
						)
					}
				}

			
}