on_load4 as "on load"
{

				type =  form
				form = Control

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											radio_button_style = ".flLeft[name=\"parentOf-Design_Effectiveness\"],.flLeft[name=\"parentOf-Operating_Effectiveness\"],.flLeft[name=\"parentOf-Control_Status\"],.flLeft[name=\"parentOf-Control_Type\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row .choice-table-cell span,flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row .choice-table-cell span,flLeft[name=\"parentOf-Control_Status\"] .choice-table-row .choice-table-cell span,flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row .choice-table-cell > span > input + label,.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row .choice-table-cell > span > input + label,.flLeft[name=\"parentOf-Control_Status\"] .choice-table-row .choice-table-cell > span > input + label,.flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row .choice-table-cell > span > label.choice-label-text,.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row .choice-table-cell > span > label.choice-label-text,.flLeft[name=\"parentOf-Control_Status\"] .choice-table-row .choice-table-cell > span > label.choice-label-text,.flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row .choice-table-cell,.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row .choice-table-cell,.flLeft[name=\"parentOf-Control_Status\"] .choice-table-row .choice-table-cell,.flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row,.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row,.flLeft[name=\"parentOf-Control_Status\"] .choice-table-row,.flLeft[name=\"parentOf-Control_Type\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }";
										design_field_style = ".flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #DEFFEA; border: 1px solid #DEFFEA;}.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #E8EFFF; border: 1px solid #E8EFFF;} .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #FDF8DA;border: 1px solid #FDF8DA; }.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text { background: #F8F0EB;border: 1px solid #F8F0EB; } .flLeft[name=\"parentOf-Design_Effectiveness\"]  .choice-table-row:nth-child(5) .choice-table-cell > span > label.choice-label-text { background: #FFE3E3; border: 1px solid #FFE3E3;} .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #16a34a; }.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #2A6FFC; }.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #fee685; } .flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(5) .choice-table-cell span input:checked ~ label  { border: 1px solid #fb2c36; }.flLeft[name=\"parentOf-Design_Effectiveness\"] .choice-table-row:nth-child(4) .choice-table-cell span input:checked ~ label  { border: 1px solid #F4660C; }";
										operating_field_style = ".flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #DEFFEA; border: 1px solid #DEFFEA; }.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #E8EFFF; border: 1px solid #E8EFFF;}  .flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #FDF8DA; border: 1px solid #FDF8DA; }.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text { background: #F8F0EB;border: 1px solid #F8F0EB; } .flLeft[name=\"parentOf-Operating_Effectiveness\"]  .choice-table-row:nth-child(5) .choice-table-cell > span > label.choice-label-text { background: #FFE3E3;  border: 1px solid #FFE3E3; } .flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #16a34a; }.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #2A6FFC; } .flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #fee685; } .flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(5) .choice-table-cell span input:checked ~ label  { border: 1px solid #fb2c36; }.flLeft[name=\"parentOf-Operating_Effectiveness\"] .choice-table-row:nth-child(4) .choice-table-cell span input:checked ~ label  { border: 1px solid #F4660C; }";
										status_field_style = ".flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #ddffe9; border: 1px solid #ddffe9;} .flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #fdfae7; border: 1px solid #fdfae7;} .flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #fee3e2; border: 1px solid #fee3e2;} .flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #16A34A; } .flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #FEE685; } .flLeft[name=\"parentOf-Control_Status\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #FB2C36; }";
										type_field_style = ".flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { background: #F5F4F9; border: 1px solid #F5F4F9;}.flLeft[name=\"parentOf-Control_Type\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }";
										input.style_txt = "<style>" + radio_button_style + design_field_style + operating_field_style + status_field_style + type_field_style + "</style>";
										if(input.Risk_Assessment == true)
										{
											show Control_Mapping;
										}
										else
										{
											hide Control_Mapping;
											if(input.Action_Field != "" && input.Action_Field != null)
											{
												if(input.Action_Field == "Control Information")
												{
													show Basic_Control_Details;
													show Section;
													show Section1;
													show Ownership_Responsibility;
													show Execution_Configuration;
													show Testing_Review_Schedule;
													show Risk_Category_Mapping;
												}
												else if(input.Action_Field == "Risk Process Links")
												{
													show Risk_Process_Associations;
												}
												else if(input.Action_Field == "Effectiveness Testing")
												{
													show Control_Effectiveness_Assessment;
													show Control_Testing_Configuration;
												}
											}
										}
						)
					}
				}

			
}