on_load14 as "on load"
{

				type =  form
				form = Control

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment == true)
										{
											riskID = input.Link_Risks;
											input.Department = input.Link_Risks.Department;
											input.Linked_Objectives = input.Link_Risks.Objective;
											input.Associated_Process_Activity = input.Link_Risks.Process;
										}
										else
										{
											clear Linked_Objectives;
											clear Associated_Process_Activity;
											clear Link_Risks;
										}
						)
					}
				}

			
}