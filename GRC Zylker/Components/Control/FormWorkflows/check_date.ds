check_date as "check date"
{

				type =  form
				form = Control

				record event = on add or edit

				on user input of Next_Review_Due
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Next_Review_Due != null && input.Next_Review_Due < zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Next_Review_Due = null;
										}
						)
					}
				}

			
}