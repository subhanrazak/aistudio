						hide Control_ID_Code,Risk_Category;
					}
					actions 
					{
						hide Last_Tested_On;
					}
					actions 
					{
						hide Basic_Control_Details,Control_Effectiveness_Assessment,Control_Testing_Configuration,Execution_Configuration,Ownership_Responsibility,Testing_Review_Schedule,Section,Section1,Risk_Process_Associations,Risk_Category_Mapping,Control_Mapping;
					}
				}

			
}