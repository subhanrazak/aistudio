on_delete4 as "on delete"
{

				type =  form
				form = Control

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Control",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Control_ID_Code + " - " + input.Control_Name_Title);
						)
					}
				}

			
}