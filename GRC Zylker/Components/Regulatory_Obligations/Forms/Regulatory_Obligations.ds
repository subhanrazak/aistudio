form Regulatory_Obligations
{

			displayname = "Regulatory Obligations"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Regulation
			(
				type = picklist	
				values  = Add_Regulation.ID
    			bidirectional = Obligations
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Obligation_ID
			(
    			type = text
				displayname = "Obligation ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Obligation_Name
			(
    			type = text
				displayname = "Obligation Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process1
			(
				type = picklist	
				displayname = "Process"
				values  = Process.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Control
			(
				type = picklist	
				values  = Control.ID
    			displayformat = [Control_Name_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}