on_delete30 as "on delete"
{

				type =  form
				form = Location

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Location",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Location);
						)
					}
				}

			
}