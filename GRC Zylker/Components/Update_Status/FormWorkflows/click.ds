click as "click"
{

				type =  form
				form = Update_Status
				button = Update_Button
				on click
				{
					actions 
					{
					on click
					(
						actionPlan = Action_Plan[ID == input.Action_Plan];
										actionPlan.Status=input.Status;
										actionPlan.Comments=input.Comments;
										actionPlan.Progress=input.Progress;
										openUrl("#Script:page.refersh","same window");
					)
					}
				}
			
}