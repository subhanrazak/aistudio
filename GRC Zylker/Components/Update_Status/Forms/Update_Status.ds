form Update_Status
{

			displayname = "Update Status"
			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Action_Plan
			(
				type = picklist	
				displayname = "Action Plan"
				values  = Action_Plan.ID
    			displayformat = [Action_ID + " - " + Action_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"In Progress","Completed","Deferred"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Progress
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Update_Button
				(
   					type = submit
   					displayname = "Update"
				)
			}
		
}