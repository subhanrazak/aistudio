form Risk_Appetite
{

			displayname = "Risk Appetites"
			success message = "Risk Appetite Added Successfully"
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Appetite_ID
			(
    			type = text
				displayname = "Risk Appetite ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Owner
			(
				type = picklist	
				displayname = "Owner"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Effective_Date_From
			(
    			type = date
				displayname = "Effective Date (From)"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expiry_Date
			(
    			type = date
				displayname = "Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category
			(
				type = picklist	
				values  = Risk_Category.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Review_Frequency
			(
				type = picklist
				displayname = "Review Frequency"
				maxchar = 100
				values = {"Monthly","Quarterly","Semi-Annual","Annual"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Threshold_Configuration
			(
				type = section
				displayname = "Threshold Configuration"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Measurement_Type
			(
				type = radiobuttons
				displayname = "Measurement Type"
				maxchar = 100
				values = {"Quantitative","Qualitative"}
				layout = 2
	 			row = 2
	 			column = 1   
				width = medium
			)
			Metric_Type
			(
				type = picklist
				displayname = "Metric Type"
				maxchar = 100
				values = {"Percentage","Currency","Count","Ratio","Score","Custom"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Target_Appetite
			(
				type = decimal
				displayname = "Target (Appetite)"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Tolerance
			(
				type = decimal
				displayname = "Tolerance (±)"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Minimum_Threshold
			(
				type = decimal
				displayname = "Minimum Threshold"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Maximum_Threshold
			(
				type = decimal
				displayname = "Maximum Threshold"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Critical_Alert_at
			(
				type = decimal
				displayname = "Critical Alert at"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Direction_of_Risk
			(
				type = radiobuttons
				displayname = "Direction of Risk"
				maxchar = 100
				values = {"Higher is Worse","Lower is Worse","Both Directions"}
				layout = 3
	 			row = 2
	 			column = 1   
				width = medium
			)
			Link_KRI
			(
				type = list	
				displayname = "Link KRI"
				values  = KRI.ID
    			displayformat = [KRI_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Data_Collection_Configuration
			(
				type = section
				displayname = "Data Collection Configuration"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Data_Collection_Method
			(
				type = radiobuttons
				displayname = "Data Collection Method"
				maxchar = 100
				values = {"Automated (API/Integration)","Manual Entry","Both"}
				layout = 3
	 			row = 3
	 			column = 1   
				width = medium
			)
			Primary_Data_Source
			(
				type = picklist
				displayname = "Primary Data Source"
				maxchar = 100
				values = {"Stock Exchange API","SAP System","Manual Entry"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Backup_Data_Source
			(
				type = picklist
				displayname = "Backup Data Source"
				maxchar = 100
				values = {"Manual Entry","Secondary API"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Update_Frequency
			(
				type = picklist
				displayname = "Update Frequency"
				maxchar = 100
				values = {"Real-time","Hourly","Daily","Weekly"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Organizational_Mapping
			(
				type = section
				displayname = "Organizational Mapping"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Departments_Impacted
			(
				type = list	
				displayname = "Departments Impacted"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Linked_Processes_From_Risk_Assessment_Module
			(
				type = list	
				displayname = "Link Processes "
				values  = Process[Approval_Status == "Approved"].ID
    			displayformat = [Process_Name]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Notification_Recipients
			(
				type = section
				displayname = "Notification Recipients"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Primary_Recipient
			(
				type = list	
				displayname = "Primary Recipient"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Secondary_Recipients
			(
				type = list	
				displayname = "Secondary Recipients"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 1   
				width = medium
			)
			CC
			(
				type = list	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}