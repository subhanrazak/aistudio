default list Risk_Appetites
{

			displayName = "Risk Appetites"
			show all rows from Risk_Appetite    
			(
				Risk_Appetite_ID as "Risk Appetite ID"
				Title
				Description
				Risk_Owner as "Owner"
				Effective_Date_From as "Effective Date (From)"
				Expiry_Date as "Expiry Date"
				Category
				Review_Frequency as "Review Frequency"
				Measurement_Type as "Measurement Type"
				Metric_Type as "Metric Type"
				Target_Appetite as "Target (Appetite)"
				Tolerance as "Tolerance (±)"
				Minimum_Threshold as "Minimum Threshold"
				Maximum_Threshold as "Maximum Threshold"
				Critical_Alert_at as "Critical Alert at"
				Direction_of_Risk as "Direction of Risk"
				Link_KRI as "Link KRI"
				Data_Collection_Method as "Data Collection Method"
				Primary_Data_Source as "Primary Data Source"
				Backup_Data_Source as "Backup Data Source"
				Update_Frequency as "Update Frequency"
				Departments_Impacted as "Departments Impacted"
				Linked_Processes_From_Risk_Assessment_Module as "Link Processes "
				Primary_Recipient as "Primary Recipient"
				Secondary_Recipients as "Secondary Recipients"
				CC
			)
		
}