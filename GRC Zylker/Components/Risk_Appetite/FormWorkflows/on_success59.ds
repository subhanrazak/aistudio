on_success59 as "on success"
{

				type =  form
				form = Risk_Appetite

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Appetite",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Risk_Appetite_ID + " - " + input.Title);
						)
					}
				}

			
}