on_edit_success31 as "on edit success"
{

				type =  form
				form = Risk_Appetite

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Appetite",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Risk_Appetite_ID + " - " + input.Title);
						)
					}
				}

			
}