Detailview_Commite as "Detailview-Commite"
{

				type =  functions
				form = Committee
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Board_Page?page_action=committe&record_id=" + input.ID,"same window");
					)
					}
				}
			
}