form Committee
{

			displayname = "Committees"
			success message = "Committee Added Successfully"
			Committee_Information
			(
				type = section
				displayname = "General Committee Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Committee_Name
			(
    			type = text
				displayname = "Committee Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Commitee_Code
			(
    			type = text
				displayname = "Commitee Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Establishment_Date
			(
    			type = date
				displayname = "Establishment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose_Objective
			(
    			type = textarea
				displayname = "Purpose/Objective"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Committee_Type
			(
				type = picklist	
				displayname = "Committee Type"
				values  = Committee_Type.ID
    			displayformat = [Committee_Type]
				allow new entries
				[
					displayname = "Add Committe Type"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Chair_Person
			(
				type = picklist	
				displayname = "Chair Person"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Review_Cycle
			(
				type = picklist
				displayname = "Review Cycle"
				maxchar = 100
				values = {"Monthly","Weekly","Yearly"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_Date
			(
    			type = date
				displayname = "Effective Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Leadership
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Chairperson_Name
			(
				type = picklist	
				displayname = "Chairperson Name "
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Members
			(
				type = list	
				values  = User.ID
    			displayformat = [" " + Name.first_name + " " + Name.last_name + " - " + Employee_ID]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Secretary_Name
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Charter_Governance_Configuration
			(
				type = section
				displayname = "Charter & Governance Configuration"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Meeting_Frequency
			(
				type = picklist
				displayname = "Meeting Frequency"
				maxchar = 100
				values = {"Monthly","Weekly","Quarterly","Yearly"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Voting_Threshold
			(
				type = picklist
				displayname = "Voting Threshold"
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Voting_Method
			(
				type = picklist
				displayname = "Voting Method"
				maxchar = 100
				values = {"Simple Majority (>50%)","Unanimous Consent (100%)","Supermajority (≥75%)"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Additional_Charter_Notes
			(
    			type = textarea
				displayname = "Additional Charter Notes"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Quorum_Requirement
			(
				type = number
				displayname = "Quorum Requirement (%)"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Upload_Charter_Document
			(
    			type = upload file
				displayname = "Upload Charter Document"
    			file count = 10
				browse = local_drive
	 			row = 3
	 			column = 2   
				width = medium
			)
			Voting_Members
			(
				type = section
				displayname = "Voting Members"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Minimum_Count
			(
				type = number
				displayname = "Minimum Count"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Count
			(
				type = number
				displayname = "Preferred Count"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Maximum_Count
			(
				type = number
				displayname = "Maximum Count"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Independent_Directors
			(
				type = section
				displayname = "Independent Directors"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Minimum_Count_Independent
			(
				type = number
				displayname = "Minimum Count"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Independence_Criteria
			(
    			type = textarea
				displayname = "Independence Criteria"
				height = 100px
	 			row = 5
	 			column = 2   
				width = medium
			)
			Non_Executive_Members
			(
				type = section
				displayname = "Non-Executive Members"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Allowed
			(
				type = picklist
				maxchar = 100
				values = {"Yes","No"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			Maximum_Count_Non_Executive
			(
				type = number
				displayname = "Maximum Count"
	 			row = 6
	 			column = 2   
				width = medium
			)
			Advisors_and_Observers
			(
				type = section
				displayname = "Advisors and Observers"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Observers_Allowed
			(
				type = picklist
				displayname = "Observers Allowed"
				maxchar = 100
				values = {"Yes","No"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Non_Voting_Advisors
			(
				type = number
				displayname = "Non-Voting Advisors"
	 			row = 7
	 			column = 2   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Valid","Invaild","Cancelled"}
	 			row = 8
	 			column = 1   
				width = medium
			)
			Last_Meeting
			(
    			type = date
				displayname = "Last Meeting"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 8
	 			column = 1   
				width = medium
			)
			Committee_Membership_Configuration
			(
				type = grid
				displayname = "Committee Membership Configuration"
				values  = Committee_Members.ID
    			bidirectional = Committee
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 10
	 			column = 0   
				width = medium
			)
			Escalation_Template
			(
				type = picklist	
				displayname = "Escalation Template"
				values  = Escalation_Template.ID
    			displayformat = [Escalation_Name]
				sortorder = ascending
	 			row = 10
	 			column = 1   
				width = medium
			)
			Committee_Escalation
			(
				type = grid
				displayname = "Committee Escalation"
				values  = Committee_Escalation.ID
    			bidirectional = Committee
	 			row = 11
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create_Commitee
					(
   						type = submit
   						displayname = "Create Commitee"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}