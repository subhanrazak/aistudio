list Committee_Report
{

			displayName = "Committee Report"
			show all rows from Committee    
			(
				Committee_Name as "Committee Name"
				Commitee_Code as "Commitee Code"
				Purpose_Objective as "Purpose/Objective"
				Committee_Type as "Committee Type"
				Chairperson_Name as "Chairperson Name "
				Members
				Secretary_Name
				Minimum_Count as "Minimum Count"
				Maximum_Count as "Maximum Count"
				Preferred_Count as "Preferred Count"
				Status
				Last_Meeting as "Last Meeting"
			)
		
}