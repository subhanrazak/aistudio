default list Committees
{

			displayName = "Committees"
			show all rows from Committee    
			(
				Committee_Name as "Committee Name"
				Committee_Type as "Committee Type"
				Purpose_Objective as "Purpose/Objective"
				Minimum_Count as "Minimum Count"
				Maximum_Count as "Maximum Count"
				Preferred_Count as "Preferred Count"
				Commitee_Code as "Commitee Code"
				Status
				Chairperson_Name as "Chairperson"
				Secretary_Name
				Members
				Last_Meeting as "Last Meeting"
				Meeting_Frequency as "Meeting Frequency"
				Quorum_Requirement as "Quorum Requirement (%)"
				Voting_Threshold as "Voting Threshold"
				Upload_Charter_Document as "Upload Charter Document"
				Additional_Charter_Notes as "Additional Charter Notes"
				Establishment_Date as "Establishment Date"
				Effective_Date as "Effective Date"
				Review_Cycle as "Review Cycle"
				Minimum_Count_Independent as "Minimum Count"
				Independence_Criteria as "Independence Criteria"
				Allowed
				Maximum_Count_Non_Executive as "Maximum Count"
				Non_Voting_Advisors as "Non-Voting Advisors"
				Observers_Allowed as "Observers Allowed"
				Chair_Person as "Chair Person"
				Escalation_Template as "Escalation Template"
				Voting_Method as "Voting Method"
			)
			custom actions
			(
				"Detailview-Commite"
				(
	  			workflow = Detailview_Commite
				)
			)
		
}