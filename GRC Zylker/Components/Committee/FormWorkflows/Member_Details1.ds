Member_Details1 as "Member Details"
{

				type =  form
				form = Committee

				record event = on add or edit

				on user input of Committee_Membership_Configuration.Member
				{
					actions 
					{
						custom deluge script
						(
											user = User[ID = row.Member];
										row.Position=user.Member_Type;
										row.Role=user.Role;
										disable row.Position;
										disable row.Role;
						)
					}
				}

			
}