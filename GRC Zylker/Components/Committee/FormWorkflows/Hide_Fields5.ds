Hide_Fields5 as "Hide Fields"
{

				type =  form
				form = Committee

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Hidden;
										hide Leadership;
										disable Committee_Escalation.Role;
										disable Committee_Escalation.Level;
										hide Committee_Escalation.Hours_Next_Escalation;
										// hide Charter_Governance_Configuration;
						)
					}
				}

			
}