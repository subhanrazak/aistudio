list Meeting_Report
{

			displayName = "Meeting Report"
			show all rows from Meeting    
			(
				Meeting_Title as "Meeting Title"
				Committee1 as "Committee"
				Quorum
				Meeting_Type as "Type"
				Priority
				Meeting_Mode as "Meeting Mode"
				Venue_Building as "Venue / Building"
				Meeting_Link as "Meeting Link "
				Organized_By as "Organized By"
				Present
				Meeting_Chairperson as "Meeting Chairperson"
				Invite_Members as "Invite Members"
				Status
			)
		
}