list Agenda_Summary
{

			displayName = "Agenda Summary"
			show all rows from Meeting    
			(
				Meeting_Title as "Meeting Title"
				Committee1 as "Committee"
				Quorum
				Purpose
				Meeting_Type as "Type"
				Priority
				Meeting_Series as "Meeting Series"
				Recurring_pattern as "Recurring pattern"
				Start_Date_Time as "Start Date & Time"
				Meeting_Mode as "Meeting Mode"
				Room_Hall as "Room/ Hall"
				End_Date_Time as "End Date & Time"
				Meeting_Link as "Meeting Link "
				Venue_Building as "Venue / Building"
				Invite_Members as "Invite Members"
				Agenda
				Automated_Reminders as "Automated Reminders"
				Pre_Meeting_Pack_Send_Date as "Pre-Meeting Pack Send Date"
				Send_calendar_invite_immediately_on_publish as "Send calendar invite immediately on publish"
				Enable_digital_voting_e_resolutions as "Enable digital voting / e-resolutions"
				Record_virtual_meeting as "Record virtual meeting"
				Organized_By as "Organized By"
				Total_Members as "Total Members"
				Present
				Meeting_Chairperson as "Meeting Chairperson"
				Duration
				Status
				Completed_Stage as "Completed Stage"
				Action_Field as "Action Field"
				Agenda.Items
				Agenda.Agenda_Type as "Agenda Type"
				Agenda.Duration_minutes as "Duration (minutes)"
				custom action "Action"
				(
	  			workflow = Action_workflow1
				show action in edit record menu = true
				column header = "Action"
				)
				custom action "Add Action"
				(
	  			workflow = Add_Action
				show action in edit record menu = true
				column header = "Add Action"
				)
			)
		
}