Detail_UpcomingAgenda as "Detail-UpcomingAgenda"
{

				type =  functions
				form = Meeting
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Agenda_Page?page_action=agenda_detail&recid=" + input.ID,"same window");
					)
					}
				}
			
}