Add_Action as "Add Action"
{

				type =  functions
				form = Meeting
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Action_Page?meeting_id=" + input.ID + "&item_index=0&zc_LoadIn=dialog","popup window","width=1200px");
					)
					}
				}
			
}