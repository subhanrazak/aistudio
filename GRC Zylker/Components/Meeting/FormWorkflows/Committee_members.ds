Committee_members as "Committee members"
{

				type =  form
				form = Meeting

				record event = on add or edit

				on user input of Committee1
				{
					actions 
					{
						custom deluge script
						(
											committeeMembers = Committee_Members[Committee == input.Committee1];
										memberList = committeeMembers.Member.getall();
										input.Invite_Members = memberList;
						)
					}
				}

			
}