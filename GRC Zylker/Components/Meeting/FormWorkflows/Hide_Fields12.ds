Hide_Fields12 as "Hide Fields"
{

				type =  form
				form = Meeting

				record event = on add or edit

				field rules
				{
					actions  (Meeting_Series == "Recurring meeting")
					{
						show Recurring_pattern;
					}
					actions 
					{
						hide Venue_Building,Room_Hall,Meeting_Link;
					}
					actions  (Meeting_Mode == "Physical Location")
					{
						show Venue_Building,Room_Hall;
					}
					actions  (Meeting_Mode == "Virtual Meeting")
					{
						show Meeting_Link,Integeration;
					}
					actions  (Meeting_Mode == "Hybrid Meeting")
					{
						show Venue_Building,Room_Hall,Integeration,Meeting_Link;
					}
					actions 
					{
						hide Committee1,Recurrence_Ends_On;
					}
					actions  (Meeting_For == "Commitee")
					{
						show Committee1;
					}
					actions  (Meeting_Series == "Recurring meeting")
					{
						show Recurrence_Ends_On;
					}
				}

			
}