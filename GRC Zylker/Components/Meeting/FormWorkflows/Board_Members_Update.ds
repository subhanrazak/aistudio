Board_Members_Update as "Board Members Update"
{

				type =  form
				form = Meeting

				record event = on add or edit

				on user input of Meeting_For
				{
					actions 
					{
						custom deluge script
						(
											if(input.Meeting_For == "Board" && input.Meeting_For != null)
										{
											boardMembers = Board_Member_Assignment[ID != 0];
											memberList = List();
											for each  bm in boardMembers
											{
												if(bm.Member != null)
												{
													memberList.add(bm.Member);
												}
											}
											input.Invite_Members = memberList;
										}
										else
										{
											input.Invite_Members = List();
										}
						)
					}
				}

			
}