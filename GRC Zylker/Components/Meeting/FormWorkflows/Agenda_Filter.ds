Agenda_Filter as "Agenda Filter"
{

				type =  form
				form = Meeting

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											usedagenda = Meeting[Status == "Scheduled"].Agenda.getAll();
										allagenda = Agenda[ID != 0].ID.getAll();
										addagenda = List();
										addagenda.addAll(allagenda);
										addagenda.removeAll(usedagenda);
										input.Agenda:ui.add(addagenda);
						)
					}
				}

			
}