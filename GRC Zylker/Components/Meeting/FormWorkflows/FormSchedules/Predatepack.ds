Predatepack as "Predatepack"
{

				type =  schedule
				form = Meeting[Status == "Sheduled"]
				start = Pre_Meeting_Pack_Send_Date at "00:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						if(input.Agenda != null)
										{
											input.Agenda_Items_Material = "Met";
										}
										else
										{
											input.Agenda_Items_Material = "Not Met";
										}
					)
					}
				}
			
}