											meeting_mode_CSS = ".zc-Meeting_Mode-group { width: 100% !important; max-width: 100% !important; flex-basis: 100% !important; } .formColumn:has(.zc-Meeting_Mode-group) { width: 100% !important; max-width: 100% !important; flex: 0 0 100% !important; } .zc-Meeting_Mode { display: flex !important; flex-direction: row !important; align-items: stretch !important; gap: 20px !important; width: 100% !important; float: none !important; flex-wrap: nowrap !important; box-sizing: border-box !important; } .zc-Meeting_Mode .choice-table-row { flex: 1 !important; margin-bottom: 0 !important; min-width: 0 !important; display: flex !important; flex-direction: column !important; } .zc-Meeting_Mode .choice-table-row:empty { display: none !important; } .zc-Meeting_Mode .choice-table-row .choice-table-cell { border: 1.5px solid #E5E7EB !important; border-radius: 12px !important; background: #FFFFFF !important; padding: 0px !important; margin: 0 !important; box-shadow: none !important; cursor: pointer !important; width: 100% !important; flex: 1 !important; box-sizing: border-box !important; overflow: hidden !important; display: flex !important; } .zc-Meeting_Mode .choice-table-row:has(input:checked) .choice-table-cell { border: 2px solid #e8453c !important; background: #fff5f5 !important; } .zc-Meeting_Mode .choice-table-row:has(input:checked) .choice-label-text { color: #e8453c !important; } .zc-Meeting_Mode .choice-table-row .choice-table-cell span { display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; width: 100% !important; padding: 24px 16px 20px 16px !important; background: transparent !important; border: none !important; box-shadow: none !important; border-radius: 12px !important; box-sizing: border-box !important; cursor: pointer !important; min-height: 130px !important; gap: 12px !important; flex: 1 !important; } .zc-Meeting_Mode .choice-table-row .choice-table-cell input.customRadio { float: none !important; display: block !important; order: 3 !important; flex-shrink: 0 !important; align-self: center !important; width: 18px !important; height: 18px !important; min-width: 18px !important; min-height: 18px !important; margin: 8px 0 4px 0 !important; padding: 0px !important; cursor: pointer !important; appearance: auto !important; -webkit-appearance: auto !important; accent-color: #e8453c !important; position: static !important; opacity: 1 !important; } .zc-Meeting_Mode .choice-table-row .choice-table-cell input.customRadio + label:not(.choice-label-text) { display: none !important; } .zc-Meeting_Mode .choice-table-row .choice-table-cell .choice-label-text { display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; gap: 10px !important; order: 1 !important; float: none !important; cursor: pointer !important; font-size: 14px !important; font-weight: 600 !important; color: #111827 !important; margin: 0px !important; padding: 0px !important; text-align: center !important; line-height: 1.3 !important; width: 100% !important; white-space: nowrap !important; } .choice-label-text[for*='Meeting_Mode_1_0']::before, .choice-label-text[for*='Meeting_Mode_3_0']::before { content: '' !important; display: block !important; width: 44px !important; height: 44px !important; min-width: 44px !important; min-height: 44px !important; max-width: 44px !important; max-height: 44px !important; align-self: center !important; flex-shrink: 0 !important; background-color: #ffe4e3 !important; background-image: url('https://api.iconify.design/lucide/calendar.svg?color=%23e8453c') !important; background-repeat: no-repeat !important; background-position: center !important; background-size: 22px !important; border-radius: 10px !important; } .choice-label-text[for*='Meeting_Mode_1_1']::before, .choice-label-text[for*='Meeting_Mode_3_1']::before { content: '' !important; display: block !important; width: 44px !important; height: 44px !important; min-width: 44px !important; min-height: 44px !important; max-width: 44px !important; max-height: 44px !important; align-self: center !important; flex-shrink: 0 !important; background-color: #ffe4e3 !important; background-image: url('https://api.iconify.design/lucide/video.svg?color=%23e8453c') !important; background-repeat: no-repeat !important; background-position: center !important; background-size: 22px !important; border-radius: 10px !important; } .choice-label-text[for*='Meeting_Mode_1_2']::before, .choice-label-text[for*='Meeting_Mode_3_2']::before { content: '' !important; display: block !important; width: 44px !important; height: 44px !important; min-width: 44px !important; min-height: 44px !important; max-width: 44px !important; max-height: 44px !important; align-self: center !important; flex-shrink: 0 !important; background-color: #ffe4e3 !important; background-image: url('https://api.iconify.design/lucide/users.svg?color=%23e8453c') !important; background-repeat: no-repeat !important; background-position: center !important; background-size: 22px !important; border-radius: 10px !important; }";
