Date_Validation as "Date Validation"
{

				type =  form
				form = Meeting

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Start_Date_Time != null && input.End_Date_Time != null)
										{
											if(input.End_Date_Time < input.Start_Date_Time)
											{
												alert "End Date/Time cannot be before Start Date/Time.";
												input.End_Date_Time = null;
											}
										}
										if(input.End_Date_Time != null && input.Recurrence_Ends_On != null)
										{
											if(input.Recurrence_Ends_On < input.End_Date_Time)
											{
												alert "Recurrence End date must be after the End Date/Time.";
												input.Recurrence_Ends_On = null;
											}
										}
						)
					}
				}

			
}