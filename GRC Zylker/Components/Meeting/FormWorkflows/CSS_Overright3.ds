CSS_Overright3 as "CSS Overright"
{

				type =  form
				form = Meeting

				record event = on add or edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											// ── Add at TOP of Meeting Form OnLoad workflow ────────────────
										meeting_CSS = ".zc-Meeting_Series.tempContDiv .choice-table-row { display: flex !important; flex-direction: row !important; gap: 12px !important; width: 100% !important; margin-bottom: 0 !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row .choice-table-cell { border: 1.5px solid #E5E7EB !important; border-radius: 12px !important; background: #FAFAFA !important; padding: 0px !important; margin: 0 !important; box-shadow: none !important; cursor: pointer !important; flex: 1 !important; box-sizing: border-box !important; overflow: hidden !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row:has(input:checked) .choice-table-cell { border: 2px solid #e8453c !important; background: #fff5f5 !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row:has(input:checked) .choice-label-text { color: #e8453c !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row .choice-table-cell span { display: flex !important; flex-direction: row !important; align-items: center !important; justify-content: space-between !important; gap: 16px !important; width: 100% !important; padding: 20px 24px !important; background: transparent !important; border: none !important; box-shadow: none !important; border-radius: 12px !important; min-height: unset !important; box-sizing: border-box !important; cursor: pointer !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row .choice-table-cell .choice-label-text { display: flex !important; flex-direction: column !important; flex: 1 !important; float: none !important; gap: 4px !important; cursor: pointer !important; font-size: 15px !important; font-weight: 600 !important; color: #111827 !important; margin: 0px !important; padding: 0px !important; order: 1 !important; min-width: 0 !important; } " + ".choice-label-text[for*='Meeting_Series_1_0']::after { content: 'Single occurence' !important; font-size: 13px !important; font-weight: 400 !important; color: #6B7280 !important; line-height: 1.5 !important; display: block !important; margin-top: 3px !important; } " + ".choice-label-text[for*='Meeting_Series_1_1']::after { content: 'Set recurring schedule' !important; font-size: 13px !important; font-weight: 400 !important; color: #6B7280 !important; line-height: 1.5 !important; display: block !important; margin-top: 3px !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row .choice-table-cell input.customRadio { float: none !important; display: flex !important; order: 2 !important; flex-shrink: 0 !important; align-self: center !important; width: 20px !important; height: 20px !important; min-width: 20px !important; margin: 0px !important; padding: 0px !important; cursor: pointer !important; appearance: auto !important; -webkit-appearance: auto !important; accent-color: #e8453c !important; position: static !important; opacity: 1 !important; } " + ".zc-Meeting_Series.tempContDiv .choice-table-row .choice-table-cell input.customRadio + label:not(.choice-label-text) { display: none !important; } ";
										CSS_Overright = "<style>" + meeting_CSS + "</style>";
						)
					}
				}

			
}