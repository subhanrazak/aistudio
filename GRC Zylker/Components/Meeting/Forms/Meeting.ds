form Meeting
{

			displayname = "Meetings"
			success message = "Meeting Added Successfully"
			Meeting_Details
			(
				type = section
				displayname = "Meeting  Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Meeting_Title
			(
    			type = text
				displayname = "Meeting Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_For
			(
				type = picklist
				displayname = "Meeting For"
				maxchar = 100
				values = {"Board","Commitee"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Committee1
			(
				type = picklist	
				displayname = "Committee"
				values  = Committee.ID
    			displayformat = [Committee_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Type
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Regular","Special / Extraordinary","Emergency","Recurring"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"High","Low","Medium"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Organized_By
			(
				type = picklist	
				displayname = "Organized By"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Metting_Series
			(
				type = section
				displayname = "Metting Series"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Meeting_Series
			(
				type = radiobuttons
				displayname = "Meeting Series"
				maxchar = 100
				values = {"One time meeting","Recurring meeting"}
				layout = 2
	 			row = 2
	 			column = 1   
				width = medium
			)
			Recurring_pattern
			(
				type = picklist
				displayname = "Recurring pattern"
				maxchar = 100
				values = {"Monthly","Weekly","Yearly","Two Weeks"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Date_Time
			(
				type = section
				displayname = "Date & Time"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Start_Date_Time
			(
    			type = datetime
				displayname = "Start Date & Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Recurrence_Ends_On
			(
    			type = datetime
				displayname = "Recurrence Ends On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Meeting_Mode
			(
				type = radiobuttons
				displayname = "Meeting Mode"
				maxchar = 100
				values = {"Physical Location","Virtual Meeting","Hybrid Meeting"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			End_Date_Time
			(
    			type = datetime
				displayname = "End Date & Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Venue_Section
			(
				type = section
				displayname = "Venue Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Venue_Building
			(
				type = picklist	
				displayname = "Venue / Building"
				values  = Location.ID
    			displayformat = [Location]
				allow new entries
				[
					displayname = "Add Location"
				]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Integeration
			(
				type = picklist
				maxchar = 100
				values = {"ZOHO Meeting","Google Meet"}
				others option = true
	 			row = 4
	 			column = 1   
				width = medium
			)
			Room_Hall
			(
    			type = text
				displayname = "Room/ Hall"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Meeting_Link
			(
    			type = url
				displayname = "Meeting Link "
				enable  linkname
	 			row = 4
	 			column = 2   
				width = medium
			)
			Attendees
			(
				type = section
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Invite_Members
			(
				type = list	
				displayname = "Invite Members"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				allow new entries
				[
					displayname = "Add Member"
				]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Agenda_setup
			(
				type = section
				displayname = "Agenda setup"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Agenda
			(
				type = picklist	
				values  = Agenda[Added_User == zoho.loginuserid].ID
    			displayformat = [Agenda_Title]
				allow new entries
				[
					displayname = "Add Agenda"
				]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Agenda_Items
			(
				type = grid
				displayname = "Agenda Items"
				values  = Agenda_Item.ID
    			bidirectional = Meeting
	 			row = 7
	 			column = 1   
				width = medium
			)
			Meeting_Attendance
			(
				type = grid
				displayname = "Meeting Attendance"
				values  = Meeting_Attendance.ID
    			bidirectional = Meetings
	 			row = 8
	 			column = 1   
				width = medium
			)
			Quorum_Governance
			(
				type = section
				displayname = "Quorum & Governance"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Quorum
			(
				type = picklist	
				values  = Quorum_Rule.ID
    			displayformat = [Rule_Name]
				sortorder = ascending
	 			row = 9
	 			column = 1   
				width = medium
			)
			Automated_Reminders
			(
				type = checkboxes	
				displayname = "Automated Reminders"
				values = {"1 week before","72 h before","48h before","24h before","3h before","1h before"}
	 			row = 9
	 			column = 1   
				width = medium
			)
			Pre_Meeting_Pack_Send_Date
			(
    			type = date
				displayname = "Pre-Meeting Pack Send Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 2   
				width = medium
			)
			Notifications_Reminders
			(
				type = section
				displayname = "Notifications & Reminders"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Send_calendar_invite_immediately_on_publish
			(
    			type = checkbox
				displayname = "Send calendar invite immediately on publish"
				initial value = false
    			description
    			[
    				type = help_text
    			 	message = "All attendees will receive an email invite"
    			]
	 			row = 10
	 			column = 1   
				width = medium
			)
			Enable_digital_voting_e_resolutions
			(
    			type = checkbox
				displayname = "Enable digital voting / e-resolutions"
				initial value = false
    			description
    			[
    				type = help_text
    			 	message = "Allow board members to vote on resolutions digitally"
    			]
	 			row = 10
	 			column = 1   
				width = medium
			)
			Record_virtual_meeting
			(
    			type = checkbox
				displayname = "Record virtual meeting"
				initial value = false
	 			row = 10
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 11
	 			column = 0   
				width = medium
			)
			MeetingID
			(
				type = picklist	
				values  = Meeting.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 11
	 			column = 1   
				width = medium
			)
			Action_Tracker
			(
				type = number
				displayname = "Action Tracker"
				maxchar = 19
	 			row = 11
	 			column = 1   
				width = medium
			)
			Completed_Stage
			(
				type = picklist
				displayname = "Completed Stage"
				maxchar = 100
				values = {"YetToStart","Meeting_Details","Agenda","Settings","Complete"}
	 			row = 11
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 11
	 			column = 1   
				width = medium
			)
			CSS_Overright
			(
    			type = plaintext
				value = "<div><br /></div>"
	 			row = 11
	 			column = 1   
				width = medium
			)
			Quorum_Status
			(
				type = picklist
				displayname = "Quorum Status"
				maxchar = 100
				values = {"Met","Not Met"}
	 			row = 11
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Draft","Sheduled","Ongoing","Cancelled","Completed"}
				initial value = "Draft"
	 			row = 11
	 			column = 1   
				width = medium
			)
			Duration
			(
    			type = text
	 			row = 11
	 			column = 1   
				width = medium
			)
			Meeting_Chairperson
			(
				type = picklist	
				displayname = "Meeting Chairperson"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 11
	 			column = 2   
				width = medium
			)
			Present
			(
				type = number
	 			row = 11
	 			column = 2   
				width = medium
			)
			Avergage_Attenance
			(
    			type = percentage
				displayname = "Avergage Attenance"
				initial value = 0%
				decimalplace = 0
	 			row = 11
	 			column = 2   
				width = medium
			)
			Total_Members
			(
				type = number
				displayname = "Total Members"
	 			row = 11
	 			column = 2   
				width = medium
			)
			Agenda_Items_Material
			(
				type = picklist
				displayname = "Agenda Items Material"
				maxchar = 100
				values = {"Met","Not Met"}
	 			row = 11
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Continue1
					(
   						type = submit
   						displayname = "Continue"
					)
				}
				on edit
				{
					Continue
					(
   						type = submit
   						displayname = "Continue"
					)
				}
			}
		
}