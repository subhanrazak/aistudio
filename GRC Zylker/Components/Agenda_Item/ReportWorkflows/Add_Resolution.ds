Add_Resolution as "Add Resolution"
{

				type =  functions
				form = Agenda_Item
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						meetingId = 0;
										if(input.Meeting != null)
										{
											meetingId = input.Meeting.toLong();
										}
										agendaItemId = input.ID;
										openUrl("#Page:Action_Page?meeting_id=" + meetingId + "&Agenda_Item=" + agendaItemId + "&mode=resolution&zc_LoadIn=dialog","popup window","width=1400px,height=500px");
					)
					}
				}
			
}