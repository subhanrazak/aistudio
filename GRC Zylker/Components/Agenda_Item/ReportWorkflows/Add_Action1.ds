Add_Action1 as "Add Action"
{

				type =  functions
				form = Agenda_Item
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						agenda = Meeting[ID == input.Meeting];
										openUrl("#Page:Action_Page?meeting_id=" + agenda.ID + "&item_index=0&Action_Item=" + input.ID + "&zc_LoadIn=dialog","popup window","width=1200px");
					)
					}
				}
			
}