Approve4 as "Approve"
{

				type =  functions
				form = Agenda_Item
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						meeting = Meeting[ID == input.Meeting];
										openUrl("#Form:Meeting?recLinkID=" + meeting.ID + "&viewLinkName=Meeting_Report&Action_Field=Action&zc_Header=false&zc_NextUrl=#Script:page.reload","popup window");
					)
					}
				}
			
}