list Agenda_Item_Report
{

			displayName = "Agenda Item Report"
			show all rows from Agenda_Item    
			(
				Item_Title as "Title"
				Type_field as "Type"
				Presenter
				Duration_minutes as "Duration"
				Purpose_Summary as "Purpose / Summary"
				Meeting as "Meetings"
				custom action "Approve"
				(
	  			workflow = Approve4
				show action in edit record menu = true
				column header = "Approve"
				condition = (Status == "Waiting For Approve")
				)
				custom action "Add Action"
				(
	  			workflow = Add_Action1
				show action in edit record menu = true
				column header = "Add Action"
				)
				File_upload as "File upload"
				Meeting.ID
				custom action "Add Resolution"
				(
	  			workflow = Add_Resolution
				show action in edit record menu = true
				column header = "Add Resolution"
				condition = (Status == "Resolution")
				)
			)
		
}