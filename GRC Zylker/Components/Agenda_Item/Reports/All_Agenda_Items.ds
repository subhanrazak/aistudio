default list All_Agenda_Items
{

			displayName = "All Agenda Items"
			show all rows from Agenda_Item    
			(
				Item_Title as "Title"
				Type_field as "Type"
				Duration_minutes as "Duration (minutes)"
				Purpose_Summary as "Purpose / Summary"
				Meeting as "Meetings"
				Presenter
				Status
				File_upload as "File upload"
				Uploader as "Uploaded By"
				Priority
			)
		
}