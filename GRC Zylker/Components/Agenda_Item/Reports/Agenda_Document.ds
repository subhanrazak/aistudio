list Agenda_Document
{

			displayName = "Agenda Document"
			show all rows from Agenda_Item  [File_upload is not null]  
			(
				Item_Title as "Item"
				Type_field as "Type"
				Presenter
				Duration_minutes as "Duration (minutes)"
				Purpose_Summary as "Purpose / Summary"
				Status
				File_upload as "Document"
				Uploader as "Uploaded By"
				Meeting as "Meetings"
				Uploader.User_Display as "Uploader"
				Added_Time as "Date"
			)
		
}