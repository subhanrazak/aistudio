default list KPI_Report
{

			displayName = "KPI"
			show all rows from KPI    
			(
				KPI_ID_Code as "KPI ID Code"
				KPI_Name as "Name"
				Description
				Unit_of_Measurement as "Unit of Measurement"
				Polarity
				Department
				Owner_Responsible_Person as "Owner / Responsible Person"
				Reviewer_Approver as "Reviewer / Approver"
				Linked_Risks as "Link Risks "
				Last_Updated as "Last Updated"
				Next_Review_Date as "Next Review Date"
				Action_Plan_if_any as "Action Plan (if any)"
				Review_Status as "Review Status"
				Additional_Notes_Comments as "Additional Notes / Comments"
				Type_field as "Type"
				Status
				Measurement_Frequency as "Measurement Frequency"
				Baseline_Value as "Baseline Value"
				Target_Value as "Target Value"
				Current_Value as "Current Value"
				Select_Data_Source_Type as "Select Data Source Type"
				Data_Source_Details as "Data Source Details"
				S_No as "S.No"
			)
		
}