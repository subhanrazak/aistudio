get_Strategy as "get Strategy"
{

				type =  form
				form = KPI

				record event = on add or edit

				on user input of Linked_Objective_s
				{
					actions 
					{
						custom deluge script
						(
											if(input.Linked_Objective_s.size() > 0)
										{
											currentStrategies = input.Linked_Strategy;
											strategyList = Strategy[Linked_Objectives == input.Linked_Objective_s].ID.getAll();
											input.Linked_Strategy:ui.add(strategyList);
											input.Linked_Strategy = currentStrategies;
											currentRisk = input.Linked_Risks;
											riskList = Risk_Entry[Objective == input.Linked_Objective_s].ID.getAll();
											input.Linked_Risks:ui.add(riskList);
											input.Linked_Risks = currentRisk;
										}
										else
										{
											clear Linked_Strategy;
											clear Linked_Risks;
										}
						)
					}
				}

			
}