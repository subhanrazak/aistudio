on_delete27 as "on delete"
{

				type =  form
				form = KPI

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("KPI",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.KPI_ID_Code + " - " + input.KPI_Name);
						)
					}
				}

			
}