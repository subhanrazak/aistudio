on_success41 as "on success"
{

				type =  form
				form = KPI

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.KPI_ID_Code = thisapp.Get_ID("KPI",input.ID);
										thisapp.Log.Audit_Log("KPI",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.KPI_ID_Code + " - " + input.KPI_Name);
						)
					}
				}

			
}