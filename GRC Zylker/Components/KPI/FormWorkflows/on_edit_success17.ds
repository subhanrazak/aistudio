on_edit_success17 as "on edit success"
{

				type =  form
				form = KPI

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("KPI",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.KPI_ID_Code + " - " + input.KPI_Name);
						)
					}
				}

			
}