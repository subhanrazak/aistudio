check_date11 as "check date"
{

				type =  form
				form = KPI

				record event = on add or edit

				on user input of Next_Review_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Next_Review_Date != null && input.Next_Review_Date < zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Next_Review_Date = null;
										}
						)
					}
				}

			
}