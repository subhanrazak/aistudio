on_load20 as "on load"
{

				type =  form
				form = KPI

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.style_txt = "<style>.flLeft[type=\"radio\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[type=\"radio\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { background: #F5F4F9;border: 1px solid #F5F4F9; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }</style>";
						)
					}
				}

			
}