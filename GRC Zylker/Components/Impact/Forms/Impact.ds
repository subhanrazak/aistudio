form Impact
{

			success message = "Likelihood Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Label
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Value
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Order
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description1
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}