on_success58 as "on success"
{

				type =  form
				form = Resource_Allocation

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											title = if(input.Assessment_Plan != null,input.Assessment_Plan.Plan_Name,input.Risk_Assessment.Assessment_Title);
										thisapp.Log.Audit_Log("Resource_Allocation",input.ID,"Create",User[Email == zoho.loginuserid].ID,title + " - " + input.Name.Resource);
						)
					}
				}

			
}