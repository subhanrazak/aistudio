default list All_Resource_Allocations
{

			displayName = "All  Resource Allocations"
			show all rows from Resource_Allocation    
			(
				Name
				Planned_Hours as "Planned Hours"
				Resource_Type as "Resource Type"
				User as "Users"
				Availability
				Occupancy
				Hourly_Rate as "Hourly Rate"
				Department
				Assessment_Plan as "Assessment Plan"
				Risk_Assessment as "Risk Assessment"
				Designation
			)
		
}