form Resource_Allocation
{

			displayname = "Resource Allocation"
			success message = "External Resource Allocation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resource_Type
			(
				type = picklist
				displayname = "Resource Type"
				maxchar = 100
				values = {"Internal Resource","External Resource"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			User
			(
				type = picklist	
				displayname = "Users"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Name
			(
				type = picklist	
				values  = Resource.ID
    			displayformat = [" " + Resource]
				allow new entries
				[
					displayname = "Add Resource"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Designation
			(
				type = picklist	
				values  = Designation.ID
    			displayformat = [Designation_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Availability
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Occupancy
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hourly_Rate
			(
				type = decimal
				displayname = "Hourly Rate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Planned_Hours
			(
				type = number
				displayname = "Planned Hours"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}