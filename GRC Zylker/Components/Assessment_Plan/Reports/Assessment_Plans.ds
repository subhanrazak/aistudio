default list Assessment_Plans
{

			displayName = "Assessment Plans"
			show all rows from Assessment_Plan    
			(
				Plan_Name as "Plan Name"
				Description
				Start_Date as "Start Date"
				End_Date as "End Date"
				Link_Objectives as "Link Objectives"
				Link_Strategies as "Link Strategies"
				Budget_Required as "Budget Required"
				Total_Budget_Allocated as "Total Budget Allocated"
				Budget_Shortfall as "Budget Shortfall"
				Plan_Owner as "Plan Owner"
				Planning_Period as "Planning Period"
				Industry_Standards as "Industry Standards"
				Action_Field as "Action Field"
				Stepper_Stage as "Stepper Stage"
				Status
			)
		
}