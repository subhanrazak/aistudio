form Assessment_Plan
{

			displayname = "Assessment Plan"
			success message = ""
			Planning_Section
			(
				type = section
				displayname = "Planning Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Planning_Period
			(
				type = radiobuttons
				displayname = "Planning Period"
				maxchar = 100
				values = {"Annual Plan","Quarterly Plan","Monthly Plan","Multi-year Plan","Custom Period"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Plan_Name_Section
			(
				type = section
				displayname = "Plan Name Section"
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Plan_Name
			(
    			type = text
				displayname = "Plan Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Plan_Owner
			(
				type = picklist	
				displayname = "Plan Owner"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Plan_Description_Section
			(
				type = section
				displayname = "Plan Description Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = large
			)
			Plan_Details
			(
				type = section
				displayname = "Plan Details"
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Link_Objectives
			(
				type = list	
				displayname = "Link Objectives"
				values  = Objective.ID
    			displayformat = [Objective_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
			Link_Strategies
			(
				type = list	
				displayname = "Link Strategies"
				values  = Strategy.ID
    			displayformat = [Strategy_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Department_Coverage
			(
				type = grid
				displayname = "Department Coverage"
				values  = Department_Coverage.ID
    			bidirectional = Assessment_Plan
	 			row = 5
	 			column = 1   
				width = medium
			)
			Risk_Category_Coverage
			(
				type = grid
				displayname = "Risk Category Coverage"
				values  = Risk_Category_Coverage.ID
    			bidirectional = Assessment_Plan
	 			row = 6
	 			column = 1   
				width = medium
			)
			Process_Selection
			(
				type = grid
				displayname = "Process Selection"
				values  = Process_Selection.ID
    			bidirectional = process
	 			row = 7
	 			column = 1   
				width = medium
			)
			Industry_Standards_Section
			(
				type = section
				displayname = "Industry Standards"
	 			row = 8
	 			column = 0   
				width = medium
			)
			Industry_Standards
			(
				type = checkboxes	
				displayname = "Industry Standards"
				values = {"ISO 27001 - Information Security","NIST Cybersecurity Framework","COSO Framework","COBIT Framework"}
				layout = 2
	 			row = 8
	 			column = 1   
				width = medium
			)
			Regulatory_Compliance_Reviews
			(
				type = grid
				displayname = "Regulatory Compliance Reviews"
				values  = Regulatory_Compliance_Reviews.ID
    			bidirectional = Assessment_Plan
	 			row = 9
	 			column = 1   
				width = medium
			)
			Internal_Resources
			(
				type = grid
				displayname = "Internal Resources"
				values  = Resource_Allocation.ID
	 			row = 10
	 			column = 1   
				width = medium
			)
			External_Resources
			(
				type = grid
				displayname = "External Resources"
				values  = Resource_Allocation.ID
	 			row = 11
	 			column = 1   
				width = medium
			)
			Budget_Planning
			(
				type = section
				displayname = "Budget Planning"
				visibility = true
	 			row = 12
	 			column = 0   
				width = medium
			)
			Budget_Required
			(
				type = decimal
				displayname = "Budget Required"
	 			row = 12
	 			column = 1   
				width = medium
			)
			Budget_Categories
			(
				type = grid
				displayname = "Budget Categories"
				values  = Budget_Categories.ID
    			bidirectional = Assessment_Plan
	 			row = 13
	 			column = 1   
				width = medium
			)
			Budget_Amount_Section
			(
				type = section
				displayname = "Budget Amount Section"
	 			row = 14
	 			column = 0   
				width = medium
			)
			Total_Budget_Allocated
			(
				type = decimal
				displayname = "Total Budget Allocated"
	 			row = 14
	 			column = 1   
				width = medium
			)
			Budget_Shortfall
			(
				type = decimal
				displayname = "Budget Shortfall"
	 			row = 14
	 			column = 2   
				width = medium
			)
			Milestone_Planning
			(
				type = grid
				displayname = "Milestone Planning"
				values  = Milestone_Planning.ID
    			bidirectional = Assessment_Plan
	 			row = 15
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 16
	 			column = 0   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Plan Details","Coverage","Compliance","Resource","Budget"}
	 			row = 16
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 16
	 			column = 1   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 16
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Started","In Progress","Completed","Overdue"}
	 			row = 16
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}