check_next_due as "check next due"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on user input of Regulatory_Compliance_Reviews.Next_Due
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(row.Next_Due != null && row.Next_Due < zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											row.Next_Due=null;
										}
						)
					}
				}

			
}