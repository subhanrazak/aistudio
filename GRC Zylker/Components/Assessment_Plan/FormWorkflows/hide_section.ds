hide_section as "hide section"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden_Section,Department_Coverage,External_Resources,Internal_Resources,Risk_Category_Coverage,Process_Selection,Plan_Details,Budget_Amount_Section,Budget_Planning,Industry_Standards_Section,Milestone_Planning,Budget_Categories,Plan_Description_Section,Plan_Name_Section,Planning_Section,Regulatory_Compliance_Reviews;
					}
				}

			
}