get_Departments as "get Departments"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on add row of Department_Coverage
				{
					actions 
					{
						custom deluge script
						(
											departmentList = Department[ID != 0].ID.getAll();
										currentDepartment = input.Department_Coverage.Department.getall();
										departmentList.removeAll(currentDepartment);
										row.Department:ui.add(departmentList);
						)
					}
				}

			
}