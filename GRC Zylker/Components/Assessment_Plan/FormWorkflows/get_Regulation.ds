get_Regulation as "get Regulation"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on add row of Regulatory_Compliance_Reviews
				{
					actions 
					{
						custom deluge script
						(
											regulationList = Regulation[ID != 0].ID.getAll();
										currentRegulation = input.Regulatory_Compliance_Reviews.Regulation.getall();
										regulationList.removeAll(currentRegulation);
										row.Regulation:ui.add(regulationList);
						)
					}
				}

			
}