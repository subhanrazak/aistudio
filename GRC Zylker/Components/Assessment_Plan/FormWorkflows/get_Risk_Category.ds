get_Risk_Category as "get Risk Category"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on add row of Risk_Category_Coverage
				{
					actions 
					{
						custom deluge script
						(
											categoryList = Risk_Category[ID != 0].ID.getAll();
										currentCategory = input.Risk_Category_Coverage.Risk_Category.getall();
										categoryList.removeAll(currentCategory);
										row.Risk_Category:ui.add(categoryList);
						)
					}
				}

			
}