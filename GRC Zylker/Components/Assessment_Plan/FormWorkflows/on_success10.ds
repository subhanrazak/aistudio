on_success10 as "on success"
{

				type =  form
				form = Assessment_Plan

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Stepper_Stage = "Coverage";
										language = thisapp.Content.translation();
										success message language.get("grc.success.planDetails");
										thisapp.Log.Audit_Log("Assessment_Plan",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Plan_Name);
										openUrl("#Page:Assessment_Plan_Page?page_action=add&recid=" + input.ID,"same window");
						)
					}
				}

			
}