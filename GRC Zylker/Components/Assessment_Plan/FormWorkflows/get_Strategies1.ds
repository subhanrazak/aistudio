get_Strategies1 as "get Strategies"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on user input of Link_Objectives
				{
					actions 
					{
						custom deluge script
						(
											if(input.Link_Objectives.size() > 0)
										{
											currentStrategies = input.Link_Strategies;
											strategyList = Strategy[Linked_Objectives == input.Link_Objectives].ID.getAll();
											input.Link_Strategies:ui.add(strategyList);
											input.Link_Strategies = currentStrategies;
										}
										else
										{
											clear Link_Strategies;
										}
						)
					}
				}

			
}