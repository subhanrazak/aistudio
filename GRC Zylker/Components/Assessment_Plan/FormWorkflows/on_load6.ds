on_load6 as "on load"
{

				type =  form
				form = Assessment_Plan

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Plan Details")
											{
												show Plan_Details;
												show Planning_Section;
												show Plan_Name_Section;
												show Plan_Description_Section;
											}
											else if(input.Action_Field == "Coverage")
											{
												show Department_Coverage;
												show Risk_Category_Coverage;
												show Process_Selection;
											}
											else if(input.Action_Field == "Compliance")
											{
												show Industry_Standards_Section;
												show Regulatory_Compliance_Reviews;
											}
											else if(input.Action_Field == "Resource")
											{
												show Internal_Resources;
												show External_Resources;
											}
											else if(input.Action_Field == "Budget")
											{
												show Budget_Planning;
												show Budget_Categories;
												show Budget_Amount_Section;
												show Milestone_Planning;
											}
										}
										hide External_Resources.Assessment_Plan;
										hide External_Resources.User;
										hide External_Resources.Resource_Type;
										hide External_Resources.Risk_Assessment;
										disable External_Resources.Designation;
										disable External_Resources.Department;
										disable External_Resources.Availability;
										disable External_Resources.Occupancy;
										disable External_Resources.Hourly_Rate;
										hide Internal_Resources.Assessment_Plan;
										hide Internal_Resources.User;
										hide Internal_Resources.Resource_Type;
										hide Internal_Resources.Risk_Assessment;
										disable Internal_Resources.Designation;
										disable Internal_Resources.Department;
										disable Internal_Resources.Availability;
										disable Internal_Resources.Occupancy;
										disable Internal_Resources.Hourly_Rate;
										disable Department_Coverage.Last_Assessment;
										disable Department_Coverage.Risk_Level;
										disable Risk_Category_Coverage.Overall_Risk_Score;
										disable Risk_Category_Coverage.Affected_Departments;
										disable Risk_Category_Coverage.Last_Assessed;
										disable Process_Selection.Departments;
										disable Process_Selection.Criticality_Weightage;
										disable Process_Selection.Risk_Category;
										disable Process_Selection.Last_Assessed;
										hide Budget_Categories.Risk_Assessment;
										disable Budget_Categories.Percentage;
										disable Total_Budget_Allocated;
										disable Budget_Shortfall;
										radio_button_style = ".flLeft[name=\"parentOf-Planning_Period\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }";
										planning_style = ".flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { border: 2px solid #E5E7EB;min-width: 176px;text-align: center;padding-top: 48px;padding-bottom:16px;}.flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 2px solid #FB2C36; background:#FFF3F3 }.flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row .choice-table-cell > span > label.choice-label-text::before {  position: absolute; top: 10px; left: 50%; transform: translate(-50%); font-family: 'ZC Live Outline'; font-size: 24px; } .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text::before{content: '\e9f5';}.flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text::before{content: '\ee9e';}.choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text::before{content: '\e944';}.choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text::before{content: '\ef21';} .flLeft[name=\"parentOf-Planning_Period\"] .choice-table-row:nth-child(5) .choice-table-cell > span > label.choice-label-text::before{content: '\e815';}";
										input.style_txt = "<style>" + radio_button_style + planning_style + "</style>";
						)
					}
				}

			
}