on_delete7 as "on delete"
{

				type =  form
				form = Assessment_Plan

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Assessment_Plan",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Plan_Name);
						)
					}
				}

			
}