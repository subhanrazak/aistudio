on_success53 as "on success"
{

				type =  form
				form = Regulatory_Jurisdictions

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Jurisdictions",input.ID,"Create",User[Email == zoho.loginuserid].ID,"");
										openUrl("#Script:page.refresh","same window");
						)
					}
				}

			
}