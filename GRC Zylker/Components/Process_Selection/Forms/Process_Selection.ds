form Process_Selection
{

			displayname = "Process Selection"
			success message = "Process Selection Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			process
			(
				type = picklist	
				values  = Assessment_Plan.ID
    			bidirectional = Process_Selection
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Process_Name
			(
				type = picklist	
				displayname = "Process Name"
				values  = Process[Approval_Status == "Approved"].ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Departments
			(
				type = list	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Criticality_Weightage
			(
    			type = text
				displayname = "Criticality (Weightage)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Category
			(
    			type = text
				displayname = "Risk Category"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Assessed
			(
    			type = text
				displayname = "Last Assessed"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}