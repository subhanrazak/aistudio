on_delete34 as "on delete"
{

				type =  form
				form = Process_Selection

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											plan_name = Assessment_Plan[ID == input.process].Plan_Name;
										process_name = Process[ID == input.Process_Name].Process_Name;
										thisapp.Log.Audit_Log("Process_Selection",input.ID,"Update",User[Email == zoho.loginuserid].ID,plan_name + " - " + process_name);
						)
					}
				}

			
}