on_success49 as "on success"
{

				type =  form
				form = Process_Selection

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Process_Selection",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.process.Plan_Name + " - " + input.Process_Name.Process_Name);
						)
					}
				}

			
}