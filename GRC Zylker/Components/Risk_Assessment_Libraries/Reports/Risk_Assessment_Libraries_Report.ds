default list Risk_Assessment_Libraries_Report
{

			displayName = "Risk Assessment Libraries"
			show all rows from Risk_Assessment_Libraries    
			(
				Objectives
				Start_Date as "Start Date"
				End_Date as "End Date"
				Processes
				Departments
				Risks
				Risk_Assessment as "Risk Assessment"
				Risks_Identified as "Risks Identified"
				Scope_Type as "Scope Type"
				Status
				Progress as "Progress(%)"
				Approval_Status as "Approval Status"
				Approved_By as "Approved By"
				Comments
				Approver_Mail as "Approver Mail"
				Risk_Assessment.ID
			)
		
}