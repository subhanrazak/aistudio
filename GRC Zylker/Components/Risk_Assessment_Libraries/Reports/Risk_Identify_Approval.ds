list Risk_Identify_Approval
{

			displayName = "Risk Identify Approval"
			show all rows from Risk_Assessment_Libraries  [Scope_Type == "Risk" && Approval_Status == "Pending" && Approver_Mail == zoho.loginuserid]  
			(
				Objectives
				Start_Date as "Start Date"
				End_Date as "End Date"
				Processes
				Departments
				Risks as "Risk"
				Risk_Assessment as "Risk Assessment"
				Risks_Identified as "Risks Identified"
				Scope_Type as "Scope Type"
				Status
				Progress as "Progress(%)"
				Approval_Status as "Approval Status"
				custom action "Approve"
				(
	  			workflow = Approve5
				show action in view header = true
				show action in edit record menu = true
				column header = "Approve"
				)
				custom action "Reject"
				(
	  			workflow = Reject5
				show action in view header = true
				show action in edit record menu = true
				column header = "Reject"
				)
			)
			custom actions
			(
				"Approve "
				(
	  			workflow = Approve6
				show action in view header = true
				execute action for collection of records
				)
				"Reject "
				(
	  			workflow = Reject6
				show action in view header = true
				execute action for collection of records
				)
			)
		
}