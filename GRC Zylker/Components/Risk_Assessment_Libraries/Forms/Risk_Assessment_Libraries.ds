form Risk_Assessment_Libraries
{

			displayname = "Risk Assessment Libraries"
			success message = "Risk Assessment Objective Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Scope_Type
			(
				type = picklist
				displayname = "Scope Type"
				maxchar = 100
				values = {"Objective","Department","Risk","Process"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Departments
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Objectives
			(
				type = picklist	
				values  = Objective.ID
    			displayformat = [Objective_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Processes
			(
				type = picklist	
				values  = Process[Approval_Status == "Approved"].ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risks
			(
				type = picklist	
				values  = Risk_Entry[Approval_Status != "Rejected"].ID
    			displayformat = [Risk_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risks_Identified
			(
				type = number
				displayname = "Risks Identified"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","In Progress","Completed"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Progress
			(
				type = decimal
				displayname = "Progress(%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved_By
			(
				type = picklist	
				displayname = "Approved By"
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approver_Mail
			(
    			type = formula
				displayname = "Approver Mail"
				value =  input.Risks.Risk_Owner.Email
				visibility = false
				display type = text
				format = plaintext
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}