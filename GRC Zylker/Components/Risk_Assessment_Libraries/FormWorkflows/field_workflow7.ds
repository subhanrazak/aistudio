field_workflow7 as "field workflow"
{

				type =  form
				form = Risk_Assessment_Libraries

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Scope_Type,Risk_Assessment;
					}
					actions 
					{
						hide Risks_Identified,Status,Progress,Approval_Status,Approved_By,Comments;
					}
				}

			
}