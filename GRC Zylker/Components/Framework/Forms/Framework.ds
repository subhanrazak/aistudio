form Framework
{

			success message = "Framework Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Framework_Name
			(
    			type = text
				displayname = "Framework Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Framework_Type
			(
				type = picklist
				displayname = " Type"
				maxchar = 100
				values = {"Risk","Compliance","IT","Security"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}