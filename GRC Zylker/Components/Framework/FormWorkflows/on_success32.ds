on_success32 as "on success"
{

				type =  form
				form = Framework

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Framework",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Framework_Name);
						)
					}
				}

			
}