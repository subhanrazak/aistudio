on_delete21 as "on delete"
{

				type =  form
				form = Framework

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Framework",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Framework_Name);
						)
					}
				}

			
}