Template_Updated1 as "Template Updated"
{

				type =  form
				form = MOM

				record event = on add or edit

				on user input of Template
				{
					actions 
					{
						custom deluge script
						(
											mom = MOM_Tempelate[ID == input.Template];
										input.Discussion = mom.Tempelate;
						)
					}
				}

			
}