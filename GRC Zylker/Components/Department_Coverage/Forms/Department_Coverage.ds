form Department_Coverage
{

			displayname = "Department Coverage"
			success message = "Department Coverage Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			bidirectional = Department_Coverage
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Level
			(
    			type = text
				displayname = "Risk Level"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Last_Assessment
			(
    			type = text
				displayname = "Last Assessment"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Planned_Period
			(
				type = picklist
				displayname = "Planned Period"
				maxchar = 100
				values = {"Q1","Q2","Q3","Q4"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}