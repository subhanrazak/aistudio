on_success25 as "on success"
{

				type =  form
				form = Department_Coverage

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department_Coverage",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Assessment_Plan.Plan_Name + " - " + input.Department.Department_Name);
						)
					}
				}

			
}