on_edit_success11 as "on edit success"
{

				type =  form
				form = Department_Coverage

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department_Coverage",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Assessment_Plan.Plan_Name + " - " + input.Department.Department_Name);
						)
					}
				}

			
}