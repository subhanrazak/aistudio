form Send_Back_for_Rework
{

			displayname = "Send Back for Rework"
			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Send_back_to_step
			(
				type = radiobuttons
				displayname = "Send back to step"
				maxchar = 100
				values = {"Assessment Initiate","Risk Identify","Inherent Risk","Control Mapping","Control Effectiveness","Risk Treatment"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reason_for_rework
			(
    			type = textarea
				displayname = "Reason for rework"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have What_needs_to_change
			(
    			type = textarea
				displayname = "What needs to change"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				Send_Back
				(
   					type = submit
   					displayname = "Send Back"
				)
			}
		
}