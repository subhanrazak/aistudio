on_load26 as "on load"
{

				type =  form
				form = Send_Back_for_Rework

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										input.plain = "<div><span style='color:#6E7784;'>" + language.get("grc.alert.sendBackAlert") + "</span></div>";
						)
					}
				}

			
}