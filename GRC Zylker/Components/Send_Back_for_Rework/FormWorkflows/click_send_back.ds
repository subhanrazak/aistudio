click_send_back as "click send back"
{

				type =  form
				form = Send_Back_for_Rework
				button = Send_Back
				on click
				{
					actions 
					{
					on click
					(
						riskAss = Risk_Assessment[ID == input.Risk_Assessment];
										riskAss.Reason_for_rework=input.Reason_for_rework;
										riskAss.What_needs_to_change=input.What_needs_to_change;
										riskAss.Work_Sheet_Status=input.Send_back_to_step;
										riskAss.Send_for_Approval=false;
										openUrl("#Page:Risk_Assessment_Page?page_action=openWorkSheet&recid=" + input.Risk_Assessment,"same window");
					)
					}
				}
			
}