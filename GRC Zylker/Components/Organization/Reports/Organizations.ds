default custom Organizations
{

			displayName = "Organizations"
			show all rows from Organization    
			(
				Organization_ID as "Organization ID"
				Organization_Name as " Name"
				Employee_Count as "Employee Count"
				Organization_Size as "Size"
				Organization_Type as "Type"
				Stock_Exchange_Listings as "Stock Exchange Listings"
				Industry_Type as "Industry Type"
				Industry_Sector as "Industry Sector"
				Sub_Sector as "Sub-Sector"
				Logo
				Stepper_Stage as "Stepper Stage"
				Action_Field as "Action Field"
				External_Audit_Provider_Type as "External Audit Provider Type"
				Internal_Audit_Structure as "Internal Audit Structure"
				External_Audit_Frequency as "External Audit Frequency"
				External_Audit_Firm_Name as "External Audit Firm Name"
				Internal_Audit_Frequency as "Internal Audit Frequency"
				Compliance_Review_Scope as "Compliance Review Scope"
				Contact_Phone as "Contact Phone"
				(
					displayformat = plainnumber 
				)
				Contact_Email as "Contact Email"
				Website
				S_No as "S.No"
			)
			custom actions
			(
				"editOrg"
				(
	  			workflow = editOrg
				show action in edit record menu = true
				)
				"View Org"
				(
	  			workflow = View_Org
				)
			)
		
}