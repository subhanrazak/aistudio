form Organization
{

			displayname = "Organizations"
			success message = ""
			Basic_Organization_Details
			(
				type = section
				displayname = "Basic Organization Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Organization_Name
			(
    			type = text
				displayname = " Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Industry_Sector
			(
				type = picklist	
				displayname = "Industry Sector"
				values  = Industry_Sector.ID
    			displayformat = [Industry_Sector]
				allow new entries
				[
					displayname = "Add Industry Sector"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Website
			(
    			type = url
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Industry_Type
			(
				type = picklist
				displayname = "Industry Type"
				maxchar = 100
				values = {"Financial Services","Healthcare","Manufacturing","Technology","Government"}
				others option = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Organization_ID
			(
    			type = text
				displayname = "Organization ID"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sub_Sector
			(
				type = picklist	
				displayname = "Sub-Sector"
				values  = Industry_Sub_Sector.ID
    			displayformat = [Sub_Sector]
				allow new entries
				[
					displayname = "Add Sub-Sector"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Logo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Organization_Scale_Size
			(
				type = section
				displayname = "Organization Scale & Size"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Organization_Size
			(
				type = radiobuttons
				displayname = "Size"
				maxchar = 100
				values = {"Startup (1-50 employees)","Small (51-500 employees)","Medium (501-5,000 employees)","Large (5,001-50,000 employees)","Enterprise (50,000+ employees)"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Organization_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Publicly Traded","Private","Non-Profit","Government"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Employee_Count
			(
				type = number
				displayname = "Employee Count"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Stock_Exchange_Listings
			(
				type = list	
				displayname = "Stock Exchange Listings"
				values  = Stock_Exchange.ID
    			displayformat = [Stock_Exchange]
				allow new entries
				[
					displayname = "Add Stock Exchange"
				]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Address_Information
			(
				type = grid
				displayname = "Address Information"
				values  = Organization_Address.ID
    			bidirectional = Organization
	 			row = 3
	 			column = 1   
				width = medium
			)
			Entities
			(
				type = grid
				values  = Entity.ID
    			bidirectional = Organization
	 			row = 4
	 			column = 1   
				width = medium
			)
			Regulatory_Jurisdictions
			(
				type = grid
				displayname = "Regulatory Jurisdictions"
				values  = Regulatory_Jurisdictions.ID
    			bidirectional = Organization
	 			row = 5
	 			column = 1   
				width = medium
			)
			Risk_Compliance_Frameworks
			(
				type = grid
				displayname = "Risk & Compliance Frameworks"
				values  = Risk_Compliance_Frameworks.ID
    			bidirectional = Organization
	 			row = 6
	 			column = 1   
				width = medium
			)
			Regulatory_Reporting_Requirements
			(
				type = grid
				displayname = "Regulatory Reporting Requirements"
				values  = Regulatory_Reporting_Requirements.ID
    			bidirectional = Organization
	 			row = 7
	 			column = 1   
				width = medium
			)
			Audit_Examination_Requirements
			(
				type = section
				displayname = "Audit & Examination Requirements"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			External_Audit_Provider_Type
			(
				type = picklist
				displayname = "External Audit Provider Type"
				maxchar = 100
				values = {"Big 4 Accounting Firm","National Accounting Firm","Regional Accounting Firm","Local Accounting Firm","Government Audit Office"}
	 			row = 8
	 			column = 1   
				width = medium
			)
			Internal_Audit_Structure
			(
				type = picklist
				displayname = "Internal Audit Structure"
				maxchar = 100
				values = {"Fully Independent","Co-sourced","Outsourced","Hybrid Model","Shared Services"}
	 			row = 8
	 			column = 1   
				width = medium
			)
			External_Audit_Frequency
			(
				type = picklist
				displayname = "External Audit Frequency"
				maxchar = 100
				values = {"Annual","Semi-Annual","Quarterly","Continuous"}
	 			row = 8
	 			column = 2   
				width = medium
			)
			Internal_Audit_Frequency
			(
				type = picklist
				displayname = "Internal Audit Frequency"
				maxchar = 100
				values = {"Continuous","Quarterly","Annual","Risk-Based"}
	 			row = 8
	 			column = 2   
				width = medium
			)
			External_Audit_Firm_Name
			(
    			type = text
				displayname = "External Audit Firm Name"
	 			row = 8
	 			column = 3   
				width = medium
			)
			Compliance_Review_Scope
			(
				type = picklist
				displayname = "Compliance Review Scope"
				maxchar = 100
				values = {"Enterprise-wide","Business Unit Specific","Process Specific","Risk-Based","Regulatory Focused"}
	 			row = 8
	 			column = 3   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
	 			row = 9
	 			column = 0   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Basic Details","Scale","Address","Entity","Regulatory"}
	 			row = 9
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 9
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}