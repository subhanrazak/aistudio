getHeadQuarters as "getHeadQuarters"
{

				type =  form
				form = Organization

				record event = on add or edit

				on add row of Address_Information
				{
					actions 
					{
						custom deluge script
						(
											if(input.Address_Information.count() == 1)
										{
											row.is_head_quarters=true;
										}
						)
					}
				}

			
}