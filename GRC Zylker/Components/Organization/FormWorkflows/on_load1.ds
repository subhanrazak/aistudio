on_load1 as "on load"
{

				type =  form
				form = Organization

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											/* hide Basic_Organization_Details;
										hide Organization_Scale_Size;
										hide Address_Information;
										hide Entities;
										hide Regulatory_Jurisdictions;
										hide Regulatory_Reporting_Requirements;
										hide Risk_Compliance_Frameworks;
										hide Audit_Examination_Requirements; */
										if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Basic Details")
											{
												show Basic_Organization_Details;
											}
											else if(input.Action_Field == "Scale")
											{
												show Organization_Scale_Size;
											}
											else if(input.Action_Field == "Address")
											{
												show Address_Information;
											}
											else if(input.Action_Field == "Entity")
											{
												show Entities;
											}
											else if(input.Action_Field == "Regulatory")
											{
												show Regulatory_Jurisdictions;
												show Regulatory_Reporting_Requirements;
												show Risk_Compliance_Frameworks;
												show Audit_Examination_Requirements;
											}
										}
						)
					}
				}

			
}