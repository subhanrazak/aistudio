check_head_quarters as "check head quarters"
{

				type =  form
				form = Organization

				record event = on add or edit

				on user input of Address_Information.is_head_quarters
				{
					actions 
					{
						custom deluge script
						(
											if(row.is_head_quarters == true)
										{
											for each  rec in input.Address_Information
											{
												if(rec.Address != row.Address)
												{
													rec.is_head_quarters=false;
												}
											}
										}
						)
					}
				}

			
}