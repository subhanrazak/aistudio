hide_fields as "hide fields"
{

				type =  form
				form = Organization

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden_Section,Address_Information,Entities,Regulatory_Jurisdictions,Regulatory_Reporting_Requirements,Basic_Organization_Details,Risk_Compliance_Frameworks,Audit_Examination_Requirements,Organization_Scale_Size;
					}
					actions 
					{
						hide Organization_ID;
					}
				}

			
}