on_delete11 as "on delete"
{

				type =  form
				form = Organization

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Organization",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Organization_ID + " - " + input.Organization_Name);
						)
					}
				}

			
}