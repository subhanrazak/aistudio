organization_validation as "organization validation"
{

				type =  form
				form = Organization

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Organization_Name == "")
										{
											alert(Organization_Name,language.get("grc.organization.organizationNameAlert").toString());
											cancel submit;
										}
										else if(input.Industry_Type == "")
										{
											alert(Industry_Type,language.get("grc.organization.industryTypeAlert").toString());
											cancel submit;
										}
						)
					}
				}

			
}