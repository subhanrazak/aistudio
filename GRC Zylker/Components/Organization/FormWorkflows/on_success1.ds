on_success1 as "on success"
{

				type =  form
				form = Organization

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Organization_ID = thisapp.Get_ID("Organization",input.ID);
										input.Stepper_Stage = "Scale";
										thisapp.Log.Audit_Log("Organization",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Organization_ID + " - " + input.Organization_Name);
										language = thisapp.Content.translation();
										success message language.get("grc.success.basicInformation");
										//openUrl("#Page:Organization_Page?recid=" + input.ID,"same window");
										openUrl("#Page:Preferences?tab=organisations&page_action=add&recid=" + input.ID,"same window");
						)
					}
				}

			
}