View_Org as "View Org"
{

				type =  functions
				form = Organization
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Preferences?tab=organisations&page_action=detailView&recid=" + input.ID,"same window");
					)
					}
				}
			
}