default custom Entities
{

			displayName = "Entities"
			show all rows from Entity    
			(
				Entity_Name as "Name"
				Entity_Code as "Entity Code"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Description
				Employee_Count as "Employee Count"
				Established_Date as "Established Date"
				Primary_Contact_Name as "Primary Contact Name"
				Entity_Manager as "Manager"
				Primary_Contact_Name.Photo
				Organization as "Organizations"
			)
		
}