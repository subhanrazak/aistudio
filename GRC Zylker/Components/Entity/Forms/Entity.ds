form Entity
{

			displayname = "Entities"
			success message = "Entity Added Successfully"
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Organization
			(
				type = picklist	
				displayname = "Organizations"
				values  = Organization.ID
    			bidirectional = Entities
    			displayformat = [Organization_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity_Name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Entity_Code
			(
    			type = text
				displayname = "Entity Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Location
			(
				type = section
				displayname = "Contact & Location"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Primary_Contact_Name
			(
				type = picklist	
				displayname = "Primary Contact Name"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Additional_Information
			(
				type = section
				displayname = "Additional Information"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Employee_Count
			(
				type = number
				displayname = "Employee Count"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Established_Date
			(
    			type = date
				displayname = "Established Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Entity_Manager
			(
				type = picklist	
				displayname = "Manager"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}