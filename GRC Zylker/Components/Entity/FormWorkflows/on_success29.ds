on_success29 as "on success"
{

				type =  form
				form = Entity

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Entity",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Entity_Code + " - " + input.Entity_Name);
						)
					}
				}

			
}