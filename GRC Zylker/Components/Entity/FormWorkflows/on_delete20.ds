on_delete20 as "on delete"
{

				type =  form
				form = Entity

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Entity",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Entity_Code + " - " + input.Entity_Name);
						)
					}
				}

			
}