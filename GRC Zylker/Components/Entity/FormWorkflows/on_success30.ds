on_success30 as "on success"
{

				type =  form
				form = Entity

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Entity",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Entity_Code + " - " + input.Entity_Name);
						)
					}
				}

			
}