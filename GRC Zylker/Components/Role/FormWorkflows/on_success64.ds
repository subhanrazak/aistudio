on_success64 as "on success"
{

				type =  form
				form = Role

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Role",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Role_Name);
						)
					}
				}

			
}