on_delete47 as "on delete"
{

				type =  form
				form = Role

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Role",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Role_Name);
						)
					}
				}

			
}