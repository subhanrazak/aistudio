on_edit_success34 as "on edit success"
{

				type =  form
				form = Role

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Role",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Role_Name);
						)
					}
				}

			
}