form Action_Plan
{

			displayname = "Action Plans"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_ID
			(
    			type = text
				displayname = "Action ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Title
			(
    			type = text
				displayname = " Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Linked_Risks
			(
				type = list	
				displayname = "Linked Risks"
				values  = Risk_Entry.ID
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Linked_Control
			(
				type = list	
				displayname = "Linked Control"
				values  = Control.ID
    			displayformat = [Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Type_field
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Mitigation","Remediation","Preventive","Detective","Improvement"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = radiobuttons
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","In Progress","Completed","Overdue","Deferred"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Progress
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Date
			(
    			type = date
				displayname = "Target Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div><br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Owner
			(
				type = picklist	
				values  = Resource.ID
    			displayformat = [Resource]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Category
			(
				type = picklist
				maxchar = 100
				values = {"Operational","Compliance","Strategic","IT","Financial"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Approver_Email
			(
    			type = formula
				displayname = "Approver Email"
				value =  if(Owner.Resource_Type == "Internal Resource",input.Owner.Internal_Resource.Email,input.Owner.Email)
				visibility = false
				display type = text
				format = plaintext
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}