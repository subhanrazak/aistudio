on_edit_success38 as "on edit success"
{

				type =  form
				form = Action_Plan

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Action_Plan",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Action_ID + " - " + input.Action_Title);
						)
					}
				}

			
}