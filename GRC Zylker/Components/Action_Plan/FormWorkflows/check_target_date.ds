check_target_date as "check target date"
{

				type =  form
				form = Action_Plan

				record event = on add or edit

				on user input of Target_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Target_Date != null && input.Target_Date < zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Target_Date = null;
										}
						)
					}
				}

			
}