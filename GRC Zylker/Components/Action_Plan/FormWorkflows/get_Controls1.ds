get_Controls1 as "get Controls"
{

				type =  form
				form = Action_Plan

				record event = on add or edit

				on user input of Linked_Risks
				{
					actions 
					{
						custom deluge script
						(
											if(input.Linked_Risks.size() > 0)
										{
											input.Linked_Control:ui.add(Risk_Entry[ID == input.Linked_Risks].Link_Controls.getAll());
										}
										else
										{
											clear Linked_Control;
										}
						)
					}
				}

			
}