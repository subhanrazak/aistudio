on_success79 as "on success"
{

				type =  form
				form = Action_Plan

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Action_ID = thisapp.Get_ID("Action_Plan",input.ID);
										thisapp.Log.Audit_Log("Action_Plan",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Action_ID + " - " + input.Action_Title);
						)
					}
				}

			
}