on_delete56 as "on delete"
{

				type =  form
				form = Action_Plan

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Action_Plan",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Action_ID + " - " + input.Action_Title);
						)
					}
				}

			
}