on_load23 as "on load"
{

				type =  form
				form = Action_Plan

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Progress;
										hide Comments;
										if(input.Risk_Assessment != null)
										{
											hide Risk_Assessment;
											//getRiskList = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment && Scope_Type == "Risk" && Approval_Status == "Approved"].Risks.getAll();
											getRiskList = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment && Scope_Type == "Risk"].Risks.getAll();
											input.Linked_Risks:ui.add(getRiskList);
											clear Linked_Control;
											getResource = Resource_Allocation[Risk_Assessment == input.Risk_Assessment].Name.getAll();
											input.Owner:ui.add(getResource);
										}
						)
					}
				}

			
}