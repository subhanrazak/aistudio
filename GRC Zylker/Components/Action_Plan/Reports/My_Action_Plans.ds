list My_Action_Plans
{

			displayName = "My Action Plans"
			show all rows from Action_Plan  [Approver_Email == zoho.loginuserid]  
			(
				Action_ID as "Action ID"
				Action_Title as " Title"
				Owner
				Type_field as "Type"
				Priority
				Description
				Status
				Progress
				Target_Date as "Target Date"
				Risk_Assessment as "Risk Assessment"
				Linked_Risks as "Linked Risks"
				Linked_Control as "Linked Control"
				Category
				custom action "Update Status"
				(
	  			workflow = Update_Status
				show action in edit record menu = true
				column header = "Update Status"
				condition = (Status != "Completed")
				)
			)
		
}