update_risk_appetite as "update risk appetite"
{

				type =  form
				form = Risk_Treatment

				record event = on add

				on user input of Risk_Appetite
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment != null)
										{
											riskAss = Risk_Assessment[ID == input.Risk_Assessment];
											riskAss.Risk_Appetite=input.Risk_Appetite;
										}
						)
					}
				}

			
}