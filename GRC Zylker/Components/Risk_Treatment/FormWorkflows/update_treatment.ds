update_treatment as "update treatment"
{

				type =  form
				form = Risk_Treatment

				record event = on add

				on user input of Treatment_Option
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment != null)
										{
											riskAss = Risk_Assessment[ID == input.Risk_Assessment];
											riskAss.Treatment_Option=input.Treatment_Option;
										}
						)
					}
				}

			
}