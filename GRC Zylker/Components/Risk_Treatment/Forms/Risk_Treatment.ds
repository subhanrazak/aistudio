form Risk_Treatment
{

			displayname = "Risk Treatment"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Treatment_Option
			(
				type = picklist
				displayname = "Treatment Option"
				maxchar = 100
				values = {"Accept","Mitigate","Avoid","Transfer","Escalate","Monitor"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Appetite
			(
				type = picklist
				displayname = "Risk Appetite"
				maxchar = 100
				values = {"Conservative","Moderate","Aggressive"}
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}