form Report_Filter_Govenance
{

			displayname = "Report Filter Govenance"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Search
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Page
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Report
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action"
	 			row = 1
	 			column = 1   
				width = medium
			)
			tab
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 2   
				width = medium
			)
			Committee_Type
			(
				type = picklist	
				displayname = "Committee Type"
				values  = Committee_Type.ID
    			displayformat = [Committee_Type]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = 200px
			)
			User_Status
			(
				type = picklist
				displayname = "User Status"
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Committee
			(
				type = picklist	
				values  = Committee.ID
    			displayformat = [Committee_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Meeting_Type
			(
				type = picklist
				displayname = "Meeting Type"
				maxchar = 100
				values = {"Regular","Special / Extraordinary","Emergency","Recurring"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Agenda_Type
			(
				type = picklist	
				displayname = "Agenda Type"
				values  = Agenda_Type.ID
    			displayformat = [Agenda_Type]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		
}