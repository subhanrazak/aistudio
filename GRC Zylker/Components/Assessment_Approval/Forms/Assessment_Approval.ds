form Assessment_Approval
{

			displayname = "Assessment Approval"
			store data in zc = false
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Field
			(
				type = picklist
				displayname = "Action Field"
				maxchar = 100
				values = {"Assessment Initiate","Risk Identify","Inherent Risk","Control Mapping","Control Effectiveness","Residual Risk","Risk Treatment","Approval"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			style
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Send_back_for_Rework
				(
   					type = button
   					displayname = "Send back for Rework"
				)
				Next
				(
   					type = submit
   					displayname = "Next"
				)
				Approve
				(
   					type = button
   					displayname = "Approve"
				)
				Send_for_Approval
				(
   					type = button
   					displayname = "Send for Approval"
				)
				Waiting_for_Approval
				(
   					type = button
   					displayname = "Waiting for Approval"
				)
				Reject
				(
   					type = button
   					displayname = "Reject"
				)
			}
		
}