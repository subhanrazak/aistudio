send_for_approval as "send for approval"
{

				type =  form
				form = Assessment_Approval
				button = Send_for_Approval
				on click
				{
					actions 
					{
					on click
					(
						assessment = Risk_Assessment[ID == input.Risk_Assessment];
										assessment.Send_for_Approval=true;
										assessment.Current_Work_Sheet_User=null;
										openUrl("#Form:Alert?Action_field=sendForApproval&Risk_Assessment=" + input.Risk_Assessment,"popup window","height=auto,width=auto");
					)
					}
				}
			
}