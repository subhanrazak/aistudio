form Resource
{

			displayname = "Resources"
			success message = "Resource Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Resource_Type
			(
				type = radiobuttons
				displayname = "Resource Type"
				maxchar = 100
				values = {"Internal Resource","External Resource"}
				layout = 2
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internal_Resource_Details
			(
				type = section
				displayname = "Internal Resource Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Internal_Resource
			(
				type = picklist	
				displayname = "Internal Resource"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Resource_Information
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Job_Title
			(
				type = picklist	
				displayname = "Job Title"
				values  = Designation.ID
    			displayformat = [Designation_Name]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Enable_App_Access
			(
    			type = checkbox
				displayname = "Enable App Access"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Employee_Contractor_ID
			(
    			type = text
				displayname = "Employee/Contractor ID"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 3
	 			column = 2   
				width = medium
				personal data = true
			)
			Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 3
	 			column = 2   
				width = medium
			)
			Organization_Information
			(
				type = section
				displayname = "Organization Information"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Company_Vendor
			(
				type = picklist	
				displayname = "Company/Vendor"
				values  = Vendor.ID
    			displayformat = [Vendor_Name]
				allow new entries
				[
					displayname = "Add Vendor"
				]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Manager
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 4
	 			column = 2   
				width = medium
			)
			End_Date_if_contractor
			(
    			type = date
				displayname = "End Date (if contractor)"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Skills_Expertise
			(
				type = grid
				displayname = "Skills & Expertise"
				values  = Skills_Expertise.ID
    			bidirectional = Resource
	 			row = 6
	 			column = 1   
				width = medium
			)
			Certifications_Education
			(
				type = section
				displayname = "Certifications & Education"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Highest_Education_Level
			(
				type = picklist
				displayname = "Highest Education Level"
				maxchar = 100
				values = {"High School","Associate's Degree","Bachelor's Degree","Master's Degree","Doctorate","Professional Degree"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Certifications
			(
    			type = textarea
				height = 100px
	 			row = 7
	 			column = 1   
				width = medium
			)
			Years_of_Experience
			(
				type = number
				displayname = "Years of Experience"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Years_in_Risk_Audit
			(
				type = number
				displayname = "Years in Risk/Audit"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Field_of_Study
			(
    			type = text
				displayname = "Field of Study"
	 			row = 7
	 			column = 2   
				width = medium
			)
			Previous_Assessments
			(
				type = section
				displayname = "Previous Assessments"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Assessment_Experience
			(
    			type = textarea
				displayname = "Assessment Experience"
				height = 100px
	 			row = 8
	 			column = 1   
				width = medium
			)
			Cost_Information
			(
				type = section
				displayname = "Cost Information"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Hourly_Rate
			(
				type = decimal
				displayname = "Hourly Rate"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Contract_Value
			(
				type = decimal
				displayname = "Contract Value"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Currency
			(
				type = picklist
				maxchar = 100
				values = {"USD ($)","INR (₹)","EUR (€)","GBP (£)","JPY (¥)","AUD (A$)","CAD (C$)","CHF (CHF)","CNY (¥)","SGD (S$)","AED (د.إ)","SAR (﷼)","MYR (RM)","THB (฿)","ZAR (R)","NZD (NZ$)","HKD (HK$)","KRW (₩)","SEK (kr)","NOK (kr)"}
	 			row = 9
	 			column = 1   
				width = medium
			)
			Billing_Frequency
			(
				type = picklist
				displayname = "Billing Frequency"
				maxchar = 100
				values = {"Monthly","Weekly","Daily","Hourly","Per Project"}
	 			row = 9
	 			column = 2   
				width = medium
			)
			Contract_Duration
			(
				type = picklist
				displayname = "Contract Duration"
				maxchar = 100
				values = {"3 Months","6 Months","1 Year","2 Years","Ongoing"}
	 			row = 9
	 			column = 2   
				width = medium
			)
			Availability
			(
				type = section
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Hours_per_Week
			(
				type = number
				displayname = "Hours per Week"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Working_Days
			(
				type = checkboxes	
				displayname = "Working Days"
				values = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Additional_Settings
			(
				type = checkboxes	
				displayname = "Additional Settings"
				values = {"Available for immediate assignment","Can work remotely","Willing to travel","Available for overtime work","Send assignment notifications"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Time_Zone
			(
				type = picklist
				displayname = "Time Zone"
				maxchar = 100
				values = {"India Standard Time (IST)","Gulf Standard Time (GST)","Singapore Standard Time (SGT)","Japan Standard Time (JST)","China Standard Time (CST)","Korea Standard Time (KST)","Greenwich Mean Time (GMT)","British Summer Time (BST)","Central European Time (CET)","Eastern Standard Time (EST)","Central Standard Time (CST)","Mountain Standard Time (MST)","Pacific Standard Time (PST)","Australian Eastern Standard Time (AEST)","Australian Western Standard Time (AWST)","Coordinated Universal Time (UTC)"}
				others option = true
	 			row = 10
	 			column = 2   
				width = medium
			)
			Resource
			(
    			type = formula
				value =  if(Resource_Type == "Internal Resource",input.Internal_Resource.Employee_ID + " - " + input.Internal_Resource.Name,input.Employee_Contractor_ID + " - " + input.Name)
				visibility = false
				display type = text
				format = plaintext
	 			row = 10
	 			column = 2   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 11
	 			column = 0   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Basic Information","Skill Experience","Cost Availability"}
	 			row = 11
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 11
	 			column = 1   
				width = medium
			)
			tab
			(
    			type = text
	 			row = 11
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}