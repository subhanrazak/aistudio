on_load28 as "on load"
{

				type =  form
				form = Resource

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Basic Information")
											{
												show Section;
												if(Resource_Type == "External Resource")
												{
													show Basic_Information;
													show Organization_Information;
												}
												show Section1;
											}
											else if(input.Action_Field == "Skill Experience")
											{
												show Skills_Expertise;
												show Certifications_Education;
												show Previous_Assessments;
											}
											else if(input.Action_Field == "Cost Availability")
											{
												show Cost_Information;
												show Availability;
											}
										}
										else
										{
											show Section;
											show Basic_Information;
											show Organization_Information;
											show Section1;
											show Skills_Expertise;
											show Certifications_Education;
											show Previous_Assessments;
											show Cost_Information;
											show Availability;
										}
						)
					}
				}

			
}