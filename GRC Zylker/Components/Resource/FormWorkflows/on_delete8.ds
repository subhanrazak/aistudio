on_delete8 as "on delete"
{

				type =  form
				form = Resource

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Resource",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Resource);
						)
					}
				}

			
}