field_workflow4 as "field workflow"
{

				type =  form
				form = Resource

				record event = on add or edit

				field rules
				{
					actions  (Resource_Type == "Internal Resource" && Action_Field == "Basic Information")
					{
						show Internal_Resource_Details;
					}
					actions  (Resource_Type == "Internal Resource")
					{
						hide Basic_Information,Organization_Information;
					}
					actions 
					{
						hide Availability,Basic_Information,Previous_Assessments,Section1,Hidden_Section,Section,Certifications_Education,Cost_Information,Internal_Resource_Details,Organization_Information,Skills_Expertise;
					}
					actions  (Resource_Type == "External Resource" && Action_Field == "Basic Information")
					{
						show Basic_Information,Organization_Information;
					}
				}

			
}