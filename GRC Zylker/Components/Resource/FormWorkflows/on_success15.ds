on_success15 as "on success"
{

				type =  form
				form = Resource

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Resource",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Resource);
										input.Stepper_Stage = "Skill Experience";
										language = thisapp.Content.translation();
										success message language.get("grc.success.basicInformation");
										openUrl("#Page:Resources_Page?page_action=add&recid=" + input.ID + "&tab=" + input.tab,"same window");
						)
					}
				}

			
}