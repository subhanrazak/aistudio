on_validation as "on validation"
{

				type =  form
				form = Resource

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Resource_Type == "Internal Resource")
										{
											if(input.Internal_Resource == null)
											{
												alert language.get("grc.resource.internalResourceAlert");
												cancel submit;
											}
										}
										else if(input.Resource_Type == "External Resource")
										{
											if(input.Name.first_name == "" || input.Name.last_name == "")
											{
												alert language.get("grc.resource.nameAlert");
												cancel submit;
											}
											if(input.Email == "")
											{
												alert language.get("grc.resource.emailAlert");
												cancel submit;
											}
											if(input.Role == null)
											{
												alert language.get("grc.resource.roleAlert");
												cancel submit;
											}
										}
						)
					}
				}

			
}