get_Skill as "get Skill"
{

				type =  form
				form = Resource

				record event = on add or edit

				on add row of Skills_Expertise
				{
					actions 
					{
						custom deluge script
						(
											skillList = Skill[ID != 0].ID.getAll();
										currentSkill = input.Skills_Expertise.Skill.getall();
										skillList.removeAll(currentSkill);
										row.Skill:ui.add(skillList);
						)
					}
				}

			
}