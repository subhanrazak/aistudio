default list Resources
{

			displayName = "Resources"
			show all rows from Resource    
			(
				Resource_Type as "Resource Type"
				Name 
				Email
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Employee_Contractor_ID as "Employee/Contractor ID"
				Highest_Education_Level as "Highest Education Level"
				Field_of_Study as "Field of Study"
				Certifications
				Years_in_Risk_Audit as "Years in Risk/Audit"
				Years_of_Experience as "Years of Experience"
				Assessment_Experience as "Assessment Experience"
				Hourly_Rate as "Hourly Rate"
				Billing_Frequency as "Billing Frequency"
				Hours_per_Week as "Hours per Week"
				Time_Zone as "Time Zone"
				Working_Days as "Working Days"
				Additional_Settings as "Additional Settings"
				Job_Title as "Job Title"
				Department
				Manager
				End_Date_if_contractor as "End Date (if contractor)"
				Start_Date as "Start Date"
				Notes
				Company_Vendor as "Company/Vendor"
				Contract_Value as "Contract Value"
				Contract_Duration as "Contract Duration"
				Internal_Resource as "Internal Resource"
				Resource
				Role
				Photo
				Currency
				Stepper_Stage as "Stepper Stage"
				Action_Field as "Action Field"
				tab
				Enable_App_Access as "Enable App Access"
			)
		
}