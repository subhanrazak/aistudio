get_Objectives as "get Objectives"
{

				type =  form
				form = Risk_Entry

				record event = on add or edit

				on user input of Department
				{
					actions 
					{
						custom deluge script
						(
											if(Department.size() > 0)
										{
											currentObjectives = input.Objective;
											if(input.Risk_Assessment1 != null)
											{
												assessmentObjectives = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment1].Objectives.getAll();
												objectiveList = Objective[Linked_Departments == input.Department && ID == assessmentObjectives].ID.getAll();
											}
											else
											{
												objectiveList = Objective[Linked_Departments == input.Department].ID.getAll();
											}
											input.Objective:ui.add(objectiveList);
											input.Objective = currentObjectives;
										}
										else
										{
											clear Objective;
										}
						)
					}
				}

			
}