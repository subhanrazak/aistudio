on_load13 as "on load"
{

				type =  form
				form = Risk_Entry

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											clear Objective;
										clear Process;
										if(input.Risk_Assessment1 != null)
										{
											departmentList = Risk_Assessment_Libraries[Risk_Assessment == input.Risk_Assessment1].Departments.getAll();
											input.Department:ui.add(departmentList);
										}
						)
					}
				}

			
}