on_delete5 as "on delete"
{

				type =  form
				form = Risk_Entry

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Entry",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Risk_ID + " - " + input.Risk_Title);
						)
					}
				}

			
}