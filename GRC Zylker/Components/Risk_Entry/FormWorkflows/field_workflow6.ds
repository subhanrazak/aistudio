field_workflow6 as "field workflow"
{

				type =  form
				form = Risk_Entry

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Inherent_Score,Risk_Level,Residual_Risk_Score;
					}
					actions 
					{
						hide Risk_ID,Hidden_Section;
					}
					actions 
					{
						hide Risk_Description,Control_Mapping,Risk_Assessment,Risk_Category,Risk_Context,Risk_Assessment_Section;
					}
				}

			
}