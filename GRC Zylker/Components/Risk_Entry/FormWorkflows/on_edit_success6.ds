on_edit_success6 as "on edit success"
{

				type =  form
				form = Risk_Entry

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Entry",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Risk_ID + " - " + input.Risk_Title);
										actionList = {"Risk Info","Controls"};
										getIndex = if(input.Action_Field != "Templates",actionList.indexOf(input.Action_Field) + 1,null);
										if(input.Stepper_Stage == "Risk Info")
										{
											input.Stepper_Stage = "Controls";
										}
										else if(input.Stepper_Stage == "Controls")
										{
										}
										success message input.Action_Field + " information submitted successfully.";
										currentAction = input.Action_Field;
										input.Action_Field = "";
										if(currentAction != "Controls")
										{
											openUrl("#Page:Risk_Entries_Page?page_action=add&recid=" + input.ID + "&action_field=" + encodeUrl(actionList.get(getIndex)),"same window");
										}
										else
										{
											openUrl("#Page:Risk_Entries_Page?page_action=detailView&recid=" + input.ID,"same window");
										}
						)
					}
				}

			
}