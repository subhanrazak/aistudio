getScore as "getScore"
{

				type =  form
				form = Risk_Entry

				record event = on add or edit

				on user input of Impact
				{
					actions 
					{
						custom deluge script
						(
											if(input.Impact != null && input.Likelihood != null)
										{
											input.Inherent_Score = input.Impact.Value * input.Likelihood.Value;
											input.Risk_Level = Risk_Level[From <= input.Inherent_Score && To >= input.Inherent_Score].ID;
										}
										else
										{
											input.Inherent_Score = null;
										}
						)
					}
				}

			
}