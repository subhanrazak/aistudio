on_load27 as "on load"
{

				type =  form
				form = Risk_Entry

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Risk_Assessment1 != null)
										{
											show Risk_Context;
											show Risk_Description;
											show Risk_Category;
											show Risk_Assessment;
											show Control_Mapping;
										}
										else
										{
											if(input.Action_Field != "" && input.Action_Field != null)
											{
												if(input.Action_Field == "Risk Info")
												{
													show Risk_Context;
													show Risk_Description;
													show Risk_Category;
													show Risk_Assessment;
												}
												else if(input.Action_Field == "Controls")
												{
													show Control_Mapping;
												}
											}
										}
						)
					}
				}

			
}