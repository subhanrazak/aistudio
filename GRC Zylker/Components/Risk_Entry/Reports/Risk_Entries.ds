default list Risk_Entries
{

			displayName = "Risk Entries"
			show all rows from Risk_Entry    
			(
				Business_Unit_Entity as "Business Unit/Entity"
				Department
				Risk_Title as "Title "
				Risk_Description1 as "Description "
				Risk_Impact as "Impact"
				Additional_Notes as "Additional Notes"
				Attachments
				Risk_Category1 as "Category"
				Risk_Owner as "Owner"
				Risk_Tags as "Tags"
				Impact
				Likelihood
				Inherent_Score as "Inherent Risk Score"
				Risk_ID as "Risk ID"
				S_No as "S.No"
				Risk_Level as "Risk Level"
				Approval_Status as "Approval Status"
				Comments
				Approved_By as "Approved By"
				Residual_Risk_Score as "Residual Risk Score"
				Risk_Category2 as "Risk Category"
				Last_Review_Date as "Last Review Date"
				Next_Review_Date as "Next Review Date"
				Stepper_Stage as "Stepper Stage"
				Action_Field as "Action Field"
				Risk_Assessment1 as "Risk Assessment"
			)
		
}