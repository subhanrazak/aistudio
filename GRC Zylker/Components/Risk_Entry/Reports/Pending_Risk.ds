list Pending_Risk
{

			displayName = "Pending Risk"
			show all rows from Risk_Entry  [Approval_Status == "Pending"]  
			(
				Business_Unit_Entity as "Business Unit/Entity"
				Department
				Risk_Title as "Title "
				Risk_Description1 as "Description "
				Risk_Impact as "Impact"
				Additional_Notes as "Additional Notes"
				Attachments
				Risk_Category1 as "Category"
				Risk_Owner as "Owner"
				Risk_Tags as "Tags"
				Impact
				Likelihood
				Inherent_Score as "Inherent Risk Score"
				Risk_ID as "Risk ID"
				S_No as "S.No"
				Risk_Level as "Risk Level"
				Approval_Status as "Approval Status"
				Comments
				Approved_By as "Approved By"
				custom action "Approve"
				(
	  			workflow = Approve2
				show action in edit record menu = true
				column header = "Approve"
				condition = (Approval_Status == "Pending")
				)
				custom action "Reject"
				(
	  			workflow = Reject2
				show action in edit record menu = true
				column header = "Reject"
				condition = (Approval_Status == "Pending")
				)
			)
			custom actions
			(
				"Approve "
				(
	  			workflow = Approval
				show action in view header = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
				"Reject "
				(
	  			workflow = Reject_Workflow
				show action in view header = true
				execute action for collection of records
				condition = (Approval_Status == "Pending")
				)
			)
		
}