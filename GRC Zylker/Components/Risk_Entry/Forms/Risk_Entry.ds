form Risk_Entry
{

			displayname = "Risk Entries"
			success message = ""
			Risk_Assessment_Section
			(
				type = section
				displayname = "Risk Assessment"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Risk_Assessment1
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			displayformat = [Assessment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Context
			(
				type = section
				displayname = "Risk Context"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Business_Unit_Entity
			(
				type = list	
				displayname = "Business Unit/Entity"
				values  = Entity.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = list	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Objective
			(
				type = list	
				values  = Objective.ID
    			bidirectional = Linked_Risks
    			displayformat = [Objective_Title]
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Process
			(
				type = list	
				values  = Process[Approval_Status == "Approved"].ID
    			bidirectional = Associate_Risks
    			displayformat = [Process_Name]
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Risk_Description
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Risk_ID
			(
    			type = text
				displayname = "Risk ID"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Risk_Title
			(
    			type = text
				displayname = "Title "
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Risk_Description1
			(
    			type = textarea
				displayname = "Description "
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Risk_Impact
			(
    			type = textarea
				displayname = "Impact"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Additional_Notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Attachments
			(
    			type = upload file
    			file count = 10
				browse = local_drive
	 			row = 3
	 			column = 1   
				width = medium
			)
			Risk_Category
			(
				type = section
				displayname = "Risk Category"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Risk_Category1
			(
				type = list	
				displayname = "Category"
				values  = Risk_Category.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add Category"
				]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Risk_Owner
			(
				type = picklist	
				displayname = "Owner"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Risk_Tags
			(
				type = list	
				displayname = "Tags"
				values  = Risk_Tag.ID
    			displayformat = [Risk_Tag]
				allow new entries
				[
					displayname = "Add Risk Tag"
				]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = section
				displayname = "Risk Assessment"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Impact
			(
				type = picklist	
				values  = Impact.ID
    			displayformat = [" " + Value + "-" + Label]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Likelihood
			(
				type = picklist	
				values  = Likelihood.ID
    			displayformat = ["  " + Value + "-" + Label]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Inherent_Score
			(
				type = number
				displayname = "Inherent Risk Score"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Risk_Level
			(
				type = picklist	
				displayname = "Risk Level"
				values  = Risk_Level.ID
    			displayformat = [Label]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Control_Mapping
			(
				type = section
				displayname = "Control Mapping"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Link_Controls
			(
				type = list	
				displayname = "Link Controls"
				values  = Control[Approval_Status == "Approved"].ID
    			bidirectional = Link_Risks
    			displayformat = [Control_Name_Title]
				height = 60px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Residual_Risk_Score
			(
				type = number
				displayname = "Residual Risk Score"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 7
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending","Approved","Rejected"}
				initial value = "Pending"
	 			row = 7
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 100px
	 			row = 7
	 			column = 1   
				width = medium
			)
			Approved_By
			(
				type = picklist	
				displayname = "Approved By"
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 7
	 			column = 1   
				width = medium
			)
			Risk_Category2
			(
    			type = formula
				displayname = "Risk Category"
				value =  input.Risk_Category1.Category_Name
				visibility = false
				display type = text
				format = plaintext
	 			row = 7
	 			column = 1   
				width = medium
			)
			Last_Review_Date
			(
    			type = date
				displayname = "Last Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Next_Review_Date
			(
    			type = date
				displayname = "Next Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Risk Info","Controls"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}