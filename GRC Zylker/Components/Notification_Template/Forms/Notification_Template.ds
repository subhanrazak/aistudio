form Notification_Template
{

			displayname = "Notification Template"
			success message = "Notification Template Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Template_Name
			(
    			type = text
				displayname = "Template Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Trigger_Event
			(
				type = picklist
				displayname = "Trigger Event"
				maxchar = 100
				values = {"Approval Request","Approval Granted","Approval Rejected","Escalation","Reminder","SLA Breach"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notification_Channel
			(
				type = picklist
				displayname = "Notification Channel"
				maxchar = 100
				values = {"Email","SMS","Dashboard Notification","Multiple Channels"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority_Level
			(
				type = picklist
				displayname = "Priority Level"
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subject_Line
			(
    			type = text
				displayname = "Subject Line"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Message_Template
			(
    			type = richtext
				displayname = "Message Template"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}