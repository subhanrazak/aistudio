on_edit_success20 as "on edit success"
{

				type =  form
				form = Notification_Template

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Notification_Template",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Template_Name);
						)
					}
				}

			
}