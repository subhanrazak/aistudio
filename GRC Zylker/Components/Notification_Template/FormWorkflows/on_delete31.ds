on_delete31 as "on delete"
{

				type =  form
				form = Notification_Template

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Notification_Template",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Template_Name);
						)
					}
				}

			
}