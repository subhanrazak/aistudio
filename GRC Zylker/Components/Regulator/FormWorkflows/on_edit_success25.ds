on_edit_success25 as "on edit success"
{

				type =  form
				form = Regulator

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulator",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Regulator_Name);
						)
					}
				}

			
}