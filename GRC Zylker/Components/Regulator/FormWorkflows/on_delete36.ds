on_delete36 as "on delete"
{

				type =  form
				form = Regulator

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulator",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Regulator_Name);
						)
					}
				}

			
}