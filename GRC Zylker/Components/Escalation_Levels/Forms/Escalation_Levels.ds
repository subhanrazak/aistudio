form Escalation_Levels
{

			displayname = "Escalation Levels"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Level
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Hours_Next_Escalation
			(
				type = number
				displayname = "Hours Next Escalation"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalation_Template
			(
				type = picklist	
				displayname = "Escalation Template"
				values  = Escalation_Template.ID
    			bidirectional = Escalation_Levels
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}