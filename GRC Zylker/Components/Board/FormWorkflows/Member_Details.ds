Member_Details as "Member Details"
{

				type =  form
				form = Board

				record event = on add or edit

				on user input of Board_Member_Assigment_Management_Two.Member
				{
					actions 
					{
						custom deluge script
						(
											user = User[ID == row.Member];
										row.Member_Type=user.Member_Type;
										disable row.Member_Type;
						)
					}
				}

			
}