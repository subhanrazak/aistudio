Composition_Single as "Composition Single"
{

				type =  form
				form = Board

				record event = on add or edit

				on add row of Member_Assignment_Single
				{
					actions 
					{
						custom deluge script
						(
											usersSelected = input.Member_Assignment_Single.Member.getall();
										allusers = User[ID not in usersSelected].ID.getAll();
										row.Member:ui.add(allusers);
						)
					}
				}

			
}