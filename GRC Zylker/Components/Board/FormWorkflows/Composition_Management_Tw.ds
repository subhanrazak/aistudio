Composition_Management_Tw as "Composition Management-Two"
{

				type =  form
				form = Board

				record event = on add or edit

				on add row of Board_Member_Assigment_Management_Two
				{
					actions 
					{
						custom deluge script
						(
											usersSelected = input.Board_Member_Assigment_Management_Two.Member.getall();
										allusers = User[ID not in usersSelected].ID.getAll();
										row.Member:ui.add(allusers);
						)
					}
				}

			
}