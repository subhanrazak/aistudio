Member_Details3 as "Member Details"
{

				type =  form
				form = Board

				record event = on add or edit

				on user input of Board_Members_Assignment_Advisory.Member
				{
					actions 
					{
						custom deluge script
						(
											user = User[ID == row.Member];
										row.Member_Type=user.Member_Type;
										row.Role1=user.Role;
										row.Member_Type="Independent";
										disable row.Member_Type;
										disable row.Member_Type;
						)
					}
				}

			
}