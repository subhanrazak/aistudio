Composition_Advisory as "Composition Advisory"
{

				type =  form
				form = Board

				record event = on add or edit

				on add row of Board_Members_Assignment_Advisory
				{
					actions 
					{
						custom deluge script
						(
											usersSelected = input.Board_Members_Assignment_Advisory.Member.getall();
										allusers = User[ID not in usersSelected].ID.getAll();
										row.Member:ui.add(allusers);
						)
					}
				}

			
}