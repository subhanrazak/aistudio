Update_Board_Details2 as "Update Board Details"
{

				type =  form
				form = Board

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Completed_Stage = "Details";
										input.Action_Field = "";
										openUrl("#Page:Board_Page?recid=" + input.ID,"same window");
						)
					}
				}

			
}