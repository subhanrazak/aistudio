Test as "Test"
{

				type =  form
				form = Board

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch one record from Board form and get all field names
										collectionVar = Board[ID != 0];
										fieldNames = collectionVar.getFieldNames();
										info fieldNames;
						)
					}
				}

			
}