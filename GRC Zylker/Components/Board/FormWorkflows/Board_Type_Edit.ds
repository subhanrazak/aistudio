Board_Type_Edit as "Board Type Edit"
{

				type =  form
				form = Board

				record event = on edit

				on user input of Board_Type_Board
				{
					actions 
					{
						custom deluge script
						(
											hide CSS_Overright;
										hide Board_Type_Configuration;
										hide Board;
										hide Board_Details;
										hide Composition_Overview_Section;
										hide Single_Heading_Section;
										hide Voting_Section_Single;
										hide Balance_Single;
										hide Board_Diversity_Skills_Single;
										hide Diversity_Targets_Single;
										hide Member_Assignment_Single;
										hide Assign_Key_Roles_Single;
										hide Board_Composition_Two;
										hide Review_Section_Single;
										hide Two_Tyre_Heading_Section_Two;
										hide Board_Diversity_Skills_Two;
										hide Voting_Method_Section_Two;
										hide Board_Member_Assigment_Management_Two;
										hide Assign_Key_Roles_Supervisory_Two;
										hide Assign_Key_Roles_Management_Two;
										hide Diversity_Targets_Two;
										hide Review_Section_Two;
										hide Advisory_Section__Heading_Advisory;
										hide Board_Member_Assigment_Supervisory_Two;
										hide Assign_Key_Roles_Advisory;
										hide mandatory_roles_Section_Advisory;
										hide Board_Members_Assignment_Advisory;
										hide Review_Section_Advisory;
										hide Hidden;
										hide Completed_Stage;
										hide Action_Field;
										hide Board_Composition_Two;
										hide Board_Member_Assigment_Supervisory_Two;
										hide Board_Diversity_Skills_Advisory;
										hide Diversity_Targets_Advisory;
										activeField = input.Action_Field;
										if(activeField == "Edit")
										{
											if(input.Board_Type_Board == "Single-Tier")
											{
												hide CSS_Overright;
												show Board_Type_Configuration;
												hide Single_Heading_Single;
												hide Mandatory_Notes_Single;
												show Board;
												show Board_Details;
												show Composition_Overview_Section;
												show Single_Heading_Section;
												show Voting_Section_Single;
												show Balance_Single;
												show Board_Diversity_Skills_Single;
												show Diversity_Targets_Single;
												show Member_Assignment_Single;
												show Assign_Key_Roles_Single;
											}
											else if(input.Board_Type_Board == "Two-Tier")
											{
												show Board_Type_Configuration;
												hide Two_Heading_Two;
												show Board;
												show Board_Details;
												show Two_Tyre_Heading_Section_Two;
												show Board_Diversity_Skills_Two;
												show Assign_Key_Roles_Management_Two;
												show Voting_Method_Section_Two;
												show Board_Member_Assigment_Management_Two;
												show Board_Member_Assigment_Supervisory_Two;
												show Assign_Key_Roles_Supervisory_Two;
												show Assign_Key_Roles_Management_Two;
												show Board_Composition_Two;
												show Voting_Method_Section_Two;
												show Diversity_Targets_Two;
											}
											else if(input.Board_Type_Board == "Advisory")
											{
												hide Advisory_Heading_Advisory;
												hide mandatory_roles_Notes_Advisory;
												show Board_Type_Configuration;
												show Board;
												show Board_Details;
												show Advisory_Section__Heading_Advisory;
												show Assign_Key_Roles_Advisory;
												show mandatory_roles_Section_Advisory;
												show Board_Diversity_Skills_Advisory;
												show Diversity_Targets_Advisory;
											}
										}
						)
					}
				}

			
}