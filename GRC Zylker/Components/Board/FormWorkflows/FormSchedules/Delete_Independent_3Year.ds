Delete_Independent_3Year as "Delete_Independent_3Year"
{

				type =  schedule
				form = Board
				start = Delete_Record at "00:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						recordsToDelete = Board_Member_Assignment[Member_Type == "Independent"];
										for each  rec in recordsToDelete
										{
											delete from Board_Member_Assignment[ID == rec.ID];
										}
					)
					}
				}
			
}