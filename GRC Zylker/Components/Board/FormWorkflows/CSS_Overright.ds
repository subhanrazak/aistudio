CSS_Overright as "CSS Overright"
{

				type =  form
				form = Board

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											testCSS = "<style>";
										testCSS = testCSS + "body{background:yellow !important;}";
										testCSS = testCSS + ".section-label{color:red !important;font-size:40px !important;background:lime !important;border:5px solid blue !important;padding:20px !important;}";
										testCSS = testCSS + "</style>";
										input.CSS_Overright = testCSS;
						)
					}
				}

			
}