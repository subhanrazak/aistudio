Update_Board_Details1 as "Update Board Details"
{

				type =  form
				form = Board

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											boardType = input.Board_Type_Board;
										actionFld = input.Action_Field;
										nextField = "";
										if(actionFld == "Edit")
										{
											input.Action_Field = "";
											openUrl("#Page:Board_Page","same window");
										}
										else if(actionFld == "Details")
										{
											input.Completed_Stage = "Details";
											input.Action_Field = "";
											openUrl("#Page:Board_Page?action_field=Composition","same window");
										}
										else if(actionFld == "Composition")
										{
											input.Completed_Stage = "Composition";
											input.Action_Field = "";
											openUrl("#Page:Board_Page?action_field=Rules","same window");
										}
										else if(actionFld == "Rules")
										{
											input.Completed_Stage = "Rules";
											input.Action_Field = "";
											openUrl("#Page:Board_Page?action_field=Review","same window");
										}
										else if(actionFld == "Review")
										{
											input.Completed_Stage = "Complete";
											input.Action_Field = "";
											openUrl("#Page:Board_Page?show_popup=1","same window");
										}
										else
										{
											input.Action_Field = "";
											openUrl("#Page:Board_Page","same window");
										}
						)
					}
				}

			
}