form Board
{

			displayname = "Boards"
			success message = "Board Added Successfully"
			Board
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Board_Detail_Notes
			(
    			type = plaintext
				value = "<div><span style=\"white-space: pre-wrap\"><b><span class=\"size\" style=\"font-size: 16px\">Board Details\n</span></b><span style=\"white-space: pre-wrap\"><span class=\"size\" style=\"font-size: 13.3333px\">Choose the governance model that matches your organisation.</span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Board_Name
			(
    			type = text
				displayname = "Board Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Board_Details
			(
				type = section
				displayname = "Board Details"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Industry
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			Jurisdiction
			(
    			type = text
	 			row = 2
	 			column = 2   
				width = medium
			)
			Board_Type_Configuration
			(
				type = section
				displayname = "Board Type Configuration"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Board_Type_Board
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Single-Tier","Two-Tier","Advisory"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Single_Heading_Section
			(
				type = section
				displayname = "Single Heading Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Single_Heading_Single
			(
    			type = plaintext
				value = "<div style=\"max-width: 700px; display: flex; flex-direction: column\"><div style=\"display: flex; align-items: center; background: linear-gradient(135deg, rgb(255, 240, 240), rgb(253, 245, 245)); border: 1.5px solid rgb(240, 176, 176); border-radius: 14px; padding: 18px 24px\"><div style=\"background: rgb(232, 64, 64); border-radius: 12px; width: 50px; height: 50px; flex-shrink: 0; display: flex; align-items: center; justify-content: center\"><div style=\"width: 26px; height: 26px; border-radius: 50%; border: 2px solid white; display: flex; align-items: center; justify-content: center\"><div style=\"width: 12px; height: 12px; border-radius: 50%; border: 2px solid white; display: flex; align-items: center; justify-content: center\"><div style=\"width: 4px; height: 4px; border-radius: 50%; background: white\"><br /></div></div></div></div><div><h3 style=\"margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: rgb(26, 26, 26)\">&nbsp; &nbsp; &nbsp;Single Tier Board <br /></h3><p style=\"margin: 0px; font-weight: 400\"><span class=\"colour\" style=\"color: rgb(85, 85, 85)\"><span class=\"size\" style=\"font-size: 13px; margin: 0px; font-weight: 400\">&nbsp; &nbsp; &nbsp; &nbsp;Unified board with management oversight and strategic direction </span></span><br /></p></div></div></div><div><br /></div>"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Member_Assignment_Single
			(
				type = grid
				displayname = "Board Member Assignment Single"
				values  = Board_Member_Assignment.ID
	 			row = 5
	 			column = 1   
				width = medium
			)
			Composition_Overview_Section
			(
				type = section
				displayname = "Composition Overview Section"
	 			row = 6
	 			column = 0   
				width = medium
			)
			Composition_Overview_Notes
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 6
	 			column = 1   
				width = medium
			)
			Assign_Key_Roles_Single
			(
				type = section
				displayname = "Assign Key Roles"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Chairperson_Single
			(
				type = picklist	
				displayname = "Chairperson"
				values  = User.ID
