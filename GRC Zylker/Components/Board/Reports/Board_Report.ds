list Board_Report
{

			displayName = "Board Report"
			show all rows from Board    
			(
				Board_Type_Board as "Type"
				Board_Name as "Board Name"
				Jurisdiction
				Industry
				Independence_Rules_Single as "Independence Rules"
				Gender_Diversity_Single as "Gender Diversity (%)"
				Ethnic_Diversity_Single as "Ethnic Diversity (%)"
				Chairperson_Single as "Chairperson"
				Company_Secretary_Single as "Company Secretary"
				Director_Single as "Director"
				Committee_Chair_Single as "Committee Chair"
				Chairperson_Supervisory_Two as "Chairperson"
				CEO_Management_Two as "CEO"
				Committee_Chair_Supervisory_Two as "Committee Chair"
				CFO_Mangement_Two as "CFO"
				Management_Member_Two as "Management Member"
				Advisory_Chair_Advisory as "Advisory Chair"
				Advisory_Member_Advisory as "Advisory Member"
				Completed_Stage as "Completed Stage"
				Action_Field as "Action Field"
			)
		
}