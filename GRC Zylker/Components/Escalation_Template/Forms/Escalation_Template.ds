form Escalation_Template
{

			displayname = "Escalation Template"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Escalation_Name
			(
    			type = text
				displayname = "Escalation Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Levels
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Escalation_Levels
			(
				type = grid
				displayname = "Escalation Levels"
				values  = Escalation_Levels.ID
    			bidirectional = Escalation_Template
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}