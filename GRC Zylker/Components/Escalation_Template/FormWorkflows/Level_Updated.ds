Level_Updated as "Level Updated"
{

				type =  form
				form = Escalation_Template

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											rowCount = 0;
										for each  level in input.Escalation_Levels
										{
											rowCount = rowCount + 1;
											level.Level="Level-" + rowCount;
										}
										input.Levels = "Level-" + rowCount;
						)
					}
				}

			
}