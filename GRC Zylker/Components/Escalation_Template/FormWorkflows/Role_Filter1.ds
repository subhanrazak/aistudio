Role_Filter1 as "Role Filter"
{

				type =  form
				form = Escalation_Template

				record event = on add or edit

				on add row of Escalation_Levels
				{
					actions 
					{
						custom deluge script
						(
											subformmrole = input.Escalation_Levels.Role.getall();
										role = Role[ID != 0].ID.getAll();
										addrole = List();
										addrole.addAll(role);
										addrole.removeAll(subformmrole);
										row.Role:ui.add(addrole);
						)
					}
				}

			
}