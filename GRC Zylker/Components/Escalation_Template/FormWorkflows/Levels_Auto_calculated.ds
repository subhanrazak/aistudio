Levels_Auto_calculated as "Levels Auto calculated"
{

				type =  form
				form = Escalation_Template

				record event = on add or edit
					status = inactive

				on add row of Escalation_Levels
				{
					actions 
					{
						custom deluge script
						(
											rowCount = 0;
										for each  level in input.Escalation_Levels
										{
											rowCount = rowCount + 1;
											row.Level="Level-" + rowCount;
										}
										input.Levels = "Level-" + rowCount;
						)
					}
				}

			
}