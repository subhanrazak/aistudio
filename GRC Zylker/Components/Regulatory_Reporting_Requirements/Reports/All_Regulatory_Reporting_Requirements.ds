default list All_Regulatory_Reporting_Requirements
{

			displayName = "All Regulatory Reporting Requirements"
			show all rows from Regulatory_Reporting_Requirements    
			(
				Regulatory_Report as "Regulatory Report"
				Frequency
				Deadline_Date as "Deadline Date"
				Regulator
				Deadline_Type as "Deadline Type"
				Days
				Organization
			)
		
}