on_edit_success28 as "on edit success"
{

				type =  form
				form = Regulatory_Reporting_Requirements

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Reporting_Requirements",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Organization.Organization_Name + " - " + input.Regulatory_Report.Report_Name);
						)
					}
				}

			
}