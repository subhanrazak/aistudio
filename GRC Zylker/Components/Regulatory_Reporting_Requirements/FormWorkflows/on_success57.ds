on_success57 as "on success"
{

				type =  form
				form = Regulatory_Reporting_Requirements

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Regulatory_Reporting_Requirements",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Organization.Organization_Name + " - " + input.Regulatory_Report.Report_Name);
										openUrl("#Script:page.refresh","same window");
						)
					}
				}

			
}