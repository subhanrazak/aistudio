form Regulatory_Reporting_Requirements
{

			displayname = "Regulatory Reporting Requirements"
			success message = "Regulatory Reporting Requirement Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Organization
			(
				type = picklist	
				values  = Organization.ID
    			bidirectional = Regulatory_Reporting_Requirements
    			displayformat = [Organization_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Regulatory_Report
			(
				type = picklist	
				displayname = "Regulatory Report"
				values  = Regulatory_Report.ID
    			displayformat = [Report_Name]
				allow new entries
				[
					displayname = "Add Report"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Frequency
			(
				type = picklist
				maxchar = 100
				values = {"Monthly","Quarterly","Semi-Annual","Annual","Ad-hoc"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Regulator
			(
				type = picklist	
				values  = Regulator.ID
    			displayformat = [Regulator_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Deadline_Type
			(
				type = picklist
				displayname = "Deadline Type"
				maxchar = 100
				values = {"Fixed Date","Relative (X days after period end)"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Deadline_Date
			(
    			type = date
				displayname = "Deadline Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Days
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}