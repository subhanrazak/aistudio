form Stock_Exchange
{

			displayname = "Stock Exchange"
			success message = "Stock Exchange Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Stock_Exchange
			(
    			type = text
				displayname = "Stock Exchange"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}