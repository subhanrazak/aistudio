default list Objectives
{

			displayName = "Objectives"
			show all rows from Objective    
			(
				Objective_ID as "Objective ID"
				Objective_Title as "Title"
				Description
				Objective_Type as "Type"
				Status
				Link_Strategies as "Link Strategies"
				Owner
				Priority
				Start_Date as "Start Date"
				End_Date as "End Date"
				Time_Horizon_Summary as "Time Horizon"
				Linked_Risks as "Link Risks"
				Linked_Controls as "Link Controls"
				Linked_Processes as "Link Processes"
				Progress
				Last_Review_Date as "Last Review Date"
				Next_Review_Date as "Next Review Date"
				Comments_Notes as "Comments / Notes"
				Linked_Documents as "Link Documents"
				Linked_KPIs as "Link KPI"
				Linked_Departments as "Link Departments"
				Progress_Display as "Progress"
				Status_Display as "Status "
				Type_Display as "Type"
				Linked_Risks_Display as "Linked Risks"
				Objective_Details as "Objective Details"
				Modified_Time as "Last Updated"
				(
					displayformat = dateonly
				)
				S_No as "S.No"
				Page_Filter as "Page Filter"
				tab
			)
			custom actions
			(
				"detailView"
				(
	  			workflow = detailView
				)
			)
		
}