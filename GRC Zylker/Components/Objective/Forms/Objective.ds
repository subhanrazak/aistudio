form Objective
{

			displayname = "Objectives"
			success message = "Objective Added Successfully"
			feature property = 32
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Objective_Title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Objective_ID
			(
    			type = text
				displayname = "Objective ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Objective_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Strategic","Operational","Financial","Compliance"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = radiobuttons
				maxchar = 100
				values = {"Active","Planning","On Hold","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Strategy_Entity_Alignment
			(
				type = section
				displayname = "Strategy & Entity Alignment"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Linked_Departments
			(
				type = list	
				displayname = "Link Departments"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Owner
			(
				type = picklist	
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Link_Strategies
			(
				type = list	
				displayname = "Link Strategies"
				values  = Strategy.ID
    			bidirectional = Linked_Objectives
    			displayformat = [Strategy_Title]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Priority
			(
				type = radiobuttons
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Time_Horizon
			(
				type = section
				displayname = "Time Horizon"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Time_Horizon_Summary
			(
    			type = text
				displayname = "Time Horizon Summary"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Performance_Risk_Alignment
			(
				type = section
				displayname = "Performance & Risk Alignment"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Linked_KPIs
			(
				type = list	
				displayname = "Link KPI"
				values  = KPI.ID
    			bidirectional = Linked_Objective_s
    			displayformat = [KPI_Name]
				allow new entries
				[
					displayname = "Add KPI"
				]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Linked_Controls
			(
				type = list	
				displayname = "Link Controls"
				values  = Control[Approval_Status == "Approved"].ID
    			bidirectional = Linked_Objectives
    			displayformat = [Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Linked_Risks
			(
				type = list	
				displayname = "Link Risks"
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			bidirectional = Objective
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Linked_Processes
			(
				type = list	
				displayname = "Link Processes"
				values  = Process[Approval_Status == "Approved"].ID
    			bidirectional = Linked_Objectives
    			displayformat = [Process_Name]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Monitoring_Performance_Tracking
			(
				type = section
				displayname = "Monitoring & Performance Tracking"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Progress
			(
				type = decimal
	 			row = 5
	 			column = 1   
				width = medium
			)
			Progress1
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 5
	 			column = 2   
				width = medium
			)
			Section
			(
				type = section
	 			row = 6
	 			column = 0   
				width = medium
			)
			Last_Review_Date
			(
    			type = date
				displayname = "Last Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Next_Review_Date
			(
    			type = date
				displayname = "Next Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Comments_Notes
			(
    			type = textarea
				displayname = "Comments / Notes"
				height = 100px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Attachments_References
			(
				type = section
				displayname = "Attachments & References"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Linked_Documents
			(
    			type = upload file
				displayname = "Link Documents"
    			file count = 10
				browse = local_drive
	 			row = 7
	 			column = 1   
				width = medium
			)
			External_References
			(
				type = grid
				displayname = "External References"
				values  = Objective_External_References.ID
    			bidirectional = Objective
	 			row = 8
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Objective_Details
			(
    			type = richtext
				displayname = "Objective Details"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Progress_Display
			(
    			type = richtext
				displayname = "Progress"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Status_Display
			(
    			type = richtext
				displayname = "Status "
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Type_Display
			(
    			type = richtext
				displayname = "Type"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Linked_Risks_Display
			(
    			type = richtext
				displayname = "Linked Risks"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			Page_Filter
			(
    			type = textarea
				displayname = "Page Filter"
				height = 100px
	 			row = 9
	 			column = 1   
				width = medium
			)
			tab
			(
    			type = text
	 			row = 9
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}