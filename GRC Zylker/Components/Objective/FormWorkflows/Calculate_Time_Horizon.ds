Calculate_Time_Horizon as "Calculate Time Horizon"
{

				type =  form
				form = Objective

				record event = on add or edit

				on user input of End_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Start_Date != null && input.End_Date != null)
										{
											if(input.Start_Date > input.End_Date)
											{
												alert language.get("grc.date.endDateAlert");
												input.End_Date = null;
												input.Time_Horizon_Summary = "";
											}
											else
											{
												input.Time_Horizon_Summary = (input.Start_Date.daysBetween(input.End_Date) + 1) + " days";
											}
										}
										else
										{
											input.Time_Horizon_Summary = "";
										}
						)
					}
				}

			
}