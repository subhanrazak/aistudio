check_last_review_date as "check last review date"
{

				type =  form
				form = Objective

				record event = on add or edit

				on user input of Last_Review_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Last_Review_Date != null && input.Last_Review_Date > zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Last_Review_Date = null;
										}
						)
					}
				}

			
}