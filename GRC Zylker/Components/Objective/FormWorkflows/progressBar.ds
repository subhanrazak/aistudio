progressBar as "progressBar"
{

				type =  form
				form = Objective

				record event = on add or edit

				on user input of Progress
				{
					actions 
					{
						custom deluge script
						(
											if(input.Progress != null)
										{
											if(input.Progress > 100)
											{
												input.Progress = 100;
											}
											input.Progress1 = "<style>.zcs-progress-bar { height: 8px; background-color: #E2E7EF; } .zcs-progress-bar-indicator { height: inherit; border-radius: inherit; background-color: #ef1617;</style><div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6' style='width:100px;'><p class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-font-14 zcs-font-medium zcs-lh-body zcs-m-0'><span class='zcs-color-primary'>" + input.Progress + "%</span></p><div class='zcs-progress-bar zcs-rounded-sm'><div class='zcs-progress-bar-indicator' style='width: " + input.Progress + "%;'></div></div></div>";
										}
										else
										{
											input.Progress1 = "";
										}
						)
					}
				}

			
}