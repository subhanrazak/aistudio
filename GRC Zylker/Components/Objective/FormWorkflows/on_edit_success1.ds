on_edit_success1 as "on edit success"
{

				type =  form
				form = Objective

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Objective",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Objective_ID + " - " + input.Objective_Title);
										openUrl("#Page:Objective_Page?page_action=detailView&recid=" + input.ID + "&tab=" + input.tab,"same window");
						)
					}
				}

			
}