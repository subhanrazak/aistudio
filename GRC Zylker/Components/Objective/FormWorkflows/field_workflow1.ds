field_workflow1 as "field workflow"
{

				type =  form
				form = Objective

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden_Section;
					}
					actions 
					{
						hide Objective_ID;
					}
					actions 
					{
						hide Last_Review_Date,Next_Review_Date;
					}
					actions 
					{
						disable Time_Horizon_Summary;
					}
				}

			
}