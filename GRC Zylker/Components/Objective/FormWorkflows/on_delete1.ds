on_delete1 as "on delete"
{

				type =  form
				form = Objective

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Objective",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Objective_ID + " - " + input.Objective_Title);
						)
					}
				}

			
}