check_next_review_date as "check next review date"
{

				type =  form
				form = Objective

				record event = on add or edit

				on user input of Next_Review_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Next_Review_Date != null && input.Next_Review_Date < zoho.currentdate || input.Next_Review_Date < input.Start_Date || input.Next_Review_Date > input.End_Date)
										{
											alert language.get("grc.date.dateAlert");
											input.Next_Review_Date = null;
										}
						)
					}
				}

			
}