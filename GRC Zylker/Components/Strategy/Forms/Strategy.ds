form Strategy
{

			displayname = "Strategies"
			success message = "Strategy Added Successfully"
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Strategy_Title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Strategy_ID
			(
    			type = text
				displayname = "Strategy ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Priority_Weightage
			(
				type = radiobuttons
				displayname = "Priority / Weightage"
				maxchar = 100
				values = {"Critical","High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = radiobuttons
				maxchar = 100
				values = {"Not Started","In Progress","On Hold","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Strategic_Category.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add Strategy Category"
				]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Strategy_Description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Ownership_Timeline
			(
				type = section
				displayname = "Ownership & Timeline"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Owner_Responsible_Person
			(
				type = picklist	
				displayname = "Owner / Responsible Person"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Department
			(
				type = list	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Strategic_Linkages
			(
				type = section
				displayname = "Strategic Linkages"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Linked_Objectives
			(
				type = list	
				displayname = "Link Objectives"
				values  = Objective.ID
    			bidirectional = Link_Strategies
    			displayformat = [Objective_Title]
				allow new entries
				[
					displayname = "Add Objective"
				]
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 4
	 			column = 0   
				width = medium
			)
			KPI_s_Link
			(
				type = list	
				displayname = "Link KPI"
				values  = KPI.ID
    			bidirectional = Linked_Strategy
    			displayformat = [KPI_Name]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Risk_s_Linkage
			(
				type = list	
				displayname = "Link Risks"
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			KRI_s_Link
			(
				type = list	
				displayname = "Link KRI"
				values  = KRI.ID
    			bidirectional = Linked_Strategy
    			displayformat = [KRI_Name]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Control_s_Linkage
			(
				type = list	
				displayname = "Link Controls"
				values  = Control[Approval_Status == "Approved"].ID
    			displayformat = [Control_Name_Title]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Review_Schedule
			(
				type = section
				displayname = "Review Schedule"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Review_Frequency
			(
				type = picklist
				displayname = "Review Frequency"
				maxchar = 100
				values = {"Weekly","Monthly","Quarterly","Semi-Annual","Annual"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Next_Review_Date
			(
    			type = date
				displayname = "Next Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Last_Review_Date
			(
    			type = date
				displayname = "Last Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 2   
				width = medium
			)
			Additional_Information
			(
				type = section
				displayname = "Additional Information"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Attachments_Supporting_Documents
			(
    			type = upload file
				displayname = "Attachments / Supporting Documents"
    			file count = 10
				browse = local_drive
	 			row = 6
	 			column = 1   
				width = medium
			)
			Remarks_Comments
			(
    			type = textarea
				displayname = "Remarks / Comments"
				height = 100px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Strategy_Details
			(
    			type = richtext
				displayname = "Strategy Details"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 7
	 			column = 1   
				width = medium
			)
			Status_Display
			(
    			type = richtext
				displayname = "Status"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 7
	 			column = 1   
				width = medium
			)
			Priority_Display
			(
    			type = richtext
				displayname = "Priority"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 7
	 			column = 1   
				width = medium
			)
			Linked_Risks_Display
			(
    			type = richtext
				displayname = "Linked Risks"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 7
	 			column = 1   
				width = medium
			)
			Linked_KPIs_Display
			(
    			type = richtext
				displayname = "Linked KPIs"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 7
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 7
	 			column = 1   
				width = medium
			)
			tab
			(
    			type = text
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}