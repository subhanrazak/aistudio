on_load2 as "on load"
{

				type =  form
				form = Strategy

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											radio_button_style = ".flLeft[type=\"radio\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[type=\"radio\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }";
										priority_field_style = ".flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #fee3e2;border: 1px solid #fee3e2; }.flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #ddffe9;border: 1px solid #ddffe9; } .flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #EFF6FF;border: 1px solid #EFF6FF; } .flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text { background: #fdfae7; border: 1px solid #fdfae7;} .flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #FB2C36; } .flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #16A34A; } .flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #1447E6; }.flLeft[name=\"parentOf-Priority_Weightage\"] .choice-table-row:nth-child(4) .choice-table-cell span input:checked ~ label  { border: 1px solid #FEE685; }";
										status_field_style = ".flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #EFF6FF; border: 1px solid #EFF6FF;} .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #FFEED9; border: 1px solid #FFEED9;} .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #fee3e2;border: 1px solid #fee3e2;} .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(4) .choice-table-cell > span > label.choice-label-text { background: #ddffe9;border: 1px solid #ddffe9; } .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #1447E6; } .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #FC8F01; } .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #FB2C36; } .flLeft[name=\"parentOf-Status\"] .choice-table-row:nth-child(4) .choice-table-cell span input:checked ~ label  { border: 1px solid #16A34A; }";
										input.style_txt = "<style>" + radio_button_style + priority_field_style + status_field_style + "</style>";
						)
					}
				}

			
}