on_success2 as "on success"
{

				type =  form
				form = Strategy

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Strategy_ID = thisapp.Get_ID("Strategy",input.ID);
										thisapp.Log.Audit_Log("Strategy",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Strategy_ID + " - " + input.Strategy_Title);
										openUrl("#Page:Strategy_Page?tab=" + input.tab,"same window");
						)
					}
				}

			
}