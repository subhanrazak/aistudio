on_delete2 as "on delete"
{

				type =  form
				form = Strategy

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Strategy",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Strategy_ID + " - " + input.Strategy_Title);
						)
					}
				}

			
}