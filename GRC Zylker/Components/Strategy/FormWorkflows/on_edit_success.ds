on_edit_success as "on edit success"
{

				type =  form
				form = Strategy

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Strategy",input.ID,"Edit",User[Email == zoho.loginuserid].ID,input.Strategy_ID + " - " + input.Strategy_Title);
										openUrl("#Page:Strategy_Page?page_action=detailView&recid=" + input.ID + "&tab=" + input.tab,"same window");
						)
					}
				}

			
}