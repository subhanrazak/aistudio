getObjectives as "getObjectives"
{

				type =  form
				form = Strategy

				record event = on add or edit

				on user input of Department
				{
					actions 
					{
						custom deluge script
						(
											if(Department.size() > 0)
										{
											currentObjectives = input.Linked_Objectives;
											objectiveList = Objective[Linked_Departments == input.Department].ID.getAll();
											input.Linked_Objectives:ui.add(objectiveList);
											input.Linked_Objectives = currentObjectives;
										}
										else
										{
											clear Linked_Objectives;
										}
						)
					}
				}

			
}