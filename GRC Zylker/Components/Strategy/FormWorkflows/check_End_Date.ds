check_End_Date as "check End Date"
{

				type =  form
				form = Strategy

				record event = on add or edit

				on user input of End_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Start_Date != null && input.End_Date != null)
										{
											if(input.Start_Date > input.End_Date)
											{
												alert language.get("grc.date.endDateAlert");
												input.End_Date = null;
											}
										}
						)
					}
				}

			
}