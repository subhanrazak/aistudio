default list Strategies
{

			displayName = "Strategies"
			show all rows from Strategy    
			(
				Strategy_ID as "Strategy ID"
				Strategy_Title as "Title"
				Strategy_Description as "Description"
				Priority_Weightage as "Priority / Weightage"
				Category
				Owner_Responsible_Person as "Owner / Responsible Person"
				Department
				Start_Date as "Start Date"
				End_Date as "End Date"
				Review_Frequency as "Review Frequency"
				Last_Review_Date as "Last Review Date"
				Next_Review_Date as "Next Review Date"
				Attachments_Supporting_Documents as "Attachments / Supporting Documents"
				Remarks_Comments as "Remarks / Comments"
				Status
				KRI_s_Link as "Link KRI"
				Risk_s_Linkage as "Link Risks"
				Control_s_Linkage as "Link Controls"
				KPI_s_Link as "Link KPI"
				Strategy_Details as "Strategy Details"
				Status_Display as "Status"
				Priority_Display as "Priority"
				Linked_Risks_Display as "Linked Risks"
				Linked_KPIs_Display as "Linked KPIs"
				S_No as "S.No"
				tab
			)
			custom actions
			(
				"detailView"
				(
	  			workflow = detailView1
				)
			)
		
}