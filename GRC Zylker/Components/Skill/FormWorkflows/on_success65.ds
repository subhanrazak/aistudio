on_success65 as "on success"
{

				type =  form
				form = Skill

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Skill",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Skill_Name);
						)
					}
				}

			
}