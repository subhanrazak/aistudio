on_delete48 as "on delete"
{

				type =  form
				form = Skill

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Skill",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Skill_Name);
						)
					}
				}

			
}