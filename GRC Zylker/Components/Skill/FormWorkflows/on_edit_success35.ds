on_edit_success35 as "on edit success"
{

				type =  form
				form = Skill

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Skill",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Skill_Name);
						)
					}
				}

			
}