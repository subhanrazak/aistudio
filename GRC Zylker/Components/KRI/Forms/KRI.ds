form KRI
{

			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			KRI_ID_Code
			(
    			type = text
				displayname = "KRI ID / Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			KRI_Name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_of_Measurement
			(
				type = picklist
				displayname = "Unit of Measurement"
				maxchar = 100
				values = {"Percentage (%)","Currency ($","Count (Number)","Time (Hours / Days)","Rate (per period)","Ratio (X:Y)","Score (1–5, 1–10)","Yes / No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Polarity
			(
				type = picklist
				maxchar = 100
				values = {"Higher is Better","Lower is Better","Target Value(specific number)","Range(within bounds)"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Alignment_Integration
			(
				type = section
				displayname = "Alignment & Integration"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Department
			(
				type = list	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Objective_s
			(
				type = list	
				displayname = "Link Objectives"
				values  = Objective.ID
    			displayformat = [Objective_Title]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Strategy
			(
				type = list	
				displayname = "Link Strategies"
				values  = Strategy.ID
    			bidirectional = KRI_s_Link
    			displayformat = [Strategy_Title]
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Owner_Responsible_Person
			(
				type = picklist	
				displayname = "Owner / Responsible Person"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reviewer_Approver
			(
				type = picklist	
				displayname = "Reviewer / Approver"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Linked_Risks
			(
				type = list	
				displayname = "Link Risks "
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			displayformat = [Risk_Title]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Advanced_Configuration
			(
				type = section
				displayname = "Advanced Configuration"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Last_Updated
			(
    			type = date
				displayname = "Last Updated"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Next_Review_Date
			(
    			type = date
				displayname = "Next Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Action_Plan_if_any
			(
    			type = textarea
				displayname = "Action Plan (if any)"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Review_Status
			(
				type = picklist
				displayname = "Review Status"
				maxchar = 100
				values = {"Current","Pending Review","Overdue","In Progress","Completed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Additional_Notes_Comments
			(
    			type = textarea
				displayname = "Additional Notes / Comments"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}