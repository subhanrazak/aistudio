on_success42 as "on success"
{

				type =  form
				form = KRI

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("KRI",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.KRI_ID_Code + " - " + input.KRI_Name);
						)
					}
				}

			
}