on_delete28 as "on delete"
{

				type =  form
				form = KRI

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("KRI",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.KRI_ID_Code + " - " + input.KRI_Name);
						)
					}
				}

			
}