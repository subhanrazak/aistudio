on_edit_success18 as "on edit success"
{

				type =  form
				form = KRI

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("KRI",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.KRI_ID_Code + " - " + input.KRI_Name);
						)
					}
				}

			
}