form Committee_Escalation
{

			displayname = "Committee Escalation"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Level
			(
				type = picklist	
				values  = Escalation_Levels.ID
    			displayformat = [Level]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member
			(
				type = picklist	
				values  = User[Role.ID == input.Role].ID
    			displayformat = [" " + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hours_Next_Escalation
			(
				type = number
				displayname = "Hours Next Escalation"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Committee
			(
				type = picklist	
				displayname = "Committees"
				values  = Committee.ID
    			bidirectional = Committee_Escalation
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}