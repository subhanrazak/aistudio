form Industry_Sub_Sector
{

			displayname = "Industry Sub-Sector"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Industry_Sector
			(
				type = picklist	
				displayname = "Industry Sector"
				values  = Industry_Sector.ID
    			displayformat = [Industry_Sector]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Sub_Sector
			(
    			type = text
				displayname = "Sub-Sector"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}