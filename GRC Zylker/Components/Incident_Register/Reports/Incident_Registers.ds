default list Incident_Registers
{

			displayName = "Incident Registers"
			show all rows from Incident_Register    
			(
				Incident_ID as "Incident ID"
				Date_Reported as "Date Reported"
				Incident_Title as "Title"
				Date_of_Occurrence as "Date of Occurrence"
				Reported_By as "Reported By"
				Department
				Location
				Category
				Description_of_Incident as "Description of Incident"
				Incident_Type as "Type"
				Financial_Impact_Estimated as "Financial Impact (Estimated)"
				Financial_Impact_Actual as "Financial Impact (Actual)"
				Non_Financial_Impact as "Non-Financial Impact"
				Affected_Process_System as "Affected Process / System"
				Severity_Level as "Severity Level"
				Root_Cause as "Root Cause"
				Method_of_Detection as "Method of Detection"
				Detailed_Root_Cause_Description as "Detailed Root Cause Description"
				Linked_Risk as "Link Risk"
				Linked_Control_if_control_failed as "Link Control (if control failed)"
				Investigator_Type as "Investigator Type"
				Investigator_Responsible_Officer as "Investigator / Responsible Officer"
				Investigator_Responsible_Officer_External  as "Investigator / Responsible Officer"
				Investigation_Status as "Investigation Status"
				Investigation_End_Date as "Investigation End Date"
				Investigation_Start_Date as "Investigation Start Date"
				Investigation_Findings_Summary as "Investigation Findings (Summary)"
				Attach_Evidence as "Attach Evidence"
				Follow_up_Requirements as "Follow-up Requirements"
				Target_Completion_Date as "Target Completion Date"
				Incident_Outcome as "Incident Outcome"
				Closure_Approved_By as "Closure Approved By"
				Preventive_Measures_Implemented as "Preventive Measures Implemented"
				Lessons_Learned as "Lessons Learned"
				Closure_Date as "Closure Date"
				S_No as "S.No"
				Final_Root_Cause_Category as "Final Root Cause Category"
				Status
			)
		
}