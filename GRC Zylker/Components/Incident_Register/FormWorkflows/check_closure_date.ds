check_closure_date as "check closure date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Closure_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Closure_Date != null)
										{
											if(input.Closure_Date < input.Investigation_End_Date || input.Closure_Date > zoho.currentdate)
											{
												alert language.get("grc.date.dateAlert");
												input.Closure_Date = null;
											}
										}
						)
					}
				}

			
}