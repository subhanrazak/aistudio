on_success78 as "on success"
{

				type =  form
				form = Incident_Register

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Incident_Register",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Incident_ID + " - " + input.Incident_Title);
						)
					}
				}

			
}