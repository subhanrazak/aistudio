check_date9 as "check date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Date_Reported
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Date_Reported != null && input.Date_Reported > zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Date_Reported = null;
										}
						)
					}
				}

			
}