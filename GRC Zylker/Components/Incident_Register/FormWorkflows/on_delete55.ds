on_delete55 as "on delete"
{

				type =  form
				form = Incident_Register

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Incident_Register",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Incident_ID + " - " + input.Incident_Title);
						)
					}
				}

			
}