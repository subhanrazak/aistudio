hide_fields7 as "hide fields"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Incident_ID,style_txt;
					}
					actions  (Investigator_Type == "Internal")
					{
						show Investigator_Responsible_Officer;
					}
					actions  (Investigator_Type == "External")
					{
						show Investigator_Responsible_Officer_External;
					}
				}

			
}