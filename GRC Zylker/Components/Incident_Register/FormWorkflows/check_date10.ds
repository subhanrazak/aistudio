check_date10 as "check date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Date_of_Occurrence
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Date_of_Occurrence != null && input.Date_of_Occurrence > zoho.currentdate)
										{
											alert language.get("grc.date.dateAlert");
											input.Date_of_Occurrence = null;
										}
						)
					}
				}

			
}