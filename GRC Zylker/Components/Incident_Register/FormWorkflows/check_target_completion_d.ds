check_target_completion_d as "check target completion date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Target_Completion_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Target_Completion_Date != null)
										{
											if(input.Target_Completion_Date < input.Investigation_End_Date || input.Target_Completion_Date < zoho.currentdate)
											{
												alert language.get("grc.date.dateAlert");
												input.Target_Completion_Date = null;
											}
										}
						)
					}
				}

			
}