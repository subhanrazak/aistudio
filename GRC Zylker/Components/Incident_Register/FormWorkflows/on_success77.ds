on_success77 as "on success"
{

				type =  form
				form = Incident_Register

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Incident_ID = thisapp.Get_ID("Incident",input.ID);
										thisapp.Log.Audit_Log("Incident_Register",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Incident_ID + " - " + input.Incident_Title);
										openUrl("#Page:Incident_Management_Page","same window");
						)
					}
				}

			
}