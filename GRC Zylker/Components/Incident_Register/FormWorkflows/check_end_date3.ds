check_end_date3 as "check end date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Investigation_End_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Investigation_End_Date != null)
										{
											if(input.Investigation_End_Date < input.Date_Reported || input.Investigation_End_Date < input.Date_of_Occurrence || (input.Investigation_Start_Date != null && input.Investigation_Start_Date > input.Investigation_End_Date))
											{
												alert language.get("grc.date.endDateAlert");
												input.Investigation_End_Date = null;
											}
										}
						)
					}
				}

			
}