check_start_date2 as "check start date"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on user input of Investigation_Start_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Investigation_Start_Date != null)
										{
											if(input.Investigation_Start_Date < input.Date_Reported || input.Investigation_Start_Date < input.Date_of_Occurrence || (input.Investigation_End_Date != null && input.Investigation_Start_Date > input.Investigation_End_Date))
											{
												alert language.get("grc.date.startDateAlert");
												input.Investigation_Start_Date = null;
											}
										}
						)
					}
				}

			
}