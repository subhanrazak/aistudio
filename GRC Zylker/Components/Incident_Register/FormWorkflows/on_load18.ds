on_load18 as "on load"
{

				type =  form
				form = Incident_Register

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											radio_button_style = ".flLeft[type=\"radio\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell span { padding-top: 0px !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[type=\"radio\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[type=\"radio\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[type=\"radio\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; }";
										incident_type_style = ".flLeft[name=\"parentOf-Incident_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text,.flLeft[name=\"parentOf-Final_Root_Cause_Category\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { background: #F5F4F9;border: 1px solid #F5F4F9; }.flLeft[name=\"parentOf-Incident_Type\"] .choice-table-row .choice-table-cell span input:checked ~ label,.flLeft[name=\"parentOf-Final_Root_Cause_Category\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }";
										severity_field_style = ".flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(3) .choice-table-cell > span > label.choice-label-text { background: #ddffe9; border: 1px solid #ddffe9; } .flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text { background: #fdfae7; border: 1px solid #fdfae7;} .flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text { background: #fee3e2;border: 1px solid #fee3e2; } .flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(3) .choice-table-cell span input:checked ~ label  { border: 1px solid #16A34A; } .flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(2) .choice-table-cell span input:checked ~ label  { border: 1px solid #FEE685; } .flLeft[name=\"parentOf-Severity_Level\"] .choice-table-row:nth-child(1) .choice-table-cell span input:checked ~ label  { border: 1px solid #FB2C36; }";
										input.style_txt = "<style>" + radio_button_style + incident_type_style + severity_field_style + "</style>";
						)
					}
				}

			
}