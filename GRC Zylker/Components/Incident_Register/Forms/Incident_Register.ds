form Incident_Register
{

			displayname = "Incident Register"
			success message = "Incident Register Added Successfully"
			Basic_Information
			(
				type = section
				displayname = " Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Incident_ID
			(
    			type = text
				displayname = "Incident ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incident_Title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_of_Occurrence
			(
    			type = date
				displayname = "Date of Occurrence"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Operational","Compliance","IT Security","Fraud","Safety","Financial"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description_of_Incident
			(
    			type = textarea
				displayname = "Description of Incident"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incident_Type
			(
				type = radiobuttons
				displayname = "Type"
				maxchar = 100
				values = {"Actual Loss","Near Miss","Breach"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_Reported
			(
    			type = date
				displayname = "Date Reported"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Reported_By
			(
				type = picklist	
				displayname = "Reported By"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Location
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","Under Investigation","Closed","On Hold"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Impact_Severity_Assessment
			(
				type = section
				displayname = "Impact & Severity Assessment"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Financial_Impact_Estimated
			(
				type = decimal
				displayname = "Financial Impact (Estimated)"
				initial value = 0
	 			row = 2
	 			column = 1   
				width = medium
			)
			Non_Financial_Impact
			(
    			type = textarea
				displayname = "Non-Financial Impact"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Affected_Process_System
			(
    			type = text
				displayname = "Affected Process / System"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Severity_Level
			(
				type = radiobuttons
				displayname = "Severity Level"
				maxchar = 100
				values = {"Critical","Major","Minor"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Financial_Impact_Actual
			(
				type = decimal
				displayname = "Financial Impact (Actual)"
				initial value = 0
	 			row = 2
	 			column = 2   
				width = medium
			)
			Root_Cause_Analysis_Investigation
			(
				type = section
				displayname = "Root Cause Analysis & Investigation"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Root_Cause
			(
				type = picklist
				displayname = "Root Cause"
				maxchar = 100
				values = {"Human Error","System Failure","Process Failure","Control Failure","External Factor","Policy Violation","Training Gap"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Detailed_Root_Cause_Description
			(
    			type = textarea
				displayname = "Detailed Root Cause Description"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Linked_Risk
			(
				type = picklist	
				displayname = "Link Risk"
				values  = Risk_Entry[Approval_Status == "Approved"].ID
    			displayformat = [Risk_Title]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Linked_Control_if_control_failed
			(
				type = picklist	
				displayname = "Link Control (if control failed)"
				values  = Control[Approval_Status == "Approved"].ID
    			displayformat = [Control_Name_Title]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Method_of_Detection
			(
				type = picklist
				displayname = "Method of Detection"
				maxchar = 100
				values = {"Internal Audit","System Monitoring","Employee Report","Customer Complaint","Management Review","External Audit","Regulatory Notice"}
	 			row = 3
	 			column = 2   
				width = medium
			)
			Actions_Closure
			(
				type = section
				displayname = "Actions & Closure"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Investigator_Type
			(
				type = picklist
				displayname = "Investigator Type"
				maxchar = 100
				values = {"Internal","External"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Investigator_Responsible_Officer
			(
				type = picklist	
				displayname = "Investigator / Responsible Officer"
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Investigator_Responsible_Officer_External
			(
    			type = name
				displayname = "Investigator / Responsible Officer"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Investigation_Status
			(
				type = picklist
				displayname = "Investigation Status"
				maxchar = 100
				values = {"Not Started","In Progress","Completed","On Hold"}
	 			row = 4
	 			column = 2   
				width = medium
			)
			Section
			(
				type = section
	 			row = 5
	 			column = 0   
				width = medium
			)
			Investigation_Start_Date
			(
    			type = date
				displayname = "Investigation Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Investigation_Findings_Summary
			(
    			type = textarea
				displayname = "Investigation Findings (Summary)"
				height = 100px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Attach_Evidence
			(
    			type = upload file
				displayname = "Attach Evidence"
    			file count = 10
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Investigation_End_Date
			(
    			type = date
				displayname = "Investigation End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 2   
				width = medium
			)
			Mitigation_Corrective_Actions
			(
				type = section
				displayname = "Mitigation / Corrective Actions"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Follow_up_Requirements
			(
    			type = textarea
				displayname = "Follow-up Requirements"
				height = 100px
	 			row = 6
	 			column = 1   
				width = medium
			)
			Target_Completion_Date
			(
    			type = date
				displayname = "Target Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Closure_Lessons_Learned
			(
				type = section
				displayname = "Closure & Lessons Learned"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Incident_Outcome
			(
				type = picklist
				displayname = "Incident Outcome"
				maxchar = 100
				values = {"Resolved","Ongoing","Unresolved"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Final_Root_Cause_Category
			(
				type = radiobuttons
				displayname = "Final Root Cause Category"
				maxchar = 100
				values = {"Human Error","System Failure","Control Gap"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Preventive_Measures_Implemented
			(
    			type = textarea
				displayname = "Preventive Measures Implemented"
				height = 100px
	 			row = 7
	 			column = 1   
				width = medium
			)
			Lessons_Learned
			(
    			type = textarea
				displayname = "Lessons Learned"
				height = 100px
	 			row = 7
	 			column = 1   
				width = medium
			)
			Closure_Date
			(
    			type = date
				displayname = "Closure Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 7
	 			column = 1   
				width = medium
			)
			Closure_Approved_By
			(
				type = picklist	
				displayname = "Closure Approved By"
				values  = User[Status == "Active"].ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 7
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}