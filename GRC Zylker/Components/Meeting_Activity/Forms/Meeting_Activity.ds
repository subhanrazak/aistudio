form Meeting_Activity
{

			displayname = "Meeting Activity"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Agenda
			(
				type = picklist	
				values  = Agenda.ID
    			displayformat = [Agenda_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agenda_Activity
			(
				type = picklist
				displayname = "Agenda Activity"
				maxchar = 100
				values = {"Created","Modified","Published"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting
			(
				type = picklist	
				displayname = "Meetings"
				values  = Meeting.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Activity
			(
				type = picklist
				maxchar = 100
				values = {"Created","Action Item Created","Approved","Action Item Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			User
			(
				type = picklist	
				displayname = "Users"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_Time
			(
    			type = datetime
				displayname = "Date-Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Tracker
			(
				type = picklist	
				displayname = "Action Tracker"
				values  = Action_Tracker.ID
    			displayformat = [Action_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Tracker_Activity
			(
				type = picklist
				displayname = "Action Tracker Activity"
				maxchar = 100
				values = {"Action Item Created","Action Item Completed","Escalated","Acknologement"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}