default list Meeting_Activity_Report
{

			displayName = "Meeting Activity Report"
			show all rows from Meeting_Activity    
			(
				Meeting as "Meetings"
				Activity
				User as "Users"
				Date_Time as "Date-Time"
				Description
				Agenda
				Agenda_Activity as "Agenda Activity"
				Action_Tracker as "Action Tracker"
				Action_Tracker_Activity as "Action Tracker Activity"
			)
		
}