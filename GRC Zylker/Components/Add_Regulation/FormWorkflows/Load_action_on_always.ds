Load_action_on_always as "Load action on always"
{

				type =  form
				form = Add_Regulation

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Identity")
											{
												show Basic_Regulation_Details;
											}
											else if(input.Action_Field == "Versioning")
											{
												show Effective_Versioning_Details;
											}
											else if(input.Action_Field == "Source")
											{
												show Source_Documentation;
											}
											else if(input.Action_Field == "Risk & Scope")
											{
												show Risk_Impact_Classification;
												show Business_Applicability;
											}
											else if(input.Action_Field == "Ownership")
											{
												show Compliance_Ownership;
											}
											else if(input.Action_Field == "Obligations")
											{
												show Obligations;
											}
										}
						)
					}
				}

			
}