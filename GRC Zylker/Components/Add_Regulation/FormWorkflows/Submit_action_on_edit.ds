Submit_action_on_edit as "Submit action on edit"
{

				type =  form
				form = Add_Regulation

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											actionList = {"Identity","Versioning","Source","Risk & Scope","Ownership","Obligations"};
										getIndex = if(input.Action_Field != actionList.get(actionList.size() - 1),actionList.indexOf(input.Action_Field) + 1,null);
										if(input.Stepper_Stage != actionList.get(actionList.size() - 1))
										{
											input.Stepper_Stage = actionList.get(actionList.indexOf(input.Stepper_Stage));
										}
										success message input.Action_Field + " information submitted successfully.";
										currentAction = input.Action_Field;
										input.Action_Field = "";
										if(currentAction != actionList.get(actionList.size() - 1))
										{
											openUrl("#Page:Regulatory_Inventory?page_action=add&recid=" + input.ID + "&action_field=" + encodeUrl(actionList.get(getIndex)),"same window");
										}
										else
										{
											openUrl("#Page:Regulatory_Inventory?page_action=detailView&recid=" + input.ID,"same window");
										}
						)
					}
				}

			
}