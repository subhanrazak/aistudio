Submit_action_on_add as "Submit action on add"
{

				type =  form
				form = Add_Regulation

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Regulation_ID = thisapp.Get_ID("Regulation",input.ID);
										input.Stepper_Stage = "Versioning";
										// thisapp.Log.Audit_Log("Process",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Process_ID + " - " + input.Process_Name);
										// language = thisapp.Content.translation();
										// success message language.get("grc.success.processInformation");
										openUrl("#Page:Regulatory_Inventory?page_action=add&recid=" + input.ID,"same window");
						)
					}
				}

			
}