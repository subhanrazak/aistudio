Field_action_on_always as "Field action on always"
{

				type =  form
				form = Add_Regulation

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Hidden_Section,Basic_Regulation_Details,Effective_Versioning_Details,Source_Documentation,Risk_Impact_Classification,Business_Applicability,Compliance_Ownership,Obligations;
					}
				}

			
}