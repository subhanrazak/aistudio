form Add_Regulation
{

			displayname = "Add Regulation"
			success message = "Data Added Successfully!"
			Basic_Regulation_Details
			(
				type = section
				displayname = "Basic Regulation Details "
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Regulation_Name
			(
    			type = text
				displayname = "Regulation Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Regulator
			(
				type = list	
				values  = Add_Regulator.ID
    			displayformat = [Regulator_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Jurisdiction
			(
				type = list	
				values  = Add_Jurisdiction.ID
    			displayformat = [Jurisdiction_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Applicable_Entity_License_Type
			(
				type = list	
				displayname = "Applicable Entity / License Type"
				values  = Add_Applicable_Entity.ID
    			displayformat = [Applicable_Entity]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Short_Name
			(
    			type = text
				displayname = "Short Name"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Category
			(
				type = list	
				values  = Add_Regulation_Category.ID
    			displayformat = [Jurisdiction_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Industry_Type
			(
				type = list	
				displayname = "Industry Type"
				values  = Add_Industry_Type.ID
    			displayformat = [Industry_Type]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Effective_Versioning_Details
			(
				type = section
				displayname = "Effective & Versioning Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Original_Effective_Date
			(
    			type = date
				displayname = "Original Effective Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Version_Number
			(
    			type = text
				displayname = "Version Number"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Review_Cycle
			(
				type = picklist
				displayname = "Review Cycle"
				maxchar = 100
				values = {"Monthly","Quarterly","Semi-Annual","Annual","Biennial","Ad Hoc"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Regulation_Status
			(
				type = picklist
				displayname = "Regulation Status"
				maxchar = 100
				values = {"Draft","Under Review","Active","Superseded","Archived","Retired"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Latest_Amendment_Date
			(
    			type = date
				displayname = "Latest Amendment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Supersedes_Regulation
			(
				type = list	
				displayname = "Supersedes Regulation"
				values  = Add_Regulation.ID
    			displayformat = [Regulation_Name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Sunset_Date
			(
    			type = date
				displayname = "Sunset Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			Lifecycle_Notes
			(
    			type = textarea
				displayname = "Lifecycle Notes"
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Detailed description of the strategy, including objectives, scope, \nand expected outcomes..."
    			]
	 			row = 2
	 			column = 2   
				width = medium
			)
			Source_Documentation
			(
				type = section
				displayname = "Source & Documentation"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Regulator_Reference_Number
			(
    			type = text
				displayname = "Regulator Reference Number"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Official_Link_URL
			(
    			type = url
				displayname = "Official Link (URL)"
				enable  linkname
	 			row = 3
	 			column = 1   
				width = medium
			)
			Publication_Date
			(
    			type = date
				displayname = "Publication Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Upload_Internal_Interpretation_Memo
			(
    			type = textarea
				displayname = "Upload Internal Interpretation Memo"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Circular_Notification_Number
			(
    			type = text
				displayname = "Circular / Notification Number"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Upload_Regulator_Document
			(
    			type = upload file
				displayname = "Upload Regulator Document"
    			file count = 10
				browse = local_drive
	 			row = 3
	 			column = 2   
				width = medium
			)
			Last_Updated_from_regulator
			(
    			type = date
				displayname = "Last Updated (from regulator)"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Risk_Impact_Classification
			(
				type = section
				displayname = "Risk & Impact Classification"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Inherent_Risk_Level
			(
				type = picklist
				displayname = "Inherent Risk Level"
				maxchar = 100
				values = {"Critical","High","Medium","Low"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Penalty_Exposure
			(
				type = list	
				displayname = "Penalty Exposure"
				values  = Add_Penalty_Exposure.ID
    			displayformat = [Penalty_Exposure]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Estimated_Financial_Exposure_optional
			(
				type = decimal
				displayname = "Estimated Financial Exposure (optional)"
	 			row = 4
	 			column = 2   
				width = medium
			)
			Impact_Area
			(
				type = list	
				displayname = "Impact Area"
				values  = Add_Impact_Area.ID
    			displayformat = [Impact_Area_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 2   
				width = medium
			)
			Business_Applicability
			(
				type = section
				displayname = "Business Applicability"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Business_Units
			(
				type = list	
				displayname = "Business Units"
				values  = Add_Business_Unit.ID
    			displayformat = [Business_Unit_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 1   
				width = medium
			)
			Department
			(
				type = list	
				displayname = "Departments"
				values  = Department.ID
    			displayformat = [Department_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 60px
	 			row = 5
	 			column = 2   
				width = medium
			)
			Compliance_Ownership
			(
				type = section
				displayname = "Compliance Ownership"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Regulation_Owner
			(
				type = picklist	
				displayname = "Regulation Owner"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 6
	 			column = 1   
				width = medium
			)
			Board_Reporting_Required
			(
				type = radiobuttons
				displayname = "Board Reporting Required?"
				maxchar = 100
				values = {"Yes","No"}
				initial value = "Yes"
	 			row = 6
	 			column = 1   
				width = medium
			)
			Owner_Governance_Notes
			(
    			type = textarea
				displayname = "Owner / Governance Notes"
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Detailed description of the strategy, including objectives, scope, \nand expected outcomes..."
    			]
	 			row = 6
	 			column = 1   
				width = medium
			)
			Secondary_Owner
			(
				type = picklist	
				displayname = "Secondary Owner / Coordinator"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 6
	 			column = 2   
				width = medium
			)
			Escalation_Matrix_Applicable_Use_predefined_escalation_matrix_template
			(
				type = picklist
				displayname = "Escalation Matrix Applicable (Use predefined escalation matrix template)"
				maxchar = 100
				values = {"Liquidity Breach Escalation (L1/L2/L3)","Regulatory Reporting Delay Matrix","Generic Compliance Escalation Matrix"}
	 			row = 6
	 			column = 2   
				width = medium
			)
			Obligations
			(
				type = grid
				values  = Regulatory_Obligations.ID
    			bidirectional = Regulation
	 			row = 7
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Identity","Versioning","Source","Risk & Scope","Ownership","Obligations"}
	 			row = 8
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Regulation_ID
			(
    			type = text
				displayname = "Regulation ID"
	 			row = 8
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S No"
				start index = 1
	 			row = 8
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}