default list All_Agenda_Item_Details
{

			displayName = "All Agenda Item Details"
			show all rows from Agenda_Item_Details    
			(
				Item_Title
				Type_field as "Type"
				Presenter
				Duration_minutes as "Duration (minutes)"
				Priority
				Description
				Agenda
				File_upload as "File upload"
				Uploader
			)
		
}