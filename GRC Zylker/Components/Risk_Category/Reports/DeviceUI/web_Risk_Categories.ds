{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Order
								Category_Name as "Name"
								Category_Code as "Category Code"
								Risk_Appetite as " Risk Appetite"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Category_Name as "Name"
								Category_Code as "Category Code"
								Order
								Status
								Description
								Risk_Appetite as " Risk Appetite"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			
}