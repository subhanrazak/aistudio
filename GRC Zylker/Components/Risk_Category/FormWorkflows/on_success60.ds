on_success60 as "on success"
{

				type =  form
				form = Risk_Category

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Category",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Category_Name);
						)
					}
				}

			
}