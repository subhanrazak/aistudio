on_delete44 as "on delete"
{

				type =  form
				form = Risk_Category

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Category",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Category_Name);
						)
					}
				}

			
}