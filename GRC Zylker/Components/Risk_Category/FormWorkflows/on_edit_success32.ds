on_edit_success32 as "on edit success"
{

				type =  form
				form = Risk_Category

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Category",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Category_Name);
						)
					}
				}

			
}