form Risk_Category
{

			displayname = "Risk Categories"
			success message = "Risk Category Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Category_Name
			(
    			type = text
				displayname = "Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Order
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			unique Category_Code
			(
    			type = text
				displayname = "Category Code"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Risk_Appetite
			(
				type = picklist
				displayname = " Risk Appetite"
				maxchar = 100
				values = {"Conservative","Moderate","Aggressive"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}