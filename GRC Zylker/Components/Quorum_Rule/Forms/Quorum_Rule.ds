form Quorum_Rule
{

			displayname = "Quorum Rules"
			success message = "Quorum Rule Added Successfully"
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span style=\"white-space: pre-wrap\"><span class=\"size\" style=\"font-size: 16px\"><b>Create Quorum Rules\n </b></span><span style=\"white-space: pre-wrap\">Set up governance rules for committee membership requirements and voting thresholds\n</span></span><br /><span style=\"white-space: pre-wrap\"><span class=\"size\" style=\"font-size: 16px\"><b>Select Committee\n</b></span><span class=\"size\" style=\"font-size: 13.3333px\">Define comprehensive control details and configuration</span></span><span class=\"size\" style=\"font-size: 13.3333px\"><br /></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rule_Naming
			(
				type = section
				displayname = "Rule Naming"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Rule_Name
			(
    			type = text
				displayname = "Rule Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Committee
			(
				type = picklist	
				values  = Committee.ID
    			displayformat = [Committee_Name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Rule_Description
			(
    			type = textarea
				displayname = "Rule Description"
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Membership_Requirements
			(
				type = section
				displayname = "Membership Requirements"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Minimum_Voting_Members
			(
				type = number
				displayname = "Minimum Voting Members"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Minimum_Independent_Members
			(
				type = number
				displayname = "Minimum Independent Members"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Minimum_Total_Members
			(
				type = number
				displayname = "Minimum Total Members"
	 			row = 3
	 			column = 2   
				width = medium
			)
			must have Minimum_Non_Executive_Members
			(
				type = number
				displayname = "Minimum Non-Executive Members"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Current_Committee_Status
			(
				type = section
				displayname = "Current Committee Status"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Committee_Status
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Chair_Requirements
			(
				type = section
				displayname = "Chair Requirements"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Chair_is_mandatory_for_meetings
			(
    			type = checkbox
				displayname = "Chair is mandatory for meetings"
				initial value = false
    			description
    			[
    				type = help_text
    			 	message = "Meeting cannot proceed without chair present"
    			]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Chair_must_be_non_executive
			(
    			type = checkbox
				displayname = "Chair must be non-executive"
				initial value = false
    			description
    			[
    				type = help_text
    			 	message = "Ensure independent leadership of the committee"
    			]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Allow_proxy_voting
			(
    			type = checkbox
				displayname = "Allow proxy voting"
				initial value = false
    			description
    			[
    				type = help_text
    			 	message = "Members can vote through authorized proxy if absent"
    			]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Approval_Publishing
			(
				type = section
				displayname = "Approval & Publishing"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			I_confirm_this_information_is_correct
			(
    			type = checkbox
				displayname = "I confirm this information is correct"
				initial value = false
	 			row = 6
	 			column = 1   
				width = medium
			)
			I_understand_the_impact_of_publishing_these_rules1
			(
    			type = checkbox
				displayname = "I understand the impact of publishing these rules"
				initial value = false
	 			row = 6
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			CSS_Overright
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 7
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Met","Not Met"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Validation
			(
				type = grid
				values  = Quorum_Validation.ID
    			bidirectional = Quorum_Rule
	 			row = 8
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}