{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Committee
								Rule_Name as "Rule Name"
								Minimum_Voting_Members as "Minimum Voting Members"
								Minimum_Total_Members as "Minimum Total Members"
								Minimum_Non_Executive_Members as "Minimum Non-Executive Members"
								Minimum_Independent_Members as "Minimum Independent Members"
								Status
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							"Quorum Detailview"
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Committee
								Rule_Name as "Rule Name"
								Rule_Description as "Rule Description"
								Minimum_Voting_Members as "Minimum Voting Members"
								Minimum_Total_Members as "Minimum Total Members"
								Minimum_Non_Executive_Members as "Minimum Non-Executive Members"
								Minimum_Independent_Members as "Minimum Independent Members"
								Chair_is_mandatory_for_meetings as "Chair is mandatory for meetings"
								Chair_must_be_non_executive as "Chair must be non-executive"
								Allow_proxy_voting as "Allow proxy voting"
								I_confirm_this_information_is_correct as "I confirm this information is correct"
								I_understand_the_impact_of_publishing_these_rules1 as "I understand the impact of publishing these rules"
								Status
								ID
							)
						)
					)
						menu
						(
							header
							(
								Edit 
