Quorum_Detailview as "Quorum Detailview"
{

				type =  functions
				form = Quorum_Rule
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Quorum_Rule_Page?page_action=quorumDetailview&recid=" + input.ID,"same window");
					)
					}
				}
			
}