CSS_Overright6 as "CSS Overright"
{

				type =  form
				form = Quorum_Rule

				record event = on add or edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											cssBlock = "<style>";
										// === Card containers ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group,.zc-Chair_must_be_non_executive-group,.zc-Allow_proxy_voting-group{background:#ffffff !important;border:1px solid #e5e7eb !important;border-radius:12px !important;padding:18px 70px 18px 76px !important;margin-bottom:12px !important;position:relative !important;min-height:78px !important;box-sizing:border-box !important;}";
										// === Soft red bg for first two cards ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group,.zc-Chair_must_be_non_executive-group{background:#fff5f5 !important;border-color:#fde8e8 !important;}";
										// === Icon circle base on cards ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group::before,.zc-Chair_must_be_non_executive-group::before,.zc-Allow_proxy_voting-group::before{content:'';position:absolute;left:18px;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background-repeat:no-repeat;background-position:center;background-size:22px 22px;z-index:1;}";
										// === Chair icon (red) ===
										chairSvg = "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23e8453c%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M6%209V6a3%203%200%20013-3h6a3%203%200%20013%203v3%22%2F%3E%3Cpath%20d%3D%22M4%209h16v6H4z%22%2F%3E%3Cpath%20d%3D%22M6%2015v6M18%2015v6%22%2F%3E%3C%2Fsvg%3E";
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group::before{background-color:#fde8e8;background-image:url('" + chairSvg + "');}";
										// === Crown icon (red) ===
										crownSvg = "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23e8453c%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M2%2018h20%22%2F%3E%3Cpath%20d%3D%22M3%208l4%206%205-8%205%208%204-6v10H3z%22%2F%3E%3C%2Fsvg%3E";
										cssBlock = cssBlock + ".zc-Chair_must_be_non_executive-group::before{background-color:#fde8e8;background-image:url('" + crownSvg + "');}";
										// === Shield-check icon (gray) ===
										shieldSvg = "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%203l8%204v5c0%205-3.5%208.5-8%209-4.5-.5-8-4-8-9V7l8-4z%22%2F%3E%3Cpath%20d%3D%22M9%2012l2%202%204-4%22%2F%3E%3C%2Fsvg%3E";
										cssBlock = cssBlock + ".zc-Allow_proxy_voting-group::before{background-color:#f3f4f6;background-image:url('" + shieldSvg + "');}";
										// === Position the .decision-box-field on the FAR RIGHT ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group .decision-box-field,.zc-Chair_must_be_non_executive-group .decision-box-field,.zc-Allow_proxy_voting-group .decision-box-field{position:absolute !important;right:24px !important;top:50% !important;transform:translateY(-50%) !important;left:auto !important;width:24px !important;height:24px !important;margin:0 !important;padding:0 !important;float:none !important;display:block !important;}";
										// === Hide raw checkbox (keep clickable on top) ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group input.zc_decisionbox,.zc-Chair_must_be_non_executive-group input.zc_decisionbox,.zc-Allow_proxy_voting-group input.zc_decisionbox{position:absolute !important;opacity:0 !important;width:24px !important;height:24px !important;margin:0 !important;cursor:pointer !important;z-index:2 !important;top:0 !important;left:0 !important;}";
										// === The visible checkbox = the label, base = empty box ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group .zc_decision_box_label,.zc-Chair_must_be_non_executive-group .zc_decision_box_label,.zc-Allow_proxy_voting-group .zc_decision_box_label{position:absolute !important;top:0 !important;left:0 !important;width:24px !important;height:24px !important;border:1.5px solid #d1d5db !important;border-radius:6px !important;background:#fff !important;margin:0 !important;padding:0 !important;box-sizing:border-box !important;cursor:pointer !important;display:block !important;}";
										// === Checked = red fill via input:checked + label ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group input.zc_decisionbox:checked + .zc_decision_box_label,.zc-Chair_must_be_non_executive-group input.zc_decisionbox:checked + .zc_decision_box_label,.zc-Allow_proxy_voting-group input.zc_decisionbox:checked + .zc_decision_box_label{background:#e8453c !important;border-color:#e8453c !important;}";
										// === White checkmark via ::after when checked ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group input.zc_decisionbox:checked + .zc_decision_box_label::after,.zc-Chair_must_be_non_executive-group input.zc_decisionbox:checked + .zc_decision_box_label::after,.zc-Allow_proxy_voting-group input.zc_decisionbox:checked + .zc_decision_box_label::after{content:'' !important;position:absolute !important;left:8px !important;top:3px !important;width:6px !important;height:12px !important;border:solid #fff !important;border-width:0 2.5px 2.5px 0 !important;transform:rotate(45deg) !important;}";
										// === Title label ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group .decision-box-label,.zc-Chair_must_be_non_executive-group .decision-box-label,.zc-Allow_proxy_voting-group .decision-box-label{font-size:15px !important;font-weight:600 !important;color:#111827 !important;margin:0 0 4px !important;padding:0 !important;display:block !important;float:none !important;width:auto !important;cursor:default !important;}";
										// === Help text ===
										cssBlock = cssBlock + ".zc-Chair_is_mandatory_for_meetings-group .zc-help-txt,.zc-Chair_must_be_non_executive-group .zc-help-txt,.zc-Allow_proxy_voting-group .zc-help-txt{font-size:13px !important;color:#6b7280 !important;margin:0 !important;padding:0 !important;line-height:1.4 !important;width:auto !important;max-width:100% !important;white-space:normal !important;display:block !important;}";
										cssBlock = cssBlock + "</style>";
										input.CSS_Overright = cssBlock;
										// === Pre-check the two cards if record is being created (matches design) ===
										if(input.ID == null)
										{
											if(input.Chair_is_mandatory_for_meetings == null || input.Chair_is_mandatory_for_meetings == false)
											{
												input.Chair_is_mandatory_for_meetings = true;
											}
											if(input.Chair_must_be_non_executive == null || input.Chair_must_be_non_executive == false)
											{
												input.Chair_must_be_non_executive = true;
											}
										}
						)
					}
				}

			
}