Validation as "Validation"
{

				type =  form
				form = Quorum_Rule

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.I_confirm_this_information_is_correct == false && input.I_understand_the_impact_of_publishing_these_rules1 == false)
										{
											alert "Please Agree Approval & Publishing\"";
											cancel submit;
										}
						)
					}
				}

			
}