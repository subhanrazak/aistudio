Commitee_Details as "Commitee Details"
{

				type =  form
				form = Quorum_Rule

				record event = on add or edit

				on user input of Committee
				{
					actions 
					{
						custom deluge script
						(
											reqVoting = 0;
										reqIndependent = 0;
										reqNonExec = 0;
										reqTotal = 0;
										if(input.Committee != null)
										{
											committeeRec = Committee[ID == input.Committee];
											if(committeeRec.count() > 0)
											{
												if(committeeRec.Minimum_Count != null)
												{
													reqVoting = committeeRec.Minimum_Count.toLong();
												}
												if(committeeRec.Minimum_Count_Independent != null)
												{
													reqIndependent = committeeRec.Minimum_Count_Independent.toLong();
												}
												if(committeeRec.Maximum_Count_Non_Executive != null)
												{
													reqNonExec = committeeRec.Maximum_Count_Non_Executive.toLong();
												}
												reqTotal = reqVoting + reqIndependent + reqNonExec;
											}
										}
										input.Minimum_Voting_Members = reqVoting;
										input.Minimum_Total_Members = reqTotal;
										input.Minimum_Independent_Members = reqIndependent;
										input.Minimum_Non_Executive_Members = reqNonExec;
										statusVoting = "<span style='display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#e8fbef;color:#2a9a5f;'>● Valid</span>";
										statusTotal = "<span style='display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#e8fbef;color:#2a9a5f;'>● Valid</span>";
										statusIndep = "<span style='display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#e8fbef;color:#2a9a5f;'>● Valid</span>";
										statusNonExec = "<span style='display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#e8fbef;color:#2a9a5f;'>● Valid</span>";
										htmlTable = "<div style='border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;background:#fff;font-family:Inter,sans-serif;'>";
										htmlTable = htmlTable + "<table style='width:100%;border-collapse:collapse;'>";
										htmlTable = htmlTable + "<thead><tr style='background:#f7f9fd;border-bottom:1px solid #e5e7eb;'>";
										htmlTable = htmlTable + "<th style='text-align:left;padding:12px 16px;color:#5f708a;font-size:13px;font-weight:600;'>Committee Name</th>";
										htmlTable = htmlTable + "<th style='text-align:left;padding:12px 16px;color:#5f708a;font-size:13px;font-weight:600;'>Required</th>";
										htmlTable = htmlTable + "<th style='text-align:left;padding:12px 16px;color:#5f708a;font-size:13px;font-weight:600;'>Current</th>";
										htmlTable = htmlTable + "<th style='text-align:left;padding:12px 16px;color:#5f708a;font-size:13px;font-weight:600;'>Status</th>";
										htmlTable = htmlTable + "</tr></thead><tbody>";
										htmlTable = htmlTable + "<tr style='border-bottom:1px solid #f3f4f6;'>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#e8453c;font-size:13px;'>Minimum Voting Members</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqVoting + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqVoting + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;'>" + statusVoting + "</td>";
										htmlTable = htmlTable + "</tr>";
										htmlTable = htmlTable + "<tr style='border-bottom:1px solid #f3f4f6;'>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#e8453c;font-size:13px;'>Minimum Total Members</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqTotal + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqTotal + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;'>" + statusTotal + "</td>";
										htmlTable = htmlTable + "</tr>";
										htmlTable = htmlTable + "<tr style='border-bottom:1px solid #f3f4f6;'>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#e8453c;font-size:13px;'>Minimum Independent Members</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqIndependent + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqIndependent + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;'>" + statusIndep + "</td>";
										htmlTable = htmlTable + "</tr>";
										htmlTable = htmlTable + "<tr>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#e8453c;font-size:13px;'>Minimum Non-Executive Members</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqNonExec + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;color:#1f2937;font-size:13px;'>" + reqNonExec + "</td>";
										htmlTable = htmlTable + "<td style='padding:14px 16px;'>" + statusNonExec + "</td>";
										htmlTable = htmlTable + "</tr>";
										htmlTable = htmlTable + "</tbody></table></div>";
										input.Committee_Status = htmlTable;
						)
					}
				}

			
}