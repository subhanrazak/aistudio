form ID_Setup
{

			displayname = "ID Setup"
			success message = "Id Setup Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Organization_ID
			(
    			type = text
				displayname = "Organization ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department_ID
			(
    			type = text
				displayname = "Department ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have User_ID
			(
    			type = text
				displayname = "User ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Objective_ID
			(
    			type = text
				displayname = "Objective ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Strategy_ID
			(
    			type = text
				displayname = "Strategy ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Process_ID
			(
    			type = text
				displayname = "Process ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Risk_ID
			(
    			type = text
				displayname = "Risk ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Control_ID
			(
    			type = text
				displayname = "Control ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Assessment_ID
			(
    			type = text
				displayname = "Assessment ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Incident_ID
			(
    			type = text
				displayname = "Incident ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have KPI_ID
			(
    			type = text
				displayname = "KPI ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Action_Plan_ID
			(
    			type = text
				displayname = "Action Plan ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Regulation_ID
			(
    			type = text
				displayname = "Regulation ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}