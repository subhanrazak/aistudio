default list All_Id_Setups
{

			displayName = "All Id Setups"
			show all rows from ID_Setup    
			(
				Objective_ID as "Objective ID"
				Strategy_ID as "Strategy ID"
				Process_ID as "Process ID"
				Risk_ID as "Risk ID"
				Control_ID as "Control ID"
				Assessment_ID as "Assessment ID"
				Department_ID as "Department ID"
				Organization_ID as "Organization ID"
				User_ID as "User ID"
				Incident_ID as "Incident ID"
				KPI_ID as "KPI ID"
				Action_Plan_ID as "Action Plan ID"
				Regulation_ID as "Regulation ID"
			)
		
}