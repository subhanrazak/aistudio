default list All_Audit_Logs
{

			displayName = "Audit Logs"
			show all rows from Audit_Log    
			(
				Form_Link_Name as "Form Link Name"
				Log
				Action_Type as "Action Type"
				Performed_By as "Performed By"
				Performed_Time as "Performed Time"
				Title
				Record_ID as "Record ID"
			)
		
}