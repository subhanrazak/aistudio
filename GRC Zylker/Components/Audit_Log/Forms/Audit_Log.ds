form Audit_Log
{

			displayname = "Audit Log"
			success message = "Audit Log Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Form_Link_Name
			(
    			type = text
				displayname = "Form Link Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Record_ID
			(
				type = number
				displayname = "Record ID"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Type
			(
				type = picklist
				displayname = "Action Type"
				maxchar = 100
				values = {"Create","Update","Delete","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Performed_By
			(
				type = picklist	
				displayname = "Performed By"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Performed_Time
			(
    			type = datetime
				displayname = "Performed Time"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Log
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}