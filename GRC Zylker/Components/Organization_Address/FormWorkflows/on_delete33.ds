on_delete33 as "on delete"
{

				type =  form
				form = Organization_Address

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Organization_Address",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Address);
						)
					}
				}

			
}