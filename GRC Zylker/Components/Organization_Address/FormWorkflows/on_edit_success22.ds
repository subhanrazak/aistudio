on_edit_success22 as "on edit success"
{

				type =  form
				form = Organization_Address

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Organization_Address",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Address);
						)
					}
				}

			
}