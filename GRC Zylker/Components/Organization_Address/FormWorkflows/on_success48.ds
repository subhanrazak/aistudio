on_success48 as "on success"
{

				type =  form
				form = Organization_Address

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Organization_Address",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Address);
						)
					}
				}

			
}