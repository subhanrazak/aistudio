on_edit_success12 as "on edit success"
{

				type =  form
				form = Department_Process_Approvals

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Department_Process_Approvals",input.ID,"Update",User[Email == zoho.loginuserid].ID,"");
						)
					}
				}

			
}