list Risk_Approvals
{

			displayName = "Risk  Approvals"
			show all rows from Department_Process_Approvals    
			(
				Process as "Processes"
				Status
				Approved_By as "Approved By"
				Department_Approvals as "Department Approvals"
				Risk as "Risk "
				Risk.Risk_Title as "Title "
				custom action "Approve"
				(
	  			workflow = Approve_Risk
				show action in view header = true
				show action in edit record menu = true
				column header = "Approve"
				condition = (Status == "Pending")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to approve the   ${Risk.Risk_Title}  risk?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				custom action "Reject"
				(
	  			workflow = Reject_Risk
				show action in view header = true
				show action in edit record menu = true
				column header = "Reject"
				condition = (Status == "Pending")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to reject the   ${Risk.Risk_Title}  risk?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}