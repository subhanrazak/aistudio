form Department_Process_Approvals
{

			displayname = "Department Process Approvals"
			success message = "Department Process Approval Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Department_Approvals
			(
				type = picklist	
				displayname = "Department Approvals"
				values  = Department_Approvals.ID
    			bidirectional = Process_Details
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk
			(
				type = picklist	
				displayname = "Risk "
				values  = Risk_Entry.ID
    			displayformat = [Risk_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Process
			(
				type = picklist	
				displayname = "Processes"
				values  = Process.ID
    			displayformat = [Process_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved_By
			(
				type = picklist	
				displayname = "Approved By"
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}