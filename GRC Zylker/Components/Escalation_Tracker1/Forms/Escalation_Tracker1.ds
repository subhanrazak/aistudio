form Escalation_Tracker1
{

			displayname = "Escalation Tracker"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Escalation_Level
			(
				type = picklist	
				displayname = "Escalation Level"
				values  = Escalation_Levels.ID
    			displayformat = [Level]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Role1
			(
				type = picklist	
				displayname = "Role"
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalation_Status
			(
				type = picklist
				displayname = "Escalation Status"
				maxchar = 100
				values = {"Pending","Acknowledged","Escalated","Resolved"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalated_To
			(
				type = picklist	
				displayname = "Escalated To"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalated_At
			(
    			type = datetime
				displayname = "Escalated At"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Due_By
			(
    			type = datetime
				displayname = "Due By"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Acknowledged_At
			(
    			type = datetime
				displayname = "Acknowledged At"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}