default list Escalation_Tracker1_Report
{

			displayName = "Escalation Tracker Report"
			show all rows from Escalation_Tracker1    
			(
				Escalation_Level as "Escalation Level"
				Role1 as "Role"
				Member
				Escalation_Status as "Escalation Status"
				Escalated_At as "Escalated At"
				Due_By as "Due By"
				Acknowledged_At as "Acknowledged At"
				Escalated_To as "Escalated To"
			)
		
}