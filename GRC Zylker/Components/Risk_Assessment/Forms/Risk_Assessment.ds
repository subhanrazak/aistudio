form Risk_Assessment
{

			displayname = "Risk Assessment"
			success message = ""
			Link_to_Risk_Assessment_Plan
			(
				type = section
				displayname = "Link to Risk Assessment Plan"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Basic_Assessment_Information
			(
				type = section
				displayname = "Basic Assessment Information"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Assessment_ID
			(
    			type = text
				displayname = "Assessment ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Assessment_Title
			(
    			type = text
				displayname = "Assessment Title"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Assessment_Period
			(
				type = radiobuttons
				displayname = "Assessment Period"
				maxchar = 100
				values = {"Choice 3"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Approvers
			(
				type = list	
				values  = User[Role.Role_Name == "CRO"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Target_Completion_Date
			(
    			type = date
				displayname = "Target Completion Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have Assessment_Owner
			(
				type = picklist	
				displayname = "Assessment Owner"
				values  = User[Status == "Active" && Role.Role_Name == "Risk Manager"].ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			must have Assessors
			(
				type = list	
				values  = Resource.ID
    			displayformat = [Resource]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 2   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Date_Period
			(
				type = section
				displayname = "Date Period"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 2   
				width = medium
			)
			Section3
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Assessment_Description
			(
    			type = textarea
				displayname = "Assessment Description"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Assessment_Type
			(
				type = radiobuttons
				displayname = "Assessment Type"
				maxchar = 100
				values = {"Risk & Control Self-Assessment","Independent Risk Assessment"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Auditors
			(
				type = list	
				values  = Resource.ID
    			displayformat = [Resource]
				sortorder = ascending
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Departments
			(
				type = grid
				values  = Risk_Assessment_Libraries.ID
	 			row = 5
	 			column = 1   
				width = medium
			)
			Objectives
			(
				type = grid
				values  = Risk_Assessment_Libraries.ID
	 			row = 6
	 			column = 1   
				width = medium
			)
			Processes
			(
				type = grid
				values  = Risk_Assessment_Libraries.ID
	 			row = 7
	 			column = 1   
				width = medium
			)
			Risks
			(
				type = grid
				values  = Risk_Assessment_Libraries.ID
	 			row = 8
	 			column = 1   
				width = medium
			)
			Internal_Resources
			(
				type = grid
				displayname = "Internal Resources"
				values  = Resource_Allocation.ID
	 			row = 9
	 			column = 1   
				width = medium
			)
			External_Resources
			(
				type = grid
				displayname = "External Resources"
				values  = Resource_Allocation.ID
	 			row = 10
	 			column = 1   
				width = medium
			)
			Budget_Categories
			(
				type = grid
				displayname = "Budget Categories"
				values  = Budget_Categories.ID
    			bidirectional = Risk_Assessment
	 			row = 11
	 			column = 1   
				width = medium
			)
			Templates
			(
				type = section
				visibility = true
	 			row = 12
	 			column = 0   
				width = medium
			)
			Assessment_Template
			(
				type = radiobuttons
				displayname = "Assessment Template"
				maxchar = 100
				values = {"ISO 31000 Framework","COSO ERM Framework","Custom Template","Industry-Specific"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Risk_Scoring_Method
			(
				type = picklist
				displayname = "Risk Scoring Method"
				maxchar = 100
				values = {"5-Point Scale (Very Low to Very High)","3-Point Scale (Low, Medium, High)","Numerical Scale (1-100)","Custom Scale"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Assessment_Format
			(
				type = picklist
				displayname = "Assessment Format"
				maxchar = 100
				values = {"Online Questionnaire","Workshop-based","Interview-based","Hybrid Approach"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Reporting_Level
			(
				type = picklist
				displayname = "Reporting Level"
				maxchar = 100
				values = {"Detailed Report","Summary Report","Executive Summary Only","Custom Sections"}
	 			row = 12
	 			column = 1   
				width = medium
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 13
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Started","In Progress","On Hold","Approved","Completed","Rejected"}
				initial value = "Not Started"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Stepper_Stage
			(
				type = picklist
				displayname = "Stepper Stage"
				maxchar = 100
				values = {"Basic Info","Scope","Resources","Budget","Templates"}
	 			row = 13
	 			column = 1   
				width = medium
			)
			Action_Field
			(
    			type = text
				displayname = "Action Field"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Overall_progress
			(
				type = decimal
				displayname = "Overall progress(%)"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Risk_Identified
			(
				type = number
				displayname = "Risk Identified"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Risk_with_Controls
			(
				type = number
				displayname = "Risk with Controls"
	 			row = 13
	 			column = 1   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 13
	 			column = 1   
				width = medium
			)
			Current_Work_Sheet_User
			(
				type = picklist	
				displayname = "Current Work Sheet User"
				values  = Resource.ID
    			displayformat = [Resource]
				sortorder = ascending
	 			row = 13
	 			column = 1   
				width = medium
			)
			Work_Sheet_Status
			(
				type = picklist
				displayname = "Work Sheet Status"
				maxchar = 100
				values = {"Assessment Initiate","Risk Identify","Inherent Risk","Control Mapping","Control Effectiveness","Residual Risk","Risk Treatment","Approval"}
				initial value = "Assessment Initiate"
	 			row = 13
	 			column = 1   
				width = medium
			)
			Treatment_Option
			(
				type = picklist
				displayname = "Treatment Option"
				maxchar = 100
				values = {"Accept","Mitigate","Avoid","Transfer","Escalate","Monitor"}
	 			row = 13
	 			column = 1   
				width = medium
			)
			Risk_Appetite
			(
				type = picklist
				displayname = "Risk Appetite"
				maxchar = 100
				values = {"Conservative","Moderate","Aggressive"}
	 			row = 13
	 			column = 1   
				width = medium
			)
			Reason_for_rework
			(
    			type = textarea
				displayname = "Reason for rework"
				height = 100px
	 			row = 13
	 			column = 1   
				width = medium
			)
			What_needs_to_change
			(
    			type = textarea
				displayname = "What needs to change"
				height = 100px
	 			row = 13
	 			column = 1   
				width = medium
			)
			Send_for_Approval
			(
    			type = checkbox
				displayname = "Send for Approval"
				initial value = false
	 			row = 13
	 			column = 1   
				width = medium
			)
			Comments
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 13
	 			column = 1   
				width = medium
			)
			tab
			(
    			type = text
	 			row = 13
	 			column = 1   
				width = medium
			)
			Department_Approvals
			(
				type = grid
				displayname = "Department Approvals"
				values  = Department_Approvals.ID
    			bidirectional = Risk_Assessment
	 			row = 14
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Submit1
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					Submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
			}
		
}