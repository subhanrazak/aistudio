default list Risk_Assessments
{

			displayName = "Risk Assessments"
			show all rows from Risk_Assessment    
			(
				Assessment_Plan as "Assessment Plan"
				Assessment_Title as "Assessment Title"
				Target_Completion_Date as "Target Completion Date"
				Assessment_Description as "Assessment Description"
				Assessment_Type as "Assessment Type"
				Assessment_Period as "Assessment Period"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Assessment_Template as "Assessment Template"
				Risk_Scoring_Method as "Risk Scoring Method"
				Assessment_Format as "Assessment Format"
				Reporting_Level as "Reporting Level"
				Status
				Stepper_Stage as "Stepper Stage"
				Action_Field as "Action Field"
				Assessment_Owner as "Assessment Owner"
				Overall_progress as "Overall progress(%)"
				Risk_Identified as "Risk Identified"
				Risk_with_Controls as "Risk with Controls"
				Assessment_ID as "Assessment ID"
				S_No as "S.No"
				Approvers
				Assessors
				Work_Sheet_Status as "Work Sheet Status"
			)
		
}