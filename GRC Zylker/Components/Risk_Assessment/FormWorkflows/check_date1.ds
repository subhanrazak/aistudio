check_date1 as "check  date"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on user input of Departments.Start_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(row.Start_Date != null)
										{
											if((row.End_Date != null && row.Start_Date > row.End_Date) || row.Start_Date < input.Start_Date || row.Start_Date > input.End_Date)
											{
												alert language.get("grc.date.startDateAlert");
												row.Start_Date=null;
											}
										}
						)
					}
				}

			
}