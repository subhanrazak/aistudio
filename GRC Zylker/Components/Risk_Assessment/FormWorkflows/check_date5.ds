check_date5 as "check date"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on user input of Departments.End_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(row.End_Date != null)
										{
											if((row.Start_Date != null && row.Start_Date > row.End_Date) || row.End_Date < input.Start_Date || row.End_Date > input.End_Date)
											{
												alert language.get("grc.date.endDateAlert");
												row.End_Date=null;
											}
										}
						)
					}
				}

			
}