get_Category as "get Category"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on add row of Budget_Categories
				{
					actions 
					{
						custom deluge script
						(
											categoryList = Budget_Category[ID != 0].ID.getAll();
										currentCategory = input.Budget_Categories.Category.getall();
										categoryList.removeAll(currentCategory);
										row.Category:ui.add(categoryList);
						)
					}
				}

			
}