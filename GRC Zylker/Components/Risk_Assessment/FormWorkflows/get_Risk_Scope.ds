get_Risk_Scope as "get Risk Scope"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on add row of Risks
				{
					actions 
					{
						custom deluge script
						(
											row.Scope_Type="Risk";
										//row.Approval_Status="Pending";
						)
					}
				}

			
}