on_delete6 as "on delete"
{

				type =  form
				form = Risk_Assessment

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Assessment",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Assessment_ID + " - " + input.Assessment_Title);
						)
					}
				}

			
}