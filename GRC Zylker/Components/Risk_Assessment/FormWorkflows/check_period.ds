check_period as "check period"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on user input of Assessment_Period
				{
					actions 
					{
						custom deluge script
						(
											if(input.Assessment_Period == "Custom Period")
										{
											show Date_Period;
										}
										else
										{
											hide Date_Period;
										}
						)
					}
				}

			
}