getDepartments as "getDepartments"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on add row of Departments
				{
					actions 
					{
						custom deluge script
						(
											departmentList = Department[ID != 0].ID.getAll();
										currentDepartment = input.Departments.Departments.getall();
										departmentList.removeAll(currentDepartment);
										row.Departments:ui.add(departmentList);
						)
					}
				}

			
}