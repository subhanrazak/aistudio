on_load8 as "on load"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											radio_button_style = ".flLeft[name=\"parentOf-Assessment_Period\"],.flLeft[name=\"parentOf-Assessment_Type\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row .choice-table-cell span,.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell span{ padding-top: 0px !important; } .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row .choice-table-cell > span > input + label,.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell > span > input + label { display: none !important; } .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row .choice-table-cell > span > label.choice-label-text,.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row .choice-table-cell,.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell{padding:0px !important} .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row,.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row{flex-shrink:0 !important;margin:0 10px 10px 0 !important; min-width: 300px;flex: 1;}";
										period_style = ".flLeft[name=\"parentOf-Assessment_Period\"] {display: flex;align-items:center;flex-wrap:wrap;} .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell span { padding-top: 0px !important; } .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell > span > input + label { display: none !important; } .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell > span > label.choice-label-text { padding: 5px 12px; border-radius: 7px; color: #364152 !important; }.flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell{padding:0px !important;flex-shrink:0 !important;margin:0 10px 10px 0 !important; } .flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-row{display: none;}.flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell > span > label.choice-label-text { background: #F5F4F9; border: 1px solid #F5F4F9;}.flLeft[name=\"parentOf-Assessment_Period\"] .choice-table-cell span input:checked ~ label  { border: 1px solid #62748E; }";
										assessment_type_style = ".flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text { border: 2px solid #E5E7EB;min-width: 176px;text-align: center;padding-top: 48px;padding-bottom:16px;}.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell span input:checked ~ label  { border: 2px solid #FB2C36; background:#FFF3F3 }.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text::before {  position: absolute; top: 10px;color: #FB2C36; left: 50%; transform: translate(-50%); font-family: 'ZC Live Outline'; font-size: 24px; } .flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text::before{content: '\ee95';}.flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text::before{content: '\e86d';} .flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row:nth-child(2) .choice-table-cell > span > label.choice-label-text::after { content: 'An independent evaluation carried out by a separate function, not by the process owner. This validates whether self-assessments are accurate, unbiased, and complete, providing an objective third-party perspective.'; } .flLeft[type=\"radio\"] .choice-table-row:empty { display: none; } .flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row:nth-child(1) .choice-table-cell > span > label.choice-label-text::after { content: 'A self-assessment process where process owners evaluate their own risks and controls. This approach leverages the detailed knowledge of process owners while maintaining ownership and accountability at the operational level.'; } .flLeft[name=\"parentOf-Assessment_Type\"] .choice-table-row .choice-table-cell > span > label.choice-label-text::after { display: block; margin-top: 10px; color: #717182; font-family: Lato; font-weight: 400; font-size: 14px; line-height: 20px; letter-spacing: -0.15px; text-align: center; }";
										input.style_txt = "<style>" + radio_button_style + period_style + assessment_type_style + "</style>";
										if(input.Action_Field != "" && input.Action_Field != null)
										{
											if(input.Action_Field == "Basic Info")
											{
												show Basic_Assessment_Information;
												show Link_to_Risk_Assessment_Plan;
												show Section3;
											}
											else if(input.Action_Field == "Scope")
											{
												show Objectives;
												show Departments;
												show Processes;
												show Risks;
											}
											else if(input.Action_Field == "Resources")
											{
												show Internal_Resources;
												show External_Resources;
											}
											else if(input.Action_Field == "Budget")
											{
												show Budget_Categories;
											}
											else if(input.Action_Field == "Templates")
											{
												show Templates;
											}
										}
										hide Objectives.Scope_Type;
										hide Departments.Scope_Type;
										hide Processes.Scope_Type;
										hide Risks.Scope_Type;
										hide Objectives.Risk_Assessment;
										hide Objectives.Departments;
										hide Objectives.Risks;
										hide Objectives.Processes;
										hide Objectives.Risks_Identified;
										hide Objectives.Status;
										hide Objectives.Progress;
										hide Objectives.Approval_Status;
										hide Objectives.Approved_By;
										hide Objectives.Comments;
										hide Departments.Risk_Assessment;
										hide Departments.Objectives;
										hide Departments.Risks;
										hide Departments.Processes;
										hide Departments.Risks_Identified;
										hide Departments.Status;
										hide Departments.Progress;
										hide Departments.Approval_Status;
										hide Departments.Approved_By;
										hide Departments.Comments;
										hide Processes.Risk_Assessment;
										hide Processes.Objectives;
										hide Processes.Risks;
										hide Processes.Departments;
										hide Processes.Risks_Identified;
										hide Processes.Status;
										hide Processes.Progress;
										hide Processes.Approval_Status;
										hide Processes.Approved_By;
										hide Processes.Comments;
										hide Risks.Risk_Assessment;
										hide Risks.Objectives;
										hide Risks.Processes;
										hide Risks.Departments;
										hide Risks.Risks_Identified;
										hide Risks.Status;
										hide Risks.Progress;
										hide Risks.Approval_Status;
										hide Risks.Approved_By;
										hide Risks.Comments;
										hide External_Resources.Assessment_Plan;
										hide External_Resources.User;
										hide External_Resources.Resource_Type;
										hide External_Resources.Risk_Assessment;
										disable External_Resources.Designation;
										disable External_Resources.Department;
										disable External_Resources.Availability;
										disable External_Resources.Occupancy;
										disable External_Resources.Hourly_Rate;
										hide Internal_Resources.Assessment_Plan;
										hide Internal_Resources.User;
										hide Internal_Resources.Resource_Type;
										hide Internal_Resources.Risk_Assessment;
										disable Internal_Resources.Designation;
										disable Internal_Resources.Department;
										disable Internal_Resources.Availability;
										disable Internal_Resources.Occupancy;
										disable Internal_Resources.Hourly_Rate;
										hide Budget_Categories.Assessment_Plan;
										getAssessors = input.Assessors;
										//getRole = Role[Role_Name == "Control Owner" || Role_Name == "Risk Owner" || Role_Name == "Risk Manager"].ID.getAll();
										getRole = Role[Role_Name == "Risk Manager"].ID.getAll();
										internalResources = Resource[Resource_Type == "Internal Resource" && Internal_Resource.Role == getRole].ID.getAll();
										externalResources = Resource[Resource_Type == "External Resource" && Role == getRole].ID.getAll();
										assessorList = List();
										assessorList.addAll(internalResources);
										assessorList.addAll(externalResources);
										input.Assessors:ui.add(assessorList);
										input.Assessors = getAssessors;
						)
					}
				}

			
}