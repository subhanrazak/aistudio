field_workflow5 as "field workflow"
{

				type =  form
				form = Risk_Assessment

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Date_Period,Hidden_Section,Department_Approvals;
					}
					actions 
					{
						hide Section3,Link_to_Risk_Assessment_Plan,Basic_Assessment_Information,Templates,Objectives,Departments,Processes,Risks,Internal_Resources,External_Resources,Budget_Categories;
					}
					actions 
					{
						hide Assessment_ID;
					}
				}

			
}