on_success67 as "on success"
{

				type =  form
				form = Skills_Expertise

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Skills_Expertise",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Resource.Resource + " - " + input.Skill.Skill_Name);
						)
					}
				}

			
}