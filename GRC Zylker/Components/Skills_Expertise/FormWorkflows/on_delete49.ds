on_delete49 as "on delete"
{

				type =  form
				form = Skills_Expertise

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											resource = Resource[ID == input.Resource].Resource;
										skill = Skill[ID == input.Skill].Skill_Name;
										thisapp.Log.Audit_Log("Skills_Expertise",input.ID,"Update",User[Email == zoho.loginuserid].ID,resource + " - " + skill);
						)
					}
				}

			
}