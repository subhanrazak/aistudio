form Skills_Expertise
{

			displayname = "Skills & Expertise"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Resource
			(
				type = picklist	
				displayname = "Resources"
				values  = Resource.ID
    			bidirectional = Skills_Expertise
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Skill
			(
				type = picklist	
				values  = Skill.ID
    			displayformat = [Skill_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Level
			(
				type = picklist
				maxchar = 100
				values = {"Beginner","Intermediate","Advanced","Expert"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Years_of_Experience1
			(
				type = number
				displayname = "Years of Experience"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}