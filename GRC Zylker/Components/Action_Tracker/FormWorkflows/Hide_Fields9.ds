Hide_Fields9 as "Hide Fields"
{

				type =  form
				form = Action_Tracker

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Agenda_Item;
										hide Meeting;
										hide Agenda_Items_Notes;
										hide Escalation_Tracker;
						)
					}
				}

			
}