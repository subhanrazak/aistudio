Hide_Fields11 as "Hide Fields"
{

				type =  form
				form = Action_Tracker

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Agenda_Item;
										hide Meeting;
										hide Agenda_Items_Notes;
										actionCount = Action_Tracker[ID != 0].count() + 1;
										paddedNum = "";
										if(actionCount < 10)
										{
											paddedNum = "ACT-00" + actionCount;
										}
										else if(actionCount < 100)
										{
											paddedNum = "ACT-0" + actionCount;
										}
										else
										{
											paddedNum = "ACT-" + actionCount;
										}
										input.Action_ID = paddedNum;
						)
					}
				}

			
}