Status_Update2 as "Status Update"
{

				type =  form
				form = Action_Tracker

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											meetingId = input.Meeting.ID;
										openUrl("#Page:Meeting_Page?page_action=detailview&record_id=" + meetingId + "&tab=action_item","same window");
						)
					}
				}

			
}