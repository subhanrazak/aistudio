form Action_Tracker
{

			displayname = "Action Tracker"
			success message = "Action Tracker Added Successfully"
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			style_txt
			(
    			type = plaintext
				value = "<div><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Agenda_Items_Notes
			(
    			type = plaintext
				value = "Add your Note here ..."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			Action_ID
			(
    			type = text
				displayname = "Action ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Status
			(
				type = radiobuttons
				maxchar = 100
				values = {"Completed","Ongoing","Yet to start"}
				initial value = "Yet to start"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Assign_To
			(
				type = picklist	
				displayname = "Assign To"
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Priority
			(
				type = radiobuttons
				maxchar = 100
				values = {"Low","High","Medium"}
	 			row = 2
	 			column = 2   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 2
	 			column = 2   
				width = medium
			)
			Action_Items
			(
				type = grid
				displayname = "Action Items"
				values  = Action_Item_Details.ID
    			bidirectional = Action_Tracker
	 			row = 3
	 			column = 1   
				width = medium
			)
			Hidden
			(
				type = section
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			MOM
			(
				type = picklist	
				values  = MOM.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Meeting
			(
				type = picklist	
				displayname = "Meetings"
				values  = Meeting.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Resolution
			(
				type = picklist	
				values  = Add_Resolution.ID
    			bidirectional = Action_Tracker
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Completed_Date
			(
    			type = date
				displayname = "Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Agenda_Item
			(
				type = picklist	
				displayname = "Agenda Item"
				values  = Agenda_Item.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 4
	 			column = 1   
				width = medium
			)
			Current_Escalation_Level
			(
				type = number
				displayname = "Current Escalation Level"
				initial value = 0
	 			row = 4
	 			column = 1   
				width = medium
			)
			Is_Escalated
			(
    			type = checkbox
				displayname = "Is Escalated"
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Next_Escalation_Time
			(
    			type = datetime
				displayname = "Next Escalation Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Escalation_Tracker
			(
				type = grid
				displayname = "Escalation Tracker"
				values  = Escalation_Tracker1.ID
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}