Tracker_Detailview as "Tracker-Detailview"
{

				type =  functions
				form = Action_Tracker
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Page:Operational_Page?page_action=tracker_detail&record_id=" + input.ID,"same window");
					)
					}
				}
			
}