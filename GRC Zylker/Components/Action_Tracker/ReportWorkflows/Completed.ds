Completed as "Completed"
{

				type =  functions
				form = Action_Tracker
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						input.Status = "Completed";
										user = User[Email == zoho.loginuserid];
										met = insert into Meeting_Activity
										[
											Added_User=zoho.loginuser
											Activity="Action Item Completed"
											User=user.ID
											Date_Time=zoho.currenttime
											Meeting=input.Meeting.ID
											Action_Tracker=input.ID
										];
					)
					}
				}
			
}