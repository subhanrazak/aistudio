							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							"Action-Tracker-Detailview"
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Action_ID as "Action ID"
								Due_Date as "Due Date"
								Status
