default list All_Action_Trackers
{

			displayName = "All Action Trackers"
			show all rows from Action_Tracker    
			(
				Action_ID as "Action ID"
				Priority
				Assign_To as "Assign To"
				Due_Date as "Due Date"
				Status
				MOM
				Meeting as "Meetings"
				Agenda_Item as "Agenda Item"
				Description
				Completed_Date as "Completed Date"
				Current_Escalation_Level as "Current Escalation Level"
				Is_Escalated as "Is Escalated"
				Next_Escalation_Time as "Next Escalation Time"
				Resolution
			)
		
}