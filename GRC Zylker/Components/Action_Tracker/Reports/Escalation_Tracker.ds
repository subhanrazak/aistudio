list Escalation_Tracker
{

			displayName = "Escalation Tracker"
			show all rows from Action_Tracker  [Due_Date > zoho.currentdate]  
			(
				Action_ID as "Action ID"
				Due_Date as "Due Date"
				Status
				Assign_To as "Assign To"
				Priority
				Description
				MOM
				Meeting as "Meetings"
				Agenda_Item as "Agenda Item"
			)
			custom actions
			(
				"Traker-Detailview"
				(
	  			workflow = Tracker_Detailview
				)
			)
		
}