list Operations_Action_Tracker
{

			displayName = "Operations Action Tracker"
			show all rows from Action_Tracker    
			(
				Action_ID as "Action ID"
				Due_Date as "Due Date"
				Status
				Assign_To as "Assign To"
				Priority
				Description
				MOM
				Meeting as "Meetings"
				Agenda_Item as "Agenda Item"
				ID
			)
			custom actions
			(
				"Action-Tracker-Detailview"
				(
	  			workflow = Action_Tracker_Detailview
				)
			)
		
}