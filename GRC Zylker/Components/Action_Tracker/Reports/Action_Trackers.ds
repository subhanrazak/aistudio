list Action_Trackers
{

			displayName = "Action Trackers"
			show all rows from Action_Tracker    
			(
				Action_ID as "Action ID"
				Priority
				Assign_To as "Assign To"
				Due_Date as "Due Date"
				Status
				MOM
				custom action "Completed"
				(
	  			workflow = Completed
				show action in edit record menu = true
				column header = "Completed"
				condition = (Status == "Ongoing")
				confirmation before execution
				(
					message for individual record = "Execute the Completed action for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				Meeting as "Meetings"
			)
			conditional formatting
			(
				"Completed"
				{
				condition = (Status == "Completed")
				fields = [Status]
				format = "color:#19bc9f;"
				}
				"Ongoing"
				{
				condition = (Status == "Ongoing")
				fields = [Status]
				format = "color:#f1c50e;"
				}
				"Yet to Start"
				{
				condition = (Status == "Yet to start")
				fields = [Status]
				format = "color:#bd588b;"
				}
			)
		
}