form Budget_Categories
{

			displayname = "Budget Categories"
			success message = "Budget Category Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assessment_Plan
			(
				type = picklist	
				displayname = "Assessment Plan"
				values  = Assessment_Plan.ID
    			bidirectional = Budget_Categories
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Assessment
			(
				type = picklist	
				displayname = "Risk Assessment"
				values  = Risk_Assessment.ID
    			bidirectional = Budget_Categories
    			displayformat = [Assessment_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist	
				values  = Budget_Category.ID
    			displayformat = [Category_Name]
				allow new entries
				[
					displayname = "Add Budget Category"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Allocation
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Percentage
			(
    			type = percentage
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}