on_delete12 as "on delete"
{

				type =  form
				form = Budget_Categories

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											title = if(input.Assessment_Plan != null,Assessment_Plan[ID == input.Assessment_Plan].Plan_Name,Risk_Assessment[ID == input.Risk_Assessment].Assessment_Title);
										category_name = Budget_Category[ID == input.Category].Category_Name;
										thisapp.Log.Audit_Log("Budget_Categories",input.ID,"Delete",User[Email == zoho.loginuserid].ID,title + " - " + category_name);
						)
					}
				}

			
}