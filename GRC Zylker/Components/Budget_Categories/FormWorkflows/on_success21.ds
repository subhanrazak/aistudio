on_success21 as "on success"
{

				type =  form
				form = Budget_Categories

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											title = if(input.Assessment_Plan != null,input.Assessment_Plan.Plan_Name + " - " + input.Category.Category_Name,input.Risk_Assessment.Assessment_Title + " - " + input.Category.Category_Name);
										thisapp.Log.Audit_Log("Budget_Categories",input.ID,"Create",User[Email == zoho.loginuserid].ID,title);
						)
					}
				}

			
}