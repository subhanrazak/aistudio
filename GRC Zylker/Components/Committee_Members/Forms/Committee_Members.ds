form Committee_Members
{

			displayname = "Committee Members"
			success message = "Committee Member Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Member
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				allow new entries
				[
					displayname = "Add Member"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Position
			(
				type = picklist
				maxchar = 100
				values = {"Executive","Non-Executive","Independent"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Committee
			(
				type = picklist	
				displayname = "Committees"
				values  = Committee.ID
    			bidirectional = Committee_Membership_Configuration
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}