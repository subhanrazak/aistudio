on_edit_success30 as "on edit success"
{

				type =  form
				form = Risk_Compliance_Frameworks

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Compliance_Frameworks",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Organization.Organization_Name + " - " + input.Framework.Framework_Name);
						)
					}
				}

			
}