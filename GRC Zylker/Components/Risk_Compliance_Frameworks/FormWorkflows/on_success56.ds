on_success56 as "on success"
{

				type =  form
				form = Risk_Compliance_Frameworks

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Risk_Compliance_Frameworks",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Organization.Organization_Name + " - " + input.Framework.Framework_Name);
										openUrl("#Script:page.refresh","same window");
						)
					}
				}

			
}