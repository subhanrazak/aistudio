on_delete42 as "on delete"
{

				type =  form
				form = Risk_Compliance_Frameworks

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											org_name = Organization[ID == input.Organization].Organization_Name;
										framework_name = Framework[ID == input.Framework].Framework_Name;
										thisapp.Log.Audit_Log("Risk_Compliance_Frameworks",input.ID,"Delete",User[Email == zoho.loginuserid].ID,org_name + " - " + framework_name);
						)
					}
				}

			
}