form Risk_Compliance_Frameworks
{

			displayname = "Risk & Compliance Frameworks"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Organization
			(
				type = picklist	
				values  = Organization.ID
    			bidirectional = Risk_Compliance_Frameworks
    			displayformat = [Organization_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Framework
			(
				type = picklist	
				values  = Framework.ID
    			displayformat = [Framework_Name]
				allow new entries
				[
					displayname = "Add Framework"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Full Implementation","Phased Implementation","Preparation Phase","Not Applicable"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Date
			(
    			type = date
				displayname = "Target Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Review_Date
			(
    			type = date
				displayname = "Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}