list User_Report
{

			displayName = "User Report"
			show all rows from User    
			(
				Name 
				Employee_ID as "User ID"
				Location
				Photo
				Designation
				Status
				Department_Access as "Department Access"
				Email
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Department
				Joining_Date as "Joining Date"
				Manager
				Role
				Location_Access as "Location Access"
				User_Display as "User"
				ID
			)
		
}