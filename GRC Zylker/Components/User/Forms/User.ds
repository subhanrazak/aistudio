form User
{

			displayname = "Users"
			success message = "User Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			unique Employee_ID
			(
    			type = text
				displayname = "User ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Location
			(
				type = picklist	
				values  = Entity.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Designation
			(
				type = picklist	
				values  = Designation.ID
    			displayformat = [Designation_Name]
				allow new entries
				[
					displayname = "Add Designation"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Gender
			(
				type = picklist
				maxchar = 100
				values = {"Male","Female"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Access
			(
				type = list	
				displayname = "Department Access"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Enable_App_Access
			(
    			type = checkbox
				displayname = "Enable App Access"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			User_Display
			(
    			type = richtext
				displayname = "User"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
			must have Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Joining_Date
			(
    			type = date
				displayname = "Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Manager
			(
				type = picklist	
				values  = User.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Member_Type
			(
				type = picklist
				displayname = "Member Type"
				maxchar = 100
				values = {"Executive","Non-Executive","Independent","Advisory"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Role
			(
				type = picklist	
				values  = Role.ID
    			displayformat = [Role_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Skill_Coverage
			(
				type = list	
				displayname = "Skill Coverage"
				values  = Skill_Coverage.ID
    			displayformat = [Skill_Coverage]
				allow new entries
				[
					displayname = "Add Skill Coverage"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Language
			(
				type = list	
				values  = Language.ID
    			displayformat = [Language]
				allow new entries
				[
					displayname = "Add Language"
				]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Location_Access
			(
				type = list	
				displayname = "Location Access"
				values  = Entity.ID
    			displayformat = [Entity_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 2   
				width = medium
			)
			S_No
			(
    			type = autonumber
				displayname = "S.No"
				start index = 1
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}