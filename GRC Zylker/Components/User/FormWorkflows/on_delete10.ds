on_delete10 as "on delete"
{

				type =  form
				form = User

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("User",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Employee_ID + " - " + input.Name);
						)
					}
				}

			
}