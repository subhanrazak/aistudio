on_success19 as "on success"
{

				type =  form
				form = User

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											input.Employee_ID = thisapp.Get_ID("User",input.ID);
										thisapp.Log.Audit_Log("User",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Employee_ID + " - " + input.Name);
						)
					}
				}

			
}