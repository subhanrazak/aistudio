on_success20 as "on success"
{

				type =  form
				form = User

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("User",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Employee_ID + " - " + input.Name);
						)
					}
				}

			
}