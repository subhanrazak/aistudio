default list Software_Licenses
{

			displayName = "Software Licenses"
			show all rows from Software_License    
			(
				Software_Name as "Software Name"
				Version_Edition as "Version/Edition"
				Vendor
				Description
				Category
				License_Type as "License Type"
				License_Key as "License Key"
				Total_Licenses as "Total Licenses"
				Allocated_Users as "Allocated Users"
				Utilization
				Renewal_Date as "Renewal Date"
				Purchase_Date as "Purchase Date"
				License_Status as "License Status"
				Enable_automatic_renewal as "Enable automatic renewal"
				License_Cost as "License Cost"
				Support_Cost as "Support Cost"
				Billing_Period as "Billing Period"
				Currency
				Compliance_Requirements1 as "Compliance Requirements"
				Business_Criticality as "Business Criticality"
				Department
				License_Owner as "License Owner"
				Support_Phone as "Support Phone"
				(
					displayformat = plainnumber 
				)
				Support_Email as "Support Email"
				License_Agreement as "License Agreement"
				Purchase_Order as "Purchase Order"
				Tags
				Notes
			)
		
}