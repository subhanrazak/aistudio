check_purchase_date as "check purchase date"
{

				type =  form
				form = Software_License

				record event = on add or edit

				on user input of Purchase_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Purchase_Date != null && input.Purchase_Date > zoho.currentdate)
										{
											alert language.get("grc.software.purchaseDateAlert");
											input.Purchase_Date = null;
										}
						)
					}
				}

			
}