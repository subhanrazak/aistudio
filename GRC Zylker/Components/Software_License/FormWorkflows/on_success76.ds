on_success76 as "on success"
{

				type =  form
				form = Software_License

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Software_License",input.ID,"Update",User[Email == zoho.loginuserid].ID,input.Software_Name);
										openUrl("#Page:Software_License_Resources?page_action=detailView&recid=" + input.ID,"same window");
						)
					}
				}

			
}