check_renewal_date as "check renewal date"
{

				type =  form
				form = Software_License

				record event = on add or edit

				on user input of Renewal_Date
				{
					actions 
					{
						custom deluge script
						(
											language = thisapp.Content.translation();
										if(input.Renewal_Date != null && input.Renewal_Date < zoho.currentdate)
										{
											alert language.get("grc.software.renewalDateAlert");
											input.Renewal_Date = null;
										}
						)
					}
				}

			
}