on_delete54 as "on delete"
{

				type =  form
				form = Software_License

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Software_License",input.ID,"Delete",User[Email == zoho.loginuserid].ID,input.Software_Name);
						)
					}
				}

			
}