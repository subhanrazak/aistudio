on_success75 as "on success"
{

				type =  form
				form = Software_License

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.Log.Audit_Log("Software_License",input.ID,"Create",User[Email == zoho.loginuserid].ID,input.Software_Name);
										openUrl("#Page:Software_License_Resources","same window");
						)
					}
				}

			
}