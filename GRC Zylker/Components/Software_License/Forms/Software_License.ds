form Software_License
{

			displayname = "Software Licenses"
			success message = "Software License Added Successfully"
			Basic_Information
			(
				type = section
				displayname = "Basic Information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Software_Name
			(
    			type = text
				displayname = "Software Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Vendor
			(
				type = picklist	
				values  = Vendor.ID
    			displayformat = [Vendor_Name]
				allow new entries
				[
					displayname = "Add Vendor"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Version_Edition
			(
    			type = text
				displayname = "Version/Edition"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Productivity","Security","Development","Audit Tools","Analytics & BI","CRM","ERP","Collaboration"}
				others option = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			License_Details
			(
				type = section
				displayname = "License Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have License_Type
			(
				type = picklist
				displayname = "License Type"
				maxchar = 100
				values = {"Subscription","Named User","Concurrent User","Device License","Perpetual","Volume License"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have unique License_Key
			(
    			type = text
				displayname = "License Key"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Section
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Total_Licenses
			(
				type = number
				displayname = "Total Licenses"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Allocated_Users
			(
				type = number
				displayname = "Allocated Users"
	 			row = 3
	 			column = 2   
				width = medium
			)
			Utilization
			(
    			type = percentage
	 			row = 3
	 			column = 3   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Purchase_Date
			(
    			type = date
				displayname = "Purchase Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			License_Status
			(
				type = picklist
				displayname = "License Status"
				maxchar = 100
				values = {"Active","Pending Activation","Expiring Soon","Expired","Under Maintenance"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Renewal_Date
			(
    			type = date
				displayname = "Renewal Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 2   
				width = medium
			)
			Enable_automatic_renewal
			(
    			type = checkbox
				displayname = "Enable automatic renewal"
				initial value = false
	 			row = 4
	 			column = 2   
				width = medium
			)
			Section3
			(
				type = section
				displayname = "Cost Information"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have License_Cost
			(
				type = decimal
				displayname = "License Cost"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Support_Cost
			(
				type = decimal
				displayname = "Support Cost"
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Billing_Period
			(
				type = picklist
				displayname = "Billing Period"
				maxchar = 100
				values = {"Monthly","Quarterly","Annual","Biennial","One-time (Perpetual)"}
	 			row = 5
	 			column = 2   
				width = medium
			)
			Currency
			(
				type = picklist
				maxchar = 100
				values = {"USD ($)","INR (₹)","EUR (€)","GBP (£)","JPY (¥)","AUD (A$)","CAD (C$)","CHF (CHF)","CNY (¥)","SGD (S$)","AED (د.إ)","SAR (﷼)","MYR (RM)","THB (฿)","ZAR (R)","NZD (NZ$)","HKD (HK$)","KRW (₩)","SEK (kr)","NOK (kr)"}
	 			row = 5
	 			column = 2   
				width = medium
			)
			Compliance_Requirements
			(
				type = section
				displayname = "Compliance & Requirements"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Compliance_Requirements1
			(
				type = checkboxes	
				displayname = "Compliance Requirements"
				values = {"SOX (Sarbanes-Oxley) Required","GDPR Related","HIPAA Compliant","ISO 27001 Required","PCI DSS Compliant"}
	 			row = 6
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 7
	 			column = 0   
				width = medium
			)
			Business_Criticality
			(
				type = picklist
				displayname = "Business Criticality"
				maxchar = 100
				values = {"Critical","High","Medium","Low"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 7
	 			column = 2   
				width = medium
			)
			Contact_Information
			(
				type = section
				displayname = "Contact Information"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have License_Owner
			(
				type = picklist	
				displayname = "License Owner"
				values  = User.ID
    			displayformat = [" " + Employee_ID + " -" + Name.first_name + " " + Name.last_name]
				sortorder = ascending
	 			row = 8
	 			column = 1   
				width = medium
			)
			Support_Email
			(
    			type = email
				displayname = "Support Email"
				maxchar = 80
	 			row = 8
	 			column = 1   
				width = medium
				personal data = true
			)
			Support_Phone
			(
    			type = phonenumber
				displayname = "Support Phone"
	 			row = 8
	 			column = 2   
				width = medium
				personal data = true
			)
			Documents_Attachments
			(
				type = section
				displayname = "Documents & Attachments"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			License_Agreement
			(
    			type = upload file
				displayname = "License Agreement"
    			file count = 10
				browse = local_drive
	 			row = 9
	 			column = 1   
				width = medium
			)
			Purchase_Order
			(
    			type = upload file
				displayname = "Purchase Order"
    			file count = 10
				browse = local_drive
	 			row = 9
	 			column = 1   
				width = medium
			)
			Additional_Information
			(
				type = section
				displayname = "Additional Information"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Tags
			(
    			type = text
	 			row = 10
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Create
					(
   						type = submit
   						displayname = "Create"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
				}
			}
		
}