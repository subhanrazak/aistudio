<%
	language = thisapp.Content.translation();
	pageParam = "";
	riskIDList = Risk_Entry[ID != 0].ID.getAll();
	if(input.Priority != null && input.Priority != "" && input.Priority != "null")
	{
		riskIDList = Risk_Entry[ID == riskIDList && Risk_Level.Label == input.Priority].ID.getAll();
		pageParam = pageParam + "&Priority=" + input.Priority;
	}
	if(input.Search != null && input.Search != "" && input.Search != "null")
	{
		riskIDList = Risk_Entry[ID == riskIDList && Risk_Title.contains(input.Search) || Risk_ID.contains(input.Search)].ID.getAll();
		pageParam = pageParam + "&Search=" + input.Search;
	}
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Table()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Pagination()%>

.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	box-sizing: border-box;
}

.zcs-page-table-view {
    height: 100%;
	background :var(--zcs-white-color);
}
.zcs-pagination {
    height: 32px;
    padding: 10px;
    box-sizing: content-box;
	background :var(--zcs-white-color);
}
.zcs-table-wrapper {
	height: calc(100% - 52px);
}
/* .zcs-table-wrapper table {
    height: 100%;
    table-layout: auto;
	overflow: auto;
} */

.zcs-table-wrapper table thead {
    z-index: 1;
}

.zcs-table-wrapper table tbody tr {
   position:relative;
}
.zcs-detail-view-td{
	position:absolute;
	border: none !important;
    inset: 0;
    background: transparent !important;
	
}
.zcs-detail-view-td a{
	height: 100%;
    display: block;
    width: 100%;
	
}
</style>
<div class='zcs-page-container zcs-page-table-view'>
<%
	if(riskIDList.size() > 0)
	{
		recordCount_per_page = 20;
		total_risk_count = riskIDList.size();
		no_of_pages = ceil(total_risk_count / recordCount_per_page);
		input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
		diff = total_risk_count - input.start_index;
		end_index = if(input.start_index + recordCount_per_page - 1 > total_risk_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
		previousAction = if(input.start_index == 1,"disable","");
		nextAction = if(end_index == total_risk_count,"disable","");
		pageLink = '#Page:Risk_Report_Page?zc_Header=false' + pageParam;
		previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
		nextLink = if(end_index < total_risk_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.id")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.riskTitle")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.category")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.riskLevel")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.impact")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.likelihood")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.inherentScore")%> </th>
            </tr>
            
        </thead>
        <tbody>
<%
		for each  risk in Risk_Entry[ID == riskIDList] sort by Added_Time desc range from input.start_index to end_index
		{
			%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> 
					<%=risk.Risk_ID%>		
				
				</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				        <%=risk.Risk_Title%>		
			
</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				 <span  style='background:#F3F4F6;border-radius:5px;color:#62748E;padding: 3px 8px;'><%=risk.Risk_Category1.Category_Name%></span>
</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			colorCode = risk.Risk_Level.Color_Code;
			backgroundColor = colorCode + "26";
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;color:<%=colorCode%>;background:<%=backgroundColor%>;border:1px solid <%=colorCode%>;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=risk.Risk_Level.Label%> </span>
				 </div>
				</td>
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                     <%=risk.Impact.Value%> - <%=risk.Impact.Label%>
				</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				<%=risk.Likelihood.Value%> - <%=risk.Likelihood.Label%>
				</td>
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				<%=risk.Inherent_Score%>
				</td>
				<td class='zcs-detail-view-td'>
				<a href='#Page:Risk_Entries_Page?page_action=detailView&recid=<%=risk.ID%>&tab=<%=input.tab%>'></a>
				</td>
            </tr>
<%
		}
		%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_risk_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
	}
	else
	{
		%>
<%=thisapp.Page.noData()%>
<%
	}
	%>
</div>