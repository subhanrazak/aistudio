<%
	language = thisapp.Content.translation();
	pageParam = "";
	processIDList = Process[ID != 0].ID.getAll();
	if(input.Department != null)
	{
		processIDList = Process[ID == processIDList && Linked_Departments == input.Department].ID.getAll();
		pageParam = pageParam + "&Department=" + input.Department;
	}
	if(input.Risk_Level != null && input.Risk_Level != "" && input.Risk_Level != "null")
	{
		processIDList = Process[ID == processIDList && Complexity_Level == input.Risk_Level].ID.getAll();
		pageParam = pageParam + "&Risk_Level=" + input.Risk_Level;
	}
	if(input.Search != null && input.Search != "" && input.Search != "null")
	{
		processIDList = Process[ID == processIDList && Process_Name.contains(input.Search) || Process_ID.contains(input.Search)].ID.getAll();
		pageParam = pageParam + "&Search=" + input.Search;
	}
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Table()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Pagination()%>

.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	box-sizing: border-box;
}

.zcs-page-table-view {
    height: 100%;
	background :var(--zcs-white-color);
}
.zcs-pagination {
    height: 32px;
    padding: 10px;
    box-sizing: content-box;
	background :var(--zcs-white-color);
}
.zcs-table-wrapper {
	height: calc(100% - 52px);
}
/* .zcs-table-wrapper table {
    height: 100%;
    table-layout: auto;
	overflow: auto;
} */

.zcs-table-wrapper table thead {
    z-index: 1;
}

.zcs-table-wrapper table tbody tr {
   position:relative;
}
.zcs-detail-view-td{
	position:absolute;
	border: none !important;
    inset: 0;
    background: transparent !important;
	
}
.zcs-detail-view-td a{
	height: 100%;
    display: block;
    width: 100%;
	
}
.zcs-table-wrapper table tbody tr td:first-child{
min-width:250px;
}
</style>
<div class='zcs-page-container zcs-page-table-view'>
<%
	if(processIDList.size() > 0)
	{
		recordCount_per_page = 20;
		total_process_count = processIDList.size();
		no_of_pages = ceil(total_process_count / recordCount_per_page);
		input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
		diff = total_process_count - input.start_index;
		end_index = if(input.start_index + recordCount_per_page - 1 > total_process_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
		previousAction = if(input.start_index == 1,"disable","");
		nextAction = if(end_index == total_process_count,"disable","");
		pageLink = '#Page:Process_Report_Page?zc_Header=false' + pageParam;
		previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
		nextLink = if(end_index < total_process_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.processDetails")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.objectives")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.strategies")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.objective.owner")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.weightage")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.risks")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.controls")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.process.riskLevel")%> </th>
            </tr>
            
        </thead>
        <tbody>
<%
		for each  process in Process[ID == processIDList] sort by Added_Time desc range from input.start_index to end_index
		{
			%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
							<div>
							   <div style='display:flex;'>
							   <span style='font-size:13px;color:#4A5565'>#<%=process.Process_ID%></span>
							   </div>
							   <div style='color:#04204B;font-size:17px;margin-bottom:10px;'><%=process.Process_Name%></div>
							   <div style='display:flex;'>
<%
			for each  department in process.Linked_Departments
			{
				%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-right:7px;'><%=department.Department_Name%></div>
<%
			}
			%>
</div>
			                </div>
				
				</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				        <div>
<%
			objectiveCount = 0;
			for each  objective in process.Linked_Objectives
			{
				objectiveCount = objectiveCount + 1;
				sizeStr = "";
				if(objectiveCount == 2)
				{
					objectiveSize = process.Linked_Objectives.size();
					objectiveSize = objectiveSize - 2;
					if(objectiveSize > 0)
					{
						sizeStr = "<span style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;margin-left:6px;'> +" + objectiveSize + "</span></div>";
					}
				}
				if(objectiveCount == 2 && objectiveSize > 0)
				{
					%>
<div style='display:flex;'>
<%
				}
				%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;'><%=objective.Objective_Title%></div> <%=sizeStr%>
<%
				if(objectiveCount == 2)
				{
					break;
				}
			}
			%>
</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				 <div>
<%
			strategyCount = 0;
			for each  strategy in process.Linked_Strategies
			{
				strategyCount = strategyCount + 1;
				strategySizeStr = "";
				if(strategyCount == 2)
				{
					strategySize = process.Linked_Strategies.size();
					strategySize = strategySize - 2;
					if(strategySize > 0)
					{
						strategySizeStr = "<span style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;margin-left:6px;'> +" + strategySize + "</span></div>";
					}
				}
				if(strategyCount == 2 && strategySize > 0)
				{
					%>
<div style='display:flex;'>
<%
				}
				%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;'><%=strategy.Strategy_Title%></div> <%=strategySizeStr%>
<%
				if(strategyCount == 2)
				{
					break;
				}
			}
			%>
</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=process.Process_Owner.Name%> </td>
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                      <div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6' style='width:75px;'>
					  <p class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-font-14 zcs-font-medium zcs-lh-body zcs-m-0' style='display: flex;align-items: center;justify-content: center;font-size: 14px;'>
					    <span class='zcs-color-primary'><%=if(process.Process_Weightage != null,process.Process_Weightage.toNumber() + "%","")%></span>
					 </p>
					 <div class='zcs-progress-bar zcs-rounded-sm' style='border-radius: 0.25rem;'><div class='zcs-progress-bar-indicator' style='width:<%=if(process.Process_Weightage != null,process.Process_Weightage,0)%>%;'></div></div></div>
				 </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>  
				<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border zcs-badge-orange' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> 
				<i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid' style='color:#F4660C'></i>  <%=process.Associate_Risks.size()%> 
				</span>
				</div>
				
				</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				  <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border zcs-badge-violet' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				  <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='ui-3-security' html='ui-3-security' class='ui-3-security zc-li-solid' style='color:#8200DB'></i>  <%=process.Associate_Controls.size()%> </span>
				  </div>
				</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			if(process.Complexity_Level == "High")
			{
				badgeClass = "zcs-badge-orange";
			}
			else if(process.Complexity_Level == "Medium")
			{
				badgeClass = "zcs-badge-yellow";
			}
			else if(process.Complexity_Level == "Very High")
			{
				badgeClass = "zcs-badge-red";
			}
			else if(process.Complexity_Level == "Low")
			{
				badgeClass = "zcs-badge-green";
			}
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <%=process.Complexity_Level%> </span>
				</div>
				</td>
				<td class='zcs-detail-view-td'>
				<a href='#Page:Process_Page?page_action=detailView&recid=<%=process.ID%>'></a>
				</td>
            </tr>
<%
		}
		%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_process_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
	}
	else
	{
		%>
<%=thisapp.Page.noData()%>
<%
	}
	%>
</div>