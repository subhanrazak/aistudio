    .zcs-panel-wrapper.zcs-lg-panel-wrapper li:hover .zcs-panel {
        background-image: radial-gradient(circle at 100% 0, var(--component_hover_color) 0%, #ffffff 52%);
    }
    .zcs-lg-panel-wrapper .zcs-panel-icon-wrapper {
        height: 100%;
    }
    .zcs-lg-panel-wrapper .zcs-panel-icon {
        color: var(--theme_brand_color);
        opacity: 50%;
    }
    .zcs-report {
        max-height: 350px;
    }
    .zcs-card.zcs-report .reportfullwidth {
        border-top-width: 0px;
    }
    @media (max-width: 768px) {
        .zcs-page-container,
         .zcs-page-container-inner {
            height: auto;
        }
        .zcs-report-card {
            border-width: 0px;
            background-color: transparent;
            height: auto;
        }
        .zcs-report-header {
            padding: 0px 0px 16px;
        }
        body:not(.zc-mobile) .zcs-report-header {
            padding: 0px;
        }
    }
    
