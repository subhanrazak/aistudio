    }
    .zcs-progress-bar-list .zcs-progress-bar-wrapper:nth-child(4) .zcs-progress-bar-indicator {
        background-color: #16A34A;
    }
    .zcs-list li,
    .zcs-custom-tabhead .zcs-custom-tab {
        list-style-type: none;	
    }
    
