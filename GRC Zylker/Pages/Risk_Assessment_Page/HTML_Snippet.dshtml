<style>
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .form-outer-wrapper form[name="Assessment_Approval"] .formContainer {
    display: none !important;
}
form[name="Assessment_Approval"] .zc-live-primary-btn{
	margin:0 12px 0 0!important;
}
form[name="Assessment_Approval"] .zc-live-primary-btn:nth-of-type(1){
	margin-right: 12px !important;
	color: #ef1617;
	background: #fff;
	border: 1px solid #ef1617;
}
form[name="Assessment_Approval"] .zc-live-primary-btn:nth-of-type(5){
	margin-right: 12px !important;
	color: #364153;
	background: #fff;
	border: 1px solid #D1D5DC;
	cursor:auto;
}
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper form[name="Assessment_Approval"] .zc-footer-wrapper .zc-form-footer .formbutton{
	text-align: end;
    padding: 0;
}
</style>


			<div class='zcs-page-footer  zcs-flex zcs-align-items-center zcs-justify-space-between zcs-p-24' style='background:#fff;'>
			    <a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
    <%=previoushrefAction%> >
	<span class='zcs-button-text <%=if(input.action_field == "Assessment Initiate","zcs-button-disable","")%>'> <%=language.get("grc.button.previous")%> </span>
</a>
<div  zc_MobileView='inline' elName='zc-component' formLinkName='Assessment_Approval' params='zc_Header=false&zc_Focus=false&Risk_Assessment=<%=assessmentDet.ID%>&Action_Field=<%=input.action_field%>'></div>

			</div> 
				
				
				</div>
				</div>
<%
	}
	else if(input.page_action == "detailView")
	{
		assessmentDet = Risk_Assessment[ID == input.recid];
		tab_map = thisapp.Page.Get_Tabs("Risk_Assessment_Detail_View");
		tab_keys = tab_map.keys();
		input.tab = if(input.tab != "" && input.tab != "null" && input.tab != null,input.tab,tab_keys.get(0));
		%>
<div class='zcs-page-container zcs-page-fleet_driver zcs-wh-full zcs-common-container '>
		<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
		     <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
					<div class='zcs-flex zcs-gap-16 zcs-ellipsis'>
						<a class='zcs-back' href='#Page:<%=page_link_name%>?filter_tab=<%=input.filter_tab%>'>
							<i class='zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left'></i>
						</a>
						<div class='zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis'>
							<div class='zcs-row zcs-align-items-center zcs-gap-8'>
								<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=assessmentDet.Assessment_Title%> </h5>

							</div>
							<div class='zcs-row zcs-align-items-center zcs-gap-8'>
							<p class='zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>
								<%=assessmentDet.Assessment_Description%> 
							</p>
							
							</div>
						</div>
					</div>
					<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
<%
		if(assessmentDet.Current_Work_Sheet_User == null)
		{
			if(thisapp.permission.app_access("risk_assessment_edit") == true)
			{
				if(thisapp.permissions.profileForUser(zoho.loginuserid) == "Risk Owner" || thisapp.permissions.profileForUser(zoho.loginuserid) == "Control Owner")
				{
					userDet = User[Email == zoho.loginuserid].ID;
					if(userDet != null)
					{
						resource = Resource[Internal_Resource == userDet].ID;
					}
					else
					{
						resource = Resource[Email == zoho.loginuserid].ID;
					}
					if(resource != null && assessmentDet.Assessors == resource)
					{
						app_access = true;
					}
					else
					{
						app_access = false;
					}
				}
				else
				{
					app_access = true;
				}
				if(app_access == true)
				{
					%>
<a href='#Page:<%=page_link_name%>?page_action=add&recid=<%=assessmentDet.ID%>&editRec=true&filter_tab=<%=input.filter_tab%>&action_field=<%=encodeUrl("Basic Info")%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
							<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
							<span class='zcs-button-text'> <%=language.get("grc.edit.text")%> </span>
						</a>
<%
				}
			}
		}
		else
		{
			%>
<div class='zcs-flex zcs-px-27 zcs-py-8 zcs-gap-20' style='border:1px solid #16A34A;background:#ECFDF3;border-radius:100px'>
							   <div class='zcs-flex zcs-direction-column zcs-gap-4'>
							      <span class='zcs-font-16 zcs-color-primary'><%=assessmentDet.Current_Work_Sheet_User.Resource%></span>
								  <span  class='zcs-font-14' style='color:#238010;'>Editing..</span>
							   </div>
							   <div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'
									style='--zcs-avatar-size: 42px; --zcs-avatar-radius: 50%;background: #16A34A;color: #fff;'>
									<span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=thisapp.Content.letterGenerate(if(assessmentDet.Current_Work_Sheet_User.Resource_Type == "Internal Resource",assessmentDet.Current_Work_Sheet_User.Internal_Resource.Name,assessmentDet.Current_Work_Sheet_User.Name))%> </span>
								</div>
								   
							   
							</div>
<%
		}
		auditorDet = User[Email == zoho.loginuserid].ID;
		if(auditorDet != null)
		{
			auditorResource = Resource[Internal_Resource == auditorDet].ID;
		}
		else
		{
			auditorResource = Resource[Email == zoho.loginuserid].ID;
		}
		if(assessmentDet.Status == "Approved" && auditorResource != null && assessmentDet.Auditors == auditorResource)
		{
			%>
<a href='#Form:Send_Back_for_Rework?Risk_Assessment=<%=assessmentDet.ID%>&zc_LoadIn=dialog' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' style='border-color: #D1D5DC;color: #364153;'>
							<i class='zcs-button-icon zc-li-outline arrows-1-refresh-69'></i>
							<span class='zcs-button-text'> <%=language.get("grc.button.sendBack")%></span>
						</a>
						<a href='#Form:Reject?Risk_Assessment=<%=assessmentDet.ID%>&Action_Field=Auditor&zc_LoadIn=dialog' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body' style='border-color: #D1D5DC;color: #364153;'>
							<i class='zcs-button-icon zc-li-outline ui-2-small-remove'></i>
							<span class='zcs-button-text'> <%=language.get("grc.button.reject")%> </span>
						</a>
		<a href='#Form:Approve?Risk_Assessment=<%=assessmentDet.ID%>&Action_Field=Auditor&zc_LoadIn=dialog' class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
							<i class='zcs-button-icon zc-li-outline ui-1-check-circle-08'></i>
							<span class='zcs-button-text'> <%=language.get("grc.button.approve")%> </span>
						</a>
<%
		}
		%>
</div>
				</div>
				 <div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border'>
				  <div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full'>
                <ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
<%
		for each  tab_id in tab_keys
		{
			class_name = if(input.tab == tab_id,"zcs-horizontal-tabitem zcs-horizontal-tabactive'","zcs-horizontal-tabitem");
			%>
<li class='<%=class_name%>'> <a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-secondary' href='#Page:<%=page_link_name%>?tab=<%=tab_id%>&filter_tab=<%=input.filter_tab%>&page_action=detailView&recid=<%=input.recid%>'><span class="zcs-horizontal-tab-text"> <%=tab_map.get(tab_id).get("Display")%></span> </a> </li>
<%
		}
		%>
</ul>
 <div class='zcs-horizontal-tabbody zcs-col-common zcs-flex zcs-direction-column'>
<%
		if(input.tab == "assessment")
		{
			%>
<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border">
					      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.assessmentInitiate")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex zcs-px-14 zcs-py-30 zcs-direction-column zcs-gap-50'>
						      <div class='zcs-flex zcs-direction-column zcs-gap-12'>
						      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.basicAssessmentInformation")%></h6>
							  <div class="zcs-divider zcs-divider-horizontal"></div>
						    <div class='zcs-flex zcs-mt-17'>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentPlan")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(assessmentDet.Assessment_Plan != null,assessmentDet.Assessment_Plan.Plan_Name,"-")%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentType")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=assessmentDet.Assessment_Type%> </span>
											</div>
							</div>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentID")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=assessmentDet.Assessment_ID%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentPeriod")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=assessmentDet.Assessment_Period%> </span>
											</div>
									</div>
							
							   
							</div>
                            </div>
                            <div class='zcs-flex zcs-direction-column zcs-gap-12'>
						      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.timelineTeam")%></h6>
							  <div class="zcs-divider zcs-divider-horizontal"></div>
						    <div class='zcs-flex zcs-mt-17 zcs-gap-12'>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.objective.startDate")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=assessmentDet.Start_Date%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessors")%> </h6>
										    <div class='zcs-list-container zcs-row zcs-gap-10'>
<%
			for each  assessor in assessmentDet.Assessors
			{
				%>
<div class='zcs-flex zcs-px-6 zcs-py-5 zcs-card zcs-border-box zcs-gap-12 zcs-align-items-center' style='min-width:200px;'>
											<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'
									style='--zcs-avatar-size: 36px; --zcs-avatar-radius: 50%;background: #FECACA69;color: #FB2C36;'>
									<span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=thisapp.Content.letterGenerate(if(assessor.Resource_Type == "Internal Resource",assessor.Internal_Resource.Name,assessor.Name))%> </span>
								</div>
								   <div class='zcs-flex zcs-direction-column zcs-gap-4'>
								   <span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=if(assessor.Resource_Type == "Internal Resource",assessor.Internal_Resource.Name,assessor.Name)%> </span>
								    <span class='zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary '> <%=if(assessor.Resource_Type == "Internal Resource",assessor.Internal_Resource.Designation.Designation_Name,assessor.Job_Title.Designation_Name)%> </span>
								   </div>
											       
											</div>
<%
			}
			%>
</div>
											</div>
							</div>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessmentPlan.dueDate")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=assessmentDet.End_Date%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.status")%> </h6>
<%
			if(assessmentDet.Status == "Not Started")
			{
				badgeClass = "zcs-badge-orange";
			}
			else if(assessmentDet.Status == "In Progress")
			{
				badgeClass = "zcs-badge-blue";
			}
			else if(assessmentDet.Status == "Completed")
			{
				badgeClass = "zcs-badge-green";
			}
			else if(assessmentDet.Status == "On Hold")
			{
				badgeClass = "zcs-badge-red";
			}
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius:8px;padding:5px 12px ; width:max-content;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=assessmentDet.Status%> </span>
				</div>
											</div>
									</div>
							
							   
							</div>
                            </div>
							
							</div>
							
						  
					 </div>
				 </div>
			 </div>
<%
		}
		else if(input.tab == "riskIdentify")
		{
			%>
<style>
		.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
			padding:0px !important; 
		}
		</style>
		<div class='zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15'>
		<div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
		<div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border zcs-h-full'>
		 <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-h-full'>
		      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskIdentify")%></h6>
			  <div class="zcs-divider zcs-divider-horizontal"></div>
			  <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=riskView&Page=<%=page_link_name%>&Report=Risk_Assessment_Libraries_Report&rec_ID=<%=assessmentDet.ID%>'></div>
			  <div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Risk_Assessment_Report_Page' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&page_action=risk&assessment_id=<%=assessmentDet.ID%>' ></div>
		 </div>
		
		
		</div>
		
		</div>
		
		</div>
<%
		}
		else if(input.tab == "inherentRisk")
		{
			riskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
			likelihoodScore = 0;
			impactScore = 0;
			for each  riskDet in riskList
			{
				riskRecord = Risk_Entry[ID == riskDet];
				if(riskRecord != null)
				{
					likelihoodScore = likelihoodScore + if(Likelihood[ID == riskRecord.Likelihood].Value != null,Likelihood[ID == riskRecord.Likelihood].Value,0);
					impactScore = impactScore + if(Impact[ID == riskRecord.Impact].Value != null,Impact[ID == riskRecord.Impact].Value,0);
				}
			}
			avgLikelihood = if(riskList.size() > 0,likelihoodScore / riskList.size(),"-");
			avgImpact = if(riskList.size() > 0,impactScore / riskList.size(),"-");
			avgScore = if(riskList.size() > 0,(Risk_Entry[ID == riskList].sum(Inherent_Score) / riskList.size()).toNumber(),null);
			scoreStatusID = if(avgScore != null,Risk_Level[From <= avgScore && To >= avgScore].ID,null);
			%>
<style>
.zcs-likelihood-label {
    rotate: 270deg;
	height: 100%;
}
.zcs-likelihood-label,
.zcs-impact-label{
    width: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #62748E;
}
.zcs-impact-label {
	padding-block: 10px;
}
.zcs-heatmap-likelihood{
	padding-left: 20px;
	padding-bottom: 20px;
    position: relative;
}
.zcs-heatmap-likelihood:before{
	 position: absolute;
    content: "Likelihood (L)";
    left: -30px;
    rotate: 270deg;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    color: #62748E;
}
.zcs-heatmap-likelihood:after{
	 position: absolute;
    content: "Impact (I)";
    bottom: 0px;
	width: 100%;
	text-align: center;
    font-size: 16px;
    color: #62748E;
}
</style>
<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15 zcs-overflow-auto">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border">
					      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.inherentRiskEvaluation")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex zcs-px-14 zcs-py-30 zcs-direction-column zcs-gap-50'>
						      <div class='zcs-flex zcs-direction-column zcs-gap-12'>
						      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskScoring")%></h6>
							  <div class="zcs-divider zcs-divider-horizontal"></div>
						    <div class='zcs-flex zcs-mt-17'>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.likelihood")%> (L)</h6>
											
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=avgLikelihood%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.score")%> (L * I)</h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=if(avgScore != null,avgScore,"-")%> </span>
											</div>
							</div>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.impact")%> (I) </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=avgImpact%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.status")%> </h6>
<%
			if(scoreStatusID != null)
			{
				scoreStatus = Risk_Level[ID == scoreStatusID];
				scoreColor = scoreStatus.Color_Code;
				scoreBackgroundColor = scoreColor + "26";
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=scoreColor%>;background:<%=scoreBackgroundColor%>' >
											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=scoreStatus.Label%> </span>
										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
</div>
									</div>
							
							   
							</div>
                            </div>
                            <div class='zcs-flex zcs-direction-column zcs-gap-12'>
						      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskHeatmap")%></h6>
							     <div class='zcs-flex zcs-w-full zcs-direction-column zcs-gap-1 zcs-heatmap-likelihood'>
<%
			for each  likeDet in Likelihood[ID != 0] sort by Value
			{
				%>
<div class='zcs-flex zcs-w-full zcs-gap-1'>
									     <span class='zcs-likelihood-label'><%=likeDet.Label%></span>
										 <div class='zcs-flex zcs-w-full zcs-gap-1'>
<%
				impactHTML = "<div class='zcs-flex zcs-w-full zcs-gap-1'><span class='zcs-likelihood-label'></span>";
				for each  impactDet in Impact[ID != 0] sort by Value
				{
					impactHTML = impactHTML + "<span class='zcs-impact-label' style='width:20%; text-align: center;'>" + impactDet.Label + "</span>";
					currentScore = likeDet.Value * impactDet.Value;
					riskLevel = Risk_Level[From <= currentScore && To >= currentScore];
					colorCode = riskLevel.Color_Code;
					backgroundColor = colorCode + "26";
					riskCount = Risk_Entry[ID == riskList && Impact == impactDet.ID && Likelihood == likeDet.ID].count();
					%>
<div class='zcs-flex zcs-align-items-center zcs-justify-center zcs-font-16 zcs-color-white'style='width:20%;height:50px;background-color:<%=colorCode%>' >
										    <%=if(avgScore == currentScore && avgLikelihood == likeDet.Value && avgImpact == impactDet.Value,avgScore,"")%>
										 </div>
<%
				}
				%>
</div>
										 </div>
<%
			}
			%>
<%=impactHTML%></div>
			
</div>
								 
								 <div class='zcs-flex zcs-justify-space-between'>
<%
			levelCount = 0;
			for each  levelDet in Risk_Level[ID != 0] sort by From
			{
				%>
<div class='zcs-flex zcs-gap-10 zcs-align-items-center'>
<%
				if(levelCount == 0)
				{
					%>
<span class='zcs-font-16'><%=language.get("grc.assessment.severityScale")%> :</span>
<%
				}
				%>
<div style='height:20px;width:20px;background:<%=levelDet.Color_Code%>;border-radius:4px;'></div>
											   <p class='zcs-m-0'><%=levelDet.Label%> <span class='zcs-color-tertiary'><%=levelDet.From%>-<%=levelDet.To%></span></p>
										   </div>
<%
				levelCount = levelCount + 1;
			}
			%>
</div>
							  
                            </div>
							
							</div>
                            </div>
<%
		}
		else if(input.tab == "controlMapping")
		{
			%>
<style>
					/* ===== Risk Card ===== */
.zcs-rpd-risk-card {
    margin-bottom: 28px;
    background: #ffffff;
    border: 1px solid #F3F4F6;
    border-radius: 12px;
    overflow: hidden;
}

.zcs-rpd-risk-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 20px;
    gap: 20px;
    border-bottom: 1px solid #F3F4F6;
}

.zcs-rpd-risk-info {
    flex: 1;
    min-width: 0;
}

.zcs-rpd-risk-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
   
}

.zcs-rpd-risk-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #FEF2F2;
    flex-shrink: 0;
}

.zcs-rpd-risk-title {
    font-size: 17px;
    font-weight: 700;
    color: #0a1929;
}

.zcs-rpd-risk-id {
    font-size: 12px;
    font-weight: 500;
    color: #62748E;
    background: #F9FAFB;
    padding: 3px 12px;
    border-radius: 4px;
    border: 1px solid #F3F4F6;
    white-space: nowrap;
}

.zcs-rpd-risk-desc {
    font-size: 13px;
    font-weight: 400;
    color: #6b7a8d;
    line-height: 1.5;
    margin-left: 50px;
}

/* ===== Risk Metrics ===== */
.zcs-rpd-risk-metrics {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.zcs-rpd-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9px 17px;
    border: 1px solid #F3F4F6;
    border-radius: 8px;
    background: #F9FAFB;
    gap: 4px;
}

.zcs-rpd-metric-label {
    font-size: 12px;
    font-weight: 500;
    color: #99A1AF;
}




/* ===== Score Badge ===== */
.zcs-rpd-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9px 17px;
    border-radius: 8px;
    gap: 2px;
    min-width: 60px;
    background: #FEF2F2;
    border: 1px solid #FFE2E2;
}



.zcs-rpd-score-label {
    font-size: 12px;
    font-weight: 500;
    color: #FF6467;;
}



.zcs-rpd-score-value {
    font-size: 20px;
    font-weight: 700;
    color: #C10007;
}


/* ===== Controls Table ===== */
.zcs-rpd-controls-table {
    background: #ffffff;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    overflow: hidden;
    
}

.zcs-rpd-controls-table table {
    width: 100%;
    border-collapse: collapse;
}

.zcs-rpd-controls-table thead th {
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: #6A7282;
    padding: 12px 20px;
    border-bottom: 1px solid #E5E7EB;
    background: #F9FAFB;
}

.zcs-rpd-controls-table tbody td {
    padding: 14px 20px;
    border-bottom: 1px solid #ECEAF7;
    vertical-align: middle;
}

.zcs-rpd-controls-table tbody tr:last-child td {
    border-bottom: none;
}

/* ===== Control Name Cell ===== */
.zcs-rpd-control-name {
    display: flex;
    align-items: center;
    gap: 10px;
}

.zcs-rpd-check-icon {
    flex-shrink: 0;
}

.zcs-rpd-ctrl-title {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #101828;
}

.zcs-rpd-ctrl-id {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: #6A7282;
}

/* ===== Type Badge ===== */
.zcs-rpd-type-badge {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    background: #F3F4F6;
    color: #62748E;
}





/* ===== Residual ===== */
.zcs-rpd-residual {
    font-size: 16px;
    font-weight: 700;
    color: #364153;
    
}

/* ===== Responsive ===== */
@media (max-width: 992px) {
    .zcs-rpd-layout {
        flex-direction: column;
    }

    .zcs-rpd-sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid #e8ecf1;
        display: flex;
        gap: 20px;
        padding: 16px;
        overflow-x: auto;
    }

    .zcs-rpd-dept {
        margin-bottom: 0;
    }

    .zcs-rpd-risk-header {
        flex-direction: column;
        gap: 16px;
    }

    .zcs-rpd-controls-table {
        margin: 0 12px;
    }
}

@media (max-width: 640px) {
    .zcs-rpd-main {
        padding: 16px;
    }

    .zcs-rpd-header {
        flex-direction: column;
    }

    .zcs-rpd-header-right {
        align-items: flex-start;
    }

    .zcs-rpd-risk-metrics {
        flex-wrap: wrap;
    }

    .zcs-rpd-controls-table {
        margin: 0;
        overflow-x: auto;
    }

    .zcs-rpd-controls-table table {
        min-width: 500px;
    }
}
.zcs-control-table-wrapper{
	padding: 20px 24px 20px;
    background: #fcfdfd;
}
		</style>
		<div class='zcs-col-common zcs-overflow-auto zcs-px-26 zcs-py-13'>
<%
			index = 1;
			for each  risk in Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID && Scope_Type == "Risk"]
			{
				if(risk.Risks.Likelihood.Label == "Very Low")
				{
					likelihoodBadge = "zcs-badge-green";
				}
				else if(risk.Risks.Likelihood.Label == "Low")
				{
					likelihoodBadge = "zcs-badge-yellow";
				}
				else if(risk.Risks.Likelihood.Label == "Medium")
				{
					likelihoodBadge = "zcs-badge-blue";
				}
				else if(risk.Risks.Likelihood.Label == "High")
				{
					likelihoodBadge = "zcs-badge-orange";
				}
				else if(risk.Risks.Likelihood.Label == "Very High")
				{
					likelihoodBadge = "zcs-badge-red";
				}
				if(risk.Risks.Impact.Label == "Negligible")
				{
					impactBadge = "zcs-badge-green";
				}
				else if(risk.Risks.Impact.Label == "Minor")
				{
					impactBadge = "zcs-badge-yellow";
				}
				else if(risk.Risks.Impact.Label == "Moderate")
				{
					impactBadge = "zcs-badge-blue";
				}
				else if(risk.Risks.Impact.Label == "Major")
				{
					impactBadge = "zcs-badge-orange";
				}
				else if(risk.Risks.Impact.Label == "Catastrophic")
				{
					impactBadge = "zcs-badge-red";
				}
				%>
<div class="zcs-rpd-risk-card">
                 <input class="zcs-accordion-input" type="checkbox" id="zcs-tl-card1<%=index%>" name="zcs-card" <%=if(index == 1,"checked","")%>>
				 <label for="zcs-tl-card1<%=index%>" class="zcs-accordion-label zcs-wh-full  zcs-cursor-pointer">
                <div class="zcs-rpd-risk-header">
				
				<div class="zcs-rpd-risk-info">
                        <div class="zcs-rpd-risk-title-row">
                            <span class="zcs-rpd-risk-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 2L1 21h22L12 2z" fill="#fff" stroke="#e53e3e" stroke-width="2"></path>
                                    <text x="12" y="18" text-anchor="middle" font-size="12" font-weight="700" fill="#e53e3e">!</text>
                                </svg>
                            </span>
                            <h3 class="zcs-rpd-risk-title"><%=risk.Risks.Risk_Title%></h3>
                            <span class="zcs-rpd-risk-id"><%=risk.Risks.Risk_ID%></span>
                        </div>
                        <p class="zcs-rpd-risk-desc zcs-m-0"><%=risk.Risks.Risk_Description1%></p>
                    </div>
				
                    
                    <div class="zcs-rpd-risk-metrics">
                        <div class="zcs-rpd-metric">
                            <span class="zcs-rpd-metric-label"><%=language.get("grc.assessment.likelihood")%></span>
							<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=likelihoodBadge%>' style='border:none !important;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=risk.Risks.Likelihood.Label%> </span>
                           </div> 
                        </div>
                        <div class="zcs-rpd-metric">
                            <span class="zcs-rpd-metric-label"><%=language.get("grc.assessment.impact")%></span>
                            <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=impactBadge%>' style='border:none !important;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=risk.Risks.Impact.Label%> </span>
                           </div> 
                        </div>
                        <div class="zcs-rpd-score zcs-rpd-score--red">
                            <span class="zcs-rpd-score-label"><%=language.get("grc.assessment.score")%></span>
                            <span class="zcs-rpd-score-value"> <%=risk.Risks.Inherent_Score%></span>
                        </div>
						<span class="zcs-accordion-icon zcs-cursor-pointer zcs-rounded-half zcs-border zcs-flex zcs-align-items-center zcs-justify-center zcs-p-3 zcs-cursor-pointer zcs-font-22 fa fa-angle-down"></span>
                    </div>
                </div>
                </label>
				<div class="zcs-accordion-content">
                <!-- Controls Table -->
				 <div class="zcs-control-table-wrapper">
                <div class="zcs-rpd-controls-table">
                    <table>
                        <thead>
                            <tr>
                                <th><%=language.get("grc.assessment.controlName")%></th>
                                <th><%=language.get("grc.assessment.type")%></th>
                                <th><%=language.get("grc.assessment.freq")%></th>
                                <th><%=language.get("grc.assessment.status")%></th>
                                <th><%=language.get("grc.assessment.residual")%></th>
                            </tr>
                        </thead>
                        <tbody>
<%
				for each  control in Control[Link_Risks == risk.Risks]
				{
					if(control.Control_Status == "Inactive")
					{
						badgeClass = "zcs-badge-red";
					}
					else if(control.Control_Status == "Active")
					{
						badgeClass = "zcs-badge-green";
					}
					else if(control.Control_Status == "Under Review")
					{
						badgeClass = "zcs-badge-orange";
					}
					if(control.Design_Effectiveness == "Highly Effective")
					{
						designValue = 5;
					}
					else if(control.Design_Effectiveness == "Effective")
					{
						designValue = 4;
					}
					else if(control.Design_Effectiveness == "Moderately Effective")
					{
						designValue = 3;
					}
					else if(control.Design_Effectiveness == "Weak")
					{
						designValue = 2;
					}
					else if(control.Design_Effectiveness == "Ineffective")
					{
						designValue = 1;
					}
					if(control.Operating_Effectiveness == "Highly Effective")
					{
						operationValue = 5;
					}
					else if(control.Operating_Effectiveness == "Effective")
					{
						operationValue = 4;
					}
					else if(control.Operating_Effectiveness == "Moderately Effective")
					{
						operationValue = 3;
					}
					else if(control.Operating_Effectiveness == "Weak")
					{
						operationValue = 2;
					}
					else if(control.Operating_Effectiveness == "Ineffective")
					{
						operationValue = 1;
					}
					totalValue = ((operationValue + designValue) / 2).toNumber();
					%>
<tr>
                                <td>
                                    <div class="zcs-rpd-control-name">
                                        <i value="ui-1-check-square-11" html="ui-1-check-square-11" class="ui-1-check-square-11 zc-li-outline" style='color: #615FFF; font-size: 12px; font-weight: 700;'></i>
                                        <div>
                                            <span class="zcs-rpd-ctrl-title"><%=control.Control_Name_Title%></span>
                                            <span class="zcs-rpd-ctrl-id"><%=control.Control_ID_Code%></span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="zcs-rpd-type-badge "><%=control.Control_Type%></span></td>
                                <td style='color: #4A5565;font-size: 14px;font-weight: 400;'><%=control.Frequency%></td>
                                <td>
								<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border: none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> \u2022  <%=control.Control_Status%> </span></div>
								</td>
								
								</td>
                                <td class="zcs-rpd-residual">
<%
					if(totalValue == 5)
					{
						statusBadgeClass = "zcs-badge-green";
						statusValue = "Highly Effective";
					}
					else if(totalValue == 4)
					{
						statusBadgeClass = "zcs-badge-blue";
						statusValue = "Effective";
					}
					else if(totalValue == 3)
					{
						statusBadgeClass = "zcs-badge-yellow";
						statusValue = "Moderately Effective";
					}
					else if(totalValue == 2)
					{
						statusBadgeClass = "zcs-badge-orange";
						statusValue = "Weak";
					}
					else if(totalValue == 1)
					{
						statusBadgeClass = "zcs-badge-red";
						statusValue = "Ineffective";
					}
					%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=statusBadgeClass%>' style='border:none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><i class='location-flag-diagonal-33 zc-li-solid' value='location-flag-diagonal-33'></i>  <%=statusValue%> </span></div></td>
                            </tr>
<%
				}
				%>
</tbody>
                    </table>
                </div>
				</div>
				
				</div>
            </div>
<%
				index = index + 1;
			}
			%>
</div>
<%
		}
		else if(input.tab == "controlEffectiveness")
		{
			%>
<style>
		.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
			padding:0px !important; 
		}
		</style>
		<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border zcs-h-full">
					      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.controlEffectivenessReview")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Risk_Assessment_Report_Page' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&page_action=controlEffectiveness&assessment_id=<%=assessmentDet.ID%>'></div>
						  
						  
		</div>
		</div>
		</div>
<%
		}
		else if(input.tab == "residualRisk")
		{
			riskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
			avgInherentScore = if(riskList.size() > 0,(Risk_Entry[ID == riskList].sum(Inherent_Score) / riskList.size()).toNumber(),null);
			inherentScoreStatusID = if(avgInherentScore != null,Risk_Level[From <= avgInherentScore && To >= avgInherentScore].ID,null);
			avgResidualScore = if(riskList.size() > 0,(Risk_Entry[ID == riskList].sum(Residual_Risk_Score) / riskList.size()).toNumber(),null);
			residualScoreStatusID = if(avgResidualScore != null,Risk_Level[From <= avgResidualScore && To >= avgResidualScore].ID,null);
			controlEffectiveness = if(avgInherentScore != null && avgResidualScore != null && avgInherentScore != 0,(avgInherentScore - avgResidualScore) / avgInherentScore * 100,null);
			getMaximumInherent = Risk_Entry[ID == riskList].maximum(Inherent_Score);
			primaryRisk = Risk_Entry[ID == riskList && Inherent_Score == getMaximumInherent];
			likeLihoodCount = Likelihood[ID != 0].count();
			impactCount = Impact[ID != 0].count();
			likelihoodScore = 0;
			impactScore = 0;
			for each  riskDet in riskList
			{
				riskRecord = Risk_Entry[ID == riskDet];
				if(riskRecord != null)
				{
					likelihoodScore = likelihoodScore + if(Likelihood[ID == riskRecord.Likelihood].Value != null,Likelihood[ID == riskRecord.Likelihood].Value,0);
					impactScore = impactScore + if(Impact[ID == riskRecord.Impact].Value != null,Impact[ID == riskRecord.Impact].Value,0);
				}
			}
			avgLikelihood = if(riskList.size() > 0,(likelihoodScore / riskList.size()).toNumber(),null);
			avgImpact = if(riskList.size() > 0,(impactScore / riskList.size()).toNumber(),null);
			likeLihoodValue = Likelihood[Value == avgLikelihood].Label;
			impactValue = Impact[Value == avgImpact].Label;
			controlList = Risk_Entry[ID == riskList].distinct(Link_Controls);
			if(inherentScoreStatusID != null)
			{
				inherentScoreStatus = Risk_Level[ID == inherentScoreStatusID];
				inherentScoreColor = inherentScoreStatus.Color_Code;
				inherentScoreBackgroundColor = inherentScoreColor + "26";
			}
			if(residualScoreStatusID != null)
			{
				residualScoreStatus = Risk_Level[ID == residualScoreStatusID];
				residualScoreColor = residualScoreStatus.Color_Code;
				residualScoreBackgroundColor = residualScoreColor + "26";
			}
			%>
<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-p-15 zcs-overflow-auto zcs-col-common">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border">
					      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.residualRiskEvaluation")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex zcs-px-14 zcs-py-30 zcs-direction-column zcs-gap-50'>
						      <div class='zcs-flex zcs-direction-column zcs-gap-12'>
						      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskScoring")%></h6>
							  <div class="zcs-divider zcs-divider-horizontal"></div>
						    <div class='zcs-flex zcs-mt-17'>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.riskEntry.inherentRiskScore")%></h6>
											
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=avgInherentScore%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.residualRiskScore")%></h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=avgResidualScore%> </span>
											</div>
							</div>
							<div style="flex: 1;flex-shrink: 0;" class="zcs-flex zcs-direction-column zcs-gap-32">
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.controlEffectiveness")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body">  <%=if(controlEffectiveness != null,controlEffectiveness.round(2) + "%","-")%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.residualRiskRating")%> </h6>
<%
			if(residualScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=residualScoreColor%>;background:<%=residualScoreBackgroundColor%>' >
											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=residualScoreStatus.Label%> </span>
										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
</div>
									</div>
							
							   
							</div>
                            </div>
                            <div class='zcs-flex zcs-direction-column zcs-gap-12'>
							<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.riskEntry.riskSummary")%></h6>
							  <div class="zcs-divider zcs-divider-horizontal"></div>
							<div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20" style='border: 1px solid;border-image-source: linear-gradient(270deg, #FB2C36 0%, rgba(255, 255, 255, 0) 100%);background: linear-gradient(90deg, #FFD8DA 0%, rgba(255, 255, 255, 0) 50%, #FFEBD0 100%);'>
				     <div class="zcs-flex zcs-p-14 zcs-box-border zcs-justify-space-around">
					    <div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20'>
						
						 <p class="zcs-font-16 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.inherentRisk")%> </p>
						  <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size:60px;color:#FB2C36;'> <%=avgInherentScore%> </h4>
<%
			if(inherentScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=inherentScoreColor%>;background:<%=inherentScoreBackgroundColor%>' >
											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=inherentScoreStatus.Label%> </span>
										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  L=<%=if(avgLikelihood != null,avgLikelihood,"-")%> (<%=likeLihoodValue%>) <i class="ui-1-simple-remove zc-li-outline" style='font-size: 10px;font-weight: 700;'></i> I=<%=if(avgImpact != null,avgImpact,"-")%> (<%=impactValue%>)</p>
						</div>
						 <div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20 zcs-justify-center'>
						 <div style='background: #EEF2FF;border-radius: 56px;padding: 8px 9px;'><i style="color:#4F46E5" class="ui-3-security zc-li-solid" value="ui-3-security"></i> <%=controlList.size()%> Controls Mapped</div>
						<svg width="234" height="20" viewBox="0 0 234 20" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M14 10L3.5 18.6603L3.5 1.33975L14 10Z" fill="#FFC2C2"/>
						<path d="M36 10L25.5 18.6603L25.5 1.33975L36 10Z" fill="#FFC2C2"/>
						<path d="M58 10L47.5 18.6603L47.5 1.33975L58 10Z" fill="#FFC2C2"/>
						<path d="M80 10L69.5 18.6603L69.5 1.33975L80 10Z" fill="#FFC2C2"/>
						<path d="M102 10L91.5 18.6603L91.5 1.33975L102 10Z" fill="#FFC2C2"/>
						<path d="M124 10L113.5 18.6603L113.5 1.33975L124 10Z" fill="#FFC2C2"/>
						<path d="M146 10L135.5 18.6603L135.5 1.33975L146 10Z" fill="#FC8F01"/>
						<path d="M168 10L157.5 18.6603L157.5 1.33975L168 10Z" fill="#FC8F01"/>
