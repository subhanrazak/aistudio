							</div>
							<div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20 zcs-card'>
							<div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
										<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.assessment.actionPlanStatus")%> </h6>
										<div class='zcs-flex zcs-gap-10 zcs-w-full'>
										    <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-align-items-center zcs-justify-center zcs-py-9' style='flex:1;flex-shrink:0;border-radius:5px;background:#ECF0F7;'>
											  <span class='zcs-font-16 zcs-color-primary'><%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Overdue" || Status == "Deferred"].count()%></span>
											  <span class='zcs-font-12 zcs-color-tertiary'><%=language.get("grc.assessment.pending")%></span>
											</div>
											<div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-align-items-center zcs-justify-center zcs-py-9' style='flex:1;flex-shrink:0;border-radius:5px;background:#ECF0F7;'>
											  <span class='zcs-font-16 zcs-color-primary'><%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "In Progress" || Status == "Open"].count()%></span>
											  <span class='zcs-font-12 zcs-color-tertiary'><%=language.get("grc.assessment.inprogress")%></span>
											</div>
											<div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-align-items-center zcs-justify-center zcs-py-9' style='flex:1;flex-shrink:0;border-radius:5px;background:#ECF0F7;'>
											  <span class='zcs-font-16 zcs-color-primary'><%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Completed"].count()%></span>
											  <span class='zcs-font-12 zcs-color-tertiary'><%=language.get("grc.assessment.completed")%></span>
											</div>
										</div>
<%
			totalActionCount = Action_Plan[Risk_Assessment == assessmentDet.ID].count();
			if(totalActionCount > 0)
			{
				pendingActionPercentage = Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Overdue" || Status == "Deferred"].count() / totalActionCount * 100;
				inProgressActionPercentage = Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "In Progress" || Status == "Open"].count() / totalActionCount * 100;
				completedActionPercentage = Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Completed"].count() / totalActionCount * 100;
				%>
<div class='zcs-chart zcs-w-full zcs-barchart-wrapper zcs-relative'>
    <ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>  </span>
            <span class='zcs-col-common'> </span>
        </li>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> </span>
            <span class='zcs-col-common'> </span>
        </li>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>  </span>
            <span class='zcs-col-common'> </span>
        </li>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>  </span>
            <span class='zcs-col-common'> </span>
        </li>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>  </span>
            <span class='zcs-col-common'> </span>
        </li>
        <li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
            <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary' style='color:#fff;'> 0% </span>
            <span class='zcs-chart-y-axis-line zcs-col-common'> </span>
        </li>
    </ul>
    <div class='zcs-scrollable-container zcs-absolute'>
        <ul class='zcs-chart-x-axis zcs-wh-full zcs-flex zcs-justify-space-around zcs-gap-4 zcs-m-0 zcs-p-0'>
            <li class='zcs-flex zcs-direction-column zcs-gap-12'>
                <div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'>
                    <a class='zcs-bar-value bar-orange' href='' style='height: <%=pendingActionPercentage%>%;'></a>
                </div>
                <a class='zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis'
                    >
                    <%=language.get("grc.assessment.pending")%>
                </a>
            </li>
            <li class='zcs-flex zcs-direction-column zcs-gap-12'>
                <div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'>
                    <a class='zcs-bar-value bar-blue' href='' style='height: <%=inProgressActionPercentage%>%;'></a>
                </div>
                <a class='zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis'
                    >
                    <%=language.get("grc.assessment.inprogress")%>
                </a>
            </li>
            <li class='zcs-flex zcs-direction-column zcs-gap-12'>
                <div class='zcs-bar zcs-col-common zcs-flex zcs-align-items-end zcs-justify-center'>
                    <a class='zcs-bar-value bar-green' href='' style='height: <%=completedActionPercentage%>%;'></a>
                </div>
                <a class='zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis'
                    >
                    <%=language.get("grc.assessment.completed")%>
                </a>
            </li>
        </ul>
    </div>
</div>
<%
			}
