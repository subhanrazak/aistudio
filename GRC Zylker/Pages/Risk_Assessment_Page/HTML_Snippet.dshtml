						<path d="M234 10L223.5 18.6603L223.5 1.33975L234 10Z" fill="#FC8F01"/>
						</svg>
						<span style='color:#16A34A;font-size:20px;font-weight:700;'><%=if(controlEffectiveness != null,"-" + controlEffectiveness.round(2) + "%","-")%></span>
						<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-5'>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.control.effectiveness")%> </p>
<%
			effectiveControl = Control[ID == controlList && Operating_Effectiveness == "Highly Effective" || Operating_Effectiveness == "Effective"].count();
			partialControl = Control[ID == controlList && Operating_Effectiveness == "Moderately Effective"].count();
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=effectiveControl%> Effective <span style='font-size:4px;'>\u2022</span> <%=partialControl%> Partial </p>
						</div>

						</div>
						<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20'>
						
						 <p class="zcs-font-16 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.residualRisk")%> </p>
						  <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size:60px;color:#FC8F01;'> <%=avgResidualScore%> </h4>
<%
			if(residualScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=residualScoreColor%>;background:<%=residualScoreBackgroundColor%>;' >

											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>

											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=residualScoreStatus.Label%> </span>

										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.afterApplyingControls")%></p>
						</div>
					       
					 </div>
				</div>
			</div>
<%
			earlierDueDate = Action_Plan[Risk_Assessment == assessmentDet.ID].minimum(Target_Date);
			lateDueDate = Action_Plan[Risk_Assessment == assessmentDet.ID].maximum(Target_Date);
			earlierDue = Action_Plan[Risk_Assessment == assessmentDet.ID && Target_Date == earlierDueDate].Action_Title;
			lateDue = Action_Plan[Risk_Assessment == assessmentDet.ID && Target_Date == lateDueDate].Action_Title;
			%>
<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.treatmentActionPlans")%></h6>
			 <div class="zcs-divider zcs-divider-horizontal"></div>
			 <div class="zcs-panel-wrapper">
            <ul class="zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0">
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.treatmentStrategy")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=assessmentDet.Treatment_Option%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"><%=language.get("grc.assessment.riskAppetite")%> : <%=assessmentDet.Risk_Appetite%>  </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.actionPlans")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=Action_Plan[Risk_Assessment == assessmentDet.ID].count()%> Plans </h4>
						 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "In Progress" || Status == "Open"].count()%>  In progress</p>
                        </div>
                          
                            
                       
                    </div>
                    
                </li>
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.earliestDue")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=earlierDueDate%></h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=earlierDue%> </p>
                        </div>
                            
                       
                    </div>
                   
                </li>
               <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.lastDue")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=lateDueDate%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=lateDue%> </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
               
            </ul>
        </div>
			 
			 
			 
			 
			 
			  
		 </div>
		
		
		</div>
		
		</div>
		
		</div>
<%
		}
		else if(input.tab == "followup")
		{
			%>
<style>
		.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
			padding:0px !important; 
		}
		</style>
		<div class="zcs-panel-wrapper zcs-mt-15">
            <ul class="zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0">
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.totalFollowups")%> </p>
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=Action_Plan[Risk_Assessment == assessmentDet.ID].count()%></h4>
                        </div>
                            <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg">
                                <i class="zcs-panel-icon zcs-font-24 zc-li-outline tech-disk-reader"></i>
                            </div>
                            
                       
                    </div>
                    <a class="zcs-overlay zcs-wh-full zcs-absolute"></a>
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.activeFollowups")%> </p>
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0">  <%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "In Progress" || Status == "Open"].count()%> </h4>
                        </div>
                            <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg">
                                <i class="zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-25"></i>
                            </div>
                            
                       
                    </div>
                    <a class="zcs-overlay zcs-wh-full zcs-absolute"></a>
                </li>
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.completed")%> </p>
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Completed"].count()%> </h4>
                        </div>
                            <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg">
                                <i class="zcs-panel-icon zcs-font-24 zc-li-outline location-position-pin"></i>
                            </div>
                            
                       
                    </div>
                    <a class="zcs-overlay zcs-wh-full zcs-absolute"></a>
                </li>
               <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.pendingFollowups")%> </p>
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "Overdue" || Status == "Deferred"].count()%></h4>
                        </div>
                            <div class="zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg">
                                <i class="zcs-panel-icon zcs-font-24 zc-li-outline users-parent"></i>
                            </div>
                            
                       
                    </div>
                    <a class="zcs-overlay zcs-wh-full zcs-absolute"></a>
                </li>
               
            </ul>
        </div>
		<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border zcs-h-full">
					     
						       <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-h-full'>
							      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.followups")%></h6>
								  <div class="zcs-divider zcs-divider-horizontal"></div>
								  <div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Risk_Assessment_Report_Page' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&page_action=followup&assessment_id=<%=assessmentDet.ID%>'></div>
							   
						  
						  
						  
						  
		</div>
		</div>
		</div>
		</div>
<%
		}
		else if(input.tab == "reports")
		{
			riskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
			departmentList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Departments.getAll();
			linkedControlList = Risk_Entry[ID == riskList].distinct(Link_Controls);
			%>
<style>
    .zcs-chart ul li {
        list-style-type: none;
    }

    .zcs-chart-y-axis-text {
        width: 50px;
    }

    .zcs-chart-y-axis-line {
        border-top: 1px solid #EBECF0;
    }

    .zcs-chart-x-axis-text {
        max-width: 150px;
    }

    .zcs-scrollable-container {
        top: 10px;
        /* 2px border, 8px space*/
        left: 50px;
        /* Y axis width */
        width: calc(100% - 50px);
        height: calc(100% + 12px);
        /* Gap 12px */
        overflow-x: auto;
        overflow-y: hidden;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .zcs-scrollable-container::-webkit-scrollbar {
        display: none;
    }

    .zcs-bar-value {
        width: 47px;
        border-radius: 6px 6px 0px 0px;
        
    }
	.bar-blue
	{
		background-color: #4C82FF;
	}
	.bar-orange
	{
		background-color: #FC8F01;
	}
	.bar-green
	{
		background-color: #50B43C;
	}

    /* RTL styles start here */
    .zc-rtl-wrapper .zcs-scrollable-container {
        left: auto;
        right: 50px;
    }
	
	.zcs-control-progress-bar:last-child{
		border-radius:0 10px 10px 0 !important;
	}
	
	.zc-pra-donut-chart-{
		display:inline-flex !important;
	}
</style>
<div class='zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-my-15'>
		<div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
		<div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border'>
		 <div class='zcs-flex zcs-direction-column zcs-gap-12'>
		      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.reportsDashboards")%></h6>
			  <div class="zcs-divider zcs-divider-horizontal"></div>
			  <div class='zcs-row zcs-gap-20 zcs-w-full zcs-mt-15' style='height:333px;'>
					        <div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-6 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
							     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border zcs-h-full">
										<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.assessment.risksByDepartment")%> </h6>
										
							<div class='zcs-font-14 zcs-color-tertiary zcs-mt-9'><%=language.get("grc.assessment.riskDistributionByDepartment")%>
							</div>
										
							<div class="zcs-card-content zcs-flex  zcs-direction-column zcs-gap-23">
<%
			if(departmentList.size() > 0)
			{
				for each  departmentID in departmentList
				{
					departmentRiskCount = Risk_Entry[ID == riskList && Department == departmentID].count();
					departmentName = Department[ID == departmentID].Department_Name;
					departmentRiskPer = if(riskList.size() > 0,departmentRiskCount / riskList.size() * 100,0);
					%>
<div class="zcs-progress-bar-wrapper zcs-gap-4 ">
									<p class="zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0">
										<%=departmentName%>
									</p><div class="zcs-progress-bar zcs-rounded-sm zcs-fw" style='height:14px;border-radius: 0 10px 10px 0;'>
										<div style="width: <%=departmentRiskPer%>%;" class="zcs-progress-bar-indicator"></div>
									</div>
									
								</div>
<%
				}
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
										
										
										
										
										
										
							
									</div>	
							</div>
							
							<div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-6 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20 zcs-card'>
							<div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border zcs-h-full">
							<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.assessment.riskByCategory")%> </h6>
<%
			categoryList = Risk_Entry[ID == riskList].distinct(Risk_Category1);
			if(categoryList.size() > 0)
			{
				%>
<div class='zc-pra-card-content'>
<%
				chart_name = "";
				orderChart_Inputs = Map();
				catListCount = 0;
				showedCatList = List();
				for each  category in categoryList
				{
					if(catListCount <= 4)
					{
						categoryName = Risk_Category[ID == category].Category_Name;
						categoryCount = Risk_Entry[ID == riskList && Risk_Category1 == category].count();
						orderChart_Inputs.put(categoryName,categoryCount);
						showedCatList.add(category);
						catListCount = catListCount + 1;
					}
					else
					{
						categoryList.removeAll(showedCatList);
						categoryCount = Risk_Entry[ID == riskList && Risk_Category1 == categoryList].count();
						orderChart_Inputs.put("Others",categoryCount);
						break;
					}
				}
				colors = {"#4C82FF","#FB2C36","#50B43C","#FFBF2C","#6F51FF"};
				show_legend = true;
				%>
<%=thisapp.Components.Custom_Donut(chart_name,orderChart_Inputs,colors,show_legend)%>

					</div>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
							
							</div>
							
							</div>
			  <div class='zcs-row zcs-gap-20 zcs-w-full zcs-mt-15'  style='height:354px;'>
					        <div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
							     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
										<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.assessment.riskStatusCount")%> </h6>
<%
			levelList = Risk_Level[ID != 0].ID.getAll();
			if(levelList.size() > 0)
			{
				%>
<div class='zc-pra-card-content'>
<%
				chart_name = "";
				levelChart_Inputs = Map();
				levelList = Risk_Level[ID != 0].ID.getAll();
				for each  level in Risk_Level[ID != 0] sort by From
				{
					levelName = level.Label;
					levelCount = Risk_Entry[ID == riskList && Risk_Level == level.ID].count();
					levelChart_Inputs.put(levelName,levelCount);
				}
				colors = {"#50B43C","#6F51FF","#FC8F01","#FB2C36"};
				show_legend = true;
				%>
<%=thisapp.Components.Custom_Donut(chart_name,levelChart_Inputs,colors,show_legend)%>
					</div>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>	
							</div>
							
							<div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20 zcs-card'>
							<div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border zcs-h-full">
							<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.assessment.controlEffectivenessAnalysis")%>  </h6>
<%
			controlCategoryList = Control[ID == linkedControlList].distinct(Category);
			if(controlCategoryList.size() > 0)
			{
				%>
<div class="zcs-card-content zcs-flex  zcs-direction-column zcs-gap-23">
<%
				for each  category in controlCategoryList
				{
					categoryCount = Control[ID == linkedControlList && Category == category].count();
					categoryName = Control_Category[ID == category].Category_Name;
					categoryPer = if(linkedControlList.size() > 0,departmentRiskCount / linkedControlList.size() * 100,0);
					effectiveMap = {"Highly Effective":"#238010","Effective":"#50B43C","Moderately Effective":"#4C82FF","Weak":"#FC8F01","Ineffective":"#FB2C36"};
					effectiveKeys = effectiveMap.keys();
					%>
<div class="zcs-progress-bar-wrapper zcs-gap-4 ">
                                    <div class='zcs-flex zcs-justify-space-between'>
									<p class="zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-m-0">
										<%=categoryName%>
									</p>
									<p class="zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary zcs-m-0">
										<%=categoryCount%> Controls
									</p>
									</div>
									<div class="zcs-progress-bar zcs-rounded-sm zcs-fw zcs-flex" style='height:14px;border-radius: 0 10px 10px 0 !important;overflow: hidden;'>
<%
					for each  effective in effectiveKeys
					{
						effectiveCount = Control[ID == linkedControlList && Category == category && Operating_Effectiveness == effective].count();
						effectivePer = effectiveCount / categoryCount * 100;
						%>
<div style="width: <%=effectivePer%>%;background-color:<%=effectiveMap.get(effective)%> !important;border-radius:0px;" class="zcs-progress-bar-indicator zcs-control-progress-bar"></div>
<%
					}
					%>
