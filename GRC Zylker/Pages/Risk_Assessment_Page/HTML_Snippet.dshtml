			font-size:14px !important;
			opacity :1 !important;
		}
		</style>
		<div class="zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-p-15  zcs-overflow-auto zcs-col-common">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border zcs-h-full">
					      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskTreatment")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex zcs-px-14 zcs-pt-30 zcs-direction-column zcs-gap-50 zcs-h-full'>
						  
						 
						       <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-h-full'>
							    <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.treatmentStrategy")%></h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						   <div class='zcs-filter'  zc_MobileView='inline' elName='zc-component' formLinkName='Risk_Treatment' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Risk_Assessment=<%=assessmentDet.ID%>&Treatment_Option=<%=assessmentDet.Treatment_Option%>&Risk_Appetite=<%=assessmentDet.Risk_Appetite%>'></div>
							      
								    <div class='zcs-flex zcs-align-items-center zcs-justify-space-between'>
		     <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.actionPlans")%></h6>
			  <a href="#Form:Action_Plan?Risk_Assessment=<%=assessmentDet.ID%>&zc_LoadIn=dialog" class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body">
                <i class="zcs-button-icon zc-li-outline ui-1-simple-add"></i>
                <span class="zcs-button-text"> <%=language.get("grc.assessment.addAction")%> </span>
            </a>
			  </div>
								  <div class="zcs-divider zcs-divider-horizontal"></div>
								  <div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Risk_Assessment_Report_Page' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&page_action=actionPlans&assessment_id=<%=assessmentDet.ID%>'></div>
							   </div>
						  </div>
						  
						  
						  
						  
		</div>
		</div>
		</div>
<%
		}
		else if(input.action_field == "Approval")
		{
			riskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
			avgInherentScore = if(riskList.size() > 0,(Risk_Entry[ID == riskList].sum(Inherent_Score) / riskList.size()).toNumber(),null);
			inherentScoreStatusID = if(avgInherentScore != null,Risk_Level[From <= avgInherentScore && To >= avgInherentScore].ID,null);
			avgResidualScore = if(riskList.size() > 0,(Risk_Entry[ID == riskList].sum(Residual_Risk_Score) / riskList.size()).toNumber(),null);
			residualScoreStatusID = if(avgResidualScore != null,Risk_Level[From <= avgResidualScore && To >= avgResidualScore].ID,null);
			controlEffectiveness = if(avgInherentScore != null && avgResidualScore != null && avgInherentScore != 0,(avgInherentScore - avgResidualScore) / avgInherentScore * 100,null);
			getMaximumInherent = Risk_Entry[ID == riskList].maximum(Inherent_Score);
			primaryRisk = Risk_Entry[ID == riskList && Inherent_Score == getMaximumInherent];
			likeLihoodCount = Likelihood[ID != 0].count();
			impactCount = Impact[ID != 0].count();
			likelihoodScore = 0;
			impactScore = 0;
			for each  riskDet in riskList
			{
				riskRecord = Risk_Entry[ID == riskDet];
				if(riskRecord != null)
				{
					likelihoodScore = likelihoodScore + if(Likelihood[ID == riskRecord.Likelihood].Value != null,Likelihood[ID == riskRecord.Likelihood].Value,0);
					impactScore = impactScore + if(Impact[ID == riskRecord.Impact].Value != null,Impact[ID == riskRecord.Impact].Value,0);
				}
			}
			avgLikelihood = if(riskList.size() > 0,(likelihoodScore / riskList.size()).toNumber(),null);
			avgImpact = if(riskList.size() > 0,(impactScore / riskList.size()).toNumber(),null);
			likeLihoodValue = Likelihood[Value == avgLikelihood].Label;
			impactValue = Impact[Value == avgImpact].Label;
			controlList = Risk_Entry[ID == riskList].distinct(Link_Controls);
			if(inherentScoreStatusID != null)
			{
				inherentScoreStatus = Risk_Level[ID == inherentScoreStatusID];
				inherentScoreColor = inherentScoreStatus.Color_Code;
				inherentScoreBackgroundColor = inherentScoreColor + "26";
			}
			if(residualScoreStatusID != null)
			{
				residualScoreStatus = Risk_Level[ID == residualScoreStatusID];
				residualScoreColor = residualScoreStatus.Color_Code;
				residualScoreBackgroundColor = residualScoreColor + "26";
			}
			%>
<div class='zcs-row zcs-gap-20 zcs-w-full zcs-h-full zcs-p-15 zcs-col-common zcs-overflow-auto'>
		<div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
		<div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border'>
		 <div class='zcs-flex zcs-direction-column zcs-gap-12'>
		      <h6 class="zcs-font-20 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.approval")%></h6>
			  <div class="zcs-divider zcs-divider-horizontal"></div>
			  <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20" style='border: 1px solid #FC8F01;background: linear-gradient(90deg, #FFFAF3 100%, #FFFFFF 100%);'>
				     <div class="zcs-flex  zcs-gap-27 zcs-p-25 zcs-box-border">
					 
					 <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-m-0 " style='color:#C46F00;'> <%=language.get("grc.assessment.finalResult")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=language.get("grc.assessment.residualRiskScore")%>  </span>
					</div>
					<div class="zcs-flex  zcs-gap-8 zcs-align-items-center" style='border-left: 1px solid #FC8F01;padding:0 27px;'>
											<h6 class="zcs-font-40 zcs-font-normal zcs-lh-heading zcs-m-0" style='color:#C46F00;font-size:40px;'> <%=if(avgResidualScore != null,avgResidualScore,"-")%> </h6>
<%
			if(residualScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border' style='border:1px solid <%=residualScoreColor%>;color:<%=residualScoreColor%>;border-radius: 0.75rem;padding:0 10px ; width:max-content;height: fit-content;' >
											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=residualScoreStatus.Label%> </span>
										</div>
<%
			}
			%>
</div>
					
                        
					        <div class="zcs-flex zcs-gap-58">
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.inherent")%> </h6>
											
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=avgInherentScore%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.controlEffectiveness")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(controlEffectiveness != null,controlEffectiveness.round(2) + "%","-")%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.treatment")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=assessmentDet.Treatment_Option%> </span>
							</div>
