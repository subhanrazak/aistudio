<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border' style='border:1px solid <%=residualScoreColor%>;color:<%=residualScoreColor%>;border-radius: 0.75rem;padding:0 10px ; width:max-content;height: fit-content;' >
