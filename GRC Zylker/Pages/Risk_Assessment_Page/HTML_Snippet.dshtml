					 </div>
				 </div>
			 </div>
			<!-- <div class='zcs-flex zcs-gap-16 zcs-justify-center zcs-align-items-center'>
			 
			       <div class='zcs-flex zcs-p-20 zcs-direction-column zcs-card'>
				   <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.riskEntry.riskOwner")%></p>
				   
						 
				   
				   </div>
			      <div >
				  <i value="arrows-1-tail-right" html="arrows-1-tail-right" class="arrows-1-tail-right zc-li-outline" style='color:#9595AB;font-size:16px;'></i>
				  </div>
				   <div class='zcs-flex zcs-p-20 zcs-direction-column zcs-card'>
				    <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.assessment.assessors")%></p>
