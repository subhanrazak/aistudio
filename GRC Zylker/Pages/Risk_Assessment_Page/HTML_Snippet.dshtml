			 <div class="zcs-panel-wrapper">
            <ul class="zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0">
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.primaryRisk")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=primaryRisk.Risk_Title%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=primaryRisk.Risk_ID%> </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.riskEntry.inherentScore")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=primaryRisk.Inherent_Score%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"><%=language.get("grc.process.riskLevel")%> :  <%=primaryRisk.Risk_Level.Label%> </p>
                        </div>
                          
                            
                       
                    </div>
                    
                </li>
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.assessmentWindow")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=assessmentDet.Start_Date%> - <%=assessmentDet.End_Date%></h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.methodology")%> : <%=likeLihoodCount%> <i class="ui-1-simple-remove zc-li-outline" style='font-size: 10px;font-weight: 700;'></i>  <%=impactCount%> L <i class="ui-1-simple-remove zc-li-outline" style='font-size: 10px;font-weight: 700;'></i> I </p>
                        </div>
                            
                       
                    </div>
                   
                </li>
               <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.riskEntry.riskOwner")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=primaryRisk.Risk_Owner.Name%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=primaryRisk.Risk_Owner.Designation.Designation_Name%> </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
               
            </ul>
        </div>
		<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.riskScoringJourney")%></h6>
			 <div class="zcs-divider zcs-divider-horizontal"></div>
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20" style='border: 1px solid;border-image-source: linear-gradient(270deg, #FB2C36 0%, rgba(255, 255, 255, 0) 100%);background: linear-gradient(90deg, #FFD8DA 0%, rgba(255, 255, 255, 0) 50%, #FFEBD0 100%);'>
				     <div class="zcs-flex zcs-p-14 zcs-box-border zcs-justify-space-around">
					    <div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20'>
						
						 <p class="zcs-font-16 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.inherentRisk")%> </p>
						  <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size:60px;color:#FB2C36;'> <%=avgInherentScore%> </h4>
<%
			if(inherentScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=inherentScoreColor%>;background:<%=inherentScoreBackgroundColor%>;' >

											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>

											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=inherentScoreStatus.Label%> </span>

										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  L=<%=if(avgLikelihood != null,avgLikelihood,"-")%> (<%=likeLihoodValue%>) <i class="ui-1-simple-remove zc-li-outline" style='font-size: 10px;font-weight: 700;'></i> I=<%=if(avgImpact != null,avgImpact,"-")%> (<%=impactValue%>)</p>
						</div>
						 <div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20 zcs-justify-center'>
						 <div style='background: #EEF2FF;border-radius: 56px;padding: 8px 9px;'><i style="color:#4F46E5" class="ui-3-security zc-li-solid" value="ui-3-security"></i> <%=controlList.size()%> Controls Mapped</div>
						<svg width="234" height="20" viewBox="0 0 234 20" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M14 10L3.5 18.6603L3.5 1.33975L14 10Z" fill="#FFC2C2"/>
						<path d="M36 10L25.5 18.6603L25.5 1.33975L36 10Z" fill="#FFC2C2"/>
						<path d="M58 10L47.5 18.6603L47.5 1.33975L58 10Z" fill="#FFC2C2"/>
						<path d="M80 10L69.5 18.6603L69.5 1.33975L80 10Z" fill="#FFC2C2"/>
						<path d="M102 10L91.5 18.6603L91.5 1.33975L102 10Z" fill="#FFC2C2"/>
						<path d="M124 10L113.5 18.6603L113.5 1.33975L124 10Z" fill="#FFC2C2"/>
						<path d="M146 10L135.5 18.6603L135.5 1.33975L146 10Z" fill="#FC8F01"/>
						<path d="M168 10L157.5 18.6603L157.5 1.33975L168 10Z" fill="#FC8F01"/>
						<path d="M190 10L179.5 18.6603L179.5 1.33975L190 10Z" fill="#FC8F01"/>
						<path d="M212 10L201.5 18.6603L201.5 1.33975L212 10Z" fill="#FC8F01"/>
						<path d="M234 10L223.5 18.6603L223.5 1.33975L234 10Z" fill="#FC8F01"/>
						</svg>
						<span style='color:#16A34A;font-size:20px;font-weight:700;'><%=if(controlEffectiveness != null,"-" + controlEffectiveness.round(2) + "%","-")%></span>
						<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-5'>
						<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.control.effectiveness")%> </p>
<%
			effectiveControl = Control[ID == controlList && Operating_Effectiveness == "Highly Effective" || Operating_Effectiveness == "Effective"].count();
			partialControl = Control[ID == controlList && Operating_Effectiveness == "Moderately Effective"].count();
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=effectiveControl%> Effective <span style='font-size:4px;'>\u2022</span> <%=partialControl%> Partial </p>
						</div>

						</div>
						<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-20'>
						
						 <p class="zcs-font-16 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.residualRisk")%> </p>
						  <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size:60px;color:#FC8F01;'> <%=avgResidualScore%> </h4>
<%
			if(residualScoreStatusID != null)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=residualScoreColor%>;background:<%=residualScoreBackgroundColor%>;' >

											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>

											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=residualScoreStatus.Label%> </span>

										</div>
<%
			}
			else
			{
				%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> - </span>
<%
			}
			%>
<p class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.afterApplyingControls")%></p>
						</div>
					       
					 </div>
				</div>
			</div>
<%
			earlierDueDate = Action_Plan[Risk_Assessment == assessmentDet.ID].minimum(Target_Date);
			lateDueDate = Action_Plan[Risk_Assessment == assessmentDet.ID].maximum(Target_Date);
			earlierDue = Action_Plan[Risk_Assessment == assessmentDet.ID && Target_Date == earlierDueDate].Action_Title;
			lateDue = Action_Plan[Risk_Assessment == assessmentDet.ID && Target_Date == lateDueDate].Action_Title;
			%>
<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessment.treatmentActionPlans")%></h6>
			 <div class="zcs-divider zcs-divider-horizontal"></div>
			 <div class="zcs-panel-wrapper">
            <ul class="zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0">
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.treatmentStrategy")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=assessmentDet.Treatment_Option%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"><%=language.get("grc.assessment.riskAppetite")%> : <%=assessmentDet.Risk_Appetite%>  </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.actionPlans")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=Action_Plan[Risk_Assessment == assessmentDet.ID].count()%> Plans </h4>
						 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=Action_Plan[Risk_Assessment == assessmentDet.ID && Status == "In Progress" || Status == "Open"].count()%>  In progress</p>
                        </div>
                          
                            
                       
                    </div>
                    
                </li>
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.earliestDue")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=earlierDueDate%></h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=earlierDue%> </p>
                        </div>
                            
                       
                    </div>
                   
                </li>
               <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between" style='box-shadow:none !important;'>
					<div class="zcs-flex zcs-justify-center zcs-gap-5 zcs-direction-column">
					 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=language.get("grc.assessment.lastDue")%> </p>
                        <h4 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=lateDueDate%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0">  <%=lateDue%> </p>
                        </div>
                           
                            
                       
                    </div>
                   
                </li>
               
            </ul>
        </div>
			 
			 
			 
			 
			 
			  
		 </div>
		
		
		</div>
		
