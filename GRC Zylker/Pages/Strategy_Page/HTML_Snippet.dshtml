                            </div>
                        </div>    
                       <div class="zcs-progress-bar zcs-rounded-sm">
					   <div class="zcs-progress-bar-indicator" style='width: <%=if(totalCount > 0,Strategy[ID != 0].count() / totalCount * 100,0)%>%'></div>
					</div>
                    </div>
					<a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                   
                </li>
