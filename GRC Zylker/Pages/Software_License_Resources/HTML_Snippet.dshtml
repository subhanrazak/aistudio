<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-p-17" style='background: #F9FAFB;border: 1px solid #E5E7EB;border-radius: 10px;'> <%=softwareDet.Notes%> </span>
<%
		}
		%>
</div>	
									 
