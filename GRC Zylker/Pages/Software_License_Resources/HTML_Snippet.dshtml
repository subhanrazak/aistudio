								<div class="zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center" style="--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%">

<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(softwareDet.Vendor.Vendor_Name)%></span>

</div>
								<div class="zcs-flex zcs-direction-column zcs-gap-6">
