			}
			%>
<h4 class="zcs-font-12 zcs-font-medium zcs-lh-heading  zcs-m-0"> <%=standard%> </h4>
						 
                     
                   
                </div>
<%
		}
		%>
</div>
						  </div>
						 <div class='zcs-flex zcs-w-full zcs-gap-6'>
						     <div class="zcs-flex zcs-direction-column zcs-gap-6" style='width:50%;'>
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.businessCriticality")%> </h6>
<%
		if(softwareDet.Business_Criticality == "High")
		{
			badgeClass = "zcs-badge-orange";
		}
		else if(softwareDet.Business_Criticality == "Medium")
		{
			badgeClass = "zcs-badge-yellow";
		}
		else if(softwareDet.Business_Criticality == "Low")
		{
			badgeClass = "zcs-badge-green";
		}
		else if(softwareDet.Business_Criticality == "Critical")
		{
			badgeClass = "zcs-badge-red";
		}
		%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=softwareDet.Business_Criticality%> </span>
				</div>
										    
							        </div>
								<div class="zcs-flex zcs-direction-column zcs-gap-6" style='width:50%;'>
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.objective.department")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Department.Department_Name%> </span>
							         </div>
						 </div>
						  
					 </div>
				</div>
			</div>
			<div  class="zcs-row zcs-gap-20 zcs-w-full zcs-mt-15" style='height:190px;'>
					        <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-6 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
							     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-25 zcs-box-border">
										<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.software.licenseOwner")%> </h6>
										<div class="zcs-flex zcs-gap-16  zcs-rounded-md zcs-p-16 ">
								
