<%
		if(softwareDet.License_Owner.Photo != null && softwareDet.License_Owner.Photo != "")
		{
			ownerImage = zoho.appuri + "report/User_Report/" + softwareDet.License_Owner + "/Photo/download-file?filepath=/" + softwareDet.License_Owner.Photo.getSuffix("image/").getPrefix("\\"") + "&mediaType=1";
			%>
<img class='zcs-avatar-img zcs-wh-full' src=<%=ownerImage%> alt="John Smith profile photo"
											height="100%" width="100%">
<%
		}
		else
		{
			%>
<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(softwareDet.License_Owner.Name)%></span>
<%
		}
		%>
</div>
								<div class="zcs-flex zcs-direction-column zcs-gap-6">
								    	<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-mb-4 zcs-mt-0"> <%=softwareDet.License_Owner.Name%></h6>
								   <div class='zcs-flex zcs-gap-8 zcs-align-items-center zcs-color-tertiary'><i value="ui-1-email-83" html="ui-1-email-83" class="ui-1-email-83 zc-li-outline"></i> <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=softwareDet.License_Owner.Email%> </p></div>
								
									<div class='zcs-flex zcs-gap-8 zcs-align-items-center zcs-color-tertiary'><i value="users-man-23" html="users-man-23" class="users-man-23 zc-li-outline"></i><p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=softwareDet.License_Owner.Role.Role_Name%> </p></div>
								</div>
							</div>
								 </div>
