<%
	page_link_name = "Software_License_Resources";
	language = thisapp.Content.translation();
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>
<%=thisapp.Styles_Page.Common_View()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Divider()%>
<%=thisapp.Styles.Label_Value()%>
<%=thisapp.Styles.Avatar()%>
.zcs-complaince-div{
	background:#F3F4F6;
	color:#6A7282;
	border-radius:30px;
	
}
.zcs-divider-horizontal {
   
    border-color: #F3F4F6 !important;
}
.zcs-text-white{
	color:#fff;
}
</style>
<%
	if(input.page_action == "add")
	{
		if(input.recid != null)
		{
			%>
<%=thisapp.Components.Add_Record(language.get("grc.software.formHeader"),"#Page:" + page_link_name + "?page_action=detailView&recid=" + input.recid,"Software_License","zc_Header=false&zc_SubmitVal=Create&recLinkID=" + input.recid + "&viewLinkName=Software_Licenses")%>;
<%
		}
		else
		{
			%>
<%=thisapp.Components.Add_Record(language.get("grc.software.formHeader"),"#Page:" + page_link_name,"Software_License","zc_Header=false&zc_SubmitVal=Create")%>;
<%
		}
	}
	else if(input.page_action == "detailView")
	{
		softwareDet = Software_License[ID == input.recid];
		if(softwareDet.License_Status == "Expiring Soon")
		{
			badgeClass = "zcs-badge-orange";
		}
		else if(softwareDet.License_Status == "Under Maintenance")
		{
			badgeClass = "zcs-badge-blue";
		}
		else if(softwareDet.License_Status == "Pending Activation")
		{
			badgeClass = "zcs-badge-grey";
		}
		else if(softwareDet.License_Status == "Active")
		{
			badgeClass = "zcs-badge-green";
		}
		else if(softwareDet.License_Status == "Expired")
		{
			badgeClass = "zcs-badge-red";
		}
		%>
<div class='zcs-page-container zcs-page-fleet_driver zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
	           <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
			<div class='zcs-flex zcs-gap-16 zcs-ellipsis'>
				<a class='zcs-back' href='#Page:<%=page_link_name%>'>
					<i class='zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left'></i>
				</a>
				<div class='zcs-flex zcs-direction-column zcs-gap-8 '>
				
						<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=softwareDet.Software_Name%> </h5>
						
					
					
					<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0' >
						Monitor risk posture and drive governance actions.
					</p>



					
				</div>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
<%
		if(thisapp.permission.app_access("software_licences") == true)
		{
			%>
<a href='#Page:<%=page_link_name%>?page_action=add&recid=<%=softwareDet.ID%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
					<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
					<span class='zcs-button-text'> <%=language.get("grc.edit.text")%> </span>
				</a>
<%
		}
		%>
</div>
		</div>
		
		  <div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border'>
		       <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex   zcs-justify-space-between zcs-p-25 zcs-box-border">
					       <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseStatus")%> </h6>

<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=softwareDet.License_Status%> </span>
				</div>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.totalLicenses")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Total_Licenses%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.allocated")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Allocated_Users%> Users </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.utilization")%> </h6>
											<div class="zcs-progress-bar zcs-rounded-sm" style='height:6px !important;width:135px;'>
									<div style="width: <%=if(softwareDet.Utilization != null,softwareDet.Utilization,0)%>%;" class="zcs-progress-bar-indicator"></div>
					</div>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(softwareDet.Utilization != null,softwareDet.Utilization.toNumber() + "%","")%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.renewalCountdown")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(softwareDet.Renewal_Date > zoho.currentdate,(zoho.currentdate.daysBetween(softwareDet.Renewal_Date) + 1) + " Days Left","-")%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.annualCost")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.License_Cost + if(softwareDet.Support_Cost != null,softwareDet.Support_Cost,"0")%> </span>
							</div>
							
						  
					 </div>
				 </div>
			 </div>
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.strategy.basicInformation")%> </h6>
						  <div class='zcs-flex zcs-w-full zcs-gap-50' >
						      <div class='zcs-flex zcs-direction-column zcs-gap-12' style='width:50%;'>
							         <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.softwareName")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Software_Name%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.vendor")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Vendor.Vendor_Name%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
							  </div>
							  <div class='zcs-flex zcs-direction-column zcs-gap-12' style='width:50%;'>
							        <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.versionEdition")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Version_Edition%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.incident.category")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Category%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
							  </div>
						  </div>
						  <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.strategy.description")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Description%> </span>
							         </div>
					 </div>
				</div>
			</div>
			
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.software.licenseInformation")%> </h6>
						  <div class='zcs-flex zcs-w-full zcs-gap-50' >
						      <div class='zcs-flex zcs-direction-column zcs-gap-12' style='width:50%;'>
							         <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseType")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.License_Type%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.totalLicenses")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Total_Licenses%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									  <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.purchaseDate")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Purchase_Date%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.autoRenewal")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(softwareDet.Enable_automatic_renewal == true,"Enabled","Disabled")%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
							  </div>
							  <div class='zcs-flex zcs-direction-column zcs-gap-12' style='width:50%;'>
							        <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseKey")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.License_Key%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.allocatedUsers")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Allocated_Users%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.renewalDate")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Renewal_Date%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseStatus")%> </h6>
											<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=softwareDet.License_Status%> </span>
				</div>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
							  </div>
						  </div>
						  <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseUtilization")%> </h6>
										    <div class="zcs-progress-bar zcs-rounded-sm" style='height:12px !important;width:100% !important;'>
									<div style="width: <%=if(softwareDet.Utilization != null,softwareDet.Utilization,0)%>%;" class="zcs-progress-bar-indicator"></div>
					</div>
					<span class="zcs-badge-text zcs-font-12 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=softwareDet.Allocated_Users%> / <%=softwareDet.Total_Licenses%> (<%=softwareDet.Utilization%>)% </span>
							         </div>
					 </div>
				</div>
			</div>
			
			<div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.software.costInformation")%> </h6>
						  <div class='zcs-flex zcs-w-full zcs-gap-50' >
						      <div class='zcs-flex zcs-direction-column zcs-gap-12' style='width:50%;'>
							         <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseCost")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.License_Cost%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.supportCost")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=if(softwareDet.Support_Cost != null,softwareDet.Support_Cost,"-")%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.billingPeriod")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Billing_Period%> </span>
							         </div>
									 <div class="zcs-divider zcs-divider-horizontal"></div>
									 <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.currency")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.Currency%> </span>
							         </div>
									 
							  </div>
							  <div class='zcs-flex zcs-direction-column zcs-gap-12   zcs-justify-center zcs-px-25' style='width:50%;border: 1px solid #EF444420;border-radius:14px;background: linear-gradient(135deg, rgba(239, 68, 68, 0.063) 0%, rgba(239, 68, 68, 0.02) 100%);'>
							  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.totalAnnualCost")%> </h6>
							 
							  <span class="zcs-badge-text zcs-font-36 zcs-font-normal zcs-lh-body" style='font-weight:700;color:#101828;font-size: 36px;'>  <%=softwareDet.License_Cost + if(softwareDet.Support_Cost != null,softwareDet.Support_Cost,"0")%></span>
							   <div class="zcs-divider zcs-divider-horizontal" style='border-top: 1px solid #EF444420 !important;'></div>
							   <div class="zcs-flex  zcs-gap-6 zcs-justify-space-between">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.licenseCost")%>: </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=softwareDet.License_Cost%> </span>
							         </div>
									
									 <div class="zcs-flex  zcs-gap-6 zcs-justify-space-between">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.supportCost")%>: </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=if(softwareDet.Support_Cost != null,softwareDet.Support_Cost,"-")%> </span>
							         </div>
							        
							  </div>
						  </div>
						  
					 </div>
				</div>
			</div>
			
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.software.complianceRisk")%> </h6>
						  <div class='zcs-flex zcs-direction-column zcs-gap-12' >
						    <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.software.complianceRequirements")%> </h6>
<%
		standardList = {"SOX (Sarbanes-Oxley) Required","GDPR Related","HIPAA Compliant","ISO 27001 Required","PCI DSS Compliant"};
		%>
<div class="zcs-flex zcs-mb-15 zcs-gap-8  ">
<%
		for each  standard in standardList
		{
			style_txt = "";
			if(standard == softwareDet.Compliance_Requirements1)
			{
				style_txt = "style='color:#22C55E !important;background: #22C55E15 !important;'";
			}
			%>
<div class="zcs-flex zcs-px-18 zcs-py-7 zcs-complaince-div" <%=style_txt%> >
<%
			if(standard == softwareDet.Compliance_Requirements1)
			{
				%>
<i value="ui-1-check-small" html="ui-1-check-small" class="ui-1-check-small zc-li-outline"></i>
