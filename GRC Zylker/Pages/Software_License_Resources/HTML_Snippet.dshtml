<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-px-12 zcs-py-5" style='background:#DBEAFE;color:#1447E6;width: fit-content;border-radius: 30px;'> <%=softwareDet.Tags%> </span>
<%
