<%
	page_link_name = "User_Management";
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>
<%=thisapp.Styles_Page.Common_View()%>
</style>
<%
	if(input.page_action == "add")
	{
		if(input.recid != null)
		{
			%>
<%=thisapp.Components.Add_Record("Users","#Page:" + page_link_name,"User","zc_Header=false&zc_SubmitVal=Create&recLinkID=" + input.recid + "&viewLinkName=User_Report")%>;
<%
		}
		else
		{
			%>
<%=thisapp.Components.Add_Record("Users","#Page:" + page_link_name,"User","zc_Header=false&zc_SubmitVal=Create")%>;
<%
		}
	}
	else
	{
		%>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> User Management </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Monitor risk posture and drive governance actions.</p>
			</div>
            <a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> Add User </span>
            </a>
        </div>
        <div class='zcs-panel-wrapper'>
            <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
                    <div class='zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> Total Users </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=User[ID != 0].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' href=''></a>
                </li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
                    <div class='zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> Active Users </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=User[Status == "Active"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' href=''></a>
                </li>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
                    <div class='zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> Roles </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Role[ID != 0].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' href=''></a>
                </li>
               <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'>
                    <div class='zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> Departments </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Department[ID != 0].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline arrows-4-restore'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' href=''></a>
                </li>
               
            </ul>
        </div>
		<div class='zcs-page-content zcs-card zcs-col-common zcs-overflow-auto'>
          
                    <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=overView&Page=<%=page_link_name%>'></div>
					<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='User_Report' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false'></div>
               
		</div>
	</div>
</div>
<%
	}
%>