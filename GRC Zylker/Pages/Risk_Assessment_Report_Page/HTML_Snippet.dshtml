<div style='height:calc(100% - 52px);overflow:auto;'>
<%
			for each  assessment in Risk_Assessment[ID == assessmentIDList] sort by Added_Time desc range from input.start_index to end_index
			{
				assessmentProgress = if(assessment.Overall_progress != null,assessment.Overall_progress,0);
				%>
<div class='zcs-row zcs-gap-20 zcs-w-full zcs-mb-15' >
<div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
     <div class='zcs-flex zcs-direction-column   zcs-box-border'>
	         <div class='zcs-flex zcs-justify-space-between zcs-m-20 zcs-box-border' style='border-bottom: 1px solid #ECEAF7;padding-bottom: 16px;'>
			      <div class='zcs-flex zcs-gap-16'>
