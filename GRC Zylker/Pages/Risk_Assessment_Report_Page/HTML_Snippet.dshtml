                        <div class='zcs-flex zcs-direction-column zcs-gap-4'>
						   <span class='zcs-font-18 zcs-color-primary'><%=assessment.Assessment_Title%></span>
						   <div class='zcs-flex zcs-gap-8 zcs-align-items-center'>
						         <span class='zcs-font-12 zcs-color-tertiary zcs-px-6 zc-py-3' style='background:#F1F5F9;border-radius:4px;'><%=assessment.Assessment_ID%></span>
								 <span class='zcs-font-12 zcs-color-tertiary'>\u2022 Updated <%=assessment.Modified_Time.toDate()%></span>
						   </div>
						</div>
				  </div>
				  
				  <div class='zcs-flex zcs-direction-column zcs-gap-8 zcs-align-items-end'>
<%
				if(assessment.Status == "Not Started")
				{
					badgeClass = "zcs-badge-orange";
				}
				else if(assessment.Status == "In Progress")
				{
					badgeClass = "zcs-badge-blue";
				}
				else if(assessment.Status == "Completed")
				{
					badgeClass = "zcs-badge-green";
				}
				else if(assessment.Status == "On Hold")
				{
					badgeClass = "zcs-badge-red";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=assessment.Status%> </span>
				</div>
				<div class='zcs-flex zcs-gap-10 zcs-align-items-center'>
				   <div style="height:6px !important;width:100px !important;" class="zcs-progress-bar zcs-rounded-sm">
									<div class="zcs-progress-bar-indicator" style="width: <%=assessmentProgress%>%"></div>
					</div>
					<span class='zcs-font-12 zcs-color-tertiary'><%=assessmentProgress%>%</span>
				</div>
		
				  </div>
				 
			 </div>
			  <div class='zcs-flex zcs-gap-38 zcs-h-full  zcs-p-20' style='border-bottom: 1px solid #ECEAF7;'>
				     <div class='zcs-flex zcs-gap-40 zcs-direction-column zcs-h-full' style='flex:1;flex-shrink:0;border-right:1px solid #ECEAF7;'>
					      <div class='zcs-flex'>
						  <div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex:1;flex-shrink:0;'>
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentPeriod")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"><%=assessment.Assessment_Period%> </span>
							</div>
							<div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex:1;flex-shrink:0;'>
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.assessmentType")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"> <%=assessment.Assessment_Type%> </span>
							</div>
						  </div>
						  <div class="zcs-flex zcs-direction-column zcs-gap-4" >
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessment.targetCompletion")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary"> <%=assessment.Target_Completion_Date%> </span>
							</div>
					 </div>
					 <div class='zcs-flex zcs-h-full zcs-direction-column zcs-gap-20 ' style='flex:1;flex-shrink:0;border-right:1px solid #ECEAF7;'>
					 
					    <div class='zcs-flex zcs-gap-6 zcs-direction-column '>
					    
    
								<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'
									style='--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%;background: #FFE2E9;color: #FF4572;'>
									<span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=thisapp.Content.letterGenerate(assessment.Assessment_Owner.Name)%> </span>
								</div>
    
                         
						   <span class='zcs-color-tertiary zcs-font-12'><%=language.get("grc.assessment.owner")%></span>
						   </div>
						   <div class='zcs-flex'>
						    <div class='zcs-flex zcs-gap-6 zcs-direction-column ' style='flex:1;flex-shirnk:0;'>
					    
                               <div class='zcs-avatar-wrapper zcs-avatar-grp zcs-flex zcs-align-items-center'>
<%
				if(assessment.Assessors.size() > 0)
				{
					for each  assessor in assessment.Assessors
					{
						%>
<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'
									style='--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%;background: #ECE8FF;color: #6F51FF;'>
									<span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=thisapp.Content.letterGenerate(if(assessor.Resource_Type == "Internal Resource",assessor.Internal_Resource.Name,assessor.Name))%> </span>
								</div>
<%
					}
				}
				else
				{
					%>
<span class='zcs-color-tertiary zcs-font-12'> - </span>
<%
				}
				%>
</div>
    
                         
						   <span class='zcs-color-tertiary zcs-font-12'><%=language.get("grc.assessment.assessors")%></span>
						   </div>
						   
						   <div class='zcs-flex zcs-gap-6 zcs-direction-column ' style='flex:1;flex-shirnk:0;'>
					    
                               <div class='zcs-avatar-wrapper zcs-avatar-grp zcs-flex zcs-align-items-center'>
<%
				if(assessment.Approvers.size() > 0)
				{
					for each  reader in assessment.Approvers
					{
						%>
<div class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'
									style='--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%;background: #E5F4EB;color: #16A34A;'>
									<span class='zcs-font-14 zcs-font-normal zcs-lh-body '> <%=thisapp.Content.letterGenerate(reader.Name)%> </span>
								</div>
<%
					}
				}
				else
				{
					%>
<span class='zcs-color-tertiary zcs-font-12'> - </span>
<%
				}
				%>
</div>
    
                         
						   <span class='zcs-color-tertiary zcs-font-12'><%=language.get("grc.assessment.approvers")%></span>
						   </div>
					        </div>
						   
					 </div>
					 <div class='zcs-flex zcs-h-full zcs-align-items-center' style='flex:1;flex-shrink:0;'>
					       <div class='zcs-card zcs-flex  zcs-direction-column zcs-border-box zcs-px-17 zcs-py-15 zcs-w-full zcs-gap-8' style='background: linear-gradient(180deg, rgba(255, 249, 249, 0) 0%, #FFF5F6 100%);border-radius:10px;'>
						     <div class='zcs-flex zcs-gap-8 zcs-align-items-center'>
							   <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M8.66723 14.5217L7.97213 15.4283C7.46556 16.0891 7.21228 16.4194 6.92849 16.6056C6.32875 16.9989 5.56427 17.041 4.92496 16.7159C4.62244 16.5621 4.33441 16.2615 3.75834 15.6604C3.29523 15.1772 3.06368 14.9356 2.93057 14.6769C2.65032 14.1323 2.63506 13.4893 2.88917 12.932C3.00986 12.6673 3.2297 12.415 3.66937 11.9103L6.13546 9.07972C7.15123 7.91381 7.65912 7.33086 8.29693 7.1868C8.55583 7.12832 8.82379 7.12196 9.08517 7.1681C9.7291 7.28174 10.2641 7.83996 11.334 8.95638" stroke="#FB2C36" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M11.3328 4.78265L11.867 4.2252C12.5057 3.55876 12.825 3.22553 13.1803 3.06601C13.7014 2.83206 14.2976 2.83206 14.8187 3.06601C15.174 3.22553 15.4933 3.55876 16.132 4.2252C16.6986 4.8164 16.9819 5.11201 17.1245 5.43906C17.3335 5.91851 17.3463 6.46075 17.1603 6.94958C17.0334 7.28302 16.7645 7.59173 16.2266 8.20914L13.8645 10.9203C12.8488 12.0862 12.3409 12.6691 11.7031 12.8132C11.4442 12.8717 11.1762 12.878 10.9148 12.8319C10.2709 12.7183 9.73594 12.16 8.66602 11.0436" stroke="#FB2C36" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
<span style='color:#FB2C36;' class='zcs-font-10'> <%=language.get("grc.assessment.linkedPlan")%></span>
							 </div>
<%
				if(assessment.Assessment_Plan != null)
				{
					%>
<div class='zcs-flex zcs-gap-5 zcs-direction-column'>
							     <div class='zcs-font-14 zcs-color-primary'><%=assessment.Assessment_Plan.Plan_Name%></div>
								 <div class='zcs-flex zcs-justify-space-between'>
								    <span class='zcs-font-12 zcs-color-tertiary'><%=assessment.Assessment_Plan.Planning_Period%></span>
									<span class='zcs-font-12 zcs-color-primary'>Budget : <%=assessment.Assessment_Plan.Budget_Required%></span>
								 </div>
							 </div>
							 <div class="zcs-divider zcs-divider-horizontal"></div>
						      <div class='zcs-flex zcs-justify-space-between'>
							        <div class='zcs-flex zcs-gap-6 zcs-align-items-center'>
									<i value="users-man-23" html="users-man-23" class="users-man-23 zc-li-outline zcs-color-tertiary"></i>
									  <span class='zcs-font-12 zcs-color-tertiary'><%=assessment.Assessment_Plan.Plan_Owner.Name%></span>
									</div>
									<a target="_blank" class='zcs-flex zcs-gap-6 zcs-align-items-center' href='#Page:Assessment_Plan_Page?page_action=detailView&recid=<%=assessment.Assessment_Plan%>'>
									<span class='zcs-font-12 zcs-color-tertiary'><%=language.get("grc.assessment.view")%></span>
									  <i value="arrows-1-minimal-right" html="arrows-1-minimal-right" class="arrows-1-minimal-right zc-li-outline zcs-color-tertiary"></i>
									</a>
							  </div>
<%
				}
				else
				{
					%>
<div class='zcs-font-14 zcs-color-primary'><%=language.get("grc.assessment.noLinkedPlan")%></div>
<%
				}
				%>
</div>
					 </div>
					 
				  </div>
				  <div class='zcs-flex zcs-px-20 zcs-py-16 zcs-justify-space-between zcs-align-items-center' style='background:#FBFDFD;'>
				     <div class='zcs-flex zcs-gap-12 zcs-align-items-center'>
					     <div class='zcs-flex zcs-gap-37' style='border:1px solid #E2E8F0;border-radius:8px;padding:8px 10px;background: #fff;'>
						 <span class='zcs-font-12 zcs-color-primary'><%=language.get("grc.preference.departments")%></span>
						   <div class='zcs-color-primary zcs-font-12'style='background:#FFF3E6;border-radius:6px;border-left:1px solid #FC8F01;padding:3px 9px;'><%=Risk_Assessment_Libraries[Risk_Assessment == assessment.ID && Departments != null].count()%></div>
						 </div>
						 <div class='zcs-flex zcs-gap-37' style='border:1px solid #E2E8F0;border-radius:8px;padding:8px 10px;background: #fff;'>
						   <span class='zcs-font-12 zcs-color-primary'><%=language.get("grc.objective.formHeader")%></span>
						   <div class='zcs-color-primary zcs-font-12'style='background:#FEF2FF;border-radius:6px;border-left:1px solid #6F51FF;padding:3px 9px;'><%=Risk_Assessment_Libraries[Risk_Assessment == assessment.ID && Objectives != null].count()%></div>
						 </div>
						 <div class='zcs-flex zcs-gap-37' style='border:1px solid #E2E8F0;border-radius:8px;padding:8px 10px;background: #fff;'>
						   <span class='zcs-font-12 zcs-color-primary'><%=language.get("grc.process.formHeader")%></span>
						   <div class='zcs-color-primary zcs-font-12'style='background:#DFEEFF;border-radius:6px;border-left:1px solid #2493E4;padding:3px 9px;'><%=Risk_Assessment_Libraries[Risk_Assessment == assessment.ID && Processes != null].count()%></div>
						 </div>
					 </div>
					 <div class='zcs-flex zcs-gap-13'>
					 
					 <a href="#Page:Risk_Assessment_Page?page_action=detailView&recid=<%=assessment.ID%>&filter_tab=<%=input.tab%>" class="zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body">
                
                <span class="zcs-button-text"> <%=language.get("grc.assessment.viewAssessment")%> </span>
            </a>
<%
				userDet = User[Email == zoho.loginuserid].ID;
				if(userDet != null)
				{
					resource = Resource[Internal_Resource == userDet].ID;
				}
				else
				{
					resource = Resource[Email == zoho.loginuserid].ID;
				}
				if(resource != null && (assessment.Current_Work_Sheet_User == null && assessment.Assessors == resource && assessment.Assessors.size() > 0 && assessment.Send_for_Approval == false) || (assessment.Current_Work_Sheet_User == resource && assessment.Send_for_Approval == false) || (assessment.Approvers == userDet && assessment.Work_Sheet_Status == "Approval" && assessment.Status == "In Progress" && assessment.Send_for_Approval == true))
				{
					%>
<a href="#Page:Risk_Assessment_Page?page_action=openWorkSheet&recid=<%=assessment.ID%>&filter_tab=<%=input.tab%>" class='zcs-flex zcs-align-items-center zcs-px-11 zcs-py-8 zcs-gap-13' style='background:#0F172B;border-radius:8px;color:#fff;'> 
					 <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M10 2H14V6" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M6.66602 9.33333L13.9993 2" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M12 8.66667V12.6667C12 13.0203 11.8595 13.3594 11.6095 13.6095C11.3594 13.8595 11.0203 14 10.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V5.33333C2 4.97971 2.14048 4.64057 2.39052 4.39052C2.64057 4.14048 2.97971 4 3.33333 4H7.33333" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
                   <span><%=language.get("grc.assessment.openWorksheet")%></span>

					 </a>
<%
				}
				%>
</div>
				  </div>
	 </div>
</div>

</div>
<%
			}
			%>
</div>
<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_assessment_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
	}
	%>
</div>