<%
	language = thisapp.Content.translation();
	pageParam = "";
	paddingClass = if(input.page_action == "" || input.page_action == null || input.page_action == "null","zcs-px-20 zcs-pt-0 zcs-box-border zcs-h-full","");
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Table()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Pagination()%>

.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	box-sizing: border-box;
}

.zcs-main-container {
    height: 100%;
	background :var(--zcs-white-color);
}
.zcs-pagination {
    height: 32px;
    padding: 10px;
    box-sizing: content-box;
	background :var(--zcs-white-color);
}
.zcs-table-wrapper {
	height: calc(100% - 52px);
}
/* .zcs-table-wrapper table {
    height: 100%;
    table-layout: auto;
	overflow: auto;
} */
.zcs-table-wrapper table thead {
    z-index: 1;
}
.zcs-table-wrapper table tbody tr {
   position:relative;
}
.zcs-detail-view-td{
	position:absolute;
	border: none !important;
    inset: 0;
    background: transparent !important;
	
}
.zcs-detail-view-td a{
	height: 100%;
    display: block;
    width: 100%;
	}	
	.zcs-table-wrapper table tbody tr td:first-child{
min-width:250px;
}
</style>

<div class='zcs-page-container zcs-main-container <%=paddingClass%>'>
<%
	if(input.page_action == "controlEffectiveness")
	{
		pageParam = "";
		assessmentDet = Risk_Assessment[ID == input.assessment_id];
		riskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
		controlList = Risk_Entry[ID == riskList].distinct(Link_Controls);
		if(riskList.size() > 0)
		{
			recordCount_per_page = 20;
			total_risk_count = riskList.size();
			no_of_pages = ceil(total_risk_count / recordCount_per_page);
			input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
			diff = total_risk_count - input.start_index;
			end_index = if(input.start_index + recordCount_per_page - 1 > total_risk_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
			previousAction = if(input.start_index == 1,"disable","");
			nextAction = if(end_index == total_risk_count,"disable","");
			pageLink = '#Page:Risk_Assessment_Report_Page?zc_Header=false&page_action=controlEffectiveness' + pageParam;
			previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
			nextLink = if(end_index < total_risk_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
			     <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.assessment.riskDetails")%> </th>
				 
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.assessment.controlID")%> </th>
				
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.control.designEffectiveness")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.control.operatingEffectiveness")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.evidence")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.overallEffectiveness")%> </th>
				
            </tr>
            
        </thead>
        <tbody>
<%
			for each  risk in Risk_Entry[ID == riskList] sort by Added_Time desc range from input.start_index to end_index
			{
				effectivenessVal = 0;
				totalValue = 0;
				totalDesignVal = 0;
				totalOperationVal = 0;
				riskDet = Risk_Entry[ID == risk];
				linkedControl = riskDet.Link_Controls;
				if(linkedControl.size() > 0)
				{
					for each  control in linkedControl
					{
						controlData = Control[ID == control];
						if(controlData.Design_Effectiveness == "Highly Effective")
						{
							designValue = 5;
						}
						else if(controlData.Design_Effectiveness == "Effective")
						{
							designValue = 4;
						}
						else if(controlData.Design_Effectiveness == "Moderately Effective")
						{
							designValue = 3;
						}
						else if(controlData.Design_Effectiveness == "Weak")
						{
							designValue = 2;
						}
						else if(controlData.Design_Effectiveness == "Ineffective")
						{
							designValue = 1;
						}
						if(controlData.Operating_Effectiveness == "Highly Effective")
						{
							operationValue = 5;
						}
						else if(controlData.Operating_Effectiveness == "Effective")
						{
							operationValue = 4;
						}
						else if(controlData.Operating_Effectiveness == "Moderately Effective")
						{
							operationValue = 3;
						}
						else if(controlData.Operating_Effectiveness == "Weak")
						{
							operationValue = 2;
						}
						else if(controlData.Operating_Effectiveness == "Ineffective")
						{
							operationValue = 1;
						}
						totalDesignVal = totalDesignVal + designValue;
						totalOperationVal = totalOperationVal + operationValue;
						totalValue = totalValue + ((operationValue + designValue) / 2).toNumber();
					}
					deisgnValAvg = (totalDesignVal / linkedControl.size()).toNumber();
					operationValAvg = (totalOperationVal / linkedControl.size()).toNumber();
					effectivenessVal = (totalValue / linkedControl.size()).toNumber();
				}
				if(effectivenessVal == 5)
				{
					statusBadgeClass = "zcs-badge-green";
					statusValue = "Highly Effective";
				}
				else if(effectivenessVal == 4)
				{
					statusBadgeClass = "zcs-badge-blue";
					statusValue = "Effective";
				}
				else if(effectivenessVal == 3)
				{
					statusBadgeClass = "zcs-badge-yellow";
					statusValue = "Moderately Effective";
				}
				else if(effectivenessVal == 2)
				{
					statusBadgeClass = "zcs-badge-orange";
					statusValue = "Weak";
				}
				else if(effectivenessVal == 1)
				{
					statusBadgeClass = "zcs-badge-red";
					statusValue = "Ineffective";
				}
				else if(effectivenessVal == 0)
				{
					statusValue = "-";
				}
				%>
<tr>
				
				
 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
  <div>
					   <div style='display:flex;'>
					       <span style='font-size:13px;color:#4A5565'><%=riskDet.Risk_ID%></span>
						   
						</div>
					<div style='color:#04204B;font-size:17px;margin-bottom:10px;'><%=riskDet.Risk_Title%></div>
					<div style='display:flex;'>
<%
				for each  category in riskDet.Risk_Category1
				{
					%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-right:7px;'><%=category.Category_Name%></div>
<%
				}
				%>
</div></div>
 </td>
 
                 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<div>
<%
				controlCount = 0;
				for each  control in riskDet.Link_Controls
				{
					controlCount = controlCount + 1;
					sizeStr = "";
					if(controlCount == 2)
					{
						controlSize = riskDet.Link_Controls.size();
						controlSize = controlSize - 2;
						if(controlSize > 0)
						{
							sizeStr = "<span style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;margin-left:6px;'> +" + controlSize + "</span></div>";
						}
					}
					if(controlCount == 2 && controlSize > 0)
					{
						%>
<div style='display:flex;'>
<%
					}
					%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;'><%=control.Control_ID_Code%></div> <%=sizeStr%>
<%
					if(controlCount == 2)
					{
						break;
					}
				}
				%>
</td>
 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                  <div class='zcs-rating-icon-wrapper zcs-flex zcs-align-items-center zcs-gap-8'>
<%
				designStarList = "".leftPad(4).replaceAll(" ",",").toList();
				starCount = 1;
				for each  star in designStarList
				{
					if(starCount <= deisgnValAvg)
					{
						starColor = "#FDCC0D";
					}
					else
					{
						starColor = "#D9D9D9";
					}
					%>
<i class='zcs-font-16 zcs-text-center fa fa-star' style='color:<%=starColor%>'></i>
<%
					starCount = starCount + 1;
				}
				%>
</div>
				 

				</td>
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
				
				<div class='zcs-rating-icon-wrapper zcs-flex zcs-align-items-center zcs-gap-8'>
<%
				oprStarList = "".leftPad(4).replaceAll(" ",",").toList();
				oprStarCount = 1;
				for each  oprStar in oprStarList
				{
					if(oprStarCount <= operationValAvg)
					{
						oprStarColor = "#FDCC0D";
					}
					else
					{
						oprStarColor = "#D9D9D9";
					}
					%>
<i class='zcs-font-16 zcs-text-center fa fa-star' style='color:<%=oprStarColor%>'></i>
<%
					oprStarCount = oprStarCount + 1;
				}
				%>
</div>


				</td>
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<div class='zcs-flex zcs-direction-column zcs-gap-4'>
<%
				for each  controlID in riskDet.Link_Controls
				{
					controlDet = Control[ID == controlID];
					for each  attachment in controlDet.Upload_Testing_Evidence
					{
						%>
<a href="https://creatorapp.zoho.com/file<%=zoho.appuri%>Controls/<%=controlDet.ID%>/Upload_Testing_Evidence/download?filepath=/<%=attachment%>"><%=attachment%></a>
<%
					}
				}
				%>
</div>
				
				</td>
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>

<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=statusBadgeClass%>' style='border:none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><i class='location-flag-diagonal-33 zc-li-solid' value='location-flag-diagonal-33'></i>  <%=statusValue%> </span></div>
				</td>
				

 </tr>
<%
			}
			%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_risk_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
	}
	else if(input.page_action == "actionPlans" || input.page_action == "followup")
	{
		assessmentDet = Risk_Assessment[ID == input.assessment_id];
		pageParam = "";
		actionList = if(input.page_action == "actionPlans",Action_Plan[Risk_Assessment == input.assessment_id].ID.getAll(),Action_Plan[Risk_Assessment == input.assessment_id && Status != "Completed"].ID.getAll());
		if(actionList.size() > 0)
		{
			recordCount_per_page = 20;
			total_action_count = actionList.size();
			no_of_pages = ceil(total_action_count / recordCount_per_page);
			input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
			diff = total_action_count - input.start_index;
			end_index = if(input.start_index + recordCount_per_page - 1 > total_action_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
			previousAction = if(input.start_index == 1,"disable","");
			nextAction = if(end_index == total_action_count,"disable","");
			pageLink = '#Page:Risk_Assessment_Report_Page?zc_Header=false&page_action=' + input.page_action + pageParam;
			previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
			nextLink = if(end_index < total_action_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.assessment.actionID")%> </th>
				
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.actionPlan")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.owner")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessmentPlan.dueDate")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.status")%> </th>
				
            </tr>
            
        </thead>
        <tbody>
<%
			for each  action in Action_Plan[ID == actionList] sort by Added_Time desc range from input.start_index to end_index
			{
				%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<%=action.Action_ID%>
				
				</td>
				
				  
			
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                  
				 <%=action.Action_Title%>

				</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
				
				<%=action.Owner.Resource%>

				</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<%=action.Target_Date%>
				
				</td>
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				if(action.Status == "Completed")
				{
					statusBadgeClass = "zcs-badge-green";
				}
				else if(action.Status == "In Progress")
				{
					statusBadgeClass = "zcs-badge-blue";
				}
				else if(action.Status == "Deferred")
				{
					statusBadgeClass = "zcs-badge-grey";
				}
				else if(action.Status == "Open")
				{
					statusBadgeClass = "zcs-badge-orange";
				}
				else if(action.Status == "Overdue")
				{
					statusBadgeClass = "zcs-badge-red";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=statusBadgeClass%>' style='border:none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><i class='location-flag-diagonal-33 zc-li-solid' value='location-flag-diagonal-33'></i>  <%=action.Status%> </span></div>
				</td>
                
			
			
            </tr>
<%
			}
			%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_action_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
	}
	else if(input.page_action == "risk")
	{
		pageParam = "";
		assessmentDet = Risk_Assessment[ID == input.assessment_id];
		assRiskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID].Risks.getAll();
		if(input.Status != null && input.Status != "" && input.Status != "null")
		{
			assRiskList = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID && Approval_Status == input.Status].Risks.getAll();
			pageParam = pageParam + "&Status=" + input.Status;
		}
		if(input.Department != null)
		{
			assRiskList = Risk_Entry[ID == assRiskList && Department == input.Department].ID.getAll();
			pageParam = pageParam + "&Department=" + input.Department;
		}
		if(input.Search != null && input.Search != "" && input.Search != "null")
		{
			assRiskList = Risk_Entry[ID == assRiskList && Risk_Title.contains(input.Search) || Risk_ID.contains(input.Search)].ID.getAll();
			pageParam = pageParam + "&Search=" + input.Search;
		}
		if(assRiskList.size() > 0)
		{
			recordCount_per_page = 20;
			total_risk_count = assRiskList.size();
			no_of_pages = ceil(total_risk_count / recordCount_per_page);
			input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
			diff = total_risk_count - input.start_index;
			end_index = if(input.start_index + recordCount_per_page - 1 > total_risk_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
			previousAction = if(input.start_index == 1,"disable","");
			nextAction = if(end_index == total_risk_count,"disable","");
			pageLink = '#Page:Risk_Assessment_Report_Page?zc_Header=false&page_action=risk' + pageParam;
			previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
			nextLink = if(end_index < total_risk_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
			%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.assessment.riskDetails")%> </th>
				
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.department")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.inherentScore")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.controlEffectiveness")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.residualScore")%> </th>
					
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.riskEntry.riskOwner")%> </th>
					<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.approvalStatus")%> </th>
				
            </tr>
            
        </thead>
        <tbody>
<%
			for each  risk in Risk_Entry[ID == assRiskList] sort by Added_Time desc range from input.start_index to end_index
			{
				effectivenessVal = 0;
				totalValue = 0;
				riskDet = Risk_Entry[ID == risk];
				linkedControl = riskDet.Link_Controls;
				if(linkedControl.size() > 0)
				{
					for each  control in linkedControl
					{
						if(control.Design_Effectiveness == "Highly Effective")
						{
							designValue = 5;
						}
						else if(control.Design_Effectiveness == "Effective")
						{
							designValue = 4;
						}
						else if(control.Design_Effectiveness == "Moderately Effective")
						{
							designValue = 3;
						}
						else if(control.Design_Effectiveness == "Weak")
						{
							designValue = 2;
						}
						else if(control.Design_Effectiveness == "Ineffective")
						{
							designValue = 1;
						}
						if(control.Operating_Effectiveness == "Highly Effective")
						{
							operationValue = 5;
						}
						else if(control.Operating_Effectiveness == "Effective")
						{
							operationValue = 4;
						}
						else if(control.Operating_Effectiveness == "Moderately Effective")
						{
							operationValue = 3;
						}
						else if(control.Operating_Effectiveness == "Weak")
						{
							operationValue = 2;
						}
						else if(control.Operating_Effectiveness == "Ineffective")
						{
							operationValue = 1;
						}
						totalValue = ((operationValue + designValue) / 2).toNumber();
					}
					effectivenessVal = (totalValue / linkedControl.size()).toNumber();
				}
				if(effectivenessVal == 5)
				{
					statusBadgeClass = "zcs-badge-green";
					statusValue = "Highly Effective";
				}
				else if(effectivenessVal == 4)
				{
					statusBadgeClass = "zcs-badge-blue";
					statusValue = "Effective";
				}
				else if(effectivenessVal == 3)
				{
					statusBadgeClass = "zcs-badge-yellow";
					statusValue = "Moderately Effective";
				}
				else if(effectivenessVal == 2)
				{
					statusBadgeClass = "zcs-badge-orange";
					statusValue = "Weak";
				}
				else if(effectivenessVal == 1)
				{
					statusBadgeClass = "zcs-badge-red";
					statusValue = "Ineffective";
				}
				else if(effectivenessVal == 0)
				{
					statusValue = "-";
				}
				%>
<tr>
 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
  <div>
					   <div style='display:flex;'>
					       <span style='font-size:13px;color:#4A5565'><%=riskDet.Risk_ID%></span>
						   
						</div>
					<div style='color:#04204B;font-size:17px;margin-bottom:10px;'><%=riskDet.Risk_Title%></div>
					<div style='display:flex;'>
<%
				for each  category in riskDet.Risk_Category1
				{
					%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-right:7px;'><%=category.Category_Name%></div>
<%
				}
				%>
</div></div>
 </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<div>
<%
				departmentCount = 0;
				for each  department in riskDet.Department
				{
					departmentCount = departmentCount + 1;
					sizeStr = "";
					if(departmentCount == 2)
					{
						departmentSize = riskDet.Department.size();
						departmentSize = departmentSize - 2;
						if(departmentSize > 0)
						{
							sizeStr = "<span style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;margin-left:6px;'> +" + departmentSize + "</span></div>";
						}
					}
					if(departmentCount == 2 && departmentSize > 0)
					{
						%>
<div style='display:flex;'>
<%
					}
					%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;'><%=department.Department_Name%></div> <%=sizeStr%>
<%
					if(departmentCount == 2)
					{
						break;
					}
				}
				%>
</td>
				
				  
			
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                      <div class='zcs-px-9 zcs-py-5' style='border-radius:56px;background:#FFE2E3;width: fit-content;'><%=riskDet.Inherent_Score%></div>

				</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				if(effectivenessVal > 0)
				{
					%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=statusBadgeClass%>' style='border:none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><i class='location-flag-diagonal-33 zc-li-solid' value='location-flag-diagonal-33'></i>  <%=statusValue%> </span></div>
<%
				}
				else
				{
					%>
<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>  <%=statusValue%> </span></div>
<%
				}
				%>
</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				if(riskDet.Residual_Risk_Score != null)
				{
					%>
<div class='zcs-px-9 zcs-py-5' style='border-radius:56px;background:#FFE2E3;width: fit-content;'><%=riskDet.Residual_Risk_Score%></div>
<%
				}
				else
				{
					%>
-
<%
				}
				%>
</td>
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                     <%=riskDet.Risk_Owner.User_Display%>
				</td>
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				getApprovalStatus = Risk_Assessment_Libraries[Risk_Assessment == assessmentDet.ID && Risks == riskDet.ID].Approval_Status;
				if(getApprovalStatus == "Approved")
				{
					badgeClass = "zcs-badge-green";
				}
				else if(getApprovalStatus == "Rejected")
				{
					badgeClass = "zcs-badge-red";
				}
				else if(getApprovalStatus == "Pending")
				{
					badgeClass = "zcs-badge-orange";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=getApprovalStatus%> </span>
				</div>
				</td>
                
			
			
            </tr>
<%
			}
			%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_risk_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
	}
	else
	{
		pageParam = "";
		assessmentIDList = Risk_Assessment[ID != 0].ID.getAll();
		if(input.Status != null && input.Status != "" && input.Status != "null")
		{
			assessmentIDList = Risk_Assessment[ID == assessmentIDList && Status == input.Status].ID.getAll();
			pageParam = pageParam + "&Status=" + input.Status;
		}
		if(input.Risk_Template != null && input.Risk_Template != "" && input.Risk_Template != "null")
		{
			assessmentIDList = Risk_Assessment[ID == assessmentIDList && Assessment_Template == input.Risk_Template].ID.getAll();
			pageParam = pageParam + "&Risk_Template=" + input.Risk_Template;
		}
		if(input.Period != null && input.Period != "" && input.Period != "null")
		{
			assessmentIDList = Risk_Assessment[ID == assessmentIDList && Assessment_Period == input.Period].ID.getAll();
			pageParam = pageParam + "&Period=" + input.Period;
		}
		if(input.Search != null && input.Search != "" && input.Search != "null")
		{
			assessmentIDList = Risk_Assessment[ID == assessmentIDList && Assessment_Title.contains(input.Search)].ID.getAll();
			pageParam = pageParam + "&Search=" + input.Search;
		}
		if(assessmentIDList.size() > 0)
		{
			recordCount_per_page = 20;
			total_assessment_count = assessmentIDList.size();
			no_of_pages = ceil(total_assessment_count / recordCount_per_page);
			input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
			diff = total_assessment_count - input.start_index;
			end_index = if(input.start_index + recordCount_per_page - 1 > total_assessment_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
			previousAction = if(input.start_index == 1,"disable","");
			nextAction = if(end_index == total_assessment_count,"disable","");
			pageLink = '#Page:Risk_Assessment_Report_Page?zc_Header=false' + pageParam;
			previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
			nextLink = if(end_index < total_assessment_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
			%>
<!-- <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.riskDetails")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.period")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.assessment.targetDate")%> </th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.riskTemplate")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.scoringTemplate")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.status")%> </th>
				
            </tr>
            
