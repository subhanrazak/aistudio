<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;'><%=language.get("grc.assessment.objectives")%> - <%=(assessment.Objectives.Objectives.getall()).size()%></div>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;'><%=language.get("grc.assessment.departments")%> - <%=(assessment.Departments.Departments.getall()).size()%> </div>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;'><%=language.get("grc.assessment.processes")%> - <%=(assessment.Processes.Processes.getall()).size()%> </div>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;'><%=language.get("grc.assessment.risks")%> - <%=(assessment.Risks.Risks.getall()).size()%></div>

</div></div>
				
				</td>
				<td><%=assessment.Assessment_Period%></td>
				<td><%=assessment.Target_Completion_Date%></td>
				<td><%=assessment.Assessment_Template%></td>
				<td><%=assessment.Risk_Scoring_Method%></td>
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				if(assessment.Status == "In Progress")
				{
					badgeClass = "zcs-badge-blue";
				}
				else if(assessment.Status == "Not Started")
				{
					badgeClass = "zcs-badge-orange";
				}
				else if(assessment.Status == "On Hold")
				{
					badgeClass = "zcs-badge-red";
				}
				else if(assessment.Status == "Completed")
				{
					badgeClass = "zcs-badge-green";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> \u2022  <%=assessment.Status%> </span></div>
				 </td>
				<td class='zcs-detail-view-td'>
