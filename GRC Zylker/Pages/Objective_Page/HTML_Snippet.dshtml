<%
	page_link_name = "Objective_Page";
	language = thisapp.Content.translation();
	tab_map = thisapp.Page.Get_Tabs(page_link_name);
	tab_keys = tab_map.keys();
	input.tab = if(input.tab != "" && input.tab != "null" && input.tab != null,input.tab,tab_keys.get(0));
	checkAccess = thisapp.permission.app_access("risk_Management_Library");
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>

<%=thisapp.Styles_Page.Common_View()%>
</style>
<%
	if(checkAccess == true)
	{
		if(input.page_action == "add")
		{
			if(input.recid != null)
			{
				%>
<%=thisapp.Components.Add_Record("Objectives","#Page:" + page_link_name + "?page_action=detailView&tab=" + input.tab + "&recid=" + input.recid,"Objective","zc_Header=false&zc_SubmitVal=Create&recLinkID=" + input.recid + "&viewLinkName=Objectives&tab=" + input.tab)%>;
<%
			}
			else
			{
				%>
<%=thisapp.Components.Add_Record("Objectives","#Page:" + page_link_name + "?tab=" + input.tab,"Objective","zc_Header=false&zc_SubmitVal=Create&tab=" + input.tab)%>;
<%
			}
		}
		else if(input.page_action == "detailView")
		{
			objectiveDet = Objective[ID == input.recid];
			if(objectiveDet.Status == "Active")
			{
				badgeClass = "zcs-badge-blue";
			}
			else if(objectiveDet.Status == "Planning")
			{
				badgeClass = "zcs-badge-orange";
			}
			else if(objectiveDet.Status == "On Hold")
			{
				badgeClass = "zcs-badge-red";
			}
			else if(objectiveDet.Status == "Completed")
			{
				badgeClass = "zcs-badge-green";
			}
			%>
<style>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Divider()%>
<%=thisapp.Styles.Label_Value()%>
<%=thisapp.Styles.Avatar()%>
		.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
.zcs-bg-grey {
	background-color: #F9FAFC;
}
.zcs-bg-blue {
	background-color: #F9FAFC;
}
.zcs-green-box {
    border: 1px solid #D0FAE5;
    color: #008000;
}
.zcs-blue-box {
    border: 1px solid #DBEAFE;
	background-color: #EFF6FF;
    color: #1C398E;
}
.zcs-grey-box {
    border: 1px solid #E2E8F0;
	background-color: #F8FAFC;
    color: #155DFC;
}
.zcs-red-box {
    border: 1px solid #FFE4E6;
    color: #EC003F;
}
@media (max-width: 768px) {
	.zcs-page-container .zcs-button {
		min-width: 36px;
	}
	.zcs-page-container .zcs-button .zcs-button-text {
		 display: none;
	}
	.zcs-page-fleet_driver .zcs-left-content,
	.zcs-page-fleet_driver .zcs-right-content {
		height: auto;
		overflow: initial;
	}
}
.zcs-reference-link a{
	color:#155DFC !important;
}

		</style>
		<div class='zcs-page-container zcs-page-fleet_driver zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
        <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
			<div class='zcs-flex zcs-gap-16 zcs-ellipsis'>
				<a class='zcs-back' href='#Page:<%=page_link_name%>?tab=<%=input.tab%>'>
					<i class='zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left'></i>
				</a>
				<div class='zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis'>
					<div class='zcs-row zcs-align-items-center zcs-gap-8'>
						<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=objectiveDet.Objective_Title%> </h5>
						<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>'>
							<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> \u2022  <%=objectiveDet.Status%> </span>
						</div>
					</div>
					<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0 ' style='white-space: normal;'>
						#<%=objectiveDet.Objective_ID%> \u2022 <%=objectiveDet.Description%>
					</p>
				</div>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
<%
			if(thisapp.permission.app_access("risk_Management_Library_Button") == true)
			{
				%>
<a href='#Page:<%=page_link_name%>?page_action=add&recid=<%=objectiveDet.ID%>&tab=<%=input.tab%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
					<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
					<span class='zcs-button-text'> <%=language.get("grc.edit.text")%> </span>
				</a>
<%
			}
			%>
</div>
		</div>
        <div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border'>
			<div class='zcs-row zcs-gap-20 zcs-wh-full'>
				<div class='zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-8 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.progressOverview")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
						<div class='zcs-flex zcs-direction-column zcs-gap-20'>
							<div class='zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6'>
								<p class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-font-14 zcs-font-medium zcs-lh-body zcs-m-0'>
									<span class='zcs-color-primary'>
										<%=language.get("grc.objective.overallProgress")%>
									</span>
									<span class='zcs-font-30 zcs-color-primary'>
										<%=if(objectiveDet.Progress != null,objectiveDet.Progress.toNumber() + "%","")%>
									</span>
								</p>
								<div class='zcs-progress-bar zcs-rounded-sm'>
									<div style='width:<%=if(objectiveDet.Progress != null,objectiveDet.Progress,0)%>%;' class='zcs-progress-bar-indicator'></div>
								</div>
							</div>
							<div class='zcs-row zcs-gap-20'>
								<div class='zcs-col-4 zcs-col-sm-12 zcs-bg-grey zcs-rounded-md zcs-p-16 zcs-box-border'>
									<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4'>
										<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'> <%=language.get("grc.objective.startDate")%> </p>
										<h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=if(objectiveDet.Start_Date != null,objectiveDet.Start_Date,"-")%> </h6>
									</div>
								</div>
								<div class='zcs-col-4 zcs-col-sm-12 zcs-bg-grey zcs-rounded-md zcs-p-16 zcs-box-border'>
									<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4'>
										<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'> <%=language.get("grc.objective.target")%> </p>
										<h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=if(objectiveDet.End_Date != null,objectiveDet.End_Date,"-")%>  </h6>
									</div>
								</div>
								<div class='zcs-col-4 zcs-col-sm-12 zcs-bg-grey zcs-rounded-md zcs-p-16 zcs-box-border'>
									<div class='zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4'>
										<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0'> <%=language.get("grc.objective.timeHorizon")%> </p>
										<h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=if(objectiveDet.Start_Date != null && objectiveDet.End_Date != null,objectiveDet.Start_Date.daysBetween(objectiveDet.End_Date) + " " + language.get('grc.objective.days'),"-")%> </h6>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.performanceRiskAlignment")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
						<div class='zcs-flex zcs-direction-column zcs-gap-20'>
							<div class='zcs-flex zcs-direction-column zcs-gap-16'>
								<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.linkedKPIs")%> (<%=objectiveDet.Linked_KPIs.size()%>) </h6>
								<div class='zcs-flex zcs-direction-column zcs-gap-12'>
<%
			for each  kpi in objectiveDet.Linked_KPIs
			{
				kpiDet = KPI[ID == kpi];
				if(kpi.Review_Status == "Overdue")
				{
					badgeClass = "zcs-badge-red";
				}
				else if(kpi.Review_Status == "Completed")
				{
					badgeClass = "zcs-badge-green";
				}
				else if(kpi.Review_Status == "In Progress")
				{
					badgeClass = "zcs-badge-blue";
				}
				else if(kpi.Review_Status == "Pending Review")
				{
					badgeClass = "zcs-badge-grey";
				}
				else if(kpi.Review_Status == "Current")
				{
					badgeClass = "zcs-badge-orange";
				}
				%>
<div class='zcs-green-box zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-rounded-xl zcs-px-16 zcs-py-10 zcs-box-border'>
										<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
											<i class='zcs-no-shrink zc-li-outline ui-1-check-circle-08'></i>
											<span class='zcs-font-14 zcs-font-normal zcs-lh-body'><%=kpiDet.KPI_Name%> </span>
										</div>
										<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border <%=badgeClass%>' style='border:none !important;'>
											
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=kpiDet.Review_Status%> </span>
										</div>
									</div>
<%
			}
			%>
</div>
							</div>
							<div class='zcs-divider zcs-divider-horizontal'></div>
							<div class='zcs-flex zcs-direction-column zcs-gap-16'>
								<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.linkedRisks")%>(<%=objectiveDet.Linked_Risks.size()%>) </h6>
								<div class='zcs-flex zcs-direction-column zcs-gap-12'>
<%
			for each  risk in objectiveDet.Linked_Risks
			{
				riskDet = Risk_Entry[ID == risk];
				colorCode = riskDet.Risk_Level.Color_Code;
				backgroundColor = colorCode + "26";
				%>
<a class='zcs-red-box zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-rounded-xl zcs-px-16 zcs-py-10 zcs-box-border' href='#Page:Risk_Entries_Page?page_action=detailView&recid=<%=riskDet.ID%>' target='_blank'>
										<div class='zcs-flex zcs-align-items-center zcs-gap-8'>
											<i class='zcs-no-shrink zc-li-outline ui-3-alert'></i>
											<span class='zcs-font-14 zcs-font-normal zcs-lh-body'> <%=riskDet.Risk_Title%> </span>
										</div>
										<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-4 zcs-box-border ' style='border:none !important;color:<%=colorCode%>;background:<%=backgroundColor%>' >
											<i class='zcs-badge-icon zcs-no-shrink zc-li-solid location-flag-points-32'></i>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=riskDet.Risk_Level.Label%> </span>
										</div>
									</a>
<%
			}
			%>
</div>
							</div>
							<div class='zcs-flex zcs-direction-column zcs-gap-16'>
								<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.linkedControls")%> (<%=objectiveDet.Linked_Controls.size()%>) </h6>
								<div class='zcs-row zcs-gap-12'>
<%
			for each  control in objectiveDet.Linked_Controls
			{
				controlDet = Control[ID == control];
				%>
<a class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-md zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-blue' href='#Page:Controls_Page?page_action=detailView&recid=<%=controlDet.ID%>' target='_blank'>
										<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <%=controlDet.Control_Name_Title%> </span>
									</a>
<%
			}
			%>
</div>
							</div>
							<div class='zcs-divider zcs-divider-horizontal'></div>
							<div class='zcs-flex zcs-direction-column zcs-gap-16'>
								<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.linkedProcesses")%> (<%=objectiveDet.Linked_Processes.size()%>) </h6>
								<div class='zcs-row zcs-gap-12'>
<%
			for each  process in objectiveDet.Linked_Processes
			{
				processDet = Process[ID == process];
				%>
<a class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-md zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-violet' href='#Page:Process_Page?page_action=detailView&recid=<%=processDet.ID%>' target='_blank'>
										<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <%=processDet.Process_Name%> </span>
									</a>
<%
			}
			%>
</div>
							</div>
							
						</div>
					</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.commentsNotes")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
<%
			if(objectiveDet.Comments_Notes != "" && objectiveDet.Comments_Notes != null)
			{
				%>
<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-m-0'>
							<%=objectiveDet.Comments_Notes%>
						</p>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.activityHistory")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
<%
			getLogs = Audit_Log[Form_Link_Name == "Objective" && Record_ID == objectiveDet.ID] sort by Added_Time desc;
			if(getLogs.count() > 0)
			{
				%>
<ul class='zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0' style='height:300px;overflow:auto;'>
<%
				for each  log in getLogs
				{
					%>
<li class='zcs-flex zcs-gap-16 zcs-bg-blue zcs-rounded-md zcs-p-16'>
								<div style='--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%' class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'>
<%
					if(log.Performed_By.Photo != null && log.Performed_By.Photo != "")
					{
						ownerImage = zoho.appuri + "report/User_Report/" + log.Performed_By + "/Photo/download-file?filepath=/" + log.Performed_By.Photo.getSuffix("image/").getPrefix("\\"") + "&mediaType=1";
						%>
<img class='zcs-avatar-img zcs-wh-full' src=<%=ownerImage%> alt="John Smith profile photo"
											height="100%" width="100%">
<%
					}
					else
					{
						%>
<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(log.Performed_By.Name)%></span>
<%
					}
					%>
</div>
								<div class='zcs-flex zcs-direction-column zcs-gap-4'>
									<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=thisapp.Log.Log_Translation(log.Form_Link_Name,objectiveDet.ID,log.Action_Type,log.Performed_By,log.Title)%> </h6>
									<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=log.Performed_Time%> </p>
								</div>
							</li>
<%
				}
				%>
</ul>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
				</div>
				<div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.details")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
						<div class='zcs-labelvalue-wrapper'>
							<ul class='zcs-row zcs-gap-20 zcs-p-0 zcs-m-0'>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.type")%> </label>
									<div class='zcs-flex'>
										<span style='border-radius: 6px;' class='zcs-card zcs-rounded-sm zcs-px-12 zcs-py-4 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=objectiveDet.Objective_Type%> </span>
									</div>
									
								</li>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.objective.department")%>  </label>
									<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=Department[ID == objectiveDet.Linked_Departments].Department_Name.getAll()%> </span>
								</li>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.owner")%> </label>
									<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=objectiveDet.Owner.Name%> </span>
								</li>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.timeHorizon")%> </label>
									<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=if(objectiveDet.Start_Date != null && objectiveDet.End_Date != null,objectiveDet.Start_Date.daysBetween(objectiveDet.End_Date) + " " + language.get('grc.objective.days'),"-")%> </span>
								</li>
								<div class='zcs-w-full zcs-divider zcs-divider-horizontal'></div>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.lastUpdated")%> </label>
									<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=objectiveDet.Modified_Time.getDate()%> </span>
								</li>
							</ul>
						</div>
					</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.linkedStrategies")%> </h6>

						<div class='zcs-divider zcs-divider-horizontal'></div>
<%
			if(objectiveDet.Link_Strategies.size() > 0)
			{
				%>
<div class='zcs-flex zcs-flex zcs-direction-column zcs-gap-12 zcs-overflow-auto ' style='height:250px;'>
<%
				for each  strategy in objectiveDet.Link_Strategies
				{
					strategyDet = Strategy[ID == strategy];
					%>
<a class='zcs-blue-box zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-rounded-xl zcs-p-16 zcs-box-border' href='#Page:Strategy_Page?page_action=detailView&recid=<%=strategyDet.ID%>' target='_blank'>
							<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0'> <%=strategyDet.Strategy_Title%> </p>
						</a>
<%
				}
				%>
</div>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.reviewSchedule")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
						<div class='zcs-labelvalue-wrapper'>
							<ul class='zcs-row zcs-gap-20 zcs-p-0 zcs-m-0'>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.lastReview")%> </label>
									<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=if(objectiveDet.Last_Review_Date != null,objectiveDet.Last_Review_Date,"-")%> </span>
								</li>
								<li class='zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12'>
									<label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.objective.nextReview")%> </label>
									<div class='zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8'>
										<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=if(objectiveDet.Next_Review_Date != null,objectiveDet.Next_Review_Date,"-")%> </span>
<%
			if(objectiveDet.Next_Review_Date > zoho.currentdate)
			{
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-sm zcs-px-10 zcs-py-2 zcs-box-border zcs-badge-yellow'>
											<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <%=language.get("grc.objective.upcoming")%> </span>
										</div>
<%
			}
			%>
</div>
								</li>
							</ul>
						</div>
					</div>
					<div class='zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border'>
						<h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'> <%=language.get("grc.objective.externalReferences")%> </h6>
						<div class='zcs-divider zcs-divider-horizontal'></div>
<%
			if(Objective_External_References[Objective == objectiveDet.ID].count() > 0)
			{
				%>
<div class='zcs-flex zcs-direction-column zcs-gap-20 zcs-overflow-auto' style='height:250px;'>
<%
				for each  link in Objective_External_References[Objective == objectiveDet.ID]
				{
					%>
<div class='zcs-grey-box zcs-flex zcs-rounded-xl zcs-p-16 zcs-box-border'>
								<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-m-0 zcs-reference-link' > <%=link.Link%> </p>
							</div>
<%
				}
				%>
</div>
<%
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
				</div>
			</div>
		</div>
    </div>
</div>
<%
		}
		else
		{
			totalCount = Objective[ID != 0].count();
			%>
<style>
<%=thisapp.Styles.Progress_Bar()%>
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	padding:0px !important;
}
.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
</style>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.objective.objectiveLibrary")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.objective.subHeader")%></p>
			</div>
<%
			if(thisapp.permission.app_access("risk_Management_Library_Button") == true)
			{
				%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add&tab=<%=input.tab%>'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.objective.createObjective")%> </span>
            </a>
<%
			}
			%>
</div>
        <div class='zcs-panel-wrapper'>
            <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
					<div class='zcs-panel zcs-panel-red zcs-wh-full  zcs-rounded-lg zcs-p-16 zcs-box-border '>
					<div class='zcs-flex  zcs-gap-8 zcs-justify-space-between zcs-mb-20'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=language.get("grc.objective.strategicObjectives")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Objective[Objective_Type == "Strategic"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline tech-disk-reader'></i>
                            </div>
                        </div>    
                       <div class="zcs-progress-bar zcs-rounded-sm">
									<div class="zcs-progress-bar-indicator" style='width: <%=if(totalCount > 0,Objective[Objective_Type == "Strategic"].count() / totalCount * 100,0)%>%'></div>
					</div>
                    </div>
					<a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                  
					<div class='zcs-panel zcs-panel-red zcs-wh-full  zcs-rounded-lg zcs-p-16 zcs-box-border '>
					<div class='zcs-flex  zcs-gap-8 zcs-justify-space-between zcs-mb-20'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.objective.operationalObjectives")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Objective[Objective_Type == "Operational"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-25'></i>
                            </div>
                        </div>    
                       <div class="zcs-progress-bar zcs-rounded-sm">
					   <div class="zcs-progress-bar-indicator" style='width: <%=if(totalCount > 0,Objective[Objective_Type == "Operational"].count() / totalCount * 100,0)%>%'></div>
					</div>
                    </div>
					<a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
					<div class='zcs-panel zcs-panel-red zcs-wh-full  zcs-rounded-lg zcs-p-16 zcs-box-border '>
					<div class='zcs-flex  zcs-gap-8 zcs-justify-space-between zcs-mb-20'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.objective.financialObjectives")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Objective[Objective_Type == "Financial"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline location-position-pin'></i>
                            </div>
                        </div>    
                       <div class="zcs-progress-bar zcs-rounded-sm">
									<div class="zcs-progress-bar-indicator" style='width: <%=if(totalCount > 0,Objective[Objective_Type == "Financial"].count() / totalCount * 100,0)%>%'></div>
					</div>
                    </div>
					<a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
               <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
					
					<div class='zcs-panel zcs-panel-red zcs-wh-full  zcs-rounded-lg zcs-p-16 zcs-box-border '>
					<div class='zcs-flex  zcs-gap-8 zcs-justify-space-between zcs-mb-20'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.objective.complainceObjectives")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Objective[Objective_Type == "Compliance"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline users-parent'></i>
                            </div>
                        </div>    
                       <div class="zcs-progress-bar zcs-rounded-sm">
									<div class="zcs-progress-bar-indicator" style='width: <%=if(totalCount > 0,Objective[Objective_Type == "Compliance"].count() / totalCount * 100,0)%>%'></div>
					</div>
                    </div>
					<a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
            </ul>
        </div>
		<div class='zcs-page-content zcs-card zcs-col-common zcs-overflow-auto'>
            <div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full'>
                <ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
<%
			for each  tab_id in tab_keys
			{
				class_name = if(input.tab == tab_id,"zcs-horizontal-tabitem zcs-horizontal-tabactive'","zcs-horizontal-tabitem");
				%>
<li class='<%=class_name%>'> <a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-secondary' href='#Page:<%=page_link_name%>?tab=<%=tab_id%>'><span class="zcs-horizontal-tab-text"> <%=tab_map.get(tab_id).get("Display")%></span> </a> </li>
<%
			}
			%>
</ul>
                <div class='zcs-horizontal-tabbody zcs-col-common zcs-flex zcs-direction-column'>
                     <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=overView&Page=<%=page_link_name%>&Report=Objectives<%=tab_map.get(input.tab).get("Param")%>'></div>
					<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Objective_Report_Page' params='zc_Header=false&tab=<%=input.tab%><%=tab_map.get(input.tab).get("Param")%>' ></div>
                </div>
            </div>
