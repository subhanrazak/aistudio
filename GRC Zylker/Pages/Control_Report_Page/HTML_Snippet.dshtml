<%
	language = thisapp.Content.translation();
	pageParam = "";
	controlIDList = Control[ID != 0].ID.getAll();
	if(input.Department != null)
	{
		controlIDList = Control[ID == controlIDList && Department == input.Department].ID.getAll();
		pageParam = pageParam + "&Department=" + input.Department;
	}
	if(input.Status != null && input.Status != "" && input.Status != "null")
	{
		controlIDList = Control[ID == controlIDList && Control_Status == input.Status].ID.getAll();
		pageParam = pageParam + "&Status=" + input.Status;
	}
	if(input.Type_field != null && input.Type_field != "" && input.Type_field != "null")
	{
		controlIDList = Control[ID == controlIDList && Control_Type == input.Type_field].ID.getAll();
		pageParam = pageParam + "&Type_field=" + input.Type_field;
	}
	if(input.Search != null && input.Search != "" && input.Search != "null")
	{
		controlIDList = Control[ID == controlIDList && Control_Name_Title.contains(input.Search) || Control_ID_Code.contains(input.Search)].ID.getAll();
		pageParam = pageParam + "&Search=" + input.Search;
	}
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Table()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Pagination()%>

.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	box-sizing: border-box;
}

.zcs-page-table-view {
    height: 100%;
	background :var(--zcs-white-color);
}
.zcs-pagination {
    height: 32px;
    padding: 10px;
    box-sizing: content-box;
	background :var(--zcs-white-color);
}
.zcs-table-wrapper {
	height: calc(100% - 52px);
}
/* .zcs-table-wrapper table {
    height: 100%;
    table-layout: auto;
	overflow: auto;
} */

.zcs-table-wrapper table thead {
    z-index: 1;
}

.zcs-table-wrapper table tbody tr {
   position:relative;
}
.zcs-detail-view-td{
	position:absolute;
	border: none !important;
    inset: 0;
    background: transparent !important;
	
}
.zcs-detail-view-td a{
	height: 100%;
    display: block;
    width: 100%;
	
}
.zcs-table-wrapper table tbody tr td:first-child{
min-width:250px;
}
</style>
<div class='zcs-page-container zcs-page-table-view'>
<%
	if(controlIDList.size() > 0)
	{
		recordCount_per_page = 20;
		total_control_count = controlIDList.size();
		no_of_pages = ceil(total_control_count / recordCount_per_page);
		input.start_index = if(input.start_index.isEmpty(),1,input.start_index);
		diff = total_control_count - input.start_index;
		end_index = if(input.start_index + recordCount_per_page - 1 > total_control_count,input.start_index + diff,input.start_index + recordCount_per_page - 1);
		previousAction = if(input.start_index == 1,"disable","");
		nextAction = if(end_index == total_control_count,"disable","");
		pageLink = '#Page:Control_Report_Page?zc_Header=false' + pageParam;
		previousLink = if(input.start_index > 1,"href=" + pageLink + "&start_index=" + (input.start_index - recordCount_per_page) + "&zc_LoadIn=embed-embedDiv","");
		nextLink = if(end_index < total_control_count,"href=" + pageLink + "&start_index=" + (end_index + 1) + "&zc_LoadIn=embed-embedDiv","");
		%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("grc.control.controlDetails")%> </th>
				
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.category")%></th>
				 
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.objective.linkedProcesses")%></th>
				 
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.objective.owner")%> </th>
               
               
				 <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.control.designEffectiveness")%> </th>
				  <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.control.operatingEffectiveness")%> </th>
				<th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=language.get("grc.assessment.status")%> </th>
				
            </tr>
            
        </thead>
        <tbody>
<%
		for each  control in Control[ID == controlIDList] sort by Added_Time desc range from input.start_index to end_index
		{
			%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
					<div>
					<div style='display:flex;'>
					<span style='font-size:13px;color:#4A5565'>#<%=control.Control_ID_Code%></span>
					<div style='display:flex;'><div style='color:#4A5565;font-size:12px;margin-left: 6px;'>
					<span style='color:#9EA0A799'>\u2022 </span><%=control.Control_Type%>
					</div>
					</div>
					</div>
					<div style='color:#04204B;font-size:17px;margin-bottom:10px;'><%=control.Control_Name_Title%></div><div style='display:flex;'>
<%
			for each  department in control.Department
			{
				%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-right:7px;'><%=department.Department_Name%></div>
<%
			}
			%>
</div></div>
				
				</td>
				
				  <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
				<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;width: max-content;'><%=control.Category.Category_Name%></div>
				</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				        <div>
<%
			processCount = 0;
			for each  process in control.Associated_Process_Activity
			{
				processCount = processCount + 1;
				sizeStr = "";
				if(processCount == 2)
				{
					processSize = control.Associated_Process_Activity.size();
					processSize = processSize - 2;
					if(processSize > 0)
					{
						sizeStr = "<span style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;margin-left:6px;'> +" + processSize + "</span></div>";
					}
				}
				if(processCount == 2 && processSize > 0)
				{
					%>
<div style='display:flex;'>
<%
				}
				%>
<div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-bottom:7px;width: max-content !important;'><%=process.Process_Name%></div> <%=sizeStr%>
<%
				if(processCount == 2)
				{
					break;
				}
			}
			%>
</td>
				
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> 
				<%=control.Control_Owner.User_Display%>
				
</td>
                
              
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			if(control.Design_Effectiveness == "Highly Effective")
			{
				badgeClass = "zcs-badge-green";
			}
			else if(control.Design_Effectiveness == "Moderately Effective")
			{
				badgeClass = "zcs-badge-yellow";
			}
			else if(control.Design_Effectiveness == "Effective")
			{
				badgeClass = "zcs-badge-blue";
			}
			else if(control.Design_Effectiveness == "Ineffective")
			{
				badgeClass = "zcs-badge-red";
			}
			else if(control.Design_Effectiveness == "Weak")
			{
				badgeClass = "zcs-badge-orange";
			}
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=control.Design_Effectiveness%> </span>
				</div>
				</td>
				
				<td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			if(control.Operating_Effectiveness == "Highly Effective")
			{
				badgeClass = "zcs-badge-green";
			}
			else if(control.Operating_Effectiveness == "Moderately Effective")
			{
				badgeClass = "zcs-badge-yellow";
			}
			else if(control.Operating_Effectiveness == "Effective")
			{
				badgeClass = "zcs-badge-blue";
			}
			else if(control.Operating_Effectiveness == "Ineffective")
			{
				badgeClass = "zcs-badge-red";
			}
			else if(control.Operating_Effectiveness == "Weak")
			{
				badgeClass = "zcs-badge-orange";
			}
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=control.Operating_Effectiveness%> </span>
				</div>
				</td>
				
				 <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			if(control.Control_Status == "Under Review")
			{
				badgeClass = "zcs-badge-yellow";
			}
			else if(control.Control_Status == "Inactive")
			{
				badgeClass = "zcs-badge-red";
			}
			else if(control.Control_Status == "Active")
			{
				badgeClass = "zcs-badge-green";
			}
			%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border:none !important;'><span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'><%=control.Control_Status%> </span></div>
				</td>
                
			
				<td class='zcs-detail-view-td'>
				<a href='#Page:Controls_Page?page_action=detailView&recid=<%=control.ID%>'></a>
				</td>
            </tr>
<%
		}
		%>
</tbody>
    </table>
</div>
	<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span
                class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'
               >
                <%=input.start_index%>-<%=end_index%> of <%=total_control_count%>
            </span>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(previousAction == "disable","zcs-button-disable","")%>'
                <%=previousLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item '>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(nextAction == "disable","zcs-button-disable","")%>'
                <%=nextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
	}
	else
	{
		%>
<%=thisapp.Page.noData()%>
<%
	}
	%>
</div>