						<div class="zcs-divider zcs-divider-horizontal"></div>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
					<ul class="zcs-row zcs-p-0 zcs-m-0">
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.category")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=riskDet.Risk_Category1.Category_Name%> </p>
						</li>
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.owner")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Risk_Owner.Name%> </p>
						</li>
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.process.riskLevel")%> </label>
							 <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border' style='border:none !important;color:<%=colorCode%>;background:<%=backgroundColor%>;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=riskDet.Risk_Level.Label%> </span>
				 </div> 
						</li>
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.tags")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Risk_Tags.Risk_Tag%> </p>
						</li>
						
					</ul>
				</div>
						
					</div>
					
					<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
						<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.riskEntry.riskAssessment")%> </h6>
						<div class="zcs-divider zcs-divider-horizontal"></div>
						
						<div class="zcs-row zcs-gap-20">
								<div class="zcs-col-6 zcs-col-sm-12 zcs-bg-grey zcs-rounded-md zcs-p-16 zcs-box-border" style='background: #f8fafc;'>
									<div class="zcs-flex zcs-direction-column zcs-gap-4">
										<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0"><%=language.get("grc.assessment.impact")%> </p>
										<h6 class="zcs-font-32 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size: 32px !important;'> <%=riskDet.Impact.Value%>/5  </h6>
										<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=impactBadge%>' style='border:none !important;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=riskDet.Impact.Label%> </span>
                           </div> 
									</div>
								</div>
								<div class="zcs-col-6 zcs-col-sm-12 zcs-bg-grey zcs-rounded-md zcs-p-16 zcs-box-border" style='background: #f8fafc;'>
									<div class="zcs-flex zcs-direction-column zcs-gap-4">
										<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-secondary zcs-m-0"> <%=language.get("grc.assessment.likelihood")%> </p>
										<h6 class="zcs-font-32 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size: 32px !important;'><%=riskDet.Likelihood.Value%>/5  </h6>
										<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=likelihoodBadge%>' style='border:none !important;'>
				 <span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <i value='location-flag-diagonal-33' html='location-flag-diagonal-33' class='location-flag-diagonal-33 zc-li-solid'></i>  <%=riskDet.Likelihood.Label%> </span>
                           </div> 
									</div>
								</div>
								
							</div>
						
						
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
					<ul class="zcs-row zcs-p-0 zcs-m-0">
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.inherentRiskScore")%> </label>
							<p class="zcs-font-32 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0" style='font-size: 32px !important;'><%=riskDet.Inherent_Score%> </p>
						</li>		
					</ul>
				</div>
						
					</div>
				 
				 </div>
				 <div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
				     <div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
						<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.riskEntry.assignmentOwnership")%> </h6>
						<div class="zcs-divider zcs-divider-horizontal"></div>
						<div class="zcs-labelvalue-wrapper">
							<ul class="zcs-row zcs-gap-20 zcs-p-0 zcs-m-0">
								
								<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-12">
									<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"><%=language.get("grc.riskEntry.riskOwner")%>  </label>
									<span class="zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary"> <%=riskDet.Risk_Owner.Name%> </span>
								</li>
								
							</ul>
						</div>
					</div>
				      
					<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border" style='height: calc(100% - 129px);'>
						<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.riskEntry.timelineActivity")%> </h6>
						<div class="zcs-divider zcs-divider-horizontal"></div>
<%
		getLogs = Audit_Log[Form_Link_Name == "Risk_Entry" && Record_ID == riskDet.ID] sort by Added_Time desc;
		if(getLogs.count() > 0)
		{
			%>
<ul class='zcs-flex zcs-direction-column zcs-gap-20 zcs-p-0 zcs-m-0 zcs-overflow-auto'>
<%
			for each  log in getLogs
			{
				%>
<li class='zcs-flex zcs-gap-16 zcs-bg-blue zcs-rounded-md zcs-p-16'>
								<div style='--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%' class='zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center'>
<%
				if(log.Performed_By.Photo != null && log.Performed_By.Photo != "")
				{
					ownerImage = zoho.appuri + "report/User_Report/" + log.Performed_By + "/Photo/download-file?filepath=/" + log.Performed_By.Photo.getSuffix("image/").getPrefix("\\"") + "&mediaType=1";
					%>
<img class='zcs-avatar-img zcs-wh-full' src=<%=ownerImage%> alt="John Smith profile photo"
											height="100%" width="100%">
<%
				}
				else
				{
					%>
<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(log.Performed_By.Name)%></span>
<%
				}
				%>
</div>
								<div class='zcs-flex zcs-direction-column zcs-gap-4'>
									<h6 class='zcs-font-16 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0'> <%=thisapp.Log.Log_Translation(log.Form_Link_Name,riskDet.ID,log.Action_Type,log.Performed_By,log.Title)%> </h6>
									<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=log.Performed_Time%> </p>
								</div>
							</li>
<%
			}
			%>
</ul>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>
				 
				 </div>
				 
			 
			 </div>
		
			
		</div>
    </div>
</div>
<%
	}
	else
	{
		departmentList = Process[ID != 0].distinct(Linked_Departments);
		controlList = Process[ID != 0].distinct(Associate_Controls);
		riskList = Process[ID != 0].distinct(Associate_Risks);
		%>
<style>
		.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	padding:0px !important;
}
</style>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.riskEntry.formHeader")%> </h5>
			</div>
<%
		if(thisapp.permission.app_access("risk_register_add_Button") == true)
		{
			%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.riskEntry.newRisk")%> </span>
            </a>
<%
		}
		%>
</div>
        <div class='zcs-panel-wrapper'>
            <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=language.get("grc.riskEntry.allRisks")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Risk_Entry[ID != 0].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline tech-disk-reader'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>  <%=language.get("grc.riskEntry.critical")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Risk_Entry[Risk_Level.Label == "Critical"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-25'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>  <%=language.get("grc.riskEntry.high")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Risk_Entry[Risk_Level.Label == "High"].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
