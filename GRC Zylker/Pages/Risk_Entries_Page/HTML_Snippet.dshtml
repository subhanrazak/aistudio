						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-4 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.process")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Process.Process_Name.getall()%> </p>
						</li>
						
					</ul>
				</div>
						
					</div>
					
					<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
						<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.riskEntry.basicInformation")%> </h6>
						<div class="zcs-divider zcs-divider-horizontal"></div>
						<div class="zcs-labelvalue-wrapper zcs-labelvalue-with-bg zcs-rounded-xl zcs-px-15 zcs-py-10 zcs-box-border">
					<ul class="zcs-row zcs-p-0 zcs-m-0">
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.title")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"><%=riskDet.Risk_Title%> </p>
						</li>
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.description")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Risk_Description1%> </p>
						</li>
						
						
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.impact")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Risk_Impact%> </p>
						</li>
						
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.additionalNotes")%> </label>
							<p class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=riskDet.Additional_Notes%> </p>
						</li>
						
						<li class="zcs-flex zcs-direction-column zcs-gap-8 zcs-col-6 zcs-col-sm-6 zcs-col-xs-12 zcs-px-15 zcs-py-10 zcs-box-border">
							<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.riskEntry.attachments")%> </label>
							<div class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0 zcs-flex zcs-direction-column zcs-gap-4">
<%
		for each  attachment in riskDet.Attachments
		{
			%>
<a href="https://creatorapp.zoho.com/file<%=zoho.appuri%>Risk_Entries/<%=riskDet.ID%>/Attachments/download?filepath=/<%=attachment%>"><%=attachment%></a>
<%
		}
		%>
</div>
						</li>
						
					</ul>
				</div>
						
					</div>
					
					<div class="zcs-card zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
