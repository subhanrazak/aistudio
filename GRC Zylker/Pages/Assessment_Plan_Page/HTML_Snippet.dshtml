                        <th><%=language.get("grc.assessmentPlan.role")%></th>
                        <th><%=language.get("grc.assessmentPlan.firm")%></th>
                        <th><%=language.get("grc.assessmentPlan.availability")%></th>
						<th><%=language.get("grc.assessmentPlan.occupancy")%></th>
						<th><%=language.get("grc.assessmentPlan.hourlyRate")%></th>
						<th><%=language.get("grc.assessmentPlan.plannedHours")%></th>
                        
                    </tr>
                </thead>
                <tbody>
<%
			for each  external in Resource_Allocation[Assessment_Plan == planDet.ID && Resource_Type == "External Resource"]
			{
				externalResource = Resource[ID == external.Name];
				%>
<tr>
                       <td>
					   <div class="zcs-flex zcs-gap-16  zcs-rounded-md  zcs-align-items-center">
								
								<div class="zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center" style="--zcs-avatar-size: 32px; --zcs-avatar-radius: 50%">
<%
				if(externalResource.Photo != null && externalResource.Photo != "")
				{
					ownerImage = zoho.appuri + "report/Resources/" + externalResource.ID + "/Photo/download-file?filepath=/" + externalResource.Photo.getSuffix("image/").getPrefix("\\"") + "&mediaType=1";
					%>
<img class='zcs-avatar-img zcs-wh-full' src=<%=ownerImage%> alt="John Smith profile photo"
											height="100%" width="100%">
<%
				}
				else
				{
					%>
<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(externalResource.Name)%></span>
<%
				}
				%>
</div>
								<div class="zcs-flex zcs-direction-column zcs-gap-4">
								   
									<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-primary zcs-m-0"> <%=externalResource.Name%></h6>
									
								</div>
							</div>
					   </td>
                        <td><%=externalResource.Job_Title.Designation_Name%></td>
                        <td><div style='border:1px solid #E6E6E6;padding:5px 8px;border-radius:6px;margin-right:7px;width: fit-content;'><%=externalResource.Company_Vendor.Vendor_Name%></div></td>
                        <td><%=external.Availability%></td>
						<td><%=external.Occupancy%></td>
                        <td><%=external.Hourly_Rate%></td>
                        <td><%=external.Planned_Hours%></td>
                        
                        
                    </tr>
<%
			}
			%>
</tbody>
            </table>
        </div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>
				 </div>
				 
				 
			 </div>
			 
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessmentPlan.budgetTimeline")%> </h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class="zcs-panel-wrapper zcs-mb-15">
            <ul class="zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0">
                <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=planDet.Budget_Required%> </h4>
						 <p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessmentPlan.budgetRequired")%>  </p>
                        </div>
                            
                            
                       
                    </div>
                   
                </li>
				 <li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-m-0" style='color:#FB2C36;'> <%=planDet.Budget_Shortfall%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessmentPlan.budgetShortfall")%> </p>
                        </div>
                           
                            
                       
                    </div>
                    
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
                    <div class="zcs-panel zcs-panel-yellow zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between">
					<div class="zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column">
					 
                        <h4 class="zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0"> <%=planDet.Total_Budget_Allocated%> </h4>
						<p class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessmentPlan.totalBudgetAllocated")%> </p>
                        </div>
                            
                            
                       
                    </div>
                    
                </li>
				<li class="zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative ">
				</li>
               
              
            </ul>
        </div>
<%
		if(Budget_Categories[Assessment_Plan == planDet.ID].count() > 0)
		{
			%>
<div class="zcs-table-wrap">
            <table class="zcs-table">
                <thead>
                    <tr>
                       <th><%=language.get("grc.assessmentPlan.category")%></th>
                        <th><%=language.get("grc.assessmentPlan.allocation")%></th>
                        <th><%=language.get("grc.assessmentPlan.percentage")%></th>
                        <th><%=language.get("grc.assessmentPlan.description")%></th>
						
                        
                    </tr>
                </thead>
                <tbody>
<%
			for each  budget in Budget_Categories[Assessment_Plan == planDet.ID]
			{
				percentageWidth = budget.Percentage;
				if(budget.Percentage > 100)
				{
					percentageWidth = 100;
				}
				%>
<tr>
                       
                        <td><%=budget.Category.Category_Name%></td>
                      
                        <td><%=budget.Allocation%></td>
						<td><div style="width:75px;" class="zcs-progress-bar-wrapper zcs-flex zcs-direction-column zcs-gap-6">
				<p style="display: flex;align-items: center;justify-content: center;font-size: 14px;" class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-font-14 zcs-font-medium zcs-lh-body zcs-m-0"><span class="zcs-color-primary"><%=budget.Percentage%>%</span></p>
				<div style="border-radius: 0.25rem;" class="zcs-progress-bar zcs-rounded-sm"><div style="width:<%=percentageWidth%>%;" class="zcs-progress-bar-indicator"></div></div></div></td>
                      
                        <td><%=budget.Description%></td>
                        
                        
                    </tr>
<%
			}
			%>
</tbody>
            </table>
        </div>
<%
		}
		%>
</div>
				 </div>
				 
				 
			 </div>
			 <div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessmentPlan.milestonePlanning")%> </h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
<%
		if(Milestone_Planning[Assessment_Plan == planDet.ID].count() > 0)
		{
			%>
<div class="zcs-table-wrap">
            <table class="zcs-table">
                <thead>
                    <tr>
                       <th><%=language.get("grc.assessmentPlan.milestone")%></th>
                        <th><%=language.get("grc.assessmentPlan.description")%></th>
                        <th><%=language.get("grc.assessment.owner")%></th>
						<th><%=language.get("grc.assessmentPlan.dueDate")%></th>
						<th><%=language.get("grc.assessmentPlan.status")%></th>
						
                        
                    </tr>
                </thead>
                <tbody>
<%
			for each  milestone in Milestone_Planning[Assessment_Plan == planDet.ID]
			{
				%>
<tr>
                     
                        <td><%=milestone.Milestone%></td>
						<td><%=milestone.Description%></td>
                        <td><%=milestone.Owner.User_Display%></td>
                        <td><%=milestone.Due_Date%></td>
						<td>
<%
				if(milestone.Status == "Planned")
				{
					badgeClass = "zcs-badge-orange";
				}
				else if(milestone.Status == "In Progress")
				{
					badgeClass = "zcs-badge-blue";
				}
				else if(milestone.Status == "Pending")
				{
					badgeClass = "zcs-badge-grey";
				}
				else if(milestone.Status == "Completed")
				{
					badgeClass = "zcs-badge-green";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=milestone.Status%> </span>
				</div>
						</td>
                        
                        
                    </tr>
<%
			}
			%>
</tbody>
            </table>
        </div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>
				 </div>
				 
				 
			 </div>
		
		</div> <!-- page content end here -->
		
		
</div>
</div>
<%
	}
	else
	{
		%>
<style>
.zcs-stat-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.zcs-stat-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #edf0f4;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
}

.zcs-stat-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0px;
    height: 0px;
    pointer-events: none;
    background: rgb(255 190 190 / 20%);
    box-shadow: 0px 1px 60px 50px rgba(255, 190, 190, 0.35);
    border-radius: 0 0 0 10px;
}

.zcs-stat-label {
    font-size: 14px;
    font-weight: 500;
    color: #6b7a8d;
    line-height: 1.4;
}

.zcs-stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #0a1929;
    line-height: 1.2;
}

.zcs-stat-trend {
    display: flex;
    align-items: center;
    gap: 6px;
    align-self: flex-end;
    background: #E7F7F2;
    padding: 4px 10px;
    border-radius: 4px;
}

.zcs-stat-trend i {
    width: 24px;
    height: 14px;
    color: #008C44;
}

.zcs-stat-trend-value {
    font-size: 13px;
    font-weight: 600;
    color: #008C44;
}

/* ===== Responsive ===== */
@media (max-width: 1024px) {
    .zcs-stat-cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .zcs-stat-cards {
        grid-template-columns: 1fr;
    }

    .zcs-dash-header {
        flex-direction: column;
        gap: 16px;
    }
}
/* ===== Content Grid ===== */
.zcs-content-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 20px;
    
}

/* ===== Active Plans Card ===== */
.zcs-plans-card {
    background: #ffffff;
    border: 1px solid #edf0f4;
    border-radius: 12px;
    padding: 24px;
}

.zcs-plans-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.zcs-plans-title {
    font-size: 18px;
    font-weight: 600;
    color: #0a1929;
}

.zcs-view-all {
    font-size: 14px;
    font-weight: 500;
    color: #e53e3e;
    text-decoration: none;
    cursor: pointer;
}

.zcs-view-all:hover {
    text-decoration: underline;
}

.zcs-plans-list {
    display: flex;
    flex-direction: column;
}

.zcs-plan-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    
}

.zcs-plan-row:last-child {
    border-bottom: none;
}

.zcs-plan-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
}

.zcs-plan-icon svg {
    width: 100%;
    height: 100%;
}

.zcs-plan-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
}

.zcs-plan-name {
    font-size: 15px;
    font-weight: 600;
    color: #0a1929;
}

.zcs-plan-meta {
    font-size: 13px;
    font-weight: 400;
    color: #8896a6;
}

/* Status Badges */
.zcs-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 5px 14px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
}

.zcs-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
}

.zcs-status-progress {
    background: #ede9fe;
    color: #4338ca;
}

.zcs-dot-blue {
    background: #4338ca;
}

.zcs-status-done {
    background: #ecfdf5;
    color: #059669;
}

.zcs-dot-green {
    background: #059669;
}

.zcs-status-not-started {
    background: #f3f4f6;
    color: #6b7280;
}

.zcs-dot-gray {
    background: #6b7280;
}
.zc-status-overdue{
	 background: #FFE3E3;
    color: #E33635;
}
.zcs-dot-red{
	color:#E33635;
}

/* ===== Recent Activity Card ===== */
.zcs-activity-card {
    background: #ffffff;
    border: 1px solid #edf0f4;
    border-radius: 12px;
    padding: 24px;
}

.zcs-activity-title {
    font-size: 18px;
    font-weight: 600;
    color: #0a1929;
    margin-bottom: 16px;
}

.zcs-activity-list {
    display: flex;
    flex-direction: column;
	gap: 16px;
	margin-top: 16px;
}

.zcs-activity-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 10px;
    background: #F8FAFB;
	border-radius:10px;
}

.zcs-activity-item:last-child {
    border-bottom: none;
}

.zcs-activity-dot {
    width: 10px;
    height: 10px;
    background: #e53e3e;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 5px;
}

.zcs-activity-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.zcs-activity-name {
    font-size: 14px;
    font-weight: 600;
    color: #0a1929;
}

.zcs-activity-meta {
    font-size: 13px;
    font-weight: 400;
    color: #8896a6;
}
.zcs-icon-wrapper {
    width: 32px;
    height: 32px;
    background-color: #FEE2E2;
    color: #FB2C36;
}
/* ===== Bottom Grid: Deadlines + Calendar ===== */
.zcs-bottom-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 20px;
}

/* ===== Upcoming Deadlines Card ===== */
.zcs-deadlines-card {
    background: #ffffff;
    border: 1px solid #edf0f4;
    border-radius: 12px;
    padding: 24px;
}

.zcs-deadlines-title {
    font-size: 18px;
    font-weight: 600;
    color: #0a1929;
    margin-bottom: 16px;
}

.zcs-deadlines-list {
    display: flex;
    flex-direction: column;
	gap: 16px;
    margin-top: 16px;
}

.zcs-deadline-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 10px;
    background: #F8FAFB;
    border-radius: 10px;
}

.zcs-deadline-item:last-child {
    border-bottom: none;
}

.zcs-deadline-dot {
    width: 10px;
    height: 10px;
    background: #e53e3e;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 5px;
}

.zcs-deadline-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.zcs-deadline-name {
    font-size: 14px;
    font-weight: 600;
    color: #0a1929;
}

.zcs-deadline-meta {
    font-size: 13px;
    font-weight: 400;
    color: #8896a6;
}




/* ===== Quick Actions Card ===== */

.zcs-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.zcs-action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px 16px;
    border-radius: 12px;
    border: 1px solid #edf0f4;
    cursor: pointer;
    transition: box-shadow 0.2s ease;
}

.zcs-action-item:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.zcs-action-icon {
    width: 36px;
    height: 36px;
}

.zcs-action-icon i {
    font-size: 34px;
}

.zcs-action-label {
    font-size: 13px;
    font-weight: 600;
    color: #0a1929;
    text-align: center;
}

/* Quick Action color variants */
.zcs-action-purple {
    background: #EFECFF;
    border: 1px solid #CCC2FF;
}

.zcs-action-purple .zcs-action-icon {
    color: #6F51FF;
}

.zcs-action-orange {
    background: #FFF4E5;
	border: 1px solid #FEE4C1;
}

.zcs-action-orange .zcs-action-icon {
    color: #FC8F01;
}

.zcs-action-green {
    background: #F2FBF5;
	border: 1px solid #C9EBD4;
}

.zcs-action-green .zcs-action-icon {
    color: #16A34A;
}

.zcs-action-blue {
    background: #F0F5FF;
    border: 1px solid #C6D8FB;
}

.zcs-action-blue .zcs-action-icon {
    color: #2B82F8;
}

/* ===== Header ===== */
.zcs-pc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.zcs-pc-title {
    font-size: 22px;
    font-weight: 700;
    color: #0a1929;
}

/* ===== Legend ===== */
.zcs-pc-legend {
    display: flex;
    align-items: center;
    gap: 24px;
}

.zcs-pc-legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.zcs-pc-legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.zcs-pc-dot--monthly {
    background: #f8c4c4;
}

.zcs-pc-dot--quarterly {
    background: #c9bff2;
}

.zcs-pc-dot--annual {
    background: #f5dea3;
}

.zcs-pc-legend-text {
    font-size: 14px;
    font-weight: 500;
    color: #3c3c3c;
}

/* ===== Calendar Grid ===== */
.zcs-pc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

/* ===== Month Card ===== */
.zcs-pc-card {
    background: linear-gradient(180deg, #FECACA24 0%, #F8FAFB00 100%);
    border: 1px solid #EEF2F4;
    border-radius: 10px;
    padding: 14px 9px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 150px;
}

.zcs-pc-month {
    font-size: 12px;
    font-weight: 600;
    color: #000000;
}

/* ===== Badges ===== */
.zcs-pc-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.zcs-pc-badge {
    font-size: 10px;
    font-weight: 500;
    color: #364153;
    padding: 6px 12px;
    border-radius: 8px;
}

.zcs-pc-badge--annual {
    background: #FFEED9;
}

.zcs-pc-badge--quarterly {
    background: #EAE6FF;
}

.zcs-pc-badge--monthly {
    background: #FFDEDE;
}

/* ===== Progress Bar ===== */
.zcs-pc-bar-track {
    width: 100%;
    height: 8px;
    background: #e4dede;
    border-radius: 4px;
    overflow: hidden;
}

.zcs-pc-bar-fill {
    height: 100%;
    background: #e63946;
    border-radius: 4px;
}

/* ===== Responsive ===== */
@media (max-width: 1024px) {
    .zcs-pc-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 768px) {
    .zcs-pc-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .zcs-pc-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}

@media (max-width: 480px) {
    .zcs-pc-grid {
        grid-template-columns: 1fr;
    }
}
.zcs-calendar-card {
    background: #ffffff;
    border: 1px solid #edf0f4;
    border-radius: 12px;
    padding: 16px 20px;
}
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
    padding:0px !important;
}
.zcs-page-container{
    overflow:auto !important;
}

</style>
<%
		yearStartDate = ("01-Jan-" + zoho.currentdate.getYear().toString()).toDate("dd-MMM-yyyy");
		yearEndDate = ("31-Dec-" + zoho.currentdate.getYear().toString()).toDate("dd-MMM-yyyy");
		yearPlanCount = Assessment_Plan[Start_Date <= yearStartDate && End_Date >= yearEndDate].count();
		%>
<div class='zcs-page-container zcs-commonview '>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 '>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.assessmentPlan.header")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.assessmentPlan.subHeader")%></p>
			</div>
<%
		if(thisapp.permission.app_access("assessment_plan") == true)
		{
			%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.assessmentPlan.createPlan")%> </span>
            </a>
<%
		}
		%>
</div>
		<div class="zcs-stat-cards">

           
            <div class="zcs-stat-card">
			<span class="zcs-stat-label"><%=language.get("grc.assessmentPlan.pendingPlans")%></span>
				<span class="zcs-stat-value"><%=Assessment_Plan[Status == "Not Started"].count()%></span>
               
            </div>

            
            <div class="zcs-stat-card">
                <span class="zcs-stat-label"><%=language.get("grc.assessmentPlan.activePlans")%></span>
                <span class="zcs-stat-value"><%=Assessment_Plan[Status == "In Progress"].count()%></span>
                
            </div>

           
            <div class="zcs-stat-card">
                <span class="zcs-stat-label"><%=language.get("grc.assessmentPlan.completedPlans")%></span>
                <span class="zcs-stat-value"><%=Assessment_Plan[Status == "Completed"].count()%></span>
                
            </div>

           
            <div class="zcs-stat-card">
                <span class="zcs-stat-label"><%=language.get("grc.assessmentPlan.overduePlans")%></span>
                <span class="zcs-stat-value"><%=Assessment_Plan[Status == "Overdue"].count()%></span>
               
            </div>

        </div>
		
		<div class='zcs-page-content zcs-card zcs-col-common  zcs-flex zcs-direction-column' style='height:500px;overflow:clip;'>
            
                
 
                     <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=overView&Page=<%=page_link_name%>&Report=Assessment_Plans'></div>
					<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Assessment_Plan_Report_Page' params='zc_Header=false' ></div>
                
           
		</div>
	
		
		<div class="zcs-row zcs-gap-20 zcs-w-full " style='height:558px;'>

            <!-- Upcoming Deadlines -->
            <div class="zcs-deadlines-card zcs-left-content zcs-h-full  zcs-col-6 zcs-col-sm-12 zcs-card">
                <h6 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessmentPlan.upcomingDeadlines")%></h6>
<%
		if(Assessment_Plan[End_Date > zoho.currentdate].count() > 0)
		{
			%>
<div class="zcs-deadlines-list zcs-overflow-auto" style='height:calc(100% - 22.5px);'>
<%
			for each  upcomingDet in Assessment_Plan[End_Date > zoho.currentdate]
			{
				%>
<div class="zcs-deadline-item">
                        <span class="zcs-deadline-dot"></span>
                        <div class="zcs-deadline-info">
                            <span class="zcs-deadline-name"><%=upcomingDet.Plan_Name%></span>
                            <span class="zcs-deadline-meta"><%=upcomingDet.Planning_Period%> \u2022 <%=upcomingDet.End_Date%></span>
                        </div>
                    </div>
<%
			}
			%>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>

			 <!-- Recent Activity -->
            <div class="zcs-activity-card zcs-right-content zcs-h-full  zcs-col-6 zcs-col-sm-12 zcs-card">
                <h6 class="zcs-font-18 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"><%=language.get("grc.assessmentPlan.recentActivity")%></h6>
<%
		getLogs = Audit_Log[Form_Link_Name == "Assessment_Plan"] sort by Added_Time desc;
		if(getLogs.count() > 0)
		{
			%>
<div class="zcs-activity-list zcs-overflow-auto" style='height:calc(100% - 22.5px);'>
<%
			for each  log in getLogs
			{
				%>
<div class="zcs-activity-item">
                        <span class="zcs-activity-dot"></span>
                        <div class="zcs-activity-info">
                            <span class="zcs-activity-name"><%=thisapp.Log.Log_Translation(log.Form_Link_Name,log.Record_ID,log.Action_Type,log.Performed_By,log.Title)%></span>
                            <span class="zcs-activity-meta"><%=log.Title%> \u2022 <%=log.Performed_Time%></span>
                        </div>
                    </div>
<%
			}
			%>
</div>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>

           
        </div>
		 <!-- 2025 Planning Calendar -->
            <div class="zcs-calendar-card zcs-row zcs-card zcs-w-full zcs-h-full" style="box-sizing: border-box;">
                   
			
            <!-- Header -->
            <div class="zcs-pc-header zcs-w-full">
                <h2 class="zcs-pc-title"><%=zoho.currentdate.getYear()%> Planning Calendar</h2>
                <div class="zcs-pc-legend">
                    <div class="zcs-pc-legend-item">
                        <span class="zcs-pc-legend-dot zcs-pc-dot--monthly"></span>
                        <span class="zcs-pc-legend-text">Monthly</span>
                    </div>
                    <div class="zcs-pc-legend-item">
                        <span class="zcs-pc-legend-dot zcs-pc-dot--quarterly"></span>
                        <span class="zcs-pc-legend-text">Quarterly</span>
                    </div>
                    <div class="zcs-pc-legend-item">
                        <span class="zcs-pc-legend-dot zcs-pc-dot--annual"></span>
                        <span class="zcs-pc-legend-text">Annual</span>
                    </div>
                </div>
            </div>
           
            <!-- Calendar Grid -->
            <div class="zcs-pc-grid zcs-w-full">
<%
		monthList = {"January","February","March","April","May","June","July","August","September","October","November","December"};
		for each  month in monthList
		{
			startDate = ("01-" + month + "-" + zoho.currentdate.getYear().toString()).toDate("dd-MMM-yyyy");
			endDate = startDate.addMonth(1).subDay(1);
			monthlyCount = Assessment_Plan[Planning_Period == "Monthly Plan" && Start_Date <= startDate && End_Date >= endDate].count();
			annualCount = Assessment_Plan[Planning_Period == "Annual Plan" && Start_Date <= startDate && End_Date >= endDate].count();
			quarterCount = Assessment_Plan[Planning_Period == "Quarterly Plan" && Start_Date <= startDate && End_Date >= endDate].count();
			progress = if(yearPlanCount > 0,(monthlyCount + annualCount + quarterCount) / yearPlanCount * 100,0);
			%>
<div class="zcs-pc-card">
                    <span class="zcs-pc-month"><%=month%></span>
                    <div class="zcs-pc-badges">
<%
			if(annualCount > 0)
			{
				%>
<span class="zcs-pc-badge zcs-pc-badge--annual">A : <%=annualCount%></span>
<%
			}
			if(quarterCount > 0)
			{
				%>
<span class="zcs-pc-badge zcs-pc-badge--quarterly">Q : <%=quarterCount%></span>
<%
			}
			if(monthlyCount > 0)
			{
				%>
<span class="zcs-pc-badge zcs-pc-badge--monthly">M : <%=monthlyCount%></span>
<%
			}
			%>
</div>
                    <div class="zcs-pc-bar-track">
                        <div class="zcs-pc-bar-fill" style="width: <%=progress%>%;"></div>
                    </div>
                </div>
<%
		}
		%>
</div>
        
			
			
            </div>

		
		
		
	</div>
	</div>
<%
	}
%>