<%
	page_link_name = "Controls_Page";
	language = thisapp.Content.translation();
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>
<%=thisapp.Styles_Page.Common_View()%>
.zcs-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
}
.zcs-list-container{
	max-height: 200px;
    overflow: auto;
}
</style>
<%
	if(input.page_action == "add")
	{
		actionList = {"Control Information","Risk Process Links","Effectiveness Testing"};
		current_stepper = if(input.recid != null,Control[ID == input.recid].Stepper_Stage,"Control Information");
		input.action_field = if(input.action_field.isEmpty() || input.action_field == "" || input.action_field == null || input.action_field == "null",current_stepper,input.action_field);
		actionParam = if(input.action_field.isEmpty(),"","&Action_Field=" + input.action_field);
		formParam = if(input.recid != null,"&recLinkID=" + input.recid + "&viewLinkName=Controls" + actionParam,actionParam);
		previoushrefLink = if(input.action_field != "Control Information",'#Page:' + page_link_name + '?page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(actionList.get(actionList.indexOf(input.action_field) - 1)),"");
		previoushrefAction = if(input.action_field != "Control Information","href=" + previoushrefLink,"");
		buttonName = if(input.action_field == "Effectiveness Testing","Submit","Continue");
		backurl = if(input.recid != null,"#Page:" + page_link_name + "?page_action=detailView&recid=" + input.recid,"#Page:" + page_link_name);
		%>
<style>
.form-action-container {
    position: relative;
}
.zc-form-footer .form-action-container .form-action.formbutton .form-label {
    display: flex;
    width: auto;
    padding: 0px;
} 
.form-action-container label:before {
    content: '<%=buttonName%>';
    min-width: 75px;
    height: 36px;
    display: inline-block;
    vertical-align: middle;
    background-color: var(--theme_brand_color);
    border-radius: var(--input_radius);
    padding: 8px 15px;
    font-size: 14px;
    line-height: 17px;
    font-weight: 400;
    text-align: center;
    color: var(--primary_btn_fClr);
    cursor: pointer;
    position: absolute;
    top: 14px;
    right: 30px;
}
.form-action-container .zc-live-primary-btn {
    background-color: transparent;
    color: transparent;
    margin: 0px;
    position: relative;
    z-index: 1;
}
  .choice-table-row .choice-table-cell > span > label.choice-label-text::before {
      position:absolute;
  }
    /* Visited Styles */
    .zcs-stepper-status {
        width: 32px;
        height: 32px;
        background-color: var(--zcs_brand_color);
        
    }

    .zcs-stepper-count {
        border: 1px solid var(--zcs_tertiary_border_color);
        display: none;
    }

    .zcs-stepper-icon.zcs-stepper-failed {
        display: none;
    }

    .zcs-stepper-level {
        display: none;
        background-color: var(--zcs_brand_color);
    }

    .zcs-stepper:not(:last-child):before {
        content: '';
        width: 100%;
        height: 1px;
        border-top: 1px solid var(--zcs_brand_color);
        box-sizing: border-box;
        position: absolute;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }

    /* Active Styles */
    .zcs-stepper-active .zcs-stepper-status {
        border: 1px solid var(--zcs_brand_color);
        
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active .zcs-stepper-count {
        display: flex;
        border-width: 0px;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper.zcs-stepper-active:before,
    .zcs-stepper.zcs-stepper-active~.zcs-stepper:before {
        border-color: var(--zcs_tertiary_border_color);
    }

    /* Stepper Failed */
    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-status {
        background-color: #FE455D;
        border-color: #FE455D;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-count {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-icon.zcs-stepper-failed {
        display: flex;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_primary_text_color);
    }

    /* Level Styles */
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-count,
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-level {
        display: flex;
    }

    /* Unvisited Styles */
    .zcs-stepper-active~.zcs-stepper .zcs-stepper-status {
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-count {
        display: flex;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-text {
        color: var(--zcs_tertiary_text_color);
    }

    @media (max-width: 575px) {
        .zcs-stepper-wrapper ul {
            flex-direction: column;
            gap: 24px;
        }

        .zcs-stepper-wrapper ul .zcs-stepper {
            flex-direction: row;
            gap: 16px;
        }

        .zcs-stepper:not(:last-child):before {
            width: 1px;
            height: 100%;
            border-left: 1px solid var(--zcs_brand_color);
            left: calc((32px - 1px) / 2);
        }
    }

    .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
        left: auto;
        right: 50%;
    }

    @media (max-width: 575px) {
        .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
            border-left: 1px solid var(--zcs_brand_color);
            left: auto;
            right: calc((32px - 1px) / 2);
        }
    }
    
    .zcs-icon-stepper-wrapper .zcs-stepper-status {
        width: 48px;
        height: 48px;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
        top: calc((48px - 1px) / 2);
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active .zcs-stepper-status {
        background-color: #FFE5E6;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active .zcs-stepper-icon {
        display: flex;
        color: var(--zcs_brand_color);
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active~.zcs-stepper .zcs-stepper-status {
        background-color: #E5E7EB;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active~.zcs-stepper .zcs-stepper-icon {
        display: flex;
        color: #62748E;
    }

    @media (max-width: 575px) {
        .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
            left: calc((48px - 1px) / 2);
        }
    }

    @media (max-width: 575px) {
        .zc-rtl-wrapper .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
            right: calc((48px - 1px) / 2);
        }
    }


.zcs-page-container { background-color: #F5F6FA; } .zcs-back:hover { color: #131635; }
.zcs-card {
    box-shadow: 0px 0px 6px 0px #E6E6E6;
}
/* .zcs-stepper-wrapper {
    border-bottom: 1px solid #e7e7ee;
} */
.zcs-wizard-page .zcs-form .zc-form-fullheight, .zcs-wizard-page .zcs-form .row, .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { width: 100%; height: 100%; background-color: transparent; } .zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper { height: 100% !important; border-width: 0px; background-color: transparent; } .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { display: flex; flex-direction: column; } .zcs-wizard-page .zcs-form .form-outer-wrapper .zc-mobile-scroll-ctr { display: flex; flex-direction: column; height: 100%; padding: 0px; } .zcs-wizard-page .zcs-form form .zc-form-scroll-wrapper { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; box-shadow: 0px 0px 6px 0px #E6E6E6; padding: 20px; box-sizing: border-box; } .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer { flex: 1; padding: 20px 10%; box-sizing: border-box; overflow: auto; background-color: transparent; } .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton { display: flex; align-items: center; padding: 20px 30px; box-sizing: border-box; justify-content: end; }

@media (max-width: 768px) {
    body:not(.zc-mobile) .zcs-page-container, body:not(.zc-mobile) .zcs-page-container-inner { height: auto; }
    .zcs-wizard-page .zcs-page-header,
    .zc-mobile .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer,
    .zc-mobile .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton {
        padding: 16px 20px;
    }
/*  .zcs-page-content {
        padding: 0px 20px 20px;
    } */
    body:not(.zc-mobile) .zcs-card {
        background-color: transparent;
        border-color: transparent;
    }
    body:not(.zc-mobile) .zcs-stepper-wrapper {
        border-bottom-width: 0px;
    }
}
@media (max-width: 575px) {
    .zcs-stepper-wrapper ul {
        flex-direction: row;
    }
    .zcs-stepper-wrapper ul .zcs-stepper {
        flex-direction: column;
    }
    .zcs-stepper-text {
        display: none;
    }
    .zcs-stepper:not(:last-child):before {
        width: 100%;
        height: 1px;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }
}
.zcs-form .zc-footer-wrapper{
     background-color: var(--zcs-white-color);
       
}
.zcs-button-disable
{
    color:#99A1AF !important;
}
</style>
<div class='zcs-page-container zcs-wizard-page zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>

<div class='zcs-page-header zcs-w-full zcs-flex  zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>

            <a href="<%=backurl%>" class="zcs-back">
					<i class="zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left"></i>
				</a>
			<div class='zcs-flex zcs-direction-column zcs-gap-6'>
			<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.control.addControl")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis zcs-m-0'> <%=language.get("grc.assessment.processIdentificationSubHeader")%> </p>
			</div>
        </div>
        <div class='zcs-page-content zcs-col-common zcs-overflow-auto'>
            <div class='zcs-wh-full zcs-flex zcs-direction-column zcs-box-border zcs-overflow-hidden zcs-relative'>
			
			<div class='zcs-stepper-wrapper zcs-icon-stepper-wrapper'>
    <ul class='zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0'>
<%
		stepCount = 1;
		iconList = {"travel-hotel","users-multiple-19","location-pin"};
		for each  step in actionList
		{
			currentStage = if(input.recid != null,Control[ID == input.recid].Stepper_Stage,"Control Information");
			getIndex = actionList.indexOf(currentStage) + 1;
			ahrefAction = "";
			if(stepCount <= getIndex)
			{
				ahrefLink = '#Page:' + page_link_name + '?page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(step);
				ahrefAction = "href=" + ahrefLink;
			}
			%>
<a class='zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative <%=if(step == input.action_field,"zcs-stepper-active","")%>' <%=ahrefAction%> >
							<div class='zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border zcs-relative'>
                <i class='zcs-stepper-icon zcs-font-18 zcs-font-semibold zcs-color-white zc-li-outline <%=iconList.get(stepCount - 1)%>'></i>
            </div>
            <span class='zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
			if(step == "Risk Process Links")
			{
				%>
Risk & Process Links
<%
			}
			else if(step == "Effectiveness Testing")
			{
				%>
Effectiveness & Testing
<%
			}
			else
			{
				%>
<%=step%>
<%
			}
			%>
</span>
						
						
							</a>
<%
			stepCount = stepCount + 1;
		}
		%>
</ul>
</div>
			

				<div class='zcs-col-common zcs-overflow-auto'>
					<div class='zcs-form' zc_MobileView='inline' elName='zc-component' formLinkName='Control' params='zc_Header=false&zc_Focus=false<%=formParam%>'></div>
				</div>
				<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
    <%=previoushrefAction%> style='position: absolute;bottom: 14px;left: 40px;'>
	<span class='zcs-button-text <%=if(input.action_field == "Control Information","zcs-button-disable","")%>'> <%=language.get("grc.button.previous")%> </span>
</a>
            </div>
        </div>

</div>
</div>
<%
	}
	else if(input.page_action == "detailView")
	{
		controlDet = Control[ID == input.recid];
		if(controlDet.Control_Status == "Active")
		{
			badgeClass = "zcs-badge-green";
		}
		else if(controlDet.Control_Status == "Under Review")
		{
			badgeClass = "zcs-badge-orange";
		}
		else if(controlDet.Control_Status == "Inactive")
		{
			badgeClass = "zcs-badge-red";
		}
		%>
<style>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Divider()%>
<%=thisapp.Styles.Label_Value()%>
<%=thisapp.Styles.Avatar()%>
		.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
.zcs-bg-grey {
	background-color: #F9FAFC;
}
.zcs-bg-blue {
	background-color: #F9FAFC;
}
.zcs-green-box {
    border: 1px solid #D0FAE5;
    color: #008000;
}
.zcs-blue-box {
    border: 1px solid #DBEAFE;
	background-color: #EFF6FF;
    color: #1C398E;
}
.zcs-grey-box {
    border: 1px solid #E2E8F0;
	background-color: #F8FAFC;
    color: #155DFC;
}
.zcs-red-box {
    border: 1px solid #FFE4E6;
    color: #EC003F;
}
@media (max-width: 768px) {
	.zcs-page-container .zcs-button {
		min-width: 36px;
	}
	.zcs-page-container .zcs-button .zcs-button-text {
		 display: none;
	}
	.zcs-page-fleet_driver .zcs-left-content,
	.zcs-page-fleet_driver .zcs-right-content {
		height: auto;
		overflow: initial;
	}
}
.zcs-icon-wrapper {
    width: 32px;
    height: 32px;
    background-color: #FEE2E2;
    color: #FB2C36;
}
		</style>
	<div class='zcs-page-container zcs-page-fleet_driver zcs-wh-full'>
          <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
              <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
			         <div class='zcs-flex zcs-gap-16 zcs-ellipsis'>
							<a class='zcs-back' href='#Page:<%=page_link_name%>'>
								<i class='zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left'></i>
							</a>
							<div class='zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis'>
								<div class='zcs-row zcs-align-items-center zcs-gap-8'>
									<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=controlDet.Control_Name_Title%> </h5>
									
	
		
									<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>'>
							<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> \u2022  <%=controlDet.Control_Status%> </span>
						</div>

								</div>
								
								<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>
									 ID: <%=controlDet.Control_ID_Code%> 
								</p>
								
							</div>
						</div>
						<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
<%
		if(thisapp.permission.app_access("contol_Library_Button") == true)
		{
			%>
<a href='#Page:<%=page_link_name%>?page_action=add&recid=<%=controlDet.ID%>&action_field=<%=encodeUrl("Control Information")%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
								<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
								<span class='zcs-button-text'> <%=language.get("grc.edit.text")%> </span>
							</a>
<%
		}
		%>
</div>
			  </div>
			   <div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border'>
			         <div class='zcs-grid zcs-gap-20 zcs-w-full zcs-mt-15' style='grid-template-columns: 2fr 1fr !important;'>
					        <div class='zcs-left-content zcs-h-full zcs-overflow-auto  zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20 zcs-card'>
							   <div class="zcs-flex zcs-direction-column zcs-gap-12 zcs-p-16 zcs-box-border">
										<h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0"> <%=language.get("grc.process.basicDetails")%> </h6>
										<div class="zcs-divider zcs-divider-horizontal"></div>
											<div class="zcs-flex zcs-direction-column zcs-gap-20">
											  <div class="zcs-row">
											         <div class='zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
													     <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.control.description")%></label>
														 <span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'><%=controlDet.Control_Description%></span>
													 </div>
													
											  </div>
											  <div class="zcs-row">
											  <div class='zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
													     <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.objective.status")%></label>
														 <div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border:none !important;'>
							<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>   <%=controlDet.Control_Status%> </span>
						</div>
														  
													 </div>
													 <div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
													     <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.control.createdBy")%></label>
														  <span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=controlDet.Added_User%>/<%=controlDet.Added_Time.toDate()%></span>
													 </div>
													  <div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
													     <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.control.lastTestedOn")%></label>
														  <span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=controlDet.Last_Tested_On%></span>
													 </div>
											  </div>
											  
											  <div class="zcs-row">
											  <div class='zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
													     <label class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary'><%=language.get("grc.control.nextReviewDue")%></label>
														  <span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=controlDet.Next_Review_Due%></span>
													 </div>
													 <div class='zcs-right-content zcs-h-full zcs-overflow-auto zcs-col-4 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-8'>
