        <div class='zcs-stat-icon'><svg viewBox='0 0 40 40' fill='none'><circle cx='20' cy='14' r='6' stroke='#e8b4b8' stroke-width='2'/><path d='M8 34c0-6.627 5.373-12 12-12s12 5.373 12 12' stroke='#e8b4b8' stroke-width='2' stroke-linecap='round'/></svg></div>
