				%>
<div class='zcs-page-container zcs-wizard-page zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
        <div class='zcs-page-header zcs-w-full zcs-flex zcs-direction-column zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
            <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'><%=language.get("board.title.setup")%></h5>
            <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis zcs-m-0'><%=language.get("board.title.setupDesc")%></p>
        </div>
        <div class='zcs-page-content zcs-col-common zcs-overflow-auto'>
            <div class='zcs-wh-full zcs-flex zcs-direction-column zcs-box-border zcs-overflow-hidden zcs-relative'>
                <div class='zcs-stepper-wrapper'>
                    <ul>
                        <li class='zcs-stepper <%=c1%>'>
                            <a class='zcs-stepper-link' <%=s1action%>>
                                <div class='zcs-stepper-status'>
                                    <svg viewBox='0 0 24 24'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M7 8h10M7 12h10M7 16h6'/></svg>
                                </div>
                                <span class='zcs-stepper-text'><%=language.get("board.stepper.details")%></span>
                            </a>
                        </li>
                        <li class='zcs-stepper <%=c2%>'>
                            <a class='zcs-stepper-link' <%=s2action%>>
                                <div class='zcs-stepper-status'>
                                    <svg viewBox='0 0 24 24'><circle cx='9' cy='8' r='3'/><circle cx='15' cy='8' r='3'/><path d='M3 19c0-3.314 2.686-6 6-6'/><path d='M21 19c0-3.314-2.686-6-6-6'/></svg>
                                </div>
                                <span class='zcs-stepper-text'><%=language.get("board.stepper.composition")%></span>
                            </a>
                        </li>
                        <li class='zcs-stepper <%=c3%>'>
                            <a class='zcs-stepper-link' <%=s3action%>>
                                <div class='zcs-stepper-status'>
                                    <svg viewBox='0 0 24 24'><path d='M12 2L4 6v6c0 5 3.5 9.4 8 10 4.5-.6 8-5 8-10V6l-8-4z'/><path d='M9 12l2 2 4-4'/></svg>
                                </div>
                                <span class='zcs-stepper-text'><%=language.get("board.stepper.rules")%></span>
                            </a>
                        </li>
                        <li class='zcs-stepper <%=c4%>'>
                            <a class='zcs-stepper-link' <%=s4action%>>
                                <div class='zcs-stepper-status'>
                                    <svg viewBox='0 0 24 24'><path d='M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2'/><rect x='9' y='3' width='6' height='4' rx='1'/><path d='M9 12l2 2 4-4'/></svg>
                                </div>
                                <span class='zcs-stepper-text'><%=language.get("board.stepper.review")%></span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class='zcs-col-common zcs-overflow-auto'>
                    <div class='zcs-form' zc_MobileView='inline' elName='zc-component' formLinkName='Board'
                         params='zc_Header=false&zc_SubmitVal=Next<%=formParam%>'></div>
                </div>
                <a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                   <%=previoushrefAction%> style='position:absolute;bottom:14px;left:40px;'>
                    <span class='zcs-button-text <%=isPrevDisabled%>'><%=language.get("board.button.previous")%></span>
                </a>
            </div>
        </div>
    </div>
</div>
<%
			}
		}
		if(showDetailView == true)
		{
			tab_map = thisapp.Page.Get_Tabs(page_link_name);
			tab_keys = tab_map.keys();
			input.tab = if(input.tab != "" && input.tab != "null" && input.tab != null,input.tab,tab_keys.get(0));
			addedTime = dRec.Added_Time.toString("MMM dd, yyyy, hh:mm a");
			modifiedTime = dRec.Modified_Time.toString("MMM dd, yyyy, hh:mm a");
			%>
</div>
<ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
<%
			for each  tab_id in tab_keys
			{
				class_name = if(input.tab == tab_id,"zcs-horizontal-tabitem zcs-horizontal-tabactive","zcs-horizontal-tabitem");
				%>
<li class='<%=class_name%>'><a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-secondary' href='#Page:<%=page_link_name%>?page_action=detailview&record_id=<%=input.recid%>&tab=<%=tab_id%>'><span class='zcs-horizontal-tab-text'><%=tab_map.get(tab_id).get("Display")%></span></a></li>
<%
			}
			%>
</ul>
<%
			if(input.tab == "overview" || input.tab.isEmpty())
			{
				%>
<style>
    .zcs-ov-container { padding: 0 20px 20px 20px; }
    .zcs-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .zcs-ov-card { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 0 6px rgba(0,0,0,0.06); font-family: Inter, sans-serif; }
    .zcs-ov-card h4 { font-size: 16px; font-weight: 700; color: #111827; margin: 0 0 4px 0; }
    .zcs-ov-card > p { font-size: 12px; color: #6B7280; margin: 0 0 16px 0; }

    .zcs-tier-radio { position: absolute; left: -9999px; opacity: 0; }
    .zcs-tier-tabs { display: flex; gap: 0; border-bottom: 1px solid #f0f0f0; margin-bottom: 16px; }
    .zcs-tier-tab { flex: 1; text-align: center; padding: 10px 0; font-size: 13px; font-weight: 600; color: #6B7280; cursor: pointer; border-bottom: 2px solid transparent; user-select: none; }
    .zcs-tier-pane { display: none; }
    #zcs-tier-mgmt-r:checked ~ .zcs-tier-pane-mgmt { display: block; }
    #zcs-tier-mgmt-r:checked ~ .zcs-tier-tabs label[for="zcs-tier-mgmt-r"] { color: #e8453c; border-bottom-color: #e8453c; }
    #zcs-tier-supv-r:checked ~ .zcs-tier-pane-supv { display: block; }
    #zcs-tier-supv-r:checked ~ .zcs-tier-tabs label[for="zcs-tier-supv-r"] { color: #e8453c; border-bottom-color: #e8453c; }

    .zcs-member-group-label { font-size: 13px; font-weight: 600; color: #e8453c; margin: 0 0 10px 0; }
    .zcs-member-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-bottom: 18px; }
    .zcs-member-chip { display: inline-flex; align-items: center; gap: 8px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 20px; padding: 5px 12px 5px 5px; }
    .zcs-member-avatar { width: 28px; height: 28px; border-radius: 50%; background: #e8453c; color: #fff; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .zcs-member-name { font-size: 13px; font-weight: 500; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .zcs-chair-crown { color: #e8453c; margin-left: 4px; }

    .zcs-compliance-card { margin-bottom: 16px; }
    .zcs-compliance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
    .zcs-compliance-item { display: flex; align-items: center; gap: 16px; padding: 16px 20px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; }
    .zcs-compliance-ring { position: relative; width: 56px; height: 56px; flex-shrink: 0; }
    .zcs-compliance-ring-svg { width: 56px; height: 56px; display: block; }
    .zcs-compliance-pct { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 12px; font-weight: 700; color: #111827; }
    .zcs-compliance-title { font-size: 14px; font-weight: 600; color: #111827; margin: 0 0 2px 0; }
    .zcs-compliance-sub { font-size: 12px; color: #6B7280; margin: 0; }

    @media(max-width:768px) { .zcs-two-col { grid-template-columns: 1fr; } .zcs-member-grid { grid-template-columns: 1fr; } .zcs-compliance-grid { grid-template-columns: 1fr; } }
</style>
<div class='zcs-ov-container'>
    <div class='zcs-two-col'>
        <div class='zcs-ov-card'>
<%
				if(boardType == "Advisory")
				{
					%>
<h4><%=language.get("board.section.boardMembers")%></h4>
<p>&nbsp;</p>
<%
				}
				else
				{
					%>
<h4><%=language.get("board.section.boardComposition")%></h4>
<p>&nbsp;</p>
<%
				}
				if(boardType == "Two-Tier")
				{
					mgmtChairChips = "";
					mgmtSecChips = "";
					mgmtExecChips = "";
					supvChairChips = "";
					supvSecChips = "";
					supvExecChips = "";
					for each  mRow in dRec.Board_Member_Assigment_Management_Two
					{
						mName = "";
						if(mRow.Member != null)
						{
							mName = mRow.Member.Name + "";
						}
						mName = mName.trim();
						firstLetter = "";
						secondLetter = "";
						if(mName.length() > 0)
						{
							firstLetter = mName.subString(0,1);
						}
						if(mName.contains(" "))
						{
							remainName = mName.getSuffix(" ").trim();
							if(remainName.length() > 0)
							{
								secondLetter = remainName.subString(0,1);
							}
						}
						initials = (firstLetter + secondLetter).toUpperCase();
						crown = "";
						mTypeRaw = mRow.Member_Type + "";
						if(mTypeRaw == "Chairperson")
						{
							crown = "<span class='zcs-chair-crown'>\u2655</span>";
						}
						chipHTML = "<div class='zcs-member-chip'><div class='zcs-member-avatar'>" + initials + "</div><span class='zcs-member-name'>" + mName + "</span>" + crown + "</div>";
						if(mTypeRaw == "Executive")
						{
							mgmtChairChips = mgmtChairChips + chipHTML;
						}
						else if(mTypeRaw == "Non-Executive")
						{
							mgmtSecChips = mgmtSecChips + chipHTML;
						}
						else if(mTypeRaw == "Independent")
						{
							mgmtExecChips = mgmtExecChips + chipHTML;
						}
					}
					for each  sRow in dRec.Board_Member_Assigment_Supervisory_Two
					{
						mName = "";
						if(sRow.Member != null)
						{
							mName = sRow.Member.Name + "";
						}
						mName = mName.trim();
						firstLetter = "";
						secondLetter = "";
						if(mName.length() > 0)
						{
							firstLetter = mName.subString(0,1);
						}
						if(mName.contains(" "))
						{
							remainName = mName.getSuffix(" ").trim();
							if(remainName.length() > 0)
							{
								secondLetter = remainName.subString(0,1);
							}
						}
						initials = (firstLetter + secondLetter).toUpperCase();
						crown = "";
						mTypeRaw = sRow.Member_Type + "";
						chipHTML = "<div class='zcs-member-chip'><div class='zcs-member-avatar'>" + initials + "</div><span class='zcs-member-name'>" + mName + "</span>" + crown + "</div>";
						if(mTypeRaw == "Executive")
						{
							supvChairChips = supvChairChips + chipHTML;
						}
						else if(mTypeRaw == "Non-Executive")
						{
							supvSecChips = supvSecChips + chipHTML;
						}
						else if(mTypeRaw == "Independent")
						{
							supvExecChips = supvExecChips + chipHTML;
						}
					}
					%>
<input type="radio" id="zcs-tier-mgmt-r" name="zcs-tier-toggle" class="zcs-tier-radio" checked>
<input type="radio" id="zcs-tier-supv-r" name="zcs-tier-toggle" class="zcs-tier-radio">

<div class="zcs-tier-tabs">
    <label for="zcs-tier-mgmt-r" class="zcs-tier-tab"><%=language.get("board.memberType.managementBoard")%></label>
    <label for="zcs-tier-supv-r" class="zcs-tier-tab"><%=language.get("board.memberType.supervisoryBoard")%></label>
</div>

<div class="zcs-tier-pane zcs-tier-pane-mgmt">
<%
					if(mgmtChairChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.executive")%></div>
    <div class='zcs-member-grid'><%=mgmtChairChips%></div>
<%
					}
					if(mgmtSecChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.secretary")%></div>
    <div class='zcs-member-grid'><%=mgmtSecChips%></div>
<%
					}
					if(mgmtExecChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.independent")%></div>
    <div class='zcs-member-grid'><%=mgmtExecChips%></div>
<%
					}
					%>
</div>

<div class="zcs-tier-pane zcs-tier-pane-supv">
<%
					if(supvChairChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.executive")%></div>
    <div class='zcs-member-grid'><%=supvChairChips%></div>
<%
					}
					if(supvSecChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.secretary")%></div>
    <div class='zcs-member-grid'><%=supvSecChips%></div>
<%
					}
					if(supvExecChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.independent")%></div>
    <div class='zcs-member-grid'><%=supvExecChips%></div>
<%
					}
					%>
</div>
<%
				}
				else
				{
					chairChips = "";
					execChips = "";
					nonExecChips = "";
					indChips = "";
					subformRows = list();
					if(boardType == "Single-Tier")
					{
						subformRows = dRec.Member_Assignment_Single;
					}
					else
					{
						subformRows = dRec.Board_Members_Assignment_Advisory;
					}
					for each  mRow in subformRows
					{
						mName = "";
						if(mRow.Member != null)
						{
							mName = mRow.Member.Name + "";
						}
						mName = mName.trim();
						firstLetter = "";
						secondLetter = "";
						if(mName.length() > 0)
						{
							firstLetter = mName.subString(0,1);
						}
						if(mName.contains(" "))
						{
							remainName = mName.getSuffix(" ").trim();
							if(remainName.length() > 0)
							{
								secondLetter = remainName.subString(0,1);
							}
						}
						initials = (firstLetter + secondLetter).toUpperCase();
						crown = "";
						mTypeRaw = mRow.Member_Type + "";
						if(mTypeRaw == "Chairperson")
						{
							crown = "<span class='zcs-chair-crown'>\u2655</span>";
						}
						chipHTML = "<div class='zcs-member-chip'><div class='zcs-member-avatar'>" + initials + "</div><span class='zcs-member-name'>" + mName + "</span>" + crown + "</div>";
						if(mTypeRaw == "Chairperson")
						{
							chairChips = chairChips + chipHTML;
						}
						else if(mTypeRaw == "Executive")
						{
							execChips = execChips + chipHTML;
						}
						else if(mTypeRaw == "Non-Executive")
						{
							nonExecChips = nonExecChips + chipHTML;
						}
						else if(mTypeRaw == "Independent")
						{
							indChips = indChips + chipHTML;
						}
					}
					if(chairChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.executive")%></div>
<div class='zcs-member-grid'><%=chairChips%></div>
<%
					}
					if(nonExecChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.nonExecutive")%></div>
<div class='zcs-member-grid'><%=nonExecChips%></div>
<%
					}
					if(execChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.executive")%></div>
<div class='zcs-member-grid'><%=execChips%></div>
<%
					}
					if(indChips != "")
					{
						%>
<div class='zcs-member-group-label'><%=language.get("board.memberType.independent")%></div>
<div class='zcs-member-grid'><%=indChips%></div>
<%
					}
				}
				%>
</div>
<%
				todayDate = zoho.currentdate;
				firstOfMonth = zoho.currentdate.toStartOfMonth();
				lastOfMonth = firstOfMonth.addMonth(1).subDay(1);
				upcomingMeetings = Meeting[Start_Date_Time > todayDate] sort by Start_Date_Time;
				recentMeetings = Meeting[Start_Date_Time >= firstOfMonth && Start_Date_Time <= lastOfMonth] sort by Start_Date_Time desc;
				upRecordsPerPage = 5;
				upTotalCount = upcomingMeetings.count();
				upStartIndex = 1;
				if(!input.up_start.isEmpty())
				{
					upStartIndex = input.up_start.toLong();
				}
				upDiff = upTotalCount - upStartIndex;
				upEndIndex = if(upStartIndex + upRecordsPerPage - 1 > upTotalCount,upStartIndex + upDiff,upStartIndex + upRecordsPerPage - 1);
				upPrevAction = if(upStartIndex == 1,"disable","");
				upNextAction = if(upEndIndex >= upTotalCount,"disable","");
				upPageLink = "#Page:Board_Page?zc_Header=false&page_action=detailview&record_id=" + input.rc_start + "&tab=overview";
				upPrevLink = if(upStartIndex > 1,"href='" + upPageLink + "&up_start=" + (upStartIndex - upRecordsPerPage) + "&zc_LoadIn=embed-embedDiv'","");
				upNextLink = if(upEndIndex < upTotalCount,"href='" + upPageLink + "&up_start=" + (upEndIndex + 1) + "&zc_LoadIn=embed-embedDiv'","");
				rcRecordsPerPage = 5;
				rcTotalCount = recentMeetings.count();
				rcStartIndex = 1;
				if(!input.rc_start.isEmpty())
				{
					rcStartIndex = input.rc_start.toLong();
				}
				rcDiff = rcTotalCount - rcStartIndex;
				rcEndIndex = if(rcStartIndex + rcRecordsPerPage - 1 > rcTotalCount,rcStartIndex + rcDiff,rcStartIndex + rcRecordsPerPage - 1);
				rcPrevAction = if(rcStartIndex == 1,"disable","");
				rcNextAction = if(rcEndIndex >= rcTotalCount,"disable","");
				rcPageLink = "#Page:Board_Page?zc_Header=false&page_action=detailview&record_id=" + input.recid + "&tab=overview";
				rcPrevLink = if(rcStartIndex > 1,"href='" + rcPageLink + "&rc_start=" + (rcStartIndex - rcRecordsPerPage) + "&zc_LoadIn=embed-embedDiv'","");
				rcNextLink = if(rcEndIndex < rcTotalCount,"href='" + rcPageLink + "&rc_start=" + (rcEndIndex + 1) + "&zc_LoadIn=embed-embedDiv'","");
				%>
<div class='zcs-ov-card'>
    <h4><%=language.get("board.section.upcomingMeetings")%></h4>
    <p>&nbsp;</p>
    <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
        <table class='zcs-w-full'>
            <thead class='zcs-sticky'>
                <tr>
                    <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.meetingName")%></th>
                    <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.date")%></th>
                    <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.agenda")%></th>
                    <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.meetingMode")%></th>
                </tr>
                <tr class='zcs-tspace'>
                    <th class='zcs-p-2 zcs-box-border' colspan='4'></th>
                </tr>
            </thead>
            <tbody>
<%
				upIdx = 0;
				upDisplayedCount = 0;
				for each  um in upcomingMeetings
				{
					upIdx = upIdx + 1;
					if(upIdx >= upStartIndex && upIdx <= upEndIndex)
					{
						umDateStr = "\u2014";
						if(um.Start_Date_Time != null)
						{
							umDateStr = um.Start_Date_Time.toString("MMM dd, yyyy");
						}
						umAgenda = Agenda_Item[Meeting.ID == um.ID].count();
						umDetailUrl = "#Page:Meeting_Page?page_action=detailview&record_id=" + um.ID;
						umMode = if(um.Meeting_Mode != null,um.Meeting_Mode + "","\u2014");
						umModeCls = "zcs-color-primary";
						if(umMode == "Physical Location")
						{
							umModeCls = "zcs-mode-physical";
						}
						else if(umMode == "Virtual Meeting")
						{
							umModeCls = "zcs-mode-virtual";
						}
						else if(umMode == "Hybrid Meeting")
						{
							umModeCls = "zcs-mode-hybrid";
						}
						upDisplayedCount = upDisplayedCount + 1;
						%>
<tr>
                    <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                        <a href='<%=umDetailUrl%>' target='_blank' style='color:inherit;text-decoration:none;font-weight:500;'
                            onmouseover='this.style.textDecoration="underline"'
                            onmouseout='this.style.textDecoration="none"'><%=um.Meeting_Title%></a>
                    </td>
                    <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=umDateStr%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=umAgenda%></td>
                    <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body <%=umModeCls%>'><%=umMode%></td>
                </tr>
<%
					}
				}
				if(upDisplayedCount == 0)
				{
					%>
<%=thisapp.Page.noData()%>
<%
				}
				%>
</tbody>
        </table>
    </div>
<%
				if(upTotalCount > 0)
				{
					%>
<div class='zcs-pagination'>
        <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
            <li class='zcs-pagination-item'>
                <span class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
                    <%=upStartIndex%>-<%=upEndIndex%> of <%=upTotalCount%>
                </span>
            </li>
            <li class='zcs-pagination-item'>
                <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(upPrevAction == "disable","zcs-button-disable","")%>' <%=upPrevLink%>>
                    <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
                </a>
            </li>
            <li class='zcs-pagination-item'>
                <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(upNextAction == "disable","zcs-button-disable","")%>' <%=upNextLink%>>
                    <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
                </a>
            </li>
        </ul>
    </div>
<%
				}
				%>
</div>
</div>

<div class='zcs-two-col'>
    <div class='zcs-ov-card'>
        <h4><%=language.get("board.section.recentMeetings")%></h4>
        <p>&nbsp;</p>
        <div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
            <table class='zcs-w-full'>
                <thead class='zcs-sticky'>
                    <tr>
                        <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.meetingName")%></th>
                        <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.date")%></th>
                        <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.agenda")%></th>
                        <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("board.table.meetingMode")%></th>
                    </tr>
                    <tr class='zcs-tspace'>
                        <th class='zcs-p-2 zcs-box-border' colspan='4'></th>
                    </tr>
                </thead>
                <tbody>
<%
				rcIdx = 0;
				rcDisplayedCount = 0;
				for each  rm in recentMeetings
				{
					rcIdx = rcIdx + 1;
					if(rcIdx >= rcStartIndex && rcIdx <= rcEndIndex)
					{
						rmDateStr = "\u2014";
						if(rm.Start_Date_Time != null)
						{
							rmDateStr = rm.Start_Date_Time.toString("MMM dd, yyyy");
						}
						rmAgenda = Agenda_Item[Meeting.ID == rm.ID].count();
						rmDetailUrl = "#Page:Meeting_Page?page_action=detailview&record_id=" + rm.ID;
						rmMode = if(rm.Meeting_Mode != null,rm.Meeting_Mode + "","\u2014");
						rmModeCls = "zcs-color-primary";
						if(rmMode == "Physical Location")
						{
							rmModeCls = "zcs-mode-physical";
						}
						else if(rmMode == "Virtual Meeting")
						{
							rmModeCls = "zcs-mode-virtual";
						}
						else if(rmMode == "Hybrid Meeting")
						{
							rmModeCls = "zcs-mode-hybrid";
						}
						rcDisplayedCount = rcDisplayedCount + 1;
						%>
<tr>
                        <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
                            <a href='<%=rmDetailUrl%>' target='_blank' style='color:inherit;text-decoration:none;font-weight:500;'
                                onmouseover='this.style.textDecoration="underline"'
                                onmouseout='this.style.textDecoration="none"'><%=rm.Meeting_Title%></a>
                        </td>
                        <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=rmDateStr%></td>
                        <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-right zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=rmAgenda%></td>
                        <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body <%=rmModeCls%>'><%=rmMode%></td>
                    </tr>
<%
					}
				}
				if(rcDisplayedCount == 0)
				{
					%>
<%=thisapp.Page.noData()%>
<%
				}
				%>
</tbody>
            </table>
        </div>
<%
				if(rcTotalCount > 0)
				{
					%>
<div class='zcs-pagination'>
        <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
            <li class='zcs-pagination-item'>
                <span class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
                    <%=rcStartIndex%>-<%=rcEndIndex%> of <%=rcTotalCount%>
                </span>
            </li>
            <li class='zcs-pagination-item'>
                <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(rcPrevAction == "disable","zcs-button-disable","")%>' <%=rcPrevLink%>>
                    <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
                </a>
            </li>
            <li class='zcs-pagination-item'>
                <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(rcNextAction == "disable","zcs-button-disable","")%>' <%=rcNextLink%>>
                    <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
                </a>
            </li>
        </ul>
    </div>
<%
				}
				%>
</div>
<div class='zcs-ov-card'>
            <h4><%=language.get("board.section.activityTimeline")%></h4>
            <p>&nbsp;</p>
            <div style='display:flex;gap:12px;margin-bottom:16px;'>
                <div style='width:40px;height:40px;background:#f3f4f6;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;'>
                    <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#6B7280' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2'/><rect x='9' y='3' width='6' height='4' rx='1'/><path d='M9 12l2 2 4-4'/></svg>
                </div>
                <div>
                    <p style='font-size:13px;color:#374151;font-weight:500;margin:0 0 2px 0;'><%=language.get("board.timeline.setupCompleted")%> \u2014 <%=dRec.Board_Type_Board%></p>
                    <p style='font-size:12px;color:#e8453c;margin:0;'><%=addedTime%></p>
                </div>
            </div>
            <div style='display:flex;gap:12px;'>
                <div style='width:40px;height:40px;background:#f3f4f6;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;'>
                    <svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#6B7280' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2'/><rect x='9' y='3' width='6' height='4' rx='1'/><path d='M9 12h6M9 16h4'/></svg>
                </div>
                <div>
                    <p style='font-size:13px;color:#374151;font-weight:500;margin:0 0 2px 0;'><%=language.get("board.timeline.lastModified")%></p>
                    <p style='font-size:12px;color:#e8453c;margin:0;'><%=modifiedTime%></p>
                </div>
            </div>
        </div>
    </div>
<%
			}
			else if(input.tab == "committee")
			{
				committeeIDList = Committee[ID != 0].ID.getAll();
				cmtTypeFilter = 0;
				if(input.Committee_Type != null)
				{
					ctStr = input.Committee_Type + "";
					if(ctStr != "null" && !ctStr.isEmpty() && ctStr != "0")
					{
						cmtTypeFilter = input.Committee_Type.toLong();
					}
				}
				if(cmtTypeFilter > 0)
				{
					committeeIDList = Committee[ID == committeeIDList && Committee_Type == cmtTypeFilter].ID.getAll();
				}
				searchKeyVal = "";
				if(input.Search_Key != null)
				{
					skStr = input.Search_Key + "";
					if(skStr != "null" && !skStr.isEmpty())
					{
						searchKeyVal = skStr;
					}
				}
				if(searchKeyVal != "")
				{
					committeeIDList = Committee[ID == committeeIDList && Committee_Name.contains(searchKeyVal) || Commitee_Code.contains(searchKeyVal)].ID.getAll();
				}
				committees = Committee[ID == committeeIDList];
				cmtRecordsPerPage = 6;
				cmtTotalCount = committeeIDList.size();
				cmtStartIndex = 1;
				if(!input.cmt_start.isEmpty())
				{
					cmtStartIndex = input.cmt_start.toLong();
				}
				cmtDiff = cmtTotalCount - cmtStartIndex;
				cmtEndIndex = if(cmtStartIndex + cmtRecordsPerPage - 1 > cmtTotalCount,cmtStartIndex + cmtDiff,cmtStartIndex + cmtRecordsPerPage - 1);
				cmtPrevAction = if(cmtStartIndex == 1,"disable","");
				cmtNextAction = if(cmtEndIndex >= cmtTotalCount,"disable","");
				cmtPageLink = "#Page:Board_Page?zc_Header=false&page_action=detailview&record_id=" + input.recid + "&tab=committee" + pageParam;
				cmtPrevLink = if(cmtStartIndex > 1,"href='" + cmtPageLink + "&cmt_start=" + (cmtStartIndex - cmtRecordsPerPage) + "&zc_LoadIn=embed-cmtEmbedDiv'","");
				cmtNextLink = if(cmtEndIndex < cmtTotalCount,"href='" + cmtPageLink + "&cmt_start=" + (cmtEndIndex + 1) + "&zc_LoadIn=embed-cmtEmbedDiv'","");
				committees = Committee[ID == committeeIDList];
				%>
<style>
    .zcs-committee-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; padding: 0 20px; align-items: stretch; }
    .zcs-committee-grid > a { display: flex; }
    .zcs-committee-card { background: #fff; border-radius: 12px; padding: 16px 20px; box-shadow: 0 0 6px rgba(0,0,0,0.06); border: 1px solid #f0f0f0; transition: box-shadow 0.15s, border-color 0.15s; cursor: pointer; display: flex; flex-direction: column; width: 100%; }
    .zcs-committee-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); border-color: #e8453c; }
    .zcs-committee-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; flex: 1; }
    .zcs-committee-card-left { display: flex; align-items: flex-start; gap: 12px; flex: 1; min-width: 0; }
    .zcs-committee-icon { width: 36px; height: 36px; background: #fff1f1; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .zcs-committee-icon svg { width: 18px; height: 18px; }
    .zcs-committee-title { font-size: 14px; font-weight: 700; color: #111827; margin: 0 0 2px 0; font-family: Inter, sans-serif; }
    .zcs-committee-desc { font-size: 12px; color: #6B7280; margin: 0; font-family: Inter, sans-serif; line-height: 1.5; }
    .zcs-committee-type { font-size: 11px; font-weight: 500; color: #6B7280; background: #F3F4F6; padding: 4px 10px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }
    .zcs-committee-meta { display: flex; gap: 20px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #F3F4F6; flex-wrap: wrap; }
    .zcs-committee-meta-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #6B7280; font-family: Inter, sans-serif; }
    .zcs-committee-meta-item svg { width: 14px; height: 14px; flex-shrink: 0; }
    @media(max-width:768px) { .zcs-committee-grid { grid-template-columns: 1fr; } }
    .zcs-filter.divEmbedContainer { display: block !important; }
</style>
<div class="zcs-filter" elName="zc-component" formLinkName="Filter_Form" params='zc_Header=false&zc_Footer=false&zc_Focus=false&Page=Board_Page&Tab=committee&Committee_Type=<%=input.Committee_Type%>&Search_Key=<%=input.Search_Key%>'></div>
</div>
<div name='cmtEmbedDiv'>
<%
				if(cmtTotalCount == 0)
				{
					%>
<%=thisapp.Page.noData()%>
<%
				}
				else
				{
					%>
<div class='zcs-committee-grid'>
<%
					cmtIdx = 0;
					for each  c in committees
					{
						cmtIdx = cmtIdx + 1;
						if(cmtIdx >= cmtStartIndex && cmtIdx <= cmtEndIndex)
						{
							chairName = "";
							if(c.Chairperson_Name != null)
							{
								chairName = c.Chairperson_Name.Name + "";
							}
							%>
<a href='#Page:<%=page_link_name%>?page_action=committee_detail&recid=<%=c.ID%>' style='text-decoration:none;'>
    <div class='zcs-committee-card'>
        <div class='zcs-committee-card-header'>
            <div class='zcs-committee-card-left'>
                <div class='zcs-committee-icon'>
                    <svg viewBox='0 0 24 24' fill='none' stroke='#e8453c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
                        <rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 9h18'/><path d='M9 4v5M15 4v5'/>
                    </svg>
                </div>
                <div>
                    <p class='zcs-committee-title'><%=c.Committee_Name%></p>
                    <p class='zcs-committee-desc'><%=c.Purpose_Objective%></p>
                </div>
            </div>
            <span class='zcs-committee-type'><%=c.Committee_Type.Committee_Type%></span>
        </div>
        <div class='zcs-committee-meta'>
            <div class='zcs-committee-meta-item'>
                <svg viewBox='0 0 24 24' fill='none' stroke='#e8453c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 9h18'/><path d='M9 4v5M15 4v5'/></svg>
                <span><%=c.Commitee_Code%></span>
            </div>
            <div class='zcs-committee-meta-item'>
                <svg viewBox='0 0 24 24' fill='none' stroke='#e8453c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='4'/><path d='M4 20c0-4 3.6-7 8-7s8 3 8 7'/></svg>
                <span><%=chairName%></span>
            </div>
            <div class='zcs-committee-meta-item'>
                <svg viewBox='0 0 24 24' fill='none' stroke='#e8453c' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='3'/><circle cx='15' cy='8' r='3'/><path d='M3 20c0-3.3 2.7-6 6-6h6c3.3 0 6 2.7 6 6'/></svg>
                <span><%=c.Minimum_Count%>/<%=c.Preferred_Count%> Members</span>
            </div>
        </div>
    </div>
</a>
<%
						}
					}
					%>
</div>
<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
                <%=cmtStartIndex%>-<%=cmtEndIndex%> of <%=cmtTotalCount%>
            </span>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(cmtPrevAction == "disable","zcs-button-disable","")%>' <%=cmtPrevLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(cmtNextAction == "disable","zcs-button-disable","")%>' <%=cmtNextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
				}
				%>
</div>
<%
			}
			else if(input.tab == "member")
			{
				%>
<style>
					.zcs-filter.divEmbedContainer {
    display: block !important;}
				</style>
<div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Page=Board_Page&Tab=member&Status=<%=input.Status%>&Search_Key=<%=input.Search_Key%>'></div>
<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Board_Members' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false&Status=<%=input.Status%>&Name=<%=input.Search_Key%>&Name_op=26'></div>
<%
			}
		}
	}
	%>
<style>
<%=thisapp.Styles_Page.Board_Page()%>
<%=thisapp.Styles_Page.Committee_Detailview()%>
</style>