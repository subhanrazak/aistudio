            <div style='width:48px;height:48px;background-color:#EAD6D6;border-radius:12px;display:flex;align-items:center;justify-content:center;'>
                <svg width='24' height='24' viewBox='0 0 24 24' fill='none'>
                    <rect x='4' y='7' width='16' height='13' rx='2' stroke='#e8453c' stroke-width='1.6'/>
                    <path d='M8 7V5a2 2 0 014 0v2' stroke='#e8453c' stroke-width='1.6' stroke-linecap='round'/>
                    <path d='M8 12h8M8 15h5' stroke='#e8453c' stroke-width='1.6' stroke-linecap='round'/>
                </svg>
            </div>
            <div>
                <h3><%=boardDisplayName%></h3>
                <p><%=identitySubText%></p>
            </div>
        </div>
        <div class='zcs-badge-active'>\u25CF <%=language.get("board.meta.activeBoard")%></div>
    </div>
<%
			if(boardType == "Single-Tier")
			{
				bType = if(dRec.Board_Type_Board != null,dRec.Board_Type_Board + "","\u2014");
				jur = if(dRec.Jurisdiction != null,dRec.Jurisdiction + "","\u2014");
				ind = if(dRec.Industry != null,dRec.Industry + "","\u2014");
				vMethod = if(dRec.Voting_Methods_Single != null,dRec.Voting_Methods_Single + "","\u2014");
				gender = "\u2014";
