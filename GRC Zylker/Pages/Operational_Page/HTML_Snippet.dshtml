                        </div>
                    </li>
                    <li class='zcs-col-4 zcs-col-sm-6 zcs-col-xs-12'>
                        <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
                            <span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Independence Ratio</span>
                            <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-green zcs-m-0'><%=cmIndepRatio%>% (<%=cmIndepCount%>/<%=cmMemberCount%>)</h4>
                            <span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Benchmark: &ge;75%</span>
                        </div>
                    </li>
                    <li class='zcs-col-4 zcs-col-sm-6 zcs-col-xs-12'>
                        <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'>
                            <span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Female Representation</span>
                            <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-green zcs-m-0'><%=cmFemaleRatio%>% (<%=cmFemaleCount%>/<%=cmMemberCount%>)</h4>
                            <span class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>Target: &ge;30%</span>
                        </div>
                    </li>
                </ul>

                <h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-mt-8'>Tenure Distribution</h6>
                <ul class='zcs-list zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12'><div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>0-6 months</span><h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=tenure0to3%> Members</h6></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12'><div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>7-12 months</span><h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=tenure4to7%> Members</h6></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12'><div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>12+ months</span><h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=tenure8plus%> Members</h6></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12'><div class='zcs-card zcs-flex zcs-direction-column zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border'><span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary'>Average Tenure</span><h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'><%=avgTenure%> months</h6></div></li>
                </ul>

<h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-mt-8'>Skill Coverage Matrix</h6>
