					skPrevLink = if(skStartIndex > 1,"href='" + skPageLink + "&sk_start=" + (skStartIndex - skRecordsPerPage) + "'","");
					skNextLink = if(skEndIndex < skTotalCount,"href='" + skPageLink + "&sk_start=" + (skEndIndex + 1) + "'","");
					if(skTotalCount == 0)
					{
						%>
<%=thisapp.Page.noData()%>
<%
					}
					else
					{
						%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Skill Category</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Coverage</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("ops.committee.status")%></th>
            </tr>
            <tr class='zcs-tspace'><th class='zcs-p-2 zcs-box-border' colspan='3'></th></tr>
        </thead>
        <tbody>
<%
						skIdx = 0;
						for each  skKey in skillKeys
						{
							skIdx = skIdx + 1;
							if(skIdx >= skStartIndex && skIdx <= skEndIndex)
							{
								skCount = skillMap.get(skKey).toLong();
								skPct = if(cmMemberCount > 0,((skCount * 100) / cmMemberCount).toLong(),0);
								skClr = if(skPct >= 80,"#179E6C",if(skPct >= 50,"#f59e0b","#e8453c"));
								skStatus = if(skPct >= 80,"Strong",if(skPct >= 50,"Partial","Weak"));
								skStatusBg = if(skPct >= 80,"#e4fcf3",if(skPct >= 50,"#FCF4E6","#FDE3E6"));
								skStatusClr = if(skPct >= 80,"#179E6C",if(skPct >= 50,"#B8770D","#FE455D"));
								%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=skKey%></td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <div class='zcs-flex zcs-align-items-center zcs-gap-8'><div class='zcs-cm-skill-bar'><div class='zcs-cm-skill-fill' style='width:<%=skPct%>%;background:<%=skClr%>;'></div></div><span class='zcs-font-13 zcs-color-primary'><%=skCount%>/<%=cmMemberCount%> Members</span></div>
                </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <span class='zcs-cm-badge' style='background:<%=skStatusBg%>;color:<%=skStatusClr%>;'><%=skStatus%></span>
                </td>
            </tr>
<%
							}
						}
						%>
</tbody>
    </table>
</div>
<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
                <%=skStartIndex%>-<%=skEndIndex%> of <%=skTotalCount%>
            </span>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(skPrevAction == "disable","zcs-button-disable","")%>' <%=skPrevLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(skNextAction == "disable","zcs-button-disable","")%>' <%=skNextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
					}
					%>
</div>

<!-- Meeting Effectiveness + Oversight Quality -->
            <div class='zcs-row zcs-gap-20' style='align-items:stretch;'>
                <div class='zcs-col-6 zcs-col-xs-12'>
                    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border' style='height:100%;'>
                 <h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'>Meeting Effectiveness</h6>
                        <div class='zcs-flex zcs-direction-column zcs-gap-20'>
<%
					hvpClr = if(hvpPct >= 90,"#179E6C",if(hvpPct >= 75,"#f59e0b","#e8453c"));
					attClr2 = if(cmAvgAtt2 >= 90,"#179E6C",if(cmAvgAtt2 >= 75,"#f59e0b","#e8453c"));
					acClr2 = if(cmActionCompRate >= 90,"#179E6C",if(cmActionCompRate >= 75,"#f59e0b","#e8453c"));
					agcClr = if(cmAgendaCompRate >= 90,"#179E6C",if(cmAgendaCompRate >= 75,"#f59e0b","#e8453c"));
					matClr = if(cmMatPct >= 90,"#179E6C",if(cmMatPct >= 75,"#f59e0b","#e8453c"));
					%>
<div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Meetings Held vs Planned</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmHeldVsPlanned%></span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=hvpPct%>%;background:<%=hvpClr%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Target 100%</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Average Attendance</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmAvgAtt2%>%</span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmAvgAtt2%>%;background:<%=attClr2%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Target &ge;90%</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Agenda Completion Rate</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmAgendaCompRate%>%</span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmAgendaCompRate%>%;background:<%=agcClr%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Per meeting</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Advance Material Distribution</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmMatPct%>%</span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmMatPct%>%;background:<%=matClr%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Target 5+ days before meeting</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class='zcs-col-6 zcs-col-xs-12'>
                    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-16 zcs-p-20 zcs-box-border' style='height:100%;'>
                  <h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'>Oversight Quality &amp; Risk Control</h6>
                        <div class='zcs-flex zcs-direction-column zcs-gap-20'>
<%
					escClr = if(cmEscPct <= 10,"#179E6C",if(cmEscPct <= 25,"#f59e0b","#e8453c"));
					%>
<div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Action Item Closure Rate</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmActionCompRate%>%</span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmActionCompRate%>%;background:<%=acClr2%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>% closed within SLA</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Overdue Actions</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmOverdueAT2%></span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmEscPct%>%;background:<%=escClr%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Lower is better</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Risk Issues Escalated</span><span class='zcs-font-16 zcs-font-medium zcs-color-primary'><%=cmEscalated%></span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:<%=cmEscPct%>%;background:<%=escClr%>;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>Overdue vs total actions</p>
                            </div>
                            <div class='zcs-cm-metric'>
                                <div class='zcs-cm-metric-row'><span class='zcs-font-16 zcs-font-medium zcs-color-primary'>Escalations to Board</span><span class='zcs-font-16 zcs-font-medium zcs-color-tertiary'>-</span></div>
                                <div class='zcs-cm-bar-track-lg'><div class='zcs-cm-bar-fill' style='width:0%;'></div></div>
                                <p class='zcs-font-12 zcs-font-normal zcs-color-tertiary zcs-m-0'>-</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
<%
				}
				else
				{
					%>
<div class='zcs-card zcs-p-20 zcs-box-border zcs-text-center'>
			<p class='zcs-font-14 zcs-color-tertiary'>No committee found. Please add a committee first.</p>
		</div>
<%
				}
			}
			/* \u2500\u2500 INDIVIDUAL SUB-TAB (static placeholder) \u2500\u2500 */
			else if(input.perf_tab == "individual")
			{
				%>
<style>
			.zcs-ind-avatar { width:28px;height:28px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0; }
    .zcs-ind-bar-wrap { display:flex;align-items:center;gap:6px; }
    .zcs-ind-bar-track { width:60px;height:6px;background:#eef1f6;border-radius:999px;overflow:hidden; }
    .zcs-ind-bar-fill { height:100%;border-radius:999px; }
    .zcs-ind-status { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:6px;font-size:12px;font-weight:500; }
    .zcs-ind-dot { width:7px;height:7px;border-radius:50%;flex-shrink:0; }
    .zcs-ind-score-bar { height:100%;border-radius:0 6px 6px 0; }
			</style>
<%
				/* \u2500\u2500 Individual tab data fetch \u2500\u2500 */
				indUserList = List();
				indTotalUsers = 0;
				indSumAtt = 0;
				indSumComp = 0;
				indSumContrib = 0;
				indUserCount = 0;
				allUsers = User[ID != 0];
				indTotalUsers = allUsers.count();
				uIdx = 0;
				for each  usr in allUsers
				{
					uRow = Map();
					uName = usr.Name + "";
					if(uName == "null" || uName.isEmpty())
					{
						uName = "-";
					}
					uRow.put("name",uName);
					uInitial = if(uName != "-" && uName.length() > 0,uName.subString(0,1),"?");
					uRow.put("initial",uInitial);
					uRole = "-";
					if(usr.Role != null)
					{
						roleRec = Role[ID == usr.Role];
						if(roleRec != null)
						{
							rName = roleRec.Role_Name + "";
							if(rName != "null" && !rName.isEmpty())
							{
								uRole = rName;
							}
						}
					}
					uRow.put("role",uRole);
					uColorIdx = (uIdx - (uIdx / 5).toLong() * 5).toLong();
					uRow.put("avatarBg",avatarBgs.get(uColorIdx));
					uRow.put("avatarClr",avatarClrs.get(uColorIdx));
					/* Attendance */
					/* Attendance \u2014 loop meetings, check subform for this user */
					uTotalMtg = 0;
					uPresentMtg = 0;
					allMtgsForAtt = Meeting[ID != 0];
					for each  mtgA in allMtgsForAtt
					{
						for each  attR in mtgA.Meeting_Attendance
						{
							if(attR.Member != null)
							{
								attMemberId = attR.Member + "";
								usrIdStr = usr.ID + "";
								if(attMemberId == usrIdStr)
								{
									uTotalMtg = uTotalMtg + 1;
									attSt = attR.Status + "";
									if(attSt == "Present")
									{
										uPresentMtg = uPresentMtg + 1;
									}
								}
							}
						}
					}
					uAttPct = if(uTotalMtg > 0,((uPresentMtg * 100) / uTotalMtg).toLong(),0);
					uRow.put("attendance",uAttPct);
					/* Completion */
					uTotalAT = Action_Tracker[Assign_To == usr.ID].count();
					uCompAT = Action_Tracker[Assign_To == usr.ID && Status == "Completed"].count();
					uCompPct = if(uTotalAT > 0,((uCompAT * 100) / uTotalAT).toLong(),0);
					uRow.put("completion",uCompPct);
					uRow.put("totalActions",uTotalAT);
					uRow.put("completedActions",uCompAT);
					/* Vote \u2014 participation rate via loop */
					uTotalExpected = 0;
					uActualVotes = 0;
					allMtgs = Meeting[ID != 0];
					for each  im in allMtgs
					{
						isInvited = false;
						if(im.Invite_Members != null)
						{
							for each  inv in im.Invite_Members
							{
								if(inv == usr.ID)
								{
									isInvited = true;
								}
							}
						}
						if(isInvited == true)
						{
							mtgResos = Add_Resolution[Meeting.ID == im.ID];
							uTotalExpected = uTotalExpected + mtgResos.count();
						}
					}
					uActualVotes = Vote[Voter == usr.ID].count();
					uVotePct = if(uTotalExpected > 0,((uActualVotes * 100) / uTotalExpected).toLong(),0);
					if(uVotePct > 100)
					{
						uVotePct = 100;
					}
					uRow.put("vote",uVotePct);
					uRow.put("totalExpectedVotes",uTotalExpected);
					uRow.put("actualVotes",uActualVotes);
					/* Score */
					uScore = ((uAttPct + uCompPct + uVotePct) / 3).toLong();
					uRow.put("score",uScore);
					/* Status */
					uStatus = "Poor";
					uStatusBg = "#FDE3E6";
					uStatusClr = "#FE455D";
					if(uScore >= 90)
					{
						uStatus = "Excellent";
						uStatusBg = "#e4fcf3";
						uStatusClr = "#179E6C";
					}
					else if(uScore >= 75)
					{
						uStatus = "Good";
						uStatusBg = "#E8EFFF";
						uStatusClr = "#2A6FFC";
					}
					else if(uScore >= 50)
					{
						uStatus = "Needs Attention";
						uStatusBg = "#FCF4E6";
						uStatusClr = "#B8770D";
					}
					uRow.put("status",uStatus);
					uRow.put("statusBg",uStatusBg);
					uRow.put("statusClr",uStatusClr);
					indSumAtt = indSumAtt + uAttPct;
					indSumComp = indSumComp + uCompPct;
					indSumContrib = indSumContrib + uScore;
					indUserCount = indUserCount + 1;
					indUserList.add(uRow);
					uIdx = uIdx + 1;
				}
				indAvgAtt = if(indUserCount > 0,(indSumAtt / indUserCount).toLong(),0);
				indAvgComp = if(indUserCount > 0,(indSumComp / indUserCount).toLong(),0);
				indAvgContrib = if(indUserCount > 0,(indSumContrib / indUserCount).toLong(),0);
				/* Top 5 by score \u2014 pick highest, add to sorted list, remove from source */
				top5List = List();
				top5Source = List();
				for each  tu in indUserList
				{
					top5Source.add(tu);
				}
				for each  round in {1,2,3,4,5}
				{
					if(top5Source.size() > 0)
					{
						maxScore = -1;
						maxIdx = 0;
						sIdx = 0;
						for each  ts in top5Source
						{
							if(ts.get("score").toLong() > maxScore)
							{
								maxScore = ts.get("score").toLong();
								maxIdx = sIdx;
							}
							sIdx = sIdx + 1;
						}
						top5List.add(top5Source.get(maxIdx));
						top5Source.remove(maxIdx);
					}
				}
				/* Action completion \u2014 pick highest completed, add to sorted list */
				actCompList = List();
				actSource = List();
				for each  au in indUserList
				{
					if(au.get("totalActions").toLong() > 0)
					{
						actSource.add(au);
					}
				}
				for each  round2 in {1,2,3,4,5}
				{
					if(actSource.size() > 0)
					{
						maxComp = -1;
						maxIdx2 = 0;
						sIdx2 = 0;
						for each  as2 in actSource
						{
							if(as2.get("completedActions").toLong() > maxComp)
							{
								maxComp = as2.get("completedActions").toLong();
								maxIdx2 = sIdx2;
							}
							sIdx2 = sIdx2 + 1;
						}
						actCompList.add(actSource.get(maxIdx2));
						actSource.remove(maxIdx2);
					}
				}
				maxCompActions = 1;
				for each  mc in actCompList
				{
					if(mc.get("completedActions").toLong() > maxCompActions)
					{
						maxCompActions = mc.get("completedActions").toLong();
					}
				}
				%>
<!-- Individual KPI Panels -->
            <div class='zcs-panel-wrapper zcs-lg-panel-wrapper'>
                <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-list-none zcs-p-0 zcs-m-0'>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'><div class='zcs-panel zcs-wh-full zcs-flex zcs-justify-space-between zcs-gap-16 zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-direction-column zcs-gap-4'><p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Total Users</p><h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=indTotalUsers%></h4></div><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-end zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-24'></i></div></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'><div class='zcs-panel zcs-wh-full zcs-flex zcs-justify-space-between zcs-gap-16 zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-direction-column zcs-gap-4'><p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("ops.perf.avgAttendance")%></p><h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=indAvgAtt%>%</h4></div><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-end zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline location-position-pin'></i></div></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'><div class='zcs-panel zcs-wh-full zcs-flex zcs-justify-space-between zcs-gap-16 zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-direction-column zcs-gap-4'><p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Avg Completion</p><h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=indAvgComp%>%</h4></div><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-end zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline files-archive'></i></div></div></li>
                    <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative zcs-cursor-pointer'><div class='zcs-panel zcs-wh-full zcs-flex zcs-justify-space-between zcs-gap-16 zcs-rounded-lg zcs-p-16 zcs-box-border'><div class='zcs-flex zcs-direction-column zcs-gap-4'><p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Avg Contribution</p><h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=indAvgContrib%>%</h4></div><div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-end zcs-justify-center zcs-no-shrink zcs-rounded-lg'><i class='zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-24'></i></div></div></li>
                </ul>
            </div>

<!-- Individual Performance Details Table -->
<div class='zcs-card zcs-flex zcs-direction-column zcs-box-border'>
    <h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0 zcs-px-20 zcs-pt-16 zcs-pb-0 zcs-box-border'>Individual Performance Details</h6>
<%
				/* ============ Pagination ============ */
				ipRecordsPerPage = 5;
				ipTotalCount = indUserList.size();
				ipStartIndex = 1;
				if(!input.ip_start.isEmpty())
				{
					ipStartIndex = input.ip_start.toLong();
				}
				ipDiff = ipTotalCount - ipStartIndex;
				ipEndIndex = if(ipStartIndex + ipRecordsPerPage - 1 > ipTotalCount,ipStartIndex + ipDiff,ipStartIndex + ipRecordsPerPage - 1);
				ipPrevAction = if(ipStartIndex == 1,"disable","");
				ipNextAction = if(ipEndIndex >= ipTotalCount,"disable","");
				ipPageLink = "#Page:Operational_Page?tab=performance&perf_tab=individual";
				ipPrevLink = if(ipStartIndex > 1,"href='" + ipPageLink + "&ip_start=" + (ipStartIndex - ipRecordsPerPage) + "'","");
				ipNextLink = if(ipEndIndex < ipTotalCount,"href='" + ipPageLink + "&ip_start=" + (ipEndIndex + 1) + "'","");
				if(ipTotalCount == 0)
				{
					%>
<%=thisapp.Page.noData()%>
<%
				}
				else
				{
					%>
<div class='zcs-table-wrapper zcs-rounded-sm zcs-box-border zcs-relative'>
    <table class='zcs-w-full'>
        <thead class='zcs-sticky'>
            <tr>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>User</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("ops.individual.role")%></th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Attendance</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Completion</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Voting</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>Score</th>
                <th class='zcs-px-16 zcs-py-8 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=language.get("ops.committee.status")%></th>
            </tr>
            <tr class='zcs-tspace'><th class='zcs-p-2 zcs-box-border' colspan='7'></th></tr>
        </thead>
        <tbody>
<%
					ipIdx = 0;
					for each  uRow in indUserList
					{
						ipIdx = ipIdx + 1;
						if(ipIdx >= ipStartIndex && ipIdx <= ipEndIndex)
						{
							uAttBarClr = if(uRow.get("attendance").toLong() >= 90,"#179E6C",if(uRow.get("attendance").toLong() >= 75,"#f59e0b","#e8453c"));
							uCompBarClr = if(uRow.get("completion").toLong() >= 90,"#179E6C",if(uRow.get("completion").toLong() >= 75,"#f59e0b","#e8453c"));
							%>
<tr>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <div style='display:flex;align-items:center;gap:8px;'>
                        <span class='zcs-ind-avatar' style='background:<%=uRow.get("avatarBg")%>;color:<%=uRow.get("avatarClr")%>;'><%=uRow.get("initial")%></span>
                        <span class='zcs-font-14 zcs-font-medium zcs-color-primary'><%=uRow.get("name")%></span>
                    </div>
                </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=uRow.get("role")%></td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <div class='zcs-ind-bar-wrap'><div class='zcs-ind-bar-track'><div class='zcs-ind-bar-fill' style='width:<%=uRow.get("attendance")%>%;background:<%=uAttBarClr%>;'></div></div><span class='zcs-font-13 zcs-color-primary'><%=uRow.get("attendance")%>%</span></div>
                </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <div class='zcs-ind-bar-wrap'><div class='zcs-ind-bar-track'><div class='zcs-ind-bar-fill' style='width:<%=uRow.get("completion")%>%;background:<%=uCompBarClr%>;'></div></div><span class='zcs-font-13 zcs-color-primary'><%=uRow.get("completion")%>%</span></div>
                </td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=uRow.get("vote")%>%</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'><%=uRow.get("score")%>%</td>
                <td class='zcs-px-16 zcs-py-8 zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
                    <span class='zcs-ind-status' style='background:<%=uRow.get("statusBg")%>;color:<%=uRow.get("statusClr")%>;'><span class='zcs-ind-dot' style='background:<%=uRow.get("statusClr")%>;'></span><%=uRow.get("status")%></span>
                </td>
            </tr>
<%
						}
					}
					%>
</tbody>
    </table>
</div>
<div class='zcs-pagination'>
    <ul class='zcs-flex zcs-align-items-center zcs-justify-end zcs-gap-12 zcs-p-0 zcs-m-0'>
        <li class='zcs-pagination-item'>
            <span class='zcs-pagination-text zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
                <%=ipStartIndex%>-<%=ipEndIndex%> of <%=ipTotalCount%>
            </span>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(ipPrevAction == "disable","zcs-button-disable","")%>' <%=ipPrevLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-left'></i>
            </a>
        </li>
        <li class='zcs-pagination-item'>
            <a class='zcs-pagination-action zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-sm zcs-px-8 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-cursor-pointer <%=if(ipNextAction == "disable","zcs-button-disable","")%>' <%=ipNextLink%>>
                <i class='zcs-pagination-icon zc-li-outline arrows-1-minimal-right'></i>
            </a>
        </li>
    </ul>
</div>
<%
				}
				%>
</div>
<!-- Top 5 Performers + Action Completion -->
            <div class='zcs-row zcs-gap-20' style='align-items:stretch;'>
                <div class='zcs-col-6 zcs-col-xs-12'>
                    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-p-20 zcs-box-border' style='height:100%;'>
                        <h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=language.get("ops.individual.top5")%></h6>
                        <div class='zcs-chart zcs-columnchart-wrapper zcs-relative'>
                            <ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'>
<%
				topCount = 0;
				for each  tp in top5List
				{
					if(topCount < 5)
					{
						tpName = tp.get("name") + "";
						tpScore = tp.get("score").toLong();
						tpColor = tp.get("avatarClr") + "";
						%>
<li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
                                    <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal'><%=tpName%></span>
                                    <div class='zcs-column zcs-col-common zcs-flex zcs-pl-20 zcs-box-border zcs-overflow-hidden'>
                                        <a class='zcs-ind-score-bar zcs-h-full' style='width:<%=tpScore%>%;background-color:<%=tpColor%>;'></a>
                                    </div>
                                </li>
<%
						topCount = topCount + 1;
					}
				}
				%>
<li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'><span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal'></span><div class='zcs-column zcs-col-common zcs-flex zcs-pl-20 zcs-box-border zcs-overflow-hidden zcs-align-items-center'><a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'>0</a><a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'>25</a><a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'>50</a><a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'>75</a><a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'>100</a></div></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class='zcs-col-6 zcs-col-xs-12'>
                    <div class='zcs-card zcs-flex zcs-direction-column zcs-gap-24 zcs-p-20 zcs-box-border' style='height:100%;'>
<h6 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'><%=language.get("ops.individual.completionByUser")%></h6>
                        <div class='zcs-chart zcs-columnchart-wrapper zcs-relative'>
                            <ul class='zcs-chart-y-axis zcs-flex zcs-direction-column zcs-gap-32 zcs-m-0 zcs-p-0'>
<%
				actCount = 0;
				for each  ac in actCompList
				{
					if(actCount < 5)
					{
						acName = ac.get("name") + "";
						acComp = ac.get("completedActions").toLong();
						acBarPct = if(maxCompActions > 0,((acComp * 100) / maxCompActions).toLong(),0);
						%>
<li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
                                    <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal'><%=acName%></span>
                                    <div class='zcs-column zcs-col-common zcs-flex zcs-pl-20 zcs-box-border zcs-overflow-hidden'>
                                        <a class='zcs-column-value zcs-h-full' style='width:<%=acBarPct%>%;'></a>
                                    </div>
                                </li>
<%
						actCount = actCount + 1;
					}
				}
				/* X-axis labels: 0 to maxCompActions in 4 steps */
				xStep = if(maxCompActions > 4,(maxCompActions / 4).toLong(),1);
				x0 = 0;
				x1 = xStep;
				x2 = xStep * 2;
				x3 = xStep * 3;
				x4 = maxCompActions;
				%>
<li class='zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-4'>
                                    <span class='zcs-chart-y-axis-text zcs-font-14 zcs-font-normal'></span>
                                    <div class='zcs-column zcs-col-common zcs-flex zcs-pl-20 zcs-box-border zcs-overflow-hidden zcs-align-items-center'>
                                        <a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'><%=x0%></a>
                                        <a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'><%=x1%></a>
                                        <a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'><%=x2%></a>
                                        <a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'><%=x3%></a>
                                        <a class='zcs-col-common zcs-chart-x-axis-text zcs-font-14 zcs-font-normal zcs-text-center zcs-ellipsis'><%=x4%></a>
                                    </div>
                                </li>
                            </ul>
                        </div>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
<%
			}
		}
		%>
</div>
    </div>
</div>
</div>
<%
	}
%>