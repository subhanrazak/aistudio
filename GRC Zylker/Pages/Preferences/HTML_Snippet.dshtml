<%
	page_link_name = "Preferences";
	language = thisapp.Content.translation();
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Vertical_Tab()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>
<%=thisapp.Styles_Page.Common_View()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Avatar()%>
.zcs-skill-table thead th{
	border-bottom: 1px solid #E6E8EC;
}
.zcs-skill-table tbody  td{
	border-bottom: 1px solid #F3F4F6;
}
.zcs-skill-table tbody tr:last-child td{
	border-bottom: none !important;
} 

.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
.zcs-card-header, 
.zcs-vertical-tabbody .zcs-mobile-vertical-tabheader {
    border-bottom: 1px solid var(--zcs_tertiary_border_color);;
}
.zcs-card-content {
    border-radius: 0px 12px 12px 0px;
}
.zcs-embeddiv {
	height: 100% !important;
}
.zcs-embeddiv.zcs-form .form-header {
    margin-left: 0px;
}
@media (max-width: 992px) {
	.zcs-card-header {
		display: none;
	}
}
@media (max-width: 768px) {
	.zcs-page-container-inner {
		padding: 0px;
	}
	.zcs-card {
		border-width: 0px;
		border-radius: 0px;
	}
	.zcs-page-container .zcs-embeddiv {
		height: auto;
	}
	.zcs-mobile-vertical-tabheader {
		min-height: 110px;
	}
	body:not(.zc-mobile) .zcs-card-content {
		overflow: initial
	}
}
.zcs-embeddiv.zcs-form .zc-form-fullheight, .zcs-embeddiv.zcs-form .row, .zcs-embeddiv.zcs-form .form-outer-wrapper form.form-table { width: 100%; height: 100%; } .zcs-embeddiv.zcs-form .zc-form-fullheight .form-outer-wrapper { height: 100% !important; border-width: 0px; } .zcs-embeddiv.zcs-form .form-outer-wrapper form.form-table { display: flex; flex-direction: column; } .zcs-embeddiv.zcs-form .form-outer-wrapper .zc-mobile-scroll-ctr { display: flex; flex-direction: column; height: 100%; padding: 0px; } .zcs-embeddiv.zcs-form form .zc-form-scroll-wrapper { padding: 0px; } .zcs-page-container .zcs-embeddiv.zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer { flex: 1; padding: 20px 30px; box-sizing: border-box; overflow: auto; } .zcs-embeddiv.zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton { display: flex; align-items: center; padding: 20px 30px; box-sizing: border-box; } @media (max-width: 768px) { .zc-mobile .zcs-page-container.zcs-form-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer, .zc-mobile .zcs-form-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton { padding: 16px 20px; } }

</style>
<%
	if(input.page_action == "add")
	{
		if(input.tab == "organisations")
		{
			actionList = {"Basic Details","Scale","Address","Entity","Regulatory"};
			current_stepper = if(input.recid != null,Organization[ID == input.recid].Stepper_Stage,"Basic Details");
			input.action_field = if(input.action_field.isEmpty() || input.action_field == "" || input.action_field == null || input.action_field == "null",current_stepper,input.action_field);
			actionParam = if(input.action_field.isEmpty(),"","&Action_Field=" + input.action_field);
			formParam = if(input.recid != null,"&recLinkID=" + input.recid + "&viewLinkName=Organizations" + actionParam,actionParam);
			previoushrefLink = if(input.action_field != "Basic Details",'#Page:' + page_link_name + '?tab=organisations&page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(actionList.get(actionList.indexOf(input.action_field) - 1)),"");
			previoushrefAction = if(input.action_field != "Basic Details","href=" + previoushrefLink,"");
			%>
<style>
    /* Visited Styles */
    .zcs-stepper-status {
        width: 32px;
        height: 32px;
        background-color: var(--zcs_brand_color);
        border: 4px solid var(--zcs-white-color);
    }

    .zcs-stepper-count {
        border: 1px solid var(--zcs_tertiary_border_color);
        display: none;
    }

    .zcs-stepper-icon.zcs-stepper-failed {
        display: none;
    }

    .zcs-stepper-level {
        display: none;
        background-color: var(--zcs_brand_color);
    }

    .zcs-stepper:not(:last-child):before {
        content: '';
        width: 100%;
        height: 1px;
        border-top: 1px solid var(--zcs_brand_color);
        box-sizing: border-box;
        position: absolute;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }

    /* Active Styles */
    .zcs-stepper-active .zcs-stepper-status {
        border: 1px solid var(--zcs_brand_color);
        outline: 4px solid var(--zcs-white-color);
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active .zcs-stepper-count {
        display: flex;
        border-width: 0px;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper.zcs-stepper-active:before,
    .zcs-stepper.zcs-stepper-active~.zcs-stepper:before {
        border-color: var(--zcs_tertiary_border_color);
    }

    /* Stepper Failed */
    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-status {
        background-color: #FE455D;
        border-color: #FE455D;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-count {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-icon.zcs-stepper-failed {
        display: flex;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_primary_text_color);
    }

    /* Level Styles */
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-count,
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-level {
        display: flex;
    }

    /* Unvisited Styles */
    .zcs-stepper-active~.zcs-stepper .zcs-stepper-status {
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-count {
        display: flex;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-text {
        color: var(--zcs_tertiary_text_color);
    }

    @media (max-width: 575px) {
        .zcs-stepper-wrapper ul {
            flex-direction: column;
            gap: 24px;
        }

        .zcs-stepper-wrapper ul .zcs-stepper {
            flex-direction: row;
            gap: 16px;
        }

        .zcs-stepper:not(:last-child):before {
            width: 1px;
            height: 100%;
            border-left: 1px solid var(--zcs_brand_color);
            left: calc((32px - 1px) / 2);
        }
    }

    .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
        left: auto;
        right: 50%;
    }

    @media (max-width: 575px) {
        .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
            border-left: 1px solid var(--zcs_brand_color);
            left: auto;
            right: calc((32px - 1px) / 2);
        }
    }


.zcs-page-container { background-color: #F5F6FA; } .zcs-back:hover { color: #131635; }
.zcs-card {
	box-shadow: 0px 0px 6px 0px #E6E6E6;
}
/* .zcs-stepper-wrapper {
	border-bottom: 1px solid #e7e7ee;
} */
.zcs-wizard-page .zcs-form .zc-form-fullheight, .zcs-wizard-page .zcs-form .row, .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { width: 100%; height: 100%; background-color: transparent; } .zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper { height: 100% !important; border-width: 0px; background-color: transparent; } .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { display: flex; flex-direction: column; } .zcs-wizard-page .zcs-form .form-outer-wrapper .zc-mobile-scroll-ctr { display: flex; flex-direction: column; height: 100%; padding: 0px; } .zcs-wizard-page .zcs-form form .zc-form-scroll-wrapper { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; box-shadow: 0px 0px 6px 0px #E6E6E6; padding: 20px; box-sizing: border-box; } .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer { flex: 1; padding: 20px 10%; box-sizing: border-box; overflow: auto; background-color: transparent; } .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton { display: flex; align-items: center; padding: 20px 30px; box-sizing: border-box; justify-content: end; }

@media (max-width: 768px) {
	body:not(.zc-mobile) .zcs-page-container, body:not(.zc-mobile) .zcs-page-container-inner { height: auto; }
    .zcs-wizard-page .zcs-page-header,
    .zc-mobile .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer,
    .zc-mobile .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton {
        padding: 16px 20px;
    }
/* 	.zcs-page-content {
		padding: 0px 20px 20px;
	} */
    body:not(.zc-mobile) .zcs-card {
        background-color: transparent;
        border-color: transparent;
    }
	body:not(.zc-mobile) .zcs-stepper-wrapper {
		border-bottom-width: 0px;
	}
}
@media (max-width: 575px) {
    .zcs-stepper-wrapper ul {
        flex-direction: row;
    }
    .zcs-stepper-wrapper ul .zcs-stepper {
        flex-direction: column;
    }
    .zcs-stepper-text {
        display: none;
    }
    .zcs-stepper:not(:last-child):before {
        width: 100%;
        height: 1px;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }
}
.zcs-form .zc-footer-wrapper{
	 background-color: var(--zcs-white-color);
       
}
.zcs-button-disable
{
	color:#99A1AF !important;
}
</style>

<div class='zcs-page-container zcs-wizard-page zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>

<div class='zcs-page-header zcs-w-full zcs-flex  zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
<a href="#Page:<%=page_link_name%>?tab=organisations" class="zcs-back">
					<i class="zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left"></i>
				</a>
				<div class='zcs-flex zcs-direction-column zcs-gap-6'>
			<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> Organization </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis zcs-m-0'> Monitor risk posture and drive governance actions. </p>
			</div>
        </div>
        <div class='zcs-page-content zcs-col-common zcs-overflow-auto'>
            <div class='zcs-wh-full zcs-flex zcs-direction-column zcs-box-border zcs-overflow-hidden zcs-relative'>
                <div class='zcs-stepper-wrapper zcs-p-24 zcs-box-border'>
					<ul class='zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0'>
<%
			stepCount = 1;
			for each  step in actionList
			{
				currentStage = if(input.recid != null,Organization[ID == input.recid].Stepper_Stage,"Basic Details");
				getIndex = actionList.indexOf(currentStage) + 1;
				ahrefAction = "";
				if(stepCount <= getIndex)
				{
					ahrefLink = '#Page:' + page_link_name + '?tab=organisations&page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(step);
					ahrefAction = "href=" + ahrefLink;
				}
				%>
<a class='zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative <%=if(step == input.action_field,"zcs-stepper-active","")%>' <%=ahrefAction%> >
<div class='zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border zcs-relative'>
								<h6 class='zcs-stepper-count zcs-col-common zcs-w-full zcs-flex zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-font-12 zcs-font-semibold zcs-lh-body zcs-color-tertiary zcs-m-0 zcs-box-border'> <%=stepCount%> </h6>
								<i class='zcs-stepper-icon zcs-stepper-passed zcs-font-18 zcs-font-bold zcs-color-white zc-li-outline ui-1-check-small'></i>
							</div>
							<span class='zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=step%></span>


							
						
						
							</a>
<%
				stepCount = stepCount + 1;
			}
			%>
</ul>
				</div>
				<div class='zcs-col-common zcs-overflow-auto'>
					<div class='zcs-form' zc_MobileView='inline' elName='zc-component' formLinkName='Organization' params='zc_Header=false<%=formParam%>'></div>
				</div>
				<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
    <%=previoushrefAction%> style='position: absolute;bottom: 14px;left: 40px;'>
	<span class='zcs-button-text <%=if(input.action_field == "Basic Details","zcs-button-disable","")%>'> <%=language.get("grc.button.previous")%> </span>
</a>
            </div>
        </div>

</div>
</div>
<%
		}
		else if(input.tab == "users")
		{
			if(input.recid != null)
			{
				%>
<%=thisapp.Components.Add_Record("Users","#Page:" + page_link_name + "?tab=users","User","zc_Header=false&zc_SubmitVal=Create&recLinkID=" + input.recid + "&viewLinkName=User_Report")%>;
<%
			}
			else
			{
				%>
<%=thisapp.Components.Add_Record("Users","#Page:" + page_link_name + "?tab=users","User","zc_Header=false&zc_SubmitVal=Create")%>;
<%
			}
		}
	}
	else if(input.page_action == "detailView")
	{
		if(input.tab == "organisations")
		{
			orgDet = Organization[ID == input.recid];
			detail_tab_map = thisapp.Page.Get_Tabs("Organization_Page");
			detail_tab_keys = detail_tab_map.keys();
			input.detail_tab = if(input.detail_tab != "" && input.detail_tab != "null" && input.detail_tab != null,input.detail_tab,detail_tab_keys.get(0));
			%>
<style>
	.zcs-page-container 
	{ 
		background: #f3f4f8;
	}
	.zcs-divider-horizontal { border-top: 1px solid #E5E7EB; } 
	
	
	</style>
	<div class='zcs-page-container zcs-box-border zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
	    <div class="zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border">
			<div class="zcs-flex zcs-gap-16 zcs-ellipsis">
				<a href="#Page:Preferences?tab=organisations" class="zcs-back">
					<i class="zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left"></i>
				</a>
				<div class="zcs-flex zcs-direction-column zcs-gap-8">
				
						<h5 class="zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0"> <%=language.get("grc.organization.organizationDetails")%> </h5>
					
				</div>
			</div>
			<div class="zcs-flex zcs-align-items-center zcs-gap-12">
<%
			if(thisapp.permission.app_access("org_structure") == true)
			{
				%>
<a class="zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body" href='#Page:Preferences?page_action=add&recid=<%=orgDet.ID%>&action_field=<%=encodeUrl("Basic Details")%>&tab=organisations'>
					<i class="zcs-button-icon zc-li-outline ui-1-edit-72"></i>
					<span class="zcs-button-text"> <%=language.get("grc.edit.text")%> </span>
				</a>
<%
			}
			%>
</div>
		</div>
		
		<div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border zcs-flex zcs-direction-column zcs-gap-20'>
	    <div class="zcs-row zcs-gap-20 zcs-w-full">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20" style='border:none !important;'>
				     <div class="zcs-flex zcs-p-25 zcs-box-border zcs-gap-27">
					       <div class="zcs-avatar zcs-flex zcs-align-items-center zcs-justify-center" style="--zcs-avatar-size: 57px; --zcs-avatar-radius: 10px; border: 1px solid #E2E8F0;background-color:unset !important;">
<%
			if(orgDet.Logo != null && orgDet.Logo != "")
			{
				ownerImage = zoho.appuri + "report/Organizations/" + orgDet.ID + "/Logo/download-file?filepath=/" + orgDet.Logo.getSuffix("image/").getPrefix("\\"") + "&mediaType=1";
				%>
<img class='zcs-avatar-img zcs-wh-full' src=<%=ownerImage%> alt="John Smith profile photo"
											height="100%" width="100%">
<%
			}
			else
			{
				%>
<span class="zcs-font-18 zcs-font-normal zcs-text-white zcs-flex zcs-justify-center zcs-align-items-center zcs-fh zcs-lh-body" aria-hidden="true"><%=thisapp.Content.letterGenerate(orgDet.Organization_Name)%></span>
<%
			}
			%>
</div> 
<div class='zcs-flex zcs-direction-column zcs-gap-12'>
<div class='zcs-flex zcs-direction-column zcs-gap-4'>
<h5 class="zcs-font-24 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0"> <%=orgDet.Organization_Name%> </h5>
<div class='zcs-flex'>
					       <span style="font-size:16px;color:#62748E"><%=orgDet.Organization_ID%></span>
						   <div style="color:#62748E;font-size:16px;margin-left: 6px;"><span>\u2022 </span><%=orgDet.Industry_Type%></div>
						   <div style="color:#62748E;font-size:16px;margin-left: 6px;">\u2022 </span><%=orgDet.Organization_Type%></div>
						   
						   
						</div>
</div>

<div class='zcs-flex zcs-gap-24'>
       <div class='zcs-flex zcs-gap-8 zcs-align-items-center'>
	       <i class="ui-3-phone-call zc-li-outline zcs-font-14"  style='color:#99A1AF;font-weight:600;'></i>
		   <span class='zcs-font-14' style='color: var(--zcs_brand_color);'><%=orgDet.Contact_Phone%></span>
	   </div>
	   <div class='zcs-flex zcs-gap-8 zcs-align-items-center'>
	       <i class="ui-1-email-83 zc-li-outline zcs-font-14"  style='color:#99A1AF;font-weight:600;'></i>
		   <span class='zcs-font-14' style='color: var(--zcs_brand_color);'><%=orgDet.Contact_Email%></span>
	   </div>
	   <div class='zcs-flex zcs-gap-8 zcs-align-items-center'>
	       <i  class="business-globe zc-li-outline zc-li-outline zcs-font-14"  style='color:#99A1AF;font-weight:600;'></i>
		   <span class='zcs-font-14' style='color: var(--zcs_brand_color);'><%=orgDet.Website%></span>
	   </div>


</div>

</div>

						  
					 </div>
				 </div>
			 </div>
		

<div class='zcs-panel-wrapper'>
            <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.organization.entities")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=User[ID != 0].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline tech-disk-reader'></i>
                            </div>
                            
                       
                    </div>
                   
                </li>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=language.get("grc.organization.departments")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Role[ID != 0].count()%> </h4>
                        </div>
