<div class='zcs-card zcs-row zcs-gap-24 zcs-p-16 zcs-box-border zcs-flex zcs-direction-column'>
<div class='zcs-row zcs-gap-16 zcs-justify-space-between zcs-w-full'>
     <div class='zcs-flex zcs-direction-column zcs-gap-5'>
	   <h5 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'><%=language.get("grc.organization.regulatoryReporting")%></h5>
	   <span class='zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis'><%=language.get("grc.organization.regulatoryReportingSubheader")%></span>
	 </div>
<%
			if(thisapp.permission.app_access("org_structure") == true)
			{
				%>
<a href='#Form:Regulatory_Reporting_Requirements?Organization=<%=orgDet.ID%>&zc_LoadIn=dialog'> + <%=language.get("grc.organization.addCustomRequirement")%></a>
<%
			}
			%>
</div>
<%
			if(Regulatory_Reporting_Requirements[Organization == orgDet.ID].count() > 0)
			{
				%>
<table style='border-collapse: collapse;' class='zcs-skill-table'>
						  <thead>
						      <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary' > <%=language.get("grc.organization.regulatoryReport")%> </th>
							   <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.organization.frequency")%> </th>
							    <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.organization.regulator")%> </th>
								<th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.organization.deadlineType")%> </th>
						  </thead>
						  <tbody>
<%
				for each  requirement in Regulatory_Reporting_Requirements[Organization == orgDet.ID]
				{
					%>
<tr>
						 <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=requirement.Regulatory_Report.Report_Name%></td>
						  <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%=requirement.Frequency%></td>
						  </td>
						  <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=requirement.Regulator.Regulator_Name%></td>
						  <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=requirement.Deadline_Type%></td>
						  </tr>
<%
				}
				%>
</tbody>
						  </table>
<%
			}
			else
			{
				%>
<style>
	.zcs-nodata-wrapper{
		flex:1;
	}
	</style>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>


	</div>	
	</div>
	</div>
<%
		}
	}
	else
	{
		tab_map = thisapp.Page.Get_Tabs(page_link_name);
		tab_keys = tab_map.keys();
		input.tab = if(input.tab == "" || input.tab == null,tab_keys.get(0),input.tab);
		input.tab = if(!tab_keys.contains(input.tab),tab_keys.get(0),input.tab);
		%>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-p-30 zcs-box-border'>
        <div class='zcs-card zcs-wh-full zcs-flex zcs-direction-column'>
            <div class='zcs-card-header zcs-flex zcs-direction-column zcs-gap-4 zcs-p-20 zcs-box-border'>
                <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> Configuration </h5>
                <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> Configure your organization's profile and other informations. </p>
            </div>
			<div class='zcs-card-content zcs-col-common zcs-flex zcs-overflow-auto'>
                <div class='zcs-vertical-tabpanel zcs-flex zcs-wh-full zcs-relative'>
                    <input class='zcs-mobile-vertical-tabinput' name='zcs-mobile-tab' id='zcs-mobile-vertical-tabinput-submenu-vt' type='checkbox'>
                    <label class='zcs-mobile-vertical-tablabel zcs-com-page-navbar zcs-absolute' for='zcs-mobile-vertical-tabinput-submenu-vt'>
                        <i class='zcs-font-16 zcs-color-primary fa fa-bars'> </i>
                    </label>
                    <div class='zcs-mobile-vertical-tab-freezelayer'></div>
                    <ul class='zcs-vertical-tabhead zcs-h-full zcs-flex zcs-direction-column zcs-gap-2 zcs-p-20 zcs-m-0 zcs-box-border zcs-overflow-auto'>
<%
		tabCount = 1;
		for each  tab_id in tab_keys
		{
			class_name = if(input.tab == tab_id,'zcs-vertical-tabactive',"");
			%>
<li class='zcs-vertical-tabitem zcs-relative <%=class_name%>'>
                            <input class='zcs-vertical-tabinput' id='submenu-vt-<%=tabCount%>' name='zcs-tab' type='checkbox'>
                            <label class='zcs-vertical-tablabel' for='submenu-vt-<%=tabCount%>'>
                                <a class='zcs-vertical-tablink zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-4 zcs-rounded-sm zcs-px-12 zcs-py-10 zcs-box-border zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary zcs-ellipsis zcs-cursor-pointer'
                                    href='#Page:<%=page_link_name%>?tab=<%=tab_id%>'><%=tab_map.get(tab_id).get("Display")%> </a>
                            </label>
                        </li>
<%
			tabCount = tabCount + 1;
		}
		%>
</ul>
                    <div class='zcs-vertical-tabbody zcs-h-full zcs-col-common zcs-flex zcs-direction-column zcs-overflow-auto'>
						
                        <div class='zcs-vertical-tabcontent zcs-col-common zcs-overflow-auto' style='position: relative;'>
<%
		if(input.tab == "organisations")
		{
			%>
<div class="zcs-mb-15 zcs-flex zcs-justify-end " style='position: absolute;right: 10px;z-index: 99;height: var(--appname_height);align-items:center;'>
<%
			if(thisapp.permission.app_access("org_structure") == true)
			{
				%>
<a aria-label="Add new record" type="button" class="zcs-button zcs-cursor-pointer zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-box-border zcs-rounded-md" style='height:fit-content;'href='#Page:<%=page_link_name%>?tab=<%=input.tab%>&page_action=add'> <i value="ui-1-simple-add" html="ui-1-simple-add" class="ui-1-simple-add zc-li-outline"></i> <span class="zcs-button-text zcs-font-14 zcs-font-normal">Add</span> </a>
<%
			}
			%>
</div>
							<div class='zcs-embeddiv' name='embedDiv' elName='zc-component' viewLinkName='Organizations' params='zc_Footer=false&zc_Search=false&zc_AddRec=false&zc_MoreAction=false&zc_ColMenu=false&zc_RecSelect=false' zc_MobileView='inline'> </div>
<%
		}
		else if(input.tab == "notificationTemplates")
		{
			%>
<div class='zcs-embeddiv' name='embedDiv' elName='zc-component' viewLinkName='Notification_Templates' params='zc_Footer=false&zc_Search=false&zc_MoreAction=false&zc_ColMenu=false&zc_RecSelect=false' zc_MobileView='inline'> </div>
<%
		}
		else if(input.tab == "roles")
		{
			%>
<div class='zcs-embeddiv' name='embedDiv' elName='zc-component' viewLinkName='Roles' params='zc_Footer=false&zc_Search=false&zc_MoreAction=false&zc_ColMenu=false&zc_RecSelect=false&zc_AddRec=false' zc_MobileView='inline'> </div>
<%
		}
		else if(input.tab == "departments")
		{
			%>
<div class='zcs-embeddiv' name='embedDiv' elName='zc-component' viewLinkName='Departments' params='zc_Footer=false&zc_Search=false&zc_MoreAction=false&zc_ColMenu=false&zc_RecSelect=false' zc_MobileView='inline'> </div>
<%
		}
		else if(input.tab == "users")
		{
			%>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.user.header")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.assessment.processIdentificationSubHeader")%></p>
			</div>
<%
			if(thisapp.permission.app_access("org_structure") == true)
			{
				%>
<a class='zcs-button zcs-primary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add&tab=users'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.user.addUser")%> </span>
            </a>
<%
			}
			%>
</div>
        <div class='zcs-panel-wrapper'>
            <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
