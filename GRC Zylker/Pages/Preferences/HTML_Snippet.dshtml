<%
			if(Organization_Address[Organization == orgDet.ID].count() > 0)
			{
				%>
<span><%=language.get("grc.organization.viewAll")%></span>
<%
			}
			%>
-->
		</div>
		<div class='zcs-panel-wrapper zcs-flex zcs-gap-20 zcs-w-full zcs-overflow-auto' style='min-height: 115px;padding-bottom: 6px;box-sizing: border-box;'>
<%
			if(Organization_Address[Organization == orgDet.ID].count() > 0)
			{
				for each  location in Organization_Address[Organization == orgDet.ID]
				{
					%>
<div class='zcs-asset-card zcs-card zcs-flex  zcs-gap-12 zcs-p-12 zcs-box-border zcs-relative zcs-panel zcs-panel-grey' style ='box-shadow: 0px 2px 4px 0px #0000000D;border:none !important;flex-shrink:0;width:320px;'>
			<div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
										<i class='zcs-panel-icon zcs-font-24 zc-li-outline location-pin'></i>
			</div>
			<div class='zcs-flex zcs-direction-column zcs-gap-8 zcs-ellipsis'>

				  <span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'>
				  <%=location.Address.address_line_1%>,<%=location.Address.address_line_2%>
				</span>

					<span class='zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-primary'> <%=location.Address.district_city%>,<%=location.Address.state_province%>  <%=location.Address.postal_Code%></span>

				<span class='zcs-font-14 zcs-font-semibold zcs-lh-body zcs-color-primary zcs-ellipsis'>
					<%=location.Address.country%>
				</span>
