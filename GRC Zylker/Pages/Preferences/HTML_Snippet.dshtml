</div>
 <h5 class='zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary  zcs-m-0'><%=language.get("grc.organization.regulatoryCompliance")%></h5>
<div class="zcs-card zcs-row zcs-gap-24 zcs-p-16 zcs-box-border zcs-flex zcs-direction-column">
<div class="zcs-row zcs-gap-16 zcs-justify-space-between">
     <div class="zcs-flex zcs-direction-column zcs-gap-5">
	   <h5 class="zcs-font-16 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0"><%=language.get("grc.organization.regulatoryJurisdictions")%></h5>
	   <span class="zcs-font-13 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis"><%=language.get("grc.organization.regulatoryJurisdictionsSubheader")%></span>
	 </div>
<%
			if(thisapp.permission.app_access("org_structure") == true)
			{
				%>
<a href='#Form:Regulatory_Jurisdictions?Organization=<%=orgDet.ID%>&zc_LoadIn=dialog'> + <%=language.get("grc.organization.addRegulatoryJurisdictions")%></a>
<%
			}
			%>
</div>
<div class="zcs-panel-wrapper zcs-flex zcs-gap-20 zcs-overflow-auto zcs-w-full">
<%
			if(Regulatory_Jurisdictions[Organization == orgDet.ID].count() > 0)
			{
				for each  jurisdication in Regulatory_Jurisdictions[Organization == orgDet.ID]
				{
					%>
<div style="width:351px;background: #F9FAFB;flex-shrink: 0;" class="zcs-card zcs-row zcs-gap-24 zcs-p-16 zcs-box-border zcs-flex zcs-direction-column">
<div class="zcs-info-wrapper zcs-row zcs-gap-16 zcs-justify-space-between">
							<div class="zcs-info-item zcs-col-common zcs-flex zcs-align-items-center zcs-gap-16">
								
								
									
									<span class="zcs-font-15 zcs-font-medium zcs-lh-heading zcs-color-primary"> <%=jurisdication.Jurisdiction.Jurisdiction_Name%> </span>
									
							</div>
							
							
						</div>
						<div class="zcs-divider zcs-divider-horizontal"></div>
						<div class="zcs-info-wrapper zcs-row zcs-gap-16">
							<div class="zcs-info-item zcs-col-common zcs-flex  zcs-gap-8">
								
								<div class="zcs-flex zcs-direction-column zcs-col-common zcs-gap-4">
									
									<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.organization.regulators")%> </label>
									<div class='zcs-flex zcs-gap-6 zcs-align-items-center'>
									<span class="zcs-font-15 zcs-font-medium zcs-lh-heading zcs-color-primary"> <%=if(jurisdication.Regulators.size() > 0,Regulator[ID == jurisdication.Regulators.get(0)].Regulator_Name,"")%> </span>
<%
					if(jurisdication.Regulators.size() > 1)
					{
						%>
<span class='zcs-p-5' style='background:#DFE6EC;border-radius:6px;width:fit-content;'>+<%=jurisdication.Regulators.size() - 1%><span>
<%
					}
					%>
</div>
								</div>
							</div>
							<div class="zcs-info-item zcs-col-common  zcs-flex  zcs-gap-16">
								
								<div class="zcs-flex zcs-direction-column zcs-gap-4">
									<label class="zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary"> <%=language.get("grc.organization.keyRegulations")%> </label>
									<div class='zcs-flex zcs-gap-6 zcs-align-items-center'>
									<span class="zcs-font-15 zcs-font-medium zcs-lh-heading zcs-color-primary"> <%=if(jurisdication.Key_Regulations.size() > 0,Regulation[ID == jurisdication.Key_Regulations.get(0)].Regulation_Name,"")%> </span>
<%
					if(jurisdication.Key_Regulations.size() > 1)
					{
						%>
<span class='zcs-p-5' style='background:#DFE6EC;border-radius:6px;width:fit-content;'>+<%=jurisdication.Key_Regulations.size() - 1%><span>
<%
					}
					%>
</div>
									
								</div>
							</div>
						</div>
						</div>
<%
				}
			}
			else
			{
				%>
<%=thisapp.Page.noData()%>
<%
			}
			%>
</div>
</div>


 
<div class='zcs-card zcs-row zcs-gap-24 zcs-p-16 zcs-box-border zcs-flex zcs-direction-column'>
<div class='zcs-row zcs-gap-16 zcs-justify-space-between'>
