<%
	page_link_name = "Regulatory_Inventory";
	language = thisapp.Content.translation();
	%>
<style>
<%=thisapp.Styles.App_CSS()%>
<%=thisapp.Styles.Button()%>
<%=thisapp.Styles.Panel()%>
<%=thisapp.Styles.Horizontal_Tab()%>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles_Creator.Filter()%>
<%=thisapp.Styles_Creator.Report_Card()%>
<%=thisapp.Styles_Page.Common_View()%>
</style>
<%
	if(input.page_action == "add")
	{
		formLinkName = "Add_Regulation";
		actionList = {"Identity","Versioning","Source","Risk & Scope","Ownership","Obligations"};
		current_stepper = if(input.recid != null,Add_Regulation[ID == input.recid].Stepper_Stage,actionList.get(0));
		input.action_field = if(input.action_field.isEmpty(),current_stepper,input.action_field);
		actionParam = if(input.action_field.isEmpty(),"","&Action_Field=" + encodeUrl(input.action_field));
		formParam = if(input.recid != null,"&recLinkID=" + input.recid + "&viewLinkName=Add_Regulation_Report" + actionParam,actionParam);
		previoushrefLink = if(input.action_field != actionList.get(0),'#Page:' + page_link_name + '?page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(actionList.get(actionList.indexOf(input.action_field) - 1)),"");
		previoushrefAction = if(input.action_field != actionList.get(0),"href=" + previoushrefLink,"");
		buttonName = if(input.action_field == actionList.get(actionList.size() - 1),"Submit","Continue");
		backurl = if(input.recid != null,"#Page:" + page_link_name + "?page_action=detailView&recid=" + input.recid,"#Page:" + page_link_name);
		%>
<style>
 .form-action-container {
    position: relative;
}
.zc-form-footer .form-action-container .form-action.formbutton .form-label {
    display: flex;
    width: auto;
    padding: 0px;
} 
.form-action-container label:before {
    content: '<%=buttonName%>';
    min-width: 75px;
    height: 36px;
    display: inline-block;
    vertical-align: middle;
    background-color: var(--theme_brand_color);
    border-radius: var(--input_radius);
    padding: 8px 15px;
    font-size: 14px;
    line-height: 17px;
    font-weight: 400;
    text-align: center;
    color: var(--primary_btn_fClr);
    cursor: pointer;
    position: absolute;
    top: 14px;
    right: 30px;
}
.form-action-container .zc-live-primary-btn {
    background-color: transparent;
    color: transparent;
    margin: 0px;
    position: relative;
    z-index: 1;
}
  .choice-table-row .choice-table-cell > span > label.choice-label-text::before {
	  position:absolute;
  }
    /* Visited Styles */
    .zcs-stepper-status {
        width: 32px;
        height: 32px;
        background-color: var(--zcs_brand_color);
        
    }

    .zcs-stepper-count {
        border: 1px solid var(--zcs_tertiary_border_color);
        display: none;
    }

    .zcs-stepper-icon.zcs-stepper-failed {
        display: none;
    }

    .zcs-stepper-level {
        display: none;
        background-color: var(--zcs_brand_color);
    }

    .zcs-stepper:not(:last-child):before {
        content: '';
        width: 100%;
        height: 1px;
        border-top: 1px solid var(--zcs_brand_color);
        box-sizing: border-box;
        position: absolute;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }

    /* Active Styles */
    .zcs-stepper-active .zcs-stepper-status {
        border: 1px solid var(--zcs_brand_color);
        
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active .zcs-stepper-count {
        display: flex;
        border-width: 0px;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_brand_color);
    }

    .zcs-stepper.zcs-stepper-active:before,
    .zcs-stepper.zcs-stepper-active~.zcs-stepper:before {
        border-color: var(--zcs_tertiary_border_color);
    }

    /* Stepper Failed */
    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-status {
        background-color: #FE455D;
        border-color: #FE455D;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-count {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-icon.zcs-stepper-failed {
        display: flex;
    }

    .zcs-stepper-active.zcs-stepper-failed .zcs-stepper-text {
        font-weight: 500;
        color: var(--zcs_primary_text_color);
    }

    /* Level Styles */
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-count,
    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active.zcs-stepper-level-active .zcs-stepper-level {
        display: flex;
    }

    /* Unvisited Styles */
    .zcs-stepper-active~.zcs-stepper .zcs-stepper-status {
        background-color: var(--zcs-white-color);
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-count {
        display: flex;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-icon {
        display: none;
    }

    .zcs-stepper-active~.zcs-stepper .zcs-stepper-text {
        color: var(--zcs_tertiary_text_color);
    }

    @media (max-width: 575px) {
        .zcs-stepper-wrapper ul {
            flex-direction: column;
            gap: 24px;
        }

        .zcs-stepper-wrapper ul .zcs-stepper {
            flex-direction: row;
            gap: 16px;
        }

        .zcs-stepper:not(:last-child):before {
            width: 1px;
            height: 100%;
            border-left: 1px solid var(--zcs_brand_color);
            left: calc((32px - 1px) / 2);
        }
    }

    .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
        left: auto;
        right: 50%;
    }

    @media (max-width: 575px) {
        .zc-rtl-wrapper .zcs-stepper:not(:last-child):before {
            border-left: 1px solid var(--zcs_brand_color);
            left: auto;
            right: calc((32px - 1px) / 2);
        }
    }
	
	.zcs-icon-stepper-wrapper .zcs-stepper-status {
        width: 48px;
        height: 48px;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
        top: calc((48px - 1px) / 2);
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active .zcs-stepper-status {
        background-color: #FFE5E6;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active .zcs-stepper-icon {
        display: flex;
        color: var(--zcs_brand_color);
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active~.zcs-stepper .zcs-stepper-status {
        background-color: #E5E7EB;
    }

    .zcs-icon-stepper-wrapper .zcs-stepper-active~.zcs-stepper .zcs-stepper-icon {
        display: flex;
        color: #62748E;
    }

    @media (max-width: 575px) {
        .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
            left: calc((48px - 1px) / 2);
        }
    }

    @media (max-width: 575px) {
        .zc-rtl-wrapper .zcs-icon-stepper-wrapper .zcs-stepper:not(:last-child):before {
            right: calc((48px - 1px) / 2);
        }
    }


.zcs-page-container { background-color: #F5F6FA; } .zcs-back:hover { color: #131635; }
.zcs-card {
	box-shadow: 0px 0px 6px 0px #E6E6E6;
}
/* .zcs-stepper-wrapper {
	border-bottom: 1px solid #e7e7ee;
} */
.zcs-wizard-page .zcs-form .zc-form-fullheight, .zcs-wizard-page .zcs-form .row, .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { width: 100%; height: 100%; background-color: transparent; } .zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper { height: 100% !important; border-width: 0px; background-color: transparent; } .zcs-wizard-page .zcs-form .form-outer-wrapper form.form-table { display: flex; flex-direction: column; } .zcs-wizard-page .zcs-form .form-outer-wrapper .zc-mobile-scroll-ctr { display: flex; flex-direction: column; height: 100%; padding: 0px; } .zcs-wizard-page .zcs-form form .zc-form-scroll-wrapper { background-color: var(--zcs-white-color); border: 1px solid #e7e7ee; border-radius: 12px; box-shadow: 0px 0px 6px 0px #E6E6E6; padding: 20px; box-sizing: border-box; } .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer { flex: 1; padding: 20px 10%; box-sizing: border-box; overflow: auto; background-color: transparent; } .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton { display: flex; align-items: center; padding: 20px 30px; box-sizing: border-box; justify-content: end; }

@media (max-width: 768px) {
	body:not(.zc-mobile) .zcs-page-container, body:not(.zc-mobile) .zcs-page-container-inner { height: auto; }
    .zcs-wizard-page .zcs-page-header,
    .zc-mobile .zcs-page-container.zcs-wizard-page .zcs-form .zc-form-fullheight .form-outer-wrapper .form-table .formContainer,
    .zc-mobile .zcs-wizard-page .zcs-form form .zc-footer-wrapper .zc-form-footer .formbutton {
        padding: 16px 20px;
    }
/* 	.zcs-page-content {
		padding: 0px 20px 20px;
	} */
    body:not(.zc-mobile) .zcs-card {
        background-color: transparent;
        border-color: transparent;
    }
	body:not(.zc-mobile) .zcs-stepper-wrapper {
		border-bottom-width: 0px;
	}
}
@media (max-width: 575px) {
    .zcs-stepper-wrapper ul {
        flex-direction: row;
    }
    .zcs-stepper-wrapper ul .zcs-stepper {
        flex-direction: column;
    }
    .zcs-stepper-text {
        display: none;
    }
    .zcs-stepper:not(:last-child):before {
        width: 100%;
        height: 1px;
        top: calc((32px - 1px) / 2);
        left: 50%;
    }
}
.zcs-form .zc-footer-wrapper{
	 background-color: var(--zcs-white-color);
       
}
.zcs-button-disable
{
	color:#99A1AF !important;
}
</style>

<div class='zcs-page-container zcs-wizard-page zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>

<div class='zcs-page-header zcs-w-full zcs-flex  zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>

            <a href="<%=backurl%>" class="zcs-back">
					<i class="zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left"></i>
				</a>
			<div class='zcs-flex zcs-direction-column zcs-gap-6'>
			<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.assessmentPlan.createNewPlan")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-ellipsis zcs-m-0'> Monitor risk posture and drive governance actions. </p>
			</div>
        </div>
        <div class='zcs-page-content zcs-col-common zcs-overflow-auto'>
            <div class='zcs-wh-full zcs-flex zcs-direction-column zcs-box-border zcs-overflow-hidden zcs-relative'>
			
			<div class='zcs-stepper-wrapper zcs-icon-stepper-wrapper'>
			
    <ul class='zcs-flex zcs-gap-8 zcs-p-0 zcs-m-0'>
<%
		stepCount = 1;
		iconList = {"travel-hotel","files-single-folded-content","files-single-folded-content","users-multiple-11","business-money-bag","business-money-bag"};
		for each  step in actionList
		{
			currentStage = if(input.recid != null,Process[ID == input.recid].Stepper_Stage,"Process Information");
			getIndex = actionList.indexOf(currentStage) + 1;
			ahrefAction = "";
			if(stepCount <= getIndex)
			{
				ahrefLink = '#Page:' + page_link_name + '?page_action=add&recid=' + input.recid + '&action_field=' + encodeUrl(step);
				ahrefAction = "href=" + ahrefLink;
			}
			%>
<a class='zcs-stepper zcs-col-common zcs-flex zcs-direction-column zcs-align-items-center zcs-gap-4 zcs-text-center zcs-relative <%=if(step == input.action_field,"zcs-stepper-active","")%>' <%=ahrefAction%> >
							<div class='zcs-stepper-status zcs-flex zcs-direction-column zcs-align-items-center zcs-justify-center zcs-rounded-half zcs-text-center zcs-relative zcs-box-border zcs-relative'>
                <i class='zcs-stepper-icon zcs-font-18 zcs-font-semibold zcs-color-white zc-li-outline <%=iconList.get(stepCount - 1)%>'></i>
            </div>
            <span class='zcs-stepper-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'> <%=if(step == "Risk Control Association","Risk & Control Association",step)%></span>
						
						
							</a>
<%
			stepCount = stepCount + 1;
		}
		%>
</ul>
</div>
			

				<div class='zcs-col-common zcs-overflow-auto'>
					<div class='zcs-form' zc_MobileView='inline' elName='zc-component' formLinkName='<%=formLinkName%>' params='zc_Header=false&zc_Focus=false<%=formParam%>'></div>
				</div>
				<a class='zcs-button zcs-secondary-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
    <%=previoushrefAction%> style='position: absolute;bottom: 14px;left: 40px;'>
	<span class='zcs-button-text <%=if(input.action_field == actionList.get(0),"zcs-button-disable","")%>'> <%=language.get("grc.button.previous")%> </span>
</a>
            </div>
        </div>

</div>
</div>
<%
	}
	else if(input.page_action == "detailView")
	{
		regulation_record = Add_Regulation[ID == input.recid];
		%>
<style>
<%=thisapp.Styles.Badge()%>
<%=thisapp.Styles.Progress_Bar()%>
<%=thisapp.Styles.Divider()%>
<%=thisapp.Styles.Label_Value()%>
<%=thisapp.Styles.Avatar()%>
.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
.zcs-owner-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    min-width: 170px;
    width: fit-content;
}

.zcs-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
}

.zcs-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.zcs-avatar span{
	color:#fff !important;
}

.zcs-owner-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.zcs-owner-name {
    font-size: 13px;
    font-weight: 600;
    color: #0a1929;
}

.zcs-owner-role {
    font-size: 12px;
    font-weight: 400;
    color: #8896a6;
}

/* ===== Table Wrapper ===== */
.zcs-table-wrap {
    background: #ffffff;
    overflow: auto;
}

.zcs-table {
    width: 100%;
    border-collapse: collapse;
}

.zcs-table thead th {
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    color: #000000;
    padding: 9px 14px;
    background: #F8F8F8;
}

.zcs-table tbody td {
    font-size: 14px;
    font-weight: 400;
    color: #62748E;
    padding: 15px 14px;
	border-bottom :1px solid #ECEAF7;
}


.zcs-table tbody tr:last-child td {
    border-bottom: none;
}
</style>
<div class='zcs-page-container zcs-page-fleet_driver zcs-wh-full'>
    <div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column'>
        <div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-px-30 zcs-py-24 zcs-box-border'>
			<div class='zcs-flex zcs-gap-16 zcs-ellipsis'>
				<a class='zcs-back' href='#Page:<%=page_link_name%>'>
					<i class='zcs-back-icon zcs-font-22 zcs-color-tertiary fa fa-angle-left'></i>
				</a>
				<div class='zcs-flex zcs-direction-column zcs-gap-6 zcs-ellipsis'>
					<div class='zcs-row zcs-align-items-center zcs-gap-8'>
						<h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=regulation_record.Regulation_Name%> </h5>
						
					</div>
					<div class='zcs-row zcs-align-items-center zcs-gap-8'>
					<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-m-0 zcs-py-6 zcs-px-12 zcs-rounded-lg' style='background: #EFF0F2;'>
						<%=regulation_record.Regulation_Name%> 
					</p>
<%
		if(regulation_record.Regulation_Status == "Overdue")
		{
			priority_badgeClass = "zcs-badge-red";
		}
		else if(regulation_record.Regulation_Status == "Completed")
		{
			priority_badgeClass = "zcs-badge-green";
		}
		else if(regulation_record.Regulation_Status == "In Progress")
		{
			priority_badgeClass = "zcs-badge-blue";
		}
		else if(regulation_record.Regulation_Status == "Not Started")
		{
			priority_badgeClass = "zcs-badge-orange";
		}
		%>
<p class='zcs-badge zcs-badge-filled-outline zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary zcs-m-0 zcs-py-5 zcs-px-6 zcs-rounded-2xl <%=priority_badgeClass%>' style='border: none !important;'>
					<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'>\u2022 <%=regulation_record.Regulation_Status%> </span>
					</p>


					</div>
				</div>
			</div>
			<div class='zcs-flex zcs-align-items-center zcs-gap-12'>
<%
		if(thisapp.permission.app_access("assessment_plan") == true)
		{
			%>
<a href='#Page:<%=page_link_name%>?page_action=add&recid=<%=regulation_record.ID%>&action_field=<%=encodeUrl("Plan Details")%>' class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'>
					<i class='zcs-button-icon zc-li-outline ui-1-edit-72'></i>
					<span class='zcs-button-text'> <%=language.get("grc.edit.text")%> </span>
				</a>
<%
		}
		%>
</div>
		</div>
		<div class='zcs-page-content zcs-col-common zcs-overflow-auto zcs-px-20 zcs-pb-20 zcs-box-border'>
		   
		
		<div class='zcs-row zcs-gap-20 zcs-w-full zcs-mb-15'>
			     <div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
				     <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border'>
					      <h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Basic Details </h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex'>
						         <div class="zcs-flex zcs-direction-column zcs-gap-20" style='flex: 1;flex-shrink: 0;'>
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Regulation ID </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulation_ID%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Regulation Name </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulation_Name%> </span>
											</div>
											
											
											</div>
									<div class='zcs-flex zcs-direction-column zcs-gap-20' style='flex: 1;flex-shrink: 0;'>
									<div class='zcs-flex'>
									<div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex: 1;flex-shrink: 0;'>
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Short Name / Acronym </h6>
									 <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Short_Name%> </span>
									  </div>
									  <div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex: 1;flex-shrink: 0;'>
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Regulator </h6>
									 <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulator.Regulator_Name%> </span>
									  </div>
									  </div>
									  <div class="zcs-flex zcs-direction-column zcs-gap-4">
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Jurisdiction </h6>
									  <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Jurisdiction.Jurisdiction_Name%> </span>
									  </div>
									  
									  
									</div>
						  </div>
						  <div class='zcs-flex'>
						   <div class='zcs-flex zcs-direction-column zcs-gap-4' style='flex: 1;flex-shrink: 0;'>
						   <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Applicable Entity / License Type </h6>
						  <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Applicable_Entity_License_Type.Applicable_Entity%> </span>    
</div>
<div class='zcs-flex zcs-direction-column zcs-gap-4' style='flex: 1;flex-shrink: 0;'>
<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Industry Type </h6>
<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Industry_Type.Industry_Type%> </span>
</div>
						  

						  </div>
						  
					 </div>
				 </div>
				 
				 
			 </div>
		
		
             <div class='zcs-row zcs-gap-20 zcs-w-full zcs-mb-15'>
			     <div class='zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20'>
				     <div class='zcs-flex zcs-direction-column zcs-gap-12 zcs-p-23 zcs-box-border'>
					      <h6 class='zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-m-0'>Versioning </h6>
						  <div class="zcs-divider zcs-divider-horizontal"></div>
						  <div class='zcs-flex'>
						         <div class="zcs-flex zcs-direction-column zcs-gap-20" style='flex: 1;flex-shrink: 0;'>
										     <div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Original Effective Date </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulation_ID%> </span>
											</div>
											
											<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Latest Amendment Date </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulation_Name%> </span>
											</div>
											
											
											</div>
									<div class='zcs-flex zcs-direction-column zcs-gap-20' style='flex: 1;flex-shrink: 0;'>
									<div class='zcs-flex'>
									<div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex: 1;flex-shrink: 0;'>
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Version Number </h6>
									 <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Short_Name%> </span>
									  </div>
									  <div class="zcs-flex zcs-direction-column zcs-gap-4" style='flex: 1;flex-shrink: 0;'>
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Supersedes Regulation </h6>
									 <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Regulator.Regulator_Name%> </span>
									  </div>
									  </div>
									  <div class="zcs-flex zcs-direction-column zcs-gap-4">
									  <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Review Cycle </h6>
									  <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Jurisdiction.Jurisdiction_Name%> </span>
									  </div>
									  
									  
									</div>
						  </div>
						  <div class='zcs-flex'>
						   <div class='zcs-flex zcs-direction-column zcs-gap-4' style='flex: 1;flex-shrink: 0;'>
						   <h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Sunset Date </h6>
						  <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Applicable_Entity_License_Type.Applicable_Entity%> </span>    
</div>
<div class='zcs-flex zcs-direction-column zcs-gap-4' style='flex: 1;flex-shrink: 0;'>
<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> Regulation Status </h6>
<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=regulation_record.Industry_Type.Industry_Type%> </span>
</div>
						  

						  </div>
						  
					 </div>
				 </div>
				 
				 
			 </div>

		</div> <!-- page content end here -->
		
		
</div>
</div>
<%
	}
	else
	{
		%>
<style>
		.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	padding:0px !important;
}
</style>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.regulatory.Header")%>  </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'><%=language.get("grc.regulatory.subHeader")%>  </p>
			</div>
<%
		if(thisapp.permission.app_access("risk_Management_Library_Button") == true)
		{
			%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.regulatory.addRegulatory")%> </span>
            </a>
<%
		}
		%>
</div>
        
		<div class='zcs-page-content zcs-card zcs-col-common zcs-overflow-auto zcs-flex zcs-direction-column'>
          
                    <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=overView&Page=<%=page_link_name%>&Report=Processes'></div>
					<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Regulatory_Report_Page' params='zc_Header=false&zc_AddRec=false&zc_ColMenu=false&zc_Footer=false'></div>
               
		</div>
	</div>
</div>
<%
	}
%>