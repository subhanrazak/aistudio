										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=resourceDet.Currency%> </span>
							</div>

<div class="zcs-flex zcs-direction-column zcs-gap-4">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.resource.billingFrequency")%> </h6>
											<span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"><%=resourceDet.Billing_Frequency%></span>
