				     <div class="zcs-flex zcs-direction-column zcs-gap-20 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.resource.technicalSkills")%> </h6>
<%
		if(Skills_Expertise[Resource == resourceDet.ID].count() > 0)
		{
			%>
<table style='border-collapse: collapse;' class='zcs-skill-table'>
						  <thead>
						      <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary' > <%=language.get("grc.resource.skill")%> </th>
							   <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.resource.level")%> </th>
							    <th class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-medium zcs-lh-body zcs-color-tertiary'> <%=language.get("grc.resource.yearsOfExperience")%> </th>
						  </thead>
						  <tbody>
<%
			for each  skill in Skills_Expertise[Resource == resourceDet.ID]
			{
				%>
<tr>
						 <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=skill.Skill.Skill_Name%></td>
						  <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'>
<%
				if(skill.Level == "Beginner")
				{
					badgeClass = "zcs-badge-orange";
				}
				else if(skill.Level == "Intermediate")
				{
					badgeClass = "zcs-badge-yellow";
				}
				else if(skill.Level == "Advanced")
				{
					badgeClass = "zcs-badge-blue";
				}
				else if(skill.Level == "Expert")
				{
					badgeClass = "zcs-badge-green";
				}
				%>
<div class='zcs-badge zcs-badge-filled-outline zcs-inline-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-rounded-xl zcs-px-10 zcs-py-0 zcs-box-border <%=badgeClass%>' style='border-radius: 0.75rem;padding:0 10px ; width:max-content;border:none !important;'>
				<span class='zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body'> <%=skill.Level%> </span>
				</div> 
						  </td>
						  <td class='zcs-p-16 zcs-box-border zcs-text-left zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-primary'><%=skill.Years_of_Experience1%></td>
						  </tr>
<%
			}
			%>
</tbody>
						  </table>
<%
		}
		else
		{
			%>
<%=thisapp.Page.noData()%>
<%
		}
		%>
</div>
				</div>
			</div>
			<div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
