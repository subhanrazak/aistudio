											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.resource.workingDays")%> </h6>
<%
		workingDaysList = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
		%>
<div class="zcs-flex zcs-mb-15 zcs-gap-8  ">
<%
		for each  workingDay in workingDaysList
		{
			style_txt = "";
			if(workingDay == resourceDet.Working_Days)
			{
				style_txt = "style='color:#fff !important;background: #E53935 !important;border:1px solid #E53935'";
			}
			%>
<div class="zcs-flex zcs-px-16 zcs-py-10 zcs-workingday-div zcs-gap-3" <%=style_txt%> >

<h4 class="zcs-font-12 zcs-font-medium zcs-lh-heading  zcs-m-0"> <%=workingDay%> </h4>
						 
                     
                   
                </div>
<%
		}
		%>
</div>	
											
										    
					
							         </div>
						  
					 </div>
				</div>
			</div>
			<div class="zcs-row zcs-gap-20 zcs-w-full zcs-mb-15">
			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-20 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.resource.additionalSettings")%> </h6>
<%
		settingsList = {"Available for immediate assignment","Can work remotely","Willing to travel","Available for overtime work","Send assignment notifications"};
		%>
<div class="zcs-flex zcs-mb-15 zcs-gap-8  ">
<%
		for each  setting in settingsList
		{
			style_txt = "";
			if(setting == resourceDet.Additional_Settings)
			{
				style_txt = "style='color:#008236 !important;background: #F0FDF4 !important;border:1px solid #B9F8CF'";
			}
			%>
<div class="zcs-flex zcs-px-16 zcs-py-10 zcs-settings-div zcs-gap-3" <%=style_txt%> >
<%
			if(setting == resourceDet.Additional_Settings)
			{
				%>
<i value="ui-1-check-small" html="ui-1-check-small" class="ui-1-check-small zc-li-outline"></i>
<%
			}
			%>
<h4 class="zcs-font-12 zcs-font-medium zcs-lh-heading  zcs-m-0"> <%=setting%> </h4>
						 
                     
                   
                </div>
<%
		}
		%>
</div>
						  
					 </div>
				</div>
			</div>
			
		
		</div> <!-- page content end here -->
		
		
		</div>
		</div>
<%
	}
	else
	{
		totalCount = Resource[ID != 0].count();
		internalCount = Resource[Resource_Type == "Internal Resource"].count();
		externalCount = Resource[Resource_Type == "External Resource"].count();
		%>
<style>
<%=thisapp.Styles.Progress_Bar()%>
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper.zc-page-content-wrapper .elemContainment{
	padding:0px !important;
}
.zcs-page-container {
	background-color: var(--zcs-page-bg-color);
}
</style>
<div class='zcs-page-container zcs-commonview zcs-wh-full'>
	<div class='zcs-page-container-inner zcs-wh-full zcs-flex zcs-direction-column zcs-gap-20 zcs-px-30 zcs-py-24 zcs-box-border'>
		<div class='zcs-page-header zcs-w-full zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-8 zcs-ellipsis'>
            
			<div class='zcs-flex zcs-direction-column zcs-gap-8'>
           <h5 class='zcs-font-18 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-ellipsis zcs-m-0'> <%=language.get("grc.resource.resourceHeader")%> </h5>
			<p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>Monitor risk posture and drive governance actions.</p>
			</div>
<%
		if(thisapp.permission.app_access("resource") == true)
		{
			%>
<a class='zcs-button zcs-primary-outline-button zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-16 zcs-py-8 zcs-rounded-md zcs-box-border zcs-font-14 zcs-font-normal zcs-lh-body'
                href='#Page:<%=page_link_name%>?page_action=add&tab=<%=input.tab%>'>
                <i class='zcs-button-icon zc-li-outline ui-1-simple-add'></i>
                <span class='zcs-button-text'> <%=language.get("grc.resource.addResource")%> </span>
            </a>
<%
		}
		%>
</div>
        <div class='zcs-panel-wrapper'>
           <ul class='zcs-row zcs-justify-space-between zcs-gap-20 zcs-p-0 zcs-m-0'>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'> <%=language.get("grc.resource.totalResources")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=totalCount%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline tech-disk-reader'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
				<li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>  <%=language.get("grc.resource.companyVendor")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Resource[ID != 0].distinct(Company_Vendor).size()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline business-briefcase-25'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
                <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>  <%=language.get("grc.resource.weeklyCapacity")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Resource[ID != 0].sum(Hours_per_Week)%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline location-position-pin'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
               <li class='zcs-col-3 zcs-col-sm-6 zcs-col-xs-12 zcs-relative '>
                    <div class='zcs-panel zcs-panel-red zcs-wh-full zcs-flex  zcs-gap-8 zcs-rounded-lg zcs-p-16 zcs-box-border zcs-justify-space-between'>
					<div class='zcs-flex zcs-justify-center zcs-gap-10 zcs-direction-column'>
					 <p class='zcs-font-14 zcs-font-normal zcs-lh-body zcs-color-tertiary zcs-m-0'>  <%=language.get("grc.resource.contractsExpiringSoon")%> </p>
                        <h4 class='zcs-font-20 zcs-font-medium zcs-lh-heading zcs-color-primary zcs-m-0'> <%=Resource[End_Date_if_contractor in next 30 days].count()%> </h4>
                        </div>
                            <div class='zcs-panel-icon-wrapper zcs-flex zcs-align-items-center zcs-justify-center zcs-no-shrink zcs-rounded-lg'>
                                <i class='zcs-panel-icon zcs-font-24 zc-li-outline users-parent'></i>
                            </div>
                            
                       
                    </div>
                    <a class='zcs-overlay zcs-wh-full zcs-absolute' ></a>
                </li>
               
            </ul>
        </div>
		<div class='zcs-page-content zcs-card zcs-col-common zcs-overflow-auto'>
            <div class='zcs-horizontal-tabpanel zcs-flex zcs-direction-column zcs-wh-full'>
                <ul class='zcs-horizontal-tabhead zcs-flex zcs-gap-12 zcs-px-10 zcs-py-0 zcs-m-0 zcs-box-border'>
<%
		for each  tab_id in tab_keys
		{
			class_name = if(input.tab == tab_id,"zcs-horizontal-tabitem zcs-horizontal-tabactive'","zcs-horizontal-tabitem");
			if(tab_id == "internal")
			{
				resourceCount = internalCount;
			}
			else if(tab_id == "external")
			{
				resourceCount = externalCount;
			}
			else
			{
				resourceCount = totalCount;
			}
			%>
<li class='<%=class_name%>'> <a class='zcs-horizontal-tablink zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-8 zcs-px-10 zcs-py-12 zcs-box-border zcs-font-medium zcs-lh-body zcs-color-secondary' href='#Page:<%=page_link_name%>?tab=<%=tab_id%>'><span class="zcs-horizontal-tab-text"> <%=tab_map.get(tab_id).get("Display")%> (<%=resourceCount%>)</span> </a> </li>
<%
		}
		%>
</ul>
                <div class='zcs-horizontal-tabbody zcs-col-common zcs-flex zcs-direction-column'>
                     <div class='zcs-filter' zc_MobileView='inline' elName='zc-component' formLinkName='Filter_Form' params='zc_Header=false&zc_Footer=false&zc_Focus=false&Action_field=overView&Page=<%=page_link_name%>&Report=Resources<%=tab_map.get(input.tab).get("Param")%>'></div>
					<div class='zcs-report zcs-col-common' name='embedDiv' elName='zc-component' viewLinkName='Resource_Report_Page' params='zc_Header=false&tab=<%=input.tab%><%=tab_map.get(input.tab).get("Param")%>' ></div>
                </div>
            </div>
		</div>
	</div>
</div>
<%
	}
%>