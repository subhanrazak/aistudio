<%
		if(resourceDet.Certifications != "" && resourceDet.Certifications != null)
		{
			%>
<span style="border:1px solid #C6D2FF;border-radius:10px;background:#EEF2FF;color:#432DD7;" class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body zcs-p-17"> <%=resourceDet.Certifications%> </span>
<%
		}
		%>
</div>
						  
						   <div class='zcs-flex zcs-w-full zcs-gap-50'>
