			     <div class="zcs-card zcs-left-content zcs-h-full zcs-overflow-auto zcs-col-12 zcs-col-sm-12 zcs-flex zcs-direction-column zcs-gap-20">
				     <div class="zcs-flex zcs-direction-column zcs-gap-20 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.software.costInformation")%> </h6>
						  <div class='zcs-flex  zcs-justify-space-between zcs-gap-12' style='width:75%;'>
						      
							 
							        <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.assessmentPlan.hourlyRate")%> </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=resourceDet.Hourly_Rate%> </span>
