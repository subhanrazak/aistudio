				     <div class="zcs-flex zcs-direction-column zcs-gap-20 zcs-p-25 zcs-box-border">
					      <h6 class="zcs-font-16 zcs-font-semibold zcs-lh-heading zcs-color-primary zcs-mb-8 zcs-mt-0"><%=language.get("grc.assessmentPlan.availability")%> </h6>
						  <div class='zcs-flex zcs-w-full zcs-gap-50'>
						      <div style="width:50%;" class="zcs-flex zcs-direction-column zcs-gap-20">
							         <div class="zcs-flex zcs-direction-column zcs-gap-6">
											<h6 class="zcs-font-14 zcs-font-normal zcs-lh-heading zcs-color-tertiary zcs-m-0"> <%=language.get("grc.resource.hoursPerWeek")%>  </h6>
										    <span class="zcs-badge-text zcs-font-14 zcs-font-normal zcs-lh-body"> <%=resourceDet.Hours_per_Week%>  </span>
							         </div>
							  </div>
