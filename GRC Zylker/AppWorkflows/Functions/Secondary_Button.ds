string Styles.Secondary_Button()
{

                 	style_text = '.zcs-button { width: auto; min-width: 5rem; min-height: 36px; } .zcs-fw-button { width: 100%; } .zcs-primary-button { background-color: var(--zcs_brand_color); color: var(--zcs_brand_foreground_color); } .zcs-primary-outline-button { border: 1px solid var(--zcs_brand_color); background-color: var(--zcs-white-color); color: var(--zcs_brand_color); } .zcs-secondary-button { border: 1px solid var(--zcs_primary_border_color); background-color: var(--zcs_light_grey_color); color: var(--zcs_primary_text_color); } .zcs-primary-button.zcs-custom-color { background-color: var(--zcs-button-color); } .zcs-primary-outline-button.zcs-custom-color { border-color: var(--zcs-button-color); color: var(--zcs-button-color); } .zcs-primary-button.zcs-button:hover { background-color: var(--zcs_brand_dark_color); } .zcs-primary-outline-button:hover { background-color: var(--zcs_component_hover_color); border-color: var(--zcs_brand_color); color: var(--zcs_brand_color); } .zcs-secondary-button:hover { background-color: --zcs_dark_grey_color; } .zcs-primary-button.zcs-custom-color:hover { background-color: var(--zcs-button-hover-color); } .zcs-primary-outline-button.zcs-custom-color:hover { background-color: var(--zcs-button-hover-color); border-color: var(--zcs-button-hover-color); } .zcs-primary-button.zcs-button:active, .zcs-primary-button.zcs-button:focus { background-color: var(--zcs_component_hover_color); outline: 2px solid var(--zcs_brand_color); outline-offset: 2px; } .zcs-primary-button.zcs-custom-color:active, .zcs-primary-button.zcs-custom-color:focus { background-color: var(--zcs-button-hover-color); outline: 2px solid var(--zcs-button-color); outline-offset: 2px; } .zcs-primary-outline-button.zcs-button:active, .zcs-primary-outline-button.zcs-button:focus { background-color: var(--zcs_component_hover_color); outline: 2px solid var(--zcs_brand_color); outline-offset: 2px; color: var(--zcs_brand_color); } .zcs-primary-outline-button.zcs-custom-color:active, .zcs-primary-outline-button.zcs-custom-color:focus { background-color: var(--zcs-button-hover-color); outline: 2px solid var(--zcs-button-color); outline-offset: 2px; } .zcs-secondary-button.zcs-button:active, .zcs-secondary-button.zcs-button:focus { background-color: --zcs_dark_grey_color; outline: 2px solid var(--zcs_primary_border_color); outline-offset: 2px; } .zcs-button-icon { width: 16px; max-height: 16px; } .zcs-button-group .zcs-button { border-radius: 6px 0px 0px 6px; } .zcs-button-group .zcs-more-options { height: 37px; background-color: var(--zcs_brand_color); border-radius: 0px 6px 6px 0px; border-color: var(--zcs_brand_color); border-left-color: var(--zcs_brand_dark_color); } .zcs-button-group .zcs-more-options .zcs-mo-icon { color: var(--zcs_brand_foreground_color); } .zcs-button-group .zcs-more-options:hover { background-color: var(--zcs_brand_dark_color); border-color: var(--zcs_brand_dark_color); color: var(--zcs_brand_foreground_color); } .zcs-button-group .zcs-more-options:hover .zcs-mo-icon { color: var(--zcs_brand_foreground_color); }';
                 	return style_text;
                 
}