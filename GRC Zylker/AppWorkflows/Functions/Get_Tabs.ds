map Page.Get_Tabs(string page)
{

                 	tabs_map = Map();
                 	display_name = thisapp.Content.translation();
                 	if(input.page == "Organization_Page")
                 	{
                 		tabs_map.put("organization",{"Display":display_name.get("grc.organization.organization")});
                 		tabs_map.put("structure",{"Display":display_name.get("grc.organization.structure")});
                 		tabs_map.put("entity",{"Display":display_name.get("grc.organization.entity")});
                 		tabs_map.put("department",{"Display":display_name.get("grc.organization.department")});
                 	}
                 	else if(input.page == "Risk_Assessment_Detail_View")
                 	{
                 		tabs_map.put("assessment",{"Display":display_name.get("grc.assessment.assessmentInitiate")});
                 		tabs_map.put("riskIdentify",{"Display":display_name.get("grc.assessment.riskIdentify")});
                 		tabs_map.put("inherentRisk",{"Display":display_name.get("grc.assessment.inherentRisk")});
                 		tabs_map.put("controlMapping",{"Display":display_name.get("grc.assessment.controlMapping")});
                 		tabs_map.put("controlEffectiveness",{"Display":display_name.get("grc.assessment.controlEffectiveness")});
                 		tabs_map.put("residualRisk",{"Display":display_name.get("grc.assessment.residualRisk")});
                 		tabs_map.put("riskTreatment",{"Display":display_name.get("grc.assessment.riskTreatment")});
                 		tabs_map.put("approval",{"Display":display_name.get("grc.assessment.approval")});
                 		tabs_map.put("followup",{"Display":display_name.get("grc.assessment.followup")});
                 		tabs_map.put("reports",{"Display":display_name.get("grc.assessment.reports")});
                 	}
                 	else if(input.page == "Risk_Assessment_Worksheet")
                 	{
                 		tabs_map.put("Assessment Initiate",{"Display":display_name.get("grc.assessment.assessmentInitiate")});
                 		tabs_map.put("Risk Identify",{"Display":display_name.get("grc.assessment.riskIdentify")});
                 		tabs_map.put("Inherent Risk",{"Display":display_name.get("grc.assessment.inherentRisk")});
                 		tabs_map.put("Control Mapping",{"Display":display_name.get("grc.assessment.controlMapping")});
                 		tabs_map.put("Control Effectiveness",{"Display":display_name.get("grc.assessment.controlEffectiveness")});
                 		tabs_map.put("Residual Risk",{"Display":display_name.get("grc.assessment.residualRisk")});
                 		tabs_map.put("Risk Treatment",{"Display":display_name.get("grc.assessment.riskTreatment")});
                 		tabs_map.put("Approval",{"Display":display_name.get("grc.assessment.approval")});
                 	}
                 	else if(input.page == "Objective_Page" || input.page == "Strategy_Page" || input.page == "Risk_Assessment_Page")
                 	{
                 		if(input.page == "Objective_Page")
                 		{
                 			report_Link = "Objectives";
                 		}
                 		else
                 		{
                 			report_Link = "Strategies";
                 		}
                 		tabs_map.put("all",{"Display":display_name.get("grc.objective.all"),"Link":report_Link,"Param":""});
                 		if(input.page == "Objective_Page")
                 		{
                 			tabs_map.put("active",{"Display":display_name.get("grc.objective.active"),"Link":report_Link,"Param":"&Status=Active"});
                 			tabs_map.put("planning",{"Display":display_name.get("grc.objective.planning"),"Link":report_Link,"Param":"&Status=Planning"});
                 		}
                 		else
                 		{
                 			tabs_map.put("notStarted",{"Display":display_name.get("grc.strategy.notStarted"),"Link":report_Link,"Param":"&Status=Not Started"});
                 			tabs_map.put("inProgress",{"Display":display_name.get("grc.strategy.inProgress"),"Link":report_Link,"Param":"&Status=In Progress"});
                 		}
                 		tabs_map.put("onHold",{"Display":display_name.get("grc.objective.onHold"),"Link":report_Link,"Param":"&Status=On Hold"});
                 		tabs_map.put("completed",{"Display":display_name.get("grc.objective.completed"),"Link":report_Link,"Param":"&Status=Completed"});
                 	}
                 	else if(input.page == "Incident_Management_Page")
                 	{
                 		report_Link = "Incident_Registers";
                 		tabs_map.put("all",{"Display":display_name.get("grc.objective.all"),"Link":report_Link,"Param":""});
                 		tabs_map.put("open",{"Display":display_name.get("grc.incident.open"),"Link":report_Link,"Param":"&Status=Open"});
                 		tabs_map.put("underInvestigation",{"Display":display_name.get("grc.incident.underInvestigation"),"Link":report_Link,"Param":"&Status=Under Investigation"});
                 		tabs_map.put("onHold",{"Display":display_name.get("grc.incident.onHold"),"Link":report_Link,"Param":"&Status=On Hold"});
                 		tabs_map.put("closed",{"Display":display_name.get("grc.incident.closed"),"Link":report_Link,"Param":"&Status=Closed"});
                 	}
                 	else if(input.page == "Resources_Page")
                 	{
                 		report_Link = "Resources";
                 		tabs_map.put("all",{"Display":display_name.get("grc.resource.allResources"),"Link":report_Link,"Param":""});
                 		tabs_map.put("internal",{"Display":display_name.get("grc.resource.internal"),"Link":report_Link,"Param":"&Resource_Type=Internal Resource"});
                 		tabs_map.put("external",{"Display":display_name.get("grc.resource.external"),"Link":report_Link,"Param":"&Resource_Type=External Resource"});
                 	}
                 	else if(input.page == "Preferences")
                 	{
                 		tabs_map.put("organisations",{"Display":display_name.get("grc.preference.organisations")});
                 		tabs_map.put("departments",{"Display":display_name.get("grc.preference.departments")});
                 		if(thisapp.permission.app_access("settings") == true)
                 		{
                 			tabs_map.put("roles",{"Display":display_name.get("grc.preference.roles")});
                 			tabs_map.put("users",{"Display":display_name.get("grc.preference.users")});
                 			tabs_map.put("notificationTemplates",{"Display":display_name.get("grc.preference.notificationTemplates")});
                 		}
                 	}
                 	else if(input.page == "Process_Page")
                 	{
                 		tabs_map.put("Risk",{"Display":display_name.get("grc.objective.linkedRisks")});
                 		tabs_map.put("Control",{"Display":display_name.get("grc.objective.linkedControls")});
                 	}
                 	else if(input.page == "Board_Page")
                 	{
                 		tabs_map.put("overview",{"Display":"Overview"});
                 		tabs_map.put("committee",{"Display":"Committe"});
                 		tabs_map.put("member",{"Display":"Members","Link":"User_Report"});
                 	}
                 	else if(input.page == "Meeting_Page")
                 	{
                 		tabs_map.put("agenda",{"Display":"Agenda","Link":"Agenda_Summary"});
                 		tabs_map.put("mom",{"Display":"MOM"});
                 		tabs_map.put("resolution",{"Display":"Resolution","Link":"Resolution_Report"});
                 		tabs_map.put("action_item",{"Display":"Action Items","Link":"Action_Trackers"});
                 		tabs_map.put("attenace",{"Display":"Attedance"});
                 		tabs_map.put("agenda",{"Display":"Agenda"});
                 		tabs_map.put("document",{"Display":"Document"});
                 		tabs_map.put("activity",{"Display":"Activity"});
                 	}
                 	else if(input.page == "Agenda_Page")
                 	{
                 		tabs_map.put("all",{"Display":"All","Link":"All_Agenda"});
                 		tabs_map.put("my",{"Display":"My Agenda","Link":"My_Agenda"});
                 		tabs_map.put("upcoming",{"Display":"Upcoming","Link":"Upcoming_Agenda"});
                 		tabs_map.put("completed",{"Display":"Completed","Link":"Completed_Agenda"});
                 		tabs_map.put("tempelate",{"Display":"Templates","Link":"Agenda_Template"});
                 	}
                 	else if(input.page == "Operational_Page")
                 	{
                 		tabs_map.put("action",{"Display":"Action Tracking"});
                 		tabs_map.put("escalation",{"Display":"Escalation"});
                 		tabs_map.put("performance",{"Display":"Performance"});
                 	}
                 	else if(input.page == "Operational_Page")
                 	{
                 		tabs_map.put("action",{"Display":"Action Tracking"});
                 		tabs_map.put("escalation",{"Display":"Escalation"});
                 		tabs_map.put("performance",{"Display":"Performance"});
                 	}
                 	else if(input.page == "performance_Detail")
                 	{
                 		tabs_map.put("overview",{"Display":"Overview Commitee"});
                 		tabs_map.put("commitee",{"Display":"Commitee"});
                 		tabs_map.put("individual",{"Display":"Individual"});
                 	}
                 	return tabs_map;
                 
}