string Styles.Badge()
{

                 	str = '.zcs-badge { width: max-content; white-space: nowrap; } .zcs-badge-filled { border: 1px solid transparent; } .zcs-badge-filled-outline, .zcs-badge-outline { border: 1px solid; } /* Filled Badge */ .zcs-badge-filled.zcs-badge-theme { background-color: var(--zcs-theme-brand-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-green { background-color: #179E6C; border-color: #179E6C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-red { background-color: #FE455D; border-color: #FE455D; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-grey { background-color: #242424; border-color: #242424; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-yellow { background-color: #FAAE13; border-color: #FAAE13; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-blue { background-color: #2A6FFC; border-color: #2A6FFC; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-orange { background-color: #F4660C; border-color: #F4660C; color: var(--zcs-white-color); } .zcs-badge-filled.zcs-badge-violet { background-color: #8200DB; border-color: #8200DB; color: var(--zcs-white-color); } /* Filled Outline Badge */ .zcs-badge-filled-outline.zcs-badge-theme { background-color: var(--zcs-light-bg-color); border-color: var(--zcs-theme-brand-color); color: var(--zcs-theme-brand-color); } .zcs-badge-filled-outline.zcs-badge-green { background-color: #E4FCF3; border-color: #179E6C; color: #179E6C; } .zcs-badge-filled-outline.zcs-badge-red { background-color: #FDE3E6; border-color: #FE455D; color: #FE455D; } .zcs-badge-filled-outline.zcs-badge-grey { background-color: #e8e8e8; border-color: #242424; color: #242424; } .zcs-badge-filled-outline.zcs-badge-yellow { background-color: #FCF4E6; border-color: #FAAE13; color: #FAAE13; } .zcs-badge-filled-outline.zcs-badge-blue { background-color: #E8EFFF; border-color: #2A6FFC; color: #2A6FFC; } .zcs-badge-filled-outline.zcs-badge-orange { background-color: #F8F0EB; border-color: #F4660C; color: #F4660C; } .zcs-badge-filled-outline.zcs-badge-violet { background-color: #F7EEFD; border-color: #8200DB; color: #8200DB; } /* Outline Badge */ .zcs-badge-outline.zcs-badge-theme { color: var(--zcs-theme-brand-color); } .zcs-badge-outline.zcs-badge-green { color: #179E6C; } .zcs-badge-outline.zcs-badge-red { color: #FE455D; } .zcs-badge-outline.zcs-badge-grey { color: #242424; } .zcs-badge-outline.zcs-badge-yellow { color: #FAAE13; } .zcs-badge-outline.zcs-badge-blue { color: #2A6FFC; } .zcs-badge-outline.zcs-badge-orange { color: #F4660C; } .zcs-badge-outline.zcs-badge-violet { color: #8200DB; }';
                 	return str;
                 
}